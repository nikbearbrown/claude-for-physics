  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 140,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "The universe is expanding - so does that mean\nthere's a center from which everything is"
    } ]
  }, {
    "tStartMs": 4280,
    "dDurationMs": 4649,
    "segs": [ {
      "utf8": "stretching? I mean, it LOOKS like the center\nis here, because this point didn't move when"
    } ]
  }, {
    "tStartMs": 8929,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "we scaled. But we could just as easily have\nwatched the scaling from this star, or this"
    } ]
  }, {
    "tStartMs": 13249,
    "dDurationMs": 2131,
    "segs": [ {
      "utf8": "one, and they each \"look\" like the center."
    } ]
  }, {
    "tStartMs": 15380,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "In fact, ANY time you scale anything up or\ndown, there's no real center to the scaling."
    } ]
  }, {
    "tStartMs": 19850,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "I mean, this square was clearly scaled up\nfrom its center... I mean, its corner. I mean,"
    } ]
  }, {
    "tStartMs": 24540,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "that point over there. The point... is, sure\nthere may be points that stay in the same"
    } ]
  }, {
    "tStartMs": 28670,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "place because of your frame of reference,\nwhich is why it appears to us as if the earth"
    } ]
  }, {
    "tStartMs": 32210,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "is the center of the expansion of the universe,\nbut to someone in the Andromeda Galaxy it"
    } ]
  }, {
    "tStartMs": 35930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "would appear that THEY were the center of\nthe expansion."
    } ]
  }, {
    "tStartMs": 38480,
    "dDurationMs": 4169,
    "segs": [ {
      "utf8": "In short, if you're too close-minded to view\nthe universe from different perspectives,"
    } ]
  }, {
    "tStartMs": 42649,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "it's easy to think you're at the center of\nthe universe. Maybe that's the universe's"
    } ]
  } ]
}
