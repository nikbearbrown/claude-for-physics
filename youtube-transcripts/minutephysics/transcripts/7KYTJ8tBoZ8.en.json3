{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 2738,
    "dDurationMs": 2629,
    "segs": [ {
      "utf8": "\"The world has persisted\nmany a long year,"
    } ]
  }, {
    "tStartMs": 5377,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "having once been set going\nin the appropriate motions."
    } ]
  }, {
    "tStartMs": 8947,
    "dDurationMs": 2815,
    "segs": [ {
      "utf8": "From these, everything else follows.\""
    } ]
  }, {
    "tStartMs": 12035,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "Lucretius."
    } ]
  }, {
    "tStartMs": 15053,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "In the beginning,"
    } ]
  }, {
    "tStartMs": 16506,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "about 13.7 billion years ago,"
    } ]
  }, {
    "tStartMs": 19418,
    "dDurationMs": 3614,
    "segs": [ {
      "utf8": "all the space, and all the matter,\nand all the energy of the known universe"
    } ]
  }, {
    "tStartMs": 23042,
    "dDurationMs": 3539,
    "segs": [ {
      "utf8": "was contained in a volume less\nthan one trillionth the size"
    } ]
  }, {
    "tStartMs": 26591,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "of the point of a pin."
    } ]
  }, {
    "tStartMs": 27969,
    "dDurationMs": 2789,
    "segs": [ {
      "utf8": "Conditions were so hot the\nbasic forces of nature"
    } ]
  }, {
    "tStartMs": 30768,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "that collectively describe\nthe universe were unified."
    } ]
  }, {
    "tStartMs": 34101,
    "dDurationMs": 4874,
    "segs": [ {
      "utf8": "For reasons unknown, this\nsub-pinpoint-sized cosmos began to expand."
    } ]
  }, {
    "tStartMs": 39143,
    "dDurationMs": 3554,
    "segs": [ {
      "utf8": "When the universe was a piping-hot\n10 to the 30th degrees,"
    } ]
  }, {
    "tStartMs": 42707,
    "dDurationMs": 3606,
    "segs": [ {
      "utf8": "and a youthful 10 to the\nminus 43 seconds old --"
    } ]
  }, {
    "tStartMs": 46323,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "before which all of our\ntheories of matter and space"
    } ]
  }, {
    "tStartMs": 49217,
    "dDurationMs": 2329,
    "segs": [ {
      "utf8": "break down and have no meaning --"
    } ]
  }, {
    "tStartMs": 51556,
    "dDurationMs": 4251,
    "segs": [ {
      "utf8": "black holes spontaneously formed,\ndisappeared, and formed again,"
    } ]
  }, {
    "tStartMs": 55817,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "out of the energy contained\nwithin the unified field."
    } ]
  }, {
    "tStartMs": 59546,
    "dDurationMs": 4522,
    "segs": [ {
      "utf8": "Under these extreme conditions,\nin what is admittedly speculative physics,"
    } ]
  }, {
    "tStartMs": 64078,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "the structure of space and\ntime became severely curved"
    } ]
  }, {
    "tStartMs": 67509,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "as it gurgled, into a spongy,\nfoamlike form."
    } ]
  }, {
    "tStartMs": 70913,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "During these epochs, phenomena described by\nEinstein's general theory of relativity,"
    } ]
  }, {
    "tStartMs": 75656,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "the modern theory of gravity,"
    } ]
  }, {
    "tStartMs": 77266,
    "dDurationMs": 4022,
    "segs": [ {
      "utf8": "and quantum mechanics, the description\nof matter in its smallest scales,"
    } ]
  }, {
    "tStartMs": 81420,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "were indistinguishable from one another."
    } ]
  }, {
    "tStartMs": 84084,
    "dDurationMs": 2754,
    "segs": [ {
      "utf8": "As the universe continued\nto expand and cool,"
    } ]
  }, {
    "tStartMs": 86848,
    "dDurationMs": 2242,
    "segs": [ {
      "utf8": "gravity split from the other forces."
    } ]
  }, {
    "tStartMs": 89284,
    "dDurationMs": 4851,
    "segs": [ {
      "utf8": "Quickly thereafter, the strong nuclear force and\nthe electroweak force split from each other,"
    } ]
  }, {
    "tStartMs": 94145,
    "dDurationMs": 3193,
    "segs": [ {
      "utf8": "which was accompanied by an\nenormous release of stored energy,"
    } ]
  }, {
    "tStartMs": 97348,
    "dDurationMs": 4516,
    "segs": [ {
      "utf8": "that induced a rapid 30-power-of-10\nincrease in the size of the universe."
    } ]
  }, {
    "tStartMs": 102111,
    "dDurationMs": 3729,
    "segs": [ {
      "utf8": "The rapid expansion of the universe,\nknown as the epoch of inflation,"
    } ]
  }, {
    "tStartMs": 105850,
    "dDurationMs": 3826,
    "segs": [ {
      "utf8": "stretched and smoothed out the cosmic\ndistribution of matter and energy,"
    } ]
  }, {
    "tStartMs": 109686,
    "dDurationMs": 2438,
    "segs": [ {
      "utf8": "so that any regional\nvariation in density"
    } ]
  }, {
    "tStartMs": 112134,
    "dDurationMs": 2855,
    "segs": [ {
      "utf8": "became less than one part\nin one hundred thousand."
    } ]
  }, {
    "tStartMs": 115358,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "Continuing onward with what is\nnow laboratory confirmed physics,"
    } ]
  }, {
    "tStartMs": 118891,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "the universe was hot enough for photons\nto spontaneously convert their energy"
    } ]
  }, {
    "tStartMs": 123101,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "into matter-antimatter particle pairs,"
    } ]
  }, {
    "tStartMs": 125424,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "which immediately thereafter\nannihilated each other,"
    } ]
  }, {
    "tStartMs": 128018,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "returning their energy\nback to the photons."
    } ]
  }, {
    "tStartMs": 130728,
    "dDurationMs": 4399,
    "segs": [ {
      "utf8": "For reasons unknown, this symmetry between\nmatter and antimatter had been broken,"
    } ]
  }, {
    "tStartMs": 135137,
    "dDurationMs": 3544,
    "segs": [ {
      "utf8": "which led to a slight excess\nof matter over antimatter."
    } ]
  }, {
    "tStartMs": 138691,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "For every billion antimatter particles,"
    } ]
  }, {
    "tStartMs": 141445,
    "dDurationMs": 3111,
    "segs": [ {
      "utf8": "a billion plus one matter\nparticles were born."
    } ]
  }, {
    "tStartMs": 144566,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "This asymmetry was small,\nbut really, really important"
    } ]
  }, {
    "tStartMs": 148053,
    "dDurationMs": 2248,
    "segs": [ {
      "utf8": "for the future evolution\nof the universe."
    } ]
  }, {
    "tStartMs": 150311,
    "dDurationMs": 3593,
    "segs": [ {
      "utf8": "As the universe continued to cool,\nthe electroweak force split"
    } ]
  }, {
    "tStartMs": 153914,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "into the electromagnetic force\nand the weak nuclear force,"
    } ]
  }, {
    "tStartMs": 157340,
    "dDurationMs": 3489,
    "segs": [ {
      "utf8": "completing the four distinct\nand familiar forces of nature."
    } ]
  }, {
    "tStartMs": 160839,
    "dDurationMs": 2839,
    "segs": [ {
      "utf8": "While the energy of the photon\nbath continued to drop,"
    } ]
  }, {
    "tStartMs": 163688,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "pairs of matter-antimatter particles\ncould no longer be created spontaneously"
    } ]
  }, {
    "tStartMs": 167938,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": "from the available photons."
    } ]
  }, {
    "tStartMs": 169556,
    "dDurationMs": 4688,
    "segs": [ {
      "utf8": "All remaining pairs of matter-antimatter\nparticles swiftly annihilated,"
    } ]
  }, {
    "tStartMs": 174254,
    "dDurationMs": 3325,
    "segs": [ {
      "utf8": "leaving behind a universe with\none particle of ordinary matter"
    } ]
  }, {
    "tStartMs": 177589,
    "dDurationMs": 3755,
    "segs": [ {
      "utf8": "for every billion photons,\nand no antimatter."
    } ]
  }, {
    "tStartMs": 181472,
    "dDurationMs": 3053,
    "segs": [ {
      "utf8": "Had this matter-over-antimatter\nasymmetry not emerged,"
    } ]
  }, {
    "tStartMs": 184535,
    "dDurationMs": 4538,
    "segs": [ {
      "utf8": "the expanding universe would forever\nbe composed of light an nothing else,"
    } ]
  }, {
    "tStartMs": 189083,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "not even astrophysicists."
    } ]
  }, {
    "tStartMs": 191378,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Over a roughly three-minute period,"
    } ]
  }, {
    "tStartMs": 193438,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "protons and neutrons assembled\nfrom the annihilations"
    } ]
  }, {
    "tStartMs": 196278,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to become the simplest atomic nuclei."
    } ]
  }, {
    "tStartMs": 198528,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Meanwhile, free-roving electrons thoroughly\nscattered the photons to and fro,"
    } ]
  }, {
    "tStartMs": 203018,
    "dDurationMs": 2559,
    "segs": [ {
      "utf8": "creating an opaque soup\nof matter and energy."
    } ]
  }, {
    "tStartMs": 205587,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "When the univers cooled below\na few thousand degrees Kelvin,"
    } ]
  }, {
    "tStartMs": 208658,
    "dDurationMs": 2092,
    "segs": [ {
      "utf8": "about the temperature\nof fireplace embers,"
    } ]
  }, {
    "tStartMs": 210760,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "the loose electrons moved slowly enough"
    } ]
  }, {
    "tStartMs": 213347,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "to get snatched from the\nsoup by the roving nuclei,"
    } ]
  }, {
    "tStartMs": 215960,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "to make completed atoms of\nhydrogen, helium, and lithium,"
    } ]
  }, {
    "tStartMs": 219848,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "the three lightest elements."
    } ]
  }, {
    "tStartMs": 221731,
    "dDurationMs": 3755,
    "segs": [ {
      "utf8": "The universe is now, for the first time,\ntransparent to visible light,"
    } ]
  }, {
    "tStartMs": 225496,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "and these free-flying\nphotons are visible today"
    } ]
  }, {
    "tStartMs": 228381,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "as the cosmic microwave background."
    } ]
  }, {
    "tStartMs": 230967,
    "dDurationMs": 1725,
    "segs": [ {
      "utf8": "Over the first billion years,"
    } ]
  }, {
    "tStartMs": 232702,
    "dDurationMs": 2145,
    "segs": [ {
      "utf8": "the universe continued\nto expand and cool,"
    } ]
  }, {
    "tStartMs": 234857,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "as matter gravitated into this massive\nconcentrations we call galaxies."
    } ]
  }, {
    "tStartMs": 239008,
    "dDurationMs": 2499,
    "segs": [ {
      "utf8": "Between 50 and 100\nbillion of them formed,"
    } ]
  }, {
    "tStartMs": 241517,
    "dDurationMs": 2531,
    "segs": [ {
      "utf8": "each containing hundreds\nof billions of stars,"
    } ]
  }, {
    "tStartMs": 244058,
    "dDurationMs": 2798,
    "segs": [ {
      "utf8": "that undergo thermonuclear\nfusion in their cores."
    } ]
  }, {
    "tStartMs": 246866,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "Those stars with more than about\n10 times the mass of the Sun"
    } ]
  }, {
    "tStartMs": 249998,
    "dDurationMs": 2573,
    "segs": [ {
      "utf8": "achieve sufficient pressure\nand temperature in their cores"
    } ]
  }, {
    "tStartMs": 252581,
    "dDurationMs": 2929,
    "segs": [ {
      "utf8": "to manufacture dozens of\nelements heavier than hydrogen,"
    } ]
  }, {
    "tStartMs": 255520,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "including elements that compose\nthe planets and life upon them."
    } ]
  }, {
    "tStartMs": 259470,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "These element would be\nemarassingly useless"
    } ]
  }, {
    "tStartMs": 261703,
    "dDurationMs": 2358,
    "segs": [ {
      "utf8": "were they to remain\nlocked inside the star."
    } ]
  }, {
    "tStartMs": 264071,
    "dDurationMs": 2832,
    "segs": [ {
      "utf8": "But high mass stars,\nfortuitously, explode,"
    } ]
  }, {
    "tStartMs": 266913,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "scattering their chemically enriched\nguts throughout the galaxy."
    } ]
  }, {
    "tStartMs": 270326,
    "dDurationMs": 2726,
    "segs": [ {
      "utf8": "After seven or eight billion\nyears of such enrichment,"
    } ]
  }, {
    "tStartMs": 273062,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "an undistinguished star was born\nin an undistinguished region"
    } ]
  }, {
    "tStartMs": 276722,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "of an undistinguished galaxy,"
    } ]
  }, {
    "tStartMs": 278596,
    "dDurationMs": 2568,
    "segs": [ {
      "utf8": "in an undistinguished\npart of the universe:"
    } ]
  }, {
    "tStartMs": 281174,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "the outskirts of the Virgo supercluster."
    } ]
  }, {
    "tStartMs": 283988,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "During the formation\nof this star system,"
    } ]
  }, {
    "tStartMs": 286091,
    "dDurationMs": 4574,
    "segs": [ {
      "utf8": "matter condensed and accreted out of the\nparent cloud of gas while circling the Sun."
    } ]
  }, {
    "tStartMs": 290675,
    "dDurationMs": 2083,
    "segs": [ {
      "utf8": "The gas cloud from which the Sun formed"
    } ]
  }, {
    "tStartMs": 292768,
    "dDurationMs": 2331,
    "segs": [ {
      "utf8": "contained a sufficient\nsupply of heavy elements"
    } ]
  }, {
    "tStartMs": 295109,
    "dDurationMs": 4806,
    "segs": [ {
      "utf8": "to form a system of planets, thousands\nof asteroids, and billions of comets."
    } ]
  }, {
    "tStartMs": 299925,
    "dDurationMs": 3324,
    "segs": [ {
      "utf8": "For several hundred million years,\nthe persisting impacts"
    } ]
  }, {
    "tStartMs": 303259,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "of high velocity comets\nand other leftover debris,"
    } ]
  }, {
    "tStartMs": 306031,
    "dDurationMs": 2735,
    "segs": [ {
      "utf8": "rendered molten the surfaces\nof the rocky planets,"
    } ]
  }, {
    "tStartMs": 308776,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "preventing the formation\nof complex molecules."
    } ]
  }, {
    "tStartMs": 311609,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "As less an less accretable matter\nremained in the Solar System,"
    } ]
  }, {
    "tStartMs": 314961,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "the planet surfaces began to cool."
    } ]
  }, {
    "tStartMs": 317248,
    "dDurationMs": 2775,
    "segs": [ {
      "utf8": "The one we call Earth formed\nin a zone around the Sun"
    } ]
  }, {
    "tStartMs": 320033,
    "dDurationMs": 2691,
    "segs": [ {
      "utf8": "where oceans remain\nlargely liquid in form."
    } ]
  }, {
    "tStartMs": 322734,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "Had Earth been much closer to the Sun,\nthe oceans would have vaporized."
    } ]
  }, {
    "tStartMs": 326191,
    "dDurationMs": 3025,
    "segs": [ {
      "utf8": "Had Earth been much farther,\nthe oceans would have frozen."
    } ]
  }, {
    "tStartMs": 329226,
    "dDurationMs": 3439,
    "segs": [ {
      "utf8": "In either case, life as we know\nit would not have evolved."
    } ]
  }, {
    "tStartMs": 332675,
    "dDurationMs": 3597,
    "segs": [ {
      "utf8": "Within the chemically rich liquid\noceans, by a mechanism unknown,"
    } ]
  }, {
    "tStartMs": 336282,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "there emerged simple anaerobic\nbacteria, that unwillingly"
    } ]
  }, {
    "tStartMs": 339752,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "transformed Earth's carbon\ndioxide rich atmosphere"
    } ]
  }, {
    "tStartMs": 342696,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "into one with sufficient oxygen to\nallow aerobic organisms to emerge"
    } ]
  }, {
    "tStartMs": 346584,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "and dominate the oceans and land."
    } ]
  }, {
    "tStartMs": 348655,
    "dDurationMs": 3919,
    "segs": [ {
      "utf8": "The same oxygen atoms,\nnormally found in pairs, O2,"
    } ]
  }, {
    "tStartMs": 352671,
    "dDurationMs": 4311,
    "segs": [ {
      "utf8": "also combined in threes to form ozone,\nO3, in the upper atmosphere,"
    } ]
  }, {
    "tStartMs": 356992,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "that protects Earth's surface from most"
    } ]
  }, {
    "tStartMs": 358891,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "of the Sun's molecule-hostile\nultraviolet photons."
    } ]
  }, {
    "tStartMs": 362322,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "The remarkable diversity\nof life on Earth"
    } ]
  }, {
    "tStartMs": 364459,
    "dDurationMs": 1865,
    "segs": [ {
      "utf8": "and we presume elsewhere\nin the universe,"
    } ]
  }, {
    "tStartMs": 366334,
    "dDurationMs": 2383,
    "segs": [ {
      "utf8": "is owed to the cosmic\nabundance of carbon,"
    } ]
  }, {
    "tStartMs": 368727,
    "dDurationMs": 4318,
    "segs": [ {
      "utf8": "and the countless number of molecules,\nsimple and complex, made from it."
    } ]
  }, {
    "tStartMs": 373168,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "How can you argue, when there are more\nvarieties of carbon-based molecules"
    } ]
  }, {
    "tStartMs": 377058,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "than all other molecules combined?"
    } ]
  }, {
    "tStartMs": 379731,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "But life is fragile."
    } ]
  }, {
    "tStartMs": 381360,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Earth's encounters with large leftover\nmeteors, a formerly common event,"
    } ]
  }, {
    "tStartMs": 385583,
    "dDurationMs": 2796,
    "segs": [ {
      "utf8": "wreak intermittent havoc\nupon the ecosystem."
    } ]
  }, {
    "tStartMs": 388389,
    "dDurationMs": 4478,
    "segs": [ {
      "utf8": "A mere 65 million years ago,\nless than 2% of Earth's past,"
    } ]
  }, {
    "tStartMs": 392877,
    "dDurationMs": 4112,
    "segs": [ {
      "utf8": "a ten trillion ton asteroid hit\nwhat is now the Yucatan peninsula,"
    } ]
  }, {
    "tStartMs": 396999,
    "dDurationMs": 4441,
    "segs": [ {
      "utf8": "and obliterated over 70% of Earth's\nspecies of flora and fauna,"
    } ]
  }, {
    "tStartMs": 401450,
    "dDurationMs": 3369,
    "segs": [ {
      "utf8": "including dinosaurs,\nthe dominant land animals."
    } ]
  }, {
    "tStartMs": 404829,
    "dDurationMs": 2871,
    "segs": [ {
      "utf8": "This ecological tragedy\npried open an opportunity"
    } ]
  }, {
    "tStartMs": 407710,
    "dDurationMs": 4231,
    "segs": [ {
      "utf8": "for small surviving mammals to\nfill freshly vacant niches."
    } ]
  }, {
    "tStartMs": 411951,
    "dDurationMs": 3918,
    "segs": [ {
      "utf8": "One big-brained branch of these mammals,\nthat which we call primates,"
    } ]
  }, {
    "tStartMs": 415879,
    "dDurationMs": 3157,
    "segs": [ {
      "utf8": "evolved a genus and a\nspecies, homo sapiens,"
    } ]
  }, {
    "tStartMs": 419046,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "to a level of intelligence\nthat enabled them"
    } ]
  }, {
    "tStartMs": 421425,
    "dDurationMs": 4226,
    "segs": [ {
      "utf8": "to invent methods and tools of\nscience, to invent astrophysics,"
    } ]
  }, {
    "tStartMs": 425661,
    "dDurationMs": 3686,
    "segs": [ {
      "utf8": "and to deduce the origin and\nevolution of the universe."
    } ]
  }, {
    "tStartMs": 430258,
    "dDurationMs": 2094,
    "segs": [ {
      "utf8": "Yes, the universe had a beginning."
    } ]
  }, {
    "tStartMs": 432362,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "Yes, the universe continues to evolve."
    } ]
  }, {
    "tStartMs": 434973,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And yes, every one of our\nbodies atoms is traceable"
    } ]
  }, {
    "tStartMs": 438193,
    "dDurationMs": 4239,
    "segs": [ {
      "utf8": "to the Big Bang and to the thermonuclear\nfurnace within high mass stars."
    } ]
  }, {
    "tStartMs": 442442,
    "dDurationMs": 3219,
    "segs": [ {
      "utf8": "We are not simply in the\nuniverse, we are part of it."
    } ]
  }, {
    "tStartMs": 445671,
    "dDurationMs": 1345,
    "segs": [ {
      "utf8": "We are born from it."
    } ]
  }, {
    "tStartMs": 447026,
    "dDurationMs": 4643,
    "segs": [ {
      "utf8": "One might even say, we've been empowered\nby the universe to figure itself out."
    } ]
  }, {
    "tStartMs": 452228,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "And we've only just begun."
    } ]
  }, {
    "tStartMs": 455070,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "I'm Neil deGrasse Tyson,"
    } ]
  }, {
    "tStartMs": 456521,
    "dDurationMs": 2691,
    "segs": [ {
      "utf8": "astrophysicist and the\nFrederick P. Rose Director"
    } ]
  }, {
    "tStartMs": 459222,
    "dDurationMs": 2274,
    "segs": [ {
      "utf8": "of New York City's Hayden Planetarium."
    } ]
  }, {
    "tStartMs": 462857,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "Keep looking up."
    } ]
  } ]
}
