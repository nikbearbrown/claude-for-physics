  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 9330,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Sounds ethereal, right?"
    } ]
  }, {
    "tStartMs": 10550,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "This is the sound of hydrogen, the most common\nelement in the universe."
    } ]
  }, {
    "tStartMs": 15610,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "It's the simplest atom, the building block\nof stars, and the stuff that turns unsaturated"
    } ]
  }, {
    "tStartMs": 19810,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "fat into saturated fat."
    } ]
  }, {
    "tStartMs": 22330,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "It also blew up the Hindenburg."
    } ]
  }, {
    "tStartMs": 24500,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But how are we listening to hydrogen?"
    } ]
  }, {
    "tStartMs": 26340,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It doesn't normally make noise, does it?"
    } ]
  }, {
    "tStartMs": 28800,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Well, atomic hydrogen absorbs and emits radiation\nat certain frequencies: its atomic spectrum."
    } ]
  }, {
    "tStartMs": 33780,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "And, if hydrogen emitted sound waves instead\nof light waves, this is what it would sound"
    } ]
  }, {
    "tStartMs": 38390,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "like (though I did pitch-shift it down so\nit would be audible to the human ear)"
    } ]
  }, {
    "tStartMs": 43080,
    "dDurationMs": 4649,
    "segs": [ {
      "utf8": "So, just like you might have seen false-color\npictures of galaxies and planets made by shifting"
    } ]
  }, {
    "tStartMs": 47729,
    "dDurationMs": 6250,
    "segs": [ {
      "utf8": "infrared or radio-wave images into the visible\nspectrum, this is a false-pitch sound, shifted"
    } ]
  }, {
    "tStartMs": 53979,
    "dDurationMs": 1951,
    "segs": [ {
      "utf8": "into the audible spectrum."
    } ]
  }, {
    "tStartMs": 55930,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And it's what our eyes hear when they see\nthis:"
    } ]
  }, {
    "tStartMs": 58960,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "Enjoy"
    } ]
  } ]
}
