{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 140,
    "dDurationMs": 1253,
    "segs": [ {
      "utf8": "What do we really mean by \"near\" and \"far\"?"
    } ]
  }, {
    "tStartMs": 1393,
    "dDurationMs": 4987,
    "segs": [ {
      "utf8": "In a way, distance is just a measure of how\nhard it is to get between two points."
    } ]
  }, {
    "tStartMs": 6380,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The harder to get from here to there, the\nmore distant \"there\" is."
    } ]
  }, {
    "tStartMs": 10660,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Thinking about distance in multiple dimensions\nis easy now!"
    } ]
  }, {
    "tStartMs": 13720,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "In two spatial dimensions, a point a mile\nnorth and a mile east is more distant than"
    } ]
  }, {
    "tStartMs": 17940,
    "dDurationMs": 3149,
    "segs": [ {
      "utf8": "one that's just a mile east - it's harder\nto get to."
    } ]
  }, {
    "tStartMs": 21089,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "What about one space and one time dimension?"
    } ]
  }, {
    "tStartMs": 23990,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "Easy as well!"
    } ]
  }, {
    "tStartMs": 25260,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Getting to a point a mile east in 10 minutes\nis a lot harder than getting there in 10 hours"
    } ]
  }, {
    "tStartMs": 29430,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "-\nso one mile east and 10 minutes in the future"
    } ]
  }, {
    "tStartMs": 31669,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "is way more distant than 1 mile east and a\nday in the future."
    } ]
  }, {
    "tStartMs": 35310,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "And a point that's a mile east right now is\nimpossible to get to - so it's super distant!"
    } ]
  }, {
    "tStartMs": 40100,
    "dDurationMs": 3509,
    "segs": [ {
      "utf8": "But hold on - that would mean that 10 minutes\nis farther away than 10 hours!"
    } ]
  }, {
    "tStartMs": 43609,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "Doesn't that seem backwards?"
    } ]
  }, {
    "tStartMs": 44679,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It kind of is - but it's the way the universe\nworks:"
    } ]
  }, {
    "tStartMs": 47769,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "in special relativity, more time equals less\ndistance!"
    } ]
  }, {
    "tStartMs": 51710,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "So distance in time is negative!"
    } ]
  }, {
    "tStartMs": 54079,
    "dDurationMs": 4221,
    "segs": [ {
      "utf8": "And if you travel east and into the future\nin such a way that the negative time \u0026 positive"
    } ]
  }, {
    "tStartMs": 58300,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "space distances cancel out, your total distance\nwill be zero."
    } ]
  }, {
    "tStartMs": 62420,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "And you'll be traveling at the speed of light!"
    } ]
  }, {
    "tStartMs": 64780,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So how far away is tomorrow?"
    } ]
  }, {
    "tStartMs": 66060,
    "dDurationMs": 14559,
    "segs": [ {
      "utf8": "It's closer than you think."
    } ]
  } ]
}
