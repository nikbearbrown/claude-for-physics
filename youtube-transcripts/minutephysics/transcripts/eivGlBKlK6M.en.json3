{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1170,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "This has nothing to do with physics, but I\nwant to make a bet with you and 99 other people:"
    } ]
  }, {
    "tStartMs": 5550,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "100 in total."
    } ]
  }, {
    "tStartMs": 6820,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "You'll all stand in a line, take a one dollar\nbill out of your pocket and write your position"
    } ]
  }, {
    "tStartMs": 10490,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "in line on the bill."
    } ]
  }, {
    "tStartMs": 12019,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "Then I'll collect the bills, take them to\na separate room, put each one into its own"
    } ]
  }, {
    "tStartMs": 15400,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "one of 100 identical boxes, and randomly rearrange\nthe boxes."
    } ]
  }, {
    "tStartMs": 19400,
    "dDurationMs": 4209,
    "segs": [ {
      "utf8": "The game is this: each of you come into the\nroom and try to find which box your bill is"
    } ]
  }, {
    "tStartMs": 23609,
    "dDurationMs": 3691,
    "segs": [ {
      "utf8": "in - but you're only allowed to come in one\nat a time, you're only allowed to peek in"
    } ]
  }, {
    "tStartMs": 27300,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "half of the boxes, and you aren't allowed\nto change anything about the boxes or move"
    } ]
  }, {
    "tStartMs": 31800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "bills around."
    } ]
  }, {
    "tStartMs": 32800,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "If you find your own bill, great!"
    } ]
  }, {
    "tStartMs": 34989,
    "dDurationMs": 3151,
    "segs": [ {
      "utf8": "Show me that you've succeeded and then leave\nthe bill in its box."
    } ]
  }, {
    "tStartMs": 38140,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "And regardless of whether or not you find\nyour bill, you have to leave the room by a"
    } ]
  }, {
    "tStartMs": 40790,
    "dDurationMs": 3839,
    "segs": [ {
      "utf8": "different route so you can't tell anyone else\nwhat you've seen, and the room is then reset"
    } ]
  }, {
    "tStartMs": 44629,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "before the next person comes in."
    } ]
  }, {
    "tStartMs": 46499,
    "dDurationMs": 4781,
    "segs": [ {
      "utf8": "At the end, if all 100 of you have successfully\nfound your own bills, you all win and I'll"
    } ]
  }, {
    "tStartMs": 51280,
    "dDurationMs": 3009,
    "segs": [ {
      "utf8": "give each of you a hundred dollars plus the\none you started with!"
    } ]
  }, {
    "tStartMs": 54289,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "But if any one of you doesn't find your bill…"
    } ]
  }, {
    "tStartMs": 56379,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "I keep all the dollars."
    } ]
  }, {
    "tStartMs": 58429,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "You are allowed to plan a strategy together\nwith the other players before any of you come"
    } ]
  }, {
    "tStartMs": 61709,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "into the room, but no communication afterwards."
    } ]
  }, {
    "tStartMs": 64619,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The question is this: should you take the\nbet?"
    } ]
  }, {
    "tStartMs": 66659,
    "dDurationMs": 5950,
    "segs": [ {
      "utf8": "To recap, every person gets to look in half\nof the boxes, there's no communication between"
    } ]
  }, {
    "tStartMs": 72609,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "players after they go into the room, and you\nonly win if every single person finds their"
    } ]
  }, {
    "tStartMs": 76710,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "own bill."
    } ]
  }, {
    "tStartMs": 77710,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "$101 dollar payout if you win, nothing if\nyou lose."
    } ]
  }, {
    "tStartMs": 81140,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Take a moment to think about it, then click\nthe links on screen or in the description"
    } ]
  }, {
    "tStartMs": 84820,
    "dDurationMs": 3229,
    "segs": [ {
      "utf8": "to make your choice - and find out what the\ncorrect answer is."
    } ]
  } ]
}
