  "events": [ {
    "tStartMs": 1709,
    "dDurationMs": 4871,
    "segs": [ {
      "utf8": "In a recent freddiew video, Freddie and Brandon\nintroduced a superhero who vomits milk to"
    } ]
  }, {
    "tStartMs": 6580,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "thwart his enemies, and as a means of transportation."
    } ]
  }, {
    "tStartMs": 8990,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "This is disgusting."
    } ]
  }, {
    "tStartMs": 9990,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So naturally, I immediately wondered how much\nmilk you'd actually have to drink (and expel)"
    } ]
  }, {
    "tStartMs": 14090,
    "dDurationMs": 1719,
    "segs": [ {
      "utf8": "in order to hover like Milkman."
    } ]
  }, {
    "tStartMs": 15809,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Turns out, it's a lot!"
    } ]
  }, {
    "tStartMs": 17689,
    "dDurationMs": 3691,
    "segs": [ {
      "utf8": "Using basic rocket science, you can calculate\nthat an average person will need to vomit"
    } ]
  }, {
    "tStartMs": 21380,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "around 5 gallons of milk each second in order\nto hover!"
    } ]
  }, {
    "tStartMs": 24220,
    "dDurationMs": 2209,
    "segs": [ {
      "utf8": "You know those videos of water jetpacks?"
    } ]
  }, {
    "tStartMs": 26429,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Replace that water with milk coming out of\nyour mouth, and you get the rough idea."
    } ]
  }, {
    "tStartMs": 30119,
    "dDurationMs": 3751,
    "segs": [ {
      "utf8": "So either MilkMan would have to be carrying\na LOT more milk around with him, or else he"
    } ]
  }, {
    "tStartMs": 33870,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "must use special milk that's super-dense - like,\nmercury milk, or molten-lead milk."
    } ]
  }, {
    "tStartMs": 39560,
    "dDurationMs": 10689,
    "segs": [ {
      "utf8": "Either way, definitely \na superpower!"
    } ]
  } ]
}
