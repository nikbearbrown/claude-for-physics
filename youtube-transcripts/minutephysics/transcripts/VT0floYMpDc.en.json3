  "events": [ {
    "tStartMs": 260,
    "dDurationMs": 1719,
    "segs": [ {
      "utf8": "Dear citizens of the universe,"
    } ]
  }, {
    "tStartMs": 1979,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "You probably know that light can reach two\nhundred ninety nine thousand, seven hundred"
    } ]
  }, {
    "tStartMs": 4930,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "ninety two measly kilometers in a second,\nbut did you also know that physics can now"
    } ]
  }, {
    "tStartMs": 8590,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "reach over two hundred ninety nine thousand,\nseven hundred ninety two amazing people in"
    } ]
  }, {
    "tStartMs": 11730,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "a minute?"
    } ]
  }, {
    "tStartMs": 12730,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "We've broken the speed of light!"
    } ]
  }, {
    "tStartMs": 13809,
    "dDurationMs": 3191,
    "segs": [ {
      "utf8": "Of course, what I'm really trying to say is,\nwhen I made the first MinutePhysics video"
    } ]
  }, {
    "tStartMs": 17000,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "in the corner of my bedroom last summer, I\nhad no idea that it would reach this many"
    } ]
  }, {
    "tStartMs": 20020,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "spectacular people."
    } ]
  }, {
    "tStartMs": 21350,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "If you're watching, thanks."
    } ]
  }, {
    "tStartMs": 22750,
    "dDurationMs": 1539,
    "segs": [ {
      "utf8": "I couldn't do this without you."
    } ]
  }, {
    "tStartMs": 24289,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "And if you're a scientist or science lover\nanywhere on earth, I couldn't do this without"
    } ]
  }, {
    "tStartMs": 27240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "you, either."
    } ]
  }, {
    "tStartMs": 28240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "So thanks."
    } ]
  }, {
    "tStartMs": 29240,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "Thank you all for your support, and thanks\nfor helping share the awesomeness of the universe"
    } ]
  }, {
    "tStartMs": 31439,
    "dDurationMs": 1451,
    "segs": [ {
      "utf8": "with the world!"
    } ]
  }, {
    "tStartMs": 32890,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yours truly,"
    } ]
  }, {
    "tStartMs": 33890,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Henry Reich"
    } ]
  }, {
    "tStartMs": 34890,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "p.s."
    } ]
  }, {
    "tStartMs": 35890,
    "dDurationMs": 2559,
    "segs": [ {
      "utf8": "if you'd like to download and watch MinutePhysics\non your own time, it's now available as a"
    } ]
  }, {
    "tStartMs": 38449,
    "dDurationMs": 15540,
    "segs": [ {
      "utf8": "free podcast on iTunes."
    } ]
  } ]
}
