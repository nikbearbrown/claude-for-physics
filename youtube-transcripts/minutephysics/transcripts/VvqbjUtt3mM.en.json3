  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Common mirror glass reflects around half the light that hits it"
    } ]
  }, {
    "tStartMs": 3340,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "from either side, and lets half through."
    } ]
  }, {
    "tStartMs": 4940,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "So in a dark room where the only light is that half,"
    } ]
  }, {
    "tStartMs": 7240,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "you will see the other side easily,"
    } ]
  }, {
    "tStartMs": 8480,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but in the bright room, the 50% reflected bright light"
    } ]
  }, {
    "tStartMs": 10580,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "will swamp the dark light from the other side."
    } ]
  } ]
}
