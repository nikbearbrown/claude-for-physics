{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 149,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Hey Internet!"
    } ]
  }, {
    "tStartMs": 1149,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "Did you know that if we look into the farthest\nreaches of the night sky, past all the stars"
    } ]
  }, {
    "tStartMs": 4460,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "and galaxies and superclusters of galaxies,\nwe see light that’s basically a picture"
    } ]
  }, {
    "tStartMs": 8160,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "of the big bang and has been traveling for\n13.7 billion years to reach earth?"
    } ]
  }, {
    "tStartMs": 12429,
    "dDurationMs": 3971,
    "segs": [ {
      "utf8": "To help you learn more about how awesome this\n“Cosmic Background Radiation” is, we’ve"
    } ]
  }, {
    "tStartMs": 16400,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "built a cool map that lets you explore the\nearliest picture of our universe."
    } ]
  }, {
    "tStartMs": 19830,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Welcome to BigBangRegistry.com."
    } ]
  }, {
    "tStartMs": 21880,
    "dDurationMs": 4489,
    "segs": [ {
      "utf8": "Now, scientists who measure the temperature\nof this ancient radiation have noticed that"
    } ]
  }, {
    "tStartMs": 26369,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "it’s hotter or colder in different parts\nof the sky, which they usually draw as red"
    } ]
  }, {
    "tStartMs": 29699,
    "dDurationMs": 1151,
    "segs": [ {
      "utf8": "and blue blobs."
    } ]
  }, {
    "tStartMs": 30850,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "But  since this is the oldest light in the\nuniverse, we thought it deserves a bit more"
    } ]
  }, {
    "tStartMs": 34340,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "excitement, so we've drawn the \"hot spots\"\nas mountains, the “cold spots” as oceans..."
    } ]
  }, {
    "tStartMs": 38340,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And just tried make the whole thing a lot\nmore fun."
    } ]
  }, {
    "tStartMs": 40230,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Since it can be hard to get oriented on an\nunfamiliar map, we’ve also added constellations"
    } ]
  }, {
    "tStartMs": 44170,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "so you’ll always know what part of the night\nsky you’re seeing."
    } ]
  }, {
    "tStartMs": 46290,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "Not to be outdone by google maps, we have\ndifferent overlays, too - like the same view"
    } ]
  }, {
    "tStartMs": 49760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of the sky as seen in infrared."
    } ]
  }, {
    "tStartMs": 51560,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Hey!"
    } ]
  }, {
    "tStartMs": 52560,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Here’s Andromeda!"
    } ]
  }, {
    "tStartMs": 53560,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Just click on the labeled astronomical objects\nto see sweet pictures and learn more about"
    } ]
  }, {
    "tStartMs": 57140,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "them."
    } ]
  }, {
    "tStartMs": 58140,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "But what about the Cosmic Background Radiation?"
    } ]
  }, {
    "tStartMs": 59370,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "It also has tons of cool features, they’re\njust not labeled yet."
    } ]
  }, {
    "tStartMs": 62710,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "So we invite you to pick your own special\nspot on the map, (just hold shift and click)"
    } ]
  }, {
    "tStartMs": 66080,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "and choose a name that will become part of\nthe MinutePhysics map of the cosmos."
    } ]
  }, {
    "tStartMs": 69130,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "You’ll be supporting MinutePhysics, which\nmeans supporting present and future science"
    } ]
  }, {
    "tStartMs": 72870,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "awesomeness..."
    } ]
  }, {
    "tStartMs": 73870,
    "dDurationMs": 16450,
    "segs": [ {
      "utf8": "Thanks."
    } ]
  } ]
}
