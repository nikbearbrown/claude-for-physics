{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 149,
    "dDurationMs": 4711,
    "segs": [ {
      "utf8": "You may have heard physicists describe the\nmoon as being 1.3 light-seconds away, or the"
    } ]
  }, {
    "tStartMs": 4860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "sun as 8 light-minutes away, and thought \"what\nis this nonsense?"
    } ]
  }, {
    "tStartMs": 8280,
    "dDurationMs": 1649,
    "segs": [ {
      "utf8": "measuring distances with time?\""
    } ]
  }, {
    "tStartMs": 9929,
    "dDurationMs": 3551,
    "segs": [ {
      "utf8": "But actually, we measure distances using time\nalmost every day."
    } ]
  }, {
    "tStartMs": 13480,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "How far is it from your house to the store?"
    } ]
  }, {
    "tStartMs": 15679,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "About ten minutes."
    } ]
  }, {
    "tStartMs": 16679,
    "dDurationMs": 2171,
    "segs": [ {
      "utf8": "And how far is it from New York to Boston?"
    } ]
  }, {
    "tStartMs": 18850,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "About four hours."
    } ]
  }, {
    "tStartMs": 19980,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Los Angeles to Sydney?"
    } ]
  }, {
    "tStartMs": 20980,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "14 hours."
    } ]
  }, {
    "tStartMs": 21980,
    "dDurationMs": 4869,
    "segs": [ {
      "utf8": "But of course, what we really mean is that\nthe store is ten bike-minutes from your house,"
    } ]
  }, {
    "tStartMs": 26849,
    "dDurationMs": 5141,
    "segs": [ {
      "utf8": "New York is 4 car-hours from Boston, and Sydney\nis 14 plane-hours from LA."
    } ]
  }, {
    "tStartMs": 31990,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "In fact, using time to measure distances is\nso useful that I only know the distance from"
    } ]
  }, {
    "tStartMs": 36420,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "LA to Sydney in plane-hours, not miles or\nkilometers…"
    } ]
  }, {
    "tStartMs": 39630,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "though I suppose I could figure it out by\nmultiplying 14 plane-hours by the 550-miles-per-hour"
    } ]
  }, {
    "tStartMs": 43920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "speed of a plane to get roughly 7500 miles."
    } ]
  }, {
    "tStartMs": 46440,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "But Sydney is also 5 sailboat-weeks from LA,\n7 humpback-whale months from LA, 5 message-in-a-bottle"
    } ]
  }, {
    "tStartMs": 52720,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "years from LA, and 0.04 light-seconds from\nLA."
    } ]
  }, {
    "tStartMs": 56990,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "On the other hand, the moon is 18 airplane-days\naway, 6 car-months away, and 15 whale-years"
    } ]
  }, {
    "tStartMs": 62990,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "away."
    } ]
  }, {
    "tStartMs": 63990,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Which means, in fact, that a whale might swim\nas far as the distance to the moon over the"
    } ]
  }, {
    "tStartMs": 67050,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "course of its lifetime ."
    } ]
  }, {
    "tStartMs": 68050,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And if that's not crazy enough, sometimes\nwe even measure times in distance!"
    } ]
  }, {
    "tStartMs": 71970,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "How long is a movie?"
    } ]
  }, {
    "tStartMs": 73410,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "8,000 feet – of film!"
    } ]
  }, {
    "tStartMs": 75550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And MinutePhysics?"
    } ]
  }, {
    "tStartMs": 77620,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "30 meters."
    } ]
  } ]
}
