  "events": [ {
    "tStartMs": 1410,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "How long is a day on the sun?"
    } ]
  }, {
    "tStartMs": 3910,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "at first might seem like a stupid question."
    } ]
  }, {
    "tStartMs": 6130,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "A day is how long it takes the sun to come\nback overhead."
    } ]
  }, {
    "tStartMs": 8769,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "Doesn’t happen on the sun, unless you’re\nstanding upside down, in which case days on"
    } ]
  }, {
    "tStartMs": 12410,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "the sun are infinitesimally short and your\nhair is on fire."
    } ]
  }, {
    "tStartMs": 15550,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "But maybe a day is how long it takes to spin\naround relative to the distant stars, in which"
    } ]
  }, {
    "tStartMs": 20410,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "case different parts of the sun have different\ndays because it’s a big ball of flowing,"
    } ]
  }, {
    "tStartMs": 24460,
    "dDurationMs": 4309,
    "segs": [ {
      "utf8": "gassy plasma and different parts rotate at\ndifferent rates: relative to distant stars,"
    } ]
  }, {
    "tStartMs": 28769,
    "dDurationMs": 4501,
    "segs": [ {
      "utf8": "the sun’s equator rotates once every 24\nand a half earth days, while near the poles"
    } ]
  }, {
    "tStartMs": 33270,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "it rotates roughly every 34 earth days."
    } ]
  }, {
    "tStartMs": 35980,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Or maybe a day is simply eighty six thousand\nand four hundred seconds, in which case a"
    } ]
  }, {
    "tStartMs": 40600,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "day on the sun is slightly longer than a day\non the earth due to gravitational time dilation."
    } ]
  }, {
    "tStartMs": 45700,
    "dDurationMs": 5710,
    "segs": [ {
      "utf8": "Or maybe a day is the time a human can survive\nwithout breathing, times 360, in which case"
    } ]
  }, {
    "tStartMs": 51410,
    "dDurationMs": 19640,
    "segs": [ {
      "utf8": "a day on the sun is… definitely your last."
    } ]
  } ]
}
