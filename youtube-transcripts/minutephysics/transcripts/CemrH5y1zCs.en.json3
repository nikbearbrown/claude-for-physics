  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 1699,
    "segs": [ {
      "utf8": "Dear US Citizens,"
    } ]
  }, {
    "tStartMs": 1859,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "On this glorious day, YOU get to help decide\nhow the universe will work!"
    } ]
  }, {
    "tStartMs": 5400,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "(or at least, the small but awesome part of\nit called the United States of America)"
    } ]
  }, {
    "tStartMs": 9960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "All you need to do is go and vote!"
    } ]
  }, {
    "tStartMs": 12040,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And guess what - the internet has even made\nit easy for you!"
    } ]
  }, {
    "tStartMs": 14260,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "If you go to this website and type in your\naddress, google will not only tell you where"
    } ]
  }, {
    "tStartMs": 17920,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "your polling place is, but also who's on your\nlocal ballot."
    } ]
  }, {
    "tStartMs": 21480,
    "dDurationMs": 14130,
    "segs": [ {
      "utf8": "So as Hank Green of Vlogbrothers so eloquently\nput it: don't forget to vote, America!"
    } ]
  } ]
}
