  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The observable universe is 93 billion light\nyears across."
    } ]
  }, {
    "tStartMs": 3700,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But just how big is that?"
    } ]
  }, {
    "tStartMs": 5160,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Well, it's roughly 100 quintillion (10^20)\ntimes the size of the Earth."
    } ]
  }, {
    "tStartMs": 8620,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "For comparison, imagine taking this whole\n1920 pixel by 1080 pixel video and making"
    } ]
  }, {
    "tStartMs": 13930,
    "dDurationMs": 2289,
    "segs": [ {
      "utf8": "just one pixel white and the rest black."
    } ]
  }, {
    "tStartMs": 16219,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "If you were to take each row of one thousand,\nnine hundred and twenty pixels and string"
    } ]
  }, {
    "tStartMs": 20039,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "them all end to end, then shrink that huge\ndistance down to the size of one pixel of"
    } ]
  }, {
    "tStartMs": 24429,
    "dDurationMs": 4661,
    "segs": [ {
      "utf8": "the video, string the new video's pixels out\nend to end, shrink it all down AGAIN to the"
    } ]
  }, {
    "tStartMs": 29090,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "size of one pixel of video, and string the\npixels out end to end once more..."
    } ]
  }, {
    "tStartMs": 33870,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "that one tiny white pixel represents the earth,\nand the string of all the pixels all together,"
    } ]
  }, {
    "tStartMs": 39390,
    "dDurationMs": 37690,
    "segs": [ {
      "utf8": "is one tenth of the diameter of the observable\nuniverse."
    } ]
  } ]
}
