{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 900,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It took Clyde Tombaugh half a year"
    } ]
  }, {
    "tStartMs": 3140,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "of manually looking at photographic"
    } ]
  }, {
    "tStartMs": 4860,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "plates, contains over two million stars"
    } ]
  }, {
    "tStartMs": 6880,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "before he discovered Pluto."
    } ]
  }, {
    "tStartMs": 8760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and its in our own solar system."
    } ]
  }, {
    "tStartMs": 10840,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So how on earth, does one find a planet orbiting a distant star?"
    } ]
  }, {
    "tStartMs": 14960,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "You could just look,"
    } ]
  }, {
    "tStartMs": 16320,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "but stars are so far away,"
    } ]
  }, {
    "tStartMs": 17660,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and so bright compared to their planets,"
    } ]
  }, {
    "tStartMs": 19360,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "that its really hard to just look at one, and see a planet orbiting it."
    } ]
  }, {
    "tStartMs": 22740,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Direct discovery of new exoplanets by"
    } ]
  }, {
    "tStartMs": 25040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "just looking, is essentially limited to"
    } ]
  }, {
    "tStartMs": 27380,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "relatively nearby stars,"
    } ]
  }, {
    "tStartMs": 28840,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "with very large planets, very far away from them."
    } ]
  }, {
    "tStartMs": 31380,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Think 10 times the size of jupiter, and an orbit at least as big."
    } ]
  }, {
    "tStartMs": 35280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The vast majority of exoplanets,"
    } ]
  }, {
    "tStartMs": 37520,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "have been found indirectly, by observing their effects on their parents stars."
    } ]
  }, {
    "tStartMs": 41300,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "For example, a planet passing in front of a star will make"
    } ]
  }, {
    "tStartMs": 44360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that star darker for a little while."
    } ]
  }, {
    "tStartMs": 46200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and the amount it darkens, will tell you about the size of the planet, relative to the size of the star."
    } ]
  }, {
    "tStartMs": 50600,
    "dDurationMs": 6060,
    "segs": [ {
      "utf8": "of course this only works if the planets orbit is tilted perfectly to pass between us and its star."
    } ]
  }, {
    "tStartMs": 56660,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "and on average less than 1% of earth like planets will have this convenient orbital orientation."
    } ]
  }, {
    "tStartMs": 62060,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "We have managed to find a lot of exoplanets this way,"
    } ]
  }, {
    "tStartMs": 64760,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "by exhaustive satellite searches."
    } ]
  }, {
    "tStartMs": 66820,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "but you could instead have a look at the effect planets have on the motion of stars."
    } ]
  }, {
    "tStartMs": 70840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "as we know, planets don't orbit stars."
    } ]
  }, {
    "tStartMs": 73400,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Rather, both orbit around their combined centre of mass."
    } ]
  }, {
    "tStartMs": 76680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Stars are so heavy, so often the centre of mass is inside the star,"
    } ]
  }, {
    "tStartMs": 80600,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "but the star will nonetheless be moving."
    } ]
  }, {
    "tStartMs": 82780,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "That motion manifests itself as a teeny tiny wobble,"
    } ]
  }, {
    "tStartMs": 86280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "in the velocity of the star relative to us."
    } ]
  }, {
    "tStartMs": 88040,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "which we determine by carefully measuring the red or blue doppler shift"
    } ]
  }, {
    "tStartMs": 91420,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "of the stars light"
    } ]
  }, {
    "tStartMs": 92480,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "both these indirect methods are most effective at finding big planets,"
    } ]
  }, {
    "tStartMs": 96560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "close to their stars,"
    } ]
  }, {
    "tStartMs": 98000,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "because the speeds involved, and the amount of light blocked"
    } ]
  }, {
    "tStartMs": 100260,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "are greater, and also because close planets orbit more often"
    } ]
  }, {
    "tStartMs": 103580,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "so we don't have to wait as long to notice their effects."
    } ]
  }, {
    "tStartMs": 105840,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "There are other more complicated and fancy methods which can find planets"
    } ]
  }, {
    "tStartMs": 110380,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "which are harder to notice by a star wobbling or star light blocking"
    } ]
  }, {
    "tStartMs": 113420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and all of these together have helped to discover"
    } ]
  }, {
    "tStartMs": 116120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "more than 1800 exoplanets"
    } ]
  }, {
    "tStartMs": 118060,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "as of 2014."
    } ]
  }, {
    "tStartMs": 119020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Sorry pluto, you've been Ex-ed out!"
    } ]
  }, {
    "tStartMs": 124120,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "This video is brought to you in part by Audible.com,"
    } ]
  }, {
    "tStartMs": 127560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "The leading provider of audio books across all types of literature, including"
    } ]
  }, {
    "tStartMs": 130840,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "fiction, non-fiction and periodicals."
    } ]
  }, {
    "tStartMs": 133220,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "If you go to audible.com/minutephysics,"
    } ]
  }, {
    "tStartMs": 135400,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "you can try Audible out by downloading a free audiobook of your choice."
    } ]
  }, {
    "tStartMs": 138240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "I would like to recommend the book 'Foundation'."
    } ]
  }, {
    "tStartMs": 139760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's the opening act of Isaac Asimov's"
    } ]
  }, {
    "tStartMs": 142160,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "opening saga about the impending collapse of interstellar civilisation."
    } ]
  }, {
    "tStartMs": 145580,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "You can download your free audiobook at Audible.com/minutephysics"
    } ]
  }, {
    "tStartMs": 149480,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "and I would like to say thanks to Audible for helping me continue to make these videos."
    } ]
  } ]
}
