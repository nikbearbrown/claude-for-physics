  "events": [ {
    "tStartMs": 4200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm Craig Childs, I'm a writer and traveler"
    } ]
  }, {
    "tStartMs": 7200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "from Western Colorado."
    } ]
  }, {
    "tStartMs": 8980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Craig likes to go hiking and exploring in the rough and rugged canyons"
    } ]
  }, {
    "tStartMs": 11880,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "of the Southwest,"
    } ]
  }, {
    "tStartMs": 12500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the ancient territory of the Anasazi."
    } ]
  }, {
    "tStartMs": 14700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But picture him just a few years ago,"
    } ]
  }, {
    "tStartMs": 16500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "standing in a reading room."
    } ]
  }, {
    "tStartMs": 18000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "(Nowhere near the canyons)"
    } ]
  }, {
    "tStartMs": 19000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Right, in front of a display of ancient pottery."
    } ]
  }, {
    "tStartMs": 21800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Inside the cabinet is a collection"
    } ]
  }, {
    "tStartMs": 24100,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "of jars and bowls, that are probably 700-800 years old, and I,"
    } ]
  }, {
    "tStartMs": 29840,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and I recognize the design, and I know where they came from."
    } ]
  }, {
    "tStartMs": 33080,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I know that they came from a part of Arizona"
    } ]
  }, {
    "tStartMs": 35600,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "where I had just spent a month, backpacking."
    } ]
  }, {
    "tStartMs": 38020,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "And I found the place, just entirely looted."
    } ]
  }, {
    "tStartMs": 41380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and, and..."
    } ]
  }, {
    "tStartMs": 43060,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "..I mean, folks had come in and removed everything they could find."
    } ]
  }, {
    "tStartMs": 45620,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "...I mean, folks had come in and removed everything they could find.\nCHRIS: Yeah, yeah."
    } ]
  }, {
    "tStartMs": 46720,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Some archaeologists, but mostly pot hunters,"
    } ]
  }, {
    "tStartMs": 50460,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "people illegally coming in and taking shovels, and digging out burial artifacts."
    } ]
  }, {
    "tStartMs": 56060,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And these artifacts in this little cabinet were,"
    } ]
  }, {
    "tStartMs": 60100,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "were all stolen."
    } ]
  }, {
    "tStartMs": 61600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They, they weren't cataloged,"
    } ]
  }, {
    "tStartMs": 64120,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and in fact they were very roughly handled."
    } ]
  }, {
    "tStartMs": 66560,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Some had been broken and repaired with masking tape, but.."
    } ]
  }, {
    "tStartMs": 69740,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "PERSON: With masking tape?\nCHRIS: And with glue."
    } ]
  }, {
    "tStartMs": 70880,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "PERSON: And Elmer's Glue!\nCHRIS: Yeah."
    } ]
  }, {
    "tStartMs": 72440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "PERSON: And what did the sign say on the thing?"
    } ]
  }, {
    "tStartMs": 75480,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "CHRIS: I think it just said these come from"
    } ]
  }, {
    "tStartMs": 77420,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "CHRIS: Arizona, that was..\nPERSON: So was that, uh.."
    } ]
  }, {
    "tStartMs": 78640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "CHRIS: [INAUDIBLE] percent of it.\nPERSON: ..just it?"
    } ]
  }, {
    "tStartMs": 80160,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "CHRIS: Yeah."
    } ]
  }, {
    "tStartMs": 81180,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "PERSON: So, what did you think and then"
    } ]
  }, {
    "tStartMs": 83640,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "what did you do?"
    } ]
  }, {
    "tStartMs": 85700,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "CHRIS: Well, I had been very frustrated at"
    } ]
  }, {
    "tStartMs": 89300,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "seeing this landscape that had been"
    } ]
  }, {
    "tStartMs": 90940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "completely looted and I\nthought, \"you know what?"
    } ]
  }, {
    "tStartMs": 93220,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I need to take something back\","
    } ]
  }, {
    "tStartMs": 96060,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and so I, I broke into the display case."
    } ]
  }, {
    "tStartMs": 100260,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "when we do this at night or how did you\nhow did you get by the security I just"
    } ]
  }, {
    "tStartMs": 104610,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "did it when I kept an eye on the room\nand saw when nobody was in there and"
    } ]
  }, {
    "tStartMs": 107700,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "were you dressed in black and hanging\nfrom the ceiling?"
    } ]
  }, {
    "tStartMs": 112570,
    "dDurationMs": 6659,
    "segs": [ {
      "utf8": "I was looking like I look now how do you\ndid you get that glass cutter I cut"
    } ]
  }, {
    "tStartMs": 119229,
    "dDurationMs": 5731,
    "segs": [ {
      "utf8": "around the molding of the of the glass\nand removed the glass plate and reached"
    } ]
  }, {
    "tStartMs": 124960,
    "dDurationMs": 3779,
    "segs": [ {
      "utf8": "in and took one of the jars that have\nbeen actually split in half with a"
    } ]
  }, {
    "tStartMs": 128739,
    "dDurationMs": 6061,
    "segs": [ {
      "utf8": "shovel I am not a good thief I nearly\npissed my pants in the middle of it and"
    } ]
  }, {
    "tStartMs": 134800,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "then I rearranged all the jars and and\nblew on the dust so it would resettle"
    } ]
  }, {
    "tStartMs": 139510,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "and look like nothing had ever changed\nand then and then I went down to the"
    } ]
  }, {
    "tStartMs": 145420,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Apache reservation the White Mountain\nApache reservation in central Arizona"
    } ]
  }, {
    "tStartMs": 149140,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "and walked for two weeks with this this\non my back down through all these"
    } ]
  }, {
    "tStartMs": 155260,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "canyons looking for the the right place\nto put it back. In one sense I was I was"
    } ]
  }, {
    "tStartMs": 160330,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "pushing against the tide of all these\nartifacts that are coming out of the"
    } ]
  }, {
    "tStartMs": 164140,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "millions and millions of objects that\nare disappearing from the land I was I"
    } ]
  }, {
    "tStartMs": 168700,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "was putting one back in and just pushing\nagainst that but the same time I"
    } ]
  }, {
    "tStartMs": 174099,
    "dDurationMs": 4051,
    "segs": [ {
      "utf8": "immediately started questioning what I\nwas doing because I thought oh you're"
    } ]
  }, {
    "tStartMs": 178150,
    "dDurationMs": 3179,
    "segs": [ {
      "utf8": "just doing what everybody else has done\nyou're stealing it because you think you"
    } ]
  }, {
    "tStartMs": 181329,
    "dDurationMs": 5581,
    "segs": [ {
      "utf8": "know the right thing to do with it. where\ndid you finally put it I climbed up this"
    } ]
  }, {
    "tStartMs": 186910,
    "dDurationMs": 7260,
    "segs": [ {
      "utf8": "is this cliff face where there was a\nlittle tiny cave alcove about the size"
    } ]
  }, {
    "tStartMs": 194170,
    "dDurationMs": 7260,
    "segs": [ {
      "utf8": "of a bread loaf just a little hole in a\ncliff and I and I slid the vessel into"
    } ]
  }, {
    "tStartMs": 201430,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "it and set it back there where I I don't\nthink people will find it for centuries"
    } ]
  }, {
    "tStartMs": 206880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "the moment at which you place it have\nbeen that little alcove you're there"
    } ]
  }, {
    "tStartMs": 210640,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "your hand leaves the thing what are you\nthinking at that point I'm I'm thinking"
    } ]
  }, {
    "tStartMs": 216040,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "if anybody else finds us they will see\nthe masking tape and this will really"
    } ]
  }, {
    "tStartMs": 221260,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "confound them"
    } ]
  }, {
    "tStartMs": 225280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Thanks to Robert Krulwich and Jetta Boomrod from Radio Lab for helping out with this"
    } ]
  }, {
    "tStartMs": 228970,
    "dDurationMs": 7560,
    "segs": [ {
      "utf8": "piece. You're welcome. If you haven't yet\nheard the collection of Radio Lab"
    } ]
  }, {
    "tStartMs": 236530,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "episodes this videos a companion to head\nover to radio lab org and look for the"
    } ]
  }, {
    "tStartMs": 240790,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "things, skull, and kilogram episodes.\nThere's also a short audio story I put"
    } ]
  }, {
    "tStartMs": 245110,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "together while visiting the radio lab\nteam in New York."
    } ]
  } ]
}
