  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 299,
    "dDurationMs": 3291,
    "segs": [ {
      "utf8": "We've all been told that the colors of the\nrainbow correspond to different wavelengths"
    } ]
  }, {
    "tStartMs": 3590,
    "dDurationMs": 6260,
    "segs": [ {
      "utf8": "of visible light - red, orange, yellow, green,\nblue, and violet. Where's pink in that list?"
    } ]
  }, {
    "tStartMs": 9850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It's not there. There's simply no pink light."
    } ]
  }, {
    "tStartMs": 11950,
    "dDurationMs": 4469,
    "segs": [ {
      "utf8": "So where does pink come from? It turns out\nthat pink, (or magenta, fuchsia, or whatever"
    } ]
  }, {
    "tStartMs": 16419,
    "dDurationMs": 4631,
    "segs": [ {
      "utf8": "you want to call it) is actually a mix of\nred and blue light - light from both ends"
    } ]
  }, {
    "tStartMs": 21050,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "of the rainbow that our brains see as one single color."
    } ]
  }, {
    "tStartMs": 24019,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "If you try to roll up the rainbow to make\na color wheel, there'll be a gap between red"
    } ]
  }, {
    "tStartMs": 27689,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and blue. That's where all of the rest of\nthe light in the universe is supposed to go"
    } ]
  }, {
    "tStartMs": 30809,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "- radio waves, microwaves, infrared, ultraviolet,\nx-rays, gamma rays, and so on. But since we"
    } ]
  }, {
    "tStartMs": 36379,
    "dDurationMs": 4351,
    "segs": [ {
      "utf8": "can't see any of those wavelengths, we replace\nall that hidden grandeur with pink."
    } ]
  }, {
    "tStartMs": 40730,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "And speaking in terms of light, pink should\nprobably be called \"minus-green\", because"
    } ]
  }, {
    "tStartMs": 45230,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "pink is what's left over from white light\nwhen you take out the green."
    } ]
  } ]
}
