{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1400,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "The Earth spins once per day."
    } ]
  }, {
    "tStartMs": 3300,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Which means that if you live at the Equator,"
    } ]
  }, {
    "tStartMs": 4820,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "The surface of the Earth with you on it,"
    } ]
  }, {
    "tStartMs": 6400,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "is moving around a thousand miles per hour to the East,"
    } ]
  }, {
    "tStartMs": 9420,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "relative to the centre of the Earth."
    } ]
  }, {
    "tStartMs": 11200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Even at 45º latitude,"
    } ]
  }, {
    "tStartMs": 13200,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "the Earth's surface is moving 700 miles per hour to the East."
    } ]
  }, {
    "tStartMs": 16540,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "So it kinda seems like it should be faster for airplanes to fly west."
    } ]
  }, {
    "tStartMs": 20180,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "I mean, their destination is literally spinning towards them."
    } ]
  }, {
    "tStartMs": 23100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "At the same time however, they are spinning away from their destination."
    } ]
  }, {
    "tStartMs": 27100,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "When we say the earth is going 1000 mph to the east,"
    } ]
  }, {
    "tStartMs": 30340,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "that means that the ground, and airplanes on the ground, and even the air above the ground are all also moving 1000 mph to the east."
    } ]
  }, {
    "tStartMs": 37540,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "For an airplane to get anywhere, it has to start moving relative to the ground and through the air"
    } ]
  }, {
    "tStartMs": 42180,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "at something like 100 or so mph."
    } ]
  }, {
    "tStartMs": 44980,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "So when it flies east, it's actually moving 1000 plus 100 mph to the east,"
    } ]
  }, {
    "tStartMs": 49920,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "and when it flies west, it's actually moving 1000 minus 100 mph, to the east."
    } ]
  }, {
    "tStartMs": 55460,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Yes, to go west you go east, just slower than the Earth is going east."
    } ]
  }, {
    "tStartMs": 59240,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "Unless you're within ten or so miles of the poles, in which case a brisk westward walk will take you legitimately west."
    } ]
  }, {
    "tStartMs": 65560,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "That said, planes do often take different amounts of time to fly the same route in different directions,"
    } ]
  }, {
    "tStartMs": 70880,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "because of winds in the upper atmosphere like the jetstream that they either have at their tail, or have to fly into."
    } ]
  }, {
    "tStartMs": 76160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The prevailing direction of these winds is largely caused by the Coriolis effect,"
    } ]
  }, {
    "tStartMs": 80160,
    "dDurationMs": 7280,
    "segs": [ {
      "utf8": "which is caused by the fact that different parts of the Earth are moving east at different speeds, which happens because the Earth is round and spinning."
    } ]
  }, {
    "tStartMs": 87440,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "So, airplane travel times are influenced by the rotation of the Earth, just not in a straightforward way."
    } ]
  } ]
}
