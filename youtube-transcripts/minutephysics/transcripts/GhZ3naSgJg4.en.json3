    } ]
  }, {
    "tStartMs": 281060,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "and for a book I'd like to recommend"
    } ]
  }, {
    "tStartMs": 282880,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Creativity, inc. by Ed Catmull"
    } ]
  }, {
    "tStartMs": 284700,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It's about a history of Pixar, why their so consistent that making successful movies"
    } ]
  }, {
    "tStartMs": 288940,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the challenges that they had faced growing a creative company"
    } ]
  }, {
    "tStartMs": 291340,
    "dDurationMs": 2740,
    "segs": [ {
