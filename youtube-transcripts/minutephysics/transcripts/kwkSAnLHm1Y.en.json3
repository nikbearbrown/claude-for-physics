{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1440,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Anyone can draw a stick figure - all you need\nis a circle and five straight lines…"
    } ]
  }, {
    "tStartMs": 5880,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "four straight lines… one straight line and\na curvy one?"
    } ]
  }, {
    "tStartMs": 9730,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The point is, there's no right or wrong way\nto draw a stick figure."
    } ]
  }, {
    "tStartMs": 13090,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So here's how you do it."
    } ]
  }, {
    "tStartMs": 15270,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Maybe."
    } ]
  }, {
    "tStartMs": 16270,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "Step one - the head."
    } ]
  }, {
    "tStartMs": 17540,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "Draw a circle - well, or an oval, but it looks\nbetter if it's a vertical oval because people's"
    } ]
  }, {
    "tStartMs": 21570,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "heads tend to be that way."
    } ]
  }, {
    "tStartMs": 23380,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Unless you're drawing a dog."
    } ]
  }, {
    "tStartMs": 24590,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Or a sideways person."
    } ]
  }, {
    "tStartMs": 26110,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Or Dolores Umbridge."
    } ]
  }, {
    "tStartMs": 27730,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Step two - the body."
    } ]
  }, {
    "tStartMs": 29250,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Connect it to the head."
    } ]
  }, {
    "tStartMs": 30570,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Or close enough."
    } ]
  }, {
    "tStartMs": 31570,
    "dDurationMs": 1029,
    "segs": [ {
      "utf8": "Don't make it too long."
    } ]
  }, {
    "tStartMs": 32599,
    "dDurationMs": 2431,
    "segs": [ {
      "utf8": "If it curves, the person might be sad."
    } ]
  }, {
    "tStartMs": 35030,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Or doing yoga."
    } ]
  }, {
    "tStartMs": 36370,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "Or a snake."
    } ]
  }, {
    "tStartMs": 37679,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "Step three - the legs."
    } ]
  }, {
    "tStartMs": 39420,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "This is the most important part."
    } ]
  }, {
    "tStartMs": 41109,
    "dDurationMs": 2011,
    "segs": [ {
      "utf8": "Make them longer than the body."
    } ]
  }, {
    "tStartMs": 43120,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "That's how most people look in real life."
    } ]
  }, {
    "tStartMs": 45050,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "You can make them running, or walking, or\ndoing the splits, or squatting, or punting"
    } ]
  }, {
    "tStartMs": 48600,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "Baxter - anything's fine, as long as they're\nlong."
    } ]
  }, {
    "tStartMs": 51559,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "But not too long, otherwise you get alien\nweirdness."
    } ]
  }, {
    "tStartMs": 55379,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "Also no extra joints - unless you're a two-tailed\nsnake."
    } ]
  }, {
    "tStartMs": 58920,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "Step four - the arms."
    } ]
  }, {
    "tStartMs": 60489,
    "dDurationMs": 4901,
    "segs": [ {
      "utf8": "The quick and dirty method is a single line,\nbut it doesn't really look like a real person."
    } ]
  }, {
    "tStartMs": 65390,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "People have arms that can point independently\nof one another!"
    } ]
  }, {
    "tStartMs": 68540,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "And necks that aren't half the length of their\ntorsos."
    } ]
  }, {
    "tStartMs": 71560,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Arms can do lots of things - yay!"
    } ]
  }, {
    "tStartMs": 73780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "scribble scribble scribble telescope point\nhammer!"
    } ]
  }, {
    "tStartMs": 76750,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "you've been a naughty boy Sad."
    } ]
  }, {
    "tStartMs": 79260,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "And finally - step five."
    } ]
  }, {
    "tStartMs": 81130,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The great enigma of the face: do you draw\nit?"
    } ]
  }, {
    "tStartMs": 84310,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "I don't because I like to let people project\ntheir own emotions onto my stick figures…"
    } ]
  }, {
    "tStartMs": 88990,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "also because I can't draw faces that express\nany emotion other than cheesy smile!"
    } ]
  }, {
    "tStartMs": 93350,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And that's how you draw a stick figure!"
    } ]
  }, {
    "tStartMs": 95300,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "Add ears for extra cuteness."
    } ]
  }, {
    "tStartMs": 98190,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Hey!"
    } ]
  }, {
    "tStartMs": 100090,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "This video is part of the \"School of Youtube\"\nCharity event, inspired by the fact that while"
    } ]
  }, {
    "tStartMs": 104300,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "many of us are lucky enough to attend school\nor college, there are millions of children"
    } ]
  }, {
    "tStartMs": 108170,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "around the world who can't go to school because\nof poverty or conflict or lack of educational"
    } ]
  }, {
    "tStartMs": 112450,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "infrastructure or a host of other reasons."
    } ]
  }, {
    "tStartMs": 115420,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Comic Relief is a charitable organization\nthat provides grants and aid to tackle the"
    } ]
  }, {
    "tStartMs": 119200,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "root causes of poverty and social injustice\naround the world, and they'll use the money"
    } ]
  }, {
    "tStartMs": 123260,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "that's raised through this School of Youtube\ncampaign towards helping kids around the world"
    } ]
  }, {
    "tStartMs": 127130,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "get a better education."
    } ]
  }, {
    "tStartMs": 128599,
    "dDurationMs": 6651,
    "segs": [ {
      "utf8": "You can donate either online at comicrelief.com/soyt\n(for \"school of youtube\") or if you're in"
    } ]
  }, {
    "tStartMs": 135250,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "the US by texting SOYT to number 71777 - message\nand data rates may apply."
    } ]
  }, {
    "tStartMs": 141450,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Even as little as $10 can help provide school\nsupplies for several students for an entire"
    } ]
  }, {
    "tStartMs": 145560,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "year - that's like, one ticket to the movies,\nor two chocolate malts."
    } ]
  }, {
    "tStartMs": 150370,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "I like malts so much, I donated a hundred\nmalts worth of education!"
    } ]
  }, {
    "tStartMs": 154470,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "How many malts will you donate?"
    } ]
  } ]
}
