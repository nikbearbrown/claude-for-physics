{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 820,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Hey there."
    } ]
  }, {
    "tStartMs": 1820,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "My name is Henry, and I'm a youtuber."
    } ]
  }, {
    "tStartMs": 4009,
    "dDurationMs": 3991,
    "segs": [ {
      "utf8": "I recently made a video showing a geometric\nproof of the distributive law in algebra,"
    } ]
  }, {
    "tStartMs": 8000,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "which I think is really awesome - I mean,\nwhen you think about it it's really crazy"
    } ]
  }, {
    "tStartMs": 11730,
    "dDurationMs": 3809,
    "segs": [ {
      "utf8": "that you can use the areas of rectangles to\nprove a rule in algebra!"
    } ]
  }, {
    "tStartMs": 15539,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "You can even use the same trick with boxes\nfor triple products!"
    } ]
  }, {
    "tStartMs": 18750,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "But clearly I failed at conveying this message\nto a large number of you, who thought I was"
    } ]
  }, {
    "tStartMs": 22580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "just trying to teach a stupid mnemonic from\njunior high school."
    } ]
  }, {
    "tStartMs": 25640,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I'm sorry."
    } ]
  }, {
    "tStartMs": 26640,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "I hope I won't be foiled again."
    } ]
  }, {
    "tStartMs": 28300,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Also, whenever I make a video about a supposedly\n\"simple\" topic like this, it's normally because"
    } ]
  }, {
    "tStartMs": 33100,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "I've gotten really excited about some cool\nnew way to think about the topic."
    } ]
  }, {
    "tStartMs": 36470,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Simple stuff that you think you understand\ncan be some of the most fascinating!"
    } ]
  }, {
    "tStartMs": 40460,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "I have no fear of running out of physics ideas\nany time soon - physics is suuuuch a big field..."
    } ]
  }, {
    "tStartMs": 45020,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "sometimes I just get excited about math, too."
    } ]
  }, {
    "tStartMs": 47539,
    "dDurationMs": 1311,
    "segs": [ {
      "utf8": "Or racewalking."
    } ]
  }, {
    "tStartMs": 48850,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "Either way, as you've probably guessed, I'm\n100% committed to making videos that are free"
    } ]
  }, {
    "tStartMs": 53120,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "for anyone and everyone to watch."
    } ]
  }, {
    "tStartMs": 55079,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "However, giving stuff away for free is a tough\nway to make a living, and at the moment, advertisements"
    } ]
  }, {
    "tStartMs": 60129,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "on youtube seem to be the best way to keep\nmyself fed with a roof over my head."
    } ]
  }, {
    "tStartMs": 64170,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "They also help support MinuteEarth and MinutoDeFisica..."
    } ]
  }, {
    "tStartMs": 66310,
    "dDurationMs": 4161,
    "segs": [ {
      "utf8": "And if you don't like the sponsorship ads,\nwell, they're at the end of my videos so you"
    } ]
  }, {
    "tStartMs": 70471,
    "dDurationMs": 1749,
    "segs": [ {
      "utf8": "don't actually have to watch them!"
    } ]
  }, {
    "tStartMs": 72220,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "I won't be offended."
    } ]
  }, {
    "tStartMs": 73670,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "This MinutePhysics video was brought to you\nby... a collection of atoms known as Henry."
    } ]
  } ]
}
