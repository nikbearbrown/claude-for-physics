{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I've recently been getting some emails that look"
    } ]
  }, {
    "tStartMs": 2200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "convincingly like messages from YouTube,"
    } ]
  }, {
    "tStartMs": 3800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "asking me to confirm my account."
    } ]
  }, {
    "tStartMs": 5240,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Look! It says it's from YouTube"
    } ]
  }, {
    "tStartMs": 6820,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and the text reads like something from a YouTube email"
    } ]
  }, {
    "tStartMs": 9280,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "and the link to click on to confirm my account"
    } ]
  }, {
    "tStartMs": 11100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "is a link on YouTube's website."
    } ]
  }, {
    "tStartMs": 13000,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Except it's not."
    } ]
  }, {
    "tStartMs": 14120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The text of the link, certainly is a youtube.com address."
    } ]
  }, {
    "tStartMs": 17360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Though, it doesn't go anywhere"
    } ]
  }, {
    "tStartMs": 18640,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "but the website the link goes to when you click on it"
    } ]
  }, {
    "tStartMs": 21240,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "is definitely, not YouTube."
    } ]
  }, {
    "tStartMs": 23040,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Now, most people know that you can put a link to any"
    } ]
  }, {
    "tStartMs": 25400,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "address on any text you want."
    } ]
  }, {
    "tStartMs": 27060,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "but this phishing attack is maliciously taking advantage"
    } ]
  }, {
    "tStartMs": 29660,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "of the fact that, typically when you paste a link into an"
    } ]
  }, {
    "tStartMs": 31740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "email, it automatically just links to that link."
    } ]
  }, {
    "tStartMs": 34380,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So, we've all habituated to think that if we see a link and"
    } ]
  }, {
    "tStartMs": 36980,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "click on it. We're going to that address."
    } ]
  }, {
    "tStartMs": 38920,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But of course, in this case."
    } ]
  }, {
    "tStartMs": 40540,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "We're not."
    } ]
  }, {
    "tStartMs": 41460,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "The site this link takes you to"
    } ]
  }, {
    "tStartMs": 42940,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "looks convincingly like YouTube"
    } ]
  }, {
    "tStartMs": 44700,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "but the URL definitely isn't and if you clicked on the link"
    } ]
  }, {
    "tStartMs": 47420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "without looking carefully and didn't pay attention to the address"
    } ]
  }, {
    "tStartMs": 49880,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "you might even try to log into this fake Google login"
    } ]
  }, {
    "tStartMs": 52980,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "and then... I don't know what happens"
    } ]
  }, {
    "tStartMs": 55160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but I bet it's not good."
    } ]
  }, {
    "tStartMs": 56680,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "because you just gave your Gmail YouTube login away to a malicious stranger"
    } ]
  }, {
    "tStartMs": 61040,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "If anyone watching this video is clever enough to"
    } ]
  }, {
    "tStartMs": 62900,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "figure out, exactly what these attack sites do"
    } ]
  }, {
    "tStartMs": 65020,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "or, who's behind them."
    } ]
  }, {
    "tStartMs": 66140,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "I'm all ears"
    } ]
  }, {
    "tStartMs": 67260,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "or, if you work for YouTube."
    } ]
  }, {
    "tStartMs": 68840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Perhaps you could send out a message to all"
    } ]
  }, {
    "tStartMs": 70600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "of you users, warning of attack sites like this"
    } ]
  }, {
    "tStartMs": 72900,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "but for now, just know that if you see an email"
    } ]
  }, {
    "tStartMs": 75260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that looks like it's from YouTube asking you"
    } ]
  }, {
    "tStartMs": 76880,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to verify your account information"
    } ]
  }, {
    "tStartMs": 78860,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "DON'T CLICK ON THE LINK"
    } ]
  } ]
}
