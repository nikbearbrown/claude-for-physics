{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Have you ever had the feeling that there's\nsomething bigger out there, something you"
    } ]
  }, {
    "tStartMs": 3040,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "can't see?"
    } ]
  }, {
    "tStartMs": 4040,
    "dDurationMs": 2489,
    "segs": [ {
      "utf8": "Well there is – it's called Dark Matter."
    } ]
  }, {
    "tStartMs": 6529,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "Dark matter is spread throughout space, engulfing\nthe Milky Way and all other galaxies."
    } ]
  }, {
    "tStartMs": 11019,
    "dDurationMs": 4091,
    "segs": [ {
      "utf8": "It's four times more common in the universe\nthan visible matter, yet we've never seen"
    } ]
  }, {
    "tStartMs": 15110,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "or directly observed it!"
    } ]
  }, {
    "tStartMs": 16410,
    "dDurationMs": 1629,
    "segs": [ {
      "utf8": "So how do we know it's there?"
    } ]
  }, {
    "tStartMs": 18039,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Because of gravity."
    } ]
  }, {
    "tStartMs": 19040,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "A galaxy is like a giant merry-go-round that\nall the stars are riding."
    } ]
  }, {
    "tStartMs": 22890,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "In order to stay on, each star has to hold\non tight (that's where gravity comes in),"
    } ]
  }, {
    "tStartMs": 27380,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "otherwise it'll fly off into space."
    } ]
  }, {
    "tStartMs": 29470,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "The problem is, the force of gravity from\nall the stars we can see isn't strong enough"
    } ]
  }, {
    "tStartMs": 33460,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "to hold galaxies together – all the stars\nshould be flying off the edge of the merry-go-round!"
    } ]
  }, {
    "tStartMs": 38050,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But they're not."
    } ]
  }, {
    "tStartMs": 39250,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "It's as if some invisible rope is helping\nthem hold on."
    } ]
  }, {
    "tStartMs": 42020,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Physicists believe that rope is the gravitational\nforce from stuff we can't see - hence, Dark"
    } ]
  }, {
    "tStartMs": 46880,
    "dDurationMs": 1179,
    "segs": [ {
      "utf8": "Matter."
    } ]
  }, {
    "tStartMs": 48059,
    "dDurationMs": 2551,
    "segs": [ {
      "utf8": "And how do we know the speeds of stars in\ndistant galaxies?"
    } ]
  }, {
    "tStartMs": 50610,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "The doppler effect (which is why a police\nsiren shifts to a lower pitch as the car passes)"
    } ]
  }, {
    "tStartMs": 55820,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "also works for light – that's how radar\ncatches you speeding, and how astronomers"
    } ]
  }, {
    "tStartMs": 59750,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "measure the rotation of galaxies."
    } ]
  }, {
    "tStartMs": 61870,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, we use what we can see to tell us about\nwhat we can't."
    } ]
  } ]
}
