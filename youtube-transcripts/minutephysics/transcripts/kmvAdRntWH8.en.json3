  }, {
    "tStartMs": 351970,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "coming into my apartment at 2 AM,"
    } ]
  }, {
    "tStartMs": 354240,
    "dDurationMs": 2160,
