{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "For weeks my friend Ever has been living under siege."
    } ]
  }, {
    "tStartMs": 3520,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "He's not a soldier, a diplomat, a protester or a revolutionary."
    } ]
  }, {
    "tStartMs": 7420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "He's just a regular citizen of Venezuela."
    } ]
  }, {
    "tStartMs": 10120,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "For those who don't know,"
    } ]
  }, {
    "tStartMs": 10980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Venezuela is in the middle of an uprising."
    } ]
  }, {
    "tStartMs": 12780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The reasons, of course, are complicated myriad"
    } ]
  }, {
    "tStartMs": 14940,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and go back at least two decades,"
    } ]
  }, {
    "tStartMs": 16320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but since the death of President Hugo Chavez \none year ago"
    } ]
  }, {
    "tStartMs": 18810,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "the economic situation has become increasingly dire."
    } ]
  }, {
    "tStartMs": 21230,
    "dDurationMs": 3969,
    "segs": [ {
      "utf8": "And major nationwide protests began on \nFebruary 12, 2014"
    } ]
  }, {
    "tStartMs": 25200,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "This news is largely been overshadowed\nby recent arguably more serious events in Ukraine,"
    } ]
  }, {
    "tStartMs": 29560,
    "dDurationMs": 2839,
    "segs": [ {
      "utf8": "but just because Venezuela is\nnot a conduit for petroleum products"
    } ]
  }, {
    "tStartMs": 32399,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "between Russia and Western Europe nor a \nproxy for the conflict between the two"
    } ]
  }, {
    "tStartMs": 35460,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "and just because the death toll during\nprotests in Venezuela hasn't yet reached the hundreds,"
    } ]
  }, {
    "tStartMs": 39280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "doesn't mean that life is\ngood for its citizens."
    } ]
  }, {
    "tStartMs": 41900,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Take case in point, Ever."
    } ]
  }, {
    "tStartMs": 43920,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "He lives in Ciudad Guayana, a city of a million along the Orinoco River in eastern Venezuela."
    } ]
  }, {
    "tStartMs": 48480,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "It is Venezuela's sixth-largest city\nwith a dozen universities"
    } ]
  }, {
    "tStartMs": 51560,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "(including the one where Ever teaches),"
    } ]
  }, {
    "tStartMs": 52980,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "a major industrial center for iron and aluminum,"
    } ]
  }, {
    "tStartMs": 55340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "many beautiful parks, and so on,"
    } ]
  }, {
    "tStartMs": 57900,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "but none of that matters at the moment"
    } ]
  }, {
    "tStartMs": 59320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "because on an average day in Ever's neighborhood"
    } ]
  }, {
    "tStartMs": 61530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "there are cars burning on the streets,"
    } ]
  }, {
    "tStartMs": 63150,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "teargas wafting through his windows,"
    } ]
  }, {
    "tStartMs": 65430,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and protesters barricading the main roads"
    } ]
  }, {
    "tStartMs": 67150,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "with trash, tires, and tree limbs"
    } ]
  }, {
    "tStartMs": 68950,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "so the Guardia Nacional and everyone else can't get to where they're going."
    } ]
  }, {
    "tStartMs": 72689,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Even before the protests started,"
    } ]
  }, {
    "tStartMs": 74509,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Ever and I had a little joke going"
    } ]
  }, {
    "tStartMs": 76229,
    "dDurationMs": 3411,
    "segs": [ {
      "utf8": "about the dysfunctional nature of life and\nso-called socialist Venezuela."
    } ]
  }, {
    "tStartMs": 79650,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Whenever the internet or power in \nCiudad Guayana would go down"
    } ]
  }, {
    "tStartMs": 82350,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "or Ever had to wait three hours in line to buy rice,"
    } ]
  }, {
    "tStartMs": 84960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "(all of regular occurrences)"
    } ]
  }, {
    "tStartMs": 86700,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "He would describe the situation with the hashtag:\n#ThirdWorldProblems"
    } ]
  }, {
    "tStartMs": 90090,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It was funny because it was ironic."
    } ]
  }, {
    "tStartMs": 91980,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "That's no longer the case."
    } ]
  }, {
    "tStartMs": 93600,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Now Ever and his family and neighbors and countrymen have spent two months in a state of uncertainty."
    } ]
  }, {
    "tStartMs": 97940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "They still have third world problems on their hands"
    } ]
  }, {
    "tStartMs": 100220,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "but the problems have grown much bigger"
    } ]
  }, {
    "tStartMs": 101920,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "than waiting in lines."
    } ]
  }, {
    "tStartMs": 102760,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(even while those problems continue to persist)."
    } ]
  }, {
    "tStartMs": 105820,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "And then this week something else caught my attention."
    } ]
  }, {
    "tStartMs": 108300,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Ever started describing the situation"
    } ]
  }, {
    "tStartMs": 109800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "in his neighborhood as \"quiet\" or \"fine\""
    } ]
  }, {
    "tStartMs": 112480,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "during lulls in clashes between"
    } ]
  }, {
    "tStartMs": 113900,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "protesters and the Guardia Nacional."
    } ]
  }, {
    "tStartMs": 115680,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Things, at least, from my vantage point"
    } ]
  }, {
    "tStartMs": 117780,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "3,000 miles to the north"
    } ]
  }, {
    "tStartMs": 119300,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "clearly weren't fine."
    } ]
  }, {
    "tStartMs": 120820,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They were just slightly less bad."
    } ]
  }, {
    "tStartMs": 122660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I sent Ever the following email:"
    } ]
  }, {
    "tStartMs": 124660,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Ever,"
    } ]
  }, {
    "tStartMs": 125270,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I'm getting a little worried that your standards for quiet"
    } ]
  }, {
    "tStartMs": 127830,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "have become skewed."
    } ]
  }, {
    "tStartMs": 128870,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "Yesterday you said it was quiet"
    } ]
  }, {
    "tStartMs": 130560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and several vehicles were lit on fire on your street."
    } ]
  }, {
    "tStartMs": 133040,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Today it was quiet and a National Guard \nman was hit by a bomb."
    } ]
  }, {
    "tStartMs": 136940,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "I'm saying this partly in jest, but also to remind you what peaceful life is really like,"
    } ]
  }, {
    "tStartMs": 141220,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "so you don't become complacent and start accepting"
    } ]
  }, {
    "tStartMs": 143130,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "even a little insanity as being okay."
    } ]
  }, {
    "tStartMs": 145960,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Henry."
    } ]
  }, {
    "tStartMs": 146690,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Here is his beautiful response:"
    } ]
  }, {
    "tStartMs": 149750,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "You are right, Henry."
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I forgot to give you context for the video."
    } ]
  }, {
    "tStartMs": 154420,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "He was hit by a firework,"
    } ]
  }, {
    "tStartMs": 155740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "one of those that sounds very loud."
    } ]
  }, {
    "tStartMs": 158330,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "They call it mata suegra, tu ma rancho, bin laden, etc."
    } ]
  }, {
    "tStartMs": 162420,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "That guard was the captain that was leading."
    } ]
  }, {
    "tStartMs": 164720,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "He got a very bad looking injury in the upper left leg."
    } ]
  }, {
    "tStartMs": 168050,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Fortunately, he is alive,"
    } ]
  }, {
    "tStartMs": 170500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and despite the fact that \"quiet\""
    } ]
  }, {
    "tStartMs": 172500,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "was referring to what happened after those events"
    } ]
  }, {
    "tStartMs": 175420,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "you're right in that I may be complacent"
    } ]
  }, {
    "tStartMs": 177900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and accepting a fair amount of insanity"
    } ]
  }, {
    "tStartMs": 180200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "as being okay."
    } ]
  }, {
    "tStartMs": 181680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And that made me think about my personality"
    } ]
  }, {
    "tStartMs": 184330,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I mean I know that it shouldn't be happening"
    } ]
  }, {
    "tStartMs": 186910,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and that is not okay,"
    } ]
  }, {
    "tStartMs": 188500,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "but the fact is that I live in"
    } ]
  }, {
    "tStartMs": 190320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "an insane dysfunctional country,"
    } ]
  }, {
    "tStartMs": 192060,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "where basic products such as"
    } ]
  }, {
    "tStartMs": 193880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "milk, coffee, flower, and toilet paper"
    } ]
  }, {
    "tStartMs": 196440,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "are scarce to the point that"
    } ]
  }, {
    "tStartMs": 198260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "people make insane long lines"
    } ]
  }, {
    "tStartMs": 200600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and even end up fighting and looting to get those goods"
    } ]
  }, {
    "tStartMs": 204280,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "I live in the country with an insane\ndysfunctional economy,"
    } ]
  }, {
    "tStartMs": 207980,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "where there's nothing cheaper than gasoline."
    } ]
  }, {
    "tStartMs": 210160,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Where people have gotten rich making money"
    } ]
  }, {
    "tStartMs": 212300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "by trafficking it and other subsidizing goods."
    } ]
  }, {
    "tStartMs": 215520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Where the police and National Guards"
    } ]
  }, {
    "tStartMs": 217320,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "cannot control the rampant crime"
    } ]
  }, {
    "tStartMs": 219200,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "that took the life of more than 24,000 during 2013 only."
    } ]
  }, {
    "tStartMs": 223860,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Where impunity is the law."
    } ]
  }, {
    "tStartMs": 225910,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Where prisoners control the jails"
    } ]
  }, {
    "tStartMs": 227950,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and live with a comfort that honest working people"
    } ]
  }, {
    "tStartMs": 230890,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "outside cannot have."
    } ]
  }, {
    "tStartMs": 232780,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Where at least half the population ratifies the disaster"
    } ]
  }, {
    "tStartMs": 236320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "by voting in favor of the 15 year long revolution."
    } ]
  }, {
    "tStartMs": 240050,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Where you have to drive like a drunk"
    } ]
  }, {
    "tStartMs": 242130,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "because of the craters in the roads."
    } ]
  }, {
    "tStartMs": 244860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Where law does not apply to people who can"
    } ]
  }, {
    "tStartMs": 247260,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "afford to pay off judges."
    } ]
  }, {
    "tStartMs": 248870,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Where all TV stations want to report"
    } ]
  }, {
    "tStartMs": 251650,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "to avoid conflicts with the government."
    } ]
  }, {
    "tStartMs": 254420,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Where government blames"
    } ]
  }, {
    "tStartMs": 255660,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the Empire, the CIA, the opposition,"
    } ]
  }, {
    "tStartMs": 258860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and nearly every imaginable thing,"
    } ]
  }, {
    "tStartMs": 261260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "even iguanas,"
    } ]
  }, {
    "tStartMs": 262460,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "for the problems in the country."
    } ]
  }, {
    "tStartMs": 264570,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Where you cannot save in local currency"
    } ]
  }, {
    "tStartMs": 266790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "due to the fifty percent inflation rate,"
    } ]
  }, {
    "tStartMs": 269240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and I could go on and on."
    } ]
  }, {
    "tStartMs": 271860,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "And on top of that,"
    } ]
  }, {
    "tStartMs": 272840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "we have had about a month"
    } ]
  }, {
    "tStartMs": 275080,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "with many streets blocked,"
    } ]
  }, {
    "tStartMs": 276660,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "with National Guard's using teargas every day"
    } ]
  }, {
    "tStartMs": 279320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to dissolve peaceful protest,"
    } ]
  }, {
    "tStartMs": 281100,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "with some protesters setting fire on cars,"
    } ]
  }, {
    "tStartMs": 283940,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "bosses taking down"
    } ]
  }, {
    "tStartMs": 285120,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "traffic lights, trees, and even building \nconcrete walls on the street."
    } ]
  }, {
    "tStartMs": 289730,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I have no control over any of these things."
    } ]
  }, {
    "tStartMs": 293160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "I can only talk, debate, and try to make people I know"
    } ]
  }, {
    "tStartMs": 296840,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "think carefully about what they do and support."
    } ]
  }, {
    "tStartMs": 300860,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And being complacent and accepting all these insanity"
    } ]
  }, {
    "tStartMs": 304060,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "may be a defense mechanism."
    } ]
  }, {
    "tStartMs": 305800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "If I don't do it then I will leave angry and embittered,"
    } ]
  }, {
    "tStartMs": 309240,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "as many people I know do."
    } ]
  }, {
    "tStartMs": 311320,
    "dDurationMs": 5219,
    "segs": [ {
      "utf8": "I don't know if this is a good way to\ndeal with frustration but that's me,"
    } ]
  }, {
    "tStartMs": 316539,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "I think."
    } ]
  }, {
    "tStartMs": 319800,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "[Truck burning]"
    } ]
  }, {
    "tStartMs": 325480,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "As a follow up,"
    } ]
  }, {
    "tStartMs": 326080,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "I want to acknowledge that Ever works with me"
    } ]
  }, {
    "tStartMs": 327860,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "as the illustrator for the \nMinuteEarth channel on Youtube,"
    } ]
  }, {
    "tStartMs": 330040,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "and the situation in Venezuela is part of the"
    } ]
  }, {
    "tStartMs": 331870,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "reason the video output from Minute Earth"
    } ]
  }, {
    "tStartMs": 333410,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "has suffered over the last month."
    } ]
  }, {
    "tStartMs": 335060,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "As we've been working on this video,"
