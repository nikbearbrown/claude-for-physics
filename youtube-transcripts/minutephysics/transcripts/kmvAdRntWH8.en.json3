  }, {
    "tStartMs": 340889,
    "dDurationMs": 1511,
    "segs": [ {
      "utf8": "often going long into the night."
    } ]
  }, {
    "tStartMs": 342400,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "I guess I just want to make clear that the \nscenarios we illustrated"
    } ]
  }, {
    "tStartMs": 345000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "aren't isolated events, and they're not over."
    } ]
  }, {
    "tStartMs": 347280,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "They are literally the daily insane reality."
    } ]
  }, {
    "tStartMs": 349870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I'm thankful that I don't have to deal with teargas"
