  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "today we have a beautiful guest video for \nyou by robert crawwich and nate milton"
    } ]
  }, {
    "tStartMs": 9920,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "imagine a house a normal house with the usual \nappliances dishwashers refrigerators vacuum  "
    } ]
  }, {
    "tStartMs": 16320,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "cleaners and of course an electricity bill \nwhich comes every month now we're going to  "
    } ]
  }, {
    "tStartMs": 21120,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "make this a kentucky home because in kentucky \nthey get almost all their energy from coal  "
    } ]
  }, {
    "tStartMs": 25680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and since we all know that coal is a fossil fuel  "
    } ]
  }, {
    "tStartMs": 28720,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "here's an idea let's go back and meet the \nfossils who died to light up this house  "
    } ]
  }, {
    "tStartMs": 40560,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "well we're gonna have to go way way back to \nthe carboniferous period that's about 300  "
    } ]
  }, {
    "tStartMs": 45920,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "million years ago and this here is a typical \nforest from that time and this is a typical  "
    } ]
  }, {
    "tStartMs": 52880,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "tree called a lepidodendron long skinny little \ntree they sprouted up as plants do soaking in  "
    } ]
  }, {
    "tStartMs": 59760,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "sunshine absorbing carbon from the air so they \ncould grow and grow and grow and then of course  "
    } ]
  }, {
    "tStartMs": 66880,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "they died to be replaced by another set of \nlepidodendrons that also grew and died another  "
    } ]
  }, {
    "tStartMs": 73360,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "that grew and died and another that grew and \ndied so after millions and millions of years  "
    } ]
  }, {
    "tStartMs": 78080,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "the layers of all these dead plants press down \none on top of the other concentrating all that  "
    } ]
  }, {
    "tStartMs": 84560,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "ancient carbon and ancient sunshine \ninto a hard black rock that we call  "
    } ]
  }, {
    "tStartMs": 90400,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "coal so just for the fun of it let's say our \nhouse here in kentucky uses roughly a thousand  "
    } ]
  }, {
    "tStartMs": 97760,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "kilowatt hours of coal powered electricity in \na month that's about average can we figure out  "
    } ]
  }, {
    "tStartMs": 103920,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "how many of those ancient trees are in effect \nbeing harvested to power this home for one month  "
    } ]
  }, {
    "tStartMs": 111760,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "well it turns out that a thousand kilowatt hours \nthat's the electricity bill comes from burning  "
    } ]
  }, {
    "tStartMs": 116320,
    "dDurationMs": 7840,
    "segs": [ {
      "utf8": "about a half ton of coal which is the energy \nequivalent of two ancient trees each one about  "
    } ]
  }, {
    "tStartMs": 124160,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "60 feet high so that is what this home is \nburning every month to old trees worth of carbon  "
    } ]
  }, {
    "tStartMs": 132560,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "now if we go for a year of electricity that would \nbe 24 of these trees and then over a decade over  "
    } ]
  }, {
    "tStartMs": 138880,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "10 years we're up to 240 trees and now you kind \nof used up a mini forest of ancient energy just  "
    } ]
  }, {
    "tStartMs": 145600,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "to power your home and that does not include by \nthe way the family car now cars we all know also  "
    } ]
  }, {
    "tStartMs": 152560,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "use fossil fuels gasoline does come from oil and \noil comes from once again ancient plants but not  "
    } ]
  }, {
    "tStartMs": 159680,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "trees this time no no oil comes from much much \nteenier plant-like creatures so small you can't  "
    } ]
  }, {
    "tStartMs": 165520,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "see them with your eyes but you do find them \nin the ocean drifting about and rolling around  "
    } ]
  }, {
    "tStartMs": 171120,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "using sunshine to absorb carbon and grow and \nmultiply there are trillions actually a thousand  "
    } ]
  }, {
    "tStartMs": 178160,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "trillion trillion of these teeny plants in the \nsea they're called phytoplankton the basic food  "
    } ]
  }, {
    "tStartMs": 184560,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "of the ocean eaten by little guys and the \nbig guys and a hundred million years ago  "
    } ]
  }, {
    "tStartMs": 190080,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "there were phytoplankton living in the oceans \nand when they died and their babies died and  "
    } ]
  }, {
    "tStartMs": 195280,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "the babies of those babies died the ocean bottoms \nwere gradually littered with sunshine rich remains  "
    } ]
  }, {
    "tStartMs": 200720,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "creating a layer of stored carbon that under \npressure from the mud above and the heat below  "
    } ]
  }, {
    "tStartMs": 206640,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "compressed first into rock and then under even \ngreater pressure turned into a black liquid that  "
    } ]
  }, {
    "tStartMs": 212800,
    "dDurationMs": 8960,
    "segs": [ {
      "utf8": "we now call oil so today when you pump a gallon \nof gasoline into your car you are mostly pumping  "
    } ]
  }, {
    "tStartMs": 221760,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "these squeezed remains of countless ancient \nmicro plants into your car engine well actually  "
    } ]
  }, {
    "tStartMs": 227440,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "they're not really countless because we can \ncount them based on their carbon content so  "
    } ]
  }, {
    "tStartMs": 232240,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "we calculate that when you turn on the engine and \nstep on the gas and go for every inch of highway  "
    } ]
  }, {
    "tStartMs": 238800,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "you are crunching 20 billion ancient plants \nthrough your car engine that is 20 billion  "
    } ]
  }, {
    "tStartMs": 246000,
    "dDurationMs": 8320,
    "segs": [ {
      "utf8": "for every highway inch so if your grandma lives \na mile down the road that works out to 1 trillion  "
    } ]
  }, {
    "tStartMs": 254960,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "plants given up their energy to move you to \ngrandma's who when she turns on the lights to  "
    } ]
  }, {
    "tStartMs": 259920,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "say hi she's using energy from ancient trees so we \nare constantly using carbon that's been locked in  "
    } ]
  }, {
    "tStartMs": 267040,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "the ground for millions of years digging it up \nand putting it back to work for you and for me"
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "we today are ravenous for old sunshine so \nmuch so that if you add up all the coal  "
    } ]
  }, {
    "tStartMs": 282560,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "and all the oil and all the natural gas that we \nhumans use to power our lives in just one recent  "
    } ]
  }, {
    "tStartMs": 289680,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "year we'll choose the year 2018 and then think \njust for a second of all the ancient organisms  "
    } ]
  }, {
    "tStartMs": 295360,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "that had to get squished down to make those fossil \nfuels so that would be the old carboniferous trees  "
    } ]
  }, {
    "tStartMs": 301520,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "and the carboniferous plants and the phytoplankton \nand ancient plant eaters the little buns  "
    } ]
  }, {
    "tStartMs": 307360,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "and the big ones in the sea on the land all those \nold organisms that got crunched into fossil fuels  "
    } ]
  }, {
    "tStartMs": 314720,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "if you drop all that old life into the container \nthat we call earth and burn them it turns out  "
    } ]
  }, {
    "tStartMs": 320880,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "that what we burn in one year weighs a hundred \ntimes more than everything alive today everything  "
    } ]
  }, {
    "tStartMs": 329600,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "all the living whales and the elephants and \nthe forests and insects and grass and crops  "
    } ]
  }, {
    "tStartMs": 337280,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "and birds and fish and people dogs and cats add \nup all the carbon in everything alive now and  "
    } ]
  }, {
    "tStartMs": 344640,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "still in one year we burned a hundred times more \nor to put it another way we humans gobbled up 100  "
    } ]
  }, {
    "tStartMs": 352080,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "earth's worth of ancient life that's 55 \ntrillion tons of ancient carbon in a single year  "
    } ]
