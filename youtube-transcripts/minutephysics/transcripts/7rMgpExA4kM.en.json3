{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 12080,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Airplanes"
    } ]
  }, {
    "tStartMs": 13200,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "are essentially pressurized cylinders zooming through the air 10 km above the ground."
    } ]
  }, {
    "tStartMs": 17660,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "They take us to work and on vacation, bring us to family"
    } ]
  }, {
    "tStartMs": 20840,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "and in general move us from point A to point B faster than any other publicly available transport on earth."
    } ]
  }, {
    "tStartMs": 26880,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Here's how a modern commercial jet aircraft is made:"
    } ]
  }, {
    "tStartMs": 31780,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So, it's a beautiful fall morning"
    } ]
  }, {
    "tStartMs": 33540,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and I am getting ready to go"
    } ]
  }, {
    "tStartMs": 36140,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "get on an airplane"
    } ]
  }, {
    "tStartMs": 38140,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "to go to france to learn about airplanes."
    } ]
  }, {
    "tStartMs": 45420,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "I flew to europe to visit the factories, research and design facilities of AIRBUS"
    } ]
  }, {
    "tStartMs": 49420,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "because they wanted to give me and you a behind the scenes look at their newest airplane, the A350."
    } ]
  }, {
    "tStartMs": 55180,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "Here it is!"
    } ]
  }, {
    "tStartMs": 56720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "But before the first flight happens,"
    } ]
  }, {
    "tStartMs": 58240,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "even long before the first rivet is set,"
    } ]
  }, {
    "tStartMs": 60660,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "a team of thousands of engineers and designers spend years developing the design for both the aircraft"
    } ]
  }, {
    "tStartMs": 65580,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and how it will be manufactured."
    } ]
  }, {
    "tStartMs": 67760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They have to take into account the desired passenger capacity,"
    } ]
  }, {
    "tStartMs": 70400,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the range and speed of the plane,"
    } ]
  }, {
    "tStartMs": 71960,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "passenger comfort,"
    } ]
  }, {
    "tStartMs": 72980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "requirements for landing and navigating airports,"
    } ]
  }, {
    "tStartMs": 75100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "flight controls,"
    } ]
  }, {
    "tStartMs": 76120,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "fuel efficiency,"
    } ]
  }, {
    "tStartMs": 76900,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "how and where materials and parts will be scourced and produced"
    } ]
  }, {
    "tStartMs": 79920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and a million in sundry other details."
    } ]
  }, {
    "tStartMs": 81780,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Over the course of the design"
    } ]
  }, {
    "tStartMs": 83240,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "engineers use computer simulations and wind tunnel models"
    } ]
  }, {
    "tStartMs": 86160,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "to test the aerodynamics of the aircraft in its takeoff, cruising and landing configurations"
    } ]
  }, {
    "tStartMs": 90520,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "and even use scale model engines powered by compressed air"
    } ]
  }, {
    "tStartMs": 93740,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "to understand the wing engine interaction."
    } ]
  }, {
    "tStartMs": 96000,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Fluid dynamics is freakin' complicated."
    } ]
  }, {
    "tStartMs": 98380,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "All of the various systems have to be independently tested,"
    } ]
  }, {
    "tStartMs": 101320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the wing flaps and the landing gear deployment and the engines and so on."
    } ]
  }, {
    "tStartMs": 104920,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "They even shoot several dead ducks into the engine at high speed"
    } ]
  }, {
    "tStartMs": 108720,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "to make sure it can continue to provide thrust if it encounters a flock of birds."
    } ]
  }, {
    "tStartMs": 112380,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "Once a plane is designed, the parts  --all 2.65 million of them--  have to be manufactured and assembled,"
    } ]
  }, {
    "tStartMs": 118380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "some by AIRBUS itself"
    } ]
  }, {
    "tStartMs": 119820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and many like the engines and landing gear by outside contractors."
    } ]
  }, {
    "tStartMs": 123180,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "In the case of the A350 aircraft"
    } ]
  }, {
    "tStartMs": 125180,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "the wing tops and bottoms are made in an additive process using carbon fiber infused resinous tape,"
    } ]
  }, {
    "tStartMs": 130660,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "which is then cured in a massive oven until it becomes stronger and lighter than steel."
    } ]
  }, {
    "tStartMs": 134700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Let me say that again:"
    } ]
  }, {
    "tStartMs": 135900,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That is going to be an airplane wing --"
    } ]
  }, {
    "tStartMs": 138460,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "made out of tape."
    } ]
  }, {
    "tStartMs": 140400,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The wingboxes are assembled and fitted with electrical, hydraulic and fuel systems,"
    } ]
  }, {
    "tStartMs": 144160,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "painted and then the flaps, slats and ailerons  --the things they use to steer--  are added."
    } ]
  }, {
    "tStartMs": 149060,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "They ginormous tail fin is constructed in a similar fashion."
    } ]
  }, {
    "tStartMs": 152440,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The fuselage (struggles to pronounce)"
    } ]
  }, {
    "tStartMs": 156180,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "and rear pressure bulkhead are built separately,"
    } ]
  }, {
    "tStartMs": 158320,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "again out of carbon fiber composite materials"
    } ]
  }, {
    "tStartMs": 161000,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and are wired and outfitted with instrumentation and hydraulics."
    } ]
  }, {
    "tStartMs": 164060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The nose of the aircraft is added"
    } ]
  }, {
    "tStartMs": 165560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and then all the parts built off site"
    } ]
  }, {
    "tStartMs": 167540,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "are flown by a special and hilarious looking airplane part carrying airplane"
    } ]
  }, {
    "tStartMs": 171460,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "to the final assembly line"
    } ]
  }, {
    "tStartMs": 172920,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "where in a single stupendously massive hangar the fuselage pieces are fastened together,"
    } ]
  }, {
    "tStartMs": 177200,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "the wings are connected,"
    } ]
  }, {
    "tStartMs": 178440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "landing gear installed,"
    } ]
  }, {
    "tStartMs": 179880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "auxiliary power unit put in place,"
    } ]
  }, {
    "tStartMs": 181600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "vertical stabilizer and horizontal tailplane are attached,"
    } ]
  }, {
    "tStartMs": 184600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "seats and ventilation and cabin and cockpit interiors are installed,"
    } ]
  }, {
    "tStartMs": 187720,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "etc."
    } ]
  }, {
    "tStartMs": 188980,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Finally, at the very end, it's time for the engines."
    } ]
  }, {
    "tStartMs": 192160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "They're the most expensive part, so they're put on last."
    } ]
  }, {
    "tStartMs": 195120,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "The plane then undergoes in flight testing to make sure all the systems are working as intended."
    } ]
  }, {
    "tStartMs": 200180,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "When a new aircraft it being developed, the first few planes built"
    } ]
  }, {
    "tStartMs": 203700,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "are covered with sensores and tested extensively to the range of their limits:"
    } ]
  }, {
    "tStartMs": 207520,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Cold weather,"
    } ]
  }, {
    "tStartMs": 208880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "hot weather,"
    } ]
  }, {
    "tStartMs": 209880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "high altitude,"
    } ]
  }, {
    "tStartMs": 210880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "water on the runway,"
    } ]
  }, {
    "tStartMs": 212160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "tail scraping on low speed take off,"
    } ]
  }, {
    "tStartMs": 214260,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "wing bending strenght,"
    } ]
  }, {
    "tStartMs": 215500,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "etc."
    } ]
  }, {
    "tStartMs": 216260,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "And in addition to this extensive prototype testing, every single plane that comes off the assembly line"
    } ]
  }, {
    "tStartMs": 221300,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "is taken on its own testflights."
    } ]
  }, {
    "tStartMs": 223320,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Once the test pilots and test flight enineers are happy"
    } ]
  }, {
    "tStartMs": 226240,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "we're done!"
    } ]
  }, {
    "tStartMs": 226920,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The plane heads out onto the runway for delivery to an airline somewhere around the world."
    } ]
  }, {
    "tStartMs": 232320,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "When it's running at full speed, AIRBUS' facilities will build ten A350 aircraft every month."
    } ]
  }, {
    "tStartMs": 237520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "That's one plane completed every two working days."
    } ]
  }, {
    "tStartMs": 240800,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "It's a pretty amazing feat of engineering, manufacturing, infrastructure and technology."
    } ]
  }, {
    "tStartMs": 245460,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "And if there is one thing that I learned about airplane manufactur while visiting AIRBUS,"
    } ]
  }, {
    "tStartMs": 248800,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "it's that every single part of the process has its own expert."
    } ]
  }, {
    "tStartMs": 251820,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "There are airtraffic control experts,"
    } ]
  }, {
    "tStartMs": 253860,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "seat experts,"
    } ]
  }, {
    "tStartMs": 254660,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "wing flap experts,"
    } ]
  }, {
    "tStartMs": 255780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "wind tunnel engine model experts"
    } ]
  }, {
    "tStartMs": 257760,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "and even carbon fiber recycling experts."
    } ]
  }, {
    "tStartMs": 260520,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "All, so that you and I can get from New York to London in a few hours instead of a few days."
    } ]
  }, {
    "tStartMs": 274340,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "I am here in the escape hatch of the AIRBUS A350."
    } ]
  }, {
    "tStartMs": 278740,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Ahh, if there were an emergency I would have to jump out of this place."
    } ]
  }, {
    "tStartMs": 281540,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "But I would like to say thank you to AIRBUS for bringing me here,"
    } ]
  }, {
    "tStartMs": 285140,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "it's been an amazing trip, I have learned so much about airplanes"
    } ]
  }, {
    "tStartMs": 287680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and it's been really fun to see the production facilities and-"
    } ]
  }, {
    "tStartMs": 290480,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "and to see the test aircraft and stuff like this."
    } ]
  }, {
    "tStartMs": 292620,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So yeah, thank you to AIRBUS for allowing this to happen, I hope you've enjoyed it."
    } ]
  }, {
    "tStartMs": 296100,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "I can't believe how big this airplane is."
    } ]
  }, {
    "tStartMs": 298060,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "It is huge."
    } ]
  }, {
    "tStartMs": 298980,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "I don't want to jump out."
    } ]
  }, {
    "tStartMs": 307080,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Oh, and one more thing:"
    } ]
  }, {
    "tStartMs": 308340,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "If you'd like to buy an AIRBUS A350,"
    } ]
  }, {
    "tStartMs": 310460,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "just get in touch with AIRBUS and let them know I sent you."
    } ]
  }, {
    "tStartMs": 312440,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "(wink)"
    } ]
  }, {
    "tStartMs": 312940,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "LOL"
    } ]
  } ]
}
