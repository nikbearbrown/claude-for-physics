  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 360,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "Quantum mechanics is weird, right?"
    } ]
  }, {
    "tStartMs": 2510,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "But did you know that some of its supposed\npeculiarities are not unique to quantum physics"
    } ]
  }, {
    "tStartMs": 5920,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "but are just properties of waves in general?"
    } ]
  }, {
    "tStartMs": 7610,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "Take the uncertainty principle - it says that\nthe better we know where a particle is, the"
    } ]
  }, {
    "tStartMs": 12019,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "less we know about how fast it's going."
    } ]
  }, {
    "tStartMs": 13969,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "There's a limit to how much we can know!"
    } ]
  }, {
    "tStartMs": 15949,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "But this isn't just quantum weirdness - it\nhappens all the time with normal everyday"
    } ]
  }, {
    "tStartMs": 19260,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "waves!"
    } ]
  }, {
    "tStartMs": 20260,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Remember that the frequency of a wave is how\nclose the wave crests are to each other - a"
    } ]
  }, {
    "tStartMs": 23540,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "low frequency wave doesn't have nearly as\nmuch oomph as a high frequency one!"
    } ]
  }, {
    "tStartMs": 26550,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "And the position of a wave is… well, where\nthe wave is… mostly."
    } ]
  }, {
    "tStartMs": 31030,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "So where exactly is a wave?"
    } ]
  }, {
    "tStartMs": 32110,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "It's spread out everywhere, right?"
    } ]
  }, {
    "tStartMs": 33690,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Ok, but for a wave pulse it's pretty easy\nto see where the wave is."
    } ]
  }, {
    "tStartMs": 37030,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So now that we know where the pulse is, what's\nit's frequency?"
    } ]
  }, {
    "tStartMs": 40420,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Well, a localized pulse doesn't really \"wave\",\nso we can't measure the frequency of its crests!"
    } ]
  }, {
    "tStartMs": 45220,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And that's the uncertainty principle in a\nnutshell - you can either know where a wave"
    } ]
  }, {
    "tStartMs": 48790,
    "dDurationMs": 13340,
    "segs": [ {
      "utf8": "is or where it's going, but not both at the\nsame time!"
    } ]
  } ]
}
