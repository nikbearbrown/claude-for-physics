{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 190,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Dear Universe,"
    } ]
  }, {
    "tStartMs": 1190,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "I'm a big fan of yours."
    } ]
  }, {
    "tStartMs": 2570,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "You're so fresh and real, and I love how you\nmanage to be fascinating day in and day out!"
    } ]
  }, {
    "tStartMs": 6840,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "I'm particularly impressed by your devotion\nto the laws of nature and how you stick to"
    } ]
  }, {
    "tStartMs": 10230,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "them regardless of opinion polls of scientists\nor the public."
    } ]
  }, {
    "tStartMs": 13400,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Of course, our goal in science is to find\nout how you work by careful observation."
    } ]
  }, {
    "tStartMs": 16700,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "But it doesn't matter at all if I believe\nin a theory or not - what matters is whether"
    } ]
  }, {
    "tStartMs": 20460,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "you work that way."
    } ]
  }, {
    "tStartMs": 21460,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "A lot of popular ideas (like, \"the earth is\nflat\") turned out to be wrong, and a lot of"
    } ]
  }, {
    "tStartMs": 25110,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "uncomfortable ideas (like quantum mechanics,\nevolution and plate tectonics) turned out"
    } ]
  }, {
    "tStartMs": 29370,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "to be right."
    } ]
  }, {
    "tStartMs": 30370,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "But I don't need to tell you that, you know\nalready - in fact, you set the rules."
    } ]
  }, {
    "tStartMs": 34260,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "It's a dictatorship, Universe: you decide\nhow you work, and I get no vote!"
    } ]
  }, {
    "tStartMs": 38670,
    "dDurationMs": 4069,
    "segs": [ {
      "utf8": "I would complain, except that I DO get to\ndecide where to stick my nose and which questions"
    } ]
  }, {
    "tStartMs": 42739,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "to ask, and that's what makes science (and\nlife) fun."
    } ]
  }, {
    "tStartMs": 45140,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "Plus, you're beautiful."
    } ]
  }, {
    "tStartMs": 46219,
    "dDurationMs": 4251,
    "segs": [ {
      "utf8": "If you ever get this message, please let me\nknow by encoding your response in the digits"
    } ]
  }, {
    "tStartMs": 50470,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "of pi."
    } ]
  }, {
    "tStartMs": 51470,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And thanks for being so incredible."
    } ]
  }, {
    "tStartMs": 52550,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Sincerely,"
    } ]
  }, {
    "tStartMs": 53550,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "A collection of atoms known as Henry"
    } ]
  } ]
}
