    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Active Noise Cancellation. Coming in four unique \ncolors, these noise canceling earbuds come with  "
    } ]
  }, {
    "tStartMs": 1021240,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "touch controls which allow you choose one of three \nsound profiles. The Pure Sound profile is attuned  "
    } ]
  }, {
    "tStartMs": 1027240,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "for podcast or audiobooks which is helpful if \nyou need to listen to a refresher lecture on  "
    } ]
  }, {
