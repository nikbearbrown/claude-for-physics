  }, {
    "tStartMs": 275060,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "in fact, let's make it an emo party and get rid of regular massive pressure,"
    } ]
  }, {
    "tStartMs": 281420,
    "dDurationMs": 6959,
    "segs": [ {
      "utf8": "after all, in the future dark energy will completely dominate the expansion so we"
    } ]
  }, {
    "tStartMs": 288380,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "have the energy density of the vacuum and the pressure that it exerts"
