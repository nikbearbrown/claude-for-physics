  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 20,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "♪ (𝘴𝘱𝘢𝘤𝘦𝘺 𝘱𝘪𝘢𝘯𝘰 𝘯𝘰𝘵𝘦𝘴 𝘢𝘣𝘰𝘷𝘦 𝘦𝘦𝘳𝘪𝘦 𝘴𝘺𝘯𝘵𝘩 𝘥𝘳𝘰𝘯𝘪𝘯𝘨) ♪\nMATT:  If it looks like we're at the sci-fi headquarters of some league of superheroes,"
    } ]
  }, {
    "tStartMs": 4720,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "♪ ♪\nit's because we are."
    } ]
  }, {
    "tStartMs": 6100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "♪ (𝘢𝘥𝘥 𝘥𝘦𝘦𝘱𝘦𝘳 𝘴𝘺𝘯𝘵𝘩) ♪\nThis is Fermilab."
    } ]
  }, {
    "tStartMs": 7600,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "♪ (𝘢𝘥𝘥 𝘥𝘦𝘦𝘱𝘦𝘳 𝘴𝘺𝘯𝘵𝘩) ♪\nFor over half a century,"
    } ]
  }, {
    "tStartMs": 8980,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "♪ ♪\nthis has been the premier particle  accelerator facility of the United States."
    } ]
  }, {
    "tStartMs": 13460,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "♪ ♪\nThese days, many of the super-powered geniuses of Fermilab are tackling"
    } ]
  }, {
    "tStartMs": 18520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "♪ ♪\nthe most feeble particle in the universe:"
    } ]
  }, {
    "tStartMs": 21320,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "♪ (𝘩𝘪𝘨𝘩 𝘥𝘪𝘨𝘪𝘵𝘢𝘭 𝘴𝘺𝘯𝘵𝘩 𝘦𝘯𝘵𝘦𝘳𝘴 𝘳𝘩𝘺𝘵𝘩𝘮𝘪𝘤𝘢𝘭𝘭𝘺) ♪\nthe neutrino."
    } ]
  }, {
    "tStartMs": 22720,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "♪ (𝘩𝘪𝘨𝘩 𝘥𝘪𝘨𝘪𝘵𝘢𝘭 𝘴𝘺𝘯𝘵𝘩 𝘦𝘯𝘵𝘦𝘳𝘴 𝘳𝘩𝘺𝘵𝘩𝘮𝘪𝘤𝘢𝘭𝘭𝘺) ♪\nWhy?"
    } ]
  }, {
    "tStartMs": 23740,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "♪ ♪\nBecause, this elusive particle may hold powerful secrets,"
    } ]
  }, {
    "tStartMs": 27180,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "♪ ♪\nfrom the unification of the forces of nature,"
    } ]
  }, {
    "tStartMs": 30380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "♪ (𝘣𝘦𝘤𝘰𝘮𝘦𝘴 𝘥𝘢𝘳𝘬 𝘥𝘪𝘨𝘪𝘵𝘢𝘭 𝘴𝘺𝘯𝘵𝘩) ♪\nto the biggest question of all:"
    } ]
  }, {
    "tStartMs": 32120,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "♪ (𝘥𝘢𝘳𝘬 𝘥𝘪𝘨𝘪𝘵𝘢𝘭 𝘴𝘺𝘯𝘵𝘩) ♪\nWhy is there something rather than nothing?"
    } ]
  }, {
    "tStartMs": 35020,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "♪ (𝘧𝘢𝘥𝘦 𝘰𝘶𝘵) ♪\n♪ (𝘴𝘱𝘢𝘤𝘦𝘺 𝘱𝘪𝘯𝘨 𝘳𝘦𝘷𝘦𝘳𝘣𝘦𝘳𝘢𝘵𝘦𝘴) ♪"
    } ]
  }, {
    "tStartMs": 37680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "♪ (𝘧𝘢𝘥𝘦 𝘰𝘶𝘵) ♪\n(title) \"SPACE TIME\""
    } ]
  }, {
    "tStartMs": 38880,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "(title) \"SPACE TIME\""
    } ]
  }, {
    "tStartMs": 39740,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "♪ (𝘫𝘰𝘺𝘧𝘶𝘭 / 𝘢𝘯𝘵𝘪𝘤𝘪𝘱𝘢𝘵𝘰𝘳𝘺 𝘴𝘺𝘯𝘵𝘩  𝘨𝘶𝘪𝘵𝘢𝘳 𝘱𝘶𝘭𝘴𝘦𝘴) ♪\nMATT:  Everyone, I want you to meet Dr. Don Lincoln."
    } ]
  }, {
    "tStartMs": 42640,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "♪ (𝘫𝘰𝘺𝘧𝘶𝘭 / 𝘢𝘯𝘵𝘪𝘤𝘪𝘱𝘢𝘵𝘰𝘳𝘺 𝘴𝘺𝘯𝘵𝘩 𝘨𝘶𝘪𝘵𝘢𝘳 𝘱𝘶𝘭𝘴𝘦𝘴) ♪\nSo Don is a particle physics researcher here at Fermilab,"
    } ]
  }, {
    "tStartMs": 43720,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "♪ ♪\nSo Don is a particle physics researcher here at Fermilab,"
    } ]
  }, {
    "tStartMs": 46160,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "♪ ♪\nbut he also writes and hosts many of the awesome videos on Fermilab's youtube channel."
    } ]
  }, {
    "tStartMs": 50540,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 51040,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "♪ ♪\nDon, Thank you for having us."
    } ]
  }, {
    "tStartMs": 52440,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  You know, we're glad you could visit."
    } ]
  }, {
    "tStartMs": 54060,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  I'm kind of obsessed with neutrinos;"
    } ]
  }, {
    "tStartMs": 55780,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "♪ ♪\nit seems like they could open the window into the next frontier of physics."
    } ]
  }, {
    "tStartMs": 59640,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  We have a very broad research program,"
    } ]
  }, {
    "tStartMs": 61660,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "♪ ♪\nbut our core research program is centered around neutrinos,"
    } ]
  }, {
    "tStartMs": 64880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "♪ ♪\nand the big one - the future one - is the DUNE experiment."
    } ]
  }, {
    "tStartMs": 68000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "♪ (𝘴𝘱𝘢𝘤𝘦𝘺 𝘴𝘺𝘯𝘵𝘩 𝘯𝘰𝘵𝘦𝘴) ♪\n(text) \"Deep Underground Neutrino Experiment\"\nIts core - and sort of the central most important thing that it's looking for -"
    } ]
  }, {
    "tStartMs": 71240,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "♪ ♪\n(text) \"Deep Underground Neutrino Experiment\"\nis to study whether or not matter and antimatter actually act differently."
    } ]
  }, {
    "tStartMs": 75880,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "♪ ♪\nAs you know from E=mc^2, matter and antimatter should be the same,"
    } ]
  }, {
    "tStartMs": 79800,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "♪ ♪\nand they're not."
    } ]
  }, {
    "tStartMs": 81100,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "♪ ♪\nDUNE may tell us why."
    } ]
  }, {
    "tStartMs": 82840,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  Well, it sounds like we probably need to learn a little bit more about neutrinos."
    } ]
  }, {
    "tStartMs": 87520,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "♪ (𝘥𝘢𝘳𝘬 𝘴𝘺𝘯𝘵𝘩 𝘧𝘳𝘰𝘮 𝘪𝘯𝘵𝘳𝘰) ♪"
    } ]
  }, {
    "tStartMs": 88540,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "♪ (𝘥𝘢𝘳𝘬 𝘴𝘺𝘯𝘵𝘩 𝘧𝘳𝘰𝘮 𝘪𝘯𝘵𝘳𝘰) ♪\nDR. DON:  Neutrinos are elementary particles of a type called leptons."
    } ]
  }, {
    "tStartMs": 91900,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON (voiceover):  That's the same family as the familiar electron"
    } ]
  }, {
    "tStartMs": 94420,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "♪ ♪\nand it's heavier cousins the muon and tau particle."
    } ]
  }, {
    "tStartMs": 97400,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 97960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "♪ ♪\nNeutrinos also come in three flavors:"
    } ]
  }, {
    "tStartMs": 100280,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "♪ ♪\none for each of the charged leptons."
    } ]
  }, {
    "tStartMs": 102420,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "♪ ♪\nSo we have the electron neutrino,"
    } ]
  }, {
    "tStartMs": 104060,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "♪ ♪\nmuon neutrino, and tau neutrino."
    } ]
  }, {
    "tStartMs": 106180,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 106880,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "♪ (𝘢𝘥𝘥 𝘥𝘦𝘦𝘱𝘦𝘳 𝘴𝘺𝘯𝘵𝘩) ♪\nBut all neutrinos have the bizarre quality that they oscillate between these types over time."
    } ]
  }, {
    "tStartMs": 109620,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "♪ ♪\nBut all neutrinos have the bizarre quality that they oscillate between these types over time."
    } ]
  }, {
    "tStartMs": 111400,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 112280,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "♪ ♪\nMeasuring neutrino oscillations is a big part of how we unlock their secrets, but it's not easy."
    } ]
  }, {
    "tStartMs": 117520,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 118180,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "♪ ♪\nNeutrinos are among the most elusive elementary particles of nature,"
    } ]
  }, {
    "tStartMs": 121800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "♪ ♪\nonly interacting by the weak nuclear force and gravity."
    } ]
  }, {
    "tStartMs": 125000,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON (voiceover):   In fact, it would take a wall of lead five light-years thick to have a 50/50 chance at stopping a single neutrino from the Sun."
    } ]
  }, {
    "tStartMs": 133100,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "♪ ♪\nFiguring out ways to detect them is tricky to say the least."
    } ]
  }, {
    "tStartMs": 136140,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "♪ (𝘧𝘢𝘥𝘦 𝘵𝘰 𝘭𝘪𝘨𝘩𝘵 𝘳𝘩𝘺𝘵𝘩𝘮𝘪𝘤 𝘨𝘶𝘪𝘵𝘢𝘳 𝘱𝘪𝘤𝘬𝘪𝘯𝘨)♪ \n(title) \"MINOS: Main Injector Neutrino Oscillation Search\""
    } ]
  }, {
    "tStartMs": 138880,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "♪ (𝘭𝘪𝘨𝘩𝘵 𝘳𝘩𝘺𝘵𝘩𝘮𝘪𝘤 𝘨𝘶𝘪𝘵𝘢𝘳 𝘱𝘪𝘤𝘬𝘪𝘯𝘨) ♪\nMATT:  The weakly interacting nature of the neutrino makes them insanely difficult to detect,"
    } ]
  }, {
    "tStartMs": 143340,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "♪ ♪\nand we'll be seeing exactly how that's done soon."
    } ]
  }, {
    "tStartMs": 145880,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "♪ ♪\nBut in order to have a chance at spotting even one single neutrino,"
    } ]
  }, {
    "tStartMs": 150280,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "♪ ♪\na truly enormous number needs to reach the detector."
    } ]
  }, {
    "tStartMs": 153680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "♪ (𝘷𝘦𝘳𝘺 𝘴𝘰𝘧𝘵 𝘴𝘱𝘢𝘤𝘦𝘺 𝘨𝘶𝘪𝘵𝘢𝘳) ♪\nIn order to do that, neutrinos need to be focused into a beam."
    } ]
  }, {
    "tStartMs": 157620,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "♪ (𝘴𝘪𝘯𝘨𝘭𝘦 𝘴𝘱𝘢𝘤𝘦𝘺 𝘨𝘶𝘪𝘵𝘢𝘳 𝘸𝘩𝘢𝘮𝘮𝘺) ♪\nBut, if neutrinos are so weakly interacting,"
    } ]
  }, {
    "tStartMs": 159900,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "♪ ♪\nhow do we channel them into a beam in the first place?"
    } ]
  }, {
    "tStartMs": 162800,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "♪ ♪\nThe answer is:"
    } ]
  }, {
    "tStartMs": 164260,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "♪ ♪\nWe don't; at least, not directly."
    } ]
  }, {
    "tStartMs": 165520,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "♪ (𝘴𝘰𝘧𝘵 𝘸𝘩𝘢𝘮𝘮𝘺) ♪\nWe don't; at least, not directly."
    } ]
  }, {
    "tStartMs": 167300,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "♪ ♪\nMATT (voiceover):  The main Fermilab beam line accelerates protons around a two and a half mile circumference ring, using giant electromagnets,"
    } ]
  }, {
    "tStartMs": 173900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "♪ (𝘳𝘩𝘺𝘵𝘩𝘮 𝘣𝘶𝘪𝘭𝘥𝘴) ♪\nto around 99.997% the speed of light."
    } ]
  }, {
    "tStartMs": 178060,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "♪ ♪\nThat's possible because, unlike neutrinos, protons have an electric charge."
    } ]
  }, {
    "tStartMs": 182340,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "♪ ♪\nThose protons are then smashed into a graphite barrier,"
    } ]
  }, {
    "tStartMs": 185480,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "♪ ♪\nand as they collide with nuclei they produce all sorts of particles."
    } ]
  }, {
    "tStartMs": 189500,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "♪ ♪\nMore magnetic fields are used to sort the positively charged pion particles from the debris"
    } ]
  }, {
    "tStartMs": 194960,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "♪ ♪\nand focus *them* into a beam."
    } ]
  }, {
    "tStartMs": 197400,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "♪ ♪\nThose pions quickly decay into muons and muon neutrinos."
    } ]
  }, {
    "tStartMs": 200960,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "♪ (𝘴𝘰𝘧𝘵 𝘢𝘯𝘥 𝘴𝘱𝘢𝘤𝘦𝘺 𝘢𝘨𝘢𝘪𝘯) ♪\nThe beam then passes through several hundred meters of solid rock, which blocks the muons,"
    } ]
  }, {
    "tStartMs": 204020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "♪ ♪\nThe beam then passes through several hundred meters of solid rock, which blocks the muons,"
    } ]
  }, {
    "tStartMs": 205760,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "♪ (𝘴𝘰𝘧𝘵 𝘸𝘩𝘢𝘮𝘮𝘺) ♪\nbut the neutrinos pass straight through into an almost pure beam of muon neutrinos"
    } ]
  }, {
    "tStartMs": 208100,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "♪ ♪\nbut the neutrinos pass straight through into an almost pure beam of muon neutrinos"
    } ]
  }, {
    "tStartMs": 211200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "♪ ♪\nready to be sent to our detector."
    } ]
  }, {
    "tStartMs": 213000,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "♪ (𝘧𝘢𝘥𝘦 𝘵𝘰 𝘴𝘰𝘧𝘵ly 𝘣𝘳𝘰𝘰𝘥𝘪𝘯𝘨 𝘴𝘺𝘯𝘵𝘩 𝘱𝘶𝘭𝘴𝘦𝘴) ♪\n(title)  \"ICARUS (Imaging Cosmic And Rare Underground Signals):\nLiquid Argon Neutrino Hunter\""
    } ]
  }, {
    "tStartMs": 217120,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  Down here, we have the ICARUS neutrino detector."
    } ]
  }, {
    "tStartMs": 221080,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "♪ ♪\nAnd, as awesome a piece of science equipment as this looks,"
    } ]
  }, {
    "tStartMs": 224900,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "♪ ♪\nIt's definitely not five light-years of lead."
    } ]
  }, {
    "tStartMs": 227960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "♪ ♪\nHow is it supposed to stop a neutrino?"
    } ]
  }, {
    "tStartMs": 230000,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  Well,"
    } ]
  }, {
    "tStartMs": 230680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "♪ ♪\nit's entirely probabilistic."
    } ]
  }, {
    "tStartMs": 232680,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "♪ ♪\nEach neutrino has only a *tiny* possibility of interacting with any particular argon atom,"
    } ]
  }, {
    "tStartMs": 238180,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "♪ ♪\nso what we do is we shoot 10 trillion neutrinos per second through this detector,"
    } ]
  }, {
    "tStartMs": 243760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "♪ ♪\nand only a handful of them actually interact."
    } ]
  }, {
    "tStartMs": 246520,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "♪ (𝘴𝘱𝘢𝘤𝘦𝘺 𝘴𝘺𝘯𝘵𝘩 𝘣𝘦𝘭𝘭 𝘵𝘰𝘯𝘦𝘴) ♪\nAnd so, by doing that, we're able to understand what's going on."
    } ]
  }, {
    "tStartMs": 249660,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  I think we should go down there."
    } ]
  }, {
    "tStartMs": 251600,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "♪ ♪\nLet me try to give you a sense of why neutrinos are so elusive."
    } ]
  }, {
    "tStartMs": 256760,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "♪ ♪\nAs we mentioned: they only experience the weak nuclear force and gravity,"
    } ]
  }, {
    "tStartMs": 260840,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "♪ ((𝘴𝘰𝘧𝘵)) ♪\nand the latter is so weak we can ignore it altogether."
    } ]
  }, {
    "tStartMs": 264340,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "♪ ((𝘴𝘰𝘧𝘵)) ♪\nMATT (voiceover):  In order to interact with other types of matter, a neutrino needs to"
    } ]
  }, {
    "tStartMs": 267840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "♪ (𝘩𝘪𝘨𝘩 𝘴𝘺𝘯𝘵𝘩 𝘸𝘩𝘪𝘯𝘦 𝘧𝘢𝘥𝘦𝘴 𝘪𝘯) ♪\nexchange one of the carriers of the weak force:"
    } ]
  }, {
    "tStartMs": 270880,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "♪ ♪\na W or Z boson;"
    } ]
  }, {
    "tStartMs": 272760,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "♪ (𝘤𝘰𝘯𝘵𝘦𝘮𝘱𝘭𝘢𝘵𝘪𝘷𝘦 𝘦𝘭𝘦𝘤𝘵𝘳𝘪𝘤 𝘱𝘪𝘢𝘯𝘰 𝘴𝘰𝘧𝘵𝘭𝘺 𝘢𝘳𝘱𝘦𝘨𝘨𝘪𝘢𝘵𝘦𝘴) ♪\nor, truly, a virtual boson. It exists only for an instant -"
    } ]
  }, {
    "tStartMs": 276160,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "♪ (𝘤𝘰𝘯𝘵𝘦𝘮𝘱𝘭𝘢𝘵𝘪𝘷𝘦 𝘦𝘭𝘦𝘤𝘵𝘳𝘪𝘤 𝘱𝘪𝘢𝘯𝘰 𝘴𝘰𝘧𝘵𝘭𝘺 𝘢𝘳𝘱𝘦𝘨𝘨𝘪𝘢𝘵𝘦𝘴) ♪\njust long enough to exchange energy between the neutrino and, say the nucleus of an atom."
    } ]
  }, {
    "tStartMs": 277760,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "♪ ♪\njust long enough to exchange energy between the neutrino and, say the nucleus of an atom."
    } ]
  }, {
    "tStartMs": 281980,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "♪ ♪\nIt borrows the energy it needs to exist from, well, nowhere, really."
    } ]
  }, {
    "tStartMs": 286240,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "♪ ♪\nIt's sort of cheats energy conservation by taking advantage of the Heisenberg uncertainty principle,"
    } ]
  }, {
    "tStartMs": 291840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "♪ ♪\nwhich tells us that there's a fundamental uncertainty"
    } ]
  }, {
    "tStartMs": 295120,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "♪ ♪\nbetween certain pairs of properties, in this case, energy and time."
    } ]
  }, {
    "tStartMs": 299260,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 299980,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "♪ ♪\nSo: the briefer the lifetime of this virtual boson, the more energy it's allowed to borrow."
    } ]
  }, {
    "tStartMs": 305720,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "♪ (𝘥𝘳𝘢𝘮𝘢𝘵𝘪𝘤 𝘱𝘢𝘶𝘴𝘦, 𝘵𝘩𝘦𝘯 𝘴𝘢𝘮𝘦 𝘱𝘪𝘢𝘯𝘰 𝘢𝘳𝘱𝘦𝘨𝘨𝘪𝘰) ♪\nNow, the thing about the weak force bosons is that they are massive,"
    } ]
  }, {
    "tStartMs": 309340,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "♪ ♪\nunlike the massless photon or gluon, which carry the electromagnetic and strong nuclear forces."
    } ]
  }, {
    "tStartMs": 315200,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "♪ ♪\nIn order to exist, they need to borrow a lot of energy to cover their rest mass."
    } ]
  }, {
    "tStartMs": 320220,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "♪ ♪\nThat greatly limits the amount of time they can exist,"
    } ]
  }, {
    "tStartMs": 323360,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "♪ ♪\nand so limits the distance that they can travel."
    } ]
  }, {
    "tStartMs": 326220,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "♪ ♪\nIn order for a neutrino to interact with an atomic nucleus"
    } ]
  }, {
    "tStartMs": 329920,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "♪ ♪\nit needs to pass so close that it's essentially inside the nucleus."
    } ]
  }, {
    "tStartMs": 334260,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "♪ ♪\nIn other words:"
    } ]
  }, {
    "tStartMs": 335140,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "♪ ♪\nwe need a direct hit."
    } ]
  }, {
    "tStartMs": 337400,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  And if a neutrino interacts in our detector,"
    } ]
  }, {
    "tStartMs": 340020,
    "dDurationMs": 7100,
    "segs": [ {
      "utf8": "♪ ♪\nan Argon nucleus is broken apart and charged particles are released - in particular, pions and muons."
    } ]
  }, {
    "tStartMs": 347120,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "♪ ♪\nThose particles then travel through the liquid argon knocking electrons free from atoms."
    } ]
  }, {
    "tStartMs": 352180,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "♪ ♪\nWe charge the sides of the detector, so a giant electric field fills the entire tank."
    } ]
  }, {
    "tStartMs": 358080,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "♪ ♪\nThat draws these free electrons to the walls of the tank, which lets us trace out the path of the particles"
    } ]
  }, {
    "tStartMs": 364620,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "♪ ♪\nFrom those paths, we can learn all about the neutrino oscillation,"
    } ]
  }, {
    "tStartMs": 368280,
    "dDurationMs": 7020,
    "segs": [ {
      "utf8": "♪ ♪\nand that includes the flavour of the neutrino that caused it - be it an electron, muon, or tau neutrino."
    } ]
  }, {
    "tStartMs": 375300,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "♪ ♪\nBut remember: our neutrino source produces only muon neutrinos,"
    } ]
  }, {
    "tStartMs": 379240,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "♪ ♪\nso if we detect a tau or electron neutrino, then we've seen neutrino oscillation."
    } ]
  }, {
    "tStartMs": 384200,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "♪ ♪ \nWe can use our measurement to determine how much oscillation has occurred."
    } ]
  }, {
    "tStartMs": 388820,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "♪ ♪\nWhen we add that we know how far the neutrinos traveled at the speed of light, we know how fast they oscillate."
    } ]
  }, {
    "tStartMs": 394660,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "♪ ♪\nICARUS is much smaller than the upcoming DUNE experiment."
    } ]
  }, {
    "tStartMs": 398060,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "♪ ♪\nLet's see part of the new accelerator that's being built to feed DUNE."
    } ]
  }, {
    "tStartMs": 401780,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "♪ (𝘥𝘦𝘦𝘱 𝘦𝘦𝘳𝘪𝘦 𝘴𝘺𝘯𝘵𝘩 𝘥𝘳𝘰𝘯𝘦, 𝘰𝘤𝘤𝘢𝘴𝘪𝘰𝘯𝘢𝘭𝘭𝘺 𝘴𝘸𝘦𝘭𝘭𝘴) ♪\n(title) \"PIP - II: Proton Improvement Plan - II\""
    } ]
  }, {
    "tStartMs": 406380,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  We are standing in front of the injection test accelerator for 'PIP-II' - that's the Proton Improvement Plan Two -"
    } ]
  }, {
    "tStartMs": 412820,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "♪ ♪\nwhich is going to *massively* increase the number of neutrinos"
    } ]
  }, {
    "tStartMs": 416340,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "♪ ♪\nthat Fermilab will be able to send to the DUNE experiments."
    } ]
  }, {
    "tStartMs": 420320,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "♪ (𝘴𝘸𝘦𝘭𝘭𝘴) ♪ \nDon, I think you need to tell us a bit about how DUNE is actually going to work."
    } ]
  }, {
    "tStartMs": 424440,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "♪ (𝘵𝘦𝘤𝘩𝘺 𝘴𝘺𝘯𝘵𝘩 𝘢𝘯𝘥 𝘣𝘶𝘪𝘭𝘥𝘪𝘯𝘨 𝘳𝘩𝘺𝘵𝘩𝘮 𝘧𝘢𝘥𝘦 𝘰𝘷𝘦𝘳) ♪\nDR. DON:  Sure. Well, what we're gonna do is we're going to send a super intense beam of neutrinos through the Earth"
    } ]
  }, {
    "tStartMs": 430300,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "♪ ♪\n1,300 kilometers from Chicago to South Dakota, where"
    } ]
  }, {
    "tStartMs": 434800,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "♪ ♪\na huge detector weighing 70,000 tons"
    } ]
  }, {
    "tStartMs": 437700,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "♪ ♪\nconsisting of liquid argon and located a mile underground"
    } ]
  }, {
    "tStartMs": 441420,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "♪ ♪\nwill catch the beam and tell us what happened to the neutrinos as they passed from here to there."
    } ]
  }, {
    "tStartMs": 446740,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "♪ (𝘴𝘺𝘯𝘵𝘩 𝘥𝘳𝘰𝘯𝘦 𝘣𝘢𝘤𝘬 𝘪𝘯 𝘧𝘰𝘤𝘶𝘴) ♪\nMATT:  Which will, hopefully, tell us something fundamental about the difference between matter and antimatter"
    } ]
  }, {
    "tStartMs": 452880,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "♪ ♪\nWhich, also hopefully, will tell us why we live in a universe made of matter in the first place."
    } ]
  }, {
    "tStartMs": 458240,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "♪ ♪\nMATT (voiceover):  Our best understanding of particle physics tells us that matter and antimatter"
    } ]
  }, {
    "tStartMs": 462100,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "♪ (𝘭𝘰𝘸 𝘦𝘯𝘥 𝘰𝘧 𝘴𝘺𝘯𝘵𝘩 𝘧𝘢𝘥𝘦𝘴) ♪\nshould have been created in equal quantities in the early universe,"
    } ]
  }, {
    "tStartMs": 465740,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "♪ (𝘩𝘪𝘨𝘩 𝘦𝘯𝘥 𝘰𝘧 𝘴𝘺𝘯𝘵𝘩 𝘥𝘳𝘰𝘯𝘦 𝘸𝘪𝘵𝘩 𝘴𝘰𝘧𝘵, 𝘵𝘢𝘱𝘱𝘪𝘯𝘨 𝘳𝘩𝘺𝘵𝘩𝘮) ♪\nand so, should have perfectly annihilated each other"
    } ]
  }, {
    "tStartMs": 468660,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "♪ ♪\nleaving a universe of only photons."
    } ]
  }, {
    "tStartMs": 471620,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "♪ ♪\nThe fact that we see a universe full of matter"
    } ]
  }, {
    "tStartMs": 474060,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "♪ (𝘷𝘰𝘭𝘶𝘮𝘦 𝘣𝘶𝘪𝘭𝘥𝘴, 𝘴𝘺𝘯𝘵𝘩 𝘴𝘵𝘳𝘪𝘯𝘨 𝘱𝘭𝘶𝘤𝘬 𝘧𝘢𝘥𝘦𝘴 𝘰𝘷𝘦𝘳) ♪\nmeans there must have been a tiny imbalance between matter and antimatter,"
    } ]
  }, {
    "tStartMs": 478400,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "♪ (𝘴𝘰𝘧𝘵 𝘩𝘰𝘳𝘯 𝘣𝘶𝘳𝘴𝘵, 𝘩𝘪𝘨𝘩 𝘴𝘺𝘯𝘵𝘩) ♪\nenough to leave a bit of leftover stuff to produce the stars and galaxies and"
    } ]
  }, {
    "tStartMs": 482800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "♪ ♪\nparticle physicists that we see around us today."
    } ]
  }, {
    "tStartMs": 486000,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "♪ (𝘭𝘰𝘸 𝘴𝘺𝘯𝘵𝘩 𝘥𝘳𝘰𝘯𝘦 𝘳𝘦𝘵𝘶𝘳𝘯𝘴) ♪\nIn order for that to happen,"
    } ]
  }, {
    "tStartMs": 488120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "♪ ♪\nthere must have been a tiny asymmetry"
    } ]
  }, {
    "tStartMs": 491000,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "♪ (𝘭𝘰𝘸 𝘴𝘸𝘦𝘭𝘭) ♪\nbetween the behavior of matter and antimatter."
    } ]
  }, {
    "tStartMs": 494520,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "♪ (𝘭𝘰𝘸 𝘴𝘸𝘦𝘭𝘭) ♪\nThe full details of that are speculative,"
    } ]
  }, {
    "tStartMs": 497200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "♪ ♪\nbut one possibility is 'leptogenesis':"
    } ]
  }, {
    "tStartMs": 500500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "♪ ♪\na hypothetical physical process that may have occurred right after the Big Bang."
    } ]
  }, {
    "tStartMs": 502700,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "♪ (𝘴𝘭𝘰𝘸𝘭𝘺 𝘧𝘢𝘥𝘦 𝘰𝘶𝘵) ♪\na hypothetical physical process that may have occurred right after the Big Bang."
    } ]
  }, {
    "tStartMs": 506140,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "And, Don has already made an excellent video on the subject, which you should check out."
    } ]
  }, {
    "tStartMs": 508020,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "♪ (𝘥𝘪𝘧𝘧𝘶𝘴𝘦 𝘦𝘵𝘩𝘦𝘳𝘦𝘢𝘭 𝘣𝘦𝘭𝘭 𝘵𝘰𝘯𝘦𝘴 𝘧𝘢𝘥𝘦 𝘪𝘯)♪\nAnd, Don has already made an excellent video on the subject, which you should check out."
    } ]
  }, {
    "tStartMs": 511220,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "♪ (𝘥𝘪𝘧𝘧𝘶𝘴𝘦 𝘦𝘵𝘩𝘦𝘳𝘦𝘢𝘭 𝘣𝘦𝘭𝘭 𝘵𝘰𝘯𝘦𝘴 𝘧𝘢𝘥𝘦 𝘪𝘯)♪\nDR. DON:  But, the short version is that, according to leptogenesis,"
    } ]
  }, {
    "tStartMs": 513480,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  But, the short version is that, according to leptogenesis,"
    } ]
  }, {
    "tStartMs": 514340,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON (voiceover): \n neutrinos in the early universe may have decayed into other matter particles,"
    } ]
  }, {
    "tStartMs": 518640,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "♪ ♪\nwith matter neutrinos producing antimatter particles,"
    } ]
  }, {
    "tStartMs": 521180,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "♪ ♪\nand antimatter neutrinos - or anti-neutrinos - producing matter particles."
    } ]
  }, {
    "tStartMs": 526020,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  If there *was* an imbalance in the number of neutrinos versus anti neutrinos,"
    } ]
  }, {
    "tStartMs": 529700,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "♪ ♪\nthat could lead to an ultimate imbalance in the amount of matter versus antimatter."
    } ]
  }, {
    "tStartMs": 534960,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON (voiceover):  And, that same initial imbalance should also be reflected in the way neutrinos oscillate:"
    } ]
  }, {
    "tStartMs": 540100,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "♪ ♪\nwith anti-neutrinos oscillating between the three different types more slowly than matter neutrinos."
    } ]
  }, {
    "tStartMs": 546100,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  And *that* is what the DUNE experiment seeks to detect."
    } ]
  }, {
    "tStartMs": 550000,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  Well, it sounds like you all have a *lot* of work ahead of you, so we're gonna get out of your hair,"
    } ]
  }, {
    "tStartMs": 555960,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "♪ ♪\nbut thank you so much for taking us literally behind the scenes."
    } ]
  }, {
    "tStartMs": 559740,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "♪ ♪\nDR. DON:  You know, you're welcome to come anytime,"
    } ]
  }, {
    "tStartMs": 561740,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "♪ ♪\nwe love Space Time."
    } ]
  }, {
    "tStartMs": 563420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "♪ ♪\nMATT:  And we love Fermilab."
    } ]
  }, {
    "tStartMs": 565100,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "♪ ♪"
    } ]
  }, {
    "tStartMs": 565600,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "♪ ♪\nAnd that is how you study the most elusive particle in the universe."
    } ]
  }, {
    "tStartMs": 570360,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "♪ ♪\nCheck out the Fermilab channel for a much deeper dive into neutrinos and lots lots more."
    } ]
  }, {
    "tStartMs": 576660,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "♪ ♪\nIt's honestly one of my go-to resources when I'm researching"
    } ]
  }, {
    "tStartMs": 579980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "♪ ♪\na new episode of a Space Time."
    } ]
  }, {
    "tStartMs": 582020,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "♪ (𝘦𝘵𝘩𝘦𝘳𝘦𝘢𝘭 𝘣𝘦𝘭𝘭𝘴 𝘴𝘭𝘰𝘸𝘭𝘺 𝘧𝘢𝘥𝘦 𝘰𝘶𝘵) ♪"
    } ]
  }, {
    "tStartMs": 584700,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "♪ (𝘦𝘵𝘩𝘦𝘳𝘦𝘢𝘭 𝘣𝘦𝘭𝘭𝘴 𝘴𝘭𝘰𝘸𝘭𝘺 𝘧𝘢𝘥𝘦 𝘰𝘶𝘵) ♪\n(title)\n\"SPACE TIME\""
    } ]
  }, {
    "tStartMs": 586160,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "(text):  \"Matt is currently lost in the Fermilab tunnels, so comments will return after we find him.\""
