{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Thanks to Curiosity Stream for supporting PBS Digital Studios"
    } ]
  }, {
    "tStartMs": 4380,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Hook up an old analog antenna to your TV and scan between the channels."
    } ]
  }, {
    "tStartMs": 8960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That static buzz your hear"
    } ]
  }, {
    "tStartMs": 10720,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "is mostly due to the ambient radio"
    } ]
  }, {
    "tStartMs": 12840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "produced by our noisy pre-galactic Civilization"
    } ]
  }, {
    "tStartMs": 16560,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "But"
    } ]
  }, {
    "tStartMs": 17400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Around 1% of that buzz is something very different"
    } ]
  }, {
    "tStartMs": 20880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "It's the Cosmic Microwave Background radiation"
    } ]
  }, {
    "tStartMs": 24200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The remnants of the heat glow released"
    } ]
  }, {
    "tStartMs": 26760,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "when the hot dense early Universe became transparent for the first time"
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It sounds like random static"
    } ]
  }, {
    "tStartMs": 33140,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "But that buzz contains an incredible wealth of hidden information"
    } ]
  }, {
    "tStartMs": 38140,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "It holds the secrets to the composition of the Universe"
    } ]
  }, {
    "tStartMs": 41900,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and allows us to peer inside its fiery beginnings"
    } ]
  }, {
    "tStartMs": 45600,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "[Intro music]"
    } ]
  }, {
    "tStartMs": 50480,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "It's not that scientists have spent"
    } ]
  }, {
    "tStartMs": 53380,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "half a century and built multiple satellites"
    } ]
  }, {
    "tStartMs": 56620,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to unlock the mysteries of the cosmic microwave background"
    } ]
  }, {
    "tStartMs": 59100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "We've delved into its nature before"
    } ]
  }, {
    "tStartMs": 62020,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "from its formation 38,000 years after the Big Bang"
    } ]
  }, {
    "tStartMs": 65100,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "to its 1964 discovery by Penzias and Wilson"
    } ]
  }, {
    "tStartMs": 69760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "with the Holmdel Horn Antenna"
    } ]
  }, {
    "tStartMs": 72320,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "to its incredibly accurate mapping across the sky"
    } ]
  }, {
    "tStartMs": 76040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "with ever-better satellites."
    } ]
  }, {
    "tStartMs": 78040,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "It all culminated in this."
    } ]
  }, {
    "tStartMs": 81180,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The Planck Satellite's map of the CMB."
    } ]
  }, {
    "tStartMs": 84620,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Those blotches are tiny differences in temperature."
    } ]
  }, {
    "tStartMs": 88040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "deviations one part in 10,000"
    } ]
  }, {
    "tStartMs": 90700,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "from the average temperature of only 2.7 kelvin."
    } ]
  }, {
    "tStartMs": 94920,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "Those differences result from tiny variations in the density of matter right after the big bang"
    } ]
  }, {
    "tStartMs": 100660,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "which evolved as colossal sound waves reverberated through the first few hundred thousand years of the Universe's life."
    } ]
  }, {
    "tStartMs": 107780,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "We explored these baryon acoustic oscillations in the last week's episode"
    } ]
  }, {
    "tStartMs": 112820,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "and that's really worth watching first if you haven't yet"
    } ]
  }, {
    "tStartMs": 116080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "That episode painted a simplistic picture"
    } ]
  }, {
    "tStartMs": 119100,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "A quick review"
    } ]
  }, {
    "tStartMs": 120740,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "In the very beginning"
    } ]
  }, {
    "tStartMs": 122180,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Dark matter flowed towards tiny regions of increased density."
    } ]
  }, {
    "tStartMs": 125400,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "drawn by gravity"
    } ]
  }, {
    "tStartMs": 127580,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Regular matter, what we call baryons was in plasma form"
    } ]
  }, {
    "tStartMs": 131080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "with the simple atomic nuclei stripped of their electrons"
    } ]
  }, {
    "tStartMs": 135040,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "in that extreme heat"
    } ]
  }, {
    "tStartMs": 137700,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "in this plasma state, light and matter were locked together"
    } ]
  }, {
    "tStartMs": 141680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "As the baryons condensed into over-dense regions"
    } ]
  }, {
    "tStartMs": 144720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "this led to a massive buildup of pressure"
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Collapsing baryons rebounded"
    } ]
  }, {
    "tStartMs": 150060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "producing an expanding sound wave"
    } ]
  }, {
    "tStartMs": 152860,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "That expanding shell was eventually frozen in place"
    } ]
  }, {
    "tStartMs": 156480,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "380,000 years later when light decoupled from matter"
    } ]
  }, {
    "tStartMs": 161100,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "at the formation of the first atoms"
    } ]
  }, {
    "tStartMs": 163100,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the moment of Recombination"
    } ]
  }, {
    "tStartMs": 165680,
    "dDurationMs": 1596,
    "segs": [ {
      "utf8": "As the universe evolved"
    } ]
  }, {
    "tStartMs": 167276,
    "dDurationMs": 2984,
    "segs": [ {
      "utf8": "those frozen shells collapsed into galaxies"
    } ]
  }, {
    "tStartMs": 170560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "We still see them today"
    } ]
  }, {
    "tStartMs": 172080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Interwoven patterns of rings"
    } ]
  }, {
    "tStartMs": 173960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "drawn in galaxies on the sky"
    } ]
  }, {
    "tStartMs": 176300,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but those rings are not the whole story"
    } ]
  }, {
    "tStartMs": 178640,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Today we're going to explore the intricate patterning"
    } ]
  }, {
    "tStartMs": 182300,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Not of the galaxies but of the cosmic microwave background map"
    } ]
  }, {
    "tStartMs": 186940,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The image of the universe at the moment of recombination"
    } ]
  }, {
    "tStartMs": 190700,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "We'll see that the complex dynamics of the early universe"
    } ]
  }, {
    "tStartMs": 194560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "are frozen into its spots"
    } ]
  }, {
    "tStartMs": 196640,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "That pattern will tell us exactly what the universe is made of"
    } ]
  }, {
    "tStartMs": 202100,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "As I said this picture of a single expanding shell of plasma is simplistic"
    } ]
  }, {
    "tStartMs": 207060,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "In reality these acoustic waves pulse in and out of their over-dense regions"
    } ]
  }, {
    "tStartMs": 212300,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "They oscillated"
    } ]
  }, {
    "tStartMs": 213800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And the number of oscillations"
    } ]
  }, {
    "tStartMs": 215700,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "depended on how large that over-density was"
    } ]
  }, {
    "tStartMs": 219000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "In some places the over-densities were so large"
    } ]
  }, {
    "tStartMs": 222200,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "that matter only just had time to float at the centre"
    } ]
  }, {
    "tStartMs": 225340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "before being frozen in place by Recombination"
    } ]
  }, {
    "tStartMs": 227920,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "no rebounding happened"
    } ]
  }, {
    "tStartMs": 229400,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "And in other places the over-densities were smaller"
    } ]
  }, {
    "tStartMs": 232920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The density wave had time to flow in"
    } ]
  }, {
    "tStartMs": 235240,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "reverberate out and then get captured by the gravitational field once more"
    } ]
  }, {
    "tStartMs": 239100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "falling back to the centre"
    } ]
  }, {
    "tStartMs": 240480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and that could happen multiple times"
    } ]
  }, {
    "tStartMs": 242880,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "Everywhere in the universe the pull of gravity fought against the outward push of radiation pressure"
    } ]
  }, {
    "tStartMs": 248440,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "causing density oscillations of all sizes"
    } ]
  }, {
    "tStartMs": 252000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The state of those oscillations was then frozen"
    } ]
  }, {
    "tStartMs": 255200,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "at the moment of Recombination"
    } ]
  }, {
    "tStartMs": 257140,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "This messy overlapping network of oscillations resulted in"
    } ]
  }, {
    "tStartMs": 261240,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "the spotty mess that is the map of the CMB"
    } ]
  }, {
    "tStartMs": 264680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But crazily, we can untangle that mess"
    } ]
  }, {
    "tStartMs": 268040,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "We can do that by thinking of these complex oscillations"
    } ]
  }, {
    "tStartMs": 271600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "as just a bunch of very simple oscillations"
    } ]
  }, {
    "tStartMs": 274800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "of all different sizes stacked on top of each other"
    } ]
  }, {
    "tStartMs": 277900,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "This only works because the differences between the highest and"
    } ]
  }, {
    "tStartMs": 281580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "lowest density regions are so small"
    } ]
  }, {
    "tStartMs": 284420,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "so in our calculations"
    } ]
  }, {
    "tStartMs": 286000,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "we model the early Universe as many overlapping layers of"
    } ]
  }, {
    "tStartMs": 290220,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "simple density fluctuations"
    } ]
  }, {
    "tStartMs": 292220,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Each layer has fluctuations of a certain size"
    } ]
  }, {
    "tStartMs": 295720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "defined by the mathematics"
    } ]
  }, {
    "tStartMs": 297640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "of spherical harmonics"
    } ]
  }, {
    "tStartMs": 299240,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Sort of like sine waves but different wavelengths"
    } ]
  }, {
    "tStartMs": 302920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but on a 2D surface of a sphere"
    } ]
  }, {
    "tStartMs": 304840,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Fluctuations in each of these layers oscillate independently"
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "But by adding them together you can calculate the"
    } ]
  }, {
    "tStartMs": 312220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "complex fluctuations of the early universe"
    } ]
  }, {
    "tStartMs": 314620,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Thinking about the oscillations this way"
    } ]
  }, {
    "tStartMs": 316880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "leads to a really powerful prediction"
    } ]
  }, {
    "tStartMs": 320320,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Over the 380,000 years between the Big Bang and Recombination"
    } ]
  }, {
    "tStartMs": 325160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "each of our simple oscillations did its thing"
    } ]
  }, {
    "tStartMs": 328240,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Sound waves moved inwards outwards inwards outwards"
    } ]
  }, {
    "tStartMs": 332200,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "When Recombination hit"
    } ]
  }, {
    "tStartMs": 334260,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "most oscillations were caught in the middle of an in or an out flow"
    } ]
  }, {
    "tStartMs": 338900,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Those are not the interesting ones"
    } ]
  }, {
    "tStartMs": 341440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but some oscillators"
    } ]
  }, {
    "tStartMs": 343300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "those were just the right size"
    } ]
  }, {
    "tStartMs": 345400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "were caught at maximum density"
    } ]
  }, {
    "tStartMs": 347920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "matter concentrated in the middle of the fluctuation"
    } ]
  }, {
    "tStartMs": 351000,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "or at minimum density"
    } ]
  }, {
    "tStartMs": 352880,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "with matter at its most spread out"
    } ]
  }, {
    "tStartMs": 355220,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "we call that second one maximum rarefaction"
    } ]
  }, {
    "tStartMs": 359100,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "These particular oscillations defined the most  obvious spots on the CMB map"
    } ]
  }, {
    "tStartMs": 364980,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "because they were frozen in their most extreme states"
    } ]
  }, {
    "tStartMs": 367720,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "so the most prominent spots on the CMB"
    } ]
  }, {
    "tStartMs": 370100,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "will have exactly the right size"
    } ]
  }, {
    "tStartMs": 372240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to get a single collapse"
    } ]
  }, {
    "tStartMs": 374280,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "or one collapse and then an expansion"
    } ]
  }, {
    "tStartMs": 377540,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "or two complete collapses"
    } ]
  }, {
    "tStartMs": 379740,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "et cetera"
    } ]
  }, {
    "tStartMs": 380400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The oscillations happened at the same speed"
    } ]
  }, {
    "tStartMs": 383720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the speed of sound for our baryon-photon plasma"
    } ]
  }, {
    "tStartMs": 386920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which was over half the speed of light"
    } ]
  }, {
    "tStartMs": 389480,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "Okay, so"
    } ]
  }, {
    "tStartMs": 390520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We multiply the speed of sound"
    } ]
  }, {
    "tStartMs": 392520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "by the age of the universe at Recombination"
    } ]
  }, {
    "tStartMs": 395340,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "That's how far these density waves could travel"
    } ]
  }, {
    "tStartMs": 398580,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "divide that by the radius of a given density fluctuation"
    } ]
  }, {
    "tStartMs": 402420,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and we get how many half oscillations it could execute"
    } ]
  }, {
    "tStartMs": 406400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "if the result is a whole number"
    } ]
  }, {
    "tStartMs": 408460,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "then that fluctuation size will be at an extreme state"
    } ]
  }, {
    "tStartMs": 412200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "either all in or all out"
    } ]
  }, {
    "tStartMs": 413720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "at the moment of Recombination"
    } ]
  }, {
    "tStartMs": 416500,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So the sizes of these special spots"
    } ]
  }, {
    "tStartMs": 419080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "should follow a harmonic series"
    } ]
  }, {
    "tStartMs": 421900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and that's exactly what we see"
    } ]
  }, {
    "tStartMs": 423900,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "The best way to show this is with what we call a power spectrum"
    } ]
  }, {
    "tStartMs": 427880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It's really just like a histogram"
    } ]
  }, {
    "tStartMs": 430120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "that plots the number of spots of every possible size"
    } ]
  }, {
    "tStartMs": 433620,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and we definitely see that some sizes are more common than others"
    } ]
  }, {
    "tStartMs": 438980,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "This peak here"
    } ]
  }, {
    "tStartMs": 439940,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "those are spots in which the plasma only just had time to collapse"
    } ]
  }, {
    "tStartMs": 444180,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "once before Recombination"
    } ]
  }, {
    "tStartMs": 446020,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "The second peak corresponds to a full compression and a full expansion"
    } ]
  }, {
    "tStartMs": 449960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The third peak is for compression expansion and compression"
    } ]
  }, {
    "tStartMs": 454220,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "and so on"
    } ]
  }, {
    "tStartMs": 455120,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Okay now so we can explain the spot sizes"
    } ]
  }, {
    "tStartMs": 458420,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "But what does this actually tell us about the Universe?"
    } ]
  }, {
    "tStartMs": 462180,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Well kind of everything"
    } ]
  }, {
    "tStartMs": 463960,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "In fact each of these peaks"
    } ]
  }, {
    "tStartMs": 466320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "tells us something unique"
    } ]
  }, {
    "tStartMs": 467840,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Let's go through this"
    } ]
  }, {
    "tStartMs": 469100,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The main value of that first peak"
    } ]
  }, {
    "tStartMs": 471380,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Is as a measuring tape"
    } ]
  }, {
    "tStartMs": 473440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Seriously, a standard ruler"
    } ]
  }, {
    "tStartMs": 475600,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Spots of this size"
    } ]
  }, {
    "tStartMs": 477380,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "represent fluctuations that had time to collapse"
    } ]
  }, {
    "tStartMs": 480220,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "exactly once"
    } ]
  }, {
    "tStartMs": 481100,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "which means their size"
    } ]
  }, {
    "tStartMs": 482660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "had to be equal to the speed of sound"
    } ]
  }, {
    "tStartMs": 485080,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "times the amount of time that they had to collapse"
    } ]
  }, {
    "tStartMs": 488360,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Factoring in the expansion of the universe over that time"
    } ]
  }, {
    "tStartMs": 491320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that size should be about half a million light years"
    } ]
  }, {
    "tStartMs": 494200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "at Recombination"
    } ]
  }, {
    "tStartMs": 495620,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "theoretically"
    } ]
  }, {
    "tStartMs": 496980,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And that gives us our ruler"
    } ]
  }, {
    "tStartMs": 498900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now when we try to measure the size of those spots"
    } ]
  }, {
    "tStartMs": 501900,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "on the sky"
    } ]
  }, {
    "tStartMs": 503160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "we actually measure an angle"
    } ]
  }, {
    "tStartMs": 505620,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "We need to convert to a distance using trigonmetry"
    } ]
  }, {
    "tStartMs": 509600,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "and to do that we have to assume a flat universe"
    } ]
  }, {
    "tStartMs": 514220,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "By flat, I mean geometrically regular"
    } ]
  }, {
    "tStartMs": 517720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Parallel lines stay parallel"
    } ]
  }, {
    "tStartMs": 520280,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "the angles of a triangle add up to 180 degrees"
    } ]
  }, {
    "tStartMs": 523260,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "However"
    } ]
  }, {
    "tStartMs": 524540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the presence of matter and energy"
    } ]
  }, {
    "tStartMs": 526740,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "as well as cosmic expansion"
    } ]
  }, {
    "tStartMs": 528560,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cause geometry to be curved"
    } ]
  }, {
    "tStartMs": 531920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which would mess up our basic trig"
    } ]
  }, {
    "tStartMs": 534080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So here we have a test"
    } ]
  }, {
    "tStartMs": 536740,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "if we measure the angular size of a spot"
    } ]
  }, {
    "tStartMs": 540020,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and use simple geometry"
    } ]
  }, {
    "tStartMs": 541740,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and that gives us the exact"
    } ]
  }, {
    "tStartMs": 543500,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "physical size that we expect"
    } ]
  }, {
    "tStartMs": 545860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "from our theory from our standard ruler"
    } ]
  }, {
    "tStartMs": 548500,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "then that's a good indication that our universe is geometrically flat"
    } ]
  }, {
    "tStartMs": 553340,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And apparently it is"
    } ]
  }, {
    "tStartMs": 555280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The spots are about one degree on the sky"
    } ]
  }, {
    "tStartMs": 557920,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "which corresponds to that half a million light years"
    } ]
  }, {
    "tStartMs": 561140,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that we got from the prediction"
    } ]
  }, {
    "tStartMs": 563220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to the limits of our abilities to measure those sizes"
    } ]
  }, {
    "tStartMs": 567140,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "the universe is flat"
    } ]
  }, {
    "tStartMs": 568680,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "That tells us something very important"
    } ]
  }, {
    "tStartMs": 570800,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It tells us the total amount of energy in the Universe"
    } ]
  }, {
    "tStartMs": 574540,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Energy results in positive curvature"
    } ]
  }, {
    "tStartMs": 577100,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "due to its positive gravitational effect"
    } ]
  }, {
    "tStartMs": 579760,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "On the other hand"
    } ]
  }, {
    "tStartMs": 580920,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "an expanding universe with no energy"
    } ]
  }, {
    "tStartMs": 583400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "would have negative curvature"
    } ]
  }, {
    "tStartMs": 585440,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "So a flat universe"
    } ]
  }, {
    "tStartMs": 587500,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "must have exactly the right amount of energy"
    } ]
  }, {
    "tStartMs": 590280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to flatten the geometry of the Universe"
    } ]
  }, {
    "tStartMs": 592900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So that first peak"
    } ]
  }, {
    "tStartMs": 594100,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "tells us the Universe is flat"
    } ]
  }, {
    "tStartMs": 595980,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Therefore it tells us"
    } ]
  }, {
    "tStartMs": 597420,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "the total amount of energy"
    } ]
  }, {
    "tStartMs": 599380,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It tells us the sum total of baryons,"
    } ]
  }, {
    "tStartMs": 601860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "dark matter, and dark energy"
    } ]
  }, {
    "tStartMs": 604160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "We'll see how useful that is"
    } ]
  }, {
    "tStartMs": 606240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "when we look at the rest of the peaks"
    } ]
  }, {
    "tStartMs": 608560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Okay onto the second peak"
    } ]
  }, {
    "tStartMs": 610540,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "That peak represents maximum rarefaction"
    } ]
  }, {
    "tStartMs": 614100,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Fluctuations where matter had bounced back once after its initial collapse"
    } ]
  }, {
    "tStartMs": 619220,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "To understand the use of the second peak"
    } ]
  }, {
    "tStartMs": 621520,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "we need to use an analogy"
    } ]
  }, {
    "tStartMs": 623080,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "We can think of these oscillations as being like heavy masses attached to a spring"
    } ]
  }, {
    "tStartMs": 627160,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Release the mass then it falls and then bounces up again"
    } ]
  }, {
    "tStartMs": 630780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "always back to the original position"
    } ]
  }, {
    "tStartMs": 632780,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "if it's a perfect spring"
    } ]
  }, {
    "tStartMs": 634380,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "But the heavier the mass"
    } ]
  }, {
    "tStartMs": 635940,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "the further it will fall"
    } ]
  }, {
    "tStartMs": 637540,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "before bouncing up"
    } ]
  }, {
    "tStartMs": 638940,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Think of the baryons as this mass"
    } ]
  }, {
    "tStartMs": 641100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "They're heavy and they want to fall towards our over-dense spots"
    } ]
  }, {
    "tStartMs": 645100,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "But the baryons are locked with light"
    } ]
  }, {
    "tStartMs": 647480,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "which act like our spring"
    } ]
  }, {
    "tStartMs": 649060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The more baryons, the deeper matter will fall"
    } ]
  }, {
    "tStartMs": 651640,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "into that over-density"
    } ]
  }, {
    "tStartMs": 653700,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Having more baryons should enhance the odd-numbered peaks"
    } ]
  }, {
    "tStartMs": 658180,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "which represent the compressed state"
    } ]
  }, {
    "tStartMs": 660840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "On the other hand"
    } ]
  }, {
    "tStartMs": 661980,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "the even numbered peaks"
    } ]
  }, {
    "tStartMs": 663640,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "aren't directly affected by the baryons"
    } ]
  }, {
    "tStartMs": 665940,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "They represent the top of the spring's rise"
    } ]
  }, {
    "tStartMs": 668680,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which is just determined"
    } ]
  }, {
    "tStartMs": 670300,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "by its starting position"
    } ]
  }, {
    "tStartMs": 671740,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "What does this have to do with the second peak?"
    } ]
  }, {
    "tStartMs": 674340,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Well"
    } ]
  }, {
    "tStartMs": 674940,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "The more baryons"
    } ]
  }, {
    "tStartMs": 676060,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the higher the odd-numbered peaks"
    } ]
  }, {
    "tStartMs": 678280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are compared to the even-numbered peaks"
    } ]
  }, {
    "tStartMs": 680800,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In practice, we can just use the height of the second peak"
    } ]
  }, {
    "tStartMs": 684280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "relative to the first peak"
    } ]
  }, {
    "tStartMs": 686040,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "to measure the baryon content of the Universe"
    } ]
  }, {
    "tStartMs": 688880,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And those measurements tell use that that baryons constitute"
    } ]
  }, {
    "tStartMs": 692960,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "only about 5% of the total energy of the Universe"
    } ]
  }, {
    "tStartMs": 696560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And finally we get to the other peaks"
    } ]
  }, {
    "tStartMs": 698320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which represent the smallest fluctuations"
    } ]
  }, {
    "tStartMs": 701300,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "These tell us about the dark matter"
    } ]
  }, {
    "tStartMs": 703760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Well more accurately"
    } ]
  }, {
    "tStartMs": 705200,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they tell us about the relative amount of dark matter"
    } ]
  }, {
    "tStartMs": 707960,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "compared to radiation, or light"
    } ]
  }, {
    "tStartMs": 710900,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Now this is a bit too much of a rabbit hole for right now"
    } ]
  }, {
    "tStartMs": 714140,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "But in short"
    } ]
  }, {
    "tStartMs": 715060,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "In the first few tens of thousands of years"
    } ]
  }, {
    "tStartMs": 718220,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "the Universe was in the"
    } ]
  }, {
    "tStartMs": 719780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "radiation-dominated epoch"
    } ]
  }, {
    "tStartMs": 722220,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Basically photons produced more gravity than matter"
    } ]
  }, {
    "tStartMs": 725820,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Fluctuations that were small enough"
    } ]
  }, {
    "tStartMs": 728240,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "to oscillate at least once during this brief time"
    } ]
  }, {
    "tStartMs": 732520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "should be enhanced"
    } ]
  }, {
    "tStartMs": 733800,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Their peaks on the power spectrum should be raised"
    } ]
  }, {
    "tStartMs": 736880,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "compared to the larger fluctuations"
    } ]
  }, {
    "tStartMs": 739000,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "So by looking at the height of those smaller peaks"
    } ]
  }, {
    "tStartMs": 742320,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "You can actually figure out when the radiation epoch gave way"
    } ]
  }, {
    "tStartMs": 746400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to the Dark Matter-dominated Epoch"
    } ]
  }, {
    "tStartMs": 748700,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "That in turn tells you how much dark matter there is"
    } ]
  }, {
    "tStartMs": 752280,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Spoiler: There's a lot."
    } ]
  }, {
    "tStartMs": 754460,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "OK, Let's bring all this together"
    } ]
  }, {
    "tStartMs": 756700,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The size of the spots in the first peak"
    } ]
  }, {
    "tStartMs": 759180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "tells you the total amount of dark energy"
    } ]
  }, {
    "tStartMs": 761760,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "dark energy, and baryons"
    } ]
  }, {
    "tStartMs": 763680,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The second peak gives you just the amount of baryons"
    } ]
  }, {
    "tStartMs": 767120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and the higher peaks give you the amount of Dark Matter"
    } ]
  }, {
    "tStartMs": 771000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Combining this, we can separate the"
    } ]
  }, {
    "tStartMs": 773860,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "relative contents of all three components"
    } ]
  }, {
    "tStartMs": 775600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "extrapolate that to the modern Universe"
    } ]
  }, {
    "tStartMs": 778140,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and we get the baryons constitute"
    } ]
  }, {
    "tStartMs": 780380,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "only about 5% of the mass and energy"
    } ]
  }, {
    "tStartMs": 782580,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "that's all of the atoms in all of the stars in all of the galaxies"
    } ]
  }, {
    "tStartMs": 786460,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "basically everything you can see"
    } ]
  }, {
    "tStartMs": 788600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The remaining 95% is the so-called Dark Sector"
    } ]
  }, {
    "tStartMs": 792040,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Dark matter is 26.5%"
    } ]
  }, {
    "tStartMs": 795100,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "and dark energy is a whopping 68.5%"
    } ]
  }, {
    "tStartMs": 798460,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "This is a super-important verification"
    } ]
  }, {
    "tStartMs": 801720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "because we get approximately the same numbers"
    } ]
  }, {
    "tStartMs": 804280,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "when we look at the dark matter content in modern galaxies and clusters"
    } ]
  }, {
    "tStartMs": 808660,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and the dark energy based on measuring"
    } ]
  }, {
    "tStartMs": 811220,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "the accelerating expansion rate of the Universe"
    } ]
  }, {
    "tStartMs": 813960,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "So that's how you lay bare the secrets of the cosmic microwave background"
    } ]
  }, {
    "tStartMs": 818620,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It's an insane wealth of information"
    } ]
  }, {
    "tStartMs": 821100,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "f rom what looks like random minuscule fluctuations"
    } ]
  }, {
    "tStartMs": 824380,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "in this faint noisy buzz"
    } ]
  }, {
    "tStartMs": 826780,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "So next time you hear the static of an untuned TV or radio"
    } ]
  }, {
    "tStartMs": 831100,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "remember that in that noise can be found"
    } ]
  }, {
    "tStartMs": 833860,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "the secrets of the earliest epochs of Spacetime"
    } ]
  }, {
    "tStartMs": 837560,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Thank you to Curiosity Stream for supporting PBS Digital Studios"
    } ]
  }, {
    "tStartMs": 841240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Curiosity Stream is a subscription-streaming service"
    } ]
  }, {
    "tStartMs": 844120,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "That offers documentaries and non-fiction titles"
    } ]
  }, {
    "tStartMs": 846800,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "from a variety of film-makers"
    } ]
  }, {
    "tStartMs": 848660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "including Curiosity Stream originals"
    } ]
  }, {
    "tStartMs": 851520,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "For example you can check out the Joy of Chance"
    } ]
  }, {
    "tStartMs": 854560,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "which explores whether chance is a fundamental part of"
    } ]
  }, {
    "tStartMs": 858160,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "the Universe"
    } ]
  }, {
    "tStartMs": 859420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and it probes whether chance has"
    } ]
  }, {
    "tStartMs": 862280,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "rules..."
    } ]
  }, {
    "tStartMs": 863040,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "You can learn more at curiositystream.com/spacetime"
    } ]
  }, {
    "tStartMs": 868080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "In our previous episode we started"
    } ]
  }, {
    "tStartMs": 870400,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "our discussion of the baryon-acoustic oscillation"
    } ]
  }, {
    "tStartMs": 873400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the actual source or our CMB power spectrum"
    } ]
  }, {
    "tStartMs": 876280,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Let's see what you guys had to say"
    } ]
  }, {
    "tStartMs": 878420,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "flux_capacitor and Marcus Kunrath"
    } ]
  }, {
    "tStartMs": 880660,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "point out that the baryon-acoustic oscillations"
    } ]
  }, {
    "tStartMs": 883040,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "should have produced bubbles, spheres"
    } ]
  }, {
    "tStartMs": 885820,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "rather than rings on the sky"
    } ]
  }, {
    "tStartMs": 887820,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "That's right, they definitely would have produced"
    } ]
  }, {
    "tStartMs": 891360,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "3D spherical shells"
    } ]
  }, {
    "tStartMs": 893560,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "not rings"
    } ]
  }, {
    "tStartMs": 894720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Sorry if I wasn't clear about that"
    } ]
  }, {
    "tStartMs": 896800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So you should actually have"
    } ]
  }, {
    "tStartMs": 898600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "overlapping bubbles of galaxies"
    } ]
  }, {
    "tStartMs": 900820,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "throughout the Universe"
    } ]
  }, {
    "tStartMs": 902200,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But we only see a 2D projection"
    } ]
  }, {
    "tStartMs": 904940,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "of that Universe"
    } ]
  }, {
    "tStartMs": 906440,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "When we look"
    } ]
  }, {
    "tStartMs": 907240,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "through the edges of these bubbles"
    } ]
  }, {
    "tStartMs": 910060,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "we see many more galaxies"
    } ]
  }, {
    "tStartMs": 911740,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "compared to when we look through the thin layer of the middle of the bubble"
    } ]
  }, {
    "tStartMs": 915340,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "It's just like when you look at soap bubbles"
    } ]
  }, {
    "tStartMs": 918020,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the edge is darker than the centre"
    } ]
  }, {
    "tStartMs": 920500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "aspuzling noticed that"
    } ]
  }, {
    "tStartMs": 922100,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "the graph of the CMB power spectrum"
    } ]
  }, {
    "tStartMs": 924520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "has a first peak at 105Mpc"
    } ]
  }, {
    "tStartMs": 928600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "rather than 150 Mpc"
    } ]
  }, {
    "tStartMs": 931000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "which is the size I actually stated"
    } ]
  }, {
    "tStartMs": 933740,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Now the reason for this is that the authors of that paper"
    } ]
  }, {
    "tStartMs": 937440,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "use a different value for the Hubble constant"
    } ]
  }, {
    "tStartMs": 941220,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "See, the quoted distance is the co-moving distance"
    } ]
  }, {
    "tStartMs": 944780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's the size the ring would have"
    } ]
  }, {
    "tStartMs": 946940,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "if it existed in the modern Universe"
    } ]
  }, {
    "tStartMs": 949300,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "given the rate of expansion of the Universe"
    } ]
  }, {
    "tStartMs": 951640,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "The surveys that measure these rings"
    } ]
  }, {
    "tStartMs": 954080,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "look so far in distance"
    } ]
  }, {
    "tStartMs": 956280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that we're actually looking into a younger smaller Universe"
    } ]
  }, {
    "tStartMs": 959320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "In order to consistently consider ring sizes"
    } ]
  }, {
    "tStartMs": 962480,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "we convert to co-moving size"
    } ]
  }, {
    "tStartMs": 964900,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So the size they would have in the modern Universe"
    } ]
  }, {
    "tStartMs": 967840,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But to do that you have to assume an expansion rate for the Universe"
    } ]
  }, {
    "tStartMs": 971920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "the Hubble constant"
    } ]
  }, {
    "tStartMs": 973380,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The power spectrum I showed"
    } ]
  }, {
    "tStartMs": 975220,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "is from the Sloane Digital Sky Survey"
    } ]
  }, {
    "tStartMs": 978300,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Eisenstein et al. 2005"
    } ]
  }, {
    "tStartMs": 979820,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "and they use a smaller Hubble constant"
    } ]
  }, {
    "tStartMs": 981880,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "giving a smaller current ring size"
    } ]
  }, {
    "tStartMs": 984100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "than the currently accepted 150Mpc"
    } ]
  }, {
    "tStartMs": 987280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Juki who is 13 and wants to become a theoretical physicist"
    } ]
  }, {
    "tStartMs": 990900,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "wanted to thank us for our content"
    } ]
  }, {
    "tStartMs": 993480,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Juki, thank YOU for letting us know your awesome dreams!"
    } ]
  }, {
    "tStartMs": 997740,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is exactly why we do this!"
    } ]
  }, {
    "tStartMs": 999740,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "I remember that when I realised I wanted to become a physicist"
    } ]
  }, {
    "tStartMs": 1002880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It seemed like that I'd glimpsed a secret layer of reality"
    } ]
  }, {
    "tStartMs": 1006920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that I just had to figure out"
    } ]
  }, {
    "tStartMs": 1009460,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It was kind of like getting my letter from Hogwarts"
    } ]
  }, {
    "tStartMs": 1013380,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Seriously"
    } ]
  }, {
    "tStartMs": 1014640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And so now you've got yours too"
    } ]
  }, {
    "tStartMs": 1016940,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "So what does that mean?"
    } ]
  }, {
    "tStartMs": 1018460,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Well it means that magic is real"
    } ]
  }, {
    "tStartMs": 1020160,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "and you're in for a lot of hard but fascinating work"
    } ]
  }, {
    "tStartMs": 1023820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And when you're done you'll be a Wizard."
    } ]
  }, {
    "tStartMs": 1028500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "[music]"
    } ]
  } ]
}
