    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "keeps your online identity safe by encrypting \nall of the information sent between your  "
    } ]
  }, {
    "tStartMs": 896400,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "device and the internet. Using a VPN when using \npublic wifi can help you more safely surf the  "
    } ]
  }, {
    "tStartMs": 902160,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "internet, but it’s also very useful when you’re \nworking from home. A lot of online services use  "
    } ]
  }, {
    "tStartMs": 905940,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "sophisticated targeting and tracking services, \nbut a VPN can protect you from that. Surfshark’s  "
    } ]
  }, {
    "tStartMs": 912240,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "CleanWeb feature blocks ads, trackers, malware \nand phishing attempts making the internet safer  "
    } ]
  }, {
    "tStartMs": 916174,
    "dDurationMs": 3206,
    "segs": [ {
      "utf8": "while you work from home. And if you do a lot of \ninternational traveling like I have, Surfshark  "
    } ]
  }, {
    "tStartMs": 919380,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "allows you to change your virtual location. \nIt has over 3200 servers in more than 100  "
    } ]
  }, {
    "tStartMs": 924540,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "countries meaning you never have to miss out on \nyour home country’s features while traveling.  "
    } ]
  }, {
    "tStartMs": 929760,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "To learn more go to Surfshark.deals/spacetime \nor click the link in the description."
    } ]
  } ]
}
