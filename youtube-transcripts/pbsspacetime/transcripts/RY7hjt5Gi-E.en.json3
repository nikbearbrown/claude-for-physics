{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 290,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- Physicists have a long history"
    } ]
  }, {
    "tStartMs": 2220,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "of sticking our noses\nwhere they don't belong,"
    } ]
  }, {
    "tStartMs": 4280,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "and one of our favorite places\nto step beyond our expertise"
    } ]
  }, {
    "tStartMs": 7840,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "is the question of\nconsciousness and free will."
    } ]
  }, {
    "tStartMs": 10780,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Sometimes our musings are\ninsightful, sometimes incoherent,"
    } ]
  }, {
    "tStartMs": 14530,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and usually at least somewhat naive,"
    } ]
  }, {
    "tStartMs": 17250,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "which is a fair description of this show."
    } ]
  }, {
    "tStartMs": 19700,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So of course, \"Space\nTime\" needs to weigh in"
    } ]
  }, {
    "tStartMs": 22370,
    "dDurationMs": 2986,
    "segs": [ {
      "utf8": "on the subject of physics and free will."
    } ]
  }, {
    "tStartMs": 25356,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 30300,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "In recent episodes, we explored\nthe notion of determinism"
    } ]
  }, {
    "tStartMs": 32960,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "in the context of the block universe idea"
    } ]
  }, {
    "tStartMs": 34930,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "that we get from Einstein's relativity."
    } ]
  }, {
    "tStartMs": 36810,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "In it, the past and future"
    } ]
  }, {
    "tStartMs": 38350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "have a sort of eternal timeless existence"
    } ]
  }, {
    "tStartMs": 41110,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "from the point of view\nof some god-like observer"
    } ]
  }, {
    "tStartMs": 43750,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "outside both space and time."
    } ]
  }, {
    "tStartMs": 45600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And this naturally brings into focus"
    } ]
  }, {
    "tStartMs": 48100,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "the question of how physics relates"
    } ]
  }, {
    "tStartMs": 50370,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "to the concept of free will."
    } ]
  }, {
    "tStartMs": 52030,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "The most evocative expression\nof perfect determinism"
    } ]
  }, {
    "tStartMs": 55360,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "is given by Laplace's demon."
    } ]
  }, {
    "tStartMs": 57810,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "In 1814, Pierre Simon Laplace postulated"
    } ]
  }, {
    "tStartMs": 61010,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that a sufficiently vast intellect"
    } ]
  }, {
    "tStartMs": 63010,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "that had perfect knowledge\nof the current state"
    } ]
  }, {
    "tStartMs": 65100,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "of the universe, like the\npositions and velocities"
    } ]
  }, {
    "tStartMs": 67400,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of all particles,"
    } ]
  }, {
    "tStartMs": 68233,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "and perfect knowledge\nof the laws of nature"
    } ]
  }, {
    "tStartMs": 70580,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "could calculate perfectly all\nfuture states of the universe."
    } ]
  }, {
    "tStartMs": 74040,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If you accept that the mind\nis generated by the brain,"
    } ]
  }, {
    "tStartMs": 77920,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "which is made of matter,"
    } ]
  }, {
    "tStartMs": 79370,
    "dDurationMs": 2827,
    "segs": [ {
      "utf8": "and you've already accepted\nthat matter follows"
    } ]
  }, {
    "tStartMs": 82197,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "the cold inviolable laws of nature,"
    } ]
  }, {
    "tStartMs": 85620,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "then your mind, every single\nthought, choice, decision,"
    } ]
  }, {
    "tStartMs": 88800,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "is the inevitable result of the long chain"
    } ]
  }, {
    "tStartMs": 91390,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "of cause and effect that came before it."
    } ]
  }, {
    "tStartMs": 94120,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "And what you do next also\nis already determined."
    } ]
  }, {
    "tStartMs": 98170,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Laplace's demon knows\nwhether or not you'll decide"
    } ]
  }, {
    "tStartMs": 101310,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you believe in free will."
    } ]
  }, {
    "tStartMs": 102900,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "There are many ways of looking\nat the concept in question"
    } ]
  }, {
    "tStartMs": 106040,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "of free will."
    } ]
  }, {
    "tStartMs": 107120,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "We are not gonna pretend to\ngive any definitive answers"
    } ]
  }, {
    "tStartMs": 109970,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "regarding its reality,"
    } ]
  }, {
    "tStartMs": 111540,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "but we do wanna look\nat the most popular way"
    } ]
  }, {
    "tStartMs": 113260,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "this question is positioned in physics,"
    } ]
  }, {
    "tStartMs": 115840,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "the idea that determinism\nnegates free will."
    } ]
  }, {
    "tStartMs": 118830,
    "dDurationMs": 2143,
    "segs": [ {
      "utf8": "Is it really that simple?"
    } ]
  }, {
    "tStartMs": 121840,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "One note before I go further."
    } ]
  }, {
    "tStartMs": 123780,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Yes, we will mention the quantum,"
    } ]
  }, {
    "tStartMs": 126350,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "but importantly, that is not to say"
    } ]
  }, {
    "tStartMs": 128470,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that free will or consciousness"
    } ]
  }, {
    "tStartMs": 130090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "are necessarily related to it."
    } ]
  }, {
    "tStartMs": 132100,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "We'll talk about that connection"
    } ]
  }, {
    "tStartMs": 133680,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "or lack thereof another time."
    } ]
  }, {
    "tStartMs": 135530,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "But understanding the\nimplications of quantum mechanics"
    } ]
  }, {
    "tStartMs": 138070,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "is key to unraveling determinism"
    } ]
  }, {
    "tStartMs": 140120,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "and its connection to predictability."
    } ]
  }, {
    "tStartMs": 142710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Quantum mechanics seems to tell us"
    } ]
  }, {
    "tStartMs": 144240,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "that one of the following is true."
    } ]
  }, {
    "tStartMs": 146270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Either the outcomes of\nquantum-scale events"
    } ]
  }, {
    "tStartMs": 148550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "are fundamentally random"
    } ]
  }, {
    "tStartMs": 150440,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "or the outcomes of quantum\nevents are perfectly determined"
    } ]
  }, {
    "tStartMs": 153620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "by quantum laws and the\napparent randomness comes"
    } ]
  }, {
    "tStartMs": 156260,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "from our limited perspective."
    } ]
  }, {
    "tStartMs": 158130,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Let's unpack these possibilities\nand what they imply"
    } ]
  }, {
    "tStartMs": 161450,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "for free will by looking at\nit in terms of information."
    } ]
  }, {
    "tStartMs": 166240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "One of the most important\nrules of quantum mechanics"
    } ]
  }, {
    "tStartMs": 168560,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "is the principle of conservation\nof quantum information."
    } ]
  }, {
    "tStartMs": 171670,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It just says that quantum information"
    } ]
  }, {
    "tStartMs": 173560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "can never be destroyed or\ncreated out of nothing."
    } ]
  }, {
    "tStartMs": 175930,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "We've talked about why"
    } ]
  }, {
    "tStartMs": 177150,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "this is such a fundamental law previously."
    } ]
  }, {
    "tStartMs": 180720,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "Let's paint a cartoon representation\nof quantum information"
    } ]
  }, {
    "tStartMs": 184030,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "in a block universe."
    } ]
  }, {
    "tStartMs": 185760,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Two dimensions of space and one of time,"
    } ]
  }, {
    "tStartMs": 187780,
    "dDurationMs": 1992,
    "segs": [ {
      "utf8": "the slices of the block universe represent"
    } ]
  }, {
    "tStartMs": 189772,
    "dDurationMs": 2768,
    "segs": [ {
      "utf8": "the causal ordering of the universe."
    } ]
  }, {
    "tStartMs": 192540,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Lower layers cause layers above them."
    } ]
  }, {
    "tStartMs": 195170,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Each bit of quantum information"
    } ]
  }, {
    "tStartMs": 197160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "can be represented as a thread."
    } ]
  }, {
    "tStartMs": 199500,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Threads are evolving quantum states."
    } ]
  }, {
    "tStartMs": 201930,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "These may transform and become\nentangled with each other,"
    } ]
  }, {
    "tStartMs": 205010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but if quantum information is conserved,"
    } ]
  }, {
    "tStartMs": 207530,
    "dDurationMs": 1565,
    "segs": [ {
      "utf8": "a thread can never vanish"
    } ]
  }, {
    "tStartMs": 209095,
    "dDurationMs": 1565,
    "segs": [ {
      "utf8": "nor start out of nothing."
    } ]
  }, {
    "tStartMs": 210660,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "We'll ignore what happens"
    } ]
  }, {
    "tStartMs": 211900,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "at the beginning of time for today."
    } ]
  }, {
    "tStartMs": 214170,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Tangled networks of these\nthreads may spend time"
    } ]
  }, {
    "tStartMs": 217010,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "as different types of matter"
    } ]
  }, {
    "tStartMs": 218830,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "and sometimes as brains,"
    } ]
  }, {
    "tStartMs": 220500,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "both as the crude matter\nthat forms the brain"
    } ]
  }, {
    "tStartMs": 222820,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "and the ephemeral configuration\nof neural connections,"
    } ]
  }, {
    "tStartMs": 225840,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "synaptic strengths, and\nelectrochemical dynamics"
    } ]
  }, {
    "tStartMs": 229000,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "from which we think emerges\nour experience of our minds."
    } ]
  }, {
    "tStartMs": 233310,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "So, information goes in\nas the stuff of the brain"
    } ]
  }, {
    "tStartMs": 236470,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and the experience of our senses,"
    } ]
  }, {
    "tStartMs": 238520,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and information comes out,"
    } ]
  }, {
    "tStartMs": 240080,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "sometimes in the form\nof the choices we make."
    } ]
  }, {
    "tStartMs": 242790,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "The brain is like a machine"
    } ]
  }, {
    "tStartMs": 244420,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "for processing information into choices."
    } ]
  }, {
    "tStartMs": 247210,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "We can parcel that\ndecision-making machine off"
    } ]
  }, {
    "tStartMs": 250290,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "from the rest of the universe,"
    } ]
  }, {
    "tStartMs": 251660,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "and we can ask, what has\nto happen inside this patch"
    } ]
  }, {
    "tStartMs": 256260,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "for us to reasonably\nattribute free will to it?"
    } ]
  }, {
    "tStartMs": 260260,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "There are different ways\nwe could define free will"
    } ]
  }, {
    "tStartMs": 262360,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "in this picture."
    } ]
  }, {
    "tStartMs": 263330,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "We could require that information\nemerging from the brain"
    } ]
  }, {
    "tStartMs": 266390,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "in the form of a decision,"
    } ]
  }, {
    "tStartMs": 268140,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "either one, incorporates\nan entirely new thread"
    } ]
  }, {
    "tStartMs": 272040,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "of quantum information,"
    } ]
  }, {
    "tStartMs": 273400,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "in violation with the\nconservation principle,"
    } ]
  }, {
    "tStartMs": 275840,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "or two, that this information\njust not be predictable"
    } ]
  }, {
    "tStartMs": 279980,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "even in principle by\nany arbitrarily precise"
    } ]
  }, {
    "tStartMs": 283210,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "far future brain scanning technology."
    } ]
  }, {
    "tStartMs": 285650,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And there are other\nrequirements we could place,"
    } ]
  }, {
    "tStartMs": 287890,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "like three, that the\nfuture not be predefined"
    } ]
  }, {
    "tStartMs": 291830,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "and not singular,"
    } ]
  }, {
    "tStartMs": 293620,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "or four, we could require that the choice"
    } ]
  }, {
    "tStartMs": 298160,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "not depend on any\nunderlying non-free-willed,"
    } ]
  }, {
    "tStartMs": 301710,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "mechanistic process, whether that process"
    } ]
  }, {
    "tStartMs": 304130,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "is deterministic or random."
    } ]
  }, {
    "tStartMs": 306180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I'm going to argue that it's reasonable"
    } ]
  }, {
    "tStartMs": 308760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to endow the brain with free will"
    } ]
  }, {
    "tStartMs": 310860,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "with some combination of the first three."
    } ]
  }, {
    "tStartMs": 313110,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "If we demand number four,"
    } ]
  }, {
    "tStartMs": 314650,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "that there's no underlying\nnon-free-willed mechanics"
    } ]
  }, {
    "tStartMs": 318190,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "to the process of choice,"
    } ]
  }, {
    "tStartMs": 320120,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "then free will probably is indeed dead."
    } ]
  }, {
    "tStartMs": 323790,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "But I'll also argue that\nthis is an unreasonable ask."
    } ]
  }, {
    "tStartMs": 328660,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "Let's start with one and two."
    } ]
  }, {
    "tStartMs": 330290,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "You are free-willed if you"
    } ]
  }, {
    "tStartMs": 331980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "or fundamentally unpredictable information"
    } ]
  }, {
    "tStartMs": 333840,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "can emerge from your\nbrain's patch of space time."
    } ]
  }, {
    "tStartMs": 337020,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Now, creating brand new\ninformation explicitly violates"
    } ]
  }, {
    "tStartMs": 340530,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "conservation of quantum information."
    } ]
  }, {
    "tStartMs": 342810,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "That said, the most\nmainstream interpretation"
    } ]
  }, {
    "tStartMs": 345070,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "of quantum mechanics has the same problem."
    } ]
  }, {
    "tStartMs": 347400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The Copenhagen interpretation insists"
    } ]
  }, {
    "tStartMs": 349440,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "that the apparent\nrandomness of quantum events"
    } ]
  }, {
    "tStartMs": 351470,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "is really random."
    } ]
  }, {
    "tStartMs": 352750,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "The quantum information in\nthe state of the wave function"
    } ]
  }, {
    "tStartMs": 355350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "before collapse is destroyed,"
    } ]
  }, {
    "tStartMs": 357480,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "but information is also created."
    } ]
  }, {
    "tStartMs": 359030,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The outcome of quantum\ninteractions are chosen"
    } ]
  }, {
    "tStartMs": 362070,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "in fundamentally unpredictable ways."
    } ]
  }, {
    "tStartMs": 364340,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Information threads both end and begin"
    } ]
  }, {
    "tStartMs": 366970,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "at every wave function collapse."
    } ]
  }, {
    "tStartMs": 368870,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The idea of random processes\ndriving our choices"
    } ]
  }, {
    "tStartMs": 371230,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "doesn't really sound like free will,"
    } ]
  }, {
    "tStartMs": 373360,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "so is there any possible way\nto generate new information"
    } ]
  }, {
    "tStartMs": 375930,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "that isn't random, that's\nsomehow intentional?"
    } ]
  }, {
    "tStartMs": 379320,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Well, actually, not really."
    } ]
  }, {
    "tStartMs": 381200,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "Think about a new thread of\nquantum information starting"
    } ]
  }, {
    "tStartMs": 384210,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "from nothing, let's say emerging\nfrom a packet of space time"
    } ]
  }, {
    "tStartMs": 387850,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "where no information enters."
    } ]
  }, {
    "tStartMs": 389930,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "By definition, it has no cause."
    } ]
  }, {
    "tStartMs": 392150,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "But the notion of choice\nimplies a deliberate cause"
    } ]
  }, {
    "tStartMs": 395640,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to that bit of information\nbeing intentionally, say,"
    } ]
  }, {
    "tStartMs": 398250,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "a one or a zero rather than\nrandomly a one or a zero."
    } ]
  }, {
    "tStartMs": 403070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But that cause is by definition a thread"
    } ]
  }, {
    "tStartMs": 405260,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "of ingoing information."
    } ]
  }, {
    "tStartMs": 406750,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "If the cause arises within\nour packet, within our brain,"
    } ]
  }, {
    "tStartMs": 410220,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "then either it itself is random"
    } ]
  }, {
    "tStartMs": 411950,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "or has its own causing thread whose origin"
    } ]
  }, {
    "tStartMs": 414790,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "is either in our brain\nand uncaused, random,"
    } ]
  }, {
    "tStartMs": 417900,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "or has an origin outside our brain,"
    } ]
  }, {
    "tStartMs": 419680,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "meaning our brain didn't choose."
    } ]
  }, {
    "tStartMs": 421750,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "You could say that the cause\narises outside the universe"
    } ]
  }, {
    "tStartMs": 425110,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "in a supernatural sense,"
    } ]
  }, {
    "tStartMs": 426410,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "but then all we need to do\nis expand our definition"
    } ]
  }, {
    "tStartMs": 428280,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "of the universe to all\nthings causally connected"
    } ]
  }, {
    "tStartMs": 430340,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and we reach the same conclusion."
    } ]
  }, {
    "tStartMs": 432230,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "The only way for new information to come"
    } ]
  }, {
    "tStartMs": 434290,
    "dDurationMs": 3515,
    "segs": [ {
      "utf8": "from a closed region is for\nit to be generated randomly"
    } ]
  }, {
    "tStartMs": 437805,
    "dDurationMs": 2065,
    "segs": [ {
      "utf8": "within that region."
    } ]
  }, {
    "tStartMs": 439870,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "On the surface, the idea\nof randomly generating"
    } ]
  }, {
    "tStartMs": 441931,
    "dDurationMs": 3479,
    "segs": [ {
      "utf8": "new streams of quantum\ninformation within a brain"
    } ]
  }, {
    "tStartMs": 445410,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "doesn't seem to help\nthe cause of free will."
    } ]
  }, {
    "tStartMs": 448800,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I'll argue shortly that\nthere's a notion of free will"
    } ]
  }, {
    "tStartMs": 451230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in which it doesn't matter the origin"
    } ]
  }, {
    "tStartMs": 453210,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "of the unpredictability of choice."
    } ]
  }, {
    "tStartMs": 455430,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "But let's first look at another source"
    } ]
  }, {
    "tStartMs": 457460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of that unpredictability."
    } ]
  }, {
    "tStartMs": 459080,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Even in a deterministic universe,"
    } ]
  }, {
    "tStartMs": 461380,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Laplace's demon is a fiction."
    } ]
  }, {
    "tStartMs": 463870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It's not just impossible in practice"
    } ]
  }, {
    "tStartMs": 465970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to perfectly measure all\nthe states of a brain,"
    } ]
  }, {
    "tStartMs": 468130,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "of neurons, their activity,\nthe molecules involved"
    } ]
  }, {
    "tStartMs": 470830,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and their signaling, et cetera."
    } ]
  }, {
    "tStartMs": 472530,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It's also impossible in principle."
    } ]
  }, {
    "tStartMs": 475630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "By that I mean, there's\na fundamental limit"
    } ]
  }, {
    "tStartMs": 478120,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "to the amount of information\nthat can be collected"
    } ]
  }, {
    "tStartMs": 480080,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "about a system."
    } ]
  }, {
    "tStartMs": 481200,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "Forget the brain, that's\ntrue even for a box full"
    } ]
  }, {
    "tStartMs": 484070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "or air molecules."
    } ]
  }, {
    "tStartMs": 485660,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "This is a direct consequence"
    } ]
  }, {
    "tStartMs": 487120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of the Heisenberg uncertainty principle,"
    } ]
  }, {
    "tStartMs": 489040,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "which tells us that measuring\none property perfectly"
    } ]
  }, {
    "tStartMs": 492390,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "leaves a counterpart\nproperty perfectly undefined."
    } ]
  }, {
    "tStartMs": 496350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So, there is no possibility\nto perfectly know the state"
    } ]
  }, {
    "tStartMs": 499050,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "of the brain or of the information threads"
    } ]
  }, {
    "tStartMs": 501160,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "that go into making it,"
    } ]
  }, {
    "tStartMs": 502850,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "either in principle or in practice,"
    } ]
  }, {
    "tStartMs": 505084,
    "dDurationMs": 3426,
    "segs": [ {
      "utf8": "because unknown random\nprocesses are at work,"
    } ]
  }, {
    "tStartMs": 508510,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "and/or perfect measurement is not possible"
    } ]
  }, {
    "tStartMs": 511280,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "for any entity that could possibly exist."
    } ]
  }, {
    "tStartMs": 514410,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But is the impossibility of\nperfect predictability enough"
    } ]
  }, {
    "tStartMs": 517610,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to endow us with free will?"
    } ]
  }, {
    "tStartMs": 520070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "What if some future type of brain scan"
    } ]
  }, {
    "tStartMs": 521960,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "allows 98% predictability of your choices?"
    } ]
  }, {
    "tStartMs": 525500,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "This is actually a very\ninteresting area of research,"
    } ]
  }, {
    "tStartMs": 528370,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "which we may talk about another time,"
    } ]
  }, {
    "tStartMs": 530030,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "but the short story is that\neven for the simplest decision,"
    } ]
  }, {
    "tStartMs": 532780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the best people have done is to predict"
    } ]
  }, {
    "tStartMs": 534700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "just a bit above chance"
    } ]
  }, {
    "tStartMs": 536380,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "at 60 to 70% accuracy and retrospectively."
    } ]
  }, {
    "tStartMs": 540660,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Which means, you could ask\nif it's even prediction"
    } ]
  }, {
    "tStartMs": 543990,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "or really just finding a correlation"
    } ]
  }, {
    "tStartMs": 545800,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "between a brain state and an\noutcome a few seconds later."
    } ]
  }, {
    "tStartMs": 549290,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And don't quote the famous\nLibet experiment at me."
    } ]
  }, {
    "tStartMs": 551970,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "It's been thoroughly cast in a new light."
    } ]
  }, {
    "tStartMs": 555420,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The short answer is we don't know how well"
    } ]
  }, {
    "tStartMs": 557850,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "we'll ever be able to forward\nmodel a brain's behavior,"
    } ]
  }, {
    "tStartMs": 561490,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "even with the best future technology."
    } ]
  }, {
    "tStartMs": 564490,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "By the way, there's also\nevidence to indicate"
    } ]
  }, {
    "tStartMs": 566356,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "that brain activity utilizes\nthe random fluctuations"
    } ]
  }, {
    "tStartMs": 569960,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "of neuronal activity to\nmake certain decisions."
    } ]
  }, {
    "tStartMs": 573330,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "In other words, a certain\ntype of randomness"
    } ]
  }, {
    "tStartMs": 575140,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "may be a feature of the brain,"
    } ]
  }, {
    "tStartMs": 577290,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "an item in its mechanistic toolbox."
    } ]
  }, {
    "tStartMs": 580240,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "So even the all-knowing Laplace demon"
    } ]
  }, {
    "tStartMs": 583100,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "may be out of luck, especially\nif quantum randomness"
    } ]
  }, {
    "tStartMs": 586130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "or quantum indeterminacy is magnified"
    } ]
  }, {
    "tStartMs": 589070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to brain-level activity."
    } ]
  }, {
    "tStartMs": 590660,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Again, not saying\nconsciousness is quantum."
    } ]
  }, {
    "tStartMs": 593360,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "We'll talk more about that soon."
    } ]
  }, {
    "tStartMs": 595080,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Another important consideration"
    } ]
  }, {
    "tStartMs": 596750,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "is whether or not the\nfuture is actually singular"
    } ]
  }, {
    "tStartMs": 599810,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "and determined, regardless\nof the existence"
    } ]
  }, {
    "tStartMs": 602670,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of any agents of choice."
    } ]
  }, {
    "tStartMs": 604620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "In the Copenhagen interpretation,"
    } ]
  }, {
    "tStartMs": 606420,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "the future is singular but undetermined."
    } ]
  }, {
    "tStartMs": 609280,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "One future will happen,"
    } ]
  }, {
    "tStartMs": 610360,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "but it's impossible to\npredict what it will be."
    } ]
  }, {
    "tStartMs": 612780,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "In the many worlds interpretation,"
    } ]
  }, {
    "tStartMs": 614320,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "the future is plural and determined."
    } ]
  }, {
    "tStartMs": 617000,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "All possible futures exist"
    } ]
  }, {
    "tStartMs": 618870,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "and develop according to the\nlaws of quantum mechanics."
    } ]
  }, {
    "tStartMs": 621490,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "In either case, there's\na place for a fair notion"
    } ]
  }, {
    "tStartMs": 623870,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "of free will."
    } ]
  }, {
    "tStartMs": 624890,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Either our brains play a part choosing"
    } ]
  }, {
    "tStartMs": 626880,
    "dDurationMs": 3057,
    "segs": [ {
      "utf8": "what future happens or\nthe choices we experience"
    } ]
  }, {
    "tStartMs": 629937,
    "dDurationMs": 3223,
    "segs": [ {
      "utf8": "are the process of choosing\nwhich many worlds future"
    } ]
  }, {
    "tStartMs": 633160,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "we travel towards,"
    } ]
  }, {
    "tStartMs": 634410,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "even if other versions\nof us choose otherwise."
    } ]
  }, {
    "tStartMs": 637130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The case where free\nwill may really struggle"
    } ]
  }, {
    "tStartMs": 639470,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "is the case of a singular\ndetermined future."
    } ]
  }, {
    "tStartMs": 642570,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "You can get this sort of\nsingular hard determinism"
    } ]
  }, {
    "tStartMs": 645050,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "with things like DeBroglie-Bohm\npilot-wave theory."
    } ]
  }, {
    "tStartMs": 647770,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "But fortunately for free will,"
    } ]
  }, {
    "tStartMs": 649030,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "such interpretations don't\nlook like they're correct,"
    } ]
  }, {
    "tStartMs": 651510,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "at least as they currently stand."
    } ]
  }, {
    "tStartMs": 653170,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "Let's talk about the fourth\nargument against free will"
    } ]
  }, {
    "tStartMs": 655980,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "in my earlier list,"
    } ]
  }, {
    "tStartMs": 657530,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "that a purely mechanistic\nprocess can't lead"
    } ]
  }, {
    "tStartMs": 660660,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "to any reasonable notion of free will."
    } ]
  }, {
    "tStartMs": 663470,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "So we've established that\nthere are plausible ways"
    } ]
  }, {
    "tStartMs": 665703,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "in which fundamental\nunpredictable information,"
    } ]
  }, {
    "tStartMs": 669470,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "perhaps in the form of choices,\ncan emerge from a brain."
    } ]
  }, {
    "tStartMs": 672470,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "So this nexus of quantum\ninformation processing"
    } ]
  }, {
    "tStartMs": 675790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "may truly be an unpredictable black box"
    } ]
  }, {
    "tStartMs": 678220,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "decision-making machine,\nat least some of the time."
    } ]
  }, {
    "tStartMs": 681610,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Add to that the fact that\nits emergent phenomenon,"
    } ]
  }, {
    "tStartMs": 684140,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "conscious free will, can\nrecursively influence"
    } ]
  }, {
    "tStartMs": 687210,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "the machine itself."
    } ]
  }, {
    "tStartMs": 688930,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The brain can talk itself into new states."
    } ]
  }, {
    "tStartMs": 691730,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Could that be enough to\ndesignate it free-willed?"
    } ]
  }, {
    "tStartMs": 695420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Some would argue no."
    } ]
  }, {
    "tStartMs": 697160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If there's a mechanistic substrate"
    } ]
  }, {
    "tStartMs": 699800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "to generating this phenomenon,"
    } ]
  }, {
    "tStartMs": 701700,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "which is founded in either deterministic"
    } ]
  }, {
    "tStartMs": 704340,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "or random processes,"
    } ]
  }, {
    "tStartMs": 706340,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "then the phenomenon is an illusion."
    } ]
  }, {
    "tStartMs": 709300,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But I think it's a reductionist fallacy"
    } ]
  }, {
    "tStartMs": 711940,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "to deny an emergent\nphenomenon any properties"
    } ]
  }, {
    "tStartMs": 714380,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "not also possessed by its parts."
    } ]
  }, {
    "tStartMs": 716570,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "A red apple is made of atoms,"
    } ]
  }, {
    "tStartMs": 718980,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "but atoms possess neither\nredness nor appleness."
    } ]
  }, {
    "tStartMs": 723020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yet, we don't say that\napples are an illusion."
    } ]
  }, {
    "tStartMs": 726020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "If it's not even in principle possible"
    } ]
  }, {
    "tStartMs": 728900,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "to perfectly predict a brain's choices,"
    } ]
  }, {
    "tStartMs": 731440,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "and that brain feels\nlike it's making choices,"
    } ]
  }, {
    "tStartMs": 733950,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "is it reasonable to deny meaningfulness"
    } ]
  }, {
    "tStartMs": 736010,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to the concept of free will"
    } ]
  }, {
    "tStartMs": 737900,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "just because the brain's\natoms don't have free will?"
    } ]
  }, {
    "tStartMs": 741330,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "The same goes with your\nconscious experience."
    } ]
  }, {
    "tStartMs": 743600,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "It's not an illusion."
    } ]
  }, {
    "tStartMs": 744940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It's an emergent phenomenon,"
    } ]
  }, {
    "tStartMs": 746800,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "and it's the most directly\nverifiably real thing"
    } ]
  }, {
    "tStartMs": 749910,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "you will ever observe."
    } ]
  }, {
    "tStartMs": 751970,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "You don't choose the mechanical behavior"
    } ]
  }, {
    "tStartMs": 754350,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "of your brain's atoms or\nthe electrical potential"
    } ]
  }, {
    "tStartMs": 757490,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that triggers each firing neuron."
    } ]
  }, {
    "tStartMs": 759730,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Those things are the\nsubstrate of your choices,"
    } ]
  }, {
    "tStartMs": 762520,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "and your choices are you."
    } ]
  }, {
    "tStartMs": 764850,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "In the end, this is all semantic."
    } ]
  }, {
    "tStartMs": 766730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "There are definitions of free will"
    } ]
  }, {
    "tStartMs": 768410,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "that we probably don't have,"
    } ]
  }, {
    "tStartMs": 770440,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "but both physics and neuroscience tell us"
    } ]
  }, {
    "tStartMs": 772640,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "that we can probably call\nourselves free-willed"
    } ]
  }, {
    "tStartMs": 774690,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "by a number of very reasonable\nand functional definitions."
    } ]
  }, {
    "tStartMs": 777920,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Ultimately, many agree that the question"
    } ]
  }, {
    "tStartMs": 780000,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "is just badly posed."
    } ]
  }, {
    "tStartMs": 781540,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "When you ask, is free will an illusion,"
    } ]
  }, {
    "tStartMs": 784570,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "what do you mean by\nfree or will or illusion"
    } ]
  }, {
    "tStartMs": 788240,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "or is, for that matter?"
    } ]
  }, {
    "tStartMs": 790010,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Well, you go ahead and enjoy\nthe very convincing illusion"
    } ]
  }, {
    "tStartMs": 792610,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that you are going to go\ndown a recursive rabbit hole"
    } ]
  }, {
    "tStartMs": 795410,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "deciding whether you have\nthe free will to decide"
    } ]
  }, {
    "tStartMs": 798580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "if free will exists."
    } ]
  }, {
    "tStartMs": 800410,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "I'm now gonna exercise my free will"
    } ]
  }, {
    "tStartMs": 802500,
    "dDurationMs": 3846,
    "segs": [ {
      "utf8": "to not end this episode with\nme saying, \"Space Time.\""
    } ]
  }, {
    "tStartMs": 806346,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "(mysterious music continues)"
    } ]
  }, {
    "tStartMs": 821442,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  } ]
}
