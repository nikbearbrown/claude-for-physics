{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "- This is one of the strangest\nmaterials I have ever seen."
    } ]
  }, {
    "tStartMs": 3750,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It is not sticky at all."
    } ]
  }, {
    "tStartMs": 6030,
    "dDurationMs": 4353,
    "segs": [ {
      "utf8": "You can't even stick regular tape to it."
    } ]
  }, {
    "tStartMs": 11700,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "But if I drape it over this tomato,"
    } ]
  }, {
    "tStartMs": 16590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "it holds it up,"
    } ]
  }, {
    "tStartMs": 18540,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "unless you turn it upside-down,"
    } ]
  }, {
    "tStartMs": 20940,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "in which case it just falls off."
    } ]
  }, {
    "tStartMs": 23490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Now does it only stick to fruit?"
    } ]
  }, {
    "tStartMs": 26010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "No, it'll stick to a water\nbottle or a bag of chips,"
    } ]
  }, {
    "tStartMs": 28980,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "basically any approximately\nsmooth surface."
    } ]
  }, {
    "tStartMs": 32430,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And that's because"
    } ]
  }, {
    "tStartMs": 33390,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "this material is made to mimic gecko skin."
    } ]
  }, {
    "tStartMs": 39060,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Artificial gecko skin"
    } ]
  }, {
    "tStartMs": 40200,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "comes out of Professor Mark\nCutkosky's Stanford lab"
    } ]
  }, {
    "tStartMs": 43380,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and it has now been used\non robotic grippers,"
    } ]
  }, {
    "tStartMs": 46740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "on tiny robots that can pull way more"
    } ]
  }, {
    "tStartMs": 49500,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "than their weight,"
    } ]
  }, {
    "tStartMs": 51060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "on a robot that floats"
    } ]
  }, {
    "tStartMs": 52770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "around the International Space Station"
    } ]
  }, {
    "tStartMs": 55410,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and even enabling a person"
    } ]
  }, {
    "tStartMs": 57480,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "to scale a glass wall, Spider-man style."
    } ]
  }, {
    "tStartMs": 61050,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It all started with a competition"
    } ]
  }, {
    "tStartMs": 62760,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "to make a robot that climbs a\nvertical wall without suction."
    } ]
  }, {
    "tStartMs": 66330,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Here's sticky type."
    } ]
  }, {
    "tStartMs": 67260,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Everybody's familiar with it."
    } ]
  }, {
    "tStartMs": 68550,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You press it on and it sticks."
    } ]
  }, {
    "tStartMs": 70530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Sticks pretty hard actually."
    } ]
  }, {
    "tStartMs": 72150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And then you peel it off."
    } ]
  }, {
    "tStartMs": 73710,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Here's gecko material."
    } ]
  }, {
    "tStartMs": 75210,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And the first thing you notice"
    } ]
  }, {
    "tStartMs": 76350,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "is that it's actually..."
    } ]
  }, {
    "tStartMs": 77820,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It's not sticky at all,"
    } ]
  }, {
    "tStartMs": 79200,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but if I lift it from the\nmiddle I can lift a football."
    } ]
  }, {
    "tStartMs": 82350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "You might say, \"Well you could do that"
    } ]
  }, {
    "tStartMs": 84360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "if you had this other sticky tape\", right?"
    } ]
  }, {
    "tStartMs": 86880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Well, yes, but if I had\nthe other sticky tape"
    } ]
  }, {
    "tStartMs": 88980,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "it wouldn't do that."
    } ]
  }, {
    "tStartMs": 90450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And that's important because\nif you're a small robot"
    } ]
  }, {
    "tStartMs": 92760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "trying to climb a wall,"
    } ]
  }, {
    "tStartMs": 94560,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "you can't afford to have something"
    } ]
  }, {
    "tStartMs": 96570,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "like chewing gum on your feet,"
    } ]
  }, {
    "tStartMs": 98340,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "'cause then every step you take is effort."
    } ]
  }, {
    "tStartMs": 100950,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "What you want is something that only grabs"
    } ]
  }, {
    "tStartMs": 103740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "when you need it to,"
    } ]
  }, {
    "tStartMs": 105300,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and that's kind of the main principle"
    } ]
  }, {
    "tStartMs": 107670,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "of our gecko-inspired adhesive."
    } ]
  }, {
    "tStartMs": 109559,
    "dDurationMs": 2491,
    "segs": [ {
      "utf8": "Here this is an early\nprototype of the sticky bot"
    } ]
  }, {
    "tStartMs": 112050,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "gecko-inspired robot."
    } ]
  }, {
    "tStartMs": 113610,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This got us into a a long effort"
    } ]
  }, {
    "tStartMs": 115800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to understand what is it"
    } ]
  }, {
    "tStartMs": 117300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that makes gecko adhesion work,"
    } ]
  }, {
    "tStartMs": 118980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "having something which grips"
    } ]
  }, {
    "tStartMs": 120990,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "but is not sticky."
    } ]
  }, {
    "tStartMs": 124770,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] Geckos are incredible climbers."
    } ]
  }, {
    "tStartMs": 126810,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "They scale walls and\neven walk on ceilings,"
    } ]
  }, {
    "tStartMs": 130110,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but for a long time we\ndidn't know how they did it."
    } ]
  }, {
    "tStartMs": 133170,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "They don't use hairs or spikes"
    } ]
  }, {
    "tStartMs": 135450,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "like spiders or other insects."
    } ]
  }, {
    "tStartMs": 137700,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "You might think they'd have\ntiny little suction cups"
    } ]
  }, {
    "tStartMs": 140610,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "at the end of their feet,"
    } ]
  }, {
    "tStartMs": 141900,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "but their adhesion"
    } ]
  }, {
    "tStartMs": 142890,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "is actually way stronger\nthan suction cups."
    } ]
  }, {
    "tStartMs": 145800,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Mark] A gecko can easily\nhang its entire weight"
    } ]
  }, {
    "tStartMs": 147990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "from just part of one toe."
    } ]
  }, {
    "tStartMs": 149910,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] The clue to how\nthis works can be seen"
    } ]
  }, {
    "tStartMs": 151830,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "if you zoom in on a gecko's toe"
    } ]
  }, {
    "tStartMs": 154140,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Mark] These are called lamella."
    } ]
  }, {
    "tStartMs": 155580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They're regions of stalks,"
    } ]
  }, {
    "tStartMs": 157620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which are called seta."
    } ]
  }, {
    "tStartMs": 159420,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And the seta branch"
    } ]
  }, {
    "tStartMs": 161010,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "into these incredibly fine\nstructures called spatula,"
    } ]
  }, {
    "tStartMs": 163680,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "which are less than one micrometer across."
    } ]
  }, {
    "tStartMs": 167010,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- [Derek] And that's important"
    } ]
  }, {
    "tStartMs": 167850,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "because the physical\nprinciple they use to stick"
    } ]
  }, {
    "tStartMs": 170700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "is actually incredibly weak."
    } ]
  }, {
    "tStartMs": 173250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's not like an ionic bond"
    } ]
  }, {
    "tStartMs": 174930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "where atoms are attracted to each other"
    } ]
  }, {
    "tStartMs": 176730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "because one is positive"
    } ]
  }, {
    "tStartMs": 178020,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and the other is negative."
    } ]
  }, {
    "tStartMs": 179430,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It's not even a hydrogen\nbond like in water"
    } ]
  }, {
    "tStartMs": 182130,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "where part of the molecule\nis slightly positive"
    } ]
  }, {
    "tStartMs": 184620,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and the other part is slightly negative."
    } ]
  }, {
    "tStartMs": 186690,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "No, geckos rely on the\nattraction between neutral atoms."
    } ]
  }, {
    "tStartMs": 191940,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "So how does that work?"
    } ]
  }, {
    "tStartMs": 194370,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Say a gecko is climbing up a glass window."
    } ]
  }, {
    "tStartMs": 197310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The gecko atoms are neutral"
    } ]
  }, {
    "tStartMs": 198930,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the glass atoms are neutral,"
    } ]
  }, {
    "tStartMs": 200850,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "but at any particular instant"
    } ]
  }, {
    "tStartMs": 202860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the electrons around in atom"
    } ]
  }, {
    "tStartMs": 204900,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "are not perfectly evenly\ndistributed about the nucleus."
    } ]
  }, {
    "tStartMs": 208410,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "They may be a little bit more\non one side than the other."
    } ]
  }, {
    "tStartMs": 211470,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And this makes the atom"
    } ]
  }, {
    "tStartMs": 212880,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "momentarily a little\npositively charged on one side"
    } ]
  }, {
    "tStartMs": 216330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and a little negatively\ncharged on the other side."
    } ]
  }, {
    "tStartMs": 219060,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Now if there's a neighboring\natom really close to it,"
    } ]
  }, {
    "tStartMs": 222120,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "say an atom for the glass\nis within a few nanometers,"
    } ]
  }, {
    "tStartMs": 224670,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "this charge can induce a\ncomplimentary charge imbalance"
    } ]
  }, {
    "tStartMs": 227760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "on the glass atom."
    } ]
  }, {
    "tStartMs": 229200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So now the electrons from the glass atom"
    } ]
  }, {
    "tStartMs": 231480,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are attracted to the\nnucleus of the gecko atom"
    } ]
  }, {
    "tStartMs": 234000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and vice versa."
    } ]
  }, {
    "tStartMs": 235590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "There is a very weak force of attraction"
    } ]
  }, {
    "tStartMs": 237540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "between gecko and glass."
    } ]
  }, {
    "tStartMs": 239580,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And this is known as a\nVan der Waal's Force."
    } ]
  }, {
    "tStartMs": 243090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Van der Waal's Forces\nare, at least in part,"
    } ]
  }, {
    "tStartMs": 245190,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "why gauge blocks,"
    } ]
  }, {
    "tStartMs": 246390,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "smooth flat pieces of steel,"
    } ]
  }, {
    "tStartMs": 248070,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "can stick together."
    } ]
  }, {
    "tStartMs": 249720,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- It's there all the time."
    } ]
  }, {
    "tStartMs": 250890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "If you have a car with, you know,"
    } ]
  }, {
    "tStartMs": 252300,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "you can put these vinyl\nsheets on the back window"
    } ]
  }, {
    "tStartMs": 254730,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so that your kids don't\nget like excessive sun"
    } ]
  }, {
    "tStartMs": 256800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "when they're in the car seat."
    } ]
  }, {
    "tStartMs": 258180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "That's also Van der Waal's Force."
    } ]
  }, {
    "tStartMs": 259710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Derek] But generally we don't notice"
    } ]
  }, {
    "tStartMs": 261720,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Van der Waal's Forces."
    } ]
  }, {
    "tStartMs": 262980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We don't feel them with our fingers"
    } ]
  }, {
    "tStartMs": 265230,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "because at least on the molecular scale,"
    } ]
  }, {
    "tStartMs": 267840,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "our skin is incredibly bumpy."
    } ]
  }, {
    "tStartMs": 270690,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Touching a piece of glass"
    } ]
  }, {
    "tStartMs": 271740,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "is like putting a mountain\nrange on top of a flat plane."
    } ]
  }, {
    "tStartMs": 275430,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "There aren't many points of close contact."
    } ]
  }, {
    "tStartMs": 278460,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "Geckos overcome this using\nall those tiny branches."
    } ]
  }, {
    "tStartMs": 283200,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- So this means that"
    } ]
  }, {
    "tStartMs": 284070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "when the gecko puts its foot down,"
    } ]
  }, {
    "tStartMs": 286110,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it has a very large\nintimate area of contact"
    } ]
  }, {
    "tStartMs": 289230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "It's almost as if you were pouring glue"
    } ]
  }, {
    "tStartMs": 291000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "on the surface"
    } ]
  }, {
    "tStartMs": 291833,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "and letting it flow."
    } ]
  }, {
    "tStartMs": 293790,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And that's what makes the adhesion work."
    } ]
  }, {
    "tStartMs": 296280,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] Replicating the gecko's"
    } ]
  }, {
    "tStartMs": 297420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "intricate branching structures"
    } ]
  }, {
    "tStartMs": 298980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "is currently impossible."
    } ]
  }, {
    "tStartMs": 300840,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- We cannot make what the gecko has."
    } ]
  }, {
    "tStartMs": 302820,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "We can't."
    } ]
  }, {
    "tStartMs": 303653,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] That structure,"
    } ]
  }, {
    "tStartMs": 304486,
    "dDurationMs": 1192,
    "segs": [ {
      "utf8": "that really fine branching structure."
    } ]
  }, {
    "tStartMs": 305678,
    "dDurationMs": 2242,
    "segs": [ {
      "utf8": "- That sophisticated branching structure."
    } ]
  }, {
    "tStartMs": 307920,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "but we can make a more\ncrude approximation."
    } ]
  }, {
    "tStartMs": 311820,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Derek] Under a microscope,"
    } ]
  }, {
    "tStartMs": 312840,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you can see that the\nartificial gecko adhesive"
    } ]
  }, {
    "tStartMs": 315210,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "is covered in rows of sharp wedges."
    } ]
  }, {
    "tStartMs": 318270,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The tips are around one\nor two micrometers wide."
    } ]
  }, {
    "tStartMs": 322110,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "That's a hundred times\nnarrower than a human hair."
    } ]
  }, {
    "tStartMs": 326100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "To create such fine structures"
    } ]
  }, {
    "tStartMs": 328080,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "requires a labor-intensive process."
    } ]
  }, {
    "tStartMs": 331050,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "A block of wax is used\nas the base for a mold"
    } ]
  }, {
    "tStartMs": 334710,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and then a razor blade\nis repeatedly pressed"
    } ]
  }, {
    "tStartMs": 337560,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "into the block creating\nwedge-shaped indents."
    } ]
  }, {
    "tStartMs": 340890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "A silicone polymer is poured into the mold"
    } ]
  }, {
    "tStartMs": 343590,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and a backing material is attached."
    } ]
  }, {
    "tStartMs": 345840,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "- This is silicone?"
    } ]
  }, {
    "tStartMs": 347586,
    "dDurationMs": 2588,
    "segs": [ {
      "utf8": "- [Lab Worker] So it's called Sylgard 170."
    } ]
  }, {
    "tStartMs": 350174,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "And it is a type of silicone, yes."
    } ]
  }, {
    "tStartMs": 352050,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] And after about 24 hours,"
    } ]
  }, {
    "tStartMs": 353670,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the adhesive is cured and ready to go."
    } ]
  }, {
    "tStartMs": 356760,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And that's what it looks like."
    } ]
  }, {
    "tStartMs": 358710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But the mold can only be used a few times"
    } ]
  }, {
    "tStartMs": 360630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "before the quality of\nthe adhesive declines"
    } ]
  }, {
    "tStartMs": 362790,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and you have to start all over again."
    } ]
  }, {
    "tStartMs": 365370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- This sharp wedge structure,"
    } ]
  }, {
    "tStartMs": 367320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which has this interesting property"
    } ]
  }, {
    "tStartMs": 369120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that when you first\nbring it up to a surface,"
    } ]
  }, {
    "tStartMs": 371640,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "the only part in contact is these tips."
    } ]
  }, {
    "tStartMs": 374940,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So therefore it's not sticky"
    } ]
  }, {
    "tStartMs": 376260,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "because there's no Van der\nWaal's Force worth mentioning."
    } ]
  }, {
    "tStartMs": 379290,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "As you load it in shear,"
    } ]
  }, {
    "tStartMs": 381600,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "these things all bend over"
    } ]
  }, {
    "tStartMs": 384240,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and we get a much larger,"
    } ]
  }, {
    "tStartMs": 385560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in fact almost continuous contact area."
    } ]
  }, {
    "tStartMs": 388080,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And so like the gecko,"
    } ]
  }, {
    "tStartMs": 389850,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "we have some Van der\nWaal's Forces to work with"
    } ]
  }, {
    "tStartMs": 392340,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "and that's what give us adhesion."
    } ]
  }, {
    "tStartMs": 395010,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "- [Derek] So to make the adhesive stick"
    } ]
  }, {
    "tStartMs": 396417,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "you have to pull it\nparallel to the surface,"
    } ]
  }, {
    "tStartMs": 398910,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that's known as a shear force,"
    } ]
  }, {
    "tStartMs": 401460,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and you have to pull it in the direction"
    } ]
  }, {
    "tStartMs": 403200,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "that will bend the wedges"
    } ]
  }, {
    "tStartMs": 404460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so that they make\ncontact with the surface."
    } ]
  }, {
    "tStartMs": 406980,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "If you pull it in any other direction,"
    } ]
  }, {
    "tStartMs": 408930,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it won't stick."
    } ]
  }, {
    "tStartMs": 410370,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This makes it easy to pull the adhesive"
    } ]
  }, {
    "tStartMs": 413130,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "straight off the surface."
    } ]
  }, {
    "tStartMs": 414480,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I mean, there is basically\nno contact force."
    } ]
  }, {
    "tStartMs": 417420,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "- [Lab Worker] And so\nthe way we clean this"
    } ]
  }, {
    "tStartMs": 418610,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "is just with tape,"
    } ]
  }, {
    "tStartMs": 419640,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "because tape doesn't stick to the Sylgard,"
    } ]
  }, {
    "tStartMs": 422477,
    "dDurationMs": 1176,
    "segs": [ {
      "utf8": "but the dust particles do."
    } ]
  }, {
    "tStartMs": 424920,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] They used this property"
    } ]
  }, {
    "tStartMs": 426330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to create an incredibly small"
    } ]
  }, {
    "tStartMs": 427950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and lightweight robot called MicroTug."
    } ]
  }, {
    "tStartMs": 430710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It weighs just 17 grams,"
    } ]
  }, {
    "tStartMs": 433020,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "but is able to pull a 20 kilogram weight."
    } ]
  }, {
    "tStartMs": 436740,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "That's the equivalent of a\nhuman towing a blue whale."
    } ]
  }, {
    "tStartMs": 440490,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Just six of these tiny\nrobots can tow a car."
    } ]
  }, {
    "tStartMs": 444690,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The gecko adhesive is on the\nunderside of the MicroTugs."
    } ]
  }, {
    "tStartMs": 447960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So when they're pulling the car,"
    } ]
  }, {
    "tStartMs": 449460,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the material is in shear"
    } ]
  }, {
    "tStartMs": 451170,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and it sticks tight to the ground."
    } ]
  }, {
    "tStartMs": 453360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But as the car moves forward,"
    } ]
  }, {
    "tStartMs": 455070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the shear force decreases"
    } ]
  }, {
    "tStartMs": 456780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and so it's easy for the\nrobot to pick itself up"
    } ]
  }, {
    "tStartMs": 459270,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and move itself forward."
    } ]
  }, {
    "tStartMs": 462720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The amount of pulling force attainable"
    } ]
  }, {
    "tStartMs": 464400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "depends on the area of adhesive"
    } ]
  }, {
    "tStartMs": 466110,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that's in contact with the surface."
    } ]
  }, {
    "tStartMs": 468000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So they've developed a\nmethod for measuring this"
    } ]
  }, {
    "tStartMs": 470280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "by shining light through acrylic."
    } ]
  }, {
    "tStartMs": 472710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Tony] So what it does is shines the LED"
    } ]
  }, {
    "tStartMs": 474240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "across the acrylic"
    } ]
  }, {
    "tStartMs": 475920,
    "dDurationMs": 2406,
    "segs": [ {
      "utf8": "and whenever there's a\ncontact with the surface,"
    } ]
  }, {
    "tStartMs": 478326,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "it frustrates the ray"
    } ]
  }, {
    "tStartMs": 480570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and it shows you exactly\nwhere the contact area is."
    } ]
  }, {
    "tStartMs": 483030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] One square inch of contact area"
    } ]
  }, {
    "tStartMs": 485070,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "can support the weight of\nabout four-and-a-half kilograms"
    } ]
  }, {
    "tStartMs": 487920,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or 10 pounds."
    } ]
  }, {
    "tStartMs": 490260,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Since the adhesive is directional,"
    } ]
  }, {
    "tStartMs": 492240,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to grip an object"
    } ]
  }, {
    "tStartMs": 493650,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "two pieces of adhesive are\nattached in opposite directions."
    } ]
  }, {
    "tStartMs": 497190,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So when you pull up,"
    } ]
  }, {
    "tStartMs": 498810,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "both sides are in shear"
    } ]
  }, {
    "tStartMs": 500310,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "and so they both stick."
    } ]
  }, {
    "tStartMs": 503250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Two opposing pads of adhesive"
    } ]
  }, {
    "tStartMs": 505080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "were actually tested on a robot"
    } ]
  }, {
    "tStartMs": 506520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "on the international space station."
    } ]
  }, {
    "tStartMs": 508770,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- It's called Astrobee."
    } ]
  }, {
    "tStartMs": 509880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Think of it as like a drone,"
    } ]
  }, {
    "tStartMs": 511200,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "a UAV, only actually uses\na fan to push itself around"
    } ]
  }, {
    "tStartMs": 514980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "inside the International Space Station."
    } ]
  }, {
    "tStartMs": 516570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And the idea is that it could be there"
    } ]
  }, {
    "tStartMs": 518610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to take video"
    } ]
  }, {
    "tStartMs": 520410,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or fetch something for astronauts."
    } ]
  }, {
    "tStartMs": 522600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Our proposal was,"
    } ]
  }, {
    "tStartMs": 523433,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": "\"How about it should be\nable to float along gently"
    } ]
  }, {
    "tStartMs": 525870,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "and stick itself to a wall, for example."
    } ]
  }, {
    "tStartMs": 528027,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "Or pick up a big box."
    } ]
  }, {
    "tStartMs": 530520,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "- [Astronaut] Our goal is to\nget that blue LED to turn green"
    } ]
  }, {
    "tStartMs": 534510,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Because there's no gravity."
    } ]
  }, {
    "tStartMs": 535980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "You don't actually need a lot of force"
    } ]
  }, {
    "tStartMs": 538320,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but you do want to be\nable to grab very gently"
    } ]
  }, {
    "tStartMs": 540630,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and and release easily."
    } ]
  }, {
    "tStartMs": 541950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And so we got the gecko adhesives up"
    } ]
  }, {
    "tStartMs": 544710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "at International Space Station"
    } ]
  }, {
    "tStartMs": 546180,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and it works just as well up\nthere as it does down here."
    } ]
  }, {
    "tStartMs": 549510,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] This went to space,\nthis was in the space station?"
    } ]
  }, {
    "tStartMs": 551430,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- This was in Space station\nfor about a year-and-a-half."
    } ]
  }, {
    "tStartMs": 554010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 556110,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "This principle can be extended"
    } ]
  }, {
    "tStartMs": 557370,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to three pieces of adhesive"
    } ]
  }, {
    "tStartMs": 558930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "so that when you pull them all in"
    } ]
  }, {
    "tStartMs": 560580,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "they can stick to a flat surface."
    } ]
  }, {
    "tStartMs": 563070,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "When it's at rest, these\nthings are sticking up"
    } ]
  }, {
    "tStartMs": 566100,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "just a little bit"
    } ]
  }, {
    "tStartMs": 567840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and then when you pull there,"
    } ]
  }, {
    "tStartMs": 569460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "then they become flatter right?"
    } ]
  }, {
    "tStartMs": 571350,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- Yeah, the entire pad doesn't touch"
    } ]
  }, {
    "tStartMs": 572970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because it's both surfaces\nis not perfectly flat."
    } ]
  }, {
    "tStartMs": 575850,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "And then once you activate it."
    } ]
  }, {
    "tStartMs": 579720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- [Derek] Oh yeah, I\ncould totally see that."
    } ]
  }, {
    "tStartMs": 582420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Tony] So I'm going to unplug the power"
    } ]
  }, {
    "tStartMs": 583980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "so there's absolutely\nno power to it at all"
    } ]
  }, {
    "tStartMs": 586440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and it's still attach the surface."
    } ]
  }, {
    "tStartMs": 588120,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Yeah, I was thinking"
    } ]
  }, {
    "tStartMs": 588953,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "that you'd have to keep the motor on but"
    } ]
  }, {
    "tStartMs": 591000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it just sort of like\nlocks in position or what?"
    } ]
  }, {
    "tStartMs": 593190,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Tony] Yeah, as long as\nthere's tiny bit of tension"
    } ]
  }, {
    "tStartMs": 595050,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "it just stays there forever."
    } ]
  }, {
    "tStartMs": 597870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] There are lots\nof potential applications"
    } ]
  }, {
    "tStartMs": 599820,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "for this material,"
    } ]
  }, {
    "tStartMs": 600660,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "but the most obvious one\nis for robotic grippers."
    } ]
  }, {
    "tStartMs": 604050,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Since the adhesive sticks well"
    } ]
  }, {
    "tStartMs": 605460,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "with just a small shear force,"
    } ]
  }, {
    "tStartMs": 607500,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "it's great for picking up"
    } ]
  }, {
    "tStartMs": 608610,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "delicate items like produce."
    } ]
  }, {
    "tStartMs": 610770,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "- These are meant to be\nsmart gecko palms, basically."
    } ]
  }, {
    "tStartMs": 614820,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So we're trying to grasp\nwith minimal squeezing."
    } ]
  }, {
    "tStartMs": 617580,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- We're not even really engaging"
    } ]
  }, {
    "tStartMs": 618870,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the ratchet mechanism there."
    } ]
  }, {
    "tStartMs": 620430,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Lab Worker] Yeah, not at all."
    } ]
  }, {
    "tStartMs": 621263,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "- So it's like less than a Newton."
    } ]
  }, {
    "tStartMs": 622650,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It can also grab bulky items"
    } ]
  }, {
    "tStartMs": 626280,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "or palm a basketball."
    } ]
  }, {
    "tStartMs": 628770,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Now can the gecko adhesive pull a car?"
    } ]
  }, {
    "tStartMs": 631950,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "They have hooked this one up to this rope,"
    } ]
  }, {
    "tStartMs": 634980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which is connected to a winch here,"
    } ]
  }, {
    "tStartMs": 637260,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but the winch is not actually secured."
    } ]
  }, {
    "tStartMs": 639930,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "It is tethered back to four\npieces of gecko adhesive"
    } ]
  }, {
    "tStartMs": 643800,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "which are just sitting on this pipe."
    } ]
  }, {
    "tStartMs": 646170,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "So the question is,"
    } ]
  }, {
    "tStartMs": 647430,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "can these four pieces of gecko adhesive"
    } ]
  }, {
    "tStartMs": 649920,
    "dDurationMs": 3614,
    "segs": [ {
      "utf8": "anchor the winch as it\npulls that car back?"
    } ]
  }, {
    "tStartMs": 653534,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(winch grinding)"
    } ]
  }, {
    "tStartMs": 659730,
    "dDurationMs": 2171,
    "segs": [ {
      "utf8": "Oh yeah, it's moving."
    } ]
  }, {
    "tStartMs": 661901,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(winch grinding)"
    } ]
  }, {
    "tStartMs": 671610,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 672630,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Could I pull these off?"
    } ]
  }, {
    "tStartMs": 673920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [All] Yep, yeah."
    } ]
  }, {
    "tStartMs": 674753,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "- How much does..."
    } ]
  }, {
    "tStartMs": 676020,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "like there was nothing holding it on."
    } ]
  }, {
    "tStartMs": 680100,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "That's wild."
    } ]
  }, {
    "tStartMs": 680970,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But of course the\napplication everyone wants"
    } ]
  }, {
    "tStartMs": 683010,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "is to be able to climb a building."
    } ]
  }, {
    "tStartMs": 685200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And this was actually a PhD project"
    } ]
  }, {
    "tStartMs": 687630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "for grad student Elliot Hawks."
    } ]
  }, {
    "tStartMs": 690240,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "It was a challenge"
    } ]
  }, {
    "tStartMs": 691080,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "because he had to get\nenough gecko adhesive"
    } ]
  }, {
    "tStartMs": 692850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "in contact with the glass at any one time"
    } ]
  }, {
    "tStartMs": 695640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to support his whole weight."
    } ]
  }, {
    "tStartMs": 698100,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Let me know if you want me"
    } ]
  }, {
    "tStartMs": 699360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to try to climb a building\nwith gecko adhesive"
    } ]
  }, {
    "tStartMs": 701310,
    "dDurationMs": 3107,
    "segs": [ {
      "utf8": "and maybe even go a little bit faster."
    } ]
  }, {
    "tStartMs": 704417,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(electronic beeping)"
    } ]
  }, {
    "tStartMs": 709980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Hey, this video was\nsponsored by Brilliant,"
    } ]
  }, {
    "tStartMs": 712260,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "the online learning tool"
    } ]
  }, {
    "tStartMs": 713370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that helps you understand\ngame-changing technologies."
    } ]
  }, {
    "tStartMs": 716040,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Not only in the physical sciences,"
    } ]
  }, {
    "tStartMs": 717750,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "but also in computer science."
    } ]
  }, {
    "tStartMs": 719790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "You know, these days everyone's"
    } ]
  }, {
    "tStartMs": 721170,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "talking about neural networks."
    } ]
  }, {
    "tStartMs": 722670,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "How AI can win any game or\nwrite sonnets with ChatGPT."
    } ]
  }, {
    "tStartMs": 726690,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Tech like this is already\nchanging the world"
    } ]
  }, {
    "tStartMs": 728850,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and you should really know how it works."
    } ]
  }, {
    "tStartMs": 731160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Brilliant has courses that delve"
    } ]
  }, {
    "tStartMs": 732660,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "into the inner machinery\nof neural networks"
    } ]
  }, {
    "tStartMs": 734760,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to discover how a computer\nsystem can actually learn."
    } ]
  }, {
    "tStartMs": 737670,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "You'll be able to apply\nwhat you've learned"
    } ]
  }, {
    "tStartMs": 739200,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and build a neural network yourself"
    } ]
  }, {
    "tStartMs": 740970,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to recognize numbers, shapes, and objects."
    } ]
  }, {
    "tStartMs": 743730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And if you need to refresh your math"
    } ]
  }, {
    "tStartMs": 745380,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "or computer science skills first,"
    } ]
  }, {
    "tStartMs": 746910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Brilliant has a whole library of courses,"
    } ]
  }, {
    "tStartMs": 749370,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "ranging from beginner to\nintermediate to advanced."
    } ]
  }, {
    "tStartMs": 753000,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Personally, I use\nBrilliant as a mental gym."
    } ]
  }, {
    "tStartMs": 756060,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The other day I was going through a lesson"
    } ]
  }, {
    "tStartMs": 758490,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "on group theory,"
    } ]
  }, {
    "tStartMs": 759840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and the thing Brilliant does better"
    } ]
  }, {
    "tStartMs": 761190,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "than any other platform"
    } ]
  }, {
    "tStartMs": 762330,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is it forces you to think for yourself."
    } ]
  }, {
    "tStartMs": 764970,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It asks you questions\nevery step of the way"
    } ]
  }, {
    "tStartMs": 767430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and the material is carefully curated"
    } ]
  }, {
    "tStartMs": 769440,
    "dDurationMs": 2614,
    "segs": [ {
      "utf8": "to increase in complexity as you go."
    } ]
  }, {
    "tStartMs": 772054,
    "dDurationMs": 3596,
    "segs": [ {
      "utf8": "I find it really satisfying\nto work things out for myself."
    } ]
  }, {
    "tStartMs": 775650,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That's the only way to\ntruly understand something."
    } ]
  }, {
    "tStartMs": 778770,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And you can try Brilliant out for free"
    } ]
  }, {
    "tStartMs": 780840,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "by going to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 784290,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And if you want to sign up"
    } ]
  }, {
    "tStartMs": 785580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "for an annual premium subscription,"
    } ]
  }, {
    "tStartMs": 787410,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "the first 200 people to join\nget 20% off through that link."
    } ]
  }, {
    "tStartMs": 791310,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So I will put it down in the description."
    } ]
  }, {
    "tStartMs": 793530,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I want to thank Brilliant\nfor supporting Veritasium"
    } ]
  }, {
    "tStartMs": 795510,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
