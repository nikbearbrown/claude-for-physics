{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 123,
    "dDurationMs": 4424,
    "segs": [ {
      "utf8": "- I am about to drive\nthe world's first car."
    } ]
  }, {
    "tStartMs": 4547,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "This was invented by Karl\nBenz, patented in 1886."
    } ]
  }, {
    "tStartMs": 8728,
    "dDurationMs": 3335,
    "segs": [ {
      "utf8": "Of course, this is not the\nreal thing, this is a replica."
    } ]
  }, {
    "tStartMs": 12063,
    "dDurationMs": 2443,
    "segs": [ {
      "utf8": "But I've partnered with Mercedes"
    } ]
  }, {
    "tStartMs": 14506,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "to make a video about car safety."
    } ]
  }, {
    "tStartMs": 17427,
    "dDurationMs": 1059,
    "segs": [ {
      "utf8": "- Yeah. (laughs)"
    } ]
  }, {
    "tStartMs": 18486,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right?"
    } ]
  }, {
    "tStartMs": 19319,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "There's not a lot of safety here."
    } ]
  }, {
    "tStartMs": 20195,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Safety would come later."
    } ]
  }, {
    "tStartMs": 21495,
    "dDurationMs": 936,
    "segs": [ {
      "utf8": "You ready?"
    } ]
  }, {
    "tStartMs": 22431,
    "dDurationMs": 894,
    "segs": [ {
      "utf8": "- Yeah!"
    } ]
  }, {
    "tStartMs": 23325,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I trust you."
    } ]
  }, {
    "tStartMs": 24158,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "(engine sputters slowly)"
    } ]
  }, {
    "tStartMs": 26960,
    "dDurationMs": 1273,
    "segs": [ {
      "utf8": "Awesome!"
    } ]
  }, {
    "tStartMs": 28233,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "- I'm driving the world's\nfirst motor vehicle."
    } ]
  }, {
    "tStartMs": 32213,
    "dDurationMs": 4541,
    "segs": [ {
      "utf8": "When he made his patent, what\ndid he call this invention?"
    } ]
  }, {
    "tStartMs": 36754,
    "dDurationMs": 1587,
    "segs": [ {
      "utf8": "- Patent Motorcar."
    } ]
  }, {
    "tStartMs": 38341,
    "dDurationMs": 1664,
    "segs": [ {
      "utf8": "This is the gasoline tank."
    } ]
  }, {
    "tStartMs": 40005,
    "dDurationMs": 2209,
    "segs": [ {
      "utf8": "The only place in Germany\nwhere you could actually buy"
    } ]
  }, {
    "tStartMs": 42214,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "ligroin, or gasoline,\nback then were pharmacies."
    } ]
  }, {
    "tStartMs": 45787,
    "dDurationMs": 3332,
    "segs": [ {
      "utf8": "They sold it not as a cough\nmedicine, don't worry."
    } ]
  }, {
    "tStartMs": 49119,
    "dDurationMs": 2927,
    "segs": [ {
      "utf8": "They sold it as a stain\nremover, a washing agent."
    } ]
  }, {
    "tStartMs": 52046,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "In Germany, there's still\na word, Waschbenzin,"
    } ]
  }, {
    "tStartMs": 54845,
    "dDurationMs": 2272,
    "segs": [ {
      "utf8": "washing gasoline, but no one really knows"
    } ]
  }, {
    "tStartMs": 57117,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "why it's called like that."
    } ]
  }, {
    "tStartMs": 58338,
    "dDurationMs": 1788,
    "segs": [ {
      "utf8": "Benz had an early thing for safety."
    } ]
  }, {
    "tStartMs": 60126,
    "dDurationMs": 1662,
    "segs": [ {
      "utf8": "His ignition is a really modern one,"
    } ]
  }, {
    "tStartMs": 61788,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "because in here there's a battery inside"
    } ]
  }, {
    "tStartMs": 65075,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "which was fairly new back then."
    } ]
  }, {
    "tStartMs": 66903,
    "dDurationMs": 4187,
    "segs": [ {
      "utf8": "And, of course, igniting\nthe gasoline oxygen fumes"
    } ]
  }, {
    "tStartMs": 71090,
    "dDurationMs": 3355,
    "segs": [ {
      "utf8": "with an electric spark is much safer than"
    } ]
  }, {
    "tStartMs": 74445,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "if you go with your lighter there"
    } ]
  }, {
    "tStartMs": 76549,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and you're trying to ignite a whole thing."
    } ]
  }, {
    "tStartMs": 79429,
    "dDurationMs": 2312,
    "segs": [ {
      "utf8": "Let's say the most\nimportant part, or course,"
    } ]
  }, {
    "tStartMs": 81741,
    "dDurationMs": 1583,
    "segs": [ {
      "utf8": "is the cylinder with the piston."
    } ]
  }, {
    "tStartMs": 83324,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And the piston moves front and back."
    } ]
  }, {
    "tStartMs": 85644,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "- This is a single cylinder engine."
    } ]
  }, {
    "tStartMs": 87880,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "- Yeah, a single cylinder engine."
    } ]
  }, {
    "tStartMs": 89342,
    "dDurationMs": 1955,
    "segs": [ {
      "utf8": "This is the cooling water tank,"
    } ]
  }, {
    "tStartMs": 91297,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "and of course what's really important,"
    } ]
  }, {
    "tStartMs": 93203,
    "dDurationMs": 1558,
    "segs": [ {
      "utf8": "it's the oil reservoir."
    } ]
  }, {
    "tStartMs": 94761,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "Lubrication is really\nimportant, because you can see"
    } ]
  }, {
    "tStartMs": 97010,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "everything's open here,"
    } ]
  }, {
    "tStartMs": 98693,
    "dDurationMs": 2672,
    "segs": [ {
      "utf8": "and so all the time you lose a lot of oil,"
    } ]
  }, {
    "tStartMs": 101365,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and for my colleagues it's always"
    } ]
  }, {
    "tStartMs": 102905,
    "dDurationMs": 2632,
    "segs": [ {
      "utf8": "a big fuss cleaning this thing up."
    } ]
  }, {
    "tStartMs": 105537,
    "dDurationMs": 1258,
    "segs": [ {
      "utf8": "This the drive belt."
    } ]
  }, {
    "tStartMs": 106795,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 107628,
    "dDurationMs": 2088,
    "segs": [ {
      "utf8": "- It's not just a drive\nbelt, it's also your brake."
    } ]
  }, {
    "tStartMs": 109716,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's leather, so you can\nimagine if you do brake a lot"
    } ]
  }, {
    "tStartMs": 112596,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "you get problems with the leather band."
    } ]
  }, {
    "tStartMs": 114465,
    "dDurationMs": 4179,
    "segs": [ {
      "utf8": "The flywheel here we\nneed for the ignition."
    } ]
  }, {
    "tStartMs": 118644,
    "dDurationMs": 1917,
    "segs": [ {
      "utf8": "We need it to start it."
    } ]
  }, {
    "tStartMs": 122797,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(engine sputters)"
    } ]
  }, {
    "tStartMs": 136096,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Wow!"
    } ]
  }, {
    "tStartMs": 138177,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 139010,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "- Okay, see, that's really simple."
    } ]
  }, {
    "tStartMs": 141019,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "We don't have a lot of stuff here."
    } ]
  }, {
    "tStartMs": 142640,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 143473,
    "dDurationMs": 2784,
    "segs": [ {
      "utf8": "- We just have the steering crank,"
    } ]
  }, {
    "tStartMs": 146257,
    "dDurationMs": 3208,
    "segs": [ {
      "utf8": "and this is our gas and our brakes."
    } ]
  }, {
    "tStartMs": 149465,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "- Okay, you're moving us into gear."
    } ]
  }, {
    "tStartMs": 151577,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 152511,
    "dDurationMs": 1058,
    "segs": [ {
      "utf8": "- Whoa!"
    } ]
  }, {
    "tStartMs": 153569,
    "dDurationMs": 1424,
    "segs": [ {
      "utf8": "(engine sputters)"
    } ]
  }, {
    "tStartMs": 154993,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "This does feel fast."
    } ]
  }, {
    "tStartMs": 156092,
    "dDurationMs": 1949,
    "segs": [ {
      "utf8": "- Oh, it even goes, ahh, faster."
    } ]
  }, {
    "tStartMs": 158041,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- Whoa! (both laugh)"
    } ]
  }, {
    "tStartMs": 160481,
    "dDurationMs": 3979,
    "segs": [ {
      "utf8": "The top speed of this vehicle\nwas 16 kilometers per hour,"
    } ]
  }, {
    "tStartMs": 164460,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "that's about 10 miles an hour."
    } ]
  }, {
    "tStartMs": 166126,
    "dDurationMs": 1175,
    "segs": [ {
      "utf8": "- We can go fast."
    } ]
  }, {
    "tStartMs": 167301,
    "dDurationMs": 1912,
    "segs": [ {
      "utf8": "- It feels faster than I was expecting."
    } ]
  }, {
    "tStartMs": 169213,
    "dDurationMs": 2558,
    "segs": [ {
      "utf8": "(engine sputters)"
    } ]
  }, {
    "tStartMs": 171771,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "Just 16 years later,"
    } ]
  }, {
    "tStartMs": 173599,
    "dDurationMs": 3269,
    "segs": [ {
      "utf8": "this car could go 80 kilometers per hour."
    } ]
  }, {
    "tStartMs": 176868,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "This car in 1928 could already\ngo 192 kilometers per hour."
    } ]
  }, {
    "tStartMs": 182812,
    "dDurationMs": 3884,
    "segs": [ {
      "utf8": "By 1938, cars had gotten incredibly fast."
    } ]
  }, {
    "tStartMs": 186696,
    "dDurationMs": 1984,
    "segs": [ {
      "utf8": "This car right here set a record of"
    } ]
  }, {
    "tStartMs": 188680,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "432.7 kilometers per hour."
    } ]
  }, {
    "tStartMs": 191723,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "That's almost 270 miles per hour,"
    } ]
  }, {
    "tStartMs": 194443,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "and another driver trying\nto beat that record"
    } ]
  }, {
    "tStartMs": 196676,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "died the same day."
    } ]
  }, {
    "tStartMs": 198701,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "And to this day, no one has\nbeat that car on a public road."
    } ]
  }, {
    "tStartMs": 204674,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "The automobile revolutionized\ntransportation."
    } ]
  }, {
    "tStartMs": 207558,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "It allowed people to travel\nfaster than ever before."
    } ]
  }, {
    "tStartMs": 210888,
    "dDurationMs": 3312,
    "segs": [ {
      "utf8": "But that also created a really\ndifficult physics problem,"
    } ]
  }, {
    "tStartMs": 214200,
    "dDurationMs": 2731,
    "segs": [ {
      "utf8": "which is that if you're moving\nfast and you need to stop"
    } ]
  }, {
    "tStartMs": 216931,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "or you hit something,"
    } ]
  }, {
    "tStartMs": 218389,
    "dDurationMs": 2386,
    "segs": [ {
      "utf8": "you have to decelerate incredibly rapidly"
    } ]
  }, {
    "tStartMs": 220775,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "and that creates huge forces\non the people inside the car,"
    } ]
  }, {
    "tStartMs": 224416,
    "dDurationMs": 2151,
    "segs": [ {
      "utf8": "and causing injury and sometimes death."
    } ]
  }, {
    "tStartMs": 226567,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "And as more and more cars came on the road"
    } ]
  }, {
    "tStartMs": 228797,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "and traveled faster and faster,"
    } ]
  }, {
    "tStartMs": 230666,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "the number of fatalities increased,"
    } ]
  }, {
    "tStartMs": 233106,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "peaking in a lot of developed\nnations in the '70s."
    } ]
  }, {
    "tStartMs": 236234,
    "dDurationMs": 3289,
    "segs": [ {
      "utf8": "But then scientists and\nengineers embraced this challenge"
    } ]
  }, {
    "tStartMs": 239523,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "and figured out new, innovative ways"
    } ]
  }, {
    "tStartMs": 241946,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "to create cars to minimize those injuries."
    } ]
  }, {
    "tStartMs": 244987,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "To improve safety, regular crash testing"
    } ]
  }, {
    "tStartMs": 247547,
    "dDurationMs": 2115,
    "segs": [ {
      "utf8": "began in the late 1950s."
    } ]
  }, {
    "tStartMs": 249662,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "But what amazes me is,"
    } ]
  }, {
    "tStartMs": 250964,
    "dDurationMs": 2727,
    "segs": [ {
      "utf8": "the crash test dummy really\nhadn't been perfected yet."
    } ]
  }, {
    "tStartMs": 253691,
    "dDurationMs": 1995,
    "segs": [ {
      "utf8": "So actual scientists and engineers"
    } ]
  }, {
    "tStartMs": 255686,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "drove the cars in crash tests."
    } ]
  }, {
    "tStartMs": 256519,
    "dDurationMs": 3436,
    "segs": [ {
      "utf8": "- People like me actually started"
    } ]
  }, {
    "tStartMs": 259955,
    "dDurationMs": 3174,
    "segs": [ {
      "utf8": "to do first testing with themselves."
    } ]
  }, {
    "tStartMs": 263129,
    "dDurationMs": 2791,
    "segs": [ {
      "utf8": "Certain accelerations,\nhow much you can suffer,"
    } ]
  }, {
    "tStartMs": 265920,
    "dDurationMs": 2396,
    "segs": [ {
      "utf8": "I mean before you get any injuries."
    } ]
  }, {
    "tStartMs": 268316,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "Of course, today this\nwould be impossible to do."
    } ]
  }, {
    "tStartMs": 271119,
    "dDurationMs": 3456,
    "segs": [ {
      "utf8": "- But when they finally did\ndevelop crash test dummies,"
    } ]
  }, {
    "tStartMs": 274575,
    "dDurationMs": 1948,
    "segs": [ {
      "utf8": "well then people weren't\ndriving the cars anymore"
    } ]
  }, {
    "tStartMs": 276523,
    "dDurationMs": 2846,
    "segs": [ {
      "utf8": "so they needed a different\nway to propel the vehicle."
    } ]
  }, {
    "tStartMs": 279369,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "And so they used this, a hot water rocket,"
    } ]
  }, {
    "tStartMs": 282976,
    "dDurationMs": 4016,
    "segs": [ {
      "utf8": "to propel the car into all\nsorts of crash test situations."
    } ]
  }, {
    "tStartMs": 286992,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "One of the first major safety innovations"
    } ]
  }, {
    "tStartMs": 289027,
    "dDurationMs": 1624,
    "segs": [ {
      "utf8": "that was introduced in a car like this"
    } ]
  }, {
    "tStartMs": 290651,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "in 1959 was crumple zones."
    } ]
  }, {
    "tStartMs": 293053,
    "dDurationMs": 2739,
    "segs": [ {
      "utf8": "That is, regions in the\nfront and the rear of the car"
    } ]
  }, {
    "tStartMs": 295792,
    "dDurationMs": 3315,
    "segs": [ {
      "utf8": "that were designed to collapse\nin the event of an accident."
    } ]
  }, {
    "tStartMs": 299107,
    "dDurationMs": 2346,
    "segs": [ {
      "utf8": "I remember when I was a kid,\nhearing about crumple zones"
    } ]
  }, {
    "tStartMs": 301453,
    "dDurationMs": 3205,
    "segs": [ {
      "utf8": "thinking that was a ridiculous\nidea to improve safety."
    } ]
  }, {
    "tStartMs": 304658,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "I mean, why would you\nwant your car to collapse?"
    } ]
  }, {
    "tStartMs": 306768,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "But the point is to increase"
    } ]
  }, {
    "tStartMs": 308759,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "the distance over which\nthe deceleration occurs,"
    } ]
  }, {
    "tStartMs": 311803,
    "dDurationMs": 2688,
    "segs": [ {
      "utf8": "and in doing so, you\nactually reduce the magnitude"
    } ]
  }, {
    "tStartMs": 314491,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "of the acceleration and so you reduce"
    } ]
  }, {
    "tStartMs": 316364,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "the forces on the passengers inside."
    } ]
  }, {
    "tStartMs": 319126,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "And that is what saves lives."
    } ]
  }, {
    "tStartMs": 321607,
    "dDurationMs": 3985,
    "segs": [ {
      "utf8": "- This vehicle has done a\n64 kilometer per hour crash,"
    } ]
  }, {
    "tStartMs": 325592,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "frontal impact, against\na deformable barrier."
    } ]
  }, {
    "tStartMs": 328193,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "This is what we classically\ncall the crumple zone."
    } ]
  }, {
    "tStartMs": 331132,
    "dDurationMs": 3973,
    "segs": [ {
      "utf8": "- But it's this beam here\nthat's designed to crumple?"
    } ]
  }, {
    "tStartMs": 335105,
    "dDurationMs": 1055,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 336160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So this takes away a lot\nof energy by crumpling."
    } ]
  }, {
    "tStartMs": 341034,
    "dDurationMs": 3017,
    "segs": [ {
      "utf8": "The passenger compartment\nitself is designed with"
    } ]
  }, {
    "tStartMs": 344051,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "different steel qualities, if you want,"
    } ]
  }, {
    "tStartMs": 346612,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "high strength and ultra\nhigh strength materials,"
    } ]
  }, {
    "tStartMs": 349292,
    "dDurationMs": 3655,
    "segs": [ {
      "utf8": "so that it's getting stiffer\nand stiffer as closer"
    } ]
  }, {
    "tStartMs": 352947,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "as you get to the passenger compartment."
    } ]
  }, {
    "tStartMs": 355224,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "- One of the biggest\nchallenges for car safety is"
    } ]
  }, {
    "tStartMs": 357458,
    "dDurationMs": 2688,
    "segs": [ {
      "utf8": "Newton's First Law that\nsays whatever is moving"
    } ]
  }, {
    "tStartMs": 360146,
    "dDurationMs": 1592,
    "segs": [ {
      "utf8": "at a constant speed will tend"
    } ]
  }, {
    "tStartMs": 361738,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "to maintain that constant speed."
    } ]
  }, {
    "tStartMs": 363896,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So if a car hits something,\nthe people inside"
    } ]
  }, {
    "tStartMs": 366446,
    "dDurationMs": 2832,
    "segs": [ {
      "utf8": "maintain their constant speed,\nfly through the windshield,"
    } ]
  }, {
    "tStartMs": 369278,
    "dDurationMs": 4097,
    "segs": [ {
      "utf8": "and suffer a very high deceleration\nwhen they hit the road."
    } ]
  }, {
    "tStartMs": 373375,
    "dDurationMs": 2765,
    "segs": [ {
      "utf8": "This is why seatbelts are so important."
    } ]
  }, {
    "tStartMs": 376140,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "They ensure that you stay in the vehicle"
    } ]
  }, {
    "tStartMs": 378213,
    "dDurationMs": 1785,
    "segs": [ {
      "utf8": "and decelerate with it."
    } ]
  }, {
    "tStartMs": 379998,
    "dDurationMs": 2149,
    "segs": [ {
      "utf8": "You know, when seatbelts\nwere originally introduced,"
    } ]
  }, {
    "tStartMs": 382147,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "they were an option, something\nyou could pay extra for."
    } ]
  }, {
    "tStartMs": 385031,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "But once we realized\njust how useful they are"
    } ]
  }, {
    "tStartMs": 387300,
    "dDurationMs": 2968,
    "segs": [ {
      "utf8": "and how they save lives,\nwell, they became standard"
    } ]
  }, {
    "tStartMs": 390268,
    "dDurationMs": 2029,
    "segs": [ {
      "utf8": "and now they are mandatory."
    } ]
  }, {
    "tStartMs": 392297,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "Now, airbags were made\navailable by Mercedes-Benz"
    } ]
  }, {
    "tStartMs": 394898,
    "dDurationMs": 3908,
    "segs": [ {
      "utf8": "for the first time in a\nserious production car in 1981."
    } ]
  }, {
    "tStartMs": 398806,
    "dDurationMs": 2072,
    "segs": [ {
      "utf8": "And again, the idea is similar."
    } ]
  }, {
    "tStartMs": 400878,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "In a head-on collision, you\nwant to stop the driver's head"
    } ]
  }, {
    "tStartMs": 404277,
    "dDurationMs": 2356,
    "segs": [ {
      "utf8": "from accelerating too fast\ninto the steering wheel,"
    } ]
  }, {
    "tStartMs": 406633,
    "dDurationMs": 1258,
    "segs": [ {
      "utf8": "and that's what the airbag does."
    } ]
  }, {
    "tStartMs": 407891,
    "dDurationMs": 1945,
    "segs": [ {
      "utf8": "It allows that acceleration\nto take place over"
    } ]
  }, {
    "tStartMs": 409836,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "a larger distance and\ntherefore at a lower rate."
    } ]
  }, {
    "tStartMs": 413196,
    "dDurationMs": 2838,
    "segs": [ {
      "utf8": "So it helps preserve the driver's head."
    } ]
  }, {
    "tStartMs": 416034,
    "dDurationMs": 3488,
    "segs": [ {
      "utf8": "- What you can also see is,\nlook at this tiny gap here."
    } ]
  }, {
    "tStartMs": 419522,
    "dDurationMs": 2155,
    "segs": [ {
      "utf8": "You can barely get your\nfingers in between."
    } ]
  }, {
    "tStartMs": 421677,
    "dDurationMs": 2475,
    "segs": [ {
      "utf8": "- So that steering column has collapsed."
    } ]
  }, {
    "tStartMs": 424152,
    "dDurationMs": 894,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 425046,
    "dDurationMs": 2395,
    "segs": [ {
      "utf8": "And it has collapsed in a designed way."
    } ]
  }, {
    "tStartMs": 427441,
    "dDurationMs": 4345,
    "segs": [ {
      "utf8": "So after you reach a\ncertain force threshold,"
    } ]
  }, {
    "tStartMs": 431786,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "then the driver basically pushes away"
    } ]
  }, {
    "tStartMs": 434749,
    "dDurationMs": 2798,
    "segs": [ {
      "utf8": "the entire steering column,\nincluding the airbag,"
    } ]
  }, {
    "tStartMs": 437547,
    "dDurationMs": 1342,
    "segs": [ {
      "utf8": "by taking away energy."
    } ]
  }, {
    "tStartMs": 438889,
    "dDurationMs": 3535,
    "segs": [ {
      "utf8": "And what you want to do as an\nengineer for restraint systems"
    } ]
  }, {
    "tStartMs": 442424,
    "dDurationMs": 4517,
    "segs": [ {
      "utf8": "is that you want to basically\nconnect the driver, passenger,"
    } ]
  }, {
    "tStartMs": 446941,
    "dDurationMs": 4189,
    "segs": [ {
      "utf8": "and the occupants as tightly\nas possible to the car"
    } ]
  }, {
    "tStartMs": 451130,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "in a way that you have the\nmost time to decelerate."
    } ]
  }, {
    "tStartMs": 455490,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "- Seatbelts, crumple zones, and airbags"
    } ]
  }, {
    "tStartMs": 457477,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "are all passive safety features."
    } ]
  }, {
    "tStartMs": 459418,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "They're passive in that\nthey assume a collision"
    } ]
  }, {
    "tStartMs": 461246,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "is occurring and they're just trying"
    } ]
  }, {
    "tStartMs": 462389,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "to reduce the acceleration\non the passengers inside."
    } ]
  }, {
    "tStartMs": 465232,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "But there are also active safety systems,"
    } ]
  }, {
    "tStartMs": 467471,
    "dDurationMs": 2804,
    "segs": [ {
      "utf8": "like the anti-lock braking system, or ABS,"
    } ]
  }, {
    "tStartMs": 470275,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "which was introduced by Mercedes in 1978."
    } ]
  }, {
    "tStartMs": 473403,
    "dDurationMs": 2635,
    "segs": [ {
      "utf8": "The idea with ABS is to\ngive you more control"
    } ]
  }, {
    "tStartMs": 476038,
    "dDurationMs": 3296,
    "segs": [ {
      "utf8": "so you may be able to swerve\nthe car and avoid an accident."
    } ]
  }, {
    "tStartMs": 479334,
    "dDurationMs": 3374,
    "segs": [ {
      "utf8": "The way ABS works is by\nallowing the wheels to rotate"
    } ]
  }, {
    "tStartMs": 482708,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "rather than locking them up,"
    } ]
  }, {
    "tStartMs": 484297,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "and having the wheels\nslide across the ground"
    } ]
  }, {
    "tStartMs": 486527,
    "dDurationMs": 2424,
    "segs": [ {
      "utf8": "as might happen with\ntraditional braking systems."
    } ]
  }, {
    "tStartMs": 488951,
    "dDurationMs": 3289,
    "segs": [ {
      "utf8": "So, with ABS the wheel is allowed to turn,"
    } ]
  }, {
    "tStartMs": 492240,
    "dDurationMs": 3293,
    "segs": [ {
      "utf8": "and then it's braked hard, and\nthen it turns a little more,"
    } ]
  }, {
    "tStartMs": 495533,
    "dDurationMs": 1141,
    "segs": [ {
      "utf8": "brakes again."
    } ]
  }, {
    "tStartMs": 496674,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "And by doing that in quick succession"
    } ]
  }, {
    "tStartMs": 498871,
    "dDurationMs": 2808,
    "segs": [ {
      "utf8": "you allow the wheel to\nstay rolling on the ground"
    } ]
  }, {
    "tStartMs": 501679,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "and maintain static\nfriction against the road."
    } ]
  }, {
    "tStartMs": 504527,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "That actually increases\nthe frictional force"
    } ]
  }, {
    "tStartMs": 506600,
    "dDurationMs": 2074,
    "segs": [ {
      "utf8": "and increases your ability to decelerate"
    } ]
  }, {
    "tStartMs": 508674,
    "dDurationMs": 2688,
    "segs": [ {
      "utf8": "and also steer around a collision."
    } ]
  }, {
    "tStartMs": 511362,
    "dDurationMs": 4148,
    "segs": [ {
      "utf8": "So ABS was a huge improvement\nover past braking systems."
    } ]
  }, {
    "tStartMs": 515510,
    "dDurationMs": 1016,
    "segs": [ {
      "utf8": "All of these innovations"
    } ]
  }, {
    "tStartMs": 516526,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "have dramatically improved road safety."
    } ]
  }, {
    "tStartMs": 518966,
    "dDurationMs": 1909,
    "segs": [ {
      "utf8": "But there's always more to be done."
    } ]
  }, {
    "tStartMs": 520875,
    "dDurationMs": 1018,
    "segs": [ {
      "utf8": "And I got to take a look at"
    } ]
  }, {
    "tStartMs": 521893,
    "dDurationMs": 2947,
    "segs": [ {
      "utf8": "Mercedes Benz Intelligent\nDrive technology,"
    } ]
  }, {
    "tStartMs": 524840,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "which is what they're doing right now"
    } ]
  }, {
    "tStartMs": 526380,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "to improve safety,\nperformance, and convenience."
    } ]
  }, {
    "tStartMs": 529228,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "And I actually made a\nseries of videos about that"
    } ]
  }, {
    "tStartMs": 531219,
    "dDurationMs": 1788,
    "segs": [ {
      "utf8": "over on Mercedes-Benz Channel."
    } ]
  }, {
    "tStartMs": 533007,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "You can click here to check them out."
    } ]
  }, {
    "tStartMs": 534957,
    "dDurationMs": 1705,
    "segs": [ {
      "utf8": "(car engine hums)"
    } ]
  }, {
    "tStartMs": 536662,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "Okay, we're about to go\ninto a dangerous turn."
    } ]
  }, {
    "tStartMs": 538653,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "(brakes squeal) and\nexperience the Pre-Safe."
    } ]
  }, {
    "tStartMs": 542003,
    "dDurationMs": 968,
    "segs": [ {
      "utf8": "(laughing) - [Driver] Hey, I can't brake."
    } ]
  }, {
    "tStartMs": 542971,
    "dDurationMs": 2074,
    "segs": [ {
      "utf8": "- I can see this car coming, oh my god!"
    } ]
  }, {
    "tStartMs": 545045,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(brakes squeal)"
    } ]
  }, {
    "tStartMs": 545878,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "(host laughs) - It tends for\nme to brake in this situation."
    } ]
  }, {
    "tStartMs": 547632,
    "dDurationMs": 3669,
    "segs": [ {
      "utf8": "- I have been in more potentially\ncrash situations today"
    } ]
  }, {
    "tStartMs": 551301,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "than I have been in for my\nwhole life. (driver laughs)"
    } ]
  } ]
}
