{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- Arthur C. Clarke had a sequel\nto \"2001, A Space Odyssey.\""
    } ]
  }, {
    "tStartMs": 3840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's called \"2010, Odyssey Two.\""
    } ]
  }, {
    "tStartMs": 6180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And at the end of it,"
    } ]
  }, {
    "tStartMs": 7013,
    "dDurationMs": 3937,
    "segs": [ {
      "utf8": "an alien intelligence\nconverts Jupiter into a star."
    } ]
  }, {
    "tStartMs": 10950,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "As a group of astronauts\nnarrowly escape the implosion,"
    } ]
  }, {
    "tStartMs": 14550,
    "dDurationMs": 2887,
    "segs": [ {
      "utf8": "they receive the following\nmessage from the aliens,"
    } ]
  }, {
    "tStartMs": 17437,
    "dDurationMs": 4013,
    "segs": [ {
      "utf8": "\"All these worlds are\nyours, except Europa,"
    } ]
  }, {
    "tStartMs": 21450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "attempt no landing there.\""
    } ]
  }, {
    "tStartMs": 24240,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Now that was just a novel, but it suggests"
    } ]
  }, {
    "tStartMs": 26970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that already in 1982,"
    } ]
  }, {
    "tStartMs": 28890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "we suspected that Europa\nmight offer our best chance"
    } ]
  }, {
    "tStartMs": 31830,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "of finding alien life in the solar system."
    } ]
  }, {
    "tStartMs": 35100,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "42 years later, in October 2024,"
    } ]
  }, {
    "tStartMs": 38490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "NASA is actually launching\nthe most advanced mission"
    } ]
  }, {
    "tStartMs": 41370,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "to hunt for signs of alien life."
    } ]
  }, {
    "tStartMs": 44310,
    "dDurationMs": 3225,
    "segs": [ {
      "utf8": "And it's going to Jupiter's moon Europa."
    } ]
  }, {
    "tStartMs": 48960,
    "dDurationMs": 1791,
    "segs": [ {
      "utf8": "There's just one problem,"
    } ]
  }, {
    "tStartMs": 51690,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "Jupiter kills everything around it."
    } ]
  }, {
    "tStartMs": 54960,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "So how could life exist there?"
    } ]
  }, {
    "tStartMs": 58230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And how do you make a probe"
    } ]
  }, {
    "tStartMs": 60210,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "that can withstand the\nperilous conditions?"
    } ]
  }, {
    "tStartMs": 62823,
    "dDurationMs": 3777,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 66600,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "(gentle music)\nDeep inside Jupiter,"
    } ]
  }, {
    "tStartMs": 69360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "there is so much pressure,"
    } ]
  }, {
    "tStartMs": 70860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that hydrogen is believed to take the form"
    } ]
  }, {
    "tStartMs": 73500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "of a metallic liquid."
    } ]
  }, {
    "tStartMs": 75630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And this metallic liquid\nhydrogen generates"
    } ]
  }, {
    "tStartMs": 78150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "an incredibly powerful magnetic field,"
    } ]
  }, {
    "tStartMs": 80700,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "almost 20,000 times stronger than Earth,"
    } ]
  }, {
    "tStartMs": 83850,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "if you measure at the same distance away."
    } ]
  }, {
    "tStartMs": 86550,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So if you could see this\nmagnetic field from Earth,"
    } ]
  }, {
    "tStartMs": 89490,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "it would appear twice\nas big as the full moon."
    } ]
  }, {
    "tStartMs": 94020,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "On its own, that magnetic\nfield is harmless."
    } ]
  }, {
    "tStartMs": 97410,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But right in the middle of it"
    } ]
  }, {
    "tStartMs": 99090,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "is the most volcanically active\nworld in the solar system,"
    } ]
  }, {
    "tStartMs": 103020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Jupiter's moon, Io."
    } ]
  }, {
    "tStartMs": 106080,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The volcanoes on Io's\nsurface shoot out tons"
    } ]
  }, {
    "tStartMs": 109290,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "of sulfur dioxide, and every second,"
    } ]
  }, {
    "tStartMs": 112020,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "one ton of this material gets ionized"
    } ]
  }, {
    "tStartMs": 114540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and trapped inside\nJupiter's magnetic field."
    } ]
  }, {
    "tStartMs": 117780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And the field accelerates these particles"
    } ]
  }, {
    "tStartMs": 119910,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to rotate incredibly fast with Jupiter."
    } ]
  }, {
    "tStartMs": 122790,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "So they whizz around at over\n300 kilometers per second."
    } ]
  }, {
    "tStartMs": 127140,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Their inertia actually\npulls back on the field,"
    } ]
  }, {
    "tStartMs": 130140,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "stretching it out."
    } ]
  }, {
    "tStartMs": 131700,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And this trapped material\nslams into other moons,"
    } ]
  }, {
    "tStartMs": 134760,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "ejecting even more particles\nfrom their surfaces."
    } ]
  }, {
    "tStartMs": 137970,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This cycle forms massive radiation belts"
    } ]
  }, {
    "tStartMs": 141030,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "which span past Europa and\nthe other moons of Jupiter."
    } ]
  }, {
    "tStartMs": 146160,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "Now, for electronics, this\nintense radiation is kryptonite."
    } ]
  }, {
    "tStartMs": 150210,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "In the 1970s, the Pioneer\n10 and Voyager missions"
    } ]
  }, {
    "tStartMs": 153510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "only briefly passed by Jupiter,"
    } ]
  }, {
    "tStartMs": 155940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but the radiation caused glitches,"
    } ]
  }, {
    "tStartMs": 158160,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "gave the instruments false commands,"
    } ]
  }, {
    "tStartMs": 160230,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and corrupted some of their data."
    } ]
  }, {
    "tStartMs": 162870,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Even with modern shielding,"
    } ]
  }, {
    "tStartMs": 164760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "a spacecraft within the radiation belts"
    } ]
  }, {
    "tStartMs": 166860,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "would only survive for\naround three months."
    } ]
  }, {
    "tStartMs": 169650,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So how will NASA's new\nmission, the Europa Clipper,"
    } ]
  }, {
    "tStartMs": 173010,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "orbit Europa for over four\nyears without getting fried?"
    } ]
  }, {
    "tStartMs": 177750,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Well, the solution is, it won't."
    } ]
  }, {
    "tStartMs": 180240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It'll orbit Jupiter from afar"
    } ]
  }, {
    "tStartMs": 182430,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and then swoop in every few\nweeks to quickly fly by Europa"
    } ]
  }, {
    "tStartMs": 186030,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and then leave again."
    } ]
  }, {
    "tStartMs": 187230,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And since the mission is going\nto collect a lot of data,"
    } ]
  }, {
    "tStartMs": 189870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "it can use the downtime\nwhile it's way out here"
    } ]
  }, {
    "tStartMs": 192720,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to transmit it all back to Earth"
    } ]
  }, {
    "tStartMs": 194790,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "before going in for another swoop."
    } ]
  }, {
    "tStartMs": 197190,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "In all, it'll do 49 flybys,"
    } ]
  }, {
    "tStartMs": 199410,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "mapping almost the entire surface."
    } ]
  }, {
    "tStartMs": 201990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "That's actually how the\nClipper got its name,"
    } ]
  }, {
    "tStartMs": 204060,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "after the fast and nimble\n19th century Clipper ships,"
    } ]
  }, {
    "tStartMs": 207420,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "quickly dipping in and out of ports."
    } ]
  }, {
    "tStartMs": 210960,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But of all the places in the solar system"
    } ]
  }, {
    "tStartMs": 212700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to look for life, why Europa?"
    } ]
  }, {
    "tStartMs": 215460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you stood on Europa's surface,"
    } ]
  }, {
    "tStartMs": 217290,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "you'd be hit with 5,400 milliSieverts"
    } ]
  }, {
    "tStartMs": 220080,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "of radiation in a single day."
    } ]
  }, {
    "tStartMs": 222210,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "That's 1,800 times more than\nthe annual dose here on Earth."
    } ]
  }, {
    "tStartMs": 228060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If you stay here for a couple of hours,"
    } ]
  }, {
    "tStartMs": 229800,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "you would eventually die\nfrom radiation sickness."
    } ]
  }, {
    "tStartMs": 232950,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "But Europa contains a secret."
    } ]
  }, {
    "tStartMs": 236760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "When Voyager 1 passed by Jupiter in 1979,"
    } ]
  }, {
    "tStartMs": 240120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "it took this photo of Europa."
    } ]
  }, {
    "tStartMs": 242430,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "If you compare it to\nmost of the other moons"
    } ]
  }, {
    "tStartMs": 244520,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "in the solar system,"
    } ]
  }, {
    "tStartMs": 245790,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "you'll notice something\nis missing, craters."
    } ]
  }, {
    "tStartMs": 250470,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Every planet and moon has been bombarded"
    } ]
  }, {
    "tStartMs": 253110,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "by asteroids over billions of years."
    } ]
  }, {
    "tStartMs": 255570,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And most planetary surfaces show it."
    } ]
  }, {
    "tStartMs": 258660,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But not Europa."
    } ]
  }, {
    "tStartMs": 260880,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "So why not?"
    } ]
  }, {
    "tStartMs": 263220,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Well, something recent,"
    } ]
  }, {
    "tStartMs": 264600,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "say over the last 60 million years or so,"
    } ]
  }, {
    "tStartMs": 267420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "must have been happening on Europa"
    } ]
  }, {
    "tStartMs": 269160,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "to erase most of these\ncraters from the surface."
    } ]
  }, {
    "tStartMs": 273900,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "16 years after Voyager,\nGalileo arrived to Jupiter."
    } ]
  }, {
    "tStartMs": 278190,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It spent eight years\nstudying both the gas giant"
    } ]
  }, {
    "tStartMs": 281310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and its moons."
    } ]
  }, {
    "tStartMs": 282990,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And Galileo's magnetometer"
    } ]
  }, {
    "tStartMs": 284700,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "picked up something interesting on Europa."
    } ]
  }, {
    "tStartMs": 287520,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Jupiter's magnetic poles, like Earth's,"
    } ]
  }, {
    "tStartMs": 289710,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "aren't aligned with its geographic poles."
    } ]
  }, {
    "tStartMs": 292620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So as the planet rotates every 10 hours,"
    } ]
  }, {
    "tStartMs": 295680,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "the whole magnetic field wobbles."
    } ]
  }, {
    "tStartMs": 298950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This changing field from Jupiter"
    } ]
  }, {
    "tStartMs": 301140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "induces a magnetic field on Europa,"
    } ]
  }, {
    "tStartMs": 303930,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and a relatively strong one at that."
    } ]
  }, {
    "tStartMs": 306870,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "That means there must be an\nelectrically conductive layer"
    } ]
  }, {
    "tStartMs": 309540,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "within Europa that reacts\nto Jupiter's field."
    } ]
  }, {
    "tStartMs": 312810,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And readings from Galileo indicate"
    } ]
  }, {
    "tStartMs": 314790,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that it must be somewhere\nclose to the surface,"
    } ]
  }, {
    "tStartMs": 317520,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "only 10s of kilometers deep."
    } ]
  }, {
    "tStartMs": 321900,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "So what kind of conductive layer?"
    } ]
  }, {
    "tStartMs": 326220,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Well, Europa's white surface\nis almost entirely covered"
    } ]
  }, {
    "tStartMs": 329280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "in a thick crust of water ice."
    } ]
  }, {
    "tStartMs": 331950,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "These reddish-brown regions,"
    } ]
  }, {
    "tStartMs": 333630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "when observed through a spectrometer,"
    } ]
  }, {
    "tStartMs": 335790,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "fit the description of a lot\nof things, like hydrated salts,"
    } ]
  }, {
    "tStartMs": 339150,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "sulfuric acid or even bacteria."
    } ]
  }, {
    "tStartMs": 342150,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "We need more data to be sure,"
    } ]
  }, {
    "tStartMs": 344160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but recent experiments at\nJPL found that sea salt"
    } ]
  }, {
    "tStartMs": 347280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "when bombarded with intense radiation,"
    } ]
  }, {
    "tStartMs": 349530,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "turns from white"
    } ]
  }, {
    "tStartMs": 350760,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "to this same brownish\ncolor found on Europa."
    } ]
  }, {
    "tStartMs": 354990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "So scientists suspect"
    } ]
  }, {
    "tStartMs": 356250,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "that there's a whole\nsaltwater ocean inside Europa"
    } ]
  }, {
    "tStartMs": 359253,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "that could be 100 kilometers deep."
    } ]
  }, {
    "tStartMs": 362520,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Meaning that Europa would\ncontain twice as much water"
    } ]
  }, {
    "tStartMs": 365910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "as the whole of the Earth."
    } ]
  }, {
    "tStartMs": 368250,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And it must driving geological activity"
    } ]
  }, {
    "tStartMs": 370590,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that constantly smooths out"
    } ]
  }, {
    "tStartMs": 372510,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and renews the surface of the moon."
    } ]
  }, {
    "tStartMs": 377370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But the Jupiter system only gets about 4%"
    } ]
  }, {
    "tStartMs": 379650,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "of the sunlight we get here on Earth."
    } ]
  }, {
    "tStartMs": 382830,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So Europa's surface is constantly\nbelow -160 deg Celsius,"
    } ]
  }, {
    "tStartMs": 388290,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "so you'd expect the\nocean to be frozen solid."
    } ]
  }, {
    "tStartMs": 392400,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But there's a way to generate heat"
    } ]
  }, {
    "tStartMs": 394650,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that doesn't rely on the Sun."
    } ]
  }, {
    "tStartMs": 397290,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And I've got a little\ndemo here to prove it."
    } ]
  }, {
    "tStartMs": 400650,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Europa's orbit around Jupiter\nisn't a perfect circle."
    } ]
  }, {
    "tStartMs": 404010,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "This is because Io, Europa and Ganymede"
    } ]
  }, {
    "tStartMs": 406710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "are in orbital resonance."
    } ]
  }, {
    "tStartMs": 408990,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Each time Ganymede completes one orbit,"
    } ]
  }, {
    "tStartMs": 411240,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Europa completes two and Io four."
    } ]
  }, {
    "tStartMs": 414090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Because of that, Io tugs Europa inward"
    } ]
  }, {
    "tStartMs": 416880,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "on one side of the orbit,"
    } ]
  }, {
    "tStartMs": 418350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "while Ganymede pulls it out on the other,"
    } ]
  }, {
    "tStartMs": 421110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "making its orbit more eccentric."
    } ]
  }, {
    "tStartMs": 424020,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Now, Jupiter's pull is stronger"
    } ]
  }, {
    "tStartMs": 426030,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "on the closer side of the\norbit than on the farther side."
    } ]
  }, {
    "tStartMs": 429210,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "So Europa is constantly\nbeing stretched and squeezed,"
    } ]
  }, {
    "tStartMs": 433140,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "stretched and squeezed."
    } ]
  }, {
    "tStartMs": 435990,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And you can see how this\nrubber ball gets warmer"
    } ]
  }, {
    "tStartMs": 440130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "as I squeeze it."
    } ]
  }, {
    "tStartMs": 442500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Scientists believe that\nthe friction caused"
    } ]
  }, {
    "tStartMs": 444570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "by the tidal flexing of the entire moon"
    } ]
  }, {
    "tStartMs": 447300,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "can generate enough heat\nto keep the ocean liquid."
    } ]
  }, {
    "tStartMs": 450840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "This effect gets stronger the\ncloser you are to Jupiter,"
    } ]
  }, {
    "tStartMs": 453840,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "which is why Io is so volcanically active."
    } ]
  }, {
    "tStartMs": 458280,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So you can see this ball is\nsignificantly hotter now."
    } ]
  }, {
    "tStartMs": 461670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I held onto this ball at the same time"
    } ]
  }, {
    "tStartMs": 463590,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to make sure that it wasn't\njust the heat coming in"
    } ]
  }, {
    "tStartMs": 465120,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "from my hand."
    } ]
  }, {
    "tStartMs": 466980,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "What sort of temperature of\nthe ocean are we thinking?"
    } ]
  }, {
    "tStartMs": 470010,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- So it depends on how salty it is."
    } ]
  }, {
    "tStartMs": 472260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So, melting temperature of ice"
    } ]
  }, {
    "tStartMs": 475320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "or maybe depressed by 10\ndegrees Celsius below that"
    } ]
  }, {
    "tStartMs": 480450,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "if it's a very salty ocean."
    } ]
  }, {
    "tStartMs": 483120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Similar to cold oceans on Earth."
    } ]
  }, {
    "tStartMs": 486480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- And how would the flexing differ"
    } ]
  }, {
    "tStartMs": 488850,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "if there's this big liquid ocean"
    } ]
  }, {
    "tStartMs": 490710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "versus if there's no ocean there?"
    } ]
  }, {
    "tStartMs": 492780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- If there's no ocean, Europa should flex"
    } ]
  }, {
    "tStartMs": 495000,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "by only about one meter in amplitude."
    } ]
  }, {
    "tStartMs": 498030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But if there's an ocean in there,"
    } ]
  }, {
    "tStartMs": 499800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "then it flexes with an\namplitude of 30 meters."
    } ]
  }, {
    "tStartMs": 502920,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So that's an enormous deflection."
    } ]
  }, {
    "tStartMs": 504900,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And that will come out pretty\nclearly in the gravity data."
    } ]
  }, {
    "tStartMs": 507720,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Another argument for how\nthick the ice shell is,"
    } ]
  }, {
    "tStartMs": 511200,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "we see these very strange\nfeatures on the surface"
    } ]
  }, {
    "tStartMs": 513990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that are arcuate in shape,"
    } ]
  }, {
    "tStartMs": 515820,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but like multiple arcs put together."
    } ]
  }, {
    "tStartMs": 518010,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We call them cycloids."
    } ]
  }, {
    "tStartMs": 519360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Not something you'd expect\nto see on an icy moon."
    } ]
  }, {
    "tStartMs": 522450,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "And we think they form\nif a crack propagates"
    } ]
  }, {
    "tStartMs": 526350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "at just the right speed, about\nthe speed someone would walk,"
    } ]
  }, {
    "tStartMs": 529140,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and is following the changing stress field"
    } ]
  }, {
    "tStartMs": 532350,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of Europa being squeezed as\nit orbits around Jupiter."
    } ]
  }, {
    "tStartMs": 535590,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And if there were no ocean down there,"
    } ]
  }, {
    "tStartMs": 537450,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "there wouldn't be enough of\nan amplitude of that motion"
    } ]
  }, {
    "tStartMs": 541680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to explain the cracking."
    } ]
  }, {
    "tStartMs": 543180,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But if there is an ocean,"
    } ]
  }, {
    "tStartMs": 544500,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "then it could explain the cracking."
    } ]
  }, {
    "tStartMs": 547320,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- All that tidal flexing pushes\nmagma in the outer core up,"
    } ]
  }, {
    "tStartMs": 551190,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "closer to the seafloor."
    } ]
  }, {
    "tStartMs": 553020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Water flowing through the\ncrust above it is heated"
    } ]
  }, {
    "tStartMs": 555600,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and it picks up minerals from the ground,"
    } ]
  }, {
    "tStartMs": 557970,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "ejecting them into the ocean."
    } ]
  }, {
    "tStartMs": 560040,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "This creates hydrothermal vents."
    } ]
  }, {
    "tStartMs": 563130,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "And where we find these on\nEarth, we also find life."
    } ]
  }, {
    "tStartMs": 567750,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Thousands of meters below the\nsurface, with no sunlight,"
    } ]
  }, {
    "tStartMs": 571350,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "these vents are oases for ocean life."
    } ]
  }, {
    "tStartMs": 574530,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "The lifeforms down here\nrely on unique bacteria,"
    } ]
  }, {
    "tStartMs": 578100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "bacteria that feed on the\nminerals from the vents,"
    } ]
  }, {
    "tStartMs": 580980,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "rather than on the energy\nprovided by the Sun."
    } ]
  }, {
    "tStartMs": 584700,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "How long are we thinking\nthat Europa has had an ocean?"
    } ]
  }, {
    "tStartMs": 588270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- It could be four billion\nyears, we don't know for sure."
    } ]
  }, {
    "tStartMs": 591510,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- That amount of time could\ngive life the opportunity"
    } ]
  }, {
    "tStartMs": 594990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to evolve in those oceans?"
    } ]
  }, {
    "tStartMs": 596820,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- Right, exactly right."
    } ]
  }, {
    "tStartMs": 598050,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Organisms can use methane,\ncarbon dioxide, sulfur reactions."
    } ]
  }, {
    "tStartMs": 603450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Any chemical reaction you can think of"
    } ]
  }, {
    "tStartMs": 605370,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "that might happen in the\nocean can potentially be used"
    } ]
  }, {
    "tStartMs": 608580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "as a fuel for that organism's metabolism."
    } ]
  }, {
    "tStartMs": 612720,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So we're not talking about\nsearching for fishes,"
    } ]
  }, {
    "tStartMs": 615570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "or whales or squids or\nsomething down there,"
    } ]
  }, {
    "tStartMs": 617700,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "but looking for single cell organisms."
    } ]
  }, {
    "tStartMs": 621420,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- We were so concerned there\nmight be life on Europa that,"
    } ]
  }, {
    "tStartMs": 624480,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "when the Galileo mission\nwas ending in 2003,"
    } ]
  }, {
    "tStartMs": 627330,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it was deliberately crashed into Jupiter"
    } ]
  }, {
    "tStartMs": 629520,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to avoid the risk of contaminating Europa."
    } ]
  }, {
    "tStartMs": 632850,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But Clipper will not be able"
    } ]
  }, {
    "tStartMs": 634380,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to drill through the\nkilometers-thick ice crust."
    } ]
  }, {
    "tStartMs": 637530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So how are we going to find evidence"
    } ]
  }, {
    "tStartMs": 639780,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "for life beneath that thick surface?"
    } ]
  }, {
    "tStartMs": 643950,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This is the SnotBot."
    } ]
  }, {
    "tStartMs": 645630,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's a drone with Petri\ndishes glued to the top,"
    } ]
  }, {
    "tStartMs": 648510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and it flies right through whale blows"
    } ]
  }, {
    "tStartMs": 650670,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to collect whale snot right here on Earth."
    } ]
  }, {
    "tStartMs": 653790,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And zoologists can use the SnotBot"
    } ]
  }, {
    "tStartMs": 656100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "to retrieve all sorts of\ninfo on a whale's biology."
    } ]
  }, {
    "tStartMs": 660300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And it turns we can do\nsomething very similar"
    } ]
  }, {
    "tStartMs": 662580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "for celestial bodies too."
    } ]
  }, {
    "tStartMs": 664560,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "We've actually captured images"
    } ]
  }, {
    "tStartMs": 666360,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "of water geysers shooting\nout of Enceladus,"
    } ]
  }, {
    "tStartMs": 668970,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "a moon of Saturn, housing\na subsurface ocean."
    } ]
  }, {
    "tStartMs": 672720,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And the Hubble space telescope\nhas picked up some evidence"
    } ]
  }, {
    "tStartMs": 675540,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "of what could be similar\ngeyser eruptions on Europa."
    } ]
  }, {
    "tStartMs": 679050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "The hope is that Clipper\ncould fly through one"
    } ]
  }, {
    "tStartMs": 681660,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of these plumes, like the SnotBot,"
    } ]
  }, {
    "tStartMs": 683670,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and reveal their chemical composition"
    } ]
  }, {
    "tStartMs": 685620,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "using a mass spectrometer."
    } ]
  }, {
    "tStartMs": 688710,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "But evidence for an ocean\non Europa isn't conclusive."
    } ]
  }, {
    "tStartMs": 692550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Enceladus seems like a stronger candidate,"
    } ]
  }, {
    "tStartMs": 694890,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "we have actual images of its plumes"
    } ]
  }, {
    "tStartMs": 697380,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and we've even flown through them."
    } ]
  }, {
    "tStartMs": 699210,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "We are almost 100% certain\nthere's a subsurface ocean there."
    } ]
  }, {
    "tStartMs": 703590,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If we have these plumes on Enceladus"
    } ]
  }, {
    "tStartMs": 705930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and there's clearly maybe\na liquid ocean there,"
    } ]
  }, {
    "tStartMs": 708690,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "why does Europa have your\nattention more than Enceladus?"
    } ]
  }, {
    "tStartMs": 712230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Is there something that draws you?"
    } ]
  }, {
    "tStartMs": 714210,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "- We don't know how long\nit takes life to get going,"
    } ]
  }, {
    "tStartMs": 718860,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but it's possible that Enceladus"
    } ]
  }, {
    "tStartMs": 721410,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "may have just kind of\nstarted up its engines,"
    } ]
  }, {
    "tStartMs": 725910,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "whereas Europa has more\nlikely been well evolved"
    } ]
  }, {
    "tStartMs": 729870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "over a long time."
    } ]
  }, {
    "tStartMs": 732180,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- Surprisingly, being bombarded\nby Jupiter's radiation"
    } ]
  }, {
    "tStartMs": 735690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "actually makes Europa a better candidate."
    } ]
  }, {
    "tStartMs": 738570,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "See, those high-speed particles\nhitting Europa's surface"
    } ]
  }, {
    "tStartMs": 741900,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "give water and carbon dioxide\nmolecules enough energy"
    } ]
  }, {
    "tStartMs": 744810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to form new compounds,"
    } ]
  }, {
    "tStartMs": 746400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "like formaldehyde or hydrogen peroxide."
    } ]
  }, {
    "tStartMs": 749220,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "And these can serve as food\nfor life beneath the surface,"
    } ]
  }, {
    "tStartMs": 753270,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "if they can get down that far."
    } ]
  }, {
    "tStartMs": 755310,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "- And we have evidence of\noverturn of the icy shell"
    } ]
  }, {
    "tStartMs": 759060,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "at chaos zones where the icy\ncrust seems to have collided"
    } ]
  }, {
    "tStartMs": 763140,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and material has been\nshoved into the icy shell."
    } ]
  }, {
    "tStartMs": 765750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So there may be ways\nfor this fuel for life"
    } ]
  }, {
    "tStartMs": 768420,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to get down into the icy shell\nand potentially to the ocean."
    } ]
  }, {
    "tStartMs": 773820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Derek] And Clipper\ndoesn't have to touch down"
    } ]
  }, {
    "tStartMs": 775800,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "on the surface to confirm this."
    } ]
  }, {
    "tStartMs": 778320,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- There's an infrared spectrometer"
    } ]
  }, {
    "tStartMs": 780090,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to look at the chemical fingerprints"
    } ]
  }, {
    "tStartMs": 782490,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "of light bounced off the\nsurface to help identify"
    } ]
  }, {
    "tStartMs": 785580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and map out where the salts are,"
    } ]
  }, {
    "tStartMs": 788040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "find if there are organics there."
    } ]
  }, {
    "tStartMs": 790590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "There is an ultraviolet spectrograph"
    } ]
  }, {
    "tStartMs": 792990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that's aboard the spacecraft\nto look for plumes."
    } ]
  }, {
    "tStartMs": 795540,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Are they there?"
    } ]
  }, {
    "tStartMs": 796410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And of course, then can\nwe fly through them?"
    } ]
  }, {
    "tStartMs": 798900,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "And then there'll be imaging\nof essentially the whole globe"
    } ]
  }, {
    "tStartMs": 803130,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "at better than 100 meters\nper pixel resolution."
    } ]
  }, {
    "tStartMs": 806580,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So one camera will take swaths of images"
    } ]
  }, {
    "tStartMs": 810210,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "as we fly over the surface"
    } ]
  }, {
    "tStartMs": 811620,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and that's called the wide angle camera."
    } ]
  }, {
    "tStartMs": 813240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And then the other camera\nis the narrow angle camera."
    } ]
  }, {
    "tStartMs": 816000,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "From 50 kilometers altitude,"
    } ]
  }, {
    "tStartMs": 818820,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "it will get half meter\nper pixel images, right?"
    } ]
  }, {
    "tStartMs": 822060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So it'll be able to resolve my desk here"
    } ]
  }, {
    "tStartMs": 824790,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "if it were on Europa."
    } ]
  }, {
    "tStartMs": 826260,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And then it would be a future mission,"
    } ]
  }, {
    "tStartMs": 827820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "like a lander that would go"
    } ]
  }, {
    "tStartMs": 829260,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and actually search for\nsigns of life on Europa."
    } ]
  }, {
    "tStartMs": 832020,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Do you think a lander would\nhave a chance of survival?"
    } ]
  }, {
    "tStartMs": 834720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- There have been studies"
    } ]
  }, {
    "tStartMs": 836040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that say we can get a lander living"
    } ]
  }, {
    "tStartMs": 838200,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "on the surface for a month."
    } ]
  }, {
    "tStartMs": 839730,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "If we think that's\nsufficient to go in there,"
    } ]
  }, {
    "tStartMs": 842580,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "scoop some stuff up from below the depth"
    } ]
  }, {
    "tStartMs": 845190,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of radiation processing,"
    } ]
  }, {
    "tStartMs": 847140,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and put it into a mass\nspectrometer and see what we see."
    } ]
  }, {
    "tStartMs": 851190,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- But the Europa Clipper"
    } ]
  }, {
    "tStartMs": 852090,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "won't be studying Jupiter's moons alone."
    } ]
  }, {
    "tStartMs": 854520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The European Space Agency's JUICE mission,"
    } ]
  }, {
    "tStartMs": 856920,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "or the Jupiter Icy Moon Explorer,"
    } ]
  }, {
    "tStartMs": 859020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is already on its way to Jupiter."
    } ]
  }, {
    "tStartMs": 861090,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "It will come to the system\njust 15 months after Clipper"
    } ]
  }, {
    "tStartMs": 864510,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and it'll even be doing\na few flybys of Europa,"
    } ]
  }, {
    "tStartMs": 867360,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "before settling into a\ntight orbit around Ganymede."
    } ]
  }, {
    "tStartMs": 871230,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So the European Space Agency"
    } ]
  }, {
    "tStartMs": 873240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "will also have a mission\nthere at the same time?"
    } ]
  }, {
    "tStartMs": 875940,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- Yes, we're having informal conversations"
    } ]
  }, {
    "tStartMs": 879630,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with members of the JUICE science team."
    } ]
  }, {
    "tStartMs": 882330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "What would it mean to\nhave two spacecraft there"
    } ]
  }, {
    "tStartMs": 884400,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "at the same time?"
    } ]
  }, {
    "tStartMs": 885240,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "The JUICE mission will end\nup in orbit around Ganymede"
    } ]
  }, {
    "tStartMs": 889110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and Ganymede has its own magnetosphere."
    } ]
  }, {
    "tStartMs": 892050,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Well, we'll be outside\nGanymede's magnetosphere."
    } ]
  }, {
    "tStartMs": 894840,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So we might say, \"Oh, look,"
    } ]
  }, {
    "tStartMs": 896160,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "there's this big burst\ncoming from Jupiter.\""
    } ]
  }, {
    "tStartMs": 898890,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "And then JUICE might say,"
    } ]
  }, {
    "tStartMs": 899917,
    "dDurationMs": 4283,
    "segs": [ {
      "utf8": "\"Oh, we felt that over here\nin our magnetic signals.\""
    } ]
  }, {
    "tStartMs": 904200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So we wouldn't have to\nreally do anything different"
    } ]
  }, {
    "tStartMs": 906630,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "except talk to each other"
    } ]
  }, {
    "tStartMs": 907830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and make sure that the sum of the whole"
    } ]
  }, {
    "tStartMs": 910590,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "is even bigger than its parts."
    } ]
  }, {
    "tStartMs": 913470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Europa Clipper was scheduled to launch"
    } ]
  }, {
    "tStartMs": 915360,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "on October 10, 2024,"
    } ]
  }, {
    "tStartMs": 917100,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but NASA is waiting for\nHurricane Milton to clear Florida"
    } ]
  }, {
    "tStartMs": 920220,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "before the spacecraft can take off safely."
    } ]
  }, {
    "tStartMs": 923520,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "When will we get the first results?"
    } ]
  }, {
    "tStartMs": 925710,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- You'll start seeing distant\nobservations coming in in 2030"
    } ]
  }, {
    "tStartMs": 931200,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "as we look at Europa from\nafar and search for plumes."
    } ]
  }, {
    "tStartMs": 934590,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And then you'll see the first\nreally high resolution data"
    } ]
  }, {
    "tStartMs": 938010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "in 2031."
    } ]
  }, {
    "tStartMs": 939480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- So after say 26 years of thinking"
    } ]
  }, {
    "tStartMs": 942840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "about a mission to Europa,"
    } ]
  }, {
    "tStartMs": 944670,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "how does it feel to be so close to launch?"
    } ]
  }, {
    "tStartMs": 947430,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- It's a little surreal,\n(laughs) I must say."
    } ]
  }, {
    "tStartMs": 950280,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This has been such a long time coming."
    } ]
  }, {
    "tStartMs": 953310,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "It's occasionally hitting\nme that our spacecraft"
    } ]
  }, {
    "tStartMs": 957630,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "is going to be up there in the\nheavens, right, on its way."
    } ]
  }, {
    "tStartMs": 961680,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "It turns out that, during a Europa Ocean Conference "
    } ]
  }, {
    "tStartMs": 964129,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "in the late 1990s, "
    } ]
  }, {
    "tStartMs": 965351,
    "dDurationMs": 2679,
    "segs": [ {
      "utf8": "NASA actually video-called\nArthur C. Clarke."
    } ]
  }, {
    "tStartMs": 968030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And after showing him plans\nfor a future mission"
    } ]
  }, {
    "tStartMs": 970130,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "to explore the faraway ocean world,"
    } ]
  }, {
    "tStartMs": 972277,
    "dDurationMs": 4474,
    "segs": [ {
      "utf8": "Clarke finally gave NASA\npermission to land on Europa."
    } ]
  }, {
    "tStartMs": 977149,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(monitor whooshing)"
    } ]
  }, {
    "tStartMs": 983061,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Europa Clipper is a perfect example"
    } ]
  }, {
    "tStartMs": 985281,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "of the amazing things we can do"
    } ]
  }, {
    "tStartMs": 986781,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "when we set ourselves ambitious goals"
    } ]
  }, {
    "tStartMs": 988791,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and work together with\nothers to achieve them."
    } ]
  }, {
    "tStartMs": 991521,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But I think we often get\nwrapped up in our everyday lives"
    } ]
  }, {
    "tStartMs": 994131,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and forget just how much"
    } ]
  }, {
    "tStartMs": 995391,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of an impact we can make on the world."
    } ]
  }, {
    "tStartMs": 997761,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "That's true on a society-wide level,"
    } ]
  }, {
    "tStartMs": 999591,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "like these big international\nspace missions,"
    } ]
  }, {
    "tStartMs": 1001439,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but I also think it's true\nat an individual level."
    } ]
  }, {
    "tStartMs": 1004342,
    "dDurationMs": 2248,
    "segs": [ {
      "utf8": "You yourself can probably\naccomplish much more"
    } ]
  }, {
    "tStartMs": 1006590,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "than you think when it comes"
    } ]
  }, {
    "tStartMs": 1007826,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to making the world a better place."
    } ]
  }, {
    "tStartMs": 1009386,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And today's sponsor, 80,000 Hours,"
    } ]
  }, {
    "tStartMs": 1011606,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "wants to help you do just that."
    } ]
  }, {
    "tStartMs": 1013706,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "They're not selling anything."
    } ]
  }, {
    "tStartMs": 1015871,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "80,000 Hours is a nonprofit"
    } ]
  }, {
    "tStartMs": 1017951,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that can help you work out\na plan for achieving a big,"
    } ]
  }, {
    "tStartMs": 1020951,
    "dDurationMs": 3207,
    "segs": [ {
      "utf8": "positive impact in the world,\nand then executing on it."
    } ]
  }, {
    "tStartMs": 1024158,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Career advice typically\naims to help you find a job"
    } ]
  }, {
    "tStartMs": 1026798,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "that suits your preferences."
    } ]
  }, {
    "tStartMs": 1028058,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But what if you really care\nabout helping the world?"
    } ]
  }, {
    "tStartMs": 1031058,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Well sure, they can tell you\nto be a doctor or a teacher,"
    } ]
  }, {
    "tStartMs": 1033908,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but these aren't your only options."
    } ]
  }, {
    "tStartMs": 1035828,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Which is why 80,000 Hours"
    } ]
  }, {
    "tStartMs": 1037028,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "have done over 10 years of research"
    } ]
  }, {
    "tStartMs": 1039188,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "into how to find a career\nthat does a lot of good,"
    } ]
  }, {
    "tStartMs": 1041648,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and also feels satisfying."
    } ]
  }, {
    "tStartMs": 1043778,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "They have everything from\nan in-depth career guide,"
    } ]
  }, {
    "tStartMs": 1046328,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to a podcast on the world's\nmost pressing problems"
    } ]
  }, {
    "tStartMs": 1048908,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and how we can solve them."
    } ]
  }, {
    "tStartMs": 1050708,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "They even have a curated job board"
    } ]
  }, {
    "tStartMs": 1052418,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "with hundreds of high-impact\ncareer opportunities."
    } ]
  }, {
    "tStartMs": 1054740,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And everything they\nprovide is free, forever."
    } ]
  }, {
    "tStartMs": 1058068,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So if you want to make a difference"
    } ]
  }, {
    "tStartMs": 1059268,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "with the 80,000 hours you\nhave to shape your career,"
    } ]
  }, {
    "tStartMs": 1062208,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "then sign up now at\n80000hours.org/veritasium."
    } ]
  }, {
    "tStartMs": 1066018,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "There's a link in the description"
    } ]
  }, {
    "tStartMs": 1067428,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or you can scan this QR code."
    } ]
  }, {
    "tStartMs": 1069618,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, I want to thank 80,000\nHours for sponsoring this video,"
    } ]
  }, {
    "tStartMs": 1072558,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
