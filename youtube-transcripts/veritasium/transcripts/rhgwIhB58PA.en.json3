{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "- This video is about learning styles."
    } ]
  }, {
    "tStartMs": 1987,
    "dDurationMs": 1963,
    "segs": [ {
      "utf8": "What kind of learner are you?"
    } ]
  }, {
    "tStartMs": 3950,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Oh yeah, I'm a visual person"
    } ]
  }, {
    "tStartMs": 5060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "so I have to see things, yeah.\n- Oh yeah, same."
    } ]
  }, {
    "tStartMs": 5893,
    "dDurationMs": 1737,
    "segs": [ {
      "utf8": "- I think visual learner."
    } ]
  }, {
    "tStartMs": 7630,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Visual."
    } ]
  }, {
    "tStartMs": 8463,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "- I mean, like, I remember\nformulas like auditory."
    } ]
  }, {
    "tStartMs": 11040,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- I need to be like,\ninteracting with the material."
    } ]
  }, {
    "tStartMs": 13260,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- I like to learn by doing it myself."
    } ]
  }, {
    "tStartMs": 15010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Very hands-on."
    } ]
  }, {
    "tStartMs": 15843,
    "dDurationMs": 977,
    "segs": [ {
      "utf8": "- Hands-on learner."
    } ]
  }, {
    "tStartMs": 16820,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Hands-on?"
    } ]
  }, {
    "tStartMs": 17653,
    "dDurationMs": 1827,
    "segs": [ {
      "utf8": "- So like, if I have a model,\nI'd like to look at that"
    } ]
  }, {
    "tStartMs": 19480,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "and look it over."
    } ]
  }, {
    "tStartMs": 20430,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Part of this video was\nsponsored by Google Search."
    } ]
  }, {
    "tStartMs": 25040,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "There is this idea in\neducation that everyone"
    } ]
  }, {
    "tStartMs": 27510,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "has their own preferred way of learning,"
    } ]
  }, {
    "tStartMs": 29210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "their so-called learning style."
    } ]
  }, {
    "tStartMs": 31160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "If information is presented in accordance"
    } ]
  }, {
    "tStartMs": 32840,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "with the learning style, well,\nthen they'll learn better."
    } ]
  }, {
    "tStartMs": 36090,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Now, there are dozens of\ndifferent learning style theories,"
    } ]
  }, {
    "tStartMs": 38950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but the most common one identifies"
    } ]
  }, {
    "tStartMs": 40660,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "four main learning\nstyles, visual, auditory,"
    } ]
  }, {
    "tStartMs": 43790,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "reading-writing, and\nkinesthetic or VARK for short."
    } ]
  }, {
    "tStartMs": 47132,
    "dDurationMs": 2438,
    "segs": [ {
      "utf8": "Visual learners learn best from images,"
    } ]
  }, {
    "tStartMs": 49570,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "demonstrations, and pictures."
    } ]
  }, {
    "tStartMs": 51560,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- People may say things, but\nI can't really take it in."
    } ]
  }, {
    "tStartMs": 54110,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "I just gotta see 'em act it\nout or write it or something."
    } ]
  }, {
    "tStartMs": 57830,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- [Derek] Auditory learners learn best"
    } ]
  }, {
    "tStartMs": 59230,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "from listening to an explanation."
    } ]
  }, {
    "tStartMs": 61240,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "- Like in school, I was\nalways engaged in the lecture"
    } ]
  }, {
    "tStartMs": 64410,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "and that was usually good\nenough to pass a test."
    } ]
  }, {
    "tStartMs": 67300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- [Derek] Reading-writing\nlearners learn best"
    } ]
  }, {
    "tStartMs": 68900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "from reading and writing."
    } ]
  }, {
    "tStartMs": 70100,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- Like I can get pretty much anything"
    } ]
  }, {
    "tStartMs": 71980,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "out of reading a textbook or something."
    } ]
  }, {
    "tStartMs": 73610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Derek] And kinesthetic\nlearners learn best by doing."
    } ]
  }, {
    "tStartMs": 76010,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Physically interacting with the world."
    } ]
  }, {
    "tStartMs": 77740,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Hands-on."
    } ]
  }, {
    "tStartMs": 78573,
    "dDurationMs": 1927,
    "segs": [ {
      "utf8": "You have to touch things,\nyou have to play with things,"
    } ]
  }, {
    "tStartMs": 80500,
    "dDurationMs": 2565,
    "segs": [ {
      "utf8": "you know, it's a contact sport."
    } ]
  }, {
    "tStartMs": 83065,
    "dDurationMs": 1485,
    "segs": [ {
      "utf8": "You have to do it yourself."
    } ]
  }, {
    "tStartMs": 84550,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "- I want to try something\nwith you, a little experiment."
    } ]
  }, {
    "tStartMs": 87530,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "I want to show you 10 pictures of things"
    } ]
  }, {
    "tStartMs": 89067,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "and I don't want you to say anything"
    } ]
  }, {
    "tStartMs": 90810,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "while you're looking at them,\nand at the end of the 10"
    } ]
  }, {
    "tStartMs": 92910,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "you tell me how many you can remember."
    } ]
  }, {
    "tStartMs": 94660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 95493,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay?\n- Okay."
    } ]
  }, {
    "tStartMs": 96326,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 98910,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "- Now, learning styles\nmake intuitive sense"
    } ]
  }, {
    "tStartMs": 100900,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "because we know everyone is different."
    } ]
  }, {
    "tStartMs": 103510,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "Some people have better spacial reasoning."
    } ]
  }, {
    "tStartMs": 105960,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Others have better\nlistening comprehension."
    } ]
  }, {
    "tStartMs": 108580,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "We know some people are better readers"
    } ]
  }, {
    "tStartMs": 110210,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "while others are good with their hands."
    } ]
  }, {
    "tStartMs": 112540,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "- It's sort of very much\nfits with a broad strain"
    } ]
  }, {
    "tStartMs": 116430,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "of thought in the recent\nWestern tradition is,"
    } ]
  }, {
    "tStartMs": 120180,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "we're all unique, we're all different."
    } ]
  }, {
    "tStartMs": 121850,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "And so you don't want to say, like,"
    } ]
  }, {
    "tStartMs": 122800,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "everybody learns the same way."
    } ]
  }, {
    "tStartMs": 124157,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "That sort of conflicts with our feelings"
    } ]
  }, {
    "tStartMs": 127090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "about what it means to be human."
    } ]
  }, {
    "tStartMs": 129190,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- So doesn't it make sense\nthat people should learn better"
    } ]
  }, {
    "tStartMs": 132190,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "in their own preferred learning style?"
    } ]
  }, {
    "tStartMs": 134390,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Well, teachers certainly seem to think so."
    } ]
  }, {
    "tStartMs": 136720,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "A survey of nearly 400\nteachers from the UK"
    } ]
  }, {
    "tStartMs": 139410,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "and the Netherlands found\nthat over 90% believed"
    } ]
  }, {
    "tStartMs": 142550,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that individuals learn better\nwhen they receive information"
    } ]
  }, {
    "tStartMs": 145510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "in their preferred learning style."
    } ]
  }, {
    "tStartMs": 147340,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "- [Instructor] Just like every professor"
    } ]
  }, {
    "tStartMs": 148440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "has a different style of teaching,"
    } ]
  }, {
    "tStartMs": 150000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "you have a different style of learning."
    } ]
  }, {
    "tStartMs": 151840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Instructor] But when his\nteacher starts using visuals,"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Johnathan finds it easier to focus"
    } ]
  }, {
    "tStartMs": 155620,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and understand the material"
    } ]
  }, {
    "tStartMs": 156910,
    "dDurationMs": 2472,
    "segs": [ {
      "utf8": "so he might be a visual learner."
    } ]
  }, {
    "tStartMs": 159382,
    "dDurationMs": 2228,
    "segs": [ {
      "utf8": "- [Derek] Can you tell me\nwhat that means to you?"
    } ]
  }, {
    "tStartMs": 161610,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Like, what does it mean\nto be a visual learner?"
    } ]
  }, {
    "tStartMs": 163360,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "- To me it means that\nfor me to learn something"
    } ]
  }, {
    "tStartMs": 165620,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "sometimes you need to draw\nit or I need to write it down"
    } ]
  }, {
    "tStartMs": 168250,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "or I need to see a picture or a movie."
    } ]
  }, {
    "tStartMs": 171080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- For example, science\nclasses, I get bored easily"
    } ]
  }, {
    "tStartMs": 174200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "just listening and I think\nit's more interesting for me"
    } ]
  }, {
    "tStartMs": 177320,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "to actually be able to do it."
    } ]
  }, {
    "tStartMs": 179140,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- [Derek] How do you know\nthat you're a visual learner?"
    } ]
  }, {
    "tStartMs": 180750,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "- I don't, I just assumed."
    } ]
  }, {
    "tStartMs": 183380,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- To take advantage of learning styles"
    } ]
  }, {
    "tStartMs": 185130,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "then teachers need to do two things."
    } ]
  }, {
    "tStartMs": 187520,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "First, identify the learning style"
    } ]
  }, {
    "tStartMs": 189780,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "of each of their students."
    } ]
  }, {
    "tStartMs": 191120,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "And second, teach each student"
    } ]
  }, {
    "tStartMs": 193330,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "in accordance with their learning style."
    } ]
  }, {
    "tStartMs": 195550,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "On the VARK website it says,\nonce you know about VARK,"
    } ]
  }, {
    "tStartMs": 199120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "its power to explain things\nwill be a revelation."
    } ]
  }, {
    "tStartMs": 202720,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "But before you take an\nonline learning styles quiz,"
    } ]
  }, {
    "tStartMs": 205310,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "it's a good idea to ask, do\nlearning styles even exist?"
    } ]
  }, {
    "tStartMs": 209060,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I mean, do you have one?"
    } ]
  }, {
    "tStartMs": 210260,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And if you're taught\nin accordance with it,"
    } ]
  }, {
    "tStartMs": 212380,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "would you learn better?\n(warm instrumental music)"
    } ]
  }, {
    "tStartMs": 215320,
    "dDurationMs": 905,
    "segs": [ {
      "utf8": "Well, you could test this"
    } ]
  }, {
    "tStartMs": 216225,
    "dDurationMs": 2138,
    "segs": [ {
      "utf8": "by running a randomized control trial"
    } ]
  }, {
    "tStartMs": 218363,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "where first you would identify learners"
    } ]
  }, {
    "tStartMs": 220620,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "with at least two\ndifferent learning styles,"
    } ]
  }, {
    "tStartMs": 222440,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "say visual and auditory and\nthen randomly assign learners"
    } ]
  }, {
    "tStartMs": 226460,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "to one of two educational presentations,"
    } ]
  }, {
    "tStartMs": 228840,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "one visual, one auditory."
    } ]
  }, {
    "tStartMs": 230870,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "So for half of the students"
    } ]
  }, {
    "tStartMs": 232420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the experience will match\ntheir learning style"
    } ]
  }, {
    "tStartMs": 234700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and for the other half it won't."
    } ]
  }, {
    "tStartMs": 237000,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "And then you give everyone the same test."
    } ]
  }, {
    "tStartMs": 239930,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "If the learning style\nhypothesis is correct,"
    } ]
  }, {
    "tStartMs": 242350,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the results should show better performance"
    } ]
  }, {
    "tStartMs": 244270,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "when the presentation\nmatches the learning style"
    } ]
  }, {
    "tStartMs": 247000,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "than when they're mismatched."
    } ]
  }, {
    "tStartMs": 249830,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I tried a very unscientific version"
    } ]
  }, {
    "tStartMs": 252150,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "of this experiment on the street."
    } ]
  }, {
    "tStartMs": 254090,
    "dDurationMs": 2548,
    "segs": [ {
      "utf8": "For some people, I matched\ntheir learning style"
    } ]
  }, {
    "tStartMs": 256638,
    "dDurationMs": 4512,
    "segs": [ {
      "utf8": "so I showed visual learners\npictures of 10 items,"
    } ]
  }, {
    "tStartMs": 261150,
    "dDurationMs": 4669,
    "segs": [ {
      "utf8": "but for other visual learners\nI read out the items instead."
    } ]
  }, {
    "tStartMs": 265819,
    "dDurationMs": 3991,
    "segs": [ {
      "utf8": "Bell, penguin, sun."
    } ]
  }, {
    "tStartMs": 269810,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "- Okay, I'm maxed out."
    } ]
  }, {
    "tStartMs": 270780,
    "dDurationMs": 1253,
    "segs": [ {
      "utf8": "- [Derek] How many can you remember?"
    } ]
  }, {
    "tStartMs": 272033,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I don't know."
    } ]
  }, {
    "tStartMs": 272866,
    "dDurationMs": 4414,
    "segs": [ {
      "utf8": "- Hair, knife, duck, heart, butterfly."
    } ]
  }, {
    "tStartMs": 278800,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "- Apple, bicycle, guitar."
    } ]
  }, {
    "tStartMs": 282230,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "- There was a spider."
    } ]
  }, {
    "tStartMs": 284240,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Did I say eye already?"
    } ]
  }, {
    "tStartMs": 285400,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- Trumpet, pear.\n- Pear."
    } ]
  }, {
    "tStartMs": 287040,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "- Butterfly.\n- Duck."
    } ]
  }, {
    "tStartMs": 288340,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "- Knife.\n- Boat."
    } ]
  }, {
    "tStartMs": 289350,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "- Heart.\n- Knife."
    } ]
  }, {
    "tStartMs": 290200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Heart."
    } ]
  }, {
    "tStartMs": 291033,
    "dDurationMs": 2357,
    "segs": [ {
      "utf8": "- I couldn't tell you the\nrest, that's all I got."
    } ]
  }, {
    "tStartMs": 293390,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- [Derek] Most people could remember"
    } ]
  }, {
    "tStartMs": 294840,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "only about five or six things."
    } ]
  }, {
    "tStartMs": 296897,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "- Yeah, yeah.\n- Six, six is not bad."
    } ]
  }, {
    "tStartMs": 298227,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- All right."
    } ]
  }, {
    "tStartMs": 299060,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- Six.\n- Six out of 10"
    } ]
  }, {
    "tStartMs": 300420,
    "dDurationMs": 1587,
    "segs": [ {
      "utf8": "which is not bad, right?\n- Oh, all right, yeah."
    } ]
  }, {
    "tStartMs": 302007,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "- That's a passing score."
    } ]
  }, {
    "tStartMs": 303170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Candle.\n- Oh."
    } ]
  }, {
    "tStartMs": 304003,
    "dDurationMs": 1472,
    "segs": [ {
      "utf8": "- Candle.\n- Everyone forgets the candle."
    } ]
  }, {
    "tStartMs": 305475,
    "dDurationMs": 3065,
    "segs": [ {
      "utf8": "But a few could remember\nsubstantially more,"
    } ]
  }, {
    "tStartMs": 308540,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "say, eight or nine items."
    } ]
  }, {
    "tStartMs": 310380,
    "dDurationMs": 2052,
    "segs": [ {
      "utf8": "- Bug, I don't know if I said bug."
    } ]
  }, {
    "tStartMs": 312432,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Guitar, bike, eye,\nbell, spoon, sun, chair."
    } ]
  }, {
    "tStartMs": 317450,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "I'm forgetting the last two."
    } ]
  }, {
    "tStartMs": 318710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- That's pretty good.\n- Eight is really good."
    } ]
  }, {
    "tStartMs": 320270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh, cool."
    } ]
  }, {
    "tStartMs": 321103,
    "dDurationMs": 947,
    "segs": [ {
      "utf8": "- Nine?\n- Nine out of 10."
    } ]
  }, {
    "tStartMs": 322050,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Nine, very impressive."
    } ]
  }, {
    "tStartMs": 324900,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But the reason didn't seem to\nbe because the presentation"
    } ]
  }, {
    "tStartMs": 327510,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "matched their preferred learning style"
    } ]
  }, {
    "tStartMs": 329930,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "but because they employed\na memory strategy."
    } ]
  }, {
    "tStartMs": 333112,
    "dDurationMs": 2935,
    "segs": [ {
      "utf8": "- So as you were showing I was\nmaking an order in my head."
    } ]
  }, {
    "tStartMs": 336047,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "So as I saw more I would\njust add it to the list"
    } ]
  }, {
    "tStartMs": 339250,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "and I was repeating the list\nas I was looking at them"
    } ]
  }, {
    "tStartMs": 341240,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "so I could just say it out loud."
    } ]
  }, {
    "tStartMs": 342600,
    "dDurationMs": 2188,
    "segs": [ {
      "utf8": "- Did you try a strategy\nwhile you were looking"
    } ]
  }, {
    "tStartMs": 344788,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "at those pictures?\n- Yeah, yeah."
    } ]
  }, {
    "tStartMs": 346580,
    "dDurationMs": 2683,
    "segs": [ {
      "utf8": "So I guess I tried creating a story"
    } ]
  }, {
    "tStartMs": 349263,
    "dDurationMs": 1517,
    "segs": [ {
      "utf8": "'cause it's easier to remember a story"
    } ]
  }, {
    "tStartMs": 350780,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "than just individual objects."
    } ]
  }, {
    "tStartMs": 352660,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "So I tried to tie it all into one story."
    } ]
  }, {
    "tStartMs": 355190,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "- This is all obviously\nanecdotal evidence,"
    } ]
  }, {
    "tStartMs": 357370,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "but rigorous studies\nlike the one I outlined"
    } ]
  }, {
    "tStartMs": 359810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "have been conducted."
    } ]
  }, {
    "tStartMs": 361220,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "For example, one looked at\nvisualizers versus verbalizers"
    } ]
  }, {
    "tStartMs": 364790,
    "dDurationMs": 2176,
    "segs": [ {
      "utf8": "instead of visual versus\nauditory learners."
    } ]
  }, {
    "tStartMs": 366966,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "The study was computer-based,"
    } ]
  }, {
    "tStartMs": 369600,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "so first students' learning\nstyles were assessed"
    } ]
  }, {
    "tStartMs": 371870,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "using questions like, would\nyou rather read a paragraph"
    } ]
  }, {
    "tStartMs": 375020,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "or see a diagram describing an atom?"
    } ]
  }, {
    "tStartMs": 377440,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "The researchers also provided\nsome challenging explanations"
    } ]
  }, {
    "tStartMs": 380520,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "with two buttons, visual\nhelp or verbal help."
    } ]
  }, {
    "tStartMs": 384110,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The visual one played a short animation"
    } ]
  }, {
    "tStartMs": 386290,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "whereas the verbal help\ngave a written explanation."
    } ]
  }, {
    "tStartMs": 389670,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "From these measures combined,\nthe researchers categorized"
    } ]
  }, {
    "tStartMs": 392100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the students as either\nvisualizers or verbalizers"
    } ]
  }, {
    "tStartMs": 395280,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and then the students\nwere randomly assigned"
    } ]
  }, {
    "tStartMs": 397470,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to go through a text-based"
    } ]
  }, {
    "tStartMs": 399090,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "or picture-based lesson on electronics."
    } ]
  }, {
    "tStartMs": 402220,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "When a student hovered\ntheir mouse over key words"
    } ]
  }, {
    "tStartMs": 404460,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in the lesson in the text-based group,"
    } ]
  }, {
    "tStartMs": 406560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "a definition and clarification came up."
    } ]
  }, {
    "tStartMs": 408810,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But in the picture group,"
    } ]
  }, {
    "tStartMs": 410130,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "an annotated diagram was shown instead."
    } ]
  }, {
    "tStartMs": 412780,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And after the lesson,\nthe students did a test"
    } ]
  }, {
    "tStartMs": 415100,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "to assess their learning."
    } ]
  }, {
    "tStartMs": 416710,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The students whose\npreferred learning style"
    } ]
  }, {
    "tStartMs": 418470,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "matched their instruction\nperformed no better on the tests"
    } ]
  }, {
    "tStartMs": 422560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "than those whose\ninstruction was mismatched."
    } ]
  }, {
    "tStartMs": 425200,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "The researchers ran the test again"
    } ]
  }, {
    "tStartMs": 426810,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "with 61 non-college-educated adults"
    } ]
  }, {
    "tStartMs": 429250,
    "dDurationMs": 2114,
    "segs": [ {
      "utf8": "and found exactly the same result."
    } ]
  }, {
    "tStartMs": 431364,
    "dDurationMs": 2522,
    "segs": [ {
      "utf8": "But learning styles are a preference"
    } ]
  }, {
    "tStartMs": 433886,
    "dDurationMs": 3824,
    "segs": [ {
      "utf8": "so how strongly do learners\nstick to their preference?"
    } ]
  }, {
    "tStartMs": 437710,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Well, in a 2018 study during\nthe first week of semester,"
    } ]
  }, {
    "tStartMs": 440630,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "over 400 students at a\nuniversity in Indiana"
    } ]
  }, {
    "tStartMs": 443440,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "completed the VARK questionnaire\nand they were classified"
    } ]
  }, {
    "tStartMs": 446480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "according to their learning style."
    } ]
  }, {
    "tStartMs": 448100,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Then at the end of the semester"
    } ]
  }, {
    "tStartMs": 449320,
    "dDurationMs": 3054,
    "segs": [ {
      "utf8": "the same students completed a\nstudy strategy questionnaire."
    } ]
  }, {
    "tStartMs": 452374,
    "dDurationMs": 3406,
    "segs": [ {
      "utf8": "So how did they actually\nstudy during the term?"
    } ]
  }, {
    "tStartMs": 455780,
    "dDurationMs": 1929,
    "segs": [ {
      "utf8": "Well, an overwhelming majority of students"
    } ]
  }, {
    "tStartMs": 457709,
    "dDurationMs": 2972,
    "segs": [ {
      "utf8": "used study strategies which\nwere supposedly incompatible"
    } ]
  }, {
    "tStartMs": 460681,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "with their learning style,"
    } ]
  }, {
    "tStartMs": 462580,
    "dDurationMs": 1538,
    "segs": [ {
      "utf8": "and the minority of students who did"
    } ]
  }, {
    "tStartMs": 464118,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "did not perform significantly differently"
    } ]
  }, {
    "tStartMs": 466370,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "on the assessments in the course."
    } ]
  }, {
    "tStartMs": 468553,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "The visual auditory\nreading-writing, kinesthetic"
    } ]
  }, {
    "tStartMs": 471120,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "or VARK model came\nabout from Neil Fleming,"
    } ]
  }, {
    "tStartMs": 473920,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "a school inspector in New Zealand."
    } ]
  }, {
    "tStartMs": 476040,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Describing the origins of VARK he says,"
    } ]
  }, {
    "tStartMs": 478390,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "I was puzzled when I\nobserved excellent teachers"
    } ]
  }, {
    "tStartMs": 480540,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "who did not reach some learners\nand poor teachers who did."
    } ]
  }, {
    "tStartMs": 484220,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "I decided to try to solve this puzzle."
    } ]
  }, {
    "tStartMs": 486360,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "There are, of course, many\nreasons for what I observed."
    } ]
  }, {
    "tStartMs": 489540,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "But one topic that seemed\nto hold some magic,"
    } ]
  }, {
    "tStartMs": 492500,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "some explanatory power,"
    } ]
  }, {
    "tStartMs": 494150,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "was preferred modes of\nlearning, modal preferences."
    } ]
  }, {
    "tStartMs": 497850,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "And thus, VARK was born."
    } ]
  }, {
    "tStartMs": 500240,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "There was no study that revealed"
    } ]
  }, {
    "tStartMs": 502020,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "students naturally cluster\ninto four distinct groups."
    } ]
  }, {
    "tStartMs": 504980,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Just some magic that might explain"
    } ]
  }, {
    "tStartMs": 506720,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "why some teachers can reach\nstudents while others can't."
    } ]
  }, {
    "tStartMs": 509930,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But how can this be?"
    } ]
  }, {
    "tStartMs": 511430,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "If we accept that some\npeople are more skilled"
    } ]
  }, {
    "tStartMs": 513650,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "at interpreting and remembering\ncertain kinds of stimuli"
    } ]
  }, {
    "tStartMs": 515960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "than others like visual or auditory,"
    } ]
  }, {
    "tStartMs": 518660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "then why don't we see\ndifferences in learning"
    } ]
  }, {
    "tStartMs": 521180,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "or recall with different presentations?"
    } ]
  }, {
    "tStartMs": 523600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Well, it's because what we\nactually want people to recall"
    } ]
  }, {
    "tStartMs": 526480,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "is not the precise nature of the images"
    } ]
  }, {
    "tStartMs": 528810,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "or the pitch or quality of the sound."
    } ]
  }, {
    "tStartMs": 531010,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "It's the meaning behind the presentations."
    } ]
  }, {
    "tStartMs": 533212,
    "dDurationMs": 2678,
    "segs": [ {
      "utf8": "There are some tasks that\nobviously require the use"
    } ]
  }, {
    "tStartMs": 535890,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "of a particular modality."
    } ]
  }, {
    "tStartMs": 537520,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "Learning about music, for example,"
    } ]
  }, {
    "tStartMs": 539130,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "should have an auditory component."
    } ]
  }, {
    "tStartMs": 541180,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Similarly, learning about geography"
    } ]
  }, {
    "tStartMs": 542910,
    "dDurationMs": 2145,
    "segs": [ {
      "utf8": "will involve looking at maps."
    } ]
  }, {
    "tStartMs": 545055,
    "dDurationMs": 2485,
    "segs": [ {
      "utf8": "And some people will have greater aptitude"
    } ]
  }, {
    "tStartMs": 547540,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to learn one task over another."
    } ]
  }, {
    "tStartMs": 549310,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Someone with perfect pitch, for example,"
    } ]
  }, {
    "tStartMs": 551090,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "will be better able to recall\ncertain tones in music."
    } ]
  }, {
    "tStartMs": 553830,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Someone with excellent\nvisual-spatial reasoning"
    } ]
  }, {
    "tStartMs": 555820,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "will be better at learning the locations"
    } ]
  }, {
    "tStartMs": 557460,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of countries on a map."
    } ]
  }, {
    "tStartMs": 558870,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But the claim of learning style theories"
    } ]
  }, {
    "tStartMs": 560730,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "is that these preferences"
    } ]
  }, {
    "tStartMs": 561990,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "will be consistent\nacross learning domains."
    } ]
  }, {
    "tStartMs": 564792,
    "dDurationMs": 2078,
    "segs": [ {
      "utf8": "The person with perfect pitch"
    } ]
  }, {
    "tStartMs": 566870,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "should learn everything better auditorily"
    } ]
  }, {
    "tStartMs": 569157,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "but that is clearly not the case."
    } ]
  }, {
    "tStartMs": 571780,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "Most people will learn\ngeography better with a map."
    } ]
  }, {
    "tStartMs": 575940,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Review articles of learning\nstyles consistently conclude"
    } ]
  }, {
    "tStartMs": 578910,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "there is no credible evidence\nthat learning styles exist."
    } ]
  }, {
    "tStartMs": 583030,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "In a 2009 review, the\nresearchers note, the contrast"
    } ]
  }, {
    "tStartMs": 586360,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "between the enormous popularity"
    } ]
  }, {
    "tStartMs": 588100,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "of the learning styles\napproach within education"
    } ]
  }, {
    "tStartMs": 590630,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "and the lack of credible\nevidence for its utility is,"
    } ]
  }, {
    "tStartMs": 594060,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "in our opinion, striking and disturbing."
    } ]
  }, {
    "tStartMs": 597250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If classification of\nstudents' learning styles"
    } ]
  }, {
    "tStartMs": 599080,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "has practical utility, it\nremains to be demonstrated."
    } ]
  }, {
    "tStartMs": 602870,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "- What we're expecting is,\nif your style was honored"
    } ]
  }, {
    "tStartMs": 606210,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "you're going to perform better than if"
    } ]
  }, {
    "tStartMs": 608320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "you had some experience that\nconflicted with your style."
    } ]
  }, {
    "tStartMs": 610880,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "And this is where we don't see any support"
    } ]
  }, {
    "tStartMs": 613710,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "for the learning styles theory."
    } ]
  }, {
    "tStartMs": 615730,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "- One of the reasons many\npeople find learning styles"
    } ]
  }, {
    "tStartMs": 617581,
    "dDurationMs": 4139,
    "segs": [ {
      "utf8": "so convincing is because they\nalready believe it to be true."
    } ]
  }, {
    "tStartMs": 621720,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "For example, they might already think"
    } ]
  }, {
    "tStartMs": 623288,
    "dDurationMs": 2772,
    "segs": [ {
      "utf8": "that they're a visual learner,\nand then when a teacher"
    } ]
  }, {
    "tStartMs": 626060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "shows them a diagram of, say, a bike pump"
    } ]
  }, {
    "tStartMs": 629000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and suddenly the concept clicks,"
    } ]
  }, {
    "tStartMs": 630920,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "well, they interpret this as evidence"
    } ]
  }, {
    "tStartMs": 632660,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for their visual learning style."
    } ]
  }, {
    "tStartMs": 634310,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "- You already believe that\nlearning styles is right."
    } ]
  }, {
    "tStartMs": 636810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "When you have an experience\nthe first think you think is,"
    } ]
  }, {
    "tStartMs": 639600,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "is that in some way consistent\nwith learning styles?"
    } ]
  }, {
    "tStartMs": 642260,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "And if it is, you don't think further."
    } ]
  }, {
    "tStartMs": 643830,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- When in reality that diagram\nmight just be a great diagram"
    } ]
  }, {
    "tStartMs": 647250,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "that would have helped anyone learn."
    } ]
  }, {
    "tStartMs": 649240,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "When we already believe the\nworld to be a certain way,"
    } ]
  }, {
    "tStartMs": 652230,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "then we interpret new experiences\nto fit with those beliefs"
    } ]
  }, {
    "tStartMs": 655690,
    "dDurationMs": 2218,
    "segs": [ {
      "utf8": "whether they actually do or not."
    } ]
  }, {
    "tStartMs": 657908,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "So if learning styles"
    } ]
  }, {
    "tStartMs": 659610,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "don't improve learning, then what does?"
    } ]
  }, {
    "tStartMs": 662440,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Well, there's a large body of literature"
    } ]
  }, {
    "tStartMs": 663720,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "that supports the claim\nthat everyone learns better"
    } ]
  }, {
    "tStartMs": 665980,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "with multimodal approaches"
    } ]
  }, {
    "tStartMs": 667330,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "where words and pictures\nare presented together"
    } ]
  }, {
    "tStartMs": 669980,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "rather than either\nwords or pictures alone."
    } ]
  }, {
    "tStartMs": 672600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Now there's gonna be words\nas well as the picture."
    } ]
  }, {
    "tStartMs": 675090,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "We're gonna see if this is any better."
    } ]
  }, {
    "tStartMs": 677060,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "This is known as the multimedia effect,"
    } ]
  }, {
    "tStartMs": 679500,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "and it explains in part, at least,"
    } ]
  }, {
    "tStartMs": 681430,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "why videos can be such\npowerful tools for learning"
    } ]
  }, {
    "tStartMs": 684220,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "when the narration\ncomplements the visuals."
    } ]
  }, {
    "tStartMs": 686920,
    "dDurationMs": 1093,
    "segs": [ {
      "utf8": "Duck.\n- Duck."
    } ]
  }, {
    "tStartMs": 690134,
    "dDurationMs": 1586,
    "segs": [ {
      "utf8": "- Heart.\n- Heart."
    } ]
  }, {
    "tStartMs": 691720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- [Derek] In my PhD research,\nI found explicit discussion"
    } ]
  }, {
    "tStartMs": 694440,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "of misconceptions was essential"
    } ]
  }, {
    "tStartMs": 696140,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "in multimedia teaching\nfor introductory physics."
    } ]
  }, {
    "tStartMs": 698830,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- How many is that?\n- Six."
    } ]
  }, {
    "tStartMs": 700050,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "- Six, okay, that's good."
    } ]
  }, {
    "tStartMs": 701030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- That is a whole 50% better."
    } ]
  }, {
    "tStartMs": 703490,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "Do you think that was easier?"
    } ]
  }, {
    "tStartMs": 704948,
    "dDurationMs": 3032,
    "segs": [ {
      "utf8": "- Yeah, yeah, 100%, 100%.\n- Yeah, with the words, yeah."
    } ]
  }, {
    "tStartMs": 707980,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "- Ultimately, the most\nimportant thing for learning"
    } ]
  }, {
    "tStartMs": 710214,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "is not the way the\ninformation is presented"
    } ]
  }, {
    "tStartMs": 712980,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "but what is happening\ninside the learner's head."
    } ]
  }, {
    "tStartMs": 715990,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "People learn best when\nthey're actively thinking"
    } ]
  }, {
    "tStartMs": 718310,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "about the material, solving problems"
    } ]
  }, {
    "tStartMs": 720450,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "or imagining what happens if\ndifferent variables change."
    } ]
  }, {
    "tStartMs": 724010,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I talked about how and why we learn best"
    } ]
  }, {
    "tStartMs": 726290,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "in my video, \"The Science of\nThinking\" so check that out."
    } ]
  }, {
    "tStartMs": 729690,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Now, the truth is, there\nare many evidence-based"
    } ]
  }, {
    "tStartMs": 731960,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "teaching methods that improve learning."
    } ]
  }, {
    "tStartMs": 734220,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "Learning styles is just not one of them."
    } ]
  }, {
    "tStartMs": 737810,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And it is likely, given the prevalence"
    } ]
  }, {
    "tStartMs": 740210,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of the learning styles misconception"
    } ]
  }, {
    "tStartMs": 741830,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "that it actually makes learning worse."
    } ]
  }, {
    "tStartMs": 744210,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "I mean, learning styles give\nteachers unnecessary things"
    } ]
  }, {
    "tStartMs": 747130,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "to worry about, and they\nmake some students reluctant"
    } ]
  }, {
    "tStartMs": 749640,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "to engage with certain\ntypes of instruction."
    } ]
  }, {
    "tStartMs": 752650,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "And all the time and money\nspent on learning styles"
    } ]
  }, {
    "tStartMs": 755220,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and related training could be\nbetter spent on interventions"
    } ]
  }, {
    "tStartMs": 757720,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that actually improve learning."
    } ]
  }, {
    "tStartMs": 760180,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "You are not a visual learner\nnor an auditory learner"
    } ]
  }, {
    "tStartMs": 764080,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "nor a kinesthetic learner,\nor more accurately,"
    } ]
  }, {
    "tStartMs": 767130,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "you are all these kinds of learner in one."
    } ]
  }, {
    "tStartMs": 770400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The best learning experiences are those"
    } ]
  }, {
    "tStartMs": 772470,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "that involve multiple different ways"
    } ]
  }, {
    "tStartMs": 774318,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "of understanding the same thing."
    } ]
  }, {
    "tStartMs": 776620,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "And best of all, this strategy works"
    } ]
  }, {
    "tStartMs": 778610,
    "dDurationMs": 4825,
    "segs": [ {
      "utf8": "not just for one subset of\npeople but for everyone."
    } ]
  }, {
    "tStartMs": 783435,
    "dDurationMs": 4035,
    "segs": [ {
      "utf8": "(radio tuner chirping)"
    } ]
  }, {
    "tStartMs": 787470,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "This part of the video was\nsponsored by Google Search."
    } ]
  }, {
    "tStartMs": 790160,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "Now, there are lots of topics out there"
    } ]
  }, {
    "tStartMs": 791730,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "that are controversial like\nlearning styles, for example."
    } ]
  }, {
    "tStartMs": 794960,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Most people believe\nlearning styles are a thing"
    } ]
  }, {
    "tStartMs": 797690,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "whereas educational researchers"
    } ]
  }, {
    "tStartMs": 799270,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "find no robust evidence for them."
    } ]
  }, {
    "tStartMs": 801400,
    "dDurationMs": 1879,
    "segs": [ {
      "utf8": "And if you search for learning styles,"
    } ]
  }, {
    "tStartMs": 803279,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "you'll get lots of sites\nwith resources and quizzes."
    } ]
  }, {
    "tStartMs": 806520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But if you search for\nlearning styles debunked,"
    } ]
  }, {
    "tStartMs": 809130,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "well, then you'll find articles"
    } ]
  }, {
    "tStartMs": 810810,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "about how there is very little evidence"
    } ]
  }, {
    "tStartMs": 812630,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "for the learning styles hypothesis."
    } ]
  }, {
    "tStartMs": 814630,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "I think one of the most\ncommon traps people fall into"
    } ]
  }, {
    "tStartMs": 817475,
    "dDurationMs": 1995,
    "segs": [ {
      "utf8": "is only searching for information"
    } ]
  }, {
    "tStartMs": 819470,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that confirms what they already believe."
    } ]
  }, {
    "tStartMs": 821750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "A common mistake is putting\nthe answer you're looking for"
    } ]
  }, {
    "tStartMs": 824420,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "right in the search query."
    } ]
  }, {
    "tStartMs": 826140,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "A better idea is to try another search,"
    } ]
  }, {
    "tStartMs": 828620,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "adding debunked or false at\nthe end and see what comes up."
    } ]
  }, {
    "tStartMs": 831510,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And Google makes it\neasy to get more detail"
    } ]
  }, {
    "tStartMs": 833630,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "about the source of the information."
    } ]
  }, {
    "tStartMs": 835570,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Just click the three dots\nnext to any search result"
    } ]
  }, {
    "tStartMs": 838250,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "and then you can judge for yourself"
    } ]
  }, {
    "tStartMs": 839880,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "whether the information is trustworthy"
    } ]
  }, {
    "tStartMs": 841540,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "and if you want to visit the site."
    } ]
  }, {
    "tStartMs": 842910,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "A Google Search is meant to surface"
    } ]
  }, {
    "tStartMs": 844510,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the most relevant\ninformation for your query."
    } ]
  }, {
    "tStartMs": 847360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But it's up to you to\nformulate that query,"
    } ]
  }, {
    "tStartMs": 850160,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "try a few different searches,"
    } ]
  }, {
    "tStartMs": 851530,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and assess whether the\ninformation is reliable."
    } ]
  }, {
    "tStartMs": 854570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And the whole point of Veritasium\nis to get to the truth."
    } ]
  }, {
    "tStartMs": 857300,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "So I'm excited to encourage everyone"
    } ]
  }, {
    "tStartMs": 858850,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "to think more critically\nabout how we get information."
    } ]
  }, {
    "tStartMs": 862070,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "I want to thank Google for\nsponsoring this part of the video"
    } ]
  }, {
    "tStartMs": 864360,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
