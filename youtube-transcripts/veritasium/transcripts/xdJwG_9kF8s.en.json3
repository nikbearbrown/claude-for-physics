  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I'm about to experience weightlessness"
    } ]
  }, {
    "tStartMs": 3180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "for the first time."
    } ]
  }, {
    "tStartMs": 6640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Oh my god! Oh my god"
    } ]
  }, {
    "tStartMs": 9760,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "that is so strange  *Oh my god*"
    } ]
  }, {
    "tStartMs": 14580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "this is totally freaky"
    } ]
  }, {
    "tStartMs": 17760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "this is way better than I expected"
    } ]
  }, {
    "tStartMs": 19760,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "I'm just gonna say that right now"
    } ]
  }, {
    "tStartMs": 21540,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "*um*"
    } ]
  }, {
    "tStartMs": 22560,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "I'm going up to the ceiling"
    } ]
  }, {
    "tStartMs": 25100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "and here we are."
    } ]
  }, {
    "tStartMs": 29540,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I am ridiculously excited, because behind me"
    } ]
  }, {
    "tStartMs": 33020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is a Zero-G plane."
    } ]
  }, {
    "tStartMs": 34660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I'm in France, I was invited here by"
    } ]
  }, {
    "tStartMs": 37160,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "by the youtuber Bruce."
    } ]
  }, {
    "tStartMs": 38340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This is Bruce, Diana physics girl."
    } ]
  }, {
    "tStartMs": 41320,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "We are going - flying some parabolas-  we're going into Zero-G"
    } ]
  }, {
    "tStartMs": 44480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's gonna be awesome! C'mon"
    } ]
  }, {
    "tStartMs": 48020,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The principle behind weightlessness is pretty simple,"
    } ]
  }, {
    "tStartMs": 50340,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "the plane and everything inside it just need to accelerate towards the earth"
    } ]
  }, {
    "tStartMs": 53780,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "at the same rate as a freely falling object in a vacuum."
    } ]
  }, {
    "tStartMs": 57040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That is 9.8 meters per second squared"
    } ]
  }, {
    "tStartMs": 59440,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So, you can think of your body as this pen, and the plane as this bottle"
    } ]
  }, {
    "tStartMs": 63540,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "and when it's freely falling, there's no contact force between the pen and the bottle,"
    } ]
  }, {
    "tStartMs": 68380,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "and so the pen feels weightless."
    } ]
  }, {
    "tStartMs": 70560,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "So you might think the way to do this"
    } ]
  }, {
    "tStartMs": 71920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is just to put the plane into a dive."
    } ]
  }, {
    "tStartMs": 74200,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "But that's not actually how it works."
    } ]
  }, {
    "tStartMs": 76460,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Instead, the plane starts climbing"
    } ]
  }, {
    "tStartMs": 78480,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "at a steadily increasing angle."
    } ]
  }, {
    "tStartMs": 80800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "With no windows inside,"
    } ]
  }, {
    "tStartMs": 82180,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "it's impossible to tell that this is happening,"
    } ]
  }, {
    "tStartMs": 84300,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and all you feel is pressed into the floor with a force"
    } ]
  }, {
    "tStartMs": 87460,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "1.8 times your body weight."
    } ]
  }, {
    "tStartMs": 90080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "This is because the plane's acceleration is"
    } ]
  }, {
    "tStartMs": 91829,
    "dDurationMs": 1891,
    "segs": [ {
      "utf8": "directed upwards and perpendicular to"
    } ]
  }, {
    "tStartMs": 93720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the floor, and it makes standing very"
    } ]
  }, {
    "tStartMs": 95640,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "difficult - not only are you nearly twice"
    } ]
  }, {
    "tStartMs": 97860,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "as heavy, all the blood drains from your"
    } ]
  }, {
    "tStartMs": 100350,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "head and into your feet - which made me"
    } ]
  }, {
    "tStartMs": 102390,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "pretty dizzy. -Ah!"
    } ]
  }, {
    "tStartMs": 107040,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Haha! So weak... ugh -Lying on your back is much"
    } ]
  }, {
    "tStartMs": 111060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "more comfortable, and we're advised not"
    } ]
  }, {
    "tStartMs": 113190,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "to move our heads around and look"
    } ]
  }, {
    "tStartMs": 114480,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "straight ahead,"
    } ]
  }, {
    "tStartMs": 115230,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "because in hyper-G our vestibular system"
    } ]
  }, {
    "tStartMs": 117690,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "is hypersensitive to movement, which can"
    } ]
  }, {
    "tStartMs": 120300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "lead to motion sickness. And that's why"
    } ]
  }, {
    "tStartMs": 122400,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "this is sometimes called the vomit comet."
    } ]
  }, {
    "tStartMs": 124290,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "-I kind of like this. -It is fun, feels like"
    } ]
  }, {
    "tStartMs": 127950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "someone lying on you -Yeah -Not like that."
    } ]
  }, {
    "tStartMs": 130050,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Once the plane is climbing at about 50"
    } ]
  }, {
    "tStartMs": 132420,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "degrees,"
    } ]
  }, {
    "tStartMs": 133020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the engines are ramped down, and the"
    } ]
  }, {
    "tStartMs": 135060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "plane is put into a parabolic trajectory."
    } ]
  }, {
    "tStartMs": 137580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's at this point that you start"
    } ]
  }, {
    "tStartMs": 139500,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "experiencing weightlessness. -I can feel"
    } ]
  }, {
    "tStartMs": 141210,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "myself getting lighter... oh that is such a"
    } ]
  }, {
    "tStartMs": 144420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "strange feeling... that is so weird..."
    } ]
  }, {
    "tStartMs": 147030,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "-The plane and you are still moving"
    } ]
  }, {
    "tStartMs": 149040,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "upward, but you are accelerating downward."
    } ]
  }, {
    "tStartMs": 152600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "-There's Diana, she's the physics girl"
    } ]
  }, {
    "tStartMs": 154480,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Then the plane peaks, and start\nspeeding up again towards the Earth."
    } ]
  }, {
    "tStartMs": 160460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The whole time the plane is\naccelerating toward Earth"
    } ]
  }, {
    "tStartMs": 163280,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "with the same acceleration as a\nfree falling object in vacuum,"
    } ]
  }, {
    "tStartMs": 166320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "the pilots have to very skillfully\nadjust the thrust"
    } ]
  }, {
    "tStartMs": 168920,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "to perfectly balance air resistance,\nand maintain exactly this acceleration."
    } ]
  }, {
    "tStartMs": 173880,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Oh, my goodness-"
    } ]
  }, {
    "tStartMs": 174900,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "how do you feel?"
    } ]
  }, {
    "tStartMs": 176320,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "This is incredible."
    } ]
  }, {
    "tStartMs": 177820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So, it's like throwing this bottle\ninto the air"
    } ]
  }, {
    "tStartMs": 179980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the pen inside experiences weightlessness"
    } ]
  }, {
    "tStartMs": 182080,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "from the time it leaves my hand,\nuntil it comes into contact again."
    } ]
  }, {
    "tStartMs": 185920,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "After 22 seconds of weightlessness,\nthe pilots pull out of the dive"
    } ]
  }, {
    "tStartMs": 189180,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "again, subjecting us to hyper-g..."
    } ]
  }, {
    "tStartMs": 191080,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "as the plane accelerate upwards."
    } ]
  }, {
    "tStartMs": 193400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "In total, we have performed thirteen\nof these zero-g parabolas-"
    } ]
  }, {
    "tStartMs": 196840,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "plus, one martian gravity and\ntwo moon gravity parabolas."
    } ]
  }, {
    "tStartMs": 200160,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Okay, we are now in Mars gravity."
    } ]
  }, {
    "tStartMs": 202680,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "In Mars gravity i can do"
    } ]
  }, {
    "tStartMs": 204540,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "one arm pull ups.."
    } ]
  }, {
    "tStartMs": 205600,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "maybe."
    } ]
  }, {
    "tStartMs": 214240,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I am the martian."
    } ]
  }, {
    "tStartMs": 216720,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "We brought along some experiments\nto do in zero-g."
    } ]
  }, {
    "tStartMs": 219100,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "So, this is in about 1g, \nof gravity"
    } ]
  }, {
    "tStartMs": 222720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "this are what the flame looks like\non this barbecue lighter"
    } ]
  }, {
    "tStartMs": 224580,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "now we are gonna try it\nin hyper-g?"
    } ]
  }, {
    "tStartMs": 226900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "And then we'll try it in zero-g"
    } ]
  }, {
    "tStartMs": 229060,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "and it should be..."
    } ]
  }, {
    "tStartMs": 230320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "We will see...  (2x)."
    } ]
  }, {
    "tStartMs": 231600,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "We take it for granted that flames\nhad this distinctive shape."
    } ]
  }, {
    "tStartMs": 234840,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But that only because of gravity."
    } ]
  }, {
    "tStartMs": 237200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The products of combustion have more energy"
    } ]
  }, {
    "tStartMs": 239360,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and so, move around faster and take up more space\nthan the cooler air around them."
    } ]
  }, {
    "tStartMs": 244340,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Therefore, there is a buoyant force on them,\nwhich is greater than their weight-"
    } ]
  }, {
    "tStartMs": 247660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and so, hot air rises."
    } ]
  }, {
    "tStartMs": 249580,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "This helps pulling the oxygen from \naround the flame to continue the reaction."
    } ]
  }, {
    "tStartMs": 253880,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "We are going through hyper-g."
    } ]
  }, {
    "tStartMs": 256460,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "i keep blowing out the candle, because..."
    } ]
  }, {
    "tStartMs": 259280,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The, uhhh... stress of hyper-g is\nsignificant."
    } ]
  }, {
    "tStartMs": 262600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "In hyper-g, this effect is magnified."
    } ]
  }, {
    "tStartMs": 265120,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Since the effect of gravity is\nalmost twice as much."
    } ]
  }, {
    "tStartMs": 267900,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "This amplifies the difference between\nthe weight of the hot air,"
    } ]
  }, {
    "tStartMs": 270720,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "and the weight of the cooler air around it-"
    } ]
  }, {
    "tStartMs": 272980,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "and so, the hot air rises faster..."
    } ]
  }, {
    "tStartMs": 275400,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "making, a longer flame."
    } ]
  }, {
    "tStartMs": 281060,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Oh my goodness."
    } ]
  }, {
    "tStartMs": 282740,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Look at that flame just..."
    } ]
  }, {
    "tStartMs": 285560,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in zero-g 'cause there is..."
    } ]
  }, {
    "tStartMs": 287400,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "much less buoyant force,"
    } ]
  }, {
    "tStartMs": 289080,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "to carry away..."
    } ]
  }, {
    "tStartMs": 290860,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And so, the combustion is not as good\nyou can see a lot of smoke."
    } ]
  }, {
    "tStartMs": 294140,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "coming off, of that candle."
    } ]
  }, {
    "tStartMs": 296740,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "And it's incredible."
    } ]
  }, {
    "tStartMs": 301800,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "So, we still have a gas flow"
    } ]
  }, {
    "tStartMs": 303100,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "so this is why the flame\nis not circular."
    } ]
  }, {
    "tStartMs": 307480,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "It is not a sphere, but it looks very strange."
    } ]
  }, {
    "tStartMs": 310400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "In zero-g, the hot air is still \nless dense than the cooler air..."
    } ]
  }, {
    "tStartMs": 313520,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but, now there is no weight,"
    } ]
  }, {
    "tStartMs": 315380,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and no buoyant force."
    } ]
  }, {
    "tStartMs": 317520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So, the flame doesn't rise as high."
    } ]
  }, {
    "tStartMs": 320180,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "This flame still maintain some if it shape,\nbecause of the flow of fuel from the lighter"
    } ]
  }, {
    "tStartMs": 324340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "otherwise, the flame would form a sphere."
    } ]
  }, {
    "tStartMs": 326920,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Like on the space station."
    } ]
  }, {
    "tStartMs": 328680,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Where, it's very difficult to maintain the\ncombustion reaction."
    } ]
  }, {
    "tStartMs": 331220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because it's hard for oxygen to access the fuel"
    } ]
  }, {
    "tStartMs": 334100,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with all of the combustion \nproducts getting in the way."
    } ]
  }, {
    "tStartMs": 336640,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "So, if you're ever unsure about what\nthe gravitational acceleration is where you are."
    } ]
  }, {
    "tStartMs": 341160,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Well, looking at a flame is a pretty\ngood way of finding out."
    } ]
  }, {
    "tStartMs": 349140,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I also brought along a slinky, to \ntry the slow motion slinky drop"
    } ]
  }, {
    "tStartMs": 352740,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "but, in zero-g."
    } ]
  }, {
    "tStartMs": 354380,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Of course, here i couldn't dangle\nthe slinky under it's own weight"
    } ]
  }, {
    "tStartMs": 357760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "so, i swung it around my head instead."
    } ]
  }, {
    "tStartMs": 361120,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "The effect, should be similar with each\ncoils stretch to provide the tension that keeps..."
    } ]
  }, {
    "tStartMs": 365100,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the length of slinky beyond that..."
    } ]
  }, {
    "tStartMs": 366940,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "accelerating in uniform circular motion."
    } ]
  }, {
    "tStartMs": 369700,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "I wanted to see what happens to the \nend of the slinky, when i let go."
    } ]
  }, {
    "tStartMs": 376500,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Here we go, 3, 2, 1."
    } ]
  }, {
    "tStartMs": 385200,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "Did you catch that?"
    } ]
  }, {
    "tStartMs": 386540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The slinky remain fairly stretch out,"
    } ]
  }, {
    "tStartMs": 388480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and kept rotating at about the\nsame frequency as before."
    } ]
  }, {
    "tStartMs": 391840,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Initially, i thought this was a boring result."
    } ]
  }, {
    "tStartMs": 394800,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "But then i realized..."
    } ]
  }, {
    "tStartMs": 395880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the reason the slinky doesn't contract,"
    } ]
  }, {
    "tStartMs": 397960,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "is because weight, was never part\nof this equation."
    } ]
  }, {
    "tStartMs": 401120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The slinky stretched out in the first place,\nbecause it was rotating."
    } ]
  }, {
    "tStartMs": 404840,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "And, since it's rotating after i let go..."
    } ]
  }, {
    "tStartMs": 407100,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "roughly, the same amount of tension\nis required to maintain that circular motion."
    } ]
  }, {
    "tStartMs": 411060,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And so, it doesn't contract."
    } ]
  }, {
    "tStartMs": 413400,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "In zero-g, it's possible to have a stretched\nslinky rotating in place,"
    } ]
  }, {
    "tStartMs": 417760,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "without contracting"
    } ]
  }, {
    "tStartMs": 419000,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "as long as the tension in the slinky provides \nthe centripetal force, it will keep spinning."
    } ]
  }, {
    "tStartMs": 424560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This just goes against my intuition."
    } ]
  }, {
    "tStartMs": 426720,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Which is, made of course..."
    } ]
  }, {
    "tStartMs": 428120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "only had of experiences with gravity."
    } ]
  }, {
    "tStartMs": 432240,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Being weightless, was an unforgettable\nexperience."
    } ]
  }, {
    "tStartMs": 435300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But, maybe my favorite part,"
    } ]
  }, {
    "tStartMs": 437040,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "was how it challenged my intuition."
    } ]
  }, {
    "tStartMs": 440680,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "And that's the reason, we need to do research,\nin zero-g."
    } ]
  }, {
    "tStartMs": 448240,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "I want to say a huge thanks, to the team at NovaSpace\nwho made this an unforgettable experience."
    } ]
  }, {
    "tStartMs": 452680,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "And of course, Bruce who runs a french youtube channel, e-penser for inviting me."
    } ]
  }, {
    "tStartMs": 456540,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "You should really go check out his video from the zero-g experience, and of course Diana, the Physics Girl."
    } ]
  }, {
    "tStartMs": 461620,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Go check out her video on zero-g here."
    } ]
  } ]
}
