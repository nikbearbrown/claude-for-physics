{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "A plane plummets out of the sky,"
    } ]
  }, {
    "tStartMs": 3120,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "a speed runner inexplicably\njumps to a higher platform."
    } ]
  }, {
    "tStartMs": 6762,
    "dDurationMs": 1091,
    "segs": [ {
      "utf8": "What the?"
    } ]
  }, {
    "tStartMs": 7853,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What the?!"
    } ]
  }, {
    "tStartMs": 8686,
    "dDurationMs": 3144,
    "segs": [ {
      "utf8": "And an election\nrecount is triggered."
    } ]
  }, {
    "tStartMs": 11830,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "All because of the same\ninvisible phenomenon"
    } ]
  }, {
    "tStartMs": 15260,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "that permeates the universe."
    } ]
  }, {
    "tStartMs": 18480,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "On May 18th, 2003, voters in\nBelgium went to the polls."
    } ]
  }, {
    "tStartMs": 22770,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "In many regions, voting\nwas done on a computer,"
    } ]
  }, {
    "tStartMs": 25560,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "something the Belgians had\nbeen experimenting with"
    } ]
  }, {
    "tStartMs": 27610,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "for over a decade."
    } ]
  }, {
    "tStartMs": 29400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "But the system had a backup."
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Each voter would insert a\nmagnetic card into the machine"
    } ]
  }, {
    "tStartMs": 34460,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and make their selection on screen."
    } ]
  }, {
    "tStartMs": 36760,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Their vote was saved both to the computer"
    } ]
  }, {
    "tStartMs": 39540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and the magnetic card,"
    } ]
  }, {
    "tStartMs": 41070,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "which they dropped into\na box for redundancy."
    } ]
  }, {
    "tStartMs": 44360,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Late that night, as the\nvotes were being tabulated,"
    } ]
  }, {
    "tStartMs": 47140,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "one of the election\nofficials detected a problem"
    } ]
  }, {
    "tStartMs": 49670,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "with the results from Schaerbeek,"
    } ]
  }, {
    "tStartMs": 51540,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "a municipality in central Brussels."
    } ]
  }, {
    "tStartMs": 54230,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Maria Vindevogel, a little known candidate"
    } ]
  }, {
    "tStartMs": 56620,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "with her own party received more votes"
    } ]
  }, {
    "tStartMs": 59430,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "than was mathematically possible."
    } ]
  }, {
    "tStartMs": 61760,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "They knew this because of the way"
    } ]
  }, {
    "tStartMs": 63100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the preferential voting system works."
    } ]
  }, {
    "tStartMs": 65770,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "So they took out the magnetic\ncards and started a recount."
    } ]
  }, {
    "tStartMs": 69450,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "One by one, they fed each of them"
    } ]
  }, {
    "tStartMs": 71640,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "through the machines again,"
    } ]
  }, {
    "tStartMs": 73890,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "and after several hours,\nthe recount was complete."
    } ]
  }, {
    "tStartMs": 77080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The vote totals for every candidate"
    } ]
  }, {
    "tStartMs": 79480,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "were exactly the same as before,"
    } ]
  }, {
    "tStartMs": 82370,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "except for Maria Vindevogel."
    } ]
  }, {
    "tStartMs": 85100,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "In her case, the recounted number of votes"
    } ]
  }, {
    "tStartMs": 87360,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "was less than the original by 4,096."
    } ]
  }, {
    "tStartMs": 91830,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So what went wrong?"
    } ]
  }, {
    "tStartMs": 93590,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "How had her original tally"
    } ]
  }, {
    "tStartMs": 95270,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "been inflated by over 4,000 votes?"
    } ]
  }, {
    "tStartMs": 98660,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "Computer experts were brought\nin to run extensive tests"
    } ]
  }, {
    "tStartMs": 101350,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "on the software."
    } ]
  }, {
    "tStartMs": 102600,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "They combed through the\ncode, but could find no bugs."
    } ]
  }, {
    "tStartMs": 106370,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "They got the computer"
    } ]
  }, {
    "tStartMs": 107250,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "that had made the initial erroneous tally"
    } ]
  }, {
    "tStartMs": 109100,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "and tested the hardware again and again,"
    } ]
  }, {
    "tStartMs": 112120,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "but they could not replicate the error."
    } ]
  }, {
    "tStartMs": 114720,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "Everything about the hardware"
    } ]
  }, {
    "tStartMs": 115790,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "seemed to be in perfect working order."
    } ]
  }, {
    "tStartMs": 118660,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "And this left only one\npossible explanation"
    } ]
  }, {
    "tStartMs": 121410,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "and it is seriously weird."
    } ]
  }, {
    "tStartMs": 124070,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "The clue comes from the\nexcess number of votes"
    } ]
  }, {
    "tStartMs": 127050,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Vindevogel received."
    } ]
  }, {
    "tStartMs": 128440,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "4,096."
    } ]
  }, {
    "tStartMs": 131460,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Computers work using binary,\nstrings of zeros and ones,"
    } ]
  }, {
    "tStartMs": 135440,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "each corresponding to a power of two."
    } ]
  }, {
    "tStartMs": 137880,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So somewhere inside the computer\ntabulating all the votes"
    } ]
  }, {
    "tStartMs": 140820,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "was a string of bits"
    } ]
  }, {
    "tStartMs": 142080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "representing the number\nof votes Maria received."
    } ]
  }, {
    "tStartMs": 144900,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "It started the day all zeros,"
    } ]
  }, {
    "tStartMs": 146860,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "and then as each vote for her came in,"
    } ]
  }, {
    "tStartMs": 148830,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "it would increment by one."
    } ]
  }, {
    "tStartMs": 150940,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Physically, this is done by\nturning on a transistor for one"
    } ]
  }, {
    "tStartMs": 154140,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and turning it off for zero."
    } ]
  }, {
    "tStartMs": 156750,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "What's remarkable about the number 4,096"
    } ]
  }, {
    "tStartMs": 160110,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "is that it is exactly a power of two."
    } ]
  }, {
    "tStartMs": 163530,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Two to the power of 12."
    } ]
  }, {
    "tStartMs": 165550,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "That is the 13th bit."
    } ]
  }, {
    "tStartMs": 168120,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "So for Maria Vindevogel to\nreceive an extra 4,096 votes,"
    } ]
  }, {
    "tStartMs": 172730,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "only one thing needed to happen."
    } ]
  }, {
    "tStartMs": 175440,
    "dDurationMs": 4613,
    "segs": [ {
      "utf8": "The 13th bit had to flip\nfrom a zero to a one."
    } ]
  }, {
    "tStartMs": 181110,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But why would that happen?"
    } ]
  }, {
    "tStartMs": 183090,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Computers work precisely\nbecause bits don't flip"
    } ]
  }, {
    "tStartMs": 186410,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "unless we want them to, or do they?"
    } ]
  }, {
    "tStartMs": 190960,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Looking into the problem,"
    } ]
  }, {
    "tStartMs": 192260,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Belgian investigators found\nreports of similar issues"
    } ]
  }, {
    "tStartMs": 194900,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "from big computer companies\nstarting in the 1970s."
    } ]
  }, {
    "tStartMs": 199430,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "In 1978, Intel reported some\nstrange errors popping up"
    } ]
  }, {
    "tStartMs": 203610,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "in their 16 kilobit dynamic\nrandom access memory or DRAM."
    } ]
  }, {
    "tStartMs": 208040,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "Ones would spontaneously flip to zeros"
    } ]
  }, {
    "tStartMs": 210990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with no apparent cause."
    } ]
  }, {
    "tStartMs": 213390,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "The problem turned out to\nbe the ceramic packaging"
    } ]
  }, {
    "tStartMs": 216320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "the chip was encased in."
    } ]
  }, {
    "tStartMs": 218510,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "With the demand for semiconductor\npackaging skyrocketing"
    } ]
  }, {
    "tStartMs": 221240,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "in the 1970s, a new manufacturing\nplant was constructed"
    } ]
  }, {
    "tStartMs": 224730,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "on the Green River in Colorado."
    } ]
  }, {
    "tStartMs": 226950,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Unfortunately, this site\nhappened to be just downstream"
    } ]
  }, {
    "tStartMs": 230120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "of an old uranium mill."
    } ]
  }, {
    "tStartMs": 232370,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Radioactive atoms made\ntheir way into the river"
    } ]
  }, {
    "tStartMs": 235130,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "and then into the ceramic\npackaging for Intel's microchips."
    } ]
  }, {
    "tStartMs": 239480,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Intel scientists investigating the problem"
    } ]
  }, {
    "tStartMs": 241500,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "found that even trace amounts\nof uranium and thorium"
    } ]
  }, {
    "tStartMs": 244160,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "in the ceramic were\nsufficient to cause problems."
    } ]
  }, {
    "tStartMs": 247730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "In their DRAM, memory was\nstored as the presence"
    } ]
  }, {
    "tStartMs": 250400,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "or absence of electrons\nin a semiconductor well."
    } ]
  }, {
    "tStartMs": 254250,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The alpha particles emitted\nby uranium and thorium"
    } ]
  }, {
    "tStartMs": 257150,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "were energetic and ionizing enough"
    } ]
  }, {
    "tStartMs": 259150,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "to create electron hole\npairs in the silicone."
    } ]
  }, {
    "tStartMs": 262490,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "If an alpha particle is struck\nin just the right place,"
    } ]
  }, {
    "tStartMs": 265450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "it could create a large\nnumber of free charge carriers"
    } ]
  }, {
    "tStartMs": 268930,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "causing electrons to\naccumulate in the well"
    } ]
  }, {
    "tStartMs": 271940,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "flipping a one to a zero."
    } ]
  }, {
    "tStartMs": 274600,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "This is known as a single event\nupset, a type of soft error."
    } ]
  }, {
    "tStartMs": 279340,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "The error is soft because the\ndevice hasn't been damaged."
    } ]
  }, {
    "tStartMs": 282690,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "The bit has changed,"
    } ]
  }, {
    "tStartMs": 283700,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "but you could erase it and\nrewrite it with no problems."
    } ]
  }, {
    "tStartMs": 287460,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "Investigators exposed the\nchips to alpha emitters"
    } ]
  }, {
    "tStartMs": 290210,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "with different levels of activity."
    } ]
  }, {
    "tStartMs": 292150,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "And just as you'd expect,"
    } ]
  }, {
    "tStartMs": 293250,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "they found the number of bit\nflips directly correlated"
    } ]
  }, {
    "tStartMs": 295950,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "with the number of alpha particles"
    } ]
  }, {
    "tStartMs": 297280,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "the chip had been exposed to."
    } ]
  }, {
    "tStartMs": 299430,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The reason this problem\nwas identified in the 1970s"
    } ]
  }, {
    "tStartMs": 302550,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "was because chip components\nhad been miniaturized"
    } ]
  }, {
    "tStartMs": 304830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to the point where a single alpha particle"
    } ]
  }, {
    "tStartMs": 307500,
    "dDurationMs": 2263,
    "segs": [ {
      "utf8": "could produce enough charge to flip a bit."
    } ]
  }, {
    "tStartMs": 310860,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Immediately, these findings\nattracted a lot of attention."
    } ]
  }, {
    "tStartMs": 314140,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "Before the paper was published,"
    } ]
  }, {
    "tStartMs": 315650,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "it was widely circulated in the industry."
    } ]
  }, {
    "tStartMs": 318280,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "And as a result, chip manufacturers"
    } ]
  }, {
    "tStartMs": 320690,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "were a lot more careful to\navoid radioactive materials"
    } ]
  }, {
    "tStartMs": 323470,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "when producing their\nmicrochips and packaging."
    } ]
  }, {
    "tStartMs": 326300,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "Therefore, the bit flip\nthat gave Maria Vindevogel"
    } ]
  }, {
    "tStartMs": 328533,
    "dDurationMs": 2847,
    "segs": [ {
      "utf8": "4,096 extra votes"
    } ]
  }, {
    "tStartMs": 331380,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "wasn't caused by natural\nradioactivity in the computer."
    } ]
  }, {
    "tStartMs": 335490,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "So where did it come from?"
    } ]
  }, {
    "tStartMs": 338200,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "After Henri Becquerel\ndiscovered radioactivity"
    } ]
  }, {
    "tStartMs": 340750,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "with uranium in 1896,"
    } ]
  }, {
    "tStartMs": 342960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "scientists sought a way to measure it."
    } ]
  }, {
    "tStartMs": 345280,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "How radioactive were different materials?"
    } ]
  }, {
    "tStartMs": 348230,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "And one way to do this is\nwith a gold leaf electrometer."
    } ]
  }, {
    "tStartMs": 351660,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "When it's charged, the leaf is repelled"
    } ]
  }, {
    "tStartMs": 354350,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and you can measure the amount of charge"
    } ]
  }, {
    "tStartMs": 356210,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "by the angle of the leaf."
    } ]
  }, {
    "tStartMs": 358360,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Now, if ionizing radiation\nenters the chamber,"
    } ]
  }, {
    "tStartMs": 361440,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "it rips electrons off air molecules,"
    } ]
  }, {
    "tStartMs": 363790,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "creating positive and negative charges."
    } ]
  }, {
    "tStartMs": 366680,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Opposite charges are\nattracted to the leaf,"
    } ]
  }, {
    "tStartMs": 369110,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "discharging it over time."
    } ]
  }, {
    "tStartMs": 371440,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "The higher the level\nof ionizing radiation,"
    } ]
  }, {
    "tStartMs": 373730,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "the faster the device discharges."
    } ]
  }, {
    "tStartMs": 376630,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "In 1910, Theodore Wolf\ntook his electrometer"
    } ]
  }, {
    "tStartMs": 379780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to the top of the Eiffel Tower."
    } ]
  }, {
    "tStartMs": 381730,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Since radioactivity was found in the soil"
    } ]
  }, {
    "tStartMs": 383910,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and rocks of earth, he\nexpected that 300 meters up,"
    } ]
  }, {
    "tStartMs": 387300,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "the radiation would be just a few percent"
    } ]
  }, {
    "tStartMs": 389740,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "of the ground radiation."
    } ]
  }, {
    "tStartMs": 391480,
    "dDurationMs": 3443,
    "segs": [ {
      "utf8": "Instead he found only a slight decrease."
    } ]
  }, {
    "tStartMs": 395820,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "In 1911, Austrian physicist Victor Hess"
    } ]
  }, {
    "tStartMs": 398670,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "decided to take this experiment further."
    } ]
  }, {
    "tStartMs": 401060,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "Literally."
    } ]
  }, {
    "tStartMs": 402040,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "He loaded electric scopes into the basket"
    } ]
  }, {
    "tStartMs": 404370,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of a hydrogen balloon."
    } ]
  }, {
    "tStartMs": 406200,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "In his first two flights,"
    } ]
  }, {
    "tStartMs": 407370,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "he observed the same thing as Wolf."
    } ]
  }, {
    "tStartMs": 409630,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Up to an altitude of 1100 meters,"
    } ]
  }, {
    "tStartMs": 412200,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "both trips revealed no\nfundamental change in radiation"
    } ]
  }, {
    "tStartMs": 415640,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "compared to the values\nobserved on the ground."
    } ]
  }, {
    "tStartMs": 418530,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "But the next year, he\nconducted seven balloon flights"
    } ]
  }, {
    "tStartMs": 421550,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "up to an altitude of 5,200 meters."
    } ]
  }, {
    "tStartMs": 424830,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "And here he discovered\nsomething remarkable."
    } ]
  }, {
    "tStartMs": 428410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "While there was an\ninitial drop in radiation"
    } ]
  }, {
    "tStartMs": 430900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for the first several hundred meters,"
    } ]
  }, {
    "tStartMs": 433060,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "above one kilometer or\nso the level increased"
    } ]
  }, {
    "tStartMs": 436550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "with increasing altitude."
    } ]
  }, {
    "tStartMs": 438920,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "At his maximum height,"
    } ]
  }, {
    "tStartMs": 440560,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "the level of radiation\nwas several times greater"
    } ]
  }, {
    "tStartMs": 443850,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "than it was on the ground."
    } ]
  }, {
    "tStartMs": 446110,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The radiation appeared to be\ncoming, not from the earth,"
    } ]
  }, {
    "tStartMs": 450350,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "but from the sky."
    } ]
  }, {
    "tStartMs": 452910,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Hess scheduled one of his balloon flights"
    } ]
  }, {
    "tStartMs": 454900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "during a solar eclipse."
    } ]
  }, {
    "tStartMs": 456820,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "And as the moon passed\nin front of the sun,"
    } ]
  }, {
    "tStartMs": 458970,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "he carefully watched his instruments."
    } ]
  }, {
    "tStartMs": 461740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But the readings were unaffected."
    } ]
  }, {
    "tStartMs": 464080,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Even with the sun half covered,"
    } ]
  }, {
    "tStartMs": 466130,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "the level of radiation was the same."
    } ]
  }, {
    "tStartMs": 469060,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Since no influence of the eclipse"
    } ]
  }, {
    "tStartMs": 471140,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "on the penetrating radiation was noted,"
    } ]
  }, {
    "tStartMs": 473250,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "we conclude that even if\na part of the radiation"
    } ]
  }, {
    "tStartMs": 475700,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "should be of cosmic origin, it\nhardly emanates from the sun."
    } ]
  }, {
    "tStartMs": 479810,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "Victor Hess had discovered cosmic rays."
    } ]
  }, {
    "tStartMs": 482880,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "High energy radiation from space."
    } ]
  }, {
    "tStartMs": 486460,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "But what were these rays exactly"
    } ]
  }, {
    "tStartMs": 488280,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and where were they coming from?"
    } ]
  }, {
    "tStartMs": 490860,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "Well, today we know they\naren't electromagnetic rays"
    } ]
  }, {
    "tStartMs": 493750,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "as many suspected, but particles."
    } ]
  }, {
    "tStartMs": 496240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Around 90% are protons,"
    } ]
  }, {
    "tStartMs": 498850,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "9% are helium nuclei, and\n1% are heavier nuclei."
    } ]
  }, {
    "tStartMs": 503750,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Some of them are from the sun,"
    } ]
  }, {
    "tStartMs": 505870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but they have comparatively low energy."
    } ]
  }, {
    "tStartMs": 508630,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "High energy cosmic rays moving very close"
    } ]
  }, {
    "tStartMs": 511220,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "to the speed of light come\nfrom exploding stars, supernova"
    } ]
  }, {
    "tStartMs": 516130,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "in our own galaxy and in others."
    } ]
  }, {
    "tStartMs": 519750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And the highest energy particles"
    } ]
  }, {
    "tStartMs": 521400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "are thought to come from black holes,"
    } ]
  }, {
    "tStartMs": 523500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "including the super massive black holes"
    } ]
  }, {
    "tStartMs": 525540,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "at the centers of galaxies."
    } ]
  }, {
    "tStartMs": 527730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But it's hard to pin down"
    } ]
  }, {
    "tStartMs": 529560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "exactly where cosmic rays come from"
    } ]
  }, {
    "tStartMs": 531480,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "because as charged particles,"
    } ]
  }, {
    "tStartMs": 533410,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "they're deflected by\nmagnetic fields in space."
    } ]
  }, {
    "tStartMs": 536250,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "So they can wind their\nway through the universe"
    } ]
  }, {
    "tStartMs": 538840,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "for billions of years."
    } ]
  }, {
    "tStartMs": 541340,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "A cosmic ray detected\non October 15th, 1991"
    } ]
  }, {
    "tStartMs": 545310,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "had an energy of 51 joules."
    } ]
  }, {
    "tStartMs": 548440,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "That is a single subatomic particle"
    } ]
  }, {
    "tStartMs": 550830,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "with the energy of a baseball"
    } ]
  }, {
    "tStartMs": 553160,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "going a hundred kilometers per hour."
    } ]
  }, {
    "tStartMs": 555870,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "For obvious reasons, it was\ndubbed the OMG particle."
    } ]
  }, {
    "tStartMs": 560120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But primary cosmic rays like these"
    } ]
  }, {
    "tStartMs": 562010,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "don't make it down to earth's surface."
    } ]
  }, {
    "tStartMs": 564230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Instead, they collide with air molecules"
    } ]
  }, {
    "tStartMs": 566270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "around 25 kilometers above the ground"
    } ]
  }, {
    "tStartMs": 568550,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "and create new particles like pions."
    } ]
  }, {
    "tStartMs": 571620,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "These collide and decay into\nother particles like neutrons,"
    } ]
  }, {
    "tStartMs": 575420,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "protons, muons, electrons,\npositrons and photons,"
    } ]
  }, {
    "tStartMs": 580450,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "which in turn collide\nwith other air molecules"
    } ]
  }, {
    "tStartMs": 582820,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "in one long cascade."
    } ]
  }, {
    "tStartMs": 585300,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So from a single primary cosmic ray,"
    } ]
  }, {
    "tStartMs": 588330,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "comes a shower of particles\nstreaming towards the earth."
    } ]
  }, {
    "tStartMs": 592620,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "It is one of these\nparticles that investigators"
    } ]
  }, {
    "tStartMs": 595010,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "suspect struck a transistor\nin a computer in Belgium,"
    } ]
  }, {
    "tStartMs": 598570,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "flipping the 13th bit from a zero to a one"
    } ]
  }, {
    "tStartMs": 601820,
    "dDurationMs": 4943,
    "segs": [ {
      "utf8": "and giving Maria Vindevogel\n4,096 extra votes."
    } ]
  }, {
    "tStartMs": 607770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But how often do things like this happen?"
    } ]
  }, {
    "tStartMs": 610800,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "In 1911, Charles Wilson made it possible"
    } ]
  }, {
    "tStartMs": 613590,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to see the cosmic rays all around us"
    } ]
  }, {
    "tStartMs": 615910,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "when he perfected his cloud chamber,"
    } ]
  }, {
    "tStartMs": 618270,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "an enclosure with super\nsaturated water or alcohol vapor."
    } ]
  }, {
    "tStartMs": 622310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "When a cosmic ray passes\nthrough the chamber,"
    } ]
  }, {
    "tStartMs": 624500,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it ionizes the gas\ncausing vapor to condense"
    } ]
  }, {
    "tStartMs": 627560,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "into tiny droplets on the ions,"
    } ]
  }, {
    "tStartMs": 629620,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "revealing the path of the particle."
    } ]
  }, {
    "tStartMs": 632100,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Alpha particles, helium nuclei,"
    } ]
  }, {
    "tStartMs": 634320,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "leave short thick tracks\nwhile beta particles,"
    } ]
  }, {
    "tStartMs": 637400,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "electrons leave long skinny trails."
    } ]
  }, {
    "tStartMs": 640510,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "In 1932, Carl Anderson identified a trail"
    } ]
  }, {
    "tStartMs": 643830,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "that looked like it was\nmade by an electron,"
    } ]
  }, {
    "tStartMs": 646450,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "but in the applied magnetic field,"
    } ]
  }, {
    "tStartMs": 648200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "it curved in the wrong direction."
    } ]
  }, {
    "tStartMs": 650500,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Implying it had a positive charge."
    } ]
  }, {
    "tStartMs": 653280,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "Anderson had found the\nanti electron or positron."
    } ]
  }, {
    "tStartMs": 657730,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "It was the first confirmed\nsighting of anti-matter."
    } ]
  }, {
    "tStartMs": 661260,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Four years later, also\nusing a cloud chamber,"
    } ]
  }, {
    "tStartMs": 663850,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "he discovered the muon,\nagain in cosmic rays."
    } ]
  }, {
    "tStartMs": 667810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "For his discovery of the positron,"
    } ]
  }, {
    "tStartMs": 669760,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Anderson was awarded the Nobel\nPrize in Physics in 1936."
    } ]
  }, {
    "tStartMs": 674040,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "He shared the prize with Victor Hess,"
    } ]
  }, {
    "tStartMs": 676780,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the man who discovered cosmic\nrays in the first place,"
    } ]
  }, {
    "tStartMs": 680140,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "invisible particles that\naffect our lives in ways"
    } ]
  }, {
    "tStartMs": 683030,
    "dDurationMs": 2113,
    "segs": [ {
      "utf8": "most of us are oblivious to."
    } ]
  }, {
    "tStartMs": 686480,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "This is possibly the rarest thing"
    } ]
  }, {
    "tStartMs": 689140,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "to ever happen in a video game."
    } ]
  }, {
    "tStartMs": 692060,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "In 2013, user DOTA_Teabag was\nspeed running Super Mario 64"
    } ]
  }, {
    "tStartMs": 696930,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "on the console."
    } ]
  }, {
    "tStartMs": 698220,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "In the level Tik Tok Clock,"
    } ]
  }, {
    "tStartMs": 699860,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "he suddenly up warps\nonto a higher platform."
    } ]
  }, {
    "tStartMs": 703250,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "- [DOTA_Teabag] What the?"
    } ]
  }, {
    "tStartMs": 704580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Player] Did you get invisible wall?"
    } ]
  }, {
    "tStartMs": 705413,
    "dDurationMs": 1757,
    "segs": [ {
      "utf8": "What?\n- Please say you got the---"
    } ]
  }, {
    "tStartMs": 707170,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [DOTA_Teabag] No, that\nwas the craziest thing"
    } ]
  }, {
    "tStartMs": 708430,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "I've ever seen though."
    } ]
  }, {
    "tStartMs": 709810,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "- [Narrator] The move\nshaves off a few seconds"
    } ]
  }, {
    "tStartMs": 712080,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "and it seems like a newly\ndiscovered glitch in the game"
    } ]
  }, {
    "tStartMs": 715150,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "that could give speed runners and edge."
    } ]
  }, {
    "tStartMs": 717540,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "User PenandCook12 put out a $1,000 bounty"
    } ]
  }, {
    "tStartMs": 720980,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "for anyone who could\nreplicate the up warp."
    } ]
  }, {
    "tStartMs": 723510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But so far, after six years,"
    } ]
  }, {
    "tStartMs": 725970,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "no one has been able to."
    } ]
  }, {
    "tStartMs": 728340,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "The best explanation\nanyone can come up with"
    } ]
  }, {
    "tStartMs": 730730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "is that a cosmic ray caused the glitch."
    } ]
  }, {
    "tStartMs": 733610,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "It's been shown that a single bit flipped"
    } ]
  }, {
    "tStartMs": 735430,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "in the first bite of\nMario's height co-ordinate"
    } ]
  }, {
    "tStartMs": 738350,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "could have caused the effect."
    } ]
  }, {
    "tStartMs": 740180,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "On the main level, the\nbite was 1 1 0 0 0 1 0 1."
    } ]
  }, {
    "tStartMs": 744430,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "But if you flip the last one to a zero,"
    } ]
  }, {
    "tStartMs": 747160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "it changes his vertical position."
    } ]
  }, {
    "tStartMs": 749500,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "And just by chance,"
    } ]
  }, {
    "tStartMs": 750810,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "this new height coincides\nwith the higher floor."
    } ]
  }, {
    "tStartMs": 754630,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "PenandCook12 wrote a script\nto manually flip the bit"
    } ]
  }, {
    "tStartMs": 757930,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "at the right moment\nand was able to achieve"
    } ]
  }, {
    "tStartMs": 760420,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "the same up warp."
    } ]
  }, {
    "tStartMs": 762610,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "This is a particularly visible bit flip,"
    } ]
  }, {
    "tStartMs": 765210,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "but the truth is cosmic rays\nare triggering bit flips"
    } ]
  }, {
    "tStartMs": 768130,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "all the time."
    } ]
  }, {
    "tStartMs": 769300,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "- An upset there, transient\nthere can alter the function"
    } ]
  }, {
    "tStartMs": 772710,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "of these devices and we\ncall that a single event"
    } ]
  }, {
    "tStartMs": 775040,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "functional interrupt."
    } ]
  }, {
    "tStartMs": 776120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So an entire process can hang."
    } ]
  }, {
    "tStartMs": 777880,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So a blue screen of death that you get"
    } ]
  }, {
    "tStartMs": 780010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "might actually have been\na neutron or whatnot."
    } ]
  }, {
    "tStartMs": 782650,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Derek] When people see\nthe blue screen of death,"
    } ]
  }, {
    "tStartMs": 784360,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "could that be caused by a cosmic ray?"
    } ]
  }, {
    "tStartMs": 786010,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- Absolutely."
    } ]
  }, {
    "tStartMs": 787230,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- These days, there are a number of ways"
    } ]
  }, {
    "tStartMs": 789230,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "computer chips are made resilient\nin the face of bit flips"
    } ]
  }, {
    "tStartMs": 792550,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "like error correction code or ECC memory."
    } ]
  }, {
    "tStartMs": 796080,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "But you can't totally prevent\nbit flips from happening."
    } ]
  }, {
    "tStartMs": 799670,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "In 1996, IBM estimated that\nfor each 256 megabytes of RAM,"
    } ]
  }, {
    "tStartMs": 804860,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "one bit flip occurs per month."
    } ]
  }, {
    "tStartMs": 807090,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And the main culprit seems to be neutrons"
    } ]
  }, {
    "tStartMs": 809410,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "created in the shower of\nparticles from cosmic rays."
    } ]
  }, {
    "tStartMs": 812880,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Starting in 2009,"
    } ]
  }, {
    "tStartMs": 814550,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Toyota recalled millions of vehicles"
    } ]
  }, {
    "tStartMs": 817320,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "due to the problem of\nunintended acceleration."
    } ]
  }, {
    "tStartMs": 820470,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "- We were in the fast\nlane driving at about 70,"
    } ]
  }, {
    "tStartMs": 823340,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "and he said that the car\nwas continuing to accelerate"
    } ]
  }, {
    "tStartMs": 826470,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "and he couldn't bring it to a stop."
    } ]
  }, {
    "tStartMs": 828260,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "- Many speculated that\ncosmic ray induced bit flips"
    } ]
  }, {
    "tStartMs": 831240,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "in the electronic control\nsystem were the cause."
    } ]
  }, {
    "tStartMs": 834130,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So much so that NASA was called in"
    } ]
  }, {
    "tStartMs": 836290,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "to help with the investigation."
    } ]
  }, {
    "tStartMs": 838220,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "But it turns out, cosmic rays\nwere probably not the culprit."
    } ]
  }, {
    "tStartMs": 842500,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "NASA identified as the main causes,"
    } ]
  }, {
    "tStartMs": 845030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "sticky accelerator pedals,"
    } ]
  }, {
    "tStartMs": 846800,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "poorly fitted floor\nmats and most commonly,"
    } ]
  }, {
    "tStartMs": 850290,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "drivers pushing on the accelerator"
    } ]
  }, {
    "tStartMs": 852680,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "thinking it was the brake."
    } ]
  }, {
    "tStartMs": 854950,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "But cosmic rays have caused\ncrashes of supercomputers,"
    } ]
  }, {
    "tStartMs": 859380,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "especially at higher elevations."
    } ]
  }, {
    "tStartMs": 861860,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "Los Alamos National Labs located\n2200 meters above sea level"
    } ]
  }, {
    "tStartMs": 866090,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "is constantly dealing with neutron induced"
    } ]
  }, {
    "tStartMs": 868610,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "supercomputer crashes."
    } ]
  }, {
    "tStartMs": 870210,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "So the software auto saves\nfrequently and neutron detectors"
    } ]
  }, {
    "tStartMs": 873820,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "have been installed\nthroughout the facility."
    } ]
  }, {
    "tStartMs": 876910,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "If you go even higher,"
    } ]
  }, {
    "tStartMs": 878250,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "like climbing up to cruising\naltitude in a plane,"
    } ]
  }, {
    "tStartMs": 881140,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "you can see the radiation\nfrom cosmic rays increasing"
    } ]
  }, {
    "tStartMs": 884070,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "on a Geiger counter."
    } ]
  }, {
    "tStartMs": 885110,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "To .5 microsieverts per\nhour at 18,000 feet."
    } ]
  }, {
    "tStartMs": 888610,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Up to one microsieverts\nper hour at 23,000 feet."
    } ]
  }, {
    "tStartMs": 891580,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Over two microsieverts\nper hour at 33,000 feet."
    } ]
  }, {
    "tStartMs": 894660,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "And over three microsieverts per hour"
    } ]
  }, {
    "tStartMs": 896440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at even higher altitudes\nand towards the poles."
    } ]
  }, {
    "tStartMs": 899410,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "At cruising altitude,"
    } ]
  }, {
    "tStartMs": 900600,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "this increases the chance\nof a single event upset"
    } ]
  }, {
    "tStartMs": 903080,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "by 10 to 30 times."
    } ]
  }, {
    "tStartMs": 905610,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "This isn't critical if it\nhappens in your laptop,"
    } ]
  }, {
    "tStartMs": 908270,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "but what if it occurs\nin the flight computer?"
    } ]
  }, {
    "tStartMs": 912130,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "On October 7th, 2008,"
    } ]
  }, {
    "tStartMs": 914160,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "an Airbus A330 took off\nfrom Singapore to Perth."
    } ]
  }, {
    "tStartMs": 918010,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Just over three hours into the flight,"
    } ]
  }, {
    "tStartMs": 919910,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "the plane suddenly pitched down"
    } ]
  }, {
    "tStartMs": 922170,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "diving 200 meters in 20 seconds."
    } ]
  }, {
    "tStartMs": 925340,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "Inside the plane, everyone\nexperienced negative 0.8 Gs"
    } ]
  }, {
    "tStartMs": 929730,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of acceleration."
    } ]
  }, {
    "tStartMs": 931140,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "It would have felt like\nthe plane had flipped over."
    } ]
  }, {
    "tStartMs": 934000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- The G-Force was enough,"
    } ]
  }, {
    "tStartMs": 936040,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "even with our three point harness"
    } ]
  }, {
    "tStartMs": 938610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to lift us both out of the seat"
    } ]
  }, {
    "tStartMs": 941080,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and push us forward as well."
    } ]
  }, {
    "tStartMs": 943330,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "- Minutes later, the plane\ndropped another 120 meters."
    } ]
  }, {
    "tStartMs": 948090,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "119 people on board were injured,"
    } ]
  }, {
    "tStartMs": 950590,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "many from bumping their\nheads into the ceiling."
    } ]
  }, {
    "tStartMs": 953390,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "So the pilots decided to\nmake an emergency landing"
    } ]
  }, {
    "tStartMs": 956040,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "in Learmonth."
    } ]
  }, {
    "tStartMs": 957660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "In the investigation that\nfollowed, the fault seem to occur"
    } ]
  }, {
    "tStartMs": 960740,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "with the first air data\ninertial reference unit,"
    } ]
  }, {
    "tStartMs": 963360,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "or ADIRU for short."
    } ]
  }, {
    "tStartMs": 965480,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "This computer supplies\ncritical data like airspeed,"
    } ]
  }, {
    "tStartMs": 968670,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "angle of attack and altitude."
    } ]
  }, {
    "tStartMs": 970920,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The way it supplies each of\nthese pieces of information"
    } ]
  }, {
    "tStartMs": 973710,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "is in a 32 bit binary word."
    } ]
  }, {
    "tStartMs": 976970,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The first eight bits identify\nthe type of information"
    } ]
  }, {
    "tStartMs": 980180,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "and bits 11 to 29 encode the actual data."
    } ]
  }, {
    "tStartMs": 984410,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "What seems to have happened"
    } ]
  }, {
    "tStartMs": 986010,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "is that a bit flip in the first eight bits"
    } ]
  }, {
    "tStartMs": 988880,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "meant altitude information was mislabeled"
    } ]
  }, {
    "tStartMs": 991430,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "as angle of attack information."
    } ]
  }, {
    "tStartMs": 994090,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Inside the cockpit, alarms went on"
    } ]
  }, {
    "tStartMs": 996160,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "for over speed and stall simultaneously,"
    } ]
  }, {
    "tStartMs": 999190,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "something that should be impossible."
    } ]
  }, {
    "tStartMs": 1001630,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "But the plane nose down sharply\nto correct what it thought"
    } ]
  }, {
    "tStartMs": 1004850,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "was a stall, throwing passengers\nand crew into the ceiling."
    } ]
  }, {
    "tStartMs": 1009640,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Investigators looked into software bugs,"
    } ]
  }, {
    "tStartMs": 1012230,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "software corruption, a hardware fail,"
    } ]
  }, {
    "tStartMs": 1014920,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "physical environment factors"
    } ]
  }, {
    "tStartMs": 1017090,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "and electromagnetic interference."
    } ]
  }, {
    "tStartMs": 1019540,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "But each of these possibilities\nwas found to be unlikely"
    } ]
  }, {
    "tStartMs": 1022890,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "based on multiple sources of evidence."
    } ]
  }, {
    "tStartMs": 1025540,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The other potential triggering event"
    } ]
  }, {
    "tStartMs": 1027640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "was a single event effect"
    } ]
  }, {
    "tStartMs": 1029240,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "resulting from a high\nenergy atmospheric particle"
    } ]
  }, {
    "tStartMs": 1032140,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "striking one of the integrated circuits"
    } ]
  }, {
    "tStartMs": 1034040,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "within the CPU module."
    } ]
  }, {
    "tStartMs": 1036000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "One of the challenges\nwith single event upsets"
    } ]
  }, {
    "tStartMs": 1038180,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "is that they are soft errors."
    } ]
  }, {
    "tStartMs": 1039760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "They don't leave a trace,"
    } ]
  }, {
    "tStartMs": 1041640,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "but interestingly, the\nAirbus A330 was built in 1992"
    } ]
  }, {
    "tStartMs": 1046070,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "when there were no specific regulatory"
    } ]
  }, {
    "tStartMs": 1048190,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "or aircraft manufacturer requirements"
    } ]
  }, {
    "tStartMs": 1050370,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for airborne systems to be resilient"
    } ]
  }, {
    "tStartMs": 1052620,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to single event effects."
    } ]
  }, {
    "tStartMs": 1054600,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "With the space shuttle,"
    } ]
  }, {
    "tStartMs": 1055910,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "redundancy was built in from the start."
    } ]
  }, {
    "tStartMs": 1058430,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "For navigation and control,\nthere were four computers"
    } ]
  }, {
    "tStartMs": 1061520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "simultaneously running identical software."
    } ]
  }, {
    "tStartMs": 1064640,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "If one computer had a soft error,"
    } ]
  }, {
    "tStartMs": 1066630,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "the other three would overrule it."
    } ]
  }, {
    "tStartMs": 1069370,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "And using this setup,"
    } ]
  }, {
    "tStartMs": 1070310,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "they could also track the\nfrequency of bit flips."
    } ]
  }, {
    "tStartMs": 1073400,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "On one five day mission, STS 48,"
    } ]
  }, {
    "tStartMs": 1076260,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "there were 161"
    } ]
  }, {
    "tStartMs": 1078680,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "separate bit flips."
    } ]
  }, {
    "tStartMs": 1081700,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "Above the atmosphere,\ncosmic rays are so energetic"
    } ]
  }, {
    "tStartMs": 1085550,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "sometimes you can even see them."
    } ]
  }, {
    "tStartMs": 1088070,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- Once in a while you\nhave your eyes closed"
    } ]
  }, {
    "tStartMs": 1090070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and you're not asleep yet."
    } ]
  }, {
    "tStartMs": 1091450,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "And if you wait a little while,"
    } ]
  }, {
    "tStartMs": 1095370,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "you occasionally will\nsee a flash of light."
    } ]
  }, {
    "tStartMs": 1098690,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "And we think it is heavy particles"
    } ]
  }, {
    "tStartMs": 1101040,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "or individual bursts of\nenergy coming from radiation"
    } ]
  }, {
    "tStartMs": 1104800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that are either going\nthrough the eyeball itself"
    } ]
  }, {
    "tStartMs": 1107020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "or going through the optic nerve."
    } ]
  }, {
    "tStartMs": 1109150,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And they,"
    } ]
  }, {
    "tStartMs": 1111220,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "the way that your body registers\nradiation going through it"
    } ]
  }, {
    "tStartMs": 1115330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "is amazingly enough by\nshowing you a little flash"
    } ]
  }, {
    "tStartMs": 1118000,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "in one of your eyes,"
    } ]
  }, {
    "tStartMs": 1119160,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "just to remind you that you\nare subject to the radiation"
    } ]
  }, {
    "tStartMs": 1122130,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "of not only our sun, but\nevery star of the universe,"
    } ]
  }, {
    "tStartMs": 1126010,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that is radiating at you."
    } ]
  }, {
    "tStartMs": 1128950,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I picture back to the first astronauts"
    } ]
  }, {
    "tStartMs": 1130870,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "who must have closed their\neyes and seen that radiation"
    } ]
  }, {
    "tStartMs": 1133350,
    "dDurationMs": 2717,
    "segs": [ {
      "utf8": "and gone, \"I'm not going\nto tell anybody about this"
    } ]
  }, {
    "tStartMs": 1136067,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "\"because no one's told me about it."
    } ]
  }, {
    "tStartMs": 1137807,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "\"I'm not talking.\""
    } ]
  }, {
    "tStartMs": 1138640,
    "dDurationMs": 1997,
    "segs": [ {
      "utf8": "I can just imagine the\nfirst two guys that said,"
    } ]
  }, {
    "tStartMs": 1140637,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "\"Hey, I am,"
    } ]
  }, {
    "tStartMs": 1141807,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "\"sometimes I see flashes of light."
    } ]
  }, {
    "tStartMs": 1143217,
    "dDurationMs": 1253,
    "segs": [ {
      "utf8": "\"Do you see flashes of light?\""
    } ]
  }, {
    "tStartMs": 1144470,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "And then it's, \"Oh, we\nall see flashes of light.\""
    } ]
  }, {
    "tStartMs": 1146417,
    "dDurationMs": 2245,
    "segs": [ {
      "utf8": "\"Oh, okay, well, that's all right then.\""
    } ]
  }, {
    "tStartMs": 1148662,
    "dDurationMs": 1318,
    "segs": [ {
      "utf8": "(narrator laughing)"
    } ]
  }, {
    "tStartMs": 1149980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Narrator] For missions\nto other planets,"
    } ]
  }, {
    "tStartMs": 1152260,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "protecting electronics is critical."
    } ]
  }, {
    "tStartMs": 1154890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- If a single bit of information"
    } ]
  }, {
    "tStartMs": 1156540,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "controls a critical\nfunction on your spacecraft,"
    } ]
  }, {
    "tStartMs": 1159150,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "let's say your thrusters,"
    } ]
  }, {
    "tStartMs": 1161100,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "and that goes from a one to\nis zero, from a on to off,"
    } ]
  }, {
    "tStartMs": 1164680,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "or vice versa, you could lose the mission."
    } ]
  }, {
    "tStartMs": 1167210,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "- [Narrator] That's why the computer"
    } ]
  }, {
    "tStartMs": 1168400,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "on the Perseverance Rover\nthat just landed on Mars"
    } ]
  }, {
    "tStartMs": 1171210,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is 20 years old."
    } ]
  }, {
    "tStartMs": 1173280,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It's a power PC launched in 2001"
    } ]
  }, {
    "tStartMs": 1175840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "with only 256 megabytes of Ram"
    } ]
  }, {
    "tStartMs": 1178800,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and two gigabytes of flash storage."
    } ]
  }, {
    "tStartMs": 1181770,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "But it is radiation hardened,"
    } ]
  }, {
    "tStartMs": 1183920,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "meaning the design, materials,\ncircuits and software"
    } ]
  }, {
    "tStartMs": 1187410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "are built to withstand\n40 times the radiation"
    } ]
  }, {
    "tStartMs": 1190500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of an ordinary computer."
    } ]
  }, {
    "tStartMs": 1192300,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "It's been used on over\na dozen space missions"
    } ]
  }, {
    "tStartMs": 1194960,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "going back to 2005."
    } ]
  }, {
    "tStartMs": 1197260,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "- In fact, when we first started\ndoing the power PC testing"
    } ]
  }, {
    "tStartMs": 1201170,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "years ago, the way we did it,"
    } ]
  }, {
    "tStartMs": 1203680,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "we just simply stuck an\noperating system processor"
    } ]
  }, {
    "tStartMs": 1206710,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "in a beam line where we\ngenerate these particles"
    } ]
  }, {
    "tStartMs": 1210860,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "on the planet and look\nfor blue screens of death."
    } ]
  }, {
    "tStartMs": 1214070,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "You can kind of figure\nout what's going wrong"
    } ]
  }, {
    "tStartMs": 1216190,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "and try to undo that."
    } ]
  }, {
    "tStartMs": 1217360,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "So you don't get to the\nblue screen of death"
    } ]
  }, {
    "tStartMs": 1219330,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "because a spacecraft\nthat gets into that mode"
    } ]
  }, {
    "tStartMs": 1222420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is basically unrecoverable."
    } ]
  }, {
    "tStartMs": 1224460,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "- As the Voyager 1 spacecraft\ndeparted the solar system,"
    } ]
  }, {
    "tStartMs": 1227810,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "one of the ways we could\ntell was by an increase"
    } ]
  }, {
    "tStartMs": 1230480,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "in the flux of cosmic rays it experienced."
    } ]
  }, {
    "tStartMs": 1233300,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Although on earth, the\nparticles streaming from the sun"
    } ]
  }, {
    "tStartMs": 1235640,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "and the solar wind are\na source of radiation,"
    } ]
  }, {
    "tStartMs": 1238350,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "further out these same particles\nmaintain protective bubble."
    } ]
  }, {
    "tStartMs": 1243040,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "The heliosphere."
    } ]
  }, {
    "tStartMs": 1244770,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "It helps deflect and slow cosmic rays"
    } ]
  }, {
    "tStartMs": 1247280,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "from interstellar space"
    } ]
  }, {
    "tStartMs": 1248910,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "protecting the solar system\nfrom ionizing radiation."
    } ]
  }, {
    "tStartMs": 1252600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But the sun has an 11 year activity cycle."
    } ]
  }, {
    "tStartMs": 1255660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So this protection fluctuates."
    } ]
  }, {
    "tStartMs": 1258300,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "The flux of cosmic rays\non earth is much lower"
    } ]
  }, {
    "tStartMs": 1260930,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "when the sun is active\nthan when it's dormant."
    } ]
  }, {
    "tStartMs": 1265290,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "In the history of our planet,"
    } ]
  }, {
    "tStartMs": 1266990,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "cosmic rays may have\nplayed an even larger role"
    } ]
  }, {
    "tStartMs": 1270610,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "flipping bits, not in electronics,"
    } ]
  }, {
    "tStartMs": 1273260,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "but in the genetic codes\nof living organisms,"
    } ]
  }, {
    "tStartMs": 1276400,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "providing some of the variation"
    } ]
  }, {
    "tStartMs": 1277980,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "on which natural selection acts."
    } ]
  }, {
    "tStartMs": 1280960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Maria Vindevogel is now a member"
    } ]
  }, {
    "tStartMs": 1283540,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "of the Belgium Chamber of Representatives,"
    } ]
  }, {
    "tStartMs": 1286160,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "elected by people, not a particle,"
    } ]
  }, {
    "tStartMs": 1289720,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "but her story is a reminder\nof the zillions of particles"
    } ]
  }, {
    "tStartMs": 1293420,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "winding their way through the universe"
    } ]
  }, {
    "tStartMs": 1295140,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "for millions or billions of years."
    } ]
  }, {
    "tStartMs": 1298880,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "One of which might at any moment,"
    } ]
  }, {
    "tStartMs": 1301720,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "change your life by passing\nthrough a tiny transistor"
    } ]
  }, {
    "tStartMs": 1306320,
    "dDurationMs": 1315,
    "segs": [ {
      "utf8": "and cra...."
    } ]
  }, {
    "tStartMs": 1307635,
    "dDurationMs": 3417,
    "segs": [ {
      "utf8": "(electronic disturbance)"
    } ]
  }, {
    "tStartMs": 1314210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Discovering the origin of cosmic rays"
    } ]
  }, {
    "tStartMs": 1316490,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "or where 4,096 extra votes came from"
    } ]
  }, {
    "tStartMs": 1319730,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "or how to protect the\nMars Rover from radiation"
    } ]
  }, {
    "tStartMs": 1322280,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "requires problem solving,\nwhich is a perishable skill."
    } ]
  }, {
    "tStartMs": 1325660,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And the best way to keep your\nproblem solving skills sharp"
    } ]
  }, {
    "tStartMs": 1327940,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "is to solve a diverse range of problems,"
    } ]
  }, {
    "tStartMs": 1330980,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "which you can do with the\nsponsor of this video, Brilliant."
    } ]
  }, {
    "tStartMs": 1334360,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Brilliant is a website and app"
    } ]
  }, {
    "tStartMs": 1336090,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "that teaches you STEM concepts\nin an interactive way."
    } ]
  }, {
    "tStartMs": 1339830,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "They have courses on topics\nfrom applied computer science"
    } ]
  }, {
    "tStartMs": 1342360,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "to special relativity."
    } ]
  }, {
    "tStartMs": 1344060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Two courses I would recommend\nif you enjoyed this video,"
    } ]
  }, {
    "tStartMs": 1346310,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "are computer memory and\nalgorithm fundamentals."
    } ]
  }, {
    "tStartMs": 1349610,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Brilliant have really upped\ntheir interactivity recently."
    } ]
  }, {
    "tStartMs": 1352330,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "So instead of reading about algorithms,"
    } ]
  }, {
    "tStartMs": 1354690,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "you're taught how to\nwrite algorithms yourself."
    } ]
  }, {
    "tStartMs": 1357540,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Brilliant engages you in active learning."
    } ]
  }, {
    "tStartMs": 1359910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Instead of telling you the right answer,"
    } ]
  }, {
    "tStartMs": 1361230,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "they allow you to figure\nit out for yourself"
    } ]
  }, {
    "tStartMs": 1363360,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "with plenty of helpful hints\nand guidance along the way."
    } ]
  }, {
    "tStartMs": 1366100,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And for viewers of this channel,"
    } ]
  }, {
    "tStartMs": 1367380,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Brilliant is offering 20%\noff an annual subscription"
    } ]
  }, {
    "tStartMs": 1370100,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to the first 200 people to sign up."
    } ]
  }, {
    "tStartMs": 1372170,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Just go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1375080,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "I'll put that link down\nin the description."
    } ]
  }, {
    "tStartMs": 1377130,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So I want to thank Brilliant\nfor supporting Veritasium"
    } ]
  }, {
    "tStartMs": 1379310,
    "dDurationMs": 2023,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
