{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "(zipper whirring)"
    } ]
  }, {
    "tStartMs": 2070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- How does a zipper actually work?"
    } ]
  }, {
    "tStartMs": 3780,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Like try to push down on a zipper"
    } ]
  }, {
    "tStartMs": 5610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from above and it probably won't budge,"
    } ]
  }, {
    "tStartMs": 8010,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but if you just use the pull tab,"
    } ]
  }, {
    "tStartMs": 9630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "suddenly it's buttery smooth."
    } ]
  }, {
    "tStartMs": 11610,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So how does it do this?"
    } ]
  }, {
    "tStartMs": 12900,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "We've made more zippers"
    } ]
  }, {
    "tStartMs": 14160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "than there are stars in the Milky Way."
    } ]
  }, {
    "tStartMs": 16110,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "You probably used one 10 times\ntoday without even noticing,"
    } ]
  }, {
    "tStartMs": 19740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "except the only time you\ndo is when one breaks."
    } ]
  }, {
    "tStartMs": 22710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I'll show you what to\ndo when this happens,"
    } ]
  }, {
    "tStartMs": 24150,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but what is actually going\non inside this thing?"
    } ]
  }, {
    "tStartMs": 27270,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I mean, obviously the teeth\ncome together inside the slider,"
    } ]
  }, {
    "tStartMs": 30540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but it turns out there\nis a surprising amount"
    } ]
  }, {
    "tStartMs": 32460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "of engineering to this thing."
    } ]
  }, {
    "tStartMs": 33840,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "All of this is too small\nto see on a real zipper,"
    } ]
  }, {
    "tStartMs": 36330,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "which is why we made this one."
    } ]
  }, {
    "tStartMs": 39780,
    "dDurationMs": 3857,
    "segs": [ {
      "utf8": "This is a video about the\nsurprising genius of zippers."
    } ]
  }, {
    "tStartMs": 45090,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "What is that?"
    } ]
  }, {
    "tStartMs": 45990,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "- This is a device that\nbasically started it all."
    } ]
  }, {
    "tStartMs": 50130,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "The idea was just to take\na bunch of hooks and eyes"
    } ]
  }, {
    "tStartMs": 54300,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and try to put them\ntogether in some fashion"
    } ]
  }, {
    "tStartMs": 56970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to make them quote, \"automatic\", unquote."
    } ]
  }, {
    "tStartMs": 59370,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Gregor] The hooks seemed very sharp,"
    } ]
  }, {
    "tStartMs": 60630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "like I don't think I'd\nwant this on my fly."
    } ]
  }, {
    "tStartMs": 62580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No, no."
    } ]
  }, {
    "tStartMs": 63413,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "Oh, definitely not there."
    } ]
  }, {
    "tStartMs": 64829,
    "dDurationMs": 1291,
    "segs": [ {
      "utf8": "(Robert laughing)"
    } ]
  }, {
    "tStartMs": 66120,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- By the 1800s,"
    } ]
  }, {
    "tStartMs": 67140,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "clothes were typically\nfastened using laces, buttons,"
    } ]
  }, {
    "tStartMs": 70230,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "brooches, and hooks and eyes."
    } ]
  }, {
    "tStartMs": 72060,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "These got the job done, but\nthey all shared the same flaw."
    } ]
  }, {
    "tStartMs": 75270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you had a series of these fasteners"
    } ]
  }, {
    "tStartMs": 77100,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "on a piece of clothing,"
    } ]
  }, {
    "tStartMs": 78450,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "well, you have to close them one by one."
    } ]
  }, {
    "tStartMs": 80160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Most people were satisfied\nwith the state of affairs,"
    } ]
  }, {
    "tStartMs": 83040,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but one man, American\nengineer, Whitcomb Judson,"
    } ]
  }, {
    "tStartMs": 86130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "thought the world\ndeserved something better."
    } ]
  }, {
    "tStartMs": 88380,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- The idea, primarily,"
    } ]
  }, {
    "tStartMs": 90030,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "it appears to be that he\nwould put them in shoes"
    } ]
  }, {
    "tStartMs": 92607,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "and people who had to lace\nup would be able to do it"
    } ]
  }, {
    "tStartMs": 96360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in one quick motion."
    } ]
  }, {
    "tStartMs": 97860,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So that was the device\nthat he had in mind,"
    } ]
  }, {
    "tStartMs": 100710,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and it didn't work."
    } ]
  }, {
    "tStartMs": 104370,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Judson was a pretty bad inventor."
    } ]
  }, {
    "tStartMs": 106560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Most of his patents had\nnever gotten much traction,"
    } ]
  }, {
    "tStartMs": 108990,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but he was a great salesman."
    } ]
  }, {
    "tStartMs": 111840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "In 1893 at the Chicago World's Fair,"
    } ]
  }, {
    "tStartMs": 114120,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "he presented this fastening\ndevice as the next big thing,"
    } ]
  }, {
    "tStartMs": 117060,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "claiming that in no time at all"
    } ]
  }, {
    "tStartMs": 119130,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "this would replace buttons and\nlaces, and not just on shoes,"
    } ]
  }, {
    "tStartMs": 122820,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but on all sorts of garments."
    } ]
  }, {
    "tStartMs": 124650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "A few wealthy investors\nactually believed it."
    } ]
  }, {
    "tStartMs": 126990,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So with their backing,"
    } ]
  }, {
    "tStartMs": 128310,
    "dDurationMs": 3293,
    "segs": [ {
      "utf8": "the Universal Fastener Company was born."
    } ]
  }, {
    "tStartMs": 131603,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "A decade later,"
    } ]
  }, {
    "tStartMs": 132660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the company managed to\ncarve out a small niche,"
    } ]
  }, {
    "tStartMs": 134970,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "primarily selling its\nfasteners for women's skirts."
    } ]
  }, {
    "tStartMs": 137737,
    "dDurationMs": 3386,
    "segs": [ {
      "utf8": "\"A pull and its done!\" said\ntheir ads, but that was a lie."
    } ]
  }, {
    "tStartMs": 141990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Judson's fastener design was a mess."
    } ]
  }, {
    "tStartMs": 143970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It jammed constantly."
    } ]
  }, {
    "tStartMs": 145620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And because it was delicate\nand made from rust prone steel,"
    } ]
  }, {
    "tStartMs": 148980,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "it actually had to be\nremoved from the garment"
    } ]
  }, {
    "tStartMs": 151110,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "before you could wash it."
    } ]
  }, {
    "tStartMs": 152460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So literally unsewn from your skirt."
    } ]
  }, {
    "tStartMs": 155160,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Moreover, if a single hook\nand eye were out of place,"
    } ]
  }, {
    "tStartMs": 158580,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the whole fastener became unstable,"
    } ]
  }, {
    "tStartMs": 160710,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "so simply bend over and the\nwhole thing could pop open."
    } ]
  }, {
    "tStartMs": 164880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Naturally, the Universal Fastener Company"
    } ]
  }, {
    "tStartMs": 166800,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "had very few repeat customers,\nand they fell into debt."
    } ]
  }, {
    "tStartMs": 171240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "But in 1906, a new\nengineer joined the team,"
    } ]
  }, {
    "tStartMs": 175080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "25-year-old Gideon Sundback,"
    } ]
  }, {
    "tStartMs": 177180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "who had just moved to the US from Sweden."
    } ]
  }, {
    "tStartMs": 179760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Why does someone like Gideon Sundback"
    } ]
  }, {
    "tStartMs": 181200,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "with a good degree in\nelectrical engineering"
    } ]
  }, {
    "tStartMs": 184530,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "decide to join this failing company?"
    } ]
  }, {
    "tStartMs": 187320,
    "dDurationMs": 1732,
    "segs": [ {
      "utf8": "- Well, it's a great story."
    } ]
  }, {
    "tStartMs": 189052,
    "dDurationMs": 3308,
    "segs": [ {
      "utf8": "- [Gregor] See, one of the\nmanagers at the company had-"
    } ]
  }, {
    "tStartMs": 192360,
    "dDurationMs": 2774,
    "segs": [ {
      "utf8": "- An absolutely drop-dead\ngorgeous daughter."
    } ]
  }, {
    "tStartMs": 195134,
    "dDurationMs": 1546,
    "segs": [ {
      "utf8": "(Gregor chuckles)"
    } ]
  }, {
    "tStartMs": 196680,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "And that daughter came into\nthe eye of Gideon Sundback,"
    } ]
  }, {
    "tStartMs": 201270,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and he was completely smitten."
    } ]
  }, {
    "tStartMs": 202770,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "So he ends up working for\nthe fastener manufacturer"
    } ]
  }, {
    "tStartMs": 206880,
    "dDurationMs": 4285,
    "segs": [ {
      "utf8": "so that he can cozy up to\nthat daughter and they marry."
    } ]
  }, {
    "tStartMs": 211165,
    "dDurationMs": 1265,
    "segs": [ {
      "utf8": "- [Gregor] For the next few years,"
    } ]
  }, {
    "tStartMs": 212430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Sundback made minor improvements"
    } ]
  }, {
    "tStartMs": 214320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to Judson's hook and eye design,"
    } ]
  }, {
    "tStartMs": 216120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but none were ever enough\nto make the product"
    } ]
  }, {
    "tStartMs": 218310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "truly functional."
    } ]
  }, {
    "tStartMs": 219930,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Then soon after giving birth\nto a daughter, his wife Elvira,"
    } ]
  }, {
    "tStartMs": 223530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "fell ill and died."
    } ]
  }, {
    "tStartMs": 225720,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- [Robert] And Sundback\nwas absolutely devastated."
    } ]
  }, {
    "tStartMs": 229410,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "So the romantic tale is that\nhe threw himself into his work"
    } ]
  }, {
    "tStartMs": 233670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "at that point out of fighting the grief"
    } ]
  }, {
    "tStartMs": 236130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "from the loss of his wife."
    } ]
  }, {
    "tStartMs": 238380,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "- This dark period in his life\nled to a major breakthrough."
    } ]
  }, {
    "tStartMs": 243660,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Sundback realized that this"
    } ]
  }, {
    "tStartMs": 245579,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(paper crinkling)"
    } ]
  }, {
    "tStartMs": 246412,
    "dDurationMs": 1538,
    "segs": [ {
      "utf8": "was never gonna work."
    } ]
  }, {
    "tStartMs": 247950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So after years of tinkering,"
    } ]
  }, {
    "tStartMs": 249450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "he submitted a patent of his own."
    } ]
  }, {
    "tStartMs": 251760,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "This is a patent from 1914,\nbut if you take a look,"
    } ]
  }, {
    "tStartMs": 255540,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "it is nearly identical\nto a zipper from today."
    } ]
  }, {
    "tStartMs": 259920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Sundback's modern zipper\nstarts with two rows of teeth,"
    } ]
  }, {
    "tStartMs": 263400,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and the teeth are shaped so\nthat they're wider at the end"
    } ]
  }, {
    "tStartMs": 267060,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "than the opening on the other side."
    } ]
  }, {
    "tStartMs": 269070,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "So if you try to push them\ntogether, it's pretty hard."
    } ]
  }, {
    "tStartMs": 273150,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Now, this is especially\ntrue on a real size zipper"
    } ]
  }, {
    "tStartMs": 276630,
    "dDurationMs": 2995,
    "segs": [ {
      "utf8": "where it's practically impossible."
    } ]
  }, {
    "tStartMs": 279625,
    "dDurationMs": 3315,
    "segs": [ {
      "utf8": "But if I add this slider to the bottom"
    } ]
  }, {
    "tStartMs": 284100,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "and try pulling on the pull tab here,"
    } ]
  }, {
    "tStartMs": 290760,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "suddenly it's effortless."
    } ]
  }, {
    "tStartMs": 292260,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So how does it do it?"
    } ]
  }, {
    "tStartMs": 294030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Well, I can remove the\ncover from the slider"
    } ]
  }, {
    "tStartMs": 296070,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "to reveal that it's\njust a Y-shaped cavity."
    } ]
  }, {
    "tStartMs": 300600,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "That's it."
    } ]
  }, {
    "tStartMs": 301920,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "See, as you zip up,"
    } ]
  }, {
    "tStartMs": 303750,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "the Y-shaped cavity tilts the\nteeth at just the right angle"
    } ]
  }, {
    "tStartMs": 307530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "so that the tooth has enough space"
    } ]
  }, {
    "tStartMs": 310110,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to slot into its groove"
    } ]
  }, {
    "tStartMs": 311880,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "without bumping into the tooth above."
    } ]
  }, {
    "tStartMs": 314940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And as you zip down,"
    } ]
  }, {
    "tStartMs": 316920,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "this wedge shaped piece\nseparates the teeth,"
    } ]
  }, {
    "tStartMs": 320130,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "allowing you to unzip."
    } ]
  }, {
    "tStartMs": 322410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This results in one awkward design quirk."
    } ]
  }, {
    "tStartMs": 324810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "At the top, no zipper\nis ever fully zipped up"
    } ]
  }, {
    "tStartMs": 327420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "because the wedge is always there."
    } ]
  }, {
    "tStartMs": 329400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It has to remain between the teeth."
    } ]
  }, {
    "tStartMs": 331710,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Now, Sundback's original design"
    } ]
  }, {
    "tStartMs": 333210,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "was a little different to this big guy."
    } ]
  }, {
    "tStartMs": 335340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It sported rectangular teeth"
    } ]
  }, {
    "tStartMs": 337200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "with a bump on the top called the nib,"
    } ]
  }, {
    "tStartMs": 339420,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and an equivalently shaped indent"
    } ]
  }, {
    "tStartMs": 341190,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "on the bottom called the scoop."
    } ]
  }, {
    "tStartMs": 343200,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "That way, when the teeth would align,"
    } ]
  }, {
    "tStartMs": 344970,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "each nib would fit neatly\ninto its neighbor's scoop,"
    } ]
  }, {
    "tStartMs": 347970,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "forming a strong connection."
    } ]
  }, {
    "tStartMs": 350340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But there was a problem,"
    } ]
  }, {
    "tStartMs": 352020,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "even though Sundback had\na new design and a patent,"
    } ]
  }, {
    "tStartMs": 354930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "manufacturing a zipper\nlike this in the 1910s"
    } ]
  }, {
    "tStartMs": 357690,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "was very impractical."
    } ]
  }, {
    "tStartMs": 359580,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Each of the tiny teeth\nneeded to be precisely shaped"
    } ]
  }, {
    "tStartMs": 362430,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for the fastener to work, but at the time,"
    } ]
  }, {
    "tStartMs": 364830,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "there were simply no tools around"
    } ]
  }, {
    "tStartMs": 366840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that could do this reliably."
    } ]
  }, {
    "tStartMs": 368670,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- So he had to come up"
    } ]
  }, {
    "tStartMs": 369960,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "with some extraordinarily\nclever machineries"
    } ]
  }, {
    "tStartMs": 373500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that allowed them to\nautomate the production"
    } ]
  }, {
    "tStartMs": 376020,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of the zipper from the very beginning."
    } ]
  }, {
    "tStartMs": 378510,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Sundback's machine worked like this."
    } ]
  }, {
    "tStartMs": 379890,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It took Y-shaped wire"
    } ]
  }, {
    "tStartMs": 381480,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "made from a nickel alloy as an input."
    } ]
  }, {
    "tStartMs": 383970,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "First, it sliced pieces off the wire"
    } ]
  }, {
    "tStartMs": 386310,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to serve as individual teeth,"
    } ]
  }, {
    "tStartMs": 388380,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and then it stamped the scoop\nand nib into each tooth."
    } ]
  }, {
    "tStartMs": 392040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Finally, the machine\nwould clamp the two arms"
    } ]
  }, {
    "tStartMs": 394440,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "of the Y-shape together\nonto a piece of fabric"
    } ]
  }, {
    "tStartMs": 397140,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "called the tape."
    } ]
  }, {
    "tStartMs": 398310,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This tape held all the teeth in place,"
    } ]
  }, {
    "tStartMs": 400230,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and it was the part of the zipper"
    } ]
  }, {
    "tStartMs": 401640,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that would later get stitched"
    } ]
  }, {
    "tStartMs": 402990,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "onto clothes and other products."
    } ]
  }, {
    "tStartMs": 405963,
    "dDurationMs": 2337,
    "segs": [ {
      "utf8": "Sundback's machines worked wonders."
    } ]
  }, {
    "tStartMs": 408300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Even in their earliest forms,"
    } ]
  }, {
    "tStartMs": 409920,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "they could already make 150\nmeters of zippers per day,"
    } ]
  }, {
    "tStartMs": 414060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and these zippers were incredibly strong."
    } ]
  }, {
    "tStartMs": 416730,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "That's because for a\ntooth to become unpaired,"
    } ]
  }, {
    "tStartMs": 419310,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "it needs to get some\ndistance between itself,"
    } ]
  }, {
    "tStartMs": 421650,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "and its neighbors,"
    } ]
  }, {
    "tStartMs": 422550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "enough for the nibs on\neither side to pop out."
    } ]
  }, {
    "tStartMs": 424920,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But since the machines spaced\nthe teeth so precisely,"
    } ]
  }, {
    "tStartMs": 428250,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "there was simply no\nroom for that to happen."
    } ]
  }, {
    "tStartMs": 430680,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Now, you might think you\ncould just stretch the zipper"
    } ]
  }, {
    "tStartMs": 432300,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "vertically to separate the teeth,"
    } ]
  }, {
    "tStartMs": 434010,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but the zipper tape itself is made"
    } ]
  }, {
    "tStartMs": 435840,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "from strong inelastic fabric."
    } ]
  }, {
    "tStartMs": 437910,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So even if the garment itself is stretchy,"
    } ]
  }, {
    "tStartMs": 440340,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "the teeth are connected to the tape"
    } ]
  }, {
    "tStartMs": 441660,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "which is designed not to stretch,\nso they won't come loose."
    } ]
  }, {
    "tStartMs": 445290,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But there is a way for\nthis mechanism to fail."
    } ]
  }, {
    "tStartMs": 447810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "If even a single tooth falls off,"
    } ]
  }, {
    "tStartMs": 449850,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "well, then its neighbors have\nenough space to come loose,"
    } ]
  }, {
    "tStartMs": 452850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and then their neighbors come loose,"
    } ]
  }, {
    "tStartMs": 454500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and this causes a cascading effect,"
    } ]
  }, {
    "tStartMs": 456690,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and the whole zipper pops open."
    } ]
  }, {
    "tStartMs": 459210,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "This isn't something you had\nto worry about with buttons,"
    } ]
  }, {
    "tStartMs": 461640,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "which can only fail one at a time."
    } ]
  }, {
    "tStartMs": 464370,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But even with this flaw,"
    } ]
  }, {
    "tStartMs": 465870,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Sundback's employers thought\nthis patent was a gold mine."
    } ]
  }, {
    "tStartMs": 469050,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So the Universal Fastener Company"
    } ]
  }, {
    "tStartMs": 470670,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "decided to launch the\nproduct under their new name,"
    } ]
  }, {
    "tStartMs": 473580,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "'The Hookless Hooker'."
    } ]
  }, {
    "tStartMs": 475440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "They abandoned that name pretty quickly"
    } ]
  }, {
    "tStartMs": 476940,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and decided to call it 'The\nHookless Fastener' instead."
    } ]
  }, {
    "tStartMs": 479910,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This new fastener was\na successful product,"
    } ]
  }, {
    "tStartMs": 482280,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but not a mainstream one."
    } ]
  }, {
    "tStartMs": 483780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Its first applications were pretty niche."
    } ]
  }, {
    "tStartMs": 485730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "You'd find it on money belts,"
    } ]
  }, {
    "tStartMs": 487410,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "essentially the fanny packs of the 1910s,"
    } ]
  }, {
    "tStartMs": 489630,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "as well as tobacco\npouches and rubber boots."
    } ]
  }, {
    "tStartMs": 492090,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Now, those rubber boots\nwere particularly important."
    } ]
  }, {
    "tStartMs": 495450,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "They were manufactured by\nthe B.F. Goodrich Company."
    } ]
  }, {
    "tStartMs": 498540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- When they got a hold of the device,"
    } ]
  }, {
    "tStartMs": 501210,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "they were convinced that,"
    } ]
  }, {
    "tStartMs": 502230,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "yes, this will give us a\nleg up on our competitor."
    } ]
  }, {
    "tStartMs": 505050,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "We will introduce this automatic fastener,"
    } ]
  }, {
    "tStartMs": 508140,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but we need a name for it."
    } ]
  }, {
    "tStartMs": 510240,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Gregor] Then the company's\npresident had an idea."
    } ]
  }, {
    "tStartMs": 512730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Well, you know, it worked really well."
    } ]
  }, {
    "tStartMs": 514200,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "They're pretty nice."
    } ]
  }, {
    "tStartMs": 515340,
    "dDurationMs": 923,
    "segs": [ {
      "utf8": "You can just sort of..."
    } ]
  }, {
    "tStartMs": 516263,
    "dDurationMs": 2647,
    "segs": [ {
      "utf8": "It just goes sort of zip\nwhen you're closing it"
    } ]
  }, {
    "tStartMs": 518910,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and when you're opening it."
    } ]
  }, {
    "tStartMs": 520140,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So, B.F. Goodrich came\nout in the early 1920s"
    } ]
  }, {
    "tStartMs": 523650,
    "dDurationMs": 2175,
    "segs": [ {
      "utf8": "with their zipper boots."
    } ]
  }, {
    "tStartMs": 525825,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "- The boots were such a hit"
    } ]
  }, {
    "tStartMs": 527400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that the name zipper transcended the shoe"
    } ]
  }, {
    "tStartMs": 529680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and became the name for\nthe fastener itself."
    } ]
  }, {
    "tStartMs": 531930,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "Soon, consumers wanted\nthe zipper on everything."
    } ]
  }, {
    "tStartMs": 537030,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "By the 1930s, the\nUniversal Fastener Company"
    } ]
  }, {
    "tStartMs": 539160,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "became very, very successful."
    } ]
  }, {
    "tStartMs": 542820,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "They got a new name, too: Talon,"
    } ]
  }, {
    "tStartMs": 545040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "since their fasteners had a secure grip,"
    } ]
  }, {
    "tStartMs": 547140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "it was kind of like\nthe talons of an eagle."
    } ]
  }, {
    "tStartMs": 549930,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Talon's new zippers were way\nsturdier than Judson's hook"
    } ]
  }, {
    "tStartMs": 553080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and eye design, because\ntheir parts were way simpler,"
    } ]
  }, {
    "tStartMs": 555660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and they were also made out\nof rust resistant nickel alloy"
    } ]
  }, {
    "tStartMs": 558960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "instead of steel,"
    } ]
  }, {
    "tStartMs": 559793,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "which meant you could\nleave them on in the wash."
    } ]
  }, {
    "tStartMs": 562350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "By the way, if you are putting\nsomething with a zipper"
    } ]
  }, {
    "tStartMs": 564450,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "inside the washing machine,\nyou should always zip it up."
    } ]
  }, {
    "tStartMs": 567090,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "That will prevent the zipper from snagging"
    } ]
  }, {
    "tStartMs": 568740,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "on your other clothes,"
    } ]
  }, {
    "tStartMs": 569880,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and it'll also protect the zipper itself."
    } ]
  }, {
    "tStartMs": 572250,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Now, even though zippers\nrapidly became popular,"
    } ]
  }, {
    "tStartMs": 575220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "there was pushback among the older"
    } ]
  }, {
    "tStartMs": 577500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and more conservative consumers,"
    } ]
  }, {
    "tStartMs": 579360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "especially about putting them on the fly."
    } ]
  }, {
    "tStartMs": 581730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And urban legends began to spread."
    } ]
  }, {
    "tStartMs": 584370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- One of the most famous ones\nis the myth of the fellow"
    } ]
  }, {
    "tStartMs": 586860,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "who has come to his\nfiance's parents for dinner,"
    } ]
  }, {
    "tStartMs": 590700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "he's seated down at the table,"
    } ]
  }, {
    "tStartMs": 593100,
    "dDurationMs": 1287,
    "segs": [ {
      "utf8": "he looked down and realized,"
    } ]
  }, {
    "tStartMs": 594387,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "\"Oh my God, I haven't zipped up my fly,\""
    } ]
  }, {
    "tStartMs": 597360,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "so he zips it up."
    } ]
  }, {
    "tStartMs": 598740,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But then when he gets\nup a few minutes later"
    } ]
  }, {
    "tStartMs": 601170,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to leave the table,"
    } ]
  }, {
    "tStartMs": 602430,
    "dDurationMs": 3197,
    "segs": [ {
      "utf8": "he has caught the tablecloth\nin the fly of his trousers,"
    } ]
  }, {
    "tStartMs": 605627,
    "dDurationMs": 3313,
    "segs": [ {
      "utf8": "and so ends up sending\nthe entire table tumbling"
    } ]
  }, {
    "tStartMs": 608940,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "after him as he gets up and leaves."
    } ]
  }, {
    "tStartMs": 614280,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- I'm still a bit confused by..."
    } ]
  }, {
    "tStartMs": 616260,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "zippers are more expensive,"
    } ]
  }, {
    "tStartMs": 617490,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "more temperamental than buttons and laces,"
    } ]
  }, {
    "tStartMs": 619770,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and anyways, they become\nhuge regardless of that."
    } ]
  }, {
    "tStartMs": 622920,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- Well, now you see the\nheart of the mystery."
    } ]
  }, {
    "tStartMs": 625530,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The novelty of a zipper\nitself was something"
    } ]
  }, {
    "tStartMs": 629010,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "that took hold of people."
    } ]
  }, {
    "tStartMs": 630000,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "People wanted to be modern,"
    } ]
  }, {
    "tStartMs": 632795,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and it came to be closely\nidentified with being modern."
    } ]
  }, {
    "tStartMs": 637800,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "I found it very interesting\nthat looking at World War II,"
    } ]
  }, {
    "tStartMs": 641700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the zipper manufacturer in Germany"
    } ]
  }, {
    "tStartMs": 644250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "was one of the protected industries,"
    } ]
  }, {
    "tStartMs": 647190,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "despite the fact that it\nused fairly precious metal,"
    } ]
  }, {
    "tStartMs": 650250,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "metals that were very important\nfor munition and the like."
    } ]
  }, {
    "tStartMs": 653213,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "But the zippers were protected"
    } ]
  }, {
    "tStartMs": 655080,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "because they were closely\nidentified with modern prosperity,"
    } ]
  }, {
    "tStartMs": 659790,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "with the idea that if we can have zippers"
    } ]
  }, {
    "tStartMs": 662460,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "then everything must be okay."
    } ]
  }, {
    "tStartMs": 665640,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- But a more obvious reason\nfor the zipper's popularity"
    } ]
  }, {
    "tStartMs": 667860,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is that it's just so easy to use."
    } ]
  }, {
    "tStartMs": 670200,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "How much quicker is a zipper\nthan a series of buttons?"
    } ]
  }, {
    "tStartMs": 673020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I have a jacket that has\nboth, so let's time it."
    } ]
  }, {
    "tStartMs": 674820,
    "dDurationMs": 1826,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 682560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There we go."
    } ]
  }, {
    "tStartMs": 687175,
    "dDurationMs": 1685,
    "segs": [ {
      "utf8": "I mean, it's a pretty great example"
    } ]
  }, {
    "tStartMs": 688860,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of how a more automatic approach"
    } ]
  }, {
    "tStartMs": 690930,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "can save you a bunch of time,"
    } ]
  }, {
    "tStartMs": 692520,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "which is what today's sponsor\nHostinger is all about."
    } ]
  }, {
    "tStartMs": 696240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Say you have a bunch\nof projects spread out"
    } ]
  }, {
    "tStartMs": 697920,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "over Slack, and email, and WhatsApp."
    } ]
  }, {
    "tStartMs": 700170,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If you're trying to keep\ntrack of everything manually,"
    } ]
  }, {
    "tStartMs": 702600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "it's a pretty slow process,"
    } ]
  }, {
    "tStartMs": 703800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and it's super easy to miss something."
    } ]
  }, {
    "tStartMs": 705660,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "But with Hostinger and their\nvirtual private server or VPS,"
    } ]
  }, {
    "tStartMs": 709530,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "you can quickly zip up your entire project"
    } ]
  }, {
    "tStartMs": 712050,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and bring everything\ntogether in one place."
    } ]
  }, {
    "tStartMs": 714330,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "In just a single click,"
    } ]
  }, {
    "tStartMs": 715290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "a Hostinger VPS lets you deploy OpenClaw,"
    } ]
  }, {
    "tStartMs": 717780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which is a multi-channel\npersonal assistant."
    } ]
  }, {
    "tStartMs": 720270,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And OpenClaw's declutter feature"
    } ]
  }, {
    "tStartMs": 722280,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "will go through all of\nyour inboxes and pluck out"
    } ]
  }, {
    "tStartMs": 724860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "all the most important\nmessages and zip them together"
    } ]
  }, {
    "tStartMs": 727290,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "into one central hub."
    } ]
  }, {
    "tStartMs": 728700,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's also a great research tool,"
    } ]
  }, {
    "tStartMs": 729960,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "so if there's a topic\nyou're interested in,"
    } ]
  }, {
    "tStartMs": 731580,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you can use OpenClaw to scrape the web"
    } ]
  }, {
    "tStartMs": 733890,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "for relevant sources,"
    } ]
  }, {
    "tStartMs": 735060,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and also keep up to\ndate on posts everywhere"
    } ]
  }, {
    "tStartMs": 737280,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "from Reddit to Nature."
    } ]
  }, {
    "tStartMs": 739110,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And because it runs 24/7,"
    } ]
  }, {
    "tStartMs": 740940,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "you can wake up each morning\nto a fresh batch of articles"
    } ]
  }, {
    "tStartMs": 743700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "delivered straight to your inbox."
    } ]
  }, {
    "tStartMs": 745920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So if you're interested\nin running OpenClaw,"
    } ]
  }, {
    "tStartMs": 748590,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "head to hostinger.com/veritasiumopenclaw,"
    } ]
  }, {
    "tStartMs": 752130,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "or click on the link in the description,"
    } ]
  }, {
    "tStartMs": 754020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and make sure you use code Veritasium"
    } ]
  }, {
    "tStartMs": 755610,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to get an exclusive discount\non all yearly VPS plans."
    } ]
  }, {
    "tStartMs": 759090,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So I wanna thank Hostinger"
    } ]
  }, {
    "tStartMs": 760320,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "for sponsoring this part of the video."
    } ]
  }, {
    "tStartMs": 761790,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "And now back to zippers."
    } ]
  }, {
    "tStartMs": 764220,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Fast forward to today,"
    } ]
  }, {
    "tStartMs": 765180,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Sundback's design is still the one"
    } ]
  }, {
    "tStartMs": 766830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "we most associate with zippers."
    } ]
  }, {
    "tStartMs": 768780,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Besides the classic metal variant,"
    } ]
  }, {
    "tStartMs": 770400,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "which was sturdy and reliable,"
    } ]
  }, {
    "tStartMs": 772650,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "zippers also started being\nproduced from plastic,"
    } ]
  }, {
    "tStartMs": 774900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "which was cheaper and more flexible."
    } ]
  }, {
    "tStartMs": 777330,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But you'd probably be surprised to know"
    } ]
  }, {
    "tStartMs": 778710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that these two zipper types"
    } ]
  }, {
    "tStartMs": 780780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "aren't the most common\nzipper in the world."
    } ]
  }, {
    "tStartMs": 782790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "In fact, the world's most popular zipper"
    } ]
  }, {
    "tStartMs": 784950,
    "dDurationMs": 3351,
    "segs": [ {
      "utf8": "doesn't have teeth at\nall, and it's this thing."
    } ]
  }, {
    "tStartMs": 788301,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 789600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Okay, at first it just\nlooks like other zippers,"
    } ]
  }, {
    "tStartMs": 791790,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "but if I pull out the threads,"
    } ]
  }, {
    "tStartMs": 793800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "you can see that everything here"
    } ]
  }, {
    "tStartMs": 795330,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "is just a single weird piece of plastic."
    } ]
  }, {
    "tStartMs": 798090,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Imagine you have a coil of plastic"
    } ]
  }, {
    "tStartMs": 799710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that you somewhat flatten."
    } ]
  }, {
    "tStartMs": 801390,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "You can mold the plastic\nsuch that one side"
    } ]
  }, {
    "tStartMs": 803640,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "of every loop bulges out\nmore on the top and bottom."
    } ]
  }, {
    "tStartMs": 807090,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "If you do this a second time\nwith a second piece of plastic,"
    } ]
  }, {
    "tStartMs": 810090,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "you'll notice that you now have ridges"
    } ]
  }, {
    "tStartMs": 811710,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that fit perfectly together,"
    } ]
  }, {
    "tStartMs": 813570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "much like zipper teeth."
    } ]
  }, {
    "tStartMs": 815550,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Stitch these two coils onto\nfabric, then add a slider,"
    } ]
  }, {
    "tStartMs": 819030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and bam, you have a functional zipper."
    } ]
  }, {
    "tStartMs": 821490,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "This is known as a coil zipper."
    } ]
  }, {
    "tStartMs": 823350,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It showed up around the\n1940s as a cheap alternative"
    } ]
  }, {
    "tStartMs": 826290,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to the original design,"
    } ]
  }, {
    "tStartMs": 827760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and now you can find it everywhere,"
    } ]
  }, {
    "tStartMs": 829590,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "especially on things like\nsuitcases and backpacks"
    } ]
  }, {
    "tStartMs": 832110,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "where the zipper needs flexibility"
    } ]
  }, {
    "tStartMs": 833700,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "to maneuver around corners."
    } ]
  }, {
    "tStartMs": 836460,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Coil zippers also have another benefit."
    } ]
  }, {
    "tStartMs": 838380,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Since all of their teeth\nare one interconnected piece"
    } ]
  }, {
    "tStartMs": 841590,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "of plastic, there's no way for\na single tooth to fall off,"
    } ]
  }, {
    "tStartMs": 844620,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "so that itself cannot cause\nthat cascading failure."
    } ]
  }, {
    "tStartMs": 849120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But there was still a\nproblem zippers had to solve,"
    } ]
  }, {
    "tStartMs": 851310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and that was that they\nwere kind of too good,"
    } ]
  }, {
    "tStartMs": 853890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "especially zippers that\nhave been used a lot"
    } ]
  }, {
    "tStartMs": 855540,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and are kind of worn down in the slider,"
    } ]
  }, {
    "tStartMs": 857340,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they can..."
    } ]
  }, {
    "tStartMs": 859050,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "just unzip on their own."
    } ]
  }, {
    "tStartMs": 861600,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "To prevent that,"
    } ]
  }, {
    "tStartMs": 862440,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Gideon Sundback\nhimself actually designed"
    } ]
  }, {
    "tStartMs": 864870,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "a locking mechanism like a break."
    } ]
  }, {
    "tStartMs": 867360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Under the piece that connects\nthe pull tab to the slider,"
    } ]
  }, {
    "tStartMs": 870210,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "there is a small metal pin."
    } ]
  }, {
    "tStartMs": 872430,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "When the pull tab is in its\ntypical resting position,"
    } ]
  }, {
    "tStartMs": 875220,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "one end of the pin sticks through a hole"
    } ]
  }, {
    "tStartMs": 877710,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in the bottom face of the slider,"
    } ]
  }, {
    "tStartMs": 879210,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "lodging itself between the\nzipper's teeth or coils."
    } ]
  }, {
    "tStartMs": 882180,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "That way the slider is stuck in place."
    } ]
  }, {
    "tStartMs": 884910,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But when the pull tab is pulled forward,"
    } ]
  }, {
    "tStartMs": 887400,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "this releases the pin,\nallowing the slider to move."
    } ]
  }, {
    "tStartMs": 890820,
    "dDurationMs": 2146,
    "segs": [ {
      "utf8": "Now you can see that there's\nlike this little tiny gap"
    } ]
  }, {
    "tStartMs": 892966,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "through which you can see light,"
    } ]
  }, {
    "tStartMs": 894750,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and that's because the\nzipper stop is now engaged."
    } ]
  }, {
    "tStartMs": 897030,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But if I grab the pull\ntab and start pulling,"
    } ]
  }, {
    "tStartMs": 900120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you can see that because of\nthe way that it's shaped,"
    } ]
  }, {
    "tStartMs": 902580,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it's actually gonna end\nup pushing that part up,"
    } ]
  }, {
    "tStartMs": 905550,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "even though I'm pulling to the side,"
    } ]
  }, {
    "tStartMs": 907560,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and that's gonna disengage."
    } ]
  }, {
    "tStartMs": 909210,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "You can try to pull apart\nthe fly on your pants,"
    } ]
  }, {
    "tStartMs": 911550,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but unless you actually grab the pull tab"
    } ]
  }, {
    "tStartMs": 913380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and pull it down, it is not gonna open."
    } ]
  }, {
    "tStartMs": 916440,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "These locking mechanisms\naren't on every zipper,"
    } ]
  }, {
    "tStartMs": 918747,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "but they're more common\nthan you might think."
    } ]
  }, {
    "tStartMs": 920670,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "I counted up 65 zippers\nin this room in total,"
    } ]
  }, {
    "tStartMs": 923272,
    "dDurationMs": 3848,
    "segs": [ {
      "utf8": "33 of those 65 had stopping mechanisms,"
    } ]
  }, {
    "tStartMs": 927120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "which is over 50%."
    } ]
  }, {
    "tStartMs": 928770,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Which is also something I\nnever noticed on a zipper."
    } ]
  }, {
    "tStartMs": 931740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But as I was hunting\nfor zippers in my room."
    } ]
  }, {
    "tStartMs": 933360,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "I noticed something else,"
    } ]
  }, {
    "tStartMs": 934740,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "on pull tab after pull tab\nthere's no mention of Talon,"
    } ]
  }, {
    "tStartMs": 938310,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but I kept finding the\nsame three letters instead:"
    } ]
  }, {
    "tStartMs": 940770,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "YKK, YKK, YKK."
    } ]
  }, {
    "tStartMs": 943740,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "YKK."
    } ]
  }, {
    "tStartMs": 944910,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Even on clothes and objects"
    } ]
  }, {
    "tStartMs": 946590,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "from completely different brands."
    } ]
  }, {
    "tStartMs": 948360,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "If you look at your zipper now,"
    } ]
  }, {
    "tStartMs": 949470,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "you'll probably see the same thing."
    } ]
  }, {
    "tStartMs": 951630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So at first, I thought this might refer"
    } ]
  }, {
    "tStartMs": 953100,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to a particular style\nof zipper or something,"
    } ]
  }, {
    "tStartMs": 955320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but then I Googled it,"
    } ]
  }, {
    "tStartMs": 956153,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "and it turns out that YKK is a company,"
    } ]
  }, {
    "tStartMs": 958170,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the biggest zipper company in the world."
    } ]
  }, {
    "tStartMs": 960300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "If Talon has the original patent rights"
    } ]
  }, {
    "tStartMs": 962880,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "and they own the original zipper,"
    } ]
  }, {
    "tStartMs": 965159,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "how don't I have a single\nTalon zipper in my room,"
    } ]
  }, {
    "tStartMs": 967980,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and how did YKK end up\ndominating the zipper world?"
    } ]
  }, {
    "tStartMs": 971880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Well, Talon pretty much\nruled the zipper market"
    } ]
  }, {
    "tStartMs": 974460,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "until the 1930s,"
    } ]
  }, {
    "tStartMs": 975990,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "but in 1934, Sundback's\noriginal patent expired,"
    } ]
  }, {
    "tStartMs": 979800,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "so the playing field was\nwide open to competitors."
    } ]
  }, {
    "tStartMs": 983010,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "That same year, Japanese\nbusinessman, Tadao Yoshida,"
    } ]
  }, {
    "tStartMs": 985890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "founded a new fastener company,"
    } ]
  }, {
    "tStartMs": 987870,
    "dDurationMs": 3722,
    "segs": [ {
      "utf8": "the Yoshida Manufacturing\nCorporation, or YKK."
    } ]
  }, {
    "tStartMs": 993180,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It began as a single workshop in Tokyo"
    } ]
  }, {
    "tStartMs": 995190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "where each zipper was made by hand."
    } ]
  }, {
    "tStartMs": 997590,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Then in 1945, that workshop\nwas completely destroyed"
    } ]
  }, {
    "tStartMs": 1001280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "by allied bombs, but\nYoshida was undaunted."
    } ]
  }, {
    "tStartMs": 1004280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "He rebuilt the plant, and after the war,"
    } ]
  }, {
    "tStartMs": 1006290,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "he started buying zipper\nmaking machines from the US."
    } ]
  }, {
    "tStartMs": 1009740,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- They improved the machine,"
    } ]
  }, {
    "tStartMs": 1011000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "particularly they improved the speed."
    } ]
  }, {
    "tStartMs": 1013580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Gregor] They then\nalso decided to switch"
    } ]
  }, {
    "tStartMs": 1015320,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to manufacturing everything in-house"
    } ]
  }, {
    "tStartMs": 1017690,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "from the zippers\nthemselves to the machines,"
    } ]
  }, {
    "tStartMs": 1019880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to even the boxes that the\nzippers were shipped in."
    } ]
  }, {
    "tStartMs": 1021920,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- And YKK emphasizes quality\nabove everything else."
    } ]
  }, {
    "tStartMs": 1027020,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So they make a real point of saying"
    } ]
  }, {
    "tStartMs": 1029240,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "that if you have a YKK zipper,\nyou can depend on it utterly."
    } ]
  }, {
    "tStartMs": 1033290,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "And that turned out"
    } ]
  }, {
    "tStartMs": 1034220,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "to be an enormously successful sale tactic."
    } ]
  }, {
    "tStartMs": 1037653,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "- [Gregor] Around 1980,"
    } ]
  }, {
    "tStartMs": 1039500,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "YKK surpassed Talon as the\nworld's biggest zipper maker,"
    } ]
  }, {
    "tStartMs": 1043490,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and by the early 2000s,"
    } ]
  }, {
    "tStartMs": 1044990,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Talon's US market share\nhad fallen to a mere 7%,"
    } ]
  }, {
    "tStartMs": 1048080,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "while YKK's surged to around 45%."
    } ]
  }, {
    "tStartMs": 1051350,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- YKK surpassed the 10\nbillion annual zipper"
    } ]
  }, {
    "tStartMs": 1055070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "unit sales last year."
    } ]
  }, {
    "tStartMs": 1057110,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- I mean, that's a very impressive number."
    } ]
  }, {
    "tStartMs": 1058580,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Like 10 billion is crazy."
    } ]
  }, {
    "tStartMs": 1060230,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- It's equivalent"
    } ]
  }, {
    "tStartMs": 1061670,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "to more than 3 million\nkilometers in length."
    } ]
  }, {
    "tStartMs": 1065660,
    "dDurationMs": 4819,
    "segs": [ {
      "utf8": "It could be like around like\n80 trips around the world."
    } ]
  }, {
    "tStartMs": 1070479,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "- [Gregor] And not all\nof these are regular"
    } ]
  }, {
    "tStartMs": 1072230,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "everyday zippers either."
    } ]
  }, {
    "tStartMs": 1073670,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- So this is an airtight,\nwatertight zipper,"
    } ]
  }, {
    "tStartMs": 1076550,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and this relies on rigid\nmetal to metal sealing,"
    } ]
  }, {
    "tStartMs": 1080120,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "where nickel teeth are\nforced tightly together"
    } ]
  }, {
    "tStartMs": 1082880,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "against a rubber tape"
    } ]
  }, {
    "tStartMs": 1084110,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "providing an extreme pressure resistance."
    } ]
  }, {
    "tStartMs": 1086390,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- I mean, that looks like a mean zipper."
    } ]
  }, {
    "tStartMs": 1087980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "What's an extreme use case\nfor a zipper like this?"
    } ]
  }, {
    "tStartMs": 1090230,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- Deep sea diving, submarine escape suits."
    } ]
  }, {
    "tStartMs": 1093590,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Submarine escape\nsuits sound really cool."
    } ]
  }, {
    "tStartMs": 1096260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "In case of an emergency\nevacuation of a submarine,"
    } ]
  }, {
    "tStartMs": 1098750,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you need a suit that\ncan balloon up with air"
    } ]
  }, {
    "tStartMs": 1100670,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to counteract the pressure\nof the deep ocean,"
    } ]
  }, {
    "tStartMs": 1103040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and that can provide\nbuoyancy helping you shoot up"
    } ]
  }, {
    "tStartMs": 1105590,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "to the surface."
    } ]
  }, {
    "tStartMs": 1106700,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But you also need to be able\nto put it on super quickly."
    } ]
  }, {
    "tStartMs": 1110150,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And the best option seems to be this suit"
    } ]
  }, {
    "tStartMs": 1112370,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "with a giant watertight and\nairtight zipper on the front."
    } ]
  }, {
    "tStartMs": 1116360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Airtight zippers like these"
    } ]
  }, {
    "tStartMs": 1117620,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "even made it onto spacesuits."
    } ]
  }, {
    "tStartMs": 1120107,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "And that's the zipper."
    } ]
  }, {
    "tStartMs": 1121490,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It's this surprisingly genius invention"
    } ]
  }, {
    "tStartMs": 1123440,
    "dDurationMs": 1904,
    "segs": [ {
      "utf8": "that no one really asked for."
    } ]
  }, {
    "tStartMs": 1128560,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "I hate when this happens."
    } ]
  }, {
    "tStartMs": 1130700,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- I think a zipper slider may get stuck"
    } ]
  }, {
    "tStartMs": 1133880,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "if fabric becomes caught in the chain."
    } ]
  }, {
    "tStartMs": 1136220,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So if dirt or debris enters in the zipper,"
    } ]
  }, {
    "tStartMs": 1140060,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "the best fix is to carefully\nremove any trapped fabric"
    } ]
  }, {
    "tStartMs": 1144694,
    "dDurationMs": 3976,
    "segs": [ {
      "utf8": "or debris, or move the slider gently."
    } ]
  }, {
    "tStartMs": 1148670,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "- Okay, so carefully removing\nstuff from the zipper."
    } ]
  }, {
    "tStartMs": 1150450,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "- Yeah, yeah."
    } ]
  }, {
    "tStartMs": 1151340,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Because my first reaction is just like,"
    } ]
  }, {
    "tStartMs": 1153800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "try and jam over the slider."
    } ]
  }, {
    "tStartMs": 1155660,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "So you're saying I shouldn't do that?"
    } ]
  }, {
    "tStartMs": 1156620,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "- Yeah, no."
    } ]
  }, {
    "tStartMs": 1158626,
    "dDurationMs": 1594,
    "segs": [ {
      "utf8": "Move it carefully."
    } ]
  }, {
    "tStartMs": 1160220,
    "dDurationMs": 864,
    "segs": [ {
      "utf8": "- Carefully!"
    } ]
  }, {
    "tStartMs": 1162200,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And if there isn't any visible\ndebris causing the zipper"
    } ]
  }, {
    "tStartMs": 1164750,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to get stuck,"
    } ]
  }, {
    "tStartMs": 1165583,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "you can try lubricating the\narea with graphite from a pencil"
    } ]
  }, {
    "tStartMs": 1168620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in order to get the slider moving again,"
    } ]
  }, {
    "tStartMs": 1170270,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "because it's a great dry lubricant."
    } ]
  }, {
    "tStartMs": 1172130,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But probably the most\nannoying zipper problem"
    } ]
  }, {
    "tStartMs": 1174050,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "is when a zipper unzips on\nboth sides of the slider."
    } ]
  }, {
    "tStartMs": 1176780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- This usually happens when the slider"
    } ]
  }, {
    "tStartMs": 1178700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "becomes worn or bent,"
    } ]
  }, {
    "tStartMs": 1180380,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and can no longer apply enough pressure"
    } ]
  }, {
    "tStartMs": 1182990,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "to properly interlock the\nzipper elements as a result."
    } ]
  }, {
    "tStartMs": 1186860,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So the zipper chain\nseparates behind the slider."
    } ]
  }, {
    "tStartMs": 1190130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- A worn down slider is something"
    } ]
  }, {
    "tStartMs": 1191330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "you might be able to fix at home."
    } ]
  }, {
    "tStartMs": 1192800,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Just take some pliers"
    } ]
  }, {
    "tStartMs": 1193880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and crimp the slider\ntogether from the sides."
    } ]
  }, {
    "tStartMs": 1196460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "That will make the inner\ncavity more narrow,"
    } ]
  }, {
    "tStartMs": 1198410,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "just like when it was new,"
    } ]
  }, {
    "tStartMs": 1199610,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which should make it bring\nthe teeth together again."
    } ]
  }, {
    "tStartMs": 1201710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Just don't crimp it too tightly."
    } ]
  }, {
    "tStartMs": 1204080,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "I just can't get over the fact"
    } ]
  }, {
    "tStartMs": 1205373,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "that the first patent\nGideon Sundback submitted"
    } ]
  }, {
    "tStartMs": 1207950,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "was around 1914,"
    } ]
  }, {
    "tStartMs": 1209517,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and in those 112 years\nso many other devices"
    } ]
  }, {
    "tStartMs": 1214640,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that we've invented have been\ncompletely transformed,"
    } ]
  }, {
    "tStartMs": 1217250,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "got better, got faster, cheaper,"
    } ]
  }, {
    "tStartMs": 1219650,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "but it seems like the zipper\nis mostly just the same."
    } ]
  }, {
    "tStartMs": 1223033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So it's just that Sundback's\ndesign was that good?"
    } ]
  }, {
    "tStartMs": 1226633,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "- It's that good."
    } ]
  }, {
    "tStartMs": 1227660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "(Robert laughing)"
    } ]
  }, {
    "tStartMs": 1228860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I don't have any better explanation."
    } ]
  }, {
    "tStartMs": 1230450,
    "dDurationMs": 1962,
    "segs": [ {
      "utf8": "It really is. It's that good."
    } ]
  } ]
}
