  "events": [ {
    "tStartMs": 1270,
    "dDurationMs": 2989,
    "segs": [ {
      "utf8": "We are doing a buoyancy experiment today"
    } ]
  }, {
    "tStartMs": 4299,
    "dDurationMs": 6169,
    "segs": [ {
      "utf8": "If you drop a golf ball into some dishwashing liquid it sinks, very slowly"
    } ]
  }, {
    "tStartMs": 10468,
    "dDurationMs": 2332,
    "segs": [ {
      "utf8": "So why does it sink in the detergent?"
    } ]
  }, {
    "tStartMs": 12820,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "Because the golf ball is more heavy than the liquid that’s in the container— then the detergent."
    } ]
  }, {
    "tStartMs": 19420,
    "dDurationMs": 7400,
    "segs": [ {
      "utf8": "What do you mean heavier ? Can you elaborate on that at all ? umm probably more dense ? Good. And if I put this in this is saltwater…"
    } ]
  }, {
    "tStartMs": 27180,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "How salt is it ? It's very salty, huh ?"
    } ]
  }, {
    "tStartMs": 29640,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "This is the  saltiest salt water you can make. Okay. And I think it’s saturated solution. What will it do?"
    } ]
  }, {
    "tStartMs": 34740,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "I think it would be floating. Okay, lets have a look… ooh, oh"
    } ]
  }, {
    "tStartMs": 40720,
    "dDurationMs": 5179,
    "segs": [ {
      "utf8": "Excellent, so the golf ball floats in the salt water… And if you have a look it’s like it’s just is sticking out just a little bit."
    } ]
  }, {
    "tStartMs": 45899,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So what does that tell you about it?"
    } ]
  }, {
    "tStartMs": 53110,
    "dDurationMs": 4039,
    "segs": [ {
      "utf8": "It’s just slightly less dense right? Like it was a lot less dense to when it’s higher."
    } ]
  }, {
    "tStartMs": 57149,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "Yeah, the question is if we now take the detergent and we pour it in on top of the golf ball."
    } ]
  }, {
    "tStartMs": 63879,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "What do you think will happen? Will the golf ball stay where it is ? Will it go down ? Or will it go up ?"
    } ]
  }, {
    "tStartMs": 68790,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I think it’ll go down a little bit."
    } ]
  }, {
    "tStartMs": 71110,
    "dDurationMs": 3229,
    "segs": [ {
      "utf8": "Yeah, why do you think that ? Well ? No let’s see."
    } ]
  }, {
    "tStartMs": 76000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Whites lighter."
    } ]
  }, {
    "tStartMs": 77920,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "Maybe it'll go up. I have no idea. I think it will go down a little bit."
    } ]
  }, {
    "tStartMs": 83460,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Do you think this is going to mix with that ? Well that's what I was thinking about"
    } ]
  }, {
    "tStartMs": 86790,
    "dDurationMs": 4469,
    "segs": [ {
      "utf8": "I wonder if it’s gonna mix or if it’s gonna layer itself, and just, sort of sit on top here."
    } ]
  }, {
    "tStartMs": 91259,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Yeah, I think this would be"
    } ]
  }, {
    "tStartMs": 94659,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "standing up, on top."
    } ]
  }, {
    "tStartMs": 96729,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "So you can make your prediction by clicking on one of the on-screen annotations or you can click a link in the description."
    } ]
  }, {
    "tStartMs": 102420,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "But make your prediction now. What do you think is Gonna happen to this golf ball ? Ready in three, two, one."
    } ]
  } ]
}
