{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 11,
    "dDurationMs": 1249,
    "segs": [ {
      "utf8": "(brooding music)"
    } ]
  }, {
    "tStartMs": 1260,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- Most plane doors aren't locked."
    } ]
  }, {
    "tStartMs": 3690,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "There are no keys, no sensors\nor passcodes to secure them."
    } ]
  }, {
    "tStartMs": 7620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "If someone wants to pull\nthe lever, they can."
    } ]
  }, {
    "tStartMs": 10380,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- A man opened the emergency exit door"
    } ]
  }, {
    "tStartMs": 12810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and forced his way off the plane."
    } ]
  }, {
    "tStartMs": 15090,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- And yet with 40 million\nflights each year,"
    } ]
  }, {
    "tStartMs": 17940,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "these doors are virtually\nnever opened in flight."
    } ]
  }, {
    "tStartMs": 21390,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So, why not?"
    } ]
  }, {
    "tStartMs": 22680,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Your self preservation, surely."
    } ]
  }, {
    "tStartMs": 24270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Common sense."
    } ]
  }, {
    "tStartMs": 25103,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- Most people are, you know, smart enough"
    } ]
  }, {
    "tStartMs": 26520,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "to not mess with that."
    } ]
  }, {
    "tStartMs": 29910,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "- The real answer relies\non where planes fly."
    } ]
  }, {
    "tStartMs": 34110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- How high do planes fly approximately?"
    } ]
  }, {
    "tStartMs": 36510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- 10,000 km or\nis that overshooting it?"
    } ]
  }, {
    "tStartMs": 38880,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- I think that's overshooting it."
    } ]
  }, {
    "tStartMs": 40140,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "I think you'd be in space."
    } ]
  }, {
    "tStartMs": 41977,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "- 25,000 km."
    } ]
  }, {
    "tStartMs": 43770,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's the height of a plane flying?"
    } ]
  }, {
    "tStartMs": 45210,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Is that way too low?"
    } ]
  }, {
    "tStartMs": 46320,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- It's too much. It's too much."
    } ]
  }, {
    "tStartMs": 47820,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Too much. Too much."
    } ]
  }, {
    "tStartMs": 48653,
    "dDurationMs": 579,
    "segs": [ {
      "utf8": "Bring it down."
    } ]
  }, {
    "tStartMs": 49232,
    "dDurationMs": 1506,
    "segs": [ {
      "utf8": "- Maybe yeah, 1,000 km?"
    } ]
  }, {
    "tStartMs": 50738,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "- 1,000 km, still space."
    } ]
  }, {
    "tStartMs": 52940,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "- 50,000 ft, I think."
    } ]
  }, {
    "tStartMs": 54570,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "- Yeah, some of them can\ngo up to 43,000 ft."
    } ]
  }, {
    "tStartMs": 57364,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- 30,000 ft."
    } ]
  }, {
    "tStartMs": 58197,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "- 38,000 ft."
    } ]
  }, {
    "tStartMs": 59400,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 59900,
    "dDurationMs": 2362,
    "segs": [ {
      "utf8": "Why do they fly that high?"
    } ]
  }, {
    "tStartMs": 62262,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Uhh..."
    } ]
  }, {
    "tStartMs": 63672,
    "dDurationMs": 2028,
    "segs": [ {
      "utf8": "- I don't know. Safety, I guess."
    } ]
  }, {
    "tStartMs": 65700,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- Probably to avoid\ncollision with other aircraft"
    } ]
  }, {
    "tStartMs": 69090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and if there's high mountain ranges."
    } ]
  }, {
    "tStartMs": 71010,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- I don't know,\nwhen storms or weather hit?"
    } ]
  }, {
    "tStartMs": 73710,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- My guess is to avoid\nthe turbulent weather."
    } ]
  }, {
    "tStartMs": 77790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- I think that's a decent guess."
    } ]
  }, {
    "tStartMs": 80040,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Now, it's true that one of the benefits"
    } ]
  }, {
    "tStartMs": 81690,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "of flying at 30,000 ft is a smoother ride."
    } ]
  }, {
    "tStartMs": 84510,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This is high in the troposphere,"
    } ]
  }, {
    "tStartMs": 86430,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the layer in which most weather occurs."
    } ]
  }, {
    "tStartMs": 88920,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So, there's less turbulence"
    } ]
  }, {
    "tStartMs": 90330,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and fewer storms to navigate around."
    } ]
  }, {
    "tStartMs": 93210,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "But this is not the main\nreason that planes fly so high."
    } ]
  }, {
    "tStartMs": 97260,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "The bigger reason, of course, is money."
    } ]
  }, {
    "tStartMs": 100350,
    "dDurationMs": 2552,
    "segs": [ {
      "utf8": "As you go up, the density of air decreases"
    } ]
  }, {
    "tStartMs": 102902,
    "dDurationMs": 3058,
    "segs": [ {
      "utf8": "and at 33,000 ft or 10 km,"
    } ]
  }, {
    "tStartMs": 105960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the density of air is just a third"
    } ]
  }, {
    "tStartMs": 108300,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of what it is at sea level."
    } ]
  }, {
    "tStartMs": 110190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So flying at this altitude,"
    } ]
  }, {
    "tStartMs": 111840,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the plane runs into a third\nof the air molecules it would"
    } ]
  }, {
    "tStartMs": 115260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "closer to the ground."
    } ]
  }, {
    "tStartMs": 116880,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "That means the plane\ncan fly about 73% faster"
    } ]
  }, {
    "tStartMs": 119940,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for the same amount of thrust."
    } ]
  }, {
    "tStartMs": 122130,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And as a result, you get\nto your destination faster"
    } ]
  }, {
    "tStartMs": 125100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and since you spend less time in the air,"
    } ]
  }, {
    "tStartMs": 127800,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you burn less fuel."
    } ]
  }, {
    "tStartMs": 130110,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It seems in a way that like\nclimbing is wasted energy."
    } ]
  }, {
    "tStartMs": 134550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Can you compare like the\ndescent to the ascent?"
    } ]
  }, {
    "tStartMs": 136890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Do you essentially get the energy back"
    } ]
  }, {
    "tStartMs": 138840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "as you fall down the other side?"
    } ]
  }, {
    "tStartMs": 140670,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 141170,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "When we climb, we burn\nabout 80 kilos per minute."
    } ]
  }, {
    "tStartMs": 143970,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "In cruise, we burn about\n40 kilos per minute."
    } ]
  }, {
    "tStartMs": 146100,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And in descent, it's maybe 10."
    } ]
  }, {
    "tStartMs": 149340,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, it's almost negligible."
    } ]
  }, {
    "tStartMs": 152160,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "- Not only that, jet engines\nare more efficient at altitude."
    } ]
  }, {
    "tStartMs": 156270,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They work by compressing\nair at the intake,"
    } ]
  }, {
    "tStartMs": 158730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "mixing it with fuel and igniting it."
    } ]
  }, {
    "tStartMs": 160740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So, the combustion products\nare ejected very fast"
    } ]
  }, {
    "tStartMs": 163380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "from the exhaust nozzle."
    } ]
  }, {
    "tStartMs": 165540,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "Now, this process is more\nefficient the colder the air is."
    } ]
  }, {
    "tStartMs": 170280,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And at altitude, the temperature"
    } ]
  }, {
    "tStartMs": 171990,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "is around minus 50 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 174660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "which is a lot colder\nthan an average of plus 15"
    } ]
  }, {
    "tStartMs": 177390,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "here at the ground."
    } ]
  }, {
    "tStartMs": 178860,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "So, flying higher means you\nburn less fuel for less time"
    } ]
  }, {
    "tStartMs": 183450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and avoid the weather\nand associated turbulence"
    } ]
  }, {
    "tStartMs": 185970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of lower altitudes."
    } ]
  }, {
    "tStartMs": 187770,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- The other reason you wanna fly high"
    } ]
  }, {
    "tStartMs": 189510,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "is to take advantage of\nthe jet stream tailwinds"
    } ]
  }, {
    "tStartMs": 192780,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and the company likes people who do that,"
    } ]
  }, {
    "tStartMs": 194520,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "because you're burning less fuel,"
    } ]
  }, {
    "tStartMs": 195660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "so it's less money."
    } ]
  }, {
    "tStartMs": 198270,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- But there is a problem\nwith flying this high."
    } ]
  }, {
    "tStartMs": 201300,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The air up there is unbreathable."
    } ]
  }, {
    "tStartMs": 204180,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If you were suddenly teleported"
    } ]
  }, {
    "tStartMs": 205920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "to the top of Mount Everest, a\nheight lower than planes fly,"
    } ]
  }, {
    "tStartMs": 209760,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "you would remain conscious\nfor only about three minutes."
    } ]
  }, {
    "tStartMs": 213720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This is because in addition"
    } ]
  }, {
    "tStartMs": 215220,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "to density dropping with\naltitude, so does air pressure."
    } ]
  }, {
    "tStartMs": 219090,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Air pressure actually falls off faster,"
    } ]
  }, {
    "tStartMs": 220740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "because it depends on the\nweight of all the air above you."
    } ]
  }, {
    "tStartMs": 223710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So at 10 km, the air pressure"
    } ]
  }, {
    "tStartMs": 225720,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "is only a quarter of\nwhat it is at sea level."
    } ]
  }, {
    "tStartMs": 229650,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "To be clear, the air is still 21% oxygen,"
    } ]
  }, {
    "tStartMs": 233010,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but the partial pressure of oxygen,"
    } ]
  }, {
    "tStartMs": 235140,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the pressure exerted\nsolely by oxygen molecules"
    } ]
  }, {
    "tStartMs": 237870,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "is around 5.5 kilopascals,"
    } ]
  }, {
    "tStartMs": 240570,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "which is a quarter of\nwhat it is on the ground."
    } ]
  }, {
    "tStartMs": 243240,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Now at this pressure, not\nenough oxygen molecules"
    } ]
  }, {
    "tStartMs": 246060,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "can force their way into\nyour blood in your lungs."
    } ]
  }, {
    "tStartMs": 249450,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "To function normally, humans\nneed an oxygen partial pressure"
    } ]
  }, {
    "tStartMs": 253050,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "of at least 16 kilopascals."
    } ]
  }, {
    "tStartMs": 256080,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, all the cabins of airplanes"
    } ]
  }, {
    "tStartMs": 257850,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "that cruise at high altitude\nmust be pressurized."
    } ]
  }, {
    "tStartMs": 261660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "A little bit of air is\ncontinuously brought"
    } ]
  }, {
    "tStartMs": 263970,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "into the cabin from outside."
    } ]
  }, {
    "tStartMs": 265800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It actually comes in from\nthe compression stage"
    } ]
  }, {
    "tStartMs": 268380,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "of the jet engines."
    } ]
  }, {
    "tStartMs": 269850,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "That is what maintains\nbreathable air inside the plane."
    } ]
  }, {
    "tStartMs": 274380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- The downside is that you are taking away"
    } ]
  }, {
    "tStartMs": 276390,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "a little bit of the\nefficiency of the engines."
    } ]
  }, {
    "tStartMs": 279300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Now, pressurizing the cabin"
    } ]
  }, {
    "tStartMs": 280980,
    "dDurationMs": 2986,
    "segs": [ {
      "utf8": "required a radical redesign of aircraft."
    } ]
  }, {
    "tStartMs": 283966,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "Before pressurization, planes would fly"
    } ]
  }, {
    "tStartMs": 286710,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "up to 10,000 feet or\naround three kilometers,"
    } ]
  }, {
    "tStartMs": 289560,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "where the partial pressure\nof oxygen is 15 kilopascals,"
    } ]
  }, {
    "tStartMs": 293100,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "just at the limit of\nwhat people can handle."
    } ]
  }, {
    "tStartMs": 296010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "On these planes, doors opened outward"
    } ]
  }, {
    "tStartMs": 298530,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and there wasn't much concern\nabout the seal around them"
    } ]
  }, {
    "tStartMs": 301260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "since the pressure was\nthe same on both sides."
    } ]
  }, {
    "tStartMs": 304050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But once planes were pressurized,"
    } ]
  }, {
    "tStartMs": 306270,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "all the doors were changed\nto be the shape of a plug."
    } ]
  }, {
    "tStartMs": 309990,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "They're wider on the\ninside than the outside."
    } ]
  }, {
    "tStartMs": 312930,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "That way the higher\npressure inside the cabin"
    } ]
  }, {
    "tStartMs": 315180,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "pushes the door into its frame,\ncreating an airtight seal."
    } ]
  }, {
    "tStartMs": 320190,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "How airtight is a cabin?"
    } ]
  }, {
    "tStartMs": 322020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- It's pretty airtight, but\nnot completely airtight."
    } ]
  }, {
    "tStartMs": 324660,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So,  you'll notice for example,"
    } ]
  }, {
    "tStartMs": 326070,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "every time that someone\nflushes the toilet,"
    } ]
  }, {
    "tStartMs": 328470,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "you'll see some of the\nair pressure go down."
    } ]
  }, {
    "tStartMs": 330120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So every time that happens,"
    } ]
  }, {
    "tStartMs": 331560,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "you can actually see the cabin\naltitude jump a little bit."
    } ]
  }, {
    "tStartMs": 334890,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- And this is why plane doors\nand emergency exit doors"
    } ]
  }, {
    "tStartMs": 338400,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "don't need locks."
    } ]
  }, {
    "tStartMs": 339870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The difference in pressure\nbetween the pressurized cabin"
    } ]
  }, {
    "tStartMs": 342420,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and the low pressure exterior is so great"
    } ]
  }, {
    "tStartMs": 345240,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "that no one is strong enough\nto pull the door inwards."
    } ]
  }, {
    "tStartMs": 350430,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And if someone had come up"
    } ]
  }, {
    "tStartMs": 351510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and turned that while\nyou're mid-flight? "
    } ]
  }, {
    "tStartMs": 354001,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "Nothing."
    } ]
  }, {
    "tStartMs": 355230,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- Even modern plane\ndoors that open outward"
    } ]
  }, {
    "tStartMs": 357660,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "are shaped like plugs."
    } ]
  }, {
    "tStartMs": 359430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "They're just cleverly designed."
    } ]
  }, {
    "tStartMs": 361530,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The main passenger door on a Boeing 737"
    } ]
  }, {
    "tStartMs": 363990,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "is both wider and taller\nthan the frame it needs"
    } ]
  }, {
    "tStartMs": 366720,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "to pass through."
    } ]
  }, {
    "tStartMs": 367950,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But when you pull the lever,"
    } ]
  }, {
    "tStartMs": 369480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "gates at the top and bottom fold in,"
    } ]
  }, {
    "tStartMs": 371850,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "reducing the height just enough."
    } ]
  }, {
    "tStartMs": 374220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "However, the sides are still too wide."
    } ]
  }, {
    "tStartMs": 377250,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "So, the door first has\nto pop inside and rotate."
    } ]
  }, {
    "tStartMs": 380940,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "It's that movement inwards\nthat is impossible at altitude."
    } ]
  }, {
    "tStartMs": 384930,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It would require a force equivalent"
    } ]
  }, {
    "tStartMs": 386940,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "to lifting 9,000 kilograms."
    } ]
  }, {
    "tStartMs": 390960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And airplane cabins aren't\neven fully pressurized"
    } ]
  }, {
    "tStartMs": 393600,
    "dDurationMs": 3357,
    "segs": [ {
      "utf8": "to the sea level pressure\nof 101.3 kilopascals."
    } ]
  }, {
    "tStartMs": 396957,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "You may have noticed this"
    } ]
  }, {
    "tStartMs": 398070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "if you take a bag of chips on a plane."
    } ]
  }, {
    "tStartMs": 400380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It's easy to squish on the ground"
    } ]
  }, {
    "tStartMs": 402480,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "but as the plane climbs, the\npressure in the cabin drops"
    } ]
  }, {
    "tStartMs": 405490,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and the chip bag seems to\ninflate like a balloon."
    } ]
  }, {
    "tStartMs": 409170,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I measured the pressure in my plane"
    } ]
  }, {
    "tStartMs": 410760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and at cruising altitude,"
    } ]
  }, {
    "tStartMs": 411960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the pressure dropped to 77 kilopascals."
    } ]
  }, {
    "tStartMs": 415080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Meaning the partial pressure of oxygen "
    } ]
  }, {
    "tStartMs": 416880,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "was only 16 kilopascals,"
    } ]
  }, {
    "tStartMs": 419370,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the minimum required for people\non the plane to feel normal."
    } ]
  }, {
    "tStartMs": 423390,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "This has some unintended consequences."
    } ]
  }, {
    "tStartMs": 426990,
    "dDurationMs": 2037,
    "segs": [ {
      "utf8": "Do you think you fart more in a plane?"
    } ]
  }, {
    "tStartMs": 429027,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "(interviewee laughing)"
    } ]
  }, {
    "tStartMs": 430980,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- If I did, I'd blame someone else."
    } ]
  }, {
    "tStartMs": 433890,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- I feel like no."
    } ]
  }, {
    "tStartMs": 435180,
    "dDurationMs": 687,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 435867,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "- No"
    } ]
  }, {
    "tStartMs": 436367,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "- I can't let it rip, no way in the world."
    } ]
  }, {
    "tStartMs": 438000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Do you think you fart more in\na plane than on the ground?"
    } ]
  }, {
    "tStartMs": 440580,
    "dDurationMs": 3984,
    "segs": [ {
      "utf8": "- A hundred percent, no hesitation."
    } ]
  }, {
    "tStartMs": 444564,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Sure, I mean it's gotta do\nwith the cabin pressure, right?"
    } ]
  }, {
    "tStartMs": 446754,
    "dDurationMs": 4716,
    "segs": [ {
      "utf8": "- So as you go up, that\ncavity in here now expands"
    } ]
  }, {
    "tStartMs": 451470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and the air wants to go somewhere,"
    } ]
  }, {
    "tStartMs": 453270,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "and the quickest place it can go is south."
    } ]
  }, {
    "tStartMs": 457560,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "- Bag of chips just popped by itself."
    } ]
  }, {
    "tStartMs": 462840,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- Now, the International\nSpace Station is pressurized"
    } ]
  }, {
    "tStartMs": 465750,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "to sea level pressure, 101.3 kilopascals."
    } ]
  }, {
    "tStartMs": 469650,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, why are planes pressurized"
    } ]
  }, {
    "tStartMs": 471900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "to the minimum extent possible"
    } ]
  }, {
    "tStartMs": 473250,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to carry human passengers?"
    } ]
  }, {
    "tStartMs": 475110,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "Well, it's actually\nfor a very good reason."
    } ]
  }, {
    "tStartMs": 478500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "In 1988, Aloha Airlines 243"
    } ]
  }, {
    "tStartMs": 481320,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "was en route from Hilo\nto Honolulu, Hawaii."
    } ]
  }, {
    "tStartMs": 484830,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The cabin was being\npressurized as we've described,"
    } ]
  }, {
    "tStartMs": 488040,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "but unfortunately, this plane's\nfuselage had a small crack"
    } ]
  }, {
    "tStartMs": 493020,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and all of a sudden at 24,000 feet,"
    } ]
  }, {
    "tStartMs": 495870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the crack widened and the whole roof"
    } ]
  }, {
    "tStartMs": 498510,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "tore off the front of the plane."
    } ]
  }, {
    "tStartMs": 501420,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Miraculously the pilots\nwere able to land safely"
    } ]
  }, {
    "tStartMs": 504690,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "and only one person was killed."
    } ]
  }, {
    "tStartMs": 508380,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The difference between the\nInternational Space Station"
    } ]
  }, {
    "tStartMs": 510930,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and a plane is that the\nISS was pressurized once"
    } ]
  }, {
    "tStartMs": 514560,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and it stays pressurized."
    } ]
  }, {
    "tStartMs": 516870,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But a plane experiences\na pressure difference"
    } ]
  }, {
    "tStartMs": 519540,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "every time it climbs to cruising altitude."
    } ]
  }, {
    "tStartMs": 522060,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, the fuselage is stretched"
    } ]
  }, {
    "tStartMs": 524490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and then relaxed with every flight."
    } ]
  }, {
    "tStartMs": 527040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Stretched and relaxed,\nstretched and relaxed."
    } ]
  }, {
    "tStartMs": 529980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The Aloha Airlines plane"
    } ]
  }, {
    "tStartMs": 531600,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "had the second highest 737\nflight cycle count in the world,"
    } ]
  }, {
    "tStartMs": 535590,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "with nearly 90,000 in total."
    } ]
  }, {
    "tStartMs": 538320,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That's way more than it was designed for."
    } ]
  }, {
    "tStartMs": 541560,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This led to fatigue, cracking, corrosion,"
    } ]
  }, {
    "tStartMs": 544470,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and the eventual explosive decompression."
    } ]
  }, {
    "tStartMs": 547350,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So, planes are pressurized\nto the least extent possible"
    } ]
  }, {
    "tStartMs": 550410,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "to minimize stresses and\nextend the life of the plane."
    } ]
  }, {
    "tStartMs": 554610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But even 75% of atmospheric pressure"
    } ]
  }, {
    "tStartMs": 557460,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "should be plenty to prevent\nthe doors from opening."
    } ]
  }, {
    "tStartMs": 560850,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "So, how did this happen in May, 2023?"
    } ]
  }, {
    "tStartMs": 566070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- A passenger panicked\nand actually managed"
    } ]
  }, {
    "tStartMs": 568860,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to open an Airbus\nemergency exit in flight."
    } ]
  }, {
    "tStartMs": 571950,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "They were on final approach"
    } ]
  }, {
    "tStartMs": 573150,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and they were quite close to the ground,"
    } ]
  }, {
    "tStartMs": 574500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so the pressure differential\nwas very little."
    } ]
  }, {
    "tStartMs": 576750,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And because of him using all of his force,"
    } ]
  }, {
    "tStartMs": 580110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "he actually managed to get\nthe door open, which was crazy"
    } ]
  }, {
    "tStartMs": 583020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and we didn't think\nthat that was possible."
    } ]
  }, {
    "tStartMs": 585900,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But if you want something\nbad enough, I guess it is."
    } ]
  }, {
    "tStartMs": 589140,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 590070,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Was he okay?"
    } ]
  }, {
    "tStartMs": 591150,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- He was okay. Everyone\nwas okay in that case."
    } ]
  }, {
    "tStartMs": 594180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- That was a pretty serious mishap."
    } ]
  }, {
    "tStartMs": 596430,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So, I guess the next logical question is: "
    } ]
  }, {
    "tStartMs": 598260,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Have any other passengers\ninadvertently caused a mishap, "
    } ]
  }, {
    "tStartMs": 601800,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "by say, forgetting to put\ntheir phone on airplane mode?"
    } ]
  }, {
    "tStartMs": 605490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "When you're sitting there on the tarmac"
    } ]
  }, {
    "tStartMs": 607380,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "and they come on and tell you"
    } ]
  }, {
    "tStartMs": 608220,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to put your phone on\nairplane mode, do you do it?"
    } ]
  }, {
    "tStartMs": 611310,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And why do they get us to do that?"
    } ]
  }, {
    "tStartMs": 615030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "What is the reason? Is there a reason?"
    } ]
  }, {
    "tStartMs": 617220,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "- Obviously, they\nwouldn't ask you to do it"
    } ]
  }, {
    "tStartMs": 619370,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "if it wasn't for some benefit."
    } ]
  }, {
    "tStartMs": 621060,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- I'm unfortunately a bit of a rebel"
    } ]
  }, {
    "tStartMs": 622530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and I don't follow the rules and yeah."
    } ]
  }, {
    "tStartMs": 624750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- But you're not worried\nabout taking the plane down?"
    } ]
  }, {
    "tStartMs": 626580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- I'd make sure my parents\nhave the airplane mode on"
    } ]
  }, {
    "tStartMs": 629130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "so I can have it off."
    } ]
  }, {
    "tStartMs": 630330,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- I mean, yes I do because\nI don't want it interfering"
    } ]
  }, {
    "tStartMs": 632760,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "with like the radio or whatever."
    } ]
  }, {
    "tStartMs": 634563,
    "dDurationMs": 4017,
    "segs": [ {
      "utf8": "- Well, I think it's the\ncommunication interference."
    } ]
  }, {
    "tStartMs": 638580,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- I feel like I've always been told"
    } ]
  }, {
    "tStartMs": 639900,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "like it messes up like instruments,"
    } ]
  }, {
    "tStartMs": 643380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but honestly you're\nalways just told to do it."
    } ]
  }, {
    "tStartMs": 645900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So you know, just gotta put\nyour phone in  airplane mode."
    } ]
  }, {
    "tStartMs": 648660,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "- In 1961, the Federal\nAviation Administration or FAA"
    } ]
  }, {
    "tStartMs": 653070,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "found that some portable FM radios"
    } ]
  }, {
    "tStartMs": 655200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "could interfere with\nplane navigation systems"
    } ]
  }, {
    "tStartMs": 657450,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "since they used neighboring radio bands."
    } ]
  }, {
    "tStartMs": 660060,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And out of caution, they banned"
    } ]
  }, {
    "tStartMs": 662010,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "almost all personal\nelectronics on flights."
    } ]
  }, {
    "tStartMs": 664946,
    "dDurationMs": 3424,
    "segs": [ {
      "utf8": "But airlines could test\nany device for interference"
    } ]
  }, {
    "tStartMs": 668370,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and overrule the FAA ban\nto allow it on board."
    } ]
  }, {
    "tStartMs": 672420,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Any device, that is, except a phone,"
    } ]
  }, {
    "tStartMs": 675600,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "because another organization\nhas jurisdiction over phones"
    } ]
  }, {
    "tStartMs": 679110,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "and that's the Federal\nCommunications Commission, or FCC."
    } ]
  }, {
    "tStartMs": 684480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "See a phone on the ground"
    } ]
  }, {
    "tStartMs": 685980,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "with buildings and hills around it"
    } ]
  }, {
    "tStartMs": 687720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "can usually only see\none or two cell towers"
    } ]
  }, {
    "tStartMs": 690420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "at the same time."
    } ]
  }, {
    "tStartMs": 691830,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "But from the air, it could\nsee 10 or 20 or more."
    } ]
  }, {
    "tStartMs": 695850,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The concern was that 200 phones"
    } ]
  }, {
    "tStartMs": 698070,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "traveling at 800 kilometers\nper hour in a plane"
    } ]
  }, {
    "tStartMs": 700890,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "could rapidly connect\nto many towers at once,"
    } ]
  }, {
    "tStartMs": 703920,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "overloading the infrastructure."
    } ]
  }, {
    "tStartMs": 705930,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "At least that's what the\nFCC thought could happen."
    } ]
  }, {
    "tStartMs": 708660,
    "dDurationMs": 3649,
    "segs": [ {
      "utf8": "So, they banned cell phone\nuse in flight in 1991."
    } ]
  }, {
    "tStartMs": 712309,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "(funky music)"
    } ]
  }, {
    "tStartMs": 714870,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "But there's a problem with this theory."
    } ]
  }, {
    "tStartMs": 718260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "A plane is a big metal enclosure,"
    } ]
  }, {
    "tStartMs": 720750,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "essentially a Faraday cage."
    } ]
  }, {
    "tStartMs": 722970,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So, it should block almost\nall electromagnetic signals."
    } ]
  }, {
    "tStartMs": 726150,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "That's why plane antennas\nare located on the outside."
    } ]
  }, {
    "tStartMs": 729540,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Your phone signals can only\nescape through the windows,"
    } ]
  }, {
    "tStartMs": 732480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "which means they go horizontally\nout the sides of the plane."
    } ]
  }, {
    "tStartMs": 736080,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "So, they would have to\ntravel long distances"
    } ]
  }, {
    "tStartMs": 737489,
    "dDurationMs": 2311,
    "segs": [ {
      "utf8": "before reaching the ground."
    } ]
  }, {
    "tStartMs": 739800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And the cell towers your\nphone is trying to connect to,"
    } ]
  }, {
    "tStartMs": 742440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "well they are tilted downwards, you know,"
    } ]
  }, {
    "tStartMs": 744780,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to collect all the signals from people"
    } ]
  }, {
    "tStartMs": 746850,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "walking around on the ground."
    } ]
  }, {
    "tStartMs": 748530,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, it's very hard to make\na connection from the air"
    } ]
  }, {
    "tStartMs": 751530,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "unless you're flying really low."
    } ]
  }, {
    "tStartMs": 754080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, phones could only conceivably\ndisrupt ground networks"
    } ]
  }, {
    "tStartMs": 756900,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "during takeoff or landing."
    } ]
  }, {
    "tStartMs": 758850,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And the FCC never even\ntested if this was the case."
    } ]
  }, {
    "tStartMs": 762570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In 2005, they went\nbefore Congress and said"
    } ]
  }, {
    "tStartMs": 765210,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the rule banning 800 MHz\ncell phone use in flight"
    } ]
  }, {
    "tStartMs": 768060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "may not be needed in order"
    } ]
  }, {
    "tStartMs": 769560,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "to protect ground-based cellular networks."
    } ]
  }, {
    "tStartMs": 774120,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "As far as we know,"
    } ]
  }, {
    "tStartMs": 774953,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "a mobile phone has never\ncaused an air accident."
    } ]
  }, {
    "tStartMs": 778020,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "All airplane mode does for\nsure is save your battery life."
    } ]
  }, {
    "tStartMs": 782310,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, why are these rules still around?"
    } ]
  }, {
    "tStartMs": 785190,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- I've been flying myself"
    } ]
  }, {
    "tStartMs": 786480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and where I've gotten interference,"
    } ]
  }, {
    "tStartMs": 788460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "you know, when you're\ntalking to a traffic control"
    } ]
  }, {
    "tStartMs": 790080,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "and you get that\n(imitating a phone signal),"
    } ]
  }, {
    "tStartMs": 793380,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "you know that signal,"
    } ]
  }, {
    "tStartMs": 794910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and that is because someone\nis either using their phone"
    } ]
  }, {
    "tStartMs": 797250,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "or the phone is on."
    } ]
  }, {
    "tStartMs": 798150,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "Will one phone in an\naircraft cause any problems?"
    } ]
  }, {
    "tStartMs": 802800,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Probably not."
    } ]
  }, {
    "tStartMs": 803633,
    "dDurationMs": 2977,
    "segs": [ {
      "utf8": "Will 200 do something?"
    } ]
  }, {
    "tStartMs": 806610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Maybe."
    } ]
  }, {
    "tStartMs": 807443,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "Rather than taking the\nchance of like, let's everyone"
    } ]
  }, {
    "tStartMs": 810540,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "update their Twitter profile at 500 feet,"
    } ]
  }, {
    "tStartMs": 813720,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "rather than saying that, we're saying no,"
    } ]
  }, {
    "tStartMs": 816030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "you know, just keep them off, you know,"
    } ]
  }, {
    "tStartMs": 817800,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "enjoy the Wi-Fi up at\naltitude and that's it."
    } ]
  }, {
    "tStartMs": 822450,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- But airplane mode might\nsoon be a thing of the past."
    } ]
  }, {
    "tStartMs": 825060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The EU actually no longer requires it"
    } ]
  }, {
    "tStartMs": 827730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and is pushing for airlines\nto provide 5G service"
    } ]
  }, {
    "tStartMs": 830400,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "on all EU flights."
    } ]
  }, {
    "tStartMs": 833160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So, we may eliminate that inconvenience,"
    } ]
  }, {
    "tStartMs": 835800,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but we still have to\ndeal with airplane food."
    } ]
  }, {
    "tStartMs": 838890,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "What do you think about airplane food?"
    } ]
  }, {
    "tStartMs": 840510,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- I only eat the bread rolls."
    } ]
  }, {
    "tStartMs": 842010,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "That's only thing I can handle."
    } ]
  }, {
    "tStartMs": 843300,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Apart from that, everything\ntastes like mush."
    } ]
  }, {
    "tStartMs": 844860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- It's can be very good.\nIt can be very terrible."
    } ]
  }, {
    "tStartMs": 847290,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- Eh, bland-ish, different consistency."
    } ]
  }, {
    "tStartMs": 850590,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Do you think the food\ntastes as good in a plane"
    } ]
  }, {
    "tStartMs": 852810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "as it would on the ground?"
    } ]
  }, {
    "tStartMs": 854370,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 856230,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "- But bad-tasting food might\nnot be all the airlines' fault."
    } ]
  }, {
    "tStartMs": 860340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "See, the air that's pumped\ninto the cabin altitude"
    } ]
  }, {
    "tStartMs": 862530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is really dry."
    } ]
  }, {
    "tStartMs": 864150,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And the Sahara Desert for reference"
    } ]
  }, {
    "tStartMs": 865860,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "has an average relative humidity of 25%,"
    } ]
  }, {
    "tStartMs": 869340,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "but inside an airplane cabin,\nit can be as low as 5%."
    } ]
  }, {
    "tStartMs": 874770,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This can dry out your nasal passages,"
    } ]
  }, {
    "tStartMs": 876990,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "hindering your sense of\nsmell and therefore taste."
    } ]
  }, {
    "tStartMs": 879900,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The lower cabin pressure\ncan also decrease sensations"
    } ]
  }, {
    "tStartMs": 883440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "like the intensity of salt and sugar."
    } ]
  }, {
    "tStartMs": 886410,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But there is one flavor\nthat appears to be enhanced"
    } ]
  }, {
    "tStartMs": 888930,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "in flight."
    } ]
  }, {
    "tStartMs": 891045,
    "dDurationMs": 1695,
    "segs": [ {
      "utf8": "What do you drink in an airplane?"
    } ]
  }, {
    "tStartMs": 892740,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "What's your drink of choice?"
    } ]
  }, {
    "tStartMs": 893700,
    "dDurationMs": 716,
    "segs": [ {
      "utf8": "- Apple juice."
    } ]
  }, {
    "tStartMs": 894416,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Apple juice?"
    } ]
  }, {
    "tStartMs": 895249,
    "dDurationMs": 599,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 895848,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Interesting."
    } ]
  }, {
    "tStartMs": 897032,
    "dDurationMs": 1408,
    "segs": [ {
      "utf8": "- I mean Coke, that's default"
    } ]
  }, {
    "tStartMs": 898440,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Orange or apple juice."
    } ]
  }, {
    "tStartMs": 900720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Gin and tonic."
    } ]
  }, {
    "tStartMs": 901553,
    "dDurationMs": 2124,
    "segs": [ {
      "utf8": "- Maybe a Bloody Mary, but..."
    } ]
  }, {
    "tStartMs": 903677,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "- You're the first one today."
    } ]
  }, {
    "tStartMs": 905520,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "- Really?"
    } ]
  }, {
    "tStartMs": 906020,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 907350,
    "dDurationMs": 2116,
    "segs": [ {
      "utf8": "A German survey of a thousand flyers"
    } ]
  }, {
    "tStartMs": 909466,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "found that more than a quarter of them"
    } ]
  }, {
    "tStartMs": 911550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "order tomato juice in flight."
    } ]
  }, {
    "tStartMs": 913980,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And what's really weird is\nthat 23% of those people"
    } ]
  }, {
    "tStartMs": 917490,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "would never drink it on the ground."
    } ]
  }, {
    "tStartMs": 920460,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And would you drink Bloody Mary,"
    } ]
  }, {
    "tStartMs": 921780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "would that be like a\nstandard drink at the bar"
    } ]
  }, {
    "tStartMs": 923460,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "or is it a special plane drink?"
    } ]
  }, {
    "tStartMs": 924960,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- I only have it on planes."
    } ]
  }, {
    "tStartMs": 926670,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- So, why is everyone\nordering tomato juice?"
    } ]
  }, {
    "tStartMs": 929790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Well, it could be because of the noise."
    } ]
  }, {
    "tStartMs": 933000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "A 2015 study points to the chorda tympani,"
    } ]
  }, {
    "tStartMs": 935610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "a nerve that carries taste information"
    } ]
  }, {
    "tStartMs": 937380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "from the tongue to the brainstem."
    } ]
  }, {
    "tStartMs": 939150,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It runs right past the eardrum,"
    } ]
  }, {
    "tStartMs": 941160,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "between the tiny sound conducting bones."
    } ]
  }, {
    "tStartMs": 943830,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So, loud cabin noise might\nunintentionally stimulate it."
    } ]
  }, {
    "tStartMs": 947930,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "This could produce an audio illusion"
    } ]
  }, {
    "tStartMs": 950430,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that boosts our sense of umami,"
    } ]
  }, {
    "tStartMs": 952710,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the savory taste you\nfind in MSG, soy sauce,"
    } ]
  }, {
    "tStartMs": 955650,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "and well, tomatoes."
    } ]
  }, {
    "tStartMs": 957752,
    "dDurationMs": 2968,
    "segs": [ {
      "utf8": "- I always drink tomato\njuice and I never knew why."
    } ]
  }, {
    "tStartMs": 960720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It just felt like my plane drink."
    } ]
  }, {
    "tStartMs": 962610,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Or like spicy tomato juice-"
    } ]
  }, {
    "tStartMs": 964200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 965033,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "- Like both of those\nare favorites of mine."
    } ]
  }, {
    "tStartMs": 967320,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 968310,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So, next time you're on a flight,"
    } ]
  }, {
    "tStartMs": 969810,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "go for something extra sweet or salty"
    } ]
  }, {
    "tStartMs": 972240,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "or maybe try the tomato juice."
    } ]
  }, {
    "tStartMs": 975150,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I feel like with how much people fly,"
    } ]
  }, {
    "tStartMs": 977070,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "our perspective of flying"
    } ]
  }, {
    "tStartMs": 978210,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is still pretty distorted."
    } ]
  }, {
    "tStartMs": 979830,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So, why is that?"
    } ]
  }, {
    "tStartMs": 981300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 982133,
    "dDurationMs": 3127,
    "segs": [ {
      "utf8": "I know that we talk a lot\nabout accidents and incidents"
    } ]
  }, {
    "tStartMs": 985260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and we dig into them really, really deep"
    } ]
  }, {
    "tStartMs": 987300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and people might ask, \"Why\nwould you be doing this?"
    } ]
  }, {
    "tStartMs": 990240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Doesn't that just make people\neven more afraid of flying?\""
    } ]
  }, {
    "tStartMs": 993240,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But the fact is that this\nis one of the prime reasons"
    } ]
  }, {
    "tStartMs": 996780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "why aviation is as safe as it is."
    } ]
  }, {
    "tStartMs": 998760,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The fact that we have\nhundreds of professionals"
    } ]
  }, {
    "tStartMs": 1001700,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that dig deep into these accidents"
    } ]
  }, {
    "tStartMs": 1003860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "means that we learn from them."
    } ]
  }, {
    "tStartMs": 1005450,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So, every flight becomes\na little bit safer."
    } ]
  }, {
    "tStartMs": 1008510,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "That's actually a big reason"
    } ]
  }, {
    "tStartMs": 1010250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that I started my channel\nMentour Pilot in the first place"
    } ]
  }, {
    "tStartMs": 1013190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "'cause I promise you, the more you know"
    } ]
  }, {
    "tStartMs": 1014870,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "the safer you'll feel."
    } ]
  }, {
    "tStartMs": 1016429,
    "dDurationMs": 3031,
    "segs": [ {
      "utf8": "(closing music)"
    } ]
  }, {
    "tStartMs": 1019460,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "- Do you think that climate\nchange increases turbulence?"
    } ]
  }, {
    "tStartMs": 1022771,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "- Eh, depends on what people\nthink about their opinions."
    } ]
  }, {
    "tStartMs": 1026650,
    "dDurationMs": 986,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1027636,
    "dDurationMs": 2414,
    "segs": [ {
      "utf8": "- It's been a bit of that in\nnews recently, hasn't there?"
    } ]
  }, {
    "tStartMs": 1030050,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Today, the media tends to prioritize"
    } ]
  }, {
    "tStartMs": 1032330,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "sensationalized headlines\nover key details."
    } ]
  }, {
    "tStartMs": 1035450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Part of why airplane mode is\nstill such a big deal today"
    } ]
  }, {
    "tStartMs": 1037850,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "is because of the media frenzy\nit started in the 1960s."
    } ]
  }, {
    "tStartMs": 1041780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So it's more important than ever"
    } ]
  }, {
    "tStartMs": 1043460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to look at all sides of the story."
    } ]
  }, {
    "tStartMs": 1045770,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "This is why we specifically\nasked Ground News"
    } ]
  }, {
    "tStartMs": 1048950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to sponsor this video."
    } ]
  }, {
    "tStartMs": 1050660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Recent stories about the\nincrease in turbulence"
    } ]
  }, {
    "tStartMs": 1053180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "come from a 2023 study"
    } ]
  }, {
    "tStartMs": 1055160,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that suggested a link to climate change."
    } ]
  }, {
    "tStartMs": 1057530,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Yet, this study was barely\nreported on by the media,"
    } ]
  }, {
    "tStartMs": 1059990,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "totally eclipsed by other major events."
    } ]
  }, {
    "tStartMs": 1062900,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But Ground News lets you\nsee the whole picture."
    } ]
  }, {
    "tStartMs": 1065180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You can easily compare the coverage"
    } ]
  }, {
    "tStartMs": 1066980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and verify the source of the information."
    } ]
  }, {
    "tStartMs": 1069230,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "If you look closer,"
    } ]
  }, {
    "tStartMs": 1070400,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "you'll see that some of the outlets,"
    } ]
  }, {
    "tStartMs": 1071750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "like The Independent and the SCMP,"
    } ]
  }, {
    "tStartMs": 1073640,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "argue that climate change is\nmaking flying more dangerous."
    } ]
  }, {
    "tStartMs": 1076970,
    "dDurationMs": 2699,
    "segs": [ {
      "utf8": "While others like the Free\nPress paint a different picture"
    } ]
  }, {
    "tStartMs": 1079669,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "by dismissing the study."
    } ]
  }, {
    "tStartMs": 1081710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "That's why it's really important"
    } ]
  }, {
    "tStartMs": 1083240,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to look at all the information."
    } ]
  }, {
    "tStartMs": 1085100,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But Ground News doesn't\nonly highlight breaking news"
    } ]
  }, {
    "tStartMs": 1087680,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "on things like science and aviation,"
    } ]
  }, {
    "tStartMs": 1090110,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "they also specifically\nshow blind spot stories"
    } ]
  }, {
    "tStartMs": 1092780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the media isn't covering."
    } ]
  }, {
    "tStartMs": 1094640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Veritasium is all about\ngetting to the truth"
    } ]
  }, {
    "tStartMs": 1097220,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and Ground News' mission"
    } ]
  }, {
    "tStartMs": 1098360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "is to provide all sides of every story,"
    } ]
  }, {
    "tStartMs": 1100550,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "so that we can do that for ourselves."
    } ]
  }, {
    "tStartMs": 1102560,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So, I encourage you to check them out"
