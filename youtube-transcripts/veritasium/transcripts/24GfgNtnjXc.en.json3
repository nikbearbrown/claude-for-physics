    } ]
  }, {
    "tStartMs": 1567110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and real understanding."
    } ]
  }, {
    "tStartMs": 1569450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And since all of their\nlessons are bite-sized,"
    } ]
  }, {
    "tStartMs": 1571430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you can be learning and building skills"
    } ]
  }, {
    "tStartMs": 1573530,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "whenever you have a few minutes to spare."
