  }, {
    "tStartMs": 1576170,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Take their freshly updated\ncourse on scientific thinking."
    } ]
  }, {
    "tStartMs": 1579290,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "If you liked learning about\nthe physics of rainbows,"
    } ]
  }, {
