  } ],
  "events": [ {
    "tStartMs": 833,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "(soft whimsical music)"
    } ]
  }, {
    "tStartMs": 1899,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "- [Derek] There is a limestone\ncave in Western Virginia"
    } ]
  }, {
    "tStartMs": 3720,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "where one of its giant chambers"
    } ]
  }, {
    "tStartMs": 5790,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "has been turned into a musical instrument."
    } ]
  }, {
    "tStartMs": 8730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "They call it an organ,"
    } ]
  }, {
    "tStartMs": 10380,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "but it's like no other\norgan on the planet."
    } ]
  }, {
    "tStartMs": 14081,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh!"
    } ]
  }, {
    "tStartMs": 14914,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "- [Derek] It relies on\nelectromechanical mallets,"
    } ]
  }, {
    "tStartMs": 16980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "steel bolts, electric guitar pickups,"
    } ]
  }, {
    "tStartMs": 19650,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and the main vibrating\nmaterial, limestone."
    } ]
  }, {
    "tStartMs": 23070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It's more technically\nreferred to as a lithophone,"
    } ]
  }, {
    "tStartMs": 25830,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the only one of its kind in the world,"
    } ]
  }, {
    "tStartMs": 28620,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but people around here\njust call it the organ."
    } ]
  }, {
    "tStartMs": 31650,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "So Veritasium producer\nPetr went to check it out."
    } ]
  }, {
    "tStartMs": 35414,
    "dDurationMs": 2626,
    "segs": [ {
      "utf8": "- We're going underground. Let's go."
    } ]
  }, {
    "tStartMs": 38040,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Can you tell me a little bit"
    } ]
  }, {
    "tStartMs": 39270,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "about the history of this place?"
    } ]
  }, {
    "tStartMs": 41844,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Luray Caverns?\n- Yeah."
    } ]
  }, {
    "tStartMs": 43044,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "- Discovered 1878, and, in fact,"
    } ]
  }, {
    "tStartMs": 44880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "to your right is where they first came in."
    } ]
  }, {
    "tStartMs": 48600,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "- Oh, no way.\n- On August 13th, 1878,"
    } ]
  }, {
    "tStartMs": 52140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "a group of hunters felt\na cool breeze coming"
    } ]
  }, {
    "tStartMs": 55080,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "from a small hole in the ground."
    } ]
  }, {
    "tStartMs": 57630,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Putting down their\nrifles, they began to dig,"
    } ]
  }, {
    "tStartMs": 60570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "making a hole big enough for the smallest"
    } ]
  }, {
    "tStartMs": 63030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "of them to fit through."
    } ]
  }, {
    "tStartMs": 64800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Andrew and Quint had\nonly a candle for light"
    } ]
  }, {
    "tStartMs": 67920,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "as they lowered themselves\ndown into the hole."
    } ]
  }, {
    "tStartMs": 71640,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "They spent the next few months exploring."
    } ]
  }, {
    "tStartMs": 75210,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They kept finding giant caverns connected"
    } ]
  }, {
    "tStartMs": 77670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "by narrow passageways."
    } ]
  }, {
    "tStartMs": 79680,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The ceilings and floors were covered"
    } ]
  }, {
    "tStartMs": 82770,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "in stalactites and stalagmites."
    } ]
  }, {
    "tStartMs": 86010,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "They even found an underground lake."
    } ]
  }, {
    "tStartMs": 89130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The cave system they had\naccidentally stumbled upon"
    } ]
  }, {
    "tStartMs": 92070,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "turned out to be the largest\nin the Eastern United States,"
    } ]
  }, {
    "tStartMs": 95640,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "covering 26 hectares."
    } ]
  }, {
    "tStartMs": 98310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It's now known as the Luray Caverns,"
    } ]
  }, {
    "tStartMs": 100890,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "and it's visited by half a\nmillion tourists each year."
    } ]
  }, {
    "tStartMs": 105300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Larry] That's Dream Lake."
    } ]
  }, {
    "tStartMs": 106620,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Petr] How still that water is"
    } ]
  }, {
    "tStartMs": 107880,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "and the reflection is just\nreally something else."
    } ]
  }, {
    "tStartMs": 111270,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "- The organ is one of the lower areas."
    } ]
  }, {
    "tStartMs": 114690,
    "dDurationMs": 4005,
    "segs": [ {
      "utf8": "It's in a room called the\nCathedral, a very large room."
    } ]
  }, {
    "tStartMs": 118695,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Petr] Yeah, that makes sense."
    } ]
  }, {
    "tStartMs": 119528,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "- [Larry] And they used to\nhave dances down there, balls."
    } ]
  }, {
    "tStartMs": 123490,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "They used to call it the ballroom"
    } ]
  }, {
    "tStartMs": 124323,
    "dDurationMs": 1317,
    "segs": [ {
      "utf8": "before the organ was put in.\n- Oh, no way."
    } ]
  }, {
    "tStartMs": 125640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So in the 1920s, people\nwould go down here and have"
    } ]
  }, {
    "tStartMs": 128520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Oh yeah.\n- balls and dances and"
    } ]
  }, {
    "tStartMs": 130320,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Well, it was no-\n- shindigs."
    } ]
  }, {
    "tStartMs": 131640,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- [Larry] It was a great place"
    } ]
  }, {
    "tStartMs": 132510,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "because it's air conditioned\nbasically naturally, so."
    } ]
  }, {
    "tStartMs": 136061,
    "dDurationMs": 1371,
    "segs": [ {
      "utf8": "- Yeah, that makes sense."
    } ]
  }, {
    "tStartMs": 137432,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "Oh my God. Are you kidding me?"
    } ]
  }, {
    "tStartMs": 139713,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "No way. Oh, this is so gorgeous."
    } ]
  }, {
    "tStartMs": 143723,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(riveting instrumental music)"
    } ]
  }, {
    "tStartMs": 144556,
    "dDurationMs": 2114,
    "segs": [ {
      "utf8": "And there's the control\npanel for the organ."
    } ]
  }, {
    "tStartMs": 146670,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- That's the organ."
    } ]
  }, {
    "tStartMs": 147870,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "You're actually inside\nthe organ right now."
    } ]
  }, {
    "tStartMs": 151140,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "The organ covers three and a half acres."
    } ]
  }, {
    "tStartMs": 154560,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "All the notes are scattered out around us."
    } ]
  }, {
    "tStartMs": 157113,
    "dDurationMs": 3027,
    "segs": [ {
      "utf8": "Of course, this was started\nin 1954, first played in 1957."
    } ]
  }, {
    "tStartMs": 161378,
    "dDurationMs": 2242,
    "segs": [ {
      "utf8": "- Okay. So it took\nthree years to get from-"
    } ]
  }, {
    "tStartMs": 163620,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 164610,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Welcome to the\nbeautiful caverns of Luray"
    } ]
  }, {
    "tStartMs": 166650,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "in Luray, Virginia and particularly"
    } ]
  }, {
    "tStartMs": 169080,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to the Great Stalacpipe Organ,"
    } ]
  }, {
    "tStartMs": 170730,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "which is located in this great\ncathedral-like structure,"
    } ]
  }, {
    "tStartMs": 174240,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which is 260 feet below the surface."
    } ]
  }, {
    "tStartMs": 176820,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This organ is so huge that\nyou stand not before it"
    } ]
  }, {
    "tStartMs": 179880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "but within it."
    } ]
  }, {
    "tStartMs": 181200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] In 1954 while on a tour"
    } ]
  }, {
    "tStartMs": 183330,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "of the caverns for his son's\nbirthday, Leland Sprinkle,"
    } ]
  }, {
    "tStartMs": 186720,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "a mathematician who worked\nat the Pentagon, had an idea."
    } ]
  }, {
    "tStartMs": 191070,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "See, during the tour,"
    } ]
  }, {
    "tStartMs": 192180,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "the guide walked around\nwith a small mallet."
    } ]
  }, {
    "tStartMs": 194880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "He would occasionally hit a stalactite,"
    } ]
  }, {
    "tStartMs": 197460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "producing a musical tone."
    } ]
  }, {
    "tStartMs": 199770,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "This was the start of\nSprinkle's three-year project"
    } ]
  }, {
    "tStartMs": 202650,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to turn the cave into\na musical instrument."
    } ]
  }, {
    "tStartMs": 206100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Since you asked for it, we\nshall be most happy to show you"
    } ]
  }, {
    "tStartMs": 208980,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "how we make music from the\nancient stalactites around us."
    } ]
  }, {
    "tStartMs": 212250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- What he did is he walked\naround these caverns"
    } ]
  }, {
    "tStartMs": 215190,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "with a ladder and climbing\nequipment and little mallets"
    } ]
  }, {
    "tStartMs": 218160,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and little tuning forks, and\nhe would hit on stalactites."
    } ]
  }, {
    "tStartMs": 221610,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And then when there was\none that was close enough"
    } ]
  }, {
    "tStartMs": 224610,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to concert pitch that he wanted,"
    } ]
  }, {
    "tStartMs": 226800,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "he'd take a disc grinder\nand grind off the stalactite"
    } ]
  }, {
    "tStartMs": 230700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "until it came to the pitch that he wanted."
    } ]
  }, {
    "tStartMs": 233220,
    "dDurationMs": 3422,
    "segs": [ {
      "utf8": "So this one should be middle C."
    } ]
  }, {
    "tStartMs": 236642,
    "dDurationMs": 2428,
    "segs": [ {
      "utf8": "(soft jaunty music)\n(sound chimes)"
    } ]
  }, {
    "tStartMs": 239070,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Stalactites form very slowly."
    } ]
  }, {
    "tStartMs": 241530,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In this cave,"
    } ]
  }, {
    "tStartMs": 242363,
    "dDurationMs": 4807,
    "segs": [ {
      "utf8": "they grow at around 16 cubic\ncentimeters every 120 years."
    } ]
  }, {
    "tStartMs": 247170,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The rate is dependent on the\namount of water that flows."
    } ]
  }, {
    "tStartMs": 250650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So some stalactites grow quickly"
    } ]
  }, {
    "tStartMs": 252870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "while others don't really grow at all."
    } ]
  }, {
    "tStartMs": 255660,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "They form as slightly acidic\nwater flows through the ground."
    } ]
  }, {
    "tStartMs": 259530,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It dissolves the limestone\nand then redeposits it"
    } ]
  }, {
    "tStartMs": 262530,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "when it comes in contact with the air."
    } ]
  }, {
    "tStartMs": 265320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "As the water drips to the ground,"
    } ]
  }, {
    "tStartMs": 267000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it can also deposit the\nlimestone on the floor,"
    } ]
  }, {
    "tStartMs": 269550,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "leading to a stalagmite."
    } ]
  }, {
    "tStartMs": 271710,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Sometimes over thousands\nof years, the stalactite"
    } ]
  }, {
    "tStartMs": 274350,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "and stalagmite can fuse\ntogether, forming a column."
    } ]
  }, {
    "tStartMs": 279330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You don't need to be living\nin an underground cave"
    } ]
  }, {
    "tStartMs": 281730,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to know that cybersecurity is important."
    } ]
  }, {
    "tStartMs": 284640,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "One of the things you can do\nto keep your identity safe"
    } ]
  }, {
    "tStartMs": 286890,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is to use a virtual private\nnetwork like our sponsor,"
    } ]
  }, {
    "tStartMs": 290040,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "NordVPN."
    } ]
  }, {
    "tStartMs": 290880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It hides your IP address,"
    } ]
  }, {
    "tStartMs": 292950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and one thing I love about NordVPN"
    } ]
  }, {
    "tStartMs": 295050,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is how fast their speeds are,"
    } ]
  }, {
    "tStartMs": 296670,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which is especially useful when connecting"
    } ]
  }, {
    "tStartMs": 298830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to streaming services in faraway locations"
    } ]
  }, {
    "tStartMs": 301590,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to watch content that's only\navailable in those regions."
    } ]
  }, {
    "tStartMs": 304620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I've been traveling around a lot recently,"
    } ]
  }, {
    "tStartMs": 306360,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "but hockey season has started."
    } ]
  }, {
    "tStartMs": 307830,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So I've been using NordVPN"
    } ]
  }, {
    "tStartMs": 309180,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to watch NHL Games while\nI'm here in Australia."
    } ]
  }, {
    "tStartMs": 312360,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Go Canucks."
    } ]
  }, {
    "tStartMs": 313410,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I just connect to the\nNordVPN servers in the US,"
    } ]
  }, {
    "tStartMs": 316380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and then I can see everything I want."
    } ]
  }, {
    "tStartMs": 318390,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "So to try it out for yourself,"
    } ]
  }, {
    "tStartMs": 319530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "go to nordvpn.com/veritasium."
    } ]
  }, {
    "tStartMs": 322110,
    "dDurationMs": 2264,
    "segs": [ {
      "utf8": "If you click that link in the description,"
    } ]
  }, {
    "tStartMs": 324374,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "you'll get a huge discount\non a two-year plan"
    } ]
  }, {
    "tStartMs": 325590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "plus an extra four months free."
    } ]
  }, {
    "tStartMs": 327660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So use our link, nordvpn.com/veritasium"
    } ]
  }, {
    "tStartMs": 330510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "for the best deal out there on NordVPN."
    } ]
  }, {
    "tStartMs": 332970,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "There is a 30-day money back guarantee,"
    } ]
  }, {
    "tStartMs": 334710,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so it's entirely risk free."
    } ]
  }, {
    "tStartMs": 336690,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I wanna thank NordVPN for\nsponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 339360,
    "dDurationMs": 2298,
    "segs": [ {
      "utf8": "and now back to the cave."
    } ]
  }, {
    "tStartMs": 341658,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(soft chiming music)"
    } ]
  }, {
    "tStartMs": 342491,
    "dDurationMs": 3079,
    "segs": [ {
      "utf8": "If you tap on a stalactite,\nthen like a tuning fork,"
    } ]
  }, {
    "tStartMs": 345570,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it vibrates at its resonant frequency."
    } ]
  }, {
    "tStartMs": 348180,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That frequency depends on the size"
    } ]
  }, {
    "tStartMs": 350220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and shape of the stalactite."
    } ]
  }, {
    "tStartMs": 352050,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Bigger stalactites make lower notes,"
    } ]
  }, {
    "tStartMs": 354600,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and it also depends on the\nelastic modulus of the material."
    } ]
  }, {
    "tStartMs": 358080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "In this case, it's all limestone."
    } ]
  }, {
    "tStartMs": 360450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So to adjust the resonant frequencies,"
    } ]
  }, {
    "tStartMs": 362760,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Sprinkle shaved a bit off\nthe end of some stalactites,"
    } ]
  }, {
    "tStartMs": 366540,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "putting them into concert pitch."
    } ]
  }, {
    "tStartMs": 369480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The organ wasn't connected to\nthe console when we visited,"
    } ]
  }, {
    "tStartMs": 372120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so Petr didn't get a chance to play it."
    } ]
  }, {
    "tStartMs": 374400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But Rob Scallon, who has\na great YouTube channel,"
    } ]
  }, {
    "tStartMs": 376920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "made a video about it a couple years ago."
    } ]
  }, {
    "tStartMs": 379200,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "We asked him what it's\nlike to play a cave."
    } ]
  }, {
    "tStartMs": 382680,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- It's hard to describe the\nfeeling of playing a cave."
    } ]
  }, {
    "tStartMs": 388719,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "(keys echo)"
    } ]
  }, {
    "tStartMs": 393390,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "It's very like grounding,\nvery surreal, very beautiful."
    } ]
  }, {
    "tStartMs": 398250,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "You know, if I'm being romantic about it,"
    } ]
  }, {
    "tStartMs": 400552,
    "dDurationMs": 3188,
    "segs": [ {
      "utf8": "you can hear the eons\nand eons and eons of time"
    } ]
  }, {
    "tStartMs": 403740,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that were needed to create this thing."
    } ]
  }, {
    "tStartMs": 414440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The cave is, of course, huge,"
    } ]
  }, {
    "tStartMs": 416120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and all the notes are in different places."
    } ]
  }, {
    "tStartMs": 418160,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So some are further away. Some are closer."
    } ]
  }, {
    "tStartMs": 420410,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Some are amplified near you,\nsome aren't, and I love reverb,"
    } ]
  }, {
    "tStartMs": 424820,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and the amount of reverb in\nthis room is just so immense,"
    } ]
  }, {
    "tStartMs": 428540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and the notes are so pure and beautiful,"
    } ]
  }, {
    "tStartMs": 430550,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and they're in different places."
    } ]
  }, {
    "tStartMs": 432080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So they like have different reverb."
    } ]
  }, {
    "tStartMs": 433820,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "It's a very like hauntingly\nbeautiful type of sound."
    } ]
  }, {
    "tStartMs": 445990,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- As you can see,\nthere's also the solenoid"
    } ]
  }, {
    "tStartMs": 448450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that is basically a mallet."
    } ]
  }, {
    "tStartMs": 450520,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Leland] After the\ntuning has been completed,"
    } ]
  }, {
    "tStartMs": 453010,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "we design a custom built bracket"
    } ]
  }, {
    "tStartMs": 454990,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "to which we attach an\nelectrically operated plunger."
    } ]
  }, {
    "tStartMs": 458920,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "This plunger with its rubber\ntip strikes the stalactite,"
    } ]
  }, {
    "tStartMs": 461800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "causing it to vibrate."
    } ]
  }, {
    "tStartMs": 463660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] Since different\nmusical stalactites"
    } ]
  }, {
    "tStartMs": 465280,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "are far away from each other\nand their volume variable,"
    } ]
  }, {
    "tStartMs": 468430,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Sprinkle amplified the vibrations."
    } ]
  }, {
    "tStartMs": 471070,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "He could've used microphones,\nbut in the 1950s,"
    } ]
  }, {
    "tStartMs": 473890,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "those weren't particularly robust."
    } ]
  }, {
    "tStartMs": 475930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So instead, he borrowed\nan idea from a piece"
    } ]
  }, {
    "tStartMs": 478480,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "of technology invented in the 1930s,"
    } ]
  }, {
    "tStartMs": 481090,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "the electric guitar pickup."
    } ]
  }, {
    "tStartMs": 483600,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "(upbeat electric guitar music)"
    } ]
  }, {
    "tStartMs": 484660,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "A guitar pickup is a coil of\nwire wrapped around a magnet."
    } ]
  }, {
    "tStartMs": 488230,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "When a steel guitar\nstring vibrates near it,"
    } ]
  }, {
    "tStartMs": 490650,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "it interacts with the magnetic field,"
    } ]
  }, {
    "tStartMs": 492430,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which induces a current in the wire."
    } ]
  }, {
    "tStartMs": 494950,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It doesn't work with\nnon-metal guitar strings."
    } ]
  }, {
    "tStartMs": 498040,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The thing that's vibrating\nneeds to be ferromagnetic."
    } ]
  }, {
    "tStartMs": 501220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Sprinkle added a steel bolt to each"
    } ]
  }, {
    "tStartMs": 503350,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "of his musical stalactites"
    } ]
  }, {
    "tStartMs": 504730,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and then used a pickup\nto detect the vibrations."
    } ]
  }, {
    "tStartMs": 507490,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "These signals are amplified mixed"
    } ]
  }, {
    "tStartMs": 509770,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and played back through speakers."
    } ]
  }, {
    "tStartMs": 511960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- You also gotta consider the weight"
    } ]
  }, {
    "tStartMs": 513340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of the bolt that goes into."
    } ]
  }, {
    "tStartMs": 515500,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Oh, right.\n- Yeah."
    } ]
  }, {
    "tStartMs": 517270,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Derek] But the guitar pickups"
    } ]
  }, {
    "tStartMs": 518380,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "created an unexpected\nproblem, radio interference."
    } ]
  }, {
    "tStartMs": 523060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- I don't know exactly how it works,"
    } ]
  }, {
    "tStartMs": 524890,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but one of the keys was picking\nup a local radio station,"
    } ]
  }, {
    "tStartMs": 528190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which actually turned it into a sampler."
    } ]
  }, {
    "tStartMs": 530530,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It was a really fun part of the video"
    } ]
  }, {
    "tStartMs": 532270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and actually sounded pretty cool."
    } ]
  }, {
    "tStartMs": 534190,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "That happens with electronic\ninstruments sometimes,"
    } ]
  }, {
    "tStartMs": 536620,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "even caves. (laughs)"
    } ]
  }, {
    "tStartMs": 539519,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "(keys echo)\n(muffled singing echoes)"
    } ]
  }, {
    "tStartMs": 543220,
    "dDurationMs": 2329,
    "segs": [ {
      "utf8": "What is that? It happens\nevery time I hit that key."
    } ]
  }, {
    "tStartMs": 545549,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(keys echo)\n(muffled singing echoes)"
    } ]
  }, {
    "tStartMs": 550660,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I'm like turning on the radio."
    } ]
  }, {
    "tStartMs": 553167,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "- [Man] It is picking up on that signal."
    } ]
  }, {
    "tStartMs": 555279,
    "dDurationMs": 1176,
    "segs": [ {
      "utf8": "(people laugh)"
    } ]
  }, {
    "tStartMs": 556455,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "- Oh my God.\n- That is what it is."
    } ]
  }, {
    "tStartMs": 558597,
    "dDurationMs": 1824,
    "segs": [ {
      "utf8": "You're getting keys."
    } ]
  }, {
    "tStartMs": 560421,
    "dDurationMs": 1192,
    "segs": [ {
      "utf8": "- So the radio is here."
    } ]
  }, {
    "tStartMs": 561613,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "(voices echoes)"
    } ]
  }, {
    "tStartMs": 563920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I thought, I'm like,\n\"Is that a human voice?\""
    } ]
  }, {
    "tStartMs": 565840,
    "dDurationMs": 1391,
    "segs": [ {
      "utf8": "Like is that-"
    } ]
  }, {
    "tStartMs": 567231,
    "dDurationMs": 3679,
    "segs": [ {
      "utf8": "- That would be the AM radio.\nAM station across the street."
    } ]
  }, {
    "tStartMs": 570910,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- [Petr] If they were\ntuned in, you know, 1957,"
    } ]
  }, {
    "tStartMs": 574690,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "have they become longer\nand hence gone out of tune?"
    } ]
  }, {
    "tStartMs": 579160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Well, he tried to pick\nstalactites that are inactive,"
    } ]
  }, {
    "tStartMs": 581500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that aren't growing anymore\nis what he tried to do."
    } ]
  }, {
    "tStartMs": 583750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- [Petr] But if he found\nstalactites that were growing"
    } ]
  }, {
    "tStartMs": 585640,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "'cause I'm seeing like a\nlittle bit of water, right?"
    } ]
  }, {
    "tStartMs": 587350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Yeah, and you'll see-\n- There's a little bit"
    } ]
  }, {
    "tStartMs": 588910,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "of growth happening.\n- Right,"
    } ]
  }, {
    "tStartMs": 589930,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "and you'll see that,\nand that comes and goes,"
    } ]
  }, {
    "tStartMs": 593560,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but we've never had to retune one yet."
    } ]
  }, {
    "tStartMs": 596530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Like I love the idea\nthat there's an organ"
    } ]
  }, {
    "tStartMs": 598450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that could grow out of tune\n- It could."
    } ]
  }, {
    "tStartMs": 600400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- because of how stalactites grow."
    } ]
  }, {
    "tStartMs": 603130,
    "dDurationMs": 2676,
    "segs": [ {
      "utf8": "- I don't think it'll be in\nmy lifetime, but it could."
    } ]
  }, {
    "tStartMs": 605806,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "(Larry chuckles)"
    } ]
  }, {
    "tStartMs": 607840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- If he chose a bunch\nthat weren't inactive,"
    } ]
  }, {
    "tStartMs": 610840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "it would be out of tune already."
    } ]
  }, {
    "tStartMs": 612460,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "- [Larry] Oh yeah."
    } ]
  }, {
    "tStartMs": 613821,
    "dDurationMs": 1189,
    "segs": [ {
      "utf8": "If they were completely\nactive, it would be."
    } ]
  }, {
    "tStartMs": 615010,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- That's so cool.\n- It's very mad scientist."
    } ]
  }, {
    "tStartMs": 617560,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "He definitely couldn't\nget away with it now,"
    } ]
  }, {
    "tStartMs": 619750,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "like going into a place like this"
    } ]
  }, {
    "tStartMs": 621250,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and then just starting to\nshave off the stalactites"
    } ]
  }, {
    "tStartMs": 623890,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that took eons to be created by nature."
    } ]
  }, {
    "tStartMs": 626890,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Thankfully it stays in tune"
    } ]
  }, {
    "tStartMs": 628150,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "'cause I can't continue shaving\noff the parts of this cave."
    } ]
  }, {
    "tStartMs": 632560,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- This is just such a\nstrange and beautiful"
    } ]
  }, {
    "tStartMs": 636250,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "and kind of insane project\nto take this gorgeous cavern"
    } ]
  }, {
    "tStartMs": 641080,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and make it even more beautiful"
    } ]
  }, {
    "tStartMs": 643300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "by turning into a musical instrument."
    } ]
  }, {
    "tStartMs": 645550,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- This structure has been\nbeing created drop by drop"
    } ]
  }, {
    "tStartMs": 652981,
    "dDurationMs": 2589,
    "segs": [ {
      "utf8": "for an unfathomable amount of years,"
    } ]
  }, {
    "tStartMs": 655570,
    "dDurationMs": 4209,
    "segs": [ {
      "utf8": "and that's pretty awe inspiring."
    } ]
  }, {
    "tStartMs": 659779,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(electronic beeps trill)\n(organ keys echo)"
    } ]
  } ]
}
