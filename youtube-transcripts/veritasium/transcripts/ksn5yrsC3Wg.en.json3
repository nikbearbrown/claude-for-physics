{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 26,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "- For two years, this drug was a miracle."
    } ]
  }, {
    "tStartMs": 3280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "It was introduced in 1996 to treat HIV."
    } ]
  }, {
    "tStartMs": 6480,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And by 1998, 75,000\npatients across the country"
    } ]
  }, {
    "tStartMs": 10320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "were taking up to 20 of them every day."
    } ]
  }, {
    "tStartMs": 12960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "It's called ritonavir,"
    } ]
  }, {
    "tStartMs": 14560,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "and it turned a certain death\ninto a manageable condition."
    } ]
  }, {
    "tStartMs": 19040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "This particular pill is on its way"
    } ]
  }, {
    "tStartMs": 20880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to quality control to\na dissolution tester."
    } ]
  }, {
    "tStartMs": 23840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Here, analysts monitor\neach batch of capsules,"
    } ]
  }, {
    "tStartMs": 27120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "checking that they do\ndissolve in around 30 minutes,"
    } ]
  }, {
    "tStartMs": 29680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "which is quickly enough\nto be absorbed properly."
    } ]
  }, {
    "tStartMs": 32400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's a rigorous precaution for a drug"
    } ]
  }, {
    "tStartMs": 34400,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "that for two years and\n240 consecutive lots"
    } ]
  }, {
    "tStartMs": 38720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "has never failed.\n(grim music)"
    } ]
  }, {
    "tStartMs": 41120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But now an analyst sees something unusual."
    } ]
  }, {
    "tStartMs": 44480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "This capsule hasn't dissolved properly."
    } ]
  }, {
    "tStartMs": 47680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "So they follow protocol and\ntrigger an emergency shutdown."
    } ]
  }, {
    "tStartMs": 51600,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "(alarm blaring)"
    } ]
  }, {
    "tStartMs": 52320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They destroy the entire batch"
    } ]
  }, {
    "tStartMs": 54320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and deep clean the production line"
    } ]
  }, {
    "tStartMs": 56000,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "to eliminate any possible\ntraces of contamination."
    } ]
  }, {
    "tStartMs": 59760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But the next day, at quality control,"
    } ]
  }, {
    "tStartMs": 61920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the same thing happens."
    } ]
  }, {
    "tStartMs": 63600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "On the line the clear capsules\nare turning white and cloudy,"
    } ]
  }, {
    "tStartMs": 67600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "technicians at the nearby\nresearch and development lab"
    } ]
  }, {
    "tStartMs": 70400,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "study the paste under a microscope"
    } ]
  }, {
    "tStartMs": 72720,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and find they're filled with\nmillions of tiny needles."
    } ]
  }, {
    "tStartMs": 76480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "They're crystals, but no\none has seen them before."
    } ]
  }, {
    "tStartMs": 79920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "They need a control to\ncompare the needles against,"
    } ]
  }, {
    "tStartMs": 83120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "so they make some of their\nown ritonavir in the lab,"
    } ]
  }, {
    "tStartMs": 86240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "but to their horror, it\nalso comes out cloudy."
    } ]
  }, {
    "tStartMs": 89680,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "So they try again, but all\nattempts yield the same result:"
    } ]
  }, {
    "tStartMs": 94320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "a white paste every time.\n(subdued music)"
    } ]
  }, {
    "tStartMs": 97360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The researchers are stumped."
    } ]
  }, {
    "tStartMs": 99600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "They had been making\nritonavir for two years."
    } ]
  }, {
    "tStartMs": 102960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They knew its exact chemical composition"
    } ]
  }, {
    "tStartMs": 105360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and every part of the\nprocess used to make it,"
    } ]
  }, {
    "tStartMs": 108480,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "so they check all the\ninput ingredients again,"
    } ]
  }, {
    "tStartMs": 111520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "all the settings, every\ntemperature setting and procedure."
    } ]
  }, {
    "tStartMs": 114880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But all of it seems to be done correctly."
    } ]
  }, {
    "tStartMs": 117760,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Yet at the factory,"
    } ]
  }, {
    "tStartMs": 118720,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "the cloudy capsules are appearing\nmore and more frequently."
    } ]
  }, {
    "tStartMs": 122480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Within a week, every tablet produced"
    } ]
  }, {
    "tStartMs": 124720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "by either the lab or the\nfactory comes out cloudy."
    } ]
  }, {
    "tStartMs": 128400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Abbott needs to halt all production"
    } ]
  }, {
    "tStartMs": 130480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of ritonavir immediately."
    } ]
  }, {
    "tStartMs": 132880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But they can't just cut off the supply"
    } ]
  }, {
    "tStartMs": 134720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "because people need these tablets."
    } ]
  }, {
    "tStartMs": 137440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- [Narrator] \"We called on as\nmany resources as we could."
    } ]
  }, {
    "tStartMs": 140320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "We tried everything."
    } ]
  }, {
    "tStartMs": 141760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We conducted countless experiments."
    } ]
  }, {
    "tStartMs": 143760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "We rebuilt facilities and new lines."
    } ]
  }, {
    "tStartMs": 145840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "We looked at alternative sites"
    } ]
  }, {
    "tStartMs": 147760,
    "dDurationMs": 4304,
    "segs": [ {
      "utf8": "to see if we could start\nclean in a new environment.\""
    } ]
  }, {
    "tStartMs": 152064,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 152078,
    "dDurationMs": 3922,
    "segs": [ {
      "utf8": "- And they found an alternative\nsite, a factory in Italy."
    } ]
  }, {
    "tStartMs": 156000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They start ritonavir production there,"
    } ]
  }, {
    "tStartMs": 157920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and to their relief,"
    } ]
  }, {
    "tStartMs": 159280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "all the pills passed the dissolution test."
    } ]
  }, {
    "tStartMs": 161920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "This is great news."
    } ]
  }, {
    "tStartMs": 163760,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "But it also means"
    } ]
  }, {
    "tStartMs": 164880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that Chicago must have\nbeen making a mistake."
    } ]
  }, {
    "tStartMs": 167920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So a team of scientists flies over"
    } ]
  }, {
    "tStartMs": 169920,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to look at what the Italians\nare doing differently."
    } ]
  }, {
    "tStartMs": 172640,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "They check everything, the\npressure, temperature, humidity,"
    } ]
  }, {
    "tStartMs": 176080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the exact weight of all the chemicals,"
    } ]
  }, {
    "tStartMs": 178160,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "but it all matches perfectly"
    } ]
  }, {
    "tStartMs": 179760,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with what they're doing in Chicago."
    } ]
  }, {
    "tStartMs": 182080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "None of it makes any sense."
    } ]
  }, {
    "tStartMs": 184000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But at least Italy can\nkeep making the medicine."
    } ]
  }, {
    "tStartMs": 188000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "(phone ringing)\n(soft brooding music)"
    } ]
  }, {
    "tStartMs": 188960,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "But when the Chicago team\nreturns home, they get a call."
    } ]
  }, {
    "tStartMs": 192480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It's from Italy."
    } ]
  }, {
    "tStartMs": 193920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Within days after their visit,"
    } ]
  }, {
    "tStartMs": 195920,
    "dDurationMs": 3747,
    "segs": [ {
      "utf8": "one of the tablets fails\nthe dissolution test."
    } ]
  }, {
    "tStartMs": 199667,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "- [Narrator] \"There was no gradual trend."
    } ]
  }, {
    "tStartMs": 201280,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "There was no early warning."
    } ]
  }, {
    "tStartMs": 202320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "In a matter of weeks,\nmaybe five or six weeks,"
    } ]
  }, {
    "tStartMs": 205440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "every place the product was"
    } ]
  }, {
    "tStartMs": 207280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "became contaminated with the crystals."
    } ]
  }, {
    "tStartMs": 209520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "We did not know how to detect it."
    } ]
  }, {
    "tStartMs": 211120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "We did not know how to test for it."
    } ]
  }, {
    "tStartMs": 212720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We did not know what caused it."
    } ]
  }, {
    "tStartMs": 214720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "We did not know how to prevent it."
    } ]
  }, {
    "tStartMs": 216880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We did not know how to get rid of it."
    } ]
  }, {
    "tStartMs": 218880,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And we kept asking the\nquestion, 'Why now?'\""
    } ]
  }, {
    "tStartMs": 223200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- They were witnessing a rare disaster."
    } ]
  }, {
    "tStartMs": 227280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It had happened before, and\nin theory could happen again"
    } ]
  }, {
    "tStartMs": 230240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "to just about any drug\nor chemical compound."
    } ]
  }, {
    "tStartMs": 233280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It spreads like a disease,"
    } ]
  }, {
    "tStartMs": 235280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but the thing that's getting\ninfected is the medicine."
    } ]
  }, {
    "tStartMs": 238640,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "One day you can make it,\nthe next it's gone forever."
    } ]
  }, {
    "tStartMs": 242400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Narrator] \"It is frightening\nthat this could happen"
    } ]
  }, {
    "tStartMs": 244320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "to any drug that we've taken\non, which we're dependent.\""
    } ]
  }, {
    "tStartMs": 246920,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- And the scariest part"
    } ]
  }, {
    "tStartMs": 248640,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "is you can't predict if it will\nhappen, when it will happen,"
    } ]
  }, {
    "tStartMs": 252560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "or to which medicine or compound."
    } ]
  }, {
    "tStartMs": 255200,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Overnight, drugs we all rely\non might just disappear."
    } ]
  }, {
    "tStartMs": 260160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So what was happening inside\nthose ritonavir capsules?"
    } ]
  }, {
    "tStartMs": 263760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "What were those crystals inside?"
    } ]
  }, {
    "tStartMs": 265920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They appeared to be an\nentirely new compound,"
    } ]
  }, {
    "tStartMs": 268560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but when they tested them,"
    } ]
  }, {
    "tStartMs": 270080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "everything indicated they were ritonavir."
    } ]
  }, {
    "tStartMs": 273200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It sounds impossible,"
    } ]
  }, {
    "tStartMs": 274960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but something similar had\nactually been the center"
    } ]
  }, {
    "tStartMs": 277120,
    "dDurationMs": 4855,
    "segs": [ {
      "utf8": "of a heated debate 170 years earlier."
    } ]
  }, {
    "tStartMs": 281975,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(mellow music)"
    } ]
  }, {
    "tStartMs": 281989,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "- [Casper] In his Paris laboratory,"
    } ]
  }, {
    "tStartMs": 283840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "chemist Justus von Liebig\nwas reading a paper."
    } ]
  }, {
    "tStartMs": 287120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It was about a newly discovered compound,"
    } ]
  }, {
    "tStartMs": 289440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and what elements it was made of."
    } ]
  }, {
    "tStartMs": 291840,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "This kind of work"
    } ]
  }, {
    "tStartMs": 292640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "was at the cutting edge\nof chemical research."
    } ]
  }, {
    "tStartMs": 295120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Research he knew better than almost anyone"
    } ]
  }, {
    "tStartMs": 297440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "because he had personally\npioneered most of it."
    } ]
  }, {
    "tStartMs": 300640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "This had made him highly\nrespected in his field,"
    } ]
  }, {
    "tStartMs": 303200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but he also had a reputation"
    } ]
  }, {
    "tStartMs": 304960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for being difficult to work with."
    } ]
  }, {
    "tStartMs": 306880,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "He was arrogant, hot-tempered,\nand didn't suffer fools."
    } ]
  }, {
    "tStartMs": 310480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And the more he read this paper,"
    } ]
  }, {
    "tStartMs": 312400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "the more incensed he got, because to him,"
    } ]
  }, {
    "tStartMs": 314880,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "it was clearly written by\na fool, Friedrich Wöhler."
    } ]
  }, {
    "tStartMs": 320160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So we headed over to the lab at Imperial"
    } ]
  }, {
    "tStartMs": 322560,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "to recreate what Wöhler\nclaimed to have discovered."
    } ]
  }, {
    "tStartMs": 325400,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- So I've got it here wrapped in foil"
    } ]
  }, {
    "tStartMs": 327360,
    "dDurationMs": 2149,
    "segs": [ {
      "utf8": "because it is a bit photo-sensitive."
    } ]
  }, {
    "tStartMs": 329509,
    "dDurationMs": 2291,
    "segs": [ {
      "utf8": "- [Casper] It's a bit like,\nlike, little rocks in there."
    } ]
  }, {
    "tStartMs": 331800,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 332360,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- Beige powder, okay."
    } ]
  }, {
    "tStartMs": 334080,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Made of one silver, one\nnitrogen, one oxygen,"
    } ]
  }, {
    "tStartMs": 337280,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "and one carbon.\n- Exactly."
    } ]
  }, {
    "tStartMs": 338949,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "- (laughs) You wanna light it up?"
    } ]
  }, {
    "tStartMs": 340152,
    "dDurationMs": 2568,
    "segs": [ {
      "utf8": "- Yeah, sure, let's do it."
    } ]
  }, {
    "tStartMs": 342720,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You seem quite excited."
    } ]
  }, {
    "tStartMs": 343840,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- I am quite excited."
    } ]
  }, {
    "tStartMs": 347920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Yeah. Not much is happening."
    } ]
  }, {
    "tStartMs": 350800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Oh, it's melting a little, or it's, like,"
    } ]
  }, {
    "tStartMs": 353600,
    "dDurationMs": 1664,
    "segs": [ {
      "utf8": "it is getting a little discolored."
    } ]
  }, {
    "tStartMs": 355264,
    "dDurationMs": 1456,
    "segs": [ {
      "utf8": "- [Dr. Kafizas] Yes, it is."
    } ]
  }, {
    "tStartMs": 356720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- I guess the issue was he said,"
    } ]
  }, {
    "tStartMs": 359520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "\"Okay, I found this beige powder"
    } ]
  }, {
    "tStartMs": 361040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and I know exactly what it's made of,"
    } ]
  }, {
    "tStartMs": 362800,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "one silver, one carbon, one\nnitrogen, and one oxygen.\""
    } ]
  }, {
    "tStartMs": 365760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "He publishes this.\n(curious music)"
    } ]
  }, {
    "tStartMs": 367200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The paper reaches Liebig, and he is like,"
    } ]
  }, {
    "tStartMs": 370160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "\"There's no way, because I've\njust discovered that compound."
    } ]
  }, {
    "tStartMs": 373760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And when I tried to put a flame to it,"
    } ]
  }, {
    "tStartMs": 375840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "it behaves completely differently.\""
    } ]
  }, {
    "tStartMs": 378160,
    "dDurationMs": 3105,
    "segs": [ {
      "utf8": "And we've got some of that right here too."
    } ]
  }, {
    "tStartMs": 381265,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 381280,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Should we try to burn this one?"
    } ]
  }, {
    "tStartMs": 382520,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- Yeah. I made some fresh this morning."
    } ]
  }, {
    "tStartMs": 384720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Let's just see how a small amount behaves."
    } ]
  }, {
    "tStartMs": 386880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So we're gonna go with, I don't know,"
    } ]
  }, {
    "tStartMs": 388880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "maybe a few milligrams."
    } ]
  }, {
    "tStartMs": 390160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "I've left it a bit moist."
    } ]
  }, {
    "tStartMs": 393120,
    "dDurationMs": 3184,
    "segs": [ {
      "utf8": "When it's in its moist-\n(compound snaps)"
    } ]
  }, {
    "tStartMs": 396304,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "Oh!\n- Oh, my God."
    } ]
  }, {
    "tStartMs": 396320,
    "dDurationMs": 1753,
    "segs": [ {
      "utf8": "I didn't expect that.\n- Yeah!"
    } ]
  }, {
    "tStartMs": 398073,
    "dDurationMs": 1925,
    "segs": [ {
      "utf8": "- It's so loud.\n(Dr. Kafizas laughs)"
    } ]
  }, {
    "tStartMs": 399998,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "- It's very sensitive."
    } ]
  }, {
    "tStartMs": 402400,
    "dDurationMs": 1824,
    "segs": [ {
      "utf8": "I'm sorry about that.\n- That is crazy."
    } ]
  }, {
    "tStartMs": 404224,
    "dDurationMs": 1136,
    "segs": [ {
      "utf8": "- [Dr. Kafizas] And that\nwas just a small amount."
    } ]
  }, {
    "tStartMs": 405360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- Oh my God, my ears."
    } ]
  }, {
    "tStartMs": 407200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "What? I was not ready for that."
    } ]
  }, {
    "tStartMs": 408800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- I wasn't ready for that either."
    } ]
  }, {
    "tStartMs": 410480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I made it moist so that it's less likely"
    } ]
  }, {
    "tStartMs": 412560,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "to self-detonate, but clearly I was wrong."
    } ]
  }, {
    "tStartMs": 416760,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Clearly Wöhler had made a mistake."
    } ]
  }, {
    "tStartMs": 419360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "These can't possibly be made\nof exactly the same elements."
    } ]
  }, {
    "tStartMs": 422960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So Liebig wrote a paper\nslamming Wöhler's work,"
    } ]
  }, {
    "tStartMs": 425920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "calling him a \"hopeless analyst\""
    } ]
  }, {
    "tStartMs": 427840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and saying he should go\nback, check his work,"
    } ]
  }, {
    "tStartMs": 430000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and publish again when\nhe's found his mistake."
    } ]
  }, {
    "tStartMs": 433600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And Wöhler does exactly that."
    } ]
  }, {
    "tStartMs": 435680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "He checks his work but finds no mistakes."
    } ]
  }, {
    "tStartMs": 438400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So now he's even more\nsure that he's correct."
    } ]
  }, {
    "tStartMs": 441120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So he writes up his\nresults in a second paper,"
    } ]
  }, {
    "tStartMs": 444160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but Liebig wasn't having any of this"
    } ]
  }, {
    "tStartMs": 446400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and replies with another\npaper saying he must be wrong."
    } ]
  }, {
    "tStartMs": 449840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "So this public back-and-forth\ncontinues for two years,"
    } ]
  }, {
    "tStartMs": 453120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "with each side becoming\nmore and more convinced"
    } ]
  }, {
    "tStartMs": 455600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that the other is out of their mind,"
    } ]
  }, {
    "tStartMs": 457840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "until finally they agreed"
    } ]
  }, {
    "tStartMs": 459440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to meet on neutral ground in Frankfurt"
    } ]
  }, {
    "tStartMs": 461360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to put this whole thing\nto bed once and for all."
    } ]
  }, {
    "tStartMs": 464080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "They would replicate each other's work"
    } ]
  }, {
    "tStartMs": 465680,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and let the results speak for themselves."
    } ]
  }, {
    "tStartMs": 468960,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "But when they did, they were stunned."
    } ]
  }, {
    "tStartMs": 472400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Before we continue, I\nwant to quickly thank SoFi"
    } ]
  }, {
    "tStartMs": 475040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "for sponsoring this part of the video."
    } ]
  }, {
    "tStartMs": 476800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You know, one of the simplest\nways to build wealth over time"
    } ]
  }, {
    "tStartMs": 479680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "is by earning compound\ninterest on your money."
    } ]
  }, {
    "tStartMs": 482560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "There's this quote from\nAlbert Einstein that says,"
    } ]
  }, {
    "tStartMs": 485280,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "\"Compound interest is the\neighth wonder of the world."
    } ]
  }, {
    "tStartMs": 488960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "He who understands it, earns it;"
    } ]
  }, {
    "tStartMs": 491920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "he who doesn't, pays it.\""
    } ]
  }, {
    "tStartMs": 494160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And yet many people don't put their money"
    } ]
  }, {
    "tStartMs": 496480,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "in a savings account,\nwhich kind of makes sense"
    } ]
  }, {
    "tStartMs": 499440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "because most banks give\nyou next to nothing,"
    } ]
  }, {
    "tStartMs": 501760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "a fraction of a percent worth of interest."
    } ]
  }, {
    "tStartMs": 504480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And at that rate, you can't\neven keep up with inflation."
    } ]
  }, {
    "tStartMs": 507680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "But with today's sponsors,\nSoFi, you can change that."
    } ]
  }, {
    "tStartMs": 510640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "SoFi is an all-in-one finance app"
    } ]
  }, {
    "tStartMs": 512720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "that lets you bank, borrow, and invest."
    } ]
  }, {
    "tStartMs": 516160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "When you open a SoFi\nchecking and savings account"
    } ]
  }, {
    "tStartMs": 518400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and set up an eligible direct deposit,"
    } ]
  }, {
    "tStartMs": 520560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "you earn a competitive APY."
    } ]
  }, {
    "tStartMs": 523360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You don't have to pay any account fees."
    } ]
  }, {
    "tStartMs": 526160,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "That means your money"
    } ]
  }, {
    "tStartMs": 527280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "isn't just sitting there, it's working."
    } ]
  }, {
    "tStartMs": 529280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And every dollar you put in can\nearn more and more interest."
    } ]
  }, {
    "tStartMs": 532640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And over time, that really adds up."
    } ]
  }, {
    "tStartMs": 535040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Einstein called it the\neighth wonder for a reason."
    } ]
  }, {
    "tStartMs": 538080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Of course, the exact amount depends"
    } ]
  }, {
    "tStartMs": 540000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "on several factors like\nyour starting capital,"
    } ]
  }, {
    "tStartMs": 542640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "the time period, the interest rate,"
    } ]
  }, {
    "tStartMs": 544400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and any additional deposits."
    } ]
  }, {
    "tStartMs": 546480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So check if it's right for you."
    } ]
  }, {
    "tStartMs": 548880,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "But right now, SoFi is also\noffering a special signup bonus."
    } ]
  }, {
    "tStartMs": 553040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "If you set up a new\nhigh-yield savings account"
    } ]
  }, {
    "tStartMs": 555520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "with an eligible direct\ndeposit of $1,000 or more,"
    } ]
  }, {
    "tStartMs": 559120,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "well then you can get either\n$50 or $400 cash bonus."
    } ]
  }, {
    "tStartMs": 564400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So start putting your money to work"
    } ]
  }, {
    "tStartMs": 566160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "by heading over to sofi.com/ve."
    } ]
  }, {
    "tStartMs": 568960,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "You can scan this QR code"
    } ]
  }, {
    "tStartMs": 570240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or click the link in the description."
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "I wanna thank SoFi for sponsoring\nthis part of the video."
    } ]
  }, {
    "tStartMs": 575360,
    "dDurationMs": 8226,
    "segs": [ {
      "utf8": "And now back to what was\nhappening with Liebig and Wöhler."
    } ]
  }, {
    "tStartMs": 583586,
    "dDurationMs": 12,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 583598,
    "dDurationMs": 1282,
    "segs": [ {
      "utf8": "- They were both right?\n- Yeah."
    } ]
  }, {
    "tStartMs": 584880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- Like, they both had a compound"
    } ]
  }, {
    "tStartMs": 586160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that was made of exactly\none carbon, one nitrogen,"
    } ]
  }, {
    "tStartMs": 588880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "one oxygen, and one silver atom."
    } ]
  }, {
    "tStartMs": 590880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And one could be boring as hell (laughs)"
    } ]
  }, {
    "tStartMs": 593840,
    "dDurationMs": 5561,
    "segs": [ {
      "utf8": "and the other one can,\nwell, blow up your face."
    } ]
  }, {
    "tStartMs": 599401,
    "dDurationMs": 21,
    "segs": [ {
      "utf8": "(compound snaps)\n- Oh!"
    } ]
  }, {
    "tStartMs": 599422,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(compound bangs)"
    } ]
  }, {
    "tStartMs": 599438,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- Whoa! (laughs)"
    } ]
  }, {
    "tStartMs": 601918,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "- This was surprising because at the time"
    } ]
  }, {
    "tStartMs": 604000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "a compound was thought\nto be just the atoms"
    } ]
  }, {
    "tStartMs": 606480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that made it up and nothing more."
    } ]
  }, {
    "tStartMs": 608880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But now this whole\nconception had to change."
    } ]
  }, {
    "tStartMs": 612080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Von Liebig and Wöhler had discovered"
    } ]
  }, {
    "tStartMs": 614160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "that the way those atoms\nare arranged also matters."
    } ]
  }, {
    "tStartMs": 618080,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "At the time, they had no way\nto work out that ordering,"
    } ]
  }, {
    "tStartMs": 621040,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "but today we can."
    } ]
  }, {
    "tStartMs": 623501,
    "dDurationMs": 19,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 623520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "When you shine light on a molecule,"
    } ]
  }, {
    "tStartMs": 625600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "its electric field tugs on\nthe electrons and nuclei."
    } ]
  }, {
    "tStartMs": 629120,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "They get pulled back and forth"
    } ]
  }, {
    "tStartMs": 630640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "as the field changes direction."
    } ]
  }, {
    "tStartMs": 633040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This can stretch, squeeze,"
    } ]
  }, {
    "tStartMs": 634720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and bend the bonds in the molecule"
    } ]
  }, {
    "tStartMs": 636800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "as the atoms oscillate back and forth."
    } ]
  }, {
    "tStartMs": 639440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But each bond responds\ndifferently to the light"
    } ]
  }, {
    "tStartMs": 641680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "depending on how strong it is"
    } ]
  }, {
    "tStartMs": 643360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and the mass of the atoms it connects."
    } ]
  }, {
    "tStartMs": 645920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It's like each bond is\na boat on the ocean."
    } ]
  }, {
    "tStartMs": 648880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "If the waves are small and rapid,"
    } ]
  }, {
    "tStartMs": 651120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "they won't rock it very much."
    } ]
  }, {
    "tStartMs": 653120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And if the waves are very slow,"
    } ]
  }, {
    "tStartMs": 654880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "like the tides coming in and out,"
    } ]
  }, {
    "tStartMs": 656960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that also won't rock the boat very much."
    } ]
  }, {
    "tStartMs": 659520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The boat just gets lifted up and down."
    } ]
  }, {
    "tStartMs": 662000,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's only when the waves\nare just the right size"
    } ]
  }, {
    "tStartMs": 664880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that the boat gets tossed around."
    } ]
  }, {
    "tStartMs": 666920,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "And because of this, each\nbond will react strongest"
    } ]
  }, {
    "tStartMs": 670000,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to a specific frequency of\nlight, which we can measure."
    } ]
  }, {
    "tStartMs": 673680,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "By hitting the molecule"
    } ]
  }, {
    "tStartMs": 674960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with a range of infrared frequencies,"
    } ]
  }, {
    "tStartMs": 676880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "we get a spectrum like this"
    } ]
  }, {
    "tStartMs": 678720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "with peaks that tell us\nwhen bonds are reacting."
    } ]
  }, {
    "tStartMs": 681920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "This acts like a\nfingerprint for the molecule"
    } ]
  }, {
    "tStartMs": 684160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and tells us which bonds are there."
    } ]
  }, {
    "tStartMs": 688080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Wöhler's compound has a broad peak,"
    } ]
  }, {
    "tStartMs": 690240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "which corresponds to bending"
    } ]
  }, {
    "tStartMs": 691760,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "an N double-bonded to C\ndouble-bonded to O group."
    } ]
  }, {
    "tStartMs": 695600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Liebig's compound, on the other hand,"
    } ]
  }, {
    "tStartMs": 697200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "has a spectrum that looks like this,"
    } ]
  }, {
    "tStartMs": 699200,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "with these two prominent peaks,"
    } ]
  }, {
    "tStartMs": 701440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "one at high frequency\nand one at low frequency."
    } ]
  }, {
    "tStartMs": 704160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "These correspond to\nstretching a double bond"
    } ]
  }, {
    "tStartMs": 706160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "between a carbon and a nitrogen"
    } ]
  }, {
    "tStartMs": 707840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and a single bond between\na nitrogen and an oxygen."
    } ]
  }, {
    "tStartMs": 711120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We now know that Wöhler's\ncompound was silver cyanate,"
    } ]
  }, {
    "tStartMs": 714480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and it looks like this."
    } ]
  }, {
    "tStartMs": 716080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The carbon, nitrogen, and oxygen"
    } ]
  }, {
    "tStartMs": 718240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "are joined with those\ntwo strong double bonds,"
    } ]
  }, {
    "tStartMs": 721120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "which is why it's so stable."
    } ]
  }, {
    "tStartMs": 722880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "In contrast, Liebig's\ncompound, silver fulminate,"
    } ]
  }, {
    "tStartMs": 726000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "looks like this."
    } ]
  }, {
    "tStartMs": 727200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The silver is bonded\nto the carbon instead,"
    } ]
  }, {
    "tStartMs": 730160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "so the other elements\nare arranged this way."
    } ]
  }, {
    "tStartMs": 733120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The bond between the carbon\nand nitrogen is a triple bond,"
    } ]
  }, {
    "tStartMs": 736720,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "but the oxygen and nitrogen\nare very weakly connected."
    } ]
  }, {
    "tStartMs": 740120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And this single bond\nis very easy to break,"
    } ]
  }, {
    "tStartMs": 743360,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "and once it does,"
    } ]
  }, {
    "tStartMs": 744240,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "the atoms can rearrange\ninto much more stable gases,"
    } ]
  }, {
    "tStartMs": 747920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which is why it's so explosive."
    } ]
  }, {
    "tStartMs": 750320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "They had discovered isomers."
    } ]
  }, {
    "tStartMs": 752400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That it's not just the atoms in a molecule"
    } ]
  }, {
    "tStartMs": 754560,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "that dictate how it behaves,\nbut its bonds as well."
    } ]
  }, {
    "tStartMs": 758960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So naturally the scientists at Abbott"
    } ]
  }, {
    "tStartMs": 761120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "suspected something similar\nmight be happening to ritonavir."
    } ]
  }, {
    "tStartMs": 764640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "They knew that the spectrum of ritonavir"
    } ]
  }, {
    "tStartMs": 766960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "should look like this."
    } ]
  }, {
    "tStartMs": 768560,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So they put a sample of white\npaste into a spectrometer,"
    } ]
  }, {
    "tStartMs": 772160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "expecting to see something\ncompletely different."
    } ]
  }, {
    "tStartMs": 774720,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "But instead they saw this, the same peaks."
    } ]
  }, {
    "tStartMs": 779440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The paste had all the\nsame bonds as ritonavir,"
    } ]
  }, {
    "tStartMs": 782880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "so it must be ritonavir."
    } ]
  }, {
    "tStartMs": 785440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But they also noticed it\nwasn't exactly the same."
    } ]
  }, {
    "tStartMs": 788240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "There were these small\ndeviations between the two."
    } ]
  }, {
    "tStartMs": 791520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The arrangement of the atoms was the same,"
    } ]
  }, {
    "tStartMs": 793760,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "but something about the\nbonds had changed slightly."
    } ]
  }, {
    "tStartMs": 797000,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- Well, it turns out there's another way"
    } ]
  }, {
    "tStartMs": 799680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to change the properties,\nand I can show you how"
    } ]
  }, {
    "tStartMs": 802560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "with probably the most\ndelicious demo I'll ever do,"
    } ]
  }, {
    "tStartMs": 805840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because this, of course,\nis a piece of chocolate."
    } ]
  }, {
    "tStartMs": 808720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It's nice, it's shiny, it's durable,"
    } ]
  }, {
    "tStartMs": 811440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and it has that nice\nsnap when you crack it."
    } ]
  }, {
    "tStartMs": 814240,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "But you'll notice"
    } ]
  }, {
    "tStartMs": 814880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that if you've ever let\nyour chocolate melt,"
    } ]
  }, {
    "tStartMs": 817680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "then it never returns\nto being quite the same."
    } ]
  }, {
    "tStartMs": 820320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Suddenly it melts in your\nhand when you pick it up,"
    } ]
  }, {
    "tStartMs": 823120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "you know, it's dull, it's bendy,"
    } ]
  }, {
    "tStartMs": 824880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and it doesn't quite taste the same."
    } ]
  }, {
    "tStartMs": 826960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "You're not imagining this."
    } ]
  }, {
    "tStartMs": 828160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "There really is a subtle difference,"
    } ]
  }, {
    "tStartMs": 829840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and I can explain what's happening"
    } ]
  }, {
    "tStartMs": 831280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with a little help from\nmy friend Chris over here."
    } ]
  }, {
    "tStartMs": 833920,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "- Hey.\n- Hello."
    } ]
  }, {
    "tStartMs": 834960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So Chris runs his own YouTube\nchannel, Chris Young Cooks,"
    } ]
  }, {
    "tStartMs": 838000,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and this is way overkill for\nwhat we need here probably,"
    } ]
  }, {
    "tStartMs": 840560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "because he was the head development chef"
    } ]
  }, {
    "tStartMs": 842240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "at a three-Michelin star restaurant."
    } ]
  }, {
    "tStartMs": 844800,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 845983,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 845998,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "- We've got some nice\nshiny chocolate here."
    } ]
  }, {
    "tStartMs": 848560,
    "dDurationMs": 8784,
    "segs": [ {
      "utf8": "But look what happens\nwhen we turn up the heat."
    } ]
  }, {
    "tStartMs": 857344,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(heat gun whirs)"
    } ]
  }, {
    "tStartMs": 857360,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "Oh yeah, that goes quite quick."
    } ]
  }, {
    "tStartMs": 863040,
    "dDurationMs": 4315,
    "segs": [ {
      "utf8": "Oh, that is surprisingly satisfying."
    } ]
  }, {
    "tStartMs": 867355,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "- We obviously melted some of\nthe chocolate, no surprise."
    } ]
  }, {
    "tStartMs": 870400,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "But this is what happens, right?"
    } ]
  }, {
    "tStartMs": 871440,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You leave it somewhere warm,"
    } ]
  }, {
    "tStartMs": 872560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the chocolate gets above body temperature,"
    } ]
  }, {
    "tStartMs": 874240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "it starts to melt, and\nthen as it cools back down,"
    } ]
  }, {
    "tStartMs": 876400,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "it's gonna harden again."
    } ]
  }, {
    "tStartMs": 877360,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "- So you've got the chocolate."
    } ]
  }, {
    "tStartMs": 879510,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "- [Chris] That looks like\nheat-damaged chocolate, right?"
    } ]
  }, {
    "tStartMs": 881669,
    "dDurationMs": 331,
    "segs": [ {
      "utf8": "- [Casper] I know."
    } ]
  }, {
    "tStartMs": 882000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- Like, you've seen this,\nyou've opened a chocolate bar,"
    } ]
  }, {
    "tStartMs": 884480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "maybe it was left in your car\nsitting in a sunny window."
    } ]
  }, {
    "tStartMs": 886800,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Touch the edge, like, you can feel,"
    } ]
  }, {
    "tStartMs": 889760,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "feel how that's just soft-\n- Yeah."
    } ]
  }, {
    "tStartMs": 891518,
    "dDurationMs": 1282,
    "segs": [ {
      "utf8": "- and kind of sticky."
    } ]
  }, {
    "tStartMs": 892800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- Immediately."
    } ]
  }, {
    "tStartMs": 893800,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "- Compare it to a nicely\ntempered piece of chocolate."
    } ]
  }, {
    "tStartMs": 896880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Like, you can pick that\nup with your bare hands,"
    } ]
  }, {
    "tStartMs": 898720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "it will eventually melt in your\nhand, but much more slowly."
    } ]
  }, {
    "tStartMs": 901760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- Now if this ever\naccidentally happens to you,"
    } ]
  }, {
    "tStartMs": 904480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "we'll show you how to get it back"
    } ]
  }, {
    "tStartMs": 906000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to the nice and shiny form."
    } ]
  }, {
    "tStartMs": 908000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But what's interesting here"
    } ]
  }, {
    "tStartMs": 909200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "is that we didn't change\nany of the ingredients"
    } ]
  }, {
    "tStartMs": 912160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and yet the properties changed completely."
    } ]
  }, {
    "tStartMs": 915280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Chocolate is made of\nthree main ingredients."
    } ]
  }, {
    "tStartMs": 917920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "There are other minor ones as well,"
    } ]
  }, {
    "tStartMs": 919440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "but three main ones to focus on."
    } ]
  }, {
    "tStartMs": 921280,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It's got cocoa solids, that's\nwhat gives it its color,"
    } ]
  }, {
    "tStartMs": 924880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "there are sugar, of course, for sweetness,"
    } ]
  }, {
    "tStartMs": 926960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and then there is cocoa butter."
    } ]
  }, {
    "tStartMs": 928880,
    "dDurationMs": 2306,
    "segs": [ {
      "utf8": "That's what gives it its texture."
    } ]
  }, {
    "tStartMs": 931186,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 931200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And this cocoa butter is the culprit."
    } ]
  }, {
    "tStartMs": 933280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It's a fat made from\nthree long carbon chains"
    } ]
  }, {
    "tStartMs": 935920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "bonded together in the middle\nto make this sort of Y shape."
    } ]
  }, {
    "tStartMs": 939600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And that Y shape can form\ntogether to form solids."
    } ]
  }, {
    "tStartMs": 942880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But there are multiple ways\nthey can stack together."
    } ]
  }, {
    "tStartMs": 945520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "There are many forms the crystal can take,"
    } ]
  }, {
    "tStartMs": 948000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "each with different properties."
    } ]
  }, {
    "tStartMs": 949680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And so we call these polymorphs."
    } ]
  }, {
    "tStartMs": 952640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Chocolate actually has six polymorphs."
    } ]
  }, {
    "tStartMs": 955440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The dull chocolate is mostly Form IV,"
    } ]
  }, {
    "tStartMs": 957920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and that has a melting point\nof around 27 degrees Celsius."
    } ]
  }, {
    "tStartMs": 961600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "While the shiny chocolate,\nwhich is the one we want,"
    } ]
  }, {
    "tStartMs": 964400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "is mostly Form V, and that\nhas a higher melting point"
    } ]
  }, {
    "tStartMs": 967600,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "of around 34 degrees Celsius."
    } ]
  }, {
    "tStartMs": 969758,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "- So the challenge and the\nart of chocolate making"
    } ]
  }, {
    "tStartMs": 972880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "is managing these polymorphs"
    } ]
  }, {
    "tStartMs": 974560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to get the right form of crystal"
    } ]
  }, {
    "tStartMs": 976320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "by managing both temperature\nand, importantly, time."
    } ]
  }, {
    "tStartMs": 979360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The nice thing about chocolate\nis you can start over."
    } ]
  }, {
    "tStartMs": 981440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "You just need to heat it\nback up to 45 to 50 Celsius"
    } ]
  }, {
    "tStartMs": 984160,
    "dDurationMs": 1438,
    "segs": [ {
      "utf8": "to wipe the memory-\n- Okay."
    } ]
  }, {
    "tStartMs": 985598,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "- of the wrong crystals."
    } ]
  }, {
    "tStartMs": 986640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "That's hot enough to melt\nout all of the crystals,"
    } ]
  }, {
    "tStartMs": 989200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but not too hot to start changing"
    } ]
  }, {
    "tStartMs": 991760,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "the flavor of the chocolate,"
    } ]
  }, {
    "tStartMs": 992720,
    "dDurationMs": 2389,
    "segs": [ {
      "utf8": "evaporating a lot of\nthe volatile aromatics."
    } ]
  }, {
    "tStartMs": 995109,
    "dDurationMs": 1371,
    "segs": [ {
      "utf8": "- [Casper] After around 10 minutes"
    } ]
  }, {
    "tStartMs": 996480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "at roughly 50 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 998400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "all the crystals should have fully melted."
    } ]
  }, {
    "tStartMs": 1000480,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- So at this point, we're\ntrying to cool it back down"
    } ]
  }, {
    "tStartMs": 1003440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to the temperature where\ncrystals start to form again."
    } ]
  }, {
    "tStartMs": 1006080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And that's gonna start\nat about 34 Celsius."
    } ]
  }, {
    "tStartMs": 1008640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You'll start getting Form\nV crystals forming at 34,"
    } ]
  }, {
    "tStartMs": 1011520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "as we cool even lower,"
    } ]
  }, {
    "tStartMs": 1012720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "we start to get Form IV and Form III."
    } ]
  }, {
    "tStartMs": 1015120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Those can all form at these temperatures."
    } ]
  }, {
    "tStartMs": 1017360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And that's okay. We want all\nof these crystals initially."
    } ]
  }, {
    "tStartMs": 1020000,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "We want-\n- Oh, really?"
    } ]
  }, {
    "tStartMs": 1020680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Yeah, we want to have"
    } ]
  }, {
    "tStartMs": 1022480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "sort of a shotgun of nucleation going on"
    } ]
  }, {
    "tStartMs": 1025360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "because we wanna make sure\nwe get lots of everything."
    } ]
  }, {
    "tStartMs": 1028360,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "- That's surprising."
    } ]
  }, {
    "tStartMs": 1029400,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- It does seem surprising."
    } ]
  }, {
    "tStartMs": 1030760,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- Because we just want Form V, right?"
    } ]
  }, {
    "tStartMs": 1033200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- We do just want Form V."
    } ]
  }, {
    "tStartMs": 1034880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The trick is, if we just\ncome down to the temperature"
    } ]
  }, {
    "tStartMs": 1037520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "where Form V forms,"
    } ]
  }, {
    "tStartMs": 1039280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "so if we just went to like\n32 degrees, 33 degrees,"
    } ]
  }, {
    "tStartMs": 1042400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and just waited there, you'd\nbe waiting a very long time"
    } ]
  }, {
    "tStartMs": 1044880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and you'd get a very random process"
    } ]
  }, {
    "tStartMs": 1046880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "of when does that crystal form,"
    } ]
  }, {
    "tStartMs": 1048720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and maybe only a few crystals would form."
    } ]
  }, {
    "tStartMs": 1050560,
    "dDurationMs": 1513,
    "segs": [ {
      "utf8": "And so they would get very large."
    } ]
  }, {
    "tStartMs": 1052073,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "- Ah.\n- By bringing the temperature"
    } ]
  }, {
    "tStartMs": 1053280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "all the way down to 27,"
    } ]
  }, {
    "tStartMs": 1054720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "we get lots of nucleation really fast."
    } ]
  }, {
    "tStartMs": 1056800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "The downside, of course,"
    } ]
  }, {
    "tStartMs": 1057600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "is we get the crystals\nwe don't want as well,"
    } ]
  }, {
    "tStartMs": 1060160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but we get lots of Form V,"
    } ]
  }, {
    "tStartMs": 1061600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and we get lots of small Form V."
    } ]
  }, {
    "tStartMs": 1063280,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1063680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- So once we have that starting to form,"
    } ]
  }, {
    "tStartMs": 1066240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "we can select for the ones we want"
    } ]
  }, {
    "tStartMs": 1068000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "just by raising the temperature back up."
    } ]
  }, {
    "tStartMs": 1070480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And melting the Form III and Form IV,"
    } ]
  }, {
    "tStartMs": 1072880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "leaving us with only\nForm V, but, importantly,"
    } ]
  }, {
    "tStartMs": 1075280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "lots of Form V.\n- Right."
    } ]
  }, {
    "tStartMs": 1077440,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "After holding the chocolate"
    } ]
  }, {
    "tStartMs": 1078720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "at around 32 degrees\nCelsius for 5 to 10 minutes,"
    } ]
  }, {
    "tStartMs": 1082160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "we can pour it into the mold."
    } ]
  }, {
    "tStartMs": 1083840,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- Okay, I think we're\ngonna be okay here, so."
    } ]
  }, {
    "tStartMs": 1087800,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- Oh."
    } ]
  }, {
    "tStartMs": 1090480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I don't know what I was expecting,"
    } ]
  }, {
    "tStartMs": 1091680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but I was not expecting\nit to go like this."
    } ]
  }, {
    "tStartMs": 1093600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It really comes out as a sort of sheet."
    } ]
  }, {
    "tStartMs": 1096560,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- One of the things here"
    } ]
  }, {
    "tStartMs": 1098800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is I do have some trapped air bubbles."
    } ]
  }, {
    "tStartMs": 1100800,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 1106020,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "- Oh, yeah."
    } ]
  }, {
    "tStartMs": 1108520,
    "dDurationMs": 4413,
    "segs": [ {
      "utf8": "- It's like a liquefaction.\n- Yeah, yeah."
    } ]
  }, {
    "tStartMs": 1112933,
    "dDurationMs": 2427,
    "segs": [ {
      "utf8": "- [Chris] So at this point,"
    } ]
  }, {
    "tStartMs": 1115360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "seems like we're done, right?\n- Yeah."
    } ]
  }, {
    "tStartMs": 1116960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- But actually now we need to lock in"
    } ]
  }, {
    "tStartMs": 1118720,
    "dDurationMs": 2472,
    "segs": [ {
      "utf8": "that crystal pattern that\nwe've created, right?"
    } ]
  }, {
    "tStartMs": 1121192,
    "dDurationMs": 1288,
    "segs": [ {
      "utf8": "- Yep.\n- Like, as it cools down,"
    } ]
  }, {
    "tStartMs": 1122480,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "there's liquid oil in there"
    } ]
  }, {
    "tStartMs": 1123520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and we're gonna drop back\ndown through the temperature"
    } ]
  }, {
    "tStartMs": 1125040,
    "dDurationMs": 2472,
    "segs": [ {
      "utf8": "where Form IV and Form III can form."
    } ]
  }, {
    "tStartMs": 1127512,
    "dDurationMs": 808,
    "segs": [ {
      "utf8": "- Yep.\n- So what we need to do"
    } ]
  }, {
    "tStartMs": 1128320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "is we need to come down"
    } ]
  }, {
    "tStartMs": 1129600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "through that temperature\nrelatively quickly"
    } ]
  }, {
    "tStartMs": 1131440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "so that we get mostly Form V growing"
    } ]
  }, {
    "tStartMs": 1134240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and lock them in by getting\nrid of most of the liquid oil."
    } ]
  }, {
    "tStartMs": 1137440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So we really need to get\nthis down to about 12 C."
    } ]
  }, {
    "tStartMs": 1140640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Casper] So we put it in the fridge"
    } ]
  }, {
    "tStartMs": 1142080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and waited for around 20 to 30 minutes."
    } ]
  }, {
    "tStartMs": 1144480,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "- Get the door closed.\n- Great."
    } ]
  }, {
    "tStartMs": 1148640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "If we did this correctly,\nit should be mostly Form V,"
    } ]
  }, {
    "tStartMs": 1152000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "which means all the molecules"
    } ]
  }, {
    "tStartMs": 1153600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "should have stacked tightly together,"
    } ]
  }, {
    "tStartMs": 1155760,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "resulting in a shiny and snappy bar."
    } ]
  }, {
    "tStartMs": 1158861,
    "dDurationMs": 2019,
    "segs": [ {
      "utf8": "(tray cracking)\nAh! Ooh!"
    } ]
  }, {
    "tStartMs": 1160880,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "That was satisfying."
    } ]
  }, {
    "tStartMs": 1161800,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- They're just barely hanging on."
    } ]
  }, {
    "tStartMs": 1163680,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "- Wow!"
    } ]
  }, {
    "tStartMs": 1164460,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "- And you can see they're nice."
    } ]
  }, {
    "tStartMs": 1166960,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- Perfect.\n- Shiny."
    } ]
  }, {
    "tStartMs": 1168200,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- This is all Form V?"
    } ]
  }, {
    "tStartMs": 1169840,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "- This is all Form V, and\nwe've got a nice shiny surface."
    } ]
  }, {
    "tStartMs": 1175280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Got a couple spots where maybe the molds"
    } ]
  }, {
    "tStartMs": 1176880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "could have been polished\na little bit more,"
    } ]
  }, {
    "tStartMs": 1178320,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "but give it a snap, just see how that is."
    } ]
  }, {
    "tStartMs": 1180941,
    "dDurationMs": 1449,
    "segs": [ {
      "utf8": "(chocolate snaps)\n- Ooh. It's a very good snap."
    } ]
  }, {
    "tStartMs": 1182390,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "- [Chris] Yeah, that's a nice."
    } ]
  }, {
    "tStartMs": 1183120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- It's very sturdy."
    } ]
  }, {
    "tStartMs": 1184960,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "- That's a good chocolate bar."
    } ]
  }, {
    "tStartMs": 1188062,
    "dDurationMs": 18,
    "segs": [ {
      "utf8": "- Delicious.\n- That"
    } ]
  }, {
    "tStartMs": 1188080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "is how you temper a chocolate bar."
    } ]
  }, {
    "tStartMs": 1189680,
    "dDurationMs": 1438,
    "segs": [ {
      "utf8": "- Amazing.\n(curious music)"
    } ]
  }, {
    "tStartMs": 1191118,
    "dDurationMs": 2162,
    "segs": [ {
      "utf8": "- But the stacking of the\nmolecules in the crystals"
    } ]
  }, {
    "tStartMs": 1193280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "also changes something else."
    } ]
  }, {
    "tStartMs": 1195200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Since each molecule is\nsurrounded by other molecules,"
    } ]
  }, {
    "tStartMs": 1198240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it changes how the bonds inside can move."
    } ]
  }, {
    "tStartMs": 1201360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "This is what the scientists at Abbott"
    } ]
  }, {
    "tStartMs": 1203120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "had seen in the spectrum."
    } ]
  }, {
    "tStartMs": 1204720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The needles they had\nseen under the microscope"
    } ]
  }, {
    "tStartMs": 1206880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "were a new polymorph of ritonavir,"
    } ]
  }, {
    "tStartMs": 1209760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and a more stable one at that."
    } ]
  }, {
    "tStartMs": 1211920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Form I crystals looked like this instead."
    } ]
  }, {
    "tStartMs": 1215280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Now at first this might\nseem like good news."
    } ]
  }, {
    "tStartMs": 1217600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It was still ritonavir, even\nif it looked a bit different."
    } ]
  }, {
    "tStartMs": 1221120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's just like how dull chocolate,"
    } ]
  }, {
    "tStartMs": 1223120,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "even if it's not quite as\nnice, is still chocolate."
    } ]
  }, {
    "tStartMs": 1226800,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But the problem was this new\npolymorph was far too stable."
    } ]
  }, {
    "tStartMs": 1230800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Ritonavir Form II"
    } ]
  }, {
    "tStartMs": 1233680,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "is substantially more stable than Form I."
    } ]
  }, {
    "tStartMs": 1237120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And the way we know it's more stable"
    } ]
  }, {
    "tStartMs": 1239440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "is because it's less soluble."
    } ]
  }, {
    "tStartMs": 1241600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But if that crystal structure"
    } ]
  }, {
    "tStartMs": 1243440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "happens to be much more stable,"
    } ]
  }, {
    "tStartMs": 1246720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "then it won't dissolve properly."
    } ]
  }, {
    "tStartMs": 1249680,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And then it's a bit like you\nhaven't taken the drug at all."
    } ]
  }, {
    "tStartMs": 1253680,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "- But with chocolate, we can\nchange which polymorph we have."
    } ]
  }, {
    "tStartMs": 1257120,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "We just had to heat it up to\nswitch it from shiny to dull,"
    } ]
  }, {
    "tStartMs": 1260880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and then by cooling it down\nagain in a specific way,"
    } ]
  }, {
    "tStartMs": 1263680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "we could get back to shiny."
    } ]
  }, {
    "tStartMs": 1265680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So you might expect that Abbott"
    } ]
  }, {
    "tStartMs": 1267440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "could just do something\nsimilar with ritonavir."
    } ]
  }, {
    "tStartMs": 1269840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And they tried, but the problem was"
    } ]
  }, {
    "tStartMs": 1272400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that no amount of heating or cooling"
    } ]
  }, {
    "tStartMs": 1275200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "could turn Form II back into Form I."
    } ]
  }, {
    "tStartMs": 1278080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "They were stuck."
    } ]
  }, {
    "tStartMs": 1279440,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "We can see what's happening\nby taking a look at this here."
    } ]
  }, {
    "tStartMs": 1284400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "See, each polymorph has\ndifferent energy levels."
    } ]
  }, {
    "tStartMs": 1287280,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And in the case of chocolate\nthat looks something like this,"
    } ]
  }, {
    "tStartMs": 1290560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "where Form IV has a higher energy level"
    } ]
  }, {
    "tStartMs": 1293040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and Form V a lower one,"
    } ]
  }, {
    "tStartMs": 1294960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and they're separated with\nthis sort of hill in between."
    } ]
  }, {
    "tStartMs": 1298080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Now, after heating up the chocolate bar,"
    } ]
  }, {
    "tStartMs": 1300400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "we were mostly left with Form IV."
    } ]
  }, {
    "tStartMs": 1302400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So let's drop this little ball in there,"
    } ]
  }, {
    "tStartMs": 1305760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and then you'll see it\nwill slowly settle down"
    } ]
  }, {
    "tStartMs": 1309120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "into that valley."
    } ]
  }, {
    "tStartMs": 1311040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But not to the more stable Form V."
    } ]
  }, {
    "tStartMs": 1313920,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And that's because there's\nthis little hill in between."
    } ]
  }, {
    "tStartMs": 1316800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But now imagine adding some heat to this."
    } ]
  }, {
    "tStartMs": 1319280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It's like giving the ball\na little bit of a kick."
    } ]
  }, {
    "tStartMs": 1322080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And you can see that the ball"
    } ]
  }, {
    "tStartMs": 1323920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "will suddenly start to move around."
    } ]
  }, {
    "tStartMs": 1325920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And if I give it enough of a kick,"
    } ]
  }, {
    "tStartMs": 1328480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "whoop, it will roll down into Form V."
    } ]
  }, {
    "tStartMs": 1331840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And now it is stuck there."
    } ]
  }, {
    "tStartMs": 1333760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Now you could keep adding more heat"
    } ]
  }, {
    "tStartMs": 1335600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and you could get it back\nover the hill back to Form IV,"
    } ]
  }, {
    "tStartMs": 1339120,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "but then you would just end\nup with a mess of both forms,"
    } ]
  }, {
    "tStartMs": 1343440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "because whenever you start\ncooling it down again,"
    } ]
  }, {
    "tStartMs": 1345680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "you know, the ball could\njust randomly settle"
    } ]
  }, {
    "tStartMs": 1347520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in one of the two valleys."
    } ]
  }, {
    "tStartMs": 1348720,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "So that's what happened"
    } ]
  }, {
    "tStartMs": 1349440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "when we melted the\nchocolate uncontrollably."
    } ]
  }, {
    "tStartMs": 1351520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "We just got a mixture of these two forms."
    } ]
  }, {
    "tStartMs": 1354720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "But with ritonavir, the\nsituation is a little different."
    } ]
  }, {
    "tStartMs": 1358240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The hill between the two\nforms is now much taller,"
    } ]
  }, {
    "tStartMs": 1361200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but the Form II valley\nis also much deeper."
    } ]
  }, {
    "tStartMs": 1364320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So once the ball does get down there,"
    } ]
  }, {
    "tStartMs": 1366080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it's basically impossible\nto get it back out of there,"
    } ]
  }, {
    "tStartMs": 1369200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "which is why no matter what\nthe scientists at Abbott tried,"
    } ]
  }, {
    "tStartMs": 1372400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "they couldn't get back to Form I."
    } ]
  }, {
    "tStartMs": 1375760,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "- But this still doesn't\nexplain why Form II"
    } ]
  }, {
    "tStartMs": 1379680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "was suddenly everywhere."
    } ]
  }, {
    "tStartMs": 1381520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Nothing had changed in their procedures."
    } ]
  }, {
    "tStartMs": 1383840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The barrier between the two\nforms should still be there."
    } ]
  }, {
    "tStartMs": 1387200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So it shouldn't have been possible"
    } ]
  }, {
    "tStartMs": 1388800,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to make this much Form II at all."
    } ]
  }, {
    "tStartMs": 1391360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And yet, 300 years earlier,"
    } ]
  }, {
    "tStartMs": 1393600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "legends of such a transformation"
    } ]
  }, {
    "tStartMs": 1395600,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "spread across northern Europe."
    } ]
  }, {
    "tStartMs": 1398224,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(gothic music)"
    } ]
  }, {
    "tStartMs": 1398238,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "- It was a bitter winter morning,"
    } ]
  }, {
    "tStartMs": 1400560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and it had been like this for months."
    } ]
  }, {
    "tStartMs": 1402560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The organist was on\nhis way to a cathedral."
    } ]
  }, {
    "tStartMs": 1405120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The cold had been messing\nwith the organ pipes."
    } ]
  }, {
    "tStartMs": 1407520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It's gone out of tune again."
    } ]
  }, {
    "tStartMs": 1409360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But that wasn't what the\ncongregation thought."
    } ]
  }, {
    "tStartMs": 1412160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "There were stories of other organs"
    } ]
  }, {
    "tStartMs": 1414400,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "getting sick with warts or\nleprosy eating away at the pipes."
    } ]
  }, {
    "tStartMs": 1419280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Some thought it was the\ndevil attacking the organ"
    } ]
  }, {
    "tStartMs": 1422080,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to punish an unfaithful flock."
    } ]
  }, {
    "tStartMs": 1425040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It was even said that\nwhen it was very quiet,"
    } ]
  }, {
    "tStartMs": 1428080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you could hear these organs screaming"
    } ]
  }, {
    "tStartMs": 1430080,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "and groaning in pain from the lesions."
    } ]
  }, {
    "tStartMs": 1434720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Nonsense, of course,"
    } ]
  }, {
    "tStartMs": 1436160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "it was just the metal\ncontracting and expanding."
    } ]
  }, {
    "tStartMs": 1439600,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 1439760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Except these pipes\nweren't just contracting,"
    } ]
  }, {
    "tStartMs": 1443040,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "they were cracked."
    } ]
  }, {
    "tStartMs": 1444480,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And others are indeed covered"
    } ]
  }, {
    "tStartMs": 1446160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in what looks like these lesions,"
    } ]
  }, {
    "tStartMs": 1448800,
    "dDurationMs": 8308,
    "segs": [ {
      "utf8": "black growths all over the organ."
    } ]
  }, {
    "tStartMs": 1457108,
    "dDurationMs": 12,
    "segs": [ {
      "utf8": "(dark music)"
    } ]
  }, {
    "tStartMs": 1457120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Now, originally when this happened,"
    } ]
  }, {
    "tStartMs": 1458880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "people thought that this\nwas the work of Satan."
    } ]
  }, {
    "tStartMs": 1461760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Of course, that's not what was going on,"
    } ]
  }, {
    "tStartMs": 1463360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and we can explain what\nwas actually happening."
    } ]
  }, {
    "tStartMs": 1465840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So we've got some normal tin right here,"
    } ]
  }, {
    "tStartMs": 1468160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "which is what those organ\npipes were made out of."
    } ]
  }, {
    "tStartMs": 1470800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It kind of looks silver,\nit feels pretty strong,"
    } ]
  }, {
    "tStartMs": 1474160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and it's sort of the form we're used to."
    } ]
  }, {
    "tStartMs": 1476240,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 1477020,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "- But here we have a slightly\ndifferent form of tin."
    } ]
  }, {
    "tStartMs": 1480640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You can look at it, it's a bit more gray,"
    } ]
  }, {
    "tStartMs": 1483440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it's a bit more crumbly."
    } ]
  }, {
    "tStartMs": 1485120,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And at room temperature,"
    } ]
  }, {
    "tStartMs": 1486400,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "normally the silvery tin\nis sort of more stable."
    } ]
  }, {
    "tStartMs": 1490160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But if you cool tin down"
    } ]
  }, {
    "tStartMs": 1493040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to something like below\n13 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 1495680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and ideally way colder,"
    } ]
  }, {
    "tStartMs": 1497040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "then it can transform into\nthis new kind of gray tin."
    } ]
  }, {
    "tStartMs": 1499840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And we're gonna see what happens"
    } ]
  }, {
    "tStartMs": 1501040,
    "dDurationMs": 3424,
    "segs": [ {
      "utf8": "when we put it on top of the silver tin."
    } ]
  }, {
    "tStartMs": 1504464,
    "dDurationMs": 1056,
    "segs": [ {
      "utf8": "- [Dr. Kafizas] We want to try and get it"
    } ]
  }, {
    "tStartMs": 1505520,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "to around minus 30 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1507743,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "- [Casper] Yep."
    } ]
  }, {
    "tStartMs": 1507758,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "- And what better to get\nus to those temperatures"
    } ]
  }, {
    "tStartMs": 1509760,
    "dDurationMs": 1278,
    "segs": [ {
      "utf8": "is dry ice.\n- Okay."
    } ]
  }, {
    "tStartMs": 1511038,
    "dDurationMs": 3282,
    "segs": [ {
      "utf8": "- So dry ice is frozen carbon dioxide."
    } ]
  }, {
    "tStartMs": 1514320,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "And that is around minus\n78 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1517567,
    "dDurationMs": 753,
    "segs": [ {
      "utf8": "- [Casper] Yep."
    } ]
  }, {
    "tStartMs": 1518320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Now we've taken a thermo flask"
    } ]
  }, {
    "tStartMs": 1520320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and filled it up with dry ice,"
    } ]
  }, {
    "tStartMs": 1521920,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and then put a platform on top\non which we'll put our tin."
    } ]
  }, {
    "tStartMs": 1525680,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "This should cool it down to\naround minus 30 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1529840,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now we left this here for around 14 hours,"
    } ]
  }, {
    "tStartMs": 1532640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and what you'll see is that initially"
    } ]
  }, {
    "tStartMs": 1534480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "there's a very tiny speck of tin"
    } ]
  }, {
    "tStartMs": 1536720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that suddenly transformed into gray tin,"
    } ]
  }, {
    "tStartMs": 1539040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and then it spreads from there"
    } ]
  }, {
    "tStartMs": 1540880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "almost like an infectious disease,"
    } ]
  }, {
    "tStartMs": 1543680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "which is why this is\nalso known as tin pest."
    } ]
  }, {
    "tStartMs": 1547200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And because gray tin is\nless dense, the tin expands."
    } ]
  }, {
    "tStartMs": 1550400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And so if you look closely,"
    } ]
  }, {
    "tStartMs": 1552240,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "you can see it start to\ntear apart the metal."
    } ]
  }, {
    "tStartMs": 1556560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Now, normally it takes a lot of energy"
    } ]
  }, {
    "tStartMs": 1559040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to transform some silver\ntin into gray tin,"
    } ]
  }, {
    "tStartMs": 1562400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "but once you get a tiny bit of gray tin,"
    } ]
  }, {
    "tStartMs": 1565200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "something strange happens,"
    } ]
  }, {
    "tStartMs": 1566400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "because now it acts as a nucleation site"
    } ]
  }, {
    "tStartMs": 1568960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that other tin can attach to,"
    } ]
  }, {
    "tStartMs": 1570720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and it effectively brings\nthat hill way down."
    } ]
  }, {
    "tStartMs": 1573600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It lowers the activation energy."
    } ]
  }, {
    "tStartMs": 1575360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And so now it becomes very easy"
    } ]
  }, {
    "tStartMs": 1576960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to switch from silver tin to gray tin."
    } ]
  }, {
    "tStartMs": 1578960,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "And so it starts to spread,\nit starts to take over."
    } ]
  }, {
    "tStartMs": 1583120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And the same thing was\nhappening to those organ pipes."
    } ]
  }, {
    "tStartMs": 1585680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Once you got a lesion\non one of those pipes,"
    } ]
  }, {
    "tStartMs": 1588160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "well then it would grow\nand spread everywhere."
    } ]
  }, {
    "tStartMs": 1590800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Little flakes would come off the pipes"
    } ]
  }, {
    "tStartMs": 1592880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and seed all the others,\nand it would spread."
    } ]
  }, {
    "tStartMs": 1596720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And that's also exactly what\nhappened with ritonavir."
    } ]
  }, {
    "tStartMs": 1600080,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Once a tiny bit of Form II appeared,"
    } ]
  }, {
    "tStartMs": 1602560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it acted as a nucleation site,"
    } ]
  }, {
    "tStartMs": 1604960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "lowering that massive activation energy"
    } ]
  }, {
    "tStartMs": 1607440,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and causing all the Form I\nto crystallize into Form II."
    } ]
  }, {
    "tStartMs": 1611840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Tiny seed crystals then broke off,"
    } ]
  }, {
    "tStartMs": 1614560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "could become airborne, and spread,"
    } ]
  }, {
    "tStartMs": 1616960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "attaching themselves to people's clothes"
    } ]
  }, {
    "tStartMs": 1619280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and making it to other parts\nof the production line,"
    } ]
  }, {
    "tStartMs": 1622240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "effectively seeding them"
    } ]
  }, {
    "tStartMs": 1624400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "so that when new\nritonavir was synthesized,"
    } ]
  }, {
    "tStartMs": 1627360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "it contained these seed crystals"
    } ]
  }, {
    "tStartMs": 1629200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and turned the entire\ncapsules into Form II."
    } ]
  }, {
    "tStartMs": 1632800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And because everyone likely had"
    } ]
  }, {
    "tStartMs": 1634640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "these seed crystals on their clothes,"
    } ]
  }, {
    "tStartMs": 1636720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "when the Chicago team flew over to Italy,"
    } ]
  }, {
    "tStartMs": 1639840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "they seeded that factory too."
    } ]
  }, {
    "tStartMs": 1642560,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And in this way,"
    } ]
  }, {
    "tStartMs": 1643920,
    "dDurationMs": 3758,
    "segs": [ {
      "utf8": "soon not a single place was\nable to manufacture Form I."
    } ]
  }, {
    "tStartMs": 1647678,
    "dDurationMs": 3842,
    "segs": [ {
      "utf8": "- [Derek] Ritonavir is\narguably the most dramatic case"
    } ]
  }, {
    "tStartMs": 1651520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "of what we now call a\ndisappearing polymorph."
    } ]
  }, {
    "tStartMs": 1654720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The YouTube channel Reactions\nmade a great video about this"
    } ]
  }, {
    "tStartMs": 1657840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that involves lots of physical demos,"
    } ]
  }, {
    "tStartMs": 1659760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "so I highly recommend you check it out."
    } ]
  }, {
    "tStartMs": 1662160,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "- [Narrator] \"When this happened to us,"
    } ]
  }, {
    "tStartMs": 1663280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "we conducted an extremely\nthorough investigation"
    } ]
  }, {
    "tStartMs": 1665680,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "to see if there was something"
    } ]
  }, {
    "tStartMs": 1666720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that we did which would have caused this."
    } ]
  }, {
    "tStartMs": 1669040,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "While we've speculated"
    } ]
  }, {
    "tStartMs": 1670160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "on the cause of this\nchemical transformation,"
    } ]
  }, {
    "tStartMs": 1672480,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "we do not have conclusive\nproof of what happened.\""
    } ]
  }, {
    "tStartMs": 1675800,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- It might be that a mistake\non the production line"
    } ]
  }, {
    "tStartMs": 1679120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "caused some chemicals to dry out."
    } ]
  }, {
    "tStartMs": 1681760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This might have created a new crystal"
    } ]
  }, {
    "tStartMs": 1683760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "similar in shape to Form II ritonavir,"
    } ]
  }, {
    "tStartMs": 1686400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "which acted like a seed."
    } ]
  }, {
    "tStartMs": 1688240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Or it might have just been bad luck"
    } ]
  }, {
    "tStartMs": 1690560,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "that a seed crystal formed\non its own purely by chance."
    } ]
  }, {
    "tStartMs": 1693880,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Even if you have a seed crystal,"
    } ]
  }, {
    "tStartMs": 1696480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "if there are some dust particles"
    } ]
  }, {
    "tStartMs": 1698640,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "or some scratches in the recipient"
    } ]
  }, {
    "tStartMs": 1703680,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "where actually crystals\ncan start to nucleate,"
    } ]
  }, {
    "tStartMs": 1708000,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that can induce, then,\ndifferent crystal structures."
    } ]
  }, {
    "tStartMs": 1710880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "So it happens that in some\npharmaceutical companies"
    } ]
  }, {
    "tStartMs": 1714640,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "where they produced the same\npolymorph for years and years,"
    } ]
  }, {
    "tStartMs": 1719360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that suddenly there is, I would say,"
    } ]
  }, {
    "tStartMs": 1721840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "a hair or some other particle that,"
    } ]
  }, {
    "tStartMs": 1724960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "kind of, gets into the process"
    } ]
  }, {
    "tStartMs": 1726800,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "and will change the entire\ncrystallization of the compound,"
    } ]
  }, {
    "tStartMs": 1731760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and is then very difficult to control."
    } ]
  }, {
    "tStartMs": 1734240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- And once a more stable\nform has appeared,"
    } ]
  }, {
    "tStartMs": 1736880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "it can spread and quickly\nseed the entire planet."
    } ]
  }, {
    "tStartMs": 1740160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- It might be that you"
    } ]
  }, {
    "tStartMs": 1741520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "will never, ever get the\ninitial polymorph again."
    } ]
  }, {
    "tStartMs": 1744320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- After five months of\nresearch, Abbott's researchers"
    } ]
  }, {
    "tStartMs": 1747200,
    "dDurationMs": 3492,
    "segs": [ {
      "utf8": "held a press conference\nto share their findings."
    } ]
  }, {
    "tStartMs": 1750692,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 1750707,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "- [Narrator] \"Good afternoon."
    } ]
  }, {
    "tStartMs": 1751760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "My colleagues and I are here today"
    } ]
  }, {
    "tStartMs": 1753200,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "to explain what has happened,\nwhy it has happened,"
    } ]
  }, {
    "tStartMs": 1756640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "how we've responded to the problem,"
    } ]
  }, {
    "tStartMs": 1758240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and what we're going to\ndo to correct the problem."
    } ]
  }, {
    "tStartMs": 1761280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Sometime during this summer,"
    } ]
  }, {
    "tStartMs": 1762640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the semi-solid formulation of ritonavir"
    } ]
  }, {
    "tStartMs": 1765760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "began to change into a crystal form,"
    } ]
  }, {
    "tStartMs": 1768000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "a transformation that we believed"
    } ]
  }, {
    "tStartMs": 1769600,
    "dDurationMs": 9427,
    "segs": [ {
      "utf8": "was a scientific and\nchemical impossibility."
    } ]
  }, {
    "tStartMs": 1779027,
    "dDurationMs": 2653,
    "segs": [ {
      "utf8": "- [Narrator] \"You are a\nlarge multinational company."
    } ]
  }, {
    "tStartMs": 1781680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Your scientists are obviously smart."
    } ]
  }, {
    "tStartMs": 1784000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "How could this happen?\""
    } ]
  }, {
    "tStartMs": 1785600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- [Narrator] \"A company's\nsize and the collective IQs"
    } ]
  }, {
    "tStartMs": 1788720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "of their scientists have no\nrelationship to this problem."
    } ]
  }, {
    "tStartMs": 1792000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "This phenomenon is, I\nbelieve, unpredictable."
    } ]
  }, {
    "tStartMs": 1794720,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "We are, in some sense,\nthe victim of bad luck."
    } ]
  }, {
    "tStartMs": 1798640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "There are many mysteries of\nnature that we've not solved."
    } ]
  }, {
    "tStartMs": 1801280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Hurricanes, for example,"
    } ]
  }, {
    "tStartMs": 1802480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "continue to occur and often\ncause massive devastation."
    } ]
  }, {
    "tStartMs": 1805680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "There is nothing that we can do today"
    } ]
  }, {
    "tStartMs": 1807360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to prevent a hurricane\nfrom striking any community"
    } ]
  }, {
    "tStartMs": 1809920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "or polymorphism from striking any drug."
    } ]
  }, {
    "tStartMs": 1813120,
    "dDurationMs": 7423,
    "segs": [ {
      "utf8": "Science cannot provide a\nsolution to all our problems.\""
    } ]
  }, {
    "tStartMs": 1820543,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(curious music)"
    } ]
  }, {
    "tStartMs": 1820558,
    "dDurationMs": 1362,
    "segs": [ {
      "utf8": "- Now, here's a good question."
    } ]
  }, {
    "tStartMs": 1821920,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Is everything polymorphic?"
    } ]
  }, {
    "tStartMs": 1824400,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "So nobody had discovered a\npolymorph of aspirin, right?"
    } ]
  }, {
    "tStartMs": 1828800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So it had been around, it's\none of the earliest drugs."
    } ]
  }, {
    "tStartMs": 1831200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It had been crystallized in industry"
    } ]
  }, {
    "tStartMs": 1833920,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "for what, 130, 140 years?"
    } ]
  }, {
    "tStartMs": 1838080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And so can you say,"
    } ]
  }, {
    "tStartMs": 1839680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "\"Because nobody had discovered"
    } ]
  }, {
    "tStartMs": 1841440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a polymorph of aspirin, therefore...\""
    } ]
  }, {
    "tStartMs": 1843360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "No. Right?"
    } ]
  }, {
    "tStartMs": 1844640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The only problem is"
    } ]
  }, {
    "tStartMs": 1847440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I discovered Form II of aspirin. (laughs)"
    } ]
  }, {
    "tStartMs": 1850320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "By accident. Right?"
    } ]
  }, {
    "tStartMs": 1851520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- It turns out over half of all compounds"
    } ]
  }, {
    "tStartMs": 1854400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "are known to be polymorphic,\nand there could be more."
    } ]
  }, {
    "tStartMs": 1857040,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- The number of polymorphs"
    } ]
  }, {
    "tStartMs": 1858560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "is proportional to the amount of time"
    } ]
  }, {
    "tStartMs": 1860400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and money you spend\nresearching that compound."
    } ]
  }, {
    "tStartMs": 1863360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- In fact, nowadays we know"
    } ]
  }, {
    "tStartMs": 1864880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "there are not two forms of\nritonavir, but at least five."
    } ]
  }, {
    "tStartMs": 1868720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So are new cases of\ndisappearing polymorphs"
    } ]
  }, {
    "tStartMs": 1871440,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "something to worry about?"
    } ]
  }, {
    "tStartMs": 1872560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- It's quite, quite rare."
    } ]
  }, {
    "tStartMs": 1874880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "We certainly know a lot more"
    } ]
  }, {
    "tStartMs": 1877520,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "than we did when ritonavir occurred,"
    } ]
  }, {
    "tStartMs": 1881680,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "but I wouldn't be surprised\nto see it happen again."
    } ]
  }, {
    "tStartMs": 1885440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- If there's a 1% chance\nthe world's gonna end,"
    } ]
  }, {
    "tStartMs": 1888240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "you're gonna do something about it, right?"
    } ]
  }, {
    "tStartMs": 1890720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "If there's a 1% chance\na plane is gonna crash,"
    } ]
  }, {
    "tStartMs": 1893040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you're not gonna fly, right?"
    } ]
  }, {
    "tStartMs": 1896640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "So, so yeah."
    } ]
  }, {
    "tStartMs": 1897760,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "So we're at that situation\nwhere it might only be"
    } ]
  }, {
    "tStartMs": 1902720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "in that order of 1%, but if it happens,"
    } ]
  }, {
    "tStartMs": 1905760,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "it's gonna cost you a hell of a lot more"
    } ]
  }, {
    "tStartMs": 1907520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "than a few weeks of\nresearch on polymorphs."
    } ]
  }, {
    "tStartMs": 1910080,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Ritonavir was one of the red flags"
    } ]
  }, {
    "tStartMs": 1915040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that caused a lot of regulatory activity"
    } ]
  }, {
    "tStartMs": 1918080,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and a lot of scientific\nactivity around polymorphs."
    } ]
  }, {
    "tStartMs": 1921800,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- Nowadays, pharmaceutical companies"
    } ]
  }, {
    "tStartMs": 1923920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "can spend hundreds of thousands"
    } ]
  }, {
    "tStartMs": 1925440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to millions of dollars\nscreening for polymorphs."
    } ]
  }, {
    "tStartMs": 1928560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "In the end, there was no way"
    } ]
  }, {
    "tStartMs": 1930160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "of getting Form I ritonavir\nback successfully."
    } ]
  }, {
    "tStartMs": 1932960,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "There were attempts, but\nall were incredibly costly,"
    } ]
  }, {
    "tStartMs": 1936160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and they risked being infected again."
    } ]
  }, {
    "tStartMs": 1939120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So instead, Abbott went back"
    } ]
  }, {
    "tStartMs": 1940960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to an older liquid formulation of the drug"
    } ]
  }, {
    "tStartMs": 1943280,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "and abandoned Form I entirely."
    } ]
  }, {
    "tStartMs": 1946467,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "- [Narrator] \"Our initial\nactivities were directed"
    } ]
  }, {
    "tStartMs": 1948240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "towards eliminating Form\nII from our environment."
    } ]
  }, {
    "tStartMs": 1950960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "We finally accepted that we could not."
    } ]
  }, {
    "tStartMs": 1953440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Our subsequent activities were directed"
    } ]
  }, {
    "tStartMs": 1955440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "towards figuring out how\nto live in a Form II world."
    } ]
  }, {
    "tStartMs": 1959280,
    "dDurationMs": 4303,
    "segs": [ {
      "utf8": "Nature would appear to favor it.\""
    } ]
  }, {
    "tStartMs": 1963583,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(curious music)"
    } ]
  }, {
    "tStartMs": 1963598,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "- The liquid formulation was not ideal."
    } ]
  }, {
    "tStartMs": 1966000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It had worse side effects,"
    } ]
  }, {
    "tStartMs": 1967520,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "and not all patients could\ntolerate it well, but it worked."
    } ]
  }, {
    "tStartMs": 1971587,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "- [Narrator] \"It is frightening\nthat this could happen"
    } ]
  }, {
    "tStartMs": 1973040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to any drug that we've taken\nand on which we're dependent,"
    } ]
  }, {
    "tStartMs": 1975920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "even though it is not that common."
    } ]
  }, {
    "tStartMs": 1977920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This time, it has happened to Abbott"
    } ]
  }, {
    "tStartMs": 1979600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and to the tens of thousands of people"
    } ]
  }, {
    "tStartMs": 1981520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "taking the semi-solid capsule."
    } ]
  }, {
    "tStartMs": 1983520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Thankfully, we had the liquid\nformulation as a safety net."
    } ]
  }, {
    "tStartMs": 1986480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Next time it may happen to another drug"
    } ]
  }, {
    "tStartMs": 1988640,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "that may not have the safety net.\""
    } ]
  }, {
    "tStartMs": 1993200,
    "dDurationMs": 1677,
    "segs": [ {
      "utf8": "(curious music continues)"
    } ]
  } ]
}
