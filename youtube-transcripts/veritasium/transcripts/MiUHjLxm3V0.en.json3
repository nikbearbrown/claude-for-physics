{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 150,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- This is a microchip."
    } ]
  }, {
    "tStartMs": 1530,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "When you zoom in, you find\na nanoscopic computing city,"
    } ]
  }, {
    "tStartMs": 5010,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "skyscrapers hundreds of layers tall"
    } ]
  }, {
    "tStartMs": 7320,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "with hundreds of kilometers of\nwires connecting everything."
    } ]
  }, {
    "tStartMs": 10950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And at the very bottom is this,"
    } ]
  }, {
    "tStartMs": 13830,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "transistors,"
    } ]
  }, {
    "tStartMs": 15810,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "billions of them."
    } ]
  }, {
    "tStartMs": 17430,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "They are the ones and\nzeros of our computer."
    } ]
  }, {
    "tStartMs": 20550,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The chip works by whizzing electrons"
    } ]
  }, {
    "tStartMs": 22080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "from transistor to transistor,"
    } ]
  }, {
    "tStartMs": 24060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and the smaller you can\nmake those transistors,"
    } ]
  }, {
    "tStartMs": 25890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "the less the signals have to travel,"
    } ]
  }, {
    "tStartMs": 27420,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so the faster they can compute."
    } ]
  }, {
    "tStartMs": 29340,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Plus, you can fit more\ntransistors into the same area,"
    } ]
  }, {
    "tStartMs": 32550,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "resulting in a much more powerful chip."
    } ]
  }, {
    "tStartMs": 35460,
    "dDurationMs": 3357,
    "segs": [ {
      "utf8": "So for over 50 years, transistors\ngot smaller and smaller,"
    } ]
  }, {
    "tStartMs": 38817,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "and the number you could\nfit on a chip doubled"
    } ]
  }, {
    "tStartMs": 41190,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "every two years."
    } ]
  }, {
    "tStartMs": 42720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "This became known as Moore's Law,"
    } ]
  }, {
    "tStartMs": 44490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "named for Intel's\nco-founder, Gordon Moore,"
    } ]
  }, {
    "tStartMs": 46860,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "after he noticed the pattern back in 1965,"
    } ]
  }, {
    "tStartMs": 49590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and it's been one of the main\ndrivers of the tech industry."
    } ]
  }, {
    "tStartMs": 52590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But around 2015,"
    } ]
  }, {
    "tStartMs": 53970,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "progress came to a screeching halt,"
    } ]
  }, {
    "tStartMs": 56400,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "and we might have never gotten past it"
    } ]
  }, {
    "tStartMs": 58090,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "if it wasn't for a single company\nthat makes these machines,"
    } ]
  }, {
    "tStartMs": 62250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the machines that saved Moore's Law."
    } ]
  }, {
    "tStartMs": 64800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- Holy."
    } ]
  }, {
    "tStartMs": 66030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- This is a video about\nthe most complicated"
    } ]
  }, {
    "tStartMs": 68490,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "commercial product humanity's ever built."
    } ]
  }, {
    "tStartMs": 71250,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- That's insane."
    } ]
  }, {
    "tStartMs": 72690,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- It costs a whopping $400 million,"
    } ]
  }, {
    "tStartMs": 75150,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and it is so bizarre that I\nwant to introduce it to you"
    } ]
  }, {
    "tStartMs": 78060,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "with a thought experiment."
    } ]
  }, {
    "tStartMs": 81150,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Imagine you are shrunk down"
    } ]
  }, {
    "tStartMs": 82800,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "to the size of an ant,"
    } ]
  }, {
    "tStartMs": 85170,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and you are given a laser\nthat's strong enough to melt"
    } ]
  }, {
    "tStartMs": 87960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "through metal like butter."
    } ]
  }, {
    "tStartMs": 89760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Next, a tiny droplet of molten tin,"
    } ]
  }, {
    "tStartMs": 91890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "roughly the size of a white blood cell,"
    } ]
  }, {
    "tStartMs": 93900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is shot out in front of you"
    } ]
  }, {
    "tStartMs": 95340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "around 250 kilometers per hour."
    } ]
  }, {
    "tStartMs": 98010,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And your task is to hit\nthis not once, not twice,"
    } ]
  }, {
    "tStartMs": 101310,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but three times in a\nrow in 20 microseconds"
    } ]
  }, {
    "tStartMs": 104130,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "with your little laser."
    } ]
  }, {
    "tStartMs": 105870,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Well, that is exactly\nwhat this machine does."
    } ]
  }, {
    "tStartMs": 108450,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It hits one tiny tin droplet\nthree times in a row,"
    } ]
  }, {
    "tStartMs": 111690,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "heating each one up to\nover 220,000 Kelvin."
    } ]
  }, {
    "tStartMs": 115350,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "That's roughly 40 times hotter\nthan the surface of the Sun."
    } ]
  }, {
    "tStartMs": 119100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And it doesn't just hit one droplet,"
    } ]
  }, {
    "tStartMs": 121230,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "it hits 50,000 droplets\nevery single second."
    } ]
  }, {
    "tStartMs": 125280,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "How often do you miss a laser shot?"
    } ]
  }, {
    "tStartMs": 127350,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- We don't miss them."
    } ]
  }, {
    "tStartMs": 128610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What?"
    } ]
  }, {
    "tStartMs": 129443,
    "dDurationMs": 3517,
    "segs": [ {
      "utf8": "You do 150,000 laser shots a second,"
    } ]
  }, {
    "tStartMs": 132960,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and you don't miss one?"
    } ]
  }, {
    "tStartMs": 134370,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 135750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- The same machine also contains mirrors"
    } ]
  }, {
    "tStartMs": 137640,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that might just be the smoothest\nobjects in the universe."
    } ]
  }, {
    "tStartMs": 141240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If you scale one up to\nthe size of the Earth,"
    } ]
  }, {
    "tStartMs": 143580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "then the largest bump would be"
    } ]
  }, {
    "tStartMs": 144930,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "no thicker than a playing card."
    } ]
  }, {
    "tStartMs": 147090,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "On top of that, it is able to overlay"
    } ]
  }, {
    "tStartMs": 148980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "one layer of a chip\nperfectly on top of another"
    } ]
  }, {
    "tStartMs": 151380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and never be off by more than five atoms."
    } ]
  }, {
    "tStartMs": 154410,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And this is all happening"
    } ]
  }, {
    "tStartMs": 155700,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "while parts of the machine whip around"
    } ]
  }, {
    "tStartMs": 157590,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "at accelerations of over 20 Gs."
    } ]
  }, {
    "tStartMs": 160130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(machine rattles)."
    } ]
  }, {
    "tStartMs": 160963,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "For 30 years, almost everyone thought"
    } ]
  }, {
    "tStartMs": 162930,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that actually building this\nmachine was impossible,"
    } ]
  }, {
    "tStartMs": 166050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and yet it exists."
    } ]
  }, {
    "tStartMs": 168090,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "There is only one company in\nthe world that can make it."
    } ]
  }, {
    "tStartMs": 171630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So what is this company and what is"
    } ]
  }, {
    "tStartMs": 173670,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "this impossible machine they've built?"
    } ]
  }, {
    "tStartMs": 176100,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This video is sponsored by Brilliant."
    } ]
  }, {
    "tStartMs": 178020,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 180390,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now, just as a quick aside,"
    } ]
  }, {
    "tStartMs": 181830,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the makers of this machine\ndidn't actually sponsor"
    } ]
  }, {
    "tStartMs": 184290,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "this video."
    } ]
  }, {
    "tStartMs": 185220,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "We just thought that the science\nand engineering here were"
    } ]
  }, {
    "tStartMs": 187650,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "so cool that we had to\nmake a video about it."
    } ]
  }, {
    "tStartMs": 190530,
    "dDurationMs": 2214,
    "segs": [ {
      "utf8": "So let's jump straight in."
    } ]
  }, {
    "tStartMs": 192744,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 193577,
    "dDurationMs": 853,
    "segs": [ {
      "utf8": "- [Derek] To make a microchip, you start"
    } ]
  }, {
    "tStartMs": 194430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "by taking silicon dioxide,\nusually from sand,"
    } ]
  }, {
    "tStartMs": 196860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and purifying it into ultrapure,"
    } ]
  }, {
    "tStartMs": 199140,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "nearly 100% silicon chunks,"
    } ]
  }, {
    "tStartMs": 202530,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which is then melted down\nin a special furnace."
    } ]
  }, {
    "tStartMs": 205590,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Next, you lower a small\nseed crystal into the vat."
    } ]
  }, {
    "tStartMs": 208770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Silicon atoms attach to the crystal,"
    } ]
  }, {
    "tStartMs": 210750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "extending its structure."
    } ]
  }, {
    "tStartMs": 212610,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Then you slowly raise the\nseed crystal while rotating it"
    } ]
  }, {
    "tStartMs": 215760,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and this results in a large,\nsingle crystal silicon ingot."
    } ]
  }, {
    "tStartMs": 219420,
    "dDurationMs": 2116,
    "segs": [ {
      "utf8": "- This is where the seed crystal would be."
    } ]
  }, {
    "tStartMs": 221536,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "Yeah.\n- And then you pull it out."
    } ]
  }, {
    "tStartMs": 222695,
    "dDurationMs": 844,
    "segs": [ {
      "utf8": "- [Casper] Can I touch it?"
    } ]
  }, {
    "tStartMs": 223539,
    "dDurationMs": 1011,
    "segs": [ {
      "utf8": "- Yeah, you can."
    } ]
  }, {
    "tStartMs": 224550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- It seems like you\nwould not be able to hold"
    } ]
  }, {
    "tStartMs": 226890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "this from here.\n- Yes."
    } ]
  }, {
    "tStartMs": 228780,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- It even feels fragile."
    } ]
  }, {
    "tStartMs": 230220,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "Like if you kinda."
    } ]
  }, {
    "tStartMs": 231337,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Person Off-Camera] Don't snap it."
    } ]
  }, {
    "tStartMs": 232170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Yeah, I'm scared to break it."
    } ]
  }, {
    "tStartMs": 233970,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 235110,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- He's using more force."
    } ]
  }, {
    "tStartMs": 236670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Derek] The ingot is\nthen cut into wafers"
    } ]
  }, {
    "tStartMs": 238530,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "with diamond wire saws,\nup to 5,000 of them,"
    } ]
  }, {
    "tStartMs": 242040,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "after which each wafer\nis carefully polished."
    } ]
  }, {
    "tStartMs": 245070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Next, it's coated with a light\nsensitive material called"
    } ]
  }, {
    "tStartMs": 247590,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "photoresist."
    } ]
  }, {
    "tStartMs": 248790,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "There are different kinds,"
    } ]
  }, {
    "tStartMs": 249810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but in a positive photoresist,"
    } ]
  }, {
    "tStartMs": 251490,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the areas exposed to light\nbecome weaker and more soluble."
    } ]
  }, {
    "tStartMs": 255120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So if you shine light\nthrough a patterned mask,"
    } ]
  }, {
    "tStartMs": 257430,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you can selectively weaken\nparts of that coating."
    } ]
  }, {
    "tStartMs": 260130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Then, you rinse the wafer\nwith a basic solution"
    } ]
  }, {
    "tStartMs": 262440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to wash away the exposed photoresist,"
    } ]
  }, {
    "tStartMs": 264810,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "leaving the design imprinted."
    } ]
  }, {
    "tStartMs": 267810,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So now you can actually turn this pattern"
    } ]
  }, {
    "tStartMs": 269790,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "into physical structures."
    } ]
  }, {
    "tStartMs": 271350,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "This is often done by etching"
    } ]
  }, {
    "tStartMs": 272760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "into the uncovered silicon"
    } ]
  }, {
    "tStartMs": 274200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "by using either chemicals or plasma."
    } ]
  }, {
    "tStartMs": 276840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And then you deposit a metal, like copper,"
    } ]
  }, {
    "tStartMs": 279030,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to fill in those etched lines."
    } ]
  }, {
    "tStartMs": 281550,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "As a last step, you wash away\nthe remaining photoresist,"
    } ]
  }, {
    "tStartMs": 284880,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and now you've made a\nsingle layer of the chip."
    } ]
  }, {
    "tStartMs": 288360,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "We've simplified this cycle\ndown to the main steps,"
    } ]
  }, {
    "tStartMs": 290700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "coat, expose, etch and deposit."
    } ]
  }, {
    "tStartMs": 293100,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It repeats for every single chip layer,"
    } ]
  }, {
    "tStartMs": 295410,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "and depending on the chip,"
    } ]
  }, {
    "tStartMs": 296430,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "there could be anywhere\nfrom 10 to 100 layers."
    } ]
  }, {
    "tStartMs": 299520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The bottom layer is the transistors."
    } ]
  }, {
    "tStartMs": 301530,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "This is the most complicated layer,"
    } ]
  }, {
    "tStartMs": 303090,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "requiring hundreds of steps"
    } ]
  }, {
    "tStartMs": 304830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that all need to be perfect."
    } ]
  }, {
    "tStartMs": 306750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The higher layers are a little easier."
    } ]
  }, {
    "tStartMs": 309150,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "These are the metal wires\nthat carry signals and power."
    } ]
  }, {
    "tStartMs": 312420,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "By the end, the completed wafer\ncan have hundreds of chips,"
    } ]
  }, {
    "tStartMs": 315480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which are then cut into separate pieces,"
    } ]
  }, {
    "tStartMs": 317280,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "packaged and put into products."
    } ]
  }, {
    "tStartMs": 320130,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But by far the hardest\nand most crucial step"
    } ]
  }, {
    "tStartMs": 322560,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "in the process is where you\nshine light through the mask"
    } ]
  }, {
    "tStartMs": 325410,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and onto the wafer."
    } ]
  }, {
    "tStartMs": 326610,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "This is photolithography,"
    } ]
  }, {
    "tStartMs": 328200,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and that's because this step determines"
    } ]
  }, {
    "tStartMs": 330540,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "how small you can make the features."
    } ]
  }, {
    "tStartMs": 333600,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- At first, it seems simple,"
    } ]
  }, {
    "tStartMs": 335220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "light passes through the openings"
    } ]
  }, {
    "tStartMs": 336870,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and it gets blocked by all the rest."
    } ]
  }, {
    "tStartMs": 339570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But as you try to print\nsmaller and smaller features,"
    } ]
  }, {
    "tStartMs": 342600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the gaps in the mask start to approach"
    } ]
  }, {
    "tStartMs": 344760,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "the wavelength of the light,"
    } ]
  }, {
    "tStartMs": 345990,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and that causes problems."
    } ]
  }, {
    "tStartMs": 348450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- And we can actually show it"
    } ]
  }, {
    "tStartMs": 349530,
    "dDurationMs": 2915,
    "segs": [ {
      "utf8": "because I happen to\nhave a, this is a mask."
    } ]
  }, {
    "tStartMs": 352445,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "This is a reticle."
    } ]
  }, {
    "tStartMs": 353278,
    "dDurationMs": 1832,
    "segs": [ {
      "utf8": "- [Casper] A reticle or a mask carries"
    } ]
  }, {
    "tStartMs": 355110,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the design of one chip layer."
    } ]
  }, {
    "tStartMs": 356730,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This reticle is filled with\nmicroscopic lines and gaps,"
    } ]
  }, {
    "tStartMs": 359580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "around 670 nanometers across."
    } ]
  }, {
    "tStartMs": 362130,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- And if I take like a laser pointer,"
    } ]
  }, {
    "tStartMs": 363840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "so this is a red laser.\n- Yep."
    } ]
  }, {
    "tStartMs": 365670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- If I shine it through\nit, then you see this here."
    } ]
  }, {
    "tStartMs": 370530,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Casper] The laser has a wavelength"
    } ]
  }, {
    "tStartMs": 371790,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "of around 650 nanometers."
    } ]
  }, {
    "tStartMs": 373560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "When light hits the reticle,"
    } ]
  }, {
    "tStartMs": 375240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "its wavefronts bend as\nthey pass through each gap."
    } ]
  }, {
    "tStartMs": 378150,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So, each gap sends out waves\nthat spread out and overlap."
    } ]
  }, {
    "tStartMs": 381810,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now, let's just look at the\nlight from these two gaps."
    } ]
  }, {
    "tStartMs": 384930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "When the peaks of one wave line up"
    } ]
  }, {
    "tStartMs": 386880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "with the troughs of the other,"
    } ]
  }, {
    "tStartMs": 388500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "we say that the two waves are out of phase"
    } ]
  }, {
    "tStartMs": 390780,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and they cancel each other out,"
    } ]
  }, {
    "tStartMs": 392190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "so you get dark spots,"
    } ]
  }, {
    "tStartMs": 393870,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and when the peaks line up with the peaks,"
    } ]
  }, {
    "tStartMs": 395730,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the two waves are in phase."
    } ]
  }, {
    "tStartMs": 397440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "They add up and you get bright spots."
    } ]
  }, {
    "tStartMs": 399780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- You can get interference.\n- Yeah."
    } ]
  }, {
    "tStartMs": 401160,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- Right, and you get\na diffraction pattern."
    } ]
  }, {
    "tStartMs": 403590,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Now, diffraction is inevitable."
    } ]
  }, {
    "tStartMs": 405840,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So instead of fighting it,"
    } ]
  }, {
    "tStartMs": 407250,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "designers actually use it to\nget the patterns they want."
    } ]
  }, {
    "tStartMs": 410730,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They kind of work backwards\nfrom the eventual pattern"
    } ]
  }, {
    "tStartMs": 413130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "they want on the wafer,"
    } ]
  }, {
    "tStartMs": 414510,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and they design the slits"
    } ]
  }, {
    "tStartMs": 416220,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "so that diffraction will occur"
    } ]
  }, {
    "tStartMs": 417690,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "in such a way that it creates\nthe pattern that they want."
    } ]
  }, {
    "tStartMs": 421230,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- You see three dots, the middle dot,"
    } ]
  }, {
    "tStartMs": 423540,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that's the original one."
    } ]
  }, {
    "tStartMs": 424560,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "That's the zero order."
    } ]
  }, {
    "tStartMs": 425820,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And then on the left and the right,"
    } ]
  }, {
    "tStartMs": 427410,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you can see the first and the minus first."
    } ]
  }, {
    "tStartMs": 430110,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Now, in order for us to have"
    } ]
  }, {
    "tStartMs": 432300,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "this image resolved on the wafer,"
    } ]
  }, {
    "tStartMs": 435390,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "you need to capture the zero and the first"
    } ]
  }, {
    "tStartMs": 437670,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and the minus first order."
    } ]
  }, {
    "tStartMs": 439440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] The smaller\nyou make the features,"
    } ]
  }, {
    "tStartMs": 440940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the larger this angle, alpha,"
    } ]
  }, {
    "tStartMs": 442530,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "between the zero and first orders becomes,"
    } ]
  }, {
    "tStartMs": 445080,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "so the larger your lens needs\nto be to capture the light."
    } ]
  }, {
    "tStartMs": 448980,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The size of the lens is described\nby the numerical aperture"
    } ]
  }, {
    "tStartMs": 452490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "or NA for short,"
    } ]
  }, {
    "tStartMs": 454170,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which is just the sin of this angle."
    } ]
  }, {
    "tStartMs": 456450,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So the larger that is,"
    } ]
  }, {
    "tStartMs": 457740,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the smaller the features you can print."
    } ]
  }, {
    "tStartMs": 460260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But there is a hard limit"
    } ]
  }, {
    "tStartMs": 461580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to how large your lens system can be"
    } ]
  }, {
    "tStartMs": 463680,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "when this angle is 90 degrees"
    } ]
  }, {
    "tStartMs": 465300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and your numerical aperture is one,"
    } ]
  }, {
    "tStartMs": 467370,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "where your lens would have to be infinite."
    } ]
  }, {
    "tStartMs": 469620,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Fortunately, there is one\nother thing we can change."
    } ]
  }, {
    "tStartMs": 473640,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- This is a red laser.\n- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 475740,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- And a red laser has a\nwavelength of 650 nanometers,"
    } ]
  }, {
    "tStartMs": 479460,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "ish, I would say.\n- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 480750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- And if I take a green laser"
    } ]
  }, {
    "tStartMs": 483510,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "and this one has a wavelength of 532,"
    } ]
  }, {
    "tStartMs": 487230,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "then you can see that the green dots are"
    } ]
  }, {
    "tStartMs": 490320,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "closer spaced than the red dots."
    } ]
  }, {
    "tStartMs": 493650,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- [Derek] That's because the light"
    } ]
  }, {
    "tStartMs": 494640,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "from the two different\ngaps doesn't have to travel"
    } ]
  }, {
    "tStartMs": 496770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "as far to match up in phase again."
    } ]
  }, {
    "tStartMs": 499170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So, the orders end up closer together."
    } ]
  }, {
    "tStartMs": 501540,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So with a smaller wavelength,"
    } ]
  }, {
    "tStartMs": 502770,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "you can print smaller\npatterns using the same lens."
    } ]
  }, {
    "tStartMs": 506340,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "All of this is captured\nby the Rayleigh Equation,"
    } ]
  }, {
    "tStartMs": 508770,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "which determines the smallest feature size"
    } ]
  }, {
    "tStartMs": 510900,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "or critical dimension."
    } ]
  }, {
    "tStartMs": 513390,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- But since there's a limit"
    } ]
  }, {
    "tStartMs": 514920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to how much you can increase\nthe numerical aperture,"
    } ]
  }, {
    "tStartMs": 517230,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "I mean to one,"
    } ]
  }, {
    "tStartMs": 518460,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "over time, the only way to keep making"
    } ]
  }, {
    "tStartMs": 520380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "smaller and smaller features is"
    } ]
  }, {
    "tStartMs": 522540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "by using shorter and shorter wavelengths."
    } ]
  }, {
    "tStartMs": 524580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So this is exactly what happened"
    } ]
  }, {
    "tStartMs": 526500,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "up until the late 1990s,"
    } ]
  }, {
    "tStartMs": 528270,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "when the industry settled on 193 nanometer"
    } ]
  }, {
    "tStartMs": 531420,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "deep UV light."
    } ]
  }, {
    "tStartMs": 533190,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "This was the light that was used to make"
    } ]
  }, {
    "tStartMs": 534780,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "all of the most advanced chips"
    } ]
  }, {
    "tStartMs": 536580,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "right until around 2015."
    } ]
  }, {
    "tStartMs": 538740,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But by that point, scientists\nhad reached a limit"
    } ]
  }, {
    "tStartMs": 541410,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to how small they could make the features."
    } ]
  }, {
    "tStartMs": 543330,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And Moore's Law was about\nto run into a brick wall."
    } ]
  }, {
    "tStartMs": 546810,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So a radical change was needed,"
    } ]
  }, {
    "tStartMs": 548970,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "a change that had been\nbrewing for around 30 years."
    } ]
  }, {
    "tStartMs": 554310,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "All the way back in the 1980s,"
    } ]
  }, {
    "tStartMs": 556050,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Japanese scientist, Hiroo Kinoshita,"
    } ]
  }, {
    "tStartMs": 558180,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "came up with a crazy idea."
    } ]
  }, {
    "tStartMs": 560670,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Why not use much shorter wavelengths,"
    } ]
  }, {
    "tStartMs": 562650,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "like x-rays of around 10 nanometers?"
    } ]
  }, {
    "tStartMs": 565080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "In theory, that should allow you to print"
    } ]
  }, {
    "tStartMs": 566880,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "much smaller features,"
    } ]
  }, {
    "tStartMs": 568530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but you quickly run into a problem."
    } ]
  }, {
    "tStartMs": 570780,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "X-rays at these wavelengths have"
    } ]
  }, {
    "tStartMs": 572250,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "enough energy to eject\nelectrons from their atoms,"
    } ]
  }, {
    "tStartMs": 575130,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "so most materials absorb them."
    } ]
  }, {
    "tStartMs": 577830,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But unlike medical X-rays which have"
    } ]
  }, {
    "tStartMs": 579930,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "wavelengths shorter than one nanometer,"
    } ]
  }, {
    "tStartMs": 582150,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "these are still long enough\nto interact with air."
    } ]
  }, {
    "tStartMs": 584790,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So, air absorbs them too."
    } ]
  }, {
    "tStartMs": 587070,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "That meant that Kinoshita's\nsetup had to be in a vacuum,"
    } ]
  }, {
    "tStartMs": 590400,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "but even worse,"
    } ]
  }, {
    "tStartMs": 591540,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "he couldn't use lenses to focus the light"
    } ]
  }, {
    "tStartMs": 593730,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "because the lenses would absorb it too."
    } ]
  }, {
    "tStartMs": 597240,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "So, it seemed like this\nidea would never work."
    } ]
  }, {
    "tStartMs": 601290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] But around 1983,"
    } ]
  }, {
    "tStartMs": 602640,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Kinoshita stumbled on a paper"
    } ]
  }, {
    "tStartMs": 604110,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "by Jim Underwood and Troy Barbee."
    } ]
  }, {
    "tStartMs": 606180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Their work focused on special mirrors"
    } ]
  }, {
    "tStartMs": 608160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that could reflect x-rays"
    } ]
  }, {
    "tStartMs": 609480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "with a wavelength of 4.48 nanometers."
    } ]
  }, {
    "tStartMs": 612360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, Kinoshita was intrigued."
    } ]
  }, {
    "tStartMs": 614610,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Curved mirrors can focus\nlight just like lenses do."
    } ]
  }, {
    "tStartMs": 617340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "If he could figure out how to make"
    } ]
  }, {
    "tStartMs": 618540,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "these special mirrors for\nthe wavelength he was using,"
    } ]
  }, {
    "tStartMs": 621030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "then this could be another\nway to do photolithography."
    } ]
  }, {
    "tStartMs": 624060,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "The mirrors work something like this."
    } ]
  }, {
    "tStartMs": 627690,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "When light crosses from\none medium to another,"
    } ]
  }, {
    "tStartMs": 630240,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "say, from air to glass,"
    } ]
  }, {
    "tStartMs": 631380,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "it bends or refracts."
    } ]
  }, {
    "tStartMs": 633210,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Some of it goes through\nand part reflects back."
    } ]
  }, {
    "tStartMs": 636030,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "How much gets reflected depends\non things like the angle,"
    } ]
  }, {
    "tStartMs": 638790,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "the light's polarization,"
    } ]
  }, {
    "tStartMs": 640290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and most importantly for us,"
    } ]
  }, {
    "tStartMs": 642120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the difference between\nthe refractive indices"
    } ]
  }, {
    "tStartMs": 644160,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "of the two media."
    } ]
  }, {
    "tStartMs": 645330,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The larger that difference,\nthe more light is reflected."
    } ]
  }, {
    "tStartMs": 648480,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And Underwood and Barbee\nused that principle."
    } ]
  }, {
    "tStartMs": 651300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "They made a super thin layer of tungsten,"
    } ]
  }, {
    "tStartMs": 653520,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "less than one nanometer thick,"
    } ]
  }, {
    "tStartMs": 655470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "thin enough that x-rays could pass through"
    } ]
  }, {
    "tStartMs": 657480,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "without immediately being absorbed."
    } ]
  }, {
    "tStartMs": 659520,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "When x-rays hit the layer\nat a specific angle,"
    } ]
  }, {
    "tStartMs": 662250,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "the tungsten reflected less than 1%."
    } ]
  }, {
    "tStartMs": 664950,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Then, they carefully\ntuned the layer thickness"
    } ]
  }, {
    "tStartMs": 667380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so the path length of the\ntransmitted x-rays was"
    } ]
  }, {
    "tStartMs": 669900,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "only one quarter of its wavelength."
    } ]
  }, {
    "tStartMs": 672570,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Then they added another layer,\nthis time out of carbon."
    } ]
  }, {
    "tStartMs": 675870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It has a higher refractive\nindex than tungsten"
    } ]
  }, {
    "tStartMs": 677970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "for wavelengths of 4.48 nanometers."
    } ]
  }, {
    "tStartMs": 680610,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The x-rays hit the boundary"
    } ]
  }, {
    "tStartMs": 682110,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and a little bit more reflects,"
    } ]
  }, {
    "tStartMs": 684540,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but this time the phase is inverted"
    } ]
  }, {
    "tStartMs": 686520,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or it's changed by half a wavelength."
    } ]
  }, {
    "tStartMs": 688860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "This happens when any light moves"
    } ]
  }, {
    "tStartMs": 690690,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "from a lower refractive\nindex to a higher one."
    } ]
  }, {
    "tStartMs": 693750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Now, by the time this new\nreflected wave reaches"
    } ]
  }, {
    "tStartMs": 696180,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "the tungsten boundary,"
    } ]
  }, {
    "tStartMs": 697200,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "it has traveled another\nquarter of its wavelength"
    } ]
  }, {
    "tStartMs": 699660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for a half wavelength in total."
    } ]
  }, {
    "tStartMs": 701580,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So the two phases line up"
    } ]
  }, {
    "tStartMs": 703230,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and the waves interfere constructively."
    } ]
  }, {
    "tStartMs": 705510,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Underwood and Barbee kept doing this trick"
    } ]
  }, {
    "tStartMs": 707400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "for a total of 76 alternating layers,"
    } ]
  }, {
    "tStartMs": 710130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "so that in total they could reflect back"
    } ]
  }, {
    "tStartMs": 712140,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "much more of the x-rays."
    } ]
  }, {
    "tStartMs": 715560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now, they only managed to reflect"
    } ]
  }, {
    "tStartMs": 717000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "around 6% of the light,"
    } ]
  }, {
    "tStartMs": 718500,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but it was a proof of principle"
    } ]
  }, {
    "tStartMs": 720210,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "that you could reflect x-rays."
    } ]
  }, {
    "tStartMs": 723150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- So Kinoshita saw the possibilities."
    } ]
  }, {
    "tStartMs": 725610,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "He got to work, and\nafter around two years,"
    } ]
  }, {
    "tStartMs": 728100,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "his team designed and built"
    } ]
  }, {
    "tStartMs": 729450,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "three tungsten-carbon\ncurved multi-layer mirrors"
    } ]
  }, {
    "tStartMs": 732570,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to reflect 11 nanometer light."
    } ]
  }, {
    "tStartMs": 734760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And with it, he managed to print"
    } ]
  }, {
    "tStartMs": 736590,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "lines four microns or\n4,000 nanometers thick,"
    } ]
  }, {
    "tStartMs": 740160,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "proving that at least in theory,"
    } ]
  }, {
    "tStartMs": 742200,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "x-ray lithography was possible."
    } ]
  }, {
    "tStartMs": 745410,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "A year later in 1986,"
    } ]
  }, {
    "tStartMs": 747300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "he went to present his findings"
    } ]
  }, {
    "tStartMs": 748770,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to the Japanese Society\nof Applied Physics."
    } ]
  }, {
    "tStartMs": 751470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Proud and excited, he explained his setup"
    } ]
  }, {
    "tStartMs": 753270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and showed his image."
    } ]
  }, {
    "tStartMs": 754950,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But to his horror, the\naudience refused to believe it."
    } ]
  }, {
    "tStartMs": 758310,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- [Kinoshita] Unfortunately,\nthe audience was"
    } ]
  }, {
    "tStartMs": 761790,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "highly skeptical of my talk."
    } ]
  }, {
    "tStartMs": 764820,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Casper] Kinoshita was devastated."
    } ]
  }, {
    "tStartMs": 766770,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "He later said, \"People\nseemed unwilling to believe"
    } ]
  }, {
    "tStartMs": 769650,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that we had actually made\nan image by bending x-rays,"
    } ]
  }, {
    "tStartMs": 772800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and they tended to regard the whole thing"
    } ]
  }, {
    "tStartMs": 774720,
    "dDurationMs": 1437,
    "segs": [ {
      "utf8": "as a big fish story.\""
    } ]
  }, {
    "tStartMs": 777270,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- Nobody believed that this\nwas a viable way forward,"
    } ]
  }, {
    "tStartMs": 780450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and unfortunately, the reaction was"
    } ]
  }, {
    "tStartMs": 782850,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "at least somewhat justified."
    } ]
  }, {
    "tStartMs": 785070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "First, this light isn't naturally produced"
    } ]
  }, {
    "tStartMs": 787260,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "by anything on Earth."
    } ]
  }, {
    "tStartMs": 788700,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "The closest natural source is the Sun."
    } ]
  }, {
    "tStartMs": 792450,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- We had to basically build an\nartificial sun here on Earth."
    } ]
  }, {
    "tStartMs": 797460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Derek] Most scientists,\nincluding Kinoshita,"
    } ]
  }, {
    "tStartMs": 799290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "produced x-ray light using"
    } ]
  }, {
    "tStartMs": 800640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "a particle accelerator or a synchrotron."
    } ]
  }, {
    "tStartMs": 803220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Jos] It gives an\nenormous amount of power."
    } ]
  }, {
    "tStartMs": 805230,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's as big as a soccer field."
    } ]
  }, {
    "tStartMs": 806910,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "You can fuel a whole fab."
    } ]
  }, {
    "tStartMs": 808410,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The problem is if the light goes out,"
    } ]
  }, {
    "tStartMs": 810090,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the whole fab goes out."
    } ]
  }, {
    "tStartMs": 811710,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- So each machine needed\nits own power source."
    } ]
  }, {
    "tStartMs": 815220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But even if you could produce the light,"
    } ]
  }, {
    "tStartMs": 817050,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "you'd need to make\nincredibly smooth mirrors"
    } ]
  }, {
    "tStartMs": 819480,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to actually focus and\nprint those tiny features."
    } ]
  }, {
    "tStartMs": 822720,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "You would need the smoothest\nobjects in the universe."
    } ]
  }, {
    "tStartMs": 826710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Okay, so I got a football"
    } ]
  }, {
    "tStartMs": 828270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and I've got a bouncy ball\nand a cobblestone street."
    } ]
  }, {
    "tStartMs": 830850,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "Now what do you think is\ngonna happen when I drop them?"
    } ]
  }, {
    "tStartMs": 834630,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The football basically\nbounces straight up,"
    } ]
  }, {
    "tStartMs": 836550,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "but for the bouncy ball,"
    } ]
  }, {
    "tStartMs": 838320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it just shoots off to the side."
    } ]
  }, {
    "tStartMs": 839760,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And it's because the\nsurface is relatively flat"
    } ]
  }, {
    "tStartMs": 842220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "for the football, which is much larger,"
    } ]
  }, {
    "tStartMs": 844050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "but it's super rough for the bouncy ball."
    } ]
  }, {
    "tStartMs": 846660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And a similar thing happens with mirrors."
    } ]
  }, {
    "tStartMs": 848850,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "If the surface is super rough"
    } ]
  }, {
    "tStartMs": 850650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "compared to the size of the wavelength,"
    } ]
  }, {
    "tStartMs": 852300,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "then the light scatters randomly."
    } ]
  }, {
    "tStartMs": 854670,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Now it might look smooth,"
    } ]
  }, {
    "tStartMs": 856050,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "but if you zoom into a mirror,"
    } ]
  }, {
    "tStartMs": 857310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "you find something that looks like this,"
    } ]
  }, {
    "tStartMs": 859440,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "you find all these crazy bumps."
    } ]
  }, {
    "tStartMs": 862200,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And now to measure the roughness,"
    } ]
  }, {
    "tStartMs": 863520,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "what you do is you take\nthe average of these bumps"
    } ]
  }, {
    "tStartMs": 866490,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and that will give you your mean line."
    } ]
  }, {
    "tStartMs": 868200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Now, for a normal household mirror,"
    } ]
  }, {
    "tStartMs": 870240,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "the average height is\nabout 4,000 silicon atoms."
    } ]
  }, {
    "tStartMs": 874320,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But for Kinoshita's mirrors,"
    } ]
  }, {
    "tStartMs": 876150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which not only needed\nto reflect x-ray light,"
    } ]
  }, {
    "tStartMs": 878250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which has 100 times shorter wavelength,"
    } ]
  }, {
    "tStartMs": 880410,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but also needed to minimize scattering,"
    } ]
  }, {
    "tStartMs": 882360,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you know, so that all the\nphotons make it onto the wafer,"
    } ]
  }, {
    "tStartMs": 885060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "it needed to be way more smooth."
    } ]
  }, {
    "tStartMs": 887190,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It needed to be atomically smooth."
    } ]
  }, {
    "tStartMs": 889170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "In fact, the average bump could only be"
    } ]
  }, {
    "tStartMs": 891120,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "about 2.3 silicon atoms thick."
    } ]
  }, {
    "tStartMs": 894270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- If one mirror would\nbe the size of Germany,"
    } ]
  }, {
    "tStartMs": 896790,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the biggest bump would be\nabout a millimeter high."
    } ]
  }, {
    "tStartMs": 899280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Casper] But Kinoshita\nrefused to give up."
    } ]
  }, {
    "tStartMs": 901680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Kinoshita] However,\nmy belief did not change."
    } ]
  }, {
    "tStartMs": 904020,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "- [Casper] And soon help would\ncome from an unlikely place."
    } ]
  }, {
    "tStartMs": 908220,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Across the Pacific,"
    } ]
  }, {
    "tStartMs": 909150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "around 70 kilometers\neast of San Francisco is"
    } ]
  }, {
    "tStartMs": 911610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Lawrence Livermore National Lab,"
    } ]
  }, {
    "tStartMs": 913470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "a lab that was born out of the Cold War,"
    } ]
  }, {
    "tStartMs": 915540,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "heavily funded by the US government,"
    } ]
  }, {
    "tStartMs": 917370,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and built for one purpose\nand one purpose only,"
    } ]
  }, {
    "tStartMs": 920400,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "nuclear weapons."
    } ]
  }, {
    "tStartMs": 922170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The lab was founded by the\ninventor of the Cyclotron,"
    } ]
  }, {
    "tStartMs": 924930,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Ernest Lawrence,"
    } ]
  }, {
    "tStartMs": 926010,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and the father of the\nhydrogen bomb, Edward Teller."
    } ]
  }, {
    "tStartMs": 928680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And over its lifetime, they designed"
    } ]
  }, {
    "tStartMs": 930450,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "over 10 fusion-type nuclear warheads."
    } ]
  }, {
    "tStartMs": 933210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So part of their research focused"
    } ]
  }, {
    "tStartMs": 934740,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "on what happens inside\nnuclear fusion reactions."
    } ]
  }, {
    "tStartMs": 938460,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Fusion reactions release\na lot of x-ray light,"
    } ]
  }, {
    "tStartMs": 941070,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "light that they had never been\nable to capture and analyze."
    } ]
  }, {
    "tStartMs": 944550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But now, using those\nspecial multilayer mirrors,"
    } ]
  }, {
    "tStartMs": 947670,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "there was a chance."
    } ]
  }, {
    "tStartMs": 949470,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Casper] One of the scientists tasked"
    } ]
  }, {
    "tStartMs": 950970,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "with making this work was Andrew Hawryluk."
    } ]
  }, {
    "tStartMs": 953400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And within a few years,"
    } ]
  }, {
    "tStartMs": 954840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "he and his team used\nmultilayer mirrors to reflect"
    } ]
  }, {
    "tStartMs": 957450,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "some x-ray light."
    } ]
  }, {
    "tStartMs": 959310,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But then in 1987,"
    } ]
  }, {
    "tStartMs": 961020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Andy got a visit from a\nprofessor from Cornell."
    } ]
  }, {
    "tStartMs": 964020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- He was very impressed\nwith the technologies"
    } ]
  }, {
    "tStartMs": 965940,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that we developed."
    } ]
  }, {
    "tStartMs": 966773,
    "dDurationMs": 1904,
    "segs": [ {
      "utf8": "And he looked at me at the\nend of the day and said,"
    } ]
  }, {
    "tStartMs": 968677,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "\"This is all very interesting\nand very neat and stuff,\""
    } ]
  }, {
    "tStartMs": 971010,
    "dDurationMs": 3697,
    "segs": [ {
      "utf8": "but his words, and I'll remember\nit to the day I died, was,"
    } ]
  }, {
    "tStartMs": 974707,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "\"Can you do anything\nuseful with this stuff?\""
    } ]
  }, {
    "tStartMs": 978279,
    "dDurationMs": 4011,
    "segs": [ {
      "utf8": "And this was the day before\na Christmas shutdown in 1987."
    } ]
  }, {
    "tStartMs": 982290,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And I was so inflamed by that comment"
    } ]
  }, {
    "tStartMs": 985680,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that I went home and for the next 10 days,"
    } ]
  }, {
    "tStartMs": 988290,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I wrote up a multi-page white paper."
    } ]
  }, {
    "tStartMs": 991140,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Casper] He applied these\nmirrors to lithography,"
    } ]
  }, {
    "tStartMs": 993060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to print chips using x-rays."
    } ]
  }, {
    "tStartMs": 995100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Around five months later,\nAndy presented his findings"
    } ]
  }, {
    "tStartMs": 998040,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "at a conference."
    } ]
  }, {
    "tStartMs": 999600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But like Kinoshita, it\nwas not the response"
    } ]
  }, {
    "tStartMs": 1002060,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "he was hoping for."
    } ]
  }, {
    "tStartMs": 1004130,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- It was extremely negative."
    } ]
  }, {
    "tStartMs": 1007040,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "That was the low point in my career."
    } ]
  }, {
    "tStartMs": 1009920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I was literally laughed off the stage."
    } ]
  }, {
    "tStartMs": 1012320,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "And I kid you not, every\nperson who I looked up to"
    } ]
  }, {
    "tStartMs": 1016700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in the field,"
    } ]
  }, {
    "tStartMs": 1017533,
    "dDurationMs": 1087,
    "segs": [ {
      "utf8": "they were listening to my talk"
    } ]
  }, {
    "tStartMs": 1018620,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and they came up to the microphone"
    } ]
  }, {
    "tStartMs": 1020750,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and told me basically\nwhy it wouldn't work,"
    } ]
  }, {
    "tStartMs": 1024320,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "how stupid an idea it was."
    } ]
  }, {
    "tStartMs": 1026900,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Later that week, I flew back\nand the following Monday,"
    } ]
  }, {
    "tStartMs": 1029780,
    "dDurationMs": 1977,
    "segs": [ {
      "utf8": "my boss asked me, \"How did it go?\""
    } ]
  }, {
    "tStartMs": 1032660,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "And I looked at him and I said,"
    } ]
  }, {
    "tStartMs": 1033957,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "\"I will never speak of it again.\""
    } ]
  }, {
    "tStartMs": 1036756,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "(uptempo music)"
    } ]
  }, {
    "tStartMs": 1038810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Casper] But then three days later,"
    } ]
  }, {
    "tStartMs": 1040400,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "he gets a phone call from\nsomeone named Bill Brinkman"
    } ]
  }, {
    "tStartMs": 1043700,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "from Bell Labs."
    } ]
  }, {
    "tStartMs": 1045564,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "- [Andy] And so I walked\nover to my boss and I said,"
    } ]
  }, {
    "tStartMs": 1047277,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "\"Just got this phone call from\na guy named Bill Brinkman."
    } ]
  }, {
    "tStartMs": 1049370,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Do you know who he is?\""
    } ]
  }, {
    "tStartMs": 1050540,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "And my boss's eyes popped open and said,"
    } ]
  }, {
    "tStartMs": 1052647,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "\"Yeah, he's the Executive\nVice President of AT\u0026T.\""
    } ]
  }, {
    "tStartMs": 1055910,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And I said, \"Well, he just called me"
    } ]
  }, {
    "tStartMs": 1057620,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and asked me to fly out to\nNew Jersey and give a talk.\""
    } ]
  }, {
    "tStartMs": 1061220,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The response from my boss said it all."
    } ]
  }, {
    "tStartMs": 1065150,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "He basically said, \"Well, you gotta go.\""
    } ]
  }, {
    "tStartMs": 1068360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Casper] At Bell Labs,\nAndy found fellow believers"
    } ]
  }, {
    "tStartMs": 1070760,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and it couldn't have\ncome at a better time."
    } ]
  }, {
    "tStartMs": 1073220,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Over the past 30 years,"
    } ]
  }, {
    "tStartMs": 1074510,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the US government had invested"
    } ]
  }, {
    "tStartMs": 1075980,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "billions of dollars into\nnational labs to maintain"
    } ]
  }, {
    "tStartMs": 1078800,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "the country's technological\nedge during the Cold War."
    } ]
  }, {
    "tStartMs": 1082340,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "But by the late 1980s,"
    } ]
  }, {
    "tStartMs": 1083930,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the Cold War was slowing down"
    } ]
  }, {
    "tStartMs": 1085970,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and all these labs were\nsitting on research"
    } ]
  }, {
    "tStartMs": 1088070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that had commercial potential."
    } ]
  }, {
    "tStartMs": 1089930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So the government encouraged\nthe labs to partner"
    } ]
  }, {
    "tStartMs": 1092360,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "with US companies"
    } ]
  }, {
    "tStartMs": 1093980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to turn that research into products"
    } ]
  }, {
    "tStartMs": 1095840,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and to stimulate the economy."
    } ]
  }, {
    "tStartMs": 1097640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And the government would\nthen supply seed money."
    } ]
  }, {
    "tStartMs": 1100220,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And so Bell Labs partnered\nwith Andy's labs and two others"
    } ]
  }, {
    "tStartMs": 1103580,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "to keep developing x-ray lithography."
    } ]
  }, {
    "tStartMs": 1107180,
    "dDurationMs": 1197,
    "segs": [ {
      "utf8": "And by 1993,"
    } ]
  }, {
    "tStartMs": 1108377,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "the first international conference\nfor x-ray lithography was"
    } ]
  }, {
    "tStartMs": 1112040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "held in Japan, near Mount Fuji."
    } ]
  }, {
    "tStartMs": 1114740,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "In the opening address, Kinoshita said"
    } ]
  }, {
    "tStartMs": 1116810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that, \"As long as we\ndo not lose the desire"
    } ]
  }, {
    "tStartMs": 1119600,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that has sprung from within us,"
    } ]
  }, {
    "tStartMs": 1121130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "technology will steadily advance"
    } ]
  }, {
    "tStartMs": 1122900,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "from the micro to the nano to the pico.\""
    } ]
  }, {
    "tStartMs": 1126560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "They even gave the technology a new name,"
    } ]
  }, {
    "tStartMs": 1128720,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "extreme ultraviolet lithography,"
    } ]
  }, {
    "tStartMs": 1131030,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "or just EUV."
    } ]
  }, {
    "tStartMs": 1133850,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- But then in 1996,"
    } ]
  }, {
    "tStartMs": 1135380,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the US government cut\nfunding for the project."
    } ]
  }, {
    "tStartMs": 1138350,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "This spelled disaster for the\nbig chip companies like Intel."
    } ]
  }, {
    "tStartMs": 1142070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The industry estimated"
    } ]
  }, {
    "tStartMs": 1143360,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that the 193 nanometer\nlithography tools would fall"
    } ]
  }, {
    "tStartMs": 1146300,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "behind Moore's Law by 2005,"
    } ]
  }, {
    "tStartMs": 1149330,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "but there were no other alternatives."
    } ]
  }, {
    "tStartMs": 1153470,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So Intel, Motorola, AMD and\nother companies got together"
    } ]
  }, {
    "tStartMs": 1156860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and invested $250\nmillion to keep it going,"
    } ]
  }, {
    "tStartMs": 1159980,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "making it the largest investment ever"
    } ]
  }, {
    "tStartMs": 1161930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "by private industry"
    } ]
  }, {
    "tStartMs": 1163250,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in a Department of\nEnergy research project."
    } ]
  }, {
    "tStartMs": 1166130,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "By the year 2000, the\nlabs had produced this,"
    } ]
  }, {
    "tStartMs": 1168620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the Engineering Test Stand."
    } ]
  }, {
    "tStartMs": 1170450,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It was the first fully\nfunctioning EUV prototype."
    } ]
  }, {
    "tStartMs": 1173660,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It produced 9.8 watts of\n13.4 nanometer EUV light,"
    } ]
  }, {
    "tStartMs": 1178100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which was then reflected by eight mirrors"
    } ]
  }, {
    "tStartMs": 1180140,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from the source to the mask to the wafer."
    } ]
  }, {
    "tStartMs": 1182540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It could print 70 nanometer features"
    } ]
  }, {
    "tStartMs": 1184700,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "and it proved that EUV could work."
    } ]
  }, {
    "tStartMs": 1188490,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It was a milestone to get"
    } ]
  }, {
    "tStartMs": 1189323,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "the Engineering Test Stand to work."
    } ]
  }, {
    "tStartMs": 1190700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It demonstrated to people like Intel"
    } ]
  }, {
    "tStartMs": 1192890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that, you know, good\nengineering will get us there."
    } ]
  }, {
    "tStartMs": 1196010,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- And then it seems like\nyou've got the prototype,"
    } ]
  }, {
    "tStartMs": 1198950,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "shouldn't be too hard to\nthen commercialize it."
    } ]
  }, {
    "tStartMs": 1203000,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "- That's what they thought."
    } ]
  }, {
    "tStartMs": 1204281,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "(Andy and Casper laugh)"
    } ]
  }, {
    "tStartMs": 1205550,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- But the prototype had a major flaw."
    } ]
  }, {
    "tStartMs": 1207560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It could only print\nabout 10 wafers per hour."
    } ]
  }, {
    "tStartMs": 1210200,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And to make EUV economically viable,"
    } ]
  }, {
    "tStartMs": 1212540,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it would have to print\nhundreds of wafers per hour,"
    } ]
  }, {
    "tStartMs": 1215090,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "24/7, 365 days a year."
    } ]
  }, {
    "tStartMs": 1218570,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The main reason output was so slow was"
    } ]
  }, {
    "tStartMs": 1220880,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "because the light reflected\noff of eight mirrors"
    } ]
  }, {
    "tStartMs": 1223130,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "and the reticle,"
    } ]
  }, {
    "tStartMs": 1224030,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "which is also a mirror, just\nwith the design imprinted."
    } ]
  }, {
    "tStartMs": 1227480,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Traditional masks that\nallow light to pass through"
    } ]
  }, {
    "tStartMs": 1229820,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "don't work because, well,\nthey absorb all the light."
    } ]
  }, {
    "tStartMs": 1233540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Each mirror had a\nreflectivity of around 70%,"
    } ]
  }, {
    "tStartMs": 1236300,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which is close to the max,"
    } ]
  }, {
    "tStartMs": 1237830,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but after nine bounces,"
    } ]
  }, {
    "tStartMs": 1239330,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "you are only left with 4% of the light,"
    } ]
  }, {
    "tStartMs": 1242240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "which means that out of every 100 photons,"
    } ]
  }, {
    "tStartMs": 1245150,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "only four make it to the wafer."
    } ]
  }, {
    "tStartMs": 1248180,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So you might think just\nuse way fewer mirrors,"
    } ]
  }, {
    "tStartMs": 1251510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but that only works up to a point."
    } ]
  }, {
    "tStartMs": 1253670,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "When you focus light\nwith any optical system,"
    } ]
  }, {
    "tStartMs": 1256010,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "you always get some distortion."
    } ]
  }, {
    "tStartMs": 1258140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "For example, rays that pass\nthrough the outer edges"
    } ]
  }, {
    "tStartMs": 1260570,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "of most lenses focus\nlight slightly different"
    } ]
  }, {
    "tStartMs": 1262790,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "from those near the center."
    } ]
  }, {
    "tStartMs": 1264020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is called spherical aberration."
    } ]
  }, {
    "tStartMs": 1266060,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And normal cameras correct for this"
    } ]
  }, {
    "tStartMs": 1267920,
    "dDurationMs": 2907,
    "segs": [ {
      "utf8": "and other aberrations by\nusing multiple lenses."
    } ]
  }, {
    "tStartMs": 1270827,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "And a mirror system is no different."
    } ]
  }, {
    "tStartMs": 1272960,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- You need to have a\ncertain amount of mirrors"
    } ]
  }, {
    "tStartMs": 1276050,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "before you can say I have my\naberrations under control."
    } ]
  }, {
    "tStartMs": 1280490,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "In reality, the systems\nof today have six mirrors."
    } ]
  }, {
    "tStartMs": 1284510,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- That helps a little."
    } ]
  }, {
    "tStartMs": 1285830,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But after reflecting off\nsix mirrors and the reticle,"
    } ]
  }, {
    "tStartMs": 1289040,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "you are still only left with\naround 8% of your light."
    } ]
  }, {
    "tStartMs": 1292220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So they needed to drastically increase"
    } ]
  }, {
    "tStartMs": 1294230,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the source power to at least 100 watts."
    } ]
  }, {
    "tStartMs": 1296810,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Now to most companies,"
    } ]
  }, {
    "tStartMs": 1298340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that tenfold increase seemed impossible."
    } ]
  }, {
    "tStartMs": 1301010,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Even people who worked on the\nEngineering Test Stand noted"
    } ]
  }, {
    "tStartMs": 1303620,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "that while EUV technology\nitself is a done deal,"
    } ]
  }, {
    "tStartMs": 1307190,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "there were six zillion\nengineering challenges"
    } ]
  }, {
    "tStartMs": 1310220,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to make it a fab-line reality."
    } ]
  }, {
    "tStartMs": 1312710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And so one by one,"
    } ]
  }, {
    "tStartMs": 1314330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "American companies walked away"
    } ]
  }, {
    "tStartMs": 1316160,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "from developing a full\nEUV lithography machine."
    } ]
  }, {
    "tStartMs": 1319220,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "That left just one company, ASML."
    } ]
  }, {
    "tStartMs": 1323605,
    "dDurationMs": 1165,
    "segs": [ {
      "utf8": "ASML, which used to stand for"
    } ]
  }, {
    "tStartMs": 1324770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Advanced Semiconductor\nMaterials Lithography,"
    } ]
  }, {
    "tStartMs": 1327110,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "is located in a small, nondescript\ntown in the Netherlands."
    } ]
  }, {
    "tStartMs": 1330320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It spun off from Philips back in the '80s"
    } ]
  }, {
    "tStartMs": 1332480,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "with little more than a shed"
    } ]
  }, {
    "tStartMs": 1333800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and a barely working\nwafer stepper to its name."
    } ]
  }, {
    "tStartMs": 1336680,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "But Philips also gave them people,"
    } ]
  }, {
    "tStartMs": 1338973,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "Jos Benschop, ASML's first researcher,"
    } ]
  }, {
    "tStartMs": 1341120,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and Martin van den Brink,"
    } ]
  }, {
    "tStartMs": 1342590,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "who would eventually become ASML's CTO,"
    } ]
  }, {
    "tStartMs": 1345200,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and EUV's greatest champion."
    } ]
  }, {
    "tStartMs": 1347720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- And he is really like the\nSteve Jobs of lithography."
    } ]
  }, {
    "tStartMs": 1350300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And he saw EUV coming."
    } ]
  }, {
    "tStartMs": 1352040,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- ASML had joined the US\nEUV consortium earlier"
    } ]
  }, {
    "tStartMs": 1355070,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and now it became their task to find a way"
    } ]
  }, {
    "tStartMs": 1357950,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to commercialize EUV."
    } ]
  }, {
    "tStartMs": 1359480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "They would work together with\ntheir German partner, Zeiss,"
    } ]
  }, {
    "tStartMs": 1362060,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "where Zeiss would take\ncare of the mirrors,"
    } ]
  }, {
    "tStartMs": 1363830,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and ASML would focus on the light source."
    } ]
  }, {
    "tStartMs": 1367250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "One of the first decisions when making"
    } ]
  }, {
    "tStartMs": 1368900,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "any lithography system is\ndeciding which wavelength to use."
    } ]
  }, {
    "tStartMs": 1372890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- In the early days, anything between"
    } ]
  }, {
    "tStartMs": 1374420,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "five and 14 nanometers was explored."
    } ]
  }, {
    "tStartMs": 1377690,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The thing is you need to find a source"
    } ]
  }, {
    "tStartMs": 1380750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and you need to find optics that reflect"
    } ]
  }, {
    "tStartMs": 1382610,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "the wavelengths.\n- Right."
    } ]
  }, {
    "tStartMs": 1383630,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- So you have to look for the combination."
    } ]
  }, {
    "tStartMs": 1385370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Underwood and Barbee had already made"
    } ]
  }, {
    "tStartMs": 1387080,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "mirrors that could reflect\nlight of around four nanometers."
    } ]
  }, {
    "tStartMs": 1389930,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And since that wavelength is so small,"
    } ]
  }, {
    "tStartMs": 1391940,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "it seems like the obvious choice,"
    } ]
  }, {
    "tStartMs": 1394310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but the maximum reflectivity\nfor those mirrors was"
    } ]
  }, {
    "tStartMs": 1396710,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "only around 20%."
    } ]
  }, {
    "tStartMs": 1398120,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So after hitting six\nmirrors and the reticle,"
    } ]
  }, {
    "tStartMs": 1401330,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "you are just left with\n0.00128% of the light,"
    } ]
  }, {
    "tStartMs": 1406700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which is way too low."
    } ]
  }, {
    "tStartMs": 1408800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Fortunately, further\nresearchers also looked"
    } ]
  }, {
    "tStartMs": 1410900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "at two other pairs,"
    } ]
  }, {
    "tStartMs": 1412670,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "silicon and molybdenum,"
    } ]
  }, {
    "tStartMs": 1414140,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "which had a theoretical\nmaximum reflectivity of 70%"
    } ]
  }, {
    "tStartMs": 1417800,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "for wavelengths around 13 nanometers,"
    } ]
  }, {
    "tStartMs": 1420080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and molybdenum and beryllium"
    } ]
  }, {
    "tStartMs": 1422480,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "with a theoretical maximum\nreflectivity of 80%"
    } ]
  }, {
    "tStartMs": 1426110,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for wavelengths around 11 nanometers."
    } ]
  }, {
    "tStartMs": 1428300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So the choice seemed obvious, right?"
    } ]
  }, {
    "tStartMs": 1430610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I mean, pick the shorter wavelength"
    } ]
  }, {
    "tStartMs": 1432260,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the higher reflectivity."
    } ]
  }, {
    "tStartMs": 1433760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But it turns out that\nberyllium is extremely toxic"
    } ]
  }, {
    "tStartMs": 1437360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and it's also difficult to handle."
    } ]
  }, {
    "tStartMs": 1439310,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "So scientists focused on\nsilicon and molybdenum instead."
    } ]
  }, {
    "tStartMs": 1443720,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "To make the mirrors, Zeiss used\na process called sputtering."
    } ]
  }, {
    "tStartMs": 1447110,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "A target of coating material is"
    } ]
  }, {
    "tStartMs": 1449000,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "bombarded with either plasma or ions,"
    } ]
  }, {
    "tStartMs": 1451790,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "causing atoms to be ejected, fly off"
    } ]
  }, {
    "tStartMs": 1454190,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and stick to the mirror."
    } ]
  }, {
    "tStartMs": 1455960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This is a messy process,"
    } ]
  }, {
    "tStartMs": 1457460,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so the layers end up\nhaving bumps and gaps."
    } ]
  }, {
    "tStartMs": 1460760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- There was a nice trick that actually"
    } ]
  }, {
    "tStartMs": 1462950,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the team in the Netherlands\nperfected with ion beam."
    } ]
  }, {
    "tStartMs": 1466520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You just shake it a little bit"
    } ]
  }, {
    "tStartMs": 1468320,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "until the atoms falls in the\nhole where it needs to be"
    } ]
  }, {
    "tStartMs": 1471115,
    "dDurationMs": 1345,
    "segs": [ {
      "utf8": "and then it's all flat."
    } ]
  }, {
    "tStartMs": 1472460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Casper] With the\nmirror design locked in,"
    } ]
  }, {
    "tStartMs": 1474260,
    "dDurationMs": 3679,
    "segs": [ {
      "utf8": "ASML needed a source for\nthat specific wavelength."
    } ]
  }, {
    "tStartMs": 1477939,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "- So it was 13.x.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1480261,
    "dDurationMs": 2813,
    "segs": [ {
      "utf8": "- Okay, now the next good\nquestion is what's the x?"
    } ]
  }, {
    "tStartMs": 1483074,
    "dDurationMs": 2316,
    "segs": [ {
      "utf8": "Now you look for the source."
    } ]
  }, {
    "tStartMs": 1485390,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So there are basically\nthree ways to generate EUV,"
    } ]
  }, {
    "tStartMs": 1488750,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "to build a sun on Earth."
    } ]
  }, {
    "tStartMs": 1492091,
    "dDurationMs": 1939,
    "segs": [ {
      "utf8": "- [Casper] The first method\nwhich early researchers used"
    } ]
  }, {
    "tStartMs": 1494030,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "was the Synchrotron,"
    } ]
  }, {
    "tStartMs": 1495200,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but it was quickly ruled out"
    } ]
  }, {
    "tStartMs": 1496610,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "because each machine\nneeded its own source."
    } ]
  }, {
    "tStartMs": 1499760,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The other two methods are\nbased on the same principle."
    } ]
  }, {
    "tStartMs": 1502310,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "When an electron recombines with an ion,"
    } ]
  }, {
    "tStartMs": 1504800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the ion drops to a lower energy level"
    } ]
  }, {
    "tStartMs": 1507290,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and it releases that\nexcess energy as a photon."
    } ]
  }, {
    "tStartMs": 1510080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And if you choose the ion just right,"
    } ]
  }, {
    "tStartMs": 1512810,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "then that photon will have\nexactly the wavelength you need."
    } ]
  }, {
    "tStartMs": 1516380,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Now, there are two ways\nyou can create those ions."
    } ]
  }, {
    "tStartMs": 1519200,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The first is you take a metal,"
    } ]
  }, {
    "tStartMs": 1520730,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "heat it up until you get a metal vapor,"
    } ]
  }, {
    "tStartMs": 1522470,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and then you apply a strong\nelectric field across it."
    } ]
  }, {
    "tStartMs": 1526010,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "This causes free electrons\nto knock into nearby atoms"
    } ]
  }, {
    "tStartMs": 1528830,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "and ionize them."
    } ]
  }, {
    "tStartMs": 1530960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "If you then turn off the electric field,"
    } ]
  }, {
    "tStartMs": 1532880,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "the electrons recombine with\nthe ions and produce light."
    } ]
  }, {
    "tStartMs": 1536540,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "This is discharge-produced plasma."
    } ]
  }, {
    "tStartMs": 1539360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Jos] That's the concept we use first."
    } ]
  }, {
    "tStartMs": 1540950,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Casper] Yeah.\n- Because of its"
    } ]
  }, {
    "tStartMs": 1541910,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "relative simplicity."
    } ]
  }, {
    "tStartMs": 1543530,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And we quickly got it to a few watts."
    } ]
  }, {
    "tStartMs": 1546260,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "We wanted to get 100 watts\nand we struggled forever."
    } ]
  }, {
    "tStartMs": 1549800,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "- So you couldn't scale it."
    } ]
  }, {
    "tStartMs": 1551523,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- We could not scale it."
    } ]
  }, {
    "tStartMs": 1552356,
    "dDurationMs": 1944,
    "segs": [ {
      "utf8": "- They needed a drastic change."
    } ]
  }, {
    "tStartMs": 1554300,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So they switched to the second method."
    } ]
  }, {
    "tStartMs": 1556490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This method uses a high powered laser"
    } ]
  }, {
    "tStartMs": 1558530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to hit a target material,"
    } ]
  }, {
    "tStartMs": 1560150,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "creating a plasma"
    } ]
  }, {
    "tStartMs": 1561170,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "that's more than 220,000\ndegrees Celsius hot."
    } ]
  }, {
    "tStartMs": 1564980,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The electrons have so much energy"
    } ]
  }, {
    "tStartMs": 1566750,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that the nucleus can't\nhold onto them anymore,"
    } ]
  }, {
    "tStartMs": 1569210,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and up to 14 electrons\nescape their orbits."
    } ]
  }, {
    "tStartMs": 1572750,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "After the laser shuts off,"
    } ]
  }, {
    "tStartMs": 1574010,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the electrons and ions\nrecombine to produce light."
    } ]
  }, {
    "tStartMs": 1577610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "This is laser-produced plasma"
    } ]
  }, {
    "tStartMs": 1579440,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "and it was the only method\nthat seemed scalable."
    } ]
  }, {
    "tStartMs": 1583670,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "In fact, this was the same method"
    } ]
  }, {
    "tStartMs": 1585320,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that the Engineering Test Stand used,"
    } ]
  }, {
    "tStartMs": 1586970,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "a 1,700 watt laser fired\ninto a stream of xenon gas"
    } ]
  }, {
    "tStartMs": 1590900,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to produce 13.4 nanometer light."
    } ]
  }, {
    "tStartMs": 1594440,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But xenon had a big problem."
    } ]
  }, {
    "tStartMs": 1596570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The conversion efficiency that is"
    } ]
  }, {
    "tStartMs": 1598400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the ratio of usable light"
    } ]
  }, {
    "tStartMs": 1600110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to the amount of power\nyou put in was terrible."
    } ]
  }, {
    "tStartMs": 1602690,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "It was only around 0.5%."
    } ]
  }, {
    "tStartMs": 1605614,
    "dDurationMs": 1636,
    "segs": [ {
      "utf8": "That's because while xenon does emit light"
    } ]
  }, {
    "tStartMs": 1607250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "in the 13 to 14 nanometer range,"
    } ]
  }, {
    "tStartMs": 1609560,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "there's much more light\nreleased around 11 nanometers."
    } ]
  }, {
    "tStartMs": 1612590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So most of the energy\nwent into making light"
    } ]
  }, {
    "tStartMs": 1614990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that the mirrors couldn't reflect."
    } ]
  }, {
    "tStartMs": 1617060,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Plus, the laser didn't\nionize all the atoms."
    } ]
  }, {
    "tStartMs": 1619550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, leftover neutral xenon atoms would"
    } ]
  }, {
    "tStartMs": 1621890,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "strongly reabsorb some of\nthat 13.4 nanometer light."
    } ]
  }, {
    "tStartMs": 1626630,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "So ASML started looking\nat another material, tin."
    } ]
  }, {
    "tStartMs": 1630560,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Now, tin has a much higher emission peak,"
    } ]
  }, {
    "tStartMs": 1632660,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "around 13.5 nanometers,"
    } ]
  }, {
    "tStartMs": 1634430,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "which results in a five to 10 times higher"
    } ]
  }, {
    "tStartMs": 1637100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "conversion efficiency than xenon."
    } ]
  }, {
    "tStartMs": 1639080,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But just like xenon, neutral\ntin atoms also absorb"
    } ]
  }, {
    "tStartMs": 1641870,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "EUV light."
    } ]
  }, {
    "tStartMs": 1642890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So they came up with a crazy idea,"
    } ]
  }, {
    "tStartMs": 1645470,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to shoot one tiny tin droplet at a time."
    } ]
  }, {
    "tStartMs": 1649010,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But to get the required power,"
    } ]
  }, {
    "tStartMs": 1650330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "you would have to make and hit"
    } ]
  }, {
    "tStartMs": 1651800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "thousands of droplets every second,"
    } ]
  }, {
    "tStartMs": 1654560,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "all of which have to be the\nexact same shape and size."
    } ]
  }, {
    "tStartMs": 1659000,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But it turns out that\nyou can't instantly make"
    } ]
  }, {
    "tStartMs": 1661490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "thousands of tin droplets\nthat are the exact same."
    } ]
  }, {
    "tStartMs": 1664370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, they found a workaround."
    } ]
  }, {
    "tStartMs": 1666710,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "To make the droplets,\nextremely pure tin is melted"
    } ]
  }, {
    "tStartMs": 1669890,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and pushed through a microscopic nozzle"
    } ]
  }, {
    "tStartMs": 1671930,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "by high pressure nitrogen."
    } ]
  }, {
    "tStartMs": 1673550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This nozzle vibrates at a high frequency,"
    } ]
  }, {
    "tStartMs": 1675740,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "breaking the stream into tiny droplets."
    } ]
  }, {
    "tStartMs": 1678470,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "These droplets are\nirregular in size, shape,"
    } ]
  }, {
    "tStartMs": 1681050,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "velocity and distance,"
    } ]
  }, {
    "tStartMs": 1682250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and the whole process is chaotic."
    } ]
  }, {
    "tStartMs": 1684980,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- That's like our magic sauce,"
    } ]
  }, {
    "tStartMs": 1686510,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "is how do you modulate that tin jet"
    } ]
  }, {
    "tStartMs": 1690050,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "so that it forms the droplets we want"
    } ]
  }, {
    "tStartMs": 1691430,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and that they're stable?"
    } ]
  }, {
    "tStartMs": 1692263,
    "dDurationMs": 4297,
    "segs": [ {
      "utf8": "- I think we found some paper\nthat describe this process"
    } ]
  }, {
    "tStartMs": 1696560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and it was sort of eyeopening to me"
    } ]
  }, {
    "tStartMs": 1699080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that it seems like all the droplets"
    } ]
  }, {
    "tStartMs": 1700940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "actually come out irregular\nout of the nozzle,"
    } ]
  }, {
    "tStartMs": 1703880,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but then before they reach the side"
    } ]
  }, {
    "tStartMs": 1706010,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "where they get hit by the laser,"
    } ]
  }, {
    "tStartMs": 1707510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "like the little irregular\ndroplets come together"
    } ]
  }, {
    "tStartMs": 1709970,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to form these perfectly spaced,"
    } ]
  }, {
    "tStartMs": 1712280,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "perfectly regular droplets"
    } ]
  }, {
    "tStartMs": 1713660,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that are about the same size and shape"
    } ]
  }, {
    "tStartMs": 1716360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and all traveling at the same velocity."
    } ]
  }, {
    "tStartMs": 1718730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "That feels like magic to me, Jayson."
    } ]
  }, {
    "tStartMs": 1720740,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Yeah, it's exactly that."
    } ]
  }, {
    "tStartMs": 1722210,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "It's how do you take a\nlong stream of a tin jet"
    } ]
  }, {
    "tStartMs": 1726470,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that wants to break up into\nall these irregular droplets"
    } ]
  }, {
    "tStartMs": 1729380,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and like force onto it"
    } ]
  }, {
    "tStartMs": 1731720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that it's gonna collapse\ninto a single droplet"
    } ]
  }, {
    "tStartMs": 1733880,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and then happen again and again and again?"
    } ]
  }, {
    "tStartMs": 1736310,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Casper] You also don't\nhave that many variables"
    } ]
  }, {
    "tStartMs": 1737960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to play with."
    } ]
  }, {
    "tStartMs": 1738793,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "You've got the pressure"
    } ]
  }, {
    "tStartMs": 1739940,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "with which you push out the tin"
    } ]
  }, {
    "tStartMs": 1741380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and at the frequency of the nozzle."
    } ]
  }, {
    "tStartMs": 1743480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Yeah, it seems like a\nhard problem to solve."
    } ]
  }, {
    "tStartMs": 1745880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- There's not a whole lot\nof variables to play with."
    } ]
  }, {
    "tStartMs": 1747980,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "And so mastering that\nmodulation of the jet is"
    } ]
  }, {
    "tStartMs": 1752780,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "how we make the droplets."
    } ]
  }, {
    "tStartMs": 1755180,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- [Casper] But these droplets\nnot only have to be identical,"
    } ]
  }, {
    "tStartMs": 1757850,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "they have to be moving incredibly fast."
    } ]
  }, {
    "tStartMs": 1761660,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- What will happen is if the next droplet"
    } ]
  }, {
    "tStartMs": 1764030,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that's coming down the line is too close,"
    } ]
  }, {
    "tStartMs": 1766250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "then it'll actually get like disturbed"
    } ]
  }, {
    "tStartMs": 1768830,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and mess up the next plasma event."
    } ]
  }, {
    "tStartMs": 1771560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So we have a requirement"
    } ]
  }, {
    "tStartMs": 1773630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which is both that we make\n50,000 droplets per second,"
    } ]
  }, {
    "tStartMs": 1776150,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "but also that they're\ntraveling extremely fast."
    } ]
  }, {
    "tStartMs": 1779810,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- [Casper] By 2011, their\nlaser-produced plasma source"
    } ]
  }, {
    "tStartMs": 1782720,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "reached 11 watts,"
    } ]
  }, {
    "tStartMs": 1784310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which was more than\ndouble what they managed"
    } ]
  }, {
    "tStartMs": 1786320,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "with their previous source."
    } ]
  }, {
    "tStartMs": 1787940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But they were still limited\nto just five wafers per hour."
    } ]
  }, {
    "tStartMs": 1791030,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So, they needed to increase\nthe power and fast,"
    } ]
  }, {
    "tStartMs": 1794210,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "because they promised they'd\nhit 60 wafers per hour"
    } ]
  }, {
    "tStartMs": 1796850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "by the end of 2011."
    } ]
  }, {
    "tStartMs": 1799280,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Unfortunately, this new\nmethod had a major flaw."
    } ]
  }, {
    "tStartMs": 1802790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- Now the problem with the tin\nissue, you hit the droplet,"
    } ]
  }, {
    "tStartMs": 1805160,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "you generate EUV with a very\ndecent conversion efficiency."
    } ]
  }, {
    "tStartMs": 1808940,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Where does the tin go?"
    } ]
  }, {
    "tStartMs": 1810110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Because like, you know,\n30 centimeters away,"
    } ]
  }, {
    "tStartMs": 1813050,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "you have this atomically flat,"
    } ]
  }, {
    "tStartMs": 1815480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "very beautiful, very expensive mirror"
    } ]
  }, {
    "tStartMs": 1818120,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "from our friends at Zeiss.\n- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 1819920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- And in the early days,"
    } ]
  }, {
    "tStartMs": 1821600,
    "dDurationMs": 1858,
    "segs": [ {
      "utf8": "we would coat a thing within."
    } ]
  }, {
    "tStartMs": 1823458,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Jos clicks fingers)"
    } ]
  }, {
    "tStartMs": 1824291,
    "dDurationMs": 1059,
    "segs": [ {
      "utf8": "Like this.\n- These machines need"
    } ]
  }, {
    "tStartMs": 1825350,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to run for a year."
    } ]
  }, {
    "tStartMs": 1826760,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "You're putting liters of tin\nthrough this plasma event"
    } ]
  }, {
    "tStartMs": 1831890,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and a single nanometer of tin,"
    } ]
  }, {
    "tStartMs": 1833690,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "if it was to land on\nthat collector mirror,"
    } ]
  }, {
    "tStartMs": 1835670,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "you'd have to take the\ncollector outta commission."
    } ]
  }, {
    "tStartMs": 1837710,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "We need to keep it almost\nperfectly clean for a year."
    } ]
  }, {
    "tStartMs": 1842030,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Yeah, how do you even approach that?"
    } ]
  }, {
    "tStartMs": 1843830,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- So our main tool here is\nthe hydrogen gas, actually."
    } ]
  }, {
    "tStartMs": 1847550,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Casper] They fill the chamber"
    } ]
  }, {
    "tStartMs": 1848690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "with low pressure hydrogen."
    } ]
  }, {
    "tStartMs": 1850190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This slows and cools\nthe tin particles down."
    } ]
  }, {
    "tStartMs": 1852980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And even if something\nmakes it to the collector,"
    } ]
  }, {
    "tStartMs": 1855440,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the hydrogen pulls it off to\nform a gas called stannane."
    } ]
  }, {
    "tStartMs": 1859070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This way, the machine\ncleans the collectors"
    } ]
  }, {
    "tStartMs": 1861230,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "while it's running,"
    } ]
  }, {
    "tStartMs": 1862520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but that hydrogen gas also gets hot"
    } ]
  }, {
    "tStartMs": 1864620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "from all those tin explosions."
    } ]
  }, {
    "tStartMs": 1866480,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So they need to keep\nflushing new, cooler hydrogen"
    } ]
  }, {
    "tStartMs": 1869270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "into the system while\nflushing out the stannane"
    } ]
  }, {
    "tStartMs": 1871820,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and hotter gas."
    } ]
  }, {
    "tStartMs": 1873350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But they have to get the\npressure and the flow rate"
    } ]
  }, {
    "tStartMs": 1875480,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "just right."
    } ]
  }, {
    "tStartMs": 1876410,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I mean, too little hydrogen"
    } ]
  }, {
    "tStartMs": 1877970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and the mirrors would get too dirty,"
    } ]
  }, {
    "tStartMs": 1879860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but too much hydrogen\nwould not only absorb"
    } ]
  }, {
    "tStartMs": 1881960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "too much EUV light,"
    } ]
  }, {
    "tStartMs": 1883340,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but it would also cause\nthe system to overheat."
    } ]
  }, {
    "tStartMs": 1886160,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- The question is how much heat is there?"
    } ]
  }, {
    "tStartMs": 1888710,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "How much energy is being\ndeposited into the gas?"
    } ]
  }, {
    "tStartMs": 1891560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And we were stumped for quite some time."
    } ]
  }, {
    "tStartMs": 1893630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "If you look at a EUV light source,"
    } ]
  }, {
    "tStartMs": 1895610,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "what you'll see is that\nit's kinda like a globe"
    } ]
  }, {
    "tStartMs": 1899030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of like purple-ish red light"
    } ]
  }, {
    "tStartMs": 1901520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and you kinda ask yourself\nlike, why is that happening?"
    } ]
  }, {
    "tStartMs": 1903920,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So we bought an ultra-fast camera."
    } ]
  }, {
    "tStartMs": 1906650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "What we realized is that\nafter every plasma event,"
    } ]
  }, {
    "tStartMs": 1909200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "there's a shockwave that goes"
    } ]
  }, {
    "tStartMs": 1911810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "propagating out into the hydrogen gas"
    } ]
  }, {
    "tStartMs": 1914450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and it's extremely repeatable."
    } ]
  }, {
    "tStartMs": 1917330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And you think to yourself,"
    } ]
  }, {
    "tStartMs": 1918163,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "there must be like an\nexplanation for this."
    } ]
  }, {
    "tStartMs": 1920420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And there's this formula,"
    } ]
  }, {
    "tStartMs": 1922940,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the Taylor-von Neumann-Sedov\nformula that explains"
    } ]
  }, {
    "tStartMs": 1926000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "point source explosions in an environment,"
    } ]
  }, {
    "tStartMs": 1927920,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "in like, say, a nuclear\nblast out to like supernova."
    } ]
  }, {
    "tStartMs": 1931520,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So I took this formula,"
    } ]
  }, {
    "tStartMs": 1932840,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "it like exactly describes the data."
    } ]
  }, {
    "tStartMs": 1934970,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It's just fantastic that we're seeing"
    } ]
  }, {
    "tStartMs": 1937550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "these, like, tiny little\nsupernovas happening"
    } ]
  }, {
    "tStartMs": 1939950,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "in our vessel 50,000 times a second."
    } ]
  }, {
    "tStartMs": 1942440,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- And is that a fair\nway to think about this,"
    } ]
  }, {
    "tStartMs": 1944390,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "like creating mini supernova?"
    } ]
  }, {
    "tStartMs": 1947090,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Yeah, it's actually pretty similar."
    } ]
  }, {
    "tStartMs": 1948650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It's almost like very similar to a,"
    } ]
  }, {
    "tStartMs": 1950300,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "like a type 1A supernova, it turns out,"
    } ]
  }, {
    "tStartMs": 1952160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "where you kind of have an object"
    } ]
  }, {
    "tStartMs": 1953480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that just fully evaporates\nand explodes apart."
    } ]
  }, {
    "tStartMs": 1956120,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And when all that energy\ngoes into the hydrogen gas,"
    } ]
  }, {
    "tStartMs": 1959390,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "it produces a shock wave, a blast wave"
    } ]
  }, {
    "tStartMs": 1961520,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "that comes flying out,"
    } ]
  }, {
    "tStartMs": 1962660,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "which is basically the same thing."
    } ]
  }, {
    "tStartMs": 1964651,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "If you look up in the night sky,"
    } ]
  }, {
    "tStartMs": 1965570,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "there are these like remnant supernovas"
    } ]
  }, {
    "tStartMs": 1967250,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that you can see coming from space."
    } ]
  }, {
    "tStartMs": 1969440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Casper] Using those\nenergy calculations,"
    } ]
  }, {
    "tStartMs": 1971120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "they discovered they needed to flush"
    } ]
  }, {
    "tStartMs": 1972680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the hydrogen at incredibly high speeds,"
    } ]
  }, {
    "tStartMs": 1974900,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "around 360 kilometers per hour."
    } ]
  }, {
    "tStartMs": 1977450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "That's more than a Category 5 hurricane,"
    } ]
  }, {
    "tStartMs": 1979520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "even if, you know, those\nspeeds are at low density."
    } ]
  }, {
    "tStartMs": 1982760,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But 2012 came and went"
    } ]
  }, {
    "tStartMs": 1984500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and they still didn't have enough power."
    } ]
  }, {
    "tStartMs": 1986900,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "In fact, by 2013, ASML\njust reached 50 watts"
    } ]
  }, {
    "tStartMs": 1990410,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "by shooting 50,000 tin\ndroplets per second."
    } ]
  }, {
    "tStartMs": 1993320,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But this increased power came at a price"
    } ]
  }, {
    "tStartMs": 1995600,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "because more power means more heat,"
    } ]
  }, {
    "tStartMs": 1998330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "heat that ends up slightly\nshifting the mirrors,"
    } ]
  }, {
    "tStartMs": 2001180,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "resulting in misaligned light\nand misaligned chip layers."
    } ]
  }, {
    "tStartMs": 2005110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So Zeiss built a nervous system"
    } ]
  }, {
    "tStartMs": 2007270,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "directly into the optics,"
    } ]
  }, {
    "tStartMs": 2009010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "robot-guided sensors\nthat constantly measure"
    } ]
  }, {
    "tStartMs": 2011530,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the exact position and\nangle of each mirror"
    } ]
  }, {
    "tStartMs": 2014410,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "down to the nanometer at the pico-radian,"
    } ]
  }, {
    "tStartMs": 2017140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "which is absolutely insane."
    } ]
  }, {
    "tStartMs": 2019570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- So how accurate do we\nneed to control this mirror?"
    } ]
  }, {
    "tStartMs": 2022600,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now one of the things, you\ncan do a thought experiment."
    } ]
  }, {
    "tStartMs": 2025510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- [Casper] Okay.\n- And I can place"
    } ]
  }, {
    "tStartMs": 2027880,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "a little laser on the side of this mirror."
    } ]
  }, {
    "tStartMs": 2031660,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Then we go all the way to the Moon"
    } ]
  }, {
    "tStartMs": 2033700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and we put a dime here."
    } ]
  }, {
    "tStartMs": 2036400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So then this light travels"
    } ]
  }, {
    "tStartMs": 2038260,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "all the way here and\nthen with the accuracy,"
    } ]
  }, {
    "tStartMs": 2041290,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I can control this mirror."
    } ]
  }, {
    "tStartMs": 2042880,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Yes.\n- I can decide"
    } ]
  }, {
    "tStartMs": 2044530,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "whether I point to this side of the dime"
    } ]
  }, {
    "tStartMs": 2047830,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "or whether I point.\n- That's insane."
    } ]
  }, {
    "tStartMs": 2049538,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "- To this side of the dime."
    } ]
  }, {
    "tStartMs": 2050699,
    "dDurationMs": 2231,
    "segs": [ {
      "utf8": "- What, that's crazy."
    } ]
  }, {
    "tStartMs": 2052930,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- So you can see that\nthe pointing accuracy is"
    } ]
  }, {
    "tStartMs": 2056500,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that's also in pico-radians."
    } ]
  }, {
    "tStartMs": 2059693,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "That is something very extreme."
    } ]
  }, {
    "tStartMs": 2062080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- This allowed them to control the light"
    } ]
  }, {
    "tStartMs": 2063760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "even when the power increased."
    } ]
  }, {
    "tStartMs": 2066040,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "While Zeiss was doing a\nstellar job with the optics,"
    } ]
  }, {
    "tStartMs": 2068500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "ASML was still struggling\nwith the power source."
    } ]
  }, {
    "tStartMs": 2071710,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The problem was that the\ntin droplets were too dense,"
    } ]
  }, {
    "tStartMs": 2074800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "meaning that most of the\nemitted EUV light was"
    } ]
  }, {
    "tStartMs": 2077620,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "still getting reabsorbed"
    } ]
  }, {
    "tStartMs": 2079030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "by the neutral atoms\nbefore it could ever reach"
    } ]
  }, {
    "tStartMs": 2081490,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "the collector mirror."
    } ]
  }, {
    "tStartMs": 2082570,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- The way we blasted the droplet was"
    } ]
  }, {
    "tStartMs": 2084790,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "so not enough light, too much debris."
    } ]
  }, {
    "tStartMs": 2087460,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- To make matters worse,"
    } ]
  }, {
    "tStartMs": 2088960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they could see that\nabout 10 years from now,"
    } ]
  }, {
    "tStartMs": 2091210,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "they would need a new\ngeneration of machine,"
    } ]
  }, {
    "tStartMs": 2093610,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "a high NA EUV machine,"
    } ]
  }, {
    "tStartMs": 2095710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "essentially one with a larger optic system"
    } ]
  }, {
    "tStartMs": 2098290,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that could print smaller features."
    } ]
  }, {
    "tStartMs": 2099910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So what did they do?"
    } ]
  }, {
    "tStartMs": 2102070,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "They decided to double down and invest"
    } ]
  }, {
    "tStartMs": 2104680,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in the next generation"
    } ]
  }, {
    "tStartMs": 2106270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "before they even got\nthe current one to work."
    } ]
  }, {
    "tStartMs": 2108850,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- The most doubtful period\nwas in the beginning."
    } ]
  }, {
    "tStartMs": 2111160,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So I started to work on this in 2012."
    } ]
  }, {
    "tStartMs": 2114130,
    "dDurationMs": 2949,
    "segs": [ {
      "utf8": "By that time, EUV was not working"
    } ]
  }, {
    "tStartMs": 2117079,
    "dDurationMs": 2031,
    "segs": [ {
      "utf8": "and there was this crazy idiot"
    } ]
  }, {
    "tStartMs": 2119110,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "working on the next generation"
    } ]
  }, {
    "tStartMs": 2122141,
    "dDurationMs": 1406,
    "segs": [ {
      "utf8": "where we could not even make"
    } ]
  }, {
    "tStartMs": 2123547,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "the EUV light in the first place."
    } ]
  }, {
    "tStartMs": 2125440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Not only are you all in on EUV,"
    } ]
  }, {
    "tStartMs": 2127690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "you're doubling down even before you know"
    } ]
  }, {
    "tStartMs": 2129340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "if EUV is gonna work.\n- Yes, yes."
    } ]
  }, {
    "tStartMs": 2131530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- But to keep funding the development,"
    } ]
  }, {
    "tStartMs": 2133180,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "they needed money and lots of it."
    } ]
  }, {
    "tStartMs": 2135610,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So, they turned to the\nvery people who needed"
    } ]
  }, {
    "tStartMs": 2137740,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "this technology."
    } ]
  }, {
    "tStartMs": 2139690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- ASML reached out to its main customers,"
    } ]
  }, {
    "tStartMs": 2141970,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "okay, you want this technology"
    } ]
  }, {
    "tStartMs": 2144700,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for the next generation of chips?"
    } ]
  }, {
    "tStartMs": 2146440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Well, you need to make us able"
    } ]
  }, {
    "tStartMs": 2148690,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to invest more by investing in us."
    } ]
  }, {
    "tStartMs": 2152110,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- Intel invested around $4.1 billion"
    } ]
  }, {
    "tStartMs": 2155320,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "and Samsung and TSMC invested\nanother 1.3 billion combined."
    } ]
  }, {
    "tStartMs": 2160060,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So they can keep the research going,"
    } ]
  }, {
    "tStartMs": 2161950,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but with no product to show,"
    } ]
  }, {
    "tStartMs": 2164080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "customers were running out of patience."
    } ]
  }, {
    "tStartMs": 2166390,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- We were crucified at every conference"
    } ]
  }, {
    "tStartMs": 2169540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that the promises we made last year,"
    } ]
  }, {
    "tStartMs": 2171550,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "we were unable to live up to."
    } ]
  }, {
    "tStartMs": 2173680,
    "dDurationMs": 937,
    "segs": [ {
      "utf8": "- Yeah.\n- And they said,"
    } ]
  }, {
    "tStartMs": 2174617,
    "dDurationMs": 1463,
    "segs": [ {
      "utf8": "\"This is what you showed two years ago."
    } ]
  }, {
    "tStartMs": 2176080,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "This is what you showed last year"
    } ]
  }, {
    "tStartMs": 2177310,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and this is what you're\ntelling me this year."
    } ]
  }, {
    "tStartMs": 2178750,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So why would I believe you?\""
    } ]
  }, {
    "tStartMs": 2180280,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- They were getting desperate."
    } ]
  }, {
    "tStartMs": 2182140,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- But this was, I think,\nabout 2012 or '13,"
    } ]
  }, {
    "tStartMs": 2187180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we were struggling to get the EUV power up"
    } ]
  }, {
    "tStartMs": 2189700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and Kinoshita visited us."
    } ]
  }, {
    "tStartMs": 2191200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I took him to dinner\nin a small town nearby"
    } ]
  }, {
    "tStartMs": 2193570,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "and across from the\nrestaurant was a Maria Chapel."
    } ]
  }, {
    "tStartMs": 2197500,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And now, you know, science,"
    } ]
  }, {
    "tStartMs": 2199210,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "we have come to the limits of science."
    } ]
  }, {
    "tStartMs": 2201460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Hey, let's go for Divine intervention."
    } ]
  }, {
    "tStartMs": 2203320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So we went to the chapel,"
    } ]
  }, {
    "tStartMs": 2204880,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "so Kinoshita just to be\nsafe lit three candles"
    } ]
  }, {
    "tStartMs": 2209110,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "for the three suppliers that\nwere pursuing EUV technology"
    } ]
  }, {
    "tStartMs": 2212170,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "at the time."
    } ]
  }, {
    "tStartMs": 2213100,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And lo and behold, and I\nhave the data to prove it,"
    } ]
  }, {
    "tStartMs": 2216400,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "there is a very strong correlation"
    } ]
  }, {
    "tStartMs": 2218856,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "between us lighting the\ncandle and power going up."
    } ]
  }, {
    "tStartMs": 2223960,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "It's not a causal effect, but\nthere is a strong correlation."
    } ]
  }, {
    "tStartMs": 2227500,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- The big idea was instead\nof hitting the droplet once,"
    } ]
  }, {
    "tStartMs": 2230380,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "hit it twice."
    } ]
  }, {
    "tStartMs": 2231670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Jos] One shot to hit the droplet"
    } ]
  }, {
    "tStartMs": 2234130,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "and it expands in like a pancake shape."
    } ]
  }, {
    "tStartMs": 2236833,
    "dDurationMs": 1227,
    "segs": [ {
      "utf8": "- [Casper] Yep.\n- And then,"
    } ]
  }, {
    "tStartMs": 2238060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "only then have the second shot,"
    } ]
  }, {
    "tStartMs": 2239980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the more powerful main pulse"
    } ]
  }, {
    "tStartMs": 2241990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "where you evaporate the pancake"
    } ]
  }, {
    "tStartMs": 2243910,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and turn it into a plasma."
    } ]
  }, {
    "tStartMs": 2245470,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] Yeah.\n- This was"
    } ]
  }, {
    "tStartMs": 2246303,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "a major breakthrough."
    } ]
  }, {
    "tStartMs": 2247630,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Casper] By changing the target"
    } ]
  }, {
    "tStartMs": 2248890,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "from a droplet to a pancake,"
    } ]
  }, {
    "tStartMs": 2250480,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "you got a larger surface area\nfor the laser to vaporize,"
    } ]
  }, {
    "tStartMs": 2253660,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "but without the cost of adding\nmore debris or neutral atoms"
    } ]
  }, {
    "tStartMs": 2257170,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "because now the tin is\nvaporized all at once."
    } ]
  }, {
    "tStartMs": 2260710,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "By 2014, they finally managed to hit"
    } ]
  }, {
    "tStartMs": 2263440,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that coveted 100 watts mark."
    } ]
  }, {
    "tStartMs": 2265750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But improvements in multi patterning"
    } ]
  }, {
    "tStartMs": 2267580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "with 193 nanometers"
    } ]
  }, {
    "tStartMs": 2269410,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "now meant that EUV would only be useful"
    } ]
  }, {
    "tStartMs": 2271930,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "if the source reached at least 200 watts"
    } ]
  }, {
    "tStartMs": 2274210,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and made 125 wafers per hour."
    } ]
  }, {
    "tStartMs": 2276850,
    "dDurationMs": 1697,
    "segs": [ {
      "utf8": "- The source went from 100 to 200,"
    } ]
  }, {
    "tStartMs": 2278547,
    "dDurationMs": 2743,
    "segs": [ {
      "utf8": "but as the industry moved\non, nobody waits for you."
    } ]
  }, {
    "tStartMs": 2281290,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "You know, they find other solutions."
    } ]
  }, {
    "tStartMs": 2283600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "We had to catch up."
    } ]
  }, {
    "tStartMs": 2285040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So, it was a moving goalpost."
    } ]
  }, {
    "tStartMs": 2287050,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- One of the problems was\nhow do you perfectly time"
    } ]
  }, {
    "tStartMs": 2289330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the laser so you hit\neach of these droplets?"
    } ]
  }, {
    "tStartMs": 2292180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- So the analogy is a bit like a golf ball"
    } ]
  }, {
    "tStartMs": 2294940,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "that you need to land in\nthe hole 200 meters away,"
    } ]
  }, {
    "tStartMs": 2298960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "not like land on the green,"
    } ]
  }, {
    "tStartMs": 2300160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "not bouncing and get in the hole,"
    } ]
  }, {
    "tStartMs": 2301300,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but like land in the hole every time."
    } ]
  }, {
    "tStartMs": 2303640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's the level of precision that we need"
    } ]
  }, {
    "tStartMs": 2305080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to deliver the droplets."
    } ]
  }, {
    "tStartMs": 2306880,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Those droplets are traveling"
    } ]
  }, {
    "tStartMs": 2308050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "through this like\nmaelstrom of hydrogen flow."
    } ]
  }, {
    "tStartMs": 2310720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The speeds are tremendously high,"
    } ]
  }, {
    "tStartMs": 2312580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "like shooting golf\nballs through a tornado,"
    } ]
  }, {
    "tStartMs": 2314500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and then right when it lands at the hole,"
    } ]
  }, {
    "tStartMs": 2316750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that's when it needs to\nget hit by the laser."
    } ]
  }, {
    "tStartMs": 2318610,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So in order to basically\ntrack the droplets for that,"
    } ]
  }, {
    "tStartMs": 2321730,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "we use laser curtains and\nwe can sort of look at"
    } ]
  }, {
    "tStartMs": 2324640,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "when does the droplet pass\nthrough a laser curtain."
    } ]
  }, {
    "tStartMs": 2326770,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Those scattered photons tell\nus basically when and where is"
    } ]
  }, {
    "tStartMs": 2330220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "the droplet,"
    } ]
  }, {
    "tStartMs": 2331053,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "and then importantly tells\nus when to fire the laser."
    } ]
  }, {
    "tStartMs": 2333070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So we actually have to take into account"
    } ]
  }, {
    "tStartMs": 2334870,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "how long will it take for\nthe light pulse to hit"
    } ]
  }, {
    "tStartMs": 2337090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the droplet after we send the pulse."
    } ]
  }, {
    "tStartMs": 2339850,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Now by 2015,"
    } ]
  }, {
    "tStartMs": 2341320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they were getting closer and closer"
    } ]
  }, {
    "tStartMs": 2343240,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to that coveted 200 watt mark,"
    } ]
  }, {
    "tStartMs": 2345490,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "when all of a sudden the ASML\nboard members got summoned."
    } ]
  }, {
    "tStartMs": 2349420,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- This was one of these decisive moments"
    } ]
  }, {
    "tStartMs": 2352090,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "where our customers were\nreally thin on patience"
    } ]
  }, {
    "tStartMs": 2355360,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and Martin and all the board members were"
    } ]
  }, {
    "tStartMs": 2356920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "summoned to Korea to show"
    } ]
  }, {
    "tStartMs": 2359590,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "200 watt and they were\nreally fed up with it."
    } ]
  }, {
    "tStartMs": 2362560,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "You know, you either show\nit now or you go away."
    } ]
  }, {
    "tStartMs": 2366460,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And when they entered the plane,"
    } ]
  }, {
    "tStartMs": 2368020,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "the experiment was still running."
    } ]
  }, {
    "tStartMs": 2368990,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "- [Casper] Okay.\n- When they exited"
    } ]
  }, {
    "tStartMs": 2371410,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "the plane,"
    } ]
  }, {
    "tStartMs": 2372730,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "they had the first result\ndemonstrating 200 watt."
    } ]
  }, {
    "tStartMs": 2374883,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "This is how close we came."
    } ]
  }, {
    "tStartMs": 2376960,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- With the source power up,"
    } ]
  }, {
    "tStartMs": 2378190,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "there was one final problem\nthat had to be solved"
    } ]
  }, {
    "tStartMs": 2381340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "before they could begin\nmanufacturing their machine."
    } ]
  }, {
    "tStartMs": 2384310,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "See, while the hydrogen gas did protect"
    } ]
  }, {
    "tStartMs": 2386350,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the collector mirror from debris,"
    } ]
  }, {
    "tStartMs": 2388180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it wasn't perfect."
    } ]
  }, {
    "tStartMs": 2389710,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "All the intense, high energy photons"
    } ]
  }, {
    "tStartMs": 2391870,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and hydrogen ions zipping around"
    } ]
  }, {
    "tStartMs": 2394150,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "deteriorated a very special\ntop coating on the collector."
    } ]
  }, {
    "tStartMs": 2397840,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So they still had to clean\nthe mirrors every 10 hours,"
    } ]
  }, {
    "tStartMs": 2401260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which, you know, is\nterrible for productivity."
    } ]
  }, {
    "tStartMs": 2404050,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Martin van den Brink asked\nfor updates every day"
    } ]
  }, {
    "tStartMs": 2406330,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "on their progress."
    } ]
  }, {
    "tStartMs": 2407260,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But then one of the engineers noticed"
    } ]
  }, {
    "tStartMs": 2409240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that every time they\nopened up the machine,"
    } ]
  }, {
    "tStartMs": 2411670,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the mirrors suddenly seemed cleaner."
    } ]
  }, {
    "tStartMs": 2414400,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "- That he kind of chimed in and said,"
    } ]
  }, {
    "tStartMs": 2416027,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "\"Oh, wait a second."
    } ]
  }, {
    "tStartMs": 2418090,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Whenever we opened up the machine,"
    } ]
  }, {
    "tStartMs": 2420160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "oxygen comes in and our problem is solved."
    } ]
  }, {
    "tStartMs": 2422800,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Couldn't we think of a way to add"
    } ]
  }, {
    "tStartMs": 2424870,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "just a little oxygen to our system"
    } ]
  }, {
    "tStartMs": 2427300,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "and make sure that the\ncollector stays clean longer?\""
    } ]
  }, {
    "tStartMs": 2431290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And so they started experimenting"
    } ]
  }, {
    "tStartMs": 2433780,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "with the amount of oxygen that was needed"
    } ]
  }, {
    "tStartMs": 2436347,
    "dDurationMs": 2743,
    "segs": [ {
      "utf8": "in the vacuum and then\nfinally got to this point,"
    } ]
  }, {
    "tStartMs": 2439090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "okay, if we add so much oxygen,"
    } ]
  }, {
    "tStartMs": 2441010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we'll keep the collector clean for longer."
    } ]
  }, {
    "tStartMs": 2443530,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- With this fix, ASML's machine could run"
    } ]
  }, {
    "tStartMs": 2445570,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "continuously for much\nlonger and it finally became"
    } ]
  }, {
    "tStartMs": 2448960,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "commercially viable."
    } ]
  }, {
    "tStartMs": 2450640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "By 2016, orders started pouring in"
    } ]
  }, {
    "tStartMs": 2453160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and now all of the most\nadvanced chips need"
    } ]
  }, {
    "tStartMs": 2455770,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "ASML's machine,"
    } ]
  }, {
    "tStartMs": 2456910,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "making them perhaps the most important"
    } ]
  }, {
    "tStartMs": 2459190,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "tech company in the world."
    } ]
  }, {
    "tStartMs": 2461140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "ASML's first commercial machines had"
    } ]
  }, {
    "tStartMs": 2463120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "a numerical aperture of 0.33"
    } ]
  }, {
    "tStartMs": 2465370,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and could print 13 nanometer lines."
    } ]
  }, {
    "tStartMs": 2468010,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "These are called the low NA machines"
    } ]
  }, {
    "tStartMs": 2470140,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and ASML still makes them."
    } ]
  }, {
    "tStartMs": 2471880,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But the machine that Jan's\nteam started working on"
    } ]
  }, {
    "tStartMs": 2474340,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "back in 2012 was the next generation,"
    } ]
  }, {
    "tStartMs": 2477280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "which had a larger optic system"
    } ]
  }, {
    "tStartMs": 2479050,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so they could print even smaller features."
    } ]
  }, {
    "tStartMs": 2481240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "This is the high NA machine"
    } ]
  }, {
    "tStartMs": 2483340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "with a numerical aperture of 0.55,"
    } ]
  }, {
    "tStartMs": 2486340,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "and we get to see their\nlatest version up close."
    } ]
  }, {
    "tStartMs": 2490570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- How much is the machine?"
    } ]
  }, {
    "tStartMs": 2492160,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- We always say north\nof 350 million euros."
    } ]
  }, {
    "tStartMs": 2496000,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- And you can actually buy it, right?"
    } ]
  }, {
    "tStartMs": 2497410,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- You can if you want, yeah."
    } ]
  }, {
    "tStartMs": 2498490,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "- If I had the money I could buy it?"
    } ]
  }, {
    "tStartMs": 2500263,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Yes, you could."
    } ]
  }, {
    "tStartMs": 2502090,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- How many people have seen this before?"
    } ]
  }, {
    "tStartMs": 2503590,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- We really limit the amount of people"
    } ]
  }, {
    "tStartMs": 2506020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that get to go inside the clean room."
    } ]
  }, {
    "tStartMs": 2507820,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Casper] ASML's machines are built"
    } ]
  }, {
    "tStartMs": 2509290,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "in a super strict clean room."
    } ]
  }, {
    "tStartMs": 2511000,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "In any cubic meter, there can\nbe no more than 10 particles,"
    } ]
  }, {
    "tStartMs": 2513910,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "only 0.1 microns large,"
    } ]
  }, {
    "tStartMs": 2515860,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and nothing bigger than that."
    } ]
  }, {
    "tStartMs": 2517570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "A spec of pollen is around 20 microns"
    } ]
  }, {
    "tStartMs": 2519640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and extremely fine sand\nis around 10 microns."
    } ]
  }, {
    "tStartMs": 2522700,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "To put all of this in perspective,"
    } ]
  }, {
    "tStartMs": 2524440,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "hospital operating rooms,"
    } ]
  }, {
    "tStartMs": 2525730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "which have to be extremely clean,"
    } ]
  }, {
    "tStartMs": 2527560,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "only allow a maximum of 10,000\nparticles per cubic meter"
    } ]
  }, {
    "tStartMs": 2531040,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that are 0.1 microns wide."
    } ]
  }, {
    "tStartMs": 2533830,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "It's so unfair how much\nbetter Marc looks, though"
    } ]
  }, {
    "tStartMs": 2537430,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "in his light suit."
    } ]
  }, {
    "tStartMs": 2538420,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I feel like a little Smurf."
    } ]
  }, {
    "tStartMs": 2541100,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "- Okay, so we're gonna go\nthrough the air showers,"
    } ]
  }, {
    "tStartMs": 2544690,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "so you're gonna have to do as I do."
    } ]
  }, {
    "tStartMs": 2546700,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Casper] Okay."
    } ]
  }, {
    "tStartMs": 2547720,
    "dDurationMs": 2422,
    "segs": [ {
      "utf8": "So this is brushing down all the particles"
    } ]
  }, {
    "tStartMs": 2550142,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that are still on us."
    } ]
  }, {
    "tStartMs": 2550975,
    "dDurationMs": 1455,
    "segs": [ {
      "utf8": "- [Marc] Yes, so this\nis like super clean air"
    } ]
  }, {
    "tStartMs": 2552430,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "blowing us clean."
    } ]
  }, {
    "tStartMs": 2554920,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "- [Casper] This place is huge."
    } ]
  }, {
    "tStartMs": 2556183,
    "dDurationMs": 2037,
    "segs": [ {
      "utf8": "- [Marc] It's huge.\n- [Casper] It's insane."
    } ]
  }, {
    "tStartMs": 2558220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I've been in a clean room\na couple times before,"
    } ]
  }, {
    "tStartMs": 2560740,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "but it's nothing compared to this."
    } ]
  }, {
    "tStartMs": 2562540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Are there any secret areas here"
    } ]
  }, {
    "tStartMs": 2564460,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "where almost no one has access to?"
    } ]
  }, {
    "tStartMs": 2567490,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "- [Marc] I can't tell you."
    } ]
  }, {
    "tStartMs": 2568800,
    "dDurationMs": 1065,
    "segs": [ {
      "utf8": "(Casper laughs)"
    } ]
  }, {
    "tStartMs": 2569865,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] Great answer."
    } ]
  }, {
    "tStartMs": 2570698,
    "dDurationMs": 1775,
    "segs": [ {
      "utf8": "- [Marc] Okay, so this\nis the total system."
    } ]
  }, {
    "tStartMs": 2574980,
    "dDurationMs": 1312,
    "segs": [ {
      "utf8": "- [Casper] This is crazy."
    } ]
  }, {
    "tStartMs": 2576292,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Look how big it is."
    } ]
  }, {
    "tStartMs": 2577960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "This is the most advanced\nmachine humanity's ever built."
    } ]
  }, {
    "tStartMs": 2581170,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "It's taken many, many years,\ndecades of development,"
    } ]
  }, {
    "tStartMs": 2584890,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "many billions of dollars,"
    } ]
  }, {
    "tStartMs": 2586690,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "all to get this humongous beauty."
    } ]
  }, {
    "tStartMs": 2590230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So this is the first high NA machine."
    } ]
  }, {
    "tStartMs": 2592120,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Marc] Yes."
    } ]
  }, {
    "tStartMs": 2592953,
    "dDurationMs": 3997,
    "segs": [ {
      "utf8": "So if you saw pictures on\nthe internet or whatever,"
    } ]
  }, {
    "tStartMs": 2596950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that's this machine."
    } ]
  }, {
    "tStartMs": 2597783,
    "dDurationMs": 2707,
    "segs": [ {
      "utf8": "So the very first lines ever\nprinted at eight nanometers"
    } ]
  }, {
    "tStartMs": 2600490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and stuff, that was this machine."
    } ]
  }, {
    "tStartMs": 2602170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- [Casper] This smoothest object on earth."
    } ]
  }, {
    "tStartMs": 2604690,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Marc] Yeah, it's all in here, yeah."
    } ]
  }, {
    "tStartMs": 2606670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Casper] Wait, so let me\nsee if I can figure this out."
    } ]
  }, {
    "tStartMs": 2609130,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This is the light source."
    } ]
  }, {
    "tStartMs": 2611980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It's where they make\nthe extreme ultraviolet."
    } ]
  }, {
    "tStartMs": 2614170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Marc] Yes."
    } ]
  }, {
    "tStartMs": 2616106,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "- [Casper] And then the laser\nmust come in from there."
    } ]
  }, {
    "tStartMs": 2617740,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Marc] Yeah, let's\ntake a look at the laser."
    } ]
  }, {
    "tStartMs": 2619690,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Casper] In fact, we got to see"
    } ]
  }, {
    "tStartMs": 2620710,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "just how the laser and light source work."
    } ]
  }, {
    "tStartMs": 2623744,
    "dDurationMs": 1706,
    "segs": [ {
      "utf8": "I think we're entering\nthe laser system here."
    } ]
  }, {
    "tStartMs": 2625450,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Marc's just making sure I think"
    } ]
  }, {
    "tStartMs": 2626680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that we can actually film here,"
    } ]
  }, {
    "tStartMs": 2628510,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that we're not catching\nanything we're not supposed to."
    } ]
  }, {
    "tStartMs": 2630850,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Oh wow, this looks dangerous."
    } ]
  }, {
    "tStartMs": 2633610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Now the laser system is covered"
    } ]
  }, {
    "tStartMs": 2635020,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "by all of these brown cabinets,"
    } ]
  }, {
    "tStartMs": 2636550,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but here is a model version."
    } ]
  }, {
    "tStartMs": 2638530,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "A carbon dioxide laser of\njust a few watts enters"
    } ]
  }, {
    "tStartMs": 2641380,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "this amplifier where it bounces around"
    } ]
  }, {
    "tStartMs": 2643720,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "until it's roughly five\ntimes its original power."
    } ]
  }, {
    "tStartMs": 2646660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It then goes through a total\nof four different amplifiers"
    } ]
  }, {
    "tStartMs": 2649510,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to bring the final laser\nup to 20,000 watts,"
    } ]
  }, {
    "tStartMs": 2652780,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which is four times stronger\nthan lasers that cut"
    } ]
  }, {
    "tStartMs": 2655090,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "through steel."
    } ]
  }, {
    "tStartMs": 2656350,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- Over here we have the\namplifiers that generates"
    } ]
  }, {
    "tStartMs": 2659860,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "this powerful laser beam."
    } ]
  }, {
    "tStartMs": 2662050,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And then it basically comes out"
    } ]
  }, {
    "tStartMs": 2663820,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and this is part of the\nbeam transport system"
    } ]
  }, {
    "tStartMs": 2666880,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "where it's brought to the machine."
    } ]
  }, {
    "tStartMs": 2669190,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So this pipe here has the big laser beam."
    } ]
  }, {
    "tStartMs": 2671800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- And this has a mirror.\n- [Marc] Yes."
    } ]
  }, {
    "tStartMs": 2674560,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Casper] Then the pulses travel"
    } ]
  }, {
    "tStartMs": 2675730,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to the light source module."
    } ]
  }, {
    "tStartMs": 2677050,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It kind of looks like a Transformer"
    } ]
  }, {
    "tStartMs": 2678700,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "or like a, I don't know, like a spaceship."
    } ]
  }, {
    "tStartMs": 2681580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "There's so many wires going everywhere."
    } ]
  }, {
    "tStartMs": 2684220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "- [Marc] Don't touch this."
    } ]
  }, {
    "tStartMs": 2688450,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Casper] Holy crap."
    } ]
  }, {
    "tStartMs": 2690460,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "This is pretty big, huh?"
    } ]
  }, {
    "tStartMs": 2691934,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "This is insane."
    } ]
  }, {
    "tStartMs": 2693000,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "- [Marc] And this is\njust the light source."
    } ]
  }, {
    "tStartMs": 2694203,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] This is just a light source."
    } ]
  }, {
    "tStartMs": 2695036,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "Are you getting this comparison shot?"
    } ]
  }, {
    "tStartMs": 2696850,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- [Marc] And so you need all\nof this just to make EUV light."
    } ]
  }, {
    "tStartMs": 2700180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Casper] Just to make the\nlight, that's incredible."
    } ]
  }, {
    "tStartMs": 2702430,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Can we do a little walk around?"
    } ]
  }, {
    "tStartMs": 2703973,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "- [Marc] We can do a little walk."
    } ]
  }, {
    "tStartMs": 2706450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Let's go."
    } ]
  }, {
    "tStartMs": 2707650,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- So basically, this is\nthe heart of the source."
    } ]
  }, {
    "tStartMs": 2710770,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "- [Casper] Can I stand on here?"
    } ]
  }, {
    "tStartMs": 2713200,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Marc] If you are below 137, you can."
    } ]
  }, {
    "tStartMs": 2715750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Casper] I don't, I think I am."
    } ]
  }, {
    "tStartMs": 2721270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Woo."
    } ]
  }, {
    "tStartMs": 2722103,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "And so the tin droplets are\ncoming in from the left."
    } ]
  }, {
    "tStartMs": 2724420,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Marc] Yes."
    } ]
  }, {
    "tStartMs": 2725470,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Casper] Then we're\nshooting the laser from here."
    } ]
  }, {
    "tStartMs": 2727930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Marc] Yeah."
    } ]
  }, {
    "tStartMs": 2729250,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Casper] Okay, it explodes."
    } ]
  }, {
    "tStartMs": 2730750,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Marc] And then the light."
    } ]
  }, {
    "tStartMs": 2731650,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Casper] The light goes out there."
    } ]
  }, {
    "tStartMs": 2734620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "One improvement from\nASML's first EUV machine"
    } ]
  }, {
    "tStartMs": 2737260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to their newest one is"
    } ]
  }, {
    "tStartMs": 2738670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the number of pulses that hit the droplet."
    } ]
  }, {
    "tStartMs": 2741460,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The first pre-pulse still\nflattens the droplet"
    } ]
  }, {
    "tStartMs": 2743890,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "into a pancake,"
    } ]
  }, {
    "tStartMs": 2745090,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but now there's also a second pre-pulse"
    } ]
  }, {
    "tStartMs": 2747430,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that further reduces the density."
    } ]
  }, {
    "tStartMs": 2749020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It basically turns it\ninto a low density gas,"
    } ]
  }, {
    "tStartMs": 2751900,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "it rarifies it."
    } ]
  }, {
    "tStartMs": 2753640,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And then the final pulse\nessentially ionizes all of it."
    } ]
  }, {
    "tStartMs": 2757210,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So for basically the same power\ncoming from the drive laser,"
    } ]
  }, {
    "tStartMs": 2760570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "they get even more EUV light."
    } ]
  }, {
    "tStartMs": 2763030,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Now if they want even more light,"
    } ]
  }, {
    "tStartMs": 2764530,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "then the only way to do that is"
    } ]
  }, {
    "tStartMs": 2765760,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "by hitting more droplets."
    } ]
  }, {
    "tStartMs": 2767290,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And that's exactly what they did."
    } ]
  }, {
    "tStartMs": 2769300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Our most recent EUV light sources"
    } ]
  }, {
    "tStartMs": 2771760,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "that we're shipping right now,"
    } ]
  }, {
    "tStartMs": 2772810,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which are around the 500 watt level,"
    } ]
  }, {
    "tStartMs": 2775330,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "we increased the rep rate up\nto 60,000 times per second."
    } ]
  }, {
    "tStartMs": 2778480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And then we have a roadmap that's gonna go"
    } ]
  }, {
    "tStartMs": 2780460,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to 100,000 droplets per second."
    } ]
  }, {
    "tStartMs": 2782920,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "We've actually now already demonstrated"
    } ]
  }, {
    "tStartMs": 2784510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "this 100,000 droplets\nper second in the lab."
    } ]
  }, {
    "tStartMs": 2786670,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So it's not an if but a when."
    } ]
  }, {
    "tStartMs": 2788410,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- Crazy."
    } ]
  }, {
    "tStartMs": 2790030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Marc] The three pulses\nthat we use to make"
    } ]
  }, {
    "tStartMs": 2791860,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the pancake, to blow up\nthe pancake a little bit"
    } ]
  }, {
    "tStartMs": 2794020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and then to evaporate the pancake."
    } ]
  }, {
    "tStartMs": 2796360,
    "dDurationMs": 1236,
    "segs": [ {
      "utf8": "- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 2797596,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- The first two pulses,"
    } ]
  }, {
    "tStartMs": 2798429,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "they would be coming in\nthrough this pipe here"
    } ]
  }, {
    "tStartMs": 2801970,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and then the main pulse\nwith the big laser,"
    } ]
  }, {
    "tStartMs": 2805180,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the laser beam would be\ndelivered through this pipe here."
    } ]
  }, {
    "tStartMs": 2808000,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Casper] Both the\nhigh and low NA machine"
    } ]
  }, {
    "tStartMs": 2809710,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "shipping out right now use three pulses"
    } ]
  }, {
    "tStartMs": 2811810,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and eventually they will hit\nmore droplets per second."
    } ]
  }, {
    "tStartMs": 2815260,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But the light source\nis just one small part"
    } ]
  }, {
    "tStartMs": 2817480,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "of the full machine."
    } ]
  }, {
    "tStartMs": 2818470,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "After bouncing off the collector mirror,"
    } ]
  }, {
    "tStartMs": 2820300,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the EUV light moves to the illuminator."
    } ]
  }, {
    "tStartMs": 2822970,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "A set of mirrors shape and focus the light"
    } ]
  }, {
    "tStartMs": 2825250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "before it hits the reticle."
    } ]
  }, {
    "tStartMs": 2826870,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The reticle is the top half"
    } ]
  }, {
    "tStartMs": 2828160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and this module is built\nin a separate facility"
    } ]
  }, {
    "tStartMs": 2830440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and installed later."
    } ]
  }, {
    "tStartMs": 2831880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Next the light goes into\nthe projection optics box,"
    } ]
  }, {
    "tStartMs": 2834760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which is a set of mirrors\nthat shrink the light down."
    } ]
  }, {
    "tStartMs": 2837640,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The high NA machine can shrink the pattern"
    } ]
  }, {
    "tStartMs": 2839530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "eight times in the vertical direction"
    } ]
  }, {
    "tStartMs": 2841330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and four times in the\nhorizontal direction."
    } ]
  }, {
    "tStartMs": 2844000,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "The mirrors are also much smoother still."
    } ]
  }, {
    "tStartMs": 2846490,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "If the low NA's mirrors\nwere the size of Germany,"
    } ]
  }, {
    "tStartMs": 2848950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the tallest bump would\nbe about a millimeter."
    } ]
  }, {
    "tStartMs": 2851110,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But if the high NA mirrors\nwere the size of the world,"
    } ]
  }, {
    "tStartMs": 2853660,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "the tallest bump would be"
    } ]
  }, {
    "tStartMs": 2854740,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "about the thickness of a playing card."
    } ]
  }, {
    "tStartMs": 2856990,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "By the combination of both\nof these improvements,"
    } ]
  }, {
    "tStartMs": 2859180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "ASML was able to increase\nthe numerical aperture"
    } ]
  }, {
    "tStartMs": 2861550,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "from 0.33 to 0.55."
    } ]
  }, {
    "tStartMs": 2865120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And finally, the light hits the wafer."
    } ]
  }, {
    "tStartMs": 2867760,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In order to print around\n185 wafers per hour,"
    } ]
  }, {
    "tStartMs": 2871180,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the reticle whips back and forth"
    } ]
  }, {
    "tStartMs": 2872770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "at accelerations of over 20 Gs."
    } ]
  }, {
    "tStartMs": 2875290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "That's over five times the acceleration"
    } ]
  }, {
    "tStartMs": 2877270,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of a Formula 1 car."
    } ]
  }, {
    "tStartMs": 2878890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And this is some actual footage"
    } ]
  }, {
    "tStartMs": 2880840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "of what that's like inside this machine."
    } ]
  }, {
    "tStartMs": 2882610,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "And notice that this is not sped up."
    } ]
  }, {
    "tStartMs": 2886330,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But the crazy thing to\nme about this machine"
    } ]
  }, {
    "tStartMs": 2888220,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "isn't how fast the reticle moves"
    } ]
  }, {
    "tStartMs": 2890260,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or even how small it can print,"
    } ]
  }, {
    "tStartMs": 2892840,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but it's just how insanely\naccurate it needs to be."
    } ]
  }, {
    "tStartMs": 2895930,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The most any two layers can be off,"
    } ]
  }, {
    "tStartMs": 2898060,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "which is called the\noverlay, is one nanometer."
    } ]
  }, {
    "tStartMs": 2901510,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "That's five freaking\nsilicon atoms of precision."
    } ]
  }, {
    "tStartMs": 2904600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That's insane."
    } ]
  }, {
    "tStartMs": 2905800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- So typically what we\ndo as system engineers is"
    } ]
  }, {
    "tStartMs": 2909160,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that we make a budget.\n- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 2910690,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- So we say, hey, you\nget, let's say a nanometer"
    } ]
  }, {
    "tStartMs": 2913780,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and we divide then the nanometers"
    } ]
  }, {
    "tStartMs": 2919000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "to smaller fractions.\n- Right,"
    } ]
  }, {
    "tStartMs": 2920230,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "the nanometers total."
    } ]
  }, {
    "tStartMs": 2921280,
    "dDurationMs": 2194,
    "segs": [ {
      "utf8": "It's not like you group gets a nanometer."
    } ]
  }, {
    "tStartMs": 2923474,
    "dDurationMs": 1316,
    "segs": [ {
      "utf8": "- You get a nanometer, you get, no, no."
    } ]
  }, {
    "tStartMs": 2924790,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "You get a nanometer in total, yes."
    } ]
  }, {
    "tStartMs": 2928240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- [Casper] So you have to fight for the,"
    } ]
  }, {
    "tStartMs": 2930760,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "for your part of the nanometer."
    } ]
  }, {
    "tStartMs": 2932770,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- It's kind of cool to realize"
    } ]
  }, {
    "tStartMs": 2933970,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that like every smartphone\nnowadays has a chip"
    } ]
  }, {
    "tStartMs": 2937330,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "that is made with the machine"
    } ]
  }, {
    "tStartMs": 2938710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that was actually put together here."
    } ]
  }, {
    "tStartMs": 2941080,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "So that's a cool thought."
    } ]
  }, {
    "tStartMs": 2944290,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Take a look at this."
    } ]
  }, {
    "tStartMs": 2946210,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Marc] It's pretty massive, eh?"
    } ]
  }, {
    "tStartMs": 2947410,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Casper] So big."
    } ]
  }, {
    "tStartMs": 2949000,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So do you cover it up?"
    } ]
  }, {
    "tStartMs": 2950890,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Marc] Yes."
    } ]
  }, {
    "tStartMs": 2951723,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "Had a customer fab, it will be\nlooking like a big white box."
    } ]
  }, {
    "tStartMs": 2957280,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I like it better like this."
    } ]
  }, {
    "tStartMs": 2958420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Casper] Yeah, me too."
    } ]
  }, {
    "tStartMs": 2960970,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It's funny, you need such a big machine,"
    } ]
  }, {
    "tStartMs": 2963520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so much infrastructure"
    } ]
  }, {
    "tStartMs": 2965740,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "to make the tiniest things\nwe can make at scale."
    } ]
  }, {
    "tStartMs": 2969640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- It's inversely proportional."
    } ]
  }, {
    "tStartMs": 2971140,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Yeah, smaller you want to go,"
    } ]
  }, {
    "tStartMs": 2972790,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the larger everything around it becomes."
    } ]
  }, {
    "tStartMs": 2975700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "After the machines are\nassembled, tested and approved,"
    } ]
  }, {
    "tStartMs": 2978160,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "they are disassembled to\nship all around the world."
    } ]
  }, {
    "tStartMs": 2981083,
    "dDurationMs": 3197,
    "segs": [ {
      "utf8": "5,000 companies supply 100,000 parts,"
    } ]
  }, {
    "tStartMs": 2984280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "3000 cables, 40,000 bolts"
    } ]
  }, {
    "tStartMs": 2986710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and two kilometers of hosing."
    } ]
  }, {
    "tStartMs": 2988990,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "ASML ships their high NA\nmachine in 250 containers"
    } ]
  }, {
    "tStartMs": 2992020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "spread out over 25 trucks"
    } ]
  }, {
    "tStartMs": 2993760,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "and seven Boeing 747s."
    } ]
  }, {
    "tStartMs": 2997540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Despite all the doubt and setback,"
    } ]
  }, {
    "tStartMs": 2999400,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "EUV finally made it to manufacturing level"
    } ]
  }, {
    "tStartMs": 3001890,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "three decades after\nKinoshita's first images."
    } ]
  }, {
    "tStartMs": 3005070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But even when almost the\nentire world didn't believe"
    } ]
  }, {
    "tStartMs": 3007830,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "it would work,"
    } ]
  }, {
    "tStartMs": 3008790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "there were some people at ASML who knew"
    } ]
  }, {
    "tStartMs": 3011400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that it was going to work\nall the way back in 2010."
    } ]
  }, {
    "tStartMs": 3014760,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "- Around 2001, we said let's do EUV."
    } ]
  }, {
    "tStartMs": 3018900,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And then we run into many challenges."
    } ]
  }, {
    "tStartMs": 3021180,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "2010, we installed the\nfirst system at a customer."
    } ]
  }, {
    "tStartMs": 3024000,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So it was installed in Korea."
    } ]
  }, {
    "tStartMs": 3025710,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "There it was, this thing\nI had been pursuing"
    } ]
  }, {
    "tStartMs": 3028680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "for, you know, 13 years was"
    } ]
  }, {
    "tStartMs": 3030690,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "now standing at a\ncustomer, producing wafers."
    } ]
  }, {
    "tStartMs": 3034380,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This for me was a moment I realized,"
    } ]
  }, {
    "tStartMs": 3037140,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "yes, we made the right bet."
    } ]
  }, {
    "tStartMs": 3039330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Casper] Years later, Jos ran into"
    } ]
  }, {
    "tStartMs": 3040800,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the man who helped\ninstall the first machine."
    } ]
  }, {
    "tStartMs": 3043410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- He's now a professor\nat a renowned institute."
    } ]
  }, {
    "tStartMs": 3045900,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And I shared the story about my relief"
    } ]
  }, {
    "tStartMs": 3048210,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "and how great we made the decision."
    } ]
  }, {
    "tStartMs": 3050719,
    "dDurationMs": 1091,
    "segs": [ {
      "utf8": "(indistinct) said, \"Yeah, yeah, yeah.\""
    } ]
  }, {
    "tStartMs": 3051810,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "He said, \"When you left and\nyou flew out after Christmas,"
    } ]
  }, {
    "tStartMs": 3054630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the thing broke down and it took"
    } ]
  }, {
    "tStartMs": 3057180,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "two months to get back up again."
    } ]
  }, {
    "tStartMs": 3058950,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And they almost fired me"
    } ]
  }, {
    "tStartMs": 3060240,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "for making the wrong decision.\""
    } ]
  }, {
    "tStartMs": 3062100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We had some ups and downs along the way."
    } ]
  }, {
    "tStartMs": 3064500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 3065333,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "- But again, once I saw\nthe system installed"
    } ]
  }, {
    "tStartMs": 3067530,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "at a customer, in a customer fab,"
    } ]
  }, {
    "tStartMs": 3070050,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I knew we had done the right thing."
    } ]
  }, {
    "tStartMs": 3071790,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "This was 2010."
    } ]
  }, {
    "tStartMs": 3072720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The first phone that came out was 2019."
    } ]
  }, {
    "tStartMs": 3074820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So we still had some hurdles to resolve."
    } ]
  }, {
    "tStartMs": 3077160,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] Right."
    } ]
  }, {
    "tStartMs": 3077993,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- But we kept going."
    } ]
  }, {
    "tStartMs": 3082590,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Now, I have spent several months"
    } ]
  }, {
    "tStartMs": 3084330,
    "dDurationMs": 2839,
    "segs": [ {
      "utf8": "working on this video\nand thinking about it"
    } ]
  }, {
    "tStartMs": 3087169,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "and it still feels absolutely impossible."
    } ]
  }, {
    "tStartMs": 3090120,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And the more I think about it,"
    } ]
  }, {
    "tStartMs": 3092220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the more I think, you know,\nthose people 40 years ago"
    } ]
  }, {
    "tStartMs": 3095250,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that said it was impossible,\nthey had a point."
    } ]
  }, {
    "tStartMs": 3098130,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "It's completely unreasonable to think"
    } ]
  }, {
    "tStartMs": 3100740,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that you could make this\nartificial sun in a lab,"
    } ]
  }, {
    "tStartMs": 3103050,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "that you could make these mirrors"
    } ]
  }, {
    "tStartMs": 3104310,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that are this smooth"
    } ]
  }, {
    "tStartMs": 3105330,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and that you could get the\nrequired overlay accuracy."
    } ]
  }, {
    "tStartMs": 3109620,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The reasonable thing is to think"
    } ]
  }, {
    "tStartMs": 3110940,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that none of that is possible"
    } ]
  }, {
    "tStartMs": 3112350,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and to point out all the\nproblems with each of them."
    } ]
  }, {
    "tStartMs": 3115290,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Which reminds me of this quote,"
    } ]
  }, {
    "tStartMs": 3117570,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the reasonable man adapts\nhimself to the world."
    } ]
  }, {
    "tStartMs": 3120420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The unreasonable one persists"
    } ]
  }, {
    "tStartMs": 3122580,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "in trying to adapt the world to himself."
    } ]
  }, {
    "tStartMs": 3125340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Therefore, all progress depends"
    } ]
  }, {
    "tStartMs": 3127860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "on the unreasonable man."
    } ]
  }, {
    "tStartMs": 3129450,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Imagine if Andy and\nKinoshita and all the others"
    } ]
  }, {
    "tStartMs": 3132810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "had been reasonable,"
    } ]
  }, {
    "tStartMs": 3134400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "we would have none of this."
    } ]
  }, {
    "tStartMs": 3136470,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "In fact, imagine what\nthe world would be like"
    } ]
  }, {
    "tStartMs": 3138510,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "if everyone on it was reasonable."
    } ]
  }, {
    "tStartMs": 3141180,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It would probably be extremely boring."
    } ]
  }, {
    "tStartMs": 3143220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Probably most of the technology,"
    } ]
  }, {
    "tStartMs": 3144750,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "most of the things you\nenjoy on a daily basis"
    } ]
  }, {
    "tStartMs": 3147360,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "wouldn't be here."
    } ]
  }, {
    "tStartMs": 3148650,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "In fact, you probably wouldn't be"
    } ]
  }, {
    "tStartMs": 3150000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "watching this video,"
    } ]
  }, {
    "tStartMs": 3151200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because just about all\nthe technology we have"
    } ]
  }, {
    "tStartMs": 3153120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "nowadays would seem\ncompletely unreasonable"
    } ]
  }, {
    "tStartMs": 3156600,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "even just 200 years ago."
    } ]
  }, {
    "tStartMs": 3159030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And so I really think\nthat to a large extent,"
    } ]
  }, {
    "tStartMs": 3162060,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "we owe our lives to those\nunreasonable people."
    } ]
  }, {
    "tStartMs": 3165090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And maybe at least to me,"
    } ]
  }, {
    "tStartMs": 3166890,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "it's a reminder that it's good\nto be a little unreasonable,"
    } ]
  }, {
    "tStartMs": 3170220,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "at least in some of the big parts of life."
    } ]
  }, {
    "tStartMs": 3177210,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Changing the world is difficult."
    } ]
  }, {
    "tStartMs": 3178710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It took overcoming thousands of obstacles"
    } ]
  }, {
    "tStartMs": 3180660,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and over 30 years to get EUV to work."
    } ]
  }, {
    "tStartMs": 3183060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But big breakthroughs usually\nstart in the same way."
    } ]
  }, {
    "tStartMs": 3186000,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "That is, you learn, you\nexplore some related ideas,"
    } ]
  }, {
    "tStartMs": 3189570,
    "dDurationMs": 2254,
    "segs": [ {
      "utf8": "you try to apply them in some new ways,"
    } ]
  }, {
    "tStartMs": 3191824,
    "dDurationMs": 1406,
    "segs": [ {
      "utf8": "and then you build skills to take on"
    } ]
  }, {
    "tStartMs": 3193230,
