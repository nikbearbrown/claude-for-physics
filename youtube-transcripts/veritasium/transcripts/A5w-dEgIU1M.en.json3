{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 467,
    "dDurationMs": 3577,
    "segs": [ {
      "utf8": "The key thing missing was a\nway to make a ton of money."
    } ]
  }, {
    "tStartMs": 5754,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "In the 1950s,"
    } ]
  }, {
    "tStartMs": 6924,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "a young physics graduate, Ed\nThorpe,"
    } ]
  }, {
    "tStartMs": 8874,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "was doing his PhD in Los Angeles,"
    } ]
  }, {
    "tStartMs": 10899,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "but a few hours drive away,"
    } ]
  }, {
    "tStartMs": 12357,
    "dDurationMs": 1808,
    "segs": [ {
      "utf8": "Las Vegas was quickly becoming"
    } ]
  }, {
    "tStartMs": 14165,
    "dDurationMs": 1691,
    "segs": [ {
      "utf8": "the gambling capital of the world,"
    } ]
  }, {
    "tStartMs": 15856,
    "dDurationMs": 2978,
    "segs": [ {
      "utf8": "and Thorpe saw a way to make a fortune."
    } ]
  }, {
    "tStartMs": 18834,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "He headed to Vegas and sat\ndown at the blackjack table,"
    } ]
  }, {
    "tStartMs": 21744,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "back then, the dealer only\nused a single deck of cards,"
    } ]
  }, {
    "tStartMs": 24234,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "so Thorpe could keep a\nmental note of all the cards"
    } ]
  }, {
    "tStartMs": 27084,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that had been played as he saw them."
    } ]
  }, {
    "tStartMs": 29424,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "This allowed him to work out"
    } ]
  }, {
    "tStartMs": 30594,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "if he had an advantage."
    } ]
  }, {
    "tStartMs": 32352,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "He would bet a bigger portion of his funds"
    } ]
  }, {
    "tStartMs": 34418,
    "dDurationMs": 1546,
    "segs": [ {
      "utf8": "when the odds were in his favor"
    } ]
  }, {
    "tStartMs": 35964,
    "dDurationMs": 2058,
    "segs": [ {
      "utf8": "and less when they weren't."
    } ]
  }, {
    "tStartMs": 38022,
    "dDurationMs": 2832,
    "segs": [ {
      "utf8": "He had invented card counting."
    } ]
  }, {
    "tStartMs": 40854,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "This is a remarkable innovation,"
    } ]
  }, {
    "tStartMs": 43020,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "considering blackjack had been around"
    } ]
  }, {
    "tStartMs": 44521,
    "dDurationMs": 2908,
    "segs": [ {
      "utf8": "in various forms for hundreds of years,"
    } ]
  }, {
    "tStartMs": 47429,
    "dDurationMs": 3355,
    "segs": [ {
      "utf8": "and for a while this\nmade him a lot of money."
    } ]
  }, {
    "tStartMs": 50784,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But the casinos got wise to his strategy"
    } ]
  }, {
    "tStartMs": 53034,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and they added more decks\nof cards to the game"
    } ]
  }, {
    "tStartMs": 55194,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to reduce the benefit of card counting."
    } ]
  }, {
    "tStartMs": 57684,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So Thorpe took his winnings to"
    } ]
  }, {
    "tStartMs": 59454,
    "dDurationMs": 3569,
    "segs": [ {
      "utf8": "what he called the\nbiggest casino on Earth:"
    } ]
  }, {
    "tStartMs": 63023,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "the stock market."
    } ]
  }, {
    "tStartMs": 65724,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "He started a hedge fund that would go on"
    } ]
  }, {
    "tStartMs": 67584,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "to make a 20% return every year"
    } ]
  }, {
    "tStartMs": 69719,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "for 20 years,"
    } ]
  }, {
    "tStartMs": 71094,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "the best performance\never seen at that time."
    } ]
  }, {
    "tStartMs": 73744,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "And he did it by transferring\nthe skills he honed"
    } ]
  }, {
    "tStartMs": 75851,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "at the blackjack table\nto the stock market."
    } ]
  }, {
    "tStartMs": 78354,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Thorpe pioneered a type of hedging,"
    } ]
  }, {
    "tStartMs": 80474,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "a way to protect against\nlosses with balancing"
    } ]
  }, {
    "tStartMs": 83094,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "or compensating transactions."
    } ]
  }, {
    "tStartMs": 85194,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Thorpe did it mathematically."
    } ]
  }, {
    "tStartMs": 86844,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "He looked at the odds\nof winning and losing"
    } ]
  }, {
    "tStartMs": 89364,
    "dDurationMs": 3455,
    "segs": [ {
      "utf8": "and decided that under certain\nconditions you can actually"
    } ]
  }, {
    "tStartMs": 92819,
    "dDurationMs": 3775,
    "segs": [ {
      "utf8": "tilt the odds in your favor\nby using certain patterns"
    } ]
  }, {
    "tStartMs": 96594,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "to be able to make bets."
    } ]
  }, {
    "tStartMs": 99114,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- Suppose Bob sells Alice\na call option on a stock,"
    } ]
  }, {
    "tStartMs": 102324,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and let's say the stock has gone up,"
    } ]
  }, {
    "tStartMs": 103824,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "so now it's in the money for Alice."
    } ]
  }, {
    "tStartMs": 106674,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Well now for every additional\n$1, the stock price goes up,"
    } ]
  }, {
    "tStartMs": 110034,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "Bob will lose $1,"
    } ]
  }, {
    "tStartMs": 112744,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "but he can eliminate this risk\nby owning one unit of stock."
    } ]
  }, {
    "tStartMs": 117124,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Then if the price goes up, he\nwould lose $1 from the option"
    } ]
  }, {
    "tStartMs": 120364,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but gain that dollar back from the stock."
    } ]
  }, {
    "tStartMs": 123034,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And if the stock drops back\noutta the money for Alice,"
    } ]
  }, {
    "tStartMs": 125554,
    "dDurationMs": 1158,
    "segs": [ {
      "utf8": "he sells the stock"
    } ]
  }, {
    "tStartMs": 126712,
    "dDurationMs": 3222,
    "segs": [ {
      "utf8": "so he doesn't risk losing\nany money from that either."
    } ]
  }, {
    "tStartMs": 129934,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This is called dynamic hedging."
    } ]
  }, {
    "tStartMs": 132154,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It means Bob can make a profit"
    } ]
  }, {
    "tStartMs": 133834,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "with minimal risk from\nfluctuating stock prices."
    } ]
  }, {
    "tStartMs": 137044,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "A hedge portfolio pi at any one time"
    } ]
  }, {
    "tStartMs": 139660,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "will offset the option V"
    } ]
  }, {
    "tStartMs": 141493,
    "dDurationMs": 2571,
    "segs": [ {
      "utf8": "with some amount of stock delta."
    } ]
  }, {
    "tStartMs": 144064,
    "dDurationMs": 3275,
    "segs": [ {
      "utf8": "- It basically means I\ncan sell you something"
    } ]
  }, {
    "tStartMs": 147339,
    "dDurationMs": 3655,
    "segs": [ {
      "utf8": "without having to take the\nopposite side of the trade."
    } ]
  }, {
    "tStartMs": 150994,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "And the way to think about it is"
    } ]
  }, {
    "tStartMs": 152917,
    "dDurationMs": 2492,
    "segs": [ {
      "utf8": "I have synthetically manufactured"
    } ]
  }, {
    "tStartMs": 155409,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "an option for you."
    } ]
  }, {
    "tStartMs": 158284,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I've created it out of nothing"
    } ]
  }, {
    "tStartMs": 160264,
    "dDurationMs": 4393,
    "segs": [ {
      "utf8": "by doing dynamic trading. Dynamic hedging."
    } ]
  }, {
    "tStartMs": 164657,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "- As we saw with Bob's\nexample delta,"
    } ]
  }, {
    "tStartMs": 166790,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": "the amount of stock he has to hold,"
    } ]
  }, {
    "tStartMs": 168398,
    "dDurationMs": 2546,
    "segs": [ {
      "utf8": "changes depending on current prices."
    } ]
  }, {
    "tStartMs": 170944,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Mathematically, it represents"
    } ]
  }, {
    "tStartMs": 172444,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "how much the current option price changes"
    } ]
  }, {
    "tStartMs": 174544,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with a change in the stock price."
    } ]
  }, {
    "tStartMs": 176944,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "But Thorpe wasn't satisfied\nwith Bachelier's model"
    } ]
  }, {
    "tStartMs": 179469,
    "dDurationMs": 1105,
    "segs": [ {
      "utf8": "for pricing options."
    } ]
  }, {
    "tStartMs": 180574,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "I mean, for one thing, stock\nprices aren't entirely random."
    } ]
  }, {
    "tStartMs": 184084,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "They can increase over time\nif the business is doing well"
    } ]
  }, {
    "tStartMs": 186844,
    "dDurationMs": 1691,
    "segs": [ {
      "utf8": "or fall if it isn't."
    } ]
  }, {
    "tStartMs": 188535,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "Bachelier's model ignored this."
    } ]
  }, {
    "tStartMs": 190734,
    "dDurationMs": 2115,
    "segs": [ {
      "utf8": "So Thorpe came up with\na more accurate model"
    } ]
  }, {
    "tStartMs": 192849,
    "dDurationMs": 3655,
    "segs": [ {
      "utf8": "for pricing options, which\ntook this drift into account."
    } ]
  }, {
    "tStartMs": 196504,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- I actually figured out"
    } ]
  }, {
    "tStartMs": 199264,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "what this model was back in"
    } ]
  }, {
    "tStartMs": 201964,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the middle of 1967,"
    } ]
  }, {
    "tStartMs": 204844,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and I decided that I would\njust use it for myself"
    } ]
  }, {
    "tStartMs": 208864,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and then later I kept it\nquiet for my own investors."
    } ]
  }, {
    "tStartMs": 212764,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "The idea was to basically make a lot"
    } ]
  }, {
    "tStartMs": 214599,
    "dDurationMs": 1555,
    "segs": [ {
      "utf8": "of money out of it for everybody."
    } ]
  }, {
    "tStartMs": 216154,
    "dDurationMs": 2432,
    "segs": [ {
      "utf8": "- His strategy was if the\noption was going cheap,"
    } ]
  }, {
    "tStartMs": 218586,
    "dDurationMs": 2098,
    "segs": [ {
      "utf8": "according to his model, buy it."
    } ]
  }, {
    "tStartMs": 220684,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "If it was overvalued, short sell it,"
    } ]
  }, {
    "tStartMs": 222817,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "that is bet against it."
    } ]
  }, {
    "tStartMs": 224250,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "And that way, more often than not,"
    } ]
  }, {
    "tStartMs": 226084,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "he would end up on the\nwinning side of the trade."
    } ]
  }, {
    "tStartMs": 229684,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This lasted until 1973."
    } ]
  }, {
    "tStartMs": 232924,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "In that year, Fischer Black"
    } ]
  }, {
    "tStartMs": 234724,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and Myron Scholes came up with an equation"
    } ]
  }, {
    "tStartMs": 236584,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that changed the industry."
    } ]
  }, {
    "tStartMs": 238414,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Robert Merton independently\npublished his own version,"
    } ]
  }, {
    "tStartMs": 241144,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "which was based on the mathematics\nof stochastic calculus,"
    } ]
  }, {
    "tStartMs": 244114,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so he is also credited."
    } ]
  }, {
    "tStartMs": 246334,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- I thought I'd have the field to myself,"
    } ]
  }, {
    "tStartMs": 248374,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but unfortunately, Fischer Black"
    } ]
  }, {
    "tStartMs": 250564,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and Myron Scholes published the idea"
    } ]
  }, {
    "tStartMs": 253864,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and they did a better job\nof the model than I did"
    } ]
  }, {
    "tStartMs": 256564,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "because they had very tight mathematics"
    } ]
  }, {
    "tStartMs": 259054,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "behind their derivation"
    } ]
  }, {
    "tStartMs": 260824,
    "dDurationMs": 1058,
    "segs": [ {
      "utf8": "- Like Bachelier,"
    } ]
  }, {
    "tStartMs": 261882,
    "dDurationMs": 2392,
    "segs": [ {
      "utf8": "they thought that option\nprices should offer a fair bet"
    } ]
  }, {
    "tStartMs": 264274,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to both buyers and sellers,"
    } ]
  }, {
    "tStartMs": 266164,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but their approach was totally new."
    } ]
  }, {
    "tStartMs": 268834,
    "dDurationMs": 1505,
    "segs": [ {
      "utf8": "They said if it was possible"
    } ]
  }, {
    "tStartMs": 270339,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "to construct a risk-free\nportfolio of options"
    } ]
  }, {
    "tStartMs": 272884,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and stocks just like Thorpe was doing"
    } ]
  }, {
    "tStartMs": 274384,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "with his delta hedging,\nthen in an efficient market,"
    } ]
  }, {
    "tStartMs": 277564,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "a fair market, this portfolio\nshould return nothing more"
    } ]
  }, {
    "tStartMs": 281254,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "than the risk-free rate,"
    } ]
  }, {
    "tStartMs": 282844,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "what the same money would earn if invested"
    } ]
  }, {
    "tStartMs": 284596,
    "dDurationMs": 3168,
    "segs": [ {
      "utf8": "in the safest asset, US treasury bonds."
    } ]
  }, {
    "tStartMs": 287764,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "The assumption was that\nif you're not taking on"
    } ]
  }, {
    "tStartMs": 289711,
    "dDurationMs": 2413,
    "segs": [ {
      "utf8": "any additional risk, then\nit shouldn't be possible"
    } ]
  }, {
    "tStartMs": 292124,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to receive any extra returns."
    } ]
  }, {
    "tStartMs": 295394,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "To describe how stock\nprices change over time,"
    } ]
  }, {
    "tStartMs": 297974,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Black, Scholes, and Merton\nused an improved version"
    } ]
  }, {
    "tStartMs": 301244,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "of Bachelier's model just like Thorpe."
    } ]
  }, {
    "tStartMs": 303224,
    "dDurationMs": 2675,
    "segs": [ {
      "utf8": "This says that at any time\nwe expect the stock price"
    } ]
  }, {
    "tStartMs": 305899,
    "dDurationMs": 1349,
    "segs": [ {
      "utf8": "to move randomly,"
    } ]
  }, {
    "tStartMs": 307248,
    "dDurationMs": 4174,
    "segs": [ {
      "utf8": "plus a general trend\nup or down, the drift."
    } ]
  }, {
    "tStartMs": 311422,
    "dDurationMs": 2992,
    "segs": [ {
      "utf8": "By combining these two equations,\nBlack, Scholes, and Merton"
    } ]
  }, {
    "tStartMs": 314414,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "came up with the most\nfamous equation in finance."
    } ]
  }, {
    "tStartMs": 318194,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It relates the price of any\nkind of contract to any asset,"
    } ]
  }, {
    "tStartMs": 321794,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "stocks, bonds, you name it."
    } ]
  }, {
    "tStartMs": 323774,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The same year they\npublished this equation,"
    } ]
  }, {
    "tStartMs": 325574,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the Chicago Board Options\nExchange was founded."
    } ]
  }, {
    "tStartMs": 329414,
    "dDurationMs": 3008,
    "segs": [ {
      "utf8": "Why is that equation so important?"
    } ]
  }, {
    "tStartMs": 332422,
    "dDurationMs": 2572,
    "segs": [ {
      "utf8": "Like for finance, how\ndid that change the game?"
    } ]
  }, {
    "tStartMs": 334994,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Well, because when you solve"
    } ]
  }, {
    "tStartMs": 336704,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that partial differential equation,"
    } ]
  }, {
    "tStartMs": 338504,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "you get an explicit formula\nof the price of the option"
    } ]
  }, {
    "tStartMs": 341744,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "as a function of a bunch\nof these input parameters."
    } ]
  }, {
    "tStartMs": 344864,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And for the very first time,"
    } ]
  }, {
    "tStartMs": 346544,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you now have an explicit expression"
    } ]
  }, {
    "tStartMs": 348464,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "where you plug in the parameters"
    } ]
  }, {
    "tStartMs": 350684,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "and out pops this number"
    } ]
  }, {
    "tStartMs": 352517,
    "dDurationMs": 2817,
    "segs": [ {
      "utf8": "so that people can actually\nuse it to trade on."
    } ]
  }, {
    "tStartMs": 355334,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- This led to one of the\nfastest adoptions by industry"
    } ]
  }, {
    "tStartMs": 357974,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "of an academic idea in all\nof the social sciences."
    } ]
  }, {
    "tStartMs": 361394,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Within just a couple of years,"
    } ]
  }, {
    "tStartMs": 363614,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "the Black Scholes formula was\nadopted as the benchmark"
    } ]
  }, {
    "tStartMs": 367844,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "for Wall Street for trading options."
    } ]
  }, {
    "tStartMs": 370124,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "The exchange traded\noptions market has exploded"
    } ]
  }, {
    "tStartMs": 373814,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and it's now a multi-trillion\ndollar industry,"
    } ]
  }, {
    "tStartMs": 377084,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the volume in this\nmarket has been doubling"
    } ]
  }, {
    "tStartMs": 380174,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "roughly every five years."
    } ]
  }, {
    "tStartMs": 381584,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So this is the financial\nequivalent of Moore's Law."
    } ]
  }, {
    "tStartMs": 384134,
    "dDurationMs": 1475,
    "segs": [ {
      "utf8": "There are other businesses"
    } ]
  }, {
    "tStartMs": 385609,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "that have grown just as quickly,"
    } ]
  }, {
    "tStartMs": 388342,
    "dDurationMs": 2452,
    "segs": [ {
      "utf8": "like credit default swaps market,"
    } ]
  }, {
    "tStartMs": 390794,
    "dDurationMs": 2116,
    "segs": [ {
      "utf8": "the OTC derivatives market,"
    } ]
  }, {
    "tStartMs": 392910,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "the securitized debt market."
    } ]
  }, {
    "tStartMs": 394668,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "All of these are multi-trillion\ndollar industries"
    } ]
  }, {
    "tStartMs": 397754,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "that in one form"
    } ]
  }, {
    "tStartMs": 398804,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "or another make use of the idea"
    } ]
  }, {
    "tStartMs": 401294,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of Black Scholes Merton option pricing."
    } ]
  }, {
    "tStartMs": 404414,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- This opened up a whole new\nway to hedge against anything,"
    } ]
  }, {
    "tStartMs": 408284,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and not just for hedge funds."
    } ]
  }, {
    "tStartMs": 410354,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Nowadays, pretty much every\nlarge company, governments,"
    } ]
  }, {
    "tStartMs": 413114,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and even individual investors use options"
    } ]
  }, {
    "tStartMs": 415844,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to hedge against their own specific risks."
    } ]
  }, {
    "tStartMs": 418964,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Suppose you're running an airline"
    } ]
  }, {
    "tStartMs": 420674,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and you're worried that an\nincrease in oil prices"
    } ]
  }, {
    "tStartMs": 422954,
    "dDurationMs": 1875,
    "segs": [ {
      "utf8": "would eat into your profits."
    } ]
  }, {
    "tStartMs": 424829,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Well, using the Black\nScholes Merton equation,"
    } ]
  }, {
    "tStartMs": 427129,
    "dDurationMs": 1255,
    "segs": [ {
      "utf8": "there's a way to accurately"
    } ]
  }, {
    "tStartMs": 428384,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and efficiently hedge that risk."
    } ]
  }, {
    "tStartMs": 430544,
    "dDurationMs": 1992,
    "segs": [ {
      "utf8": "You price an option to\nbuy something that tracks"
    } ]
  }, {
    "tStartMs": 432536,
    "dDurationMs": 2749,
    "segs": [ {
      "utf8": "the price of oil, and\nthat option will pay off"
    } ]
  }, {
    "tStartMs": 435285,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "if oil prices go up,"
    } ]
  }, {
    "tStartMs": 437468,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "and that will help compensate\nyou for the higher cost"
    } ]
  }, {
    "tStartMs": 439634,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of fuel you have to pay."
    } ]
  }, {
    "tStartMs": 441524,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So Black Scholes Merton\ncan help reduce risk,"
    } ]
  }, {
    "tStartMs": 444314,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but it can also provide leverage."
    } ]
  }, {
    "tStartMs": 446624,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- An ongoing battle\nbetween bullish day traders"
    } ]
  }, {
    "tStartMs": 450044,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and hedge fund short sellers"
    } ]
  }, {
    "tStartMs": 451784,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "that have bet against the stock,"
    } ]
  }, {
    "tStartMs": 453911,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "GameStop shares, have now risen some 700%."
    } ]
  }, {
    "tStartMs": 458114,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Well, GameStop is a\nreally interesting example"
    } ]
  }, {
    "tStartMs": 460394,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "for all sorts of reasons,"
    } ]
  }, {
    "tStartMs": 461564,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "but options figured\nprominently in that example"
    } ]
  }, {
    "tStartMs": 464174,
    "dDurationMs": 2383,
    "segs": [ {
      "utf8": "because a small cadre of users"
    } ]
  }, {
    "tStartMs": 466557,
    "dDurationMs": 3057,
    "segs": [ {
      "utf8": "on this Reddit sub-channel\nr/wallstreetbets"
    } ]
  }, {
    "tStartMs": 469614,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "decided that the hedge fund managers"
    } ]
  }, {
    "tStartMs": 471864,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "that were shorting the stock"
    } ]
  }, {
    "tStartMs": 473364,
    "dDurationMs": 2683,
    "segs": [ {
      "utf8": "and betting that the company\nwould go out of business"
    } ]
  }, {
    "tStartMs": 476047,
    "dDurationMs": 1727,
    "segs": [ {
      "utf8": "needed to be punished."
    } ]
  }, {
    "tStartMs": 477774,
    "dDurationMs": 3708,
    "segs": [ {
      "utf8": "And so they bought\nshares of GameStop stock"
    } ]
  }, {
    "tStartMs": 481482,
    "dDurationMs": 1692,
    "segs": [ {
      "utf8": "to try to drive up price."
    } ]
  }, {
    "tStartMs": 483174,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Turns out that buying\nthe stock was not enough,"
    } ]
  }, {
    "tStartMs": 485784,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "because with a dollar's worth of cash,"
    } ]
  }, {
    "tStartMs": 488454,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "you can buy a dollar's worth of stock,"
    } ]
  }, {
    "tStartMs": 490284,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "but with a dollar's worth\nof cash, you can buy options"
    } ]
  }, {
    "tStartMs": 494244,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that affected many more than\na dollar's worth of stock,"
    } ]
  }, {
    "tStartMs": 497574,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "perhaps in some cases $10"
    } ]
  }, {
    "tStartMs": 499599,
    "dDurationMs": 3285,
    "segs": [ {
      "utf8": "or $20 worth of stock for a\ndollar's worth of options."
    } ]
  }, {
    "tStartMs": 502884,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And so there's natural leverage embedded"
    } ]
  }, {
    "tStartMs": 505644,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "in these securities."
    } ]
  }, {
    "tStartMs": 507174,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "And so the combination\nof buying both the stock"
    } ]
  }, {
    "tStartMs": 510804,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and the options caused the\nprices to rise very quickly."
    } ]
  }, {
    "tStartMs": 514374,
    "dDurationMs": 2885,
    "segs": [ {
      "utf8": "And what that did was to cause\nthese hedge fund managers"
    } ]
  }, {
    "tStartMs": 517259,
    "dDurationMs": 2485,
    "segs": [ {
      "utf8": "to lose a lot of money quickly."
    } ]
  }, {
    "tStartMs": 519744,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- How big is this market for derivatives?"
    } ]
  }, {
    "tStartMs": 521934,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "How big is this whole area that kind of"
    } ]
  }, {
    "tStartMs": 524634,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "comes out of Black Scholes Merton?"
    } ]
  }, {
    "tStartMs": 527304,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "- There are estimates of how\nlarge derivatives markets are,"
    } ]
  }, {
    "tStartMs": 531324,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and first, let's be clear\nwhat a derivative is."
    } ]
  }, {
    "tStartMs": 533604,
    "dDurationMs": 4565,
    "segs": [ {
      "utf8": "A derivative is a financial\nsecurity whose value derived"
    } ]
  }, {
    "tStartMs": 538169,
    "dDurationMs": 2485,
    "segs": [ {
      "utf8": "from another financial security."
    } ]
  }, {
    "tStartMs": 540654,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So an option is an\nexample of a derivative."
    } ]
  }, {
    "tStartMs": 543354,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "In general, the size of\nderivative markets globally"
    } ]
  }, {
    "tStartMs": 546737,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "is the on the order"
    } ]
  }, {
    "tStartMs": 548394,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of several hundred trillion dollars."
    } ]
  }, {
    "tStartMs": 550884,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- How does that compare to the size"
    } ]
  }, {
    "tStartMs": 553014,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of the underlying\nsecurities they're based on?"
    } ]
  }, {
    "tStartMs": 555654,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- It's multiples of the\nunderlying securities."
    } ]
  }, {
    "tStartMs": 559374,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "- I just have to interrupt\nbecause it seems kind of crazy"
    } ]
  }, {
    "tStartMs": 563124,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that you have more money\nriding on the things"
    } ]
  }, {
    "tStartMs": 565764,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "that are based on the thing\nthan the thing itself."
    } ]
  }, {
    "tStartMs": 569244,
    "dDurationMs": 1358,
    "segs": [ {
      "utf8": "- That's right."
    } ]
  }, {
    "tStartMs": 570602,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "- So tell me how that makes any sense."
    } ]
  }, {
    "tStartMs": 572952,
    "dDurationMs": 3252,
    "segs": [ {
      "utf8": "- Because what options allow you to do is"
    } ]
  }, {
    "tStartMs": 576204,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to take the underlying thing"
    } ]
  }, {
    "tStartMs": 578484,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and turn it into 5, 10, 20, 50 things."
    } ]
  }, {
    "tStartMs": 581964,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "So these pieces of paper"
    } ]
  }, {
    "tStartMs": 583297,
    "dDurationMs": 2216,
    "segs": [ {
      "utf8": "that we call options and derivatives,"
    } ]
  }, {
    "tStartMs": 585513,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "they basically allow us to create many,"
    } ]
  }, {
    "tStartMs": 588054,
    "dDurationMs": 3352,
    "segs": [ {
      "utf8": "many different versions of\nthe underlying asset,"
    } ]
  }, {
    "tStartMs": 591406,
    "dDurationMs": 4178,
    "segs": [ {
      "utf8": "versions that individuals\nfind more palatable"
    } ]
  }, {
    "tStartMs": 595584,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "because of their own\nrisk reward preferences."
    } ]
  }, {
    "tStartMs": 599154,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- Does this make the markets"
    } ]
  }, {
    "tStartMs": 601524,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and the global economy more stable,"
    } ]
  }, {
    "tStartMs": 604614,
    "dDurationMs": 2447,
    "segs": [ {
      "utf8": "or less stable, or no effect?"
    } ]
  }, {
    "tStartMs": 607974,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "- All three. So it turns out\nthat during normal times,"
    } ]
  }, {
    "tStartMs": 613464,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "these markets are a very\nsignificant source of liquidity"
    } ]
  }, {
    "tStartMs": 617604,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "and therefore stability."
    } ]
  }, {
    "tStartMs": 619070,
    "dDurationMs": 2716,
    "segs": [ {
      "utf8": "During abnormal times,"
    } ]
  }, {
    "tStartMs": 621786,
    "dDurationMs": 3906,
    "segs": [ {
      "utf8": "by that I mean when there are\nperiods of market stress,"
    } ]
  }, {
    "tStartMs": 625692,
    "dDurationMs": 3742,
    "segs": [ {
      "utf8": "all of these securities\ncan go in one direction,"
    } ]
  }, {
    "tStartMs": 629434,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "typically down,"
    } ]
  }, {
    "tStartMs": 631200,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "and when they go down together,"
    } ]
  }, {
    "tStartMs": 632994,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "that creates a really big market crash."
    } ]
  }, {
    "tStartMs": 636804,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So in those circumstances,"
    } ]
  }, {
    "tStartMs": 639054,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "derivatives markets can\nexacerbate these kinds"
    } ]
  }, {
    "tStartMs": 642504,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "of market dislocations."
    } ]
  }, {
    "tStartMs": 645634,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- In 1997, Merton"
    } ]
  }, {
    "tStartMs": 646984,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and Scholes were awarded the\nNobel Prize in economics."
    } ]
  }, {
    "tStartMs": 649954,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Black was acknowledged\nfor his contributions,"
    } ]
  }, {
    "tStartMs": 651784,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "but unfortunately he had passed away"
    } ]
  }, {
    "tStartMs": 653534,
    "dDurationMs": 1775,
    "segs": [ {
      "utf8": "just two years earlier."
    } ]
  }, {
    "tStartMs": 655309,
    "dDurationMs": 1625,
    "segs": [ {
      "utf8": "- We were gonna make a\nlot of money in options,"
    } ]
  }, {
    "tStartMs": 656934,
    "dDurationMs": 2325,
    "segs": [ {
      "utf8": "but now Black and Shoals\nhave told everybody"
    } ]
  }, {
    "tStartMs": 659259,
    "dDurationMs": 2365,
    "segs": [ {
      "utf8": "what the secret is."
    } ]
  }, {
    "tStartMs": 661624,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "- With the option pricing formula now out"
    } ]
  }, {
    "tStartMs": 663474,
    "dDurationMs": 1125,
    "segs": [ {
      "utf8": "for everyone to see"
    } ]
  }, {
    "tStartMs": 664599,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "hedge funds would need\nto discover better ways"
    } ]
  }, {
    "tStartMs": 667119,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "to find market inefficiencies."
    } ]
  }, {
    "tStartMs": 669454,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Enter Jim Simons."
    } ]
  }, {
    "tStartMs": 672094,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Before Simons had any\nexposure to the stock market,"
    } ]
  }, {
    "tStartMs": 674794,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "he was a mathematician."
    } ]
  }, {
    "tStartMs": 676474,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "His work on Riemann geometry\nwas instrumental in many areas"
    } ]
  }, {
    "tStartMs": 679774,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of mathematics and physics,\nincluding knot theory,"
    } ]
  }, {
    "tStartMs": 682264,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "quantum field theory, and\nquantum computing"
    } ]
  }, {
    "tStartMs": 685684,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Chern Simon's theory laid the\nmathematical foundation"
    } ]
  }, {
    "tStartMs": 687964,
    "dDurationMs": 1558,
    "segs": [ {
      "utf8": "for string theory."
    } ]
  }, {
    "tStartMs": 689522,
    "dDurationMs": 1174,
    "segs": [ {
      "utf8": "In 1976,"
    } ]
  }, {
    "tStartMs": 690696,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "the American Mathematical\nSociety presented him"
    } ]
  }, {
    "tStartMs": 692721,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "with the Oswald Veblen Prize in geometry."
    } ]
  }, {
    "tStartMs": 695854,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "But at the top of his academic\ncareer, Simons went looking"
    } ]
  }, {
    "tStartMs": 699574,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "for a new challenge."
    } ]
  }, {
    "tStartMs": 701464,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "When he founded Renaissance\nTechnologies in 1978,"
    } ]
  }, {
    "tStartMs": 704314,
    "dDurationMs": 2075,
    "segs": [ {
      "utf8": "his strategy was to use machine learning"
    } ]
  }, {
    "tStartMs": 706389,
    "dDurationMs": 2382,
    "segs": [ {
      "utf8": "to find patterns in the stock market."
    } ]
  }, {
    "tStartMs": 708771,
    "dDurationMs": 3013,
    "segs": [ {
      "utf8": "Patterns provide\nopportunities to make money."
    } ]
  }, {
    "tStartMs": 711784,
    "dDurationMs": 3205,
    "segs": [ {
      "utf8": "- The real thing was to gather\na tremendous amount of data"
    } ]
  }, {
    "tStartMs": 714989,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "and we had to get it by\nhand in the early days,"
    } ]
  }, {
    "tStartMs": 718522,
    "dDurationMs": 1617,
    "segs": [ {
      "utf8": "we went down to the Federal Reserve"
    } ]
  }, {
    "tStartMs": 720139,
    "dDurationMs": 2927,
    "segs": [ {
      "utf8": "and copied interest rate\nhistories and stuff like that"
    } ]
  }, {
    "tStartMs": 723066,
    "dDurationMs": 2428,
    "segs": [ {
      "utf8": "'cause it didn't exist on computers."
    } ]
  }, {
    "tStartMs": 725494,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- His rationale was that the\nmarket is far too complex"
    } ]
  }, {
    "tStartMs": 728164,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "for anyone to be able to make\npredictions with certainty."
    } ]
  }, {
    "tStartMs": 731074,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "But Simons had worked for"
    } ]
  }, {
    "tStartMs": 732644,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "the US Institute for Defense Analysis"
    } ]
  }, {
    "tStartMs": 734627,
    "dDurationMs": 2327,
    "segs": [ {
      "utf8": "during the Cold War,\nbreaking Russian codes"
    } ]
  }, {
    "tStartMs": 736954,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "by extracting patterns\nfrom masses of data."
    } ]
  }, {
    "tStartMs": 740374,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Simons was convinced"
    } ]
  }, {
    "tStartMs": 741664,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that a similar approach\ncould beat the market."
    } ]
  }, {
    "tStartMs": 744154,
    "dDurationMs": 2645,
    "segs": [ {
      "utf8": "He then used his academic\ncontacts to hire a bunch"
    } ]
  }, {
    "tStartMs": 746799,
    "dDurationMs": 2245,
    "segs": [ {
      "utf8": "of the best scientists he could find."
    } ]
  }, {
    "tStartMs": 749044,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- What was your employment criteria then?"
    } ]
  }, {
    "tStartMs": 751114,
    "dDurationMs": 1342,
    "segs": [ {
      "utf8": "If they knew nothing about finance,"
    } ]
  }, {
    "tStartMs": 752456,
    "dDurationMs": 1348,
    "segs": [ {
      "utf8": "what were you looking for in them?"
    } ]
  }, {
    "tStartMs": 753804,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Someone with a PhD in physics\nand who'd had five years out"
    } ]
  }, {
    "tStartMs": 757804,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and had written a few good papers"
    } ]
  }, {
    "tStartMs": 759184,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and was obviously a\nsmart guy or in astronomy"
    } ]
  }, {
    "tStartMs": 762994,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "or in mathematics or in statistics."
    } ]
  }, {
    "tStartMs": 767044,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Someone who had done\nscience and done it well."
    } ]
  }, {
    "tStartMs": 770974,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- It's not surprising that mathematicians"
    } ]
  }, {
    "tStartMs": 772894,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and physicists are involved in this field."
    } ]
  }, {
    "tStartMs": 775834,
    "dDurationMs": 2472,
    "segs": [ {
      "utf8": "First of all, finance pays a\nlot better than, you know,"
    } ]
  }, {
    "tStartMs": 778306,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "being an assistant\nprofessor of mathematics."
    } ]
  }, {
    "tStartMs": 780909,
    "dDurationMs": 3535,
    "segs": [ {
      "utf8": "And for a number of\nmathematicians, the beauty"
    } ]
  }, {
    "tStartMs": 784444,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of option pricing is equally\ncompelling to anything else"
    } ]
  }, {
    "tStartMs": 787804,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that they're doing in their professions."
    } ]
  }, {
    "tStartMs": 789844,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- One of these was Leonard Baum, a pioneer"
    } ]
  }, {
    "tStartMs": 792214,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "of Hidden Markov models."
    } ]
  }, {
    "tStartMs": 794254,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Just as Einstein realized that"
    } ]
  }, {
    "tStartMs": 795964,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "although we can't directly observe atoms,"
    } ]
  }, {
    "tStartMs": 797704,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "we can infer their existence"
    } ]
  }, {
    "tStartMs": 798994,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "through their effect on pollen grains,"
    } ]
  }, {
    "tStartMs": 801274,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Hidden Markov models aim to find factors"
    } ]
  }, {
    "tStartMs": 803554,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that are not directly observable,"
    } ]
  }, {
    "tStartMs": 805414,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but do have an effect\non what we can observe."
    } ]
  }, {
    "tStartMs": 808174,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "And soon after that,"
    } ]
  }, {
    "tStartMs": 809174,
    "dDurationMs": 1825,
    "segs": [ {
      "utf8": "Renaissance launched their now-famous"
    } ]
  }, {
    "tStartMs": 810999,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Medallion fund."
    } ]
  }, {
    "tStartMs": 812932,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "Using hidden Markov models"
    } ]
  }, {
    "tStartMs": 814507,
    "dDurationMs": 1677,
    "segs": [ {
      "utf8": "and other data driven strategies,"
    } ]
  }, {
    "tStartMs": 816184,
    "dDurationMs": 2232,
    "segs": [ {
      "utf8": "The Medallion fund became\nthe highest returning"
    } ]
  }, {
    "tStartMs": 818416,
    "dDurationMs": 2568,
    "segs": [ {
      "utf8": "investment fund of all time."
    } ]
  }, {
    "tStartMs": 820984,
    "dDurationMs": 2587,
    "segs": [ {
      "utf8": "This led Bradford Cornell\nof UCLA, in his paper"
    } ]
  }, {
    "tStartMs": 823571,
    "dDurationMs": 2915,
    "segs": [ {
      "utf8": "Medallion Fund: The\nUltimate Counterexample?"
    } ]
  }, {
    "tStartMs": 826486,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "to conclude that maybe the\nefficient market hypothesis"
    } ]
  }, {
    "tStartMs": 829592,
    "dDurationMs": 2052,
    "segs": [ {
      "utf8": "itself is wrong."
    } ]
  }, {
    "tStartMs": 831644,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- In 1988, I published a paper testing it,"
    } ]
  }, {
    "tStartMs": 834344,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the US Stock Market,"
    } ]
  }, {
    "tStartMs": 836114,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and what I found was that\nthe hypothesis is false."
    } ]
  }, {
    "tStartMs": 840404,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "You can actually reject\nthe hypothesis in the data."
    } ]
  }, {
    "tStartMs": 843944,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "And so there are predictabilities"
    } ]
  }, {
    "tStartMs": 845910,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "in the stock market."
    } ]
  }, {
    "tStartMs": 847754,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- So it's possible to beat the\nmarket is what you're saying."
    } ]
  }, {
    "tStartMs": 852914,
    "dDurationMs": 3005,
    "segs": [ {
      "utf8": "- It's possible to beat the\nmarket if you have"
    } ]
  }, {
    "tStartMs": 855919,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "the right models, the right training,"
    } ]
  }, {
    "tStartMs": 858396,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "the resources, the computational power,"
    } ]
  }, {
    "tStartMs": 861337,
    "dDurationMs": 2275,
    "segs": [ {
      "utf8": "and so on and so forth, yes."
    } ]
  }, {
    "tStartMs": 865064,
    "dDurationMs": 1808,
    "segs": [ {
      "utf8": "- The people who have found the patterns"
    } ]
  }, {
    "tStartMs": 866872,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "in the stock market,"
    } ]
  }, {
    "tStartMs": 867905,
    "dDurationMs": 2019,
    "segs": [ {
      "utf8": "and the randomness for that matter,"
    } ]
  }, {
    "tStartMs": 869924,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "have often been physicists\nand mathematicians,"
    } ]
  }, {
    "tStartMs": 872744,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "but their impact has gone\nbeyond just making them rich."
    } ]
  }, {
    "tStartMs": 876494,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "By modeling market dynamics,"
    } ]
  }, {
    "tStartMs": 878144,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "they've provided new insight into risk"
    } ]
  }, {
    "tStartMs": 880784,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and opened up whole new markets."
    } ]
  }, {
    "tStartMs": 883304,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "They've determined what the accurate price"
    } ]
  }, {
    "tStartMs": 885469,
    "dDurationMs": 2155,
    "segs": [ {
      "utf8": "of derivatives should be,"
    } ]
  }, {
    "tStartMs": 887624,
    "dDurationMs": 1055,
    "segs": [ {
      "utf8": "and in doing so,"
    } ]
  }, {
    "tStartMs": 888679,
    "dDurationMs": 3415,
    "segs": [ {
      "utf8": "they have helped eliminate\nmarket inefficiencies."
    } ]
  }, {
    "tStartMs": 892094,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Ironically, if we are ever able"
    } ]
  }, {
    "tStartMs": 894224,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "to discover all the patterns\nin the stock market,"
    } ]
  }, {
    "tStartMs": 896590,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "knowing what they are will\nallow us to eliminate them."
    } ]
  }, {
    "tStartMs": 899924,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Then we will finally have\na perfectly efficient market"
    } ]
  }, {
    "tStartMs": 903284,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "where all price movements\nare truly random."
    } ]
  } ]
}
