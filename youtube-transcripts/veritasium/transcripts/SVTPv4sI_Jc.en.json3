{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 35,
    "dDurationMs": 2045,
    "segs": [ {
      "utf8": "- Could the CIA really\ntrack your heartbeat"
    } ]
  }, {
    "tStartMs": 2080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "from kilometers away?"
    } ]
  }, {
    "tStartMs": 3760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "On April 3rd, 2026,"
    } ]
  }, {
    "tStartMs": 5600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Iranian forces shot down\nan American fighter plane"
    } ]
  }, {
    "tStartMs": 8320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "just over Isfahan."
    } ]
  }, {
    "tStartMs": 10320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Inside were a pilot and\na weapon system officer,"
    } ]
  }, {
    "tStartMs": 13440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and both ejected successfully."
    } ]
  }, {
    "tStartMs": 16800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The US forces located the pilot quickly"
    } ]
  }, {
    "tStartMs": 18960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and rescued him only seven\nhours after the crash,"
    } ]
  }, {
    "tStartMs": 22000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "but they couldn't rescue\nthe weapon system officer."
    } ]
  }, {
    "tStartMs": 24800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "He landed elsewhere deep\nwithin hostile territory."
    } ]
  }, {
    "tStartMs": 27920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And, worst of all, he was injured."
    } ]
  }, {
    "tStartMs": 30320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "With the Iranian forces on his tail,"
    } ]
  }, {
    "tStartMs": 32400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "the officer needed to hide quickly,"
    } ]
  }, {
    "tStartMs": 33840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "so he disappeared into the mountains."
    } ]
  }, {
    "tStartMs": 39957,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "to rescue an aviator buried\ndeep behind enemy lines."
    } ]
  }, {
    "tStartMs": 43357,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- Fortunately, the officer\nhad a rescue beacon"
    } ]
  }, {
    "tStartMs": 45717,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that could signal his location to the US."
    } ]
  }, {
    "tStartMs": 48197,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The problem was that he\nnot only had to step out"
    } ]
  }, {
    "tStartMs": 50277,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "of his hiding spot to transmit the signal,"
    } ]
  }, {
    "tStartMs": 52517,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Iran could potentially intercept\nit and get to him first."
    } ]
  }, {
    "tStartMs": 55397,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So he could only use the beacon sparingly."
    } ]
  }, {
    "tStartMs": 57877,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "With enemy forces getting\ncloser every hour,"
    } ]
  }, {
    "tStartMs": 60437,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "how is the US going to\npinpoint his location"
    } ]
  }, {
    "tStartMs": 68275,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "in the middle of a desert."
    } ]
  }, {
    "tStartMs": 69544,
    "dDurationMs": 2411,
    "segs": [ {
      "utf8": "- [Gregor] A blind sweep of\nthe entire area could take days"
    } ]
  }, {
    "tStartMs": 71955,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "or even weeks,"
    } ]
  }, {
    "tStartMs": 73395,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but, surprisingly, just\n40 hours after the crash,"
    } ]
  }, {
    "tStartMs": 75955,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the US announced the officer was rescued."
    } ]
  }, {
    "tStartMs": 78195,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "- Still invisible to the\nenemy, but not to the CIA."
    } ]
  }, {
    "tStartMs": 81635,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- So how did they do it?"
    } ]
  }, {
    "tStartMs": 84195,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Well, according to a\nNew York Post article,"
    } ]
  }, {
    "tStartMs": 86035,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the CIA deployed a futuristic\ndevice to rescue him."
    } ]
  }, {
    "tStartMs": 89075,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Reportedly they were able\nto detect the magnetic field"
    } ]
  }, {
    "tStartMs": 91395,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "produced by his heartbeat\nfrom kilometers away."
    } ]
  }, {
    "tStartMs": 95075,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Such a device would have to\novercome the magnetic signatures"
    } ]
  }, {
    "tStartMs": 97715,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "from other soldiers, vehicles,\nand animals in the region,"
    } ]
  }, {
    "tStartMs": 100835,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "let alone Earth's magnetic field."
    } ]
  }, {
    "tStartMs": 102995,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It's like listening for\na murmur in a crowd."
    } ]
  }, {
    "tStartMs": 106515,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "So the technology was\nappropriately called Ghost Murmur."
    } ]
  }, {
    "tStartMs": 111475,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Immediately this kicked\noff a media frenzy."
    } ]
  }, {
    "tStartMs": 113715,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Ghost Murmur."
    } ]
  }, {
    "tStartMs": 114795,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- This is science fiction.\n- Ghost Murmur."
    } ]
  }, {
    "tStartMs": 116635,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- Did you hear about what\nthe CIA tech that they have"
    } ]
  }, {
    "tStartMs": 118995,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "called the Ghost Murmur."
    } ]
  }, {
    "tStartMs": 120075,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Called the Ghost Murmur."
    } ]
  }, {
    "tStartMs": 121275,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- All of this sounds too good to be true,"
    } ]
  }, {
    "tStartMs": 122995,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and there seemed to be no other sources"
    } ]
  }, {
    "tStartMs": 124755,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "beyond this New York Post article."
    } ]
  }, {
    "tStartMs": 126755,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So we dug deep to find out\nwhether this supposed technology"
    } ]
  }, {
    "tStartMs": 130115,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "really exists and what its limits are."
    } ]
  }, {
    "tStartMs": 132555,
    "dDurationMs": 4751,
    "segs": [ {
      "utf8": "- I very rarely believe things\nI read in the New York Post."
    } ]
  }, {
    "tStartMs": 137306,
    "dDurationMs": 7,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 137313,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "- I find it extremely\ndifficult to believe."
    } ]
  }, {
    "tStartMs": 139395,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- Many of these researchers\nin the NV diamond area,"
    } ]
  }, {
    "tStartMs": 142115,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "are having to sign NDAs."
    } ]
  }, {
    "tStartMs": 143315,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- The fact that the CIA is involved"
    } ]
  }, {
    "tStartMs": 145875,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in leveraging technologies"
    } ]
  }, {
    "tStartMs": 147795,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "consistent with their\nmission and their charter."
    } ]
  }, {
    "tStartMs": 149755,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "- So is Ghost Murmur fact or fiction?"
    } ]
  }, {
    "tStartMs": 154115,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There are two lines in\nthis New York Post article"
    } ]
  }, {
    "tStartMs": 156115,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that hint at what this device can be."
    } ]
  }, {
    "tStartMs": 158515,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "First, normally this signal is so weak"
    } ]
  }, {
    "tStartMs": 160995,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that it can only be measured\nin a hospital setting"
    } ]
  }, {
    "tStartMs": 163395,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "with sensors pressed\nnearly against the chest,"
    } ]
  }, {
    "tStartMs": 166115,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "the source said."
    } ]
  }, {
    "tStartMs": 167475,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But advances in a field known\nas quantum magnetometry,"
    } ]
  }, {
    "tStartMs": 170835,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "specifically sensors built\naround microscopic defects"
    } ]
  }, {
    "tStartMs": 173715,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "in synthetic diamonds,"
    } ]
  }, {
    "tStartMs": 175155,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "have apparently made it possible"
    } ]
  }, {
    "tStartMs": 176675,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to detect these signals at\ndramatically greater distances."
    } ]
  }, {
    "tStartMs": 180995,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We're gonna break this down bit by bit."
    } ]
  }, {
    "tStartMs": 182995,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "First, does the heart actually create"
    } ]
  }, {
    "tStartMs": 185155,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "detectable magnetic fields?"
    } ]
  }, {
    "tStartMs": 187075,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Second, what are these synthetic diamonds"
    } ]
  }, {
    "tStartMs": 189235,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that could potentially detect them?"
    } ]
  }, {
    "tStartMs": 191475,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And third, is it all\npossible at these distances?"
    } ]
  }, {
    "tStartMs": 195075,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Let's start with a heart."
    } ]
  }, {
    "tStartMs": 196835,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Now, if you type heart magnetic\nfield into Google Images,"
    } ]
  }, {
    "tStartMs": 199795,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "you will get a bunch of\nquestionable-looking graphs."
    } ]
  }, {
    "tStartMs": 204275,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So is it a real thing?"
    } ]
  }, {
    "tStartMs": 206275,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Well, whenever current\nflows through a conductor,"
    } ]
  }, {
    "tStartMs": 208755,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it generates a magnetic field around it."
    } ]
  }, {
    "tStartMs": 211155,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And since our bodies run\non electrical impulses"
    } ]
  }, {
    "tStartMs": 213635,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "traveling through neurons,"
    } ]
  }, {
    "tStartMs": 215155,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "our tissues and organs generate\nfaint magnetic signals."
    } ]
  }, {
    "tStartMs": 218675,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But because the heart muscles\nfire in a coordinated way,"
    } ]
  }, {
    "tStartMs": 221875,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the magnetic field they produce is"
    } ]
  }, {
    "tStartMs": 223715,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the strongest in the body."
    } ]
  }, {
    "tStartMs": 225555,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It's around 50 to 100 pico Teslas,"
    } ]
  }, {
    "tStartMs": 228595,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "10 to 100 times more"
    } ]
  }, {
    "tStartMs": 229955,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "than the next strongest\nfield produced by the brain."
    } ]
  }, {
    "tStartMs": 232995,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But even then, this is\nstill a million times weaker"
    } ]
  }, {
    "tStartMs": 235795,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "than Earth's magnetic field."
    } ]
  }, {
    "tStartMs": 237315,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So it's no surprise that we only detected"
    } ]
  }, {
    "tStartMs": 239155,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "the magnetic field of the heart in 1963."
    } ]
  }, {
    "tStartMs": 243155,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It had to be done in a remote field"
    } ]
  }, {
    "tStartMs": 245075,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "away from the magnetic noise"
    } ]
  }, {
    "tStartMs": 246435,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "produced by lab equipment,\nelevators, and cars."
    } ]
  }, {
    "tStartMs": 249395,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And the setup had to be incredibly still."
    } ]
  }, {
    "tStartMs": 252035,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Even the slightest vibration"
    } ]
  }, {
    "tStartMs": 253315,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "of the detector would\ncorrupt the measurement,"
    } ]
  }, {
    "tStartMs": 255635,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "not something that could\nwork on a helicopter"
    } ]
  }, {
    "tStartMs": 257475,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "or a military drone."
    } ]
  }, {
    "tStartMs": 259955,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But, pretty soon,\nmagnetometers got better."
    } ]
  }, {
    "tStartMs": 262755,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "By the 1970s,"
    } ]
  }, {
    "tStartMs": 264035,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "we got superconducting\nquantum interference devices,"
    } ]
  }, {
    "tStartMs": 266835,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "or SQUIDs."
    } ]
  }, {
    "tStartMs": 268195,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "These magnetometers were\nincredibly sensitive,"
    } ]
  }, {
    "tStartMs": 270675,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "detecting fields as weak\nas a few femto Tesla."
    } ]
  }, {
    "tStartMs": 273875,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "To no surprise,"
    } ]
  }, {
    "tStartMs": 274835,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "the US military quickly\nstrapped these SQUIDs"
    } ]
  }, {
    "tStartMs": 277315,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to planes and helicopters,"
    } ]
  }, {
    "tStartMs": 278835,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "and they tried to use them"
    } ]
  }, {
    "tStartMs": 279955,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to detect large magnetic signatures"
    } ]
  }, {
    "tStartMs": 281955,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "like submarines in the ocean."
    } ]
  }, {
    "tStartMs": 284275,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But the project never really picked up."
    } ]
  }, {
    "tStartMs": 286675,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Nonetheless, SQUIDs also made it easier"
    } ]
  }, {
    "tStartMs": 288995,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "to detect the heart's magnetic\nfield, but with a key caveat."
    } ]
  }, {
    "tStartMs": 292715,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- They typically need to be operated"
    } ]
  }, {
    "tStartMs": 294995,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "under a very tightly\ncontrolled conditions,"
    } ]
  }, {
    "tStartMs": 298435,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "often inside of shielded rooms."
    } ]
  }, {
    "tStartMs": 299955,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "They can't handle large dynamic\nrange of background fields"
    } ]
  }, {
    "tStartMs": 303155,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and electromagnetic interference."
    } ]
  }, {
    "tStartMs": 304875,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- Future magnetometers offered solutions,"
    } ]
  }, {
    "tStartMs": 307315,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "but they also had their own drawbacks."
    } ]
  }, {
    "tStartMs": 309635,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "There were always issues\nwith either shielding"
    } ]
  }, {
    "tStartMs": 311795,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "or sensitivity or dynamic range\nthat made them impractical"
    } ]
  }, {
    "tStartMs": 315235,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "for detecting heartbeats out in the field."
    } ]
  }, {
    "tStartMs": 318115,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Until the 1990s when physicists started"
    } ]
  }, {
    "tStartMs": 321075,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "looking into diamonds that\nmight eventually be able"
    } ]
  }, {
    "tStartMs": 323715,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to sense magnetic fields"
    } ]
  }, {
    "tStartMs": 325475,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "while potentially getting\naround the drawbacks."
    } ]
  }, {
    "tStartMs": 328595,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- These new quantum magnetometers work"
    } ]
  }, {
    "tStartMs": 331555,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "at room temperature operation,"
    } ]
  }, {
    "tStartMs": 333475,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and that's what's really\nexciting about them."
    } ]
  }, {
    "tStartMs": 335555,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They're also a solid state sensor,"
    } ]
  }, {
    "tStartMs": 337475,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "which, you know, can be very\npractical for some applications"
    } ]
  }, {
    "tStartMs": 341955,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and can be made into like a\nmore robust kind of sensor."
    } ]
  }, {
    "tStartMs": 345315,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- These are the diamonds"
    } ]
  }, {
    "tStartMs": 346835,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "mentioned in the New York Post article."
    } ]
  }, {
    "tStartMs": 348755,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So how do they work?"
    } ]
  }, {
    "tStartMs": 351315,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Now, the overall coverage of the story is"
    } ]
  }, {
    "tStartMs": 353395,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "actually very interesting"
    } ]
  }, {
    "tStartMs": 354755,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "because this tech is\nsupposedly classified."
    } ]
  }, {
    "tStartMs": 357155,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "There's a lot of uncertainty"
    } ]
  }, {
    "tStartMs": 358035,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "about whether what's being\nreported is actually real."
    } ]
  }, {
    "tStartMs": 360995,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And depending on which\noutlet you see first,"
    } ]
  }, {
    "tStartMs": 363075,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "you might arrive at completely\ndifferent conclusions."
    } ]
  }, {
    "tStartMs": 365635,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "For example, if you saw\nthis headline first,"
    } ]
  }, {
    "tStartMs": 367715,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you might be really impressed\nwith the technology,"
    } ]
  }, {
    "tStartMs": 370115,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "but this one you'd be\na bit more skeptical,"
    } ]
  }, {
    "tStartMs": 372435,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and the last one might\nnot even make you care"
    } ]
  }, {
    "tStartMs": 374755,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "about the tech."
    } ]
  }, {
    "tStartMs": 375715,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So three headlines, three\ncompletely different conclusions,"
    } ]
  }, {
    "tStartMs": 379315,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and that's where today's\nsponsor Ground News comes in."
    } ]
  }, {
    "tStartMs": 381875,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "They're a website and an app"
    } ]
  }, {
    "tStartMs": 383155,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "designed to make reading the news easier"
    } ]
  }, {
    "tStartMs": 384995,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and more data-driven."
    } ]
  }, {
    "tStartMs": 386275,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Each day they round up stories\nfrom thousands of outlets"
    } ]
  }, {
    "tStartMs": 389075,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "all around the world"
    } ]
  }, {
    "tStartMs": 389955,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and give you a visual\nbreakdown of the story,"
    } ]
  }, {
    "tStartMs": 392515,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "including its political\nleaning, factuality rating,"
    } ]
  }, {
    "tStartMs": 395555,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and even ownership,"
    } ]
  }, {
    "tStartMs": 396995,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "all backed by ratings"
    } ]
  }, {
    "tStartMs": 398115,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "from three independent\nmedia-monitoring organizations."
    } ]
  }, {
    "tStartMs": 401395,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "In case of this Ghost Murmur story,"
    } ]
  }, {
    "tStartMs": 403075,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you can see that it's been\nreported on by 65 sources,"
    } ]
  }, {
    "tStartMs": 406115,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but the coverage is pretty lopsided."
    } ]
  }, {
    "tStartMs": 408035,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So if you only get your news\nfrom right-leaning outlets,"
    } ]
  }, {
    "tStartMs": 410755,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "there's a chance you've seen the story."
    } ]
  }, {
    "tStartMs": 412355,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But if you only get it from the left,"
    } ]
  }, {
    "tStartMs": 414035,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "there's a chance you haven't."
    } ]
  }, {
    "tStartMs": 415235,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And below that, you can also\nsee the factuality rating"
    } ]
  }, {
    "tStartMs": 417635,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and the ownerships of the sources."
    } ]
  }, {
    "tStartMs": 419795,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "They also have this blind spot feature,"
    } ]
  }, {
    "tStartMs": 421635,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "which highlights stories\nlike the Ghosts Murmur one"
    } ]
  }, {
    "tStartMs": 423715,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "that were under reported on"
    } ]
  }, {
    "tStartMs": 425075,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "by either side of the political spectrum."
    } ]
  }, {
    "tStartMs": 427155,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Staying up to date and well-informed"
    } ]
  }, {
    "tStartMs": 428915,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "with accurate information has\nalmost become a full-time job."
    } ]
  }, {
    "tStartMs": 432275,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And that's where Ground News's\napproach is so valuable."
    } ]
  }, {
    "tStartMs": 434515,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "They make reading the news\nmore digestible and accessible,"
    } ]
  }, {
    "tStartMs": 437235,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and you can see all of the\ninformation within moments,"
    } ]
  }, {
    "tStartMs": 439875,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "not hours."
    } ]
  }, {
    "tStartMs": 440835,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So if you, like us at Veritasium, care"
    } ]
  }, {
    "tStartMs": 442915,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "about getting to the truth,"
    } ]
  }, {
    "tStartMs": 444115,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "you can go to ground.news/ve\nor scan this QR code"
    } ]
  }, {
    "tStartMs": 447795,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and our link will get you\n40% off their vantage plan."
    } ]
  }, {
    "tStartMs": 450515,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So I wanna thank Ground News"
    } ]
  }, {
    "tStartMs": 451715,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "for sponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 453155,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and now let's go figure out"
    } ]
  }, {
    "tStartMs": 454355,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "how those diamonds actually\ndetect magnetic fields."
    } ]
  }, {
    "tStartMs": 457795,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Well, for something to\nfunction as a magnetometer,"
    } ]
  }, {
    "tStartMs": 460115,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it needs to respond to a magnetic field"
    } ]
  }, {
    "tStartMs": 461795,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "in a way that we can detect."
    } ]
  }, {
    "tStartMs": 463635,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Now, a pure diamond is\njust an ordered lattice"
    } ]
  }, {
    "tStartMs": 466355,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "of carbon atoms,"
    } ]
  }, {
    "tStartMs": 467155,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "so it doesn't react to magnetic\nfields in a meaningful way."
    } ]
  }, {
    "tStartMs": 470435,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "But this changes"
    } ]
  }, {
    "tStartMs": 471395,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "when you start adding\ndefects to the lattice."
    } ]
  }, {
    "tStartMs": 474435,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "You can replace one of the\ncarbon atoms in the lattice"
    } ]
  }, {
    "tStartMs": 476755,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "with, say, a nitrogen."
    } ]
  }, {
    "tStartMs": 478035,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And if you remove one of the\ncarbons next to it completely,"
    } ]
  }, {
    "tStartMs": 481155,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "well, that creates a vacancy."
    } ]
  }, {
    "tStartMs": 483875,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "This defect is called a nitrogen\nvacancy or an NV center."
    } ]
  }, {
    "tStartMs": 488115,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And these NV centers\nbecome particularly useful"
    } ]
  }, {
    "tStartMs": 491635,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "when they trap two unpaired electrons."
    } ]
  }, {
    "tStartMs": 494915,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "That's because electrons have"
    } ]
  }, {
    "tStartMs": 496275,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "this intrinsic property called spin."
    } ]
  }, {
    "tStartMs": 498835,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "A simple and flawed analogy is"
    } ]
  }, {
    "tStartMs": 500675,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that spin is kind of\nlike a tiny bar magnet"
    } ]
  }, {
    "tStartMs": 502835,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that gives electrons their\nown magnetic signature"
    } ]
  }, {
    "tStartMs": 505315,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and it can point either up or down."
    } ]
  }, {
    "tStartMs": 508035,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So when an electron is exposed"
    } ]
  }, {
    "tStartMs": 509875,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to an external magnetic field,"
    } ]
  }, {
    "tStartMs": 512035,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "this magnetic signature\nwill either align itself"
    } ]
  }, {
    "tStartMs": 514755,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "with the field or against it."
    } ]
  }, {
    "tStartMs": 516835,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Also note that particles\nthat have no net spin"
    } ]
  }, {
    "tStartMs": 519635,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "will not respond to an\nexternal magnetic field."
    } ]
  }, {
    "tStartMs": 523075,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now, the two trapped electrons\ncan arrange their spins"
    } ]
  }, {
    "tStartMs": 525715,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "in the following way."
    } ]
  }, {
    "tStartMs": 527555,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They could both point up,"
    } ]
  }, {
    "tStartMs": 528995,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "which would give you a\nspin magnetic number of 1."
    } ]
  }, {
    "tStartMs": 532675,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "They could both point down\nfor a quantum number of -1,"
    } ]
  }, {
    "tStartMs": 536195,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or they could point in opposite directions"
    } ]
  }, {
    "tStartMs": 538355,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for a quantum number of 0."
    } ]
  }, {
    "tStartMs": 540515,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "We'll denote this spin magnetic\nquantum number with ms,"
    } ]
  }, {
    "tStartMs": 544195,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and it essentially acts as a bar magnet"
    } ]
  }, {
    "tStartMs": 546595,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "for the whole NV center."
    } ]
  }, {
    "tStartMs": 548595,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And just like for individual electrons,"
    } ]
  }, {
    "tStartMs": 550915,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "this bar magnet is also sensitive"
    } ]
  }, {
    "tStartMs": 552995,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to external magnetic fields."
    } ]
  }, {
    "tStartMs": 554995,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So now that we've created a diamond"
    } ]
  }, {
    "tStartMs": 557155,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "that responds to magnetic\nfields, the challenge is,"
    } ]
  }, {
    "tStartMs": 560435,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "how do we measure this\nresponse to detect a heartbeat?"
    } ]
  }, {
    "tStartMs": 565475,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Okay, so I reached out to experts"
    } ]
  }, {
    "tStartMs": 567475,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to try and figure this out,"
    } ]
  }, {
    "tStartMs": 569235,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but basically out of the 20\nor so emails that I sent,"
    } ]
  }, {
    "tStartMs": 571635,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "I only got a few responses,"
    } ]
  }, {
    "tStartMs": 572915,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but then I got an impromptu\ncall from one of these experts"
    } ]
  }, {
    "tStartMs": 575555,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "who said that many of these researchers"
    } ]
  }, {
    "tStartMs": 577475,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "in the NV diamond area\nare having to sign NDAs."
    } ]
  }, {
    "tStartMs": 580515,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "This is getting a lot more interesting."
    } ]
  }, {
    "tStartMs": 582035,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But with how secretive everyone was being,"
    } ]
  }, {
    "tStartMs": 583715,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I had to use publicly available research."
    } ]
  }, {
    "tStartMs": 586355,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And I think the key idea is to figure out"
    } ]
  }, {
    "tStartMs": 589235,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "how diamonds respond to magnetic fields,"
    } ]
  }, {
    "tStartMs": 591475,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "you have to use light."
    } ]
  }, {
    "tStartMs": 593555,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "When you shine light at an atom,"
    } ]
  }, {
    "tStartMs": 595155,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the atom can either absorb\nthe light or ignore it."
    } ]
  }, {
    "tStartMs": 598195,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "An absorbed photon of light\nwill excite an electron"
    } ]
  }, {
    "tStartMs": 600755,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "within the atom to a higher energy level."
    } ]
  }, {
    "tStartMs": 603475,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You can think of these energy\nlevels as discrete platforms"
    } ]
  }, {
    "tStartMs": 606115,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that the electrons can jump between,"
    } ]
  }, {
    "tStartMs": 607955,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "just like in a video game."
    } ]
  }, {
    "tStartMs": 609635,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "All atoms of the same\nelement, for example, carbon,"
    } ]
  }, {
    "tStartMs": 612435,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "have the same energy levels"
    } ]
  }, {
    "tStartMs": 614035,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "when the atoms are far enough apart."
    } ]
  }, {
    "tStartMs": 616755,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "But when you bring them together,"
    } ]
  }, {
    "tStartMs": 618355,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "like inside a diamond lattice,\ntheir energy levels shift."
    } ]
  }, {
    "tStartMs": 621715,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They come together to form a series"
    } ]
  }, {
    "tStartMs": 623635,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "of closely spaced energy\nlevels or an energy band."
    } ]
  }, {
    "tStartMs": 627715,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Now, an electron will\nonly ever absorb a photon"
    } ]
  }, {
    "tStartMs": 630995,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "if the photon has enough energy"
    } ]
  }, {
    "tStartMs": 632595,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to move the electron across\nthe gap to a higher band."
    } ]
  }, {
    "tStartMs": 636275,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This gap between the last\nelectron occupied band"
    } ]
  }, {
    "tStartMs": 639395,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and the first empty band above\nit is called the band gap."
    } ]
  }, {
    "tStartMs": 643475,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "In a pure diamond, it's big."
    } ]
  }, {
    "tStartMs": 645235,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It's around 5.5 electron volts,"
    } ]
  }, {
    "tStartMs": 647795,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "which means that only ultraviolet\nphotons have enough energy"
    } ]
  }, {
    "tStartMs": 651075,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to excite the electrons."
    } ]
  }, {
    "tStartMs": 652995,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "All lower energy light,\nincluding visible light,"
    } ]
  }, {
    "tStartMs": 655475,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "will mostly be ignored by the\ndiamond and just pass through."
    } ]
  }, {
    "tStartMs": 658915,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This is why a perfect pure\ndiamond is transparent."
    } ]
  }, {
    "tStartMs": 662035,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It doesn't absorb any of the light,"
    } ]
  }, {
    "tStartMs": 663875,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but if you start adding defects,"
    } ]
  }, {
    "tStartMs": 665395,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "they disrupt that organized lattice."
    } ]
  }, {
    "tStartMs": 668035,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The defects unlock\ndifferent energy levels."
    } ]
  }, {
    "tStartMs": 670755,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Secret platforms within this band gap"
    } ]
  }, {
    "tStartMs": 672915,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for nearby electrons to jump to."
    } ]
  }, {
    "tStartMs": 675315,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "A boron defect, for example,"
    } ]
  }, {
    "tStartMs": 676835,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "creates a low energy level\nat only 0.37 electron volts."
    } ]
  }, {
    "tStartMs": 681235,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is a platform that\nelectrons can jump to"
    } ]
  }, {
    "tStartMs": 683235,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "by absorbing infrared or red light."
    } ]
  }, {
    "tStartMs": 685715,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And with enough boron defects,"
    } ]
  }, {
    "tStartMs": 687555,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "a significant amount of red\nlight gets absorbed this way."
    } ]
  }, {
    "tStartMs": 691155,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The rest of the visible spectrum\nmostly makes it through."
    } ]
  }, {
    "tStartMs": 694115,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So without this red, the\ndiamond appears blue."
    } ]
  }, {
    "tStartMs": 697715,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Similarly, a nitrogen\nvacancy defect unlocks"
    } ]
  }, {
    "tStartMs": 700675,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "other secret platforms."
    } ]
  }, {
    "tStartMs": 702435,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And these can help us detect"
    } ]
  }, {
    "tStartMs": 703955,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "how the NV center responds\nto a magnetic field."
    } ]
  }, {
    "tStartMs": 707315,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "At first glance, it looks\nlike the nitrogen vacancy"
    } ]
  }, {
    "tStartMs": 710035,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "generates a few unique levels,"
    } ]
  }, {
    "tStartMs": 711875,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and these are exclusive"
    } ]
  }, {
    "tStartMs": 713235,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "to the two unpaired electrons\ntrapped within the defect."
    } ]
  }, {
    "tStartMs": 716835,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "But if you look closer at,\nfor example, the lowest level,"
    } ]
  }, {
    "tStartMs": 720115,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you'll notice that it actually contains"
    } ]
  }, {
    "tStartMs": 722115,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "three closely spaced but\nseparate energy levels."
    } ]
  }, {
    "tStartMs": 725875,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The second and third levels are\nactually at the same height,"
    } ]
  }, {
    "tStartMs": 728595,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but will draw them separately."
    } ]
  }, {
    "tStartMs": 730595,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And the fact that there are\nthree isn't a coincidence."
    } ]
  }, {
    "tStartMs": 733875,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Remember, the NV center can\nadopt one of three ms numbers,"
    } ]
  }, {
    "tStartMs": 737475,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "0, -1, or 1,"
    } ]
  }, {
    "tStartMs": 739875,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "depending on how the spins"
    } ]
  }, {
    "tStartMs": 741155,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "of the two electrons inside are arranged."
    } ]
  }, {
    "tStartMs": 743955,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "If you think of the two\nspins as bar magnets,"
    } ]
  }, {
    "tStartMs": 746755,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the most relaxed, lowest energy\nway for them to sit is this,"
    } ]
  }, {
    "tStartMs": 750595,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "one pointing up and the other down."
    } ]
  }, {
    "tStartMs": 753155,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "This is analogous to the ms = 0 state,"
    } ]
  }, {
    "tStartMs": 755875,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "which is why it has the lowest energy."
    } ]
  }, {
    "tStartMs": 758195,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Forcing both magnets to point\ndown together or up together,"
    } ]
  }, {
    "tStartMs": 761715,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "like the ms = 1 or -1\nstates requires more energy."
    } ]
  }, {
    "tStartMs": 765875,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "They oppose you."
    } ]
  }, {
    "tStartMs": 766995,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So these two states are"
    } ]
  }, {
    "tStartMs": 768275,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "at an equal, slightly\nhigher energy sub level."
    } ]
  }, {
    "tStartMs": 771715,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "These differences are tiny."
    } ]
  }, {
    "tStartMs": 772995,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Jumping from the 0 to\nthe +/-1 levels requires"
    } ]
  }, {
    "tStartMs": 775715,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "only a small amount of energy."
    } ]
  }, {
    "tStartMs": 777395,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "A microwave photon of 10.4\ncentimeters will be enough."
    } ]
  }, {
    "tStartMs": 781715,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Now, these secret energy platforms"
    } ]
  }, {
    "tStartMs": 783555,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "of NV centers were mapped out by the '90s."
    } ]
  }, {
    "tStartMs": 786835,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "But for a long time,"
    } ]
  }, {
    "tStartMs": 787715,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "no one thought to use\nthem as magnetometers."
    } ]
  }, {
    "tStartMs": 789635,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- There was a decade before\nthe light bulb went on"
    } ]
  }, {
    "tStartMs": 792435,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "for a bunch of us to think\nabout them as sensors."
    } ]
  }, {
    "tStartMs": 794435,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It takes a mindset switch\nto think differently."
    } ]
  }, {
    "tStartMs": 797395,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And once you do, you realize,"
    } ]
  }, {
    "tStartMs": 798755,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "\"Oh my goodness, this could be useful.\""
    } ]
  }, {
    "tStartMs": 800995,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- So let's apply a magnetic\nfield to this diamond"
    } ]
  }, {
    "tStartMs": 804035,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and see what happens."
    } ]
  }, {
    "tStartMs": 805955,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "If we slowly turn up the field strength,"
    } ]
  }, {
    "tStartMs": 808195,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "you'll see that the +1 and -1\nlevels are starting to shift."
    } ]
  }, {
    "tStartMs": 812275,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "To understand why,"
    } ]
  }, {
    "tStartMs": 813315,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "we can use a compass needle as an analogy."
    } ]
  }, {
    "tStartMs": 816355,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Naturally, a compass\nneedle will align itself"
    } ]
  }, {
    "tStartMs": 818755,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with the magnetic field of the Earth."
    } ]
  }, {
    "tStartMs": 821075,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And this is the lowest\nenergy relaxed state"
    } ]
  }, {
    "tStartMs": 824195,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that the needle can be in."
    } ]
  }, {
    "tStartMs": 826115,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And it's analogous to the\nbehavior of the system"
    } ]
  }, {
    "tStartMs": 828835,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "in the ms = -1 state,"
    } ]
  }, {
    "tStartMs": 831155,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "which is why its energy\nlevel drops slightly."
    } ]
  }, {
    "tStartMs": 834115,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "But if ms = 1, the system flips."
    } ]
  }, {
    "tStartMs": 837875,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "This would be like\ntaking an external magnet"
    } ]
  }, {
    "tStartMs": 840195,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and applying it to this compass needle,"
    } ]
  }, {
    "tStartMs": 842275,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "flipping it 180 degrees."
    } ]
  }, {
    "tStartMs": 844435,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And then if I'm careful\nin retracting this magnet,"
    } ]
  }, {
    "tStartMs": 847555,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "I can actually get the\nneedle to stay in this place."
    } ]
  }, {
    "tStartMs": 851715,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And this is the highest\nenergy this needle can have"
    } ]
  }, {
    "tStartMs": 854915,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "sitting in this unstable position."
    } ]
  }, {
    "tStartMs": 857155,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now if I tap it, it will actually go back."
    } ]
  }, {
    "tStartMs": 859795,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It's possible, but it's\na higher energy state."
    } ]
  }, {
    "tStartMs": 862755,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So the ms = 1 level slightly rises."
    } ]
  }, {
    "tStartMs": 866275,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And if ms = 0, it doesn't\nreact to the field,"
    } ]
  }, {
    "tStartMs": 868835,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which is why this level hasn't changed."
    } ]
  }, {
    "tStartMs": 871235,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now, if you keep turning up\nthe magnetic field strength,"
    } ]
  }, {
    "tStartMs": 874035,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "you'll notice that the levels\nget further and further apart."
    } ]
  }, {
    "tStartMs": 877235,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This phenomenon is\ncalled Zeeman splitting."
    } ]
  }, {
    "tStartMs": 879635,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It's described by a simple formula"
    } ]
  }, {
    "tStartMs": 881395,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that gives you a direct link\nbetween the energy split"
    } ]
  }, {
    "tStartMs": 884115,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and the magnetic field strength."
    } ]
  }, {
    "tStartMs": 886115,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So in the presence of a\nperiodic magnetic field"
    } ]
  }, {
    "tStartMs": 888755,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "like that generated by the heart,"
    } ]
  }, {
    "tStartMs": 890675,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "we would theoretically\nsee a rhythmic separation"
    } ]
  }, {
    "tStartMs": 893715,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "of these lines."
    } ]
  }, {
    "tStartMs": 895075,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And these two energy levels absorb light"
    } ]
  }, {
    "tStartMs": 897795,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "at two different microwave wavelengths,"
    } ]
  }, {
    "tStartMs": 900355,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "which change depending on\nthe strength of the field."
    } ]
  }, {
    "tStartMs": 903395,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So what we can actually measure is"
    } ]
  }, {
    "tStartMs": 905555,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "which microwave wavelengths\nthe diamond is absorbing."
    } ]
  }, {
    "tStartMs": 908595,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "When there's no magnetic field,"
    } ]
  }, {
    "tStartMs": 909955,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the levels are fused and\nproduce a single absorption line"
    } ]
  }, {
    "tStartMs": 912755,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "at the wavelength of 10.4 centimeters."
    } ]
  }, {
    "tStartMs": 915715,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But when there's an\nexternal magnetic field,"
    } ]
  }, {
    "tStartMs": 917875,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "they produce two separate\nabsorption lines."
    } ]
  }, {
    "tStartMs": 920755,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Now, we've simplified it a bit,"
    } ]
  }, {
    "tStartMs": 922115,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but by measuring how spaced\napart these lines are,"
    } ]
  }, {
    "tStartMs": 925475,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you get the field strength."
    } ]
  }, {
    "tStartMs": 927475,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "This is how an NV diamond\nmagnetometer works."
    } ]
  }, {
    "tStartMs": 930915,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Was the diamond magnetometer ever used"
    } ]
  }, {
    "tStartMs": 932675,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to detect a heartbeat?"
    } ]
  }, {
    "tStartMs": 933635,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- So what has been done\nfor sure is, you know,"
    } ]
  }, {
    "tStartMs": 935635,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for certain is detection"
    } ]
  }, {
    "tStartMs": 937555,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of magnetic fields generated by neurons."
    } ]
  }, {
    "tStartMs": 939955,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Yeah, I mean, which is\nto some extent connected"
    } ]
  }, {
    "tStartMs": 942755,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to the heartbeat question."
    } ]
  }, {
    "tStartMs": 944115,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Neuron activity, to my knowledge,"
    } ]
  }, {
    "tStartMs": 945875,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "has been first seen in 2015."
    } ]
  }, {
    "tStartMs": 948195,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "- Okay, well, that's,\nwow, that's impressive."
    } ]
  }, {
    "tStartMs": 952195,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So could it pick up a\nheartbeat from kilometers away?"
    } ]
  }, {
    "tStartMs": 955315,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Well, in 2022, researchers were able"
    } ]
  }, {
    "tStartMs": 957635,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "to pick up the magnetic\nfield of a rat's heart,"
    } ]
  }, {
    "tStartMs": 960435,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "but it was done using a thoracotomy,"
    } ]
  }, {
    "tStartMs": 962515,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which means the rat's chest was open"
    } ]
  }, {
    "tStartMs": 964515,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and the diamond was less\nthan two millimeters away"
    } ]
  }, {
    "tStartMs": 966835,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "from the heart."
    } ]
  }, {
    "tStartMs": 968355,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Okay, but the human heart produces"
    } ]
  }, {
    "tStartMs": 970275,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "a stronger magnetic field."
    } ]
  }, {
    "tStartMs": 971555,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And the tech, the CIA might have deployed,"
    } ]
  }, {
    "tStartMs": 973715,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "could be decades ahead of\nwhat is publicly known."
    } ]
  }, {
    "tStartMs": 976275,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "You're former CIA operations officer"
    } ]
  }, {
    "tStartMs": 978755,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and you've worked in\nthe Middle East, right?"
    } ]
  }, {
    "tStartMs": 981635,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "So what was your first\nreaction to this news?"
    } ]
  }, {
    "tStartMs": 984475,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- Well, the fact that the CIA's involved"
    } ]
  }, {
    "tStartMs": 987795,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in leveraging technology is consistent"
    } ]
  }, {
    "tStartMs": 990195,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "with their mission and their charter."
    } ]
  }, {
    "tStartMs": 992035,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But I defer to smarter\npeople in engineering"
    } ]
  }, {
    "tStartMs": 994435,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and science like yourself"
    } ]
  }, {
    "tStartMs": 995635,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to figure out the exact\ntechnique that might be used."
    } ]
  }, {
    "tStartMs": 999315,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But the processes, of\ncourse, are consistent"
    } ]
  }, {
    "tStartMs": 1001155,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "for what we've done."
    } ]
  }, {
    "tStartMs": 1002115,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- We can't say for sure\nwhether the CIA has this tech,"
    } ]
  }, {
    "tStartMs": 1005075,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "but we can use physics to estimate"
    } ]
  }, {
    "tStartMs": 1006675,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "how sensitive it would need to be."
    } ]
  }, {
    "tStartMs": 1009235,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Well, the strength of a\nmagnetic field falls off"
    } ]
  }, {
    "tStartMs": 1011795,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "with the cube of the\ndistance from the source."
    } ]
  }, {
    "tStartMs": 1014035,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So if the magnetic field of the heart"
    } ]
  }, {
    "tStartMs": 1015715,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "when measured at the\nchest is 50 pico Tesla,"
    } ]
  }, {
    "tStartMs": 1018995,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "or 5 times 10 to the -11 Tesla,"
    } ]
  }, {
    "tStartMs": 1021795,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "well, then just 100 meters away,"
    } ]
  }, {
    "tStartMs": 1024035,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "this falls off by a factor of a billion"
    } ]
  }, {
    "tStartMs": 1026355,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to 5 times 10 to the -20 Tesla."
    } ]
  }, {
    "tStartMs": 1029235,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And at 50 to 100 kilometers,"
    } ]
  }, {
    "tStartMs": 1031555,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "this could drop to as little\nas 10 to the -30 Tesla."
    } ]
  }, {
    "tStartMs": 1035555,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- The most sensitive measurement ever made"
    } ]
  }, {
    "tStartMs": 1038595,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "at the frequencies that the\nhuman heartbeat work at is"
    } ]
  }, {
    "tStartMs": 1042035,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "at the 10 to the -15 Tesla level."
    } ]
  }, {
    "tStartMs": 1045235,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And that's in a shielded room."
    } ]
  }, {
    "tStartMs": 1047075,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So you'd need a system"
    } ]
  }, {
    "tStartMs": 1049715,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that is 15 orders of\nmagnitude more sensitive"
    } ]
  }, {
    "tStartMs": 1052835,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "than the superconducting\nquantum interference devices"
    } ]
  }, {
    "tStartMs": 1056995,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and 18 orders of magnitude more sensitive"
    } ]
  }, {
    "tStartMs": 1060675,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "than diamond NV sensors."
    } ]
  }, {
    "tStartMs": 1063235,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "- 18 orders of magnitude is a\nlot, sounds quite unfeasible."
    } ]
  }, {
    "tStartMs": 1067715,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "- It's not like the hills of\nIran are devoid of animal life."
    } ]
  }, {
    "tStartMs": 1072515,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "They also have heartbeats"
    } ]
  }, {
    "tStartMs": 1074035,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and possibly larger hearts than humans."
    } ]
  }, {
    "tStartMs": 1076795,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- There's also the\nmagnetic field of the drone"
    } ]
  }, {
    "tStartMs": 1079475,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "or the helicopter the\ndevice might be mounted on."
    } ]
  }, {
    "tStartMs": 1082035,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And, finally, there's the fact"
    } ]
  }, {
    "tStartMs": 1083395,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "that a magnetic field of 10\nto the -30 Tesla is weaker"
    } ]
  }, {
    "tStartMs": 1087635,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "than a magnetic field an\nelectron will give you"
    } ]
  }, {
    "tStartMs": 1090275,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "a meter away."
    } ]
  }, {
    "tStartMs": 1091395,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- The New York Post is\nnotoriously a very good place"
    } ]
  }, {
    "tStartMs": 1095475,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "for amusing fiction."
    } ]
  }, {
    "tStartMs": 1096715,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- On the day before we saw this article,"
    } ]
  }, {
    "tStartMs": 1100035,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "we also saw an article"
    } ]
  }, {
    "tStartMs": 1101635,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "about how they had a technology\nwhere it was a beeper."
    } ]
  }, {
    "tStartMs": 1108949,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "and that was one way that\nthey were able to detect him."
    } ]
  }, {
    "tStartMs": 1114069,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And these are things that\nwe know about already."
    } ]
  }, {
    "tStartMs": 1117829,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "We also know that there may well have been"
    } ]
  }, {
    "tStartMs": 1120389,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "other intelligence methods used,"
    } ]
  }, {
    "tStartMs": 1124309,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "but this isn't really necessary."
    } ]
  }, {
    "tStartMs": 1125949,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- And then that brings\nyou to the point of like,"
    } ]
  }, {
    "tStartMs": 1128309,
    "dDurationMs": 2076,
    "segs": [ {
      "utf8": "why would they make this up?"
    } ]
  }, {
    "tStartMs": 1130385,
    "dDurationMs": 2964,
    "segs": [ {
      "utf8": "- I think New York Post is\nknown to print a lot of stuff."
    } ]
  }, {
    "tStartMs": 1133349,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "- I'm not a real fan of the credibility"
    } ]
  }, {
    "tStartMs": 1137509,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of the press to report things,"
    } ]
  }, {
    "tStartMs": 1139189,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "having seen reality and then\nseeing what the press reports."
    } ]
  }, {
    "tStartMs": 1142309,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- How about deception stories"
    } ]
  }, {
    "tStartMs": 1144549,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and like false narratives\npublished by not only the CIA,"
    } ]
  }, {
    "tStartMs": 1147989,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but other agencies?"
    } ]
  }, {
    "tStartMs": 1149749,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Is this often the case?"
    } ]
  }, {
    "tStartMs": 1151189,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- If you look historically,"
    } ]
  }, {
    "tStartMs": 1152709,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "the idea of fooling your enemy,"
    } ]
  }, {
    "tStartMs": 1155429,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "particularly when you have\nsome vulnerability to protect,"
    } ]
  }, {
    "tStartMs": 1159029,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "goes back thousands of years."
    } ]
  }, {
    "tStartMs": 1160749,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- During World War II,"
    } ]
  }, {
    "tStartMs": 1162309,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "German bombers frequently\nattacked Britain at night."
    } ]
  }, {
    "tStartMs": 1165029,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And to retaliate, the British\nwould fly up to intercept"
    } ]
  }, {
    "tStartMs": 1167829,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and somehow kept finding\nthese bombers in the dark"
    } ]
  }, {
    "tStartMs": 1170629,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and would attack them."
    } ]
  }, {
    "tStartMs": 1172069,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Now, UK officials told the press"
    } ]
  }, {
    "tStartMs": 1173909,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that the pilots were able to do this"
    } ]
  }, {
    "tStartMs": 1175509,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "because they ate a lot of carrots,"
    } ]
  }, {
    "tStartMs": 1177029,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "which was improving their vision at night."
    } ]
  }, {
    "tStartMs": 1179749,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "But some experts believe"
    } ]
  }, {
    "tStartMs": 1181109,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that this was actually a cover story"
    } ]
  }, {
    "tStartMs": 1182789,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "meant to distract the Germans"
    } ]
  }, {
    "tStartMs": 1184229,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "from the fact the British\ninstalled radars on their planes."
    } ]
  }, {
    "tStartMs": 1187749,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- Is that where the idea"
    } ]
  }, {
    "tStartMs": 1189509,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that carrots give you\ngood eyesight comes from?"
    } ]
  }, {
    "tStartMs": 1192229,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "- I think so."
    } ]
  }, {
    "tStartMs": 1193109,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I think this is the original,\nyeah, the original myth."
    } ]
  }, {
    "tStartMs": 1195509,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- That is crazy.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1197669,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- But, okay, there's one\nthing that still bothers me."
    } ]
  }, {
    "tStartMs": 1200309,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "If this is likely fake,"
    } ]
  }, {
    "tStartMs": 1202629,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "then why is everyone saying no comment"
    } ]
  }, {
    "tStartMs": 1204869,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and declining to talk?"
    } ]
  }, {
    "tStartMs": 1206069,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "There must be something here, you know?"
    } ]
  }, {
    "tStartMs": 1208129,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- Well, these NV centers\nand diamonds are also used"
    } ]
  }, {
    "tStartMs": 1210709,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "for quantum computing."
    } ]
  }, {
    "tStartMs": 1211989,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "But the more interesting,"
    } ]
  }, {
    "tStartMs": 1213269,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "probably confidential\nway they could be used is"
    } ]
  }, {
    "tStartMs": 1216389,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "as navigation devices."
    } ]
  }, {
    "tStartMs": 1217989,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The Earth's magnetic field\ncreates a unique pattern"
    } ]
  }, {
    "tStartMs": 1221029,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "all across the globe."
    } ]
  }, {
    "tStartMs": 1222149,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "- Then to place an object into this map,"
    } ]
  }, {
    "tStartMs": 1226469,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and if you know all of these perturbations"
    } ]
  }, {
    "tStartMs": 1230389,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and in homogeneities,"
    } ]
  }, {
    "tStartMs": 1231749,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you can infer where you are"
    } ]
  }, {
    "tStartMs": 1233429,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "without having any GPS reception anymore."
    } ]
  }, {
    "tStartMs": 1236549,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- With the rise of GPS spoofing"
    } ]
  }, {
    "tStartMs": 1239269,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and jamming over the last couple of years,"
    } ]
  }, {
    "tStartMs": 1241029,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that could be incredibly powerful."
    } ]
  }, {
    "tStartMs": 1243109,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So NV magnetometers do exist\nwith these synthetic diamonds,"
    } ]
  }, {
    "tStartMs": 1247349,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and they do have potential\nmilitary applications."
    } ]
  }, {
    "tStartMs": 1250229,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It's just that detecting\nheartbeats kilometers away"
    } ]
  }, {
    "tStartMs": 1253189,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "probably isn't one of them."
    } ]
  }, {
    "tStartMs": 1258549,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "I wanna give a shout-out"
    } ]
  }, {
    "tStartMs": 1259429,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to a great Scientific American article"
    } ]
  }, {
    "tStartMs": 1261349,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "on this story by Deni Béchard"
    } ]
  }, {
    "tStartMs": 1263269,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that initially expressed\nskepticism in Ghost Murmur"
    } ]
  }, {
    "tStartMs": 1266629,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "as a potential technology."
    } ]
  }, {
    "tStartMs": 1268229,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "It's a great read and you check it out."
    } ]
  } ]
}
