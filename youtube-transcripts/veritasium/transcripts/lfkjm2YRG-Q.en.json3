{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "- This is the biggest..."
    } ]
  }, {
    "tStartMs": 2283,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "hottest..."
    } ]
  }, {
    "tStartMs": 3383,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "and most explosive-"
    } ]
  }, {
    "tStartMs": 5141,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "- Oh my god."
    } ]
  }, {
    "tStartMs": 6570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Video on fireworks ever,"
    } ]
  }, {
    "tStartMs": 8970,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "covering everything from\nthe invention of gunpowder"
    } ]
  }, {
    "tStartMs": 11940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to how fire can burn underwater,"
    } ]
  }, {
    "tStartMs": 14880,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "how fireworks are made,\nthe colors, shapes, fuses."
    } ]
  }, {
    "tStartMs": 20370,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "To how they're launched."
    } ]
  }, {
    "tStartMs": 22470,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "We'll even see what it's like\nto fly through fireworks."
    } ]
  }, {
    "tStartMs": 25733,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(fireworks popping)"
    } ]
  }, {
    "tStartMs": 30600,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Mr. Beast has got nothing on this."
    } ]
  }, {
    "tStartMs": 33990,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "This video was sponsored by KiwiCo."
    } ]
  }, {
    "tStartMs": 35940,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 38163,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(drone buzzing)"
    } ]
  }, {
    "tStartMs": 44130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- I cannot believe the precision"
    } ]
  }, {
    "tStartMs": 45510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with that huge camera on there."
    } ]
  }, {
    "tStartMs": 47670,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Gene is gonna try to fly the FPV drone"
    } ]
  }, {
    "tStartMs": 50100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "actually like through the\nfireworks as they explode."
    } ]
  }, {
    "tStartMs": 53160,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You ready Gene?"
    } ]
  }, {
    "tStartMs": 54870,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I think So."
    } ]
  }, {
    "tStartMs": 55703,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "- Gene makes the channel called Potato Jet"
    } ]
  }, {
    "tStartMs": 57930,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and he does tech reviews,"
    } ]
  }, {
    "tStartMs": 59490,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but also lots of very filmic stuff."
    } ]
  }, {
    "tStartMs": 62580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Gene] Lot of-"
    } ]
  }, {
    "tStartMs": 63413,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Lot of drone work."
    } ]
  }, {
    "tStartMs": 64246,
    "dDurationMs": 1248,
    "segs": [ {
      "utf8": "- Lately a lot of drone stuff."
    } ]
  }, {
    "tStartMs": 65494,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 66327,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "- A lot of fast drone stuff.\n- FPV drones."
    } ]
  }, {
    "tStartMs": 68430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Like this one.\n- this one."
    } ]
  }, {
    "tStartMs": 69840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Are you willing to fly\nthis into a firework"
    } ]
  }, {
    "tStartMs": 72480,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "as it's exploding?"
    } ]
  }, {
    "tStartMs": 73320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's the goal."
    } ]
  }, {
    "tStartMs": 74153,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "If I can catch it, that's the hope."
    } ]
  }, {
    "tStartMs": 76380,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "But we set it up just for that.\nSo I think we could get it."
    } ]
  }, {
    "tStartMs": 79713,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(drone buzzing)"
    } ]
  }, {
    "tStartMs": 83520,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- The first recorded instance\nof something like a firework"
    } ]
  }, {
    "tStartMs": 86550,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "occurred in China over 2000 years ago"
    } ]
  }, {
    "tStartMs": 89340,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where people would get a piece of bamboo"
    } ]
  }, {
    "tStartMs": 92040,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "with the ends closed and they\nwould throw it in a fire."
    } ]
  }, {
    "tStartMs": 95850,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "So as it heated up,"
    } ]
  }, {
    "tStartMs": 96870,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "everything inside would get hot and expand"
    } ]
  }, {
    "tStartMs": 98700,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and eventually burst, creating this bang,"
    } ]
  }, {
    "tStartMs": 101580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which they thought\nscared off evil spirits."
    } ]
  }, {
    "tStartMs": 104640,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Then they developed black powder"
    } ]
  }, {
    "tStartMs": 106230,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and they put black\npowder inside the bamboo"
    } ]
  }, {
    "tStartMs": 108090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to make an even bigger bang."
    } ]
  }, {
    "tStartMs": 109890,
    "dDurationMs": 2116,
    "segs": [ {
      "utf8": "That was much more impressive."
    } ]
  }, {
    "tStartMs": 112006,
    "dDurationMs": 4364,
    "segs": [ {
      "utf8": "I wanna test out the earliest\nknown recipe for gunpowder."
    } ]
  }, {
    "tStartMs": 116370,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It involves three ingredients"
    } ]
  }, {
    "tStartMs": 118560,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that you can find out in nature."
    } ]
  }, {
    "tStartMs": 120780,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The first is potassium nitrate,"
    } ]
  }, {
    "tStartMs": 123060,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which actually comes\nfrom bat and bird guano."
    } ]
  }, {
    "tStartMs": 125610,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Once they poop in the cave\nand it dissolves in water,"
    } ]
  }, {
    "tStartMs": 128970,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you get these white crystals coming out."
    } ]
  }, {
    "tStartMs": 131160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The second ingredient is sulfur."
    } ]
  }, {
    "tStartMs": 133080,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "These yellow crystals you can\njust find on the side of hills"
    } ]
  }, {
    "tStartMs": 136800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "or around thermal vents."
    } ]
  }, {
    "tStartMs": 138300,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And the third ingredient is honey."
    } ]
  }, {
    "tStartMs": 140430,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "That is the major fuel for the gunpowder."
    } ]
  }, {
    "tStartMs": 143130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Now I'm gonna mix this all up."
    } ]
  }, {
    "tStartMs": 144900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Looks like it could be frosting."
    } ]
  }, {
    "tStartMs": 146580,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "So yummy."
    } ]
  }, {
    "tStartMs": 149430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Earliest known recipe for gunpowder."
    } ]
  }, {
    "tStartMs": 151350,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "What people observed was when\nthey heated up this mixture,"
    } ]
  }, {
    "tStartMs": 154890,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "it would spontaneously catch fire."
    } ]
  }, {
    "tStartMs": 158520,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I have no idea how big of\na thing this is gonna be."
    } ]
  }, {
    "tStartMs": 161520,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "This is only about a gram of it,"
    } ]
  }, {
    "tStartMs": 163290,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "so I don't think it's gonna be huge."
    } ]
  }, {
    "tStartMs": 165150,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "As we heat up that very\nprimitive gunpowder,"
    } ]
  }, {
    "tStartMs": 167430,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "we should see it burst into flames."
    } ]
  }, {
    "tStartMs": 169560,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "It's gotta be close."
    } ]
  }, {
    "tStartMs": 170490,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Here we go. Here we go."
    } ]
  }, {
    "tStartMs": 171720,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Yes, we have made gunpowder."
    } ]
  }, {
    "tStartMs": 175830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now that took a long time\nbefore we saw the fire."
    } ]
  }, {
    "tStartMs": 178590,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So why is that?"
    } ]
  }, {
    "tStartMs": 180570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Well, honey contains a lot of water"
    } ]
  }, {
    "tStartMs": 183030,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and that's gonna slow down the rate"
    } ]
  }, {
    "tStartMs": 185100,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "at which this is gonna start to combust."
    } ]
  }, {
    "tStartMs": 187260,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "People figured out that a\nbetter fuel was charcoal."
    } ]
  }, {
    "tStartMs": 190740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "There are three things\nyou need to make fire,"
    } ]
  }, {
    "tStartMs": 193290,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "fuel, oxygen and heat."
    } ]
  }, {
    "tStartMs": 196500,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "In most fires, the oxygen\ncomes from the air,"
    } ]
  }, {
    "tStartMs": 200040,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "but in gunpowder,"
    } ]
  }, {
    "tStartMs": 201180,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the oxygen is supplied by\none of the solid ingredients."
    } ]
  }, {
    "tStartMs": 204540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The potassium nitrate\ngives you the oxygen."
    } ]
  }, {
    "tStartMs": 206790,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It's KNO3, so there's a\nlot of oxygen in here."
    } ]
  }, {
    "tStartMs": 209640,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And then the charcoal provides\nthe fuel, that carbon."
    } ]
  }, {
    "tStartMs": 212670,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Charcoal is basically just carbon,"
    } ]
  }, {
    "tStartMs": 214920,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "but it works better than other\nforms of carbon like graphite"
    } ]
  }, {
    "tStartMs": 218460,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "because it contains\nthese microscopic pores"
    } ]
  }, {
    "tStartMs": 221686,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "and that enables the\nreactants to mix much better."
    } ]
  }, {
    "tStartMs": 224940,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "They can actually get inside those pores."
    } ]
  }, {
    "tStartMs": 227490,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So if you mix potassium\nnitrate with the fuel, charcoal"
    } ]
  }, {
    "tStartMs": 231030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and add heat from a lighter,"
    } ]
  }, {
    "tStartMs": 232860,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "you should have all the\ningredients you need to make fire."
    } ]
  }, {
    "tStartMs": 236070,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "So the question is, will this burn?"
    } ]
  }, {
    "tStartMs": 239850,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It seems like little bits\nof it are catching on fire"
    } ]
  }, {
    "tStartMs": 242670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and just like sparking up from there."
    } ]
  }, {
    "tStartMs": 244860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "But the trouble with this reaction"
    } ]
  }, {
    "tStartMs": 246450,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is that it has a high activation energy."
    } ]
  }, {
    "tStartMs": 249030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So it needs a lot of heat to get going."
    } ]
  }, {
    "tStartMs": 252060,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Whoa."
    } ]
  }, {
    "tStartMs": 253470,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "There it goes."
    } ]
  }, {
    "tStartMs": 256230,
    "dDurationMs": 1496,
    "segs": [ {
      "utf8": "That is cool."
    } ]
  }, {
    "tStartMs": 257726,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(cheerful music)"
    } ]
  }, {
    "tStartMs": 261420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I can see little balls of molten stuff"
    } ]
  }, {
    "tStartMs": 264150,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "in the crucible there."
    } ]
  }, {
    "tStartMs": 265140,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "That is awesome."
    } ]
  }, {
    "tStartMs": 267330,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So we do have oxygen and fuel\nand we can get that reaction,"
    } ]
  }, {
    "tStartMs": 270540,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "but it's just not a\nvery explosive reaction."
    } ]
  }, {
    "tStartMs": 274440,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "This is where the sulfur comes in."
    } ]
  }, {
    "tStartMs": 276510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Sulfur starts reacting\nwith the other ingredients"
    } ]
  }, {
    "tStartMs": 279090,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "at lower temperatures, and\nthose reactions give off heat."
    } ]
  }, {
    "tStartMs": 283020,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The sulfur is gonna act like kindling."
    } ]
  }, {
    "tStartMs": 284850,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "It's gonna create that initial bit of heat"
    } ]
  }, {
    "tStartMs": 286683,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "that the potassium nitrate\nneeds to really break it open"
    } ]
  }, {
    "tStartMs": 289920,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and then, you know, everything can react."
    } ]
  }, {
    "tStartMs": 291690,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So that's what I wanna do,\nI wanna try to mix sulfur,"
    } ]
  }, {
    "tStartMs": 294060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "potassium nitrate and charcoal,"
    } ]
  }, {
    "tStartMs": 295800,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "which is like your quintessential\nrecipe for gunpowder."
    } ]
  }, {
    "tStartMs": 299850,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And the amounts that you need of this"
    } ]
  }, {
    "tStartMs": 301560,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "have been pretty stable\nfor like 800 years,"
    } ]
  }, {
    "tStartMs": 305100,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "which is about 75% potassium\nnitrate, 10% sulfur,"
    } ]
  }, {
    "tStartMs": 311040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and 15% charcoal."
    } ]
  }, {
    "tStartMs": 312870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Those are the right mixtures"
    } ]
  }, {
    "tStartMs": 314550,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "so that you have just the right\nnumber of each type of atom"
    } ]
  }, {
    "tStartMs": 317100,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "to fully react and release\nthe most energy possible."
    } ]
  }, {
    "tStartMs": 320760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So I wanna test how long it\ntakes for fire to burn down"
    } ]
  }, {
    "tStartMs": 324240,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "about a meter of this homemade gunpowder."
    } ]
  }, {
    "tStartMs": 327660,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Let's let her rip."
    } ]
  }, {
    "tStartMs": 329400,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "There it goes."
    } ]
  }, {
    "tStartMs": 332160,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "Hey, it's going so slow."
    } ]
  }, {
    "tStartMs": 335810,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 339480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Come on, you can do it."
    } ]
  }, {
    "tStartMs": 341940,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Go, go,"
    } ]
  }, {
    "tStartMs": 344370,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "go, go, go."
    } ]
  }, {
    "tStartMs": 346380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Wow, it made it to the end."
    } ]
  }, {
    "tStartMs": 349020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "You know what I think the problem is"
    } ]
  }, {
    "tStartMs": 350640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the granules of charcoal that I've got"
    } ]
  }, {
    "tStartMs": 353640,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "and these grains of potassium\nnitrate, even the sulfur,"
    } ]
  }, {
    "tStartMs": 357750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "they're all a bit big."
    } ]
  }, {
    "tStartMs": 359580,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So to actually get that\nreaction to happen fast,"
    } ]
  }, {
    "tStartMs": 362730,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "it's not really working."
    } ]
  }, {
    "tStartMs": 365460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So what I wanna do is compare that"
    } ]
  }, {
    "tStartMs": 367410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to store bought gun powder from, you know,"
    } ]
  }, {
    "tStartMs": 370500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a factory that's actually\nground up all those particles"
    } ]
  }, {
    "tStartMs": 372900,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "to be really tiny."
    } ]
  }, {
    "tStartMs": 373920,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "So all the reagents are\nreally close together."
    } ]
  }, {
    "tStartMs": 378483,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh my..."
    } ]
  }, {
    "tStartMs": 379316,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "- Whoo!"
    } ]
  }, {
    "tStartMs": 380670,
    "dDurationMs": 1788,
    "segs": [ {
      "utf8": "- That is impressive."
    } ]
  }, {
    "tStartMs": 382458,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 389466,
    "dDurationMs": 894,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 390360,
    "dDurationMs": 995,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 391355,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "That is gunpowder."
    } ]
  }, {
    "tStartMs": 393690,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "That makes mine look so amateur."
    } ]
  }, {
    "tStartMs": 397470,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The chemical reaction that occurs"
    } ]
  }, {
    "tStartMs": 399120,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "in the combustion of\ngunpowder is complicated,"
    } ]
  }, {
    "tStartMs": 402150,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to say the least."
    } ]
  }, {
    "tStartMs": 403350,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But a number of the\nproducts formed are solids,"
    } ]
  }, {
    "tStartMs": 406680,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and that's why burning gunpowder\ncreates a lot of smoke."
    } ]
  }, {
    "tStartMs": 410880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The neighbors have gotta be\nlooking at this and being like-"
    } ]
  }, {
    "tStartMs": 413520,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "- That is so...\n- What the..."
    } ]
  }, {
    "tStartMs": 415167,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "The thing about gun\npowder is if you burn it"
    } ]
  }, {
    "tStartMs": 417780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "when it's just exposed to the air,"
    } ]
  }, {
    "tStartMs": 420210,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "it doesn't really explode."
    } ]
  }, {
    "tStartMs": 421710,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And I think of gunpowder as explosive."
    } ]
  }, {
    "tStartMs": 424050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But in order to see that, what\nyou have to do is confine it."
    } ]
  }, {
    "tStartMs": 427020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Because when you confine gun powder,"
    } ]
  }, {
    "tStartMs": 429060,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "you increase the concentration\nof all the reagents."
    } ]
  }, {
    "tStartMs": 431940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They don't just blow away from each other"
    } ]
  }, {
    "tStartMs": 433920,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "when they catch fire."
    } ]
  }, {
    "tStartMs": 434850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So they're forced into closer\nproximity, so they react more."
    } ]
  }, {
    "tStartMs": 437790,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Plus you trap more of the heat,"
    } ]
  }, {
    "tStartMs": 439870,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "so the reagents get moving\nfaster, they have more energy,"
    } ]
  }, {
    "tStartMs": 443520,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "and so they can react more readily."
    } ]
  }, {
    "tStartMs": 446321,
    "dDurationMs": 4009,
    "segs": [ {
      "utf8": "So I put 10 grams of\ngunpowder in a cardboard tube"
    } ]
  }, {
    "tStartMs": 450330,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "and taped it shut."
    } ]
  }, {
    "tStartMs": 453296,
    "dDurationMs": 1654,
    "segs": [ {
      "utf8": "(explosion pops)"
    } ]
  }, {
    "tStartMs": 454950,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Okay, that's better."
    } ]
  }, {
    "tStartMs": 456150,
    "dDurationMs": 2808,
    "segs": [ {
      "utf8": "But it wasn't as big of a\nbang as I was hoping for."
    } ]
  }, {
    "tStartMs": 458958,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Well, it was a bit more\nof a pop than than a bang."
    } ]
  }, {
    "tStartMs": 461460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Maybe we need a tighter vessel, I think."
    } ]
  }, {
    "tStartMs": 463410,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So I'm gonna use some\nfiber reinforced tape"
    } ]
  }, {
    "tStartMs": 466170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to strengthen the container,"
    } ]
  }, {
    "tStartMs": 468000,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "and then we should get a bigger bang."
    } ]
  }, {
    "tStartMs": 471578,
    "dDurationMs": 2092,
    "segs": [ {
      "utf8": "(explosion booms)\nOoh!"
    } ]
  }, {
    "tStartMs": 473670,
    "dDurationMs": 1294,
    "segs": [ {
      "utf8": "- It went right past me."
    } ]
  }, {
    "tStartMs": 474964,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "(explosion booms)"
    } ]
  }, {
    "tStartMs": 476940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- It's more of a bang.\nThat's a bit more like it."
    } ]
  }, {
    "tStartMs": 479160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Here I have 20 grams of black powder."
    } ]
  }, {
    "tStartMs": 481110,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So I guess the question is\nwith twice the black powder,"
    } ]
  }, {
    "tStartMs": 484320,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "do we get twice the bang?"
    } ]
  }, {
    "tStartMs": 486030,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "Here we go, everyone get back."
    } ]
  }, {
    "tStartMs": 490188,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(explosion booming)"
    } ]
  }, {
    "tStartMs": 496020,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This is essentially what a firework is."
    } ]
  }, {
    "tStartMs": 499080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I mean, fireworks consist of a shell"
    } ]
  }, {
    "tStartMs": 501390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "with a lot of gunpowder inside."
    } ]
  }, {
    "tStartMs": 503760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- So, this is an inert shell."
    } ]
  }, {
    "tStartMs": 505590,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "It's colorized"
    } ]
  }, {
    "tStartMs": 506490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "so that you can see the\nindividual pieces better."
    } ]
  }, {
    "tStartMs": 508860,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "A real shell, everything\nin here would be black"
    } ]
  }, {
    "tStartMs": 511170,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "because it would be primed\nor covered with black powder."
    } ]
  }, {
    "tStartMs": 514200,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "- Actually a note about terminology."
    } ]
  }, {
    "tStartMs": 516167,
    "dDurationMs": 3193,
    "segs": [ {
      "utf8": "For a long time the terms\ngunpowder and black powder"
    } ]
  }, {
    "tStartMs": 519360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "were used in interchangeably."
    } ]
  }, {
    "tStartMs": 521220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But these days the formula\nfor gunpowder has changed"
    } ]
  }, {
    "tStartMs": 524100,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to make it smokeless."
    } ]
  }, {
    "tStartMs": 525630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So what's used in fireworks is called,"
    } ]
  }, {
    "tStartMs": 527880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "at least in the US, black powder,"
    } ]
  }, {
    "tStartMs": 529890,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "to distinguish it from\nmodern smokeless gunpowder."
    } ]
  }, {
    "tStartMs": 533820,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Just know that in this\nvideo we'll use both terms"
    } ]
  }, {
    "tStartMs": 536010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to mean basically the same thing."
    } ]
  }, {
    "tStartMs": 538110,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- The shell itself is made out a cardboard"
    } ]
  }, {
    "tStartMs": 540180,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and what looks like and\nis a form of paper mache"
    } ]
  }, {
    "tStartMs": 543750,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "with craft paper and a glue."
    } ]
  }, {
    "tStartMs": 546330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And you go around and around"
    } ]
  }, {
    "tStartMs": 547740,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "once you put the two\nshell halves together."
    } ]
  }, {
    "tStartMs": 549510,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Is that like the standard\nsize you'd see when you go out?"
    } ]
  }, {
    "tStartMs": 551700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- So on a 4th of July display,"
    } ]
  }, {
    "tStartMs": 554040,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "you'll see anything\nfrom two and a half inch"
    } ]
  }, {
    "tStartMs": 556710,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "up to five inch typically."
    } ]
  }, {
    "tStartMs": 558480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "In most cases, six inch and above"
    } ]
  }, {
    "tStartMs": 561540,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "are reserved for locations\nthat you have a huge property,"
    } ]
  }, {
    "tStartMs": 565410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you're out in some desert shoot site"
    } ]
  }, {
    "tStartMs": 567270,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "or on a barge somewhere."
    } ]
  }, {
    "tStartMs": 568590,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "But they can go even bigger\nthan this, up to 12 inch, 16"
    } ]
  }, {
    "tStartMs": 571433,
    "dDurationMs": 2977,
    "segs": [ {
      "utf8": "and even larger in very special occasions."
    } ]
  }, {
    "tStartMs": 574410,
    "dDurationMs": 4125,
    "segs": [ {
      "utf8": "This is the hemisphere for a\n16 inch diameter aerial shell."
    } ]
  }, {
    "tStartMs": 578535,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- That is a huge firework."
    } ]
  }, {
    "tStartMs": 580055,
    "dDurationMs": 4855,
    "segs": [ {
      "utf8": "The biggest aerial firework\never was 1.44 meters wide,"
    } ]
  }, {
    "tStartMs": 584910,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "and it weighed about the same as a car."
    } ]
  }, {
    "tStartMs": 588010,
    "dDurationMs": 1971,
    "segs": [ {
      "utf8": "(speaker gasping)"
    } ]
  }, {
    "tStartMs": 589981,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- Ah-ooh-ooh-ooh!\n- Whoooh!"
    } ]
  }, {
    "tStartMs": 592301,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoa."
    } ]
  }, {
    "tStartMs": 593134,
    "dDurationMs": 1196,
    "segs": [ {
      "utf8": "(all laughing)"
    } ]
  }, {
    "tStartMs": 594330,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- To launch a firework into the air,"
    } ]
  }, {
    "tStartMs": 596520,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "the way it's done is\nwith more black powder."
    } ]
  }, {
    "tStartMs": 600000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- In a typical shell,"
    } ]
  }, {
    "tStartMs": 600960,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you're gonna have a baggie of black powder"
    } ]
  }, {
    "tStartMs": 602820,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that's underneath the shell,"
    } ]
  }, {
    "tStartMs": 605010,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and that acts to fire the\nshell out of the mortar"
    } ]
  }, {
    "tStartMs": 607500,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to the 800 feet in the air,"
    } ]
  }, {
    "tStartMs": 609120,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "which is what this eight\ninch shell would go to."
    } ]
  }, {
    "tStartMs": 610950,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Shells as large as say a 16 inch,"
    } ]
  }, {
    "tStartMs": 613080,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "those can use literally\npounds of black powder"
    } ]
  }, {
    "tStartMs": 615600,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "underneath them."
    } ]
  }, {
    "tStartMs": 616743,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "- To ensure the shell goes straight up."
    } ]
  }, {
    "tStartMs": 619680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It's placed in a big plastic\ntube called a mortar."
    } ]
  }, {
    "tStartMs": 623520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- A pyro technician gets two bangs"
    } ]
  }, {
    "tStartMs": 625560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "for every one the audience does."
    } ]
  }, {
    "tStartMs": 627540,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "You get a bang when the mortar fires"
    } ]
  }, {
    "tStartMs": 629370,
    "dDurationMs": 2012,
    "segs": [ {
      "utf8": "and then a bang when the shell explodes."
    } ]
  }, {
    "tStartMs": 631382,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(explosions booming)"
    } ]
  }, {
    "tStartMs": 636853,
    "dDurationMs": 1217,
    "segs": [ {
      "utf8": "And it's literally like a cannon,"
    } ]
  }, {
    "tStartMs": 638070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "shooting a cannon ball in the air."
    } ]
  }, {
    "tStartMs": 639660,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So the audience doesn't get\nto hear or see or feel that,"
    } ]
  }, {
    "tStartMs": 642450,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "but the pyro crew does."
    } ]
  }, {
    "tStartMs": 643811,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(explosions booming)"
    } ]
  }, {
    "tStartMs": 654406,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(audience cheering)"
    } ]
  }, {
    "tStartMs": 658410,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- Does everything burn up\nbefore it reaches the ground?"
    } ]
  }, {
    "tStartMs": 660840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- The internal contents, yes."
    } ]
  }, {
    "tStartMs": 662460,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So all the stars, the\nburst, all of that stuff,"
    } ]
  }, {
    "tStartMs": 664200,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the casing will come down in pieces."
    } ]
  }, {
    "tStartMs": 666510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "That's why we have a fallout\nzone is what we call it."
    } ]
  }, {
    "tStartMs": 669390,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Or the exclusion zone,"
    } ]
  }, {
    "tStartMs": 670770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "where only the crew is\nallowed with all their PPEs"
    } ]
  }, {
    "tStartMs": 673410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "because you do get debris that comes down."
    } ]
  }, {
    "tStartMs": 675720,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "It literally sounds like rain at the end"
    } ]
  }, {
    "tStartMs": 678330,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "from all of the debris from that finale,"
    } ]
  }, {
    "tStartMs": 680940,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "shells going off all at once."
    } ]
  }, {
    "tStartMs": 683850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- How often do they malfunction?"
    } ]
  }, {
    "tStartMs": 686280,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- It's rare, but it does happen."
    } ]
  }, {
    "tStartMs": 687840,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "You'll have a wooden rack with a few HDPE,"
    } ]
  }, {
    "tStartMs": 691110,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "high density polyethylene mortars in it."
    } ]
  }, {
    "tStartMs": 693097,
    "dDurationMs": 3893,
    "segs": [ {
      "utf8": "And that particular\nmaterial is meant to expand"
    } ]
  }, {
    "tStartMs": 696990,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and split from the energy\nof a malfunctioning shell"
    } ]
  }, {
    "tStartMs": 700080,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "versus explode and throw\nshrapnel everywhere."
    } ]
  }, {
    "tStartMs": 702925,
    "dDurationMs": 3035,
    "segs": [ {
      "utf8": "- We actually experienced\nan incident like this"
    } ]
  }, {
    "tStartMs": 705960,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "with the biggest shell\nwe had set to launch."
    } ]
  }, {
    "tStartMs": 708510,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Okay, in three,"
    } ]
  }, {
    "tStartMs": 710070,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "two,"
    } ]
  }, {
    "tStartMs": 710970,
    "dDurationMs": 1196,
    "segs": [ {
      "utf8": "one."
    } ]
  }, {
    "tStartMs": 712166,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(explosion pops)"
    } ]
  }, {
    "tStartMs": 712999,
    "dDurationMs": 1631,
    "segs": [ {
      "utf8": "Oh, oh."
    } ]
  }, {
    "tStartMs": 714630,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "That one did not look like it..."
    } ]
  }, {
    "tStartMs": 716900,
    "dDurationMs": 1247,
    "segs": [ {
      "utf8": "(explosion booms)"
    } ]
  }, {
    "tStartMs": 718147,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Oh!\n(laughs)"
    } ]
  }, {
    "tStartMs": 721650,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "That's what happens when\na firework doesn't lift."
    } ]
  }, {
    "tStartMs": 724020,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- But because we follow all\nthe rules and regulations"
    } ]
  }, {
    "tStartMs": 726540,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "at a professional display,"
    } ]
  }, {
    "tStartMs": 727830,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "it's usually the crowd going, whoa."
    } ]
  }, {
    "tStartMs": 730410,
    "dDurationMs": 1788,
    "segs": [ {
      "utf8": "And the crew going, whoa."
    } ]
  }, {
    "tStartMs": 732198,
    "dDurationMs": 978,
    "segs": [ {
      "utf8": "(explosion booms)"
    } ]
  }, {
    "tStartMs": 733176,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Oh my God."
    } ]
  }, {
    "tStartMs": 734496,
    "dDurationMs": 2754,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 737250,
    "dDurationMs": 1131,
    "segs": [ {
      "utf8": "- And then the show goes on"
    } ]
  }, {
    "tStartMs": 738381,
    "dDurationMs": 2739,
    "segs": [ {
      "utf8": "is typically what happens\nafter a few safety checks"
    } ]
  }, {
    "tStartMs": 741120,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "when something like that goes on."
    } ]
  }, {
    "tStartMs": 742440,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Thankfully everyone was safe"
    } ]
  }, {
    "tStartMs": 744030,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because we could trigger\nthe fireworks remotely"
    } ]
  }, {
    "tStartMs": 745950,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "from outside the blast radius."
    } ]
  }, {
    "tStartMs": 748170,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "But igniting explosives safely\nhas long been a challenge."
    } ]
  }, {
    "tStartMs": 753540,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- In the mining industry,"
    } ]
  }, {
    "tStartMs": 754980,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "their delay method back then"
    } ]
  }, {
    "tStartMs": 756690,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "was to literally sprinkle\nout a trail of black powder"
    } ]
  }, {
    "tStartMs": 759960,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "through the mine to give\nthem a delay to the dynamite."
    } ]
  }, {
    "tStartMs": 762750,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- The simplest fuse just\nconsists of cotton string"
    } ]
  }, {
    "tStartMs": 765750,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that's been soaked in black powder"
    } ]
  }, {
    "tStartMs": 767490,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and then allowed to dry out."
    } ]
  }, {
    "tStartMs": 769410,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "This is known as black match."
    } ]
  }, {
    "tStartMs": 771703,
    "dDurationMs": 3077,
    "segs": [ {
      "utf8": "It burns well, but pretty slowly."
    } ]
  }, {
    "tStartMs": 774780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- That alone would burn two\nto three seconds an inch."
    } ]
  }, {
    "tStartMs": 777900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But once you encase it in craft paper,"
    } ]
  }, {
    "tStartMs": 780330,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that's literally all this is,"
    } ]
  }, {
    "tStartMs": 782010,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you change that burn rate\nfrom a couple seconds an inch"
    } ]
  }, {
    "tStartMs": 784200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to anywhere from 30 to\na hundred feet a second."
    } ]
  }, {
    "tStartMs": 787560,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- This has the same effect"
    } ]
  }, {
    "tStartMs": 788850,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "as containing the black powder."
    } ]
  }, {
    "tStartMs": 790470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It traps in the heat and reagents,"
    } ]
  }, {
    "tStartMs": 792360,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "so the reaction goes much faster."
    } ]
  }, {
    "tStartMs": 794190,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- This is actually how we\nshoot our finale so fast."
    } ]
  }, {
    "tStartMs": 797190,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "We're not actually pushing\nbuttons that quickly."
    } ]
  }, {
    "tStartMs": 799770,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- This type of fuse is\nappropriately known as quick match."
    } ]
  }, {
    "tStartMs": 803640,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now, before I'd ever seen\nquick match in action,"
    } ]
  }, {
    "tStartMs": 806550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "it was suggested that I\ntry to race the signal"
    } ]
  }, {
    "tStartMs": 808770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "down the fuse."
    } ]
  }, {
    "tStartMs": 810420,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What I'm gonna do"
    } ]
  }, {
    "tStartMs": 811253,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "is light this little piece\nof black match right here,"
    } ]
  }, {
    "tStartMs": 813030,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and then I'm gonna try to race\nthe signal to the other end."
    } ]
  }, {
    "tStartMs": 816690,
    "dDurationMs": 3178,
    "segs": [ {
      "utf8": "But still, I was not\nprepared for what came next."
    } ]
  }, {
    "tStartMs": 819868,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 821089,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "(explosions popping)\nAh! Jesus,"
    } ]
  }, {
    "tStartMs": 823650,
    "dDurationMs": 1671,
    "segs": [ {
      "utf8": "what the heck was that?"
    } ]
  }, {
    "tStartMs": 825321,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(suspenseful music)\n(explosions popping)"
    } ]
  }, {
    "tStartMs": 833340,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "You are kidding me."
    } ]
  }, {
    "tStartMs": 835650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "You didn't tell me it was gonna do that."
    } ]
  }, {
    "tStartMs": 837990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The force of the combustion products"
    } ]
  }, {
    "tStartMs": 839850,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "causes the quick match\nto whip around wildly."
    } ]
  }, {
    "tStartMs": 843360,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "It's crazy how much just\ncontaining the reagents"
    } ]
  }, {
    "tStartMs": 846750,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "and containing the heat from\nthe reaction accelerates it."
    } ]
  }, {
    "tStartMs": 851340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It certainly burns much\nfaster than the black match"
    } ]
  }, {
    "tStartMs": 853680,
    "dDurationMs": 1494,
    "segs": [ {
      "utf8": "without the paper."
    } ]
  }, {
    "tStartMs": 855174,
    "dDurationMs": 1119,
    "segs": [ {
      "utf8": "(explosion pops)\nAh!"
    } ]
  }, {
    "tStartMs": 857250,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Man. Every time, every time that gets me."
    } ]
  }, {
    "tStartMs": 861870,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "One problem with these basic fuses"
    } ]
  }, {
    "tStartMs": 864120,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "is they aren't waterproof."
    } ]
  }, {
    "tStartMs": 866689,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "Even though they contain\nthe fuel and the oxidizer,"
    } ]
  }, {
    "tStartMs": 869490,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "so they don't need the\noxygen and the air to burn,"
    } ]
  }, {
    "tStartMs": 872340,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "they do need heat and\nwater is just too good"
    } ]
  }, {
    "tStartMs": 876030,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "at conducting the heat away from the fuse."
    } ]
  }, {
    "tStartMs": 878370,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So it snuffs out the reaction."
    } ]
  }, {
    "tStartMs": 880920,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And it fizzles out."
    } ]
  }, {
    "tStartMs": 882270,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "The same problem occurs with road flares."
    } ]
  }, {
    "tStartMs": 887010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "I thought since the flame comes\nout with such high pressure,"
    } ]
  }, {
    "tStartMs": 890220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it might be able to stay lit under water."
    } ]
  }, {
    "tStartMs": 892770,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Three,"
    } ]
  }, {
    "tStartMs": 893670,
    "dDurationMs": 883,
    "segs": [ {
      "utf8": "two,"
    } ]
  }, {
    "tStartMs": 894553,
    "dDurationMs": 883,
    "segs": [ {
      "utf8": "one."
    } ]
  }, {
    "tStartMs": 895436,
    "dDurationMs": 3424,
    "segs": [ {
      "utf8": "(water splashes)"
    } ]
  }, {
    "tStartMs": 898860,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "And it did for a little while,"
    } ]
  }, {
    "tStartMs": 902190,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "but eventually the water got\nin there and stole the heat."
    } ]
  }, {
    "tStartMs": 905760,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So I think that the\nwater is putting it out"
    } ]
  }, {
    "tStartMs": 908700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "by pulling the heat away from it"
    } ]
  }, {
    "tStartMs": 910080,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "so it doesn't have enough\nenergy to keep burning."
    } ]
  }, {
    "tStartMs": 912723,
    "dDurationMs": 3297,
    "segs": [ {
      "utf8": "(water burbling)"
    } ]
  }, {
    "tStartMs": 916020,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "You bring it out."
    } ]
  }, {
    "tStartMs": 918090,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Come on, come on."
    } ]
  }, {
    "tStartMs": 919080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 920820,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "- Wait, look."
    } ]
  }, {
    "tStartMs": 922090,
    "dDurationMs": 1052,
    "segs": [ {
      "utf8": "- He-ey!"
    } ]
  }, {
    "tStartMs": 923142,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(both laugh)"
    } ]
  }, {
    "tStartMs": 923975,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "- Ooh!"
    } ]
  }, {
    "tStartMs": 929277,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- And it's..."
    } ]
  }, {
    "tStartMs": 930110,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "(water burbling)"
    } ]
  }, {
    "tStartMs": 932520,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "There are special flares made\nfor underwater applications,"
    } ]
  }, {
    "tStartMs": 936630,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "but even those have similar problems."
    } ]
  }, {
    "tStartMs": 941408,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(water burbling)"
    } ]
  }, {
    "tStartMs": 945690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "You can see the gaseous\ncombustion products"
    } ]
  }, {
    "tStartMs": 947970,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "being released here and\nbubbling to the surface."
    } ]
  }, {
    "tStartMs": 950730,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And while this flare lasted longer,"
    } ]
  }, {
    "tStartMs": 952890,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "the water still eventually put it out."
    } ]
  }, {
    "tStartMs": 956790,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "Come on. Why did that go out?"
    } ]
  }, {
    "tStartMs": 959190,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "But it is possible to\nmake a waterproof fuse."
    } ]
  }, {
    "tStartMs": 963360,
    "dDurationMs": 1912,
    "segs": [ {
      "utf8": "- So this is your traditional visco fuse."
    } ]
  }, {
    "tStartMs": 965272,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "You're gonna see this in a lot\nof your consumer fireworks."
    } ]
  }, {
    "tStartMs": 968632,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(calm music)"
    } ]
  }, {
    "tStartMs": 972540,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "- Very big firework store."
    } ]
  }, {
    "tStartMs": 973982,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(cheerful music)"
    } ]
  }, {
    "tStartMs": 981540,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "I feel like we have to get this, spins?"
    } ]
  }, {
    "tStartMs": 984220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 985053,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "- And it makes fire?"
    } ]
  }, {
    "tStartMs": 986860,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 987693,
    "dDurationMs": 2007,
    "segs": [ {
      "utf8": "- I'm excited about this one."
    } ]
  }, {
    "tStartMs": 989700,
    "dDurationMs": 1554,
    "segs": [ {
      "utf8": "Here we go in three,"
    } ]
  }, {
    "tStartMs": 991254,
    "dDurationMs": 1026,
    "segs": [ {
      "utf8": "two,"
    } ]
  }, {
    "tStartMs": 992280,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "one."
    } ]
  }, {
    "tStartMs": 995640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Mike] It's really got a powder core"
    } ]
  }, {
    "tStartMs": 997200,
    "dDurationMs": 2475,
    "segs": [ {
      "utf8": "with a fiber wrap to it."
    } ]
  }, {
    "tStartMs": 999675,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(fireworks popping)"
    } ]
  }, {
    "tStartMs": 1006984,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 1011900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And it's typically lacquer coated."
    } ]
  }, {
    "tStartMs": 1013580,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "So these fuses are typically waterproof."
    } ]
  }, {
    "tStartMs": 1017164,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(explosion popping)"
    } ]
  }, {
    "tStartMs": 1021860,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoa!"
    } ]
  }, {
    "tStartMs": 1022693,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "(water burbling)"
    } ]
  }, {
    "tStartMs": 1029060,
    "dDurationMs": 1056,
    "segs": [ {
      "utf8": "Wow!"
    } ]
  }, {
    "tStartMs": 1030116,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 1030949,
    "dDurationMs": 1591,
    "segs": [ {
      "utf8": "That was impressive."
    } ]
  }, {
    "tStartMs": 1032540,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Fuses are not only used\nto light fireworks,"
    } ]
  }, {
    "tStartMs": 1035360,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "they are a core component\ninside a firework."
    } ]
  }, {
    "tStartMs": 1038840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- So that quick match flashes really quick"
    } ]
  }, {
    "tStartMs": 1040610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "down into the black\npowder lift that ignites."
    } ]
  }, {
    "tStartMs": 1043490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And while it's pushing the\nshell out of the mortar,"
    } ]
  }, {
    "tStartMs": 1046040,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it lights the time fuse."
    } ]
  }, {
    "tStartMs": 1047570,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So this is what would\nactually be in the shell"
    } ]
  }, {
    "tStartMs": 1050330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to give you the time delay."
    } ]
  }, {
    "tStartMs": 1051830,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "From the time the lift charge fires"
    } ]
  }, {
    "tStartMs": 1053399,
    "dDurationMs": 3561,
    "segs": [ {
      "utf8": "to the time the shell hits\napogee and explodes in the sky."
    } ]
  }, {
    "tStartMs": 1056960,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "You know, it's about a\nquarter inch in diameter"
    } ]
  }, {
    "tStartMs": 1058730,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "and is really a black\npowder core rigid fuse"
    } ]
  }, {
    "tStartMs": 1063230,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "compared to the more flimsy visco type."
    } ]
  }, {
    "tStartMs": 1065660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- It's really important\nthat the time delay fuse"
    } ]
  }, {
    "tStartMs": 1067970,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "keeps the combustion contained inside it"
    } ]
  }, {
    "tStartMs": 1070160,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "so the firework only\nexplodes when you want it to,"
    } ]
  }, {
    "tStartMs": 1072920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "at the very peak of its trajectory."
    } ]
  }, {
    "tStartMs": 1075590,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So we tested it underwater."
    } ]
  }, {
    "tStartMs": 1077780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Do you think it's waterproof?"
    } ]
  }, {
    "tStartMs": 1079160,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Should be."
    } ]
  }, {
    "tStartMs": 1079993,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "- All right. It's taking its time."
    } ]
  }, {
    "tStartMs": 1081380,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There we go."
    } ]
  }, {
    "tStartMs": 1083390,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "That looks like a firework type fuse."
    } ]
  }, {
    "tStartMs": 1085880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Mike] These function"
    } ]
  }, {
    "tStartMs": 1086713,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "by not spitting any fire out the side"
    } ]
  }, {
    "tStartMs": 1088940,
    "dDurationMs": 2149,
    "segs": [ {
      "utf8": "so that the shell doesn't\nget lit prematurely."
    } ]
  }, {
    "tStartMs": 1091089,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's smart."
    } ]
  }, {
    "tStartMs": 1091922,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "- [Mike] So you should only\nsee it spit out the end"
    } ]
  }, {
    "tStartMs": 1094310,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "once it's made it's all the way through."
    } ]
  }, {
    "tStartMs": 1095750,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- What's containing it?"
    } ]
  }, {
    "tStartMs": 1096890,
    "dDurationMs": 2092,
    "segs": [ {
      "utf8": "Like what kind of material\nis containing it in there?"
    } ]
  }, {
    "tStartMs": 1098982,
    "dDurationMs": 1058,
    "segs": [ {
      "utf8": "- [Mike] Well, there's a number..."
    } ]
  }, {
    "tStartMs": 1100040,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "There's weaves of fibers in\nthere and a layer of asphalt"
    } ]
  }, {
    "tStartMs": 1103550,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "that really provides that waterproofing."
    } ]
  }, {
    "tStartMs": 1105443,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "- So you can kind of see"
    } ]
  }, {
    "tStartMs": 1106910,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "how the signal is progressing."
    } ]
  }, {
    "tStartMs": 1108290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You can see how the fire's\nprogressing through there."
    } ]
  }, {
    "tStartMs": 1110450,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "'Cause obviously it's getting hot."
    } ]
  }, {
    "tStartMs": 1112190,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "Some of the gaseous\nproducts are coming up."
    } ]
  }, {
    "tStartMs": 1115520,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Oh, is it gonna come out?"
    } ]
  }, {
    "tStartMs": 1119457,
    "dDurationMs": 1223,
    "segs": [ {
      "utf8": "Was that it?"
    } ]
  }, {
    "tStartMs": 1120680,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Mike] That was it."
    } ]
  }, {
    "tStartMs": 1122963,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "- That is all that is needed"
    } ]
  }, {
    "tStartMs": 1124610,
    "dDurationMs": 2311,
    "segs": [ {
      "utf8": "to ignite the core of a firework."
    } ]
  }, {
    "tStartMs": 1126921,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "(both laugh)"
    } ]
  }, {
    "tStartMs": 1128360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- So after that time fuse hits its end,"
    } ]
  }, {
    "tStartMs": 1130070,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it'll light a piece of black match"
    } ]
  }, {
    "tStartMs": 1131750,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that'll then flash into the burst charge."
    } ]
  }, {
    "tStartMs": 1134270,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So that's what's represented\nby this blue material,"
    } ]
  }, {
    "tStartMs": 1136490,
    "dDurationMs": 3113,
    "segs": [ {
      "utf8": "which is typically rice hulls\nor something similar to that"
    } ]
  }, {
    "tStartMs": 1139603,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "coated with black powder."
    } ]
  }, {
    "tStartMs": 1141830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What are ri..."
    } ]
  }, {
    "tStartMs": 1142663,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh rice hulls."
    } ]
  }, {
    "tStartMs": 1143496,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "- Yes. Rice hulls, not holes, sorry."
    } ]
  }, {
    "tStartMs": 1144973,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "- I was like they're making\nrice holes like donut holes."
    } ]
  }, {
    "tStartMs": 1147890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- The reason we coat rice hulls"
    } ]
  }, {
    "tStartMs": 1149540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is because you get a very granular powder"
    } ]
  }, {
    "tStartMs": 1152120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "in the center of the shell now,"
    } ]
  }, {
    "tStartMs": 1153980,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "which allows the flame\nto propagate very quickly"
    } ]
  }, {
    "tStartMs": 1156890,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "through the shell, igniting\neverything simultaneously,"
    } ]
  }, {
    "tStartMs": 1160100,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "creating that significant\nover pressure very quickly"
    } ]
  }, {
    "tStartMs": 1163880,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to blow the shell open."
    } ]
  }, {
    "tStartMs": 1165440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So a traditional peony shell"
    } ]
  }, {
    "tStartMs": 1167090,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "would be your most basic of fireworks,"
    } ]
  }, {
    "tStartMs": 1169250,
    "dDurationMs": 3092,
    "segs": [ {
      "utf8": "where these stars would literally\nbe lining the hemisphere"
    } ]
  }, {
    "tStartMs": 1172342,
    "dDurationMs": 2548,
    "segs": [ {
      "utf8": "and then you'd have\nyour burst in the middle"
    } ]
  }, {
    "tStartMs": 1174890,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and that would give you"
    } ]
  }, {
    "tStartMs": 1176030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "a very symmetrical\nround sphere in the sky,"
    } ]
  }, {
    "tStartMs": 1178520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "your traditional firework that you see."
    } ]
  }, {
    "tStartMs": 1180770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- But it's just interesting to think"
    } ]
  }, {
    "tStartMs": 1182150,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that when you see a firework go off,"
    } ]
  }, {
    "tStartMs": 1184910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you know, all those little points of light"
    } ]
  }, {
    "tStartMs": 1186770,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "are about that size."
    } ]
  }, {
    "tStartMs": 1188570,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Mike] Yeah."
    } ]
  }, {
    "tStartMs": 1189403,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "- But they look..."
    } ]
  }, {
    "tStartMs": 1190400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I mean I would say that\nthey look bigger, right?"
    } ]
  }, {
    "tStartMs": 1192260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "'Cause they're so bright, I guess."
    } ]
  }, {
    "tStartMs": 1193880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1194713,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "(drone whistling)"
    } ]
  }, {
    "tStartMs": 1197030,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- So fast."
    } ]
  }, {
    "tStartMs": 1197990,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "- How fast does this thing go?"
    } ]
  }, {
    "tStartMs": 1199867,
    "dDurationMs": 2683,
    "segs": [ {
      "utf8": "- Pretty quick and it\nis definitely trickier"
    } ]
  }, {
    "tStartMs": 1202550,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "when it's dark like this."
    } ]
  }, {
    "tStartMs": 1205040,
    "dDurationMs": 1447,
    "segs": [ {
      "utf8": "- Okay, can you see anything?"
    } ]
  }, {
    "tStartMs": 1206487,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "- [Gene] Once I go start looking here,"
    } ]
  }, {
    "tStartMs": 1207920,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I'm like, I'm not sure."
    } ]
  }, {
    "tStartMs": 1209240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- How do you get focused to\nsomething that's not there yet"
    } ]
  }, {
    "tStartMs": 1212240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and you're not quite sure where\nit is or where anything is"
    } ]
  }, {
    "tStartMs": 1214640,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "'cause it's all pitch black?"
    } ]
  }, {
    "tStartMs": 1215707,
    "dDurationMs": 2713,
    "segs": [ {
      "utf8": "- 'Cause I basically have\nlocked exposure on this."
    } ]
  }, {
    "tStartMs": 1218420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And we can at least see\nhow the exposure is."
    } ]
  }, {
    "tStartMs": 1220910,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- Taking off."
    } ]
  }, {
    "tStartMs": 1221910,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "(drone whistling)\n(fireworks popping)"
    } ]
  }, {
    "tStartMs": 1224210,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 1226760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Amazing."
    } ]
  }, {
    "tStartMs": 1230090,
    "dDurationMs": 1024,
    "segs": [ {
      "utf8": "Blue."
    } ]
  }, {
    "tStartMs": 1231114,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(calm music)"
    } ]
  }, {
    "tStartMs": 1237230,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "- Oh shoot, okay."
    } ]
  }, {
    "tStartMs": 1238577,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "- Oh, dang.\n- FPV's down."
    } ]
  }, {
    "tStartMs": 1239828,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Gene] Oh dang."
    } ]
  }, {
    "tStartMs": 1240661,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "I didn't realize I was\nso close to the ground."
    } ]
  }, {
    "tStartMs": 1241970,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "All right, hold on."
    } ]
  }, {
    "tStartMs": 1242803,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "- I just wanna see what\nthis looks like, you know,"
    } ]
  }, {
    "tStartMs": 1244880,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "I wanna check this out. So."
    } ]
  }, {
    "tStartMs": 1249560,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Whoa, that is cool."
    } ]
  }, {
    "tStartMs": 1252680,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I dig that."
    } ]
  }, {
    "tStartMs": 1254240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "These stars are made of black powder"
    } ]
  }, {
    "tStartMs": 1256430,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "mixed with chemicals to give\nthem different properties."
    } ]
  }, {
    "tStartMs": 1259130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Mike] So brocade crown star"
    } ]
  }, {
    "tStartMs": 1260990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "would be the big bushy gold tail"
    } ]
  }, {
    "tStartMs": 1263330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that you would see in the sky."
    } ]
  }, {
    "tStartMs": 1264800,
    "dDurationMs": 3657,
    "segs": [ {
      "utf8": "So imagine a big glittering gold shell."
    } ]
  }, {
    "tStartMs": 1268457,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "(indistinct chatters)"
    } ]
  }, {
    "tStartMs": 1270470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- I could actually see the\nlittle pieces coming off"
    } ]
  }, {
    "tStartMs": 1272990,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "and glowing pretty bright right now."
    } ]
  }, {
    "tStartMs": 1273953,
    "dDurationMs": 1857,
    "segs": [ {
      "utf8": "- [Mike] Now, imagine those leaving a tail"
    } ]
  }, {
    "tStartMs": 1275810,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "as they fly through the sky."
    } ]
  }, {
    "tStartMs": 1277010,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "It's a really spectacular effect."
    } ]
  }, {
    "tStartMs": 1280160,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "- This is gonna be blue."
    } ]
  }, {
    "tStartMs": 1283195,
    "dDurationMs": 1195,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 1284390,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Often the chemicals mixed into the stars"
    } ]
  }, {
    "tStartMs": 1286550,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "are used to create specific colors."
    } ]
  }, {
    "tStartMs": 1289670,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Mike] Each of these stars"
    } ]
  }, {
    "tStartMs": 1290780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "would be coated with a primer composition,"
    } ]
  }, {
    "tStartMs": 1293000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "which is a really fine black powder."
    } ]
  }, {
    "tStartMs": 1295430,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "The reason for that is a\nlot of color compositions"
    } ]
  }, {
    "tStartMs": 1297619,
    "dDurationMs": 2791,
    "segs": [ {
      "utf8": "take more heat to ignite,"
    } ]
  }, {
    "tStartMs": 1300410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "so they have a higher\nignition temperature."
    } ]
  }, {
    "tStartMs": 1302720,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So by coating with black\npowder, with that primer,"
    } ]
  }, {
    "tStartMs": 1306020,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "you're ensuring ignition of all the stars,"
    } ]
  }, {
    "tStartMs": 1308540,
    "dDurationMs": 3298,
    "segs": [ {
      "utf8": "which then transfer the fire\nto that color composition."
    } ]
  }, {
    "tStartMs": 1311838,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "(calm music)"
    } ]
  }, {
    "tStartMs": 1314300,
    "dDurationMs": 1738,
    "segs": [ {
      "utf8": "- And then it started taking off on you."
    } ]
  }, {
    "tStartMs": 1316038,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "(imitates firework)"
    } ]
  }, {
    "tStartMs": 1317840,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "That's cool."
    } ]
  }, {
    "tStartMs": 1319070,
    "dDurationMs": 1139,
    "segs": [ {
      "utf8": "I like that."
    } ]
  }, {
    "tStartMs": 1320209,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(calm music)"
    } ]
  }, {
    "tStartMs": 1325310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Jeez it's bright."
    } ]
  }, {
    "tStartMs": 1326930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The colors of fireworks"
    } ]
  }, {
    "tStartMs": 1328250,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "are actually thanks to quantum mechanics."
    } ]
  }, {
    "tStartMs": 1331100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "An element absorbs energy\nfrom the combustion"
    } ]
  }, {
    "tStartMs": 1333740,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "raising an electron to\na higher energy level."
    } ]
  }, {
    "tStartMs": 1336650,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And there are only certain\ntransitions which are allowed."
    } ]
  }, {
    "tStartMs": 1339320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So when the electron drops back down"
    } ]
  }, {
    "tStartMs": 1340730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to a lower energy level,\nit gives off light"
    } ]
  }, {
    "tStartMs": 1343070,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with a specific energy of that transition,"
    } ]
  }, {
    "tStartMs": 1345770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which corresponds to a particular color."
    } ]
  }, {
    "tStartMs": 1348290,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Some elements are particularly well-suited"
    } ]
  }, {
    "tStartMs": 1350690,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to create certain colors."
    } ]
  }, {
    "tStartMs": 1353150,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So as the copper ions go in there,"
    } ]
  }, {
    "tStartMs": 1355070,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "they absorb energy from the\nfire, from the combustion,"
    } ]
  }, {
    "tStartMs": 1358850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and then the electrons drop back down"
    } ]
  }, {
    "tStartMs": 1360440,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "to a lower energy level"
    } ]
  }, {
    "tStartMs": 1361670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and they give out that\nblue light predominantly."
    } ]
  }, {
    "tStartMs": 1364130,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And that's why we get\nsuch a great blue color."
    } ]
  }, {
    "tStartMs": 1366560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "What a thing of beauty."
    } ]
  }, {
    "tStartMs": 1368480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "This is just a little interjection"
    } ]
  }, {
    "tStartMs": 1369920,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because I was looking at our flame tests"
    } ]
  }, {
    "tStartMs": 1372290,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and the copper salt tests, you know,"
    } ]
  }, {
    "tStartMs": 1374360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "anywhere you look, copper\nfireworks are meant to be blue,"
    } ]
  }, {
    "tStartMs": 1377450,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "like bright blue, but those\nflame tests look kind of green."
    } ]
  }, {
    "tStartMs": 1381110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And so I didn't really\nknow what was going on,"
    } ]
  }, {
    "tStartMs": 1383360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but I was sitting here\nplaying with my kids"
    } ]
  }, {
    "tStartMs": 1385820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "with the KiwiCo flame test kit."
    } ]
  }, {
    "tStartMs": 1388610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I know like they did sponsor this video,"
    } ]
  }, {
    "tStartMs": 1390290,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but didn't tell me to put\na section like this in."
    } ]
  }, {
    "tStartMs": 1392420,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But what I found is that, okay,"
    } ]
  }, {
    "tStartMs": 1394760,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I'm using a copper salt\nhere and it starts out green"
    } ]
  }, {
    "tStartMs": 1400070,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and then if you leave it for\na while, come zoom in here,"
    } ]
  }, {
    "tStartMs": 1403700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it starts to get blue."
    } ]
  }, {
    "tStartMs": 1405560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Oh, look at that blue."
    } ]
  }, {
    "tStartMs": 1407450,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "To get the beautiful blue color.\nI think you need more heat."
    } ]
  }, {
    "tStartMs": 1410630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "I think it's a higher\ntemperature that we need"
    } ]
  }, {
    "tStartMs": 1412700,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "that we didn't achieve in our\nflame tests out in the field."
    } ]
  }, {
    "tStartMs": 1416360,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Here we got some calcium\nchloride. Oh yeah."
    } ]
  }, {
    "tStartMs": 1419270,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Oh, that is a beautiful orange."
    } ]
  }, {
    "tStartMs": 1422780,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Look at that."
    } ]
  }, {
    "tStartMs": 1424520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Here we're getting some potassium chloride"
    } ]
  }, {
    "tStartMs": 1427220,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "to give us some violet."
    } ]
  }, {
    "tStartMs": 1429680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I'm not seeing too much violet,"
    } ]
  }, {
    "tStartMs": 1431450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but maybe just a little."
    } ]
  }, {
    "tStartMs": 1433580,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Barium chloride."
    } ]
  }, {
    "tStartMs": 1438320,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Of course, that's just small scale."
    } ]
  }, {
    "tStartMs": 1440690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Our pyro technician mixed\nup some color salt and fuel"
    } ]
  }, {
    "tStartMs": 1444140,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "in a mortar."
    } ]
  }, {
    "tStartMs": 1445070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Mike] What's in there is\nabout two gallons of methanol"
    } ]
  }, {
    "tStartMs": 1446660,
    "dDurationMs": 1622,
    "segs": [ {
      "utf8": "with boric acid on this one."
    } ]
  }, {
    "tStartMs": 1448282,
    "dDurationMs": 1618,
    "segs": [ {
      "utf8": "(explosion booms)"
    } ]
  }, {
    "tStartMs": 1449900,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 1451280,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And copper(II) chloride on this one."
    } ]
  }, {
    "tStartMs": 1454520,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Three, two, one."
    } ]
  }, {
    "tStartMs": 1457572,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Fire.\n(explosion booms)"
    } ]
  }, {
    "tStartMs": 1458405,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah!"
    } ]
  }, {
    "tStartMs": 1460640,
    "dDurationMs": 1245,
    "segs": [ {
      "utf8": "That was awesome."
    } ]
  }, {
    "tStartMs": 1461885,
    "dDurationMs": 1545,
    "segs": [ {
      "utf8": "(calm music)"
    } ]
  }, {
    "tStartMs": 1463430,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "That is the beauty of quantum mechanics."
    } ]
  }, {
    "tStartMs": 1466700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "The electron transitions"
    } ]
  }, {
    "tStartMs": 1468080,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that give rise to the\ncolor of fireworks are,"
    } ]
  }, {
    "tStartMs": 1470600,
    "dDurationMs": 986,
    "segs": [ {
      "utf8": "at least in my opinion,"
    } ]
  }, {
    "tStartMs": 1471586,
    "dDurationMs": 2944,
    "segs": [ {
      "utf8": "way cooler than colored smoke bombs."
    } ]
  }, {
    "tStartMs": 1474530,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So the combustion products here are solid,"
    } ]
  }, {
    "tStartMs": 1478010,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and that's why they make so much smoke."
    } ]
  }, {
    "tStartMs": 1480080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In this case,"
    } ]
  }, {
    "tStartMs": 1480913,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "there's just dye in the\nsmoke to give it its color."
    } ]
  }, {
    "tStartMs": 1485756,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1487670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "To make so-called ghost shells,"
    } ]
  }, {
    "tStartMs": 1489680,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the stars are coated in\nlayers of different chemicals,"
    } ]
  }, {
    "tStartMs": 1492860,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "which allows them to\nchange color mid-flight."
    } ]
  }, {
    "tStartMs": 1496610,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "- So assuming your shell\nconstruction was very uniform,"
    } ]
  }, {
    "tStartMs": 1500150,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "your casing, all your\nstars are the same mass,"
    } ]
  }, {
    "tStartMs": 1503240,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you're gonna get a very\nuniform explosion in the sky."
    } ]
  }, {
    "tStartMs": 1505610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So it's really as simple as"
    } ]
  }, {
    "tStartMs": 1507470,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "how you lay out the stars in the shell"
    } ]
  }, {
    "tStartMs": 1510140,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and it'll break in that\npattern in the sky."
    } ]
  }, {
    "tStartMs": 1512210,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- So what's your favorite patterned?"
    } ]
  }, {
    "tStartMs": 1515540,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Jellyfish are pretty neat."
    } ]
  }, {
    "tStartMs": 1517520,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "If you've ever seen a jellyfish,"
    } ]
  }, {
    "tStartMs": 1518600,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it really looks like a jellyfish."
    } ]
  }, {
    "tStartMs": 1520130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You get the dome"
    } ]
  }, {
    "tStartMs": 1520963,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "and then you get tentacles\ncoming out the bottom."
    } ]
  }, {
    "tStartMs": 1523250,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- That sounds amazing."
    } ]
  }, {
    "tStartMs": 1524090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Mike] Yeah."
    } ]
  }, {
    "tStartMs": 1526550,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Do they just do it by changing the color"
    } ]
  }, {
    "tStartMs": 1528800,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and position of the stars up here?"
    } ]
  }, {
    "tStartMs": 1530570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Like how do you get a\ndome and then tentacles?"
    } ]
  }, {
    "tStartMs": 1532940,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- If this was the shell"
    } ]
  }, {
    "tStartMs": 1533900,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and you'd have another half this way,"
    } ]
  }, {
    "tStartMs": 1535490,
    "dDurationMs": 2164,
    "segs": [ {
      "utf8": "only the top half would be covered-"
    } ]
  }, {
    "tStartMs": 1537654,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Would be fully covered."
    } ]
  }, {
    "tStartMs": 1538487,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- And that would be your dome."
    } ]
  }, {
    "tStartMs": 1539320,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "And then you'd have a couple larger stars"
    } ]
  }, {
    "tStartMs": 1541190,
    "dDurationMs": 2059,
    "segs": [ {
      "utf8": "to create the large tentacles\nthat come out the bottom."
    } ]
  }, {
    "tStartMs": 1543249,
    "dDurationMs": 1511,
    "segs": [ {
      "utf8": "- Ah."
    } ]
  }, {
    "tStartMs": 1544760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "These days fireworks\naren't usually triggered"
    } ]
  }, {
    "tStartMs": 1546860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "by lighting a fuse by hand,\nbut by pushing a button."
    } ]
  }, {
    "tStartMs": 1549980,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Each one of these buttons"
    } ]
  }, {
    "tStartMs": 1551030,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "would correspond to an\nindividual firing circuit"
    } ]
  }, {
    "tStartMs": 1553370,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "going out into the field."
    } ]
  }, {
    "tStartMs": 1554660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- The button sends current down the wire"
    } ]
  }, {
    "tStartMs": 1556520,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to an electric match."
    } ]
  }, {
    "tStartMs": 1557930,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "A little filament in the match heats up,"
    } ]
  }, {
    "tStartMs": 1559970,
    "dDurationMs": 1956,
    "segs": [ {
      "utf8": "triggering a chemical reaction."
    } ]
  }, {
    "tStartMs": 1561926,
    "dDurationMs": 1704,
    "segs": [ {
      "utf8": "- [Mike] Which then spits fire"
    } ]
  }, {
    "tStartMs": 1563630,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "into whatever you're trying to light."
    } ]
  }, {
    "tStartMs": 1568310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Gene] Yeah, I think it's just..."
    } ]
  }, {
    "tStartMs": 1570590,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Dust in the motors?"
    } ]
  }, {
    "tStartMs": 1571730,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- I think so."
    } ]
  }, {
    "tStartMs": 1572870,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "This might be a pretty quick repair."
    } ]
  }, {
    "tStartMs": 1575810,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- We are about to have a fireworks finale"
    } ]
  }, {
    "tStartMs": 1579680,
    "dDurationMs": 2994,
    "segs": [ {
      "utf8": "in the middle of nowhere in the pitch dark"
    } ]
  }, {
    "tStartMs": 1582674,
    "dDurationMs": 1986,
    "segs": [ {
      "utf8": "for like a minute."
    } ]
  }, {
    "tStartMs": 1584660,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "And we're gonna try to\nfly FPV drone through it."
    } ]
  }, {
    "tStartMs": 1589430,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "So what does it actually\nlook like to be in the middle"
    } ]
  }, {
    "tStartMs": 1592264,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "where all the fireworks\nare exploding in three,"
    } ]
  }, {
    "tStartMs": 1597290,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "two,"
    } ]
  }, {
    "tStartMs": 1598520,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "one."
    } ]
  }, {
    "tStartMs": 1599693,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(drone whistling)\n(fireworks popping)"
    } ]
  }, {
    "tStartMs": 1610758,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "- Thank you."
    } ]
  }, {
    "tStartMs": 1612024,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(fireworks popping)"
    } ]
  }, {
    "tStartMs": 1628922,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(upbeat music)\n(fireworks popping)"
    } ]
  }, {
    "tStartMs": 1653450,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 1654770,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "Can we get some light on the ground here?"
    } ]
  }, {
    "tStartMs": 1656856,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 1658610,
    "dDurationMs": 1517,
    "segs": [ {
      "utf8": "- That was insane."
    } ]
  }, {
    "tStartMs": 1661067,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "- The fireworks finale\ntriggered my car alarm."
    } ]
  }, {
    "tStartMs": 1663770,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "- They were like two\ntimes where I was like,"
    } ]
  }, {
    "tStartMs": 1665457,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "\"I'm not sure if I'm upside down or not,"
    } ]
  }, {
    "tStartMs": 1667347,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "but I gotta hold this shot.\""
    } ]
  }, {
    "tStartMs": 1669950,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "Okay, so"
    } ]
  }, {
    "tStartMs": 1672834,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [All] Whoa."
    } ]
  }, {
    "tStartMs": 1674094,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(hopeful music)"
    } ]
  }, {
    "tStartMs": 1679820,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- Oh man. Right through\nthem, right around them."
    } ]
  }, {
    "tStartMs": 1683090,
    "dDurationMs": 1842,
    "segs": [ {
      "utf8": "Just parked right down into that."
    } ]
  }, {
    "tStartMs": 1684932,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(all laughing)"
    } ]
  }, {
    "tStartMs": 1688945,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Whoa, that is so wicked."
    } ]
  }, {
    "tStartMs": 1692316,
    "dDurationMs": 1231,
    "segs": [ {
      "utf8": "- Dude."
    } ]
  }, {
    "tStartMs": 1693547,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "- Yeah, there we go."
    } ]
  }, {
    "tStartMs": 1695008,
    "dDurationMs": 1928,
    "segs": [ {
      "utf8": "(all laughing)"
    } ]
  }, {
    "tStartMs": 1696936,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "- You're upside down."
    } ]
  }, {
    "tStartMs": 1697970,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "- [Gene] Right there."
    } ]
  }, {
    "tStartMs": 1699291,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(hopeful music)"
    } ]
  }, {
    "tStartMs": 1700124,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "I was just chasing everything."
    } ]
  }, {
    "tStartMs": 1702030,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(hopeful music)"
    } ]
  }, {
    "tStartMs": 1727670,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- Fireworks are this perfect\ncombination of chemistry,"
    } ]
  }, {
    "tStartMs": 1731270,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "light, and sound."
    } ]
  }, {
    "tStartMs": 1733280,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "If their purpose is to banish bad spirits,"
    } ]
  }, {
    "tStartMs": 1736310,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "I'd say they achieve it."
    } ]
  }, {
    "tStartMs": 1738478,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(fireworks booming)"
    } ]
  }, {
    "tStartMs": 1745172,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(squicky sound)"
    } ]
  }, {
    "tStartMs": 1750050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Hey, this video was sponsored by KiwiCo."
    } ]
  }, {
    "tStartMs": 1752720,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "You know, every time a KiwiCo\ncrate shows up at our house,"
    } ]
  }, {
    "tStartMs": 1755630,
    "dDurationMs": 1649,
    "segs": [ {
      "utf8": "my kids get really excited."
    } ]
  }, {
    "tStartMs": 1757279,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "(screaming)"
    } ]
  }, {
    "tStartMs": 1759440,
    "dDurationMs": 1004,
    "segs": [ {
      "utf8": "What is it guys?"
    } ]
  }, {
    "tStartMs": 1760444,
    "dDurationMs": 2648,
    "segs": [ {
      "utf8": "- I love me this one."
    } ]
  }, {
    "tStartMs": 1763092,
    "dDurationMs": 2592,
    "segs": [ {
      "utf8": "- You light it on fire and it\nmakes different color flames."
    } ]
  }, {
    "tStartMs": 1765684,
    "dDurationMs": 1556,
    "segs": [ {
      "utf8": "(gasps)"
    } ]
  }, {
    "tStartMs": 1767240,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "- The different chemicals you put on?"
    } ]
  }, {
    "tStartMs": 1769033,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Uh-huh."
    } ]
  }, {
    "tStartMs": 1769866,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "And that's because they know what's inside"
    } ]
  }, {
    "tStartMs": 1771470,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "is a hands-on project that\nthey get to build with me."
    } ]
  }, {
    "tStartMs": 1774410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And the building is a lot of fun"
    } ]
  }, {
    "tStartMs": 1776270,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and playing with it\nafterwards is even better."
    } ]
  }, {
    "tStartMs": 1779300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "From my perspective,"
    } ]
  }, {
    "tStartMs": 1780620,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the best part is that my kids\nare learning about science,"
    } ]
  }, {
    "tStartMs": 1783440,
    "dDurationMs": 1972,
    "segs": [ {
      "utf8": "technology, engineering and design"
    } ]
  }, {
    "tStartMs": 1785412,
    "dDurationMs": 2228,
    "segs": [ {
      "utf8": "while playing and having fun."
    } ]
  }, {
    "tStartMs": 1787640,
    "dDurationMs": 2812,
    "segs": [ {
      "utf8": "And I think that is the best way to learn."
    } ]
  }, {
    "tStartMs": 1790452,
    "dDurationMs": 2258,
    "segs": [ {
      "utf8": "So the way it works is that each month"
    } ]
  }, {
    "tStartMs": 1792710,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "KiwiCo delivers a crate right to your door"
    } ]
  }, {
    "tStartMs": 1795260,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and inside is everything you\nneed to complete the project."
    } ]
  }, {
    "tStartMs": 1798350,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And I mean everything."
    } ]
  }, {
    "tStartMs": 1799880,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So there are no additional\ntrips to the store."
    } ]
  }, {
    "tStartMs": 1802670,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "We've been getting crates\nfor three years now."
    } ]
  }, {
    "tStartMs": 1804830,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So we've built lots of different projects"
    } ]
  }, {
    "tStartMs": 1807110,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and they're all high quality."
    } ]
  }, {
    "tStartMs": 1808940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I got to tour KiwiCO's headquarters,"
    } ]
  }, {
    "tStartMs": 1810980,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "so I saw how their crates\nare designed by experts"
    } ]
  }, {
    "tStartMs": 1813890,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and then tested with kids\nbefore they're ever sent out."
    } ]
  }, {
    "tStartMs": 1817040,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "They're also really good value."
    } ]
  }, {
    "tStartMs": 1819110,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Most KiwiCo subscriptions work\nout to around $20 per month."
    } ]
  }, {
    "tStartMs": 1822890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They have nine different product lines"
    } ]
  }, {
    "tStartMs": 1824810,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "targeted at different age groups."
    } ]
  }, {
    "tStartMs": 1826550,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Everything from newborns up to 14 plus"
    } ]
  }, {
    "tStartMs": 1829550,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "so your kids can grow with\nKiwiCo just as mine have."
    } ]
  }, {
    "tStartMs": 1833360,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I think my favorite thing is\nthat working on these projects"
    } ]
  }, {
    "tStartMs": 1836150,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "has become something that we do together."
    } ]
  }, {
    "tStartMs": 1838730,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Every month there is this thought starter"
    } ]
  }, {
    "tStartMs": 1841250,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and an invitation to spend\nsome quality time together"
    } ]
  }, {
    "tStartMs": 1844250,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and it just arrives on our doorstep"
    } ]
  }, {
    "tStartMs": 1846440,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and I really appreciate that."
    } ]
  }, {
    "tStartMs": 1848300,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So if you wanna try it out,"
    } ]
  }, {
    "tStartMs": 1849530,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "go to kiwico.com/veritasium\nto get your first month free."
    } ]
  }, {
    "tStartMs": 1853460,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Using my link, you're not\nonly getting a great deal,"
    } ]
  }, {
    "tStartMs": 1856070,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "you're also helping to\nsupport this channel."
    } ]
  }, {
    "tStartMs": 1858800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And if you want to purchase single crates,"
    } ]
  }, {
    "tStartMs": 1861200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that's also an option\nthrough the KiwiCo store."
    } ]
  }, {
    "tStartMs": 1863900,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "They make great gifts."
    } ]
  }, {
    "tStartMs": 1865640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So I wanna thank KiwiCo\nfor sponsoring this video"
    } ]
  }, {
    "tStartMs": 1868160,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
