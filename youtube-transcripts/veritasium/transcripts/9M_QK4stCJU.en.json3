{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1008,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "- [Derek] Friday, the 17th of July, 1992."
    } ]
  }, {
    "tStartMs": 3570,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Amidst the chaos of the trading floor"
    } ]
  }, {
    "tStartMs": 5370,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "at Singapore's international\nstock exchange,"
    } ]
  }, {
    "tStartMs": 7560,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "one of the junior traders\nmakes an expensive mistake."
    } ]
  }, {
    "tStartMs": 11340,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Instead of buying 20 futures\ncontracts for a client,"
    } ]
  }, {
    "tStartMs": 14100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "she sold them instead,"
    } ]
  }, {
    "tStartMs": 15600,
    "dDurationMs": 3945,
    "segs": [ {
      "utf8": "costing Barings Bank nearly $40,000."
    } ]
  }, {
    "tStartMs": 19545,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "To save her job, Her boss, Nick Leeson,"
    } ]
  }, {
    "tStartMs": 21630,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "a young trader keen to make his mark,"
    } ]
  }, {
    "tStartMs": 23460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "decides to hide the loss."
    } ]
  }, {
    "tStartMs": 25950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "He puts it in an obscure error account,"
    } ]
  }, {
    "tStartMs": 28710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that's account 88888."
    } ]
  }, {
    "tStartMs": 31380,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "It's used by banks to solve\nsmall discrepancies and trades."
    } ]
  }, {
    "tStartMs": 35370,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "It's a dangerous move"
    } ]
  }, {
    "tStartMs": 36780,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and it should have been picked up"
    } ]
  }, {
    "tStartMs": 38190,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "by the central office immediately,"
    } ]
  }, {
    "tStartMs": 40020,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "but when nobody from Barings\nnotices, he gains confidence,"
    } ]
  }, {
    "tStartMs": 43650,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "convinced he can win back the loss"
    } ]
  }, {
    "tStartMs": 45600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and get the team out of trouble."
    } ]
  }, {
    "tStartMs": 47460,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "- I'm operating in the belief\nthat I can get it back."
    } ]
  }, {
    "tStartMs": 51150,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "You know, maybe it goes back\nto the confidence thing."
    } ]
  }, {
    "tStartMs": 53850,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "I don't know."
    } ]
  }, {
    "tStartMs": 54690,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I mean, I'm confident I can\nget it back at that stage."
    } ]
  }, {
    "tStartMs": 57090,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- But Leeson's staggering overconfidence"
    } ]
  }, {
    "tStartMs": 59610,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "would create a debt of\ngargantuan proportions"
    } ]
  }, {
    "tStartMs": 62340,
    "dDurationMs": 3465,
    "segs": [ {
      "utf8": "and lead to one of the biggest\ncollapses in banking history."
    } ]
  }, {
    "tStartMs": 67680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- It's easy for me to make\nthe case at overconfidence"
    } ]
  }, {
    "tStartMs": 69690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "as the most dangerous of the human biases."
    } ]
  }, {
    "tStartMs": 72480,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "Overconfidence gets us\ninto all sorts of trouble."
    } ]
  }, {
    "tStartMs": 77400,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "It leads us to take\nrisks, make commitments,"
    } ]
  }, {
    "tStartMs": 82020,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "enter contests, try things\nthat will ultimately fail,"
    } ]
  }, {
    "tStartMs": 86910,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "sometimes in costly,\nembarrassing, and dangerous ways."
    } ]
  }, {
    "tStartMs": 90210,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Overconfidence has been implicated"
    } ]
  }, {
    "tStartMs": 91860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "in almost every big disaster,"
    } ]
  }, {
    "tStartMs": 93900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "from the sinking of the Titanic"
    } ]
  }, {
    "tStartMs": 95670,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to the Chernobyl nuclear disaster,"
    } ]
  }, {
    "tStartMs": 97710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to the loss of the space\nshuttle Challenger."
    } ]
  }, {
    "tStartMs": 99900,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But overconfidence isn't reserved"
    } ]
  }, {
    "tStartMs": 102090,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for just a few reckless individuals."
    } ]
  }, {
    "tStartMs": 104340,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "We can all fall victim to it."
    } ]
  }, {
    "tStartMs": 106470,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "For example, 93% of us\nthink we are better drivers"
    } ]
  }, {
    "tStartMs": 109830,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "than the median, which\nis, of course, impossible."
    } ]
  }, {
    "tStartMs": 112530,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The scale of the problem was identified"
    } ]
  }, {
    "tStartMs": 114150,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in some now-classic research"
    } ]
  }, {
    "tStartMs": 116070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "with a set of simple quiz questions."
    } ]
  }, {
    "tStartMs": 118110,
    "dDurationMs": 3632,
    "segs": [ {
      "utf8": "True or false, Australia\nis wider than the moon."
    } ]
  }, {
    "tStartMs": 121742,
    "dDurationMs": 1618,
    "segs": [ {
      "utf8": "- Oh!"
    } ]
  }, {
    "tStartMs": 123360,
    "dDurationMs": 2031,
    "segs": [ {
      "utf8": "I bet they're about the same size."
    } ]
  }, {
    "tStartMs": 125391,
    "dDurationMs": 2379,
    "segs": [ {
      "utf8": "- It looks small on a map, but it's huge."
    } ]
  }, {
    "tStartMs": 127770,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- Are there more or less\nstars in the Milky Way"
    } ]
  }, {
    "tStartMs": 131070,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "than trees on Earth?"
    } ]
  }, {
    "tStartMs": 132540,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- More stars.\n- Than trees?"
    } ]
  }, {
    "tStartMs": 133530,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- More stars."
    } ]
  }, {
    "tStartMs": 134363,
    "dDurationMs": 3277,
    "segs": [ {
      "utf8": "- One teaspoon of pure olive oil,"
    } ]
  }, {
    "tStartMs": 137640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Right.\n- Four and a half grams,"
    } ]
  }, {
    "tStartMs": 139440,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "contains more chemical potential energy"
    } ]
  }, {
    "tStartMs": 142650,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "than an equivalent four and\na half gram amount of TNT."
    } ]
  }, {
    "tStartMs": 147090,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- I'm gonna say true."
    } ]
  }, {
    "tStartMs": 148620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Hmm."
    } ]
  }, {
    "tStartMs": 149820,
    "dDurationMs": 1111,
    "segs": [ {
      "utf8": "Oh no."
    } ]
  }, {
    "tStartMs": 150931,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 152010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- This feels kind of\nlike a trick question."
    } ]
  }, {
    "tStartMs": 153870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- The energy density of butter"
    } ]
  }, {
    "tStartMs": 156510,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "is 10 times that of\nlithium batteries, right?"
    } ]
  }, {
    "tStartMs": 161190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I mean, lithium batteries are rubbish."
    } ]
  }, {
    "tStartMs": 162840,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "Everyone's going on about them."
    } ]
  }, {
    "tStartMs": 164069,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 164902,
    "dDurationMs": 1988,
    "segs": [ {
      "utf8": "Just run your car on butter, I say."
    } ]
  }, {
    "tStartMs": 166890,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- True or false, plants are more efficient"
    } ]
  }, {
    "tStartMs": 168660,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "than the average solar panel\nat absorbing the sun's energy."
    } ]
  }, {
    "tStartMs": 171660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 172493,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- They must be."
    } ]
  }, {
    "tStartMs": 173326,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "- Now, these aren't the exact questions"
    } ]
  }, {
    "tStartMs": 175350,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "from the original research,\nmore on those later,"
    } ]
  }, {
    "tStartMs": 177780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "but the specifics don't really matter."
    } ]
  }, {
    "tStartMs": 179550,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "The interesting bit is\nwhat they asked next,"
    } ]
  }, {
    "tStartMs": 182160,
    "dDurationMs": 3204,
    "segs": [ {
      "utf8": "how confident are you that you are right?"
    } ]
  }, {
    "tStartMs": 185364,
    "dDurationMs": 1455,
    "segs": [ {
      "utf8": "- 100% confident.\n(interviewee speaks faintly)"
    } ]
  }, {
    "tStartMs": 186819,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "- 100% confident?\n- 100, yes."
    } ]
  }, {
    "tStartMs": 188160,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- I think it's true."
    } ]
  }, {
    "tStartMs": 190020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So, I've also gotta go 90%."
    } ]
  }, {
    "tStartMs": 191370,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- 100%.\n- 100%."
    } ]
  }, {
    "tStartMs": 193140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- 100%?\n- Yeah."
    } ]
  }, {
    "tStartMs": 194550,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- I don't think we actually\nhad any expectations."
    } ]
  }, {
    "tStartMs": 197370,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "This was very early on in the research"
    } ]
  }, {
    "tStartMs": 201990,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "on confidence assessment,"
    } ]
  }, {
    "tStartMs": 204450,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but we didn't really\nknow what we would find."
    } ]
  }, {
    "tStartMs": 207120,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- The results revealed\na surprising disparity"
    } ]
  }, {
    "tStartMs": 209550,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "between how accurate\nsomeone thinks they are"
    } ]
  }, {
    "tStartMs": 211860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and how accurate they actually are."
    } ]
  }, {
    "tStartMs": 213990,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "When people are 90%\ncertain, they are right,"
    } ]
  }, {
    "tStartMs": 217230,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "only 75% of the time."
    } ]
  }, {
    "tStartMs": 220050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "In fact, we ran our own\nversion of this online"
    } ]
  }, {
    "tStartMs": 222750,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and found an even more\nextreme discrepancy."
    } ]
  }, {
    "tStartMs": 225720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We asked the Veritasium community a bunch"
    } ]
  }, {
    "tStartMs": 228120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of science questions and then asked"
    } ]
  }, {
    "tStartMs": 229680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "how confident they were in their answer."
    } ]
  }, {
    "tStartMs": 231660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Our results showed that those"
    } ]
  }, {
    "tStartMs": 233010,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "who were the most confident\ndescribing themselves"
    } ]
  }, {
    "tStartMs": 234990,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "as 91 to 100% sure were only\ncorrect 51% of the time."
    } ]
  }, {
    "tStartMs": 241230,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Since the original research,"
    } ]
  }, {
    "tStartMs": 242970,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "these results have been\nreplicated again and again"
    } ]
  }, {
    "tStartMs": 245700,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "in all areas from general\nknowledge to motor skills,"
    } ]
  }, {
    "tStartMs": 249210,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and it affects everyone, even experts."
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- I have a paper where\nwe analyze the survey"
    } ]
  }, {
    "tStartMs": 254520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of professional forecasters."
    } ]
  }, {
    "tStartMs": 256320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "These are chief economists\nat various corporations"
    } ]
  }, {
    "tStartMs": 259170,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and banks who are invited\nto forecast the state"
    } ]
  }, {
    "tStartMs": 262440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "of the economy on a quarterly basis."
    } ]
  }, {
    "tStartMs": 264540,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "We find that they are, on average,"
    } ]
  }, {
    "tStartMs": 267030,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "too sure that they know\nwhat's going to happen,"
    } ]
  }, {
    "tStartMs": 269580,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "so they, on average,"
    } ]
  }, {
    "tStartMs": 271200,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "say there's something like 53% sure"
    } ]
  }, {
    "tStartMs": 274650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "they have correctly predicted"
    } ]
  }, {
    "tStartMs": 276300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "what's gonna happen to\ninflation, for instance,"
    } ]
  }, {
    "tStartMs": 279300,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and they are right, like, 23% of the time."
    } ]
  }, {
    "tStartMs": 282360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- How well what you think you know matches"
    } ]
  }, {
    "tStartMs": 284400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "with what you actually know\nis called your calibration."
    } ]
  }, {
    "tStartMs": 287310,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So, if you're perfectly calibrated\nand, say, 80% confident,"
    } ]
  }, {
    "tStartMs": 290700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you should be right 80% of the time,"
    } ]
  }, {
    "tStartMs": 293100,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": "but most of us are not well calibrated."
    } ]
  }, {
    "tStartMs": 295537,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "100%\n- 100%?"
    } ]
  }, {
    "tStartMs": 296880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Yeah.\n- There are 200 billion stars"
    } ]
  }, {
    "tStartMs": 298800,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "in the Milky Way,"
    } ]
  }, {
    "tStartMs": 299910,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "but there are 3 trillion trees on Earth."
    } ]
  }, {
    "tStartMs": 301927,
    "dDurationMs": 1692,
    "segs": [ {
      "utf8": "- [Group] Oh!"
    } ]
  }, {
    "tStartMs": 303619,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(interviewee groans)"
    } ]
  }, {
    "tStartMs": 304452,
    "dDurationMs": 1128,
    "segs": [ {
      "utf8": "- 100% confident?\n- 100, yes."
    } ]
  }, {
    "tStartMs": 305580,
    "dDurationMs": 1984,
    "segs": [ {
      "utf8": "False! (laughs)"
    } ]
  }, {
    "tStartMs": 307564,
    "dDurationMs": 1171,
    "segs": [ {
      "utf8": "(interviewee mimics mocking tune)"
    } ]
  }, {
    "tStartMs": 308735,
    "dDurationMs": 1165,
    "segs": [ {
      "utf8": "(group laughs)"
    } ]
  }, {
    "tStartMs": 309900,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- Most of the time, being\noverconfident isn't a huge issue,"
    } ]
  }, {
    "tStartMs": 313380,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "but for Nick Leeson, the\nstakes soon became very high."
    } ]
  }, {
    "tStartMs": 317130,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Leeson's plan to recover his team's loss"
    } ]
  }, {
    "tStartMs": 319200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "was to bet that the Japanese\nstock market would go up,"
    } ]
  }, {
    "tStartMs": 322080,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "so he went long on the top\n225 companies in Japan,"
    } ]
  }, {
    "tStartMs": 325620,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "the Nikkei 225."
    } ]
  }, {
    "tStartMs": 327540,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Ever since the Japanese asset price bubble"
    } ]
  }, {
    "tStartMs": 329310,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "peaked two years previously,"
    } ]
  }, {
    "tStartMs": 330900,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "the Nikkei had been dropping\nfrom 38,000 to 16,000,"
    } ]
  }, {
    "tStartMs": 335250,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and he was confident the market"
    } ]
  }, {
    "tStartMs": 336600,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "would soon bottom out and start rising,"
    } ]
  }, {
    "tStartMs": 339210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but it continued to fall."
    } ]
  }, {
    "tStartMs": 341490,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Over the next few weeks, it\ndropped to a low of 14,000,"
    } ]
  }, {
    "tStartMs": 345030,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and the whole time, Nick\nwas betting the wrong way"
    } ]
  }, {
    "tStartMs": 347850,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with ever bigger and riskier bets,"
    } ]
  }, {
    "tStartMs": 350550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "he would double down,\nbetting double his losses,"
    } ]
  }, {
    "tStartMs": 352920,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "so the next win would\nbring him back above water."
    } ]
  }, {
    "tStartMs": 355860,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "This strategy should work\nwhen the next win comes along,"
    } ]
  }, {
    "tStartMs": 359190,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but the market collapse was unrelenting,"
    } ]
  }, {
    "tStartMs": 361560,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and his losses ballooned from\n$40,000 to around $3 million."
    } ]
  }, {
    "tStartMs": 366690,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "In spite of this, Leeson\nremained confident,"
    } ]
  }, {
    "tStartMs": 370500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and eventually, his luck turned around."
    } ]
  }, {
    "tStartMs": 372780,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "In the spring of 1993, the\nmarket rebounded up to 20,000,"
    } ]
  }, {
    "tStartMs": 376590,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "and by the summer, that\naccount was back in credit."
    } ]
  }, {
    "tStartMs": 381090,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Leeson goes out to celebrate that weekend,"
    } ]
  }, {
    "tStartMs": 383340,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "drinking and dancing on tables,"
    } ]
  }, {
    "tStartMs": 385290,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "finally free of the hole\nhe had dug himself into."
    } ]
  }, {
    "tStartMs": 390420,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "But on Monday morning,"
    } ]
  }, {
    "tStartMs": 391470,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "he made another trading\nerror on the futures market,"
    } ]
  }, {
    "tStartMs": 394710,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "a damaging loss that Leeson\ndidn't want to admit,"
    } ]
  }, {
    "tStartMs": 397440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "so he put the loss back\ninto account 88888,"
    } ]
  }, {
    "tStartMs": 401280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "confident that if he'd got\noutta the previous one,"
    } ]
  }, {
    "tStartMs": 403530,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "he could do it again."
    } ]
  }, {
    "tStartMs": 405510,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "He began making risky trades"
    } ]
  }, {
    "tStartMs": 407100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to try to recover that initial loss,"
    } ]
  }, {
    "tStartMs": 408990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and as the losses mounted\nin the five eights account,"
    } ]
  }, {
    "tStartMs": 411330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "it became harder and\nharder to make new trades"
    } ]
  }, {
    "tStartMs": 414000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to cover the last loss."
    } ]
  }, {
    "tStartMs": 416160,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "By the end of 1993, his\nlosses exceeded $30 million."
    } ]
  }, {
    "tStartMs": 421470,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Leeson is obviously an extreme example,"
    } ]
  }, {
    "tStartMs": 423570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but this tendency to\noverestimate our abilities"
    } ]
  }, {
    "tStartMs": 426210,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is something we all share."
    } ]
  }, {
    "tStartMs": 427950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So, the question is why?"
    } ]
  }, {
    "tStartMs": 430110,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- The obvious explanation that\na lot of people default to"
    } ]
  }, {
    "tStartMs": 433710,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "that is we wanna feel good about ourselves"
    } ]
  }, {
    "tStartMs": 438630,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and pretend like we're well-informed,"
    } ]
  }, {
    "tStartMs": 442290,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "that we enjoy enormous satisfaction"
    } ]
  }, {
    "tStartMs": 445530,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "from being able to say,"
    } ]
  }, {
    "tStartMs": 448087,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "\"I know,\""
    } ]
  }, {
    "tStartMs": 448920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or even better,"
    } ]
  }, {
    "tStartMs": 449753,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "\"I told you so.\""
    } ]
  }, {
    "tStartMs": 450960,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "And so, we pretend to ourselves and others"
    } ]
  }, {
    "tStartMs": 455310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that we know when we don't."
    } ]
  }, {
    "tStartMs": 456870,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "That is the motivated egocentric version"
    } ]
  }, {
    "tStartMs": 460860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of an explanation for excessive\nfaith in our own judgment."
    } ]
  }, {
    "tStartMs": 463620,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "- [Narrator] Reichelt\nhad faith than the idea,"
    } ]
  }, {
    "tStartMs": 465987,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "if nothing else."
    } ]
  }, {
    "tStartMs": 466830,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "- But what if it's something\nmore uncomfortable, stupidity?"
    } ]
  }, {
    "tStartMs": 470232,
    "dDurationMs": 978,
    "segs": [ {
      "utf8": "(lively retro music)"
    } ]
  }, {
    "tStartMs": 471210,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Franz Reichelt was a tailor\nwith no formal scientific"
    } ]
  }, {
    "tStartMs": 474420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "or engineering training,\nbut he was obsessed"
    } ]
  }, {
    "tStartMs": 476490,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "with solving the problem\nof aviation safety."
    } ]
  }, {
    "tStartMs": 478830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "He spent months designing\na parachute suit,"
    } ]
  }, {
    "tStartMs": 481500,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which repeatedly failed during testing,"
    } ]
  }, {
    "tStartMs": 484290,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but he became convinced the issue"
    } ]
  }, {
    "tStartMs": 486600,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "was that he didn't have\nenough height for it to work."
    } ]
  }, {
    "tStartMs": 489510,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So, in February, 1912, he\ntook it to the Eiffel Tower,"
    } ]
  }, {
    "tStartMs": 492630,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "and rather than using a dummy\nto test it, he jumped himself."
    } ]
  }, {
    "tStartMs": 497100,
    "dDurationMs": 2055,
    "segs": [ {
      "utf8": "Tragic, but also really dumb."
    } ]
  }, {
    "tStartMs": 499155,
    "dDurationMs": 855,
    "segs": [ {
      "utf8": "(soft electro music)"
    } ]
  }, {
    "tStartMs": 500010,
    "dDurationMs": 2697,
    "segs": [ {
      "utf8": "Do you recognize this graph?"
    } ]
  }, {
    "tStartMs": 502707,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "- The, like, Dunning-Kruger graph?"
    } ]
  }, {
    "tStartMs": 505260,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Are you confident that this"
    } ]
  }, {
    "tStartMs": 506310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is the actual Dunning-Kruger graph?"
    } ]
  }, {
    "tStartMs": 508320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Not at all, in fact, I think"
    } ]
  }, {
    "tStartMs": 509730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that this is not the Dunning-Kruger graph."
    } ]
  }, {
    "tStartMs": 511200,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "I think that this is a bit\nof a communication trick."
    } ]
  }, {
    "tStartMs": 514980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- This is what people call\nthe Mount Stupid Curve,"
    } ]
  }, {
    "tStartMs": 517440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "which will pop up if you search"
    } ]
  }, {
    "tStartMs": 518820,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for the Dunning-Kruger\neffect into Google images."
    } ]
  }, {
    "tStartMs": 521070,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- As far as I understand\nit, it's an effect"
    } ]
  }, {
    "tStartMs": 524280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that says that when you\nknow very little about it,"
    } ]
  }, {
    "tStartMs": 526440,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "your confidence is high,"
    } ]
  }, {
    "tStartMs": 528210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and as you know more about it,"
    } ]
  }, {
    "tStartMs": 529740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "your confidence sinks until\nyou become a master at it."
    } ]
  }, {
    "tStartMs": 532500,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- But I think that the actual result"
    } ]
  }, {
    "tStartMs": 534030,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is, like, a little bit\nmore fuzzy than this."
    } ]
  }, {
    "tStartMs": 537180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It was."
    } ]
  }, {
    "tStartMs": 539040,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This graph doesn't actually\nshow the Dunning-Kruger effect."
    } ]
  }, {
    "tStartMs": 542070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It's just a meme that\nresonates with a lot of people,"
    } ]
  }, {
    "tStartMs": 544860,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and it became conflated with the effect."
    } ]
  }, {
    "tStartMs": 547530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "In their original research,"
    } ]
  }, {
    "tStartMs": 548820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Dunning and Kruger tested people"
    } ]
  }, {
    "tStartMs": 550560,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "on tasks like grammar, logic and humor,"
    } ]
  }, {
    "tStartMs": 553320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and then they asked\nparticipants to estimate"
    } ]
  }, {
    "tStartMs": 555540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "how well they performed."
    } ]
  }, {
    "tStartMs": 557130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "That produced this curve."
    } ]
  }, {
    "tStartMs": 559260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "You can see that those who performed worse"
    } ]
  }, {
    "tStartMs": 561600,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "had the largest mismatch"
    } ]
  }, {
    "tStartMs": 562860,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "between their confidence and performance."
    } ]
  }, {
    "tStartMs": 564720,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They were the most overconfident."
    } ]
  }, {
    "tStartMs": 566970,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Those who performed the best"
    } ]
  }, {
    "tStartMs": 568230,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "were actually slightly underconfident."
    } ]
  }, {
    "tStartMs": 570510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "This suggests that\noverconfidence may be linked"
    } ]
  }, {
    "tStartMs": 572790,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to how much we know."
    } ]
  }, {
    "tStartMs": 574530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Those who know less think that\nthey know more than they do,"
    } ]
  }, {
    "tStartMs": 577920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but to me, this effect looks a little"
    } ]
  }, {
    "tStartMs": 580080,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "like a statistical artifact"
    } ]
  }, {
    "tStartMs": 581730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "because while I was doing my PhD,"
    } ]
  }, {
    "tStartMs": 583500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I asked students some physics questions"
    } ]
  }, {
    "tStartMs": 585780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and I also asked for their\nconfidence in their answers."
    } ]
  }, {
    "tStartMs": 588750,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And when I looked at the results,"
    } ]
  }, {
    "tStartMs": 590430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "accuracy spanned the full range"
    } ]
  }, {
    "tStartMs": 592440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "from nearly 0% to 100%,"
    } ]
  }, {
    "tStartMs": 595560,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "but confidence varied over\na much narrower range."
    } ]
  }, {
    "tStartMs": 599130,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "All the scores were roughly in the middle."
    } ]
  }, {
    "tStartMs": 601680,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "This meant that poor performers\nwere the most overconfident"
    } ]
  }, {
    "tStartMs": 604980,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and the highest performers"
    } ]
  }, {
    "tStartMs": 606300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "were actually slightly under confident."
    } ]
  }, {
    "tStartMs": 608460,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "This is exactly what\nDunning and Kruger found,"
    } ]
  }, {
    "tStartMs": 611190,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "so maybe overconfidence isn't entirely"
    } ]
  }, {
    "tStartMs": 613830,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "due to how much we know,"
    } ]
  }, {
    "tStartMs": 615330,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but also because most of us express"
    } ]
  }, {
    "tStartMs": 617490,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "at least kind of\nmiddle-of-the-road confidence."
    } ]
  }, {
    "tStartMs": 620520,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But there is another factor at play here,"
    } ]
  }, {
    "tStartMs": 623190,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which is how much information our brains"
    } ]
  }, {
    "tStartMs": 625740,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "are capable of processing."
    } ]
  }, {
    "tStartMs": 628530,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Monday, the 27th of January, 1986,"
    } ]
  }, {
    "tStartMs": 631290,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "it's 5:45 PM at the Kennedy\nSpace Center in Cape Canaveral,"
    } ]
  }, {
    "tStartMs": 634440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and the engineers from Morton Thiokol,"
    } ]
  }, {
    "tStartMs": 636690,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "who made the Challenger space\nshuttle's rocket boosters"
    } ]
  }, {
    "tStartMs": 639150,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "make an emergency conference call."
    } ]
  }, {
    "tStartMs": 641220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "They've just seen the weather forecast,"
    } ]
  }, {
    "tStartMs": 642750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "predicting temperatures\novernight will plummet"
    } ]
  }, {
    "tStartMs": 644700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to 25 degrees Fahrenheit,"
    } ]
  }, {
    "tStartMs": 646380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "far colder than any\nprevious shuttle launch."
    } ]
  }, {
    "tStartMs": 649440,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They know the rubber\nO-rings that seal joints"
    } ]
  }, {
    "tStartMs": 651900,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "in the boosters become less flexible"
    } ]
  }, {
    "tStartMs": 653640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "in the cold, but have just\na few hours to gather data,"
    } ]
  }, {
    "tStartMs": 656460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "create charts, and present their case."
    } ]
  }, {
    "tStartMs": 658320,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Over the next six hours,"
    } ]
  }, {
    "tStartMs": 659460,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the engineers present 13 charts with data"
    } ]
  }, {
    "tStartMs": 661860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "on O-ring temperature, hot gas erosion,"
    } ]
  }, {
    "tStartMs": 664290,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "joint rotation, and more."
    } ]
  }, {
    "tStartMs": 666540,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But the data is scattered, incomplete,"
    } ]
  }, {
    "tStartMs": 668610,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and not synthesized\ninto a clear narrative."
    } ]
  }, {
    "tStartMs": 671040,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They'd never tested below\n53 degrees Fahrenheit,"
    } ]
  }, {
    "tStartMs": 673560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so NASA managers were\ntrying simultaneously"
    } ]
  }, {
    "tStartMs": 675840,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to track historical O-ring\ndata, erosion patterns,"
    } ]
  }, {
    "tStartMs": 678810,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "joint dynamics, seal resiliency,"
    } ]
  }, {
    "tStartMs": 681120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "pressure differentials, and more."
    } ]
  }, {
    "tStartMs": 683430,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "No single chart told the whole story."
    } ]
  }, {
    "tStartMs": 685710,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So, overwhelmed by\nseemingly contradictory data"
    } ]
  }, {
    "tStartMs": 688620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and confident that their\nrocket boosters were safe,"
    } ]
  }, {
    "tStartMs": 691260,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Thiokol management overruled\ntheir own engineers"
    } ]
  }, {
    "tStartMs": 694350,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and approved the launch."
    } ]
  }, {
    "tStartMs": 695790,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "(fire roars)"
    } ]
  }, {
    "tStartMs": 697530,
    "dDurationMs": 3936,
    "segs": [ {
      "utf8": "At 11:38 the next morning,\n73 seconds after launch,"
    } ]
  }, {
    "tStartMs": 701466,
    "dDurationMs": 2124,
    "segs": [ {
      "utf8": "(explosion booms)"
    } ]
  }, {
    "tStartMs": 703590,
    "dDurationMs": 2729,
    "segs": [ {
      "utf8": "all seven crew members were killed."
    } ]
  }, {
    "tStartMs": 706319,
    "dDurationMs": 1111,
    "segs": [ {
      "utf8": "(chiming mysterious music)"
    } ]
  }, {
    "tStartMs": 707430,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "- Calibrating your\ncertainty requires thinking"
    } ]
  }, {
    "tStartMs": 711570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of all the ways that you could be wrong,"
    } ]
  }, {
    "tStartMs": 713940,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and that's hard for finite,\nfallible agents like us"
    } ]
  }, {
    "tStartMs": 718020,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "if it means considering\neverything that we don't know."
    } ]
  }, {
    "tStartMs": 721950,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- How many chunks of novel\ninformation you can hold"
    } ]
  }, {
    "tStartMs": 724080,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "in your head at one time is\nyour short-term memory capacity."
    } ]
  }, {
    "tStartMs": 727530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "In 2008, Hansson, Juslin, and Windmann"
    } ]
  }, {
    "tStartMs": 729870,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "investigated how\nshort-term memory capacity"
    } ]
  }, {
    "tStartMs": 731850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "was linked to accuracy and overconfidence."
    } ]
  }, {
    "tStartMs": 733950,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Participants were asked to give ranges"
    } ]
  }, {
    "tStartMs": 735420,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for factual questions\nlike the length of a river"
    } ]
  }, {
    "tStartMs": 737610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "or the population of a city."
    } ]
  }, {
    "tStartMs": 738870,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "People's ranges were\nconsistently too narrow,"
    } ]
  }, {
    "tStartMs": 741300,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "which effectively meant they\nwere being overconfident,"
    } ]
  }, {
    "tStartMs": 744120,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and those who had worse short-term memory"
    } ]
  }, {
    "tStartMs": 746100,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "were more often wrong and more\nlikely to be overconfident."
    } ]
  }, {
    "tStartMs": 749940,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Another study conducted by\nConte in 2023 asked participants"
    } ]
  }, {
    "tStartMs": 753120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to keep sequences of letters in their mind"
    } ]
  }, {
    "tStartMs": 755280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "while they judged their own performance."
    } ]
  }, {
    "tStartMs": 757290,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "As the memory load increased,"
    } ]
  }, {
    "tStartMs": 759000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "confidence estimates became less accurate,"
    } ]
  }, {
    "tStartMs": 761340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "even for participants with\nhigher working memory capacities."
    } ]
  }, {
    "tStartMs": 764310,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Together, these studies suggest\nthat assessing your accuracy"
    } ]
  }, {
    "tStartMs": 767010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is a mentally taxing task."
    } ]
  }, {
    "tStartMs": 769410,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So, overconfidence isn't\nnecessarily about arrogance."
    } ]
  }, {
    "tStartMs": 772170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It's your brain working at the limits"
    } ]
  }, {
    "tStartMs": 774150,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of what it can track and hold."
    } ]
  }, {
    "tStartMs": 776220,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "And because of this, your brain\ncan start using shortcuts."
    } ]
  }, {
    "tStartMs": 780330,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Psychologist Daniel Kahneman describes"
    } ]
  }, {
    "tStartMs": 781920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "these mental shortcuts as\nheuristics, that together,"
    } ]
  }, {
    "tStartMs": 784320,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "create systemic errors\ncalled cognitive biases."
    } ]
  }, {
    "tStartMs": 787260,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "One shortcut we use a lot is\nsubstituting hard questions"
    } ]
  }, {
    "tStartMs": 790260,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with easier related ones."
    } ]
  }, {
    "tStartMs": 791940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Researchers have tested\nthis by asking students"
    } ]
  }, {
    "tStartMs": 793980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "how happy they were in their life"
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and how many dates they'd\nhad in the last month."
    } ]
  }, {
    "tStartMs": 798300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Unsurprisingly, these two\nquestions did not correlate."
    } ]
  }, {
    "tStartMs": 801300,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "There's a lot more to happiness\nthan matches on Tinder,"
    } ]
  }, {
    "tStartMs": 803910,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "at least for most people."
    } ]
  }, {
    "tStartMs": 805380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "However, if you switch it around"
    } ]
  }, {
    "tStartMs": 807180,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and ask about their dates first,"
    } ]
  }, {
    "tStartMs": 808920,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "suddenly, the correlation jumps to 0.66."
    } ]
  }, {
    "tStartMs": 811890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Working out how happy you are in your life"
    } ]
  }, {
    "tStartMs": 813900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is a difficult question."
    } ]
  }, {
    "tStartMs": 815340,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "You have to consider many\nthings and balance them all out."
    } ]
  }, {
    "tStartMs": 818190,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So, when you're primed"
    } ]
  }, {
    "tStartMs": 819480,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "with the information\nabout your dating life,"
    } ]
  }, {
    "tStartMs": 821430,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "you're very likely to\nsubstitute that hard question,"
    } ]
  }, {
    "tStartMs": 824250,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "how happy am I in my life,"
    } ]
  }, {
    "tStartMs": 826020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "with, how many dates have I recently had?"
    } ]
  }, {
    "tStartMs": 828630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Overconfidence from\nmisprocessing information"
    } ]
  }, {
    "tStartMs": 831150,
    "dDurationMs": 1949,
    "segs": [ {
      "utf8": "like this can be disastrous."
    } ]
  }, {
    "tStartMs": 833099,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "(low mysterious music)"
    } ]
  }, {
    "tStartMs": 834060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So, why are our brains wired this way?"
    } ]
  }, {
    "tStartMs": 836700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I mean, you might expect natural selection"
    } ]
  }, {
    "tStartMs": 838530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "to have wiped out the\nconfidently incorrect,"
    } ]
  }, {
    "tStartMs": 841920,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but there is evidence that overconfidence"
    } ]
  }, {
    "tStartMs": 844290,
    "dDurationMs": 1924,
    "segs": [ {
      "utf8": "can actually be advantageous."
    } ]
  }, {
    "tStartMs": 847890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Overconfidence can massively\nimprove your status."
    } ]
  }, {
    "tStartMs": 851010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "In a scientific version\nof \"The Apprentice,\""
    } ]
  }, {
    "tStartMs": 852870,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "scientists in 2012 compared\nparticipants' own assessments"
    } ]
  }, {
    "tStartMs": 855930,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "of their skill with objective measures."
    } ]
  }, {
    "tStartMs": 858060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They placed them in group\ntasks to see who is chosen"
    } ]
  }, {
    "tStartMs": 860700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "as a leader and whose\nideas influenced the group,"
    } ]
  }, {
    "tStartMs": 863100,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "tracking status over multiple sessions"
    } ]
  }, {
    "tStartMs": 865110,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and assessing whether the desire\nfor status led participants"
    } ]
  }, {
    "tStartMs": 867810,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to exaggerate their abilities."
    } ]
  }, {
    "tStartMs": 869550,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The results were clear,"
    } ]
  }, {
    "tStartMs": 871080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "overconfident individuals\nwere more likely to lead,"
    } ]
  }, {
    "tStartMs": 873810,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "assert themselves, and maintain influence,"
    } ]
  }, {
    "tStartMs": 876300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "even when their actual abilities were mid."
    } ]
  }, {
    "tStartMs": 879060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And the evidence certainly\nshows people react better"
    } ]
  }, {
    "tStartMs": 881700,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to confident individuals."
    } ]
  }, {
    "tStartMs": 883350,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Using an fMRI, researchers\nat the University of Sussex"
    } ]
  }, {
    "tStartMs": 886590,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "measured brain activity of people"
    } ]
  }, {
    "tStartMs": 888150,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "after hearing unconfident\nversus confident advice,"
    } ]
  }, {
    "tStartMs": 891870,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and those who listened\nto the confident advice"
    } ]
  }, {
    "tStartMs": 893760,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "had increased activity"
    } ]
  }, {
    "tStartMs": 894900,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "in the ventromedial prefrontal cortex."
    } ]
  }, {
    "tStartMs": 897150,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That's a brain region associated\nwith processing rewards"
    } ]
  }, {
    "tStartMs": 899790,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and expected satisfaction."
    } ]
  }, {
    "tStartMs": 901320,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This means that human brains\nare biologically tuned"
    } ]
  }, {
    "tStartMs": 904350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to be influenced by confident individuals."
    } ]
  }, {
    "tStartMs": 907140,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "We literally feel better when\nwe hear confident people."
    } ]
  }, {
    "tStartMs": 910590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- But recognizing that dynamic"
    } ]
  }, {
    "tStartMs": 913590,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "highlights a potentially\nproblematic incentive"
    } ]
  }, {
    "tStartMs": 917100,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "for anyone who's contending\nfor positions that they want."
    } ]
  }, {
    "tStartMs": 921030,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "People who express more confidence\nin employment interviews"
    } ]
  }, {
    "tStartMs": 925830,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "or political campaigns, for instance,"
    } ]
  }, {
    "tStartMs": 929160,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "do earn the confidence of\ninterviewers and potential voters,"
    } ]
  }, {
    "tStartMs": 934590,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "even if they're being overconfident."
    } ]
  }, {
    "tStartMs": 937560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They can't actually deliver."
    } ]
  }, {
    "tStartMs": 939000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "They don't actually know the answer,"
    } ]
  }, {
    "tStartMs": 941220,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "but they can talk a good\nline to impress others,"
    } ]
  }, {
    "tStartMs": 945090,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "even if they can't ultimately deliver"
    } ]
  }, {
    "tStartMs": 946980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "on those grand assertions."
    } ]
  }, {
    "tStartMs": 948840,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They know the audience"
    } ]
  }, {
    "tStartMs": 951090,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "will place more faith in\nthem, if they express..."
    } ]
  }, {
    "tStartMs": 953280,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Well, they should express\nmaximal confidence."
    } ]
  }, {
    "tStartMs": 956220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] Leeson knew this\nand he took advantage of it."
    } ]
  }, {
    "tStartMs": 958500,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "While he was secretly racking up"
    } ]
  }, {
    "tStartMs": 960120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "huge losses in the infamous\nfive eights account,"
    } ]
  }, {
    "tStartMs": 962520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "he was publicly posting huge profits"
    } ]
  }, {
    "tStartMs": 965130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and everyone believed the illusion."
    } ]
  }, {
    "tStartMs": 966990,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "- They come in and they\ndon't test any records,"
    } ]
  }, {
    "tStartMs": 970770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so I can't be happier."
    } ]
  }, {
    "tStartMs": 972750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "They didn't test one record."
    } ]
  }, {
    "tStartMs": 974100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] As Leeson's\nhidden losses mounted,"
    } ]
  }, {
    "tStartMs": 975780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "he requested huge sums from head office"
    } ]
  }, {
    "tStartMs": 978000,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to keep doubling down up\nto $5 million at a time."
    } ]
  }, {
    "tStartMs": 981510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Barings management, barely\nunderstanding futures"
    } ]
  }, {
    "tStartMs": 983790,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and believing in their star trader,"
    } ]
  }, {
    "tStartMs": 985290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "they granted his requests"
    } ]
  }, {
    "tStartMs": 987030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and continued to grant future requests."
    } ]
  }, {
    "tStartMs": 989520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Every day that I make\none of these requests"
    } ]
  }, {
    "tStartMs": 991260,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "for additional money, I\nnever expect it to come."
    } ]
  }, {
    "tStartMs": 993270,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "I expect somebody to say,"
    } ]
  }, {
    "tStartMs": 994927,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "\"Look, mate, what the hell's going on?\""
    } ]
  }, {
    "tStartMs": 997140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- By Autumn 1994,"
    } ]
  }, {
    "tStartMs": 998550,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the account was nearly\n$260 million in the red."
    } ]
  }, {
    "tStartMs": 1002150,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "To mask this, Leeson began\nbuying futures from himself,"
    } ]
  }, {
    "tStartMs": 1005450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "inflating his perceived profits further."
    } ]
  }, {
    "tStartMs": 1007580,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "At SIMEX's 10th anniversary in September,"
    } ]
  }, {
    "tStartMs": 1010250,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Barings received two awards,\nlargely credited to Leeson."
    } ]
  }, {
    "tStartMs": 1013970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "In December, he was flown to New York,"
    } ]
  }, {
    "tStartMs": 1015740,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "seemingly responsible for $44 million"
    } ]
  }, {
    "tStartMs": 1018050,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in Barings turnover that year."
    } ]
  }, {
    "tStartMs": 1020240,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Some traders raised doubts"
    } ]
  }, {
    "tStartMs": 1021740,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that these kinds of profits could be made"
    } ]
  }, {
    "tStartMs": 1023420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "from the low risk trading\nhe was supposed to be doing."
    } ]
  }, {
    "tStartMs": 1025700,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But management's faith in\nLeeson's talent was unshakeable,"
    } ]
  }, {
    "tStartMs": 1028910,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and they dismissed these concerns."
    } ]
  }, {
    "tStartMs": 1031190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Barings' overconfidence in Leeson"
    } ]
  }, {
    "tStartMs": 1032990,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and Leeson's overconfidence in himself"
    } ]
  }, {
    "tStartMs": 1035150,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "would be the bank's downfall."
    } ]
  }, {
    "tStartMs": 1037220,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "The figures are so big,"
    } ]
  }, {
    "tStartMs": 1038690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "it seems like the\nultimate confidence trick,"
    } ]
  }, {
    "tStartMs": 1041480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but there's a partial explanation"
    } ]
  }, {
    "tStartMs": 1043310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for the delusion on both sides."
    } ]
  }, {
    "tStartMs": 1045440,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Leeson's and Barings'\noverconfidence was amplified"
    } ]
  }, {
    "tStartMs": 1048290,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "by the complexity and\nunpredictability of the market"
    } ]
  }, {
    "tStartMs": 1050930,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and the trades he was making."
    } ]
  }, {
    "tStartMs": 1052490,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "It's sort of an issue of feedback."
    } ]
  }, {
    "tStartMs": 1056960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "In a controlled environment\nwhere there are clear rules"
    } ]
  }, {
    "tStartMs": 1059300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and guaranteed outcomes\nlike in a chess match,"
    } ]
  }, {
    "tStartMs": 1062000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "there is clear feedback"
    } ]
  }, {
    "tStartMs": 1063200,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "on whether decisions are good or bad."
    } ]
  }, {
    "tStartMs": 1065150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "With reliable feedback,\nprofessional chess players"
    } ]
  }, {
    "tStartMs": 1067700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "are able to learn to make better decisions"
    } ]
  }, {
    "tStartMs": 1069620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with more accurate confidence."
    } ]
  }, {
    "tStartMs": 1071540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But in a noisy environment\nwhere there is rarely consistent"
    } ]
  }, {
    "tStartMs": 1074780,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or timely consequences for predictions,"
    } ]
  }, {
    "tStartMs": 1076970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "this feedback is unreliable."
    } ]
  }, {
    "tStartMs": 1078770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Whether our confidence\nis accurate or misplaced"
    } ]
  }, {
    "tStartMs": 1081290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "is increasingly hard to\njudge, even amongst experts."
    } ]
  }, {
    "tStartMs": 1084050,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It's especially problematic\nfor political pundits."
    } ]
  }, {
    "tStartMs": 1086960,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- This is going to be a landslide."
    } ]
  }, {
    "tStartMs": 1088790,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I think Romney's gonna win by quite a bit."
    } ]
  }, {
    "tStartMs": 1090710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- So, right now, we have\nHillary's about a 75"
    } ]
  }, {
    "tStartMs": 1092990,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "or an 80% favorite."
    } ]
  }, {
    "tStartMs": 1094340,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- [Derek] For example, prior to 2024,"
    } ]
  }, {
    "tStartMs": 1096230,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "political analyst Allan Lichtman"
    } ]
  }, {
    "tStartMs": 1097760,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "had accurately predicted\nthe winner of nine"
    } ]
  }, {
    "tStartMs": 1099530,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of the 10 previous US\npresidential elections,"
    } ]
  }, {
    "tStartMs": 1102020,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "using his 13 keys to\nthe White House method."
    } ]
  }, {
    "tStartMs": 1104690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Using the same strategy in\n2024, he predicted that-"
    } ]
  }, {
    "tStartMs": 1107570,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- Kamala Harris will be a\nprecedent-breaking president."
    } ]
  }, {
    "tStartMs": 1112850,
    "dDurationMs": 1103,
    "segs": [ {
      "utf8": "- And look what happened."
    } ]
  }, {
    "tStartMs": 1113953,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "Is this crazy?\n(crowd cheering)"
    } ]
  }, {
    "tStartMs": 1116270,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- He attributed his\nmiscalculation to the spread"
    } ]
  }, {
    "tStartMs": 1118580,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of disinformation that\nmisled the electorate."
    } ]
  }, {
    "tStartMs": 1120920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "This noisy environment made it difficult"
    } ]
  }, {
    "tStartMs": 1122870,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to discern key issues like the\nactual state of the economy."
    } ]
  }, {
    "tStartMs": 1126020,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Similarly, the feedback Leeson"
    } ]
  }, {
    "tStartMs": 1127910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "had received was inconsistent."
    } ]
  }, {
    "tStartMs": 1129770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "He was making some bad trades,"
    } ]
  }, {
    "tStartMs": 1131330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but he had also won it all back before,"
    } ]
  }, {
    "tStartMs": 1133670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and this significantly\nclouded his judgment,"
    } ]
  }, {
    "tStartMs": 1135860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "amplifying his overconfidence."
    } ]
  }, {
    "tStartMs": 1137690,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "By 1995, Leeson's losses were\nin the hundreds of millions,"
    } ]
  }, {
    "tStartMs": 1141440,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "and Barings had unwittingly\nsent him $1 billion."
    } ]
  }, {
    "tStartMs": 1145370,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "For a bank with around $700\nmillion in capital base,"
    } ]
  }, {
    "tStartMs": 1149000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "they were legally only allowed to lend"
    } ]
  }, {
    "tStartMs": 1151220,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "around a quarter of that,"
    } ]
  }, {
    "tStartMs": 1152630,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but no one questioned it."
    } ]
  }, {
    "tStartMs": 1154040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "They were all blinded\nby his apparent success."
    } ]
  }, {
    "tStartMs": 1156770,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "At this point, his positions were so big,"
    } ]
  }, {
    "tStartMs": 1158570,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "he estimates that he was probably half"
    } ]
  }, {
    "tStartMs": 1160430,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of the entire Nikkei futures market,"
    } ]
  }, {
    "tStartMs": 1162770,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "so all he could do was\nbuy himself some time"
    } ]
  }, {
    "tStartMs": 1164720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and hope that the market went his way."
    } ]
  }, {
    "tStartMs": 1166940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And for a while, it worked."
    } ]
  }, {
    "tStartMs": 1168800,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The economy was stable and\nhe couldn't see anything"
    } ]
  }, {
    "tStartMs": 1171500,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "on the horizon that would change this."
    } ]
  }, {
    "tStartMs": 1173720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But then disaster struck."
    } ]
  }, {
    "tStartMs": 1176210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Reporter] Japan is tonight\nin a state of mourning"
    } ]
  }, {
    "tStartMs": 1178070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and of shock.\n(siren wailing)"
    } ]
  }, {
    "tStartMs": 1180080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- On the 17th of January, 1995,"
    } ]
  }, {
    "tStartMs": 1181940,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the Great Hanshin Earthquake struck Japan"
    } ]
  }, {
    "tStartMs": 1184430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "20 kilometers from the city of Kobe."
    } ]
  }, {
    "tStartMs": 1186680,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "With the magnitude of 6.9,\nit devastated the city,"
    } ]
  }, {
    "tStartMs": 1189980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which was one of Japan's key ports."
    } ]
  }, {
    "tStartMs": 1192140,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This devastation spread\nto the stock market."
    } ]
  }, {
    "tStartMs": 1194690,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The Nikkei index plunged 1055 points."
    } ]
  }, {
    "tStartMs": 1197930,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Leeson, attempting to double down again,"
    } ]
  }, {
    "tStartMs": 1199940,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "risked even more money."
    } ]
  }, {
    "tStartMs": 1201620,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "He bet heavily that the Nikkei\nwould make a rapid recovery,"
    } ]
  }, {
    "tStartMs": 1205130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "but it didn't."
    } ]
  }, {
    "tStartMs": 1206510,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And in the end, in today's money,"
    } ]
  }, {
    "tStartMs": 1208250,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "Leeson had lost $2.8 billion."
    } ]
  }, {
    "tStartMs": 1212000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "On the 23rd of February,\nLeeson went on the run."
    } ]
  }, {
    "tStartMs": 1215000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And three days later, Barings,"
    } ]
  }, {
    "tStartMs": 1216440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "one of the oldest and most trusted banks"
    } ]
  }, {
    "tStartMs": 1218270,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "in the world, collapsed."
    } ]
  }, {
    "tStartMs": 1220310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Overconfidence was at\nleast partially to blame"
    } ]
  }, {
    "tStartMs": 1222980,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for its downfall."
    } ]
  }, {
    "tStartMs": 1224240,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Realizing the walls were closing in,"
    } ]
  }, {
    "tStartMs": 1226190,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Leeson fled to Malaysia and then Thailand,"
    } ]
  }, {
    "tStartMs": 1228740,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but his escape was short-lived."
    } ]
  }, {
    "tStartMs": 1230390,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "He was eventually arrested in Germany"
    } ]
  }, {
    "tStartMs": 1232100,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and extradited to face justice,"
    } ]
  }, {
    "tStartMs": 1233870,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "marking the end of a\nspectacularly destructive gamble."
    } ]
  }, {
    "tStartMs": 1236990,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "He was just 28 years old."
    } ]
  }, {
    "tStartMs": 1240710,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Now, we don't all bring down banks,"
    } ]
  }, {
    "tStartMs": 1242570,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but we are all vulnerable\nto overconfidence."
    } ]
  }, {
    "tStartMs": 1245510,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "In a complex world with\nunclear, noisy feedback"
    } ]
  }, {
    "tStartMs": 1248240,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "where our brains are overwhelmed,"
    } ]
  }, {
    "tStartMs": 1250220,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "a set of simplistic biases can take over."
    } ]
  }, {
    "tStartMs": 1253190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And we all too often end up thinking"
    } ]
  }, {
    "tStartMs": 1255080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "we know more than we do."
    } ]
  }, {
    "tStartMs": 1256670,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So, what can we actually do about this?"
    } ]
  }, {
    "tStartMs": 1259340,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "- I try to get better at\ncalibrating my confidence judgments"
    } ]
  }, {
    "tStartMs": 1263720,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "by keeping track and keeping score."
    } ]
  }, {
    "tStartMs": 1266960,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "So, when a colleague asks me,"
    } ]
  }, {
    "tStartMs": 1269067,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "\"How long is it going to take you"
    } ]
  }, {
    "tStartMs": 1270950,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to get me comments on this\npaper draft we're working on?\""
    } ]
  }, {
    "tStartMs": 1275270,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I don't promise I'll do it by Friday."
    } ]
  }, {
    "tStartMs": 1278540,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "I'm much more likely\nto say something like,"
    } ]
  }, {
    "tStartMs": 1280557,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "\"I think there's a 60% chance"
    } ]
  }, {
    "tStartMs": 1282170,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I can get you comments by Friday.\""
    } ]
  }, {
    "tStartMs": 1283850,
    "dDurationMs": 6323,
    "segs": [ {
      "utf8": "They'll often react with a\nquizzical look or a laugh."
    } ]
  }, {
    "tStartMs": 1290390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- Well, practicing and being\naware of our calibration"
    } ]
  }, {
    "tStartMs": 1292760,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "is the obvious way to improve,"
    } ]
  }, {
    "tStartMs": 1294230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but so is being intellectually humble."
    } ]
  }, {
    "tStartMs": 1297140,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- I think that the best\nmedicine for overconfidence"
    } ]
  }, {
    "tStartMs": 1302510,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "is not so much information\nas feedback, (chuckles)"
    } ]
  }, {
    "tStartMs": 1305810,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "and I get plenty of that. (laughs)"
    } ]
  }, {
    "tStartMs": 1307945,
    "dDurationMs": 955,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 1308900,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Though also, I think people are right,"
    } ]
  }, {
    "tStartMs": 1310850,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that sometimes I do have a\nlittle bit of overconfidence."
    } ]
  }, {
    "tStartMs": 1313310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- If we wanna become more accurate,"
    } ]
  }, {
    "tStartMs": 1315620,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "we should capitalize on\nthe wisdom of the crowd"
    } ]
  }, {
    "tStartMs": 1317510,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "by listening more to others."
    } ]
  }, {
    "tStartMs": 1319370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "In particular, we should listen"
    } ]
  }, {
    "tStartMs": 1320810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to people who disagree with us."
    } ]
  }, {
    "tStartMs": 1322220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Understanding the best\narguments of your critics,"
    } ]
  }, {
    "tStartMs": 1325100,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "understanding what information"
    } ]
  }, {
    "tStartMs": 1326960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "those who disagree with\nyou have that you lack"
    } ]
  }, {
    "tStartMs": 1329720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "is very helpful for\nmaking better decisions."
    } ]
  }, {
    "tStartMs": 1331940,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- The best calibrated people\naren't those who know the most."
    } ]
  }, {
    "tStartMs": 1335210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "It's those who know what they don't know."
    } ]
  }, {
    "tStartMs": 1337880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, true wisdom lies not in being certain,"
    } ]
  }, {
    "tStartMs": 1340700,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but in knowing the limits\nof your own certainty."
    } ]
  }, {
    "tStartMs": 1343850,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And that's an idea that's\ninspired our latest project."
    } ]
  }, {
    "tStartMs": 1347000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "All those questions I asked-"
    } ]
  }, {
    "tStartMs": 1348440,
    "dDurationMs": 1388,
    "segs": [ {
      "utf8": "- These are good questions. (laughs)"
    } ]
  }, {
    "tStartMs": 1349828,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Aw!"
    } ]
  }, {
    "tStartMs": 1350668,
    "dDurationMs": 952,
    "segs": [ {
      "utf8": "(Hannah laughs)"
    } ]
  }, {
    "tStartMs": 1351620,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- They come from a new\nboard game that we've made."
    } ]
  }, {
    "tStartMs": 1353840,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It's called \"Elements of Truth.\""
    } ]
  }, {
    "tStartMs": 1356150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The game contains over 800 fascinating"
    } ]
  }, {
    "tStartMs": 1358610,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "science trivia questions with a twist."
    } ]
  }, {
    "tStartMs": 1360860,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The number of points\nyou win on each question"
    } ]
  }, {
    "tStartMs": 1363110,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "depends on how confident you are."
    } ]
  }, {
    "tStartMs": 1366290,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You can bid any number from 1 to 10."
    } ]
  }, {
    "tStartMs": 1368930,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "If you're not sure, you\ncan play a low number"
    } ]
  }, {
    "tStartMs": 1371540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "or you can try to follow\nthe lead of someone else"
    } ]
  }, {
    "tStartMs": 1373790,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "who you think should know the answer."
    } ]
  }, {
    "tStartMs": 1375830,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "We've tested this game with scientists,"
    } ]
  }, {
    "tStartMs": 1377960,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "teachers, and students,\nand what we've found"
    } ]
  }, {
    "tStartMs": 1380690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is that it regularly leads to discussions"
    } ]
  }, {
    "tStartMs": 1382730,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that go way beyond the initial questions."
    } ]
  }, {
    "tStartMs": 1386030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The core game comes with 200 questions"
    } ]
  }, {
    "tStartMs": 1388130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that cover all aspects of science,"
    } ]
  }, {
    "tStartMs": 1389960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and there are five additional\npacks on specific topics"
    } ]
  }, {
    "tStartMs": 1392840,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "like physics, technology,\nengineering, and astronomy."
    } ]
  }, {
    "tStartMs": 1396050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Plus, there's a Veritasium\npack on concepts covered"
    } ]
  }, {
    "tStartMs": 1398660,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "in many of our most popular videos."
    } ]
  }, {
    "tStartMs": 1401690,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "We're launching the\ngame through Kickstarter"
    } ]
  }, {
    "tStartMs": 1403280,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to give you the opportunity\nto shape it with us."
    } ]
  }, {
    "tStartMs": 1406040,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Over the next month, you'll\nbe able to submit questions"
    } ]
  }, {
    "tStartMs": 1408410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "for a special community pack."
    } ]
  }, {
    "tStartMs": 1410510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is your chance to etch your name"
    } ]
  }, {
    "tStartMs": 1412550,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "into Veritasium history"
    } ]
  }, {
    "tStartMs": 1413900,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "with a credited question in the game."
    } ]
  }, {
    "tStartMs": 1416570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "To reserve your copy and get involved,"
    } ]
  }, {
    "tStartMs": 1418700,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "use this QR code or the\nlink in the description"
    } ]
  }, {
    "tStartMs": 1421370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to head over to Kickstarter."
    } ]
  }, {
    "tStartMs": 1423650,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "It is only because of\nyou that I've been able"
    } ]
  }, {
    "tStartMs": 1425900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to make this channel and this game,"
    } ]
  }, {
    "tStartMs": 1427940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "so as always, I wanna\nthank you for your support"
    } ]
  }, {
    "tStartMs": 1430850,
    "dDurationMs": 1654,
    "segs": [ {
      "utf8": "and thank you for watching."
    } ]
  } ]
}
