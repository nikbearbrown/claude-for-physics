{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] On the morning\nof the 17th of April, 2013,"
    } ]
  }, {
    "tStartMs": 2610,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "the journal Annals of Mathematics\nreceived a curious email."
    } ]
  }, {
    "tStartMs": 6270,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "It claimed to contain a 50\npage proof relating to one"
    } ]
  }, {
    "tStartMs": 9240,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "of the oldest unsolved\nproblems in mathematics."
    } ]
  }, {
    "tStartMs": 12540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "A problem that great\nmathematician Edmund Landau"
    } ]
  }, {
    "tStartMs": 15300,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "called unattackable."
    } ]
  }, {
    "tStartMs": 18720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But this proof didn't come\nfrom a famous professor,"
    } ]
  }, {
    "tStartMs": 21120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "it came from an unknown."
    } ]
  }, {
    "tStartMs": 23640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 25200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Someone who had once spent years working"
    } ]
  }, {
    "tStartMs": 27570,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "at a subway restaurant."
    } ]
  }, {
    "tStartMs": 29010,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- So, they're like, okay,"
    } ]
  }, {
    "tStartMs": 30360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "surely this isn't gonna\nwork out, but whatever."
    } ]
  }, {
    "tStartMs": 32430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "You know, we'll send it to a referee."
    } ]
  }, {
    "tStartMs": 34470,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- [Derek] They expected to\nfind a mistake in an afternoon,"
    } ]
  }, {
    "tStartMs": 37710,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "but they didn't."
    } ]
  }, {
    "tStartMs": 39090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So, they went through it again,"
    } ]
  }, {
    "tStartMs": 40470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "closely studying the fragile parts"
    } ]
  }, {
    "tStartMs": 42480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "where a proof like this\nnormally falls apart,"
    } ]
  }, {
    "tStartMs": 45540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but still nothing."
    } ]
  }, {
    "tStartMs": 47760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Soon they realized they were\nwitnessing a breakthrough."
    } ]
  }, {
    "tStartMs": 50490,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Oh, damn, he did it."
    } ]
  }, {
    "tStartMs": 52620,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- So, how did he do It?"
    } ]
  }, {
    "tStartMs": 54330,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "What did the experts miss\nand what was the problem"
    } ]
  }, {
    "tStartMs": 57030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "he was working on?"
    } ]
  }, {
    "tStartMs": 58740,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "He was working on a new way"
    } ]
  }, {
    "tStartMs": 59970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to attack one of the\nhardest unsolved problems"
    } ]
  }, {
    "tStartMs": 62610,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "in number theory,"
    } ]
  }, {
    "tStartMs": 63630,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "the twin prime conjecture."
    } ]
  }, {
    "tStartMs": 66900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "The twin primes"
    } ]
  }, {
    "tStartMs": 67733,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "are prime numbers separated\nby just one number,"
    } ]
  }, {
    "tStartMs": 70200,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "like 11 and 13 or 17 and 19."
    } ]
  }, {
    "tStartMs": 73650,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "As you go up, the number\nline, primes become rarer"
    } ]
  }, {
    "tStartMs": 76290,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and twin primes become rarer still."
    } ]
  }, {
    "tStartMs": 78960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But the twin prime conjecture claims"
    } ]
  }, {
    "tStartMs": 80760,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "that there are infinitely many\nof them you never run out."
    } ]
  }, {
    "tStartMs": 85470,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "But is it true?"
    } ]
  }, {
    "tStartMs": 86940,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Well, one way to approach this problem"
    } ]
  }, {
    "tStartMs": 88650,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is to look at the gaps\nbetween consecutive primes"
    } ]
  }, {
    "tStartMs": 91800,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "as you go up the number line."
    } ]
  }, {
    "tStartMs": 93381,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 94214,
    "dDurationMs": 2146,
    "segs": [ {
      "utf8": "Now, at first they seem chaotic,"
    } ]
  }, {
    "tStartMs": 96360,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "but if you average them\nout, a clear trend emerges."
    } ]
  }, {
    "tStartMs": 101040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The average gap between\ntwo primes grows roughly"
    } ]
  }, {
    "tStartMs": 103920,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "as the natural logarithm of the number N."
    } ]
  }, {
    "tStartMs": 107490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So, for example, the average gap"
    } ]
  }, {
    "tStartMs": 109110,
    "dDurationMs": 4486,
    "segs": [ {
      "utf8": "between primes around\n100, is approximately 4.6."
    } ]
  }, {
    "tStartMs": 113596,
    "dDurationMs": 3824,
    "segs": [ {
      "utf8": "The average gap between\nprimes around 1000 is 6.9."
    } ]
  }, {
    "tStartMs": 117420,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Logarithms grow very slowly,"
    } ]
  }, {
    "tStartMs": 119190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but they do keep growing forever."
    } ]
  }, {
    "tStartMs": 121590,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, as N approaches infinity,"
    } ]
  }, {
    "tStartMs": 123450,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "the average gap between\nprimes also goes to infinity,"
    } ]
  }, {
    "tStartMs": 127770,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "which is not particularly encouraging"
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "if you expect to always\nbe able to find primes"
    } ]
  }, {
    "tStartMs": 132930,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "that are just two apart."
    } ]
  }, {
    "tStartMs": 135600,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "But if you start checking large numbers,"
    } ]
  }, {
    "tStartMs": 137610,
    "dDurationMs": 2987,
    "segs": [ {
      "utf8": "then after a million you\nquickly find the twin primes,"
    } ]
  }, {
    "tStartMs": 140597,
    "dDurationMs": 2926,
    "segs": [ {
      "utf8": "1,000,037 and 1,000,039."
    } ]
  }, {
    "tStartMs": 144510,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "Past a billion, there's\n1,000,000,007 and 1,000,000,009."
    } ]
  }, {
    "tStartMs": 148800,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "In fact, we have found a\ntwin prime that's as large"
    } ]
  }, {
    "tStartMs": 151740,
    "dDurationMs": 6930,
    "segs": [ {
      "utf8": "as 2,996,863,034,895"
    } ]
  }, {
    "tStartMs": 158670,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "times two to the power of 1,290,000"
    } ]
  }, {
    "tStartMs": 162450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "plus or minus one."
    } ]
  }, {
    "tStartMs": 164490,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "That is a pair of numbers\neach 388,342 digits long."
    } ]
  }, {
    "tStartMs": 171120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "If you wanted to print those\nin a book for some reason,"
    } ]
  }, {
    "tStartMs": 174360,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "you would need around\n260 pages per number."
    } ]
  }, {
    "tStartMs": 179700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "All of this is to say that\nas far as we've looked,"
    } ]
  }, {
    "tStartMs": 182160,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "we've kept finding twin primes."
    } ]
  }, {
    "tStartMs": 184620,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "But of course, that is not how you solve"
    } ]
  }, {
    "tStartMs": 186630,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "the twin prime conjecture,"
    } ]
  }, {
    "tStartMs": 187620,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because you cannot physically check"
    } ]
  }, {
    "tStartMs": 189750,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "all the numbers out to infinity."
    } ]
  }, {
    "tStartMs": 191520,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, we need another way."
    } ]
  }, {
    "tStartMs": 193860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And around 100 years ago,"
    } ]
  }, {
    "tStartMs": 195480,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it felt like mathematicians\nwere getting close"
    } ]
  }, {
    "tStartMs": 197670,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with a more sophisticated method."
    } ]
  }, {
    "tStartMs": 200310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "In 1923, English mathematicians,"
    } ]
  }, {
    "tStartMs": 202440,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Hardy and Littlewood figured\nout how you can estimate"
    } ]
  }, {
    "tStartMs": 205200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "how many twin primes there should be."
    } ]
  }, {
    "tStartMs": 207420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "To do it, they started with one\nof the crowning achievements"
    } ]
  }, {
    "tStartMs": 209880,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "of number theory, the\nprime number theorem,"
    } ]
  }, {
    "tStartMs": 212310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "which tells you that the odds"
    } ]
  }, {
    "tStartMs": 213780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of a large number near N being prime"
    } ]
  }, {
    "tStartMs": 215940,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "are roughly one over the\nnatural logarithm of N."
    } ]
  }, {
    "tStartMs": 219240,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "So, let's do a quick example\nto see how they use this."
    } ]
  }, {
    "tStartMs": 223290,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Say you wanna find the\nodds that 137,037 is prime."
    } ]
  }, {
    "tStartMs": 227590,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Well, you just plug that in"
    } ]
  }, {
    "tStartMs": 229170,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and find that it has about\nan eight and a half percent"
    } ]
  }, {
    "tStartMs": 231300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "chance of being prime."
    } ]
  }, {
    "tStartMs": 233340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Of course, you could use the same trick"
    } ]
  }, {
    "tStartMs": 234870,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "to find the odds that 137,039 is prime,"
    } ]
  }, {
    "tStartMs": 238830,
    "dDurationMs": 2363,
    "segs": [ {
      "utf8": "which is also around 8.5%."
    } ]
  }, {
    "tStartMs": 242130,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So, what are the odds that\nboth of them are prime?"
    } ]
  }, {
    "tStartMs": 245220,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Well, you just multiply\nthose odds together,"
    } ]
  }, {
    "tStartMs": 247470,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that gives you around a 0.7% chance."
    } ]
  }, {
    "tStartMs": 250770,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Now we are simplifying a little here"
    } ]
  }, {
    "tStartMs": 252630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "because we're assuming that\nprimes are independent,"
    } ]
  }, {
    "tStartMs": 255180,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "which they're not."
    } ]
  }, {
    "tStartMs": 256440,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "But putting that to one side,"
    } ]
  }, {
    "tStartMs": 258030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the odds of both a large number N"
    } ]
  }, {
    "tStartMs": 260520,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and N plus two being prime,"
    } ]
  }, {
    "tStartMs": 262380,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "is one over ln(n) times\none over ln(n) plus two,"
    } ]
  }, {
    "tStartMs": 266400,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "for large N the plus two is insignificant."
    } ]
  }, {
    "tStartMs": 269430,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, we get the odds of any pair of numbers"
    } ]
  }, {
    "tStartMs": 272250,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of size N being a twin prime"
    } ]
  }, {
    "tStartMs": 274110,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "are roughly one over ln(n) squared."
    } ]
  }, {
    "tStartMs": 278460,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But of course, the\nproblem with this approach"
    } ]
  }, {
    "tStartMs": 280140,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is that the odds of a pair\nbeing a twin prime decrease"
    } ]
  }, {
    "tStartMs": 283290,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "as you go to larger numbers."
    } ]
  }, {
    "tStartMs": 284820,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So, to count all twin primes up to N,"
    } ]
  }, {
    "tStartMs": 287100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "we add up the odds at\nevery single position."
    } ]
  }, {
    "tStartMs": 289740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "In other words, we\nintegrate this expression"
    } ]
  }, {
    "tStartMs": 292080,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "from the first prime\ntwo up to that number."
    } ]
  }, {
    "tStartMs": 295290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Now Hardy and Littlewood\nrefine this argument further"
    } ]
  }, {
    "tStartMs": 298170,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to account for the fact that primes"
    } ]
  }, {
    "tStartMs": 299490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "aren't really independent."
    } ]
  }, {
    "tStartMs": 301530,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But all that added is just\nthis correction factor upfront."
    } ]
  }, {
    "tStartMs": 304770,
    "dDurationMs": 2855,
    "segs": [ {
      "utf8": "So, the final expression looks like this."
    } ]
  }, {
    "tStartMs": 307625,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 308760,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Now let's plot how many twin primes,"
    } ]
  }, {
    "tStartMs": 310620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "this predicts up to 1 trillion."
    } ]
  }, {
    "tStartMs": 312360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "We see that it keeps growing"
    } ]
  }, {
    "tStartMs": 313860,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and if we fill in the actual count,"
    } ]
  }, {
    "tStartMs": 316380,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "you'll notice that it is extremely close"
    } ]
  }, {
    "tStartMs": 320040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to the point where by 1 trillion,"
    } ]
  }, {
    "tStartMs": 321960,
    "dDurationMs": 4068,
    "segs": [ {
      "utf8": "our estimate is only off by 0.001%."
    } ]
  }, {
    "tStartMs": 326028,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 329070,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "- The only issue though, is\nthat this is just an estimate"
    } ]
  }, {
    "tStartMs": 333450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "or what mathematicians call a heuristic."
    } ]
  }, {
    "tStartMs": 336330,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "It can tell you roughly how\nmany twin primes to expect,"
    } ]
  }, {
    "tStartMs": 339780,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but it can't guarantee that they never stop."
    } ]
  }, {
    "tStartMs": 342570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "As Terry Tao puts it, for all we know,"
    } ]
  }, {
    "tStartMs": 345390,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "there could be this fast conspiracy"
    } ]
  }, {
    "tStartMs": 347400,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that every time a number\nN decides to be prime,"
    } ]
  }, {
    "tStartMs": 350550,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "it has some secret agreement"
    } ]
  }, {
    "tStartMs": 352500,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "with its neighbor N plus two saying"
    } ]
  }, {
    "tStartMs": 354810,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you're not allowed to be prime anymore."
    } ]
  }, {
    "tStartMs": 357150,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So, what we need is a rigorous\nairtight mathematical proof,"
    } ]
  }, {
    "tStartMs": 362160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but finding such a proof"
    } ]
  }, {
    "tStartMs": 363570,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "it turns out, is extremely difficult."
    } ]
  }, {
    "tStartMs": 367170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "One of the first mathematicians"
    } ]
  }, {
    "tStartMs": 368730,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to really try was a 29-year-old\nNorwegian Viggo Brun."
    } ]
  }, {
    "tStartMs": 372650,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 374100,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Brun was working during the early years"
    } ]
  }, {
    "tStartMs": 376170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of the first World War,"
    } ]
  }, {
    "tStartMs": 377730,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and with travel disrupted"
    } ]
  }, {
    "tStartMs": 379110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and Europe's mathematical\ncenters largely out of reach,"
    } ]
  }, {
    "tStartMs": 382050,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "much of his work happened in\nquiet isolation back in Norway."
    } ]
  }, {
    "tStartMs": 387360,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "His goal was simple to try\nand prove that the number"
    } ]
  }, {
    "tStartMs": 390570,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "or count of twin primes always increases."
    } ]
  }, {
    "tStartMs": 393510,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And to do this, he took a 2000\nyear old prime counting tool"
    } ]
  }, {
    "tStartMs": 397200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and tried to adapt it for twin primes."
    } ]
  }, {
    "tStartMs": 399870,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now the normal version\nof this tool is called"
    } ]
  }, {
    "tStartMs": 401940,
    "dDurationMs": 4249,
    "segs": [ {
      "utf8": "the sieve of Eratosthenes, and\nit works something like this."
    } ]
  }, {
    "tStartMs": 406189,
    "dDurationMs": 1031,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 407220,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Say we want to find the primes up to 100."
    } ]
  }, {
    "tStartMs": 410160,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "First we remove one\nbecause that's not prime."
    } ]
  }, {
    "tStartMs": 413190,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Then we circle the first\nprime, that is two,"
    } ]
  }, {
    "tStartMs": 415557,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "and we remove all of its multiples."
    } ]
  }, {
    "tStartMs": 418260,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We do the same for three."
    } ]
  }, {
    "tStartMs": 419610,
    "dDurationMs": 2564,
    "segs": [ {
      "utf8": "Circle it and remove its multiples,"
    } ]
  }, {
    "tStartMs": 422174,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 423390,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "and then repeat that for five and seven."
    } ]
  }, {
    "tStartMs": 426780,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And with these four very quick operations,"
    } ]
  }, {
    "tStartMs": 429690,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "every single number that's\nleft on your 10 by 10 grid"
    } ]
  }, {
    "tStartMs": 432930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is a prime number."
    } ]
  }, {
    "tStartMs": 435000,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Now we stop the sieve at seven,"
    } ]
  }, {
    "tStartMs": 437370,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and we could keep going sieve by 11 or 30,"
    } ]
  }, {
    "tStartMs": 441000,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but it turns out that we don't have to."
    } ]
  }, {
    "tStartMs": 443250,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "So, why is that?"
    } ]
  }, {
    "tStartMs": 445830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Well, the next prime is 11."
    } ]
  }, {
    "tStartMs": 447420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, let's check the numbers below 100"
    } ]
  }, {
    "tStartMs": 449670,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that are divisible by 11."
    } ]
  }, {
    "tStartMs": 451830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "22 is two times 11,"
    } ]
  }, {
    "tStartMs": 453750,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but since it's divisible by\ntwo, we already caught it."
    } ]
  }, {
    "tStartMs": 456600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "We also have 33, but that\nis divisible by three."
    } ]
  }, {
    "tStartMs": 459720,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "And a similar logic holds for 55 and 77."
    } ]
  }, {
    "tStartMs": 463530,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But what about 11 times 11?"
    } ]
  }, {
    "tStartMs": 466080,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Well notice that is 121,\nwhich is not in our range."
    } ]
  }, {
    "tStartMs": 471540,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So, every multiple of 11 below 100"
    } ]
  }, {
    "tStartMs": 474630,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "was already caught by a smaller prime."
    } ]
  }, {
    "tStartMs": 477360,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So, sieving by 11 would\ncross out nothing new."
    } ]
  }, {
    "tStartMs": 480720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- So, Eratosthenes,"
    } ]
  }, {
    "tStartMs": 482400,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "has this idea that you\nonly need to sieve out"
    } ]
  }, {
    "tStartMs": 485070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the primes that are at most square root,"
    } ]
  }, {
    "tStartMs": 486690,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the size of the number."
    } ]
  }, {
    "tStartMs": 488160,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- But there's also a second\nwave to visualize this sieve."
    } ]
  }, {
    "tStartMs": 491730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Take the number line"
    } ]
  }, {
    "tStartMs": 493020,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and let each prime send out a\nwave with the wavelength equal"
    } ]
  }, {
    "tStartMs": 496560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to the size of that number."
    } ]
  }, {
    "tStartMs": 498240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So, the wave from two lands\non every second number"
    } ]
  }, {
    "tStartMs": 501000,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "and the wave from three\non every third and so on."
    } ]
  }, {
    "tStartMs": 504416,
    "dDurationMs": 1594,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 506010,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Now, notice that wherever a wave lands,"
    } ]
  }, {
    "tStartMs": 509040,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "that number has to be composite."
    } ]
  }, {
    "tStartMs": 512100,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But the numbers that escape\nevery preceding wave,"
    } ]
  }, {
    "tStartMs": 514680,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "well those have to be prime."
    } ]
  }, {
    "tStartMs": 517950,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And so you end up with this\nbeautiful visualization"
    } ]
  }, {
    "tStartMs": 521010,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "of the sieve."
    } ]
  }, {
    "tStartMs": 522369,
    "dDurationMs": 1371,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 523740,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And both of these methods\nmake it incredibly easy"
    } ]
  }, {
    "tStartMs": 526950,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to identify the primes."
    } ]
  }, {
    "tStartMs": 529410,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- But Brun didn't care about\nwhich primes were left,"
    } ]
  }, {
    "tStartMs": 532800,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "he just needed to know how many were left."
    } ]
  }, {
    "tStartMs": 535470,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And to do this, he counted all the numbers"
    } ]
  }, {
    "tStartMs": 538110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that were crossed out and then subtracted"
    } ]
  }, {
    "tStartMs": 540360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "this from the total,"
    } ]
  }, {
    "tStartMs": 541950,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "since whatever is not\ncrossed out must be prime."
    } ]
  }, {
    "tStartMs": 545640,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So, let's use this to find the\nnumber of primes below 100."
    } ]
  }, {
    "tStartMs": 549150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "We can keep a running count."
    } ]
  }, {
    "tStartMs": 550710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So, we'll start with 100."
    } ]
  }, {
    "tStartMs": 552660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "We're gonna throw out\nall the multiples of two."
    } ]
  }, {
    "tStartMs": 554460,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "Well, that's 50 numbers left, okay?"
    } ]
  }, {
    "tStartMs": 556083,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Then we're gonna throw\naway multiples of three."
    } ]
  }, {
    "tStartMs": 558450,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Well, how many multiples of three"
    } ]
  }, {
    "tStartMs": 559590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "are there less than 100."
    } ]
  }, {
    "tStartMs": 560423,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "100 divided by three\nis not a whole number."
    } ]
  }, {
    "tStartMs": 562590,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "It's like 33 and a third, but\nwe don't throw out fractions."
    } ]
  }, {
    "tStartMs": 566400,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So, okay, forget that\nstupid little fraction."
    } ]
  }, {
    "tStartMs": 568590,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "We do the same for the\nmultiples of five and seven,"
    } ]
  }, {
    "tStartMs": 570960,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but now the count has gone negative."
    } ]
  }, {
    "tStartMs": 573330,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Well, it turns out that some\nnumbers got crossed out twice,"
    } ]
  }, {
    "tStartMs": 576090,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "like six for example, it's\na multiple of two and three."
    } ]
  }, {
    "tStartMs": 579390,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So, we crossed it out once when\nwe removed multiples of two"
    } ]
  }, {
    "tStartMs": 582450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and again when we removed\nmultiples of three."
    } ]
  }, {
    "tStartMs": 584970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, we have to add it back once."
    } ]
  }, {
    "tStartMs": 586740,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The same thing happens\nfor multiples of 10,"
    } ]
  }, {
    "tStartMs": 588630,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "which is two times five,"
    } ]
  }, {
    "tStartMs": 590220,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "14 which is two times seven,"
    } ]
  }, {
    "tStartMs": 591780,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "15, which is three times five and so on."
    } ]
  }, {
    "tStartMs": 594420,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So, we add these overlaps back"
    } ]
  }, {
    "tStartMs": 596640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and now the count rises to 28,"
    } ]
  }, {
    "tStartMs": 599100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "but it's still not quite right."
    } ]
  }, {
    "tStartMs": 601140,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- Now we've triple added\nback in the multiples"
    } ]
  }, {
    "tStartMs": 604560,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of two times three times five,"
    } ]
  }, {
    "tStartMs": 606510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so that we need to subtract one more time."
    } ]
  }, {
    "tStartMs": 608730,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- The same thing happens for 42,"
    } ]
  }, {
    "tStartMs": 610680,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "which is two times three times seven,"
    } ]
  }, {
    "tStartMs": 612420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and 70, which is two\ntimes five times seven."
    } ]
  }, {
    "tStartMs": 615030,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "There's a fourth triple two,\nthree times five times seven,"
    } ]
  }, {
    "tStartMs": 617820,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "which is 105, but that's\nalready bigger than 100."
    } ]
  }, {
    "tStartMs": 621390,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So, it contributes nothing here."
    } ]
  }, {
    "tStartMs": 623460,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But we'll write it in to\nkeep the pattern complete."
    } ]
  }, {
    "tStartMs": 626880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "After the triples, we\nadd back the quadruple,"
    } ]
  }, {
    "tStartMs": 629520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "two times three times five\ntimes seven, which is 210."
    } ]
  }, {
    "tStartMs": 632760,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "That's also bigger than 100,"
    } ]
  }, {
    "tStartMs": 634170,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "so it contributes zero as well."
    } ]
  }, {
    "tStartMs": 636720,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And finally, we add back the\nfour sieving primes themselves"
    } ]
  }, {
    "tStartMs": 640140,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and subtract one because it\nwas included in the count."
    } ]
  }, {
    "tStartMs": 643890,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So, the count lands at 25 primes."
    } ]
  }, {
    "tStartMs": 647130,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This process of alternating"
    } ]
  }, {
    "tStartMs": 648810,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "between subtracting and\nadding numbers back in"
    } ]
  }, {
    "tStartMs": 651150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is called inclusion exclusion."
    } ]
  }, {
    "tStartMs": 653490,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And it makes it super easy to find out"
    } ]
  }, {
    "tStartMs": 654960,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "how many primes there are\nup to some given number."
    } ]
  }, {
    "tStartMs": 658530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Now this equation still looks\na little bit like a mess,"
    } ]
  }, {
    "tStartMs": 661920,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "but actually we can\nrearrange it into this form."
    } ]
  }, {
    "tStartMs": 665430,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now notice that every prime factor"
    } ]
  }, {
    "tStartMs": 667500,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "we added just adds an\nadditional term in this series."
    } ]
  }, {
    "tStartMs": 670980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "We've got the two that goes over here,"
    } ]
  }, {
    "tStartMs": 673200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the three goes over here,\nfive goes over here,"
    } ]
  }, {
    "tStartMs": 676200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and seven goes over here."
    } ]
  }, {
    "tStartMs": 678330,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And if we were trying to find\nprimes for some higher number"
    } ]
  }, {
    "tStartMs": 681360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and we wanted to add 11 as a prime factor,"
    } ]
  }, {
    "tStartMs": 683400,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "it would just add one additional\none minus one over 11 term."
    } ]
  }, {
    "tStartMs": 687720,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Now in general,"
    } ]
  }, {
    "tStartMs": 688590,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "if we keep the sieve\ngoing up to some prime P,"
    } ]
  }, {
    "tStartMs": 691170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which is less than the square root of N,"
    } ]
  }, {
    "tStartMs": 693090,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "then the count becomes approximately this."
    } ]
  }, {
    "tStartMs": 698160,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- But this is still just\nthe count of primes."
    } ]
  }, {
    "tStartMs": 700890,
    "dDurationMs": 3017,
    "segs": [ {
      "utf8": "What Brun really wanted was\nthe count of twin primes."
    } ]
  }, {
    "tStartMs": 703907,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "And so this is the part\nwhere he adapted his sieve,"
    } ]
  }, {
    "tStartMs": 707430,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "to find a case where both\nN and N plus two are prime."
    } ]
  }, {
    "tStartMs": 711360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "For example, when you're sieving by five,"
    } ]
  }, {
    "tStartMs": 713820,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "you remove the numbers where\nN is divisible by five,"
    } ]
  }, {
    "tStartMs": 716790,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "just as before."
    } ]
  }, {
    "tStartMs": 718230,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But in addition, you need\nto remove the numbers"
    } ]
  }, {
    "tStartMs": 720450,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "where N plus two is divisible by five."
    } ]
  }, {
    "tStartMs": 723570,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "So, you also remove 23, 28, 33 and so on"
    } ]
  }, {
    "tStartMs": 727800,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "because in those cases, N plus\ntwo is 25, 30, 35 and so on."
    } ]
  }, {
    "tStartMs": 733500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So, this means that while\nin the ordinary sieve"
    } ]
  }, {
    "tStartMs": 736140,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "a prime P removes about\none out of every P numbers,"
    } ]
  }, {
    "tStartMs": 739860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the twin prime sieve removes two."
    } ]
  }, {
    "tStartMs": 742500,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And this changes the count to this,"
    } ]
  }, {
    "tStartMs": 745410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "where the numerator for\nall the terms after two,"
    } ]
  }, {
    "tStartMs": 748500,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "ends up getting a two."
    } ]
  }, {
    "tStartMs": 751140,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Now, if we plot the count of\ntwin primes that this predicts,"
    } ]
  }, {
    "tStartMs": 754650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "we see that it grows roughly like N"
    } ]
  }, {
    "tStartMs": 756870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "over the natural logarithm of N squared,"
    } ]
  }, {
    "tStartMs": 759660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "just as for our heuristic."
    } ]
  }, {
    "tStartMs": 761340,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And so it seems like Brun did it,"
    } ]
  }, {
    "tStartMs": 763890,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but unfortunately that is not the case."
    } ]
  }, {
    "tStartMs": 767490,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- We said that 100 divided\nby three is 33, and a third,"
    } ]
  }, {
    "tStartMs": 771210,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but forget about that little error,"
    } ]
  }, {
    "tStartMs": 772500,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "those little errors,"
    } ]
  }, {
    "tStartMs": 774270,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "it's very difficult to\ncontrol those errors"
    } ]
  }, {
    "tStartMs": 776370,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "'cause there are so many\nof those little errors."
    } ]
  }, {
    "tStartMs": 778110,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Each one of them is at most\none it's a rounding error."
    } ]
  }, {
    "tStartMs": 780960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Take the traditional\nsieve of Eratosthenes again,"
    } ]
  }, {
    "tStartMs": 783360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "when we're sieving with just one prime,"
    } ]
  }, {
    "tStartMs": 785430,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "we just have an over two."
    } ]
  }, {
    "tStartMs": 787260,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, one rounding error,"
    } ]
  }, {
    "tStartMs": 789120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "with two primes, two and three,"
    } ]
  }, {
    "tStartMs": 790770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "there are three separate rounding errors,"
    } ]
  }, {
    "tStartMs": 793140,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but with three primes,\ntwo, three, and five,"
    } ]
  }, {
    "tStartMs": 795540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "there are already seven\nseparate rounding errors,"
    } ]
  }, {
    "tStartMs": 798780,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "each for one term in\nthe inclusion exclusion."
    } ]
  }, {
    "tStartMs": 802350,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And so you might start to\nsee the general pattern here."
    } ]
  }, {
    "tStartMs": 805290,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "One prime gives two to the\npower one minus one terms,"
    } ]
  }, {
    "tStartMs": 808710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "two gives two to the\npower two minus one terms,"
    } ]
  }, {
    "tStartMs": 811500,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and three primes gives two"
    } ]
  }, {
    "tStartMs": 813240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to the power three minus one terms."
    } ]
  }, {
    "tStartMs": 815640,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "In general, if you sieve by K primes,"
    } ]
  }, {
    "tStartMs": 818370,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "you get roughly two to the\npower K minus one error terms,"
    } ]
  }, {
    "tStartMs": 822630,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "but we can drop the one"
    } ]
  }, {
    "tStartMs": 823800,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "because it doesn't really\nmake much of a difference."
    } ]
  }, {
    "tStartMs": 827040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So, that means that if you're\nsieving for normal primes,"
    } ]
  }, {
    "tStartMs": 829650,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "the error grows roughly\nlike two to the power K."
    } ]
  }, {
    "tStartMs": 833160,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But if you're saving for twin\nprimes, it gets even worse."
    } ]
  }, {
    "tStartMs": 836370,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And now the error grows roughly\nlike four to the power K."
    } ]
  }, {
    "tStartMs": 839940,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "And so this causes a lot of\ntrouble very, very quick."
    } ]
  }, {
    "tStartMs": 843622,
    "dDurationMs": 2678,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 846300,
    "dDurationMs": 3873,
    "segs": [ {
      "utf8": "And then here for the twin\nprimes, it's even worse."
    } ]
  }, {
    "tStartMs": 851070,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "The main term grows a bit more slowly,"
    } ]
  }, {
    "tStartMs": 855330,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but the error term grows much faster."
    } ]
  }, {
    "tStartMs": 858630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So, it still starts off slow."
    } ]
  }, {
    "tStartMs": 861120,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And so you can quickly see"
    } ]
  }, {
    "tStartMs": 862350,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that once these error\nterms start dominating,"
    } ]
  }, {
    "tStartMs": 865020,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "you get into trouble."
    } ]
  }, {
    "tStartMs": 866190,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So, the issue he was facing\nis he had this main term"
    } ]
  }, {
    "tStartMs": 868950,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and the main term, you know,"
    } ]
  }, {
    "tStartMs": 870390,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "it grew in the way he wanted to,"
    } ]
  }, {
    "tStartMs": 872310,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "but then it just got overtaken"
    } ]
  }, {
    "tStartMs": 874110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and dominated by those error terms."
    } ]
  }, {
    "tStartMs": 875640,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 876473,
    "dDurationMs": 1447,
    "segs": [ {
      "utf8": "And that's all of analysis,"
    } ]
  }, {
    "tStartMs": 877920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "in general analytic number\ntheory in particular"
    } ]
  }, {
    "tStartMs": 880200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is the fight between the main term"
    } ]
  }, {
    "tStartMs": 881640,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that you think is the truth,\nif it actually is the truth,"
    } ]
  }, {
    "tStartMs": 884190,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and getting the error\nterm to be provably lower order."
    } ]
  }, {
    "tStartMs": 887790,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- So, for twin primes,"
    } ]
  }, {
    "tStartMs": 889080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the main term grows roughly like this,"
    } ]
  }, {
    "tStartMs": 891390,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "something like N over the\nnatural logarithm of N squared."
    } ]
  }, {
    "tStartMs": 895320,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "But that's not the true count,"
    } ]
  }, {
    "tStartMs": 896670,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "because to get the true count,"
    } ]
  }, {
    "tStartMs": 897900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "we must add and subtract the error terms,"
    } ]
  }, {
    "tStartMs": 900660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "which gives us this upper and lower bound."
    } ]
  }, {
    "tStartMs": 903960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And now you can see the problem."
    } ]
  }, {
    "tStartMs": 905550,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Because the true count can\nbe anywhere in this range,"
    } ]
  }, {
    "tStartMs": 908340,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and as you can see, a big\nswath of it is negative."
    } ]
  }, {
    "tStartMs": 911850,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, to prove the\nconjecture, what we must do"
    } ]
  }, {
    "tStartMs": 914160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is we must show that this lower bound"
    } ]
  }, {
    "tStartMs": 916500,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "is always positive and growing."
    } ]
  }, {
    "tStartMs": 919290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But that is where we run into a problem"
    } ]
  }, {
    "tStartMs": 921780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "with the sieve we've been using."
    } ]
  }, {
    "tStartMs": 923790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Because the more primes we sieve by,"
    } ]
  }, {
    "tStartMs": 925950,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the more those error\nterms start to accumulate"
    } ]
  }, {
    "tStartMs": 929010,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and we just can show this."
    } ]
  }, {
    "tStartMs": 930900,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- And so what Brun eventually realized"
    } ]
  }, {
    "tStartMs": 933870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "is that if you weaken the sieve,"
    } ]
  }, {
    "tStartMs": 935670,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "if you don't sieve all the\nway up to square root X,"
    } ]
  }, {
    "tStartMs": 937980,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but to up to something less than that,"
    } ]
  }, {
    "tStartMs": 940110,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and you are very careful about\nyour inclusion exclusion,"
    } ]
  }, {
    "tStartMs": 944430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "you can actually take\ncare of those error terms."
    } ]
  }, {
    "tStartMs": 946440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- So, run a sieve by fewer factors,"
    } ]
  }, {
    "tStartMs": 948840,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "only up to N to the power one over 10."
    } ]
  }, {
    "tStartMs": 952380,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "And as a result,"
    } ]
  }, {
    "tStartMs": 953430,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "he gained enough control\nover the error term."
    } ]
  }, {
    "tStartMs": 956220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But this chooses a trade off."
    } ]
  }, {
    "tStartMs": 958500,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Say you wanted to find\nall the prime numbers"
    } ]
  }, {
    "tStartMs": 960810,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "up to 10 billion,"
    } ]
  }, {
    "tStartMs": 962070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "then using the square root method,"
    } ]
  }, {
    "tStartMs": 963870,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "you would need to sieve up to\nthe square root of 10 billion,"
    } ]
  }, {
    "tStartMs": 966810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "which is 100,000."
    } ]
  }, {
    "tStartMs": 968760,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But that gives you a lot of error terms."
    } ]
  }, {
    "tStartMs": 972090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But with Brun's method,"
    } ]
  }, {
    "tStartMs": 973890,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you would only need to\nsieve up to 10 billion"
    } ]
  }, {
    "tStartMs": 976260,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "to the power one over\n10, which is just 10."
    } ]
  }, {
    "tStartMs": 980220,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "But there's a catch."
    } ]
  }, {
    "tStartMs": 981630,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Because Brun, didn't\nsieve by all the primes,"
    } ]
  }, {
    "tStartMs": 984000,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "there were some survivors\nthat weren't prime at all,"
    } ]
  }, {
    "tStartMs": 986790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but numbers with many prime factors,"
    } ]
  }, {
    "tStartMs": 989040,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "in Brun's case up to nine."
    } ]
  }, {
    "tStartMs": 991920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So, what he actually ended up proving"
    } ]
  }, {
    "tStartMs": 994080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is that there are infinitely many pairs"
    } ]
  }, {
    "tStartMs": 996180,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of numbers two apart,"
    } ]
  }, {
    "tStartMs": 997860,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "where each number has at\nmost nine prime factors."
    } ]
  }, {
    "tStartMs": 1002270,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- Brun's techniques were improved\nand improved and improved,"
    } ]
  }, {
    "tStartMs": 1005990,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and we went from nine prime\nfactors to seven prime factors"
    } ]
  }, {
    "tStartMs": 1009050,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to three prime factors."
    } ]
  }, {
    "tStartMs": 1010670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Until in 1973,"
    } ]
  }, {
    "tStartMs": 1012800,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "a Chinese mathematician\nChen Jingrun comes along"
    } ]
  }, {
    "tStartMs": 1016070,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and proved that there are\ninfinitely many prime P,"
    } ]
  }, {
    "tStartMs": 1018680,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "where P plus two has at\nmost two prime factors."
    } ]
  }, {
    "tStartMs": 1022910,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- This is as close as you could get"
    } ]
  }, {
    "tStartMs": 1025520,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to proving the twin prime conjecture"
    } ]
  }, {
    "tStartMs": 1027710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "without actually getting there."
    } ]
  }, {
    "tStartMs": 1029180,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "We're stuck like we're\nlike as close as we can get"
    } ]
  }, {
    "tStartMs": 1032840,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and no further."
    } ]
  }, {
    "tStartMs": 1034070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 1034903,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "So, that's one approximation,"
    } ]
  }, {
    "tStartMs": 1037040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "one mechanism for\napproximating twin primes."
    } ]
  }, {
    "tStartMs": 1039770,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "There's another."
    } ]
  }, {
    "tStartMs": 1040880,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So, the other mechanism\nis what's the smallest gap"
    } ]
  }, {
    "tStartMs": 1044480,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "between two consecutive primes?"
    } ]
  }, {
    "tStartMs": 1045890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So, instead of saying they differ by two"
    } ]
  }, {
    "tStartMs": 1047870,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and one of them's prime\nand the other one, well,"
    } ]
  }, {
    "tStartMs": 1050030,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "we're gonna try to get,\nyou know, reduce the number"
    } ]
  }, {
    "tStartMs": 1052280,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "of prime factors that it has."
    } ]
  }, {
    "tStartMs": 1053390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Instead we're gonna say\nboth numbers must be prime,"
    } ]
  }, {
    "tStartMs": 1056630,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "but let's reduce the\ndistance between them."
    } ]
  }, {
    "tStartMs": 1059660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Now remember, on average\nconsecutive primes sit"
    } ]
  }, {
    "tStartMs": 1062390,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "about the natural logarithm of N apart."
    } ]
  }, {
    "tStartMs": 1065240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And so the question became,\ncan we at least prove"
    } ]
  }, {
    "tStartMs": 1068120,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "that primes come closer\nthan that average gap?"
    } ]
  }, {
    "tStartMs": 1072620,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "For decades, mathematicians\nkept chipping away"
    } ]
  }, {
    "tStartMs": 1075140,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "at this problem."
    } ]
  }, {
    "tStartMs": 1076040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "By 1988, the gap had\ndropped all the way down"
    } ]
  }, {
    "tStartMs": 1078770,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to roughly a quarter of the average gap."
    } ]
  }, {
    "tStartMs": 1081350,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This means that say the average gap is 100"
    } ]
  }, {
    "tStartMs": 1083960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "at some enormous scale,"
    } ]
  }, {
    "tStartMs": 1085340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "then primes must sometimes come"
    } ]
  }, {
    "tStartMs": 1087260,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "within about 25 of each other."
    } ]
  }, {
    "tStartMs": 1090920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But then in 2005, Goldston,\nPintz and Yildirim,"
    } ]
  }, {
    "tStartMs": 1094280,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "proved a result that shocked\nthe mathematical community."
    } ]
  }, {
    "tStartMs": 1097340,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- And they announced the\nproof of a spectacular result,"
    } ]
  }, {
    "tStartMs": 1100490,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "0% bounded gaps of 0% of the average."
    } ]
  }, {
    "tStartMs": 1104690,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Wait, what?"
    } ]
  }, {
    "tStartMs": 1106100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- They proved that you\ncan make the fraction"
    } ]
  }, {
    "tStartMs": 1107990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as small as you want."
    } ]
  }, {
    "tStartMs": 1109910,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "This means the gap could\nbe one 10th or 100th,"
    } ]
  }, {
    "tStartMs": 1113240,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or even 1000000th of the average gap."
    } ]
  }, {
    "tStartMs": 1115910,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It could be as arbitrarily\nsmall as you like,"
    } ]
  }, {
    "tStartMs": 1118460,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "and infinitely often\nprimes get that close."
    } ]
  }, {
    "tStartMs": 1122780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- When I was young, we didn't\nknow there were gaps of size,"
    } ]
  }, {
    "tStartMs": 1124790,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "less than say one 10th log X"
    } ]
  }, {
    "tStartMs": 1126890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "or infinitely many primes pairs"
    } ]
  }, {
    "tStartMs": 1130010,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "and Goldston and Yildirim,"
    } ]
  }, {
    "tStartMs": 1130940,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "came up with a method to attack that."
    } ]
  }, {
    "tStartMs": 1134360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "- But the method also came\nclose to something even bigger,"
    } ]
  }, {
    "tStartMs": 1137900,
    "dDurationMs": 3529,
    "segs": [ {
      "utf8": "an absolute bounded\ngap between two primes."
    } ]
  }, {
    "tStartMs": 1141429,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1142430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- And so that was like a big thing."
    } ]
  }, {
    "tStartMs": 1144680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- What was the big desire to go from 0%"
    } ]
  }, {
    "tStartMs": 1147560,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "or arbitrarily small to\na concrete bounded gap?"
    } ]
  }, {
    "tStartMs": 1151760,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Well, because we think that the bound"
    } ]
  }, {
    "tStartMs": 1153290,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "between two consecutive primes\ninfinitely often is two,"
    } ]
  }, {
    "tStartMs": 1155720,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and right now we're showing\nthat it's log X, and X grows."
    } ]
  }, {
    "tStartMs": 1158960,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- If they could get to bounded gaps,"
    } ]
  }, {
    "tStartMs": 1161270,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "then they had another method\nto attack the conjecture."
    } ]
  }, {
    "tStartMs": 1165020,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "The only problem"
    } ]
  }, {
    "tStartMs": 1166400,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "was that it seemed like\ntheir tool ran into a wall."
    } ]
  }, {
    "tStartMs": 1170360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And so in 2005,"
    } ]
  }, {
    "tStartMs": 1172040,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the American Institute of\nMathematics convened a meeting,"
    } ]
  }, {
    "tStartMs": 1175610,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "gathering all the world's\nleading experts on this problem."
    } ]
  }, {
    "tStartMs": 1179570,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "GPY, Andrew Granville,\nKannan Soundararajan,"
    } ]
  }, {
    "tStartMs": 1183380,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "all gathered for a week in California"
    } ]
  }, {
    "tStartMs": 1186230,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with one explicit goal,"
    } ]
  }, {
    "tStartMs": 1188390,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to prove a bounded gap between primes."
    } ]
  }, {
    "tStartMs": 1191690,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- I was a young graduate student,"
    } ]
  }, {
    "tStartMs": 1193610,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "I was very lucky to get\nto go to this meeting."
    } ]
  }, {
    "tStartMs": 1196850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "You're surrounded by\nthe world's top experts"
    } ]
  }, {
    "tStartMs": 1198590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "on this subject."
    } ]
  }, {
    "tStartMs": 1199423,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "We spent an entire week."
    } ]
  }, {
    "tStartMs": 1201290,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And the upshot of this week"
    } ]
  }, {
    "tStartMs": 1202790,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "was basically that it's impossible."
    } ]
  }, {
    "tStartMs": 1204140,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "And Soundararajan shows\nhow it's not possible"
    } ]
  }, {
    "tStartMs": 1207470,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "to do this thing."
    } ]
  }, {
    "tStartMs": 1208340,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And so as far as I was\nconcerned, that was that, and I,"
    } ]
  }, {
    "tStartMs": 1211160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "you know, this wasn't\ngonna be my thesis problem,"
    } ]
  }, {
    "tStartMs": 1213140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I'd have to do something else"
    } ]
  }, {
    "tStartMs": 1214280,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and I went off and and did other things."
    } ]
  }, {
    "tStartMs": 1216500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But there was one person\nwho was not at this meeting,"
    } ]
  }, {
    "tStartMs": 1219140,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "Yitang Zhang."
    } ]
  }, {
    "tStartMs": 1220602,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1222770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Zhang grew up in China,"
    } ]
  }, {
    "tStartMs": 1224420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and around the age of 30 moved to the U.S."
    } ]
  }, {
    "tStartMs": 1227120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to get his PhD in mathematics,"
    } ]
  }, {
    "tStartMs": 1229310,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but he never got any\nrecommendation letters"
    } ]
  }, {
    "tStartMs": 1231650,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "and so struggled to find a job."
    } ]
  }, {
    "tStartMs": 1236630,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "He ended up living in his car for time"
    } ]
  }, {
    "tStartMs": 1238490,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and ultimately working\nodd jobs for seven years,"
    } ]
  }, {
    "tStartMs": 1241910,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "including at Subway,\nwhere he kept the books"
    } ]
  }, {
    "tStartMs": 1244730,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "and sorted receipts."
    } ]
  }, {
    "tStartMs": 1247610,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "Yet, while doing all of\nthat in his spare time,"
    } ]
  }, {
    "tStartMs": 1250360,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "he would drive down to the local library"
    } ]
  }, {
    "tStartMs": 1252980,
    "dDurationMs": 3195,
    "segs": [ {
      "utf8": "to read books and\njournals on number theory."
    } ]
  }, {
    "tStartMs": 1256175,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1257810,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Then in 1999, he got a lucky break."
    } ]
  }, {
    "tStartMs": 1261500,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "One of his friends helped\nhim get a job as a lecturer"
    } ]
  }, {
    "tStartMs": 1264440,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "at the University of New Hampshire."
    } ]
  }, {
    "tStartMs": 1266990,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So, now he could spend all his time doing"
    } ]
  }, {
    "tStartMs": 1269780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "what he loved most, math."
    } ]
  }, {
    "tStartMs": 1272180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Zhang said that when he was a kid,"
    } ]
  }, {
    "tStartMs": 1274130,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "he \"Imagined there would be a day"
    } ]
  }, {
    "tStartMs": 1275870,
    "dDurationMs": 2757,
    "segs": [ {
      "utf8": "that I would solve a major math problem.\""
    } ]
  }, {
    "tStartMs": 1279560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And by 2010, he had identified"
    } ]
  }, {
    "tStartMs": 1281930,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "his major problem to focus on,"
    } ]
  }, {
    "tStartMs": 1284210,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "bounded gaps between primes."
    } ]
  }, {
    "tStartMs": 1287240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But to understand what he was working on,"
    } ]
  }, {
    "tStartMs": 1289760,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "we need to understand what\nexactly it is that GPY had built."
    } ]
  }, {
    "tStartMs": 1295130,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "See, they wanted to find two\nprimes within a bounded gap."
    } ]
  }, {
    "tStartMs": 1298700,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And to do this, they\nimagined a stencil of sorts"
    } ]
  }, {
    "tStartMs": 1301970,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "with some holes in it."
    } ]
  }, {
    "tStartMs": 1303560,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So, let's do the same,"
    } ]
  }, {
    "tStartMs": 1304970,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and for the sake of this example,"
    } ]
  }, {
    "tStartMs": 1307010,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "let's say the stencil\nhas a diameter of six"
    } ]
  }, {
    "tStartMs": 1309860,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and holes at spot zero, two and six."
    } ]
  }, {
    "tStartMs": 1313490,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Next we place the stencil\nanywhere on the number line,"
    } ]
  }, {
    "tStartMs": 1316700,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "say starting at 12."
    } ]
  }, {
    "tStartMs": 1319280,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And we ask a simple question,\nhow many primes do we see?"
    } ]
  }, {
    "tStartMs": 1323600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "In this case, we see 12, 14, and 18,"
    } ]
  }, {
    "tStartMs": 1326780,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "none of which are prime."
    } ]
  }, {
    "tStartMs": 1327860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So, we write down zero."
    } ]
  }, {
    "tStartMs": 1329780,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Next we shift the stencil\nover one spot and repeat,"
    } ]
  }, {
    "tStartMs": 1333470,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "13, 15, and 19, two of which are prime."
    } ]
  }, {
    "tStartMs": 1337010,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So, we write down two."
    } ]
  }, {
    "tStartMs": 1338960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And then we keep doing this."
    } ]
  }, {
    "tStartMs": 1340460,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "If you slide it a bit further,"
    } ]
  }, {
    "tStartMs": 1341780,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "we catch two primes again, 23 and 29."
    } ]
  }, {
    "tStartMs": 1345830,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Now, if you keep moving the\nstencil across the number line"
    } ]
  }, {
    "tStartMs": 1349400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and it keeps catching two primes,"
    } ]
  }, {
    "tStartMs": 1351710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "then you have proven"
    } ]
  }, {
    "tStartMs": 1353150,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that infinitely often\npairs of primes exist"
    } ]
  }, {
    "tStartMs": 1356030,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "within a bounded gap."
    } ]
  }, {
    "tStartMs": 1357530,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "Six in this case, since that's\nthe diameter of our stencil."
    } ]
  }, {
    "tStartMs": 1362000,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "But there are two problems\nwith this approach."
    } ]
  }, {
    "tStartMs": 1365180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The first is that we don't know exactly"
    } ]
  }, {
    "tStartMs": 1367550,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "where all the primes are."
    } ]
  }, {
    "tStartMs": 1369350,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And the second is that of\ncourse you can't keep sliding"
    } ]
  }, {
    "tStartMs": 1372740,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "a stencil down the number line forever"
    } ]
  }, {
    "tStartMs": 1374840,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because well, it's infinitely long."
    } ]
  }, {
    "tStartMs": 1377210,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Fortunately, there is an easy way"
    } ]
  }, {
    "tStartMs": 1379580,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to get around that first problem."
    } ]
  }, {
    "tStartMs": 1381140,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "See, while we don't know exactly\nwhere all the primes are,"
    } ]
  }, {
    "tStartMs": 1384500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "we do know how they behave on average."
    } ]
  }, {
    "tStartMs": 1387500,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "For example, say we take some\nstretch of the number line"
    } ]
  }, {
    "tStartMs": 1390860,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "from some very large number X to two X,"
    } ]
  }, {
    "tStartMs": 1394130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "then we can't predict\nexactly which numbers"
    } ]
  }, {
    "tStartMs": 1396890,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in this stretch will be prime."
    } ]
  }, {
    "tStartMs": 1398480,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But what we can do is put this\ninto the prime number theorem"
    } ]
  }, {
    "tStartMs": 1401690,
    "dDurationMs": 3923,
    "segs": [ {
      "utf8": "and estimate how many\nprimes to expect on average."
    } ]
  }, {
    "tStartMs": 1405613,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1407240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And GPY realized they\ncould do a similar thing"
    } ]
  }, {
    "tStartMs": 1410480,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for their stencil method"
    } ]
  }, {
    "tStartMs": 1412130,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to build an averaging machine of sorts."
    } ]
  }, {
    "tStartMs": 1415160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "All you do is you set\nup the stencil you want,"
    } ]
  }, {
    "tStartMs": 1417680,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "input your range, and out comes\nthe average number of primes"
    } ]
  }, {
    "tStartMs": 1420860,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it caught per position."
    } ]
  }, {
    "tStartMs": 1422930,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So, let's do a quick\nexample without the machine"
    } ]
  }, {
    "tStartMs": 1426140,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to see how this helps."
    } ]
  }, {
    "tStartMs": 1428060,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Let's use the same stencil from before"
    } ]
  }, {
    "tStartMs": 1430250,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and use the range 20 to 40."
    } ]
  }, {
    "tStartMs": 1432860,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Now, in reality, you would\nuse a much larger range,"
    } ]
  }, {
    "tStartMs": 1435860,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but for simplicity, let's stick to this."
    } ]
  }, {
    "tStartMs": 1438680,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "To find the average, you\njust place the stencil"
    } ]
  }, {
    "tStartMs": 1441380,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "at the start of your range,"
    } ]
  }, {
    "tStartMs": 1442760,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and you'll look at which numbers you see,"
    } ]
  }, {
    "tStartMs": 1444980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "20, 22 and 26."
    } ]
  }, {
    "tStartMs": 1446990,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "None of which are prime"
    } ]
  }, {
    "tStartMs": 1448040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and so the total prime count is zero."
    } ]
  }, {
    "tStartMs": 1450620,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Then we shift the stencil over one spot"
    } ]
  }, {
    "tStartMs": 1452840,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and see 21, 23 and 27."
    } ]
  }, {
    "tStartMs": 1455900,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "One of which is prime, so we\nincrease the total by one."
    } ]
  }, {
    "tStartMs": 1459890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Now let's keep shifting the stencil"
    } ]
  }, {
    "tStartMs": 1461990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and keep adding all the primes we see."
    } ]
  }, {
    "tStartMs": 1464540,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "No primes, so add zero,"
    } ]
  }, {
    "tStartMs": 1466160,
    "dDurationMs": 2957,
    "segs": [ {
      "utf8": "two primes, add two, and so on."
    } ]
  }, {
    "tStartMs": 1469117,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "(stencil shuffling)"
    } ]
  }, {
    "tStartMs": 1471920,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Now, if you keep shifting the stencil"
    } ]
  }, {
    "tStartMs": 1473930,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "all the way until the end,"
    } ]
  }, {
    "tStartMs": 1475460,
    "dDurationMs": 4664,
    "segs": [ {
      "utf8": "you find a total of 14 primes\nacross 21 starting positions."
    } ]
  }, {
    "tStartMs": 1480124,
    "dDurationMs": 2446,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1482570,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And so the average is 14 over 21,"
    } ]
  }, {
    "tStartMs": 1485930,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "or about 0.67 primes per location."
    } ]
  }, {
    "tStartMs": 1491690,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Now in this case where we\nchecked every spot by hand,"
    } ]
  }, {
    "tStartMs": 1495470,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "we could see that the stencil\ncaught several positions"
    } ]
  }, {
    "tStartMs": 1498380,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "with two primes in them."
    } ]
  }, {
    "tStartMs": 1500360,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But the averaging machine\ndoesn't tell us this."
    } ]
  }, {
    "tStartMs": 1503150,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "All that spits out is an average,"
    } ]
  }, {
    "tStartMs": 1505340,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and that average alone"
    } ]
  }, {
    "tStartMs": 1507050,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "can't guarantee that it\ncaught two primes at once,"
    } ]
  }, {
    "tStartMs": 1510470,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "because you could just\nas well imagine spreading"
    } ]
  }, {
    "tStartMs": 1512960,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "all of these 14 primes over\n14 individual positions."
    } ]
  }, {
    "tStartMs": 1517340,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "And the same would be true\nif the average was 0.8, 0.9,"
    } ]
  }, {
    "tStartMs": 1521360,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or even one."
    } ]
  }, {
    "tStartMs": 1523100,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "I know it's unlikely,"
    } ]
  }, {
    "tStartMs": 1524570,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "but it could be that every\nposition only caught one prime"
    } ]
  }, {
    "tStartMs": 1528800,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "to bring the average to one."
    } ]
  }, {
    "tStartMs": 1531230,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "But what if the average\nwas larger than one?"
    } ]
  }, {
    "tStartMs": 1534410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "What if we found 22 primes in total?"
    } ]
  }, {
    "tStartMs": 1537950,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Well, even if every position\nhad caught one prime,"
    } ]
  }, {
    "tStartMs": 1541580,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "you would still have one prime left over"
    } ]
  }, {
    "tStartMs": 1543650,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and that needs to go in one\nof those other positions."
    } ]
  }, {
    "tStartMs": 1547010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So, in other words, if\nthe average is above one,"
    } ]
  }, {
    "tStartMs": 1550220,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "then that guarantees"
    } ]
  }, {
    "tStartMs": 1551720,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "that at least one position\ncaught two primes."
    } ]
  }, {
    "tStartMs": 1555140,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And so that's the game."
    } ]
  }, {
    "tStartMs": 1556520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Get the average number\nof primes above one,"
    } ]
  }, {
    "tStartMs": 1559760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but that still leaves one question."
    } ]
  }, {
    "tStartMs": 1562640,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Even if you could do that, then\nhow does that help you prove"
    } ]
  }, {
    "tStartMs": 1566900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that you keep getting bounded gaps"
    } ]
  }, {
    "tStartMs": 1568940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "all the way up to infinity?"
    } ]
  }, {
    "tStartMs": 1570980,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Well, remember you just proved\nthat for any large number X,"
    } ]
  }, {
    "tStartMs": 1575180,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "so there's nothing stopping\nyou from replacing that X"
    } ]
  }, {
    "tStartMs": 1578300,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "with two X, and that two X with four X,"
    } ]
  }, {
    "tStartMs": 1581780,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and then you could replace\nthe two X with four X"
    } ]
  }, {
    "tStartMs": 1583970,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and the four X with eight X, and so,"
    } ]
  }, {
    "tStartMs": 1587170,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "on all the way up to infinity."
    } ]
  }, {
    "tStartMs": 1589310,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So, if you can prove that the average gap"
    } ]
  }, {
    "tStartMs": 1591830,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "is above one for any large number X,"
    } ]
  }, {
    "tStartMs": 1595190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "then with this clever setup,"
    } ]
  }, {
    "tStartMs": 1596870,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "it immediately extends all\nthe way out to infinity,"
    } ]
  }, {
    "tStartMs": 1600470,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "and you would've proven your bounded gap."
    } ]
  }, {
    "tStartMs": 1603109,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1605450,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Unfortunately, running the machine"
    } ]
  }, {
    "tStartMs": 1607010,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "with just the current inputs,"
    } ]
  }, {
    "tStartMs": 1608540,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the stencil visits many positions"
    } ]
  }, {
    "tStartMs": 1610250,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "where it catches zero primes,"
    } ]
  }, {
    "tStartMs": 1612320,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "this drags the average down"
    } ]
  }, {
    "tStartMs": 1613790,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and means it will never get above one."
    } ]
  }, {
    "tStartMs": 1616190,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So, GPY made one final\ntweak to their machine."
    } ]
  }, {
    "tStartMs": 1619640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They realize that some starting positions"
    } ]
  }, {
    "tStartMs": 1621680,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are more likely to catch\nprimes than others."
    } ]
  }, {
    "tStartMs": 1624200,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "For example, if the stencil\nonly lands on even numbers,"
    } ]
  }, {
    "tStartMs": 1627230,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "it will always give zero\nprimes unless it includes two."
    } ]
  }, {
    "tStartMs": 1631130,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So, those positions"
    } ]
  }, {
    "tStartMs": 1632420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "should not be weighted\nequally to the others."
    } ]
  }, {
    "tStartMs": 1635120,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Similarly, if you can divide\none or more of the numbers"
    } ]
  }, {
    "tStartMs": 1637460,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in the stencil by three, five, seven,"
    } ]
  }, {
    "tStartMs": 1639440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "or other small prime factors,"
    } ]
  }, {
    "tStartMs": 1641270,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "it's also more unlikely you\nhave primes in your stencil."
    } ]
  }, {
    "tStartMs": 1644720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So, they should also be weighted less."
    } ]
  }, {
    "tStartMs": 1647390,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Now, GPY did a few simple checks\nlike this for each position"
    } ]
  }, {
    "tStartMs": 1650960,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to assign it a weight,\nand estimate of how likely"
    } ]
  }, {
    "tStartMs": 1653750,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it is that this position contains primes."
    } ]
  }, {
    "tStartMs": 1656300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "This turned their averaging machine"
    } ]
  }, {
    "tStartMs": 1658100,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "into a weighted averaging machine."
    } ]
  }, {
    "tStartMs": 1660650,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And as a result, that\nweighted average shot up."
    } ]
  }, {
    "tStartMs": 1663920,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "With their updated machine"
    } ]
  }, {
    "tStartMs": 1665390,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "they proved that if you\npick any large number X,"
    } ]
  }, {
    "tStartMs": 1668390,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "then in the range X to two X,"
    } ]
  }, {
    "tStartMs": 1670580,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "you could get the weighted\naverage arbitrarily close to one,"
    } ]
  }, {
    "tStartMs": 1674060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but not above one."
    } ]
  }, {
    "tStartMs": 1676190,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "They were close, but they ran into a wall."
    } ]
  }, {
    "tStartMs": 1679730,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "A wall that came from their weights,"
    } ]
  }, {
    "tStartMs": 1682190,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "because to figure out how to\nweigh different positions,"
    } ]
  }, {
    "tStartMs": 1684770,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "they needed to know how\nprimes are distributed"
    } ]
  }, {
    "tStartMs": 1687050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "in something known as an\narithmetic progression."
    } ]
  }, {
    "tStartMs": 1689990,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "These are basically just series of numbers"
    } ]
  }, {
    "tStartMs": 1692300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where they're all the\nsame step size apart."
    } ]
  }, {
    "tStartMs": 1695000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So, 3, 7, 11, 15,"
    } ]
  }, {
    "tStartMs": 1697640,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that's an arithmetic progression\nwith a step size of four."
    } ]
  }, {
    "tStartMs": 1701090,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Now, GPY needed to know\nhow primes were distributed"
    } ]
  }, {
    "tStartMs": 1704420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "over many such arithmetic progressions"
    } ]
  }, {
    "tStartMs": 1706700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with all kinds of different step sizes."
    } ]
  }, {
    "tStartMs": 1709400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Fortunately, they knew\nof theorem from the 1960s"
    } ]
  }, {
    "tStartMs": 1712310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "they could use to do exactly this."
    } ]
  }, {
    "tStartMs": 1714410,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- It's the substitute for the\nRiemann hypothesis on average,"
    } ]
  }, {
    "tStartMs": 1717560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and it turns out that that's\nwhat's actually necessary"
    } ]
  }, {
    "tStartMs": 1720260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "in a lot of these arithmetic applications."
    } ]
  }, {
    "tStartMs": 1722600,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- But that theorem\ndoesn't work everywhere."
    } ]
  }, {
    "tStartMs": 1725180,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "It only works for step sizes\nup to the square root of X"
    } ]
  }, {
    "tStartMs": 1728480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "or X to the one half."
    } ]
  }, {
    "tStartMs": 1730460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The technical term for this one half"
    } ]
  }, {
    "tStartMs": 1732770,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "is the level of distribution or theta."
    } ]
  }, {
    "tStartMs": 1735500,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It tells you how large the step sizes"
    } ]
  }, {
    "tStartMs": 1737840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "can be while still getting\na reliable count of primes"
    } ]
  }, {
    "tStartMs": 1740840,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "in those progressions."
    } ]
  }, {
    "tStartMs": 1742100,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And mathematicians believed"
    } ]
  }, {
    "tStartMs": 1743570,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that the theorem worked\nbeyond X to the half,"
    } ]
  }, {
    "tStartMs": 1746510,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but this was never proven,"
    } ]
  }, {
    "tStartMs": 1748760,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and that is where the trouble lies."
    } ]
  }, {
    "tStartMs": 1751310,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "When GPY ran their\ncalculation with this ceiling,"
    } ]
  }, {
    "tStartMs": 1754610,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "they found the maximum\nweighted average they could get"
    } ]
  }, {
    "tStartMs": 1757250,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "was two times theta."
    } ]
  }, {
    "tStartMs": 1759350,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "In other words, they\ngot really close to one,"
    } ]
  }, {
    "tStartMs": 1762260,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but they could never actually cross it."
    } ]
  }, {
    "tStartMs": 1765260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- They showed in their method"
    } ]
  }, {
    "tStartMs": 1766460,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that if you could get beyond a half,"
    } ]
  }, {
    "tStartMs": 1768110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "you could do 0.5000001."
    } ]
  }, {
    "tStartMs": 1771200,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Then instead of just getting\n0% of the average gap,"
    } ]
  }, {
    "tStartMs": 1774710,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "they can get bounded gaps."
    } ]
  }, {
    "tStartMs": 1776060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The primes would be some\nfixed distance apart."
    } ]
  }, {
    "tStartMs": 1778880,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- That's what the 2005\nmeeting was all about."
    } ]
  }, {
    "tStartMs": 1781370,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "They kept trying to push\npast that one half barrier,"
    } ]
  }, {
    "tStartMs": 1785060,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "but they ended up concluding\nthat it was impossible."
    } ]
  }, {
    "tStartMs": 1789140,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "From 2010 on, Zhang spent\ntwo years hacking away"
    } ]
  }, {
    "tStartMs": 1792620,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "at it as well, internalizing\nthe GPY argument,"
    } ]
  }, {
    "tStartMs": 1796100,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "working day and night just to\ntry and find a way through."
    } ]
  }, {
    "tStartMs": 1800709,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1802310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But by the summer of 2012,"
    } ]
  }, {
    "tStartMs": 1804410,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Zhang was exhausted, and\nhad nothing to show for it."
    } ]
  }, {
    "tStartMs": 1808340,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Hoping to clear his head, he\nvisited a friend in Colorado,"
    } ]
  }, {
    "tStartMs": 1812450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "where one evening while they were waiting"
    } ]
  }, {
    "tStartMs": 1814490,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to leave for concert,"
    } ]
  }, {
    "tStartMs": 1815870,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Zhang stepped outside\nalone into the backyard,"
    } ]
  }, {
    "tStartMs": 1819680,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "looking out for the deer that\nusually roamed the property,"
    } ]
  }, {
    "tStartMs": 1823100,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "but no deer came."
    } ]
  }, {
    "tStartMs": 1826340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So, he was just walking and thinking"
    } ]
  }, {
    "tStartMs": 1828920,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "when all of a sudden\nthe answer came to him."
    } ]
  }, {
    "tStartMs": 1833180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "He hadn't brought any notes or paper,"
    } ]
  }, {
    "tStartMs": 1835550,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "but Zhang believed his idea would work."
    } ]
  }, {
    "tStartMs": 1838703,
    "dDurationMs": 2337,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1841040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- You see, GPY had to count primes"
    } ]
  }, {
    "tStartMs": 1842870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "in many different arithmetic progressions"
    } ]
  }, {
    "tStartMs": 1844670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "with all sorts of step sizes."
    } ]
  }, {
    "tStartMs": 1846860,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But Zhang focused on a\nspecial class of step sizes,"
    } ]
  }, {
    "tStartMs": 1849920,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "one's built only from small prime factors,"
    } ]
  }, {
    "tStartMs": 1852530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and he realized he could\nreorganize the error terms"
    } ]
  }, {
    "tStartMs": 1855110,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "into a form where most\nof them get canceled out."
    } ]
  }, {
    "tStartMs": 1858620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This allowed him to push\npast the half barrier"
    } ]
  }, {
    "tStartMs": 1860960,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "by a tiny fraction, just one over 584."
    } ]
  }, {
    "tStartMs": 1866120,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Zhang spent the next year\nfinalizing his proof,"
    } ]
  }, {
    "tStartMs": 1869120,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and then on the 17th of April, 2013,"
    } ]
  }, {
    "tStartMs": 1871550,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "he sent off that curious email\nto the Annals of Mathematics."
    } ]
  }, {
    "tStartMs": 1876350,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Now, the Annals gets a proof"
    } ]
  }, {
    "tStartMs": 1877430,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "of the Riemann Hypothesis every other day,"
    } ]
  }, {
    "tStartMs": 1880370,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "so they're like, okay, surely\nthis isn't gonna work out,"
    } ]
  }, {
    "tStartMs": 1883100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but whatever."
    } ]
  }, {
    "tStartMs": 1883933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "You know, we'll send it to a referee."
    } ]
  }, {
    "tStartMs": 1885800,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And they're like, well,"
    } ]
  }, {
    "tStartMs": 1888470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "let's spend a few hours this afternoon."
    } ]
  }, {
    "tStartMs": 1890240,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "We'll find a mistake."
    } ]
  }, {
    "tStartMs": 1891410,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "We'll tell the annals, you\nknow, sorry, it didn't work out."
    } ]
  }, {
    "tStartMs": 1893390,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Here's where the the gap is."
    } ]
  }, {
    "tStartMs": 1895940,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And they start reading it,"
    } ]
  }, {
    "tStartMs": 1897470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and then they flip back,\nbecause they're experts."
    } ]
  }, {
    "tStartMs": 1899270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So, they can just flip through\nlike, yeah, this'll work,"
    } ]
  }, {
    "tStartMs": 1901160,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "this will work, but wait a second,"
    } ]
  }, {
    "tStartMs": 1902450,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you're gonna get stuck here."
    } ]
  }, {
    "tStartMs": 1903890,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And they flip five pages\nand they're like, oh,"
    } ]
  }, {
    "tStartMs": 1906140,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "that's interesting."
    } ]
  }, {
    "tStartMs": 1906980,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "That's how you're gonna handle that."
    } ]
  }, {
    "tStartMs": 1908510,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Okay, but then you're gonna have another,"
    } ]
  }, {
    "tStartMs": 1910640,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "it's like trying to lay down a carpet"
    } ]
  }, {
    "tStartMs": 1913182,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "in a room."
    } ]
  }, {
    "tStartMs": 1914533,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "You're like, okay, I know that corner,"
    } ]
  }, {
    "tStartMs": 1916070,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "that corner's gonna screw you up"
    } ]
  }, {
    "tStartMs": 1917300,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "even if you managed to\nmake it work over there."
    } ]
  }, {
    "tStartMs": 1919490,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And then he goes over there,\nno, he cut it just right."
    } ]
  }, {
    "tStartMs": 1921500,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "It fits in that corner."
    } ]
  }, {
    "tStartMs": 1922370,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Wait a second."
    } ]
  }, {
    "tStartMs": 1923420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And then they flip, you\nknow, five more pages"
    } ]
  }, {
    "tStartMs": 1925820,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "and by the end of the week,"
    } ]
  }, {
    "tStartMs": 1926690,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "they've reconstructed the\nproof and everything's right."
    } ]
  }, {
    "tStartMs": 1930410,
    "dDurationMs": 1587,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 1931997,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1932830,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "- Zhang's stencil had 3.5 million slots,"
    } ]
  }, {
    "tStartMs": 1936020,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "spread across a span of 70 million."
    } ]
  }, {
    "tStartMs": 1938960,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And by proving two of those\nslots always catch primes,"
    } ]
  }, {
    "tStartMs": 1942440,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "he proved a bounded gap of 70 million."
    } ]
  }, {
    "tStartMs": 1946190,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "When the news broke,"
    } ]
  }, {
    "tStartMs": 1947120,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "mathematicians were in disbelief."
    } ]
  }, {
    "tStartMs": 1949190,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- It was basically an\nunknown in the field."
    } ]
  }, {
    "tStartMs": 1951260,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "I actually thought"
    } ]
  }, {
    "tStartMs": 1952160,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "when I started reading\nYitang Zhang's paper"
    } ]
  }, {
    "tStartMs": 1953720,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and started realizing\nit was probably correct,"
    } ]
  }, {
    "tStartMs": 1956180,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I thought it was probably\none of the people"
    } ]
  }, {
    "tStartMs": 1957620,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I knew under a pseudonym,"
    } ]
  }, {
    "tStartMs": 1959180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "trying to avoid being\nembarrassed by being wrong."
    } ]
  }, {
    "tStartMs": 1961520,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "If they were wrong."
    } ]
  }, {
    "tStartMs": 1962870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- Of course it wasn't, Zhang was real."
    } ]
  }, {
    "tStartMs": 1965660,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And just over a year later"
    } ]
  }, {
    "tStartMs": 1966980,
    "dDurationMs": 2895,
    "segs": [ {
      "utf8": "he was awarded the MacArthur Genius Grant."
    } ]
  }, {
    "tStartMs": 1969875,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1971780,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- To me, this is a\nreally interesting aspect"
    } ]
  }, {
    "tStartMs": 1974780,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of mathematics in particular."
    } ]
  }, {
    "tStartMs": 1976340,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I think it's one of the very few fields"
    } ]
  }, {
    "tStartMs": 1978590,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "where we have a truly honest approach"
    } ]
  }, {
    "tStartMs": 1982400,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to success and what counts as success."
    } ]
  }, {
    "tStartMs": 1985880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "He sent in an argument,\npeople took it seriously."
    } ]
  }, {
    "tStartMs": 1988490,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "They looked at it."
    } ]
  }, {
    "tStartMs": 1989323,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "They didn't think that\nhe had a true proof."
    } ]
  }, {
    "tStartMs": 1990920,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "They sat there, they gave him the time"
    } ]
  }, {
    "tStartMs": 1994340,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that the argument was due,"
    } ]
  }, {
    "tStartMs": 1995360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and he was immediately made a\nhero as he should have been."
    } ]
  }, {
    "tStartMs": 1997820,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "To me, it shows that\nmathematics culture works."
    } ]
  }, {
    "tStartMs": 1999980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "We're doing the right thing."
    } ]
  }, {
    "tStartMs": 2001630,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I think the cover of\nlike Scientific American"
    } ]
  }, {
    "tStartMs": 2004600,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "or whatever in 2013 is\nthe story Yitang Zhang"
    } ]
  }, {
    "tStartMs": 2007150,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and how he got this bounded gap"
    } ]
  }, {
    "tStartMs": 2008860,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "between primes toiling\nin complete isolation."
    } ]
  }, {
    "tStartMs": 2011710,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And maybe it's because he was in isolation"
    } ]
  }, {
    "tStartMs": 2013600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that he didn't have the group\nthink that the rest of us did."
    } ]
  }, {
    "tStartMs": 2015820,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "To know that this was not,"
    } ]
  }, {
    "tStartMs": 2017980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "we were all told it's\nan impossible problem."
    } ]
  }, {
    "tStartMs": 2019870,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "- After realizing a bounded gap\nwas not an impossible dream,"
    } ]
  }, {
    "tStartMs": 2024040,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "people reworked Zhang's\nmethod to optimize it."
    } ]
  }, {
    "tStartMs": 2027460,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Terence Tao spearheaded an\nonline group called Polymath,"
    } ]
  }, {
    "tStartMs": 2030430,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and they sharpened the method."
    } ]
  }, {
    "tStartMs": 2032050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So, every month, week or day,"
    } ]
  }, {
    "tStartMs": 2034750,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that upper bound kept coming down."
    } ]
  }, {
    "tStartMs": 2036970,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "One of the attendees described\nbeing at a conference"
    } ]
  }, {
    "tStartMs": 2039220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "at the time, as I remember,\nsort of day by day,"
    } ]
  }, {
    "tStartMs": 2042100,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "everyone was refreshing\ntheir screens to see"
    } ]
  }, {
    "tStartMs": 2044650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "who had the world record now,"
    } ]
  }, {
    "tStartMs": 2046660,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and ultimately they got the number"
    } ]
  }, {
    "tStartMs": 2048310,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "all the way down to 4,680."
    } ]
  }, {
    "tStartMs": 2052540,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- Meanwhile, there's a young\npostdoc named James Maynard,"
    } ]
  }, {
    "tStartMs": 2056020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "who just got his PhD at\nOxford with Roger Heath-Brown"
    } ]
  }, {
    "tStartMs": 2059020,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and other one of these analytic\nnumber theory world experts."
    } ]
  }, {
    "tStartMs": 2062800,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "And he's working with Andrew\nGranville, in Montreal."
    } ]
  }, {
    "tStartMs": 2066850,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "And he has a completely orthogonal\napproach to this problem"
    } ]
  }, {
    "tStartMs": 2071620,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that he'd been making"
    } ]
  }, {
    "tStartMs": 2072453,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "some very incremental\nprogress on independently."
    } ]
  }, {
    "tStartMs": 2074770,
    "dDurationMs": 3457,
    "segs": [ {
      "utf8": "- When Maynard started, his\nadvisor explicitly told him,"
    } ]
  }, {
    "tStartMs": 2078227,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "\"I hope you won't work on\nthis problem full time,"
    } ]
  }, {
    "tStartMs": 2081370,
    "dDurationMs": 3147,
    "segs": [ {
      "utf8": "because I'm really pretty\nconfident you're going to fail.\""
    } ]
  }, {
    "tStartMs": 2085840,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But Maynard ignored the warning,"
    } ]
  }, {
    "tStartMs": 2087910,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and came up with a different\nway to attack the problem,"
    } ]
  }, {
    "tStartMs": 2091510,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and within just a few\nmonths, he got it to work."
    } ]
  }, {
    "tStartMs": 2095320,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "Further bring down the gap to 600."
    } ]
  }, {
    "tStartMs": 2098740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But his method also proved something else."
    } ]
  }, {
    "tStartMs": 2101620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- He can get three primes\nin a bounded window."
    } ]
  }, {
    "tStartMs": 2103720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The bound has to change\ndepending on how many primes"
    } ]
  }, {
    "tStartMs": 2105640,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "you wanna put in that window,"
    } ]
  }, {
    "tStartMs": 2106990,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and that his number is better."
    } ]
  }, {
    "tStartMs": 2108400,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And the method has nothing to\ndo with the exponent one half."
    } ]
  }, {
    "tStartMs": 2111910,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Wait, what?"
    } ]
  }, {
    "tStartMs": 2113110,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- One half was a pure mirage."
    } ]
  }, {
    "tStartMs": 2116800,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It was a red herring."
    } ]
  }, {
    "tStartMs": 2118450,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- That is crazy."
    } ]
  }, {
    "tStartMs": 2119590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "One half was not a\nfundamental limit at all."
    } ]
  }, {
    "tStartMs": 2122590,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "See where GPY average was\nstuck at two times theta,"
    } ]
  }, {
    "tStartMs": 2126220,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Maynard's average grew\nroughly like theta over two"
    } ]
  }, {
    "tStartMs": 2129520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "times the natural logarithm of K,"
    } ]
  }, {
    "tStartMs": 2131500,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "where K is the number\nof slots in the stencil."
    } ]
  }, {
    "tStartMs": 2134440,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "So, all Maynard needed was\nenough slots and it worked."
    } ]
  }, {
    "tStartMs": 2139030,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- You need any number greater than zero."
    } ]
  }, {
    "tStartMs": 2141340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "When you go up to one half\nbecause you have one half,"
    } ]
  }, {
    "tStartMs": 2143200,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you'll get better numerics."
    } ]
  }, {
    "tStartMs": 2145060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But the bounded gaps you\ncould do, just going up to,"
    } ]
  }, {
    "tStartMs": 2147730,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "you know, 0.01, not 0.50101."
    } ]
  }, {
    "tStartMs": 2150910,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Now, curiously, Terry Tao independently"
    } ]
  }, {
    "tStartMs": 2154090,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "has the same approach."
    } ]
  }, {
    "tStartMs": 2156430,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "He tells Ben Green about it,"
    } ]
  }, {
    "tStartMs": 2157810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Ben Green is meeting\nwith Andrew Granville,"
    } ]
  }, {
    "tStartMs": 2160600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and says, \"Hey, Terry's got this new idea"
    } ]
  }, {
    "tStartMs": 2163690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that he thinks is gonna get even farther.\""
    } ]
  }, {
    "tStartMs": 2165520,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And Granville, says, wait a second."
    } ]
  }, {
    "tStartMs": 2166750,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "My postdoc, Maynard, is\ndoing exactly the same thing."
    } ]
  }, {
    "tStartMs": 2169810,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "We gotta get these two guys\nto talk to one another."
    } ]
  }, {
    "tStartMs": 2171700,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Terry's a Fields medalist,"
    } ]
  }, {
    "tStartMs": 2173170,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "he's like a super\nheavyweight by this point,"
    } ]
  }, {
    "tStartMs": 2176740,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "whereas James is this,\nyou know, fresh PhD,"
    } ]
  }, {
    "tStartMs": 2181240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and Terry says, you take\nit, I don't need this."
    } ]
  }, {
    "tStartMs": 2183760,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "You know, you this,"
    } ]
  }, {
    "tStartMs": 2184690,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "it's your idea, you go with it."
    } ]
  }, {
    "tStartMs": 2186610,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- By early 2014, Maynard joined forces"
    } ]
  }, {
    "tStartMs": 2189400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with Tao's Polymath group."
    } ]
  }, {
    "tStartMs": 2191080,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- It was clear that somehow 600\nwas just a proof of concept,"
    } ]
  }, {
    "tStartMs": 2194560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and the same methods would\ngive something smaller,"
    } ]
  }, {
    "tStartMs": 2197500,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "but there were extra ideas\nthat you could maybe use"
    } ]
  }, {
    "tStartMs": 2200770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to squeeze everything out."
    } ]
  }, {
    "tStartMs": 2202150,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And so the current world record"
    } ]
  }, {
    "tStartMs": 2203890,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "is that there's infinitely\nmany pairs of primes"
    } ]
  }, {
    "tStartMs": 2205690,
    "dDurationMs": 3418,
    "segs": [ {
      "utf8": "that differ by no more than 246."
    } ]
  }, {
    "tStartMs": 2209108,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 2209941,
    "dDurationMs": 3009,
    "segs": [ {
      "utf8": "- And that for now is where it stops."
    } ]
  }, {
    "tStartMs": 2212950,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "In 2022, James Maynard was\nawarded the Fields Medal,"
    } ]
  }, {
    "tStartMs": 2216490,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "Mathematics, highest honor\nfor his work on prime gaps."
    } ]
  }, {
    "tStartMs": 2220960,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Yeah, I think that's the basic outline"
    } ]
  }, {
    "tStartMs": 2223180,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "is the kind of two\ndirections of approximation"
    } ]
  }, {
    "tStartMs": 2226060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to twin primes Chen's direction,"
    } ]
  }, {
    "tStartMs": 2228670,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Brun, Chen, whatever,\nversus Zhang and Maynard,"
    } ]
  }, {
    "tStartMs": 2232750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and this story that the\nZhang wasn't at this meeting,"
    } ]
  }, {
    "tStartMs": 2235000,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "so he didn't know it was impossible."
    } ]
  }, {
    "tStartMs": 2236320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- It reminded me of the four minute mile"
    } ]
  }, {
    "tStartMs": 2237880,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "where everyone thought it was impossible."
    } ]
  }, {
    "tStartMs": 2239650,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "No one did it."
    } ]
  }, {
    "tStartMs": 2241030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- And then for the first time ever,"
    } ]
  }, {
    "tStartMs": 2242680,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Roger Bannister broke it in 1954,"
    } ]
  }, {
    "tStartMs": 2245860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and after knowing it was possible,"
    } ]
  }, {
    "tStartMs": 2247780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "just 46 days later,"
    } ]
  }, {
    "tStartMs": 2249640,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "another runner called John\nLandy broke it as well."
    } ]
  }, {
    "tStartMs": 2252970,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "And by the end of 1956,\n10 people had broken it,"
    } ]
  }, {
    "tStartMs": 2257350,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "all from knowing that it was possible."
    } ]
  }, {
    "tStartMs": 2261490,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So, what about pushing\nthat gap down even lower?"
    } ]
  }, {
    "tStartMs": 2264940,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Is that possible?"
    } ]
  }, {
    "tStartMs": 2266230,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Well, mathematicians have found ways"
    } ]
  }, {
    "tStartMs": 2268180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to bring it down even more,"
    } ]
  }, {
    "tStartMs": 2270100,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but all of these results are conditional."
    } ]
  }, {
    "tStartMs": 2272920,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "For example, there is the\nElliot-Halberstam conjecture,"
    } ]
  }, {
    "tStartMs": 2276550,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "which assumes primes"
    } ]
  }, {
    "tStartMs": 2277900,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "are spread evenly across\narithmetic progressions,"
    } ]
  }, {
    "tStartMs": 2280780,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or that the level of distribution"
    } ]
  }, {
    "tStartMs": 2282520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "can be taken as large as one."
    } ]
  }, {
    "tStartMs": 2284830,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And in 2013, Maynard\nshowed that if you assume"
    } ]
  }, {
    "tStartMs": 2288190,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "this conjecture is true,"
    } ]
  }, {
    "tStartMs": 2289540,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "then the gap plummets to just 12."
    } ]
  }, {
    "tStartMs": 2292060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "A year later,"
    } ]
  }, {
    "tStartMs": 2292893,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "the Polymath Group\nproved that if you assume"
    } ]
  }, {
    "tStartMs": 2295180,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "an even stronger version\nof this conjecture,"
    } ]
  }, {
    "tStartMs": 2297790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "the gap drops all the way down to six."
    } ]
  }, {
    "tStartMs": 2301000,
    "dDurationMs": 4473,
    "segs": [ {
      "utf8": "But without assuming\nanything, 246 still stands."
    } ]
  }, {
    "tStartMs": 2307930,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Let me ask you, do you\nthink we're gonna solve"
    } ]
  }, {
    "tStartMs": 2310060,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the twin Prime conjecture?"
    } ]
  }, {
    "tStartMs": 2311650,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "- I am totally convinced that\nhumanity will eventually solve"
    } ]
  }, {
    "tStartMs": 2316000,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "the twin prime conjecture."
    } ]
  }, {
    "tStartMs": 2317410,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Often when I'm asked about some\nof these big famous problems"
    } ]
  }, {
    "tStartMs": 2320710,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "like Twin Primes or Riemann\nor something like that,"
    } ]
  }, {
    "tStartMs": 2325120,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "one way of kind of avoiding the question"
    } ]
  }, {
    "tStartMs": 2328330,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "is that if you imagine you\nare randomly distributed in time,"
    } ]
  }, {
    "tStartMs": 2332080,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "you'd expect to be sort of\ntypically roughly halfway"
    } ]
  }, {
    "tStartMs": 2337030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "through when the\nconjectures been open for."
    } ]
  }, {
    "tStartMs": 2339490,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, an actual guess, if you\nhave no other information,"
    } ]
  }, {
    "tStartMs": 2342340,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is to guess that a problem will be open"
    } ]
  }, {
    "tStartMs": 2345460,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for as long as it has been open for already."
    } ]
  }, {
    "tStartMs": 2347860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But obviously this doesn't\nwork for twin primes,"
    } ]
  }, {
    "tStartMs": 2349750,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "'cause we don't know whether it's-"
    } ]
  }, {
    "tStartMs": 2351940,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 2352899,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(all laughing)"
    } ]
  }, {
    "tStartMs": 2353732,
    "dDurationMs": 3158,
    "segs": [ {
      "utf8": "- 125 years old or whether\nit's like 2000 years old."
    } ]
  }, {
    "tStartMs": 2356890,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So, I think it's a fools game to guess,"
    } ]
  }, {
    "tStartMs": 2358600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but it clearly needs a really big idea,"
    } ]
  }, {
    "tStartMs": 2361690,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but maybe it only needs one big idea."
    } ]
  }, {
    "tStartMs": 2364780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Although maybe, just maybe,"
    } ]
  }, {
    "tStartMs": 2367270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "not knowing this with\ncertainty is for the best."
    } ]
  }, {
    "tStartMs": 2370510,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Because if we knew for sure\nthat this was impossible,"
    } ]
  }, {
    "tStartMs": 2374470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "then we would've likely missed out"
    } ]
  }, {
    "tStartMs": 2376240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "on most of these inventions"
    } ]
  }, {
    "tStartMs": 2377920,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and new methods over the past century."
    } ]
  }, {
    "tStartMs": 2380290,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So, sometimes it pays\nnot to know everything."
    } ]
  }, {
    "tStartMs": 2386290,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- You know, before I started this channel,"
    } ]
  }, {
    "tStartMs": 2388630,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I was a teacher at a tutoring company,"
    } ]
  }, {
    "tStartMs": 2390850,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and honestly, it was the best job"
    } ]
  }, {
    "tStartMs": 2392680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I'd had up until that point."
    } ]
  }, {
    "tStartMs": 2394900,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I could be the person who gave my students"
    } ]
  }, {
    "tStartMs": 2396880,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that one big idea that\nwould help everything click."
    } ]
  }, {
    "tStartMs": 2400180,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "You know, the fastest\nway to learn something"
    } ]
  }, {
    "tStartMs": 2402640,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "is to have someone next to you\nwho already understands it."
    } ]
  }, {
    "tStartMs": 2406510,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Unfortunately, many\nstudents don't have access"
    } ]
  }, {
    "tStartMs": 2408640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to that kind of support."
    } ]
  }, {
    "tStartMs": 2410320,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "That is, until now, our\nlong-term sponsor Brilliant,"
    } ]
  }, {
    "tStartMs": 2413830,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "has just launched Koji,"
    } ]
  }, {
    "tStartMs": 2415480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which is a revolutionary personal tutor"
    } ]
  }, {
    "tStartMs": 2417640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that makes one-on-one learning\naccessible for everyone."
    } ]
  }, {
    "tStartMs": 2420640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Koji can see what you do"
    } ]
  }, {
    "tStartMs": 2422080,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and answer any questions."
    } ]
  }, {
    "tStartMs": 2424120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "He can even draw onscreen to\nhelp explain those big ideas,"
    } ]
  }, {
    "tStartMs": 2427240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "just like a person sitting next to you."
    } ]
  }, {
    "tStartMs": 2429340,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "He asks guiding questions,"
    } ]
  }, {
    "tStartMs": 2430810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "walks you through problems step by step,"
    } ]
  }, {
    "tStartMs": 2432820,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and adapts to where\nyou're at in real time."
    } ]
  }, {
    "tStartMs": 2435310,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "You get a world class\npersonal tutor in your pocket."
    } ]
  }, {
    "tStartMs": 2438100,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Koji can help you work through\nmath and coding streams"
    } ]
  }, {
    "tStartMs": 2440650,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "from grade five through\ncollege and beyond."
    } ]
  }, {
    "tStartMs": 2443500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Each course is designed by\nexperts from places like MIT,"
    } ]
  }, {
    "tStartMs": 2446710,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Harvard, Stanford, and Caltech."
    } ]
  }, {
    "tStartMs": 2448450,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "It's a great way to get seriously\nengaged with math, coding,"
    } ]
  }, {
    "tStartMs": 2451960,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "think hard and have fun,"
    } ]
  }, {
    "tStartMs": 2453430,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "especially for students on\nsummer break to stay sharp"
    } ]
  }, {
    "tStartMs": 2456010,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or get ahead for next year."
    } ]
  }, {
    "tStartMs": 2457750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, click the link below to get started"
    } ]
  }, {
    "tStartMs": 2459610,
    "dDurationMs": 1830,
    "segs": [ {
