{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "This is 10 micrograms."
    } ]
  }, {
    "tStartMs": 1470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "You think that I might be able to see?"
    } ]
  }, {
    "tStartMs": 3240,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I think you might be able to."
    } ]
  }, {
    "tStartMs": 5190,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 6023,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "It's an arrow right there."
    } ]
  }, {
    "tStartMs": 7080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 7913,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "This flashlight will help."
    } ]
  }, {
    "tStartMs": 9450,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I feel like I need to get video of this."
    } ]
  }, {
    "tStartMs": 12480,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "[Dr. Shaw] I don't know how."
    } ]
  }, {
    "tStartMs": 14146,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "(Dr. Shaw laughing)\nIt kinda looks like a hair,"
    } ]
  }, {
    "tStartMs": 15812,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "like a tiny,-\nYeah."
    } ]
  }, {
    "tStartMs": 16645,
    "dDurationMs": 2855,
    "segs": [ {
      "utf8": "like a smaller than an eyelash."
    } ]
  }, {
    "tStartMs": 19500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "If you wanna measure a force\nlike the weight of an object,"
    } ]
  }, {
    "tStartMs": 22710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the way it has always been done"
    } ]
  }, {
    "tStartMs": 24180,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "has been to balance it\nwith some known standards."
    } ]
  }, {
    "tStartMs": 27540,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And the most precise standard\nweight people ever created"
    } ]
  }, {
    "tStartMs": 30960,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "was the kilogram, a\nplatinum-iridium cylinder"
    } ]
  }, {
    "tStartMs": 33930,
    "dDurationMs": 2932,
    "segs": [ {
      "utf8": "stored in a vault on\nthe outskirts of Paris."
    } ]
  }, {
    "tStartMs": 36862,
    "dDurationMs": 1298,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 38160,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Replicas of this kilogram were sent"
    } ]
  }, {
    "tStartMs": 39720,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to countries around the world"
    } ]
  }, {
    "tStartMs": 41250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to use as their mass standards."
    } ]
  }, {
    "tStartMs": 43380,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Here is K20, the United\nStates Mass Standard."
    } ]
  }, {
    "tStartMs": 47190,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And yes, the US is secretly metric."
    } ]
  }, {
    "tStartMs": 49620,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "They just apply a conversion\nfactor to get to \"freedom units\"."
    } ]
  }, {
    "tStartMs": 53610,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "It's just a little\ntranslation that we do here,"
    } ]
  }, {
    "tStartMs": 55740,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but our country is actually\non the metric system."
    } ]
  }, {
    "tStartMs": 58530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Doesn't that seem crazy?"
    } ]
  }, {
    "tStartMs": 60450,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "Yes, it's stupid."
    } ]
  }, {
    "tStartMs": 62640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The uncertainty in the\nmass of a standard kilogram"
    } ]
  }, {
    "tStartMs": 65400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "is on the order of tens of micrograms."
    } ]
  }, {
    "tStartMs": 68160,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So that's tens of parts per billion"
    } ]
  }, {
    "tStartMs": 70350,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "or about 0.000001%."
    } ]
  }, {
    "tStartMs": 75690,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's pretty good."
    } ]
  }, {
    "tStartMs": 77370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But there's a problem if you want to weigh"
    } ]
  }, {
    "tStartMs": 79320,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "something lighter than a kilogram,"
    } ]
  }, {
    "tStartMs": 81450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the uncertainty increases."
    } ]
  }, {
    "tStartMs": 83730,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "This little object here\nis a 50 gram test weight."
    } ]
  }, {
    "tStartMs": 87210,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So it's a reference mass."
    } ]
  }, {
    "tStartMs": 88650,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Can I pick it up?"
    } ]
  }, {
    "tStartMs": 90090,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Maybe with tweezers?"
    } ]
  }, {
    "tStartMs": 91050,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Yeah, if you don't mind?"
    } ]
  }, {
    "tStartMs": 92160,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Sure."
    } ]
  }, {
    "tStartMs": 92993,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "[Dr. Shaw] We try to keep\nthe fingerprints off."
    } ]
  }, {
    "tStartMs": 95250,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "so it's got a little bit\nof heft. You can feel that."
    } ]
  }, {
    "tStartMs": 97253,
    "dDurationMs": 1927,
    "segs": [ {
      "utf8": "A little, yeah."
    } ]
  }, {
    "tStartMs": 99180,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "What about this one, what's this?"
    } ]
  }, {
    "tStartMs": 100770,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "[Dr. Shaw] This is 10 grams here."
    } ]
  }, {
    "tStartMs": 104190,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Yeah, that's pretty light."
    } ]
  }, {
    "tStartMs": 105270,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "That's pretty light."
    } ]
  }, {
    "tStartMs": 106440,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "And paperclip here is about one gram."
    } ]
  }, {
    "tStartMs": 109650,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And so, how you might use\none of these test masses."
    } ]
  }, {
    "tStartMs": 112470,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So, if you're working in a\nlaboratory or something like that"
    } ]
  }, {
    "tStartMs": 115770,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "you could take one of these little weights"
    } ]
  }, {
    "tStartMs": 118050,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and put it on here and you\ncould look at the scale and say,"
    } ]
  }, {
    "tStartMs": 120690,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "oh, okay, my scale is\nreasonably well calibrated here."
    } ]
  }, {
    "tStartMs": 124320,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "That last digit might change a little bit."
    } ]
  }, {
    "tStartMs": 127110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But you could sort of\nmake some statement about"
    } ]
  }, {
    "tStartMs": 129510,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "whether or not your scale is accurate."
    } ]
  }, {
    "tStartMs": 131910,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "When we're talking about the kilogram,"
    } ]
  }, {
    "tStartMs": 133740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "these are obviously much\nsmaller than a kilogram."
    } ]
  }, {
    "tStartMs": 136080,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "How do we think about getting\nfrom that large object"
    } ]
  }, {
    "tStartMs": 139740,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "down to something that's this size here?"
    } ]
  }, {
    "tStartMs": 143460,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "One of the ways to do it is using"
    } ]
  }, {
    "tStartMs": 145530,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "conventional mass metrology,"
    } ]
  }, {
    "tStartMs": 147000,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which is that you take the kilogram"
    } ]
  }, {
    "tStartMs": 149460,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and you use a process called subdivision."
    } ]
  }, {
    "tStartMs": 152310,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Where you compare other smaller\nmasses against the kilogram."
    } ]
  }, {
    "tStartMs": 155730,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "You take two 500 gram masses"
    } ]
  }, {
    "tStartMs": 159600,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and you make sure that\nthey're equal on your balance."
    } ]
  }, {
    "tStartMs": 162630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And then you put both\nof those on your balance"
    } ]
  }, {
    "tStartMs": 165120,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and compare that against a kilogram."
    } ]
  }, {
    "tStartMs": 166830,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Would you go like two 500's"
    } ]
  }, {
    "tStartMs": 169290,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and then two 250's and then\ntwo 125's? like you just..."
    } ]
  }, {
    "tStartMs": 173370,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 174203,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "So you could do like\none common arrangement"
    } ]
  }, {
    "tStartMs": 176550,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "is something like we have here."
    } ]
  }, {
    "tStartMs": 177810,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This is a 500 milligram mass,"
    } ]
  }, {
    "tStartMs": 179730,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "these are two 200 milligram masses,"
    } ]
  }, {
    "tStartMs": 182940,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and that's a 100 milligram mass."
    } ]
  }, {
    "tStartMs": 185190,
    "dDurationMs": 3495,
    "segs": [ {
      "utf8": "So these three sum up to this."
    } ]
  }, {
    "tStartMs": 188685,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 189518,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "So you can compare those\ntwo against each other."
    } ]
  }, {
    "tStartMs": 191280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The smallest we have here, is down there."
    } ]
  }, {
    "tStartMs": 195120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "That's a milligram."
    } ]
  }, {
    "tStartMs": 196860,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "That is a milligram?"
    } ]
  }, {
    "tStartMs": 197760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "[Dr. Shaw] That is a\nmilligram right there."
    } ]
  }, {
    "tStartMs": 199680,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What are they made out of?"
    } ]
  }, {
    "tStartMs": 200513,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "Okay, these are made\noutta stainless steel."
    } ]
  }, {
    "tStartMs": 202650,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And we have to do things like you see"
    } ]
  }, {
    "tStartMs": 204180,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "this little lint free brush here."
    } ]
  }, {
    "tStartMs": 206310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "If you have a speck of dust on\nhere or something like that,"
    } ]
  }, {
    "tStartMs": 209310,
    "dDurationMs": 4014,
    "segs": [ {
      "utf8": "it's can be a problem, if\nit's a big speck of dust."
    } ]
  }, {
    "tStartMs": 213324,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "So every time we do weighings with these,"
    } ]
  }, {
    "tStartMs": 215940,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "we'll take a lint free cloth and a brush"
    } ]
  }, {
    "tStartMs": 218580,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and clean them off a little bit."
    } ]
  }, {
    "tStartMs": 220470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Why are they this sort of"
    } ]
  }, {
    "tStartMs": 222240,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "curious wire kind of shape?"
    } ]
  }, {
    "tStartMs": 224790,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "The shapes?"
    } ]
  }, {
    "tStartMs": 225623,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 226456,
    "dDurationMs": 2414,
    "segs": [ {
      "utf8": "It helps you remember which one is which."
    } ]
  }, {
    "tStartMs": 228870,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "The five-sided one is 500 milligrams."
    } ]
  }, {
    "tStartMs": 233730,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "One of the interesting things"
    } ]
  }, {
    "tStartMs": 234930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "from my perspective about this is that"
    } ]
  }, {
    "tStartMs": 237480,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "you can really subdivide\nover a large range"
    } ]
  }, {
    "tStartMs": 240510,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of these masses from a kilogram."
    } ]
  }, {
    "tStartMs": 242520,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "this is one millionth of a\nkilogram is a milligram."
    } ]
  }, {
    "tStartMs": 245580,
    "dDurationMs": 4153,
    "segs": [ {
      "utf8": "So you can subdivide the\nkilogram by a million times."
    } ]
  }, {
    "tStartMs": 249733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "But you sort of pay a price for that,"
    } ]
  }, {
    "tStartMs": 251700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "because each time you do this subdivision,"
    } ]
  }, {
    "tStartMs": 254220,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the uncertainty increases\na little bit, right?"
    } ]
  }, {
    "tStartMs": 257280,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So what is the uncertainty\nin say the milligram there?"
    } ]
  }, {
    "tStartMs": 259830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "If you do it with a subdivision,"
    } ]
  }, {
    "tStartMs": 261900,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "it will be maybe a part in 10 to the four,"
    } ]
  }, {
    "tStartMs": 266910,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "one part in 10 to the four."
    } ]
  }, {
    "tStartMs": 268470,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "So like 0.01 percent-ish range."
    } ]
  }, {
    "tStartMs": 272400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But there is a way to do better,"
    } ]
  }, {
    "tStartMs": 274680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and that's thanks to the fact the"
    } ]
  }, {
    "tStartMs": 276120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "kilogram is no longer defined"
    } ]
  }, {
    "tStartMs": 277800,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "by the platinum-iridium cylinder in Paris."
    } ]
  }, {
    "tStartMs": 280770,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Over the course of a century or so,"
    } ]
  }, {
    "tStartMs": 282510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the replica kilograms\nwere brought back to Paris"
    } ]
  }, {
    "tStartMs": 285060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "a few times to be weighed with each other."
    } ]
  }, {
    "tStartMs": 287820,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And from those measurements\nit became clear"
    } ]
  }, {
    "tStartMs": 290400,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "that their weights were\ndiverging by up to 75 micrograms."
    } ]
  }, {
    "tStartMs": 295350,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "No one could say if the\nreplicas were getting heavier"
    } ]
  }, {
    "tStartMs": 297960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "or if the original was getting lighter."
    } ]
  }, {
    "tStartMs": 300390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But it was unacceptable\nto have mass standards"
    } ]
  }, {
    "tStartMs": 302970,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "with changing masses."
    } ]
  }, {
    "tStartMs": 304830,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So the solution was to eliminate"
    } ]
  }, {
    "tStartMs": 307080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the kilogram's dependence\non a physical object"
    } ]
  }, {
    "tStartMs": 309540,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and instead define it based\non a constant of nature,"
    } ]
  }, {
    "tStartMs": 313020,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Planck's constant."
    } ]
  }, {
    "tStartMs": 314550,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So how does that work?"
    } ]
  }, {
    "tStartMs": 316260,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Well, Planck's constant is best known"
    } ]
  }, {
    "tStartMs": 318030,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for relating the frequency of a photon"
    } ]
  }, {
    "tStartMs": 320160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to its energy by E=hf."
    } ]
  }, {
    "tStartMs": 323520,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "But energy and mass are\nrelated through E=mc2."
    } ]
  }, {
    "tStartMs": 327870,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "So you can see how mass is\nrelated to Planck's constant."
    } ]
  }, {
    "tStartMs": 331950,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "In 2019, scientists\nofficially set the value"
    } ]
  }, {
    "tStartMs": 335070,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "of Planck's constant to be\nthis number in Joule-seconds"
    } ]
  }, {
    "tStartMs": 339000,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which, along with the definition\nof the meter and the second,"
    } ]
  }, {
    "tStartMs": 342060,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "now defines what a kilogram is."
    } ]
  }, {
    "tStartMs": 345420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The real advantage of this definition"
    } ]
  }, {
    "tStartMs": 347280,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "is how it can be applied in fancy scales."
    } ]
  }, {
    "tStartMs": 351510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "This is a Kibble balance."
    } ]
  }, {
    "tStartMs": 353130,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It can balance the weight of an object"
    } ]
  }, {
    "tStartMs": 355110,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "with an electromagnetic force."
    } ]
  }, {
    "tStartMs": 357210,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "What's great about that is\nthat the electrical quantities"
    } ]
  }, {
    "tStartMs": 360240,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "used in this balance can be\nread out very accurately,"
    } ]
  }, {
    "tStartMs": 364350,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and in units of Planck's constant."
    } ]
  }, {
    "tStartMs": 367290,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So you get direct traceability"
    } ]
  }, {
    "tStartMs": 369630,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "by weighing something in this balance."
    } ]
  }, {
    "tStartMs": 373230,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "This is kind of the smaller\ncousin of the Kibble balance."
    } ]
  }, {
    "tStartMs": 376920,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "It's called the electrostatic\nforce balance or the EFB."
    } ]
  }, {
    "tStartMs": 381270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And this is a balance that was designed,"
    } ]
  }, {
    "tStartMs": 383820,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "specifically to measure mass\nsort of in the milligram range."
    } ]
  }, {
    "tStartMs": 388590,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The Kibble balance uses an\nelectromagnet, I use a capacitor,"
    } ]
  }, {
    "tStartMs": 391950,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "which is basically two metal electrodes"
    } ]
  }, {
    "tStartMs": 395130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that you apply a potential to."
    } ]
  }, {
    "tStartMs": 396960,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And when you apply a potential,\nthere's an attractive force"
    } ]
  }, {
    "tStartMs": 400050,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "between those two electrodes."
    } ]
  }, {
    "tStartMs": 401820,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I apply an electrostatic force\nby applying a voltage here"
    } ]
  }, {
    "tStartMs": 405390,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "at this you can see the cylinder here."
    } ]
  }, {
    "tStartMs": 409200,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "There's this cylinder and\nthere's inside of this"
    } ]
  }, {
    "tStartMs": 411390,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "there's another cylinder,\nand they're close together."
    } ]
  }, {
    "tStartMs": 413730,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So you have this concentric\ncylinder like this."
    } ]
  }, {
    "tStartMs": 416160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And when you apply a voltage,"
    } ]
  }, {
    "tStartMs": 417300,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "it pulls that moving\ncylinder down in there."
    } ]
  }, {
    "tStartMs": 421260,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And by measuring the\nproperties of the capacitor"
    } ]
  }, {
    "tStartMs": 425340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and measuring the voltage that we apply,"
    } ]
  }, {
    "tStartMs": 427380,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "we can know exactly how\nmuch force we get here."
    } ]
  }, {
    "tStartMs": 430710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And then up here, we drop our mass on."
    } ]
  }, {
    "tStartMs": 433290,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So we compare our gravitational\nforce from the mass"
    } ]
  }, {
    "tStartMs": 436500,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to the electrostatic\nforce from our capacitor."
    } ]
  }, {
    "tStartMs": 439620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "To get the best accuracy,"
    } ]
  }, {
    "tStartMs": 441450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "this lab is located deep underground"
    } ]
  }, {
    "tStartMs": 444330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and they keep the air temperature"
    } ]
  }, {
    "tStartMs": 445740,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "a constant 20 degrees Celsius to avoid"
    } ]
  }, {
    "tStartMs": 448530,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "any thermal expansion or\ncontraction of the devices."
    } ]
  }, {
    "tStartMs": 452670,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And all measurements in this\nbalance are made in a vacuum."
    } ]
  }, {
    "tStartMs": 455850,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So there are no air currents\nand no buoyant force"
    } ]
  }, {
    "tStartMs": 458550,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "on the object from the atmosphere."
    } ]
  }, {
    "tStartMs": 460590,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "They've even carefully\nmeasured the acceleration"
    } ]
  }, {
    "tStartMs": 462930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "due to gravity in the lab."
    } ]
  }, {
    "tStartMs": 464820,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Here it is, it's under the chair."
    } ]
  }, {
    "tStartMs": 467250,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Right there, that triangle,"
    } ]
  }, {
    "tStartMs": 468660,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "that is where the USGS\nmeasured absolute gravity"
    } ]
  }, {
    "tStartMs": 472770,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "with an absolute perimeter\n9.801-ish meters per second."
    } ]
  }, {
    "tStartMs": 477540,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Does this lab measure small forces"
    } ]
  }, {
    "tStartMs": 480630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "the most accurately in the world?"
    } ]
  }, {
    "tStartMs": 482700,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "At the milligram level, so 10\nmicro newtons-ish of force."
    } ]
  }, {
    "tStartMs": 487170,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Yes, this measures force the\nmost accurately in the world."
    } ]
  }, {
    "tStartMs": 490800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I'm confident in saying that,"
    } ]
  }, {
    "tStartMs": 492660,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but of course, you can go lower than that."
    } ]
  }, {
    "tStartMs": 495780,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "This is the smallest weight\nand you can't see it here."
    } ]
  }, {
    "tStartMs": 499530,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "This is 10 micrograms."
    } ]
  }, {
    "tStartMs": 500910,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So when you think about the\nuncertainty in a kilogram,"
    } ]
  }, {
    "tStartMs": 503940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "when you take Planck's\nconstant at a Kibble balance"
    } ]
  }, {
    "tStartMs": 506220,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and you realize the kilogram,"
    } ]
  }, {
    "tStartMs": 508380,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "you're at that level\nof about 10 micrograms."
    } ]
  }, {
    "tStartMs": 511470,
    "dDurationMs": 3117,
    "segs": [ {
      "utf8": "And that is what 10\nmicrograms, I mean you can't,"
    } ]
  }, {
    "tStartMs": 514587,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "I had to put the little\narrow here so you can."
    } ]
  }, {
    "tStartMs": 517800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "If you were here in the laboratory"
    } ]
  }, {
    "tStartMs": 519300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you could look and peer down there maybe."
    } ]
  }, {
    "tStartMs": 521550,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I feel like I need to to get video of this"
    } ]
  }, {
    "tStartMs": 524730,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "so people can see what 10 micrograms."
    } ]
  }, {
    "tStartMs": 527775,
    "dDurationMs": 1788,
    "segs": [ {
      "utf8": "[Dr. Shaw] I don't know how."
    } ]
  }, {
    "tStartMs": 530490,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It kinda looks like a hair, like a tiny,"
    } ]
  }, {
    "tStartMs": 532440,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "like a smaller than an eyelash, right?"
    } ]
  }, {
    "tStartMs": 534900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "[Dr. Shaw] It is really much,"
    } ]
  }, {
    "tStartMs": 535733,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "yeah, that's about the...\nMuch thinner."
    } ]
  }, {
    "tStartMs": 536790,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "[Dr. Shaw] Yeah, that's about the scale"
    } ]
  }, {
    "tStartMs": 538260,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "you're looking at there, yeah."
    } ]
  }, {
    "tStartMs": 539550,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I'm almost certain I can\ncapture this on video."
    } ]
  }, {
    "tStartMs": 542520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "We brought a special lens with us."
    } ]
  }, {
    "tStartMs": 544600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Ooh yes."
    } ]
  }, {
    "tStartMs": 545433,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "We brought a special,"
    } ]
  }, {
    "tStartMs": 546266,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Special lens."
    } ]
  }, {
    "tStartMs": 547099,
    "dDurationMs": 971,
    "segs": [ {
      "utf8": "2024 mill macro,"
    } ]
  }, {
    "tStartMs": 548070,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "'cause I was like, we're\ngonna need it for this."
    } ]
  }, {
    "tStartMs": 551610,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "Try to find this thing."
    } ]
  }, {
    "tStartMs": 555630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Oh, I can see it."
    } ]
  }, {
    "tStartMs": 557100,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "Oh yes.\nDo you see it there?"
    } ]
  }, {
    "tStartMs": 559223,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Yeah, yeah, yeah, yeah, you got it."
    } ]
  }, {
    "tStartMs": 562380,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "You made this?"
    } ]
  }, {
    "tStartMs": 563490,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Yes, with great trouble"
    } ]
  }, {
    "tStartMs": 565710,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and then calibrated it on a balance."
    } ]
  }, {
    "tStartMs": 567840,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "It was, man, I'll tell\nyou, it was not easy."
    } ]
  }, {
    "tStartMs": 571530,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "When you have that thing,"
    } ]
  }, {
    "tStartMs": 572910,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "you can imagine what\nit's like trying to work"
    } ]
  }, {
    "tStartMs": 575130,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "with something like this, right?"
    } ]
  }, {
    "tStartMs": 576780,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And this is about as small\nas you can reasonably"
    } ]
  }, {
    "tStartMs": 579630,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "expect to make something as a test weight."
    } ]
  }, {
    "tStartMs": 583170,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And if you wanna measure\na force smaller than that,"
    } ]
  }, {
    "tStartMs": 585390,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so I have these little tiny chips here."
    } ]
  }, {
    "tStartMs": 587820,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "These are atomic force\nmicroscope cantilevers."
    } ]
  }, {
    "tStartMs": 591540,
    "dDurationMs": 2751,
    "segs": [ {
      "utf8": "There're little tiny force\nsensors on the end of these."
    } ]
  }, {
    "tStartMs": 594291,
    "dDurationMs": 3009,
    "segs": [ {
      "utf8": "There're little tiny cantilever\nbeams with a sharp tip."
    } ]
  }, {
    "tStartMs": 597300,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And you can use that sharp\ntip to press against things"
    } ]
  }, {
    "tStartMs": 601050,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and apply nanonewton to piconewton forces."
    } ]
  }, {
    "tStartMs": 604740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But I mean the tip is so small"
    } ]
  }, {
    "tStartMs": 606570,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "it's very, very difficult to see."
    } ]
  }, {
    "tStartMs": 608730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "It really requires a microscope."
    } ]
  }, {
    "tStartMs": 610500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Is it like there's a little\ndiving board on there?"
    } ]
  }, {
    "tStartMs": 612360,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Yeah, exactly."
    } ]
  }, {
    "tStartMs": 613200,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "There's a little diving\nboard, that's right."
    } ]
  }, {
    "tStartMs": 614850,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "It looks like a little diving board."
    } ]
  }, {
    "tStartMs": 616380,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's like a spring, right?"
    } ]
  }, {
    "tStartMs": 617640,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And if you push on it,"
    } ]
  }, {
    "tStartMs": 618600,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "the more it bends the larger the force."
    } ]
  }, {
    "tStartMs": 620670,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "What is the smallest force\nthat you want to measure?"
    } ]
  }, {
    "tStartMs": 623691,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Do you have a..."
    } ]
  }, {
    "tStartMs": 624524,
    "dDurationMs": 2506,
    "segs": [ {
      "utf8": "Yeah, I can show you, I can show you."
    } ]
  }, {
    "tStartMs": 627030,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This is one of the sensors we\nused to do the smallest forces"
    } ]
  }, {
    "tStartMs": 630870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that I can confidently say we've measured"
    } ]
  }, {
    "tStartMs": 633180,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that are traceable in some way"
    } ]
  }, {
    "tStartMs": 634890,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "to the International System of units."
    } ]
  }, {
    "tStartMs": 638400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And that is a femtonewtons of force"
    } ]
  }, {
    "tStartMs": 641280,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "at about a piconewton would be"
    } ]
  }, {
    "tStartMs": 643380,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "like if you're stretching\nout a DNA molecule."
    } ]
  }, {
    "tStartMs": 646050,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, if you take it a DNA molecule"
    } ]
  }, {
    "tStartMs": 648300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and stretch it out end to\nend, that's a piconewton."
    } ]
  }, {
    "tStartMs": 650610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So back to a factor of a\nthousand less than that"
    } ]
  }, {
    "tStartMs": 653490,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "was what we were measuring."
    } ]
  }, {
    "tStartMs": 654450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So, this is an example\nof one of the sensors"
    } ]
  }, {
    "tStartMs": 657000,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "we use to get to the sort\nof femtonewton level."
    } ]
  }, {
    "tStartMs": 659880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "This is a fused silica\nparallelogram flexor."
    } ]
  }, {
    "tStartMs": 662400,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "You can't see it really well."
    } ]
  }, {
    "tStartMs": 663450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So let me, I have a\nbig version right here."
    } ]
  }, {
    "tStartMs": 666930,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So what we can do is we\ncan set this vibrating"
    } ]
  }, {
    "tStartMs": 669870,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and it'll vibrate with really pure tone."
    } ]
  }, {
    "tStartMs": 673530,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And we can see very, very\nsmall changes in force"
    } ]
  }, {
    "tStartMs": 676620,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "based on how far this\nvibrates up and down."
    } ]
  }, {
    "tStartMs": 680760,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I would have a little\nlaser interferometer,"
    } ]
  }, {
    "tStartMs": 683190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "which measures the motion of this."
    } ]
  }, {
    "tStartMs": 685440,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So we measure the\ndisplacement of this end here"
    } ]
  }, {
    "tStartMs": 687750,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and then right next to it we would have"
    } ]
  }, {
    "tStartMs": 689250,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "a little tiny optical fiber"
    } ]
  }, {
    "tStartMs": 691020,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "that would deliver a known\noptic laser power to this."
    } ]
  }, {
    "tStartMs": 694680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So this would be a photon pressure force,"
    } ]
  }, {
    "tStartMs": 696900,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "whereby reflecting the\nlight off the surface here"
    } ]
  }, {
    "tStartMs": 700320,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "we actually get a very small force."
    } ]
  }, {
    "tStartMs": 702390,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "If we vary that force sinusoidally, we vary it in time,"
    } ]
  }, {
    "tStartMs": 706650,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "we can get this to move up and down"
    } ]
  }, {
    "tStartMs": 708720,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and we can get it to vibrate."
    } ]
  }, {
    "tStartMs": 710070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And we can see differences as small"
    } ]
  }, {
    "tStartMs": 712230,
    "dDurationMs": 3612,
    "segs": [ {
      "utf8": "as femtonewtons in our force."
    } ]
  }, {
    "tStartMs": 715842,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "So you're saying you\ncould measure the force"
    } ]
  }, {
    "tStartMs": 717720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "from a laser pointer?"
    } ]
  }, {
    "tStartMs": 719820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Yeah, oh yeah, yeah, definitely."
    } ]
  }, {
    "tStartMs": 721680,
    "dDurationMs": 1048,
    "segs": [ {
      "utf8": "Yeah, we've done that."
    } ]
  }, {
    "tStartMs": 722728,
    "dDurationMs": 1059,
    "segs": [ {
      "utf8": "My pointer was shining on that."
    } ]
  }, {
    "tStartMs": 723787,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "That's right, that about approximately"
    } ]
  }, {
    "tStartMs": 726690,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "seven piconewtons of force."
    } ]
  }, {
    "tStartMs": 728760,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And once again, that's enough\nto stretch out a DNA molecule."
    } ]
  }, {
    "tStartMs": 734010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Can I ask you the big question?"
    } ]
  }, {
    "tStartMs": 734843,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Yeah, yeah."
    } ]
  }, {
    "tStartMs": 735810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Why does anyone need to measure"
    } ]
  }, {
    "tStartMs": 737370,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "forces this small?\nYeah,"
    } ]
  }, {
    "tStartMs": 738203,
    "dDurationMs": 1747,
    "segs": [ {
      "utf8": "that's a good question."
    } ]
  }, {
    "tStartMs": 739950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So a couple of things."
    } ]
  }, {
    "tStartMs": 742200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "there are a couple of\ndifferent answers to that."
    } ]
  }, {
    "tStartMs": 744570,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "One is sort of the industrial relevance."
    } ]
  }, {
    "tStartMs": 746880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Automotive manufacturers need to measure"
    } ]
  }, {
    "tStartMs": 749880,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the mass of particulates\nthat come off their exhausts,"
    } ]
  }, {
    "tStartMs": 752670,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "particularly in diesel systems."
    } ]
  }, {
    "tStartMs": 754170,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Particulate contamination is\na really kind of a big deal."
    } ]
  }, {
    "tStartMs": 758430,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So, you need to be able to measure"
    } ]
  }, {
    "tStartMs": 760170,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "50 micrograms of these particulates"
    } ]
  }, {
    "tStartMs": 763230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for those environmental\nstandards to be met."
    } ]
  }, {
    "tStartMs": 765420,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The laser power measurements for people"
    } ]
  }, {
    "tStartMs": 767370,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "who are doing industrial\nprocesses with lasers,"
    } ]
  }, {
    "tStartMs": 769590,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "because you can actually\nuse the measurement"
    } ]
  }, {
    "tStartMs": 771690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of a small force to calibrate laser power."
    } ]
  }, {
    "tStartMs": 775050,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Pharmaceuticals, you have milligram doses"
    } ]
  }, {
    "tStartMs": 778350,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "microgram doses sometimes."
    } ]
  }, {
    "tStartMs": 780330,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The other thing that's important I think"
    } ]
  }, {
    "tStartMs": 783090,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "kind of goes to the heart of"
    } ]
  }, {
    "tStartMs": 784080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "why NIST is so cool, in my opinion."
    } ]
  }, {
    "tStartMs": 786900,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Is that it really helps us\npush the frontiers of science."
    } ]
  }, {
    "tStartMs": 790080,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The new scientific discoveries benefit"
    } ]
  }, {
    "tStartMs": 792600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "from the new measurement capabilities,"
    } ]
  }, {
    "tStartMs": 794460,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "which then feed into new\nprecision metrology capabilities."
    } ]
  }, {
    "tStartMs": 799680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And so, that is really\none of the things to me"
    } ]
  }, {
    "tStartMs": 801660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that makes NIST really special is that"
    } ]
  }, {
    "tStartMs": 803340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "we're very good at sort of\ncreating that environment"
    } ]
  }, {
    "tStartMs": 806220,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "where that can happen."
    } ]
  }, {
    "tStartMs": 807980,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(electronic music)"
    } ]
  }, {
    "tStartMs": 814800,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "If you, like me, are fascinated\nby precision measurement"
    } ]
  }, {
