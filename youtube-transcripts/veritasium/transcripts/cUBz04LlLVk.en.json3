{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Derek] This is the\nfirst in a series of videos"
    } ]
  }, {
    "tStartMs": 2280,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "about a chemical reaction\ndiscovered over 125 years ago."
    } ]
  }, {
    "tStartMs": 7050,
    "dDurationMs": 3535,
    "segs": [ {
      "utf8": "It releases a tremendous amount of heat."
    } ]
  }, {
    "tStartMs": 10585,
    "dDurationMs": 965,
    "segs": [ {
      "utf8": "Oh no, the GoPro."
    } ]
  }, {
    "tStartMs": 11550,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Liquefying metal."
    } ]
  }, {
    "tStartMs": 12700,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "It is so hot."
    } ]
  }, {
    "tStartMs": 14370,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It is not an explosive,"
    } ]
  }, {
    "tStartMs": 16770,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "but it can cause explosions."
    } ]
  }, {
    "tStartMs": 24505,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That is crazy!"
    } ]
  }, {
    "tStartMs": 25338,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "But the reactants are so inert,"
    } ]
  }, {
    "tStartMs": 28020,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "they can withstand a\nblow torch indefinitely."
    } ]
  }, {
    "tStartMs": 31110,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Do you think this whole thing's"
    } ]
  }, {
    "tStartMs": 31943,
    "dDurationMs": 1507,
    "segs": [ {
      "utf8": "going to blow up in my face?"
    } ]
  }, {
    "tStartMs": 33450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "In fact, when Hollywood directors"
    } ]
  }, {
    "tStartMs": 34980,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "wanted something that\nlooked like a nuclear bomb,"
    } ]
  }, {
    "tStartMs": 37800,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "this is the reaction they chose."
    } ]
  }, {
    "tStartMs": 40830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But in its most common use,"
    } ]
  }, {
    "tStartMs": 42510,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "one basically unchanged in over a century,"
    } ]
  }, {
    "tStartMs": 45570,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "it has helped move billions\nof people all over the world."
    } ]
  }, {
    "tStartMs": 53310,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "In the late 1800s, Karl\nand his younger brother,"
    } ]
  }, {
    "tStartMs": 55800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Hans Goldschmidt,"
    } ]
  }, {
    "tStartMs": 57300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "were preparing to join\nthe family business."
    } ]
  }, {
    "tStartMs": 59700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Their father owned a chemical factory"
    } ]
  }, {
    "tStartMs": 61800,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "making dyes for fabrics."
    } ]
  }, {
    "tStartMs": 64110,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So they studied chemistry\nunder Robert Bunsen"
    } ]
  }, {
    "tStartMs": 66630,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "of Bunsen burner fame."
    } ]
  }, {
    "tStartMs": 69480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "After their father's early death,"
    } ]
  }, {
    "tStartMs": 71280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Karl took over management of the company,"
    } ]
  }, {
    "tStartMs": 73530,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "later joined by his younger brother."
    } ]
  }, {
    "tStartMs": 77037,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "One of Hans' first major research aims"
    } ]
  }, {
    "tStartMs": 80250,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "was to find a way to produce pure metals."
    } ]
  }, {
    "tStartMs": 83850,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "These were essential for\nmaking dyes for everything"
    } ]
  }, {
    "tStartMs": 86610,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "from clothing and\ntablecloths to wallpaper."
    } ]
  }, {
    "tStartMs": 90360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "At that time, good dyes\nwere hard to come by."
    } ]
  }, {
    "tStartMs": 93450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Most were faint and\nfaded further after use."
    } ]
  }, {
    "tStartMs": 96930,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Some required the collection"
    } ]
  }, {
    "tStartMs": 98220,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "of large quantities of exotic insects."
    } ]
  }, {
    "tStartMs": 101490,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "These days, we take color for granted,"
    } ]
  }, {
    "tStartMs": 104820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "but in this drab world,\npeople would pay handsomely"
    } ]
  }, {
    "tStartMs": 108360,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "for bright color fast dyes."
    } ]
  }, {
    "tStartMs": 112950,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "One such dye was Scheele's green,"
    } ]
  }, {
    "tStartMs": 116130,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "which was chemically copper arsenite."
    } ]
  }, {
    "tStartMs": 119490,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "As its name suggests, it was toxic,"
    } ]
  }, {
    "tStartMs": 122160,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "though exactly how toxic\nis a matter of debate."
    } ]
  }, {
    "tStartMs": 126150,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Still, it became the\ndominant green dye by the end"
    } ]
  }, {
    "tStartMs": 129660,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "of the 19th century because\nits color was unbeatable."
    } ]
  }, {
    "tStartMs": 134160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The red color of the\nBritish Army officer's coats"
    } ]
  }, {
    "tStartMs": 136680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "was made from cochineal,"
    } ]
  }, {
    "tStartMs": 138180,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "a central American insect mixed with tin."
    } ]
  }, {
    "tStartMs": 141870,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The addition of tin made the\ncolor darker and more intense."
    } ]
  }, {
    "tStartMs": 145470,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "So the demand for pure metals was strong."
    } ]
  }, {
    "tStartMs": 149910,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- They had their experience\nin purifying metals"
    } ]
  }, {
    "tStartMs": 152790,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "by dissolving them in\nsolutions or in acids"
    } ]
  }, {
    "tStartMs": 154920,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "and all kinds of things."
    } ]
  }, {
    "tStartMs": 155760,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Reporter] The incoming cyanide solution"
    } ]
  }, {
    "tStartMs": 157830,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "goes on dissolving the particles\nof gold left in the sand"
    } ]
  }, {
    "tStartMs": 161160,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "after amalgamation and liquefies it."
    } ]
  }, {
    "tStartMs": 163830,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- And then work with the\nsalts, purify the salts,"
    } ]
  }, {
    "tStartMs": 166440,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and then reduce the salts\ninto the metal state."
    } ]
  }, {
    "tStartMs": 169740,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And every step that you\nwould take would then"
    } ]
  }, {
    "tStartMs": 172980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "again cause problems, right?"
    } ]
  }, {
    "tStartMs": 174600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Reducing it in a furnace,"
    } ]
  }, {
    "tStartMs": 176700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "you have to deal with all the exhaust"
    } ]
  }, {
    "tStartMs": 178530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and the contamination through the carbon."
    } ]
  }, {
    "tStartMs": 181350,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] And metals are very difficult"
    } ]
  }, {
    "tStartMs": 183000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to separate from each other."
    } ]
  }, {
    "tStartMs": 184800,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "- They basically, they form\na mixed crystal, right?"
    } ]
  }, {
    "tStartMs": 187737,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "- Like an alloy.\n- Like an alloy, right."
    } ]
  }, {
    "tStartMs": 189360,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "They all become, in a sense,"
    } ]
  }, {
    "tStartMs": 190770,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "one substance that has one melting point,"
    } ]
  }, {
    "tStartMs": 194190,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "which is why you have to\nkind of take some steps"
    } ]
  }, {
    "tStartMs": 198090,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to separate them."
    } ]
  }, {
    "tStartMs": 199350,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "- [Derek] So Hans came\nup with a novel idea."
    } ]
  }, {
    "tStartMs": 202920,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "He would react a metal\noxide like chromium oxide"
    } ]
  }, {
    "tStartMs": 207000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with aluminum metal,"
    } ]
  }, {
    "tStartMs": 209160,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and his hope was that the\noxygen would swap partners,"
    } ]
  }, {
    "tStartMs": 212670,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "forming aluminum oxide and pure chromium."
    } ]
  }, {
    "tStartMs": 218100,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "This type of reaction is now\nknown as an aluminothermic"
    } ]
  }, {
    "tStartMs": 221400,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "or thermite reaction."
    } ]
  }, {
    "tStartMs": 224640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So I have come to visit\nElectro-Thermit in Germany,"
    } ]
  }, {
    "tStartMs": 228000,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "a company that is a direct\ndescendant of Goldschmidts."
    } ]
  }, {
    "tStartMs": 232140,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I feel like they've\nset this up like a tour"
    } ]
  }, {
    "tStartMs": 234390,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of Willy Wonka's Chocolate Factory,"
    } ]
  }, {
    "tStartMs": 237150,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but instead it's a thermite factory."
    } ]
  }, {
    "tStartMs": 239940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Here we are going to try to replicate"
    } ]
  }, {
    "tStartMs": 241770,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Han's first successful reaction."
    } ]
  }, {
    "tStartMs": 243990,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "All experiments in this\nvideo were performed"
    } ]
  }, {
    "tStartMs": 246000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "under the supervision of professionals"
    } ]
  }, {
    "tStartMs": 247680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "taking proper safety precautions."
    } ]
  }, {
    "tStartMs": 250260,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- Originally, the first\nexperiment was using chrome,"
    } ]
  }, {
    "tStartMs": 253290,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but we are using copper,\nwhich is comparable."
    } ]
  }, {
    "tStartMs": 256410,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] This is like 300 grams."
    } ]
  }, {
    "tStartMs": 257850,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Axel] Yeah, 300 grams of thermite."
    } ]
  }, {
    "tStartMs": 260190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Pour it in? All right."
    } ]
  }, {
    "tStartMs": 262650,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "We pour it into the crucible and ignite."
    } ]
  }, {
    "tStartMs": 266640,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 268691,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "- Yeah.\n- That's it."
    } ]
  }, {
    "tStartMs": 269730,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Yeah.\n(shouts)"
    } ]
  }, {
    "tStartMs": 270780,
    "dDurationMs": 1313,
    "segs": [ {
      "utf8": "- Leave it, leave it, leave it."
    } ]
  }, {
    "tStartMs": 274727,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoa!"
    } ]
  }, {
    "tStartMs": 278077,
    "dDurationMs": 1913,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 279990,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "That is like fireworks.\nWell, that's impressive."
    } ]
  }, {
    "tStartMs": 284905,
    "dDurationMs": 2412,
    "segs": [ {
      "utf8": "- [Axel] But you bet he was\nsurprised when he saw that."
    } ]
  }, {
    "tStartMs": 287317,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 292980,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "Handful of aluminum powder,\nand then you get this."
    } ]
  }, {
    "tStartMs": 297660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] As you can see,"
    } ]
  }, {
    "tStartMs": 298493,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "the reaction releases a lot of energy."
    } ]
  }, {
    "tStartMs": 302460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The temperature of thermite\nreactions typically exceeds"
    } ]
  }, {
    "tStartMs": 304980,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "2,000 degrees Celsius, and\nit can be as much as 2,500."
    } ]
  }, {
    "tStartMs": 309930,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "That's because aluminum forms\nvery strong bonds with oxygen."
    } ]
  }, {
    "tStartMs": 314160,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "When those bonds form, they\nrelease a lot of energy,"
    } ]
  }, {
    "tStartMs": 317400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "way more than is required to\nbreak the copper oxide bonds"
    } ]
  }, {
    "tStartMs": 320280,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "we started with."
    } ]
  }, {
    "tStartMs": 321840,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This energy melts all the\nproducts of the reaction"
    } ]
  }, {
    "tStartMs": 324900,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "and makes them glowing hot."
    } ]
  }, {
    "tStartMs": 327810,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It is hard to express\njust how bright they are."
    } ]
  }, {
    "tStartMs": 330870,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "It feels like staring at the sun."
    } ]
  }, {
    "tStartMs": 334470,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "If you see clips in this video"
    } ]
  }, {
    "tStartMs": 335880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "where the highlights are overexposed,"
    } ]
  }, {
    "tStartMs": 337980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it's because it is so hard to judge"
    } ]
  }, {
    "tStartMs": 340170,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "how bright the reaction will be,"
    } ]
  }, {
    "tStartMs": 342240,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "and it's almost always\nbrighter than you expect."
    } ]
  }, {
    "tStartMs": 348690,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So that dropping down the bottom there,"
    } ]
  }, {
    "tStartMs": 350400,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "is that liquid copper?"
    } ]
  }, {
    "tStartMs": 351690,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Axel] That's liquid copper\nand basically the solution"
    } ]
  }, {
    "tStartMs": 353640,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that was being created."
    } ]
  }, {
    "tStartMs": 355230,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Derek] But if you get this hot mixture"
    } ]
  }, {
    "tStartMs": 357030,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of pure metal and aluminum oxide,"
    } ]
  }, {
    "tStartMs": 359580,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "how do you separate the two materials"
    } ]
  }, {
    "tStartMs": 361530,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "to isolate the pure metal?"
    } ]
  }, {
    "tStartMs": 366060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We're trying to set up an experiment"
    } ]
  }, {
    "tStartMs": 367410,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that no one has ever seen before"
    } ]
  }, {
    "tStartMs": 369060,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and it's actually going to allow us"
    } ]
  }, {
    "tStartMs": 370650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to see inside the crucible."
    } ]
  }, {
    "tStartMs": 372930,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "We cut the crucible in half\nand we're attaching two pieces"
    } ]
  }, {
    "tStartMs": 376500,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "of thermally resistant glass,\neach four millimeters thick,"
    } ]
  }, {
    "tStartMs": 379920,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "as a window into the reaction."
    } ]
  }, {
    "tStartMs": 382530,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "People said this would be impossible,"
    } ]
  }, {
    "tStartMs": 384660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that you wouldn't be able to see anything"
    } ]
  }, {
    "tStartMs": 387000,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "or that the glass would just break."
    } ]
  }, {
    "tStartMs": 388950,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- We've never done this on\ncamera and really seen it"
    } ]
  }, {
    "tStartMs": 392130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "this way, this clear."
    } ]
  }, {
    "tStartMs": 394140,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And I think it's going to be fascinating"
    } ]
  }, {
    "tStartMs": 395820,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to then start to analyze\nand make sense of this."
    } ]
  }, {
    "tStartMs": 399060,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Now this glass has\nbeen specially treated,"
    } ]
  }, {
    "tStartMs": 401340,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "so it shouldn't shatter immediately"
    } ]
  }, {
    "tStartMs": 403080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "when it comes into\ncontact with molten metal."
    } ]
  }, {
    "tStartMs": 405960,
    "dDurationMs": 2337,
    "segs": [ {
      "utf8": "Ah, that is hot. That is really hot."
    } ]
  }, {
    "tStartMs": 408297,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "But the melting temperature of silica"
    } ]
  }, {
    "tStartMs": 410160,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "is around 1,700 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 414330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which is definitely lower"
    } ]
  }, {
    "tStartMs": 416340,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "than the temperature of the reaction,"
    } ]
  }, {
    "tStartMs": 418710,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so the glass certainly will melt."
    } ]
  }, {
    "tStartMs": 421710,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The hope is it melts slowly\nenough to contain the reaction."
    } ]
  }, {
    "tStartMs": 426090,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- The glass will melt and at the end,"
    } ]
  }, {
    "tStartMs": 427620,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "we have just a very thin\nlayer of the glass at the end."
    } ]
  }, {
    "tStartMs": 434730,
    "dDurationMs": 3193,
    "segs": [ {
      "utf8": "So you will ignite it. It's up\nto you to place the igniter."
    } ]
  }, {
    "tStartMs": 437923,
    "dDurationMs": 2177,
    "segs": [ {
      "utf8": "- I think someone else should ignite it."
    } ]
  }, {
    "tStartMs": 440100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I think someone else should ignite it."
    } ]
  }, {
    "tStartMs": 441720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Christof] Why?"
    } ]
  }, {
    "tStartMs": 442553,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "- Because I don't trust myself."
    } ]
  }, {
    "tStartMs": 443550,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "We saw how incapable I\nwas of igniting yesterday."
    } ]
  }, {
    "tStartMs": 447030,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's it? (shouts)"
    } ]
  }, {
    "tStartMs": 448530,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Leave it, leave it, leave it."
    } ]
  }, {
    "tStartMs": 450090,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Derek] For this reaction,"
    } ]
  }, {
    "tStartMs": 451170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "we'll be using iron thermite,"
    } ]
  }, {
    "tStartMs": 453150,
    "dDurationMs": 4163,
    "segs": [ {
      "utf8": "so a combination of iron\noxide and aluminum metal."
    } ]
  }, {
    "tStartMs": 458555,
    "dDurationMs": 2608,
    "segs": [ {
      "utf8": "Okay, that's good. Let's do this."
    } ]
  }, {
    "tStartMs": 474233,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Holy."
    } ]
  }, {
    "tStartMs": 475800,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "Oh no, the GoPro."
    } ]
  }, {
    "tStartMs": 480030,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 482250,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh no."
    } ]
  }, {
    "tStartMs": 483990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh no."
    } ]
  }, {
    "tStartMs": 493440,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "That's the end of the GoPro."
    } ]
  }, {
    "tStartMs": 497430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The reaction starts at the igniter"
    } ]
  }, {
    "tStartMs": 499410,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "and expands outwards in all directions."
    } ]
  }, {
    "tStartMs": 503610,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "To me, it almost looks like\nants or mold or something."
    } ]
  }, {
    "tStartMs": 507480,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "It looks organic in how\nit's sort of spreading."
    } ]
  }, {
    "tStartMs": 511590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "You see a pulse. Boom, boom, boom."
    } ]
  }, {
    "tStartMs": 514800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Christof] It's living."
    } ]
  }, {
    "tStartMs": 516030,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- Yeah, that's what it looks like."
    } ]
  }, {
    "tStartMs": 524040,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Why is there pulsing?"
    } ]
  }, {
    "tStartMs": 525540,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- I don't know.\n- Okay."
    } ]
  }, {
    "tStartMs": 527340,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "- We try to understand.\n- Huh."
    } ]
  }, {
    "tStartMs": 530580,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "- We never knew that it did that."
    } ]
  }, {
    "tStartMs": 533940,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "We do this for 100 years and\nand suddenly you find out,"
    } ]
  }, {
    "tStartMs": 537739,
    "dDurationMs": 2954,
    "segs": [ {
      "utf8": "you know, every portion\nthat gets ignited does that."
    } ]
  }, {
    "tStartMs": 545100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Do you think that's gas escaping up"
    } ]
  }, {
    "tStartMs": 547140,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and that's almost what causes the pulsing?"
    } ]
  }, {
    "tStartMs": 548640,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Like some gas heats up\nand then it shoots up"
    } ]
  }, {
    "tStartMs": 551850,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and then it makes space for the next one?"
    } ]
  }, {
    "tStartMs": 554190,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "That's what you seem to see over here."
    } ]
  }, {
    "tStartMs": 556050,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Christof] Yeah."
    } ]
  }, {
    "tStartMs": 559244,
    "dDurationMs": 3916,
    "segs": [ {
      "utf8": "- Wow, that is hot. That is really hot."
    } ]
  }, {
    "tStartMs": 563160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I wanted to get a closer look,"
    } ]
  }, {
    "tStartMs": 565110,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "so I asked them to put some\nthermite on top of glass,"
    } ]
  }, {
    "tStartMs": 568140,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and then I would shoot from\nbelow using this probe lens."
    } ]
  }, {
    "tStartMs": 571830,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "- I'm ready.\n- Okay, we're rolling."
    } ]
  }, {
    "tStartMs": 581880,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It's rolling, it's rolling, it's rolling,"
    } ]
  }, {
    "tStartMs": 582960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "it's rolling, it's rolling."
    } ]
  }, {
    "tStartMs": 583793,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "There it goes, there\nit goes, there it goes,"
    } ]
  }, {
    "tStartMs": 584790,
    "dDurationMs": 1557,
    "segs": [ {
      "utf8": "there it goes, there\nit goes, there it goes."
    } ]
  }, {
    "tStartMs": 586347,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Wow! Yeah!"
    } ]
  }, {
    "tStartMs": 589887,
    "dDurationMs": 1776,
    "segs": [ {
      "utf8": "The exposure's pretty good."
    } ]
  }, {
    "tStartMs": 592560,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "Oh my goodness. Incredible."
    } ]
  }, {
    "tStartMs": 597360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "This is the closest I think anyone's"
    } ]
  }, {
    "tStartMs": 599310,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "ever filmed a thermite reaction."
    } ]
  }, {
    "tStartMs": 606180,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "You can see that the\nreaction proceeds in bursts,"
    } ]
  }, {
    "tStartMs": 609960,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "it reacts fast, but\nthen pauses for a moment"
    } ]
  }, {
    "tStartMs": 613860,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "before advancing again."
    } ]
  }, {
    "tStartMs": 629255,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "- Should I take it?"
    } ]
  }, {
    "tStartMs": 631380,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Sure."
    } ]
  }, {
    "tStartMs": 632730,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Yeah, take it, take it,\ntake it, take it, take it,"
    } ]
  }, {
    "tStartMs": 634398,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "take it, take it, take it,\ntake it, take it, take it."
    } ]
  }, {
    "tStartMs": 636960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 638340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I have two ideas about why this might be."
    } ]
  }, {
    "tStartMs": 641310,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "First, there might is a mixture of grains,"
    } ]
  }, {
    "tStartMs": 644040,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "big particles of aluminum and iron oxide,"
    } ]
  }, {
    "tStartMs": 647550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and they need to be\npresent in the right ratio"
    } ]
  }, {
    "tStartMs": 649920,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to react efficiently."
    } ]
  }, {
    "tStartMs": 651810,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Maybe a little pocket reacts\nout to where the ratio"
    } ]
  }, {
    "tStartMs": 654630,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "is slightly less ideal\nuntil the heat builds up"
    } ]
  }, {
    "tStartMs": 657720,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "enough to trigger the\nreaction in the next pocket."
    } ]
  }, {
    "tStartMs": 661110,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "My second idea is that in\nbetween the grains, there is air."
    } ]
  }, {
    "tStartMs": 665340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The reaction heats the air, which expands,"
    } ]
  }, {
    "tStartMs": 668010,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "increasing the pressure between the grains"
    } ]
  }, {
    "tStartMs": 669780,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and possibly pushing some\nof the unreactive material"
    } ]
  }, {
    "tStartMs": 672720,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "away from the reaction front."
    } ]
  }, {
    "tStartMs": 674730,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "So once that air escapes,\nthe next patch can ignite."
    } ]
  }, {
    "tStartMs": 681750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Once all the thermite has reacted,"
    } ]
  }, {
    "tStartMs": 683880,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "things get really violent."
    } ]
  }, {
    "tStartMs": 687030,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Molten metal is ejected out\nof the top of the crucible,"
    } ]
  }, {
    "tStartMs": 690000,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "and inside, the liquid is sloshing around."
    } ]
  }, {
    "tStartMs": 694950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This could be due to some\nof the materials boiling,"
    } ]
  }, {
    "tStartMs": 697860,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "actually turning from liquid into a gas."
    } ]
  }, {
    "tStartMs": 701370,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Now, I know it sounds wild to\nthink about metals boiling,"
    } ]
  }, {
    "tStartMs": 704400,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "but the boiling point of\naluminum is around 2,500 Celsius."
    } ]
  }, {
    "tStartMs": 708300,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Iron boils above 2,800 Celsius,"
    } ]
  }, {
    "tStartMs": 711120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and there are other\nelements in the mixture"
    } ]
  }, {
    "tStartMs": 713010,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "like manganese that boil\nat just 2,000 Celsius."
    } ]
  }, {
    "tStartMs": 717240,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Now, once that boiling stops,\nthe liquid settles down,"
    } ]
  }, {
    "tStartMs": 721320,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "and now comes the key\nto making pure metal."
    } ]
  }, {
    "tStartMs": 725940,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "The density of liquid iron\nis more than twice that"
    } ]
  }, {
    "tStartMs": 729270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of liquid aluminum oxide."
    } ]
  }, {
    "tStartMs": 731190,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So iron settles to the bottom"
    } ]
  }, {
    "tStartMs": 733500,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "as aluminum oxide floats to the top."
    } ]
  }, {
    "tStartMs": 738000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Now, when the metal\nmelts through the bottom"
    } ]
  }, {
    "tStartMs": 739830,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "of the crucible, the first\nliquid to pour out is iron."
    } ]
  }, {
    "tStartMs": 746760,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Only after it has drained"
    } ]
  }, {
    "tStartMs": 748620,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "does the aluminum oxide or slag follow."
    } ]
  }, {
    "tStartMs": 751950,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "You can actually see the change\nfrom iron to aluminum oxide."
    } ]
  }, {
    "tStartMs": 755670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Liquid iron has a viscosity like water,"
    } ]
  }, {
    "tStartMs": 757890,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "so you can see it coming\nout there and splashing."
    } ]
  }, {
    "tStartMs": 760920,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "And then the slag starts right there."
    } ]
  }, {
    "tStartMs": 766560,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Yeah, it comes out smooth."
    } ]
  }, {
    "tStartMs": 767700,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Christof] Really, really cool."
    } ]
  }, {
    "tStartMs": 768660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoa."
    } ]
  }, {
    "tStartMs": 770670,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Christof] And this\nis more like warm honey."
    } ]
  }, {
    "tStartMs": 772410,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- [[Derek] Yeah, you can totally see it."
    } ]
  }, {
    "tStartMs": 785220,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 787320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It definitely gives you a\nsense of being right there."
    } ]
  }, {
    "tStartMs": 789960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And you can see the flames\ncoming off the front."
    } ]
  }, {
    "tStartMs": 793230,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "And it still records."
    } ]
  }, {
    "tStartMs": 795660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Look at the bubbles on the glass."
    } ]
  }, {
    "tStartMs": 798180,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "You see those bubbles?"
    } ]
  }, {
    "tStartMs": 800670,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "And that beautiful shot\nof the iron pouring out."
    } ]
  }, {
    "tStartMs": 807390,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "I mean, this is impressive work\nfor a camera that's on fire."
    } ]
  }, {
    "tStartMs": 810780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We're going to put a cobblestone,"
    } ]
  }, {
    "tStartMs": 812460,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "normal street paver inside here."
    } ]
  }, {
    "tStartMs": 815070,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "It's made of limestone."
    } ]
  }, {
    "tStartMs": 816570,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "We'll pour the thermite\non top and then ignite it."
    } ]
  }, {
    "tStartMs": 820290,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And then we'll see that the\ncobblestone is less dense."
    } ]
  }, {
    "tStartMs": 823680,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "Then that solution, it's going\nto come up to the surface."
    } ]
  }, {
    "tStartMs": 826173,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 829860,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "- Whoa. Okay."
    } ]
  }, {
    "tStartMs": 838410,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It looks like it's breaking into pieces."
    } ]
  }, {
    "tStartMs": 842220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "That's a good bit of lava."
    } ]
  }, {
    "tStartMs": 846935,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Axel] Did you see it?"
    } ]
  }, {
    "tStartMs": 847768,
    "dDurationMs": 962,
    "segs": [ {
      "utf8": "- Oh yes."
    } ]
  }, {
    "tStartMs": 848730,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Ordinary rocks like cobblestones\nrise to the surface,"
    } ]
  }, {
    "tStartMs": 852060,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "just like the slag, as the\ndenser metal drops to the bottom."
    } ]
  }, {
    "tStartMs": 856020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And this is key to\nproducing high purity metal"
    } ]
  }, {
    "tStartMs": 858900,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "in the crucible."
    } ]
  }, {
    "tStartMs": 861030,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So Hans Goldschmidt\nhad developed a process"
    } ]
  }, {
    "tStartMs": 863580,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "to make pure metals like\nchromium, copper, and iron."
    } ]
  }, {
    "tStartMs": 867630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This could be great for\nchemistry in making dyes,"
    } ]
  }, {
    "tStartMs": 870480,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "but Hans suspected it could\nhave even broader applications."
    } ]
  }, {
    "tStartMs": 874530,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "He patented the process in 1895"
    } ]
  }, {
    "tStartMs": 876960,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and wrote it up for publication."
    } ]
  }, {
    "tStartMs": 879270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "He wrote, \"The procedure that I have here"
    } ]
  }, {
    "tStartMs": 881790,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is in its principle so\nextraordinarily simple"
    } ]
  }, {
    "tStartMs": 884910,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that I could hardly have\nundertaken the time to present,"
    } ]
  }, {
    "tStartMs": 888030,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "if not for its surprising\nand extraordinary effects.\""
    } ]
  }, {
    "tStartMs": 892650,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "Thermite was a solution\nlooking for problems."
    } ]
  }, {
    "tStartMs": 897540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "One of the first applications of thermite"
    } ]
  }, {
    "tStartMs": 899220,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "was to weld metal parts\nin remote locations."
    } ]
  }, {
    "tStartMs": 902760,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "- Wherever you need a very,\nvery strong, very reliable weld"
    } ]
  }, {
    "tStartMs": 907380,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and kind of a remote area\nwhere you don't have the luxury"
    } ]
  }, {
    "tStartMs": 910200,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of bringing, you know, tons of equipment"
    } ]
  }, {
    "tStartMs": 912390,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "and tons of welding gear,\nthat is useful for thermite."
    } ]
  }, {
    "tStartMs": 916800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "You know, some of the first customers"
    } ]
  }, {
    "tStartMs": 918000,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "were in fact shipping companies."
    } ]
  }, {
    "tStartMs": 921330,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "When some shaft would break\nin the middle of the ocean,"
    } ]
  }, {
    "tStartMs": 924690,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "at the time, you would be lost."
    } ]
  }, {
    "tStartMs": 926580,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And now having like thermite to be able"
    } ]
  }, {
    "tStartMs": 928800,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to at least fix that in some way"
    } ]
  }, {
    "tStartMs": 931530,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "that would get you home\nwas actually very useful."
    } ]
  }, {
    "tStartMs": 935070,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It was being able to fix\nsomething or to fix cracks"
    } ]
  }, {
    "tStartMs": 938160,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "in engine blocks and to\nbe super mobile with it,"
    } ]
  }, {
    "tStartMs": 942450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because you know, like we said,"
    } ]
  }, {
    "tStartMs": 944730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "it takes two guys and the bucket."
    } ]
  }, {
    "tStartMs": 948150,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Of course, in this case,"
    } ]
  }, {
    "tStartMs": 949230,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the iron thermite would\nactually not produce pure iron,"
    } ]
  }, {
    "tStartMs": 952320,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but rather steel."
    } ]
  }, {
    "tStartMs": 954150,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This was done by including\ncarbon and other alloying"
    } ]
  }, {
    "tStartMs": 957210,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "elements in the thermite powder."
    } ]
  }, {
    "tStartMs": 959340,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- Nobody needs pure iron.\nPure iron is actually useless."
    } ]
  }, {
    "tStartMs": 962250,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "It's very soft, it corrodes\nimmediately even in dry air,"
    } ]
  }, {
    "tStartMs": 967020,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and nobody will want that, right?"
    } ]
  }, {
    "tStartMs": 968910,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- You need iron with some carbon in it."
    } ]
  }, {
    "tStartMs": 970170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Exactly right."
    } ]
  }, {
    "tStartMs": 971003,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "You need iron with some\ncarbon, that makes it a steel."
    } ]
  }, {
    "tStartMs": 973410,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- So the majority of\nthermite produced today"
    } ]
  }, {
    "tStartMs": 975570,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "is steel thermite."
    } ]
  }, {
    "tStartMs": 977280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- You have this steel mill that you can,"
    } ]
  }, {
    "tStartMs": 979890,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "you know, move wherever\nyou want it to have."
    } ]
  }, {
    "tStartMs": 983850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "After the end of the Cold War,"
    } ]
  }, {
    "tStartMs": 985590,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "we would use thermite\nbasically to destroy,"
    } ]
  }, {
    "tStartMs": 988140,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "say gun barrels from tanks."
    } ]
  }, {
    "tStartMs": 991260,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Basically you have a portion of thermite"
    } ]
  }, {
    "tStartMs": 993570,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that you basically stick\ninto the gun barrel"
    } ]
  }, {
    "tStartMs": 995430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and then you would ignite it\nand then it would basically"
    } ]
  }, {
    "tStartMs": 997860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "weld the gun barrel and destroy it"
    } ]
  }, {
    "tStartMs": 999990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and it would be completely\nuseless afterwards."
    } ]
  }, {
    "tStartMs": 1001970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Those are all kinds of weapons"
    } ]
  }, {
    "tStartMs": 1003860,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or stuff that were not useful anymore"
    } ]
  }, {
    "tStartMs": 1005600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that we use thermite to destroy"
    } ]
  }, {
    "tStartMs": 1007790,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "because it's very quick\nand it's very safe."
    } ]
  }, {
    "tStartMs": 1010700,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- And it's very final.\n- And it's very final."
    } ]
  }, {
    "tStartMs": 1013370,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Once you've put that in,\nthere is absolutely no way"
    } ]
  }, {
    "tStartMs": 1016100,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "of making use of that weapon again."
    } ]
  }, {
    "tStartMs": 1018890,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- A modern application of thermite"
    } ]
  }, {
    "tStartMs": 1020450,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "is to use the heat generated\nto destroy information."
    } ]
  }, {
    "tStartMs": 1024710,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Past a certain temperature,"
    } ]
  }, {
    "tStartMs": 1025850,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "the Curie temperature,\nmagnets lose their magnetism."
    } ]
  }, {
    "tStartMs": 1030020,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So information stored\non magnetic hard drives"
    } ]
  }, {
    "tStartMs": 1032870,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "at high enough temperatures\nbecomes unrecoverable."
    } ]
  }, {
    "tStartMs": 1036470,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This looks like a very\ndifferent form of thermite."
    } ]
  }, {
    "tStartMs": 1039500,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 1040599,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "- I'm used to seeing it as a powder."
    } ]
  }, {
    "tStartMs": 1041480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Before it was also powder and we dry it."
    } ]
  }, {
    "tStartMs": 1044360,
    "dDurationMs": 2095,
    "segs": [ {
      "utf8": "- Can I pick it up or?\n- Yes."
    } ]
  }, {
    "tStartMs": 1046455,
    "dDurationMs": 3605,
    "segs": [ {
      "utf8": "- I mean, it's like a\nnormal piece of tile."
    } ]
  }, {
    "tStartMs": 1050060,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "- Yeah, lay it down.\n- Whoa."
    } ]
  }, {
    "tStartMs": 1053955,
    "dDurationMs": 3188,
    "segs": [ {
      "utf8": "(laughs)\nThat's amazing."
    } ]
  }, {
    "tStartMs": 1060170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That is cool."
    } ]
  }, {
    "tStartMs": 1062900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So if we want to make sure no one can read"
    } ]
  }, {
    "tStartMs": 1065330,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the information on this hard drive,"
    } ]
  }, {
    "tStartMs": 1067790,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I could put this on top?"
    } ]
  }, {
    "tStartMs": 1069410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1071490,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "- There you go."
    } ]
  }, {
    "tStartMs": 1072950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "When we ignite the crucible,"
    } ]
  }, {
    "tStartMs": 1074690,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "we have this high temperature\nfor a short moment."
    } ]
  }, {
    "tStartMs": 1078980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And here we have it for 10 minutes,"
    } ]
  }, {
    "tStartMs": 1080360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "so everything is destroyed."
    } ]
  }, {
    "tStartMs": 1082070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- So you're controlling the energy release"
    } ]
  }, {
    "tStartMs": 1083780,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "to make it slower here."
    } ]
  }, {
    "tStartMs": 1084860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Yes. The temperature's not so high,"
    } ]
  }, {
    "tStartMs": 1086990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and reaction is slower."
    } ]
  }, {
    "tStartMs": 1088820,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- I am going to light this thermite tile"
    } ]
  }, {
    "tStartMs": 1092210,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "in all four corners,"
    } ]
  }, {
    "tStartMs": 1093230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and it's going to generate\nheat for about 10 minutes,"
    } ]
  }, {
    "tStartMs": 1096140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and we'll see what it does to this laptop."
    } ]
  }, {
    "tStartMs": 1098450,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "All right, let's light it."
    } ]
  }, {
    "tStartMs": 1106429,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "Ooh, I like this."
    } ]
  }, {
    "tStartMs": 1109940,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "See how it's oozing? Whoa."
    } ]
  }, {
    "tStartMs": 1114830,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "It's a totally different effect."
    } ]
  }, {
    "tStartMs": 1121160,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Whoa."
    } ]
  }, {
    "tStartMs": 1122840,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Yeah, that's getting hot."
    } ]
  }, {
    "tStartMs": 1125900,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It's getting to the laptop\nnow. This is really cool."
    } ]
  }, {
    "tStartMs": 1129110,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Like you got to see the molten goo"
    } ]
  }, {
    "tStartMs": 1131420,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "coming out from underneath that laptop."
    } ]
  }, {
    "tStartMs": 1134300,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "That is wild."
    } ]
  }, {
    "tStartMs": 1140510,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "After seeing so much thermite,"
    } ]
  }, {
    "tStartMs": 1141923,
    "dDurationMs": 2907,
    "segs": [ {
      "utf8": "this is a totally different version of it."
    } ]
  }, {
    "tStartMs": 1144830,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "Look at the puddle of metal there."
    } ]
  }, {
    "tStartMs": 1146987,
    "dDurationMs": 846,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1158360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Yeah, nobody's getting\nany data off that laptop."
    } ]
  }, {
    "tStartMs": 1164360,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "That is awesome."
    } ]
  }, {
    "tStartMs": 1166580,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "I did not expect to see\nthe logo in thermite."
    } ]
  }, {
    "tStartMs": 1169730,
    "dDurationMs": 1524,
    "segs": [ {
      "utf8": "Can I lift it?\n- [Christof] Of course."
    } ]
  }, {
    "tStartMs": 1171254,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 1173990,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- I've never destroyed\ndata like this before,"
    } ]
  }, {
    "tStartMs": 1176120,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but every time I get a spam call,"
    } ]
  }, {
    "tStartMs": 1178070,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I wish I could just\nmagically make the records"
    } ]
  }, {
    "tStartMs": 1180410,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of my phone number disappear."
    } ]
  }, {
    "tStartMs": 1182030,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Fortunately, today's\nsponsor Incogni can help."
    } ]
  }, {
    "tStartMs": 1185120,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Now, I used to get\nseveral spam calls a day,"
    } ]
  }, {
    "tStartMs": 1187460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which frustrated me so\nmuch that I contemplated"
    } ]
  }, {
    "tStartMs": 1190040,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "making a video where I would just mess"
    } ]
  }, {
    "tStartMs": 1191600,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "with these spam callers to\nget a small amount of revenge."
    } ]
  }, {
    "tStartMs": 1195020,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But ever since I started\nusing Incogni back in April,"
    } ]
  }, {
    "tStartMs": 1197570,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "I no longer have to because\nthey solve this problem for me."
    } ]
  }, {
    "tStartMs": 1201257,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "You see, there are a lot\nof data brokers out there"
    } ]
  }, {
    "tStartMs": 1203480,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that collect all sorts of\ndifferent information about you,"
    } ]
  }, {
    "tStartMs": 1206030,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "like your name, phone\nnumber, email address,"
    } ]
  }, {
    "tStartMs": 1208550,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and even your social security number."
    } ]
  }, {
    "tStartMs": 1210500,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "And then they sell this\ninformation on the open market,"
    } ]
  }, {
    "tStartMs": 1213830,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "which is why you can get calls from people"
    } ]
  }, {
    "tStartMs": 1215960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "who you've never even\ngiven your number to."
    } ]
  }, {
    "tStartMs": 1218540,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "But Incogni battles these data brokers."
    } ]
  }, {
    "tStartMs": 1221360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You simply give Incogni permission"
    } ]
  }, {
    "tStartMs": 1223520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and they figure out who has your data."
    } ]
  }, {
    "tStartMs": 1226280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And then they know which laws apply,"
    } ]
  }, {
    "tStartMs": 1228710,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and so they can send the right letter"
    } ]
  }, {
    "tStartMs": 1230540,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "with the correct legal\nterms to each data broker"
    } ]
  }, {
    "tStartMs": 1233630,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "with the request to\nremove your information."
    } ]
  }, {
    "tStartMs": 1236810,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "What I love about Incogni is\nthat it's super easy to use"
    } ]
  }, {
    "tStartMs": 1239480,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and it actually works, and\nit saved me a ton of time."
    } ]
  }, {
    "tStartMs": 1242990,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "So far, they filled out\n192 requests on my behalf,"
    } ]
  }, {
    "tStartMs": 1246980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "145 of which have been completed,"
    } ]
  }, {
    "tStartMs": 1248870,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "saving me over 108 hours of work."
    } ]
  }, {
    "tStartMs": 1251570,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And it just keeps running\nin the background,"
    } ]
  }, {
    "tStartMs": 1253910,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "continuously protecting me\nagainst these data brokers."
    } ]
  }, {
    "tStartMs": 1257420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The best part is that\nsince I've signed up,"
    } ]
  }, {
    "tStartMs": 1259520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I've hardly gotten any more spam calls."
    } ]
  }, {
    "tStartMs": 1261890,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So to try Incogni and fight\nagainst the data brokers,"
    } ]
  }, {
    "tStartMs": 1264410,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "visit incogni.com/veritasium."
    } ]
  }, {
    "tStartMs": 1267020,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Click that link down in the description"
    } ]
  }, {
    "tStartMs": 1268970,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "or scan the QR code right here."
    } ]
  }, {
    "tStartMs": 1271190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And make sure to use the code veritasium"
    } ]
  }, {
    "tStartMs": 1273380,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to get 60% off the annual subscription."
    } ]
  }, {
    "tStartMs": 1276110,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Head over to incogni.com/veritasium\nto get started yourself."
    } ]
  }, {
    "tStartMs": 1280250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So I want to thank Incogni for sponsoring"
    } ]
  }, {
    "tStartMs": 1281960,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "this part of the video,\nand now back to thermite."
    } ]
  }, {
    "tStartMs": 1286460,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Now you might think, given\nthe amount of energy given off"
    } ]
  }, {
    "tStartMs": 1289310,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "that thermite could be\nused as an explosive,"
    } ]
  }, {
    "tStartMs": 1292700,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but it's actually not well\nsuited for that purpose."
    } ]
  }, {
    "tStartMs": 1295700,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- What makes thermite so\ninteresting and so important"
    } ]
  }, {
    "tStartMs": 1299570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "is that you can control it so well."
    } ]
  }, {
    "tStartMs": 1302300,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "If you have an explosion,"
    } ]
  }, {
    "tStartMs": 1303320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you can kind of calculate\nthe energy really well"
    } ]
  }, {
    "tStartMs": 1305960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and say it's, you know,\nX amount of megajoules"
    } ]
  }, {
    "tStartMs": 1308360,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "that you get out,"
    } ]
  }, {
    "tStartMs": 1309500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "but it's really hard\nto say over what time."
    } ]
  }, {
    "tStartMs": 1312710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Maybe one of the reasons\nwhy this is not explosive"
    } ]
  }, {
    "tStartMs": 1315410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "is because when you have\nexplosive reactions,"
    } ]
  }, {
    "tStartMs": 1317870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "typically your reactants are solid"
    } ]
  }, {
    "tStartMs": 1320420,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and the products are gases,\nwhich obviously expand a lot"
    } ]
  }, {
    "tStartMs": 1323810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and create a lot of pressure."
    } ]
  }, {
    "tStartMs": 1325850,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But in this case, both the reactants"
    } ]
  }, {
    "tStartMs": 1327350,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and products are solids?"
    } ]
  }, {
    "tStartMs": 1329330,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- They're solids and liquids."
    } ]
  }, {
    "tStartMs": 1330500,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Yeah, right."
    } ]
  }, {
    "tStartMs": 1331550,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "You have so much control\nover what's going on."
    } ]
  }, {
    "tStartMs": 1335240,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "- Woo. I feel like I\ngot a sunburn from that."
    } ]
  }, {
    "tStartMs": 1339410,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "This property makes it possible\nto take down structures"
    } ]
  }, {
    "tStartMs": 1341990,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "where explosives would\ncause too much damage."
    } ]
  }, {
    "tStartMs": 1346280,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "In 1933, 4 weeks after Adolf Hitler"
    } ]
  }, {
    "tStartMs": 1348860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "became the chancellor of Germany,"
    } ]
  }, {
    "tStartMs": 1350690,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the Reichstag building\nin Berlin was set on fire"
    } ]
  }, {
    "tStartMs": 1353810,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and it would only be fully\nrepaired 24 years later."
    } ]
  }, {
    "tStartMs": 1358100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "But the burnt out steel\ndome had lost its structural"
    } ]
  }, {
    "tStartMs": 1361280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "integrity and needed to be removed."
    } ]
  }, {
    "tStartMs": 1363800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Now, conventional explosives\nwould've caused irreparable"
    } ]
  }, {
    "tStartMs": 1366380,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "damage to the rest of the old building."
    } ]
  }, {
    "tStartMs": 1368660,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "So on November 22nd, 1957,\nthermite charges were strapped"
    } ]
  }, {
    "tStartMs": 1373400,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to the dome and when ignited,\nthey melted through the steel,"
    } ]
  }, {
    "tStartMs": 1376940,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "which fell neatly into the\nformer plenary hall below,"
    } ]
  }, {
    "tStartMs": 1380150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "allowing the repairs to be completed."
    } ]
  }, {
    "tStartMs": 1382610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Applications like this are possible"
    } ]
  }, {
    "tStartMs": 1384470,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "because the thermite reaction\ncan be carefully controlled."
    } ]
  }, {
    "tStartMs": 1389330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "They have the ingredients so dialed in"
    } ]
  }, {
    "tStartMs": 1391400,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that you can actually ignite\nthermite indoors without fear"
    } ]
  }, {
    "tStartMs": 1394400,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "of molten metal flying all over the place."
    } ]
  }, {
    "tStartMs": 1397910,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "This mixture includes\nsome pieces of pure steel."
    } ]
  }, {
    "tStartMs": 1401270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "They don't participate in the reaction,"
    } ]
  }, {
    "tStartMs": 1403160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but they do absorb heat as they melt."
    } ]
  }, {
    "tStartMs": 1405950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So they help control the rate of reaction"
    } ]
  }, {
    "tStartMs": 1408200,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "and the temperature reached."
    } ]
  }, {
    "tStartMs": 1410840,
    "dDurationMs": 2476,
    "segs": [ {
      "utf8": "- [Axel] There you go.\n- All right."
    } ]
  }, {
    "tStartMs": 1413316,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "- That's it."
    } ]
  }, {
    "tStartMs": 1415037,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "- That's it?\n- Yes."
    } ]
  }, {
    "tStartMs": 1415910,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "- I don't think it was in. Oh boy."
    } ]
  }, {
    "tStartMs": 1420290,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "Whoa."
    } ]
  }, {
    "tStartMs": 1424850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 1426440,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- It's interesting, like looking\nat it through dark glasses,"
    } ]
  }, {
    "tStartMs": 1428750,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "it looks like a cornbread\nmuffin or something."
    } ]
  }, {
    "tStartMs": 1433340,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "One of the really important\nparameters to control is"
    } ]
  }, {
    "tStartMs": 1436040,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "how long after the reaction\nstarts does the metal start"
    } ]
  }, {
    "tStartMs": 1438860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "flowing out the bottom of the crucible."
    } ]
  }, {
    "tStartMs": 1441560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This is known as the tap time."
    } ]
  }, {
    "tStartMs": 1444170,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It's critical because if\nthe tap time is too short,"
    } ]
  }, {
    "tStartMs": 1447020,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "the metal inside doesn't\nfully separate from the slag."
    } ]
  }, {
    "tStartMs": 1450350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But if the tap time is too long,"
    } ]
  }, {
    "tStartMs": 1452240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "then the metal dissolves\nmore silica from the walls"
    } ]
  }, {
    "tStartMs": 1454850,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of the crucible and it\nalso comes out colder"
    } ]
  }, {
    "tStartMs": 1457520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "than it could have been."
    } ]
  }, {
    "tStartMs": 1458960,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- So the chemistry of the\nsteel actually changes"
    } ]
  }, {
    "tStartMs": 1462020,
    "dDurationMs": 2175,
    "segs": [ {
      "utf8": "over the time.\n- The longer it stays"
    } ]
  }, {
    "tStartMs": 1464195,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in there.\n- Exactly."
    } ]
  }, {
    "tStartMs": 1465028,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "The log it stays in there,"
    } ]
  }, {
    "tStartMs": 1465861,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "and this is why it's very\nimportant for us to be able"
    } ]
  }, {
    "tStartMs": 1468110,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to control how long it\nactually stays there."
    } ]
  }, {
    "tStartMs": 1470600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- You want the tap time to\nbe somewhere in the middle,"
    } ]
  }, {
    "tStartMs": 1473240,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "just right."
    } ]
  }, {
    "tStartMs": 1476270,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "We've set up this experiment here to test."
    } ]
  }, {
    "tStartMs": 1479420,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Can we control the time\nwhen the steel comes out?"
    } ]
  }, {
    "tStartMs": 1483110,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So the idea is it should\ncome out of this one first,"
    } ]
  }, {
    "tStartMs": 1485630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "then this one, then that one."
    } ]
  }, {
    "tStartMs": 1487640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "We're going to ignite\nall three simultaneously"
    } ]
  }, {
    "tStartMs": 1490280,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "and see what happens."
    } ]
  }, {
    "tStartMs": 1491390,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "- You good? 3, 2, 1."
    } ]
  }, {
    "tStartMs": 1497120,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1499430,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "They all ignited at almost\nexactly the same time,"
    } ]
  }, {
    "tStartMs": 1505640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but the top time of the first crucible,"
    } ]
  }, {
    "tStartMs": 1507260,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "we got one,"
    } ]
  }, {
    "tStartMs": 1508100,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "was by far the shortest."
    } ]
  }, {
    "tStartMs": 1518549,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Two."
    } ]
  }, {
    "tStartMs": 1527273,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "It'd be amazing if this one stops"
    } ]
  }, {
    "tStartMs": 1528920,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "and the third one goes,"
    } ]
  }, {
    "tStartMs": 1531021,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "like that would be very, very impressive."
    } ]
  }, {
    "tStartMs": 1534260,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "Come on, third one. Wow."
    } ]
  }, {
    "tStartMs": 1537890,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "That's great. That's fantastic."
    } ]
  }, {
    "tStartMs": 1542420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Another attribute that can be controlled"
    } ]
  }, {
    "tStartMs": 1544040,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "is the temperature of the metal."
    } ]
  }, {
    "tStartMs": 1545990,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Here we have two different versions."
    } ]
  }, {
    "tStartMs": 1547760,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So we have a version with 12% damping,"
    } ]
  }, {
    "tStartMs": 1550790,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and here we have with 25."
    } ]
  }, {
    "tStartMs": 1552920,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Sometimes you want the metal to come out"
    } ]
  }, {
    "tStartMs": 1554690,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "a little hotter or a little colder."
    } ]
  }, {
    "tStartMs": 1557540,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "There we go. Nicely controlled ignition."
    } ]
  }, {
    "tStartMs": 1563900,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Well, that one goes a lot more. Wow."
    } ]
  }, {
    "tStartMs": 1567560,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "You could see the 12% one went first."
    } ]
  }, {
    "tStartMs": 1571070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Whoa!"
    } ]
  }, {
    "tStartMs": 1575480,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "You can see that, you know,\nthis one starts first,"
    } ]
  }, {
    "tStartMs": 1579170,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "so you can get a bit of a sense,"
    } ]
  }, {
    "tStartMs": 1580460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but I feel like both\nof them reached 2,000."
    } ]
  }, {
    "tStartMs": 1582740,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I don't know."
    } ]
  }, {
    "tStartMs": 1584150,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- The one on the right side"
    } ]
  }, {
    "tStartMs": 1585530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "is one of the less dampened portions,"
    } ]
  }, {
    "tStartMs": 1587840,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and the other one is one\nof the more dampened ones."
    } ]
  }, {
    "tStartMs": 1591500,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "We could dramatically\nchange the temperatures"
    } ]
  }, {
    "tStartMs": 1593960,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "in both directions,"
    } ]
  }, {
    "tStartMs": 1595100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "a little bit higher and\nsignificantly lower."
    } ]
  }, {
    "tStartMs": 1599120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Derek] All of this control is achieved"
    } ]
  }, {
    "tStartMs": 1600860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "by carefully adjusting\nthe thermite mixture."
    } ]
  }, {
    "tStartMs": 1603890,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "- This is the starting point\nof the making of thermite."
    } ]
  }, {
    "tStartMs": 1607790,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "About once or twice a day a truck comes"
    } ]
  }, {
    "tStartMs": 1611240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and drops in this."
    } ]
  }, {
    "tStartMs": 1612680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "This is mill scale."
    } ]
  }, {
    "tStartMs": 1613880,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "So this is basically a mixture\nof different iron oxides."
    } ]
  }, {
    "tStartMs": 1618290,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "When you hot roll steel,\nthe surface of the steel"
    } ]
  }, {
    "tStartMs": 1621560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "is very reactive because it's so hot"
    } ]
  }, {
    "tStartMs": 1623990,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and there is so much water\ninvolved to cool the rollers,"
    } ]
  }, {
    "tStartMs": 1627440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "so that the surface actually\noxidizes very quickly"
    } ]
  }, {
    "tStartMs": 1631040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and creates this mill scale."
    } ]
  }, {
    "tStartMs": 1632840,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And then they use like water jets"
    } ]
  }, {
    "tStartMs": 1634970,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to blow it off the steel surface."
    } ]
  }, {
    "tStartMs": 1637310,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "And for the rolling mill,"
    } ]
  }, {
    "tStartMs": 1638360,
    "dDurationMs": 1997,
    "segs": [ {
      "utf8": "this is just a waste product, right?"
    } ]
  }, {
    "tStartMs": 1645460,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- [Derek] Whoa.\n- [Axel] There you go."
    } ]
  }, {
    "tStartMs": 1646910,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "- That is cool."
    } ]
  }, {
    "tStartMs": 1649730,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "- The mill scale from\noutside comes in here"
    } ]
  }, {
    "tStartMs": 1653180,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "and then gets dried\nbecause thermite and water,"
    } ]
  }, {
    "tStartMs": 1658070,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "they're not exactly friends"
    } ]
  }, {
    "tStartMs": 1659510,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and you want the mill scale\nto be as dry as possible"
    } ]
  }, {
    "tStartMs": 1663560,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and then stay dry, so\nthis is how we dry it."
    } ]
  }, {
    "tStartMs": 1668870,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The iron oxide is\nshaken up the spiral ramp"
    } ]
  }, {
    "tStartMs": 1671330,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to the top floor, and there,"
    } ]
  }, {
    "tStartMs": 1673100,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the particles are separated\ninto different sizes"
    } ]
  }, {
    "tStartMs": 1675650,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "and compositions before being\nmixed with aluminum powder."
    } ]
  }, {
    "tStartMs": 1679880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "This also has to be very dry, I imagine."
    } ]
  }, {
    "tStartMs": 1681830,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- It's not as much a problem here"
    } ]
  }, {
    "tStartMs": 1683960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "because the way that\nit's being manufactured"
    } ]
  }, {
    "tStartMs": 1686390,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "doesn't contain any water."
    } ]
  }, {
    "tStartMs": 1687980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "With the iron oxide,\nit's getting blown off"
    } ]
  }, {
    "tStartMs": 1690200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "with the water jets."
    } ]
  }, {
    "tStartMs": 1691400,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "We have to control all the\nelements, the reactive elements,"
    } ]
  }, {
    "tStartMs": 1694490,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "which is the iron oxide and\nthe aluminum to make sure"
    } ]
  }, {
    "tStartMs": 1697880,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "that every portion has their\nvery defined reactivity."
    } ]
  }, {
    "tStartMs": 1701690,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And then we get the reaction that we want"
    } ]
  }, {
    "tStartMs": 1703820,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and also the chemical qualities\nin the steel that we want."
    } ]
  }, {
    "tStartMs": 1708830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- You guys use this word portion."
    } ]
  }, {
    "tStartMs": 1710750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Portion, yeah. That's\nthe word that we use."
    } ]
  }, {
    "tStartMs": 1712640,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "A portion is basically\none bag of thermite."
    } ]
  }, {
    "tStartMs": 1717590,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- No cameras."
    } ]
  }, {
    "tStartMs": 1718460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- [Cameraman] Always\nbreaking the rules, this guy."
    } ]
  }, {
    "tStartMs": 1721100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Derek] So the portions\nare bagged up individually"
    } ]
  }, {
    "tStartMs": 1723290,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and stored in the warehouse."
    } ]
  }, {
    "tStartMs": 1727160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- This is our warehouse, but\nthis is only one of them."
    } ]
  }, {
    "tStartMs": 1729770,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "And this is not even the biggest."
    } ]
  }, {
    "tStartMs": 1734420,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- Can I ask you one question here?"
    } ]
  }, {
    "tStartMs": 1737000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Okay, yesterday we saw"
    } ]
  }, {
    "tStartMs": 1738590,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "there's a tremendous amount\nof energy in thermite"
    } ]
  }, {
    "tStartMs": 1743090,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and in this warehouse,"
    } ]
  }, {
    "tStartMs": 1745310,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "there's a tremendous amount of thermite."
    } ]
  }, {
    "tStartMs": 1747110,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "So the question for you is,\nis this in any way dangerous?"
    } ]
  }, {
    "tStartMs": 1751730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- It's a fair question."
    } ]
  }, {
    "tStartMs": 1753500,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "It's a fair question."
    } ]
  }, {
    "tStartMs": 1758210,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- They set up this\ndemonstration for me to see"
    } ]
  }, {
    "tStartMs": 1760220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "how safe thermite is to handle."
    } ]
  }, {
    "tStartMs": 1762350,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "They want me to try to ignite\nthis full crucible of thermite"
    } ]
  }, {
    "tStartMs": 1765830,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "with increasing sized ignition sources."
    } ]
  }, {
    "tStartMs": 1770210,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "But I wasn't entirely\nconfident this was a good idea."
    } ]
  }, {
    "tStartMs": 1773780,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Maybe you can help me ignite it."
    } ]
  }, {
    "tStartMs": 1777740,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Where's Christof?"
    } ]
  }, {
    "tStartMs": 1778820,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Have you tried this by the way?"
    } ]
  }, {
    "tStartMs": 1781040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Christof] No."
    } ]
  }, {
    "tStartMs": 1783827,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "- Well then, under these circumstances,"
    } ]
  }, {
    "tStartMs": 1785930,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "I would get you some safety gear."
    } ]
  }, {
    "tStartMs": 1788960,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- [Christof] I'm 95% sure\nthat you cannot ignite it."
    } ]
  }, {
    "tStartMs": 1792260,
    "dDurationMs": 1628,
    "segs": [ {
      "utf8": "- 95?\n- There you go."
    } ]
  }, {
    "tStartMs": 1793888,
    "dDurationMs": 972,
    "segs": [ {
      "utf8": "That's safety gear.\n- That's a one in 20."
    } ]
  }, {
    "tStartMs": 1794860,
    "dDurationMs": 1693,
    "segs": [ {
      "utf8": "Is that how we're doing it?"
    } ]
  }, {
    "tStartMs": 1798350,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "This is a fireproof suit."
    } ]
  }, {
    "tStartMs": 1805520,
    "dDurationMs": 3463,
    "segs": [ {
      "utf8": "- At least there will be footage\nhow it happened. (laughs)"
    } ]
  }, {
    "tStartMs": 1810440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- So first, here's a little lighter."
    } ]
  }, {
    "tStartMs": 1812840,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "All right, let's give it a shot."
    } ]
  }, {
    "tStartMs": 1814250,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "See if I can get this to ignite."
    } ]
  }, {
    "tStartMs": 1815600,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 1821300,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "I'm making some of the thermite\nparticles here quite hot"
    } ]
  }, {
    "tStartMs": 1824930,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "so that they are actually glowing orange."
    } ]
  }, {
    "tStartMs": 1828560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Oh, oh, oh. It's getting quite bright."
    } ]
  }, {
    "tStartMs": 1830840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Are you getting worried watching that?"
    } ]
  }, {
    "tStartMs": 1832280,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- No, not getting worried."
    } ]
  }, {
    "tStartMs": 1833240,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- I heard you make a noise"
    } ]
  }, {
    "tStartMs": 1834260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and I was like, \"No, he's getting worried."
    } ]
  }, {
    "tStartMs": 1836300,
    "dDurationMs": 1917,
    "segs": [ {
      "utf8": "I shouldn't keep it on the same spot.\""
    } ]
  }, {
    "tStartMs": 1839240,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "Do you think this whole thing's\ngoing to blow up on my face?"
    } ]
  }, {
    "tStartMs": 1841461,
    "dDurationMs": 1679,
    "segs": [ {
      "utf8": "- [Axel] No, I hope not."
    } ]
  }, {
    "tStartMs": 1843140,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So you can see like even getting it-"
    } ]
  }, {
    "tStartMs": 1845870,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "- [Axel] Glowing hot.\n- Glowing hot,"
    } ]
  }, {
    "tStartMs": 1847810,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "it still won't ignite."
    } ]
  }, {
    "tStartMs": 1850340,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "All right, let's pull out a bigger torch."
    } ]
  }, {
    "tStartMs": 1854330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I'm going to try with this one."
    } ]
  }, {
    "tStartMs": 1856070,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "Got a nice big blue flame there."
    } ]
  }, {
    "tStartMs": 1859550,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I feel like this is not as\nhot as the other lighter,"
    } ]
  }, {
    "tStartMs": 1862730,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "so I'm getting a little\nbit of orange there,"
    } ]
  }, {
    "tStartMs": 1867380,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "but just barely."
    } ]
  }, {
    "tStartMs": 1871130,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "We're going to have to\nbring out the big guns."
    } ]
  }, {
    "tStartMs": 1874340,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "All right, let's torch\nit in three, two, one."
    } ]
  }, {
    "tStartMs": 1883664,
    "dDurationMs": 1679,
    "segs": [ {
      "utf8": "Do you think we can build up enough heat?"
    } ]
  }, {
    "tStartMs": 1886670,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "How hot?"
    } ]
  }, {
    "tStartMs": 1888345,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "- [Axel] 500."
    } ]
  }, {
    "tStartMs": 1890480,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- Did you say 500?\n- [Axel] Yeah."
    } ]
  }, {
    "tStartMs": 1893240,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- I can see a lot of\nthermite glowing orange."
    } ]
  }, {
    "tStartMs": 1896390,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "There's some pieces coming out."
    } ]
  }, {
    "tStartMs": 1901580,
    "dDurationMs": 2247,
    "segs": [ {
      "utf8": "- Nice and glowing.\n- [Christof] 700."
    } ]
  }, {
    "tStartMs": 1903827,
    "dDurationMs": 996,
    "segs": [ {
      "utf8": "- 700 degrees."
    } ]
  }, {
    "tStartMs": 1908870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I think this is an excellent demonstration"
    } ]
  }, {
    "tStartMs": 1910790,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "that thermite is not going to ignite"
    } ]
  }, {
    "tStartMs": 1915110,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "under normal conditions."
    } ]
  }, {
    "tStartMs": 1919400,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 1920630,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Axel] There you go. It's still glowing."
    } ]
  }, {
    "tStartMs": 1921680,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Derek] Did it melt?"
    } ]
  }, {
    "tStartMs": 1923210,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Axel] Yeah, that can happen."
    } ]
  }, {
    "tStartMs": 1924530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- It can melt and not-"
    } ]
  }, {
    "tStartMs": 1926600,
    "dDurationMs": 2143,
    "segs": [ {
      "utf8": "- Not ignite.\n- Not ignite."
    } ]
  }, {
    "tStartMs": 1928743,
    "dDurationMs": 1517,
    "segs": [ {
      "utf8": "What the."
    } ]
  }, {
    "tStartMs": 1930260,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "That is absolutely nuts."
    } ]
  }, {
    "tStartMs": 1933260,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- Obviously, there is a lot\nof potential energy here,"
    } ]
  }, {
    "tStartMs": 1936620,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but getting that energy is\nreally, really difficult."
    } ]
  }, {
    "tStartMs": 1939470,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So if it would catch a fire\nand, you know, whatever,"
    } ]
  }, {
    "tStartMs": 1942290,
    "dDurationMs": 1822,
    "segs": [ {
      "utf8": "the wooden pallets would burn,"
    } ]
  }, {
    "tStartMs": 1944112,
    "dDurationMs": 1488,
    "segs": [ {
      "utf8": "you would not be able\nto ignite the thermite."
    } ]
  }, {
    "tStartMs": 1945600,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "- Would not even."
    } ]
  }, {
    "tStartMs": 1947060,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "- No, it would just sit there\nand it would just ignore you."
    } ]
  }, {
    "tStartMs": 1951950,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "- The key to this lack of\nreactivity is the aluminum powder."
    } ]
  }, {
    "tStartMs": 1956840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- The aluminum is quite stable because"
    } ]
  }, {
    "tStartMs": 1959480,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "it's covered in aluminum oxide,"
    } ]
  }, {
    "tStartMs": 1962390,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and only if it gets so violently heated"
    } ]
  }, {
    "tStartMs": 1965960,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "that that layer breaks down in\na large number of particles,"
    } ]
  }, {
    "tStartMs": 1969740,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "then the reaction can start."
    } ]
  }, {
    "tStartMs": 1971630,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- So the aluminum oxide\nis like the secret stopper"
    } ]
  }, {
    "tStartMs": 1975050,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of thermite?\n- [Axel] Exactly."
    } ]
  }, {
    "tStartMs": 1976340,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- The seal."
    } ]
  }, {
    "tStartMs": 1981320,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This reaction has a very\nhigh activation energy,"
    } ]
  }, {
    "tStartMs": 1984350,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "so it can't be started by a\nlighter or a propane torch."
    } ]
  }, {
    "tStartMs": 1989300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 1990620,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "This is why we've been using\nbarium hydroxide igniters."
    } ]
  }, {
    "tStartMs": 1993950,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Basically, the same stuff\nthat's in sparklers."
    } ]
  }, {
    "tStartMs": 1996440,
    "dDurationMs": 1223,
    "segs": [ {
      "utf8": "- [Christof] Happy New Year."
    } ]
  }, {
    "tStartMs": 1999950,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- It gets hot enough to break"
    } ]
  }, {
    "tStartMs": 2001150,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "through the aluminum oxide\nlayer and start the reaction."
    } ]
  }, {
    "tStartMs": 2005410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- We want to make sure that\nthe ignition temperature"
    } ]
  }, {
    "tStartMs": 2007510,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "is so high that it can\nonly light it deliberately."
    } ]
  }, {
    "tStartMs": 2011800,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Because once it's going."
    } ]
  }, {
    "tStartMs": 2016030,
    "dDurationMs": 4743,
    "segs": [ {
      "utf8": "- [Derek] I am going to push\nthe button in three, two."
    } ]
  }, {
    "tStartMs": 2022330,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "- There is no way of stopping it."
    } ]
  }, {
    "tStartMs": 2025165,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(thermite explodes)"
    } ]
  }, {
    "tStartMs": 2031360,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "- That is crazy."
    } ]
  }, {
    "tStartMs": 2034420,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I was filming in Germany\nfor a full five days,"
    } ]
  }, {
    "tStartMs": 2037180,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "so this is just a taste of what's to come."
    } ]
  }, {
    "tStartMs": 2040090,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "We'll find out how thermite\nreacts with its environment"
    } ]
  }, {
    "tStartMs": 2043630,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and we'll have a dedicated video"
    } ]
  }, {
    "tStartMs": 2045520,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "on the most common\napplication of thermite,"
    } ]
  }, {
    "tStartMs": 2050170,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "welding railroad tracks together."
    } ]
  }, {
    "tStartMs": 2052990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "There probably will be millions of people"
    } ]
  }, {
    "tStartMs": 2055030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "watching this video."
    } ]
  }, {
    "tStartMs": 2056680,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Most of them have probably\nridden on a train."
    } ]
  }, {
    "tStartMs": 2059440,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "What is the likelihood\nthat they have ridden"
    } ]
  }, {
    "tStartMs": 2061570,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "over one of your thermite welds?"
    } ]
  }, {
    "tStartMs": 2065110,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "They will."
    } ]
  }, {
    "tStartMs": 2066310,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- [Derek] 100%?\n- 100%."
    } ]
  }, {
    "tStartMs": 2069250,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Derek] So make sure you're subscribed"
    } ]
  }, {
    "tStartMs": 2070540,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "to be notified about these\nvideos when they come out."
    } ]
  } ]
}
