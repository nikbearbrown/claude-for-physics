  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Check this out"
    } ]
  }, {
    "tStartMs": 960,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I'm using this speaker to vibrate a petri dish containing silicon oil"
    } ]
  }, {
    "tStartMs": 4800,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Now if I take this toothpick and make a little droplet on the surface"
    } ]
  }, {
    "tStartMs": 9220,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "the droplet will stay there, hovering above the surface"
    } ]
  }, {
    "tStartMs": 14640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The droplet is actually bouncing"
    } ]
  }, {
    "tStartMs": 16880,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and it will keep bouncing for a very long time"
    } ]
  }, {
    "tStartMs": 19800,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Now the reason for this is a little layer of air between the droplet and the surface"
    } ]
  }, {
    "tStartMs": 24080,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "And the droplets bouncing so rapidly that that layer never shrinks to about 100 nanometers"
    } ]
  }, {
    "tStartMs": 28600,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Which is what it would take for the droplet to recombine with the oil"
    } ]
  }, {
    "tStartMs": 32040,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Now, every time the droplet lands on the surface, it creates a wave"
    } ]
  }, {
    "tStartMs": 36660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But this is a special type of wave"
    } ]
  }, {
    "tStartMs": 38900,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Driven by the vibration of the oil bath"
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It is a standing wave"
    } ]
  }, {
    "tStartMs": 43520,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Meaning that it is not traveling out"
    } ]
  }, {
    "tStartMs": 45480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It's just oscillating up and down"
    } ]
  }, {
    "tStartMs": 48240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So the droplet makes the wave"
    } ]
  }, {
    "tStartMs": 50320,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "And then it interacts with that wave on its next bounce"
    } ]
  }, {
    "tStartMs": 54100,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "If the drop lands on one side of the wave, it is pushed forwards"
    } ]
  }, {
    "tStartMs": 57840,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And as long as the bounce of the droplet remains synchronized with the wave"
    } ]
  }, {
    "tStartMs": 61240,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "It will keep landing on the front side of the wave getting pushed farther forwards"
    } ]
  }, {
    "tStartMs": 65820,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Droplets like these are known as \"Walkers\""
    } ]
  }, {
    "tStartMs": 68540,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The bouncing oil drops has been known about since the 1970s"
    } ]
  }, {
    "tStartMs": 72500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "But only recently has it been discovered that you can use these little droplets"
    } ]
  }, {
    "tStartMs": 76080,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "to replicate many of the strange phenomena of quantum mechanics"
    } ]
  }, {
    "tStartMs": 80100,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Now obviously this is not a quantum system, the droplets are about a millimeter in diameter"
    } ]
  }, {
    "tStartMs": 84840,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "But you can think of the droplets like, uh, quantum particles, say electrons"
    } ]
  }, {
    "tStartMs": 89720,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "One experiment that captures the key features of quantum mechanics is the Double-Slit Experiment"
    } ]
  }, {
    "tStartMs": 94820,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "If you send a beam of electrons at two narrow slits"
    } ]
  }, {
    "tStartMs": 98660,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Well, the electrons, rather than behaving like particles and ending up in two clumps behind the slits"
    } ]
  }, {
    "tStartMs": 103680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "They produce an interference pattern"
    } ]
  }, {
    "tStartMs": 106480,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Even when you send each electron through one at a time"
    } ]
  }, {
    "tStartMs": 111080,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "With Walking droplets, the pilot wave goes through both slits"
    } ]
  }, {
    "tStartMs": 114120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Interfering with itself, while the droplet only goes through one slit"
    } ]
  }, {
    "tStartMs": 117720,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The droplet does move in a straight line though"
    } ]
  }, {
    "tStartMs": 120480,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "It's deflected by its interaction with the wave"
    } ]
  }, {
    "tStartMs": 123260,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "The resulting distribution of where the droplets end up"
    } ]
  }, {
    "tStartMs": 126040,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Looks very similar to quantum double-slit interference patterns"
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Or take tunneling"
    } ]
  }, {
    "tStartMs": 131060,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "In quantum mechanics, it's possible for a particle to get through a barrier"
    } ]
  }, {
    "tStartMs": 134940,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that it wouldn't classically have enough energy to get over"
    } ]
  }, {
    "tStartMs": 138060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This has been demonstrated with Walkers by"
    } ]
  }, {
    "tStartMs": 140220,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "creating a shallow barrier under the surface of the oil"
    } ]
  }, {
    "tStartMs": 142880,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Usually the barrier reflects the pilot wave and its bouncing droplet"
    } ]
  }, {
    "tStartMs": 146340,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "But in rare cases, the droplet does cross the boundary"
    } ]
  }, {
    "tStartMs": 149680,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "And the probability of the droplet crossing the barrier"
    } ]
  }, {
    "tStartMs": 152820,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "Decreases exponentially with increasing width of the barrier, just as in quantum tunneling"
    } ]
  }, {
    "tStartMs": 158300,
    "dDurationMs": 6920,
    "segs": [ {
      "utf8": "Perhaps the most surprising thing about these Walkers is they exhibit quantization, just like electrons bound to atoms"
    } ]
  }, {
    "tStartMs": 165220,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Here the Walker is confined to a circular corral"
    } ]
  }, {
    "tStartMs": 167900,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The droplet seems to move around randomly as it interacts with its pilot wave"
    } ]
  }, {
    "tStartMs": 171800,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "The complex interaction between the droplet and the wave leads to chaotic motion of the droplet"
    } ]
  }, {
    "tStartMs": 177580,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But over time, a pattern builds up"
    } ]
  }, {
