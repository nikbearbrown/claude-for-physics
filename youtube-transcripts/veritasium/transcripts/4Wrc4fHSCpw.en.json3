{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 8520,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- This video was sponsored by KiwiCo."
    } ]
  }, {
    "tStartMs": 10880,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 15160,
    "dDurationMs": 4104,
    "segs": [ {
      "utf8": "On February 15th, 2013,\nover Chelyabinsk Russia,"
    } ]
  }, {
    "tStartMs": 19264,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "an asteroid heavier than the Eiffel tower"
    } ]
  }, {
    "tStartMs": 22010,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "slammed into the atmosphere."
    } ]
  }, {
    "tStartMs": 24071,
    "dDurationMs": 4849,
    "segs": [ {
      "utf8": "And then 30 kilometers above\nthe ground, it exploded."
    } ]
  }, {
    "tStartMs": 28920,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "This violent event was\nbrighter than the sun,"
    } ]
  }, {
    "tStartMs": 32320,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "but so high up that it was silent,"
    } ]
  }, {
    "tStartMs": 35062,
    "dDurationMs": 3553,
    "segs": [ {
      "utf8": "for a full 90 seconds after the blast,"
    } ]
  }, {
    "tStartMs": 38615,
    "dDurationMs": 3275,
    "segs": [ {
      "utf8": "which only made the devastation worse."
    } ]
  }, {
    "tStartMs": 41890,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "- So you see all these videos, of people,"
    } ]
  }, {
    "tStartMs": 44307,
    "dDurationMs": 1223,
    "segs": [ {
      "utf8": "\"Look, oh, what was that?\""
    } ]
  }, {
    "tStartMs": 45530,
    "dDurationMs": 2037,
    "segs": [ {
      "utf8": "They see the smoke trail in the sky,"
    } ]
  }, {
    "tStartMs": 47567,
    "dDurationMs": 1463,
    "segs": [ {
      "utf8": "\"Oh, that's amazing!\""
    } ]
  }, {
    "tStartMs": 49030,
    "dDurationMs": 1448,
    "segs": [ {
      "utf8": "And then, you know,"
    } ]
  }, {
    "tStartMs": 50478,
    "dDurationMs": 1882,
    "segs": [ {
      "utf8": "just when you think\nnothing's gonna happen,"
    } ]
  }, {
    "tStartMs": 52360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the shockwave hits and\nit blows out the windows,"
    } ]
  }, {
    "tStartMs": 54820,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "thousand people got glass\nin their face and their eyes"
    } ]
  }, {
    "tStartMs": 57850,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "because they're looking\nthrough the windows."
    } ]
  }, {
    "tStartMs": 59940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- The shockwave damaged\nthousands of buildings"
    } ]
  }, {
    "tStartMs": 63030,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "and injured 1500 people."
    } ]
  }, {
    "tStartMs": 68040,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "What makes the Chelyabinsk\nincident kind of embarrassing"
    } ]
  }, {
    "tStartMs": 70953,
    "dDurationMs": 1858,
    "segs": [ {
      "utf8": "is that the very same day,"
    } ]
  }, {
    "tStartMs": 72811,
    "dDurationMs": 3339,
    "segs": [ {
      "utf8": "scientists had predicted\nthat an asteroid would make"
    } ]
  }, {
    "tStartMs": 76150,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "a close fly-by of earth."
    } ]
  }, {
    "tStartMs": 78900,
    "dDurationMs": 1071,
    "segs": [ {
      "utf8": "And they were right."
    } ]
  }, {
    "tStartMs": 79971,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "16 hours after Chelyabinsk,\na similar sized asteroid,"
    } ]
  }, {
    "tStartMs": 83349,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "known as Duende,"
    } ]
  }, {
    "tStartMs": 84766,
    "dDurationMs": 4074,
    "segs": [ {
      "utf8": "came within 27,000 kilometers\nof earth's surface."
    } ]
  }, {
    "tStartMs": 88840,
    "dDurationMs": 3771,
    "segs": [ {
      "utf8": "That's closer than satellites\nin geosynchronous orbit."
    } ]
  }, {
    "tStartMs": 92611,
    "dDurationMs": 3669,
    "segs": [ {
      "utf8": "But while they correctly\npredicted this close approach,"
    } ]
  }, {
    "tStartMs": 96280,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "they completely missed\nthe unrelated asteroid"
    } ]
  }, {
    "tStartMs": 99290,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "that exploded over Russia."
    } ]
  }, {
    "tStartMs": 101950,
    "dDurationMs": 2376,
    "segs": [ {
      "utf8": "And the truth is, this\nhappens all the time."
    } ]
  }, {
    "tStartMs": 104326,
    "dDurationMs": 3204,
    "segs": [ {
      "utf8": "We're really not that good\nat detecting asteroids"
    } ]
  }, {
    "tStartMs": 107530,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "before they hit us."
    } ]
  }, {
    "tStartMs": 109090,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "Since 1988, over 1200\nasteroids bigger than a meter"
    } ]
  }, {
    "tStartMs": 113760,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "have collided with the\nearth, and of those,"
    } ]
  }, {
    "tStartMs": 116770,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "we detected only five before they hit,"
    } ]
  }, {
    "tStartMs": 120270,
    "dDurationMs": 2887,
    "segs": [ {
      "utf8": "never with more than a day of warning."
    } ]
  }, {
    "tStartMs": 123157,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "With all our technology\nand all the telescopes"
    } ]
  }, {
    "tStartMs": 126140,
    "dDurationMs": 2611,
    "segs": [ {
      "utf8": "across the earth, not to\nmention the ones in space,"
    } ]
  }, {
    "tStartMs": 128751,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "why do we struggle to\ndetect dangerous asteroids"
    } ]
  }, {
    "tStartMs": 132380,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "before they strike?"
    } ]
  }, {
    "tStartMs": 133733,
    "dDurationMs": 3217,
    "segs": [ {
      "utf8": "What are the chances that\na big asteroid will hit,"
    } ]
  }, {
    "tStartMs": 136950,
    "dDurationMs": 3558,
    "segs": [ {
      "utf8": "wiping out most, if not all life on earth?"
    } ]
  }, {
    "tStartMs": 140508,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And if we saw one coming,\nwhat could we do about it?"
    } ]
  }, {
    "tStartMs": 145653,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "(explosion)"
    } ]
  }, {
    "tStartMs": 155580,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Asteroids are the leftover debris"
    } ]
  }, {
    "tStartMs": 157970,
    "dDurationMs": 1993,
    "segs": [ {
      "utf8": "from when our solar system formed."
    } ]
  }, {
    "tStartMs": 161250,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "Four and a half billion years ago,"
    } ]
  }, {
    "tStartMs": 163771,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "rocks and dust clumped together\ninto molten protoplanets."
    } ]
  }, {
    "tStartMs": 169610,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "Inside, heavy elements,"
    } ]
  }, {
    "tStartMs": 171474,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "metals like iron, nickel, and\niridium, sank into the core,"
    } ]
  }, {
    "tStartMs": 176480,
    "dDurationMs": 3435,
    "segs": [ {
      "utf8": "leaving lighter silicate\nminerals on the surface."
    } ]
  }, {
    "tStartMs": 179915,
    "dDurationMs": 1727,
    "segs": [ {
      "utf8": "Some of these protoplanets"
    } ]
  }, {
    "tStartMs": 181642,
    "dDurationMs": 3449,
    "segs": [ {
      "utf8": "grew into the planets we know today."
    } ]
  }, {
    "tStartMs": 185091,
    "dDurationMs": 2975,
    "segs": [ {
      "utf8": "But many more collided with each other,"
    } ]
  }, {
    "tStartMs": 188066,
    "dDurationMs": 2357,
    "segs": [ {
      "utf8": "breaking into pieces."
    } ]
  }, {
    "tStartMs": 196890,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "These pieces continued orbiting the sun,"
    } ]
  }, {
    "tStartMs": 199840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and smashing into each\nother and breaking into"
    } ]
  }, {
    "tStartMs": 202400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "even smaller fragments."
    } ]
  }, {
    "tStartMs": 204560,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "These became the asteroids,"
    } ]
  }, {
    "tStartMs": 207540,
    "dDurationMs": 2018,
    "segs": [ {
      "utf8": "which is why some of them are rocky,"
    } ]
  }, {
    "tStartMs": 209558,
    "dDurationMs": 3592,
    "segs": [ {
      "utf8": "loose conglomerates of gravel sized rocks"
    } ]
  }, {
    "tStartMs": 213150,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "called rubble piles,"
    } ]
  }, {
    "tStartMs": 214713,
    "dDurationMs": 3355,
    "segs": [ {
      "utf8": "and others, from the\ncores of planetesimals,"
    } ]
  }, {
    "tStartMs": 218068,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "are mostly metal."
    } ]
  }, {
    "tStartMs": 221150,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "- So this is, this is an iron meteorite."
    } ]
  }, {
    "tStartMs": 224830,
    "dDurationMs": 2494,
    "segs": [ {
      "utf8": "And essentially it's the piece of a core"
    } ]
  }, {
    "tStartMs": 227324,
    "dDurationMs": 2326,
    "segs": [ {
      "utf8": "of a small planetary body,"
    } ]
  }, {
    "tStartMs": 229650,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "like basically a small planet,"
    } ]
  }, {
    "tStartMs": 231850,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "that formed four and a\nhalf billion years ago,"
    } ]
  }, {
    "tStartMs": 235037,
    "dDurationMs": 3308,
    "segs": [ {
      "utf8": "differentiated, so the\ncore material fell out,"
    } ]
  }, {
    "tStartMs": 238345,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "and then this thing was smashed apart by"
    } ]
  }, {
    "tStartMs": 241098,
    "dDurationMs": 1962,
    "segs": [ {
      "utf8": "a collision with another asteroid."
    } ]
  }, {
    "tStartMs": 243060,
    "dDurationMs": 3816,
    "segs": [ {
      "utf8": "That's the oldest thing you'll ever see."
    } ]
  }, {
    "tStartMs": 246876,
    "dDurationMs": 3274,
    "segs": [ {
      "utf8": "- Most of the asteroids have stable orbits"
    } ]
  }, {
    "tStartMs": 250150,
    "dDurationMs": 3847,
    "segs": [ {
      "utf8": "between Mars and Jupiter,\nin the main asteroid belt."
    } ]
  }, {
    "tStartMs": 253997,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "But some have made their\nway closer to earth."
    } ]
  }, {
    "tStartMs": 258063,
    "dDurationMs": 3319,
    "segs": [ {
      "utf8": "And these are known as near earth objects."
    } ]
  }, {
    "tStartMs": 261382,
    "dDurationMs": 2918,
    "segs": [ {
      "utf8": "They are of greatest interest to us"
    } ]
  }, {
    "tStartMs": 264300,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "because of the threat they pose."
    } ]
  }, {
    "tStartMs": 266480,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "In his last book,"
    } ]
  }, {
    "tStartMs": 268090,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Stephen Hawking considered\nan asteroid impact"
    } ]
  }, {
    "tStartMs": 271090,
    "dDurationMs": 3406,
    "segs": [ {
      "utf8": "to be the greatest\nthreat to life on earth."
    } ]
  }, {
    "tStartMs": 274496,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "But finding asteroids is\ndifficult for several reasons."
    } ]
  }, {
    "tStartMs": 279036,
    "dDurationMs": 3244,
    "segs": [ {
      "utf8": "Most are spotted by\nground-based telescopes."
    } ]
  }, {
    "tStartMs": 282280,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Prof. Jewitt] So\nwhat you do is you take"
    } ]
  }, {
    "tStartMs": 283630,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "a sequence of pictures,"
    } ]
  }, {
    "tStartMs": 284530,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "one, two, three, one, two, three, four,"
    } ]
  }, {
    "tStartMs": 286460,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "and you look for essentially a moving dot."
    } ]
  }, {
    "tStartMs": 289230,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "And it's moving because it's\norbiting around the sun."
    } ]
  }, {
    "tStartMs": 292160,
    "dDurationMs": 3889,
    "segs": [ {
      "utf8": "Whereas the stuff far away, the\nstars and galaxies, are not."
    } ]
  }, {
    "tStartMs": 296049,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "- But you have to look carefully."
    } ]
  }, {
    "tStartMs": 298450,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Asteroids are not very big."
    } ]
  }, {
    "tStartMs": 300810,
    "dDurationMs": 3688,
    "segs": [ {
      "utf8": "They range from meters\nup to kilometers in size."
    } ]
  }, {
    "tStartMs": 304498,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "And in the vast expanse of space,"
    } ]
  }, {
    "tStartMs": 306750,
    "dDurationMs": 2532,
    "segs": [ {
      "utf8": "rocks like that just don't stand out."
    } ]
  }, {
    "tStartMs": 309282,
    "dDurationMs": 2958,
    "segs": [ {
      "utf8": "And even the small ones can be damaging."
    } ]
  }, {
    "tStartMs": 312240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The Chelyabinsk meteor was only around"
    } ]
  }, {
    "tStartMs": 314400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "20 meters in diameter,"
    } ]
  }, {
    "tStartMs": 316260,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "roughly the width of two school buses."
    } ]
  }, {
    "tStartMs": 319600,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Plus, asteroids are rough and dark."
    } ]
  }, {
    "tStartMs": 322311,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "They only reflect around 15%\nof the light that hits them."
    } ]
  }, {
    "tStartMs": 326661,
    "dDurationMs": 2499,
    "segs": [ {
      "utf8": "So our best chance to see them"
    } ]
  }, {
    "tStartMs": 329160,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "is when they're fully\nilluminated by the sun."
    } ]
  }, {
    "tStartMs": 332230,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And that's why over 85%"
    } ]
  }, {
    "tStartMs": 334190,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "of the near earth asteroids we've detected"
    } ]
  }, {
    "tStartMs": 336760,
    "dDurationMs": 2447,
    "segs": [ {
      "utf8": "were found in the 45 degrees of sky"
    } ]
  }, {
    "tStartMs": 339207,
    "dDurationMs": 2689,
    "segs": [ {
      "utf8": "directly opposite the sun."
    } ]
  }, {
    "tStartMs": 341896,
    "dDurationMs": 2404,
    "segs": [ {
      "utf8": "This is called the opposition effect,"
    } ]
  }, {
    "tStartMs": 344300,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "and it means there are\nlikely more near earth"
    } ]
  }, {
    "tStartMs": 347430,
    "dDurationMs": 2008,
    "segs": [ {
      "utf8": "and potentially hazardous asteroids"
    } ]
  }, {
    "tStartMs": 349438,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "that haven't been detected yet."
    } ]
  }, {
    "tStartMs": 351771,
    "dDurationMs": 3549,
    "segs": [ {
      "utf8": "Any asteroid approaching\nfrom the direction of the sun"
    } ]
  }, {
    "tStartMs": 355320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "just can't be seen."
    } ]
  }, {
    "tStartMs": 358140,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "This is exactly what\nhappened with Chelyabinsk."
    } ]
  }, {
    "tStartMs": 363000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So far, we have detected and\ncataloged a million asteroids,"
    } ]
  }, {
    "tStartMs": 368060,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "the vast majority of which\nare in the main asteroid belt."
    } ]
  }, {
    "tStartMs": 372340,
    "dDurationMs": 3661,
    "segs": [ {
      "utf8": "But 24,000 are near earth objects."
    } ]
  }, {
    "tStartMs": 376001,
    "dDurationMs": 3518,
    "segs": [ {
      "utf8": "Ones that we need to keep a\nparticularly close eye on."
    } ]
  }, {
    "tStartMs": 379519,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "Because even once you've\ndetected an asteroid,"
    } ]
  }, {
    "tStartMs": 382720,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "it's hard to tell if\nit will hit the earth."
    } ]
  }, {
    "tStartMs": 385490,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- So if you just discover an object,"
    } ]
  }, {
    "tStartMs": 387370,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and you only have data from a few days,"
    } ]
  }, {
    "tStartMs": 389470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "then you can't really\ntell where it's gonna go,"
    } ]
  }, {
    "tStartMs": 391480,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "because you're tryna take\nthis little arc of motion"
    } ]
  }, {
    "tStartMs": 394340,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "and predict it far into the future, so,"
    } ]
  }, {
    "tStartMs": 396480,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "what you need is observations\nover years and years."
    } ]
  }, {
    "tStartMs": 399300,
    "dDurationMs": 3306,
    "segs": [ {
      "utf8": "But even if you have perfect\nobservations of an asteroid,"
    } ]
  }, {
    "tStartMs": 402606,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "there's kind of a fundamental limit"
    } ]
  }, {
    "tStartMs": 405040,
    "dDurationMs": 2222,
    "segs": [ {
      "utf8": "to how far in the future you can predict."
    } ]
  }, {
    "tStartMs": 407262,
    "dDurationMs": 2518,
    "segs": [ {
      "utf8": "And that's because of a couple of effects,"
    } ]
  }, {
    "tStartMs": 409780,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "but one is that, you know,"
    } ]
  }, {
    "tStartMs": 411010,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "they're not just orbiting the\nsun with no other influence."
    } ]
  }, {
    "tStartMs": 414650,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "All of the planets have gravity,"
    } ]
  }, {
    "tStartMs": 416490,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "and all of the planets are pulling on"
    } ]
  }, {
    "tStartMs": 418544,
    "dDurationMs": 4396,
    "segs": [ {
      "utf8": "near earth asteroids and can\nchange the orbit significantly."
    } ]
  }, {
    "tStartMs": 422940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So there is something\ncalled dynamical chaos,"
    } ]
  }, {
    "tStartMs": 425850,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "which basically means, after\na certain amount of time,"
    } ]
  }, {
    "tStartMs": 428590,
    "dDurationMs": 2246,
    "segs": [ {
      "utf8": "you don't know where the\nasteroid is gonna be."
    } ]
  }, {
    "tStartMs": 430836,
    "dDurationMs": 1974,
    "segs": [ {
      "utf8": "And in practice, what that means is,"
    } ]
  }, {
    "tStartMs": 432810,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "we can't do any work more\nthan 100 years in the future."
    } ]
  }, {
    "tStartMs": 437350,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "So the maximum time you can\npredict with any accuracy at all"
    } ]
  }, {
    "tStartMs": 440817,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "where a body will be is about 100 years."
    } ]
  }, {
    "tStartMs": 443673,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "- And this is pretty important,"
    } ]
  }, {
    "tStartMs": 446250,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "because we know with certainty,"
    } ]
  }, {
    "tStartMs": 448043,
    "dDurationMs": 3853,
    "segs": [ {
      "utf8": "if one does hit, the\nresults will be dramatic."
    } ]
  }, {
    "tStartMs": 451896,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 453950,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "This is Barringer crater in Arizona."
    } ]
  }, {
    "tStartMs": 456940,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It's named after a mining\nengineer, Daniel Barringer,"
    } ]
  }, {
    "tStartMs": 460210,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "who was the first to suggest"
    } ]
  }, {
    "tStartMs": 461610,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "it was formed by a meteorite impact."
    } ]
  }, {
    "tStartMs": 464640,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "The prevailing view,\neven up until the 1950s,"
    } ]
  }, {
    "tStartMs": 467149,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "was that it was created\nby volcanic activity."
    } ]
  }, {
    "tStartMs": 470271,
    "dDurationMs": 3559,
    "segs": [ {
      "utf8": "But Barringer was\nconvinced it was the site"
    } ]
  }, {
    "tStartMs": 473830,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "of an iron meteorite impact."
    } ]
  }, {
    "tStartMs": 476065,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "So in 1903, he staked a mining claim,"
    } ]
  }, {
    "tStartMs": 479860,
    "dDurationMs": 3059,
    "segs": [ {
      "utf8": "and began drilling for\nthe metallic meteorite,"
    } ]
  }, {
    "tStartMs": 482919,
    "dDurationMs": 2831,
    "segs": [ {
      "utf8": "which he believed to be worth more than"
    } ]
  }, {
    "tStartMs": 485750,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "a billion 1903 dollars."
    } ]
  }, {
    "tStartMs": 488620,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 489453,
    "dDurationMs": 1217,
    "segs": [ {
      "utf8": "So people are motivated by money, right?"
    } ]
  }, {
    "tStartMs": 490670,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So they thought,"
    } ]
  }, {
    "tStartMs": 491503,
    "dDurationMs": 1827,
    "segs": [ {
      "utf8": "\"Hey, we can get some\niron for free!\" basically."
    } ]
  }, {
    "tStartMs": 493330,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So they started to drill\nin the bottom of the crater"
    } ]
  }, {
    "tStartMs": 496360,
    "dDurationMs": 1102,
    "segs": [ {
      "utf8": "and found nothing."
    } ]
  }, {
    "tStartMs": 497462,
    "dDurationMs": 3228,
    "segs": [ {
      "utf8": "And then they started to do\nother exploratory drills."
    } ]
  }, {
    "tStartMs": 500690,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "And this went on for years and decades."
    } ]
  }, {
    "tStartMs": 503310,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "They started to drill sideways."
    } ]
  }, {
    "tStartMs": 504580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Somebody said, you know,"
    } ]
  }, {
    "tStartMs": 505413,
    "dDurationMs": 2447,
    "segs": [ {
      "utf8": "maybe it came in from\nan angle, which it did."
    } ]
  }, {
    "tStartMs": 507860,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "And maybe the iron is not under the middle"
    } ]
  }, {
    "tStartMs": 510370,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "but maybe it's over there under the wall."
    } ]
  }, {
    "tStartMs": 512340,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So he was doing drilling,"
    } ]
  }, {
    "tStartMs": 513630,
    "dDurationMs": 1963,
    "segs": [ {
      "utf8": "if you go there, you\ncan see the drills now."
    } ]
  }, {
    "tStartMs": 515593,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "He was drilling around the\nwall, he found nothing."
    } ]
  }, {
    "tStartMs": 517917,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "So what they didn't realize is,"
    } ]
  }, {
    "tStartMs": 519600,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "when you have an impact at high speed,"
    } ]
  }, {
    "tStartMs": 522130,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "it's not like you're throwing\na stone into a brick wall,"
    } ]
  }, {
    "tStartMs": 526580,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "you know, and it makes a\nhole and sticks in there."
    } ]
  }, {
    "tStartMs": 528940,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Or just bounces off."
    } ]
  }, {
    "tStartMs": 530066,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "It's explosive."
    } ]
  }, {
    "tStartMs": 531610,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "It's like totally explosive."
    } ]
  }, {
    "tStartMs": 532700,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So the kinetic energy of the projectile"
    } ]
  }, {
    "tStartMs": 534680,
    "dDurationMs": 2689,
    "segs": [ {
      "utf8": "comes in maybe 30 kilometers per second."
    } ]
  }, {
    "tStartMs": 537369,
    "dDurationMs": 2831,
    "segs": [ {
      "utf8": "The kinetic energy of the\nprojectile is big enough"
    } ]
  }, {
    "tStartMs": 540200,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "to completely vaporize the projectile."
    } ]
  }, {
    "tStartMs": 542220,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "It turns it into a gas."
    } ]
  }, {
    "tStartMs": 543690,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "And that gas is super hot\nand super high pressure,"
    } ]
  }, {
    "tStartMs": 546266,
    "dDurationMs": 2809,
    "segs": [ {
      "utf8": "and it explodes and it\nblows out the crater."
    } ]
  }, {
    "tStartMs": 549075,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "So the projectile doesn't\nreally exist after the impact."
    } ]
  }, {
    "tStartMs": 551923,
    "dDurationMs": 2374,
    "segs": [ {
      "utf8": "I mean, little pieces can survive."
    } ]
  }, {
    "tStartMs": 554297,
    "dDurationMs": 4017,
    "segs": [ {
      "utf8": "But this 50 meter body\nwas basically obliterated."
    } ]
  }, {
    "tStartMs": 558314,
    "dDurationMs": 3931,
    "segs": [ {
      "utf8": "So he was looking for\nsomething that did not exist."
    } ]
  }, {
    "tStartMs": 562245,
    "dDurationMs": 3645,
    "segs": [ {
      "utf8": "- He spent 27 years mining the crater,"
    } ]
  }, {
    "tStartMs": 565890,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "drilling down to a depth\nof over 400 meters."
    } ]
  }, {
    "tStartMs": 569600,
    "dDurationMs": 2996,
    "segs": [ {
      "utf8": "But what he was searching\nfor had vaporized on impact"
    } ]
  }, {
    "tStartMs": 572596,
    "dDurationMs": 2713,
    "segs": [ {
      "utf8": "50,000 years earlier."
    } ]
  }, {
    "tStartMs": 575309,
    "dDurationMs": 2383,
    "segs": [ {
      "utf8": "The 50 meter asteroid,"
    } ]
  }, {
    "tStartMs": 577692,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "not that much bigger than Chelyabinsk,"
    } ]
  }, {
    "tStartMs": 579972,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "released the energy equivalent\nof 10 megatons of TNT."
    } ]
  }, {
    "tStartMs": 584955,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "That's over 600 times the\nenergy of the Hiroshima bomb."
    } ]
  }, {
    "tStartMs": 589435,
    "dDurationMs": 2965,
    "segs": [ {
      "utf8": "So, the thing that most closely resembles"
    } ]
  }, {
    "tStartMs": 592400,
    "dDurationMs": 4548,
    "segs": [ {
      "utf8": "a meteorite impact is a very\nlarge nuclear explosion."
    } ]
  }, {
    "tStartMs": 596948,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "(explosion)"
    } ]
  }, {
    "tStartMs": 606565,
    "dDurationMs": 3345,
    "segs": [ {
      "utf8": "- This is the actual\nsize of the T-Rex skull."
    } ]
  }, {
    "tStartMs": 609910,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "And I thought, this is such a\ncool thing, I gotta have it."
    } ]
  }, {
    "tStartMs": 613070,
    "dDurationMs": 1693,
    "segs": [ {
      "utf8": "So, I bought the T-Rex."
    } ]
  }, {
    "tStartMs": 616300,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "The dinosaurs were wiped out by"
    } ]
  }, {
    "tStartMs": 617723,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "a 10 kilometer size asteroid,"
    } ]
  }, {
    "tStartMs": 621140,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "that hit about 65 million years ago."
    } ]
  }, {
    "tStartMs": 623640,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "So, above a critical size,"
    } ]
  }, {
    "tStartMs": 625570,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "which is probably a couple of kilometers,"
    } ]
  }, {
    "tStartMs": 628415,
    "dDurationMs": 3374,
    "segs": [ {
      "utf8": "an impacter delivers so much energy"
    } ]
  }, {
    "tStartMs": 631789,
    "dDurationMs": 1895,
    "segs": [ {
      "utf8": "that it has a global effect."
    } ]
  }, {
    "tStartMs": 633684,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "(explosion)"
    } ]
  }, {
    "tStartMs": 639090,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "So essentially, it launches\na whole bunch of debris"
    } ]
  }, {
    "tStartMs": 641968,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "into sub orbital trajectory."
    } ]
  }, {
    "tStartMs": 644370,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "So the ejector goes around the earth,"
    } ]
  }, {
    "tStartMs": 647110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "falls back into the earth, all over,"
    } ]
  }, {
    "tStartMs": 649450,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "even on the other side of the planet"
    } ]
  }, {
    "tStartMs": 650870,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "from where the impact occurred."
    } ]
  }, {
    "tStartMs": 653911,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "And what that means is\nthe whole sky lights up"
    } ]
  }, {
    "tStartMs": 656674,
    "dDurationMs": 2329,
    "segs": [ {
      "utf8": "with wall-to-wall meteors."
    } ]
  }, {
    "tStartMs": 660501,
    "dDurationMs": 3159,
    "segs": [ {
      "utf8": "So you can imagine the sky\nturning from, you know,"
    } ]
  }, {
    "tStartMs": 663660,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "a nice blue day like today,"
    } ]
  }, {
    "tStartMs": 665433,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "into essentially a red, hot glow,"
    } ]
  }, {
    "tStartMs": 668470,
    "dDurationMs": 1813,
    "segs": [ {
      "utf8": "like being inside a toaster oven."
    } ]
  }, {
    "tStartMs": 672705,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "So the first effect of this impact"
    } ]
  }, {
    "tStartMs": 674198,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "apart from the initial blast"
    } ]
  }, {
    "tStartMs": 676120,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "near where the actual impact occurred,"
    } ]
  }, {
    "tStartMs": 678060,
    "dDurationMs": 1728,
    "segs": [ {
      "utf8": "the first effect is the sky"
    } ]
  }, {
    "tStartMs": 679788,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "turns into a great source of heat,"
    } ]
  }, {
    "tStartMs": 682122,
    "dDurationMs": 1748,
    "segs": [ {
      "utf8": "and it cooks everything on the ground."
    } ]
  }, {
    "tStartMs": 683870,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "So these guys were basically cooked."
    } ]
  }, {
    "tStartMs": 686790,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Cooked alive."
    } ]
  }, {
    "tStartMs": 687623,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "- Cooked alive, as they\nwere walking around."
    } ]
  }, {
    "tStartMs": 690767,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "The only animals that had a chance"
    } ]
  }, {
    "tStartMs": 692490,
    "dDurationMs": 3029,
    "segs": [ {
      "utf8": "were the ones living in\ntunnels under the ground"
    } ]
  }, {
    "tStartMs": 695519,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "or maybe in the water."
    } ]
  }, {
    "tStartMs": 697583,
    "dDurationMs": 2677,
    "segs": [ {
      "utf8": "And they were able to\ncome back and take over"
    } ]
  }, {
    "tStartMs": 700260,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "without having to deal with the dinosaurs"
    } ]
  }, {
    "tStartMs": 703040,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "as a major obstacle."
    } ]
  }, {
    "tStartMs": 704850,
    "dDurationMs": 2453,
    "segs": [ {
      "utf8": "- What are our chances that earth gets hit"
    } ]
  }, {
    "tStartMs": 707303,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "by another 10 kilometer\nor bigger asteroid?"
    } ]
  }, {
    "tStartMs": 711593,
    "dDurationMs": 3817,
    "segs": [ {
      "utf8": "- In your lifetime, assuming\nyou live to be 100 years old,"
    } ]
  }, {
    "tStartMs": 715410,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "you have a 10 kilometer impacter"
    } ]
  }, {
    "tStartMs": 717170,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "like the KT extinction event"
    } ]
  }, {
    "tStartMs": 719111,
    "dDurationMs": 3639,
    "segs": [ {
      "utf8": "every hundred million years\nor something like that."
    } ]
  }, {
    "tStartMs": 722750,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So the probability of\ngetting it in one year"
    } ]
  }, {
    "tStartMs": 724940,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "is one in a hundred million."
    } ]
  }, {
    "tStartMs": 726730,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "So you have one in a million chance"
    } ]
  }, {
    "tStartMs": 728150,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "of dying from a 10 kilometer impact."
    } ]
  }, {
    "tStartMs": 730560,
    "dDurationMs": 2278,
    "segs": [ {
      "utf8": "But, because we know that there are no"
    } ]
  }, {
    "tStartMs": 732838,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "10 kilometer impacters"
    } ]
  }, {
    "tStartMs": 735442,
    "dDurationMs": 2144,
    "segs": [ {
      "utf8": "with a path that intersects the earth"
    } ]
  }, {
    "tStartMs": 737586,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "for the next hundred years,"
    } ]
  }, {
    "tStartMs": 739550,
    "dDurationMs": 2352,
    "segs": [ {
      "utf8": "your chance of dying from\nthat is actually zero."
    } ]
  }, {
    "tStartMs": 741902,
    "dDurationMs": 3248,
    "segs": [ {
      "utf8": "So work done already has\nreduced that down, you know,"
    } ]
  }, {
    "tStartMs": 745150,
    "dDurationMs": 1813,
    "segs": [ {
      "utf8": "from one in a million to nothing."
    } ]
  }, {
    "tStartMs": 747860,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "- So the good news is,"
    } ]
  }, {
    "tStartMs": 749040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "there won't be another\ndinosaur style extinction event"
    } ]
  }, {
    "tStartMs": 752160,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "in our lifetimes."
    } ]
  }, {
    "tStartMs": 753323,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "But, there are\nexponentially more asteroids"
    } ]
  }, {
    "tStartMs": 756883,
    "dDurationMs": 1498,
    "segs": [ {
      "utf8": "of smaller sizes."
    } ]
  }, {
    "tStartMs": 758381,
    "dDurationMs": 2368,
    "segs": [ {
      "utf8": "For every 10 kilometer asteroid,"
    } ]
  }, {
    "tStartMs": 760749,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "there are roughly a thousand\none kilometer asteroids,"
    } ]
  }, {
    "tStartMs": 764391,
    "dDurationMs": 4472,
    "segs": [ {
      "utf8": "and they're still capable\nof doing a lot of damage."
    } ]
  }, {
    "tStartMs": 769810,
    "dDurationMs": 1942,
    "segs": [ {
      "utf8": "- One or two kilometers"
    } ]
  }, {
    "tStartMs": 771752,
    "dDurationMs": 3788,
    "segs": [ {
      "utf8": "is capable of causing\nlocal, but massive damage."
    } ]
  }, {
    "tStartMs": 775540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So that means, you know,"
    } ]
  }, {
    "tStartMs": 776950,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "instead of wiping out the entire world,"
    } ]
  }, {
    "tStartMs": 779730,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you would wipe out the equivalent of"
    } ]
  }, {
    "tStartMs": 782100,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "some European country,\nlike France or Germany,"
    } ]
  }, {
    "tStartMs": 785780,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "to mention two of my favorites."
    } ]
  }, {
    "tStartMs": 787350,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So you would obliterate those countries"
    } ]
  }, {
    "tStartMs": 790230,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "with the impact of a one\nor two kilometer size body."
    } ]
  }, {
    "tStartMs": 793400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Do we know about all the"
    } ]
  }, {
    "tStartMs": 795260,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "one to two kilometer\nbodies that could hit us?"
    } ]
  }, {
    "tStartMs": 797870,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "- We think that we know\n90-something percent."
    } ]
  }, {
    "tStartMs": 800530,
    "dDurationMs": 4222,
    "segs": [ {
      "utf8": "Maybe 98% of those bodies\nhave been identified,"
    } ]
  }, {
    "tStartMs": 804752,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "and we have their orbits,"
    } ]
  }, {
    "tStartMs": 806710,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "and we can make reasonable predictions"
    } ]
  }, {
    "tStartMs": 808350,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "for the next 10 years of\nsomething about where there'll be."
    } ]
  }, {
    "tStartMs": 812660,
    "dDurationMs": 3173,
    "segs": [ {
      "utf8": "And we seem to be okay at\nthe moment, but you know,"
    } ]
  }, {
    "tStartMs": 816820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "what about the ones that are just"
    } ]
  }, {
    "tStartMs": 818020,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "a little bit less than a kilometer?"
    } ]
  }, {
    "tStartMs": 819774,
    "dDurationMs": 1726,
    "segs": [ {
      "utf8": "What about the ones that are 800 meters?"
    } ]
  }, {
    "tStartMs": 821500,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "That's still pretty,\npretty savage if it hits."
    } ]
  }, {
    "tStartMs": 824570,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "- And this is possibly where"
    } ]
  }, {
    "tStartMs": 826140,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the greatest threat of asteroids remains."
    } ]
  }, {
    "tStartMs": 829110,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "A few hundred meters is large enough"
    } ]
  }, {
    "tStartMs": 831290,
    "dDurationMs": 1846,
    "segs": [ {
      "utf8": "to obliterate a large city."
    } ]
  }, {
    "tStartMs": 833136,
    "dDurationMs": 4074,
    "segs": [ {
      "utf8": "But small enough that we\nhaven't detected them all yet."
    } ]
  }, {
    "tStartMs": 837210,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- We're missing a lot of\nhundred meter size projectiles."
    } ]
  }, {
    "tStartMs": 840810,
    "dDurationMs": 3276,
    "segs": [ {
      "utf8": "And those guys are big enough\nto cause substantial damage"
    } ]
  }, {
    "tStartMs": 844086,
    "dDurationMs": 2284,
    "segs": [ {
      "utf8": "on the earth, depending on where they hit."
    } ]
  }, {
    "tStartMs": 846370,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "- So it could destroy a city."
    } ]
  }, {
    "tStartMs": 847800,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "- Yeah. It would knock down\nthe buildings in the city."
    } ]
  }, {
    "tStartMs": 850090,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "It would cause city-wide fire."
    } ]
  }, {
    "tStartMs": 852510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And if it hit the ground,"
    } ]
  }, {
    "tStartMs": 854610,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "it would throw up ejecta\nthat would come back down,"
    } ]
  }, {
    "tStartMs": 858300,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "rain on the ground, it\nwould be high-speed ejecta,"
    } ]
  }, {
    "tStartMs": 860600,
    "dDurationMs": 4094,
    "segs": [ {
      "utf8": "that would obliterate a hundred\nkilometer zone around it."
    } ]
  }, {
    "tStartMs": 864694,
    "dDurationMs": 2989,
    "segs": [ {
      "utf8": "- And this could happen tomorrow?"
    } ]
  }, {
    "tStartMs": 868630,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "- Well it could, yeah."
    } ]
  }, {
    "tStartMs": 870182,
    "dDurationMs": 2528,
    "segs": [ {
      "utf8": "(chuckling nervously)"
    } ]
  }, {
    "tStartMs": 872710,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "- If we saw a big one coming,"
    } ]
  }, {
    "tStartMs": 875990,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "what's our best bet for, I mean,"
    } ]
  }, {
    "tStartMs": 877630,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "could we do anything about it?"
    } ]
  }, {
    "tStartMs": 878770,
    "dDurationMs": 1102,
    "segs": [ {
      "utf8": "What would we do about it?"
    } ]
  }, {
    "tStartMs": 879872,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Prof. Jewitt] No."
    } ]
  }, {
    "tStartMs": 880705,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "- Is there anything we\ncan do to actively ..."
    } ]
  }, {
    "tStartMs": 881872,
    "dDurationMs": 2518,
    "segs": [ {
      "utf8": "- No. There's nothing we can do."
    } ]
  }, {
    "tStartMs": 884390,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "I was on a committee that\nlooked at that, okay,"
    } ]
  }, {
    "tStartMs": 885970,
    "dDurationMs": 2231,
    "segs": [ {
      "utf8": "like 10 years ago, like, what could we do?"
    } ]
  }, {
    "tStartMs": 888201,
    "dDurationMs": 2549,
    "segs": [ {
      "utf8": "One option would be to try to bomb it."
    } ]
  }, {
    "tStartMs": 890750,
    "dDurationMs": 1548,
    "segs": [ {
      "utf8": "It's a standard thing."
    } ]
  }, {
    "tStartMs": 892298,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "We don't know how that would work out."
    } ]
  }, {
    "tStartMs": 894216,
    "dDurationMs": 1294,
    "segs": [ {
      "utf8": "Even when you got it there,"
    } ]
  }, {
    "tStartMs": 895510,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and even if you could explode it,"
    } ]
  }, {
    "tStartMs": 897310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "on the surface or in the surface,"
    } ]
  }, {
    "tStartMs": 899620,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "it's not clear what you would do,"
    } ]
  }, {
    "tStartMs": 900990,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "because typically what happens is you"
    } ]
  }, {
    "tStartMs": 902930,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "blow up a body, and\nthe fragments move out."
    } ]
  }, {
    "tStartMs": 906330,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "They expand out, but not very quickly."
    } ]
  }, {
    "tStartMs": 908171,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "And then gravity pulls\nthem back together again."
    } ]
  }, {
    "tStartMs": 910330,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "So it would reform as a rubble pile."
    } ]
  }, {
    "tStartMs": 913100,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If it was not already a\nrubble pile to begin with,"
    } ]
  }, {
    "tStartMs": 915530,
    "dDurationMs": 2308,
    "segs": [ {
      "utf8": "which it probably would be\nbecause of past impacts."
    } ]
  }, {
    "tStartMs": 917838,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "So blowing up a rubble pile"
    } ]
  }, {
    "tStartMs": 919738,
    "dDurationMs": 2349,
    "segs": [ {
      "utf8": "is something that we\ndon't really know about."
    } ]
  }, {
    "tStartMs": 922087,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Another idea is you could attach,"
    } ]
  }, {
    "tStartMs": 924130,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "you could be all gentle,"
    } ]
  }, {
    "tStartMs": 924980,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "and attach a rocket to the asteroid,"
    } ]
  }, {
    "tStartMs": 927247,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "and just try to push it aside."
    } ]
  }, {
    "tStartMs": 928649,
    "dDurationMs": 2011,
    "segs": [ {
      "utf8": "Just nudge it aside, instead\nof trying to blow it up,"
    } ]
  }, {
    "tStartMs": 930660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "let's just push it gently aside,"
    } ]
  }, {
    "tStartMs": 932520,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "so that it deflects it and\nit doesn't hit the earth."
    } ]
  }, {
    "tStartMs": 935390,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The trouble is, when you\nwork out the numbers,"
    } ]
  }, {
    "tStartMs": 937590,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "none of the rockets that we\nhave can push it around enough."
    } ]
  }, {
    "tStartMs": 940330,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "You would have to keep the\nrockets attached to the surface,"
    } ]
  }, {
    "tStartMs": 942850,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "which we don't know how to do."
    } ]
  }, {
    "tStartMs": 943730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Remember, it's a rotating body,"
    } ]
  }, {
    "tStartMs": 945410,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "for centuries, to have\na significant effect"
    } ]
  }, {
    "tStartMs": 948400,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "on the motion of the asteroids."
    } ]
  }, {
    "tStartMs": 949570,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "So forget bombs, forget attaching rockets."
    } ]
  }, {
    "tStartMs": 953790,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Ablating the surface,"
    } ]
  }, {
    "tStartMs": 954670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "basically you boil the\nsurface with a laser."
    } ]
  }, {
    "tStartMs": 956530,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "We don't have any lasers powerful enough"
    } ]
  }, {
    "tStartMs": 958760,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "and probably can't make\nlasers powerful enough"
    } ]
  }, {
    "tStartMs": 962050,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "to do that from the earth."
    } ]
  }, {
    "tStartMs": 963340,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "We would have to take\nthe lasers to the object,"
    } ]
  }, {
    "tStartMs": 965300,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "which is even more difficult."
    } ]
  }, {
    "tStartMs": 966910,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "The idea that you could wrap an asteroid"
    } ]
  }, {
    "tStartMs": 968788,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "in cooking foil, aluminum\ncooking foils, another nice one."
    } ]
  }, {
    "tStartMs": 972110,
    "dDurationMs": 1516,
    "segs": [ {
      "utf8": "It may be a good one, the best one."
    } ]
  }, {
    "tStartMs": 973626,
    "dDurationMs": 1724,
    "segs": [ {
      "utf8": "But it still doesn't really work"
    } ]
  }, {
    "tStartMs": 975350,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "because we don't know how to do that."
    } ]
  }, {
    "tStartMs": 977070,
    "dDurationMs": 1513,
    "segs": [ {
      "utf8": "We don't have a way to launch"
    } ]
  }, {
    "tStartMs": 978583,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "enough cooking foil to wrap up an asteroid"
    } ]
  }, {
    "tStartMs": 981910,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "and change its radiative properties"
    } ]
  }, {
    "tStartMs": 983760,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which would itself move\nthe asteroid around."
    } ]
  }, {
    "tStartMs": 986550,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "So the truth is, to be honest,"
    } ]
  }, {
    "tStartMs": 988270,
    "dDurationMs": 3531,
    "segs": [ {
      "utf8": "we do not have a way now to deflect"
    } ]
  }, {
    "tStartMs": 991801,
    "dDurationMs": 3439,
    "segs": [ {
      "utf8": "a kilometer size asteroid, at all."
    } ]
  }, {
    "tStartMs": 995240,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- That could destroy a country."
    } ]
  }, {
    "tStartMs": 996860,
    "dDurationMs": 1037,
    "segs": [ {
      "utf8": "- [Prof. Jewitt] Yeah,\nwe just don't have a way."
    } ]
  }, {
    "tStartMs": 997897,
    "dDurationMs": 1393,
    "segs": [ {
      "utf8": "- And 10 kilometers?"
    } ]
  }, {
    "tStartMs": 999290,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "- 10 kilometers is absolutely"
    } ]
  }, {
    "tStartMs": 1001167,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "a thousand times more hopeless."
    } ]
  }, {
    "tStartMs": 1002929,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 1003762,
    "dDurationMs": 2278,
    "segs": [ {
      "utf8": "So, when we discuss this, you know,"
    } ]
  }, {
    "tStartMs": 1006040,
    "dDurationMs": 1412,
    "segs": [ {
      "utf8": "we had all these grand ideas."
    } ]
  }, {
    "tStartMs": 1007452,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "\"Oh, we could do this and\nthis,\" and none of them worked."
    } ]
  }, {
    "tStartMs": 1009795,
    "dDurationMs": 2275,
    "segs": [ {
      "utf8": "We came down to the most basic idea, well,"
    } ]
  }, {
    "tStartMs": 1012070,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "maybe if we could figure out"
    } ]
  }, {
    "tStartMs": 1013210,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "where the asteroid is gonna hit,"
    } ]
  }, {
    "tStartMs": 1014650,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "like which city is it gonna explode over,"
    } ]
  }, {
    "tStartMs": 1017170,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "we can evacuate that city."
    } ]
  }, {
    "tStartMs": 1018937,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "And then we looked at the\nhistory of city evacuations,"
    } ]
  }, {
    "tStartMs": 1021785,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "and we looked at cases, you know where,"
    } ]
  }, {
    "tStartMs": 1024055,
    "dDurationMs": 2495,
    "segs": [ {
      "utf8": "for example, you have\nlike a week's warning,"
    } ]
  }, {
    "tStartMs": 1026550,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "where some hurricane\nsystem is gonna come in"
    } ]
  }, {
    "tStartMs": 1029135,
    "dDurationMs": 1488,
    "segs": [ {
      "utf8": "and flood a city."
    } ]
  }, {
    "tStartMs": 1030623,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "And evacuation just doesn't work either."
    } ]
  }, {
    "tStartMs": 1034493,
    "dDurationMs": 1937,
    "segs": [ {
      "utf8": "And the reason is very, very simple."
    } ]
  }, {
    "tStartMs": 1036430,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Going into a city, there\nare not that many freeways."
    } ]
  }, {
    "tStartMs": 1039810,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "If you have millions of people\ntrying to get on a freeway,"
    } ]
  }, {
    "tStartMs": 1042540,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the first time a car breaks\ndown, you block that freeway."
    } ]
  }, {
    "tStartMs": 1045960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So instantly, you have millions of people"
    } ]
  }, {
    "tStartMs": 1048120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "trying to get out of the target zone,"
    } ]
  }, {
    "tStartMs": 1050370,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "and they won't be able to\nbecause all of the roads"
    } ]
  }, {
    "tStartMs": 1052649,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "will be instantly blocked."
    } ]
  }, {
    "tStartMs": 1055150,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "So again, even that, even\nevacuation of a city,"
    } ]
  }, {
    "tStartMs": 1058430,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "is probably the most hopeful\nthing that we could try to do."
    } ]
  }, {
    "tStartMs": 1062680,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "Even that's really, really difficult,"
    } ]
  }, {
    "tStartMs": 1064209,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "because of the large\nnumbers of people involved."
    } ]
  }, {
    "tStartMs": 1067272,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "What I think all reasonable\npeople would conclude is,"
    } ]
  }, {
    "tStartMs": 1070572,
    "dDurationMs": 3418,
    "segs": [ {
      "utf8": "let's do the thing that we can do first."
    } ]
  }, {
    "tStartMs": 1073990,
    "dDurationMs": 893,
    "segs": [ {
      "utf8": "So let's look for them."
    } ]
  }, {
    "tStartMs": 1074883,
    "dDurationMs": 1557,
    "segs": [ {
      "utf8": "Let's do the surveys."
    } ]
  }, {
    "tStartMs": 1076440,
    "dDurationMs": 1206,
    "segs": [ {
      "utf8": "Let's build the telescopes."
    } ]
  }, {
    "tStartMs": 1077646,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "Let's put this telescope in space."
    } ]
  }, {
    "tStartMs": 1079510,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That will be a major contribution"
    } ]
  }, {
    "tStartMs": 1082010,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "to understanding the\nthreat from the asteroids."
    } ]
  }, {
    "tStartMs": 1084780,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "And then when we find a particular object"
    } ]
  }, {
    "tStartMs": 1088390,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "that looks especially dangerous,\nthen we can focus on it."
    } ]
  }, {
    "tStartMs": 1091960,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "We can focus everything we have on it,"
    } ]
  }, {
    "tStartMs": 1094016,
    "dDurationMs": 3155,
    "segs": [ {
      "utf8": "and we can begin to think\nseriously and with real motivation"
    } ]
  }, {
    "tStartMs": 1097171,
    "dDurationMs": 2232,
    "segs": [ {
      "utf8": "about ways to deflect it."
    } ]
  }, {
    "tStartMs": 1100494,
    "dDurationMs": 2806,
    "segs": [ {
      "utf8": "- Now, if you're concerned\nabout the world ending"
    } ]
  }, {
    "tStartMs": 1103300,
    "dDurationMs": 3645,
    "segs": [ {
      "utf8": "in an asteroid impact, let\nme set your mind at ease."
    } ]
  }, {
    "tStartMs": 1106945,
    "dDurationMs": 3386,
    "segs": [ {
      "utf8": "There are many other\npotential global catastrophes"
    } ]
  }, {
    "tStartMs": 1110331,
    "dDurationMs": 3979,
    "segs": [ {
      "utf8": "summarized in this map of\ndoom made by my friend Dom,"
    } ]
  }, {
    "tStartMs": 1114310,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "over at Domain of Science."
    } ]
  }, {
    "tStartMs": 1116250,
    "dDurationMs": 1838,
    "segs": [ {
      "utf8": "So if you wanna see which\nof these horrible scenarios"
    } ]
  }, {
    "tStartMs": 1118088,
    "dDurationMs": 2315,
    "segs": [ {
      "utf8": "is likeliest to be our downfall,"
    } ]
  }, {
    "tStartMs": 1120403,
    "dDurationMs": 2551,
    "segs": [ {
      "utf8": "well go check out the\nvideo on his channel."
    } ]
  }, {
    "tStartMs": 1122954,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(sci-fi sound effects)"
    } ]
  }, {
    "tStartMs": 1127240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "My oldest now knows how\nto do the sponsor message."
    } ]
  }, {
    "tStartMs": 1130520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Do you wanna say it?"
    } ]
  }, {
    "tStartMs": 1131720,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "This episode ..."
    } ]
  }, {
    "tStartMs": 1132857,
    "dDurationMs": 2298,
    "segs": [ {
      "utf8": "- [Kid] Is sponsored by KiwiCo."
    } ]
  }, {
    "tStartMs": 1135155,
    "dDurationMs": 1075,
    "segs": [ {
      "utf8": "(chuckling)"
    } ]
  }, {
    "tStartMs": 1136230,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- Very good."
    } ]
  }, {
    "tStartMs": 1137450,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "KiwiCo creates awesome projects\nand toys to get kids making."
    } ]
  }, {
    "tStartMs": 1142090,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "They offer eight subscription\nlines for kids of all ages,"
    } ]
  }, {
    "tStartMs": 1144992,
    "dDurationMs": 2226,
    "segs": [ {
      "utf8": "all the way down to newborns."
    } ]
  }, {
    "tStartMs": 1147218,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "And with the holidays\nright around the corner,"
    } ]
  }, {
    "tStartMs": 1149720,
    "dDurationMs": 2284,
    "segs": [ {
      "utf8": "KiwiCo is the perfect gift idea."
    } ]
  }, {
    "tStartMs": 1152004,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "As a parent, I know that\nlots of gifts get unwrapped"
    } ]
  }, {
    "tStartMs": 1155670,
    "dDurationMs": 1582,
    "segs": [ {
      "utf8": "and played with for a little while,"
    } ]
  }, {
    "tStartMs": 1157252,
    "dDurationMs": 2118,
    "segs": [ {
      "utf8": "but then kids lose interest."
    } ]
  }, {
    "tStartMs": 1159370,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But a KiwiCo crate subscription\nwill keep kids engaged,"
    } ]
  }, {
    "tStartMs": 1162570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "learning, and making throughout the year."
    } ]
  }, {
    "tStartMs": 1164970,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Now I use their crates with my sons,"
    } ]
  }, {
    "tStartMs": 1166760,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "and they are a lot of fun\nwhile also being educational."
    } ]
  }, {
    "tStartMs": 1169605,
    "dDurationMs": 3095,
    "segs": [ {
      "utf8": "And I want my kids to see\nlearning as a form of play."
    } ]
  }, {
    "tStartMs": 1172700,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "And KiwiCo really helps me do that."
    } ]
  }, {
    "tStartMs": 1174597,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "Plus all the supplies you\nneed come right in the box,"
    } ]
  }, {
    "tStartMs": 1177110,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "so you never need to run out to the store."
    } ]
  }, {
    "tStartMs": 1179600,
    "dDurationMs": 2904,
    "segs": [ {
      "utf8": "Now here, I built a perpetual calendar."
    } ]
  }, {
    "tStartMs": 1182504,
    "dDurationMs": 3596,
    "segs": [ {
      "utf8": "A reminder that each passing\nday brings the chance"
    } ]
  }, {
    "tStartMs": 1186100,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of an asteroid impact."
    } ]
  }, {
    "tStartMs": 1188110,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "For viewers of this video,"
    } ]
  }, {
    "tStartMs": 1189300,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "KiwiCo is offering 50% off\nyour first month of any crate."
    } ]
  }, {
    "tStartMs": 1192846,
    "dDurationMs": 2804,
    "segs": [ {
      "utf8": "Just go to kiwico.com/veritasium50,"
    } ]
  }, {
    "tStartMs": 1195650,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and I'll put that link\ndown in the description."
    } ]
  }, {
    "tStartMs": 1198320,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "So I wanna thank KiwiCo\nfor sponsoring Veritasium,"
    } ]
  }, {
    "tStartMs": 1200730,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
