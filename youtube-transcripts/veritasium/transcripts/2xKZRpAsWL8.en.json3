  "events": [ {
    "tStartMs": 1299,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "so today and i'm at the University of Sydney with\nDoctor Phil Dooley and we're talking about"
    } ]
  }, {
    "tStartMs": 6029,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "how our idea of the atom changed from a tiny\nlittle hard sphere"
    } ]
  }, {
    "tStartMs": 9989,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to something more complicated"
    } ]
  }, {
    "tStartMs": 13319,
    "dDurationMs": 3231,
    "segs": [ {
      "utf8": "And this apparatus has something to do with that\nPhil: exactly, exactly it was quite a"
    } ]
  }, {
    "tStartMs": 16550,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "the landmark historical"
    } ]
  }, {
    "tStartMs": 19300,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "experiment"
    } ]
  }, {
    "tStartMs": 20669,
    "dDurationMs": 3011,
    "segs": [ {
      "utf8": "it's just made of a tube of glass connected\nto a"
    } ]
  }, {
    "tStartMs": 23680,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "a vacuum pump"
    } ]
  }, {
    "tStartMs": 25100,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "and in the tube of glass there are two pieces\nof metal connected to high-voltage power supply"
    } ]
  }, {
    "tStartMs": 30690,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "so we can suck the air out of here\nPhil: that's right"
    } ]
  }, {
    "tStartMs": 33850,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "and then apply a high voltage two metal plates\nPhil: yes"
    } ]
  }, {
    "tStartMs": 38230,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "Normally with"
    } ]
  }, {
    "tStartMs": 39420,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "high voltage in air we don't get anything except\nmaybe a big spark"
    } ]
  }, {
    "tStartMs": 43010,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "but what we what Geissler found who did this\nin 1857"
    } ]
  }, {
    "tStartMs": 46920,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "was something quite different so shall we have a look?"
    } ]
  }, {
    "tStartMs": 49210,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Derek: let's do it\nPhil: ok, let's turn on the pump"
    } ]
  }, {
    "tStartMs": 53210,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "and"
    } ]
  }, {
    "tStartMs": 53860,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "the high volts"
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "turn off the lights so we can see what's going on"
    } ]
  }, {
    "tStartMs": 59200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "as you can see"
    } ]
  }, {
    "tStartMs": 61330,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "something's happening now"
    } ]
  }, {
    "tStartMs": 62620,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "yes I see a bit of a pink"
    } ]
  }, {
    "tStartMs": 63840,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "glow in there.\nPhil: that's right so imagine Geissler, the first person"
    } ]
  }, {
    "tStartMs": 67009,
    "dDurationMs": 2551,
    "segs": [ {
      "utf8": "to ever see this, it's pretty surprising"
    } ]
  }, {
    "tStartMs": 69560,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "that started people thinking 'what is the stuff\nthat's coming from the cathode?' There seems to be"
    } ]
  }, {
    "tStartMs": 75250,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "a ray emitted from this negatively charged\none which they called the cathode so therefore"
    } ]
  }, {
    "tStartMs": 79030,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "it's called a cathode ray"
    } ]
  }, {
    "tStartMs": 81329,
    "dDurationMs": 4741,
    "segs": [ {
      "utf8": "and it became the topic for research for the next\nforty years since"
    } ]
  }, {
    "tStartMs": 86070,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "all the big big wigs of physics in science\nbasically tried to work at what was going on"
    } ]
  }, {
    "tStartMs": 91899,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "So what did they figure out? I mean what is\ngoing on? What's producing this glow here"
    } ]
  }, {
    "tStartMs": 95780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "there were two main camps"
    } ]
  }, {
    "tStartMs": 98180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "one thought that it was waves"
    } ]
  }, {
    "tStartMs": 101180,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and the second thought that the electricity was\nbeing"
    } ]
  }, {
    "tStartMs": 104220,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "carried by a stream of charged particles. Over\nthe next forty years they basically"
    } ]
  }, {
    "tStartMs": 109790,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "came to the conclusion - well it was \nJJ Thomson in eigteen ninety seven"
    } ]
  }, {
    "tStartMs": 114540,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "who came up with the idea that uh... there\nis"
    } ]
  }, {
    "tStartMs": 118520,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "a stream of very small charged particles"
    } ]
  }, {
    "tStartMs": 121770,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "uh... negatively charged"
    } ]
  }, {
    "tStartMs": 123780,
    "dDurationMs": 3079,
    "segs": [ {
      "utf8": "they're smaller than an atom so the smallest atom"
    } ]
  }, {
    "tStartMs": 126859,
    "dDurationMs": 671,
    "segs": [ {
      "utf8": "a hydrogen atom"
    } ]
  }, {
    "tStartMs": 127530,
    "dDurationMs": 3329,
    "segs": [ {
      "utf8": "they're about one thousandth of the size of that"
    } ]
  }, {
    "tStartMs": 130859,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and it doesn't matter what material it -"
    } ]
  }, {
    "tStartMs": 133499,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "the metal is"
    } ]
  }, {
    "tStartMs": 135129,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "it's always the same particle, so this\nparticle appears to be in everything"
    } ]
  }, {
    "tStartMs": 139769,
    "dDurationMs": 5161,
    "segs": [ {
      "utf8": "and this electron as it was as\nknownn is what's carrying the electricity"
    } ]
  }, {
    "tStartMs": 144930,
    "dDurationMs": 2629,
    "segs": [ {
      "utf8": "so Thomson came to the conclusion that"
    } ]
  }, {
    "tStartMs": 147559,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "all atoms have this particle as one of their\nconstituents"
    } ]
  }, {
    "tStartMs": 150879,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "that's right, that's right so it wasn't a billiard ball,\nthere had to be something inside the billiard ball"
    } ]
  }, {
    "tStartMs": 156129,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "so how do I picture like a billiard ball"
    } ]
  }, {
    "tStartMs": 158030,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "with bits inside it?\nPhil: Well you should probably think about a pudding"
    } ]
  }, {
    "tStartMs": 161100,
    "dDurationMs": 3499,
    "segs": [ {
      "utf8": "A pudding?\nPhil: Yeah well that's what his idea was, that\nit was a plum pudding"
    } ]
  }, {
    "tStartMs": 164599,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "very dear"
    } ]
  }, {
    "tStartMs": 165919,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "to every British person's heart"
    } ]
  }, {
    "tStartMs": 167729,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Derek: right \nPhil: and inside the putting you have plums"
    } ]
  }, {
    "tStartMs": 173009,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and plums can come out of that so when you\napply high voltage then a negatively charged"
    } ]
  }, {
    "tStartMs": 177209,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "electron"
    } ]
  }, {
    "tStartMs": 178849,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "which thompson pictured as a plum comes out and\nleaves behind positively charged putting"
    } ]
  }, {
    "tStartMs": 183219,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "are you a fan of plum pudding?"
    } ]
  }, {
    "tStartMs": 185249,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "For research purposes definitely"
    } ]
  }, {
    "tStartMs": 187970,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "All right, let's see if we can research this a little further\nsounds like fun"
    } ]
  } ]
}
