  "events": [ {
    "tStartMs": 267,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(cardboard thudding)"
    } ]
  }, {
    "tStartMs": 1100,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "(cardboard crunching)"
    } ]
  }, {
    "tStartMs": 4200,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Am I retiring?"
    } ]
  }, {
    "tStartMs": 5940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That is the question I will\nanswer in this video,"
    } ]
  }, {
    "tStartMs": 7980,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and you can skip ahead to\nthe answer if you like,"
    } ]
  }, {
    "tStartMs": 10800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but I think it'll make\nmore sense if I explain."
    } ]
  }, {
    "tStartMs": 13920,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "You know, I started this\nYouTube channel in 2011"
    } ]
  }, {
    "tStartMs": 16140,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "after quitting my full-time job."
    } ]
  }, {
    "tStartMs": 17880,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And welcome to Veritasium."
    } ]
  }, {
    "tStartMs": 19530,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "In units of kilogram."
    } ]
  }, {
    "tStartMs": 20550,
    "dDurationMs": 2783,
    "segs": [ {
      "utf8": "I was teaching around 15\nhours a week to pay the bills."
    } ]
  }, {
    "tStartMs": 23333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "This is the repre-"
    } ]
  }, {
    "tStartMs": 24166,
    "dDurationMs": 2924,
    "segs": [ {
      "utf8": "But the other 40 to 50 hours per week,"
    } ]
  }, {
    "tStartMs": 27090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I spent making videos on this channel,"
    } ]
  }, {
    "tStartMs": 29640,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and I didn't do it for the money."
    } ]
  }, {
    "tStartMs": 31650,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Gives mass to the other subatomic part-"
    } ]
  }, {
    "tStartMs": 33390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "I don't think anyone who\nstarted at that time did,"
    } ]
  }, {
    "tStartMs": 36000,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "because there was basically\nno money to be made."
    } ]
  }, {
    "tStartMs": 39030,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "In my first year working\nfull time, I made $840."
    } ]
  }, {
    "tStartMs": 44040,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "In my second year, I earned $12,000."
    } ]
  }, {
    "tStartMs": 48090,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The real reason I made Veritasium"
    } ]
  }, {
    "tStartMs": 49800,
    "dDurationMs": 1448,
    "segs": [ {
      "utf8": "is because it allowed me to combine"
    } ]
  }, {
    "tStartMs": 51248,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "the three things that I\nalways loved doing the most,"
    } ]
  }, {
    "tStartMs": 54810,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "learning about science, teaching,"
    } ]
  }, {
    "tStartMs": 59010,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "and creating, like\nperforming and making videos."
    } ]
  }, {
    "tStartMs": 63960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I did not get into this\nto start a business."
    } ]
  }, {
    "tStartMs": 66210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I personally think I'd be\nterrible at selling things."
    } ]
  }, {
    "tStartMs": 68880,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "I'm not one of those people who can say,"
    } ]
  }, {
    "tStartMs": 70597,
    "dDurationMs": 1013,
    "segs": [ {
      "utf8": "\"You've gotta try this."
    } ]
  }, {
    "tStartMs": 71610,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It'll change your life.\""
    } ]
  }, {
    "tStartMs": 73560,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "You know, back in 2015,"
    } ]
  }, {
    "tStartMs": 74730,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I kickstarted a magnetic\nmolecular modeling kit"
    } ]
  }, {
    "tStartMs": 77910,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "called Snatoms, and I\nstill sell it on Amazon,"
    } ]
  }, {
    "tStartMs": 80940,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "but I hardly ever mention it"
    } ]
  }, {
    "tStartMs": 82680,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "because I don't wanna bother you."
    } ]
  }, {
    "tStartMs": 84420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And I figure if you're looking\nfor something like that,"
    } ]
  }, {
    "tStartMs": 86400,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "well maybe, you'll find it."
    } ]
  }, {
    "tStartMs": 90450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Hello?"
    } ]
  }, {
    "tStartMs": 91283,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Passerby] Very nice."
    } ]
  }, {
    "tStartMs": 92116,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Thank you."
    } ]
  }, {
    "tStartMs": 92949,
    "dDurationMs": 2871,
    "segs": [ {
      "utf8": "I almost never ask you to\nlike, comment, or subscribe."
    } ]
  }, {
    "tStartMs": 95820,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "I wanna thank you for watching."
    } ]
  }, {
    "tStartMs": 96990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Because I figure you\nknow what you wanna do."
    } ]
  }, {
    "tStartMs": 99330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And I'm not a growth hacker."
    } ]
  }, {
    "tStartMs": 101400,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "We don't sell cheap merch,\nno t-shirts or hoodies."
    } ]
  }, {
    "tStartMs": 105060,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "I want you to get more value\noutta me than I get out of you."
    } ]
  }, {
    "tStartMs": 109520,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "You know, the only thing"
    } ]
  }, {
    "tStartMs": 110400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that I am really passionate\nabout is the truth,"
    } ]
  }, {
    "tStartMs": 114000,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and the best way to get to\nthe truth is through science."
    } ]
  }, {
    "tStartMs": 117420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Our universe is an extraordinary place,"
    } ]
  }, {
    "tStartMs": 120030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and I think most people go through life"
    } ]
  }, {
    "tStartMs": 121680,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "oblivious to how it actually works."
    } ]
  }, {
    "tStartMs": 124590,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "How does the boat go forwards?"
    } ]
  }, {
    "tStartMs": 125760,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Yeah, escape that."
    } ]
  }, {
    "tStartMs": 126930,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Well again, well, I know, I know it does"
    } ]
  }, {
    "tStartMs": 130410,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but again, I don't have all the answers."
    } ]
  }, {
    "tStartMs": 133530,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- I think that's not just unfortunate."
    } ]
  }, {
    "tStartMs": 135390,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It has real negative consequences."
    } ]
  }, {
    "tStartMs": 137850,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "To give an example, in 1958,"
    } ]
  }, {
    "tStartMs": 139830,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Dr. Benjamin Spock published"
    } ]
  }, {
    "tStartMs": 141390,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in his book, \"Baby and Child Care,\""
    } ]
  }, {
    "tStartMs": 143370,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that babies should be put\ndown to sleep on their fronts"
    } ]
  }, {
    "tStartMs": 146010,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "rather than their backs"
    } ]
  }, {
    "tStartMs": 147150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to prevent them from\nchoking on their own vomit."
    } ]
  }, {
    "tStartMs": 149820,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And this book outsold every other book,"
    } ]
  }, {
    "tStartMs": 151740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "except the Bible, for\nits 52 year print run."
    } ]
  }, {
    "tStartMs": 154380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So, it was pretty influential."
    } ]
  }, {
    "tStartMs": 156060,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But when empirical studies"
    } ]
  }, {
    "tStartMs": 157380,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "showed that babies\nsleeping on their fronts"
    } ]
  }, {
    "tStartMs": 158700,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "were actually more likely to die"
    } ]
  }, {
    "tStartMs": 160470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "from sudden infant death syndrome,"
    } ]
  }, {
    "tStartMs": 162540,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "well, the book was not promptly updated."
    } ]
  }, {
    "tStartMs": 165000,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It was printed with the\nsame bad advice for decades,"
    } ]
  }, {
    "tStartMs": 168180,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "leading to an estimated\n50,000 unnecessary deaths."
    } ]
  }, {
    "tStartMs": 171900,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The point is we lead\nbetter and happier lives"
    } ]
  }, {
    "tStartMs": 174990,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "when they're in accordance\nwith how the world actually is,"
    } ]
  }, {
    "tStartMs": 177840,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "rather than just how it appears to be"
    } ]
  }, {
    "tStartMs": 179550,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or how we'd like it to be."
    } ]
  }, {
    "tStartMs": 181290,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "That is why an undercurrent of every video"
    } ]
  }, {
    "tStartMs": 184710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is how do we know what's true,"
    } ]
  }, {
    "tStartMs": 187290,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "how would we know if we were wrong,"
    } ]
  }, {
    "tStartMs": 189600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "because I want to increase the level"
    } ]
  }, {
    "tStartMs": 191760,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of critical thinking in the world."
    } ]
  }, {
    "tStartMs": 194100,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "That is the fundamental\nmission of Veritasium."
    } ]
  }, {
    "tStartMs": 197940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Now so far, this is basically just like-"
    } ]
  }, {
    "tStartMs": 199560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "By 2013, I was fortunate enough"
    } ]
  }, {
    "tStartMs": 201810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that this dream job YouTube channel"
    } ]
  }, {
    "tStartMs": 203760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "started to produce enough\nincome to live off."
    } ]
  }, {
    "tStartMs": 206160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So I quit all other work,"
    } ]
  }, {
    "tStartMs": 207570,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "and this has been my main gig ever since."
    } ]
  }, {
    "tStartMs": 209682,
    "dDurationMs": 3468,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 213150,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I can't believe all the\nthings I've gotten to do,"
    } ]
  }, {
    "tStartMs": 216240,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and I want to thank you,"
    } ]
  }, {
    "tStartMs": 217380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "someone who's watched at\nleast one of these videos,"
    } ]
  }, {
    "tStartMs": 219480,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "for making it possible."
    } ]
  }, {
    "tStartMs": 222090,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But I have to acknowledge my biggest fear"
    } ]
  }, {
    "tStartMs": 224670,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and what I think is the biggest challenge"
    } ]
  }, {
    "tStartMs": 226440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "facing any creator,\nwhich is precariousness."
    } ]
  }, {
    "tStartMs": 230280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This is a job that comes\nwith a lot of uncertainty."
    } ]
  }, {
    "tStartMs": 233130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I mean, how much you\nmake in any given month"
    } ]
  }, {
    "tStartMs": 234900,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "depends on how many views your\nchannel got in that month."
    } ]
  }, {
    "tStartMs": 237960,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And then, there's the comment section"
    } ]
  }, {
    "tStartMs": 239700,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and the fact that your sense of self worth"
    } ]
  }, {
    "tStartMs": 241740,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "is basically tied to how well\nyour videos are received."
    } ]
  }, {
    "tStartMs": 245580,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But by far, the biggest\nsource of uncertainty"
    } ]
  }, {
    "tStartMs": 247950,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "is just not knowing when\nthis is all going to end,"
    } ]
  }, {
    "tStartMs": 250980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "like when are you going to upload"
    } ]
  }, {
    "tStartMs": 252870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "your last successful video,"
    } ]
  }, {
    "tStartMs": 254670,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "when are you no longer going\nto be able to make a living"
    } ]
  }, {
    "tStartMs": 257520,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "doing what you have been doing."
    } ]
  }, {
    "tStartMs": 260010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "In 2018, I had a call\nwith my contact at YouTube"
    } ]
  }, {
    "tStartMs": 263220,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "who told me I needed to\nquote, \"Stay relevant.\""
    } ]
  }, {
    "tStartMs": 266910,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Yeah, that stung a bit."
    } ]
  }, {
    "tStartMs": 268860,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Now, I'm not gonna name\nnames, but I have seen"
    } ]
  }, {
    "tStartMs": 271950,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "friends and other creators\nwho have stopped making stuff"
    } ]
  }, {
    "tStartMs": 275520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for a whole bunch of reasons,"
    } ]
  }, {
    "tStartMs": 277260,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "like maybe they've gotten\ninjured or gotten really sick."
    } ]
  }, {
    "tStartMs": 280380,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I know of other YouTubers"
    } ]
  }, {
    "tStartMs": 281490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "who've been canceled or demonetized."
    } ]
  }, {
    "tStartMs": 283530,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I mean, there's just a million\nways for things to go wrong"
    } ]
  }, {
    "tStartMs": 286830,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and only really one way for\nthem to continue to go right."
    } ]
  }, {
    "tStartMs": 290850,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I think by far the scariest proposition"
    } ]
  }, {
    "tStartMs": 293370,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "is that the YouTube algorithm"
    } ]
  }, {
    "tStartMs": 294480,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "just stops showing your videos to people."
    } ]
  }, {
    "tStartMs": 297030,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "I think that's the scariest,\nbecause it is so common"
    } ]
  }, {
    "tStartMs": 299940,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and it's completely out of your control."
    } ]
  }, {
    "tStartMs": 302550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "A violinist placed in one of these rooms"
    } ]
  }, {
    "tStartMs": 304200,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "was apparently banging on."
    } ]
  }, {
    "tStartMs": 305130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The way I dealt with this precariousness"
    } ]
  }, {
    "tStartMs": 307230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "was by limiting my expenses."
    } ]
  }, {
    "tStartMs": 309420,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I didn't buy any more equipment\nthan was strictly necessary."
    } ]
  }, {
    "tStartMs": 312450,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I didn't book travel to filming locations."
    } ]
  }, {
    "tStartMs": 315300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But if someone else was flying me out,"
    } ]
  }, {
    "tStartMs": 316980,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I might try to tag on a shoot."
    } ]
  }, {
    "tStartMs": 318480,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "That is Chernobyl\nNuclear reactor number 4."
    } ]
  }, {
    "tStartMs": 321990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "I did all the research, writing, filming,"
    } ]
  }, {
    "tStartMs": 324060,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and editing myself."
    } ]
  }, {
    "tStartMs": 325290,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Even the crappy animations,\nyes, all of that was me."
    } ]
  }, {
    "tStartMs": 329430,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "As long as it was just my\ntime going into this channel"
    } ]
  }, {
    "tStartMs": 331890,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and me depending on it\nfor survival, I was okay."
    } ]
  }, {
    "tStartMs": 334890,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "Hello, and thank you for supporting."
    } ]
  }, {
    "tStartMs": 336243,
    "dDurationMs": 3507,
    "segs": [ {
      "utf8": "When I had my first kid in\n2016, I launched a Patreon"
    } ]
  }, {
    "tStartMs": 339750,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to try to ensure that I could\nalways take care of my family,"
    } ]
  }, {
    "tStartMs": 343170,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "but the channel continued to grow."
    } ]
  }, {
    "tStartMs": 345780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "It grew to a size where it was ridiculous"
    } ]
  }, {
    "tStartMs": 348210,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that I was still doing everything myself."
    } ]
  }, {
    "tStartMs": 349920,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I was working all the time."
    } ]
  }, {
    "tStartMs": 351930,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I am perhaps the slowest\neditor you will ever meet,"
    } ]
  }, {
    "tStartMs": 354720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so I should have hired an editor,"
    } ]
  }, {
    "tStartMs": 356640,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but hiring takes time."
    } ]
  }, {
    "tStartMs": 358740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And on how many days was hiring someone"
    } ]
  }, {
    "tStartMs": 361560,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "at the top of my priority list?"
    } ]
  }, {
    "tStartMs": 363660,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Well, zero, because I was always focused"
    } ]
  }, {
    "tStartMs": 366420,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "on making that next video."
    } ]
  }, {
    "tStartMs": 368030,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "There's been a number of missions like-"
    } ]
  }, {
    "tStartMs": 368970,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Now, I did eventually start hiring people,"
    } ]
  }, {
    "tStartMs": 371160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but not because I was looking for them,"
    } ]
  }, {
    "tStartMs": 373500,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "just because they found me."
    } ]
  }, {
    "tStartMs": 375270,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I mean, the first person\nI worked with consistently"
    } ]
  }, {
    "tStartMs": 377220,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "was Jonny Hyman."
    } ]
  }, {
    "tStartMs": 378450,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "And I only found him because\nhe recognized me in a Chipotle."
    } ]
  }, {
    "tStartMs": 383820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "He is ridiculously talented."
    } ]
  }, {
    "tStartMs": 385560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "He's researched and\nwritten for this channel,"
    } ]
  }, {
    "tStartMs": 387960,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "plus he's edited, done\nVFX, made simulations."
    } ]
  }, {
    "tStartMs": 391410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "He's even written and produced music,"
    } ]
  }, {
    "tStartMs": 393870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "original music for videos,"
    } ]
  }, {
    "tStartMs": 395670,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and you're listening to\nsome of it right now."
    } ]
  }, {
    "tStartMs": 398280,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "I hired Petr Lebedev"
    } ]
  }, {
    "tStartMs": 399570,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "because he did a PhD with\nmy old PhD supervisor."
    } ]
  }, {
    "tStartMs": 402630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I hired Emily Zang 20\nminutes into a Zoom call"
    } ]
  }, {
    "tStartMs": 405480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and told her to move across the country."
    } ]
  }, {
    "tStartMs": 407100,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I found out about you through\na friend, Xyla Foxlin."
    } ]
  }, {
    "tStartMs": 409950,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "- I remember I just got a\ntext from you and I was like,"
    } ]
  }, {
    "tStartMs": 412447,
    "dDurationMs": 2196,
    "segs": [ {
      "utf8": "\"Oh my god, Derek Muller was texting me.\""
    } ]
  }, {
    "tStartMs": 414643,
    "dDurationMs": 1427,
    "segs": [ {
      "utf8": "I be like, \"Oh my God, Veritasium,"
    } ]
  }, {
    "tStartMs": 416070,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Mr. Veritasium was texting me,\""
    } ]
  }, {
    "tStartMs": 417510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and you were just like,"
    } ]
  }, {
    "tStartMs": 418343,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "\"Can you hop on a FaceTime later today?\""
    } ]
  }, {
    "tStartMs": 419786,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And I was like,"
    } ]
  }, {
    "tStartMs": 420619,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "\"Well, this is a different\ninterview process.\""
    } ]
  }, {
    "tStartMs": 423390,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- We talked for half an hour."
    } ]
  }, {
    "tStartMs": 425130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 425963,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "- And then I said, \"Do\nyou wanna work with me?"
    } ]
  }, {
    "tStartMs": 427460,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "Do you wanna fly to LA\nand like work together?\""
    } ]
  }, {
    "tStartMs": 430410,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- And I was like, \"I guess. In how soon?\""
    } ]
  }, {
    "tStartMs": 433200,
    "dDurationMs": 2514,
    "segs": [ {
      "utf8": "And you were like, \"As soon\nas you physically can.\""
    } ]
  }, {
    "tStartMs": 435714,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "(Derek and Emily laughing)"
    } ]
  }, {
    "tStartMs": 438780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- The only person I actively\nsought out on a job board"
    } ]
  }, {
    "tStartMs": 441180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "was my editor, Trenton."
    } ]
  }, {
    "tStartMs": 442980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "My two main animators, Ivy and Fabio,"
    } ]
  }, {
    "tStartMs": 445440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I got through cold emails."
    } ]
  }, {
    "tStartMs": 447090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What did you say?"
    } ]
  }, {
    "tStartMs": 447923,
    "dDurationMs": 1436,
    "segs": [ {
      "utf8": "- I said, \"Are you looking for someone"
    } ]
  }, {
    "tStartMs": 449359,
    "dDurationMs": 1811,
    "segs": [ {
      "utf8": "to have good animations?\""
    } ]
  }, {
    "tStartMs": 451170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And you said yes, you were."
    } ]
  }, {
    "tStartMs": 453090,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "- Ivy sent me an email saying,"
    } ]
  }, {
    "tStartMs": 454807,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "\"I've seen your animations\nand I think I can do better.\""
    } ]
  }, {
    "tStartMs": 456877,
    "dDurationMs": 1073,
    "segs": [ {
      "utf8": "\"Your animations-\"\n- I wasn't"
    } ]
  }, {
    "tStartMs": 457950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "so straightforward.\n- \"Aren't the best.\""
    } ]
  }, {
    "tStartMs": 458783,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "I was like slightly\noffended reading the email,"
    } ]
  }, {
    "tStartMs": 460950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but I was also like,"
    } ]
  }, {
    "tStartMs": 461783,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "\"Well, if you think you can\ndo better, let's see it.\""
    } ]
  }, {
    "tStartMs": 464070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "We also got our first intern,\nCasper, through a cold email."
    } ]
  }, {
    "tStartMs": 467250,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- And we said yes."
    } ]
  }, {
    "tStartMs": 469020,
    "dDurationMs": 1591,
    "segs": [ {
      "utf8": "- No, you said no."
    } ]
  }, {
    "tStartMs": 470611,
    "dDurationMs": 836,
    "segs": [ {
      "utf8": "- We said no?"
    } ]
  }, {
    "tStartMs": 471447,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "- You were like, \"We\ncan't do that right now,"
    } ]
  }, {
    "tStartMs": 473850,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but would you like to research, write,"
    } ]
  }, {
    "tStartMs": 476670,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and produce a video as a freelancer?\""
    } ]
  }, {
    "tStartMs": 479760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh."
    } ]
  }, {
    "tStartMs": 480593,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "- And I was like, \"That's crazy.\""
    } ]
  }, {
    "tStartMs": 483510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- In short, I wasn't very\ngood at finding people."
    } ]
  }, {
    "tStartMs": 485730,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But if they found me and seemed decent,"
    } ]
  }, {
    "tStartMs": 488100,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "then I was happy to give them a shot."
    } ]
  }, {
    "tStartMs": 490590,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "By 2021, I had this talented little team"
    } ]
  }, {
    "tStartMs": 493290,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of writer, producers,\nanimators, and an editor."
    } ]
  }, {
    "tStartMs": 496350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So you might think that I\ncould delegate tasks to them"
    } ]
  }, {
    "tStartMs": 499140,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and work fewer hours,"
    } ]
  }, {
    "tStartMs": 500820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but what actually\nhappened was the opposite."
    } ]
  }, {
    "tStartMs": 503340,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I was working more than than ever before"
    } ]
  }, {
    "tStartMs": 505560,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "because I had to prepare\nthings for them to do"
    } ]
  }, {
    "tStartMs": 508530,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and I had to train them up."
    } ]
  }, {
    "tStartMs": 510300,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You know, I was still editing\nabout half of the videos,"
    } ]
  }, {
    "tStartMs": 512850,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and for the other half,"
    } ]
  }, {
    "tStartMs": 514050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I would often drive across Los Angeles"
    } ]
  }, {
    "tStartMs": 516000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in the middle of the night"
    } ]
  }, {
    "tStartMs": 516833,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "to pick up a hard drive from my editor,"
    } ]
  }, {
    "tStartMs": 518850,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "because this is the fastest\nmethod of data transfer"
    } ]
  }, {
    "tStartMs": 521340,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that we worked out."
    } ]
  }, {
    "tStartMs": 522173,
    "dDurationMs": 2677,
    "segs": [ {
      "utf8": "And then I would drive\nback home, upload the file,"
    } ]
  }, {
    "tStartMs": 524850,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and launch the video by 6:00 AM."
    } ]
  }, {
    "tStartMs": 527340,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I pulled more all-nighters that year"
    } ]
  }, {
    "tStartMs": 529770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "than any other year of my life,"
    } ]
  }, {
    "tStartMs": 531870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "including university."
    } ]
  }, {
    "tStartMs": 533610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "There were many nights"
    } ]
  }, {
    "tStartMs": 534870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "where instead of tucking my kids into bed,"
    } ]
  }, {
    "tStartMs": 537060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I was downstairs in the office"
    } ]
  }, {
    "tStartMs": 539100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "making videos for this channel."
    } ]
  }, {
    "tStartMs": 541470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So, that is when my\nfiance told me something"
    } ]
  }, {
    "tStartMs": 543870,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "that I already knew,"
    } ]
  }, {
    "tStartMs": 544860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "which was that this was not sustainable."
    } ]
  }, {
    "tStartMs": 547800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And yes, she was still my fiance"
    } ]
  }, {
    "tStartMs": 549960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "because even though we got\nengaged seven years previous"
    } ]
  }, {
    "tStartMs": 552480,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and had three kids together,"
    } ]
  }, {
    "tStartMs": 553950,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "we hadn't found the\ntime to have a wedding."
    } ]
  }, {
    "tStartMs": 557970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So the timing was kind of perfect"
    } ]
  }, {
    "tStartMs": 560130,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "when in 2022, these\ntwo guys, Owen and Ian,"
    } ]
  }, {
    "tStartMs": 563220,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "approached me about\ninvesting in Veritasium."
    } ]
  }, {
    "tStartMs": 566190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They had started a\ncompany called Electrify,"
    } ]
  }, {
    "tStartMs": 568440,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "with the stated aim of\nhelping educational creators"
    } ]
  }, {
    "tStartMs": 571590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "build better businesses and\nachieve work-life balance."
    } ]
  }, {
    "tStartMs": 574590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- We loved Veritasium for\nwhat it had been doing"
    } ]
  }, {
    "tStartMs": 576540,
    "dDurationMs": 2207,
    "segs": [ {
      "utf8": "for I guess 13 years at that point."
    } ]
  }, {
    "tStartMs": 578747,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "And we just wanna keep\nthat going and do more"
    } ]
  }, {
    "tStartMs": 581070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and even more of that great stuff."
    } ]
  }, {
    "tStartMs": 583110,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So the deal they offered me was this."
    } ]
  }, {
    "tStartMs": 585840,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "They would buy some of the business,"
    } ]
  }, {
    "tStartMs": 587430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but I would remain an owner."
    } ]
  }, {
    "tStartMs": 589590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "They would take care of things\nlike hiring, production,"
    } ]
  }, {
    "tStartMs": 592920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "logistics, you know, corporate compliance,"
    } ]
  }, {
    "tStartMs": 595380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "taxes, all that sort of stuff."
    } ]
  }, {
    "tStartMs": 597180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And they would reduce my working hours."
    } ]
  }, {
    "tStartMs": 599940,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So, it was kind of the perfect\noffer at the perfect time."
    } ]
  }, {
    "tStartMs": 603600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I never wanted to deal\nwith hiring, and taxes,"
    } ]
  }, {
    "tStartMs": 606600,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "and all that stuff."
    } ]
  }, {
    "tStartMs": 607440,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I just wanted to make videos, you know?"
    } ]
  }, {
    "tStartMs": 609300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Like that's always what it's been about."
    } ]
  }, {
    "tStartMs": 611130,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Learn about science, make a great video."
    } ]
  }, {
    "tStartMs": 613800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Plus with the cash they would\npay up front for equity,"
    } ]
  }, {
    "tStartMs": 616020,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "well, that would reduce the precariousness"
    } ]
  }, {
    "tStartMs": 617910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of being a creator, especially at a time"
    } ]
  }, {
    "tStartMs": 620370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "when AI was coming on the scenes"
    } ]
  }, {
    "tStartMs": 622410,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and shorts were just starting."
    } ]
  }, {
    "tStartMs": 624300,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "There was a lot more\nuncertainty than usual."
    } ]
  }, {
    "tStartMs": 626160,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And this would allow me to\nalways be able to provide"
    } ]
  }, {
    "tStartMs": 628890,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for my family, which most importantly,"
    } ]
  }, {
    "tStartMs": 631290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "with fewer working hours,"
    } ]
  }, {
    "tStartMs": 632640,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I would have a lot more time to spend."
    } ]
  }, {
    "tStartMs": 635070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So, it was kind of a no brainer."
    } ]
  }, {
    "tStartMs": 636690,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I signed the deal in April, 2023,"
    } ]
  }, {
    "tStartMs": 638790,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and since then, Veritasium\nhas been owned and run"
    } ]
  }, {
    "tStartMs": 641850,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "by me and Electrify."
    } ]
  }, {
    "tStartMs": 644460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Now, I've seen some comments concerned"
    } ]
  }, {
    "tStartMs": 646260,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with how the investment\nwill affect the channel,"
    } ]
  }, {
    "tStartMs": 648420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which I totally get."
    } ]
  }, {
    "tStartMs": 650040,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "I mean, would they cut costs,\nreduce the video quality,"
    } ]
  }, {
    "tStartMs": 652950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and just pump out way more videos"
    } ]
  }, {
    "tStartMs": 654810,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to boost short-term profits?"
    } ]
  }, {
    "tStartMs": 657000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But fortunately, you don't have to wonder"
    } ]
  }, {
    "tStartMs": 659130,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "what Electrify will do,"
    } ]
  }, {
    "tStartMs": 660660,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "because we've already\nbeen working together"
    } ]
  }, {
    "tStartMs": 662490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "for nearly three years."
    } ]
  }, {
    "tStartMs": 664530,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So, I can show you what we have done."
    } ]
  }, {
    "tStartMs": 667560,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "We have produced some of\nthe most successful videos"
    } ]
  }, {
    "tStartMs": 670680,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "in the channel's history."
    } ]
  }, {
    "tStartMs": 672000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "In fact, the three videos"
    } ]
  }, {
    "tStartMs": 673440,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "you collectively have spent\nthe most time watching"
    } ]
  }, {
    "tStartMs": 676020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "were all produced in this period."
    } ]
  }, {
    "tStartMs": 677940,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "The videos on forever\nchemicals, blue LEDs,"
    } ]
  }, {
    "tStartMs": 682020,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and black holes, white\nholes, and wormholes."
    } ]
  }, {
    "tStartMs": 684810,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Videos like these have steadily increased"
    } ]
  }, {
    "tStartMs": 687660,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "the amount of time that people"
    } ]
  }, {
    "tStartMs": 688650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "are spending watching Veritasium."
    } ]
  }, {
    "tStartMs": 690420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "In fact, the last four months"
    } ]
  }, {
    "tStartMs": 692460,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "have seen a record amount of time"
    } ]
  }, {
    "tStartMs": 694860,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that people are spending\nwatching the channel."
    } ]
  }, {
    "tStartMs": 696870,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Since the deal, the number\nof subscribers on the channel"
    } ]
  }, {
    "tStartMs": 699480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "has increased by 50%."
    } ]
  }, {
    "tStartMs": 701880,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "These results have not been achieved"
    } ]
  }, {
    "tStartMs": 703770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "by simply pumping out more videos."
    } ]
  }, {
    "tStartMs": 705870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "In fact, the number of main channel videos"
    } ]
  }, {
    "tStartMs": 707610,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "has remained basically constant."
    } ]
  }, {
    "tStartMs": 710130,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "We've also not tried\nto make shorter videos."
    } ]
  }, {
    "tStartMs": 712740,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "We've continued to do deep dives"
    } ]
  }, {
    "tStartMs": 715350,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "into complex scientific topics."
    } ]
  }, {
    "tStartMs": 717690,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And because of that, the length of videos"
    } ]
  }, {
    "tStartMs": 719490,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "has continued to increase."
    } ]
  }, {
    "tStartMs": 720960,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But that's a trend that\nbegan before Electrify."
    } ]
  }, {
    "tStartMs": 723990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The real way we've been able to grow"
    } ]
  }, {
    "tStartMs": 725820,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "is by adding more people."
    } ]
  }, {
    "tStartMs": 727650,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "There are now over 30 people\nworking on Veritasium,"
    } ]
  }, {
    "tStartMs": 731190,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "writer, directors,\nresearchers, illustrators,"
    } ]
  }, {
    "tStartMs": 734730,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "animators, editors, and production staff."
    } ]
  }, {
    "tStartMs": 738000,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "These are the people responsible"
    } ]
  }, {
    "tStartMs": 739980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for some of your favorite videos."
    } ]
  }, {
    "tStartMs": 742170,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I worked with Gregor to make the exposes"
    } ]
  }, {
    "tStartMs": 744420,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "on Teflon, and PFAS, and Monsanto,"
    } ]
  }, {
    "tStartMs": 747330,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "with Casper to make entropy,"
    } ]
  }, {
    "tStartMs": 749310,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the principle of lease action series,"
    } ]
  }, {
    "tStartMs": 751110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and black holes, white\nholes, and wormhole."
    } ]
  }, {
    "tStartMs": 753450,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "With Emily, we made blue LEDs"
    } ]
  }, {
    "tStartMs": 755640,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and the micromouse competition video."
    } ]
  }, {
    "tStartMs": 757710,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Henry was responsible"
    } ]
  }, {
    "tStartMs": 759030,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "for the videos on Alfred\nNobel and phone hacking."
    } ]
  }, {
    "tStartMs": 762090,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Sulli explored the construction"
    } ]
  }, {
    "tStartMs": 763680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of the Citycorp Tower, super glue,"
    } ]
  }, {
    "tStartMs": 765480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and what happened to Amelia Earhart."
    } ]
  }, {
    "tStartMs": 767850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Petr wrote and directed the videos"
    } ]
  }, {
    "tStartMs": 769440,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "on Oppenheimer and Japanese swords."
    } ]
  }, {
    "tStartMs": 771750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Emilia did the same for jet engines"
    } ]
  }, {
    "tStartMs": 774000,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and lithium ion batteries."
    } ]
  }, {
    "tStartMs": 775770,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "James made the videos on power laws"
    } ]
  }, {
    "tStartMs": 777900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and six degrees of separation."
    } ]
  }, {
    "tStartMs": 779790,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "I could go on, but the point\nis far from cutting costs,"
    } ]
  }, {
    "tStartMs": 783510,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "under Electrify, expenses have quadrupled."
    } ]
  }, {
    "tStartMs": 786480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Most of that goes to the team."
    } ]
  }, {
    "tStartMs": 788760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "We are all spread around the world,"
    } ]
  }, {
    "tStartMs": 790890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but we come together a few times a year"
    } ]
  }, {
    "tStartMs": 792780,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to connect and figure out how to improve."
    } ]
  }, {
    "tStartMs": 795720,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "When you see a beautifully\nanimated scene, it's not AI."
    } ]
  }, {
    "tStartMs": 799680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That was drawn by hand by a person"
    } ]
  }, {
    "tStartMs": 802080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and animated by a person too."
    } ]
  }, {
    "tStartMs": 804360,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The way our videos are storyboarded now,"
    } ]
  }, {
    "tStartMs": 806490,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "it's so professional."
    } ]
  }, {
    "tStartMs": 807720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It's like a movie studio."
    } ]
  }, {
    "tStartMs": 809610,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And we have people supporting\nus in other ways too."
    } ]
  }, {
    "tStartMs": 812430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Videos like PFAS or Monsanto"
    } ]
  }, {
    "tStartMs": 814530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "might make big companies mad at us."
    } ]
  }, {
    "tStartMs": 816690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So we've only been able\nto make those videos now,"
    } ]
  }, {
    "tStartMs": 818970,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "because we have access to a legal team"
    } ]
  }, {
    "tStartMs": 821010,
    "dDurationMs": 1313,
    "segs": [ {
      "utf8": "who can properly advise us."
    } ]
  }, {
    "tStartMs": 822323,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "You can run things past the legal team,"
    } ]
  }, {
    "tStartMs": 824400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "but just see like, are\nwe allowed to say this?"
    } ]
  }, {
    "tStartMs": 825990,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So I mean, it just, it's\nexpanded our capability."
    } ]
  }, {
    "tStartMs": 828420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "You know, the goal of improving"
    } ]
  }, {
    "tStartMs": 830130,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the level of critical thinking\nin the world is a big one,"
    } ]
  }, {
    "tStartMs": 833100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but on my own, I tackled\nit almost exclusively"
    } ]
  }, {
    "tStartMs": 835980,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "by making YouTube videos."
    } ]
  }, {
    "tStartMs": 837690,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I didn't have the time or\nbandwidth for anything else."
    } ]
  }, {
    "tStartMs": 841290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But with more people and resources,"
    } ]
  }, {
    "tStartMs": 843270,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "we have expanded our approach."
    } ]
  }, {
    "tStartMs": 845400,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "We're now launching videos regularly"
    } ]
  }, {
    "tStartMs": 847050,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "on TikTok and Instagram,"
    } ]
  }, {
    "tStartMs": 848550,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and we're making original\nShorts for YouTube."
    } ]
  }, {
    "tStartMs": 851400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "We have dubbed our most successful videos"
    } ]
  }, {
    "tStartMs": 853320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "into languages like\nIndonesian, Thai, Vietnamese,"
    } ]
  }, {
    "tStartMs": 856440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Arabic, and Turkish,"
    } ]
  }, {
    "tStartMs": 857760,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "in addition to maintaining\ndedicated channels"
    } ]
  }, {
    "tStartMs": 860190,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "in other languages."
    } ]
  }, {
    "tStartMs": 861660,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Every week we are publishing"
    } ]
  }, {
    "tStartMs": 863100,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "a free science newsletter."
    } ]
  }, {
    "tStartMs": 864810,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And we just kickstarted a\nscience trivia board game"
    } ]
  }, {
    "tStartMs": 867360,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "with over 11,000 backers."
    } ]
  }, {
    "tStartMs": 869790,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Other projects like podcasts"
    } ]
  }, {
    "tStartMs": 871440,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and additional channels are in the works."
    } ]
  }, {
    "tStartMs": 874500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Now, some of these things\nmay not appeal to you,"
    } ]
  }, {
    "tStartMs": 876750,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and that's fine, but I\nhope you agree with me"
    } ]
  }, {
    "tStartMs": 879600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that the world is better off"
    } ]
  }, {
    "tStartMs": 881370,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "with more rigorously\nproduced science content."
    } ]
  }, {
    "tStartMs": 884910,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "You know, all our facts\nare checked internally,"
    } ]
  }, {
    "tStartMs": 887400,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and we also use multiple\nexperts with every video."
    } ]
  }, {
    "tStartMs": 890490,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "We run it past them to make\nsure we get everything right."
    } ]
  }, {
    "tStartMs": 893130,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "We also post early versions\nto our Patreon supporters"
    } ]
  }, {
    "tStartMs": 895920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "who graciously help us catch mistakes."
    } ]
  }, {
    "tStartMs": 898380,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "If we ever mess up, and I know it happens,"
    } ]
  }, {
    "tStartMs": 901320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "well please let us know."
    } ]
  }, {
    "tStartMs": 902730,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I welcome your constructive criticism."
    } ]
  }, {
    "tStartMs": 905460,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "I want you to help us improve."
    } ]
  }, {
    "tStartMs": 909000,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "As for me, I have been\nable to reduce my workload"
    } ]
  }, {
    "tStartMs": 912360,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and spend more time with my now four kids."
    } ]
  }, {
    "tStartMs": 916020,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "This summer, we traveled\naround the Azores, Iceland,"
    } ]
  }, {
    "tStartMs": 921420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "biked around Amsterdam,"
    } ]
  }, {
    "tStartMs": 923580,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and visited my family in Vancouver."
    } ]
  }, {
    "tStartMs": 926610,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "And just last month, I finally got married"
    } ]
  }, {
    "tStartMs": 930660,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "to my brilliant, beautiful\nwife here in Portugal."
    } ]
  }, {
    "tStartMs": 933820,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 945570,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "I could not have picked a\nbetter or more patient partner"
    } ]
  }, {
    "tStartMs": 949440,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "with whom to spend the rest of my life."
    } ]
  }, {
    "tStartMs": 953820,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, am I retiring?"
    } ]
  }, {
    "tStartMs": 956130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Well, at some point I will,"
    } ]
  }, {
    "tStartMs": 958440,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but it's not exactly\nclear when that will be."
    } ]
  }, {
    "tStartMs": 961230,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "What I can tell you is that\nI won't be around as much,"
    } ]
  }, {
    "tStartMs": 964320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which you've probably already gathered"
    } ]
  }, {
    "tStartMs": 966120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "over the last year or two."
    } ]
  }, {
    "tStartMs": 967620,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "You know, in some upcoming\nvideos, I will not appear at all,"
    } ]
  }, {
    "tStartMs": 970950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "even if I'm guiding\nthings in the background."
    } ]
  }, {
    "tStartMs": 973050,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And this is to give me more\ntime to spend with my family"
    } ]
  }, {
    "tStartMs": 976800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and to read books, and exercise,"
    } ]
  }, {
    "tStartMs": 979260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and contemplate other projects."
    } ]
  }, {
    "tStartMs": 981540,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "You know, I am proud"
    } ]
  }, {
    "tStartMs": 983250,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that what started as my passion project,"
    } ]
  }, {
    "tStartMs": 986160,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "now employs dozens of people."
    } ]
  }, {
    "tStartMs": 989130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I am inspired by each\nand every one of them,"
    } ]
  }, {
    "tStartMs": 991500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and I have the utmost\nconfidence in their abilities."
    } ]
  }, {
    "tStartMs": 994320,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "You know, they're paid well and\nthey produce excellent work."
    } ]
  }, {
    "tStartMs": 998190,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "At one of our meetings,\nI walked into this room"
    } ]
  }, {
    "tStartMs": 1000860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to see all these super intelligent people"
    } ]
  }, {
    "tStartMs": 1003890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "who have taken up the mission"
    } ]
  }, {
    "tStartMs": 1005420,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "of increasing the level of\ncritical thinking in the world."
    } ]
  }, {
    "tStartMs": 1008630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And that's when it hit me"
    } ]
  }, {
    "tStartMs": 1010670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that I am no longer doing this alone."
    } ]
  }, {
    "tStartMs": 1013220,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It's no longer just one guy\npushing a boulder uphill."
    } ]
  }, {
    "tStartMs": 1016430,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, the team is like a juggernaut."
    } ]
  }, {
    "tStartMs": 1018560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They're like this train\nbarreling down the tracks"
    } ]
  }, {
    "tStartMs": 1021080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "with their own momentum."
    } ]
  }, {
    "tStartMs": 1022640,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So, I genuinely can't wait to see"
    } ]
  }, {
    "tStartMs": 1025730,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "what we're able to accomplish together."
    } ]
  }, {
    "tStartMs": 1028220,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "I hope you'll join us."
    } ]
  }, {
    "tStartMs": 1030110,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And if you have any questions\nor ideas for the channel,"
    } ]
  }, {
    "tStartMs": 1032900,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "please put them down in the comments."
    } ]
  }, {
    "tStartMs": 1035690,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "And as always, thanks for watching."
    } ]
  }, {
    "tStartMs": 1038024,
    "dDurationMs": 1817,
    "segs": [ {
      "utf8": "(techno music)"
    } ]
  }, {
    "tStartMs": 1039841,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(logo whizzing)"
    } ]
  } ]
}
