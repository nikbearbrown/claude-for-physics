  }, {
    "tStartMs": 497820,
    "dDurationMs": 2531,
    "segs": [ {
      "utf8": "Oh my God, this is insane."
    } ]
  }, {
    "tStartMs": 500351,
    "dDurationMs": 3019,
    "segs": [ {
      "utf8": "Nope, nope, nope, nope,\nnope, nope, nope, nope."
