{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 390,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- [Derek] This is the world's\nlargest rainfall simulator,"
    } ]
  }, {
    "tStartMs": 3300,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "located in Tsukuba, Japan."
    } ]
  }, {
    "tStartMs": 6377,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "Now, I know that it just looks\nlike a warehouse with a lot"
    } ]
  }, {
    "tStartMs": 8580,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "of sprinklers, but this building\nis incredibly important."
    } ]
  }, {
    "tStartMs": 15330,
    "dDurationMs": 2488,
    "segs": [ {
      "utf8": "The science conducted here\nkeeps tens of millions"
    } ]
  }, {
    "tStartMs": 17818,
    "dDurationMs": 3395,
    "segs": [ {
      "utf8": "of people safe, and it's only\nbecoming more and more vital."
    } ]
  }, {
    "tStartMs": 22410,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We were given exclusive\naccess to tour the facility,"
    } ]
  }, {
    "tStartMs": 25140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and they even let us\nexperience what it's like"
    } ]
  }, {
    "tStartMs": 26940,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to stand under the most intense rainfall"
    } ]
  }, {
    "tStartMs": 29310,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "ever recorded."
    } ]
  }, {
    "tStartMs": 30143,
    "dDurationMs": 1522,
    "segs": [ {
      "utf8": "- [Petr] This is insane."
    } ]
  }, {
    "tStartMs": 31665,
    "dDurationMs": 3925,
    "segs": [ {
      "utf8": "Nope, nope, nope, nope,\nnope, nope, nope, nope."
    } ]
  }, {
    "tStartMs": 35590,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "- Japan is a land of natural disasters."
    } ]
  }, {
    "tStartMs": 38130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Most people will think\nof earthquakes, tsunamis,"
    } ]
  }, {
    "tStartMs": 40500,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "and volcanoes, but it also\nexperiences massive typhoons,"
    } ]
  }, {
    "tStartMs": 44430,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "which are like hurricanes"
    } ]
  }, {
    "tStartMs": 45720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that pick up energy from the Pacific Ocean"
    } ]
  }, {
    "tStartMs": 47820,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "and dump meters of rain on the islands."
    } ]
  }, {
    "tStartMs": 51729,
    "dDurationMs": 3291,
    "segs": [ {
      "utf8": "Yakushima Island near the\nsouthern part of Japan is one"
    } ]
  }, {
    "tStartMs": 55020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of the wettest places on Earth,"
    } ]
  }, {
    "tStartMs": 57420,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "receiving up to 10 meters\nof rain every year."
    } ]
  }, {
    "tStartMs": 61170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "For comparison, the Amazon\nrainforest gets only"
    } ]
  }, {
    "tStartMs": 63900,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "about three meters of rain per year."
    } ]
  }, {
    "tStartMs": 65760,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "That's three times less\nthan Yakushima Island."
    } ]
  }, {
    "tStartMs": 69150,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Most of the time, rain isn't a problem."
    } ]
  }, {
    "tStartMs": 71670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The water evaporates\nor seeps into the soil"
    } ]
  }, {
    "tStartMs": 74460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and is then absorbed by plants"
    } ]
  }, {
    "tStartMs": 76260,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "or enters the underground aquifer systems."
    } ]
  }, {
    "tStartMs": 79140,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But too much rain in a short period,"
    } ]
  }, {
    "tStartMs": 81210,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "like after a typhoon can\nlead to serious problems."
    } ]
  }, {
    "tStartMs": 85410,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Problems that scientists working"
    } ]
  }, {
    "tStartMs": 86970,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "at NIED use the rainfall\nsimulator to study"
    } ]
  }, {
    "tStartMs": 90300,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "and hopefully prevent."
    } ]
  }, {
    "tStartMs": 92700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The giant warehouse is equipped"
    } ]
  }, {
    "tStartMs": 94200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "with 550 nozzles attached to the roof."
    } ]
  }, {
    "tStartMs": 97320,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The scientists can control the intensity"
    } ]
  }, {
    "tStartMs": 99270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of the rain from 15 millimeters per hour"
    } ]
  }, {
    "tStartMs": 101850,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to 300 millimeters per hour."
    } ]
  }, {
    "tStartMs": 104850,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The most rainfall ever\nmeasured in one hour occurred"
    } ]
  }, {
    "tStartMs": 107610,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "on the 22nd of June,\n1947, when 305 millimeters"
    } ]
  }, {
    "tStartMs": 112110,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "of rain fell on the\ntown of Holt, Missouri."
    } ]
  }, {
    "tStartMs": 116610,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So this warehouse can simulate\nthe most intense rainfall"
    } ]
  }, {
    "tStartMs": 119760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "anyone has ever experienced."
    } ]
  }, {
    "tStartMs": 121860,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "In a way that makes it the\nrainiest place on Earth."
    } ]
  }, {
    "tStartMs": 125430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And honestly, I'm having a good time here"
    } ]
  }, {
    "tStartMs": 127410,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "in sunny Australia."
    } ]
  }, {
    "tStartMs": 128400,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So I sent Veritasium\nproducer Petr in my stead."
    } ]
  }, {
    "tStartMs": 131940,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- They're gonna turn on\nthe rain really soon."
    } ]
  }, {
    "tStartMs": 133470,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So I'm running out to grab\nmy rain jacket, I'm ready."
    } ]
  }, {
    "tStartMs": 140399,
    "dDurationMs": 3781,
    "segs": [ {
      "utf8": "Wow, this is so much rain."
    } ]
  }, {
    "tStartMs": 144180,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "All around me, there is\nexactly 300 millimeters"
    } ]
  }, {
    "tStartMs": 148350,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of rain falling every hour."
    } ]
  }, {
    "tStartMs": 151230,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We've only turned it on\nabout five minutes ago,"
    } ]
  }, {
    "tStartMs": 153960,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and there's just so much rain."
    } ]
  }, {
    "tStartMs": 155820,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "There's already puddles, this\nis genuinely, absolutely wild."
    } ]
  }, {
    "tStartMs": 160710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I don't think I've ever\nexperienced anything"
    } ]
  }, {
    "tStartMs": 163380,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "like this before."
    } ]
  }, {
    "tStartMs": 164790,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The nozzles at the\nsimulator contain four holes"
    } ]
  }, {
    "tStartMs": 167250,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of varying diameters, so\nthey can produce raindrops"
    } ]
  }, {
    "tStartMs": 170010,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "of different sizes, and the\nsize of the raindrop affects"
    } ]
  }, {
    "tStartMs": 173100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "how fast it falls."
    } ]
  }, {
    "tStartMs": 174930,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "You've likely experienced the kind of rain"
    } ]
  }, {
    "tStartMs": 176850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "with the big droplets that pelt your face"
    } ]
  }, {
    "tStartMs": 179040,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "or walked through a drizzle"
    } ]
  }, {
    "tStartMs": 180510,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "where small drops hover like mist."
    } ]
  }, {
    "tStartMs": 184110,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "Because the smaller the\nraindrop, the slower it falls."
    } ]
  }, {
    "tStartMs": 192690,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "There are two forces\nthat act on a raindrop,"
    } ]
  }, {
    "tStartMs": 195030,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "gravity and air resistance."
    } ]
  }, {
    "tStartMs": 196890,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And the larger raindrops\nhave a higher weight"
    } ]
  }, {
    "tStartMs": 198690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to surface area ratio,"
    } ]
  }, {
    "tStartMs": 200190,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and so they have a\nhigher terminal velocity,"
    } ]
  }, {
    "tStartMs": 202140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so they will be falling faster."
    } ]
  }, {
    "tStartMs": 204570,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "A raindrop that's one\nmillimeter in diameter falls"
    } ]
  }, {
    "tStartMs": 207090,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "at only about two meters per second,"
    } ]
  }, {
    "tStartMs": 209520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "while a three millimeter raindrop falls"
    } ]
  }, {
    "tStartMs": 211560,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "at six meters per second."
    } ]
  }, {
    "tStartMs": 213441,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "Air resistance is also why\nraindrops aren't shaped"
    } ]
  }, {
    "tStartMs": 216480,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "like cartoon raindrops."
    } ]
  }, {
    "tStartMs": 218040,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "They are closer to spherical,"
    } ]
  }, {
    "tStartMs": 219570,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but a bit flatter on the bottom"
    } ]
  }, {
    "tStartMs": 221280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where they encounter oncoming air."
    } ]
  }, {
    "tStartMs": 223440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "If a raindrop gets too big,"
    } ]
  }, {
    "tStartMs": 224820,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "it flattens out, caves in in the middle"
    } ]
  }, {
    "tStartMs": 227190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and briefly resembles a little parachute"
    } ]
  }, {
    "tStartMs": 229590,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "before it breaks up into smaller droplets."
    } ]
  }, {
    "tStartMs": 234930,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Flooding is something that\nJapan takes very seriously"
    } ]
  }, {
    "tStartMs": 237810,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and for good reason."
    } ]
  }, {
    "tStartMs": 239250,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "In July, 2018, there were\nfloods all over the country"
    } ]
  }, {
    "tStartMs": 242490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "due to the rainfall\nfrom Typhoon Prapiroon."
    } ]
  }, {
    "tStartMs": 245370,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Some regions of the country\nreceived nearly two meters"
    } ]
  }, {
    "tStartMs": 248010,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "of rain in just 10 days,"
    } ]
  }, {
    "tStartMs": 249990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and the resulting floods were enough"
    } ]
  }, {
    "tStartMs": 251250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that more than 8 million people had"
    } ]
  }, {
    "tStartMs": 252900,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to be evacuated from their homes."
    } ]
  }, {
    "tStartMs": 255720,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Over 200 people died,"
    } ]
  }, {
    "tStartMs": 258000,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and the damage to property\nfrom the flooding was more"
    } ]
  }, {
    "tStartMs": 259950,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "than 1 trillion yen, nearly $10 billion."
    } ]
  }, {
    "tStartMs": 264600,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Tokyo, the capital city of Japan,"
    } ]
  }, {
    "tStartMs": 266340,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is very vulnerable to flooding."
    } ]
  }, {
    "tStartMs": 268080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "There are more than a hundred\nrivers crisscrossing the city"
    } ]
  }, {
    "tStartMs": 270660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of nearly 40 million people."
    } ]
  }, {
    "tStartMs": 272850,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "To prevent the rivers from\noverflowing, there are pipes"
    } ]
  }, {
    "tStartMs": 275250,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and tunnels under the city leading"
    } ]
  }, {
    "tStartMs": 277020,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to an enormous water storage tank."
    } ]
  }, {
    "tStartMs": 279930,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "In October, 2019,"
    } ]
  }, {
    "tStartMs": 281550,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "typhoon Hagibis dumped over\n200 millimeters of rain"
    } ]
  }, {
    "tStartMs": 285120,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "onto the city in under 48 hours."
    } ]
  }, {
    "tStartMs": 287730,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The underground system diverted\n12 million cubic meters"
    } ]
  }, {
    "tStartMs": 291240,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "of water and prevented an\nestimated $1.7 billion in damage."
    } ]
  }, {
    "tStartMs": 297600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But flooding isn't the only problem."
    } ]
  }, {
    "tStartMs": 300240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Japan is a very mountainous\ncountry with many towns"
    } ]
  }, {
    "tStartMs": 303240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and villages situated in valleys."
    } ]
  }, {
    "tStartMs": 305670,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "So combined with the heavy rainfall,"
    } ]
  }, {
    "tStartMs": 307040,
    "dDurationMs": 3313,
    "segs": [ {
      "utf8": "this creates the perfect\nconditions for another hazard."
    } ]
  }, {
    "tStartMs": 329152,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(man screaming)"
    } ]
  }, {
    "tStartMs": 341329,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "The researchers at NIED have\nidentified over 700,000 places"
    } ]
  }, {
    "tStartMs": 345210,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "where landslides are a\nsignificant threat to homes."
    } ]
  }, {
    "tStartMs": 349470,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But landslides are so complicated."
    } ]
  }, {
    "tStartMs": 351750,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "There are so many factors"
    } ]
  }, {
    "tStartMs": 353220,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that affect if a landslide will occur,"
    } ]
  }, {
    "tStartMs": 355530,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "how large it could be,\nhow fast it will move,"
    } ]
  }, {
    "tStartMs": 357930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and how much damage it will do."
    } ]
  }, {
    "tStartMs": 360240,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Not just the slope angle\nor the amount of new rain,"
    } ]
  }, {
    "tStartMs": 363420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but the type of soil,\nthe minerals present,"
    } ]
  }, {
    "tStartMs": 366150,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and the vegetation growing\non top of the slope."
    } ]
  }, {
    "tStartMs": 370050,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "This is footage from a landslide"
    } ]
  }, {
    "tStartMs": 371670,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that occurred in Norway in June of 2020."
    } ]
  }, {
    "tStartMs": 374370,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "There's barely any slope angle here,"
    } ]
  }, {
    "tStartMs": 376830,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "but the whole area sits\non a layer of quick clay,"
    } ]
  }, {
    "tStartMs": 380010,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "an incredibly unstable clay\nlayer, which when exposed"
    } ]
  }, {
    "tStartMs": 382890,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to intense rainfall loses\nits structural integrity,"
    } ]
  }, {
    "tStartMs": 385980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "becoming a liquid."
    } ]
  }, {
    "tStartMs": 387570,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "In the case of this landslide,\nthere were no casualties,"
    } ]
  }, {
    "tStartMs": 390450,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "though several homes\nwere swept out to sea."
    } ]
  }, {
    "tStartMs": 393390,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The complexity of the physics"
    } ]
  }, {
    "tStartMs": 394830,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of landslides is why the work done"
    } ]
  }, {
    "tStartMs": 396720,
