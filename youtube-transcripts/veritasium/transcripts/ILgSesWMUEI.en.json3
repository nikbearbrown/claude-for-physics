{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- Ever since the invention\nof nuclear weapons,"
    } ]
  }, {
    "tStartMs": 2160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "humanity has almost\naccidentally destroyed itself"
    } ]
  }, {
    "tStartMs": 5340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "many times over."
    } ]
  }, {
    "tStartMs": 6870,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "This is a video about\njust some of those times."
    } ]
  }, {
    "tStartMs": 10269,
    "dDurationMs": 981,
    "segs": [ {
      "utf8": "(rocket whooshing)"
    } ]
  }, {
    "tStartMs": 11250,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It's about nuclear bombs"
    } ]
  }, {
    "tStartMs": 12690,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "and missiles accidentally detonating."
    } ]
  }, {
    "tStartMs": 15960,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "It's about hydrogen bombs being lost."
    } ]
  }, {
    "tStartMs": 19890,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And it's about false\nalarms that could have led"
    } ]
  }, {
    "tStartMs": 22710,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "to the end of the world."
    } ]
  }, {
    "tStartMs": 24620,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "(bomb rumbling)"
    } ]
  }, {
    "tStartMs": 27990,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "On the 17th of January, 1966,"
    } ]
  }, {
    "tStartMs": 30870,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "a B-52 bomber was flying\nover the coast of Spain."
    } ]
  }, {
    "tStartMs": 35160,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It was carrying four hydrogen bombs,"
    } ]
  }, {
    "tStartMs": 38250,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "each one 75 times more powerful"
    } ]
  }, {
    "tStartMs": 41220,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "than the bomb dropped on Hiroshima."
    } ]
  }, {
    "tStartMs": 44310,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This sounds crazy, but in the mid 1960s,"
    } ]
  }, {
    "tStartMs": 47100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "during the height of the Cold War,"
    } ]
  }, {
    "tStartMs": 48720,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "this was routine."
    } ]
  }, {
    "tStartMs": 50910,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "This was part of a military\noperation known as Chrome Dome"
    } ]
  }, {
    "tStartMs": 54840,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "where bombers flew\naround the United States"
    } ]
  }, {
    "tStartMs": 57300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and skirted the borders\nof the Soviet Union"
    } ]
  }, {
    "tStartMs": 59760,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "with hydrogen bombs on board."
    } ]
  }, {
    "tStartMs": 62280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The thinking was that if the\nUSSR initiated a first strike,"
    } ]
  }, {
    "tStartMs": 66120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the US could rapidly retaliate"
    } ]
  }, {
    "tStartMs": 68010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "by having bombers already up in the air"
    } ]
  }, {
    "tStartMs": 70590,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and closer to their targets."
    } ]
  }, {
    "tStartMs": 72960,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The flight took off from North Carolina"
    } ]
  }, {
    "tStartMs": 75090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and crossed the Atlantic Ocean"
    } ]
  }, {
    "tStartMs": 77010,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "with the plan to fly by the\nborder of the Soviet Union"
    } ]
  }, {
    "tStartMs": 79770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and return home."
    } ]
  }, {
    "tStartMs": 81660,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The plane would be in the\nair for more than 24 hours."
    } ]
  }, {
    "tStartMs": 85260,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The flight was so long, it\nrequired two mid-air refuelings."
    } ]
  }, {
    "tStartMs": 90060,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "But long flights and mid-air\nrefuelings were commonplace."
    } ]
  }, {
    "tStartMs": 94080,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Flights like this happened every day."
    } ]
  }, {
    "tStartMs": 96840,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The first refuelling went smoothly."
    } ]
  }, {
    "tStartMs": 99660,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "After flying by the Soviet\nUnion and turning around,"
    } ]
  }, {
    "tStartMs": 102330,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the plane needed to be refuelled again."
    } ]
  }, {
    "tStartMs": 104820,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So at 10:30 a.m., over the coast of Spain,"
    } ]
  }, {
    "tStartMs": 107430,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "above the small fishing\nvillage of Palomares,"
    } ]
  }, {
    "tStartMs": 110490,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "the refuelling tanker pulled\nup in front of the B-52."
    } ]
  }, {
    "tStartMs": 114360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Larry Messinger, the pilot\nof the bomber, recalled."
    } ]
  }, {
    "tStartMs": 117210,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Larry] We came up behind the tanker"
    } ]
  }, {
    "tStartMs": 118980,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and we were going a little bit too fast."
    } ]
  }, {
    "tStartMs": 123930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "There's a procedure they\nhave where the boom operator,"
    } ]
  }, {
    "tStartMs": 126570,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "if you get in a dangerous position,"
    } ]
  }, {
    "tStartMs": 129600,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "he calls, \"Break away,\nbreak away, break away,\""
    } ]
  }, {
    "tStartMs": 132870,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and you immediately cut the\nthrottles and drop down below."
    } ]
  }, {
    "tStartMs": 136020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Well, there was no such call."
    } ]
  }, {
    "tStartMs": 138660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "We were dropping down below the tanker"
    } ]
  }, {
    "tStartMs": 141960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and all of a sudden something happened."
    } ]
  }, {
    "tStartMs": 144720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "There was an explosion of some kind."
    } ]
  }, {
    "tStartMs": 147240,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- The two planes collided."
    } ]
  }, {
    "tStartMs": 149130,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The boom arm, which held\nthe refuelling nozzle,"
    } ]
  }, {
    "tStartMs": 151860,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "hit the B-52, breaking off its left wing."
    } ]
  }, {
    "tStartMs": 155730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The resulting explosion was big enough"
    } ]
  }, {
    "tStartMs": 157740,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that it was witnessed by another B-52"
    } ]
  }, {
    "tStartMs": 160260,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which was flying a\nkilometre and a half away."
    } ]
  }, {
    "tStartMs": 163140,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "All four men on the refuelling tanker"
    } ]
  }, {
    "tStartMs": 165510,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and three of the seven on the B-52"
    } ]
  }, {
    "tStartMs": 168030,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "were killed in the accident."
    } ]
  }, {
    "tStartMs": 170640,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "The four bombs fell to earth."
    } ]
  }, {
    "tStartMs": 174420,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Each one of them had a yield\nof 1.1 megatons of TNT,"
    } ]
  }, {
    "tStartMs": 178980,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "about 75 times more powerful"
    } ]
  }, {
    "tStartMs": 181500,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "than the bomb dropped on Hiroshima."
    } ]
  }, {
    "tStartMs": 185280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "A hydrogen bomb gets most of its power"
    } ]
  }, {
    "tStartMs": 187290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "from the fusion of tritium and deuterium,"
    } ]
  }, {
    "tStartMs": 189780,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which are isotopes of\nhydrogen with extra neutrons."
    } ]
  }, {
    "tStartMs": 192570,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "When these isotopes fuse into helium,"
    } ]
  }, {
    "tStartMs": 194880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "a little bit of mass is lost,\nwhich is released as energy."
    } ]
  }, {
    "tStartMs": 198600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But it takes a tremendous amount of energy"
    } ]
  }, {
    "tStartMs": 200700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to get that reaction started,"
    } ]
  }, {
    "tStartMs": 202770,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "which is why a hydrogen bomb\nis actually three bombs in one."
    } ]
  }, {
    "tStartMs": 206580,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "A conventional bomb"
    } ]
  }, {
    "tStartMs": 207570,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "which when detonated triggers\nthe plutonium fission bomb"
    } ]
  }, {
    "tStartMs": 211020,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which then creates high enough\ntemperatures and pressures"
    } ]
  }, {
    "tStartMs": 213540,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and releases enough energetic X-rays"
    } ]
  }, {
    "tStartMs": 215850,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to trigger the fusion reaction."
    } ]
  }, {
    "tStartMs": 218340,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The conventional explosives\nin two of the four bombs"
    } ]
  }, {
    "tStartMs": 221610,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "detonated on impact."
    } ]
  }, {
    "tStartMs": 223680,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Fortunately, to trigger\nthe fission reaction,"
    } ]
  }, {
    "tStartMs": 226530,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "the explosion needs to be symmetrical."
    } ]
  }, {
    "tStartMs": 229950,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But since the conventional explosives"
    } ]
  }, {
    "tStartMs": 231600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "detonated on impact with the ground,"
    } ]
  }, {
    "tStartMs": 233370,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the shockwave wasn't symmetrical"
    } ]
  }, {
    "tStartMs": 235470,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "and so the fission and\nfusion bombs weren't set off."
    } ]
  }, {
    "tStartMs": 240210,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Unfortunately, the conventional explosive"
    } ]
  }, {
    "tStartMs": 242640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "blew up the plutonium core,"
    } ]
  }, {
    "tStartMs": 244200,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "contaminating a 2.6-square-kilometer area"
    } ]
  }, {
    "tStartMs": 247410,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "of the Spanish coastline"
    } ]
  }, {
    "tStartMs": 248670,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "with radioactive material."
    } ]
  }, {
    "tStartMs": 251580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The area is still contaminated\nwith radioactive atoms"
    } ]
  }, {
    "tStartMs": 254760,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "to this day."
    } ]
  }, {
    "tStartMs": 257910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Reporter] But after the\ncrash the villagers were told"
    } ]
  }, {
    "tStartMs": 259710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to eat no locally produced food"
    } ]
  }, {
    "tStartMs": 261630,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and there was an embargo\non it in nearby markets."
    } ]
  }, {
    "tStartMs": 264210,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "- The third bomb was found\nintact in a nearby riverbed."
    } ]
  }, {
    "tStartMs": 268140,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But the fourth bomb was missing."
    } ]
  }, {
    "tStartMs": 270660,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "- [Reporter] Somewhere out there"
    } ]
  }, {
    "tStartMs": 271797,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "off the sunny coast of southern Spain"
    } ]
  }, {
    "tStartMs": 273720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and H bomb is missing."
    } ]
  }, {
    "tStartMs": 275040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It's been missing now\nfor over three weeks."
    } ]
  }, {
    "tStartMs": 277680,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Mr. Ambassador, how was\nyour swim this morning?"
    } ]
  }, {
    "tStartMs": 279540,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Did you by any chance\nstub your toe on the bomb"
    } ]
  }, {
    "tStartMs": 281490,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "while you were out there today?"
    } ]
  }, {
    "tStartMs": 282540,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Wish I had."
    } ]
  }, {
    "tStartMs": 283500,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- 29 US Army ships were\ninvolved in the search,"
    } ]
  }, {
    "tStartMs": 286740,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and it still took 81 days"
    } ]
  }, {
    "tStartMs": 288990,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "for the bomb to finally\nbe located and recovered."
    } ]
  }, {
    "tStartMs": 291960,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I wanna say this again."
    } ]
  }, {
    "tStartMs": 293820,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "There was a hydrogen bomb that\nwas 75 times more powerful"
    } ]
  }, {
    "tStartMs": 297270,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "than the one dropped on Hiroshima,"
    } ]
  }, {
    "tStartMs": 299070,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it was missing for\nnearly three months."
    } ]
  }, {
    "tStartMs": 302490,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This is not an isolated incident."
    } ]
  }, {
    "tStartMs": 304650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It's common enough that\nthe US military has a term"
    } ]
  }, {
    "tStartMs": 307200,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "for accidents involving nuclear weapons."
    } ]
  }, {
    "tStartMs": 309510,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Reporter] The D-Day\nclock thus begun ticking"
    } ]
  }, {
    "tStartMs": 311220,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with a potential Broken Arrow message"
    } ]
  }, {
    "tStartMs": 312930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "from Nellis Air Force Base."
    } ]
  }, {
    "tStartMs": 314640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- They call them Broken Arrows."
    } ]
  }, {
    "tStartMs": 316590,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The Pentagon officially\nlists 32 such accidents"
    } ]
  }, {
    "tStartMs": 319710,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "between 1950 and 1980."
    } ]
  }, {
    "tStartMs": 321810,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Five of them occurred during\noperation Chrome Dome,"
    } ]
  }, {
    "tStartMs": 324690,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "cases when a B-52 carrying\nhydrogen bombs crashed."
    } ]
  }, {
    "tStartMs": 328980,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "In 1961, the first year\nof operation Chrome Dome,"
    } ]
  }, {
    "tStartMs": 332820,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "a B-52 had a fuel leak and it\ncrashed over North Carolina."
    } ]
  }, {
    "tStartMs": 337200,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Three members of the crew\ndied in the accident."
    } ]
  }, {
    "tStartMs": 340020,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "It was carrying two 4-megaton bombs."
    } ]
  }, {
    "tStartMs": 344280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Both bombs fell to earth."
    } ]
  }, {
    "tStartMs": 346890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "One had its parachute deploy"
    } ]
  }, {
    "tStartMs": 348780,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and it landed on the ground mostly intact."
    } ]
  }, {
    "tStartMs": 351330,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The other slammed into a\nfield and broke into pieces."
    } ]
  }, {
    "tStartMs": 355770,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The good news is that the\nconventional explosives"
    } ]
  }, {
    "tStartMs": 358230,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "did not explode,"
    } ]
  }, {
    "tStartMs": 359370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so radioactive plutonium was not strewn"
    } ]
  }, {
    "tStartMs": 361710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "all over North Carolina."
    } ]
  }, {
    "tStartMs": 363150,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The bad news"
    } ]
  }, {
    "tStartMs": 364410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "is that the conventional\nexplosives didn't explode,"
    } ]
  }, {
    "tStartMs": 366900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and so there was a chance"
    } ]
  }, {
    "tStartMs": 368400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that the hydrogen bombs could\nbe armed and ready to detonate"
    } ]
  }, {
    "tStartMs": 371520,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "with full force."
    } ]
  }, {
    "tStartMs": 372930,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Recalling the incident 52 years later,"
    } ]
  }, {
    "tStartMs": 375300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Lieutenant Jack ReVelle,"
    } ]
  }, {
    "tStartMs": 376650,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "who was responsible for the\nsafe disposal of the bomb, said."
    } ]
  }, {
    "tStartMs": 379680,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Jack] And as we started digging down,"
    } ]
  }, {
    "tStartMs": 381420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "trying to find the second bomb,"
    } ]
  }, {
    "tStartMs": 383400,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "one of my sergeants says,"
    } ]
  }, {
    "tStartMs": 385027,
    "dDurationMs": 3683,
    "segs": [ {
      "utf8": "\"Hey, Lieutenant, I found\nthe arm safe switch.\""
    } ]
  }, {
    "tStartMs": 388710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And I said, \"Great.\""
    } ]
  }, {
    "tStartMs": 390330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "He says, \"No, not great."
    } ]
  }, {
    "tStartMs": 392370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It's on arm.\""
    } ]
  }, {
    "tStartMs": 394080,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- At the time, a spokesman\nfor the Department of Defence"
    } ]
  }, {
    "tStartMs": 396570,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "said that the bombs were unarmed"
    } ]
  }, {
    "tStartMs": 398190,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and could not have accidentally exploded."
    } ]
  }, {
    "tStartMs": 400770,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But in a report declassified in 2013,"
    } ]
  }, {
    "tStartMs": 403710,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it was stated that the bomb was armed."
    } ]
  }, {
    "tStartMs": 406680,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "A single switch could have\ntriggered the detonation."
    } ]
  }, {
    "tStartMs": 412200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "By the way, the bomb is still there,"
    } ]
  }, {
    "tStartMs": 414480,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "lodged about 50 metres under the field."
    } ]
  }, {
    "tStartMs": 417810,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "After the bomb fell on the field,"
    } ]
  }, {
    "tStartMs": 419460,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "there was a flash flood,"
    } ]
  }, {
    "tStartMs": 420750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which meant that it couldn't be recovered."
    } ]
  }, {
    "tStartMs": 423150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So to make sure that no\none could dig up the bomb,"
    } ]
  }, {
    "tStartMs": 425520,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "the US military placed a 120-meter\ndiameter slab of concrete"
    } ]
  }, {
    "tStartMs": 430410,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "over the whole area."
    } ]
  }, {
    "tStartMs": 432150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "According to the Pentagon report,"
    } ]
  }, {
    "tStartMs": 433710,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "there is no detectable radiation\nand no hazard in the area,"
    } ]
  }, {
    "tStartMs": 437580,
    "dDurationMs": 3993,
    "segs": [ {
      "utf8": "but a portion of one weapon\ncontaining uranium is missing."
    } ]
  }, {
    "tStartMs": 443220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "There are dozens more events like this,"
    } ]
  }, {
    "tStartMs": 445860,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "like the plane crash\nover Greenland in 1968."
    } ]
  }, {
    "tStartMs": 449430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The four hydrogen bombs it was carrying"
    } ]
  }, {
    "tStartMs": 451380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "burned up in the fire."
    } ]
  }, {
    "tStartMs": 453180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The decontamination of\nthe surrounding area"
    } ]
  }, {
    "tStartMs": 455130,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "took four months."
    } ]
  }, {
    "tStartMs": 457350,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "That same year, the Soviet K-129 submarine"
    } ]
  }, {
    "tStartMs": 460740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "sank in the Pacific Ocean,"
    } ]
  }, {
    "tStartMs": 462240,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "killing all 98 of its crew."
    } ]
  }, {
    "tStartMs": 465060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It was also carrying\nthree nuclear warheads."
    } ]
  }, {
    "tStartMs": 468300,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Part of the submarine was\ncovertly recovered by the CIA."
    } ]
  }, {
    "tStartMs": 472950,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Another standout incident\noccurred in 1965,"
    } ]
  }, {
    "tStartMs": 475950,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "about 100 kilometres\noff the coast of Japan."
    } ]
  }, {
    "tStartMs": 479430,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "A Douglas A-4 jet carrying\nat least one hydrogen bomb"
    } ]
  }, {
    "tStartMs": 483060,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "fell off the aircraft carrier\nduring a training exercise."
    } ]
  }, {
    "tStartMs": 486630,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "The plane, the bomb, and the\npilot were never recovered."
    } ]
  }, {
    "tStartMs": 490800,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So, for more than half a century,"
    } ]
  }, {
    "tStartMs": 492750,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "there has been a 1-megaton hydrogen bomb"
    } ]
  }, {
    "tStartMs": 495690,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "laying on the sea floor"
    } ]
  }, {
    "tStartMs": 497430,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "four kilometres below\nthe surface of the ocean."
    } ]
  }, {
    "tStartMs": 501450,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It is one of at least\nsix US nuclear weapons"
    } ]
  }, {
    "tStartMs": 504570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that have been lost and never recovered."
    } ]
  }, {
    "tStartMs": 507600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "In 1998, Alexander Lebed,"
    } ]
  }, {
    "tStartMs": 509820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Russia's former Chief\nof National Security,"
    } ]
  }, {
    "tStartMs": 512340,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "asserted that there are more than 100"
    } ]
  }, {
    "tStartMs": 514830,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "1-kiloton nuclear bombs"
    } ]
  }, {
    "tStartMs": 516930,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "that are unaccounted for."
    } ]
  }, {
    "tStartMs": 519690,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The most well-known Broken Arrow event"
    } ]
  }, {
    "tStartMs": 521760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "happened in September 1980."
    } ]
  }, {
    "tStartMs": 524490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Inside a silo in rural Arkansas,"
    } ]
  }, {
    "tStartMs": 527370,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a team was conducting routine checks"
    } ]
  }, {
    "tStartMs": 529290,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "on the Titan II intercontinental\nballistic missile."
    } ]
  }, {
    "tStartMs": 532380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The missile was fueled,"
    } ]
  }, {
    "tStartMs": 533820,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "ready to launch at a moment's notice."
    } ]
  }, {
    "tStartMs": 536100,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "In its nose cone sat a\n9-megaton hydrogen bomb."
    } ]
  }, {
    "tStartMs": 541380,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "As one of the repairmen was\nwalking around the silo,"
    } ]
  }, {
    "tStartMs": 544470,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "the socket from his\nratchet wrench fell off."
    } ]
  }, {
    "tStartMs": 547707,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 553140,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It fell 24 metres,"
    } ]
  }, {
    "tStartMs": 555180,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "hitting the fuel tank of the\nmissile and puncturing a hole."
    } ]
  }, {
    "tStartMs": 560310,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The highly flammable rocket fuel"
    } ]
  }, {
    "tStartMs": 562200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "began to leak into the silo."
    } ]
  }, {
    "tStartMs": 564870,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The missile complex and\nsurrounding area were evacuated,"
    } ]
  }, {
    "tStartMs": 568140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but a number of military\npersonnel remained on site"
    } ]
  }, {
    "tStartMs": 570900,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to try to diffuse the situation."
    } ]
  }, {
    "tStartMs": 573360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- The maintenance team"
    } ]
  }, {
    "tStartMs": 575220,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "had an indication of an engine fire"
    } ]
  }, {
    "tStartMs": 577290,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and a rise in vapour\nconcentration inside the silo."
    } ]
  }, {
    "tStartMs": 582600,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- At 3:00 a.m.,"
    } ]
  }, {
    "tStartMs": 583680,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "about 8 1/2 hours after the\npuncture of the fuel tank,"
    } ]
  }, {
    "tStartMs": 587070,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "the leaking fuel vapours ignited,\nresulting in an explosion."
    } ]
  }, {
    "tStartMs": 591810,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "This explosion led to one\ndeath and 21 injuries."
    } ]
  }, {
    "tStartMs": 595890,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The 740-ton door keeping the silo sealed"
    } ]
  }, {
    "tStartMs": 599430,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "flew more than 60 metres into the air."
    } ]
  }, {
    "tStartMs": 602580,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "It was recovered 200 metres away."
    } ]
  }, {
    "tStartMs": 606120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The warhead containing the hydrogen bomb"
    } ]
  }, {
    "tStartMs": 608010,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "was also blown out of the silo,"
    } ]
  }, {
    "tStartMs": 609900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "landing some 30 metres away."
    } ]
  }, {
    "tStartMs": 612330,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "Luckily, it did not detonate."
    } ]
  }, {
    "tStartMs": 615570,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And these are just the near\nmisses that we know about."
    } ]
  }, {
    "tStartMs": 618480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Of the 32 Broken Arrow events\nlisted by the Pentagon,"
    } ]
  }, {
    "tStartMs": 621840,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "one which occurred in the spring\nof 1968 remains classified."
    } ]
  }, {
    "tStartMs": 626370,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And there are likely many\ndozens more nuclear mistakes"
    } ]
  }, {
    "tStartMs": 629610,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and near misses the\npublic knows nothing about"
    } ]
  }, {
    "tStartMs": 633180,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "from every nation that\nhas a nuclear arsenal."
    } ]
  }, {
    "tStartMs": 637530,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The worry of a nuclear mishap"
    } ]
  }, {
    "tStartMs": 639270,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is not just the immediate damage done"
    } ]
  }, {
    "tStartMs": 641370,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "by a hydrogen bomb explosion."
    } ]
  }, {
    "tStartMs": 643200,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It's also the misunderstanding"
    } ]
  }, {
    "tStartMs": 644940,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and retaliatory strikes that could arise."
    } ]
  }, {
    "tStartMs": 647610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Imagine that in 1966,"
    } ]
  }, {
    "tStartMs": 649440,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "instead of hydrogen bombs\nfalling off the coast of Spain,"
    } ]
  }, {
    "tStartMs": 652230,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the plane crash occurred closer"
    } ]
  }, {
    "tStartMs": 653820,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "to the border with the Soviet Union."
    } ]
  }, {
    "tStartMs": 657060,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "Humanity has been on the brink\nof nuclear war many times"
    } ]
  }, {
    "tStartMs": 661410,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and so far we've been lucky."
    } ]
  }, {
    "tStartMs": 664470,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "The closest we've likely\never come was in October 1962"
    } ]
  }, {
    "tStartMs": 668430,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "during the Cuban Missile Crisis."
    } ]
  }, {
    "tStartMs": 670170,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "The US Navy began dropping\nsignalling charges into the water"
    } ]
  }, {
    "tStartMs": 674040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to bring a Soviet\nsubmarine to the surface."
    } ]
  }, {
    "tStartMs": 676980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Tensions were high and the submarine"
    } ]
  }, {
    "tStartMs": 679200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "had not been in radio\ncontact with Moscow for days."
    } ]
  }, {
    "tStartMs": 682440,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The captain of the submarine\ndecided that war had broken out"
    } ]
  }, {
    "tStartMs": 685950,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and he was about to\nlaunch a nuclear torpedo."
    } ]
  }, {
    "tStartMs": 689070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But the launch required the\nauthorization of three men."
    } ]
  }, {
    "tStartMs": 692190,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Two out of the three\nauthorised the launch,"
    } ]
  }, {
    "tStartMs": 695430,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but Vasili Arkhipov did not."
    } ]
  }, {
    "tStartMs": 698280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "A full-blown nuclear exchange"
    } ]
  }, {
    "tStartMs": 699960,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "between the United States\nand the Soviet Union"
    } ]
  }, {
    "tStartMs": 702450,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "was avoided by the rational\ndecision of one person."
    } ]
  }, {
    "tStartMs": 707280,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The historian Arthur\nSchlesinger Jr. later noted"
    } ]
  }, {
    "tStartMs": 710250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that \"this was not only\nthe most dangerous moment"
    } ]
  }, {
    "tStartMs": 712830,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of the Cold War."
    } ]
  }, {
    "tStartMs": 714390,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "It was the most dangerous\nmoment in human history.\""
    } ]
  }, {
    "tStartMs": 718950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And during the Cuban Missile Crisis,"
    } ]
  }, {
    "tStartMs": 721020,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "with the tensions between the US and USSR"
    } ]
  }, {
    "tStartMs": 723370,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "at an all-time high,"
    } ]
  }, {
    "tStartMs": 725250,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "both countries still conducted\nhigh-altitude nuclear tests."
    } ]
  }, {
    "tStartMs": 729300,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The US set off a 410-kiloton bomb"
    } ]
  }, {
    "tStartMs": 732180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "50 kilometres above the Pacific Ocean"
    } ]
  }, {
    "tStartMs": 734250,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and a smaller 7-kiloton bomb"
    } ]
  }, {
    "tStartMs": 736440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at an altitude of 147 kilometres."
    } ]
  }, {
    "tStartMs": 739410,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Two of the 300 kiloton tests\nconducted by the Soviets"
    } ]
  }, {
    "tStartMs": 742530,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "occurred in space."
    } ]
  }, {
    "tStartMs": 744660,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It's pretty hard to justify these actions."
    } ]
  }, {
    "tStartMs": 747420,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "What if one of these\ntests was thought to be"
    } ]
  }, {
    "tStartMs": 749730,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "a nuclear first strike\nleading to all-out war?"
    } ]
  }, {
    "tStartMs": 753360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Because false alarms happen"
    } ]
  }, {
    "tStartMs": 755430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "for something a lot more innocuous"
    } ]
  }, {
    "tStartMs": 757530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "than nuclear tests in space."
    } ]
  }, {
    "tStartMs": 759750,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "On the 26th of September, 1983,"
    } ]
  }, {
    "tStartMs": 762090,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the Soviet satellite-based\nearly warning system"
    } ]
  }, {
    "tStartMs": 764550,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "detected the launch"
    } ]
  }, {
    "tStartMs": 765690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of an intercontinental ballistic missile,"
    } ]
  }, {
    "tStartMs": 767970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and their policy dictated"
    } ]
  }, {
    "tStartMs": 769620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that if any inbound\nmissiles were detected,"
    } ]
  }, {
    "tStartMs": 772620,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "there was to be an\nimmediate counter attack"
    } ]
  }, {
    "tStartMs": 774930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "against the United States."
    } ]
  }, {
    "tStartMs": 776700,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "This would've likely led to all-out war."
    } ]
  }, {
    "tStartMs": 779580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But the Soviet officer on duty"
    } ]
  }, {
    "tStartMs": 781410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "at the time of the\ndetection, Stanislav Petrov,"
    } ]
  }, {
    "tStartMs": 784260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "was sceptical of the reading."
    } ]
  }, {
    "tStartMs": 786000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "He reasoned that if there\nwas a genuine first strike,"
    } ]
  }, {
    "tStartMs": 788700,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "the US would launch hundreds\nof ICBMs simultaneously,"
    } ]
  }, {
    "tStartMs": 791940,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "not just one."
    } ]
  }, {
    "tStartMs": 793590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The detection system then warned Petrov"
    } ]
  }, {
    "tStartMs": 795540,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of another four missiles\nheaded towards the USSR,"
    } ]
  }, {
    "tStartMs": 798900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but these two, he dismissed as a glitch."
    } ]
  }, {
    "tStartMs": 802200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Petrov was right."
    } ]
  }, {
    "tStartMs": 803640,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "He made the right decision"
    } ]
  }, {
    "tStartMs": 804750,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and his clear thinking likely\nsaved millions of lives."
    } ]
  }, {
    "tStartMs": 808500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The warning system malfunctioned,"
    } ]
  }, {
    "tStartMs": 810000,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "it confused sunlight reflecting\noff high-altitude clouds"
    } ]
  }, {
    "tStartMs": 813480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for ballistic missiles."
    } ]
  }, {
    "tStartMs": 815400,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "After this incident,"
    } ]
  }, {
    "tStartMs": 816360,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Petrov took an early retirement"
    } ]
  }, {
    "tStartMs": 818130,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "and later suffered a nervous breakdown."
    } ]
  }, {
    "tStartMs": 822390,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Another close call happened\non January 25th, 1995,"
    } ]
  }, {
    "tStartMs": 826050,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "when scientists launched a\nrocket off the coast of Norway."
    } ]
  }, {
    "tStartMs": 829380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Their rocket was there to\nstudy the Northern Lights"
    } ]
  }, {
    "tStartMs": 832020,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but Russian radar picked up this launch"
    } ]
  }, {
    "tStartMs": 834000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "as it had a similar\nflight pattern and speed"
    } ]
  }, {
    "tStartMs": 836700,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "as the submarine-launched Trident ICBM."
    } ]
  }, {
    "tStartMs": 839970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The incident was serious enough"
    } ]
  }, {
    "tStartMs": 841770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that a briefcase containing\nthe nuclear launch codes"
    } ]
  }, {
    "tStartMs": 844110,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "was taken to the Russian\nPresident, Boris Yeltsin."
    } ]
  }, {
    "tStartMs": 848430,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I think most people believe"
    } ]
  }, {
    "tStartMs": 849930,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the biggest threat\nposed by nuclear weapons"
    } ]
  }, {
    "tStartMs": 852090,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "is their deliberate use."
    } ]
  }, {
    "tStartMs": 854280,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "There is this idea that as\nlong as nations only have them"
    } ]
  }, {
    "tStartMs": 857010,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and don't use them,"
    } ]
  }, {
    "tStartMs": 858390,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "they could act as a\ndeterrent keeping us safer."
    } ]
  }, {
    "tStartMs": 861360,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But all of these incidents demonstrate"
    } ]
  }, {
    "tStartMs": 863700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that the real risk of nuclear weapons"
    } ]
  }, {
    "tStartMs": 866040,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "is some freak accident."
    } ]
  }, {
    "tStartMs": 869130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So far, humanity has been lucky,"
    } ]
  }, {
    "tStartMs": 871380,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "but how long until our luck runs out?"
    } ]
  }, {
    "tStartMs": 876870,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But there is hope."
    } ]
  }, {
    "tStartMs": 878580,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "In 1986, there were more\nthan 70,000 nuclear weapons."
    } ]
  }, {
    "tStartMs": 882960,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "In 2022, that number\nhad dropped to 12,705,"
    } ]
  }, {
    "tStartMs": 887730,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "and more are being dismantled."
    } ]
  }, {
    "tStartMs": 891390,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But as long as there are any\nnuclear weapons remaining,"
    } ]
  }, {
    "tStartMs": 894180,
    "dDurationMs": 3047,
    "segs": [ {
      "utf8": "the future of humanity is not safe."
    } ]
  }, {
    "tStartMs": 897227,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(electronic beeping)"
    } ]
  }, {
    "tStartMs": 901804,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "Hey, this part of the\nvideo is brought to you"
    } ]
  }, {
    "tStartMs": 903570,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "by Henson Shaving."
    } ]
  }, {
    "tStartMs": 905310,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Close shaves are bad when\nit comes to nuclear weapons"
    } ]
  }, {
    "tStartMs": 908040,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "but they're great when\nit comes to shaving."
    } ]
  }, {
    "tStartMs": 912000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Henson is a company that was\nstarted by aerospace machinists"
    } ]
  }, {
    "tStartMs": 915240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "who wanted to use their experience"
    } ]
  }, {
    "tStartMs": 917160,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "in precision manufacturing"
    } ]
  }, {
    "tStartMs": 918690,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to create a better shaving experience."
    } ]
  }, {
    "tStartMs": 921150,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And honestly, I think they've succeeded."
    } ]
  }, {
    "tStartMs": 924000,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I've been using their AL13\nfor the past few months"
    } ]
  }, {
    "tStartMs": 926880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and it's the best shave I've ever had."
    } ]
  }, {
    "tStartMs": 929490,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The razor is made using CNC machines"
    } ]
  }, {
    "tStartMs": 931800,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "with incredibly tight tolerances,"
    } ]
  }, {
    "tStartMs": 933570,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "so the blade sticks out\njust .03 millimetres."
    } ]
  }, {
    "tStartMs": 937590,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This means that the blade\nis perfectly supported"
    } ]
  }, {
    "tStartMs": 940140,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "which reduces chatter,"
    } ]
  }, {
    "tStartMs": 941580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the up and down movement of the blade."
    } ]
  }, {
    "tStartMs": 944130,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "This reduction in chatter\nreduces skin irritation."
    } ]
  }, {
    "tStartMs": 947520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "In fact, Henson conducted a test"
    } ]
  }, {
    "tStartMs": 949350,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "where participants shaved\nthe left part of their face"
    } ]
  }, {
    "tStartMs": 951900,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "with a multi-blade razor"
    } ]
  }, {
    "tStartMs": 953160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and the right part with the AL13,"
    } ]
  }, {
    "tStartMs": 955500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and they saw a statistically\nsignificant reduction"
    } ]
  }, {
    "tStartMs": 958320,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "in skin irritation when\nthe Henson razor was used."
    } ]
  }, {
    "tStartMs": 961740,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The AL13 is really high quality"
    } ]
  }, {
    "tStartMs": 964140,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and it uses standard double-edged blades"
    } ]
  }, {
    "tStartMs": 966240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "which are much less expensive"
    } ]
  }, {
    "tStartMs": 967800,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "than the proprietary blades\nsold by other companies."
    } ]
  }, {
    "tStartMs": 970740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So, once you own a Henson razor,"
    } ]
  }, {
    "tStartMs": 972570,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "the cost of shaving works out\nto be just 3 to $5 per year,"
    } ]
  }, {
    "tStartMs": 976770,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "depending on how often you shave."
    } ]
  }, {
    "tStartMs": 978900,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And because you're not\nthrowing away all that plastic,"
    } ]
  }, {
    "tStartMs": 981120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "it's also much better for the environment."
    } ]
  }, {
    "tStartMs": 983430,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So, if you'd like to have\na better shaving experience"
    } ]
  }, {
    "tStartMs": 985950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "while saving money and\nhelping the environment,"
    } ]
  }, {
    "tStartMs": 988710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "head on over to HensonShaving.com"
    } ]
  }, {
    "tStartMs": 991410,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and enter code Veritasium\nfor 100 free blades"
    } ]
  }, {
    "tStartMs": 994440,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with the purchase of a razor."
    } ]
  }, {
    "tStartMs": 996150,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I wanna thank Henson for\nsponsoring this part of the video"
    } ]
  }, {
    "tStartMs": 998970,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
