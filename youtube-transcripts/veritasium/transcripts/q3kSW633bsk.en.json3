{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 30,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "By the end of this video, one of these three high school seniors"
    } ]
  }, {
    "tStartMs": 3440,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "will be awarded two hundred and fifty thousand dollars for their original scientific research"
    } ]
  }, {
    "tStartMs": 8720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "now the way this went down was, Regeneron the sponsor of this video,"
    } ]
  }, {
    "tStartMs": 12080,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "invited me out to Washington DC for the awards gala of the Regeneron Science Talent Search"
    } ]
  }, {
    "tStartMs": 17280,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "this is the nation's oldest and most prestigious science and math competition for high school seniors"
    } ]
  }, {
    "tStartMs": 22400,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "founded and produced by Society for Science \u0026 the Public"
    } ]
  }, {
    "tStartMs": 25560,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Here the 40 finalists were honored and the top 10 winners announced"
    } ]
  }, {
    "tStartMs": 29680,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "now they couldn't tell me who was going to win because not even they knew beforehand"
    } ]
  }, {
    "tStartMs": 34560,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "and that's because the students are judged not only on the strength of their projects but also on interviews"
    } ]
  }, {
    "tStartMs": 40120,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "where they are asked very challenging questions about a wide range of scientific topics"
    } ]
  }, {
    "tStartMs": 45320,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "so I selected three students to follow and find out more about their projects"
    } ]
  }, {
    "tStartMs": 49520,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "just to be clear these were not the top three place winners they are students I picked in advance"
    } ]
  }, {
    "tStartMs": 55120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but it just so happened that I picked the winner"
    } ]
  }, {
    "tStartMs": 58720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "so can you pick the winner?"
    } ]
  }, {
    "tStartMs": 60600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "let's meet the candidates"
    } ]
  }, {
    "tStartMs": 62480,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Ronak Roy redesigned the Phoroptor"
    } ]
  }, {
    "tStartMs": 65640,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "that's the device used to determine eyeglass prescriptions"
    } ]
  }, {
    "tStartMs": 69040,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "it contains dozens of precision glass lenses making it bulky, heavy, expensive"
    } ]
  }, {
    "tStartMs": 74880,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "and a design that hasn't really changed in two hundred years"
    } ]
  }, {
    "tStartMs": 77960,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "I wanted to make something that you know could could fit the greater than half the Earth's population"
    } ]
  }, {
    "tStartMs": 83280,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "who you know can't just you know drive down to an optometrist office and just get a prescription"
    } ]
  }, {
    "tStartMs": 88600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "so can we see it?"
    } ]
  }, {
    "tStartMs": 90000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "oh yeah absolutely"
    } ]
  }, {
    "tStartMs": 91440,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "so this is this is my child here"
    } ]
  }, {
    "tStartMs": 94040,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "this is this is the portable Phoroptor"
    } ]
  }, {
    "tStartMs": 97920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "as you can see it has the the liquid lens"
    } ]
  }, {
    "tStartMs": 100720,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "that is actually the one responsible for replacing the dozens of precisely machine lenses here"
    } ]
  }, {
    "tStartMs": 107280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "so how does this liquid lens work"
    } ]
  }, {
    "tStartMs": 109360,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Right. So it has a droplet of a polar substance like water"
    } ]
  }, {
    "tStartMs": 113720,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "And a droplet of a non-polar substance like like a mineral oil"
    } ]
  }, {
    "tStartMs": 117520,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "when you apply a voltage across of it"
    } ]
  }, {
    "tStartMs": 119720,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "the voltage will cause the polar substance to actually change its shape"
    } ]
  }, {
    "tStartMs": 123480,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and go hug or repel the surfaces of the lens"
    } ]
  }, {
    "tStartMs": 127000,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "so by changing the shape of the bubble you change the way light refracts through it"
    } ]
  }, {
    "tStartMs": 130680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "as it passes through that the two glass windows"
    } ]
  }, {
    "tStartMs": 133080,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and therefore you know you're changing the focal length of the lens"
    } ]
  }, {
    "tStartMs": 136000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "you you made an app?"
    } ]
  }, {
    "tStartMs": 137360,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "yeah I did"
    } ]
  }, {
    "tStartMs": 138120,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "so the screen you're looking at which is runs on an app on my smartphone"
    } ]
  }, {
    "tStartMs": 142320,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "displays a test chart and runs an algorithm to actually do the refraction"
    } ]
  }, {
    "tStartMs": 146320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "I mean those are pretty small letters"
    } ]
  }, {
    "tStartMs": 147960,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "those three static glass lenses are able to make it so the light coming from the phone"
    } ]
  }, {
    "tStartMs": 152520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "are projected to a virtual distance of that twenty feet"
    } ]
  }, {
    "tStartMs": 155880,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "so it's basically simulating that that test room but you know optically instead"
    } ]
  }, {
    "tStartMs": 161600,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "so the way it works is there's an algorithm running on the smartphone app"
    } ]
  }, {
    "tStartMs": 165800,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "that generates pairs of lens voltages for the patient to compare"
    } ]
  }, {
    "tStartMs": 169800,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "and in order to switch between the two lens voltages the patient can click a button on a pair of headphones"
    } ]
  }, {
    "tStartMs": 174920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "so you can click once to toggle between the two"
    } ]
  }, {
    "tStartMs": 177720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and once you've found which of the two is the best"
    } ]
  }, {
    "tStartMs": 181240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "okay that's better"
    } ]
  }, {
    "tStartMs": 182240,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "all right so you can double click it"
    } ]
  }, {
    "tStartMs": 183960,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "and it will you know indicate to the algorithm that it indeed is the best and generate the next pair"
    } ]
  }, {
    "tStartMs": 189200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "yeah I think it got worse"
    } ]
  }, {
    "tStartMs": 190640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "yeah um so..."
    } ]
  }, {
    "tStartMs": 191960,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "And I'm gonna click?"
    } ]
  }, {
    "tStartMs": 192800,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Uh.. Yeah"
    } ]
  }, {
    "tStartMs": 193640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Okay that's better but it's not the best I've seen"
    } ]
  }, {
    "tStartMs": 196400,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "the algorithm will basically cycle through this lens voltage pair generation process"
    } ]
  }, {
    "tStartMs": 201520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "this is like night and day. Like, it's not like it's not even a question"
    } ]
  }, {
    "tStartMs": 204800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "until it zeros in on on the one voltage that works the best for you"
    } ]
  }, {
    "tStartMs": 208560,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "okay okay that or... Oh yes"
    } ]
  }, {
    "tStartMs": 213240,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Test complete"
    } ]
  }, {
    "tStartMs": 214080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "all right awesome would you like to know"
    } ]
  }, {
    "tStartMs": 216160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I would love to know what my eyesight is like"
    } ]
  }, {
    "tStartMs": 218240,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "all right so I calculated negative 1.25 diopters"
    } ]
  }, {
    "tStartMs": 222600,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "um which is roughly in the range that most people with slight nearsightedness would have"
    } ]
  }, {
    "tStartMs": 228520,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Ana Humphrey wanted to find hidden exoplanets with math"
    } ]
  }, {
    "tStartMs": 232480,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "the Kepler space telescope has been the most prolific planet finder to date"
    } ]
  }, {
    "tStartMs": 237240,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "detecting over 2,000 exoplanets by measuring a dip in their host stars brightness when they pass in front of it"
    } ]
  }, {
    "tStartMs": 243400,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "but what happens if the planet passes just above or just below the star"
    } ]
  }, {
    "tStartMs": 248320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Also, what if that planet is really small?"
    } ]
  }, {
    "tStartMs": 251040,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "those little tiny shadows are really hard to pull out and you've got a lot of noise"
    } ]
  }, {
    "tStartMs": 255120,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "a further challenge is that the Kepler mission only ran for four years"
    } ]
  }, {
    "tStartMs": 259040,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "that means our absolute limit is it's really hard to find anything that takes longer than four years to orbit"
    } ]
  }, {
    "tStartMs": 264320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "To identify planets Kepler might have missed,"
    } ]
  }, {
    "tStartMs": 266520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Ana looked at existing multi planetary systems"
    } ]
  }, {
    "tStartMs": 269400,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and calculated whether additional planets could fit in between the ones we observed"
    } ]
  }, {
    "tStartMs": 273800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "without disturbing their orbits"
    } ]
  }, {
    "tStartMs": 275800,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "I imagine that you already have some sort of planets here"
    } ]
  }, {
    "tStartMs": 280760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "so we're going to call this planet X"
    } ]
  }, {
    "tStartMs": 282840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "so what are these two lines?"
    } ]
  }, {
    "tStartMs": 284360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "this line here is the same as this outer line"
    } ]
  }, {
    "tStartMs": 287400,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "it's how close your imaginary planet can get to your outer planet"
    } ]
  }, {
    "tStartMs": 292040,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and this line here is your a-x-min"
    } ]
  }, {
    "tStartMs": 296240,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "so it's how close your imaginary planet can get to your inner planet so it's this line here"
    } ]
  }, {
    "tStartMs": 301600,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "we have this region of stability given the extremes of where we can put a planet"
    } ]
  }, {
    "tStartMs": 307120,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and we have the maximum mass you can fit there"
    } ]
  }, {
    "tStartMs": 310560,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and anything in this area here"
    } ]
  }, {
    "tStartMs": 314160,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "sort of shade around our label"
    } ]
  }, {
    "tStartMs": 316040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "anything between these two graphs"
    } ]
  }, {
    "tStartMs": 318600,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "is a combination of a planet's mass and a location of the planet"
    } ]
  }, {
    "tStartMs": 322760,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "that we could fit in between the two we know about and maintain a stable system"
    } ]
  }, {
    "tStartMs": 326720,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "cool"
    } ]
  }, {
    "tStartMs": 327600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "yeah"
    } ]
  }, {
    "tStartMs": 328400,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "Now the question everyone will ask you is like what's to say that this planet really exists"
    } ]
  }, {
    "tStartMs": 334200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "as opposed to you just making up stuff?"
    } ]
  }, {
    "tStartMs": 336040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So the assumption that I made going into my research"
    } ]
  }, {
    "tStartMs": 338480,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "was that systems are going to try to have as many planets packed in as possible"
    } ]
  }, {
    "tStartMs": 343640,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "this is called the packed planetary system hypothesis"
    } ]
  }, {
    "tStartMs": 346360,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "there are 560 locations where we could fit additional planets"
    } ]
  }, {
    "tStartMs": 350280,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "so quite a few"
    } ]
  }, {
    "tStartMs": 352400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "how might we go about actually finding them?"
    } ]
  }, {
    "tStartMs": 354680,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "One of the ways you could go about doing this is by doing something called folding the data"
    } ]
  }, {
    "tStartMs": 359720,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "so let's say we figure out that a planet should have an orbital period of about one month"
    } ]
  }, {
    "tStartMs": 365160,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "we have a year's worth of data and we fold that data in twelve and get it to line up just right"
    } ]
  }, {
    "tStartMs": 370400,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "we can get it so those transit signals actually layer on top of each other"
    } ]
  }, {
    "tStartMs": 374440,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and then we get a larger signal as a that you know we can find"
    } ]
  }, {
    "tStartMs": 379320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "as opposed to the really small signals that sort of get lost in the noise"
    } ]
  }, {
    "tStartMs": 382920,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Do you want to introduce yourself? What's your name, what do you do?"
    } ]
  }, {
    "tStartMs": 384040,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "Sure"
    } ]
  }, {
    "tStartMs": 385360,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Yeah. My name is Anjali Chadha."
    } ]
  }, {
    "tStartMs": 387680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "I am a senior at DuPont Manual High School in Louisville, Kentucky"
    } ]
  }, {
    "tStartMs": 391600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "What is.. this?"
    } ]
  }, {
    "tStartMs": 393840,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That"
    } ]
  }, {
    "tStartMs": 395800,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Anjali was concerned with dangerous contaminants in drinking water"
    } ]
  }, {
    "tStartMs": 399960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "this is a prototype of my arsenic sensor"
    } ]
  }, {
    "tStartMs": 402440,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "so you want to load a water sample right here in this compartment"
    } ]
  }, {
    "tStartMs": 406760,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "the whole process starts with an automated chemical reaction"
    } ]
  }, {
    "tStartMs": 409840,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "so there are a bunch of chemical reagents that sit in this compartment above the water sample"
    } ]
  }, {
    "tStartMs": 414760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "so the first reagent is tartaric acid"
    } ]
  }, {
    "tStartMs": 417160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "next is a combination of salts it's called mono potassium sulfate"
    } ]
  }, {
    "tStartMs": 421080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and the third is zinc"
    } ]
  }, {
    "tStartMs": 423040,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Arsenic is an element that's never found freely but it's always bound to other elements"
    } ]
  }, {
    "tStartMs": 427560,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "so basically that chemical reaction will help to free up all of the arsenic"
    } ]
  }, {
    "tStartMs": 432200,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "and then the arsenic content changes into a gaseous form of arsine gas"
    } ]
  }, {
    "tStartMs": 437280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and that's the best detectable form of arsenic basically"
    } ]
  }, {
    "tStartMs": 440800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "so what happens after that gas is formed"
    } ]
  }, {
    "tStartMs": 443840,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "is that there is a test strip and it's covered in mercury bromide"
    } ]
  }, {
    "tStartMs": 447480,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "which oxidizes in response to the arsenic and then changes color"
    } ]
  }, {
    "tStartMs": 451720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So it's actually on a gradient scale."
    } ]
  }, {
    "tStartMs": 453880,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "If there's very little arsenic content then it just changes to a light color"
    } ]
  }, {
    "tStartMs": 457400,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "and if there's a lot changes a dark color and everything in between"
    } ]
  }, {
    "tStartMs": 460480,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "right so what I then did was write an image processing algorithm"
    } ]
  }, {
    "tStartMs": 464560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "using some embedded electronic devices"
    } ]
  }, {
    "tStartMs": 467840,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "specifically this device called an ArduCAM it's just an embedded camera"
    } ]
  }, {
    "tStartMs": 472920,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "and essentially the camera takes a picture of that test strip after it's changed color"
    } ]
  }, {
    "tStartMs": 478200,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "it then pulls out all of the color values of the test strip"
    } ]
  }, {
    "tStartMs": 482560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and converts them into concentration data"
    } ]
  }, {
    "tStartMs": 485200,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "so I wrote some mathematical models that kind of made that conversion"
    } ]
  }, {
    "tStartMs": 489120,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "and then the last kind of piece of the puzzle is that there is this device"
    } ]
  }, {
    "tStartMs": 493280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it's a microcontroller called a particle electron"
    } ]
  }, {
    "tStartMs": 495680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and it's connected to this cellular antenna"
    } ]
  }, {
    "tStartMs": 497960,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "so that the data is instantaneously transmitted to the cloud"
    } ]
  }, {
    "tStartMs": 501040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the real advantages of that is that"
    } ]
  }, {
    "tStartMs": 503200,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "several people would be able to access the data collected from one sensor"
    } ]
  }, {
    "tStartMs": 507040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "whether it's people in the same community"
    } ]
  }, {
    "tStartMs": 508960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "who want to kind of have that information and knowledge about their water sources"
    } ]
  }, {
    "tStartMs": 512880,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "or whether it's people in research organizations who are trying to really learn more"
    } ]
  }, {
    "tStartMs": 517440,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "learn what to test learn what to improve and what sites to really work on"
    } ]
  }, {
    "tStartMs": 521120,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "so those are kind of the reasons why I chose to do that"
    } ]
  }, {
    "tStartMs": 524840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So now the moment of truth"
    } ]
  }, {
    "tStartMs": 526840,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "which one of these high school students will win two hundred and fifty thousand dollars?"
    } ]
  }, {
    "tStartMs": 531960,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "now I should point out that all 40 finalists each receive at least $25,000,"
    } ]
  }, {
    "tStartMs": 536200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the top ten receiving more than that"
    } ]
  }, {
    "tStartMs": 539080,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "the first-place winner and recipient of a 250 thousand dollar award..."
    } ]
  }, {
    "tStartMs": 547520,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "from TC Williams High School in Alexandria, Virginia Ana Humphrey"
    } ]
  }, {
    "tStartMs": 565580,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "congratulations to Ana Humphrey on winning this year's Regeneron Science Talent Search"
    } ]
  }, {
    "tStartMs": 572560,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "if you know any bright American high school students please consider sending them this video"
    } ]
  }, {
    "tStartMs": 577440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "it could be their turn next up on that stage"
    } ]
  }, {
    "tStartMs": 580640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and if you are an American high school student,"
    } ]
  }, {
    "tStartMs": 583120,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "think about these numbers:"
    } ]
  }, {
    "tStartMs": 584600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "around 3.6 million students graduate high school in the US each year"
    } ]
  }, {
    "tStartMs": 588600,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "but only 2,000 or so applied the Regeneron Science Talent Search"
    } ]
  }, {
    "tStartMs": 593040,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "that means if you enter your science research project you have a 1 in 50 shot of winning at least $25,000"
    } ]
  }, {
    "tStartMs": 599640,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "I mean when else in high school do you get the opportunity to get such a financial boost"
    } ]
  }, {
    "tStartMs": 603880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and receive recognition for your ability in science and math"
    } ]
  }, {
    "tStartMs": 607160,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "this opportunity could literally be life-changing"
    } ]
  }, {
    "tStartMs": 610160,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "so take the next step click the link in the description and sign up to receive updates about the competition"
    } ]
  }, {
    "tStartMs": 616040,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "entries are open to all American high school seniors for next year starting June 1st"
    } ]
  }, {
    "tStartMs": 620800,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "and good luck"
    } ]
  }, {
    "tStartMs": 622440,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Now a little epilogue about Ana"
    } ]
  }, {
    "tStartMs": 625040,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "you know I asked her what inspired her to pursue this research in the first place"
    } ]
  }, {
    "tStartMs": 629080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and she told me"
    } ]
  }, {
    "tStartMs": 630360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "researchers at Caltech had predicted this ninth planet"
    } ]
  }, {
    "tStartMs": 633400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "do you know what the researchers names were?"
    } ]
  }, {
    "tStartMs": 635240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Mike Brown and Konstantin Batygin. I always mess up his last name"
    } ]
  }, {
    "tStartMs": 639280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "So I took her work and showed it to Konstantin Batygin"
    } ]
  }, {
    "tStartMs": 643200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "when i first looked at this,"
    } ]
  }, {
    "tStartMs": 646200,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "I was blown away by the fact that this was a high school student"
    } ]
  }, {
    "tStartMs": 650680,
    "dDurationMs": 6760,
    "segs": [ {
      "utf8": "Right, I mean this is this is done at the very least at the level of a senior undergraduate"
    } ]
  }, {
    "tStartMs": 657440,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "maybe a graduate level student"
    } ]
  }, {
    "tStartMs": 659400,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Right? I mean, it's a PhD level student"
    } ]
  }, {
    "tStartMs": 661590,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "and finally when I was watching the black hole press conference the other morning,"
    } ]
  }, {
    "tStartMs": 665440,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "we have seen and taken a picture of a black hole"
    } ]
  }, {
    "tStartMs": 674960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "who should be in the audience asking a question?"
    } ]
  }, {
    "tStartMs": 678160,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Ana Humphrey. It's like science is in her blood."
    } ]
  }, {
    "tStartMs": 681400,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "I expect to see much more in the future from this very talented young scientist"
    } ]
  }, {
    "tStartMs": 685680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Congrats again, Ana"
    } ]
  } ]
}
