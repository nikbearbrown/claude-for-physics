{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 600,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- In 1928, a young man shuffled\nonto a stage in Germany"
    } ]
  }, {
    "tStartMs": 3840,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to present a lecture on his recent work."
    } ]
  }, {
    "tStartMs": 6420,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "He had a slightly unusual\npresentation style."
    } ]
  }, {
    "tStartMs": 9600,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Physicist Eugene Wigner described\nthe lecture as detached,"
    } ]
  }, {
    "tStartMs": 12810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "almost like a recitation\nof a technical text."
    } ]
  }, {
    "tStartMs": 15420,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "He said, \"The man spoke"
    } ]
  }, {
    "tStartMs": 16530,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "without giving any sign of\nenjoying his own lecture.\""
    } ]
  }, {
    "tStartMs": 20040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But the work this strange\nunassuming man presented"
    } ]
  }, {
    "tStartMs": 22380,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "was about to send some of the\nmost famous quantum physicists"
    } ]
  }, {
    "tStartMs": 25110,
    "dDurationMs": 1549,
    "segs": [ {
      "utf8": "of the 20th century spiraling."
    } ]
  }, {
    "tStartMs": 26659,
    "dDurationMs": 1571,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 28230,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "After the lecture,"
    } ]
  }, {
    "tStartMs": 29190,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "Werner Heisenberg described\nthe man's theory as,"
    } ]
  }, {
    "tStartMs": 31447,
    "dDurationMs": 2453,
    "segs": [ {
      "utf8": "\"The saddest chapter in modern physics.\""
    } ]
  }, {
    "tStartMs": 33900,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "Heisenberg also wrote\nto Niels Bohr and said,"
    } ]
  }, {
    "tStartMs": 35887,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "\"I find the present situation quite absurd"
    } ]
  }, {
    "tStartMs": 38130,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and, on that account,\nalmost out of despair,"
    } ]
  }, {
    "tStartMs": 40560,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I have taken up another field.\""
    } ]
  }, {
    "tStartMs": 42660,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Legend has it that Wolfgang Pauli"
    } ]
  }, {
    "tStartMs": 44220,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "even announced that he was\nabandoning quantum physics,"
    } ]
  }, {
    "tStartMs": 46920,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and then he started\nwriting a utopian novel."
    } ]
  }, {
    "tStartMs": 50370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "What had the young man said"
    } ]
  }, {
    "tStartMs": 51810,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to disrupt the world of quantum\nmechanics so profoundly?"
    } ]
  }, {
    "tStartMs": 55320,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But he had been working on a problem"
    } ]
  }, {
    "tStartMs": 56850,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that physicists are still tackling today."
    } ]
  }, {
    "tStartMs": 59250,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The unification of Einstein's relativity"
    } ]
  }, {
    "tStartMs": 61590,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and quantum mechanics,"
    } ]
  }, {
    "tStartMs": 63120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and his work had revealed\nsomething troubling,"
    } ]
  }, {
    "tStartMs": 65640,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "a particle unlike any scene in the world,"
    } ]
  }, {
    "tStartMs": 68743,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "a particle with negative energy."
    } ]
  }, {
    "tStartMs": 71203,
    "dDurationMs": 2597,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 73800,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "In 1905,"
    } ]
  }, {
    "tStartMs": 74910,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Albert Einstein published his\nspecial theory of relativity."
    } ]
  }, {
    "tStartMs": 78060,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It was based on the simple idea"
    } ]
  }, {
    "tStartMs": 79620,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that for anyone moving\nwith constant speed,"
    } ]
  }, {
    "tStartMs": 82170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the laws of physics should be the same,"
    } ]
  }, {
    "tStartMs": 84000,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and this includes any measurement\nof the speed of light."
    } ]
  }, {
    "tStartMs": 87210,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So, it doesn't matter how you're moving"
    } ]
  }, {
    "tStartMs": 88860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "relative to a beam of light,"
    } ]
  }, {
    "tStartMs": 90480,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "you should measure its speed"
    } ]
  }, {
    "tStartMs": 91800,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to be 300 million meters per second."
    } ]
  }, {
    "tStartMs": 94470,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This means that things that we\nordinarily think of as fixed,"
    } ]
  }, {
    "tStartMs": 97380,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "like time and space, have to transform,"
    } ]
  }, {
    "tStartMs": 99990,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "so that the speed of light"
    } ]
  }, {
    "tStartMs": 101190,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "is always measured to have the same value."
    } ]
  }, {
    "tStartMs": 103500,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "In making this discovery,"
    } ]
  }, {
    "tStartMs": 104541,
    "dDurationMs": 1989,
    "segs": [ {
      "utf8": "Einstein realized that space and time"
    } ]
  }, {
    "tStartMs": 106530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "are not really separate dimensions at all."
    } ]
  }, {
    "tStartMs": 108600,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "They're linked in a\nfour-dimensional fabric"
    } ]
  }, {
    "tStartMs": 110970,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "called spacetime."
    } ]
  }, {
    "tStartMs": 111803,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 113130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "When Einstein applied this idea\nto an object emitting light,"
    } ]
  }, {
    "tStartMs": 115890,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "he found something peculiar."
    } ]
  }, {
    "tStartMs": 118200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "When an object loses\nenergy by emitting photons,"
    } ]
  }, {
    "tStartMs": 120630,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "its mass must also decrease,"
    } ]
  }, {
    "tStartMs": 123090,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and the change in the object's mass"
    } ]
  }, {
    "tStartMs": 124530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is equal to the energy\nof the photons emitted"
    } ]
  }, {
    "tStartMs": 126870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "divided by the speed of light squared."
    } ]
  }, {
    "tStartMs": 129630,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In other words,"
    } ]
  }, {
    "tStartMs": 130463,
    "dDurationMs": 3577,
    "segs": [ {
      "utf8": "he found that energy must\nbe equal to mc squared."
    } ]
  }, {
    "tStartMs": 134040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "E equals mc squared."
    } ]
  }, {
    "tStartMs": 136740,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Einstein] Mass and energy"
    } ]
  }, {
    "tStartMs": 138030,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "are but different manifestations\nof the same thing."
    } ]
  }, {
    "tStartMs": 142590,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- So, a particle's total\nenergy comes from its momentum"
    } ]
  }, {
    "tStartMs": 145710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and its rest mass,"
    } ]
  }, {
    "tStartMs": 147270,
    "dDurationMs": 3092,
    "segs": [ {
      "utf8": "giving it new relationship\nbetween energy and momentum."
    } ]
  }, {
    "tStartMs": 150362,
    "dDurationMs": 1438,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 151800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Now, if we take the\nsquare root of both sides,"
    } ]
  }, {
    "tStartMs": 153420,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "we get an expression for\nthe energy of a particle"
    } ]
  }, {
    "tStartMs": 155550,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in terms of its mass and momentum."
    } ]
  }, {
    "tStartMs": 157530,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And if we plot energy versus\nmomentum in a single dimension,"
    } ]
  }, {
    "tStartMs": 160380,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "we get this curve, where mc squared,"
    } ]
  }, {
    "tStartMs": 162810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the rest mass energy of the object,"
    } ]
  }, {
    "tStartMs": 164580,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "is the lowest possible value for energy."
    } ]
  }, {
    "tStartMs": 167550,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But really, when we took the square root,"
    } ]
  }, {
    "tStartMs": 169530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "we should have put a plus/minus out front,"
    } ]
  }, {
    "tStartMs": 171750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "which would give us two curves:"
    } ]
  }, {
    "tStartMs": 173340,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "one for positive energies and\nanother for negative energies."
    } ]
  }, {
    "tStartMs": 177570,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But we don't observe things\nthat have energy less than 0."
    } ]
  }, {
    "tStartMs": 181050,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I mean, what would that even mean?"
    } ]
  }, {
    "tStartMs": 183630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So, in classical physics,\nthe solution is simple."
    } ]
  }, {
    "tStartMs": 186180,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "You just ignore the\nnegative energy solutions."
    } ]
  }, {
    "tStartMs": 188640,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "They can't physically represent\nanything, right, Casper?"
    } ]
  }, {
    "tStartMs": 192840,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Well, sure, that sounds right."
    } ]
  }, {
    "tStartMs": 194220,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But around the same time that Einstein"
    } ]
  }, {
    "tStartMs": 195960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "was coming up with his\nspecial theory of relativity,"
    } ]
  }, {
    "tStartMs": 198390,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "physicists began observing\nsome strange phenomena"
    } ]
  }, {
    "tStartMs": 201180,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "in atomic physics"
    } ]
  }, {
    "tStartMs": 202350,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "that were overthrowing all of\nthese classical assumptions."
    } ]
  }, {
    "tStartMs": 205770,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "First of all,"
    } ]
  }, {
    "tStartMs": 206603,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "they noticed that when\nlooking at the energy levels"
    } ]
  }, {
    "tStartMs": 208320,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of subatomic particles, like electrons,"
    } ]
  }, {
    "tStartMs": 210600,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "they weren't continuous at\nall, they were discrete."
    } ]
  }, {
    "tStartMs": 213630,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And they also didn't just behave\nas particles, but as waves."
    } ]
  }, {
    "tStartMs": 217080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So, if you would take electrons"
    } ]
  }, {
    "tStartMs": 218640,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and fire them through two narrow slits,"
    } ]
  }, {
    "tStartMs": 220620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "then they would create\ninterference patterns,"
    } ]
  }, {
    "tStartMs": 222480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "just like light does."
    } ]
  }, {
    "tStartMs": 223980,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "What they were discovering"
    } ]
  }, {
    "tStartMs": 224940,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "was the new field of quantum mechanics."
    } ]
  }, {
    "tStartMs": 226981,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 228390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And in 1926, Erwin Schrodinger\nformalized this field"
    } ]
  }, {
    "tStartMs": 231630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "by coming up with his\nnow-famous wave equation,"
    } ]
  }, {
    "tStartMs": 233880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which describes how\nquantum mechanical systems"
    } ]
  }, {
    "tStartMs": 236460,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "evolve over time."
    } ]
  }, {
    "tStartMs": 238740,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- This was the most radical\nnew theory of the 20th century,"
    } ]
  }, {
    "tStartMs": 243810,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "and would remain so."
    } ]
  }, {
    "tStartMs": 244800,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "This is not a bit like\nNewton or a bit like Maxwell."
    } ]
  }, {
    "tStartMs": 248430,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "This was radically new."
    } ]
  }, {
    "tStartMs": 251100,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Casper] The equation solution,"
    } ]
  }, {
    "tStartMs": 252420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "called the wave function, psi,"
    } ]
  }, {
    "tStartMs": 254130,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "does not describe a particle\nwith a precise position"
    } ]
  }, {
    "tStartMs": 256950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and momentum as classical laws would."
    } ]
  }, {
    "tStartMs": 259140,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But instead, the modular squared\ncan give us the probability"
    } ]
  }, {
    "tStartMs": 262110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of finding the particle\nin a specific location"
    } ]
  }, {
    "tStartMs": 264270,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "at a specific time."
    } ]
  }, {
    "tStartMs": 265560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- Deriving the Schrodinger equation"
    } ]
  }, {
    "tStartMs": 267180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "is actually surprisingly simple."
    } ]
  }, {
    "tStartMs": 269340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Just start by writing\ndown the total energy,"
    } ]
  }, {
    "tStartMs": 272010,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "which, for a free particle,\nis just its kinetic energy,"
    } ]
  }, {
    "tStartMs": 275297,
    "dDurationMs": 1753,
    "segs": [ {
      "utf8": "1/2 mv squared."
    } ]
  }, {
    "tStartMs": 277050,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And we can rewrite it\nin terms of momentum,"
    } ]
  }, {
    "tStartMs": 279570,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "mass times velocity."
    } ]
  }, {
    "tStartMs": 281040,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So kinetic energy is just\nmomentum squared divided by 2m."
    } ]
  }, {
    "tStartMs": 286230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Now, we're going to make this quantum,"
    } ]
  }, {
    "tStartMs": 288570,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and to do that, we need two things."
    } ]
  }, {
    "tStartMs": 290460,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The first is the wave function, psi,"
    } ]
  }, {
    "tStartMs": 292620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which describes how particles act as waves"
    } ]
  }, {
    "tStartMs": 295080,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "at quantum scales."
    } ]
  }, {
    "tStartMs": 296490,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And the second is something\ncalled a quantum operator."
    } ]
  }, {
    "tStartMs": 299880,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "This is just a mathematical tool"
    } ]
  }, {
    "tStartMs": 301432,
    "dDurationMs": 3158,
    "segs": [ {
      "utf8": "that extracts information\nfrom the wave function"
    } ]
  }, {
    "tStartMs": 304590,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to reveal a specific\nproperty of the particle,"
    } ]
  }, {
    "tStartMs": 306810,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "like its position, energy, or momentum."
    } ]
  }, {
    "tStartMs": 309870,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "The operators for energy\nand momentum look like this."
    } ]
  }, {
    "tStartMs": 314160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "By inputting these operators,"
    } ]
  }, {
    "tStartMs": 316080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "we can make each side of the equation"
    } ]
  }, {
    "tStartMs": 317880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "act on the wave function,"
    } ]
  }, {
    "tStartMs": 319920,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and that gives us the Schrodinger equation"
    } ]
  }, {
    "tStartMs": 321810,
    "dDurationMs": 1165,
    "segs": [ {
      "utf8": "for a free particle."
    } ]
  }, {
    "tStartMs": 322975,
    "dDurationMs": 1475,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 324450,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "For particles that aren't\nfree, like electrons in atoms,"
    } ]
  }, {
    "tStartMs": 327180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you need to factor in\npotential energy, too,"
    } ]
  }, {
    "tStartMs": 329520,
    "dDurationMs": 2155,
    "segs": [ {
      "utf8": "which gives you the full\nSchrodinger equation."
    } ]
  }, {
    "tStartMs": 331675,
    "dDurationMs": 1265,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 332940,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- But there are some places"
    } ]
  }, {
    "tStartMs": 334200,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "where it doesn't produce\nthe right prediction."
    } ]
  }, {
    "tStartMs": 336660,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "For example, take the element gold."
    } ]
  }, {
    "tStartMs": 338910,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "The Schrodinger equation"
    } ]
  }, {
    "tStartMs": 339960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "suggests that it should\nbe a silver gray color,"
    } ]
  }, {
    "tStartMs": 342660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "just like all the other metals."
    } ]
  }, {
    "tStartMs": 344010,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But it's not, I mean, it's gold."
    } ]
  }, {
    "tStartMs": 345900,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And for mercury, the Schrodinger equation"
    } ]
  }, {
    "tStartMs": 348120,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "predicts that it should be\na solid at room temperature,"
    } ]
  }, {
    "tStartMs": 351150,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "but it's a liquid."
    } ]
  }, {
    "tStartMs": 352260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So, what is wrong?"
    } ]
  }, {
    "tStartMs": 353580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Well, I'll give you a hint,"
    } ]
  }, {
    "tStartMs": 354930,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "because both gold and\nmercury are heavy elements."
    } ]
  }, {
    "tStartMs": 358290,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] They have a\nhigh number of protons"
    } ]
  }, {
    "tStartMs": 359940,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in their nuclei,"
    } ]
  }, {
    "tStartMs": 360773,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "which attract orbiting\nelectrons more strongly."
    } ]
  }, {
    "tStartMs": 363030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So, if you're thinking\nin a classical sense,"
    } ]
  }, {
    "tStartMs": 365070,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the electrons would be bound tighter in,"
    } ]
  }, {
    "tStartMs": 368010,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and they'd be whizzing\naround at higher speeds"
    } ]
  }, {
    "tStartMs": 370350,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "than in other elements."
    } ]
  }, {
    "tStartMs": 371850,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And for electrons in some orbits,"
    } ]
  }, {
    "tStartMs": 373830,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "those speeds start to\nget a little too close"
    } ]
  }, {
    "tStartMs": 376073,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "to the speed of light."
    } ]
  }, {
    "tStartMs": 377325,
    "dDurationMs": 945,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 378270,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So, let's go back to the\nSchrodinger equation."
    } ]
  }, {
    "tStartMs": 380490,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "There, we had the kinetic\nenergy was p squared over 2m."
    } ]
  }, {
    "tStartMs": 384090,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But for particles moving\nat relativistic speeds"
    } ]
  }, {
    "tStartMs": 386310,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "close to the speed of light,"
    } ]
  }, {
    "tStartMs": 387390,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that equation isn't the right one."
    } ]
  }, {
    "tStartMs": 389700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The correct equation is the\nenergy momentum relation"
    } ]
  }, {
    "tStartMs": 392160,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "from special relativity."
    } ]
  }, {
    "tStartMs": 394170,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Schrodinger's equation is not consistent"
    } ]
  }, {
    "tStartMs": 396630,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with the theory of relativity, so it's..."
    } ]
  }, {
    "tStartMs": 398340,
    "dDurationMs": 1271,
    "segs": [ {
      "utf8": "Technically, it's not right."
    } ]
  }, {
    "tStartMs": 399611,
    "dDurationMs": 1756,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 401367,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "- So, the solution seems simple enough."
    } ]
  }, {
    "tStartMs": 403770,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Just start with the relativistic\nenergy momentum relation"
    } ]
  }, {
    "tStartMs": 406440,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "and use that to derive\na new wave equation."
    } ]
  }, {
    "tStartMs": 408820,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Well, this is exactly"
    } ]
  }, {
    "tStartMs": 411600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "what a physicist named\nOskar Klein did in 1926."
    } ]
  }, {
    "tStartMs": 414780,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "He subbed in the same energy"
    } ]
  }, {
    "tStartMs": 415887,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "and momentum operators\nthat Schrodinger used,"
    } ]
  }, {
    "tStartMs": 418140,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "and found this equation."
    } ]
  }, {
    "tStartMs": 419597,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 421800,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Klein's work was pretty well-received"
    } ]
  }, {
    "tStartMs": 423510,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "by a number of his colleagues."
    } ]
  }, {
    "tStartMs": 424920,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "In fact, it turned out\nthe two other physicists,"
    } ]
  }, {
    "tStartMs": 427050,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Walter Gordon and Vladimir Fock,"
    } ]
  }, {
    "tStartMs": 429150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "had independently arrived\nat the same equation"
    } ]
  }, {
    "tStartMs": 431520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in that same year."
    } ]
  }, {
    "tStartMs": 433020,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It became known as the\nKlein-Gordon equation,"
    } ]
  }, {
    "tStartMs": 435840,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "which was a bit of a burn for Fock."
    } ]
  }, {
    "tStartMs": 438162,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "(graphic whooshing)"
    } ]
  }, {
    "tStartMs": 439432,
    "dDurationMs": 1208,
    "segs": [ {
      "utf8": "(graphic twinkling)"
    } ]
  }, {
    "tStartMs": 440640,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But that's often how it goes."
    } ]
  }, {
    "tStartMs": 442290,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "You do all the hard work\nand then no one notices."
    } ]
  }, {
    "tStartMs": 445350,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Things have changed a\nlittle since Fock's time,"
    } ]
  }, {
    "tStartMs": 447810,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but the key to recognition\nis still visibility."
    } ]
  }, {
    "tStartMs": 450570,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And these days, that\nmeans having a website."
    } ]
  }, {
    "tStartMs": 453720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Simple enough,"
    } ]
  }, {
    "tStartMs": 454553,
    "dDurationMs": 2827,
    "segs": [ {
      "utf8": "you just need to write a\ncouple thousand lines of CSS,"
    } ]
  }, {
    "tStartMs": 457380,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "JavaScript, or HTML,"
    } ]
  }, {
    "tStartMs": 459360,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "or else pay someone a few\nthousand dollars to do it for you."
    } ]
  }, {
    "tStartMs": 462630,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Oh, and then there's the hosting\ncosts and the maintenance."
    } ]
  }, {
    "tStartMs": 466260,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Or you could check out\ntoday's sponsor, Hostinger."
    } ]
  }, {
    "tStartMs": 469440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Not only will they get\nyour website online,"
    } ]
  }, {
    "tStartMs": 471540,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "their intuitive tools let\nyou build it yourself."
    } ]
  }, {
    "tStartMs": 474060,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "There's no need to learn\nmultiple coding languages."
    } ]
  }, {
    "tStartMs": 476490,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The Hostinger builder can\nget you most of the way there"
    } ]
  }, {
    "tStartMs": 479160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "with just one prompt."
    } ]
  }, {
    "tStartMs": 480660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "You can optimize the website"
    } ]
  }, {
    "tStartMs": 482010,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "with their built-in tools for SEO rating,"
    } ]
  }, {
    "tStartMs": 484350,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "logo design, and e-commerce."
    } ]
  }, {
    "tStartMs": 486270,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And once you're happy,\nyou're online immediately"
    } ]
  }, {
    "tStartMs": 488700,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "on a domain that's included with the plan."
    } ]
  }, {
    "tStartMs": 491010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "That whole process is\nfast and straightforward,"
    } ]
  }, {
    "tStartMs": 493590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and a subscription is just\na few dollars a month."
    } ]
  }, {
    "tStartMs": 496530,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So, sign up now to get an\n85% discount in the sale"
    } ]
  }, {
    "tStartMs": 500010,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and use the code VERITASIUM\nfor an extra 10% off."
    } ]
  }, {
    "tStartMs": 504030,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Just scan this QR code"
    } ]
  }, {
    "tStartMs": 505560,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or follow the link in the\ndescription to get started."
    } ]
  }, {
    "tStartMs": 508140,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "I wanna thank Hostinger"
    } ]
  }, {
    "tStartMs": 509160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "for sponsoring this part of the video."
    } ]
  }, {
    "tStartMs": 511260,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And now, back to Klein, Gordon, and Fock."
    } ]
  }, {
    "tStartMs": 515759,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "The Klein-Gordon-Fock equation\neven made its way over"
    } ]
  }, {
    "tStartMs": 518700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to one of the fathers of\nquantum physics, Niels Bohr,"
    } ]
  }, {
    "tStartMs": 521460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "who must have been impressed,"
    } ]
  }, {
    "tStartMs": 522840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "because at the 1927 Solvay Conference,"
    } ]
  }, {
    "tStartMs": 525030,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Bohr was chatting to a\npromising young physicist"
    } ]
  }, {
    "tStartMs": 527190,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "about what he was working on."
    } ]
  }, {
    "tStartMs": 528480,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "The young man said,"
    } ]
  }, {
    "tStartMs": 529597,
    "dDurationMs": 3053,
    "segs": [ {
      "utf8": "\"I'm trying to get a relativistic\ntheory of the electron.\""
    } ]
  }, {
    "tStartMs": 532650,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Bohr replied, \"But Klein has\nalready solved this problem.\""
    } ]
  }, {
    "tStartMs": 535740,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The young man disagreed."
    } ]
  }, {
    "tStartMs": 537840,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "So, who was this bold 25-year-old?"
    } ]
  }, {
    "tStartMs": 541200,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "He was Paul Dirac,"
    } ]
  }, {
    "tStartMs": 542460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "a man who Bohr would\nlater give the nickname"
    } ]
  }, {
    "tStartMs": 544410,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "The Strangest Man because\nhe was truly one of a kind."
    } ]
  }, {
    "tStartMs": 548040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- First time I went to Princeton,"
    } ]
  }, {
    "tStartMs": 549240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I met a couple who invited\nDirac and his wife."
    } ]
  }, {
    "tStartMs": 553080,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And Dirac, for the whole meal,\nwhich lasted three hours,"
    } ]
  }, {
    "tStartMs": 556470,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "didn't say a single word."
    } ]
  }, {
    "tStartMs": 559800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Not one word."
    } ]
  }, {
    "tStartMs": 561420,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "He wasn't sulky, he wasn't angry."
    } ]
  }, {
    "tStartMs": 563760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "He just saw no reason to speak."
    } ]
  }, {
    "tStartMs": 566130,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- That's crazy."
    } ]
  }, {
    "tStartMs": 567600,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Derek] Dirac was a man of so few words"
    } ]
  }, {
    "tStartMs": 569670,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that his colleagues invented\na special unit, a Dirac,"
    } ]
  }, {
    "tStartMs": 573120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "equivalent to speaking one word per hour."
    } ]
  }, {
    "tStartMs": 575820,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Legend also has it that he liked to relax"
    } ]
  }, {
    "tStartMs": 578220,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "by climbing trees in three-piece suits."
    } ]
  }, {
    "tStartMs": 580680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And that wasn't his only strange hobby."
    } ]
  }, {
    "tStartMs": 583350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "As a student, Dirac had attended seminars"
    } ]
  }, {
    "tStartMs": 585360,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "on Einstein's theory of relativity,"
    } ]
  }, {
    "tStartMs": 587190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and he'd kind of fallen in love with it."
    } ]
  }, {
    "tStartMs": 589650,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "He was impressed by the elegance"
    } ]
  }, {
    "tStartMs": 591210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and beauty of its mathematics."
    } ]
  }, {
    "tStartMs": 592770,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "To Dirac, this got to the core"
    } ]
  }, {
    "tStartMs": 594360,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of what a good theory must do."
    } ]
  }, {
    "tStartMs": 596280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "He once said, \"It is more important"
    } ]
  }, {
    "tStartMs": 598080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to have beauty in one's equations"
    } ]
  }, {
    "tStartMs": 599670,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "than to have them fit experiment.\""
    } ]
  }, {
    "tStartMs": 601393,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 603660,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- [Casper] Do you know why Dirac\nwas so drawn to relativity?"
    } ]
  }, {
    "tStartMs": 606870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- Einstein went in there and did it all..."
    } ]
  }, {
    "tStartMs": 609240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Not all, but almost all\nby deductive reasoning."
    } ]
  }, {
    "tStartMs": 612000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That made a huge\nimpression on Dirac, right?"
    } ]
  }, {
    "tStartMs": 615240,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "He realized that it was\nadvanced mathematics"
    } ]
  }, {
    "tStartMs": 618990,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "was really important"
    } ]
  }, {
    "tStartMs": 620640,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to understanding the\nway that nature works."
    } ]
  }, {
    "tStartMs": 623370,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- So, Dirac found a new hobby,"
    } ]
  }, {
    "tStartMs": 625380,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "obsessively updating classical equations"
    } ]
  }, {
    "tStartMs": 627690,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "with Einstein's theory of relativity,"
    } ]
  }, {
    "tStartMs": 629880,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "so that they would now work"
    } ]
  }, {
    "tStartMs": 631020,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "for relative physics scenarios as well"
    } ]
  }, {
    "tStartMs": 632790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that are those approaching\nthe speed of light."
    } ]
  }, {
    "tStartMs": 635340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "He later said this was\nlike a game for him,"
    } ]
  }, {
    "tStartMs": 637680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and so it's maybe not too\nmuch of a surprise then"
    } ]
  }, {
    "tStartMs": 640260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that he was one of the people"
    } ]
  }, {
    "tStartMs": 641580,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "trying to unite quantum\nphysics and relativity"
    } ]
  }, {
    "tStartMs": 644700,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "because a theory that\nwould cover both of these"
    } ]
  }, {
    "tStartMs": 647370,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "would be truly beautiful in his eyes."
    } ]
  }, {
    "tStartMs": 650880,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Dirac didn't see the beauty"
    } ]
  }, {
    "tStartMs": 652230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "in Klein, Gordon, and\nFock's relativistic update"
    } ]
  }, {
    "tStartMs": 654480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "of the Schrodinger equation,"
    } ]
  }, {
    "tStartMs": 655830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and he wasn't alone."
    } ]
  }, {
    "tStartMs": 657420,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Fellow physicist, Wolfgang Pauli,"
    } ]
  }, {
    "tStartMs": 658920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "after reading Klein's\npaper, wrote him a letter,"
    } ]
  }, {
    "tStartMs": 660870,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "wishing his physics a speedy recovery."
    } ]
  }, {
    "tStartMs": 663090,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Pauli was known for being pretty savage."
    } ]
  }, {
    "tStartMs": 665580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And actually, the Klein-Gordon equation"
    } ]
  }, {
    "tStartMs": 667380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "is useful in some cases,"
    } ]
  }, {
    "tStartMs": 669240,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "but he and Dirac were both concerned"
    } ]
  }, {
    "tStartMs": 671040,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "with one particular\nfeature of the equation."
    } ]
  }, {
    "tStartMs": 674430,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- And that's because the\nKlein-Gordon equation"
    } ]
  }, {
    "tStartMs": 676560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "contains this term."
    } ]
  }, {
    "tStartMs": 677640,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "That's a second-order time derivative."
    } ]
  }, {
    "tStartMs": 679470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So the wave function is\nbeing differentiated twice"
    } ]
  }, {
    "tStartMs": 681900,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "with respect to time."
    } ]
  }, {
    "tStartMs": 683280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Now, remember, the Schrodinger equation"
    } ]
  }, {
    "tStartMs": 685020,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "also contains a second-order derivative,"
    } ]
  }, {
    "tStartMs": 687210,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but that's with space, not with time."
    } ]
  }, {
    "tStartMs": 689190,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Time is just first-order."
    } ]
  }, {
    "tStartMs": 690780,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So, why is this such a problem?"
    } ]
  }, {
    "tStartMs": 692340,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Well, think of a very simple\nsecond-order time derivative."
    } ]
  }, {
    "tStartMs": 695520,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Something like d squared y over dt squared"
    } ]
  }, {
    "tStartMs": 699180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "is equal to 3."
    } ]
  }, {
    "tStartMs": 701400,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Now, to figure out what y is,"
    } ]
  }, {
    "tStartMs": 702780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the function that satisfies this equation,"
    } ]
  }, {
    "tStartMs": 704550,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "we just have to integrate it twice."
    } ]
  }, {
    "tStartMs": 706401,
    "dDurationMs": 4479,
    "segs": [ {
      "utf8": "(pensive music)\n(record scratching)"
    } ]
  }, {
    "tStartMs": 710880,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But notice, to find the solution,"
    } ]
  }, {
    "tStartMs": 712680,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "we now two integration constants, c and D."
    } ]
  }, {
    "tStartMs": 716850,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And the problem is that\nwe can only find that"
    } ]
  }, {
    "tStartMs": 719400,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "if we know both y at a given time"
    } ]
  }, {
    "tStartMs": 722850,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and if we know the first\nderivative of y at a given time."
    } ]
  }, {
    "tStartMs": 726210,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "This makes sense physically,"
    } ]
  }, {
    "tStartMs": 727530,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "if you think about, say,\nthrowing a ball in the air."
    } ]
  }, {
    "tStartMs": 730080,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If you want to predict\nthe ball's future motion,"
    } ]
  }, {
    "tStartMs": 732420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "well, then, you need to know\nwhere you threw it from,"
    } ]
  }, {
    "tStartMs": 734580,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "that's its position,"
    } ]
  }, {
    "tStartMs": 735960,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "and how hard you threw\nit, that's its velocity."
    } ]
  }, {
    "tStartMs": 739620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Or in other words, you need\nto know both the position"
    } ]
  }, {
    "tStartMs": 742200,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "and the first derivative of the position."
    } ]
  }, {
    "tStartMs": 744391,
    "dDurationMs": 1859,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 746250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Similarly, to predict a\nquantum systems future state"
    } ]
  }, {
    "tStartMs": 748530,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "using the Klein-Gordon equation,"
    } ]
  }, {
    "tStartMs": 750000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you'd need the initial wave function"
    } ]
  }, {
    "tStartMs": 751440,
    "dDurationMs": 2371,
    "segs": [ {
      "utf8": "and the initial first\nderivative of the wave function."
    } ]
  }, {
    "tStartMs": 753811,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 755580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Now, the beauty of the\nSchrodinger equation"
    } ]
  }, {
    "tStartMs": 757560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "was that if you knew only\nthe wave function of a system"
    } ]
  }, {
    "tStartMs": 760200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "at a given time,"
    } ]
  }, {
    "tStartMs": 761033,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "you could use it to determine\nall the future states"
    } ]
  }, {
    "tStartMs": 763170,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of that system."
    } ]
  }, {
    "tStartMs": 764370,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But in the Klein-Gordon equation,"
    } ]
  }, {
    "tStartMs": 765900,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the wave function no longer\ntold the whole story."
    } ]
  }, {
    "tStartMs": 768750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And this introduced a further problem."
    } ]
  }, {
    "tStartMs": 770580,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The probability of finding\na particle in a given area"
    } ]
  }, {
    "tStartMs": 772950,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "could no longer be simply described"
    } ]
  }, {
    "tStartMs": 774600,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "by the modulus of the wave function,"
    } ]
  }, {
    "tStartMs": 776340,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "as it was for the Schrodinger equation."
    } ]
  }, {
    "tStartMs": 778290,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "For the Klein-Gordon equation,"
    } ]
  }, {
    "tStartMs": 779520,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "a new equation was needed\nto describe the probability"
    } ]
  }, {
    "tStartMs": 781800,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "using the wave function,"
    } ]
  }, {
    "tStartMs": 782940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "which takes a while to derive,"
    } ]
  }, {
    "tStartMs": 784770,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "so we won't get into that\nhere, but it looks like this."
    } ]
  }, {
    "tStartMs": 788370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And the problem with that equation"
    } ]
  }, {
    "tStartMs": 789960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "is that unlike the simple\nmodulus of the wave function,"
    } ]
  }, {
    "tStartMs": 792660,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "it can have negative solutions,\nnegative probabilities."
    } ]
  }, {
    "tStartMs": 796710,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "How can the chance of something\nhappening be less than zero?"
    } ]
  }, {
    "tStartMs": 800280,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "As Dirac put it, that, of\ncourse, is physically nonsense."
    } ]
  }, {
    "tStartMs": 803914,
    "dDurationMs": 2486,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 806400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So, Dirac did what Dirac does best,"
    } ]
  }, {
    "tStartMs": 808200,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and he set out to find his own solution"
    } ]
  }, {
    "tStartMs": 810060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that contained no\nsecond-order time derivatives."
    } ]
  }, {
    "tStartMs": 813000,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "First, he rewrote"
    } ]
  }, {
    "tStartMs": 814140,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the relativistic energy\nmomentum relationship like this,"
    } ]
  }, {
    "tStartMs": 817560,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "which is a linear equation."
    } ]
  }, {
    "tStartMs": 819150,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "So no squaring E, that is no\nsquaring the energy operator,"
    } ]
  }, {
    "tStartMs": 823080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "which is what gave rise to that\nsecond-order time derivative"
    } ]
  }, {
    "tStartMs": 825900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in the Klein-Gordon equation."
    } ]
  }, {
    "tStartMs": 827550,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Now, he just had to solve this equation"
    } ]
  }, {
    "tStartMs": 829350,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and find the coefficients,"
    } ]
  }, {
    "tStartMs": 830550,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "alpha x, alpha y, alpha z, and beta,"
    } ]
  }, {
    "tStartMs": 833760,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "and he would have a solution."
    } ]
  }, {
    "tStartMs": 835544,
    "dDurationMs": 1636,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 837180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "To do this,"
    } ]
  }, {
    "tStartMs": 838013,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "we can start by squaring\nboth sides of the equation."
    } ]
  }, {
    "tStartMs": 840750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Next, we can expand the\nmomentum on the left-hand side"
    } ]
  }, {
    "tStartMs": 843150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "into its three dimensions,"
    } ]
  }, {
    "tStartMs": 844770,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and then expand the right-hand side"
    } ]
  }, {
    "tStartMs": 846270,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to end up with this long equation."
    } ]
  }, {
    "tStartMs": 848970,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It might look pretty complicated,"
    } ]
  }, {
    "tStartMs": 850530,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "but there is a trick we can use."
    } ]
  }, {
    "tStartMs": 852023,
    "dDurationMs": 1747,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 853770,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And notice that all these\nterms on the right-hand side"
    } ]
  }, {
    "tStartMs": 855900,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "are multiplied by pmc cubed,"
    } ]
  }, {
    "tStartMs": 857970,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "but on the left-hand side,"
    } ]
  }, {
    "tStartMs": 859080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "there are no terms containing pmc cubed."
    } ]
  }, {
    "tStartMs": 861540,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "So that tells us"
    } ]
  }, {
    "tStartMs": 862590,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that when you multiply\nthese coefficients together,"
    } ]
  }, {
    "tStartMs": 864630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "like the alpha times beta\nand beta times alphas,"
    } ]
  }, {
    "tStartMs": 867480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "all of that must be 0."
    } ]
  }, {
    "tStartMs": 869010,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And similarly, notice that\nthese terms are multiplied"
    } ]
  }, {
    "tStartMs": 871500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "by two different momenta,"
    } ]
  }, {
    "tStartMs": 872940,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "like px and py times c squared,"
    } ]
  }, {
    "tStartMs": 875520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which also don't have a\ncounterpart on the left-hand side."
    } ]
  }, {
    "tStartMs": 878310,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "So these alpha times alpha\nterms must also be equal to 0."
    } ]
  }, {
    "tStartMs": 882300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And that just leaves this top row."
    } ]
  }, {
    "tStartMs": 884370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "These terms do match on both sides,"
    } ]
  }, {
    "tStartMs": 886650,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which tells us that alpha x\nsquared must be equal to 1,"
    } ]
  }, {
    "tStartMs": 889350,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and so must alpha y\nsquared, alpha z squared,"
    } ]
  }, {
    "tStartMs": 891660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and beta squared."
    } ]
  }, {
    "tStartMs": 893370,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So Dirac now had a set\nof simultaneous equations"
    } ]
  }, {
    "tStartMs": 895920,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "for alpha x, alpha y, alpha z, and beta"
    } ]
  }, {
    "tStartMs": 899190,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that he just needed to solve."
    } ]
  }, {
    "tStartMs": 901170,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That sounds easy, right?"
    } ]
  }, {
    "tStartMs": 902850,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But it's not that straightforward."
    } ]
  }, {
    "tStartMs": 904680,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- To see why, let's do some examples."
    } ]
  }, {
    "tStartMs": 906780,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "So say alpha x is 1 and\nbeta equals minus 1."
    } ]
  }, {
    "tStartMs": 911430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Well, then, we get 1 squared, which is 1,"
    } ]
  }, {
    "tStartMs": 913680,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "equals minus 1 squared, which is also 1,"
    } ]
  }, {
    "tStartMs": 916590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so that satisfies the top equation."
    } ]
  }, {
    "tStartMs": 918660,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But if we fill it in here,\nwe get 1 times minus 1,"
    } ]
  }, {
    "tStartMs": 922080,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which is just minus 1,"
    } ]
  }, {
    "tStartMs": 923610,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "plus minus 1 times 1,\nwhich is, again, minus 1,"
    } ]
  }, {
    "tStartMs": 927330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "for a total of minus 2."
    } ]
  }, {
    "tStartMs": 930060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So, that doesn't work."
    } ]
  }, {
    "tStartMs": 931800,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So, let's try another number."
    } ]
  }, {
    "tStartMs": 933510,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Say alpha x is 1, and now\nit's alpha z that is minus 1."
    } ]
  }, {
    "tStartMs": 938010,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Well, in that case, we\nget 1 times minus 1."
    } ]
  }, {
    "tStartMs": 941520,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So, again, we get minus 1,"
    } ]
  }, {
    "tStartMs": 943050,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "plus minus, 1 times 1,"
    } ]
  }, {
    "tStartMs": 945510,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "again, minus 1."
    } ]
  }, {
    "tStartMs": 946950,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So we, again, get minus 2."
    } ]
  }, {
    "tStartMs": 949500,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And in fact, if you look\nat this top equation,"
    } ]
  }, {
    "tStartMs": 951480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the only numbers that\nsatisfy this relation"
    } ]
  }, {
    "tStartMs": 954060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "is 1 and minus 1."
    } ]
  }, {
    "tStartMs": 955440,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So all these coefficients have\nto be either 1 or minus 1,"
    } ]
  }, {
    "tStartMs": 958380,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "but if you fill that in,"
    } ]
  }, {
    "tStartMs": 959700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "then the only two possible answers"
    } ]
  }, {
    "tStartMs": 961620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you're gonna get in these equations"
    } ]
  }, {
    "tStartMs": 963540,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "is minus 2 or positive 2."
    } ]
  }, {
    "tStartMs": 965910,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Now, the two equations"
    } ]
  }, {
    "tStartMs": 967200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that are giving problems are these two,"
    } ]
  }, {
    "tStartMs": 969330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and that's because alpha times beta"
    } ]
  }, {
    "tStartMs": 971160,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "is the same as beta times alpha."
    } ]
  }, {
    "tStartMs": 972930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So, you're always gonna get minus 2 or 2."
    } ]
  }, {
    "tStartMs": 975480,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So, the only way to get out of this"
    } ]
  }, {
    "tStartMs": 977220,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "is to somehow make the order\nof multiplication matter."
    } ]
  }, {
    "tStartMs": 980850,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "But where do you find something like that?"
    } ]
  }, {
    "tStartMs": 982317,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 983910,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Let's think about a\nreally simple vector,"
    } ]
  }, {
    "tStartMs": 985950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "say 1 in the x-direction\nand 2 in the y-direction."
    } ]
  }, {
    "tStartMs": 988860,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "If I reflect this vector\nalong the line y equals x"
    } ]
  }, {
    "tStartMs": 991860,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and then reflect it about the x-axis,"
    } ]
  }, {
    "tStartMs": 994590,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I get this."
    } ]
  }, {
    "tStartMs": 996030,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But if I start again"
    } ]
  }, {
    "tStartMs": 997350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and instead reflect it\nfirst about the x-axis"
    } ]
  }, {
    "tStartMs": 1000050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and then along y equals x,"
    } ]
  }, {
    "tStartMs": 1002000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I get this, which is totally different."
    } ]
  }, {
    "tStartMs": 1004430,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "So, the order matters."
    } ]
  }, {
    "tStartMs": 1007460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "How do we express this mathematically?"
    } ]
  }, {
    "tStartMs": 1009410,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "We need some way to\nrepresent transformations,"
    } ]
  }, {
    "tStartMs": 1011540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "like reflections as a single coefficient,"
    } ]
  }, {
    "tStartMs": 1013820,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which means we need matrices."
    } ]
  }, {
    "tStartMs": 1016670,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Matrices are arrays of numbers"
    } ]
  }, {
    "tStartMs": 1018380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "which encapsulate these transformations,"
    } ]
  }, {
    "tStartMs": 1020150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "telling us how to\nreflect, rotate, stretch,"
    } ]
  }, {
    "tStartMs": 1022490,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "or squish across each dimension."
    } ]
  }, {
    "tStartMs": 1024980,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Mathematically, the order\nwe multiply them matters."
    } ]
  }, {
    "tStartMs": 1028220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Since we multiply the\nrows of the first matrix"
    } ]
  }, {
    "tStartMs": 1030200,
    "dDurationMs": 1214,
    "segs": [ {
      "utf8": "by the columns of the second,"
    } ]
  }, {
    "tStartMs": 1031414,
    "dDurationMs": 3736,
    "segs": [ {
      "utf8": "(pensive music)\n(graphic whooshing)"
    } ]
  }, {
    "tStartMs": 1035150,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "A matrix that reflects along\ny equals x looks like this"
    } ]
  }, {
    "tStartMs": 1038360,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and a matrix that reflects about\nthe x-axis looks like this."
    } ]
  }, {
    "tStartMs": 1041280,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1043100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And if I apply them to that\noriginal vector one by one,"
    } ]
  }, {
    "tStartMs": 1045770,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "you can see how we end up\nwith different results."
    } ]
  }, {
    "tStartMs": 1048289,
    "dDurationMs": 1561,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1049850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And actually, using matrices\nin quantum mechanics"
    } ]
  }, {
    "tStartMs": 1052640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "was not completely out there."
    } ]
  }, {
    "tStartMs": 1054320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Dirac had already seen it\ndone by Werner Heisenberg,"
    } ]
  }, {
    "tStartMs": 1056750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "his new, if unlikely, friend."
    } ]
  }, {
    "tStartMs": 1059420,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Dirac and Heisenberg were\nvery different characters."
    } ]
  }, {
    "tStartMs": 1062090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Heisenberg was charming and outgoing,"
    } ]
  }, {
    "tStartMs": 1064190,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Dirac hated socializing and small talk."
    } ]
  }, {
    "tStartMs": 1066620,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Once the two were on a cruise\nship to a conference together"
    } ]
  }, {
    "tStartMs": 1069320,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and Heisenberg spent a lot of time"
    } ]
  }, {
    "tStartMs": 1070850,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "dancing with women on board."
    } ]
  }, {
    "tStartMs": 1072620,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So, Dirac asked him, \"Why do you dance?\""
    } ]
  }, {
    "tStartMs": 1075530,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "Heisenberg replied,"
    } ]
  }, {
    "tStartMs": 1076677,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "\"When there are nice\ngirls, it is a pleasure.\""
    } ]
  }, {
    "tStartMs": 1079520,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Dirac thought about this\nfor a bit before saying,"
    } ]
  }, {
    "tStartMs": 1081897,
    "dDurationMs": 3353,
    "segs": [ {
      "utf8": "\"How do you know beforehand\nthat the girls are nice?\""
    } ]
  }, {
    "tStartMs": 1085250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So, they were pretty different guys,"
    } ]
  }, {
    "tStartMs": 1086870,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "but Heisenberg had a\nprofound impact on Dirac."
    } ]
  }, {
    "tStartMs": 1089718,
    "dDurationMs": 2012,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 1091730,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- Do you know what drew him to\nquantum mechanics initially?"
    } ]
  }, {
    "tStartMs": 1094790,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- He always said that\nHeisenberg gave him his start,"
    } ]
  }, {
    "tStartMs": 1097250,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "he always said that."
    } ]
  }, {
    "tStartMs": 1098480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "In later life, he used to\nbegin lectures when he was 70,"
    } ]
  }, {
    "tStartMs": 1102080,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "even 80 years old, with\nthe following words."
    } ]
  }, {
    "tStartMs": 1104930,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "- Quantum mechanics was\ndiscovered by Heisenberg in 1925."
    } ]
  }, {
    "tStartMs": 1110330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- As a PhD student,"
    } ]
  }, {
    "tStartMs": 1111800,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Dirac had closely followed\nHeisenberg's work,"
    } ]
  }, {
    "tStartMs": 1114330,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "and a few years earlier,"
    } ]
  }, {
    "tStartMs": 1115700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Heisenberg had founded\nfor certain properties,"
    } ]
  }, {
    "tStartMs": 1117920,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "like position and momentum."
    } ]
  }, {
    "tStartMs": 1119630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The order of multiplication matters."
    } ]
  }, {
    "tStartMs": 1121700,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So x times p is not the same as p times x."
    } ]
  }, {
    "tStartMs": 1124970,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "This was actually the beginning"
    } ]
  }, {
    "tStartMs": 1126260,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of Heisenberg's famous\nuncertainty principle,"
    } ]
  }, {
    "tStartMs": 1129020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "which says that there's a limit"
    } ]
  }, {
    "tStartMs": 1130370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to how precisely we can know certain pairs"
    } ]
  }, {
    "tStartMs": 1132860,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of physical properties in quantum systems."
    } ]
  }, {
    "tStartMs": 1135440,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It turns out that if the order\nof multiplication matters"
    } ]
  }, {
    "tStartMs": 1138260,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "for two properties like\nposition and momentum,"
    } ]
  }, {
    "tStartMs": 1140780,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "then that means there's\nan inherent uncertainty"
    } ]
  }, {
    "tStartMs": 1143300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "in their combined measurements."
    } ]
  }, {
    "tStartMs": 1144920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The order we measure them\nin will change the outcome."
    } ]
  }, {
    "tStartMs": 1148400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Heisenberg's mentor, Max Born,"
    } ]
  }, {
    "tStartMs": 1150110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "suggested that he could\nrepresent this mathematically"
    } ]
  }, {
    "tStartMs": 1152450,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "by using matrices,"
    } ]
  }, {
    "tStartMs": 1153680,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "because there, the order of\nmultiplication also matters."
    } ]
  }, {
    "tStartMs": 1156163,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1157760,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This led Heisenberg to a new\nform of quantum mechanics,"
    } ]
  }, {
    "tStartMs": 1160820,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which was mathematically equivalent"
    } ]
  }, {
    "tStartMs": 1162830,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "to Schrodinger's equation,"
    } ]
  }, {
    "tStartMs": 1164000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "but it was based on matrix algebra."
    } ]
  }, {
    "tStartMs": 1167210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Dirac recognized something\nsimilar in his coefficients"
    } ]
  }, {
    "tStartMs": 1169880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "where the order of\nmultiplication clearly mattered."
    } ]
  }, {
    "tStartMs": 1172490,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, he thought matrices\nmight be the solution."
    } ]
  }, {
    "tStartMs": 1175430,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "For his coefficients,"
    } ]
  }, {
    "tStartMs": 1176780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "he tried 2x2 matrices"
    } ]
  }, {
    "tStartMs": 1178640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "since they're the\nsmallest, simplest matrices"
    } ]
  }, {
    "tStartMs": 1181220,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that could make the order\nof multiplication matter."
    } ]
  }, {
    "tStartMs": 1184220,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "He found that some worked\nwith the equations."
    } ]
  }, {
    "tStartMs": 1186260,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "In fact, those reflection matrices"
    } ]
  }, {
    "tStartMs": 1187790,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "we tried earlier worked well,"
    } ]
  }, {
    "tStartMs": 1189710,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but he just couldn't find solutions"
    } ]
  }, {
    "tStartMs": 1191000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "for all four coefficients\nthat all worked together."
    } ]
  }, {
    "tStartMs": 1194000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- So this is not simple."
    } ]
  }, {
    "tStartMs": 1195200,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Dirac is one of the smartest\npeople of the 20th century"
    } ]
  }, {
    "tStartMs": 1197230,
    "dDurationMs": 907,
    "segs": [ {
      "utf8": "in physics, right?"
    } ]
  }, {
    "tStartMs": 1198137,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "But it was not easy."
    } ]
  }, {
    "tStartMs": 1199550,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "You don't have just to twiddle"
    } ]
  }, {
    "tStartMs": 1201140,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with bits of the Schrodinger equation."
    } ]
  }, {
    "tStartMs": 1203540,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "You'd have to do something\ncompletely radical."
    } ]
  }, {
    "tStartMs": 1206060,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "His working is in there,"
    } ]
  }, {
    "tStartMs": 1207350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and you could see him really struggling."
    } ]
  }, {
    "tStartMs": 1209600,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Then, Dirac had a stroke of genius."
    } ]
  }, {
    "tStartMs": 1212330,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "He said, \"I suddenly realized"
    } ]
  }, {
    "tStartMs": 1214100,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that there was no need\nto stick to quantities,"
    } ]
  }, {
    "tStartMs": 1216170,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which can be represented by matrices"
    } ]
  }, {
    "tStartMs": 1217700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "with just two rows and columns."
    } ]
  }, {
    "tStartMs": 1219980,
    "dDurationMs": 2226,
    "segs": [ {
      "utf8": "Why not go to four rows and columns?\""
    } ]
  }, {
    "tStartMs": 1222206,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 1230030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "With these four 4x4 matrices,"
    } ]
  }, {
    "tStartMs": 1231980,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Dirac got these solutions to\nhis simultaneous equations,"
    } ]
  }, {
    "tStartMs": 1235160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "a matrix with 1s on the diagonal"
    } ]
  }, {
    "tStartMs": 1236960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "is mathematically equivalent to a 1,"
    } ]
  }, {
    "tStartMs": 1239120,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and a whole array of 0s\nis the same thing as 0."
    } ]
  }, {
    "tStartMs": 1242390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So, all of the equations were satisfied."
    } ]
  }, {
    "tStartMs": 1244760,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Dirac had found coefficients that worked."
    } ]
  }, {
    "tStartMs": 1247700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Now, we can substitute those matrices back"
    } ]
  }, {
    "tStartMs": 1249980,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "into Dirac's linear equation,"
    } ]
  }, {
    "tStartMs": 1251660,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "then rewrite the three momenta"
    } ]
  }, {
    "tStartMs": 1253250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and alpha coefficients as vectors."
    } ]
  }, {
    "tStartMs": 1255560,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "And just as we did with the Schrodinger"
    } ]
  }, {
    "tStartMs": 1257057,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "and Klein-Gordon equations,"
    } ]
  }, {
    "tStartMs": 1258470,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "we can use the energy\nand momentum operators"
    } ]
  }, {
    "tStartMs": 1260570,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to make both sides act\non the wave function."
    } ]
  }, {
    "tStartMs": 1263660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "If we substitute those operators in,"
    } ]
  }, {
    "tStartMs": 1265820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "we get Dirac's final equation"
    } ]
  }, {
    "tStartMs": 1267620,
    "dDurationMs": 1925,
    "segs": [ {
      "utf8": "for the relativistic free electron."
    } ]
  }, {
    "tStartMs": 1269545,
    "dDurationMs": 1795,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 1271340,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The young man who spent his life"
    } ]
  }, {
    "tStartMs": 1272660,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "looking for mathematical beauty"
    } ]
  }, {
    "tStartMs": 1274250,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "had found, perhaps, his most\nbeautiful equation of all."
    } ]
  }, {
    "tStartMs": 1278090,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- The people were expecting\nthe solution to be horrible,"
    } ]
  }, {
    "tStartMs": 1281000,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and it turned out to be\na thing of beauty, right?"
    } ]
  }, {
    "tStartMs": 1284030,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "It was something you\nlook at and you think,"
    } ]
  }, {
    "tStartMs": 1285057,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "\"That is absolutely amazing.\""
    } ]
  }, {
    "tStartMs": 1287900,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "It's a pattern that Dirac\nfound deep in nature."
    } ]
  }, {
    "tStartMs": 1291290,
    "dDurationMs": 3138,
    "segs": [ {
      "utf8": "Nothing like that has been\nseen in physics at that time."
    } ]
  }, {
    "tStartMs": 1294428,
    "dDurationMs": 1392,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1295820,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- To see some of that beauty,"
    } ]
  }, {
    "tStartMs": 1296840,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "you only have to compare it\nto the Schrodinger equation,"
    } ]
  }, {
    "tStartMs": 1299330,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "which you can see right here."
    } ]
  }, {
    "tStartMs": 1300680,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Now, the two look very similar,"
    } ]
  }, {
    "tStartMs": 1302540,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "but there is a lot hidden\nin the Dirac equation."
    } ]
  }, {
    "tStartMs": 1305240,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "First of all, it's relativistic,"
    } ]
  }, {
    "tStartMs": 1306890,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so it works at really, really high speeds"
    } ]
  }, {
    "tStartMs": 1309140,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "because it uses Einstein's\nenergy momentum relationship,"
    } ]
  }, {
    "tStartMs": 1311960,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "unlike the Schrodinger equation\nwhich breaks down there."
    } ]
  }, {
    "tStartMs": 1314690,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "But what's even more beautiful\nis that if you look at this,"
    } ]
  }, {
    "tStartMs": 1317923,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "Dirac's equation isn't just\nfirst order in time derivatives,"
    } ]
  }, {
    "tStartMs": 1321110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "it's also first order\nin spatial derivatives."
    } ]
  }, {
    "tStartMs": 1324020,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Whereas the Schrodinger equation"
    } ]
  }, {
    "tStartMs": 1325250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "was second order in spatial derivatives."
    } ]
  }, {
    "tStartMs": 1327500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So you might wonder, \"Well,\nwhy does that matter?\""
    } ]
  }, {
    "tStartMs": 1329600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Well, because not only"
    } ]
  }, {
    "tStartMs": 1330800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "does going first order in all derivatives"
    } ]
  }, {
    "tStartMs": 1332720,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "solve the second-order\ntime derivative problem"
    } ]
  }, {
    "tStartMs": 1335150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of the Klein-Gordon equation,"
    } ]
  }, {
    "tStartMs": 1336710,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it now also treats time\nand space symmetrically."
    } ]
  }, {
    "tStartMs": 1339830,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And it becomes really important"
    } ]
  }, {
    "tStartMs": 1341180,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "if you start thinking about relativity,"
    } ]
  }, {
    "tStartMs": 1342950,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "where time and space are\nnot separate dimensions,"
    } ]
  }, {
    "tStartMs": 1346400,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "they're intertwined in a\nfour dimensional spacetime."
    } ]
  }, {
    "tStartMs": 1348890,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And while the Schrodinger equation"
    } ]
  }, {
    "tStartMs": 1350210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "had just a single component wave function,"
    } ]
  }, {
    "tStartMs": 1352490,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "to make the wave function\nwork with these 4x4 matrices,"
    } ]
  }, {
    "tStartMs": 1356240,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "in Dirac's case,"
    } ]
  }, {
    "tStartMs": 1357140,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "you actually need a wave function\nthat has four components."
    } ]
  }, {
    "tStartMs": 1360530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So, it'll look something like this."
    } ]
  }, {
    "tStartMs": 1362690,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Psi one, psi two,"
    } ]
  }, {
    "tStartMs": 1365600,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "psi three,"
    } ]
  }, {
    "tStartMs": 1367130,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "and psi four."
    } ]
  }, {
    "tStartMs": 1369650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- The four-component wave function"
    } ]
  }, {
    "tStartMs": 1371330,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "means that the Dirac equation\ndescribes four possible states"
    } ]
  }, {
    "tStartMs": 1374840,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "for any quantum system,"
    } ]
  }, {
    "tStartMs": 1376400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "which reveals something"
    } ]
  }, {
    "tStartMs": 1377840,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Schrödinger's single wave function didn't."
    } ]
  }, {
    "tStartMs": 1380630,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "An electron at a given energy level"
    } ]
  }, {
    "tStartMs": 1382490,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "actually has two possible states"
    } ]
  }, {
    "tStartMs": 1384680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "due to different orientations"
    } ]
  }, {
    "tStartMs": 1386120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of its intrinsic angular momentum,"
    } ]
  }, {
    "tStartMs": 1388040,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "spin up and spin down."
    } ]
  }, {
    "tStartMs": 1390296,
    "dDurationMs": 1254,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1391550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This spin creates a tiny magnetic field."
    } ]
  }, {
    "tStartMs": 1393950,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So these two states are like tiny magnets"
    } ]
  }, {
    "tStartMs": 1396230,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "pointing in opposite directions,"
    } ]
  }, {
    "tStartMs": 1397940,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "and that has an interesting implication."
    } ]
  }, {
    "tStartMs": 1401060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Take hydrogen, which has\none proton and one electron."
    } ]
  }, {
    "tStartMs": 1404540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Classically, the electron\nwhizzes around the proton."
    } ]
  }, {
    "tStartMs": 1407540,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But if you switch to the\nperspective of the electron,"
    } ]
  }, {
    "tStartMs": 1410090,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "well, now, it's the proton that's moving."
    } ]
  }, {
    "tStartMs": 1412340,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And since it's positively charged,"
    } ]
  }, {
    "tStartMs": 1413960,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that moving charge\ncreates a magnetic field"
    } ]
  }, {
    "tStartMs": 1416330,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "in the electron's frame of reference."
    } ]
  }, {
    "tStartMs": 1418100,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So, now you've got this electron,"
    } ]
  }, {
    "tStartMs": 1419810,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "which has its own mini magnetic field,"
    } ]
  }, {
    "tStartMs": 1421790,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "interacting with a larger magnetic field,"
    } ]
  }, {
    "tStartMs": 1423710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and that interaction will\nbe slightly different"
    } ]
  }, {
    "tStartMs": 1426080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "for a spin up and a spin down electron."
    } ]
  }, {
    "tStartMs": 1429200,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And as a result, some energy\nlevels of the electron"
    } ]
  }, {
    "tStartMs": 1432170,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "split into two\nclosely-spaced energy levels."
    } ]
  }, {
    "tStartMs": 1435830,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And you can actually see this"
    } ]
  }, {
    "tStartMs": 1437300,
    "dDurationMs": 2906,
    "segs": [ {
      "utf8": "if you zoom into the emission\nspectrum for a hydrogen atom."
    } ]
  }, {
    "tStartMs": 1440206,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1441680,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Schrödinger's equation\ndidn't predict that splitting"
    } ]
  }, {
    "tStartMs": 1444110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "since it just had one solution\nfor each energy level."
    } ]
  }, {
    "tStartMs": 1447200,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But with Dirac's four-component solution,"
    } ]
  }, {
    "tStartMs": 1449090,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "the top two wave functions"
    } ]
  }, {
    "tStartMs": 1450440,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "now described two different spin states"
    } ]
  }, {
    "tStartMs": 1452420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "with two slightly different energies."
    } ]
  }, {
    "tStartMs": 1454880,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Dirac admitted himself"
    } ]
  }, {
    "tStartMs": 1455960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that he had never set out to\ncapture spin in his equation."
    } ]
  }, {
    "tStartMs": 1458660,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- I started out this work\nwithout any intention at all"
    } ]
  }, {
    "tStartMs": 1463880,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "of bringing in the spin of the electron."
    } ]
  }, {
    "tStartMs": 1467090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Casper] But hold on,\nbecause if an electron"
    } ]
  }, {
    "tStartMs": 1469100,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "at a given energy level only\nhas two possible spin states,"
    } ]
  }, {
    "tStartMs": 1472310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "then why do we have a\nfour-component wave function?"
    } ]
  }, {
    "tStartMs": 1474710,
    "dDurationMs": 2656,
    "segs": [ {
      "utf8": "Why are there four\nstates and not just two?"
    } ]
  }, {
    "tStartMs": 1477366,
    "dDurationMs": 2204,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 1479570,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Derek] Well, that's what brings us"
    } ]
  }, {
    "tStartMs": 1480650,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "back to that 1928 lecture at the start,"
    } ]
  }, {
    "tStartMs": 1482780,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "the one that seemed to drive"
    } ]
  }, {
    "tStartMs": 1483860,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "even the most well-established\nquantum physicists mad."
    } ]
  }, {
    "tStartMs": 1486770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Because that strange\nman presenting his work"
    } ]
  }, {
    "tStartMs": 1489110,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "was actually Paul Dirac"
    } ]
  }, {
    "tStartMs": 1490790,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "sharing his new equation with the world."
    } ]
  }, {
    "tStartMs": 1493460,
    "dDurationMs": 3277,
    "segs": [ {
      "utf8": "It was Dirac's beautiful\nequation that Heisenberg called,"
    } ]
  }, {
    "tStartMs": 1496737,
    "dDurationMs": 2472,
    "segs": [ {
      "utf8": "\"The saddest chapter in modern physics.\""
    } ]
  }, {
    "tStartMs": 1499209,
    "dDurationMs": 3191,
    "segs": [ {
      "utf8": "(somber music)"
    } ]
  }, {
    "tStartMs": 1502400,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- To understand why all those physicists"
    } ]
  }, {
    "tStartMs": 1504350,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "were losing their minds,"
    } ]
  }, {
    "tStartMs": 1505520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "we only have to look at the simple case"
    } ]
  }, {
    "tStartMs": 1507560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "when a particle is at rest."
    } ]
  }, {
    "tStartMs": 1509630,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "This term right here\ndescribes the momentum."
    } ]
  }, {
    "tStartMs": 1511760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So, when the particle doesn't move,"
    } ]
  }, {
    "tStartMs": 1513440,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "this becomes 0 and it drops\nout, which gives us this."
    } ]
  }, {
    "tStartMs": 1517310,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Next, we can sub in the energy\nfor this quantum operator"
    } ]
  }, {
    "tStartMs": 1520400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to get this."
    } ]
  }, {
    "tStartMs": 1521900,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So now, we know that beta times mc squared"
    } ]
  }, {
    "tStartMs": 1524480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "must be equal to the particle's energy."
    } ]
  }, {
    "tStartMs": 1526730,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And if we write out beta and\nmultiplied by mc squared,"
    } ]
  }, {
    "tStartMs": 1530150,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "then we find two positive solutions"
    } ]
  }, {
    "tStartMs": 1532400,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and two negative solutions for the energy."
    } ]
  }, {
    "tStartMs": 1535460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So, negative energy solutions"
    } ]
  }, {
    "tStartMs": 1537290,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "are baked right into the Dirac equation."
    } ]
  }, {
    "tStartMs": 1539370,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1540860,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "This idea that a free electron\ncould have negative energy"
    } ]
  }, {
    "tStartMs": 1543680,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "was impossible for any of\nthese physicists to accept."
    } ]
  }, {
    "tStartMs": 1547250,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Because think about it."
    } ]
  }, {
    "tStartMs": 1548240,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "If electrons can have a negative energy,"
    } ]
  }, {
    "tStartMs": 1550250,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "then that means"
    } ]
  }, {
    "tStartMs": 1551083,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "that they could continually\nradiate positive energy,"
    } ]
  }, {
    "tStartMs": 1553610,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that is emit photons,"
    } ]
  }, {
    "tStartMs": 1555230,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and drop into lower and\nlower negative energy states."
    } ]
  }, {
    "tStartMs": 1558380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "There would be no limit"
    } ]
  }, {
    "tStartMs": 1559880,
    "dDurationMs": 2995,
    "segs": [ {
      "utf8": "to how far they could fall into\nthe negative energy abyss."
    } ]
  }, {
    "tStartMs": 1562875,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 1563708,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "- It looked like, to\nmany very smart people,"
    } ]
  }, {
    "tStartMs": 1566750,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and Dirac was smart enough\nto know they had a point,"
    } ]
  }, {
    "tStartMs": 1569450,
    "dDurationMs": 947,
    "segs": [ {
      "utf8": "that this equation,"
    } ]
  }, {
    "tStartMs": 1570397,
    "dDurationMs": 3613,
    "segs": [ {
      "utf8": "it got the mass and the\nmagnetic moment of the electron."
    } ]
  }, {
    "tStartMs": 1574010,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Yes, but on the other hand,"
    } ]
  }, {
    "tStartMs": 1575330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it predicts this ridiculous situation,"
    } ]
  }, {
    "tStartMs": 1577880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "where you have negative energy values."
    } ]
  }, {
    "tStartMs": 1579980,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Right.\n- That's nonsense."
    } ]
  }, {
    "tStartMs": 1581900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So, Heisenberg said, \"I give up."
    } ]
  }, {
    "tStartMs": 1584300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This is just ridiculous.\""
    } ]
  }, {
    "tStartMs": 1586610,
    "dDurationMs": 3507,
    "segs": [ {
      "utf8": "So, Dirac, he had, in\nsome very clear sense,"
    } ]
  }, {
    "tStartMs": 1590117,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "had to rescue his equation."
    } ]
  }, {
    "tStartMs": 1591965,
    "dDurationMs": 1005,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1592970,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- [Derek] Dirac spent three\nyears sticking to his guns."
    } ]
  }, {
    "tStartMs": 1595820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "He tried all sorts of ways\nto interpret his new equation"
    } ]
  }, {
    "tStartMs": 1598610,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to explain where the negative\nenergy was coming from."
    } ]
  }, {
    "tStartMs": 1602060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Then, in 1931,"
    } ]
  }, {
    "tStartMs": 1603800,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "he proposed something radical"
    } ]
  }, {
    "tStartMs": 1605450,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "to explain the negative energy solutions."
    } ]
  }, {
    "tStartMs": 1607885,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1610010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "A new kind of particle unknown\nto experimental physics,"
    } ]
  }, {
    "tStartMs": 1613220,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "having the same mass and\nopposite charge to an electron."
    } ]
  }, {
    "tStartMs": 1616220,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "We may call such a\nparticle an anti-electron."
    } ]
  }, {
    "tStartMs": 1619550,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "We should not expect to\nfind any of them in nature"
    } ]
  }, {
    "tStartMs": 1622160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "on account of their rapid rate"
    } ]
  }, {
    "tStartMs": 1623840,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "of recombination with electrons."
    } ]
  }, {
    "tStartMs": 1625630,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1628730,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So, Dirac was proposing\nthat those four states"
    } ]
  }, {
    "tStartMs": 1631220,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "described in his\nfour-component wave function"
    } ]
  }, {
    "tStartMs": 1633320,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "are a spin up electron,\na spin down electron,"
    } ]
  }, {
    "tStartMs": 1636020,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "a spin up antielectron, and\na spin down antielectron."
    } ]
  }, {
    "tStartMs": 1639770,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- When Dirac said that,"
    } ]
  }, {
    "tStartMs": 1641030,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "people didn't start running around saying,"
    } ]
  }, {
    "tStartMs": 1642807,
    "dDurationMs": 1073,
    "segs": [ {
      "utf8": "\"Where's this antielectron?\""
    } ]
  }, {
    "tStartMs": 1643880,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "They just ignored it.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1645827,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "- Cut to the laboratory at Caltech."
    } ]
  }, {
    "tStartMs": 1649400,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- In 1932,"
    } ]
  }, {
    "tStartMs": 1650390,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "a Caltech postdoc named Carl Anderson"
    } ]
  }, {
    "tStartMs": 1652490,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "was working on a project"
    } ]
  }, {
    "tStartMs": 1653510,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "trying to identify the charge particles"
    } ]
  }, {
    "tStartMs": 1655280,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "produced by cosmic rays."
    } ]
  }, {
    "tStartMs": 1656990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "He photographed the tracks\nthese particles left"
    } ]
  }, {
    "tStartMs": 1659030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "in a cloud chamber containing\na uniform magnetic field."
    } ]
  }, {
    "tStartMs": 1662060,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Anderson noticed several\ninstances of a similar track."
    } ]
  }, {
    "tStartMs": 1665330,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It looked a lot like the tracks\nhe'd seen left by electrons."
    } ]
  }, {
    "tStartMs": 1668810,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Only, it curved in the opposite direction"
    } ]
  }, {
    "tStartMs": 1671200,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "in the magnetic field."
    } ]
  }, {
    "tStartMs": 1673160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Kind of like the tracks of\npositively charged protons."
    } ]
  }, {
    "tStartMs": 1676520,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But there was no way it could be a proton"
    } ]
  }, {
    "tStartMs": 1678590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "based on the length of the track."
    } ]
  }, {
    "tStartMs": 1680540,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It had traveled farther in air,"
    } ]
  }, {
    "tStartMs": 1682250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and therefore it had to be much lighter."
    } ]
  }, {
    "tStartMs": 1684410,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "It had to be something\nwith around the same mass"
    } ]
  }, {
    "tStartMs": 1686630,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "as an electron,"
    } ]
  }, {
    "tStartMs": 1687740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but opposite charge."
    } ]
  }, {
    "tStartMs": 1689360,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "A positive electron, or as\nhe named it, a positron."
    } ]
  }, {
    "tStartMs": 1693830,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "He actually also tried to\nrebrand electrons as negatrons,"
    } ]
  }, {
    "tStartMs": 1697970,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "but that one didn't quite stick."
    } ]
  }, {
    "tStartMs": 1700820,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Just one year after Dirac\nproposed the antielectron,"
    } ]
  }, {
    "tStartMs": 1704270,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "Carl Anderson found it\nentirely by accident."
    } ]
  }, {
    "tStartMs": 1707355,
    "dDurationMs": 1865,
    "segs": [ {
      "utf8": "(uplifting music)"
    } ]
  }, {
    "tStartMs": 1709220,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- But this alone doesn't get rid"
    } ]
  }, {
    "tStartMs": 1710720,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of the negative energy problem."
    } ]
  }, {
    "tStartMs": 1712310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Remember what we said earlier."
    } ]
  }, {
    "tStartMs": 1713840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If any particles, like these positrons,"
    } ]
  }, {
    "tStartMs": 1716480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "can have negative energy,"
    } ]
  }, {
    "tStartMs": 1717680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "then they could continually radiate energy"
    } ]
  }, {
    "tStartMs": 1719840,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and drop into lower and\nlower negative energy states."
    } ]
  }, {
    "tStartMs": 1722990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Fortunately,"
    } ]
  }, {
    "tStartMs": 1723823,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "Dirac proposed a solution\nto this problem as well,"
    } ]
  }, {
    "tStartMs": 1726680,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "although it was a little crazy."
    } ]
  }, {
    "tStartMs": 1728682,
    "dDurationMs": 2618,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1731300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- He theorized something\ncalled the Dirac sea,"
    } ]
  }, {
    "tStartMs": 1733610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "describing a vacuum as an\ninfinite sea of electrons"
    } ]
  }, {
    "tStartMs": 1736490,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "occupying all available\nnegative energy states."
    } ]
  }, {
    "tStartMs": 1739640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And since no two electrons\ncan occupy the same state,"
    } ]
  }, {
    "tStartMs": 1742490,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "this prevents observable\npositive energy electrons"
    } ]
  }, {
    "tStartMs": 1745400,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "from falling into the\nnegative energy states."
    } ]
  }, {
    "tStartMs": 1748820,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "A hole or vacancy in this\nsea then becomes a positron."
    } ]
  }, {
    "tStartMs": 1752990,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "When an electron and a\npositron meet and annihilate,"
    } ]
  }, {
    "tStartMs": 1755870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "well, that's just an electron\nfalling back into the sea"
    } ]
  }, {
    "tStartMs": 1758240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and filling that hole."
    } ]
  }, {
    "tStartMs": 1759770,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The theory is mathematically sound."
    } ]
  }, {
    "tStartMs": 1761840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Of course, it's Dirac we're talking about,"
    } ]
  }, {
    "tStartMs": 1764120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but if you feel like it's\nhard to come to terms"
    } ]
  }, {
    "tStartMs": 1766370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "with the idea that we're floating"
    } ]
  }, {
    "tStartMs": 1767810,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "on an infinite sea of electrons,"
    } ]
  }, {
    "tStartMs": 1770270,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "well, you wouldn't be alone."
    } ]
  }, {
    "tStartMs": 1773450,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- It's not even that crazy"
    } ]
  }, {
    "tStartMs": 1774860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "if, I don't know, several decades later,"
    } ]
  }, {
    "tStartMs": 1776750,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "people find that exact\nmodel in a physical system."
    } ]
  }, {
    "tStartMs": 1780500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "In condensed matter physics,"
    } ]
  }, {
    "tStartMs": 1782000,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "you see an exact analogy\nof also having electrons"
    } ]
  }, {
    "tStartMs": 1786740,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "in the conduction band and\nsay valence-covalence band."
    } ]
  }, {
    "tStartMs": 1789440,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "- Yes, that's true. That's true."
    } ]
  }, {
    "tStartMs": 1791061,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "But Dirac really was, you know, out there."
    } ]
  }, {
    "tStartMs": 1794300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You see what I mean?"
    } ]
  }, {
    "tStartMs": 1795133,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "Maybe it was people like..."
    } ]
  }, {
    "tStartMs": 1796190,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "He doesn't see it, really\nseeing that people are saying,"
    } ]
  }, {
    "tStartMs": 1798147,
    "dDurationMs": 1673,
    "segs": [ {
      "utf8": "\"This is nonsense.\""
    } ]
  }, {
    "tStartMs": 1799820,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But it was a way of Dirac's\nrectilinear thinking,"
    } ]
  }, {
    "tStartMs": 1802850,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "thinking, \"Well maybe this is...\""
    } ]
  }, {
    "tStartMs": 1803720,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And then it drove him to antimatter."
    } ]
  }, {
    "tStartMs": 1807560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Thankfully, in 1941,"
    } ]
  }, {
    "tStartMs": 1809240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "a Swiss physicist named Ernst Stueckelberg"
    } ]
  }, {
    "tStartMs": 1811670,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "had a clever idea."
    } ]
  }, {
    "tStartMs": 1812930,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The way function contains a\nterm that looks like this,"
    } ]
  }, {
    "tStartMs": 1815510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where energy is multiplied by time."
    } ]
  }, {
    "tStartMs": 1817670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So, we can see that if we\njust change the sign of time"
    } ]
  }, {
    "tStartMs": 1820460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "when the energy is negative,"
    } ]
  }, {
    "tStartMs": 1822290,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "then we get the same result"
    } ]
  }, {
    "tStartMs": 1824000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because a negative\nmultiplied by a negative"
    } ]
  }, {
    "tStartMs": 1826130,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "gives us a positive."
    } ]
  }, {
    "tStartMs": 1827690,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Stueckelberg took this,"
    } ]
  }, {
    "tStartMs": 1828650,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and he suggested that\nnegative energy electrons"
    } ]
  }, {
    "tStartMs": 1830900,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "traveling backwards in time\nare mathematically equivalent"
    } ]
  }, {
    "tStartMs": 1834680,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to positive energy\nantielectrons, that is positrons,"
    } ]
  }, {
    "tStartMs": 1837920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "traveling forwards in time."
    } ]
  }, {
    "tStartMs": 1840230,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- A few years later, around 1948,"
    } ]
  }, {
    "tStartMs": 1842330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Richard Feynman took this idea and used it"
    } ]
  }, {
    "tStartMs": 1844340,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in one of the most powerful\ntools in modern physics,"
    } ]
  }, {
    "tStartMs": 1846740,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the Feynman diagrams."
    } ]
  }, {
    "tStartMs": 1848480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "In his sketches of particle interactions,"
    } ]
  }, {
    "tStartMs": 1850400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "he showed antiparticles"
    } ]
  }, {
    "tStartMs": 1851600,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "traveling the opposite way to\nparticles backwards in time."
    } ]
  }, {
    "tStartMs": 1854661,
    "dDurationMs": 1169,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1855830,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It was a brilliant trick."
    } ]
  }, {
    "tStartMs": 1857450,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Negative energy solutions"
    } ]
  }, {
    "tStartMs": 1858680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "no longer had to mean\nthere was negative energy"
    } ]
  }, {
    "tStartMs": 1861020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "or a Dirac sea."
    } ]
  }, {
    "tStartMs": 1862610,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "They simply indicated the\npresence of an antiparticle."
    } ]
  }, {
    "tStartMs": 1865583,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1870320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "We now know that there's a\ncorresponding antiparticle"
    } ]
  }, {
    "tStartMs": 1872750,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "for every subatomic particle,"
    } ]
  }, {
    "tStartMs": 1874310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "with the same mass, but opposite charge."
    } ]
  }, {
    "tStartMs": 1876890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So, the proton has the antiproton,"
    } ]
  }, {
    "tStartMs": 1878900,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the neutrino has the\nantineutrino, and so on."
    } ]
  }, {
    "tStartMs": 1881870,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- According to his friend, Heisenberg,"
    } ]
  }, {
    "tStartMs": 1883370,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that was the biggest leap\nin 20th-century physics"
    } ]
  }, {
    "tStartMs": 1886520,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "to say there's a whole\nslew of antiparticles"
    } ]
  }, {
    "tStartMs": 1891020,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "corresponding to particles,"
    } ]
  }, {
    "tStartMs": 1892460,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "and Dirac got that\nthrough this crazy model."
    } ]
  }, {
    "tStartMs": 1894703,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1895940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- But all is not solved."
    } ]
  }, {
    "tStartMs": 1898160,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This new antiworld\nintroduces some big questions"
    } ]
  }, {
    "tStartMs": 1901400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "about the very nature of our universe."
    } ]
  }, {
    "tStartMs": 1903920,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Because particles and their antiparticles"
    } ]
  }, {
    "tStartMs": 1905720,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "are equal and opposite,"
    } ]
  }, {
    "tStartMs": 1906890,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "when they come together,"
    } ]
  }, {
    "tStartMs": 1907820,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "they annihilate and produce two photons"
    } ]
  }, {
    "tStartMs": 1909830,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "with energy equivalent to\ntheir mass and kinetic energy."
    } ]
  }, {
    "tStartMs": 1912650,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And this process is reversible."
    } ]
  }, {
    "tStartMs": 1914510,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Two photons with the right energies"
    } ]
  }, {
    "tStartMs": 1915980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "can produce a matter and antimatter pair."
    } ]
  }, {
    "tStartMs": 1918260,
    "dDurationMs": 2015,
    "segs": [ {
      "utf8": "This is called Breit-Wheeler\npair production."
    } ]
  }, {
    "tStartMs": 1920275,
    "dDurationMs": 1465,
    "segs": [ {
      "utf8": "(suspenseful music)\n(Big Bang exploding)"
    } ]
  }, {
    "tStartMs": 1921740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "During the first moments\nafter the Big Bang,"
    } ]
  }, {
    "tStartMs": 1923570,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the universe was hot, dense,"
    } ]
  }, {
    "tStartMs": 1925310,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and full of these pairs popping\ninto and out of existence."
    } ]
  }, {
    "tStartMs": 1928610,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "If an equal number of matter"
    } ]
  }, {
    "tStartMs": 1930050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and antimatter particles were created,"
    } ]
  }, {
    "tStartMs": 1932000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "you would expect them to\nall annihilate each other"
    } ]
  }, {
    "tStartMs": 1934760,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "in this dense environment,"
    } ]
  }, {
    "tStartMs": 1935930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "leaving behind only energy."
    } ]
  }, {
    "tStartMs": 1937700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But that didn't happen."
    } ]
  }, {
    "tStartMs": 1939560,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "We ended up with a\nuniverse full of matter."
    } ]
  }, {
    "tStartMs": 1942770,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If we work backwards from how\nmuch matter and antimatter"
    } ]
  }, {
    "tStartMs": 1945320,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "is in the universe today,"
    } ]
  }, {
    "tStartMs": 1946820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "it's actually estimated"
    } ]
  }, {
    "tStartMs": 1948170,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that only one particle\nper billion of matter"
    } ]
  }, {
    "tStartMs": 1951290,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "needed to survive this hot, dense era"
    } ]
  }, {
    "tStartMs": 1953600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and not get annihilated."
    } ]
  }, {
    "tStartMs": 1955400,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "That tiny difference"
    } ]
  }, {
    "tStartMs": 1956480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "would give us the makeup\nof our universe today,"
    } ]
  }, {
    "tStartMs": 1959060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where matter dominates."
    } ]
  }, {
    "tStartMs": 1961220,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- So what allowed that\none particle per billion"
    } ]
  }, {
    "tStartMs": 1963590,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to escape annihilation?"
    } ]
  }, {
    "tStartMs": 1965000,
    "dDurationMs": 2185,
    "segs": [ {
      "utf8": "Why did matter win out over antimatter?"
    } ]
  }, {
    "tStartMs": 1967185,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 1971030,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Well, that's a pretty big question"
    } ]
  }, {
    "tStartMs": 1972710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "with some not so simple answers."
    } ]
  }, {
    "tStartMs": 1974180,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So, we're doing an entire second video"
    } ]
  }, {
    "tStartMs": 1976790,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "where we have some pretty\nspectacular stuff happening."
    } ]
  }, {
    "tStartMs": 1980180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "We're getting into the beast."
    } ]
  }, {
    "tStartMs": 1981800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "It's absolutely insane."
    } ]
  }, {
    "tStartMs": 1982970,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I feel like I should not be in here."
    } ]
  }, {
    "tStartMs": 1985070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So you're making anti-atoms?"
    } ]
  }, {
    "tStartMs": 1986780,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 1987613,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "(energy humming)"
    } ]
  }, {
    "tStartMs": 1988730,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "- [Casper] It's so cool."
    } ]
  }, {
    "tStartMs": 1989712,
    "dDurationMs": 1688,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 1991400,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- Dirac is probably less well-known"
    } ]
  }, {
    "tStartMs": 1993230,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "than people like\nHeisenberg or Schrödinger,"
    } ]
  }, {
    "tStartMs": 1995450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but his contribution to\nquantum physics was immense,"
    } ]
  }, {
    "tStartMs": 1998330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and he was recognized for it."
    } ]
  }, {
    "tStartMs": 2000070,
    "dDurationMs": 3057,
    "segs": [ {
      "utf8": "He shared the 1933 Nobel\nPrize with Schrödinger"
    } ]
  }, {
    "tStartMs": 2003127,
    "dDurationMs": 3246,
    "segs": [ {
      "utf8": "for the discovery of new\nproductive forms of atomic theory."
    } ]
  }, {
    "tStartMs": 2007510,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And perhaps this gave strange, quiet Dirac"
    } ]
  }, {
    "tStartMs": 2010240,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "some newfound confidence,"
    } ]
  }, {
    "tStartMs": 2012100,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "because that physicist in the audience"
    } ]
  }, {
    "tStartMs": 2013855,
    "dDurationMs": 3315,
    "segs": [ {
      "utf8": "of his 1928 lecture at\nthe start, Eugene Wigner,"
    } ]
  }, {
    "tStartMs": 2017170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "actually became a reasonable\nfriend of Dirac's."
    } ]
  }, {
    "tStartMs": 2019930,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "And in 1934, introduced Dirac\nto his sister, Margit Wigner,"
    } ]
  }, {
    "tStartMs": 2024370,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a woman who would change Dirac's life,"
    } ]
  }, {
    "tStartMs": 2026770,
    "dDurationMs": 3214,
    "segs": [ {
      "utf8": "perhaps more than any\nequation or Nobel Prize."
    } ]
  }, {
    "tStartMs": 2029984,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 2032414,
    "dDurationMs": 1929,
    "segs": [ {
      "utf8": "- They were antiparticles, right?"
    } ]
  }, {
    "tStartMs": 2034343,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "They had completely\ndifferent personalities."
    } ]
  }, {
    "tStartMs": 2037630,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "He had almost no empathy,\nright? And he knew it."
    } ]
  }, {
    "tStartMs": 2041440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "She had buckets of it."
    } ]
  }, {
    "tStartMs": 2043270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "He hardly talked, she\ncouldn't stop talking."
    } ]
  }, {
    "tStartMs": 2045550,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "You could just go on,"
    } ]
  }, {
    "tStartMs": 2046390,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "like they are completely different people."
    } ]
  }, {
    "tStartMs": 2048190,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But the marriage did work."
    } ]
  }, {
    "tStartMs": 2049570,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "My great friend Lilia Harris\nChandra, who knew them,"
    } ]
  }, {
    "tStartMs": 2052480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "she came out with a\ngreat line, great line,"
    } ]
  }, {
    "tStartMs": 2055600,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "which is, \"He gave her\nstatus, she gave him a life.\""
    } ]
  }, {
    "tStartMs": 2060460,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- So, I guess there is one\nparticle-antiparticle pair"
    } ]
  }, {
    "tStartMs": 2063880,
    "dDurationMs": 1846,
    "segs": [ {
      "utf8": "that never annihilated."
    } ]
  }, {
    "tStartMs": 2065726,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 2068886,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "(graphic beeping)"
    } ]
  }, {
    "tStartMs": 2070252,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 2077440,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Hey, one last thing, in\ncase you didn't already know,"
    } ]
  }, {
    "tStartMs": 2080290,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "we just launched the\nofficial Veritasium game."
    } ]
  }, {
    "tStartMs": 2083500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It comes with 800 questions,"
    } ]
  }, {
    "tStartMs": 2085600,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and it's the perfect way\nto challenge your friends."
    } ]
  }, {
    "tStartMs": 2087910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Every time we play it at Veritasium,"
    } ]
  }, {
    "tStartMs": 2089710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "things get a little bit heated,\nand that is so much fun."
    } ]
  }, {
    "tStartMs": 2092500,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "If you want to go check it out,"
    } ]
  }, {
    "tStartMs": 2094510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "then head over to our Kickstarter,"
    } ]
  }, {
    "tStartMs": 2096130,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "where you can pre-order your own version."
    } ]
  }, {
    "tStartMs": 2098800,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And right now, we've\nenabled global shipping,"
    } ]
  }, {
    "tStartMs": 2100570,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "so no matter where you are in the world,"
    } ]
  }, {
    "tStartMs": 2102220,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "you can get your own version."
    } ]
  }, {
    "tStartMs": 2103840,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "We're coming close to the final few days"
    } ]
  }, {
    "tStartMs": 2105790,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of the Kickstarter campaign."
    } ]
  }, {
    "tStartMs": 2107080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So, this is your last chance"
    } ]
  }, {
    "tStartMs": 2108880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to get your hands on the\nexclusive launch edition."
    } ]
  }, {
    "tStartMs": 2111400,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, if you wanna support us,"
    } ]
  }, {
    "tStartMs": 2113170,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "head over to Kickstarter"
    } ]
  }, {
    "tStartMs": 2114160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "by clicking the link in the description"
    } ]
  }, {
    "tStartMs": 2116140,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "or scanning this QR code."
    } ]
  }, {
    "tStartMs": 2117760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I wanna thank you for all your support,"
    } ]
  }, {
    "tStartMs": 2119800,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "and most of all, thank you for watching."
    } ]
  } ]
}
