{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 60,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Derek] This is a video"
    } ]
  }, {
    "tStartMs": 1170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "about how Japanese swords are made,"
    } ]
  }, {
    "tStartMs": 4170,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "swords that are strong\nenough and sharp enough"
    } ]
  }, {
    "tStartMs": 6750,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to slice a bullet in half."
    } ]
  }, {
    "tStartMs": 9240,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The access we got for\nthis video is incredible."
    } ]
  }, {
    "tStartMs": 12300,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "We were able to film everything\nfrom gathering the iron sand"
    } ]
  }, {
    "tStartMs": 16140,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "to smelting the iron, forging the sword,"
    } ]
  }, {
    "tStartMs": 20490,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to sharpening and polishing it."
    } ]
  }, {
    "tStartMs": 23310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "They even let us use it."
    } ]
  }, {
    "tStartMs": 25620,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "- [Petr] That is so cool!"
    } ]
  }, {
    "tStartMs": 28860,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] The method\nof making these swords"
    } ]
  }, {
    "tStartMs": 30540,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "has remained virtually\nunchanged for hundreds of years,"
    } ]
  }, {
    "tStartMs": 34740,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "with everything done by hand."
    } ]
  }, {
    "tStartMs": 38220,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "They are still considered to\nbe among the best in the world."
    } ]
  }, {
    "tStartMs": 41820,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- The Japanese made a weapon"
    } ]
  }, {
    "tStartMs": 43740,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "that was the absolute pinnacle\nfor their style of warfare"
    } ]
  }, {
    "tStartMs": 47130,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "and the materials they had at hand."
    } ]
  }, {
    "tStartMs": 49890,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- These swords are held\nin such high regard"
    } ]
  }, {
    "tStartMs": 52770,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that one from the 16th century"
    } ]
  }, {
    "tStartMs": 54450,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "has been appraised at $105 million,"
    } ]
  }, {
    "tStartMs": 58650,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "making it the most\nexpensive sword ever built."
    } ]
  }, {
    "tStartMs": 62516,
    "dDurationMs": 3925,
    "segs": [ {
      "utf8": "(sword thwacks)\n(dramatic music)"
    } ]
  }, {
    "tStartMs": 66441,
    "dDurationMs": 3489,
    "segs": [ {
      "utf8": "(river noises)"
    } ]
  }, {
    "tStartMs": 69930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "In the Shimane province of Japan"
    } ]
  }, {
    "tStartMs": 72240,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "there is a smelter that is lit\nfor only one night each year"
    } ]
  }, {
    "tStartMs": 76770,
    "dDurationMs": 4893,
    "segs": [ {
      "utf8": "where steel is made in the\nsame way it was 1300 years ago."
    } ]
  }, {
    "tStartMs": 82710,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It's known as the Tatara method,"
    } ]
  }, {
    "tStartMs": 85260,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and only steel made in this way ends up"
    } ]
  }, {
    "tStartMs": 87840,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "in the very best Japanese swords."
    } ]
  }, {
    "tStartMs": 91560,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "And we were invited to come film it."
    } ]
  }, {
    "tStartMs": 94657,
    "dDurationMs": 3773,
    "segs": [ {
      "utf8": "(drums and flute music)"
    } ]
  }, {
    "tStartMs": 98430,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Just after 9:00 AM, the\nceremonial prayers are said"
    } ]
  }, {
    "tStartMs": 102210,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "and the fire is lit by a Shinto priest."
    } ]
  }, {
    "tStartMs": 106230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Everyone that will be working\nthis smelter will be here"
    } ]
  }, {
    "tStartMs": 108780,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "for at least the next 24 hours."
    } ]
  }, {
    "tStartMs": 111630,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "That includes Veritasium producer Petr."
    } ]
  }, {
    "tStartMs": 114930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- I'm committed. We're gonna do this."
    } ]
  }, {
    "tStartMs": 116580,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "It's gonna be fun."
    } ]
  }, {
    "tStartMs": 119160,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "- [Derek] Sword making in Japan\ngoes back about 3000 years,"
    } ]
  }, {
    "tStartMs": 123360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "but in those days, swords\nwere made out of bronze."
    } ]
  }, {
    "tStartMs": 126900,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "We're not sure how people\nfirst learned to smelt metal,"
    } ]
  }, {
    "tStartMs": 130470,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but it was likely related to pottery."
    } ]
  }, {
    "tStartMs": 133470,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- In that you were using these rocky oars"
    } ]
  }, {
    "tStartMs": 135450,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to make glazes and such for pottery"
    } ]
  }, {
    "tStartMs": 137610,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "under very controlled atmospheres."
    } ]
  }, {
    "tStartMs": 140190,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And then find maybe the\npotters found metallic beads"
    } ]
  }, {
    "tStartMs": 143160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "in the bottom of the furnaces\nthat they were firing it."
    } ]
  }, {
    "tStartMs": 145440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This possibly gave them the idea."
    } ]
  }, {
    "tStartMs": 147780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] Bronze was\ndiscovered before steel"
    } ]
  }, {
    "tStartMs": 149910,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "because it's an alloy of\ncopper, and usually tin,"
    } ]
  }, {
    "tStartMs": 153570,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "both metals with low enough melting points"
    } ]
  }, {
    "tStartMs": 155520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that they can be smelted\nin regular pottery kilns."
    } ]
  }, {
    "tStartMs": 159120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The problem with bronze"
    } ]
  }, {
    "tStartMs": 160320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "is that although it can be sharpened,"
    } ]
  }, {
    "tStartMs": 162510,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it's too soft to hold an edge for long."
    } ]
  }, {
    "tStartMs": 165480,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "So Japanese sword makers\nshifted to steel 1200 years ago"
    } ]
  }, {
    "tStartMs": 169590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "in the Heian period."
    } ]
  }, {
    "tStartMs": 171540,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This is what most people would recognize"
    } ]
  }, {
    "tStartMs": 173730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "as a Japanese sword."
    } ]
  }, {
    "tStartMs": 175410,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "It's made of steel with a curved blade."
    } ]
  }, {
    "tStartMs": 181470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Steel is an alloy of iron,"
    } ]
  }, {
    "tStartMs": 183540,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "the fourth-most-common\nelement in Earth's crust."
    } ]
  }, {
    "tStartMs": 186690,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "The oceans of the world used\nto be rich with dissolved iron."
    } ]
  }, {
    "tStartMs": 191520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But two and a half billion years ago,"
    } ]
  }, {
    "tStartMs": 193500,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "cyanobacteria started\nphotosynthesizing and creating oxygen."
    } ]
  }, {
    "tStartMs": 198090,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The iron reacted with that oxygen"
    } ]
  }, {
    "tStartMs": 200310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "precipitating out of solution"
    } ]
  }, {
    "tStartMs": 201930,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to be deposited at the\nbottom of the ocean."
    } ]
  }, {
    "tStartMs": 205470,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Incidentally, the cyanobacteria\nwere poisoned by the oxygen"
    } ]
  }, {
    "tStartMs": 209010,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that they themselves produced"
    } ]
  }, {
    "tStartMs": 211230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so it's thought that when\nlevels got high enough,"
    } ]
  }, {
    "tStartMs": 213420,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "they died off, and as a\nresult, oxygen levels dropped"
    } ]
  }, {
    "tStartMs": 217050,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and iron no longer\nprecipitated out of solution."
    } ]
  }, {
    "tStartMs": 220830,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Then the cyanobacteria\ncould multiply again"
    } ]
  }, {
    "tStartMs": 223320,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "and the cycle repeated."
    } ]
  }, {
    "tStartMs": 225720,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "That's why most of the world's\niron is found in layers"
    } ]
  }, {
    "tStartMs": 228810,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "of sedimentary rock called\nbanded iron formations."
    } ]
  }, {
    "tStartMs": 233160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Each layer of iron was formed"
    } ]
  }, {
    "tStartMs": 235320,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "during a global flourishing\nof cyanobacteria"
    } ]
  }, {
    "tStartMs": 238410,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "that infused the ocean with oxygen."
    } ]
  }, {
    "tStartMs": 241620,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The majority of the global iron supply"
    } ]
  }, {
    "tStartMs": 243570,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "comes from these banded iron formations"
    } ]
  }, {
    "tStartMs": 246330,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "because of their high\nconcentration of iron,"
    } ]
  }, {
    "tStartMs": 249450,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "up to around 60% iron oxide by weight."
    } ]
  }, {
    "tStartMs": 254775,
    "dDurationMs": 1725,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 256500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But Japan, with its\nmostly volcanic geology,"
    } ]
  }, {
    "tStartMs": 259500,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "has barely any of these\nsedimentary iron oxides."
    } ]
  }, {
    "tStartMs": 262890,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And this is likely why\nthe country was late"
    } ]
  }, {
    "tStartMs": 264960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to the steel production game."
    } ]
  }, {
    "tStartMs": 266940,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Archeologists have found\nsteel artifacts in Anatolia,"
    } ]
  }, {
    "tStartMs": 270090,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "which is modern day Turkey,\nthat are nearly 4,000 years old."
    } ]
  }, {
    "tStartMs": 274740,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But in Japan, metals including steel,"
    } ]
  }, {
    "tStartMs": 277230,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "were imported from China and Korea"
    } ]
  }, {
    "tStartMs": 279030,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "up until the eighth century"
    } ]
  }, {
    "tStartMs": 281100,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "when Japan started making its own steel."
    } ]
  }, {
    "tStartMs": 284670,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "So where did they get the raw ingredients?"
    } ]
  }, {
    "tStartMs": 289860,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Well, igneous rocks\nlike granite and diorite"
    } ]
  }, {
    "tStartMs": 292470,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "still contain iron oxides,"
    } ]
  }, {
    "tStartMs": 294630,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "just in much lower concentrations."
    } ]
  }, {
    "tStartMs": 297300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But as the mountains are weathered,"
    } ]
  }, {
    "tStartMs": 299130,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "these iron oxides are broken\napart and washed downstream."
    } ]
  }, {
    "tStartMs": 303240,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "Eventually they become part of the sand."
    } ]
  }, {
    "tStartMs": 307350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The Japanese noticed\nthat because iron oxides"
    } ]
  }, {
    "tStartMs": 310110,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "are denser than other\nminerals in the sand,"
    } ]
  }, {
    "tStartMs": 312750,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they accumulate in places"
    } ]
  }, {
    "tStartMs": 314460,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "where the river changes\ndirection or speed."
    } ]
  }, {
    "tStartMs": 317460,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The heavier iron sinks to the bottom"
    } ]
  }, {
    "tStartMs": 319470,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "and the lighter material is washed away."
    } ]
  }, {
    "tStartMs": 323700,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "To amplify this effect,"
    } ]
  }, {
    "tStartMs": 325140,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "they deliberately created\ndiversions in the river"
    } ]
  }, {
    "tStartMs": 328170,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to increase the concentration of iron."
    } ]
  }, {
    "tStartMs": 330960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- What do you do is you\ndam off a section of river"
    } ]
  }, {
    "tStartMs": 333600,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and then you drag sand into it."
    } ]
  }, {
    "tStartMs": 336270,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Because iron is heavier than\nthe other parts of the sand,"
    } ]
  }, {
    "tStartMs": 339780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "it is the thing that gets left behind"
    } ]
  }, {
    "tStartMs": 341430,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and everything else\ngets washed downstream."
    } ]
  }, {
    "tStartMs": 344490,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Derek] With this method,\nyou can get iron sands"
    } ]
  }, {
    "tStartMs": 346650,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "with 80% iron oxides by weight."
    } ]
  }, {
    "tStartMs": 349590,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "That's more concentrated\nthan high-quality iron ore."
    } ]
  }, {
    "tStartMs": 354060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And since it has fewer impurities,"
    } ]
  }, {
    "tStartMs": 355860,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "it's an excellent source\nfor high-quality steel."
    } ]
  }, {
    "tStartMs": 360330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If you heat up those iron oxides"
    } ]
  }, {
    "tStartMs": 362070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to over 1,250 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 364860,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "you can break the bonds with\noxygen and get pure iron."
    } ]
  }, {
    "tStartMs": 368850,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "But pure iron is actually\nsofter than bronze."
    } ]
  }, {
    "tStartMs": 372540,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So in its elemental state,\niron provides no advantage."
    } ]
  }, {
    "tStartMs": 376380,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But nature gave humans a lucky break."
    } ]
  }, {
    "tStartMs": 379500,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "One of the few ways you\ncan heat something up"
    } ]
  }, {
    "tStartMs": 381840,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "to 1,250 degrees is with charcoal,"
    } ]
  }, {
    "tStartMs": 385500,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and charcoal is basically pure carbon,"
    } ]
  }, {
    "tStartMs": 388650,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and if you add just a little\nbit of carbon to iron,"
    } ]
  }, {
    "tStartMs": 392130,
    "dDurationMs": 4613,
    "segs": [ {
      "utf8": "it creates an incredibly\nstrong alloy: steel."
    } ]
  }, {
    "tStartMs": 396743,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "- Yeah, a lot of people\nsee it as a heat process."
    } ]
  }, {
    "tStartMs": 399840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I see it as a chemical process."
    } ]
  }, {
    "tStartMs": 402480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- [Derek] Alloys are usually\nstronger than pure metals"
    } ]
  }, {
    "tStartMs": 405060,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "because they contain\ndifferent sized atoms,"
    } ]
  }, {
    "tStartMs": 408120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and this reduces the ability of atoms"
    } ]
  }, {
    "tStartMs": 410250,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "to slide past each other when\nan external force is applied."
    } ]
  }, {
    "tStartMs": 417540,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "- So I've just been given gloves,\nother gloves, and a towel."
    } ]
  }, {
    "tStartMs": 422220,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So things are very much getting real."
    } ]
  }, {
    "tStartMs": 425820,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "I'm genuinely quite worried."
    } ]
  }, {
    "tStartMs": 428339,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 429780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Here is the room with all of the charcoal"
    } ]
  }, {
    "tStartMs": 432750,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that we're going to be using overnight."
    } ]
  }, {
    "tStartMs": 434910,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "There's just bags and bags of this stuff."
    } ]
  }, {
    "tStartMs": 441695,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(charcoal rattles)"
    } ]
  }, {
    "tStartMs": 445570,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(flame crackles)"
    } ]
  }, {
    "tStartMs": 450016,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "There's a Buddhist saying:"
    } ]
  }, {
    "tStartMs": 451957,
    "dDurationMs": 3713,
    "segs": [ {
      "utf8": "\"Before enlightenment,\nchop wood, carry water."
    } ]
  }, {
    "tStartMs": 455670,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "After enlightenment,\nchop wood, carry water.\""
    } ]
  }, {
    "tStartMs": 466020,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "So we're lining up on the\nfour corners, I guess."
    } ]
  }, {
    "tStartMs": 470144,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(charcoal rattles)"
    } ]
  }, {
    "tStartMs": 475088,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "Oh. Oh boy."
    } ]
  }, {
    "tStartMs": 476850,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "Didn't do a great job of that. (chuckles)"
    } ]
  }, {
    "tStartMs": 480941,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "(thunder rumbles)"
    } ]
  }, {
    "tStartMs": 481860,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "So the rain is coming,"
    } ]
  }, {
    "tStartMs": 482910,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "so we're quickly getting\nall of the charcoal out"
    } ]
  }, {
    "tStartMs": 485010,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and then measuring it."
    } ]
  }, {
    "tStartMs": 486780,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "So each bag of these is 10 kilos. Okay."
    } ]
  }, {
    "tStartMs": 490210,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 493380,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "So with the iron sand, it\nis mixed together with water"
    } ]
  }, {
    "tStartMs": 497310,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "because if you don't mix it with water"
    } ]
  }, {
    "tStartMs": 498960,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "and you put it on the flame,\nit just flies straight up."
    } ]
  }, {
    "tStartMs": 502590,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But if you mix it with too much water,"
    } ]
  }, {
    "tStartMs": 505440,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "then there is water that's gonna heat up."
    } ]
  }, {
    "tStartMs": 507750,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "It's gonna become water vapor,"
    } ]
  }, {
    "tStartMs": 508770,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and the whole kiln could explode."
    } ]
  }, {
    "tStartMs": 511320,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Terrifyingly enough, they do this by feel."
    } ]
  }, {
    "tStartMs": 514230,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "They mix in enough water\nuntil the iron sand is clumpy."
    } ]
  }, {
    "tStartMs": 518790,
    "dDurationMs": 4917,
    "segs": [ {
      "utf8": "But again, if it's too much,\nthe whole thing could explode."
    } ]
  }, {
    "tStartMs": 536467,
    "dDurationMs": 1916,
    "segs": [ {
      "utf8": "Okay, put some iron in."
    } ]
  }, {
    "tStartMs": 540330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "It is just past four in the afternoon,"
    } ]
  }, {
    "tStartMs": 541800,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "and over the last couple of hours"
    } ]
  }, {
    "tStartMs": 542820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "we have added 250 kilograms of charcoal"
    } ]
  }, {
    "tStartMs": 546180,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and nearly 60 kilograms of iron sand."
    } ]
  }, {
    "tStartMs": 549660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So yeah, it's a slow process,"
    } ]
  }, {
    "tStartMs": 551850,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but I think we're\nstarting to get somewhere."
    } ]
  }, {
    "tStartMs": 554610,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "I have no idea because\nobviously the thing is hidden,"
    } ]
  }, {
    "tStartMs": 558750,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "but it should be growing."
    } ]
  }, {
    "tStartMs": 562800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Derek] To achieve the high temperatures"
    } ]
  }, {
    "tStartMs": 564600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "required to make steel,"
    } ]
  }, {
    "tStartMs": 566280,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "you need a strong,\nsteady supply of oxygen."
    } ]
  }, {
    "tStartMs": 569880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "For hundreds of years,"
    } ]
  }, {
    "tStartMs": 571500,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "this was provided by huge\nfoot-operated bellows."
    } ]
  }, {
    "tStartMs": 575040,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It would've taken an\naround-the-clock, full-body effort"
    } ]
  }, {
    "tStartMs": 578130,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "by many men to maintain\nthe furnace's temperature."
    } ]
  }, {
    "tStartMs": 582150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- When I came here,"
    } ]
  }, {
    "tStartMs": 582983,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": "I was a little bit sad that\nthe bellows were electric."
    } ]
  }, {
    "tStartMs": 585420,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I really wanted to, you know,\nhave this proper experience,"
    } ]
  }, {
    "tStartMs": 588720,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "have this proper workout"
    } ]
  }, {
    "tStartMs": 589800,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "of stepping on these bellows for 24 hours."
    } ]
  }, {
    "tStartMs": 594742,
    "dDurationMs": 2768,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 597510,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] The temperature\ninside the smelter"
    } ]
  }, {
    "tStartMs": 599190,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "gets up to 1500 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 602070,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "just below the melting point\nof iron, which is 1538 Celsius."
    } ]
  }, {
    "tStartMs": 606450,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So the iron being smelted isn't liquid,"
    } ]
  }, {
    "tStartMs": 609750,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but it's soft and malleable enough"
    } ]
  }, {
    "tStartMs": 611670,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to clump together into\na big block of iron."
    } ]
  }, {
    "tStartMs": 615000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "No matter how high\nquality the iron sand is,"
    } ]
  }, {
    "tStartMs": 617760,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "there will always be some impurities,"
    } ]
  }, {
    "tStartMs": 620070,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "like sulfur, phosphorus,\nand silicon oxides."
    } ]
  }, {
    "tStartMs": 623730,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They combine with carbon from the charcoal"
    } ]
  }, {
    "tStartMs": 626250,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and melt at a lower temperature than iron,"
    } ]
  }, {
    "tStartMs": 628920,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "so they become liquid\nand flow to the bottom."
    } ]
  }, {
    "tStartMs": 632430,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "This is known as slag."
    } ]
  }, {
    "tStartMs": 635490,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "After many more hours of\nadding charcoal and iron sand,"
    } ]
  }, {
    "tStartMs": 639150,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "it is time for the first\nremoval of the slag."
    } ]
  }, {
    "tStartMs": 643290,
    "dDurationMs": 3283,
    "segs": [ {
      "utf8": "Before the first removal of\nslag, another prayer is said."
    } ]
  }, {
    "tStartMs": 646573,
    "dDurationMs": 3347,
    "segs": [ {
      "utf8": "(steelworkers clap)"
    } ]
  }, {
    "tStartMs": 649920,
    "dDurationMs": 1187,
    "segs": [ {
      "utf8": "- Oh, that's insane."
    } ]
  }, {
    "tStartMs": 666287,
    "dDurationMs": 1875,
    "segs": [ {
      "utf8": "(slag sizzles)"
    } ]
  }, {
    "tStartMs": 668162,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 670707,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(hammer pinging)"
    } ]
  }, {
    "tStartMs": 675512,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Whoa."
    } ]
  }, {
    "tStartMs": 678750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So for the last three hours,"
    } ]
  }, {
    "tStartMs": 680100,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "there's been three processes\nthat we've been doing."
    } ]
  }, {
    "tStartMs": 682950,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "One is adding the charcoal,\ntwo is adding the iron sand,"
    } ]
  }, {
    "tStartMs": 686880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and three is opening up\nthe smelter from the bottom"
    } ]
  }, {
    "tStartMs": 690600,
    "dDurationMs": 3907,
    "segs": [ {
      "utf8": "to break apart the impurities\nso they can flow out."
    } ]
  }, {
    "tStartMs": 703420,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(shovels scrape)"
    } ]
  }, {
    "tStartMs": 714480,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Just want you guys to know\nthat it's 3:16 in the morning"
    } ]
  }, {
    "tStartMs": 717960,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and I'm still here and I'm really sleepy."
    } ]
  }, {
    "tStartMs": 721632,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 726360,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So it's currently six o'clock\nin the morning the next day."
    } ]
  }, {
    "tStartMs": 729330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "We've been smelting for 21 hours."
    } ]
  }, {
    "tStartMs": 731160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "I'm exhausted, but the\nsun is about to come out"
    } ]
  }, {
    "tStartMs": 733770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and it's been pretty\namazing, I gotta be honest."
    } ]
  }, {
    "tStartMs": 736110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "We gotta close these doors really quick"
    } ]
  }, {
    "tStartMs": 737640,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "before they get mad at me."
    } ]
  }, {
    "tStartMs": 740730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] At 9:00 AM the next morning,"
    } ]
  }, {
    "tStartMs": 742350,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the smelting is complete."
    } ]
  }, {
    "tStartMs": 744510,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "A total of 614 kilograms of iron sand"
    } ]
  }, {
    "tStartMs": 748230,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "and 670 kilograms of charcoal\nwere added to the smelter."
    } ]
  }, {
    "tStartMs": 753930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "At this point, in a traditional smelter,"
    } ]
  }, {
    "tStartMs": 756000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the only way to get the steel out"
    } ]
  }, {
    "tStartMs": 757590,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "would be to break it apart."
    } ]
  }, {
    "tStartMs": 762270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "These days, a crane is used"
    } ]
  }, {
    "tStartMs": 764190,
    "dDurationMs": 1539,
    "segs": [ {
      "utf8": "to take the smelter apart."
    } ]
  }, {
    "tStartMs": 765729,
    "dDurationMs": 1659,
    "segs": [ {
      "utf8": "- [Petr] Oh wow, okay."
    } ]
  }, {
    "tStartMs": 767388,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh!"
    } ]
  }, {
    "tStartMs": 771030,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- [Derek] And what is left to\nshow for all that hard work"
    } ]
  }, {
    "tStartMs": 773970,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "is a 100 kilogram block\nof steel, iron, and slag."
    } ]
  }, {
    "tStartMs": 778590,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Only around a third of this\nblock is high enough quality"
    } ]
  }, {
    "tStartMs": 781770,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "to be used in sword making."
    } ]
  }, {
    "tStartMs": 783470,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "(crane whirs and clunks)"
    } ]
  }, {
    "tStartMs": 786120,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- Oh, that's insane. That's so cool."
    } ]
  }, {
    "tStartMs": 789900,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "The result for all the hard work."
    } ]
  }, {
    "tStartMs": 795750,
    "dDurationMs": 3864,
    "segs": [ {
      "utf8": "This is step one of\nmaking a Japanese sword."
    } ]
  }, {
    "tStartMs": 799614,
    "dDurationMs": 1446,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 801060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- [Derek] The steel is sorted\nby quality and carbon content,"
    } ]
  }, {
    "tStartMs": 804000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "which is also done by eye,"
    } ]
  }, {
    "tStartMs": 806070,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in fact, this is one of\nthe exams you need to pass"
    } ]
  }, {
    "tStartMs": 808470,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "to be certified as a swordsmith."
    } ]
  }, {
    "tStartMs": 811320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Then, the different grades\nof steel are sent out"
    } ]
  }, {
    "tStartMs": 813540,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to one of 300 swordsmiths\naround the country."
    } ]
  }, {
    "tStartMs": 816990,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Only 30 do it as their full-time job,"
    } ]
  }, {
    "tStartMs": 820020,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and one of them is Akihara Kokaji,"
    } ]
  }, {
    "tStartMs": 822810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "who we went to visit next."
    } ]
  }, {
    "tStartMs": 824880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This is when the forging\nof the sword begins."
    } ]
  }, {
    "tStartMs": 828000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "In a coal oven with hand-pumped bellows,"
    } ]
  }, {
    "tStartMs": 830400,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the steel is heated until\nit is soft and malleable."
    } ]
  }, {
    "tStartMs": 834720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Then using hammers,"
    } ]
  }, {
    "tStartMs": 836040,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "the master swordsmith\nflattens out the steel."
    } ]
  }, {
    "tStartMs": 839850,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "In the old days, this would've\nbeen done by the swordsmith"
    } ]
  }, {
    "tStartMs": 842580,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and three apprentices."
    } ]
  }, {
    "tStartMs": 844140,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The swordsmith using a smaller\nhammer, would set the rhythm"
    } ]
  }, {
    "tStartMs": 847350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and the apprentices would use big mallets"
    } ]
  }, {
    "tStartMs": 849600,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "to flatten the steel."
    } ]
  }, {
    "tStartMs": 852673,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(hammers clank)\n(Petr grunts)"
    } ]
  }, {
    "tStartMs": 858910,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Woo. That was terrifying."
    } ]
  }, {
    "tStartMs": 863010,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "- [Derek] These days,\nelectric hammers are used."
    } ]
  }, {
    "tStartMs": 873690,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "When the steel is flat enough,"
    } ]
  }, {
    "tStartMs": 876750,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "it is then bent back on itself,"
    } ]
  }, {
    "tStartMs": 884785,
    "dDurationMs": 3252,
    "segs": [ {
      "utf8": "(fire crackles)"
    } ]
  }, {
    "tStartMs": 888037,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "and it is then hammered again"
    } ]
  }, {
    "tStartMs": 889320,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "to press the steel back\ntogether into a solid block."
    } ]
  }, {
    "tStartMs": 893813,
    "dDurationMs": 3217,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 897030,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So why go to all this\neffort flattening the steel,"
    } ]
  }, {
    "tStartMs": 899730,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "only to fold it back on itself"
    } ]
  }, {
    "tStartMs": 901650,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "and end up with a chunk of\nsteel the same size as before?"
    } ]
  }, {
    "tStartMs": 906240,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Well, because folding does\ntwo very important things."
    } ]
  }, {
    "tStartMs": 909840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "First, it spreads out the impurities"
    } ]
  }, {
    "tStartMs": 912030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "like silicon, sulfur, and phosphorus."
    } ]
  }, {
    "tStartMs": 914700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It spreads them out throughout the steel."
    } ]
  }, {
    "tStartMs": 916890,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "This ensures a uniform consistency\nwithout any weak points."
    } ]
  }, {
    "tStartMs": 921660,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Second, it gives the steel a grain."
    } ]
  }, {
    "tStartMs": 924630,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "After folding the sword,\nit is now reinforced"
    } ]
  }, {
    "tStartMs": 927330,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "in the direction that it\nwill be hit in combat,"
    } ]
  }, {
    "tStartMs": 930540,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and as a bonus, the steel\nis exposed to the air."
    } ]
  }, {
    "tStartMs": 933750,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So there is a small amount"
    } ]
  }, {
    "tStartMs": 935220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "of oxidation creating\na darker colored steel,"
    } ]
  }, {
    "tStartMs": 938640,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "which when folded makes\nbeautiful patterns."
    } ]
  }, {
    "tStartMs": 942990,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "There are some swords which\nhave more than a billion layers."
    } ]
  }, {
    "tStartMs": 947220,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Now this doesn't mean the sword"
    } ]
  }, {
    "tStartMs": 948480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "has been folded a billion times"
    } ]
  }, {
    "tStartMs": 950610,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "since every fold doubles\nthe number of layers,"
    } ]
  }, {
    "tStartMs": 953670,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "so you only need about 30\nfolds to get a billion layers."
    } ]
  }, {
    "tStartMs": 958290,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But usually a sword is\nfolded 10 to 13 times,"
    } ]
  }, {
    "tStartMs": 961770,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "resulting in a few\nthousand layers of steel."
    } ]
  }, {
    "tStartMs": 965850,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Now a blade isn't made from\na single block of steel."
    } ]
  }, {
    "tStartMs": 969060,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The carbon content affects\nhow hard the steel is."
    } ]
  }, {
    "tStartMs": 972180,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So different carbon percentages"
    } ]
  }, {
    "tStartMs": 973830,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "are used in different parts of the blade."
    } ]
  }, {
    "tStartMs": 977430,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Because carbon atoms are\nmuch smaller than iron atoms,"
    } ]
  }, {
    "tStartMs": 980460,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "they can fit inside the\ncrystal lattice of iron."
    } ]
  }, {
    "tStartMs": 983850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "These trapped carbon atoms"
    } ]
  }, {
    "tStartMs": 985500,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "then apply an outward force to the lattice"
    } ]
  }, {
    "tStartMs": 987990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "putting the steel under stress."
    } ]
  }, {
    "tStartMs": 990270,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The higher the carbon percentage,"
    } ]
  }, {
    "tStartMs": 992040,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the harder and more rigid the steel."
    } ]
  }, {
    "tStartMs": 994950,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But this hardness comes at a cost."
    } ]
  }, {
    "tStartMs": 997230,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The steel becomes brittle,"
    } ]
  }, {
    "tStartMs": 998850,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "making it more likely to chip\nand shatter rather than bend."
    } ]
  }, {
    "tStartMs": 1004490,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So what swordsmiths do"
    } ]
  }, {
    "tStartMs": 1006440,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "is they use steel with\ndifferent carbon contents"
    } ]
  }, {
    "tStartMs": 1009110,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "for different parts of the blade."
    } ]
  }, {
    "tStartMs": 1011120,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The edge is always high carbon steel"
    } ]
  }, {
    "tStartMs": 1013490,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to make it hard and rigid"
    } ]
  }, {
    "tStartMs": 1014960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "so it can maintain a sharp\nedge for a long time."
    } ]
  }, {
    "tStartMs": 1018170,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But the spine is usually\nmade of lower-carbon steel,"
    } ]
  }, {
    "tStartMs": 1021050,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "which allows the sword\nto flex without breaking."
    } ]
  }, {
    "tStartMs": 1024590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "This is done by welding\ntogether pieces of steel"
    } ]
  }, {
    "tStartMs": 1027590,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "with different carbon contents."
    } ]
  }, {
    "tStartMs": 1030620,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- So we have about a 15-minute break"
    } ]
  }, {
    "tStartMs": 1033830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "because you know it takes\na while for the iron"
    } ]
  }, {
    "tStartMs": 1036500,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to heat up and then meld together,"
    } ]
  }, {
    "tStartMs": 1038990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and then we're back in there."
    } ]
  }, {
    "tStartMs": 1040910,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It's very hot. It's\nvery, very hot in there."
    } ]
  }, {
    "tStartMs": 1043610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It's kind of unbelievable"
    } ]
  }, {
    "tStartMs": 1045470,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that he can do this for\nfour hours at a time."
    } ]
  }, {
    "tStartMs": 1048710,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Derek] After the sword\nis hammered into shape,"
    } ]
  }, {
    "tStartMs": 1051110,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "which is a straight blade, it\nis covered in a layer of clay,"
    } ]
  }, {
    "tStartMs": 1055880,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "a thick layer for the spine,"
    } ]
  }, {
    "tStartMs": 1057740,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and a thin layer for the blade itself."
    } ]
  }, {
    "tStartMs": 1060200,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It's then heated in the furnace"
    } ]
  }, {
    "tStartMs": 1062030,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and then rapidly cooled in water,"
    } ]
  }, {
    "tStartMs": 1064610,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "a process known as quenching."
    } ]
  }, {
    "tStartMs": 1067280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Now, because the layers of clay\nhave different thicknesses,"
    } ]
  }, {
    "tStartMs": 1070130,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "the rate of cooling is faster\nfor the edge than the spine."
    } ]
  }, {
    "tStartMs": 1075080,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "When the steel is heated,\ncarbon enters the iron lattice,"
    } ]
  }, {
    "tStartMs": 1079190,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and since the spine of the\nsword is covered in thick clay,"
    } ]
  }, {
    "tStartMs": 1082100,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "it will cool slowly,"
    } ]
  }, {
    "tStartMs": 1083870,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "giving time for the carbon\natoms to leave the iron matrix."
    } ]
  }, {
    "tStartMs": 1087500,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "This will lead to a very\nlow-carbon steel called ferrite,"
    } ]
  }, {
    "tStartMs": 1091280,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but the carbon atoms\nwhich have left the matrix"
    } ]
  }, {
    "tStartMs": 1093470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "will be caught by other iron atoms"
    } ]
  }, {
    "tStartMs": 1095480,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and created a type of\nsteel known as cementite."
    } ]
  }, {
    "tStartMs": 1098390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The combination of ferrite and cementite"
    } ]
  }, {
    "tStartMs": 1100610,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "is known as perlite,"
    } ]
  }, {
    "tStartMs": 1102140,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and it's a mostly soft\nand ductile form of steel,"
    } ]
  }, {
    "tStartMs": 1105500,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "though parts of it are\nhard due to the cementite."
    } ]
  }, {
    "tStartMs": 1108860,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "So per light forms the spine of the sword."
    } ]
  }, {
    "tStartMs": 1112640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "In contrast, the very thin\nlayer of clay on the blade"
    } ]
  }, {
    "tStartMs": 1115400,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "means that it cools very rapidly,"
    } ]
  }, {
    "tStartMs": 1117830,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "so more of the carbon is\ntrapped in the lattice."
    } ]
  }, {
    "tStartMs": 1121010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "This forces the lattice structure"
    } ]
  }, {
    "tStartMs": 1122600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to change from cubic to tetragonal"
    } ]
  }, {
    "tStartMs": 1125690,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "making a form of steel\nknown as martensite."
    } ]
  }, {
    "tStartMs": 1129080,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Since the trapped carbon\nputs stress on the lattice,"
    } ]
  }, {
    "tStartMs": 1132050,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "martensite is incredibly hard,"
    } ]
  }, {
    "tStartMs": 1134540,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "exactly what you'd want\nfor the edge of a sword."
    } ]
  }, {
    "tStartMs": 1140330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The tetragonal lattice\nstructure of martensite"
    } ]
  }, {
    "tStartMs": 1142460,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "also takes up more space"
    } ]
  }, {
    "tStartMs": 1144170,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "so the edge of the blade\nexpands relative to the spine,"
    } ]
  }, {
    "tStartMs": 1147290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "curving the sword backwards."
    } ]
  }, {
    "tStartMs": 1149390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The iconic curve of a samurai sword"
    } ]
  }, {
    "tStartMs": 1151760,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "comes from the formation of martensite."
    } ]
  }, {
    "tStartMs": 1155750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "You can actually see the boundary"
    } ]
  }, {
    "tStartMs": 1157340,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "between different types of\nsteel in a finished sword"
    } ]
  }, {
    "tStartMs": 1160520,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "by the difference in color."
    } ]
  }, {
    "tStartMs": 1162650,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "This is known as hamon, which\nliterally means edge pattern."
    } ]
  }, {
    "tStartMs": 1168897,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "- At the Victoria Albert Museum in London,"
    } ]
  }, {
    "tStartMs": 1171530,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "there is a Japanese sword"
    } ]
  }, {
    "tStartMs": 1173300,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that has a very detailed\nlittle dragon in the hamon,"
    } ]
  }, {
    "tStartMs": 1176090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and I've looked at it many times."
    } ]
  }, {
    "tStartMs": 1177470,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "I don't, okay, I don't know\nhow he did that. (laughs)"
    } ]
  }, {
    "tStartMs": 1180980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] About one third of all blades"
    } ]
  }, {
    "tStartMs": 1183260,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "shatter during the quenching process."
    } ]
  }, {
    "tStartMs": 1186110,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- You quench it once"
    } ]
  }, {
    "tStartMs": 1187400,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and you thank the stars that you made it."
    } ]
  }, {
    "tStartMs": 1190640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Derek] The sword is then\nplaced back in the forage"
    } ]
  }, {
    "tStartMs": 1192950,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to evaporate any remaining water."
    } ]
  }, {
    "tStartMs": 1195740,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "This also provides a little bit of energy"
    } ]
  }, {
    "tStartMs": 1197600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to loosen some of the crystal structures"
    } ]
  }, {
    "tStartMs": 1199880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "making the sword less brittle."
    } ]
  }, {
    "tStartMs": 1201830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- And that's about the extent"
    } ]
  }, {
    "tStartMs": 1203090,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of the tempering process\non a Japanese sword,"
    } ]
  }, {
    "tStartMs": 1206330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which that that might be\nenough to relax things a bit,"
    } ]
  }, {
    "tStartMs": 1208670,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but they kept the edge much harder"
    } ]
  }, {
    "tStartMs": 1211430,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "than you would've in the West."
    } ]
  }, {
    "tStartMs": 1213950,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] After the sword is forged,"
    } ]
  }, {
    "tStartMs": 1215360,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "it is sent to a polisher."
    } ]
  }, {
    "tStartMs": 1217370,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The polishing and sharpening of a sword"
    } ]
  }, {
    "tStartMs": 1219530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "is also done by hand"
    } ]
  }, {
    "tStartMs": 1221450,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "with whetstones of different coarsenesses."
    } ]
  }, {
    "tStartMs": 1224690,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It can take a month to sharpen\nand polish a single sword."
    } ]
  }, {
    "tStartMs": 1229250,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- One of the things that\nI love is that like,"
    } ]
  }, {
    "tStartMs": 1231920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "this table is sloping down"
    } ]
  }, {
    "tStartMs": 1233780,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and the entire floor over\nthere is sloping down."
    } ]
  }, {
    "tStartMs": 1236630,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So when you like add the water,"
    } ]
  }, {
    "tStartMs": 1238730,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "all of the residue and all the water,"
    } ]
  }, {
    "tStartMs": 1240770,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "you know, flows downhill\nso it's not perfectly flat."
    } ]
  }, {
    "tStartMs": 1243893,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "(hammer taps softly)"
    } ]
  }, {
    "tStartMs": 1246050,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Derek] Sometimes the swords"
    } ]
  }, {
    "tStartMs": 1247070,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "are also engraved with beautiful patterns,"
    } ]
  }, {
    "tStartMs": 1249740,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "though this is quite rare."
    } ]
  }, {
    "tStartMs": 1254630,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "And after all that, the sword is done."
    } ]
  }, {
    "tStartMs": 1259190,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "To learn how to use a Japanese sword,"
    } ]
  }, {
    "tStartMs": 1261320,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Petr got a lesson from a\nmaster, Takara Takanashi."
    } ]
  }, {
    "tStartMs": 1265880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "He is the 10th-generation student"
    } ]
  }, {
    "tStartMs": 1268280,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "of Miyamoto Musashi, a legendary samurai."
    } ]
  }, {
    "tStartMs": 1272990,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Musashi killed his first\nopponent in single combat"
    } ]
  }, {
    "tStartMs": 1276200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "at the age of 13."
    } ]
  }, {
    "tStartMs": 1278450,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "He spent the rest of his life\nperfecting his sword-fighting,"
    } ]
  }, {
    "tStartMs": 1281420,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "inventing a new technique with two swords."
    } ]
  }, {
    "tStartMs": 1284900,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Musashi fought in more\nthan 60 duels to the death,"
    } ]
  }, {
    "tStartMs": 1288290,
    "dDurationMs": 2512,
    "segs": [ {
      "utf8": "and he won every last one of them."
    } ]
  }, {
    "tStartMs": 1290802,
    "dDurationMs": 1875,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 1292677,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 1293720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "There is a story about a duel"
    } ]
  }, {
    "tStartMs": 1295400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that took place during a snowstorm."
    } ]
  }, {
    "tStartMs": 1297800,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "As he faced his opponent,\nkatana outstretched,"
    } ]
  }, {
    "tStartMs": 1300860,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Musashi was so calm and\nkept his sword so still"
    } ]
  }, {
    "tStartMs": 1304310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that snowflakes began to accumulate"
    } ]
  }, {
    "tStartMs": 1306500,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "on the thin edge of the blade."
    } ]
  }, {
    "tStartMs": 1311330,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Petr] So during the lesson,"
    } ]
  }, {
    "tStartMs": 1312350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I thought I would get to use a katana,"
    } ]
  }, {
    "tStartMs": 1315050,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but instead we spent the entire time"
    } ]
  }, {
    "tStartMs": 1317600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "learning how to take the\nblade out of its sheath"
    } ]
  }, {
    "tStartMs": 1319940,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "and then put it back in."
    } ]
  }, {
    "tStartMs": 1324470,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So when I actually got\nthe chance to use a katana"
    } ]
  }, {
    "tStartMs": 1327710,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "to slice through some things,\nI was deeply unprepared."
    } ]
  }, {
    "tStartMs": 1333756,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(katana thuds)"
    } ]
  }, {
    "tStartMs": 1337668,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "(playful music)"
    } ]
  }, {
    "tStartMs": 1340130,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "- [Producer] Well, it\nlooks like it's your turn."
    } ]
  }, {
    "tStartMs": 1342655,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "I'm so scared."
    } ]
  }, {
    "tStartMs": 1344970,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Okay, so this has been an amazing day."
    } ]
  }, {
    "tStartMs": 1347000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "We've looked at some beautiful katanas,"
    } ]
  }, {
    "tStartMs": 1349070,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and now these wonderful\npeople are letting me use one"
    } ]
  }, {
    "tStartMs": 1351680,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "of their just unbelievably\nbeautiful pieces of art"
    } ]
  }, {
    "tStartMs": 1355610,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "to chop some things."
    } ]
  }, {
    "tStartMs": 1357195,
    "dDurationMs": 3732,
    "segs": [ {
      "utf8": "(Petr exhales forcefully)"
    } ]
  }, {
    "tStartMs": 1360927,
    "dDurationMs": 2811,
    "segs": [ {
      "utf8": "(katana thuds)\n- Oh."
    } ]
  }, {
    "tStartMs": 1363738,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1364571,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Woo!"
    } ]
  }, {
    "tStartMs": 1366657,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "Like this is kind of the best day ever."
    } ]
  }, {
    "tStartMs": 1370805,
    "dDurationMs": 2415,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 1373220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Derek] There really\nis something remarkable"
    } ]
  }, {
    "tStartMs": 1375230,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "about Japanese swords."
    } ]
  }, {
    "tStartMs": 1376970,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The amount of care,\nattention, and expertise"
    } ]
  }, {
    "tStartMs": 1379700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that each step requires,"
    } ]
  }, {
    "tStartMs": 1381500,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "from the gathering and\nrefining of the iron sand"
    } ]
  }, {
    "tStartMs": 1383930,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to the smelting,"
    } ]
  }, {
    "tStartMs": 1384763,
    "dDurationMs": 2617,
    "segs": [ {
      "utf8": "to the forging and sharpening a sword,"
    } ]
  }, {
    "tStartMs": 1387380,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "each step takes so much time and skill."
    } ]
  }, {
    "tStartMs": 1390680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It's incredible that all\nthese things were discovered"
    } ]
  }, {
    "tStartMs": 1393260,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "by trial and error to produce\nartifacts of such high quality"
    } ]
  }, {
    "tStartMs": 1397610,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "that they are still\nprized centuries later."
    } ]
  }, {
    "tStartMs": 1400603,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "(steelworkers speaking Japanese)"
    } ]
  }, {
    "tStartMs": 1402925,
    "dDurationMs": 2755,
    "segs": [ {
      "utf8": "(steelworkers clap)"
    } ]
  }, {
    "tStartMs": 1405680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] Before I made this video,"
    } ]
  }, {
    "tStartMs": 1407120,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I didn't really appreciate"
    } ]
  }, {
    "tStartMs": 1408530,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that swords can be art."
    } ]
  }, {
    "tStartMs": 1411140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "To me, it's a good reminder\nthat whatever you do,"
    } ]
  }, {
    "tStartMs": 1413480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you should do it with deep\ncare, attention to detail,"
    } ]
  }, {
    "tStartMs": 1416480,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "and love for the craft."
    } ]
  }, {
    "tStartMs": 1418127,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "(both speaking Japanese)"
    } ]
  }, {
    "tStartMs": 1420980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Do that enough times"
    } ]
  }, {
    "tStartMs": 1422630,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "and you might just make\nsomething beautiful."
    } ]
  }, {
    "tStartMs": 1426731,
    "dDurationMs": 3939,
    "segs": [ {
      "utf8": "(audio chimes and warbles)"
    } ]
  }, {
    "tStartMs": 1430670,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Hey, this part of the video"
    } ]
  }, {
    "tStartMs": 1431810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "was brought to you by Henson Shaving."
    } ]
  }, {
    "tStartMs": 1434450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You know, making high\nquality things is hard,"
    } ]
  }, {
    "tStartMs": 1437000,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and as far as I'm concerned,"
    } ]
  }, {
    "tStartMs": 1438260,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Henson make the highest-quality\nrazors in the world,"
    } ]
  }, {
    "tStartMs": 1441740,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the katanas of the shaving\nworld, if you will."
    } ]
  }, {
    "tStartMs": 1444470,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I've been using their AL-13\nrazor for the last year,"
    } ]
  }, {
    "tStartMs": 1447170,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it's the best razor\nI've used by a long margin."
    } ]
  }, {
    "tStartMs": 1450590,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "One of the reasons for that"
    } ]
  }, {
    "tStartMs": 1451700,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "is Henson really understands\nthe physics of shaving,"
    } ]
  }, {
    "tStartMs": 1454940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "because as aerospace\nmachinists for 20 years,"
    } ]
  }, {
    "tStartMs": 1458030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "they understand how to\ncut things effectively."
    } ]
  }, {
    "tStartMs": 1460430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "They get precision."
    } ]
  }, {
    "tStartMs": 1462320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Human hair is much harder than\nthe skin it's growing out of,"
    } ]
  }, {
    "tStartMs": 1465170,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and as a result, typical razors drag"
    } ]
  }, {
    "tStartMs": 1467390,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and pull on the hair while cutting."
    } ]
  }, {
    "tStartMs": 1469460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "What a multi-blade\nrazor does is it assumes"
    } ]
  }, {
    "tStartMs": 1471980,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that the first cut will be ineffective,"
    } ]
  }, {
    "tStartMs": 1473810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and so they build in extra\nblades to cut the hair"
    } ]
  }, {
    "tStartMs": 1476450,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "before it can snap back into position."
    } ]
  }, {
    "tStartMs": 1478670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And that does result in a good cut,"
    } ]
  }, {
    "tStartMs": 1480530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but it also increases friction"
    } ]
  }, {
    "tStartMs": 1482750,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "leading to razor burn and skin irritation."
    } ]
  }, {
    "tStartMs": 1485540,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Henson carefully studied that problem"
    } ]
  }, {
    "tStartMs": 1487490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and realized that you didn't\nneed to add extra blades,"
    } ]
  }, {
    "tStartMs": 1490040,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "you just needed to properly\nsupport a single blade."
    } ]
  }, {
    "tStartMs": 1493430,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Virtually every razor on allows"
    } ]
  }, {
    "tStartMs": 1495290,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "for too much play in the\nblade, but Henson doesn't."
    } ]
  }, {
    "tStartMs": 1499010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The result is an effective cut"
    } ]
  }, {
    "tStartMs": 1500660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "without the additional\nfriction on your skin."
    } ]
  }, {
    "tStartMs": 1503300,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Seriously, a Henson is\ntruly a great razor."
    } ]
  }, {
    "tStartMs": 1505850,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It'll last you a lifetime."
    } ]
  }, {
    "tStartMs": 1507530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "You will get a better\nshave with less irritation,"
    } ]
  }, {
    "tStartMs": 1509720,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and you'll also save\nmoney in the long run."
    } ]
  }, {
    "tStartMs": 1512030,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So head over to\nhensonshaving.com/veritasium"
    } ]
  }, {
    "tStartMs": 1515120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "or scan the QR code here"
    } ]
  }, {
    "tStartMs": 1516890,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and enter code \"veritasium\"\nfor a hundred free blades"
    } ]
  }, {
    "tStartMs": 1519770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "with a purchase of any razor."
    } ]
  }, {
    "tStartMs": 1521660,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I wanna thank Henson Shaving\nfor supporting Veritasium,"
    } ]
  }, {
    "tStartMs": 1524240,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
