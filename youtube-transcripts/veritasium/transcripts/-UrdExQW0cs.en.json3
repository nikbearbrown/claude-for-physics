    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Just go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1454610,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I will put that link\ndown in the description."
    } ]
  }, {
    "tStartMs": 1456920,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And for viewers of this\nvideo, Brilliant is offering"
    } ]
  }, {
