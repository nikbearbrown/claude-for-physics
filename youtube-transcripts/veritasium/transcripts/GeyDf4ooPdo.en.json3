{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1590,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "I am here at the University of Sydney where\nthe mechanical engineering shop has built"
    } ]
  }, {
    "tStartMs": 6190,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "this incredible piece of apparatus for me."
    } ]
  }, {
    "tStartMs": 8570,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "It is a forty pound, that is nineteen kilogram\nflywheel on the end of a meter long shaft."
    } ]
  }, {
    "tStartMs": 14160,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Can you imagine trying to hold this out horizontally\nwith just one hand at this end?"
    } ]
  }, {
    "tStartMs": 19720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "It is virtually..."
    } ]
  }, {
    "tStartMs": 22390,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "it is impossible, ok?"
    } ]
  }, {
    "tStartMs": 23390,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "No I'm going to let go."
    } ]
  }, {
    "tStartMs": 25380,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "You going to be able to hold this at all?"
    } ]
  }, {
    "tStartMs": 27310,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "I hope so."
    } ]
  }, {
    "tStartMs": 28740,
    "dDurationMs": 1431,
    "segs": [ {
      "utf8": "Can you lift it out?"
    } ]
  }, {
    "tStartMs": 30171,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "Make it horizontal - hold it, hold it, hold\nit."
    } ]
  }, {
    "tStartMs": 31590,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Come on."
    } ]
  }, {
    "tStartMs": 32590,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Just try to - I want you to hold it out horizontal."
    } ]
  }, {
    "tStartMs": 33880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "See if you can."
    } ]
  }, {
    "tStartMs": 34880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Hold it, hold it!"
    } ]
  }, {
    "tStartMs": 35880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Ahh, come on!"
    } ]
  }, {
    "tStartMs": 36880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 37880,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "What I'm going to do is I am going to spin\nthis up to a few thousand RPM and then I'm"
    } ]
  }, {
    "tStartMs": 43230,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "going to attempt just that, to hold it from\none end and have it out horizontally."
    } ]
  }, {
    "tStartMs": 48190,
    "dDurationMs": 7800,
    "segs": [ {
      "utf8": "Five, four, three, two, one."
    } ]
  }, {
    "tStartMs": 55990,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Boom."
    } ]
  }, {
    "tStartMs": 57550,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "I'm going to let go with my left hand."
    } ]
  }, {
    "tStartMs": 63550,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "What you'll see is that the shaft remains\nhorizontal, see it going around there."
    } ]
  }, {
    "tStartMs": 69630,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "It almost looks as though the wheel is weightless."
    } ]
  }, {
    "tStartMs": 72200,
    "dDurationMs": 1259,
    "segs": [ {
      "utf8": "How does this work?"
    } ]
  }, {
    "tStartMs": 73459,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "Well instead of pulling the wheel down to\nthe ground as you'd expect, the weight of"
    } ]
  }, {
    "tStartMs": 77140,
    "dDurationMs": 3519,
    "segs": [ {
      "utf8": "the wheel creates a torque which pushes it\naround in a circle."
    } ]
  }, {
    "tStartMs": 80659,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "You may recognise this as gyroscopic precession."
    } ]
  }, {
    "tStartMs": 83479,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "For a more detailed explanation, click the\nannotation, or the link in the description"
    } ]
  }, {
    "tStartMs": 87049,
    "dDurationMs": 2491,
    "segs": [ {
      "utf8": "to see my video on the topic."
    } ]
  }, {
    "tStartMs": 89540,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "Here I want to try something more extreme."
    } ]
  }, {
    "tStartMs": 92049,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "I'm going to try to lift it over my head with\none hand while it's spinning."
    } ]
  }, {
    "tStartMs": 97549,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Wish me luck."
    } ]
  }, {
    "tStartMs": 98549,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But before I make the attempt, Rod wisely\nsuggests that I first check if I can lift"
    } ]
  }, {
    "tStartMs": 102549,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the wheel above my head without it spinning."
    } ]
  }, {
    "tStartMs": 104389,
    "dDurationMs": 4011,
    "segs": [ {
      "utf8": "OK, let's prove that I could lift it, just\nthis end, without it spinning."
    } ]
  }, {
    "tStartMs": 108400,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "Here we go."
    } ]
  }, {
    "tStartMs": 109829,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "agggh\nI mean it's just kind of awkward with the"
    } ]
  }, {
    "tStartMs": 113700,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "hand."
    } ]
  }, {
    "tStartMs": 114770,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Careful!"
    } ]
  }, {
    "tStartMs": 115850,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Ah, che\nCareful!"
    } ]
  }, {
    "tStartMs": 119090,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "Ha\nOooohhh"
    } ]
  }, {
    "tStartMs": 121249,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Just barely."
    } ]
  }, {
    "tStartMs": 123409,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "Oh goodness, do you even lift?"
    } ]
  }, {
    "tStartMs": 127859,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Clearly I do not."
    } ]
  }, {
    "tStartMs": 128859,
    "dDurationMs": 4591,
    "segs": [ {
      "utf8": "Undaunted by my lack of strength, I'm going\nfor it, but I want to make sure the wheel"
    } ]
  }, {
    "tStartMs": 133450,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "is spinning as fast as possible to give me\nthe best chance of success."
    } ]
  }, {
    "tStartMs": 137590,
    "dDurationMs": 2629,
    "segs": [ {
      "utf8": "Give it ten more seconds."
    } ]
  }, {
    "tStartMs": 140219,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "Ten, nine, eight, seven, six, five, four,\nthree, two, one."
    } ]
  }, {
    "tStartMs": 145489,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Pull!"
    } ]
  }, {
    "tStartMs": 146489,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Go."
    } ]
  }, {
    "tStartMs": 147489,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That was perfect."
    } ]
  }, {
    "tStartMs": 148489,
    "dDurationMs": 5611,
    "segs": [ {
      "utf8": "Now I'm going to release my left hand and\nholding only with my right hand at the end"
    } ]
  }, {
    "tStartMs": 154100,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "of the shaft, I'll try to lift it up over\nmy head."
    } ]
  }, {
    "tStartMs": 158980,
    "dDurationMs": 3489,
    "segs": [ {
      "utf8": "This is a forty pound, nineteen kilogram flywheel."
    } ]
  }, {
    "tStartMs": 162469,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Ready?"
    } ]
  }, {
    "tStartMs": 163629,
    "dDurationMs": 6951,
    "segs": [ {
      "utf8": "Here we go: three, two, one."
    } ]
  }, {
    "tStartMs": 170580,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "Beautiful!"
    } ]
  }, {
    "tStartMs": 171739,
    "dDurationMs": 8101,
    "segs": [ {
      "utf8": "Let's go again in three, two, one."
    } ]
  }, {
    "tStartMs": 179840,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Nice!"
    } ]
  }, {
    "tStartMs": 181000,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "Smooth."
    } ]
  }, {
    "tStartMs": 182159,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 185640,
    "dDurationMs": 28599,
    "segs": [ {
      "utf8": "It feels incredibly, incredibly light as I\ndo that."
    } ]
  }, {
    "tStartMs": 214239,
    "dDurationMs": 27790,
    "segs": [ {
      "utf8": "When you said it felt incredibly light,\nyeah"
    } ]
  }, {
    "tStartMs": 242029,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "you mean when you're lifting it feels light?"
    } ]
  }, {
    "tStartMs": 244269,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 245269,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "It shouldn't!"
    } ]
  }, {
    "tStartMs": 248529,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I know."
    } ]
  }, {
    "tStartMs": 249529,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "Hahahaha\nHonestly, I have lifted it up with one hand"
    } ]
  }, {
    "tStartMs": 251510,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "when it's not spinning."
    } ]
  }, {
    "tStartMs": 252609,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 253609,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And it feels really hard to lift it up, like\nit's a big effort."
    } ]
  }, {
    "tStartMs": 256049,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 257049,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "But with this, when it's spinning it honestly\nfelt like it was just..."
    } ]
  }, {
    "tStartMs": 260930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "wanting to go up by itself."
    } ]
  }, {
    "tStartMs": 262580,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 263580,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "It felt like I was not struggling like I was\nnot putting in the amount of force that you'd"
    } ]
  }, {
    "tStartMs": 267680,
    "dDurationMs": 3769,
    "segs": [ {
      "utf8": "think to lift that kind of weight."
    } ]
  }, {
    "tStartMs": 271449,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "I bet if you let it go, it'd crash down to\nthe ground."
    } ]
  }, {
    "tStartMs": 274350,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "It's not weightless!"
    } ]
  }, {
    "tStartMs": 275389,
    "dDurationMs": 1131,
    "segs": [ {
      "utf8": "We can't do that though."
    } ]
  }, {
    "tStartMs": 276520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "We can't do that part of the experiment."
    } ]
  }, {
    "tStartMs": 278020,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "What we could maybe do is I could stand on\na scale and we could see what the weight of"
    } ]
  }, {
    "tStartMs": 283520,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "me plus that apparatus does, while I'm lifting\nit up over my head, see if I get lighter in"
    } ]
  }, {
    "tStartMs": 288270,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "essence."
    } ]
  }, {
    "tStartMs": 289270,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "You can see that just my weight is about 72\nkilograms."
    } ]
  }, {
    "tStartMs": 292500,
    "dDurationMs": 7470,
    "segs": [ {
      "utf8": "Now when I pick up the flywheel it goes up\nto about 91 kilograms, which makes sense because"
    } ]
  }, {
    "tStartMs": 299970,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "the flywheel itself is about 19 kilos, that's\nabout 42 pounds."
    } ]
  }, {
    "tStartMs": 303610,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Now we're going to spin it up and I want you\nto make a prediction."
    } ]
  }, {
    "tStartMs": 306280,
    "dDurationMs": 4949,
    "segs": [ {
      "utf8": "As I'm lifting it over my head, do you think\nthe scale reading will be more, less than,"
    } ]
  }, {
    "tStartMs": 311229,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "or equal to 91 kilograms."
    } ]
  }, {
    "tStartMs": 313420,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "What do you think?"
    } ]
  }, {
    "tStartMs": 316370,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "You can make your prediction by clicking on\none of the on-screen annotations or if you're"
    } ]
  }, {
    "tStartMs": 320180,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "on mobile you can click a link in the description."
    } ]
  }, {
    "tStartMs": 323050,
    "dDurationMs": 6989,
    "segs": [ {
      "utf8": "Five, four, three, two, one."
    } ]
  } ]
}
