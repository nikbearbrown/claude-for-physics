{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 3100,
    "dDurationMs": 8840,
    "segs": [ {
      "utf8": "Nearly 350 years ago, Isaac Newton came up with three laws of motion that govern how everything moves."
    } ]
  }, {
    "tStartMs": 12680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "There are three pretty famous laws of motion."
    } ]
  }, {
    "tStartMs": 16020,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And they're not very complicated, but if I told them to you as clearly as I can,"
    } ]
  }, {
    "tStartMs": 21080,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "You would think that you're understanding them, but I think you wouldn't."
    } ]
  }, {
    "tStartMs": 27140,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "And the reason is, everyone has ideas about physics and how objects move,"
    } ]
  }, {
    "tStartMs": 32560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Before they're ever taught anything in, uh, a science classroom."
    } ]
  }, {
    "tStartMs": 36580,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "So rather than tell you Newton's Three Laws of Motion, I like to tell you"
    } ]
  }, {
    "tStartMs": 41040,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "Derek's Three Incorrect Laws of Motion, which are the ones I think you're actually thinking."
    } ]
  }, {
    "tStartMs": 48780,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "So, Derek's First Incorrect Law of Motion is..."
    } ]
  }, {
    "tStartMs": 55120,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "An object with no unbalanced forces on it will naturally come to rest."
    } ]
  }, {
    "tStartMs": 65400,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "[Cup sliding]"
    } ]
  }, {
    "tStartMs": 67100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "[Books falling]"
    } ]
  }, {
    "tStartMs": 68000,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "[Door slamming]"
    } ]
  }, {
    "tStartMs": 69220,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "[Coin spinning and falling]"
    } ]
  }, {
    "tStartMs": 73440,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "Derek's Second Incorrect Law of Motion is that an unbalanced force causes"
    } ]
  }, {
    "tStartMs": 79360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "An object to move with a constant velocity"
    } ]
  }, {
    "tStartMs": 83420,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "We could express this in an equation."
    } ]
  }, {
    "tStartMs": 85820,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "Where the unbalanced force, F, equals the mass (M)"
    } ]
  }, {
    "tStartMs": 91040,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "times the velocity (V)"
    } ]
  }, {
    "tStartMs": 93140,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "So, if you double the force, the velocity also doubles."
    } ]
  }, {
    "tStartMs": 98320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's just like being in a car."
    } ]
  }, {
    "tStartMs": 100360,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "As you press on the accelerator, you increase the force on the car,"
    } ]
  }, {
    "tStartMs": 104280,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "and therefore, you move to a new, higher constant speed."
    } ]
  }, {
    "tStartMs": 108960,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Derek's Third Incorrect Law of Motion is that"
    } ]
  }, {
    "tStartMs": 112600,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Larger objects apply larger forces to smaller objects."
    } ]
  }, {
    "tStartMs": 117780,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "When a large truck slams into a car on the highway,"
    } ]
  }, {
    "tStartMs": 122660,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "The force of the truck on the car is much greater than the force of the car back on the truck."
    } ]
  }, {
    "tStartMs": 129900,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Or you think about the Earth and the Moon."
    } ]
  }, {
    "tStartMs": 133000,
    "dDurationMs": 6760,
    "segs": [ {
      "utf8": "The force with which the Earth attracts the Moon is greater than the force with which the Moon attracts the Earth."
    } ]
  }, {
    "tStartMs": 140500,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "But remember, this is an incorrect law of motion."
    } ]
  } ]
}
