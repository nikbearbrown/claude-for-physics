{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- We're replicating a\npsychological experiment"
    } ]
  }, {
    "tStartMs": 2670,
    "dDurationMs": 3855,
    "segs": [ {
      "utf8": "about perceptions of discomfort."
    } ]
  }, {
    "tStartMs": 6525,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(participant exhales deeply)"
    } ]
  }, {
    "tStartMs": 7358,
    "dDurationMs": 1342,
    "segs": [ {
      "utf8": "This is a bucket of cold water."
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 9533,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "- You're gonna put your hand in"
    } ]
  }, {
    "tStartMs": 10560,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and you're gonna keep it\nin there for a duration"
    } ]
  }, {
    "tStartMs": 12690,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "that we won't tell you."
    } ]
  }, {
    "tStartMs": 13920,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "As it's in the water,"
    } ]
  }, {
    "tStartMs": 15240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you can rate your\ndiscomfort on this scale."
    } ]
  }, {
    "tStartMs": 17880,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "If basically you're at\nthe point where, like,"
    } ]
  }, {
    "tStartMs": 19297,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "\"I am in agony, let me\ntake my hand outta here,\""
    } ]
  }, {
    "tStartMs": 21330,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "you can dial it up to that."
    } ]
  }, {
    "tStartMs": 22410,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- Oh my God."
    } ]
  }, {
    "tStartMs": 23430,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- Yep, can't feel my fingers"
    } ]
  }, {
    "tStartMs": 24720,
    "dDurationMs": 1118,
    "segs": [ {
      "utf8": "- Stinging.\n- A bit achey."
    } ]
  }, {
    "tStartMs": 25838,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Arctic.\n- Painful."
    } ]
  }, {
    "tStartMs": 26671,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Numb.\n- Numb."
    } ]
  }, {
    "tStartMs": 27504,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Numb.\n- [Participant] More pain."
    } ]
  }, {
    "tStartMs": 28337,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Participant] Pain maybe."
    } ]
  }, {
    "tStartMs": 29170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Pain, can't hold it."
    } ]
  }, {
    "tStartMs": 30003,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "- And obviously you've got two hands,"
    } ]
  }, {
    "tStartMs": 31110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "we'll be doing this three times."
    } ]
  }, {
    "tStartMs": 33270,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I'm replicating an experiment\noriginally conducted"
    } ]
  }, {
    "tStartMs": 35490,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "by Daniel Kahneman and\nBarbara Fredrickson in 1993."
    } ]
  }, {
    "tStartMs": 39090,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Just as in the original study,"
    } ]
  }, {
    "tStartMs": 40950,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I've told participants we're\ninvestigating the difference"
    } ]
  }, {
    "tStartMs": 43290,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "in pain perception between\ndominant and non-dominant hands."
    } ]
  }, {
    "tStartMs": 47040,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "I'm assuming you're right-handed?"
    } ]
  }, {
    "tStartMs": 48199,
    "dDurationMs": 1091,
    "segs": [ {
      "utf8": "- Yeah, I'm right-handed.\n- Okay."
    } ]
  }, {
    "tStartMs": 49290,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But that is not the true\npurpose of the experiment."
    } ]
  }, {
    "tStartMs": 53070,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Left-hand in."
    } ]
  }, {
    "tStartMs": 54000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, go ahead."
    } ]
  }, {
    "tStartMs": 54833,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Ooh, it's cold."
    } ]
  }, {
    "tStartMs": 55666,
    "dDurationMs": 944,
    "segs": [ {
      "utf8": "- And we've started."
    } ]
  }, {
    "tStartMs": 56610,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Yeah, all the way to the wrist."
    } ]
  }, {
    "tStartMs": 58140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That's good.\n(participant exhales deeply)"
    } ]
  }, {
    "tStartMs": 59340,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "What's the physical sensation like?"
    } ]
  }, {
    "tStartMs": 61050,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Cold, (laughs) freezing."
    } ]
  }, {
    "tStartMs": 62820,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- Yeah, there's like a point"
    } ]
  }, {
    "tStartMs": 63840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "where it almost feels like a muscle cramp."
    } ]
  }, {
    "tStartMs": 65460,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Both numbing and tingling."
    } ]
  }, {
    "tStartMs": 67590,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- It is getting colder and colder, yes."
    } ]
  }, {
    "tStartMs": 70860,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Host] Half of the participants\nwere randomly assigned"
    } ]
  }, {
    "tStartMs": 72870,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to use their left hand first,"
    } ]
  }, {
    "tStartMs": 74490,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the other half used\ntheir right hand first."
    } ]
  }, {
    "tStartMs": 77070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They indicated in real time"
    } ]
  }, {
    "tStartMs": 78690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "how much discomfort\nthey were experiencing."
    } ]
  }, {
    "tStartMs": 81480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- It's getting like progressively worse."
    } ]
  }, {
    "tStartMs": 83940,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- It feels cold."
    } ]
  }, {
    "tStartMs": 85290,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I wouldn't wanna stay there\nfor very much very long."
    } ]
  }, {
    "tStartMs": 88410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Good."
    } ]
  }, {
    "tStartMs": 89243,
    "dDurationMs": 907,
    "segs": [ {
      "utf8": "Are you from Russia or something?"
    } ]
  }, {
    "tStartMs": 90150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 90983,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So you're used to the-"
    } ]
  }, {
    "tStartMs": 91816,
    "dDurationMs": 972,
    "segs": [ {
      "utf8": "- I used to cold though."
    } ]
  }, {
    "tStartMs": 92788,
    "dDurationMs": 842,
    "segs": [ {
      "utf8": "(host laughs)"
    } ]
  }, {
    "tStartMs": 93630,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- At the end of the trial,"
    } ]
  }, {
    "tStartMs": 94590,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I told them to pull their hand out"
    } ]
  }, {
    "tStartMs": 96210,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and give an overall\nrating for the experience."
    } ]
  }, {
    "tStartMs": 99360,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- About a seven."
    } ]
  }, {
    "tStartMs": 100650,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 101550,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I mean, I wouldn't wanna swim in that."
    } ]
  }, {
    "tStartMs": 103050,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 103883,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Three.\n- Seven."
    } ]
  }, {
    "tStartMs": 104716,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Six."
    } ]
  }, {
    "tStartMs": 105549,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "- [Host] Then they took a 15 minute break"
    } ]
  }, {
    "tStartMs": 107310,
    "dDurationMs": 2637,
    "segs": [ {
      "utf8": "before returning to\nsubmerge their other hand."
    } ]
  }, {
    "tStartMs": 109947,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "(intense suspenseful music)"
    } ]
  }, {
    "tStartMs": 111990,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Yeah, I can't hold it."
    } ]
  }, {
    "tStartMs": 115140,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Host] Bet that's real cold, huh?"
    } ]
  }, {
    "tStartMs": 116310,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 117150,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- I could probably go\nanother minute, I reckon."
    } ]
  }, {
    "tStartMs": 120540,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- What about an hour?"
    } ]
  }, {
    "tStartMs": 121710,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 122543,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "- It's like stinging this time."
    } ]
  }, {
    "tStartMs": 124830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- It started to feel like\nI can't feel my hand now."
    } ]
  }, {
    "tStartMs": 127500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Something like that."
    } ]
  }, {
    "tStartMs": 129757,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "- [Host] (laughs) Is that a\ngood thing or a bad thing?"
    } ]
  }, {
    "tStartMs": 131280,
    "dDurationMs": 1077,
    "segs": [ {
      "utf8": "- It's a bad thing, of course."
    } ]
  }, {
    "tStartMs": 132357,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "(both laugh)"
    } ]
  }, {
    "tStartMs": 133830,
    "dDurationMs": 1425,
    "segs": [ {
      "utf8": "- How did that feel?"
    } ]
  }, {
    "tStartMs": 135255,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- It felt a lot worse than my right hand."
    } ]
  }, {
    "tStartMs": 137415,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(record scratching)"
    } ]
  }, {
    "tStartMs": 138248,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "- [Host] What participants didn't know"
    } ]
  }, {
    "tStartMs": 139500,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "is that the two trials were different."
    } ]
  }, {
    "tStartMs": 142050,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "They started out the same,"
    } ]
  }, {
    "tStartMs": 143760,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "one hand submerged in\n14 degrees Celsius water"
    } ]
  }, {
    "tStartMs": 147090,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "for 60 seconds, and one\nof the trials ended there."
    } ]
  }, {
    "tStartMs": 151020,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "But the other trial lasted\nan additional 30 seconds."
    } ]
  }, {
    "tStartMs": 155280,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "During that time, the water\ntemperature increased slightly"
    } ]
  }, {
    "tStartMs": 158700,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "to 15 degrees Celsius."
    } ]
  }, {
    "tStartMs": 161730,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "- Have I put it in here for longer"
    } ]
  }, {
    "tStartMs": 163757,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "than I did last time?"
    } ]
  }, {
    "tStartMs": 165390,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Feels like it's been a while."
    } ]
  }, {
    "tStartMs": 167130,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- [Host] This increase in\ntemperature reduced discomfort."
    } ]
  }, {
    "tStartMs": 170430,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- It seems to make the\nwater slightly warmer."
    } ]
  }, {
    "tStartMs": 173520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "It's slightly less uncomfortable."
    } ]
  }, {
    "tStartMs": 176130,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [Host] But it was still uncomfortable."
    } ]
  }, {
    "tStartMs": 179100,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This is not the sort of thing\nyou'd wanna do for hours."
    } ]
  }, {
    "tStartMs": 181650,
    "dDurationMs": 2289,
    "segs": [ {
      "utf8": "- No, I would like genuinely\njust be dead right now."
    } ]
  }, {
    "tStartMs": 183939,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "(host laughs)"
    } ]
  }, {
    "tStartMs": 185160,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Host] Again, we randomized\nwhether the long trial"
    } ]
  }, {
    "tStartMs": 187620,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "was first or second,"
    } ]
  }, {
    "tStartMs": 189000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and whether it was with the\nleft hand or the right hand."
    } ]
  }, {
    "tStartMs": 192600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The ultimate question\nwas, \"If I were to ask you"
    } ]
  }, {
    "tStartMs": 195690,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to repeat one of those two experiences,"
    } ]
  }, {
    "tStartMs": 198030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "which would you choose?\""
    } ]
  }, {
    "tStartMs": 200400,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Probably the left hand, yes."
    } ]
  }, {
    "tStartMs": 202590,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- You'd do that first one again?"
    } ]
  }, {
    "tStartMs": 204090,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- Yeah, I think so."
    } ]
  }, {
    "tStartMs": 205110,
    "dDurationMs": 1797,
    "segs": [ {
      "utf8": "- I would say the second\none with the right hand."
    } ]
  }, {
    "tStartMs": 206907,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "- The first, the right hand."
    } ]
  }, {
    "tStartMs": 209340,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- I'll go with the first."
    } ]
  }, {
    "tStartMs": 210480,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- The first one?\n- Yeah."
    } ]
  }, {
    "tStartMs": 211770,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- In our small-scale replication,"
    } ]
  }, {
    "tStartMs": 213900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "seven out of 12 people said\nthey would rather repeat"
    } ]
  }, {
    "tStartMs": 217200,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the longer trial."
    } ]
  }, {
    "tStartMs": 219510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "In the Kahneman and Fredrickson study,"
    } ]
  }, {
    "tStartMs": 221490,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "this preference was even stronger"
    } ]
  }, {
    "tStartMs": 223590,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with almost 70% of their participants"
    } ]
  }, {
    "tStartMs": 226290,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "preferring the longer trial."
    } ]
  }, {
    "tStartMs": 227970,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That is the same trial\nthat they, in real time,"
    } ]
  }, {
    "tStartMs": 231210,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "indicated was painful for a longer time."
    } ]
  }, {
    "tStartMs": 235290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Both trials contained the same 60 seconds"
    } ]
  }, {
    "tStartMs": 238050,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "at 14 degrees Celsius."
    } ]
  }, {
    "tStartMs": 239940,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The longer trial just added\nan additional 30 seconds"
    } ]
  }, {
    "tStartMs": 243330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "with the water warming by just one degree."
    } ]
  }, {
    "tStartMs": 246180,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "This was still uncomfortable\nand it was 50% longer,"
    } ]
  }, {
    "tStartMs": 250800,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "and yet it's the trial\nmost people preferred."
    } ]
  }, {
    "tStartMs": 255390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "One of the participants\nin the original study"
    } ]
  }, {
    "tStartMs": 257340,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "after reporting that he would prefer"
    } ]
  }, {
    "tStartMs": 258780,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "to repeat the longer trial muttered,"
    } ]
  }, {
    "tStartMs": 260977,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "\"The choice I made doesn't\nseem to make much sense.\""
    } ]
  }, {
    "tStartMs": 264360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So the first trial was 30 seconds longer?"
    } ]
  }, {
    "tStartMs": 267360,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah, okay."
    } ]
  }, {
    "tStartMs": 268200,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "- You endured discomfort for longer."
    } ]
  }, {
    "tStartMs": 271830,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But at the end, the discomfort\nreduced a little bit."
    } ]
  }, {
    "tStartMs": 275310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And the extra bit is not fun."
    } ]
  }, {
    "tStartMs": 276870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It's not like the extra bit\nwas like, \"Oh, this is great."
    } ]
  }, {
    "tStartMs": 278610,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I want to do this.\""
    } ]
  }, {
    "tStartMs": 279810,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "If I asked you which trial\nyou'd want to do again,"
    } ]
  }, {
    "tStartMs": 282660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Probably the first one,"
    } ]
  }, {
    "tStartMs": 283493,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "- You'd tell me the first one.\n- Yeah."
    } ]
  }, {
    "tStartMs": 285060,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- And that's the one that's actually"
    } ]
  }, {
    "tStartMs": 287010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "a longer experience of discomfort."
    } ]
  }, {
    "tStartMs": 288870,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 289710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Host] As hard as it is to understand,"
    } ]
  }, {
    "tStartMs": 292020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "under certain circumstances, apparently,"
    } ]
  }, {
    "tStartMs": 294360,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "people prefer more pain to less."
    } ]
  }, {
    "tStartMs": 297870,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But why is this?"
    } ]
  }, {
    "tStartMs": 300450,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Well, to investigate,\nFrederickson and Kahneman"
    } ]
  }, {
    "tStartMs": 302700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "ran a follow-up study\nwhere they showed short"
    } ]
  }, {
    "tStartMs": 305100,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and long versions of pleasant\nand unpleasant videos"
    } ]
  }, {
    "tStartMs": 308430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to undergraduate students."
    } ]
  }, {
    "tStartMs": 310320,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Examples of pleasant\nvideos included a puppy"
    } ]
  }, {
    "tStartMs": 312810,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "playing with a flower,\n- [Audience] Aww."
    } ]
  }, {
    "tStartMs": 314010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- [Host] And waves breaking on a beach."
    } ]
  }, {
    "tStartMs": 316650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "While the unpleasant videos included"
    } ]
  }, {
    "tStartMs": 318810,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "the aftermath of Hiroshima,\nand a medical film"
    } ]
  }, {
    "tStartMs": 322530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of an amputation.\n- [Audience] Eww!"
    } ]
  }, {
    "tStartMs": 325110,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- After the video, students were asked"
    } ]
  }, {
    "tStartMs": 327120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to rate their experience."
    } ]
  }, {
    "tStartMs": 329310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "What they found was\nthe length of the video"
    } ]
  }, {
    "tStartMs": 331620,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "had very little effect on\nthe retrospective evaluation,"
    } ]
  }, {
    "tStartMs": 335820,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "positive or negative."
    } ]
  }, {
    "tStartMs": 339030,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Kahneman and colleagues suggest\nthis is due at least in part"
    } ]
  }, {
    "tStartMs": 342480,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to the two different ways\nwe experience the world."
    } ]
  }, {
    "tStartMs": 345960,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "In the moment as the experiencing self,"
    } ]
  }, {
    "tStartMs": 349020,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or retrospectively thinking back on events"
    } ]
  }, {
    "tStartMs": 351690,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "as the remembering self."
    } ]
  }, {
    "tStartMs": 354210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "If you're going through\nsomething unpleasant"
    } ]
  }, {
    "tStartMs": 356010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and someone offers you the chance to stop,"
    } ]
  }, {
    "tStartMs": 358590,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you, the experiencing self,"
    } ]
  }, {
    "tStartMs": 360840,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "will likely take them up on the offer."
    } ]
  }, {
    "tStartMs": 363150,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But for the remembering self,\nthe duration of an experience"
    } ]
  }, {
    "tStartMs": 366300,
    "dDurationMs": 2113,
    "segs": [ {
      "utf8": "seems to have much less importance."
    } ]
  }, {
    "tStartMs": 368413,
    "dDurationMs": 2507,
    "segs": [ {
      "utf8": "(plane engine revving)"
    } ]
  }, {
    "tStartMs": 370920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "This is known as duration neglect."
    } ]
  }, {
    "tStartMs": 374280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "A 2008 study found that\nthe length of a vacation"
    } ]
  }, {
    "tStartMs": 376950,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "did not have any impact"
    } ]
  }, {
    "tStartMs": 378900,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "on how positively the\nvacation was remembered."
    } ]
  }, {
    "tStartMs": 382080,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So if the duration of an experience"
    } ]
  }, {
    "tStartMs": 384210,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "doesn't affect your\nmemory of it, what does?"
    } ]
  }, {
    "tStartMs": 387896,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 389016,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "(group laughing)"
    } ]
  }, {
    "tStartMs": 389850,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The answer appears to be key moments,"
    } ]
  }, {
    "tStartMs": 392430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "particularly ones that elicit"
    } ]
  }, {
    "tStartMs": 393990,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the strongest emotional response."
    } ]
  }, {
    "tStartMs": 396780,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "As the novelist Milan Kundera wrote,"
    } ]
  }, {
    "tStartMs": 399067,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "\"Memory doesn't make films,"
    } ]
  }, {
    "tStartMs": 400950,
    "dDurationMs": 1557,
    "segs": [ {
      "utf8": "it makes photographs.\""
    } ]
  }, {
    "tStartMs": 403620,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And those photographs usually\ncapture the most intense,"
    } ]
  }, {
    "tStartMs": 407130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "salient moments of the experience."
    } ]
  }, {
    "tStartMs": 410070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The most joyful,\n(child laughing)"
    } ]
  }, {
    "tStartMs": 411360,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "funny, painful, scary moments in life"
    } ]
  }, {
    "tStartMs": 414300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "are the ones that are remembered,"
    } ]
  }, {
    "tStartMs": 416040,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and therefore they come to represent"
    } ]
  }, {
    "tStartMs": 418800,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "the experience as a whole."
    } ]
  }, {
    "tStartMs": 422220,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "This is a version of the\nrepresentativeness heuristic,"
    } ]
  }, {
    "tStartMs": 425220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "A term coined by Daniel Kahneman"
    } ]
  }, {
    "tStartMs": 427230,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and Amos Tversky in the 1970s."
    } ]
  }, {
    "tStartMs": 430020,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "They were studying how people\nthink about probabilities."
    } ]
  }, {
    "tStartMs": 434430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Consider a family with six children."
    } ]
  }, {
    "tStartMs": 436680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Is it more likely that\nthey were born in the order"
    } ]
  }, {
    "tStartMs": 439350,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "boy, boy, boy, girl, girl, girl,"
    } ]
  }, {
    "tStartMs": 441270,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "or girl, boy, boy, girl, boy, girl?"
    } ]
  }, {
    "tStartMs": 444810,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "For the majority of participants,\nthe first order was viewed"
    } ]
  }, {
    "tStartMs": 448050,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "as significantly less likely."
    } ]
  }, {
    "tStartMs": 450300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But in reality, both\norders are equally likely,"
    } ]
  }, {
    "tStartMs": 452820,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but boy, boy, boy, girl,\ngirl, girl feels less likely"
    } ]
  }, {
    "tStartMs": 456120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "because it seems less random."
    } ]
  }, {
    "tStartMs": 457770,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I mean, people have a\nmental model of randomness,"
    } ]
  }, {
    "tStartMs": 460650,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "and boy, boy, boy, girl, girl,\ngirl does not fit this model."
    } ]
  }, {
    "tStartMs": 464790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "We rely on representativeness all the time"
    } ]
  }, {
    "tStartMs": 467400,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "as a mental shortcut, but\nsometimes it can lead us astray."
    } ]
  }, {
    "tStartMs": 471720,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "One famous example developed\nby Kahneman and Tversky"
    } ]
  }, {
    "tStartMs": 474780,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "is known as The Linda Problem."
    } ]
  }, {
    "tStartMs": 477240,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "Linda is 31 years old, single,\noutspoken, and very bright."
    } ]
  }, {
    "tStartMs": 482190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "She majored in philosophy."
    } ]
  }, {
    "tStartMs": 484380,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "As a student, she was deeply concerned"
    } ]
  }, {
    "tStartMs": 486090,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "with issues of discrimination\nand social justice,"
    } ]
  }, {
    "tStartMs": 489150,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and she also participated in\nanti-nuclear demonstrations."
    } ]
  }, {
    "tStartMs": 492960,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So which is more probable?"
    } ]
  }, {
    "tStartMs": 494910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Linda is a bank teller,"
    } ]
  }, {
    "tStartMs": 496770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "or Linda is a bank teller"
    } ]
  }, {
    "tStartMs": 498750,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "and is active in the feminist movement?"
    } ]
  }, {
    "tStartMs": 503130,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "The majority of people"
    } ]
  }, {
    "tStartMs": 504270,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "who are asked this question\ngive the second answer,"
    } ]
  }, {
    "tStartMs": 507000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which makes sense because\nthe description of Linda"
    } ]
  }, {
    "tStartMs": 509700,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "matches our mental model of a feminist."
    } ]
  }, {
    "tStartMs": 512880,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But mathematically, it must be more likely"
    } ]
  }, {
    "tStartMs": 515820,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that she's a bank teller,"
    } ]
  }, {
    "tStartMs": 517290,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "because feminist bank\nteller is just a subset"
    } ]
  }, {
    "tStartMs": 520470,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "of bank teller."
    } ]
  }, {
    "tStartMs": 521700,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "All feminist bank tellers are,\nby definition, bank tellers."
    } ]
  }, {
    "tStartMs": 526650,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Stephen Jay Gould said, \"I know\nthat the conjoint statement"
    } ]
  }, {
    "tStartMs": 529890,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "is least probable, yet a\nlittle homunculus in my head"
    } ]
  }, {
    "tStartMs": 533250,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "continues to jump up\nand down shouting at me,"
    } ]
  }, {
    "tStartMs": 535890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "'But she can't just be a bank teller."
    } ]
  }, {
    "tStartMs": 537870,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Read the description.'\""
    } ]
  }, {
    "tStartMs": 540750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The thing about the\nrepresentativeness heuristic,"
    } ]
  }, {
    "tStartMs": 543180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "like many heuristics,\nis that we fall for it"
    } ]
  }, {
    "tStartMs": 545940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "even if we are aware that\nwe're falling for it."
    } ]
  }, {
    "tStartMs": 548670,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I mean, technically, eggplants, cucumbers,"
    } ]
  }, {
    "tStartMs": 551010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and avocados are all berries,"
    } ]
  }, {
    "tStartMs": 553590,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but because they aren't small and sweet"
    } ]
  }, {
    "tStartMs": 555780,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "like strawberries or blueberries,"
    } ]
  }, {
    "tStartMs": 557610,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "we don't think of them as berries."
    } ]
  }, {
    "tStartMs": 559710,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "An eggplant does not match my\npreconceived idea of a berry."
    } ]
  }, {
    "tStartMs": 563160,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So even though I know\nit's technically a berry,"
    } ]
  }, {
    "tStartMs": 566010,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I'm gonna keep calling it a vegetable."
    } ]
  }, {
    "tStartMs": 568140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I mean, the salient feature of an eggplant"
    } ]
  }, {
    "tStartMs": 570120,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "is that I cook it like\nI would a vegetable."
    } ]
  }, {
    "tStartMs": 573450,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Also, annoyingly enough,"
    } ]
  }, {
    "tStartMs": 574890,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a strawberry is not technically a berry."
    } ]
  }, {
    "tStartMs": 577290,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "Botany is confusing."
    } ]
  }, {
    "tStartMs": 580410,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So the representativeness\nheuristic is why we think"
    } ]
  }, {
    "tStartMs": 583320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that Linda is more likely\nto be a feminist bank teller"
    } ]
  }, {
    "tStartMs": 585960,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "rather than just a bank teller,"
    } ]
  }, {
    "tStartMs": 587790,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and why I can't bring myself\nto call an eggplant a berry."
    } ]
  }, {
    "tStartMs": 591810,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And representativeness is how\nthe peak moments in our past"
    } ]
  }, {
    "tStartMs": 594930,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "come to represent entire experiences."
    } ]
  }, {
    "tStartMs": 598260,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "But it's not the only thing"
    } ]
  }, {
    "tStartMs": 599730,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that colors our perception of the past."
    } ]
  }, {
    "tStartMs": 602280,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Our brains better recall"
    } ]
  }, {
    "tStartMs": 603840,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and therefore assign a greater importance"
    } ]
  }, {
    "tStartMs": 606390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to more recent events."
    } ]
  }, {
    "tStartMs": 608340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "This is known as recency bias."
    } ]
  }, {
    "tStartMs": 611010,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So if you were to list\nall the meals you had"
    } ]
  }, {
    "tStartMs": 613320,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "in the last week, it\nwould be easier to recall"
    } ]
  }, {
    "tStartMs": 616020,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the most recent ones."
    } ]
  }, {
    "tStartMs": 617850,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "That's why how an experience\nends plays an outsized role"
    } ]
  }, {
    "tStartMs": 621960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in how it's remembered."
    } ]
  }, {
    "tStartMs": 623460,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "I mean, how many people are rewatching"
    } ]
  }, {
    "tStartMs": 625417,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "\"Game of Thrones\" right now, for example,"
    } ]
  }, {
    "tStartMs": 627210,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "compared to, say, \"Breaking Bad?\""
    } ]
  }, {
    "tStartMs": 629580,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "I mean, the last season of\n\"Game of Thrones\" was so awful"
    } ]
  }, {
    "tStartMs": 632910,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I don't think I'll ever\nwatch any of it ever again."
    } ]
  }, {
    "tStartMs": 635880,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "The end tainted my view\nof the whole thing."
    } ]
  }, {
    "tStartMs": 640902,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": "(wind whooshing)"
    } ]
  }, {
    "tStartMs": 642510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And it seems like that also applies"
    } ]
  }, {
    "tStartMs": 644460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "when judging the quality of a life."
    } ]
  }, {
    "tStartMs": 647040,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "In a 2001 study,"
    } ]
  }, {
    "tStartMs": 648360,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "researchers told a\nfictional story about Jen,"
    } ]
  }, {
    "tStartMs": 651330,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "a never-married woman without children."
    } ]
  }, {
    "tStartMs": 653850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "She's extremely happy."
    } ]
  }, {
    "tStartMs": 655590,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "She has a job she enjoys,\nmany close friends,"
    } ]
  }, {
    "tStartMs": 657900,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "goes on vacations and has\nmany fulfilling hobbies."
    } ]
  }, {
    "tStartMs": 661410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Then she's hit by a car at the age of 30"
    } ]
  }, {
    "tStartMs": 664260,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and dies painlessly and instantly."
    } ]
  }, {
    "tStartMs": 667470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Taking her life as a whole,"
    } ]
  }, {
    "tStartMs": 669240,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "how desirable do you think Jen's life was?"
    } ]
  }, {
    "tStartMs": 673590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "For the other half of participants,"
    } ]
  }, {
    "tStartMs": 675660,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "researchers told the same story about Jen,"
    } ]
  }, {
    "tStartMs": 678150,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but added another five years to her life."
    } ]
  }, {
    "tStartMs": 681060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Years that were pleasant,"
    } ]
  }, {
    "tStartMs": 682590,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but maybe not quite as\ngood as the first 30."
    } ]
  }, {
    "tStartMs": 685710,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "Then they asked the same question,"
    } ]
  }, {
    "tStartMs": 687937,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "\"Taking her life as a whole,"
    } ]
  }, {
    "tStartMs": 689730,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "how desirable do you\nthink Jen's life was?\""
    } ]
  }, {
    "tStartMs": 693090,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And what they found was that\npeople judged Jen's longer life"
    } ]
  }, {
    "tStartMs": 696810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to be less desirable."
    } ]
  }, {
    "tStartMs": 699600,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "That living for those extra\nfive good, but not great years"
    } ]
  }, {
    "tStartMs": 703620,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "actually reduced the overall\nperceived quality of her life."
    } ]
  }, {
    "tStartMs": 708150,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The ending matters."
    } ]
  }, {
    "tStartMs": 710580,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "They repeated this same story with a Jen"
    } ]
  }, {
    "tStartMs": 712470,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that lives to age 60 compared to age 65,"
    } ]
  }, {
    "tStartMs": 715800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and the results were the same."
    } ]
  }, {
    "tStartMs": 718140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Adding mildly pleasant years"
    } ]
  }, {
    "tStartMs": 719940,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to a very positive life\ndoes not enhance it,"
    } ]
  }, {
    "tStartMs": 723210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but actually decreases the perception"
    } ]
  }, {
    "tStartMs": 725880,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "of the quality of this life."
    } ]
  }, {
    "tStartMs": 729060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So when it comes to holding your hand"
    } ]
  }, {
    "tStartMs": 731220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in a bucket of cold water,"
    } ]
  }, {
    "tStartMs": 732870,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "your overall experience of the event"
    } ]
  }, {
    "tStartMs": 734760,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "boils down to two things,\nthe peak and the end."
    } ]
  }, {
    "tStartMs": 738270,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Oh, yeah."
    } ]
  }, {
    "tStartMs": 739200,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Like, I find that painful."
    } ]
  }, {
    "tStartMs": 740850,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I can't believe people have been, like,"
    } ]
  }, {
    "tStartMs": 742410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "standing in front of us acting so tough."
    } ]
  }, {
    "tStartMs": 744900,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Both trials involved holding\na hand in 14 degree water"
    } ]
  }, {
    "tStartMs": 748020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for the same duration."
    } ]
  }, {
    "tStartMs": 749280,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So presumably they created\nthe same peak of discomfort."
    } ]
  }, {
    "tStartMs": 752880,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But the longer trial had a nicer ending."
    } ]
  }, {
    "tStartMs": 755550,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Discomfort is backing off."
    } ]
  }, {
    "tStartMs": 757800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "I mean, still uncomfortable,"
    } ]
  }, {
    "tStartMs": 759330,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but, like, not quite as uncomfortable."
    } ]
  }, {
    "tStartMs": 762780,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "By adding a slightly less\nuncomfortable 30 seconds,"
    } ]
  }, {
    "tStartMs": 766140,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Kahneman and Frederickson were\nable to trick participants"
    } ]
  }, {
    "tStartMs": 768990,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "into remembering the\nexperience more fondly."
    } ]
  }, {
    "tStartMs": 772230,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "This is clearly a bad choice\nfor the experiencing self,"
    } ]
  }, {
    "tStartMs": 776310,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but a good choice for\nthe remembering self."
    } ]
  }, {
    "tStartMs": 779250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "This might seem like an\ninsignificant party trick,"
    } ]
  }, {
    "tStartMs": 782190,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "but it actually has huge\nimplications for our lives."
    } ]
  }, {
    "tStartMs": 786060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "For example, if we remember\na medical procedure"
    } ]
  }, {
    "tStartMs": 788310,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "like a visit to the dentist\nor a checkup more favorably,"
    } ]
  }, {
    "tStartMs": 791790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "we're more likely to do it again,"
    } ]
  }, {
    "tStartMs": 793650,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and that improves\nlong-term health outcomes."
    } ]
  }, {
    "tStartMs": 796650,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "At the end of their 1993 paper,"
    } ]
  }, {
    "tStartMs": 798780,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Kahneman and Frederickson ask,\n\"Will a physician be allowed"
    } ]
  }, {
    "tStartMs": 802020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to add an interval of diminishing pain"
    } ]
  }, {
    "tStartMs": 804270,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to the end of a medical procedure"
    } ]
  }, {
    "tStartMs": 805860,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "if the sole benefit of the added pain"
    } ]
  }, {
    "tStartMs": 808470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is to cause the patients to retain"
    } ]
  }, {
    "tStartMs": 810480,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "a more favorable memory of it?\""
    } ]
  }, {
    "tStartMs": 813000,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "In 2003, Kahneman did exactly that."
    } ]
  }, {
    "tStartMs": 817920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Along with colleagues,\nhe conducted a trial"
    } ]
  }, {
    "tStartMs": 819960,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "with 682 patients who\nunderwent a colonoscopy."
    } ]
  }, {
    "tStartMs": 824220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Half of them went through\na normal routine procedure,"
    } ]
  }, {
    "tStartMs": 827640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the other half had an extra three minutes"
    } ]
  }, {
    "tStartMs": 830010,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "at the end of the procedure"
    } ]
  }, {
    "tStartMs": 831510,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "where the tip of the colonoscope\nwas left in, but not moved."
    } ]
  }, {
    "tStartMs": 835770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So it was uncomfortable,"
    } ]
  }, {
    "tStartMs": 837750,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but less painful than the\nrest of the procedure."
    } ]
  }, {
    "tStartMs": 840720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The patients who experienced\nthe extra three minutes"
    } ]
  }, {
    "tStartMs": 843390,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of discomfort at the end"
    } ]
  }, {
    "tStartMs": 844800,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "rated the whole experience\nas about 10% less unpleasant."
    } ]
  }, {
    "tStartMs": 849720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They were also more likely to come back"
    } ]
  }, {
    "tStartMs": 851640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "to do a follow-up screening procedure."
    } ]
  }, {
    "tStartMs": 854700,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "The peak-end rule also appears in design"
    } ]
  }, {
    "tStartMs": 857730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "for customer experiences."
    } ]
  }, {
    "tStartMs": 859740,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "The cheap hot dogs at the\nexit of Ikea are an example."
    } ]
  }, {
    "tStartMs": 863970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The positive experience\nof a cheap, tasty hot dog"
    } ]
  }, {
    "tStartMs": 866610,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "or ice cream cone leads to a better memory"
    } ]
  }, {
    "tStartMs": 869100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of the whole shopping experience."
    } ]
  }, {
    "tStartMs": 871290,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It's like a doctor giving a lollipop"
    } ]
  }, {
    "tStartMs": 873150,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "to a child after a checkup."
    } ]
  }, {
    "tStartMs": 875180,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 876270,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Knowing that this is how\nthe brain creates memories"
    } ]
  }, {
    "tStartMs": 878970,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "allows us to create better\nmemories for ourselves."
    } ]
  }, {
    "tStartMs": 882720,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "If you wanna run more,"
    } ]
  }, {
    "tStartMs": 884130,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "don't do painful hill sprints\nat the end of your workout."
    } ]
  }, {
    "tStartMs": 887490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Instead, maybe do a\npleasant cool-down walk"
    } ]
  }, {
    "tStartMs": 889860,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "while you talk to a friend or\nlisten to your favorite music."
    } ]
  }, {
    "tStartMs": 893310,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Wanna create better\nmemories of your vacations?"
    } ]
  }, {
    "tStartMs": 896010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Making it longer won't matter as much"
    } ]
  }, {
    "tStartMs": 898800,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "as creating exciting and novel days."
    } ]
  }, {
    "tStartMs": 902220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Make sure there's a high-peak experience,"
    } ]
  }, {
    "tStartMs": 904560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and also end it with something pleasant."
    } ]
  }, {
    "tStartMs": 907500,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Are you quitting your job"
    } ]
  }, {
    "tStartMs": 908790,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and want people to remember you fondly?"
    } ]
  }, {
    "tStartMs": 911010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Well, make sure you are\nextra nice to your colleagues"
    } ]
  }, {
    "tStartMs": 913590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "during your last few weeks."
    } ]
  }, {
    "tStartMs": 915660,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "In short, to create better\nmemories, you should optimize"
    } ]
  }, {
    "tStartMs": 918630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "for the peak and the end."
    } ]
  }, {
    "tStartMs": 921120,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So the best way to close out\na YouTube video is, I guess,"
    } ]
  }, {
    "tStartMs": 924960,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "with a wholesome message."
    } ]
  }, {
    "tStartMs": 926430,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "And why not footage of a cute\ndog playing with flowers?"
    } ]
  }, {
    "tStartMs": 931020,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(celestial music)"
    } ]
  }, {
    "tStartMs": 934890,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Our mindset plays a huge role"
    } ]
  }, {
    "tStartMs": 937020,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "in our perception of the environment."
    } ]
  }, {
    "tStartMs": 938970,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And while this makes some\nexperiences seem more enjoyable,"
    } ]
  }, {
    "tStartMs": 942240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "it can also cause us to see things"
    } ]
  }, {
    "tStartMs": 943800,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "as worse than they really are."
    } ]
  }, {
    "tStartMs": 945630,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But luckily, you can train\nyour mind like a muscle"
    } ]
  }, {
    "tStartMs": 947940,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to make meaningful improvements\nto your day-to-day life."
    } ]
  }, {
    "tStartMs": 950130,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And that's where today's\nsponsor Headspace comes in."
    } ]
  }, {
    "tStartMs": 953010,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Headspace is an all-in-one\nmental health guide"
    } ]
  }, {
    "tStartMs": 955020,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that helps you strengthen your mindset"
    } ]
  }, {
    "tStartMs": 956550,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and reach your goals through\nmeditations, exercises,"
    } ]
  }, {
    "tStartMs": 959460,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and personalized support."
    } ]
  }, {
    "tStartMs": 961230,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Now, you might be quick\nto dismiss meditation"
    } ]
  }, {
    "tStartMs": 963060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "if you think it's all\nabout taking deep breaths"
    } ]
  }, {
    "tStartMs": 964980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and sitting still for hours,"
    } ]
  }, {
    "tStartMs": 966570,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "but in reality,"
    } ]
  }, {
    "tStartMs": 967620,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "practicing mindfulness is\ndifferent for everyone."
    } ]
  }, {
    "tStartMs": 970290,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "There's no definitive way to meditate,"
    } ]
  }, {
    "tStartMs": 972420,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and that's what I really\nlike about Headspace."
    } ]
  }, {
    "tStartMs": 974850,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Whether it's guided meditation,\nstress-release workouts,"
    } ]
  }, {
    "tStartMs": 977880,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "ASMR podcasts or focus music,"
    } ]
  }, {
    "tStartMs": 980220,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Headspace has something for everyone."
    } ]
  }, {
    "tStartMs": 982290,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And if you don't wanna\ncommit to a full course,"
    } ]
  }, {
    "tStartMs": 984150,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "they even have mini\nmeditations and short stories."
