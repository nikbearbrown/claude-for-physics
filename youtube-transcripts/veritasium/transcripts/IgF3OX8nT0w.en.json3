{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 140,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "- In 1901,\nthis ancient Greek artifact"
    } ]
  }, {
    "tStartMs": 3160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "was discovered in a shipwreck\nof the island of Antikythera."
    } ]
  }, {
    "tStartMs": 6760,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "3D x-ray scans have revealed"
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "it contains 37 interlocking bronze gears,"
    } ]
  }, {
    "tStartMs": 12290,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "allowing it to model the\nmotions of the sun and moon,"
    } ]
  }, {
    "tStartMs": 15710,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and predict eclipses decades in advance."
    } ]
  }, {
    "tStartMs": 18950,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Constructed around 100 or 200 BC,"
    } ]
  }, {
    "tStartMs": 22170,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "the Antikythera mechanism"
    } ]
  }, {
    "tStartMs": 23680,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "represents a sophisticated early computer."
    } ]
  }, {
    "tStartMs": 26710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The likes of which would not be seen again"
    } ]
  }, {
    "tStartMs": 28270,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "for at least a thousand years."
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Now, of course,"
    } ]
  }, {
    "tStartMs": 32053,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "this computer didn't work\nlike modern digital computers."
    } ]
  }, {
    "tStartMs": 35090,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "It works by analogy."
    } ]
  }, {
    "tStartMs": 37440,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "The gears were constructed in such a way"
    } ]
  }, {
    "tStartMs": 39430,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "that the motions of certain dials"
    } ]
  }, {
    "tStartMs": 41640,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "are analogous to the\nmotion of the sun and moon."
    } ]
  }, {
    "tStartMs": 45210,
    "dDurationMs": 2663,
    "segs": [ {
      "utf8": "It is an analog computer."
    } ]
  }, {
    "tStartMs": 49680,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "- Here is a simple analog computer"
    } ]
  }, {
    "tStartMs": 51700,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "for adding two numbers together."
    } ]
  }, {
    "tStartMs": 53690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "If you turn the black wheel some amount"
    } ]
  }, {
    "tStartMs": 56000,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and then turn this white\nwheel a different amount,"
    } ]
  }, {
    "tStartMs": 59160,
    "dDurationMs": 3553,
    "segs": [ {
      "utf8": "the gray wheel shows the\nsum of the two rotations."
    } ]
  }, {
    "tStartMs": 63630,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "In contrast, this is a\ndigital mechanical computer"
    } ]
  }, {
    "tStartMs": 66930,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "where you can add two single bit numbers."
    } ]
  }, {
    "tStartMs": 70050,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So zero plus zero equals zero."
    } ]
  }, {
    "tStartMs": 73080,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Zero plus one equals one."
    } ]
  }, {
    "tStartMs": 75710,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "And one plus one equals two."
    } ]
  }, {
    "tStartMs": 79180,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "These two devices\nillustrate the differences"
    } ]
  }, {
    "tStartMs": 81690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "between analog and digital computers."
    } ]
  }, {
    "tStartMs": 84570,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Analog computers have a continuous range"
    } ]
  }, {
    "tStartMs": 87120,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "of inputs and outputs,"
    } ]
  }, {
    "tStartMs": 88930,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "whereas digital only works\nwith discrete values."
    } ]
  }, {
    "tStartMs": 92650,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "With analog computers,\nthe quantities of interest"
    } ]
  }, {
    "tStartMs": 95020,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "are actually represented\nby something physical,"
    } ]
  }, {
    "tStartMs": 97310,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "like the amount a wheel has turned."
    } ]
  }, {
    "tStartMs": 100060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Whereas digital computers work on symbols"
    } ]
  }, {
    "tStartMs": 102670,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "like zeros and ones."
    } ]
  }, {
    "tStartMs": 104760,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "If the answer is, say, two,"
    } ]
  }, {
    "tStartMs": 106700,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "there is nothing in the computer"
    } ]
  }, {
    "tStartMs": 108280,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "that is 'twice as much' as a one."
    } ]
  }, {
    "tStartMs": 111150,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "In analog computers, there is."
    } ]
  }, {
    "tStartMs": 113880,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "For thousands of years,"
    } ]
  }, {
    "tStartMs": 115230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "people used analog devices"
    } ]
  }, {
    "tStartMs": 117210,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "like the Antikythera\nmechanism or slide rules,"
    } ]
  }, {
    "tStartMs": 120350,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "alongside digital devices like abacuses."
    } ]
  }, {
    "tStartMs": 123280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "And up until the 1960s,"
    } ]
  }, {
    "tStartMs": 125000,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "the most powerful computers on the planet"
    } ]
  }, {
    "tStartMs": 127440,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "were actually analog."
    } ]
  }, {
    "tStartMs": 129470,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Digital computers exploded onto the scene"
    } ]
  }, {
    "tStartMs": 131640,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "with the advent of\nsolid-state transistors."
    } ]
  }, {
    "tStartMs": 134300,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And now, almost everything is digital."
    } ]
  }, {
    "tStartMs": 137030,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "Most people have never even\nheard of analog computers."
    } ]
  }, {
    "tStartMs": 140820,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "But today, that may all be changing."
    } ]
  }, {
    "tStartMs": 143800,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Moore's Law,"
    } ]
  }, {
    "tStartMs": 144633,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "the idea that you can double\nthe number of transistors"
    } ]
  }, {
    "tStartMs": 146780,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "on a chip every two years,"
    } ]
  }, {
    "tStartMs": 148570,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it's reaching its limit,"
    } ]
  }, {
    "tStartMs": 150010,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "because transistors are\nnearly the same size as atoms."
    } ]
  }, {
    "tStartMs": 153450,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Simultaneously, advancements\nin machine learning"
    } ]
  }, {
    "tStartMs": 156210,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "are straining the capabilities\nof digital computers."
    } ]
  }, {
    "tStartMs": 159790,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "The solution to these challenges"
    } ]
  }, {
    "tStartMs": 161570,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "may well be a new generation\nof analog computers."
    } ]
  }, {
    "tStartMs": 166153,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "(soft upbeat music)"
    } ]
  }, {
    "tStartMs": 168180,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "- One of the\nmost important problems"
    } ]
  }, {
    "tStartMs": 170290,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "humans have faced for millennia\nis predicting the tides."
    } ]
  }, {
    "tStartMs": 174330,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Napoleon and his men nearly\ndied crossing the Red Sea"
    } ]
  }, {
    "tStartMs": 178320,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "due to a miscalculation\nof the rising tide."
    } ]
  }, {
    "tStartMs": 181680,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "And sailors routinely\nneeded to know the tides"
    } ]
  }, {
    "tStartMs": 184580,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "to bring their ships into\nport without running aground."
    } ]
  }, {
    "tStartMs": 187930,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Most coastal locations on earth"
    } ]
  }, {
    "tStartMs": 189910,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "experience two high and\ntwo low tides per day,"
    } ]
  }, {
    "tStartMs": 193670,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but their exact timing varies\nas does their magnitude."
    } ]
  }, {
    "tStartMs": 197670,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "And this is partly caused by local factors"
    } ]
  }, {
    "tStartMs": 199810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "like the depth of the sea bed"
    } ]
  }, {
    "tStartMs": 201370,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "and the shape of the shoreline."
    } ]
  }, {
    "tStartMs": 204220,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "In the late 1700s, to describe\nthe tidal flow of the oceans,"
    } ]
  }, {
    "tStartMs": 208240,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Pierre-Simon Laplace"
    } ]
  }, {
    "tStartMs": 209530,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "derived a set of complicated\ndifferential equations."
    } ]
  }, {
    "tStartMs": 212720,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "They had no analytical solution,"
    } ]
  }, {
    "tStartMs": 215130,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "so at that time they\nwere basically useless."
    } ]
  }, {
    "tStartMs": 218120,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "But in the process of\nderiving his equations,"
    } ]
  }, {
    "tStartMs": 220720,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Laplace made a key finding."
    } ]
  }, {
    "tStartMs": 223050,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Tides are driven"
    } ]
  }, {
    "tStartMs": 224230,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "at only a few specific\nastronomical frequencies,"
    } ]
  }, {
    "tStartMs": 227660,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "including the moon, the sun,"
    } ]
  }, {
    "tStartMs": 230700,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and the eccentricity of the lunar orbit."
    } ]
  }, {
    "tStartMs": 233970,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Each one of these factors\ncontributes a sine wave"
    } ]
  }, {
    "tStartMs": 236990,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "of a particular amplitude and\nphase to the total tide curve."
    } ]
  }, {
    "tStartMs": 241830,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "If someone could figure out"
    } ]
  }, {
    "tStartMs": 242900,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "how to correctly combine\nthese frequency components,"
    } ]
  }, {
    "tStartMs": 245513,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "well the tides could finally be predicted."
    } ]
  }, {
    "tStartMs": 249660,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "It took nearly a century."
    } ]
  }, {
    "tStartMs": 251530,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But in the 1860s,"
    } ]
  }, {
    "tStartMs": 253240,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "William Thompson, later Lord\nKelvin, took up the challenge."
    } ]
  }, {
    "tStartMs": 257420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Having completed several voyages"
    } ]
  }, {
    "tStartMs": 259160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to lay the first\ntransatlantic telegraph cable,"
    } ]
  }, {
    "tStartMs": 261950,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "he developed a fascination with the sea."
    } ]
  }, {
    "tStartMs": 264520,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "And subsequently, he threw\nhis full scientific effort"
    } ]
  }, {
    "tStartMs": 267530,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "into measuring and predicting the tides."
    } ]
  }, {
    "tStartMs": 270880,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Tide gauges at that time used a buoy"
    } ]
  }, {
    "tStartMs": 273050,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to record the height of\nthe sea onto a paper roll."
    } ]
  }, {
    "tStartMs": 276470,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Kelvin set out to\ndetermine how sine waves,"
    } ]
  }, {
    "tStartMs": 279010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with the frequencies\nidentified by Laplace,"
    } ]
  }, {
    "tStartMs": 281410,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "could add together to produce\nthe observed tidal curve."
    } ]
  }, {
    "tStartMs": 285370,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "The key was to apply the\nwork of French mathematician,"
    } ]
  }, {
    "tStartMs": 288500,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "Joseph Fourier, who had shown\nhow to decompose any function"
    } ]
  }, {
    "tStartMs": 291970,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "into a sum of sine waves."
    } ]
  }, {
    "tStartMs": 294410,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Most English scientists\nwere skeptical of the work,"
    } ]
  }, {
    "tStartMs": 297070,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "but Thompson was enthralled by it."
    } ]
  }, {
    "tStartMs": 299520,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "His first paper, published at\n17, was a defense of Fourier."
    } ]
  }, {
    "tStartMs": 304610,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "While it was straightforward"
    } ]
  }, {
    "tStartMs": 306080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to apply Fourier's\nanalysis to tidal curves,"
    } ]
  }, {
    "tStartMs": 308660,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "the computation required was enormous."
    } ]
  }, {
    "tStartMs": 312150,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "First, divide the tide curve\nup into short time intervals."
    } ]
  }, {
    "tStartMs": 316290,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And for each interval,"
    } ]
  }, {
    "tStartMs": 317490,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "multiply the tide level by a sine wave"
    } ]
  }, {
    "tStartMs": 320200,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "with the frequency of interest."
    } ]
  }, {
    "tStartMs": 322410,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Add up the area of all these rectangles,"
    } ]
  }, {
    "tStartMs": 324580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and divide by the total time."
    } ]
  }, {
    "tStartMs": 326620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And this gives you a single coefficient,"
    } ]
  }, {
    "tStartMs": 329080,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "the amplitude of the sine\nwave with this frequency."
    } ]
  }, {
    "tStartMs": 332700,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "Then you have to repeat the\nprocess for a cosine function"
    } ]
  }, {
    "tStartMs": 335590,
    "dDurationMs": 1603,
    "segs": [ {
      "utf8": "with the same frequency."
    } ]
  }, {
    "tStartMs": 338210,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Kelvin found that to make\naccurate predictions,"
    } ]
  }, {
    "tStartMs": 340820,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "he actually needed 10\ndifferent frequency components."
    } ]
  }, {
    "tStartMs": 344070,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "So that is a lot of\nmultiplication and addition"
    } ]
  }, {
    "tStartMs": 347050,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to characterize the tides\nat just one location."
    } ]
  }, {
    "tStartMs": 350560,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "For each additional location,"
    } ]
  }, {
    "tStartMs": 352380,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "you have to perform this\nanalysis all over again."
    } ]
  }, {
    "tStartMs": 356240,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "And this is only half the problem."
    } ]
  }, {
    "tStartMs": 358860,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "Once you have the amplitudes and phases"
    } ]
  }, {
    "tStartMs": 361010,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "of the sine functions,"
    } ]
  }, {
    "tStartMs": 362280,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "you have to add them up to\npredict the future tides."
    } ]
  }, {
    "tStartMs": 365790,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- Lord Kelvin spent years"
    } ]
  }, {
    "tStartMs": 367550,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "analyzing and predicting tides by hand."
    } ]
  }, {
    "tStartMs": 370510,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Then he had a stroke of inspiration."
    } ]
  }, {
    "tStartMs": 373110,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Could you design a machine"
    } ]
  }, {
    "tStartMs": 374360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to carry out these\ncalculations automatically?"
    } ]
  }, {
    "tStartMs": 376920,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "In Kelvin's words to\n\"substitute brass for brains,\""
    } ]
  }, {
    "tStartMs": 380610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the resulting analog computers"
    } ]
  }, {
    "tStartMs": 382350,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "were in use for nearly a century."
    } ]
  }, {
    "tStartMs": 384970,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "They even played a critical role"
    } ]
  }, {
    "tStartMs": 386460,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "in the outcome of World War II."
    } ]
  }, {
    "tStartMs": 389960,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Kelvin started\nwith the problem of prediction,"
    } ]
  }, {
    "tStartMs": 392510,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "adding the sine waves together,"
    } ]
  }, {
    "tStartMs": 394090,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "given you know their\namplitudes and phases."
    } ]
  }, {
    "tStartMs": 397230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "He knew he could create sinusoidal motion"
    } ]
  }, {
    "tStartMs": 399570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with a device called a scotch yoke."
    } ]
  }, {
    "tStartMs": 401970,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "It extracts one dimension\nfrom uniform circular motion."
    } ]
  }, {
    "tStartMs": 406120,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "But to make a tide prediction,"
    } ]
  }, {
    "tStartMs": 407610,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "he needed a way to combine\n10 sine waves together."
    } ]
  }, {
    "tStartMs": 410910,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "He needed a mechanical\nanalog for addition."
    } ]
  }, {
    "tStartMs": 414770,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "Stuck on this problem in\n1872, Kelvin boarded a train"
    } ]
  }, {
    "tStartMs": 418380,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "for a meeting with the main\nsponsor of his tidal research,"
    } ]
  }, {
    "tStartMs": 420940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the British Association."
    } ]
  }, {
    "tStartMs": 422980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "On the train, Kelvin bumped into a friend,"
    } ]
  }, {
    "tStartMs": 425320,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "inventor Beauchamp Tower, to\nwhom he explained his dilemma."
    } ]
  }, {
    "tStartMs": 429750,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Towers suggested he used Wheatstone's plan"
    } ]
  }, {
    "tStartMs": 432140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of a chain passing around\na number of pulleys."
    } ]
  }, {
    "tStartMs": 434900,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And this was exactly\nthe addition mechanism"
    } ]
  }, {
    "tStartMs": 437400,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Kelvin was looking for."
    } ]
  }, {
    "tStartMs": 439170,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "By attaching a pulley to each scotch yoke"
    } ]
  }, {
    "tStartMs": 441700,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "and running a weighted cord around them,"
    } ]
  }, {
    "tStartMs": 443810,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "he could mechanically add\nall of their contributions"
    } ]
  }, {
    "tStartMs": 446910,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "at once."
    } ]
  }, {
    "tStartMs": 448100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "He scribbled down the entire plan"
    } ]
  }, {
    "tStartMs": 449700,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "for this predictor machine\nby the end of the train ride."
    } ]
  }, {
    "tStartMs": 452660,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "He pitched it to the British Association,"
    } ]
  }, {
    "tStartMs": 454730,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "and secured funding to build\nit all before he returned home."
    } ]
  }, {
    "tStartMs": 459920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "If you knew the relative contributions"
    } ]
  }, {
    "tStartMs": 461920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of different frequency components,"
    } ]
  }, {
    "tStartMs": 463780,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Kelvin now had a machine to\nautomate the tedious task"
    } ]
  }, {
    "tStartMs": 467450,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "of predicting future tides."
    } ]
  }, {
    "tStartMs": 469780,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This was a great leap forward."
    } ]
  }, {
    "tStartMs": 472570,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Four hours of cranking the handle"
    } ]
  }, {
    "tStartMs": 474710,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "yielded a full year of tidal predictions."
    } ]
  }, {
    "tStartMs": 478020,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "But for many years,"
    } ]
  }, {
    "tStartMs": 479060,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the harder half of the problem\nwas still done by hand,"
    } ]
  }, {
    "tStartMs": 482420,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "breaking apart an existing tide curve"
    } ]
  }, {
    "tStartMs": 484470,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "into its component frequencies."
    } ]
  }, {
    "tStartMs": 486780,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "To automate this step,\nKelvin needed a machine"
    } ]
  }, {
    "tStartMs": 489260,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "capable of multiplying the\ntide curve times the sine wave,"
    } ]
  }, {
    "tStartMs": 492940,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and then taking its integral."
    } ]
  }, {
    "tStartMs": 495520,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "What would such a device even look like?"
    } ]
  }, {
    "tStartMs": 498770,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "With his older brother, James Thompson,"
    } ]
  }, {
    "tStartMs": 500860,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Kelvin came up with a\nmechanical integrator."
    } ]
  }, {
    "tStartMs": 503650,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "It consists of a ball on a rotating disk."
    } ]
  }, {
    "tStartMs": 507080,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Due to the rotation of the disk,"
    } ]
  }, {
    "tStartMs": 508970,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "the further the ball is from the center,"
    } ]
  }, {
    "tStartMs": 511120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the faster it spins."
    } ]
  }, {
    "tStartMs": 513200,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "If the ball is at the\nvery center of the disk,"
    } ]
  }, {
    "tStartMs": 515650,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "it doesn't turn at all."
    } ]
  }, {
    "tStartMs": 517410,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "And if it's on the left side,"
    } ]
  }, {
    "tStartMs": 518780,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "it turns in the opposite direction."
    } ]
  }, {
    "tStartMs": 521730,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now the motion of the ball\nis converted into an output"
    } ]
  }, {
    "tStartMs": 524530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "via a roller,"
    } ]
  }, {
    "tStartMs": 525820,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "which moves a pen up or down\non the output graph paper."
    } ]
  }, {
    "tStartMs": 530710,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "So the way it works"
    } ]
  }, {
    "tStartMs": 532170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is you trace the function\nyou want to integrate"
    } ]
  }, {
    "tStartMs": 534270,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "with a stylus,"
    } ]
  }, {
    "tStartMs": 535430,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and the stylus controls the\nposition of the ball on the disk"
    } ]
  }, {
    "tStartMs": 538870,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "and hence its speed of rotation."
    } ]
  }, {
    "tStartMs": 541520,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "This is transferred through\nthe roller to the output,"
    } ]
  }, {
    "tStartMs": 544500,
    "dDurationMs": 2953,
    "segs": [ {
      "utf8": "which plots the integral\nof the original function."
    } ]
  }, {
    "tStartMs": 548570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now to decompose a tide curve,"
    } ]
  }, {
    "tStartMs": 550640,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "we don't just wanna\nintegrate the function."
    } ]
  }, {
    "tStartMs": 552770,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "We first wanna multiply it"
    } ]
  }, {
    "tStartMs": 554230,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "by a sine wave of a particular frequency."
    } ]
  }, {
    "tStartMs": 557087,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "And the way to do this"
    } ]
  }, {
    "tStartMs": 558530,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "is to make the disk rotate back and forth"
    } ]
  }, {
    "tStartMs": 561460,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "at that specific frequency."
    } ]
  }, {
    "tStartMs": 564080,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Now the rotation of the ball"
    } ]
  }, {
    "tStartMs": 565500,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "depends not only on\nwhere it is on the disk,"
    } ]
  }, {
    "tStartMs": 568230,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "but also on how the disc\nis turning at an instant."
    } ]
  }, {
    "tStartMs": 572010,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "You trace the tide curve with the stylus,"
    } ]
  }, {
    "tStartMs": 574330,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "which moves the ball back and\nforth on the oscillating disk,"
    } ]
  }, {
    "tStartMs": 577820,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "and the roller sums up the\nintegral of the tide curve"
    } ]
  }, {
    "tStartMs": 581040,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "times the sine wave."
    } ]
  }, {
    "tStartMs": 583030,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Simply divide by the total\ntime to get the coefficient."
    } ]
  }, {
    "tStartMs": 586950,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Several of these ball and disk integrators"
    } ]
  }, {
    "tStartMs": 588930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "can be connected in parallel"
    } ]
  }, {
    "tStartMs": 590730,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "with each disk oscillating\nat a different frequency"
    } ]
  }, {
    "tStartMs": 594220,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "to calculate the coefficients"
    } ]
  }, {
    "tStartMs": 595610,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "for multiple frequency\ncomponents at the same time."
    } ]
  }, {
    "tStartMs": 600550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Kelvin's analog computers"
    } ]
  }, {
    "tStartMs": 602440,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "revolutionized our\nability to predict tides."
    } ]
  }, {
    "tStartMs": 605520,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Tidal curves from anywhere in the world"
    } ]
  }, {
    "tStartMs": 607610,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "could be turned into a set\nof sinusoidal coefficients"
    } ]
  }, {
    "tStartMs": 610630,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "using the ball and disk harmonic analyzer."
    } ]
  }, {
    "tStartMs": 613680,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "And the resulting sinusoids\ncould be added together"
    } ]
  }, {
    "tStartMs": 616150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to predict the future tides"
    } ]
  }, {
    "tStartMs": 617710,
    "dDurationMs": 2683,
    "segs": [ {
      "utf8": "using his scotch yoke pulley machine."
    } ]
  }, {
    "tStartMs": 621640,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Derek] Kelvin's harmonic analyzers"
    } ]
  }, {
    "tStartMs": 623350,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "were the basis for a\nlandmark analog computer"
    } ]
  }, {
    "tStartMs": 625760,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "called the differential analyzer,"
    } ]
  }, {
    "tStartMs": 627780,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "and his tide predicting machines"
    } ]
  }, {
    "tStartMs": 629650,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "were used well into the 1960s."
    } ]
  }, {
    "tStartMs": 632400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "In fact, they were later overhauled"
    } ]
  }, {
    "tStartMs": 634240,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "to include 26 frequency components"
    } ]
  }, {
    "tStartMs": 636840,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "and used to plan the\nallied invasion on D-Day."
    } ]
  }, {
    "tStartMs": 641530,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "- The Germans\nexpected any invasion"
    } ]
  }, {
    "tStartMs": 643440,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "to come at high tide to minimize the time"
    } ]
  }, {
    "tStartMs": 645700,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Allied soldiers would be\nexposed on the beaches."
    } ]
  }, {
    "tStartMs": 648560,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So they installed millions of obstacles"
    } ]
  }, {
    "tStartMs": 651000,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "that would be underwater by mid tide,"
    } ]
  }, {
    "tStartMs": 653260,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "many with explosive mines attached."
    } ]
  }, {
    "tStartMs": 656270,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "But the allies spotted the\nobstacles and change tack."
    } ]
  }, {
    "tStartMs": 659760,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "Instead, they plan to begin\nthe invasion at low tide."
    } ]
  }, {
    "tStartMs": 663190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "This would allow demolition teams"
    } ]
  }, {
    "tStartMs": 664840,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "to first clear channels\nthrough the obstacles,"
    } ]
  }, {
    "tStartMs": 667700,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "then the main forces could\ncome through those gaps"
    } ]
  }, {
    "tStartMs": 670130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "as the water rose."
    } ]
  }, {
    "tStartMs": 671730,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "This would also give\nlanding craft enough time"
    } ]
  }, {
    "tStartMs": 673670,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "to depart without getting beached."
    } ]
  }, {
    "tStartMs": 675940,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "The low water times were different"
    } ]
  }, {
    "tStartMs": 677900,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "at the five landing\nbeaches by over an hour,"
    } ]
  }, {
    "tStartMs": 680710,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "so the invasion times were staggered"
    } ]
  }, {
    "tStartMs": 682940,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "according to the tide predictions."
    } ]
  }, {
    "tStartMs": 686950,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- This wasn't the only\nuse of analog computers"
    } ]
  }, {
    "tStartMs": 689270,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "in World War II."
    } ]
  }, {
    "tStartMs": 690560,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Dive bomber aircraft would\nplummet out of the sky"
    } ]
  }, {
    "tStartMs": 693300,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "directly toward their targets\nat up to an 80 degree angle,"
    } ]
  }, {
    "tStartMs": 697000,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "and their rapid descents"
    } ]
  }, {
    "tStartMs": 698480,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "made them very difficult to shoot down."
    } ]
  }, {
    "tStartMs": 701010,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So the U.S. began searching for devices"
    } ]
  }, {
    "tStartMs": 703210,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "to automatically aim guns at dive bombers."
    } ]
  }, {
    "tStartMs": 706770,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Most of the proposed solutions"
    } ]
  }, {
    "tStartMs": 708250,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "fell into one of two categories."
    } ]
  }, {
    "tStartMs": 710540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Some were analog machines\nlike Lord Kelvin's."
    } ]
  }, {
    "tStartMs": 713540,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Others were essentially fast calculators."
    } ]
  }, {
    "tStartMs": 716370,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Mechanical calculating\nmachines like the abacus"
    } ]
  }, {
    "tStartMs": 718680,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "had been around for millennia,"
    } ]
  }, {
    "tStartMs": 720150,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "but they were far too slow\nto respond to dive bombers."
    } ]
  }, {
    "tStartMs": 723540,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "These new calculating\nmachines sped things up"
    } ]
  }, {
    "tStartMs": 725930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "by using electrical pulses."
    } ]
  }, {
    "tStartMs": 728240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The committee considered\nnaming these devices"
    } ]
  }, {
    "tStartMs": 730340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "after the pulses they used."
    } ]
  }, {
    "tStartMs": 732200,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "But member George Stibitz"
    } ]
  }, {
    "tStartMs": 733570,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "proposed a more general name: digital,"
    } ]
  }, {
    "tStartMs": 736910,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "because these machines\noperated on numbers themselves"
    } ]
  }, {
    "tStartMs": 740070,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "or digits."
    } ]
  }, {
    "tStartMs": 741790,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And this is the origin of\nthe term digital computer."
    } ]
  }, {
    "tStartMs": 745890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But digital would have to wait."
    } ]
  }, {
    "tStartMs": 747840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Of all the proposals and\ninnovative analog machine"
    } ]
  }, {
    "tStartMs": 750360,
    "dDurationMs": 2871,
    "segs": [ {
      "utf8": "from David Parkinson won out."
    } ]
  }, {
    "tStartMs": 753730,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "At Bell Labs in New York,"
    } ]
  }, {
    "tStartMs": 755280,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "Parkinson had been working on a device"
    } ]
  }, {
    "tStartMs": 757150,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "to chart telephone data called\nan automatic level recorder."
    } ]
  }, {
    "tStartMs": 761270,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "It used a variable resistor\ncalled a potentiometer"
    } ]
  }, {
    "tStartMs": 764020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to control the motion of a pen."
    } ]
  }, {
    "tStartMs": 766660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "One night, after hearing reports"
    } ]
  }, {
    "tStartMs": 768400,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "of the harrowing allied\nevacuation of Dunkirk,"
    } ]
  }, {
    "tStartMs": 771090,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Parkinson had a dream that\nhe was on the front lines."
    } ]
  }, {
    "tStartMs": 774170,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "(radio tatters)"
    } ]
  }, {
    "tStartMs": 775253,
    "dDurationMs": 2214,
    "segs": [ {
      "utf8": "(mystical music)\n(gun firing)"
    } ]
  }, {
    "tStartMs": 777467,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "\"I found myself in a gun pit\nwith an anti-aircraft gun crew."
    } ]
  }, {
    "tStartMs": 781637,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "\"A gun there was firing occasionally,"
    } ]
  }, {
    "tStartMs": 783597,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "\"and the impressive\nthing was that every shot"
    } ]
  }, {
    "tStartMs": 786467,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "\"brought down an airplane."
    } ]
  }, {
    "tStartMs": 788387,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "\"After three or four shots,"
    } ]
  }, {
    "tStartMs": 789727,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "\"one of the men in the crew smiled at me"
    } ]
  }, {
    "tStartMs": 791467,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "\"and beckoned me to\ncome closer to the gun."
    } ]
  }, {
    "tStartMs": 793907,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "\"When I drew near,"
    } ]
  }, {
    "tStartMs": 794777,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "\"he pointed to the exposed\nend of the left trunnion."
    } ]
  }, {
    "tStartMs": 798017,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "\"Mounted there was the\ncontrol potentiometer"
    } ]
  }, {
    "tStartMs": 801147,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "\"of my level recorder.\""
    } ]
  }, {
    "tStartMs": 803350,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "When he woke up, Parkinson realized"
    } ]
  }, {
    "tStartMs": 805570,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "the device he was\nbuilding to control a pen"
    } ]
  }, {
    "tStartMs": 807920,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "could be scaled up to\ncontrol an anti-aircraft gun."
    } ]
  }, {
    "tStartMs": 811810,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "He shared this idea with his supervisor,"
    } ]
  }, {
    "tStartMs": 813800,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and after receiving\napproval from the military,"
    } ]
  }, {
    "tStartMs": 816240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "they set out to make\nParkinson's dream a reality."
    } ]
  }, {
    "tStartMs": 820080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Researchers at Bell Labs"
    } ]
  }, {
    "tStartMs": 821440,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "had recently invented an\nanalog electrical device"
    } ]
  }, {
    "tStartMs": 824250,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "called an operational amplifier or op-amp."
    } ]
  }, {
    "tStartMs": 827240,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "It could perform mathematical\noperations with voltages,"
    } ]
  }, {
    "tStartMs": 830140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "like addition and multiplication."
    } ]
  }, {
    "tStartMs": 832300,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "They used these op-amps to\ncreate an analog computer"
    } ]
  }, {
    "tStartMs": 835340,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "that could solve the ballistics equations"
    } ]
  }, {
    "tStartMs": 837130,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "for anti-aircraft guns."
    } ]
  }, {
    "tStartMs": 839090,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Using radar and optical\nsites to obtain the speed,"
    } ]
  }, {
    "tStartMs": 841940,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "altitude and direction of enemy planes,"
    } ]
  }, {
    "tStartMs": 844400,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "the M9 Gun Director, as\nthe computer was called,"
    } ]
  }, {
    "tStartMs": 847900,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "could rapidly calculate\nthe correct trajectory"
    } ]
  }, {
    "tStartMs": 850490,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "and few setting."
    } ]
  }, {
    "tStartMs": 852000,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Potentiometers were used\nto ascertain the direction"
    } ]
  }, {
    "tStartMs": 854670,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "the gun was pointing."
    } ]
  }, {
    "tStartMs": 856650,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This was not the first\nelectric analog computer,"
    } ]
  }, {
    "tStartMs": 859710,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "but it was an important one."
    } ]
  }, {
    "tStartMs": 861880,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "In World War I, It took an\naverage of 17,000 rounds"
    } ]
  }, {
    "tStartMs": 865780,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to take down a single airplane."
    } ]
  }, {
    "tStartMs": 867850,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "In 1943, after the invention of the M9,"
    } ]
  }, {
    "tStartMs": 870590,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it took an average of only 90."
    } ]
  }, {
    "tStartMs": 873350,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "During the war, the U.S.\ninvested big in analog computers."
    } ]
  }, {
    "tStartMs": 877610,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If you break down their\ntotal military budget,"
    } ]
  }, {
    "tStartMs": 879710,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "the third largest single expense"
    } ]
  }, {
    "tStartMs": 881980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "was the development and production"
    } ]
  }, {
    "tStartMs": 883700,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "of an incredibly complex\nmechanical analog computer"
    } ]
  }, {
    "tStartMs": 887070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "called the Norden bombsight."
    } ]
  }, {
    "tStartMs": 889260,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "Unfortunately, they didn't\nget their money's worth."
    } ]
  }, {
    "tStartMs": 893400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- Designed by\nthe eccentric Dutch engineer,"
    } ]
  }, {
    "tStartMs": 895640,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "Carl Norden, the Norden\nbombsight was built"
    } ]
  }, {
    "tStartMs": 898290,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "to enable high precision airborne bombing."
    } ]
  }, {
    "tStartMs": 901000,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "It implemented 64 different\nsimultaneous algorithms,"
    } ]
  }, {
    "tStartMs": 904860,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "including one that compensated"
    } ]
  }, {
    "tStartMs": 906540,
    "dDurationMs": 2788,
    "segs": [ {
      "utf8": "for the rotation of the\nearth as the bomb fell."
    } ]
  }, {
    "tStartMs": 909328,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "(bomb exploding)"
    } ]
  }, {
    "tStartMs": 910550,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "The Norden was one of the\nmost closely guarded secrets"
    } ]
  }, {
    "tStartMs": 913320,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "of the war."
    } ]
  }, {
    "tStartMs": 914500,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "To prevent the technology\nfrom falling into enemy hands,"
    } ]
  }, {
    "tStartMs": 917600,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "American bombardiers carried handguns"
    } ]
  }, {
    "tStartMs": 920260,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "specifically to destroy it\nin the event of a crash."
    } ]
  }, {
    "tStartMs": 924780,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "But despite its hype and funding,"
    } ]
  }, {
    "tStartMs": 926690,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "the Norden didn't work as advertised."
    } ]
  }, {
    "tStartMs": 929320,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "With over 2,000 fine parts,"
    } ]
  }, {
    "tStartMs": 931690,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "it required extreme\nprecision to manufacture."
    } ]
  }, {
    "tStartMs": 935210,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The problem with analog computers"
    } ]
  }, {
    "tStartMs": 937290,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "is that the physical device\nis a model for the real world."
    } ]
  }, {
    "tStartMs": 940580,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So any inaccuracy in the components"
    } ]
  }, {
    "tStartMs": 943010,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "translates into inaccuracy\nof the computation."
    } ]
  }, {
    "tStartMs": 946630,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "And since there will always be some slop"
    } ]
  }, {
    "tStartMs": 948660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in the connections between parts,"
    } ]
  }, {
    "tStartMs": 950580,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "if you run the same calculation twice,"
    } ]
  }, {
    "tStartMs": 952870,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "you won't get the exact same answer."
    } ]
  }, {
    "tStartMs": 955890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "In the American campaign against Japan,"
    } ]
  }, {
    "tStartMs": 958470,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "bomber crews using the bombsite"
    } ]
  }, {
    "tStartMs": 960160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "were unable to destroy critical\nJapanese war infrastructure."
    } ]
  }, {
    "tStartMs": 964080,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "And ultimately,"
    } ]
  }, {
    "tStartMs": 965000,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "the U.S. abandoned its\nprecision bombing approach,"
    } ]
  }, {
    "tStartMs": 968070,
    "dDurationMs": 3683,
    "segs": [ {
      "utf8": "and instead blanketed whole\nJapanese cities in napalm."
    } ]
  }, {
    "tStartMs": 973610,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "As the war progressed, digital\ncomputers gained traction."
    } ]
  }, {
    "tStartMs": 977480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The digital and electronic\nColossus machines"
    } ]
  }, {
    "tStartMs": 980180,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "of Bletchley Park in the UK"
    } ]
  }, {
    "tStartMs": 981950,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "were critical to breaking German codes."
    } ]
  }, {
    "tStartMs": 984690,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "In the United States,"
    } ]
  }, {
    "tStartMs": 985710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the military invested\nin an enormously complex"
    } ]
  }, {
    "tStartMs": 988230,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "and expensive digital\nmachine, known as ENIAC."
    } ]
  }, {
    "tStartMs": 991450,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "It was designed"
    } ]
  }, {
    "tStartMs": 992380,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "to speed up the calculation of\nland artillery firing tables."
    } ]
  }, {
    "tStartMs": 996310,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "At the time,"
    } ]
  }, {
    "tStartMs": 997143,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "these were computed using\ndifferential analyzers,"
    } ]
  }, {
    "tStartMs": 999540,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "the analog mechanical computers"
    } ]
  }, {
    "tStartMs": 1001660,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "based on Kelvin's harmonic analyzer."
    } ]
  }, {
    "tStartMs": 1004570,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "Although not finished until after the war,"
    } ]
  }, {
    "tStartMs": 1007020,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "ENIAC demonstrated the\npower of digital computers."
    } ]
  }, {
    "tStartMs": 1010560,
    "dDurationMs": 3493,
    "segs": [ {
      "utf8": "It's considered by many to\nbe the first modern computer."
    } ]
  }, {
    "tStartMs": 1015190,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "- What really opened the door"
    } ]
  }, {
    "tStartMs": 1016370,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "to this digital revolution"
    } ]
  }, {
    "tStartMs": 1017680,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "was the discovery made by Claude Shannon"
    } ]
  }, {
    "tStartMs": 1019610,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "in his 1936 master's thesis."
    } ]
  }, {
    "tStartMs": 1022210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "He showed that any numerical\noperation can be carried out"
    } ]
  }, {
    "tStartMs": 1025450,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "using the basic building\nblocks of Boolean algebra:"
    } ]
  }, {
    "tStartMs": 1028630,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Two values, true or false,\nalso notated as one or zero,"
    } ]
  }, {
    "tStartMs": 1032610,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and three operations and, or, and not."
    } ]
  }, {
    "tStartMs": 1036850,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "This makes digital computers"
    } ]
  }, {
    "tStartMs": 1038460,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the ideal versatile computing machines."
    } ]
  }, {
    "tStartMs": 1041460,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "In contrast, each analog computer"
    } ]
  }, {
    "tStartMs": 1043570,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "is an analog for only one type of problem."
    } ]
  }, {
    "tStartMs": 1047140,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "Furthermore, since digital computers"
    } ]
  }, {
    "tStartMs": 1048770,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "operate on ones and zeros,"
    } ]
  }, {
    "tStartMs": 1050510,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "they are more resilient\nin the face of noise."
    } ]
  }, {
    "tStartMs": 1053250,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "It would take a large error\nto mistake a one for a zero"
    } ]
  }, {
    "tStartMs": 1056410,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "or vice versa."
    } ]
  }, {
    "tStartMs": 1057760,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Whereas, even small errors\nin analog computers can grow"
    } ]
  }, {
    "tStartMs": 1061440,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "and ultimately swamp the signal."
    } ]
  }, {
    "tStartMs": 1064070,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So these days, everything is digital."
    } ]
  }, {
    "tStartMs": 1066870,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "Our phones, computers,\nand internet data centers,"
    } ]
  }, {
    "tStartMs": 1070100,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "even TV and radio is now\nbeing broadcast as digital."
    } ]
  }, {
    "tStartMs": 1073720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The advantages are obvious."
    } ]
  }, {
    "tStartMs": 1075720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Since digital devices operate on symbols,"
    } ]
  }, {
    "tStartMs": 1078120,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "usually zeros and ones,\nthey provide exact answers."
    } ]
  }, {
    "tStartMs": 1081920,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "And repeat the calculation,\nand you get the same result."
    } ]
  }, {
    "tStartMs": 1085470,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "They are robust to noise."
    } ]
  }, {
    "tStartMs": 1087880,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Plus, since only a few\ncomponents are required"
    } ]
  }, {
    "tStartMs": 1090270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to perform virtually any computation,"
    } ]
  }, {
    "tStartMs": 1092550,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "those components have been\nminiaturized and optimized,"
    } ]
  }, {
    "tStartMs": 1096000,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "making digital computers"
    } ]
  }, {
    "tStartMs": 1097260,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "the ideal universal computing machines."
    } ]
  }, {
    "tStartMs": 1100660,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So you would think analog\ncomputers would be long gone,"
    } ]
  }, {
    "tStartMs": 1104200,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "a relic of the distant past."
    } ]
  }, {
    "tStartMs": 1106380,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But, analog may now be making a comeback."
    } ]
  }, {
    "tStartMs": 1109800,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "There are startups actively\nworking on analog computers."
    } ]
  }, {
    "tStartMs": 1114340,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Why is this happening?"
    } ]
  }, {
    "tStartMs": 1115560,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "What could be the benefit of analog?"
    } ]
  }, {
    "tStartMs": 1118430,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I wanted to put all of\nthese into one video."
    } ]
  }, {
    "tStartMs": 1121700,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "But the story is too good\nto bury 20 minutes in,"
    } ]
  }, {
    "tStartMs": 1124720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so that is coming up in part two."
    } ]
  }, {
    "tStartMs": 1127720,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "Be sure you're subscribed to the channel"
    } ]
  }, {
    "tStartMs": 1129050,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "to be notified when that comes out."
    } ]
  }, {
    "tStartMs": 1131237,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(soft upbeat music)"
    } ]
  }, {
    "tStartMs": 1135940,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "I'll give you a hint about the sequel"
    } ]
  }, {
    "tStartMs": 1137820,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "in this section of the video,"
    } ]
  }, {
    "tStartMs": 1139230,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "which is sponsored by Brilliant."
    } ]
  }, {
    "tStartMs": 1141340,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Brilliant is a website and\napp that uses interactivity"
    } ]
  }, {
    "tStartMs": 1144320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to help you learn STEM concepts."
    } ]
  }, {
    "tStartMs": 1146640,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "For the sequel to this video,"
    } ]
  }, {
    "tStartMs": 1148180,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "it would be a good idea"
    } ]
  }, {
    "tStartMs": 1149440,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "to brush up on artificial intelligence,"
    } ]
  }, {
    "tStartMs": 1151880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which you can do with Brilliant's courses"
    } ]
  }, {
    "tStartMs": 1154040,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "on neural networks."
    } ]
  }, {
    "tStartMs": 1155500,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Here you can analyze"
    } ]
  }, {
    "tStartMs": 1156490,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "how a neural network\ndecodes your handwriting."
    } ]
  }, {
    "tStartMs": 1159770,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "I also recommend their calculus courses,"
    } ]
  }, {
    "tStartMs": 1161530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which are highly interactive."
    } ]
  }, {
    "tStartMs": 1163750,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "What's great about Brilliant"
    } ]
  }, {
    "tStartMs": 1165030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "is how it gets you to step through topics,"
    } ]
  }, {
    "tStartMs": 1166980,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "answering questions as you go."
    } ]
  }, {
    "tStartMs": 1168530,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "In that way, you can't trick yourself"
    } ]
  }, {
    "tStartMs": 1170280,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "into thinking you already\nunderstand everything,"
    } ]
  }, {
    "tStartMs": 1172310,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "because you're constantly\nputting your knowledge"
    } ]
  }, {
    "tStartMs": 1174430,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "to the test."
    } ]
  }, {
    "tStartMs": 1175470,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Personally, I find their\ncourses challenging,"
    } ]
  }, {
    "tStartMs": 1177760,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "which they should be in order\nfor you to learn anything."
    } ]
  }, {
    "tStartMs": 1181250,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But if you ever get stuck,"
    } ]
  }, {
    "tStartMs": 1182420,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "there's always a helpful\nhint close at hand,"
    } ]
  }, {
    "tStartMs": 1185170,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "and more in-depth\nexplanations are available"
    } ]
  }, {
    "tStartMs": 1187310,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "if you want them."
    } ]
  }, {
    "tStartMs": 1188760,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "As the holiday season is upon us,"
    } ]
  }, {
    "tStartMs": 1190420,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "an annual subscription to Brilliant"
    } ]
  }, {
    "tStartMs": 1191910,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "makes an awesome gift for any\ncurious learners in your life."
    } ]
  }, {
    "tStartMs": 1195280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And whether it's for you or someone else,"
    } ]
  }, {
    "tStartMs": 1197320,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "Brilliant is offering 20%\noff an annual subscription"
    } ]
  }, {
    "tStartMs": 1200270,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "to the first 200 people to sign up."
    } ]
  }, {
    "tStartMs": 1202210,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Just go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1205130,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "I'll put that link down\ninto the description."
    } ]
  }, {
    "tStartMs": 1207490,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So I wanna thank Brilliant\nfor supporting Veritasium,"
    } ]
  }, {
    "tStartMs": 1209710,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
