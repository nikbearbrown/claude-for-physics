{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] For some people,"
    } ]
  }, {
    "tStartMs": 1260,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "this room might be the\nscariest place on earth."
    } ]
  }, {
    "tStartMs": 4980,
    "dDurationMs": 3339,
    "segs": [ {
      "utf8": "Behind these black curtains\nare deadly spiders,"
    } ]
  }, {
    "tStartMs": 8319,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "(tense ominous music)"
    } ]
  }, {
    "tStartMs": 9240,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "hundreds of them."
    } ]
  }, {
    "tStartMs": 13650,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And what we're gonna do is\npoke them, make them angry,"
    } ]
  }, {
    "tStartMs": 17790,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and then suction the venom\nthat appears at the end"
    } ]
  }, {
    "tStartMs": 20850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of their really long fangs."
    } ]
  }, {
    "tStartMs": 23040,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Well, this is about as close"
    } ]
  }, {
    "tStartMs": 24060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as I ever want to get to a funnel-web."
    } ]
  }, {
    "tStartMs": 25980,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "And we're doing it for a very good reason."
    } ]
  }, {
    "tStartMs": 30270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This is a funnel-web spider."
    } ]
  }, {
    "tStartMs": 32430,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "They live around Sydney,"
    } ]
  }, {
    "tStartMs": 34140,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "which just happens to be one\nof Australia's biggest cities,"
    } ]
  }, {
    "tStartMs": 37860,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and they build underground burrows,"
    } ]
  }, {
    "tStartMs": 40200,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "which are distinctive,"
    } ]
  }, {
    "tStartMs": 41220,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "because of the funnel shape\nof the web at the entrance,"
    } ]
  }, {
    "tStartMs": 44580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "hence the name funnel-web."
    } ]
  }, {
    "tStartMs": 46620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But because they feel\nsafe in dark, cool places,"
    } ]
  }, {
    "tStartMs": 49980,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "they can end up having\nunexpected run-ins with people."
    } ]
  }, {
    "tStartMs": 53130,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- What happens is during\nthe breeding season,"
    } ]
  }, {
    "tStartMs": 55110,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the male funnel-web will leave his burrow,"
    } ]
  }, {
    "tStartMs": 57660,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and he moves around only at\nnight, looking for the females,"
    } ]
  }, {
    "tStartMs": 60780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but sometimes he gets, you\nknow, a bit adventurous,"
    } ]
  }, {
    "tStartMs": 63900,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and he might leave his\nburrow, go too far from it,"
    } ]
  }, {
    "tStartMs": 66750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and so in the morning, once\nthe sun starts to come up,"
    } ]
  }, {
    "tStartMs": 69060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "he's too far from his\nburrow to go back to it,"
    } ]
  }, {
    "tStartMs": 71310,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "so he kind of has a little freak out,"
    } ]
  }, {
    "tStartMs": 73050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and has to find somewhere\ntemporary to hide out"
    } ]
  }, {
    "tStartMs": 75090,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "during the day."
    } ]
  }, {
    "tStartMs": 76020,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And so what he'll do is\nhe'll head into a nice, dark,"
    } ]
  }, {
    "tStartMs": 79260,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "safe spot, like a pile of clothing,"
    } ]
  }, {
    "tStartMs": 81810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "or a pair of shoes on the ground."
    } ]
  }, {
    "tStartMs": 83610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] You'll often see Australians"
    } ]
  }, {
    "tStartMs": 85260,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "bang their shoes together"
    } ]
  }, {
    "tStartMs": 86400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "before putting them on just in case."
    } ]
  }, {
    "tStartMs": 89700,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "If you are unlucky enough to\nget bitten, it'll be painful,"
    } ]
  }, {
    "tStartMs": 93180,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "because their fangs can be\nup to one centimeter long,"
    } ]
  }, {
    "tStartMs": 96780,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "that's longer than many snake fangs,"
    } ]
  }, {
    "tStartMs": 99840,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and the venom delivered\nis fast-acting and deadly."
    } ]
  }, {
    "tStartMs": 103260,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- We only milk the males,"
    } ]
  }, {
    "tStartMs": 104520,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "because they are six times more toxic,"
    } ]
  }, {
    "tStartMs": 106980,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so the males venom actually produces"
    } ]
  }, {
    "tStartMs": 109050,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "a higher quality anti-venom."
    } ]
  }, {
    "tStartMs": 110700,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So the fastest time that\nwe've seen an adult die"
    } ]
  }, {
    "tStartMs": 113190,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "from a male funnel-web\nspider was about 76 minutes,"
    } ]
  }, {
    "tStartMs": 116100,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "so just over an hour."
    } ]
  }, {
    "tStartMs": 118517,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "So it's a very fast-acting, rapid venom."
    } ]
  }, {
    "tStartMs": 120840,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- Ideally, you wanna stay calm, still,"
    } ]
  }, {
    "tStartMs": 123420,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and apply a pressure\nimmobilization bandage,"
    } ]
  }, {
    "tStartMs": 126570,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and then get to the hospital\nas soon as possible."
    } ]
  }, {
    "tStartMs": 130290,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The venom contains a mixture of proteins,"
    } ]
  }, {
    "tStartMs": 133020,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "notably the delta hexatoxin."
    } ]
  }, {
    "tStartMs": 135390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "As it travels through your bloodstream,"
    } ]
  }, {
    "tStartMs": 137430,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "you'll begin to sweat, twitch,\nsalivate, and get goosebumps."
    } ]
  }, {
    "tStartMs": 141810,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "This is because the venom\nacts on nerve cells, neurons."
    } ]
  }, {
    "tStartMs": 145770,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Under normal conditions,"
    } ]
  }, {
    "tStartMs": 147180,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "neurotransmitters trigger\nneurons to open ion gates,"
    } ]
  }, {
    "tStartMs": 150750,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and positively-charged\nsodium ions flood in."
    } ]
  }, {
    "tStartMs": 154200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The dramatic swing from\nnegative to positive"
    } ]
  }, {
    "tStartMs": 156570,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "triggers the release of neurotransmitters"
    } ]
  }, {
    "tStartMs": 158730,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to the next neuron, and\nthen the ion gates close,"
    } ]
  }, {
    "tStartMs": 161910,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the cell returns to its resting state,"
    } ]
  }, {
    "tStartMs": 164310,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "but funnel-web venom stops\nthe ion channels from closing."
    } ]
  }, {
    "tStartMs": 168120,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So the neuron unleashes a\nflood of neurotransmitters,"
    } ]
  }, {
    "tStartMs": 171420,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "like adrenaline, throughout\nthe nervous system."
    } ]
  }, {
    "tStartMs": 174300,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So muscles, normally\nunder precise control,"
    } ]
  }, {
    "tStartMs": 177150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "receive rapid chaotic signals"
    } ]
  }, {
    "tStartMs": 179490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "causing them to tense up or spasm,"
    } ]
  }, {
    "tStartMs": 182010,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which is a big problem for the heart,"
    } ]
  }, {
    "tStartMs": 184230,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which begins to pump faster,\nraising blood pressure,"
    } ]
  }, {
    "tStartMs": 187080,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "and spreading the venom\nfurther around the body,"
    } ]
  }, {
    "tStartMs": 190792,
    "dDurationMs": 3071,
    "segs": [ {
      "utf8": "and eventually your body runs\nout of neurotransmitters."
    } ]
  }, {
    "tStartMs": 194820,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Without them, nerve cells\ncan no longer tell muscles"
    } ]
  }, {
    "tStartMs": 198090,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "what to do,"
    } ]
  }, {
    "tStartMs": 198960,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so you're effectively paralyzed,"
    } ]
  }, {
    "tStartMs": 201030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and it's only a matter\nof time before your heart"
    } ]
  }, {
    "tStartMs": 203070,
    "dDurationMs": 2098,
    "segs": [ {
      "utf8": "or your lungs give out."
    } ]
  }, {
    "tStartMs": 205168,
    "dDurationMs": 932,
    "segs": [ {
      "utf8": "(slow tense music)"
    } ]
  }, {
    "tStartMs": 206100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Humans are particularly unlucky,"
    } ]
  }, {
    "tStartMs": 208740,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "funnel-web venom is not\nthat deadly to most mammals."
    } ]
  }, {
    "tStartMs": 212250,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- If something like your dog, or your cat,"
    } ]
  }, {
    "tStartMs": 214020,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "or a rabbit gets bitten by a\nmale funnel-web spider even,"
    } ]
  }, {
    "tStartMs": 217080,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "even the male, they'll\nshow very few symptoms"
    } ]
  }, {
    "tStartMs": 220020,
    "dDurationMs": 3673,
    "segs": [ {
      "utf8": "and then you could also be\nbitten by the exact same spider,"
    } ]
  }, {
    "tStartMs": 223693,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "and be in a very severe way."
    } ]
  }, {
    "tStartMs": 225060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] And that's\nbecause the effects of venom"
    } ]
  }, {
    "tStartMs": 227100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "are very species specific."
    } ]
  }, {
    "tStartMs": 229290,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Delta hexatoxin binds to a specific site"
    } ]
  }, {
    "tStartMs": 232200,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "of the sodium ion channels in\nprimates, which causes chaos."
    } ]
  }, {
    "tStartMs": 236130,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "But that same spot isn't\nthere in other mammals."
    } ]
  }, {
    "tStartMs": 240270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The lethality of this venom in humans"
    } ]
  }, {
    "tStartMs": 242790,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "seems to be an accident."
    } ]
  }, {
    "tStartMs": 245430,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- It only affects invertebrates,"
    } ]
  }, {
    "tStartMs": 247200,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "which are their prey and also primates,"
    } ]
  }, {
    "tStartMs": 249960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "so it's really toxic to monkeys, and apes,"
    } ]
  }, {
    "tStartMs": 253170,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "and of course, we are extremely\nbadly affected by that."
    } ]
  }, {
    "tStartMs": 257460,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "- The first people\narrived on the continent"
    } ]
  }, {
    "tStartMs": 260497,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "around 70,000 years ago,"
    } ]
  }, {
    "tStartMs": 262110,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "but this spider evolved\n40 million years ago,"
    } ]
  }, {
    "tStartMs": 266190,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "and it just happens to be\nextremely deadly to people."
    } ]
  }, {
    "tStartMs": 270960,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So it seems like an\nunfortunate coincidence"
    } ]
  }, {
    "tStartMs": 273420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that venom originally evolved"
    } ]
  }, {
    "tStartMs": 274860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for effectiveness against insects"
    } ]
  }, {
    "tStartMs": 276990,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "turns out to be deadly for us."
    } ]
  }, {
    "tStartMs": 280050,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The people here at the\nAustralian Reptile Park"
    } ]
  }, {
    "tStartMs": 282150,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "try to prevent that by making\nlife-saving anti-venom,"
    } ]
  }, {
    "tStartMs": 285720,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but to produce it\nrequires collecting venom"
    } ]
  }, {
    "tStartMs": 288180,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "from their stock of spiders."
    } ]
  }, {
    "tStartMs": 290867,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "- [Jake] We actually\nrely exclusively almost"
    } ]
  }, {
    "tStartMs": 292650,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "on public donations in order\nto keep the collection going."
    } ]
  }, {
    "tStartMs": 297473,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "All of these spiders\nwould've been caught up"
    } ]
  }, {
    "tStartMs": 298620,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "by someone that has found\nit in their backyard,"
    } ]
  }, {
    "tStartMs": 301530,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "or in their swimming pool,\nor something like that."
    } ]
  }, {
    "tStartMs": 303810,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- You heard right,"
    } ]
  }, {
    "tStartMs": 305130,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "funnel-web spiders can\nactually survive underwater"
    } ]
  }, {
    "tStartMs": 308400,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "for up to 30 hours."
    } ]
  }, {
    "tStartMs": 310740,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "They do this by trapping tiny air bubbles"
    } ]
  }, {
    "tStartMs": 313350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in the hairs on their abdomen."
    } ]
  }, {
    "tStartMs": 315450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So if you see a funnel-web spider"
    } ]
  }, {
    "tStartMs": 317400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "at the bottom of a swimming pool"
    } ]
  }, {
    "tStartMs": 319470,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "that doesn't necessarily\nmean that it's dead."
    } ]
  }, {
    "tStartMs": 322560,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- It's much more efficient\nfor us to have spiders"
    } ]
  }, {
    "tStartMs": 324780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "handed in that are already adults,"
    } ]
  }, {
    "tStartMs": 327270,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "they're moving around,\nthey're mature males,"
    } ]
  }, {
    "tStartMs": 329670,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and we can start milking\nthem straight away,"
    } ]
  }, {
    "tStartMs": 331410,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "we haven't had to do any\nof the work to raise them."
    } ]
  }, {
    "tStartMs": 334994,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "And then, yeah, we'll milk\nthem for that period of time."
    } ]
  }, {
    "tStartMs": 338160,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] Here's how you do it."
    } ]
  }, {
    "tStartMs": 339780,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "First, you poke it."
    } ]
  }, {
    "tStartMs": 342510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Jake] So that's kind"
    } ]
  }, {
    "tStartMs": 343343,
    "dDurationMs": 2647,
    "segs": [ {
      "utf8": "of the funnel-web spider defensive stance,"
    } ]
  }, {
    "tStartMs": 345990,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "they'll raise in the air like\nthat, and expose their fangs."
    } ]
  }, {
    "tStartMs": 349800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Sometimes they'll actually\nform drops of venom"
    } ]
  }, {
    "tStartMs": 352200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "just on the tip of each fang"
    } ]
  }, {
    "tStartMs": 354300,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "- [Derek] Which is when we\ncome in with a tiny vacuum."
    } ]
  }, {
    "tStartMs": 358098,
    "dDurationMs": 2208,
    "segs": [ {
      "utf8": "- [Jake] You basically just\nuse it as you would a pencil,"
    } ]
  }, {
    "tStartMs": 360306,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "and just stroke the tip\nof the fang with that."
    } ]
  }, {
    "tStartMs": 364110,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- [Derek] Okay, I see\nthat I got a little bit."
    } ]
  }, {
    "tStartMs": 369390,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Jake] Sucked a big drop up."
    } ]
  }, {
    "tStartMs": 370800,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "- [Derek] Well, this is about as close"
    } ]
  }, {
    "tStartMs": 372747,
    "dDurationMs": 1226,
    "segs": [ {
      "utf8": "as I ever want to get to a funnel web."
    } ]
  }, {
    "tStartMs": 375390,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- Say we milk about 50 spiders a day."
    } ]
  }, {
    "tStartMs": 378390,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "If you were saying each spider\nproduced four to five drops,"
    } ]
  }, {
    "tStartMs": 381990,
    "dDurationMs": 4773,
    "segs": [ {
      "utf8": "you know you're only talking\nabout maybe 250 drops of venom."
    } ]
  }, {
    "tStartMs": 387600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "What we've got in the end\nof the pipette there now"
    } ]
  }, {
    "tStartMs": 390690,
    "dDurationMs": 4593,
    "segs": [ {
      "utf8": "would be enough to kill perhaps\na dozen or so adult humans."
    } ]
  }, {
    "tStartMs": 396600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- To get one vial of anti-venom,"
    } ]
  }, {
    "tStartMs": 398790,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "they have to milk 150 spiders by hand."
    } ]
  }, {
    "tStartMs": 403404,
    "dDurationMs": 1686,
    "segs": [ {
      "utf8": "That takes 12 hours."
    } ]
  }, {
    "tStartMs": 405090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "12 hours out."
    } ]
  }, {
    "tStartMs": 406470,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- It's a lot of work.\n- Milking a spider"
    } ]
  }, {
    "tStartMs": 407940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to save one person.\n- Exactly, yeah."
    } ]
  }, {
    "tStartMs": 409560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- I mean I think that's worth it."
    } ]
  }, {
    "tStartMs": 411630,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "The venom is frozen, and sent\ndown to a lab in Melbourne,"
    } ]
  }, {
    "tStartMs": 415080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and there rabbits are injected with it."
    } ]
  }, {
    "tStartMs": 418080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Now, although it's not as toxic to rabbits"
    } ]
  }, {
    "tStartMs": 420030,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "as it is to humans,"
    } ]
  }, {
    "tStartMs": 421110,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "they still start with a low dose,"
    } ]
  }, {
    "tStartMs": 423570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and then over a period of six months,"
    } ]
  }, {
    "tStartMs": 425610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "they gradually increase the dose"
    } ]
  }, {
    "tStartMs": 427380,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "as the rabbits build up their immunity,"
    } ]
  }, {
    "tStartMs": 430200,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and once they can withstand\nsix times the lethal dose,"
    } ]
  }, {
    "tStartMs": 432930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "their blood is collected,"
    } ]
  }, {
    "tStartMs": 434610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and it gets spun on a centrifuge"
    } ]
  }, {
    "tStartMs": 436410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to separate out the antibodies."
    } ]
  }, {
    "tStartMs": 438810,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And it is these rabbit antibodies"
    } ]
  }, {
    "tStartMs": 440940,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that form the life-saving anti-venom."
    } ]
  }, {
    "tStartMs": 443730,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Rabbits and people are similar enough"
    } ]
  }, {
    "tStartMs": 445860,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "that rabbit antibodies can still\nneutralize funnel-web venom"
    } ]
  }, {
    "tStartMs": 449790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "inside our bodies."
    } ]
  }, {
    "tStartMs": 452040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Every year around 40 people get bitten"
    } ]
  }, {
    "tStartMs": 454590,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "by funnel-web spiders"
    } ]
  }, {
    "tStartMs": 456090,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "commonly from not checking\ntheir shoes in the morning."
    } ]
  }, {
    "tStartMs": 459270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- And fortunately, due to this program,"
    } ]
  }, {
    "tStartMs": 460950,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "no one has died since 1981."
    } ]
  }, {
    "tStartMs": 463770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So for over 40 years now,"
    } ]
  }, {
    "tStartMs": 465330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "we haven't seen a single death from one"
    } ]
  }, {
    "tStartMs": 467370,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "of these spiders."
    } ]
  }, {
    "tStartMs": 474090,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Before we end today,"
    } ]
  }, {
    "tStartMs": 475260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I want to thank today's\nsponsor, BetterHelp."
    } ]
  }, {
    "tStartMs": 477510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "BetterHelp's mission is to\nmake therapy more accessible"
    } ]
  }, {
    "tStartMs": 479940,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "to more people,"
    } ]
  }, {
    "tStartMs": 480930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and I think that's a\nreally important goal."
    } ]
  }, {
    "tStartMs": 483570,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You know, finding a\ngood therapist is hard,"
    } ]
  }, {
    "tStartMs": 485730,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "especially when you only have\nthe options in your city."
    } ]
  }, {
    "tStartMs": 488430,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And it can be even harder to find time"
    } ]
  }, {
    "tStartMs": 490260,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "in your schedule to\ntravel in and meet them."
    } ]
  }, {
    "tStartMs": 493144,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "BetterHelp changes the game on all this,"
    } ]
  }, {
    "tStartMs": 495240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it's an online platform, it's remote,"
    } ]
  }, {
    "tStartMs": 497430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and by filling out a few questions,"
    } ]
  }, {
    "tStartMs": 498990,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you'll get matched to a\nprofessional therapist,"
    } ]
  }, {
    "tStartMs": 501300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and if you don't really\nfit with that therapist,"
    } ]
  }, {
    "tStartMs": 503040,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "which is a common thing,"
    } ]
  }, {
    "tStartMs": 504360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "you can easily switch\nto a new one for free"
    } ]
  }, {
    "tStartMs": 506430,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "without stressing about insurance,"
    } ]
  }, {
    "tStartMs": 508260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "who's in your network,\nor anything like that,"
    } ]
  }, {
    "tStartMs": 510510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "regardless of if you have a\nclinical mental health issue,"
    } ]
  }, {
    "tStartMs": 512670,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "like depression or anxiety,"
    } ]
  }, {
    "tStartMs": 514050,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "or if you're just a human\nbeing who lives in this world"
    } ]
  }, {
    "tStartMs": 517110,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "who has fears or stresses"
    } ]
  }, {
    "tStartMs": 518700,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "therapy can give you tools\nto approach your life"
    } ]
  }, {
    "tStartMs": 520860,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "in a very different way,"
    } ]
  }, {
    "tStartMs": 522120,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and it's easy to sign up,"
    } ]
  }, {
    "tStartMs": 523380,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "there's a link in the description"
    } ]
  }, {
    "tStartMs": 524610,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which is betterhelp.com/veritasium."
    } ]
  }, {
    "tStartMs": 527670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Clicking on that link\nhelp support this channel,"
    } ]
  }, {
    "tStartMs": 529860,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but it also gets you\n10% off your first month"
    } ]
  }, {
    "tStartMs": 532170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "at BetterHelp, so you can try it out,"
    } ]
  }, {
    "tStartMs": 533730,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and see if it works for you."
    } ]
  }, {
    "tStartMs": 535680,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So I wanna thank BetterHelp\nfor sponsoring Veritasium"
    } ]
  }, {
    "tStartMs": 538140,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
