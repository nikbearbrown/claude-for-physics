{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 480,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "- In 1982, there was one SAT question"
    } ]
  }, {
    "tStartMs": 3299,
    "dDurationMs": 2494,
    "segs": [ {
      "utf8": "that every single student got wrong."
    } ]
  }, {
    "tStartMs": 6900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Here it is."
    } ]
  }, {
    "tStartMs": 8340,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "In the figure above,"
    } ]
  }, {
    "tStartMs": 9360,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "the radius of circle A is\n1/3 the radius of circle B."
    } ]
  }, {
    "tStartMs": 13890,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Starting from the position\nshown in the figure,"
    } ]
  }, {
    "tStartMs": 15960,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "circle A rolls around circle B."
    } ]
  }, {
    "tStartMs": 19230,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "At the end of how many\nrevolutions of circle A"
    } ]
  }, {
    "tStartMs": 22320,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "will the center"
    } ]
  }, {
    "tStartMs": 23190,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "of the circle first\nreach its starting point."
    } ]
  }, {
    "tStartMs": 27090,
    "dDurationMs": 6210,
    "segs": [ {
      "utf8": "Is it A, 3/2, B, three, C, six,"
    } ]
  }, {
    "tStartMs": 33300,
    "dDurationMs": 3993,
    "segs": [ {
      "utf8": "D, 9/2, or E, nine?"
    } ]
  }, {
    "tStartMs": 38190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "SAT Questions are designed to be quick."
    } ]
  }, {
    "tStartMs": 40530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "This exam gave students 30\nminutes to solve 25 problems,"
    } ]
  }, {
    "tStartMs": 43920,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so about a minute each."
    } ]
  }, {
    "tStartMs": 45900,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "So feel free to pause the\nvideo here and try to solve it."
    } ]
  }, {
    "tStartMs": 50790,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "What is your answer?"
    } ]
  }, {
    "tStartMs": 53670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I'll tell you right now that option B,"
    } ]
  }, {
    "tStartMs": 55590,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "or three, is not correct."
    } ]
  }, {
    "tStartMs": 58740,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "When I first saw this problem,\nmy intuitive answer was B,"
    } ]
  }, {
    "tStartMs": 62010,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "because the circumference of\na circle is just two pi r,"
    } ]
  }, {
    "tStartMs": 65820,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and since the radius of\ncircle B is three times"
    } ]
  }, {
    "tStartMs": 70080,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the radius of circle A,"
    } ]
  }, {
    "tStartMs": 71550,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the circumference of circle\nB must also be three times"
    } ]
  }, {
    "tStartMs": 74580,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the circumference of circle A."
    } ]
  }, {
    "tStartMs": 76530,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So logically, it should\ntake three full rotations"
    } ]
  }, {
    "tStartMs": 79980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "of circle A to roll around circle B."
    } ]
  }, {
    "tStartMs": 82920,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "So my answer was three."
    } ]
  }, {
    "tStartMs": 86070,
    "dDurationMs": 6853,
    "segs": [ {
      "utf8": "This is wrong, but so are\nanswers A, C, D, and E."
    } ]
  }, {
    "tStartMs": 94590,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "The reason no one got question 17 correct"
    } ]
  }, {
    "tStartMs": 97200,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "is that the test writers\nthemselves got it wrong."
    } ]
  }, {
    "tStartMs": 100530,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They also thought the answer was three."
    } ]
  }, {
    "tStartMs": 102990,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So the actual correct\nanswer was not listed"
    } ]
  }, {
    "tStartMs": 106410,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "as an option on the test."
    } ]
  }, {
    "tStartMs": 110430,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Mistakes like this aren't\nsupposed to happen on the SAT."
    } ]
  }, {
    "tStartMs": 113490,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "For decades, it was the one\nexam every student had to take"
    } ]
  }, {
    "tStartMs": 116790,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to go to college in the US."
    } ]
  }, {
    "tStartMs": 118500,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "It had a reputation"
    } ]
  }, {
    "tStartMs": 119460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "for determining people's entire futures."
    } ]
  }, {
    "tStartMs": 122280,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "As a newspaper from the time stated,"
    } ]
  }, {
    "tStartMs": 124177,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "\"If you mess up on your SAT\ntests, you can forget it."
    } ]
  }, {
    "tStartMs": 127110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Your life as a productive citizen is over."
    } ]
  }, {
    "tStartMs": 130020,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "Hang it up, son.\""
    } ]
  }, {
    "tStartMs": 133680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Of 300,000 test takers,"
    } ]
  }, {
    "tStartMs": 136080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "just three students wrote about the error"
    } ]
  }, {
    "tStartMs": 138360,
    "dDurationMs": 3197,
    "segs": [ {
      "utf8": "to the College Board, the\ncompany that administers the SAT,"
    } ]
  }, {
    "tStartMs": 141557,
    "dDurationMs": 3916,
    "segs": [ {
      "utf8": "Shivan Kartha, Bruce\nTaub, and Doug Jungreis."
    } ]
  }, {
    "tStartMs": 147780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- I did a lot of math\nproblems when I was young"
    } ]
  }, {
    "tStartMs": 150210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "for the competitions."
    } ]
  }, {
    "tStartMs": 151440,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I probably did thousands of\nmath problems and I read it"
    } ]
  }, {
    "tStartMs": 154470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and I was amazed how badly it's worded."
    } ]
  }, {
    "tStartMs": 156990,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I just put three down. I\nfigured that's what they wanted."
    } ]
  }, {
    "tStartMs": 159720,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- The three\nstudents were confident none"
    } ]
  }, {
    "tStartMs": 161550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "of the listed answers were correct,"
    } ]
  }, {
    "tStartMs": 163200,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and their letters showed it."
    } ]
  }, {
    "tStartMs": 164760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "As a director at the\ntesting service recalled,"
    } ]
  }, {
    "tStartMs": 167160,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "they didn't say they had come up"
    } ]
  }, {
    "tStartMs": 168270,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "with possible alternative answers"
    } ]
  }, {
    "tStartMs": 170040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "or that maybe we were wrong."
    } ]
  }, {
    "tStartMs": 171720,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "They said flat out, \"You're\nwrong,\" and they proved it."
    } ]
  }, {
    "tStartMs": 175860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- I discussed it with some\nother people and said,"
    } ]
  }, {
    "tStartMs": 178890,
    "dDurationMs": 2617,
    "segs": [ {
      "utf8": "I think there was a mistake,\nand they mostly said,"
    } ]
  }, {
    "tStartMs": 181507,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "\"No one cares.\""
    } ]
  }, {
    "tStartMs": 183660,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "I wrote a letter to the\nEducational Testing Service."
    } ]
  }, {
    "tStartMs": 187470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It was a little while later they called us"
    } ]
  }, {
    "tStartMs": 189360,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and said I was correct."
    } ]
  }, {
    "tStartMs": 192720,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "- Here is their argument."
    } ]
  }, {
    "tStartMs": 195600,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The simplest version of this problem"
    } ]
  }, {
    "tStartMs": 197580,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is with two identical coins."
    } ]
  }, {
    "tStartMs": 199980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "These have the exact same circumference."
    } ]
  }, {
    "tStartMs": 202380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So by our initial logic,"
    } ]
  }, {
    "tStartMs": 204180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "this coin should rotate exactly once"
    } ]
  }, {
    "tStartMs": 206430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "as it rolls around the other."
    } ]
  }, {
    "tStartMs": 208320,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "So let's try it."
    } ]
  }, {
    "tStartMs": 210930,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 213300,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But wait, we can see it's\nalready right side up"
    } ]
  }, {
    "tStartMs": 216540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "at the halfway point."
    } ]
  }, {
    "tStartMs": 217950,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So if we finish rolling\nit around the other coin,"
    } ]
  }, {
    "tStartMs": 221790,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "it'll have rotated not once, but twice."
    } ]
  }, {
    "tStartMs": 225270,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Even though the coins\nare the exact same size"
    } ]
  }, {
    "tStartMs": 228660,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "There are no tricks here,"
    } ]
  }, {
    "tStartMs": 230610,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "you can try it for yourself,"
    } ]
  }, {
    "tStartMs": 231990,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and I'll do it again slowly."
    } ]
  }, {
    "tStartMs": 236610,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "That's one,"
    } ]
  }, {
    "tStartMs": 243270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "two."
    } ]
  }, {
    "tStartMs": 245130,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This is known as the\ncoin rotation paradox."
    } ]
  }, {
    "tStartMs": 248730,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "This paradox also applies to question 17."
    } ]
  }, {
    "tStartMs": 252360,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "I've made a to scale model of the problem."
    } ]
  }, {
    "tStartMs": 256380,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "One useful tip for standardized tests,"
    } ]
  }, {
    "tStartMs": 258780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "even though they say their\nimages are not to scale,"
    } ]
  }, {
    "tStartMs": 261120,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "they almost always are."
    } ]
  }, {
    "tStartMs": 264420,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "So when we roll circle A around circle B,"
    } ]
  }, {
    "tStartMs": 268590,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "we can see that it rotates once, twice,"
    } ]
  }, {
    "tStartMs": 277530,
    "dDurationMs": 6506,
    "segs": [ {
      "utf8": "three times, and four times in total."
    } ]
  }, {
    "tStartMs": 284721,
    "dDurationMs": 3009,
    "segs": [ {
      "utf8": "So the correct answer to this\nquestion is actually four."
    } ]
  }, {
    "tStartMs": 287730,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Once again, the circle\nrotates one more time"
    } ]
  }, {
    "tStartMs": 290310,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "than we expected."
    } ]
  }, {
    "tStartMs": 291900,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "To understand this,"
    } ]
  }, {
    "tStartMs": 293010,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "let's wrap this larger\ncircle in some ribbon"
    } ]
  }, {
    "tStartMs": 300930,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "And I'll make it the same\nlength as the circumference,"
    } ]
  }, {
    "tStartMs": 304710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and then I will stick it down to the table"
    } ]
  }, {
    "tStartMs": 307320,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "as a straight line."
    } ]
  }, {
    "tStartMs": 309210,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "I'm adding some paper here"
    } ]
  }, {
    "tStartMs": 312390,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "so there's something for this to roll on."
    } ]
  }, {
    "tStartMs": 316860,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And now it rolls one, two, three times."
    } ]
  }, {
    "tStartMs": 323100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "What's happening when we\nturn this straight path"
    } ]
  }, {
    "tStartMs": 325350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "into a circular one is that\ncircle A is now rolling"
    } ]
  }, {
    "tStartMs": 328050,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "the length of the circumference"
    } ]
  }, {
    "tStartMs": 329700,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and it's going around a circle."
    } ]
  }, {
    "tStartMs": 332640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The shape of the circular path itself"
    } ]
  }, {
    "tStartMs": 334560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "makes circle A do an additional rotation"
    } ]
  }, {
    "tStartMs": 337080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to return to its starting point."
    } ]
  }, {
    "tStartMs": 339180,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So this is the general\nsolution to the problem."
    } ]
  }, {
    "tStartMs": 342000,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Find the ratio between the\ncircumferences of circle B"
    } ]
  }, {
    "tStartMs": 345150,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and circle A and then add one rotation"
    } ]
  }, {
    "tStartMs": 347790,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "to account for the circular path traveled."
    } ]
  }, {
    "tStartMs": 352170,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But there is a way to correctly get three."
    } ]
  }, {
    "tStartMs": 355140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Let's count the rotations of circle A"
    } ]
  }, {
    "tStartMs": 357030,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "from the perspective of\ncircle B looking out at A."
    } ]
  }, {
    "tStartMs": 360510,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "We can see circle A rotates one, two,"
    } ]
  }, {
    "tStartMs": 371310,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "three times."
    } ]
  }, {
    "tStartMs": 374550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And it doesn't matter which\ncircle you are looking from,"
    } ]
  }, {
    "tStartMs": 376950,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to circle A, it also rotates three times"
    } ]
  }, {
    "tStartMs": 379650,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to come back to its starting\nposition around circle B."
    } ]
  }, {
    "tStartMs": 384030,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Similarly, from the\nperspective of the coins,"
    } ]
  }, {
    "tStartMs": 386310,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "we can see that the outer\ncoin only rotates once"
    } ]
  }, {
    "tStartMs": 389130,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "as it rolls around the inner coin."
    } ]
  }, {
    "tStartMs": 393150,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Using the perspective of a circle"
    } ]
  }, {
    "tStartMs": 394890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "is just like turning the\ncircle's circumference"
    } ]
  }, {
    "tStartMs": 396840,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "into a straight line."
    } ]
  }, {
    "tStartMs": 399450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It's only as external observers"
    } ]
  }, {
    "tStartMs": 401490,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that we actually see\nthe outer circle travel"
    } ]
  }, {
    "tStartMs": 403680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "a circular path back\nto its starting point,"
    } ]
  }, {
    "tStartMs": 405930,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "giving us the one extra rotation."
    } ]
  }, {
    "tStartMs": 410280,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "But there's even another answer."
    } ]
  }, {
    "tStartMs": 416460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If you look closely at question 17,"
    } ]
  }, {
    "tStartMs": 418740,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "it asks how many\nrevolutions circle A makes"
    } ]
  }, {
    "tStartMs": 421890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "as it rolls around circle B\nback to its starting point."
    } ]
  }, {
    "tStartMs": 425010,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Now, in astronomy,"
    } ]
  }, {
    "tStartMs": 426030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "the definition of a revolution is precise."
    } ]
  }, {
    "tStartMs": 428220,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "It's a complete orbit around another body."
    } ]
  }, {
    "tStartMs": 432120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The earth revolves around the sun,"
    } ]
  }, {
    "tStartMs": 433680,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "which is different from it\nrotating about its axis."
    } ]
  }, {
    "tStartMs": 436710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So by the astronomical\ndefinition of a revolution,"
    } ]
  }, {
    "tStartMs": 439380,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "circle A only revolves\naround circle B once."
    } ]
  }, {
    "tStartMs": 443160,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "It goes around one time."
    } ]
  }, {
    "tStartMs": 446760,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Now, other definitions of a\nrevolution do include the motion"
    } ]
  }, {
    "tStartMs": 449760,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of an object rotating about its own axis."
    } ]
  }, {
    "tStartMs": 451710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So one isn't a definitive answer,"
    } ]
  }, {
    "tStartMs": 453900,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "but the wording of this\nquestion is extremely ambiguous"
    } ]
  }, {
    "tStartMs": 457110,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "if you can justify at least\nthree different solutions."
    } ]
  }, {
    "tStartMs": 464430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "After reviewing the\nletters from the students,"
    } ]
  }, {
    "tStartMs": 466320,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "the College Board publicly\nadmitted their mistake"
    } ]
  }, {
    "tStartMs": 468300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "a few weeks later and\nnullified the question"
    } ]
  }, {
    "tStartMs": 470580,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "for all test takers."
    } ]
  }, {
    "tStartMs": 473130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- They said they were\ndiscounting the problem"
    } ]
  }, {
    "tStartMs": 474900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and they were calling us"
    } ]
  }, {
    "tStartMs": 476400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because they were gonna tell the news"
    } ]
  }, {
    "tStartMs": 478680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and they thought that we should be warned"
    } ]
  }, {
    "tStartMs": 480900,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that the news might contact us."
    } ]
  }, {
    "tStartMs": 483090,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I did a bunch of phone\ninterviews and NBC News,"
    } ]
  }, {
    "tStartMs": 486270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "they came to my school."
    } ]
  }, {
    "tStartMs": 488100,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "They said I was right and\nthey were discounting it."
    } ]
  }, {
    "tStartMs": 490860,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "So that was great."
    } ]
  }, {
    "tStartMs": 493500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- But there's\nmore to the explanation."
    } ]
  }, {
    "tStartMs": 495630,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- It's easy to get an intuitive reason,"
    } ]
  }, {
    "tStartMs": 498870,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but it's really hard to formally prove"
    } ]
  }, {
    "tStartMs": 501930,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that the answer is four."
    } ]
  }, {
    "tStartMs": 503490,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I could give you some proofs if you want."
    } ]
  }, {
    "tStartMs": 505590,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Well, that would be wonderful."
    } ]
  }, {
    "tStartMs": 506520,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "I think that would be, we'd\nappreciate that for sure."
    } ]
  }, {
    "tStartMs": 509850,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- I have a whiteboard\nbecause I'm a mathematician,"
    } ]
  }, {
    "tStartMs": 511980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "so I just happen to\nhave a whiteboard here."
    } ]
  }, {
    "tStartMs": 514020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Hold on."
    } ]
  }, {
    "tStartMs": 516660,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Can you see that?\n- Yep."
    } ]
  }, {
    "tStartMs": 519030,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- It turns out that the amount\nthe small circle rotates"
    } ]
  }, {
    "tStartMs": 522450,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "is always the same as the\ndistance the center travels."
    } ]
  }, {
    "tStartMs": 526530,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "All right, so why is this true?"
    } ]
  }, {
    "tStartMs": 529140,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Suppose you had a camera"
    } ]
  }, {
    "tStartMs": 530790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and the camera was always\npointed at the center."
    } ]
  }, {
    "tStartMs": 533160,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So in your movie, it looks\nlike the center doesn't move."
    } ]
  }, {
    "tStartMs": 536790,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In the real world,"
    } ]
  }, {
    "tStartMs": 537623,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "the center is going around the circle."
    } ]
  }, {
    "tStartMs": 539820,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Let's say it's going at some speed V."
    } ]
  }, {
    "tStartMs": 542100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "What's the velocity of this point?"
    } ]
  }, {
    "tStartMs": 544350,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It's zero, and that's because\nit's rolling without slipping."
    } ]
  }, {
    "tStartMs": 548910,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "If it had any component in that direction,"
    } ]
  }, {
    "tStartMs": 551730,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that's what slipping would be."
    } ]
  }, {
    "tStartMs": 553170,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I mean, this is something I think they"
    } ]
  }, {
    "tStartMs": 554280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "should have spelled out in the problem,"
    } ]
  }, {
    "tStartMs": 555720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but when you change\nyour frame of reference,"
    } ]
  }, {
    "tStartMs": 558360,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the relative velocities don't change."
    } ]
  }, {
    "tStartMs": 561030,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In the movee, the center\nalways has velocity zero."
    } ]
  }, {
    "tStartMs": 564390,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "So this point would have to\nhave velocity negative V."
    } ]
  }, {
    "tStartMs": 568260,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So that means the speed\nthat this is turning"
    } ]
  }, {
    "tStartMs": 571740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "is the same as the speed\nthe center is moving."
    } ]
  }, {
    "tStartMs": 574290,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So if they always have the same speed,"
    } ]
  }, {
    "tStartMs": 575910,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "they have to go the same total distance."
    } ]
  }, {
    "tStartMs": 578820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The total distance this\nturns has to be the same"
    } ]
  }, {
    "tStartMs": 581370,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "as the total distance the center moves."
    } ]
  }, {
    "tStartMs": 584760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In this problem,"
    } ]
  }, {
    "tStartMs": 585593,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "the center of the small\ncircle goes around a circle"
    } ]
  }, {
    "tStartMs": 588660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of radius four."
    } ]
  }, {
    "tStartMs": 590550,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "So the total distance that\nthe center moves is eight pi."
    } ]
  }, {
    "tStartMs": 595200,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "What's the total amount that\nthe small circle rotates?"
    } ]
  }, {
    "tStartMs": 598260,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "It rotates four times, and\nits circumference is two pi."
    } ]
  }, {
    "tStartMs": 602010,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "It's the same number."
    } ]
  }, {
    "tStartMs": 603180,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "If it rolls without slipping,"
    } ]
  }, {
    "tStartMs": 604860,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the total distance the\ncenter travels is the same"
    } ]
  }, {
    "tStartMs": 608490,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "as the total amount it turns."
    } ]
  }, {
    "tStartMs": 611490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- And this is always true."
    } ]
  }, {
    "tStartMs": 614010,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Take a circle rolling without\nslipping on any surface"
    } ]
  }, {
    "tStartMs": 616830,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "from a polygon to a blob, on\nthe outside or the inside,"
    } ]
  }, {
    "tStartMs": 622260,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the distance traveled by\nthe center of the circle"
    } ]
  }, {
    "tStartMs": 624360,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "is equal to the amount\nthe circle has rotated."
    } ]
  }, {
    "tStartMs": 627150,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, just find this distance"
    } ]
  }, {
    "tStartMs": 629010,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and divide it by the circle circumference"
    } ]
  }, {
    "tStartMs": 630630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to get how many rotations it's made."
    } ]
  }, {
    "tStartMs": 633150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This is an even more general\nsolution than our answer"
    } ]
  }, {
    "tStartMs": 635700,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "to the coin paradox where we\njust took our expected answer,"
    } ]
  }, {
    "tStartMs": 638910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which we'll call N, and added one,"
    } ]
  }, {
    "tStartMs": 641490,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "and it reveals where\nthis shortcut comes from."
    } ]
  }, {
    "tStartMs": 644970,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "If a circle is rolling\ncontinuously around a shape,"
    } ]
  }, {
    "tStartMs": 647730,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the circle center goes around the outside,"
    } ]
  }, {
    "tStartMs": 650280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "increasing its distance traveled"
    } ]
  }, {
    "tStartMs": 651720,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "by exactly one circumference of the circle"
    } ]
  }, {
    "tStartMs": 654570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so the distance traveled\nby the circle center"
    } ]
  }, {
    "tStartMs": 656640,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "is just the perimeter of the shape"
    } ]
  }, {
    "tStartMs": 658500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "plus the circle's circumference."
    } ]
  }, {
    "tStartMs": 660750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "When we ultimately divide this\nby the circle circumference"
    } ]
  }, {
    "tStartMs": 662880,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to get the total number of\nrotations, we get N plus one."
    } ]
  }, {
    "tStartMs": 667200,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "If a circle is rolling\ncontinuously within a shape,"
    } ]
  }, {
    "tStartMs": 670170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the distance travel by the\ncircle center decreases"
    } ]
  }, {
    "tStartMs": 672540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "by one circumference of the circle,"
    } ]
  }, {
    "tStartMs": 674280,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "making the total number\nof rotations N minus one."
    } ]
  }, {
    "tStartMs": 678060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If the circle is rolling\nalong a flat line,"
    } ]
  }, {
    "tStartMs": 680700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the distance travel by the circle center"
    } ]
  }, {
    "tStartMs": 682530,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "is equal to the length of the line which,"
    } ]
  }, {
    "tStartMs": 684990,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "divided by the circle\ncircumference, is just N."
    } ]
  }, {
    "tStartMs": 689010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This general principle extends far beyond"
    } ]
  }, {
    "tStartMs": 691410,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "a mathematical fun fact."
    } ]
  }, {
    "tStartMs": 692970,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "In fact, it's essential in astronomy"
    } ]
  }, {
    "tStartMs": 694830,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "for accurate timekeeping."
    } ]
  }, {
    "tStartMs": 697350,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "When we count 365 days going by in a year,"
    } ]
  }, {
    "tStartMs": 700830,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "365.24, to be precise,"
    } ]
  }, {
    "tStartMs": 703650,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "we say we're just counting\nhow many rotations"
    } ]
  }, {
    "tStartMs": 706050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the earth makes in one\norbit around the sun."
    } ]
  }, {
    "tStartMs": 708990,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But it's not that simple."
    } ]
  }, {
    "tStartMs": 710790,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "All this counting is\ndone from the perspective"
    } ]
  }, {
    "tStartMs": 712800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of you on earth."
    } ]
  }, {
    "tStartMs": 714240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "To an external observer,"
    } ]
  }, {
    "tStartMs": 715680,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they'll see the earth\ndo one extra rotation"
    } ]
  }, {
    "tStartMs": 718440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to account for its circular\npath around the sun."
    } ]
  }, {
    "tStartMs": 721560,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "So while we count 365.24 days in a year,"
    } ]
  }, {
    "tStartMs": 725730,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "they count 366.24 days in a year."
    } ]
  }, {
    "tStartMs": 730620,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This is called a Sidereal year,"
    } ]
  }, {
    "tStartMs": 732930,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Sidereal meaning with respect to the stars"
    } ]
  }, {
    "tStartMs": 735780,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "where an external observer would be."
    } ]
  }, {
    "tStartMs": 738330,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "But what happens to that one extra day?"
    } ]
  }, {
    "tStartMs": 742200,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "A normal solar day is\nthe time it takes the sun"
    } ]
  }, {
    "tStartMs": 744690,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to be directly above you again on earth."
    } ]
  }, {
    "tStartMs": 747720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But the earth isn't just rotating,"
    } ]
  }, {
    "tStartMs": 749610,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it's orbiting the sun at the same time."
    } ]
  }, {
    "tStartMs": 751800,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So in a 24-hour solar day,"
    } ]
  }, {
    "tStartMs": 754080,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "earth actually has to\nrotate more than 360 degrees"
    } ]
  }, {
    "tStartMs": 757710,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "in order to bring the sun\ndirectly overhead again."
    } ]
  }, {
    "tStartMs": 760530,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But Earth's orbit is\nnegligible to distant stars."
    } ]
  }, {
    "tStartMs": 764070,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "To see a star directly overhead again,"
    } ]
  }, {
    "tStartMs": 766470,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Earth just needs to rotate\nexactly 360 degrees."
    } ]
  }, {
    "tStartMs": 773490,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So while it takes the sun exactly 24 hours"
    } ]
  }, {
    "tStartMs": 775980,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "to be directly above you again,"
    } ]
  }, {
    "tStartMs": 780210,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "a star at night takes\nonly 23 hours, 56 minutes,"
    } ]
  }, {
    "tStartMs": 783870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and four seconds to be above you again."
    } ]
  }, {
    "tStartMs": 786180,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "That's a Sidereal day."
    } ]
  }, {
    "tStartMs": 789480,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "This explains where the extra\nday goes in the Sidereal year."
    } ]
  }, {
    "tStartMs": 794370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "If we start a solar day"
    } ]
  }, {
    "tStartMs": 795810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and a Sidereal day at the same time,"
    } ]
  }, {
    "tStartMs": 798600,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "we'd see them slowly\ndiverge throughout the year."
    } ]
  }, {
    "tStartMs": 801420,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "After six months,"
    } ]
  }, {
    "tStartMs": 802680,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "the Sidereal day would be 12\nhours ahead of the solar day,"
    } ]
  }, {
    "tStartMs": 806730,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "meaning that noon would be midnight,"
    } ]
  }, {
    "tStartMs": 809190,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and it would keep moving up"
    } ]
  }, {
    "tStartMs": 810660,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "until it's finally one full\nday ahead of the solar day,"
    } ]
  }, {
    "tStartMs": 814860,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "at which point a new\nyear and orbit begins."
    } ]
  }, {
    "tStartMs": 819180,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "365.24 days that are each 24 hours long"
    } ]
  }, {
    "tStartMs": 823230,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "are equal to 366.24 days\nthat are each 23 hours,"
    } ]
  }, {
    "tStartMs": 828540,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "56 minutes, and four seconds long."
    } ]
  }, {
    "tStartMs": 834330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So it makes no sense to\nuse Sidereal time on earth,"
    } ]
  }, {
    "tStartMs": 837330,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "because six months down the line,"
    } ]
  }, {
    "tStartMs": 838920,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "day and night would be completely swapped."
    } ]
  }, {
    "tStartMs": 841980,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But equally, it's\nuseless to use solar time"
    } ]
  }, {
    "tStartMs": 844680,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "while tracking objects in space,"
    } ]
  }, {
    "tStartMs": 846570,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "because the region you're\nobserving would shift between say,"
    } ]
  }, {
    "tStartMs": 849930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "10:00 PM one night and\n10:00 PM the next night."
    } ]
  }, {
    "tStartMs": 852690,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So instead, astronomers use Sidereal time"
    } ]
  }, {
    "tStartMs": 855210,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "for their telescopes to\nensure that they're looking"
    } ]
  }, {
    "tStartMs": 857520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "at the same region of space each night."
    } ]
  }, {
    "tStartMs": 860220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And all geostationary satellites,"
    } ]
  }, {
    "tStartMs": 862050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "like those used for\ncommunication or navigation,"
    } ]
  }, {
    "tStartMs": 864720,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they use Sidereal time"
    } ]
  }, {
    "tStartMs": 866430,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "to keep their orbits locked\nwith the Earth's rotation."
    } ]
  }, {
    "tStartMs": 871080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So the coin paradox actually\nexplains the difference"
    } ]
  }, {
    "tStartMs": 873900,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "between how we track time on earth"
    } ]
  }, {
    "tStartMs": 876210,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "and how we track time in the universe."
    } ]
  }, {
    "tStartMs": 883530,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The rescoring of the 1982\nSAT wasn't all good news."
    } ]
  }, {
    "tStartMs": 887970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "With question 17 scrapped,"
    } ]
  }, {
    "tStartMs": 889620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "students' scores were scaled without it,"
    } ]
  }, {
    "tStartMs": 891540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "moving their final result up or down"
    } ]
  }, {
    "tStartMs": 893760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "by 10 points out of 800."
    } ]
  }, {
    "tStartMs": 895920,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Now, while that doesn't seem like much,"
    } ]
  }, {
    "tStartMs": 897630,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "some universities and scholarships"
    } ]
  }, {
    "tStartMs": 899070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "use strict minimum test score cutoffs."
    } ]
  }, {
    "tStartMs": 901860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And as one admissions expert\nput it, \"There are instances,"
    } ]
  }, {
    "tStartMs": 905220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "even if we do not consider them justified,"
    } ]
  }, {
    "tStartMs": 907050,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "in which 10 points can have an impact"
    } ]
  }, {
    "tStartMs": 908880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "on a person's educational opportunities."
    } ]
  }, {
    "tStartMs": 911400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It might not keep someone\nout of law school,"
    } ]
  }, {
    "tStartMs": 913680,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "but it might affect which\none he could go to.\""
    } ]
  }, {
    "tStartMs": 917670,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "This mistake didn't only\ncost points off the exam."
    } ]
  }, {
    "tStartMs": 920340,
    "dDurationMs": 1177,
    "segs": [ {
      "utf8": "According to the testing service,"
    } ]
  }, {
    "tStartMs": 921517,
    "dDurationMs": 3353,
    "segs": [ {
      "utf8": "\"Rescoring would cost them over $100,000,"
    } ]
  }, {
    "tStartMs": 924870,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "money that came outta the\npockets of test takers."
    } ]
  }, {
    "tStartMs": 929160,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The question 17 circle problem\nwas far from the last error"
    } ]
  }, {
    "tStartMs": 932580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "on the SAT."
    } ]
  }, {
    "tStartMs": 935460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But errors are likely"
    } ]
  }, {
    "tStartMs": 937080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the least of their concerns these days."
    } ]
  }, {
    "tStartMs": 938760,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I mean, the SAT is slowly\nbecoming a thing of the past."
    } ]
  }, {
    "tStartMs": 941790,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "After COVID-19, nearly 80%\nof undergraduate colleges"
    } ]
  }, {
    "tStartMs": 945060,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "in the US no longer require\nany standardized testing."
    } ]
  }, {
    "tStartMs": 949200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And that 1982 exam, well,"
    } ]
  }, {
    "tStartMs": 951480,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "it didn't turn out too badly for some."
    } ]
  }, {
    "tStartMs": 954390,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "How did you do on your\nmath SAT, if I can ask?"
    } ]
  }, {
    "tStartMs": 957840,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- I got an 800."
    } ]
  }, {
    "tStartMs": 959430,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Even before that, it was clear\nI was gonna go into math."
    } ]
  }, {
    "tStartMs": 963150,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "I did math competitions.\nI really liked math."
    } ]
  }, {
    "tStartMs": 966840,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- Do you end up writing any\nmath questions these days?"
    } ]
  }, {
    "tStartMs": 969630,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- A while back I wrote problems\nfor a math competition."
    } ]
  }, {
    "tStartMs": 972390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- And were you careful with how\nyou wrote them, the wording?"
    } ]
  }, {
    "tStartMs": 975000,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "- I hope so. I tried"
    } ]
  }, {
    "tStartMs": 982920,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- Today's deep dive on\none SAT question proves"
    } ]
  }, {
    "tStartMs": 985950,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "there's no substitute for\nhands-on exploration to understand"
    } ]
  }, {
    "tStartMs": 989100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and appreciate the everyday\nphenomena of our world."
    } ]
  }, {
    "tStartMs": 991980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But you don't have to\nobserve earth from space,"
    } ]
  }, {
    "tStartMs": 994650,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "or make cardboard cutouts\nto get hands-on with math,"
    } ]
  }, {
    "tStartMs": 997470,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "science, and cutting edge tech."
    } ]
  }, {
    "tStartMs": 998970,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "In fact, you can do it\nfrom anywhere right now"
    } ]
  }, {
    "tStartMs": 1001400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "with this video sponsor, Brilliant,"
    } ]
  }, {
    "tStartMs": 1003380,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and you can get started for free."
    } ]
  }, {
    "tStartMs": 1004850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Just go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1007790,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Brilliant will make you a better thinker"
    } ]
  }, {
    "tStartMs": 1009590,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and problem solver in\neverything from science to math,"
    } ]
  }, {
    "tStartMs": 1012680,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "data programming, technology, you name it."
    } ]
  }, {
    "tStartMs": 1015440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Just set your goal and\nBrilliant will design a path"
    } ]
  }, {
    "tStartMs": 1017840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to get you there."
    } ]
  }, {
    "tStartMs": 1019460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "If you liked today's video,"
    } ]
  }, {
    "tStartMs": 1020840,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I highly recommend you check\nout one of my favorite courses"
    } ]
  }, {
    "tStartMs": 1023690,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "on Brilliant, which is\nScientific Thinking."
    } ]
  }, {
    "tStartMs": 1026960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Scientific Thinking takes\nyou on an interactive tour"
    } ]
  }, {
    "tStartMs": 1029480,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of our physical world."
    } ]
  }, {
    "tStartMs": 1030770,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "You'll engage with key\nscientific principles"
    } ]
  }, {
    "tStartMs": 1033020,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and theories from simple\nmachines like gears and pulleys"
    } ]
  }, {
    "tStartMs": 1035840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to Einstein's special\ntheory of relativity."
    } ]
  }, {
    "tStartMs": 1038720,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Whether you're comparing circuits"
    } ]
  }, {
    "tStartMs": 1040100,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to understand voltage and current,"
    } ]
  }, {
    "tStartMs": 1042050,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "playing snooker to learn\nthe rules of collisions,"
    } ]
  }, {
    "tStartMs": 1044870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "or even planning your itinerary"
    } ]
  }, {
    "tStartMs": 1046820,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "for an intergalactic music\nfestival on a space time diagram,"
    } ]
  }, {
    "tStartMs": 1051020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you will learn by doing"
    } ]
  }, {
    "tStartMs": 1052610,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and foster a deep understanding\nwithout getting bogged down"
    } ]
  }, {
    "tStartMs": 1055610,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "in heavy mathematical formulas."
    } ]
  }, {
    "tStartMs": 1057830,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "They even have a version\nof the coin paradox."
    } ]
  }, {
    "tStartMs": 1060860,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And by the end,"
    } ]
  }, {
    "tStartMs": 1061820,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "this course will change\nhow you think about"
    } ]
  }, {
    "tStartMs": 1064130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the world around you."
    } ]
  }, {
    "tStartMs": 1065900,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Beyond science, Brilliant\nhas a massive library"
    } ]
  }, {
    "tStartMs": 1068390,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "of content in math, data science,"
    } ]
  }, {
    "tStartMs": 1070640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "programming, and technology,"
    } ]
  }, {
    "tStartMs": 1072260,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "all with that same hands-on approach"
    } ]
  }, {
    "tStartMs": 1074030,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "that makes concepts\nincredibly easy to understand."
    } ]
  }, {
    "tStartMs": 1077450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And the best part is you can\nlearn with Brilliant on the go."
    } ]
  }, {
    "tStartMs": 1080240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's like having interactive\nversions of our videos"
    } ]
  }, {
    "tStartMs": 1083360,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "in your pocket."
    } ]
  }, {
    "tStartMs": 1084350,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "To try everything Brilliant\nhas to offer for free"
    } ]
  }, {
    "tStartMs": 1086660,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "for 30 days, just visit\nbrilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1090530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I will put that link\ndown in the description."
    } ]
  }, {
    "tStartMs": 1092870,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And the first 200 of you"
    } ]
  }, {
    "tStartMs": 1094430,
