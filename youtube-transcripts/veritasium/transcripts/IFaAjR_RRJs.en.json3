{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 150,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Derek] This is a Strandbeest."
    } ]
  }, {
    "tStartMs": 1860,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's a walking skeleton"
    } ]
  }, {
    "tStartMs": 3540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that's powered only by the wind,"
    } ]
  }, {
    "tStartMs": 5460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "created by Dutch inventor Theo Jansen."
    } ]
  }, {
    "tStartMs": 8100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "There are no motors and no electronics,"
    } ]
  }, {
    "tStartMs": 10980,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and they're made of\nthe weirdest materials."
    } ]
  }, {
    "tStartMs": 14130,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Tape and glue and snot and screws,"
    } ]
  }, {
    "tStartMs": 16530,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and gets that force to transfer,"
    } ]
  }, {
    "tStartMs": 18990,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "is really thrilling to me."
    } ]
  }, {
    "tStartMs": 20790,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "- I mean, now it's on \"The Simpsons.\""
    } ]
  }, {
    "tStartMs": 22743,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "- The Strandbeest."
    } ]
  }, {
    "tStartMs": 24295,
    "dDurationMs": 3245,
    "segs": [ {
      "utf8": "- Uh, is this science or garbage?"
    } ]
  }, {
    "tStartMs": 27540,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Dutch art."
    } ]
  }, {
    "tStartMs": 29010,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] But how do they actually work,"
    } ]
  }, {
    "tStartMs": 31050,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "and why did he build them?"
    } ]
  }, {
    "tStartMs": 34650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Well, it all started 34 years ago."
    } ]
  }, {
    "tStartMs": 36990,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "- I promised myself to\nspend one year on the tubes."
    } ]
  }, {
    "tStartMs": 41730,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "That was in 1990."
    } ]
  }, {
    "tStartMs": 43440,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "That got totally out of hand."
    } ]
  }, {
    "tStartMs": 45141,
    "dDurationMs": 1205,
    "segs": [ {
      "utf8": "- A little."
    } ]
  }, {
    "tStartMs": 46346,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "(elegant classical music)"
    } ]
  }, {
    "tStartMs": 86700,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- [Derek] Now, Jansen's thinking bigger."
    } ]
  }, {
    "tStartMs": 89280,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- I hope that that these\nanimals can survive"
    } ]
  }, {
    "tStartMs": 91500,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "all the circumstances here on the beach,"
    } ]
  }, {
    "tStartMs": 93240,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "like the storms and\nthe water and the sand."
    } ]
  }, {
    "tStartMs": 96390,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Hopefully at the end of\nmy life, it's that far,"
    } ]
  }, {
    "tStartMs": 98790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and that they can live on their own."
    } ]
  }, {
    "tStartMs": 101400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That's the idea."
    } ]
  }, {
    "tStartMs": 102600,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "A new specimen on Earth."
    } ]
  }, {
    "tStartMs": 105690,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] But to achieve this goal,"
    } ]
  }, {
    "tStartMs": 106950,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "the beest had to overcome\nsix major challenges."
    } ]
  }, {
    "tStartMs": 110340,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The first is that they had\nto support their own weight."
    } ]
  }, {
    "tStartMs": 113400,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- The beginning, I had lots of trouble"
    } ]
  }, {
    "tStartMs": 115620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "with the connections, the joints."
    } ]
  }, {
    "tStartMs": 117870,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I used Sellotape to connect them."
    } ]
  }, {
    "tStartMs": 120390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "And it all broke, you know."
    } ]
  }, {
    "tStartMs": 123000,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Derek] As a result,"
    } ]
  }, {
    "tStartMs": 123900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "all the beest could do was lie on its back"
    } ]
  }, {
    "tStartMs": 125940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and move its legs a little."
    } ]
  }, {
    "tStartMs": 127860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Yeah, I can imagine the\nfirst thing I would do"
    } ]
  }, {
    "tStartMs": 129450,
    "dDurationMs": 1405,
    "segs": [ {
      "utf8": "is stop using tape."
    } ]
  }, {
    "tStartMs": 130855,
    "dDurationMs": 2555,
    "segs": [ {
      "utf8": "(chuckling) Like, tape is\nnot a long-term solution."
    } ]
  }, {
    "tStartMs": 133410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 134243,
    "dDurationMs": 1177,
    "segs": [ {
      "utf8": "Yeah, no, it was very short term."
    } ]
  }, {
    "tStartMs": 135420,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "You can look at some of the pictures."
    } ]
  }, {
    "tStartMs": 136800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It's just like,"
    } ]
  }, {
    "tStartMs": 138180,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "you see some tubes,"
    } ]
  }, {
    "tStartMs": 139470,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but you mostly see tape everywhere"
    } ]
  }, {
    "tStartMs": 141390,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "trying to hold it together."
    } ]
  }, {
    "tStartMs": 143040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And so he too realizes this very quickly."
    } ]
  }, {
    "tStartMs": 145380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So the first fix to\nthis challenge is, like,"
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "using zip ties."
    } ]
  }, {
    "tStartMs": 149370,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Much more elegant, much more clean,"
    } ]
  }, {
    "tStartMs": 151680,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "way, way stronger."
    } ]
  }, {
    "tStartMs": 153870,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] Jansen restricted himself"
    } ]
  }, {
    "tStartMs": 155220,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to only a few basic materials."
    } ]
  }, {
    "tStartMs": 158220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Still, five more hurdles remained,"
    } ]
  }, {
    "tStartMs": 160860,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "the next of which was getting\nthe beest to walk smoothly."
    } ]
  }, {
    "tStartMs": 164250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "To do this, Jansen realized that the path"
    } ]
  }, {
    "tStartMs": 166500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "traced out by their foot as it moves"
    } ]
  }, {
    "tStartMs": 168540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "is extremely important,"
    } ]
  }, {
    "tStartMs": 170040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "because if that's wonky\nand all over the place,"
    } ]
  }, {
    "tStartMs": 172740,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the beest will likely lose its balance."
    } ]
  }, {
    "tStartMs": 175680,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But if instead it traces\nout a mostly flat surface"
    } ]
  }, {
    "tStartMs": 178770,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "along the bottom,"
    } ]
  }, {
    "tStartMs": 179700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "well, then the beest\ncould keep its balance"
    } ]
  }, {
    "tStartMs": 181620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and walk properly."
    } ]
  }, {
    "tStartMs": 183270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now, you can get drastically\ndifferent footpaths"
    } ]
  }, {
    "tStartMs": 185820,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "by changing the proportions of these tubes"
    } ]
  }, {
    "tStartMs": 188400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and where they're placed."
    } ]
  }, {
    "tStartMs": 189660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Some footpaths might be wonky,"
    } ]
  }, {
    "tStartMs": 191550,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "others a bit flat,"
    } ]
  }, {
    "tStartMs": 192750,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "or just about anything in between."
    } ]
  }, {
    "tStartMs": 195210,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But how do you find the right one?"
    } ]
  }, {
    "tStartMs": 197430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "That's what Jansen wanted to find out."
    } ]
  }, {
    "tStartMs": 199530,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So in 1990, he wrote a computer program"
    } ]
  }, {
    "tStartMs": 202230,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that could compute the footpath"
    } ]
  }, {
    "tStartMs": 203970,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "for any given combination of proportions."
    } ]
  }, {
    "tStartMs": 207090,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Now, you might think,"
    } ]
  }, {
    "tStartMs": 208057,
    "dDurationMs": 953,
    "segs": [ {
      "utf8": "\"Just have the computer"
    } ]
  }, {
    "tStartMs": 209010,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "go over trillions of possible options"
    } ]
  }, {
    "tStartMs": 210960,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and then pick the best one.\""
    } ]
  }, {
    "tStartMs": 213030,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But that doesn't work."
    } ]
  }, {
    "tStartMs": 215190,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Then my computer would be on"
    } ]
  }, {
    "tStartMs": 216600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "for a hundred thousand years, yeah."
    } ]
  }, {
    "tStartMs": 218460,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So that's why I use this evolution method"
    } ]
  }, {
    "tStartMs": 222090,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "where you can come there a lot faster."
    } ]
  }, {
    "tStartMs": 226530,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "- [Derek] So, Jansen ran\na simulation that started"
    } ]
  }, {
    "tStartMs": 229367,
    "dDurationMs": 3373,
    "segs": [ {
      "utf8": "with 1,500 different\ncombinations of proportions,"
    } ]
  }, {
    "tStartMs": 232740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "resulting in 1,500 different footpaths."
    } ]
  }, {
    "tStartMs": 235620,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Now, none of these curves"
    } ]
  }, {
    "tStartMs": 236760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "had a great flat surface at the bottom,"
    } ]
  }, {
    "tStartMs": 238950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but some were slightly\nmore flat than others."
    } ]
  }, {
    "tStartMs": 241860,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Those combinations would then reproduce"
    } ]
  }, {
    "tStartMs": 243840,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and multiply with slight changes"
    } ]
  }, {
    "tStartMs": 246210,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "into 1,500 new combinations."
    } ]
  }, {
    "tStartMs": 248640,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "This evolutionary process went\non for months, day and night,"
    } ]
  }, {
    "tStartMs": 252990,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "until, by the end of it,"
    } ]
  }, {
    "tStartMs": 254160,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "these 13 holy numbers came out."
    } ]
  }, {
    "tStartMs": 257430,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "That's how he describes it."
    } ]
  }, {
    "tStartMs": 259710,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "They describe the proportions\nand placements of all tubes"
    } ]
  }, {
    "tStartMs": 262740,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "so that when you put them all together"
    } ]
  }, {
    "tStartMs": 264210,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and start rotating the\ncrankshaft right here,"
    } ]
  }, {
    "tStartMs": 266760,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "they give you this footpath."
    } ]
  }, {
    "tStartMs": 270270,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "This is the path"
    } ]
  }, {
    "tStartMs": 271290,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that just about every\nStrandbeest has traced out"
    } ]
  }, {
    "tStartMs": 273570,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "for over 30 years."
    } ]
  }, {
    "tStartMs": 276840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "If you then connect\ndifferent legs together"
    } ]
  }, {
    "tStartMs": 278760,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "where each leg is out of phase\nof the others by 120 degrees,"
    } ]
  }, {
    "tStartMs": 282960,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "then you get this continuous smooth walk."
    } ]
  }, {
    "tStartMs": 286620,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And those 13 holy numbers?"
    } ]
  }, {
    "tStartMs": 288630,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Well, I guess you could see that"
    } ]
  }, {
    "tStartMs": 290010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "as the genetic code of the Strandbeest."
    } ]
  }, {
    "tStartMs": 292800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- And the reason you\noffset them by 120 degrees"
    } ]
  }, {
    "tStartMs": 295620,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "is so that there's always feet"
    } ]
  }, {
    "tStartMs": 297030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that are in contact with the ground,"
    } ]
  }, {
    "tStartMs": 298860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "which gives you this smooth ride."
    } ]
  }, {
    "tStartMs": 300990,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Derek] And getting\nthis right is important."
    } ]
  }, {
    "tStartMs": 303150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "In 2016, my friend and original\nMythBuster, Adam Savage,"
    } ]
  }, {
    "tStartMs": 306480,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "built his own pedal-powered Strandbeest."
    } ]
  }, {
    "tStartMs": 309330,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "- I found the movement of\nhis robots so compelling,"
    } ]
  }, {
    "tStartMs": 313260,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "because it felt like looking\nat a different kind of nature."
    } ]
  }, {
    "tStartMs": 316530,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "There's a tremendous amount\nof force on the axle,"
    } ]
  }, {
    "tStartMs": 319530,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and that he builds all\nthis stuff with, like,"
    } ]
  }, {
    "tStartMs": 321540,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "tape and glue and snot and screws"
    } ]
  }, {
    "tStartMs": 323910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and gets that force to transfer"
    } ]
  }, {
    "tStartMs": 326370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is really thrilling to me."
    } ]
  }, {
    "tStartMs": 328410,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "To be honest, I built\none at the Exploratorium"
    } ]
  }, {
    "tStartMs": 331140,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "in their parking lot, over three days,"
    } ]
  }, {
    "tStartMs": 333270,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and for two days, I was getting it wrong."
    } ]
  }, {
    "tStartMs": 336330,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- [Derek] Adam tried all kinds\nof fixes to get it to walk,"
    } ]
  }, {
    "tStartMs": 339480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but without success."
    } ]
  }, {
    "tStartMs": 341190,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- But I remember building the Strandbeest"
    } ]
  }, {
    "tStartMs": 342510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and hearing this guy"
    } ]
  }, {
    "tStartMs": 343343,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "talking about something\nI was getting wrong,"
    } ]
  }, {
    "tStartMs": 344880,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and I'm tuning him out, tuning\nhim out, tuning him out."
    } ]
  }, {
    "tStartMs": 347610,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And then at four o'clock\nbetween days two and three,"
    } ]
  }, {
    "tStartMs": 350580,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "four o'clock in the morning,"
    } ]
  }, {
    "tStartMs": 351420,
    "dDurationMs": 1865,
    "segs": [ {
      "utf8": "I woke up and I was like,\n(gasps) that guy's right."
    } ]
  }, {
    "tStartMs": 353285,
    "dDurationMs": 2995,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 356280,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "And he saw it on the\ninvitation to the build."
    } ]
  }, {
    "tStartMs": 360510,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "He saw that I had missed, in\nmy translation of a drawing,"
    } ]
  }, {
    "tStartMs": 364410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I had missed one of the linkages,"
    } ]
  }, {
    "tStartMs": 366720,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and that I had this length"
    } ]
  }, {
    "tStartMs": 368100,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "of the center triangle linkage off,"
    } ]
  }, {
    "tStartMs": 370710,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and I needed to push it out."
    } ]
  }, {
    "tStartMs": 372420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And it was like night and day."
    } ]
  }, {
    "tStartMs": 374400,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I came in, fixed that thing,"
    } ]
  }, {
    "tStartMs": 376050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "cut all the way up the\nmiddle of this metal bod,"
    } ]
  }, {
    "tStartMs": 378720,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "extended everything by an inch,"
    } ]
  }, {
    "tStartMs": 379980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and all of a sudden it just walked."
    } ]
  }, {
    "tStartMs": 381360,
    "dDurationMs": 3656,
    "segs": [ {
      "utf8": "It was like, when you get it\nright, that thing just moves."
    } ]
  }, {
    "tStartMs": 385016,
    "dDurationMs": 4747,
    "segs": [ {
      "utf8": "- Ah, yes, yes! (whoops and laughs)"
    } ]
  }, {
    "tStartMs": 390930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Did you ever give that guy a heads up"
    } ]
  }, {
    "tStartMs": 392730,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and be like, \"Hey, yeah.\""
    } ]
  }, {
    "tStartMs": 394320,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "- I did, but not till the end of the day."
    } ]
  }, {
    "tStartMs": 396029,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Okay."
    } ]
  }, {
    "tStartMs": 396862,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "- I didn't wanna give him the satisfaction"
    } ]
  }, {
    "tStartMs": 398430,
    "dDurationMs": 946,
    "segs": [ {
      "utf8": "while I was still working."
    } ]
  }, {
    "tStartMs": 399376,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 401220,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "That's my ego. (laughs)"
    } ]
  }, {
    "tStartMs": 404970,
    "dDurationMs": 2955,
    "segs": [ {
      "utf8": "- [Derek] But Adam's beest\nlived in an exhibition."
    } ]
  }, {
    "tStartMs": 407925,
    "dDurationMs": 3105,
    "segs": [ {
      "utf8": "(wind and sand whooshing)"
    } ]
  }, {
    "tStartMs": 411030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Jansen's beests, on the other hand,"
    } ]
  }, {
    "tStartMs": 412470,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "spend the entire summer on the beach,"
    } ]
  }, {
    "tStartMs": 414930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "where they're exposed to the elements."
    } ]
  }, {
    "tStartMs": 417360,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So all the remaining hurdles"
    } ]
  }, {
    "tStartMs": 418710,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "are about surviving and\nconquering their natural habitat."
    } ]
  }, {
    "tStartMs": 422340,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "One major challenge is dealing with sand."
    } ]
  }, {
    "tStartMs": 425820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Casper] And the sand is very fluffy,"
    } ]
  }, {
    "tStartMs": 427020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "so it's very easy for them to get stuck,"
    } ]
  }, {
    "tStartMs": 429480,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "especially if it's a stick."
    } ]
  }, {
    "tStartMs": 430710,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It would just bury itself in,"
    } ]
  }, {
    "tStartMs": 432690,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "and then it cannot move,"
    } ]
  }, {
    "tStartMs": 433650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "so it can survive."
    } ]
  }, {
    "tStartMs": 435330,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Derek] To prevent this from happening,"
    } ]
  }, {
    "tStartMs": 436890,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "the beests evolved feet\nspecifically adapted to the beach."
    } ]
  }, {
    "tStartMs": 441180,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- What you can immediately see"
    } ]
  }, {
    "tStartMs": 442620,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "is that it's not just a stick\nthat's poking into the ground."
    } ]
  }, {
    "tStartMs": 446010,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Instead, you've got this\nlarge sort of surface area."
    } ]
  }, {
    "tStartMs": 448830,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Then it's much easier for it\nto stay on top of the sand."
    } ]
  }, {
    "tStartMs": 453240,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- [Derek] But they also fulfill\na less obvious function."
    } ]
  }, {
    "tStartMs": 456570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- You've got these wires here,"
    } ]
  }, {
    "tStartMs": 458700,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and what this does,"
    } ]
  }, {
    "tStartMs": 459840,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "together away with the\nlarger surface area,"
    } ]
  }, {
    "tStartMs": 461550,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "is it provides a lot more contact time"
    } ]
  }, {
    "tStartMs": 464880,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "where the foot is basically\nin touch with the ground."
    } ]
  }, {
    "tStartMs": 468360,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So, when this foot is in\ntouch with the ground,"
    } ]
  }, {
    "tStartMs": 471120,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "it can get taken over by another\nand taken over by another."
    } ]
  }, {
    "tStartMs": 474660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And as a result you get\nthis very smooth ride,"
    } ]
  }, {
    "tStartMs": 477120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "which is what you're looking for,"
    } ]
  }, {
    "tStartMs": 478680,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to save the structure of the Strandbeest"
    } ]
  }, {
    "tStartMs": 480990,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and not put too much pressure on it."
    } ]
  }, {
    "tStartMs": 483690,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- [Adam] Because I built\none with tennis shoes,"
    } ]
  }, {
    "tStartMs": 486690,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Theo explained to me"
    } ]
  }, {
    "tStartMs": 487920,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that having a couple of inches of play"
    } ]
  }, {
    "tStartMs": 491370,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "in the linkage between the\nfinal ankle and the tennis shoe"
    } ]
  }, {
    "tStartMs": 494940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "was mission critical"
    } ]
  }, {
    "tStartMs": 497070,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to allow that foot to stay in place"
    } ]
  }, {
    "tStartMs": 500040,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "while the linkage got the other\nfoot up and ready to drop."
    } ]
  }, {
    "tStartMs": 503970,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And that's apparently\nhow our walking works"
    } ]
  }, {
    "tStartMs": 507240,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "is, you know, it's not a\nstraight, like, 1, 2, 3,"
    } ]
  }, {
    "tStartMs": 510960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "like a robot."
    } ]
  }, {
    "tStartMs": 511793,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "There is the swing,"
    } ]
  }, {
    "tStartMs": 513660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Derek] But the beests\naren't always walking."
    } ]
  }, {
    "tStartMs": 515640,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I mean, sometimes they're\ntied up in the same place"
    } ]
  }, {
    "tStartMs": 517860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "for days or weeks."
    } ]
  }, {
    "tStartMs": 519480,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And then, sand poses another major threat."
    } ]
  }, {
    "tStartMs": 522690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- If you leave a structure\nlike this on the beach,"
    } ]
  }, {
    "tStartMs": 524970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you come back after three weeks"
    } ]
  }, {
    "tStartMs": 526890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and it's totally covered with sand."
    } ]
  }, {
    "tStartMs": 529440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "To avoid that,"
    } ]
  }, {
    "tStartMs": 530760,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I thought maybe if they\njust lift up a little bit,"
    } ]
  }, {
    "tStartMs": 533700,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the sand goes under\nthere, and that buries."
    } ]
  }, {
    "tStartMs": 536790,
    "dDurationMs": 3388,
    "segs": [ {
      "utf8": "- [Derek] This is how\nflying Strandbeests evolved."
    } ]
  }, {
    "tStartMs": 540178,
    "dDurationMs": 4052,
    "segs": [ {
      "utf8": "But the beests also face more\nviolent threats, like storms."
    } ]
  }, {
    "tStartMs": 544230,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, how can they increase\ntheir odds of survival"
    } ]
  }, {
    "tStartMs": 547080,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "during these times?"
    } ]
  }, {
    "tStartMs": 549540,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Well, for regular animals,"
    } ]
  }, {
    "tStartMs": 551250,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "it's typically easier to\nsurvive harsh conditions"
    } ]
  }, {
    "tStartMs": 553920,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "by banding together."
    } ]
  }, {
    "tStartMs": 555150,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And the same holds true for Strandbeests."
    } ]
  }, {
    "tStartMs": 557430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- And the idea behind this animal"
    } ]
  }, {
    "tStartMs": 559470,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "was that they would survive\nthe storm maybe better"
    } ]
  }, {
    "tStartMs": 564960,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "holding each other,"
    } ]
  }, {
    "tStartMs": 565800,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "because if you see an\nindividual, like over there,"
    } ]
  }, {
    "tStartMs": 569250,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "if you put it on the beach,"
    } ]
  }, {
    "tStartMs": 570420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "it blows over very easy."
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So as an individual,\nthey wouldn't survive."
    } ]
  }, {
    "tStartMs": 575430,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But as a group holding each other,"
    } ]
  }, {
    "tStartMs": 577920,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "they are stronger in strong winds."
    } ]
  }, {
    "tStartMs": 581940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] This also allows"
    } ]
  }, {
    "tStartMs": 583140,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "for a different type of Strandbeest"
    } ]
  }, {
    "tStartMs": 585420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- One that can be pulled."
    } ]
  }, {
    "tStartMs": 586860,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And the big ideas actually\nthat this would be pulled"
    } ]
  }, {
    "tStartMs": 589830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "by the other Strandbeest."
    } ]
  }, {
    "tStartMs": 591510,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Now, I asked Theo if I can\npull it, and he said yes."
    } ]
  }, {
    "tStartMs": 594900,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So, we can grab it right here."
    } ]
  }, {
    "tStartMs": 598110,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "There's some hand markings,"
    } ]
  }, {
    "tStartMs": 600030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and then now I should be the motor,"
    } ]
  }, {
    "tStartMs": 602070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and his crawler should come behind me."
    } ]
  }, {
    "tStartMs": 604860,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So let's see."
    } ]
  }, {
    "tStartMs": 606300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Oh man, this is cool."
    } ]
  }, {
    "tStartMs": 608550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "This is very cool."
    } ]
  }, {
    "tStartMs": 610620,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "Walking a Strandbeest up a Dutch Beach."
    } ]
  }, {
    "tStartMs": 615060,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "What an epic job."
    } ]
  }, {
    "tStartMs": 617520,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Strandbeests are in\na never-ending battle"
    } ]
  }, {
    "tStartMs": 619980,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "against the elements."
    } ]
  }, {
    "tStartMs": 621150,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But they can help each\nother by working together."
    } ]
  }, {
    "tStartMs": 624420,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Not too long ago, I was in\nan endless battle myself,"
    } ]
  }, {
    "tStartMs": 627660,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "with spam callers."
    } ]
  }, {
    "tStartMs": 629040,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And fortunately for me,\ntoday's sponsor, Incogni,"
    } ]
  }, {
    "tStartMs": 632010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "is helping me in this fight."
    } ]
  }, {
    "tStartMs": 633930,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "See, there are data brokers out there"
    } ]
  }, {
    "tStartMs": 636150,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that collect all kinds of data on you,"
    } ]
  }, {
    "tStartMs": 637920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "like your name, phone\nnumber, email address,"
    } ]
  }, {
    "tStartMs": 640380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and even your social security number."
    } ]
  }, {
    "tStartMs": 642540,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And then they sell all of this information"
    } ]
  }, {
    "tStartMs": 644910,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "on the open market,"
    } ]
  }, {
    "tStartMs": 646410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and that's why you can\nget spam calls and emails"
    } ]
  }, {
    "tStartMs": 649260,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "from people that you've never even"
    } ]
  }, {
    "tStartMs": 650910,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "given your information to."
    } ]
  }, {
    "tStartMs": 652470,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Well, Incogni fights the data brokers."
    } ]
  }, {
    "tStartMs": 655320,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "You just give them permission,"
    } ]
  }, {
    "tStartMs": 656580,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and then they'll figure\nout who has your data,"
    } ]
  }, {
    "tStartMs": 658980,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "which laws apply,"
    } ]
  }, {
    "tStartMs": 660270,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and then send each broker a letter"
    } ]
  }, {
    "tStartMs": 662250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "with all the correct legal terms"
    } ]
  }, {
    "tStartMs": 664080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "requesting that your\ninformation be removed."
    } ]
  }, {
    "tStartMs": 666810,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "To see just how bad the problem is,"
    } ]
  }, {
    "tStartMs": 669030,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "here's the work Incogni\nhas done for me so far."
    } ]
  }, {
    "tStartMs": 672300,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Back in September, they\nhad filed 192 requests."
    } ]
  }, {
    "tStartMs": 675690,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Now, they've filed 260,"
    } ]
  }, {
    "tStartMs": 678120,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "which in total has saved\nme over 160 hours of work."
    } ]
  }, {
    "tStartMs": 682590,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, to try Incogni and\nfight the data brokers,"
    } ]
  }, {
    "tStartMs": 684930,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "visit incogni.com/veritasium."
    } ]
  }, {
    "tStartMs": 687780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "You can click the link in the description"
    } ]
  }, {
    "tStartMs": 689700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "or scan this QR code."
    } ]
  }, {
    "tStartMs": 691980,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And when you do, make sure\nto use the code veritasium"
    } ]
  }, {
    "tStartMs": 694410,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to get 60% off your annual subscription."
    } ]
  }, {
    "tStartMs": 696930,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So, head over to\nincogni.com/veritasium to get started."
    } ]
  }, {
    "tStartMs": 700650,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I wanna thank Incogni for\nsponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 703470,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "and now back to Strandbeests."
    } ]
  }, {
    "tStartMs": 706620,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "But if too much wind is a\nproblem, too little is as well."
    } ]
  }, {
    "tStartMs": 711150,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- So right now you can actually see"
    } ]
  }, {
    "tStartMs": 712530,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "one of the current fatal\nflaws of the Strandbeest."
    } ]
  }, {
    "tStartMs": 715560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They walk when there's wind,"
    } ]
  }, {
    "tStartMs": 717180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but as soon as the wind dies down,"
    } ]
  }, {
    "tStartMs": 719130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the animal basically dies down as well."
    } ]
  }, {
    "tStartMs": 721500,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And so this is one of the challenges"
    } ]
  }, {
    "tStartMs": 723090,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that Theo is actually\ntrying to solve right now."
    } ]
  }, {
    "tStartMs": 725730,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Ah, there it goes again."
    } ]
  }, {
    "tStartMs": 727470,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- [Derek] This is similar"
    } ]
  }, {
    "tStartMs": 728340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to a challenge that life too has faced."
    } ]
  }, {
    "tStartMs": 731370,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "See, you can't always rely"
    } ]
  }, {
    "tStartMs": 732870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "on the currents of the wind or water"
    } ]
  }, {
    "tStartMs": 734550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to take you where you need to go."
    } ]
  }, {
    "tStartMs": 736890,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "So what you want"
    } ]
  }, {
    "tStartMs": 737820,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "is to stock up on energy\nwhen it's plentiful,"
    } ]
  }, {
    "tStartMs": 740520,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "and then use it later when you need it."
    } ]
  }, {
    "tStartMs": 744240,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So you need two things,"
    } ]
  }, {
    "tStartMs": 746010,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "a way to store energy,"
    } ]
  }, {
    "tStartMs": 747510,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "and muscles that can\nuse this stored energy."
    } ]
  }, {
    "tStartMs": 751500,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Now, to collect energy,"
    } ]
  }, {
    "tStartMs": 752820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you've got this sail which\nis moved by the wind,"
    } ]
  }, {
    "tStartMs": 755820,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and as it moves, it turns this crankshaft,"
    } ]
  }, {
    "tStartMs": 758550,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "which then pushes this piston here,"
    } ]
  }, {
    "tStartMs": 760680,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and it can store pressurized\nair in this plastic bottle."
    } ]
  }, {
    "tStartMs": 764460,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Just like a bicycle pump."
    } ]
  }, {
    "tStartMs": 766200,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Casper] Do you know\nsort of what pressures"
    } ]
  }, {
    "tStartMs": 767490,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "it can go up to?"
    } ]
  }, {
    "tStartMs": 768323,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "- It went up to five yesterday."
    } ]
  }, {
    "tStartMs": 770670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So, quite a pressure."
    } ]
  }, {
    "tStartMs": 773070,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 773910,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- They explode when\nthere are 10 bars, yeah."
    } ]
  }, {
    "tStartMs": 776640,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Well, once I had a bottle,"
    } ]
  }, {
    "tStartMs": 778230,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and there was a a piston in there,"
    } ]
  }, {
    "tStartMs": 781020,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and it flew just next to my ear"
    } ]
  }, {
    "tStartMs": 785220,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "through the window on the\nback, so it broke the window."
    } ]
  }, {
    "tStartMs": 788670,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So that was quite a happening."
    } ]
  }, {
    "tStartMs": 791100,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 792450,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Holy."
    } ]
  }, {
    "tStartMs": 793620,
    "dDurationMs": 1588,
    "segs": [ {
      "utf8": "That's lucky."
    } ]
  }, {
    "tStartMs": 795208,
    "dDurationMs": 1745,
    "segs": [ {
      "utf8": "(chuckling) That's a close call."
    } ]
  }, {
    "tStartMs": 799200,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Derek] So, now that you\nhave a way to store energy,"
    } ]
  }, {
    "tStartMs": 801510,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "you just need a way to use it."
    } ]
  }, {
    "tStartMs": 803269,
    "dDurationMs": 2051,
    "segs": [ {
      "utf8": "(material rustling)"
    } ]
  }, {
    "tStartMs": 805320,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- And if you connect the\npressure with a pump like this,"
    } ]
  }, {
    "tStartMs": 809190,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "this jumps out."
    } ]
  }, {
    "tStartMs": 810690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So you have a sort of muscle."
    } ]
  }, {
    "tStartMs": 814140,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Muscle is nothing but an object"
    } ]
  }, {
    "tStartMs": 817050,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "which becomes longer\nor shorter on command."
    } ]
  }, {
    "tStartMs": 821610,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So, we have pulling muscles,"
    } ]
  }, {
    "tStartMs": 824640,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and the Strandbeest, we\nhave pushing muscles."
    } ]
  }, {
    "tStartMs": 828030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Derek] This has\nallowed some Strandbeests"
    } ]
  }, {
    "tStartMs": 829860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to crawl slightly,"
    } ]
  }, {
    "tStartMs": 831450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "others to walk by\npushing themselves along,"
    } ]
  }, {
    "tStartMs": 834240,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "and one to wag its tails."
    } ]
  }, {
    "tStartMs": 837960,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "One thing you might notice\nis that with each challenge,"
    } ]
  }, {
    "tStartMs": 841200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "the Strandbeests become more\nand more like real animals."
    } ]
  }, {
    "tStartMs": 845280,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It's as if their process is mimicking life"
    } ]
  }, {
    "tStartMs": 848490,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and following a similar\nevolutionary pattern."
    } ]
  }, {
    "tStartMs": 851460,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And in a way, this is true,"
    } ]
  }, {
    "tStartMs": 853380,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "because they have to overcome\nmany of the same challenges"
    } ]
  }, {
    "tStartMs": 856050,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that animals have had to."
    } ]
  }, {
    "tStartMs": 857730,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "And as life evolved,"
    } ]
  }, {
    "tStartMs": 858780,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "it became more and more\naware of its surroundings."
    } ]
  }, {
    "tStartMs": 862170,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And in at least one case,"
    } ]
  }, {
    "tStartMs": 864210,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "it became conscious and self-aware."
    } ]
  }, {
    "tStartMs": 867690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But right now, there is\nstill one big challenge"
    } ]
  }, {
    "tStartMs": 870000,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "the beests have to overcome."
    } ]
  }, {
    "tStartMs": 872370,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- 'Cause they're blind and deaf,"
    } ]
  }, {
    "tStartMs": 874560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "they don't hear very serious,"
    } ]
  }, {
    "tStartMs": 876120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "so imagine that you're blind and deaf,"
    } ]
  }, {
    "tStartMs": 878250,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you can only feel around somehow."
    } ]
  }, {
    "tStartMs": 880890,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So, one of the challenges\nthat the Strandbeests run into"
    } ]
  }, {
    "tStartMs": 883620,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "is that they're walking along the water,"
    } ]
  }, {
    "tStartMs": 886110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and if they accidentally\ngo in the wrong direction"
    } ]
  }, {
    "tStartMs": 888480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because they're being carried by the wind,"
    } ]
  }, {
    "tStartMs": 890610,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "then they could end up in the water,"
    } ]
  }, {
    "tStartMs": 892770,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and that would be disastrous."
    } ]
  }, {
    "tStartMs": 894630,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So to fix that, Theo has\nbeen working on a system"
    } ]
  }, {
    "tStartMs": 897510,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that can actually sense\nwhen it's touching the water"
    } ]
  }, {
    "tStartMs": 900660,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and then hopefully,"
    } ]
  }, {
    "tStartMs": 901890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "with a connection of\nbrain cells and muscles,"
    } ]
  }, {
    "tStartMs": 905010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "it can then course correct"
    } ]
  }, {
    "tStartMs": 906660,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to go away from the water\nback onto the beach."
    } ]
  }, {
    "tStartMs": 910110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- And of course it's important to know"
    } ]
  }, {
    "tStartMs": 912270,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that you're close to the sea, right?"
    } ]
  }, {
    "tStartMs": 914070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That's why I have a a water feeler here."
    } ]
  }, {
    "tStartMs": 917190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Oh, great, can you hold it here?"
    } ]
  }, {
    "tStartMs": 919440,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It goes over the ground about this height,"
    } ]
  }, {
    "tStartMs": 922260,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and it sucks in air all the time."
    } ]
  }, {
    "tStartMs": 925710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And as soon as it comes into the sea,"
    } ]
  }, {
    "tStartMs": 928230,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it swallows the water"
    } ]
  }, {
    "tStartMs": 929550,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "and feels the resistance of the water."
    } ]
  }, {
    "tStartMs": 932728,
    "dDurationMs": 3092,
    "segs": [ {
      "utf8": "(machine clicking)\nIt still doesn't work."
    } ]
  }, {
    "tStartMs": 935820,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "Well, I must regret-"
    } ]
  }, {
    "tStartMs": 938341,
    "dDurationMs": 1642,
    "segs": [ {
      "utf8": "(machine rattling)\nOh, now it's working."
    } ]
  }, {
    "tStartMs": 941806,
    "dDurationMs": 4484,
    "segs": [ {
      "utf8": "I'm so happy.\n(crew laughing)"
    } ]
  }, {
    "tStartMs": 946290,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] But those senses are only useful"
    } ]
  }, {
    "tStartMs": 947940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "if you can process those inputs,"
    } ]
  }, {
    "tStartMs": 949770,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "make a decision on what to do,"
    } ]
  }, {
    "tStartMs": 951630,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and then issue that to your muscles."
    } ]
  }, {
    "tStartMs": 954060,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Like, when you walk into the water,"
    } ]
  }, {
    "tStartMs": 955530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "you should be able to use your\nmuscles to correct course."
    } ]
  }, {
    "tStartMs": 958920,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So what you need is a nervous system,"
    } ]
  }, {
    "tStartMs": 961500,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "a sort of brain, if you will."
    } ]
  }, {
    "tStartMs": 964410,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- This is a nerve cell."
    } ]
  }, {
    "tStartMs": 966090,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If I take the top off"
    } ]
  }, {
    "tStartMs": 968730,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "and if I blow air in here,"
    } ]
  }, {
    "tStartMs": 973080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the air goes in here and comes outta here."
    } ]
  }, {
    "tStartMs": 976080,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So this is a connection."
    } ]
  }, {
    "tStartMs": 977910,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But if I push in this\npiston here, it's blocked."
    } ]
  }, {
    "tStartMs": 981690,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "So in fact, which you see\nhere is only a crank here,"
    } ]
  }, {
    "tStartMs": 986550,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "only a valve."
    } ]
  }, {
    "tStartMs": 987660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Open, close, right?"
    } ]
  }, {
    "tStartMs": 989580,
    "dDurationMs": 4563,
    "segs": [ {
      "utf8": "Now I go to operate the\ncrank here, this air."
    } ]
  }, {
    "tStartMs": 997200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So if I blow air in here,"
    } ]
  }, {
    "tStartMs": 999630,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "this closes, and no air comes outta here."
    } ]
  }, {
    "tStartMs": 1002810,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "If you see this as the output"
    } ]
  }, {
    "tStartMs": 1004250,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and this, the input,"
    } ]
  }, {
    "tStartMs": 1005630,
    "dDurationMs": 2491,
    "segs": [ {
      "utf8": "the output is opposite from the input."
    } ]
  }, {
    "tStartMs": 1008121,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(upbeat music)\n(graphics beeping)"
    } ]
  }, {
    "tStartMs": 1013730,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "In other words, you can\nswitch zeros and ones"
    } ]
  }, {
    "tStartMs": 1017240,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "just like in a computer."
    } ]
  }, {
    "tStartMs": 1025070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So what you see here"
    } ]
  }, {
    "tStartMs": 1026690,
    "dDurationMs": 4473,
    "segs": [ {
      "utf8": "is the beginning of the\nbrain of the Strandbeest."
    } ]
  }, {
    "tStartMs": 1034070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- Do you have an idea how\nmany brain cells you'd need"
    } ]
  }, {
    "tStartMs": 1036860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to be able to make that work"
    } ]
  }, {
    "tStartMs": 1038990,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "so the animal walks into the water"
    } ]
  }, {
    "tStartMs": 1041150,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "and is able to turn around?"
    } ]
  }, {
    "tStartMs": 1044081,
    "dDurationMs": 1659,
    "segs": [ {
      "utf8": "- 20, something like that."
    } ]
  }, {
    "tStartMs": 1045740,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 1046573,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1047406,
    "dDurationMs": 1188,
    "segs": [ {
      "utf8": "It's not very complicated."
    } ]
  }, {
    "tStartMs": 1048594,
    "dDurationMs": 956,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1049550,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- The only thing is, here on the beach,"
    } ]
  }, {
    "tStartMs": 1050900,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "everything is complicated,"
    } ]
  }, {
    "tStartMs": 1052640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "because sand creeps into everything"
    } ]
  }, {
    "tStartMs": 1055040,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "and so, yeah, it's not an easy thing, no."
    } ]
  }, {
    "tStartMs": 1059306,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 1060139,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "- [Derek] Over time, the\nbeests also slowly degrade."
    } ]
  }, {
    "tStartMs": 1063560,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "They lose their color,\nand parts might break off."
    } ]
  }, {
    "tStartMs": 1067250,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "On the scale of the global\nmicroplastic pollution problem,"
    } ]
  }, {
    "tStartMs": 1071090,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "this effect is small, but\nit's certainly not helping."
    } ]
  }, {
    "tStartMs": 1074750,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Fortunately though, almost\nall parts of the Strandbeests"
    } ]
  }, {
    "tStartMs": 1077630,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "are reused, sold as fossils,"
    } ]
  }, {
    "tStartMs": 1080300,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "or they end up in the graveyard."
    } ]
  }, {
    "tStartMs": 1084410,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It's crazy to think that all\nof this has been made possible"
    } ]
  }, {
    "tStartMs": 1086960,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "by the obsession of one guy"
    } ]
  }, {
    "tStartMs": 1088820,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "tinkering away year after year."
    } ]
  }, {
    "tStartMs": 1091550,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "But why did he do it?"
    } ]
  }, {
    "tStartMs": 1094520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "During the late 1980s,"
    } ]
  }, {
    "tStartMs": 1095960,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "it was becoming clear that\nrising levels of carbon dioxide"
    } ]
  }, {
    "tStartMs": 1098690,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "would warm the planet,"
    } ]
  }, {
    "tStartMs": 1100040,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and therefore sea levels would rise"
    } ]
  }, {
    "tStartMs": 1102110,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "by as much as 2.2 meters by 2100."
    } ]
  }, {
    "tStartMs": 1105590,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And about a third of Jansen's\nhome country, the Netherlands,"
    } ]
  }, {
    "tStartMs": 1109160,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "lies below the current sea level,"
    } ]
  }, {
    "tStartMs": 1111890,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "so rising sea levels pose\na clear and present threat."
    } ]
  }, {
    "tStartMs": 1117020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So Jansen came up with a solution."
    } ]
  }, {
    "tStartMs": 1119090,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "He imagined this sort of\nwalking skeleton on the beach."
    } ]
  }, {
    "tStartMs": 1123140,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "It would be powered by the wind,"
    } ]
  }, {
    "tStartMs": 1124610,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and it would kick up sand as it walked."
    } ]
  }, {
    "tStartMs": 1127220,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Then this sand would blow to the dunes,"
    } ]
  }, {
    "tStartMs": 1130070,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "heightening them and hence\nprotecting the Netherlands"
    } ]
  }, {
    "tStartMs": 1132920,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "from the rising sea levels."
    } ]
  }, {
    "tStartMs": 1134660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "He published this idea in de Volkskrant"
    } ]
  }, {
    "tStartMs": 1137300,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and called these skeletons Strandbeests."
    } ]
  }, {
    "tStartMs": 1140960,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "I don't speak Dutch."
    } ]
  }, {
    "tStartMs": 1142823,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "Strandbeest."
    } ]
  }, {
    "tStartMs": 1144470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Is it the beach beast?"
    } ]
  }, {
    "tStartMs": 1146240,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Like, what is that?"
    } ]
  }, {
    "tStartMs": 1147200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, perfect."
    } ]
  }, {
    "tStartMs": 1148033,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "It's the beach beast."
    } ]
  }, {
    "tStartMs": 1148883,
    "dDurationMs": 2787,
    "segs": [ {
      "utf8": "- (laughs) This is such a wacky idea."
    } ]
  }, {
    "tStartMs": 1151670,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- I know."
    } ]
  }, {
    "tStartMs": 1152540,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "- Who comes up with that?"
    } ]
  }, {
    "tStartMs": 1154410,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "- Theo Jansen."
    } ]
  }, {
    "tStartMs": 1156200,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Derek] What started as\nan article in a newspaper"
    } ]
  }, {
    "tStartMs": 1158540,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "turned into much more,"
    } ]
  }, {
    "tStartMs": 1160010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "to the point where it's\nbasically defined Jansen's life."
    } ]
  }, {
    "tStartMs": 1163220,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "So you might ask,"
    } ]
  }, {
    "tStartMs": 1164300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "is it still really about\nprotecting the Netherlands?"
    } ]
  }, {
    "tStartMs": 1166820,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And the answer is no, not really."
    } ]
  }, {
    "tStartMs": 1170240,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It's about a much more human need"
    } ]
  }, {
    "tStartMs": 1172550,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that most of us have,"
    } ]
  }, {
    "tStartMs": 1173990,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "the desire to be remembered\nafter we're gone."
    } ]
  }, {
    "tStartMs": 1177200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I mean, it's ominous to\nimagine that we'll die"
    } ]
  }, {
    "tStartMs": 1179480,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and be forgotten someday,"
    } ]
  }, {
    "tStartMs": 1180860,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "so a lot of us go to great\nlengths to avoid this"
    } ]
  }, {
    "tStartMs": 1184100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "by having kids donating\nlarge sums of money"
    } ]
  }, {
    "tStartMs": 1187040,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to get a building named after you,"
    } ]
  }, {
    "tStartMs": 1188660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "or writing a book, these sorts of ideas."
    } ]
  }, {
    "tStartMs": 1191510,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "For Jansen, it's making Strandbeests."
    } ]
  }, {
    "tStartMs": 1194720,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And when they fulfill their final goal"
    } ]
  }, {
    "tStartMs": 1197030,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of living independently on the beach,"
    } ]
  }, {
    "tStartMs": 1199370,
    "dDurationMs": 3657,
    "segs": [ {
      "utf8": "then, he wrote, \"I can\ndie with peace of mind.\""
    } ]
  }, {
    "tStartMs": 1204770,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The only thing is, I don't\nhave millions of years."
    } ]
  }, {
    "tStartMs": 1207230,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "There's the problem a bit."
    } ]
  }, {
    "tStartMs": 1209960,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But maybe I can hypnotize\nsome young people around here."
    } ]
  }, {
    "tStartMs": 1213410,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "There were some people who\nwere really very, very nice,"
    } ]
  }, {
    "tStartMs": 1218150,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and they help me a lot,"
    } ]
  }, {
    "tStartMs": 1219680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "so I might be able"
    } ]
  }, {
    "tStartMs": 1222320,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "to infect them with this Strandbeest virus"
    } ]
  }, {
    "tStartMs": 1227120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Because people all over the world"
    } ]
  }, {
    "tStartMs": 1228620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "are actually using this as well,"
    } ]
  }, {
    "tStartMs": 1230300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so, like, the virus is\nspreading, in a way,"
    } ]
  }, {
    "tStartMs": 1233300,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "or whatever you want to call it."
    } ]
  }, {
    "tStartMs": 1235010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] Thousands of\npeople all over the world"
    } ]
  }, {
    "tStartMs": 1236930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are incorporating his 13 holy numbers"
    } ]
  }, {
    "tStartMs": 1239450,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "into their own designs."
    } ]
  }, {
    "tStartMs": 1241040,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "From miniature Strandbeests,\nto ones you can ride,"
    } ]
  }, {
    "tStartMs": 1244100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to a walking bicycle."
    } ]
  }, {
    "tStartMs": 1245930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The genetic code of the beests"
    } ]
  }, {
    "tStartMs": 1247640,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "is spreading all over the world."
    } ]
  }, {
    "tStartMs": 1250130,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- He wants everyone to build one of these,"
    } ]
  }, {
    "tStartMs": 1253820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "but I don't think he's\ngot any ulterior motive"
    } ]
  }, {
    "tStartMs": 1255560,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "except that he likes\nseeing those things go."
    } ]
  }, {
    "tStartMs": 1258110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And when he makes them go,"
    } ]
  }, {
    "tStartMs": 1259610,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "he has a set of rules and restrictions,"
    } ]
  }, {
    "tStartMs": 1261740,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but he doesn't place those same\nrestrictions on anyone else."
    } ]
  }, {
    "tStartMs": 1264320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I think that's really beautiful."
    } ]
  }, {
    "tStartMs": 1265910,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- And who knows,"
    } ]
  }, {
    "tStartMs": 1266960,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "perhaps one day they'll\nachieve that ultimate goal."
    } ]
  }, {
    "tStartMs": 1269750,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "A new species on earth,"
    } ]
  }, {
    "tStartMs": 1271490,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "roaming the world's beaches,"
    } ]
  }, {
    "tStartMs": 1272900,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "kicking up sand all along,"
    } ]
  }, {
    "tStartMs": 1275210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and maybe even protecting some coastlines"
    } ]
  }, {
    "tStartMs": 1277880,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "from rising sea levels."
    } ]
  }, {
    "tStartMs": 1279381,
    "dDurationMs": 1818,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 1281199,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "(graphic beeping)"
    } ]
  }, {
    "tStartMs": 1282429,
    "dDurationMs": 3814,
    "segs": [ {
      "utf8": "♪ It's Strandbeest\ndriving through the sand ♪"
    } ]
  }, {
    "tStartMs": 1286243,
    "dDurationMs": 3937,
    "segs": [ {
      "utf8": "♪ Legs moving like a marching band ♪"
    } ]
  }, {
    "tStartMs": 1290180,
    "dDurationMs": 1951,
    "segs": [ {
      "utf8": "♪ Strandbeest, strandbeest ♪"
    } ]
  }, {
    "tStartMs": 1292131,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "♪ Voices chant and never cease ♪"
    } ]
  }, {
    "tStartMs": 1294141,
    "dDurationMs": 1937,
    "segs": [ {
      "utf8": "♪ Strandbeest, strandbeest ♪"
    } ]
  }, {
    "tStartMs": 1296078,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "♪ Marching to the rhythm's beat ♪"
    } ]
  } ]
}
