{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 140,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- In 1999, the German newspaper \"Die Zeit\""
    } ]
  }, {
    "tStartMs": 3060,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "ran an experiment."
    } ]
  }, {
    "tStartMs": 4500,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "They asked a falafel salesman"
    } ]
  }, {
    "tStartMs": 6450,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and former theater director,"
    } ]
  }, {
    "tStartMs": 7920,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Salah ben Ghaly,"
    } ]
  }, {
    "tStartMs": 9090,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "who in the world he would\nmost like to be connected to."
    } ]
  }, {
    "tStartMs": 12450,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "He chose his favorite\nactor, Marlon Brando."
    } ]
  }, {
    "tStartMs": 15570,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So the reporters then searched\nfor a chain of friends,"
    } ]
  }, {
    "tStartMs": 18720,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "family or acquaintances,"
    } ]
  }, {
    "tStartMs": 20250,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "people who knew each other"
    } ]
  }, {
    "tStartMs": 21360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "on a first name basis,"
    } ]
  }, {
    "tStartMs": 22620,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "who could connect ben Ghaly to Brando."
    } ]
  }, {
    "tStartMs": 25470,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "As it happens, ben Ghaly\nhad a friend in California."
    } ]
  }, {
    "tStartMs": 28620,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "This friend worked alongside\nthe boyfriend of a woman"
    } ]
  }, {
    "tStartMs": 31950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "who was the sorority sister"
    } ]
  }, {
    "tStartMs": 33450,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "of the daughter of the producer"
    } ]
  }, {
    "tStartMs": 35100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "of the film \"Don Juan DeMarco,\""
    } ]
  }, {
    "tStartMs": 37200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "starring Marlon Brando."
    } ]
  }, {
    "tStartMs": 39420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So in total, it took just six steps,"
    } ]
  }, {
    "tStartMs": 41910,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "six degrees of separation."
    } ]
  }, {
    "tStartMs": 44010,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And the idea is that this\nis not a unique example,"
    } ]
  }, {
    "tStartMs": 47070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that you could connect any\ntwo people on the planet"
    } ]
  }, {
    "tStartMs": 49590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "in six steps or less."
    } ]
  }, {
    "tStartMs": 51660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But is it really true?"
    } ]
  }, {
    "tStartMs": 53400,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And if it is,"
    } ]
  }, {
    "tStartMs": 54720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "how does it affect our lives?"
    } ]
  }, {
    "tStartMs": 57240,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- How is this possible"
    } ]
  }, {
    "tStartMs": 58110,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "in a world of now eight billion people"
    } ]
  }, {
    "tStartMs": 60660,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that we could be that close,"
    } ]
  }, {
    "tStartMs": 61980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "just six hops or less?"
    } ]
  }, {
    "tStartMs": 63630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Does that affect how diseases spread,"
    } ]
  }, {
    "tStartMs": 65640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "how information travels?"
    } ]
  }, {
    "tStartMs": 67560,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Our math showed, the question\nis not why is the world small,"
    } ]
  }, {
    "tStartMs": 70560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it's really how could it be otherwise?"
    } ]
  }, {
    "tStartMs": 72630,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "But then I got a call from the FBI."
    } ]
  }, {
    "tStartMs": 76710,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "We are making the world\nsmaller all the time."
    } ]
  }, {
    "tStartMs": 79650,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Like it's supposed to be good,"
    } ]
  }, {
    "tStartMs": 80880,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and yet it does expose you\nto toxicity and malevolence"
    } ]
  }, {
    "tStartMs": 84120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that you might've been shielded from."
    } ]
  }, {
    "tStartMs": 85860,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- You look at the net effect of it,"
    } ]
  }, {
    "tStartMs": 87660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and it's actually been pretty negative"
    } ]
  }, {
    "tStartMs": 89580,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "by a lot of measures."
    } ]
  }, {
    "tStartMs": 90900,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "People have suffered."
    } ]
  }, {
    "tStartMs": 92370,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- It's not only dangerous"
    } ]
  }, {
    "tStartMs": 93780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in terms of disease propagation,"
    } ]
  }, {
    "tStartMs": 95760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but anything malevolent"
    } ]
  }, {
    "tStartMs": 98160,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "now has conduits that\nit didn't used to have."
    } ]
  }, {
    "tStartMs": 102240,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- If we were all connected"
    } ]
  }, {
    "tStartMs": 103620,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to everyone else on the planet"
    } ]
  }, {
    "tStartMs": 105180,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "completely at random,"
    } ]
  }, {
    "tStartMs": 107070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "then it would be almost\na mathematical certainty"
    } ]
  }, {
    "tStartMs": 109860,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that any two of us would be connected"
    } ]
  }, {
    "tStartMs": 112020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "through fewer than six steps."
    } ]
  }, {
    "tStartMs": 114270,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Let's suppose I have my 100 friends"
    } ]
  }, {
    "tStartMs": 116130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "out of eight billion people."
    } ]
  }, {
    "tStartMs": 118260,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Each of them knows 100 people."
    } ]
  }, {
    "tStartMs": 120480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So two steps away from me"
    } ]
  }, {
    "tStartMs": 122610,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "is gonna encompass 100 times 100 people."
    } ]
  }, {
    "tStartMs": 126210,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "That's already 10-to-the-fourth people."
    } ]
  }, {
    "tStartMs": 128400,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And so if you do 100 to the fifth power,"
    } ]
  }, {
    "tStartMs": 132120,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that's 10 to the 10th,"
    } ]
  }, {
    "tStartMs": 133710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and that's more people\nthan there are on Earth."
    } ]
  }, {
    "tStartMs": 136380,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So notice that number is five,"
    } ]
  }, {
    "tStartMs": 138450,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "I said, \"To the fifth power.\""
    } ]
  }, {
    "tStartMs": 139830,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's the ballpark reason"
    } ]
  }, {
    "tStartMs": 141270,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "why six degrees (laughing)\nof separation is true."
    } ]
  }, {
    "tStartMs": 144930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- But the shocking thing about this is,"
    } ]
  }, {
    "tStartMs": 146610,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the calculation you've just outlined"
    } ]
  }, {
    "tStartMs": 149190,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "is about having 100 friends\nat random out of 10 billion"
    } ]
  }, {
    "tStartMs": 153870,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and they're all over the world,"
    } ]
  }, {
    "tStartMs": 155370,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but we know that in the real world,"
    } ]
  }, {
    "tStartMs": 157920,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "that's nowhere near"
    } ]
  }, {
    "tStartMs": 158910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "what the distribution of friends are like."
    } ]
  }, {
    "tStartMs": 161040,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- Yeah, absolutely true."
    } ]
  }, {
    "tStartMs": 161910,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So this really crude\ncalculation I did is absurd,"
    } ]
  }, {
    "tStartMs": 165540,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "for the reason that you said."
    } ]
  }, {
    "tStartMs": 166890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The world is very far from random."
    } ]
  }, {
    "tStartMs": 168990,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- The truth is people naturally\ncluster geographically."
    } ]
  }, {
    "tStartMs": 172140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Most of the people you\nknow live close to you,"
    } ]
  }, {
    "tStartMs": 174300,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and they also have a higher probability"
    } ]
  }, {
    "tStartMs": 176220,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of knowing each other."
    } ]
  }, {
    "tStartMs": 177810,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If you calculate the\nfraction of people you know"
    } ]
  }, {
    "tStartMs": 180150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "who also know each other,"
    } ]
  }, {
    "tStartMs": 181770,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that is a measure of the\nclustering in the network."
    } ]
  }, {
    "tStartMs": 184890,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So let's try a model with a\nhigh degree of clustering."
    } ]
  }, {
    "tStartMs": 188610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Imagine all eight billion people on Earth"
    } ]
  }, {
    "tStartMs": 191010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "are arranged into a circle,"
    } ]
  }, {
    "tStartMs": 193110,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and say each person knows the\n100 people closest to them."
    } ]
  }, {
    "tStartMs": 196590,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So 50 to the left and 50 to the right."
    } ]
  }, {
    "tStartMs": 199050,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Well, in this case,"
    } ]
  }, {
    "tStartMs": 200220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the furthest person you can connect to"
    } ]
  }, {
    "tStartMs": 202140,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "is just 50 people away."
    } ]
  }, {
    "tStartMs": 203970,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So if you wanted to connect to someone"
    } ]
  }, {
    "tStartMs": 205680,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "on the other side of the planet"
    } ]
  }, {
    "tStartMs": 207090,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "through a chain of people\nwho know each other,"
    } ]
  }, {
    "tStartMs": 209400,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "well, it would take 80 million steps,"
    } ]
  }, {
    "tStartMs": 212370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and to connect any two people"
    } ]
  }, {
    "tStartMs": 213810,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "would take on average 40 million steps."
    } ]
  }, {
    "tStartMs": 217080,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Even just getting 10% to the way there"
    } ]
  }, {
    "tStartMs": 219120,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "would take eight million steps."
    } ]
  }, {
    "tStartMs": 221130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And six steps would get you,"
    } ]
  }, {
    "tStartMs": 223350,
    "dDurationMs": 1329,
    "segs": [ {
      "utf8": "well, here."
    } ]
  }, {
    "tStartMs": 224679,
    "dDurationMs": 1071,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 225750,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This is the paradox of\nsix degrees of separation."
    } ]
  }, {
    "tStartMs": 228990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "We know that we live\nin these local clusters"
    } ]
  }, {
    "tStartMs": 231540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of friends and acquaintances,"
    } ]
  }, {
    "tStartMs": 233130,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "but we also seem to be able"
    } ]
  }, {
    "tStartMs": 234720,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to connect anyone anywhere\nin just six steps."
    } ]
  }, {
    "tStartMs": 237990,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "10 years ago, I did my\nown experiment on this,"
    } ]
  }, {
    "tStartMs": 240210,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and I found that the\naverage Veritasium viewer"
    } ]
  }, {
    "tStartMs": 242910,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "was only 2.7 degrees\nof separation from me."
    } ]
  }, {
    "tStartMs": 247260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "In social science,"
    } ]
  }, {
    "tStartMs": 248340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "this is known as the small-world problem,"
    } ]
  }, {
    "tStartMs": 251220,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "named after the phenomenon"
    } ]
  }, {
    "tStartMs": 252360,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "where you're say on holiday somewhere"
    } ]
  }, {
    "tStartMs": 254640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and you bump into a stranger"
    } ]
  }, {
    "tStartMs": 256140,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "who somehow knows your best friend,"
    } ]
  }, {
    "tStartMs": 258540,
    "dDurationMs": 4089,
    "segs": [ {
      "utf8": "and you say, \"Wow, it's\nsuch a small world.\""
    } ]
  }, {
    "tStartMs": 262629,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 263790,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "In the mid-1990s, two mathematicians,"
    } ]
  }, {
    "tStartMs": 266100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Duncan Watts and Steve Strogatz,"
    } ]
  }, {
    "tStartMs": 267720,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "set out to solve this small-world problem."
    } ]
  }, {
    "tStartMs": 270750,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- Duncan really sort of had\nvery far-seeing imagination"
    } ]
  }, {
    "tStartMs": 274830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "at that point."
    } ]
  }, {
    "tStartMs": 275663,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "- We had computers that allowed us"
    } ]
  }, {
    "tStartMs": 277560,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to simulate environments"
    } ]
  }, {
    "tStartMs": 279210,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "that were too complicated\nfor for math to work."
    } ]
  }, {
    "tStartMs": 282930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] Up until then,\nphysicists had studied networks"
    } ]
  }, {
    "tStartMs": 285360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that were ordered and regular,"
    } ]
  }, {
    "tStartMs": 286800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "like crystal lattices."
    } ]
  }, {
    "tStartMs": 288420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And mathematicians, like Paul Erdos,"
    } ]
  }, {
    "tStartMs": 290490,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "had done lots of work"
    } ]
  }, {
    "tStartMs": 291570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "on totally random networks,"
    } ]
  }, {
    "tStartMs": 293640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but no one had studied\nwhat happens in between."
    } ]
  }, {
    "tStartMs": 296640,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- There must be some\nenormous middle ground,"
    } ]
  }, {
    "tStartMs": 299070,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and that's what Duncan and I felt like"
    } ]
  }, {
    "tStartMs": 300570,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "we're starting to explore."
    } ]
  }, {
    "tStartMs": 302850,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] To study this middle ground,"
    } ]
  }, {
    "tStartMs": 304350,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Watts and Strogatz imagined"
    } ]
  }, {
    "tStartMs": 305760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "a simple regular network of people,"
    } ]
  }, {
    "tStartMs": 307890,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "or nodes,"
    } ]
  }, {
    "tStartMs": 308970,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "dotted around a circle,"
    } ]
  }, {
    "tStartMs": 310470,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "each connected to a few of\ntheir nearest neighbors."
    } ]
  }, {
    "tStartMs": 313590,
    "dDurationMs": 937,
    "segs": [ {
      "utf8": "- And so we had this idea,"
    } ]
  }, {
    "tStartMs": 314527,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "\"We're gonna start with the\nphysicist end of regular,"
    } ]
  }, {
    "tStartMs": 317370,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and now we're gonna\nturn the randomness knob"
    } ]
  }, {
    "tStartMs": 320130,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to make it more and more random"
    } ]
  }, {
    "tStartMs": 321450,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "through these random shortcuts.\""
    } ]
  }, {
    "tStartMs": 323550,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- [Derek] We all have some\nexperience with shortcuts."
    } ]
  }, {
    "tStartMs": 326640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- I belonged to this club\ncalled the Internet Chess Club."
    } ]
  }, {
    "tStartMs": 329700,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I got to be very friendly\nwith a guy in Holland."
    } ]
  }, {
    "tStartMs": 332430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "That connection makes the world small,"
    } ]
  }, {
    "tStartMs": 334860,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "because now, even though my\nfriends don't realize it,"
    } ]
  }, {
    "tStartMs": 338070,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "they're only one step away\nfrom a guy in Holland."
    } ]
  }, {
    "tStartMs": 341670,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And so that kind of connection"
    } ]
  }, {
    "tStartMs": 343710,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "where you sort of connect to someone"
    } ]
  }, {
    "tStartMs": 345360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "outside your normal circle"
    } ]
  }, {
    "tStartMs": 347310,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "is what we came to call a shortcut."
    } ]
  }, {
    "tStartMs": 350100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] So they went round the circle,"
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "disconnecting some of the links"
    } ]
  }, {
    "tStartMs": 353130,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and reconnecting them at random"
    } ]
  }, {
    "tStartMs": 355050,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to a different node in the network."
    } ]
  }, {
    "tStartMs": 357180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And as they did that,"
    } ]
  }, {
    "tStartMs": 358380,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "they watched what happened"
    } ]
  }, {
    "tStartMs": 359610,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to the average number of steps it took"
    } ]
  }, {
    "tStartMs": 361530,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to get from any one node\nin the network to another,"
    } ]
  }, {
    "tStartMs": 364980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "hopping between connected nodes."
    } ]
  }, {
    "tStartMs": 367140,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "In other words, the degree of separation."
    } ]
  }, {
    "tStartMs": 369990,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- This is now the moment\nfor the big reveal."
    } ]
  }, {
    "tStartMs": 372120,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "As Duncan turned the knob\nin his computer simulations,"
    } ]
  }, {
    "tStartMs": 375390,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "as soon as he introduced a few shortcuts,"
    } ]
  }, {
    "tStartMs": 378990,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "the world immediately gets\nas small as a random graph."
    } ]
  }, {
    "tStartMs": 382530,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Derek] When they had rewired"
    } ]
  }, {
    "tStartMs": 383550,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "just 1% of the links to shortcuts,"
    } ]
  }, {
    "tStartMs": 385680,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the average degree of separation"
    } ]
  }, {
    "tStartMs": 387390,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "dropped from 50 in the\noriginal fully ordered network"
    } ]
  }, {
    "tStartMs": 390360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to 10."
    } ]
  }, {
    "tStartMs": 391860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But Watts and Strogatz also tracked"
    } ]
  }, {
    "tStartMs": 393360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "how clustered the network was."
    } ]
  }, {
    "tStartMs": 395460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "That's the fraction of\na node's connections"
    } ]
  }, {
    "tStartMs": 397350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that are also connected to each other,"
    } ]
  }, {
    "tStartMs": 399600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or in other words, the\nfraction of my friends"
    } ]
  }, {
    "tStartMs": 401760,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "who are also friends with each other."
    } ]
  }, {
    "tStartMs": 404190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "What they found is that clustering"
    } ]
  }, {
    "tStartMs": 406440,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "remained high for much longer."
    } ]
  }, {
    "tStartMs": 410040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- The world immediately gets\nas small as a random graph,"
    } ]
  }, {
    "tStartMs": 413760,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "but it stays as clustered"
    } ]
  }, {
    "tStartMs": 415350,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "as if it were still regular."
    } ]
  }, {
    "tStartMs": 417330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So you could simultaneously"
    } ]
  }, {
    "tStartMs": 418800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "have the clustering that we know is real"
    } ]
  }, {
    "tStartMs": 421440,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "and the small world that we know is real."
    } ]
  }, {
    "tStartMs": 424980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Now, in Watts and Strogatz's model,"
    } ]
  }, {
    "tStartMs": 427020,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "they looked at 1,000 nodes,"
    } ]
  }, {
    "tStartMs": 429000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "but if you apply their model"
    } ]
  }, {
    "tStartMs": 430230,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to the eight billion people on Earth,"
    } ]
  }, {
    "tStartMs": 432630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "well, then you would only need three"
    } ]
  }, {
    "tStartMs": 435180,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "out of every 10,000\nfriendships to be a shortcut,"
    } ]
  }, {
    "tStartMs": 437970,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and the average degrees of\nseparation drops to six."
    } ]
  }, {
    "tStartMs": 441630,
    "dDurationMs": 1495,
    "segs": [ {
      "utf8": "- Our math showed,"
    } ]
  }, {
    "tStartMs": 443125,
    "dDurationMs": 2255,
    "segs": [ {
      "utf8": "the question is not\nwhy is the world small,"
    } ]
  }, {
    "tStartMs": 445380,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "it's really how could it be otherwise?"
    } ]
  }, {
    "tStartMs": 447630,
    "dDurationMs": 1447,
    "segs": [ {
      "utf8": "Duncan started saying to me,"
    } ]
  }, {
    "tStartMs": 449077,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "\"This is about discovering\na whole new universe,"
    } ]
  }, {
    "tStartMs": 451920,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "and its properties and laws.\""
    } ]
  }, {
    "tStartMs": 454950,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I recognized that he was right."
    } ]
  }, {
    "tStartMs": 458130,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- I just wanted to sort of reflect"
    } ]
  }, {
    "tStartMs": 460290,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "on what you said about\nthese sort of shortcuts."
    } ]
  }, {
    "tStartMs": 464040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I think I've had this\nphenomenon happen to me"
    } ]
  }, {
    "tStartMs": 466590,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "sometimes in my life"
    } ]
  }, {
    "tStartMs": 468180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "where I'm sort of invited to an event"
    } ]
  }, {
    "tStartMs": 470430,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and it seems like a very random event."
    } ]
  }, {
    "tStartMs": 472500,
    "dDurationMs": 952,
    "segs": [ {
      "utf8": "Often I kind of feel like,"
    } ]
  }, {
    "tStartMs": 473452,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "(sighing) \"I don't really wanna go.\""
    } ]
  }, {
    "tStartMs": 475041,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "(Steven laughing)\n\"You know, none of my friends"
    } ]
  }, {
    "tStartMs": 475920,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "are going.\""
    } ]
  }, {
    "tStartMs": 477510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But then, maybe at the last minute,"
    } ]
  }, {
    "tStartMs": 479340,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "I just say like, \"Well,\nlet's just roll the dice.\""
    } ]
  }, {
    "tStartMs": 481830,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And I find that almost invariably"
    } ]
  }, {
    "tStartMs": 484230,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "those are productive meetings."
    } ]
  }, {
    "tStartMs": 487830,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "I'm kind of wondering if there's\na takeaway for people here,"
    } ]
  }, {
    "tStartMs": 490740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "which is that they should\nput themselves in situations"
    } ]
  }, {
    "tStartMs": 493710,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "where the probability of\nforming these shortcut links,"
    } ]
  }, {
    "tStartMs": 496950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "would it sort of increase\nthe luck in your life?"
    } ]
  }, {
    "tStartMs": 499860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- You have just put your finger"
    } ]
  }, {
    "tStartMs": 502080,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "on a very famous phenomenon in sociology"
    } ]
  }, {
    "tStartMs": 505110,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that is called the strength of weak ties."
    } ]
  }, {
    "tStartMs": 507300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "'Cause you ask people\nhow they got their job,"
    } ]
  }, {
    "tStartMs": 509760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and people would say, \"Oh yeah,"
    } ]
  }, {
    "tStartMs": 511560,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I heard about it from, you know, Randy.\""
    } ]
  }, {
    "tStartMs": 514830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And then he'd say, \"Oh, is\nRandy a friend of yours?\""
    } ]
  }, {
    "tStartMs": 516750,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "and people invariably would say,"
    } ]
  }, {
    "tStartMs": 518047,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "\"No, he's an acquaintance."
    } ]
  }, {
    "tStartMs": 519810,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "I wouldn't call him a friend,"
    } ]
  }, {
    "tStartMs": 520860,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "he's an acquaintance.\""
    } ]
  }, {
    "tStartMs": 522210,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "That's a weak tie."
    } ]
  }, {
    "tStartMs": 523590,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The strong tie is your best friend"
    } ]
  }, {
    "tStartMs": 525180,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "or your circle of friends."
    } ]
  }, {
    "tStartMs": 527580,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] Excited about\ntheir breakthrough,"
    } ]
  }, {
    "tStartMs": 529170,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Watts and Strogatz wanted to\ntest their small-world model"
    } ]
  }, {
    "tStartMs": 532740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "on some real-world data,"
    } ]
  }, {
    "tStartMs": 534720,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but this was 1996."
    } ]
  }, {
    "tStartMs": 537150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Steven] We had to think,"
    } ]
  }, {
    "tStartMs": 537983,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "\"Well, where are we gonna get data"
    } ]
  }, {
    "tStartMs": 539280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "on big networks where we could test this?\""
    } ]
  }, {
    "tStartMs": 541800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And it was not so easy,"
    } ]
  }, {
    "tStartMs": 543300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the internet was not mapped out,"
    } ]
  }, {
    "tStartMs": 545520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Google didn't exist."
    } ]
  }, {
    "tStartMs": 547350,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- [Derek] So they turned\nto an unusual source."
    } ]
  }, {
    "tStartMs": 550350,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Steven] There was\nonly one nervous system"
    } ]
  }, {
    "tStartMs": 551700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that had been mapped at that time,"
    } ]
  }, {
    "tStartMs": 553770,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "which was the worm, C. elegans."
    } ]
  }, {
    "tStartMs": 557010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Tiny worm, like a millimeter,"
    } ]
  }, {
    "tStartMs": 558870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that you can find in the dirt."
    } ]
  }, {
    "tStartMs": 560550,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "A favorite of neurobiologists."
    } ]
  }, {
    "tStartMs": 563460,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "They knew every cell in\nthe body of C. elegans"
    } ]
  }, {
    "tStartMs": 566340,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "from the time it's a single cell"
    } ]
  }, {
    "tStartMs": 567690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "'til it becomes a whole organism."
    } ]
  }, {
    "tStartMs": 569520,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "So they had the total wiring\ndiagram of that organism."
    } ]
  }, {
    "tStartMs": 573390,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] Watts and\nStrogatz tested their model"
    } ]
  }, {
    "tStartMs": 575070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "on the worm's neural network."
    } ]
  }, {
    "tStartMs": 576660,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "The worm has precisely 282 neurons,"
    } ]
  }, {
    "tStartMs": 579690,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and on average, they're\nconnected to 14 others."
    } ]
  }, {
    "tStartMs": 582720,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "If you lay that all out in a line"
    } ]
  }, {
    "tStartMs": 584910,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "along the worm's body,"
    } ]
  }, {
    "tStartMs": 586080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the neurons at the ends"
    } ]
  }, {
    "tStartMs": 587940,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "would be separated by around 40 steps,"
    } ]
  }, {
    "tStartMs": 590640,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and the average degree of separation"
    } ]
  }, {
    "tStartMs": 592350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "would be around 14."
    } ]
  }, {
    "tStartMs": 594360,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But when Watts and Strogatz\nran the calculations,"
    } ]
  }, {
    "tStartMs": 596790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "they found the average\ndegrees of separation"
    } ]
  }, {
    "tStartMs": 598650,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "between any two neurons was just 2.65."
    } ]
  }, {
    "tStartMs": 601920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "To put that in context,"
    } ]
  }, {
    "tStartMs": 603210,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "if they were connected totally at random,"
    } ]
  }, {
    "tStartMs": 605130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "it would be 2.25."
    } ]
  }, {
    "tStartMs": 607260,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Steven] And yes, okay, so bingo,"
    } ]
  }, {
    "tStartMs": 608550,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "that was a small world."
    } ]
  }, {
    "tStartMs": 609420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Then we were popping the champagne."
    } ]
  }, {
    "tStartMs": 610830,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I mean, that was really exciting"
    } ]
  }, {
    "tStartMs": 612450,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that nature had done that."
    } ]
  }, {
    "tStartMs": 613920,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So then we thought, \"Well, okay,"
    } ]
  }, {
    "tStartMs": 615900,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but this should be true\nof lots of networks"
    } ]
  }, {
    "tStartMs": 617730,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "because nature can't\nresist this mechanism.\""
    } ]
  }, {
    "tStartMs": 620760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Derek] So they looked\nat Hollywood actors"
    } ]
  }, {
    "tStartMs": 622560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and power grids across the US."
    } ]
  }, {
    "tStartMs": 624720,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Sure enough, they were\nboth small-world networks."
    } ]
  }, {
    "tStartMs": 627750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "For example, in the database"
    } ]
  }, {
    "tStartMs": 629100,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of over 200,000 Hollywood actors,"
    } ]
  }, {
    "tStartMs": 631410,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "the average degree of\nseparation was less than four."
    } ]
  }, {
    "tStartMs": 635850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Dangerfield was in \"Caddy Shack\""
    } ]
  }, {
    "tStartMs": 637950,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "with Bill Murray,"
    } ]
  }, {
    "tStartMs": 638940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and Bill Murray was in\n\"She's Having a Baby\""
    } ]
  }, {
    "tStartMs": 641070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with Kevin Bacon."
    } ]
  }, {
    "tStartMs": 642780,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Steven] Then the real payoff for us,"
    } ]
  }, {
    "tStartMs": 644100,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "as people interested in dynamical systems"
    } ]
  }, {
    "tStartMs": 646710,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "more than graph theory,"
    } ]
  }, {
    "tStartMs": 647700,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "was, \"Okay, so what?"
    } ]
  }, {
    "tStartMs": 650490,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "You know, so what if the world is small?"
    } ]
  }, {
    "tStartMs": 652050,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Does that affect how things get in sync?"
    } ]
  }, {
    "tStartMs": 654930,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Does it affect how diseases spread?"
    } ]
  }, {
    "tStartMs": 657030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Does it affect how information travels?"
    } ]
  }, {
    "tStartMs": 659520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Whatever.\""
    } ]
  }, {
    "tStartMs": 660353,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "And so we did a number of experiments,"
    } ]
  }, {
    "tStartMs": 662370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "again, in the computer, like that."
    } ]
  }, {
    "tStartMs": 665040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] Take disease."
    } ]
  }, {
    "tStartMs": 666390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I wanted to know how a few shortcuts"
    } ]
  }, {
    "tStartMs": 668430,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "would affect how disease\nspreads through a network."
    } ]
  }, {
    "tStartMs": 671220,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So I asked Casper and the team"
    } ]
  }, {
    "tStartMs": 672630,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to make a simulation."
    } ]
  }, {
    "tStartMs": 674130,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Casper] And then\nthe question to you is,"
    } ]
  }, {
    "tStartMs": 675240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "do you wanna start with a\ncompletely regular world"
    } ]
  }, {
    "tStartMs": 677430,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "where it's completely clustered"
    } ]
  }, {
    "tStartMs": 679080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "or do you wanna start\nwith completely random?"
    } ]
  }, {
    "tStartMs": 681390,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "- [Derek] I would start\nwith a regular world."
    } ]
  }, {
    "tStartMs": 683256,
    "dDurationMs": 2018,
    "segs": [ {
      "utf8": "- [Casper] Okay."
    } ]
  }, {
    "tStartMs": 685274,
    "dDurationMs": 949,
    "segs": [ {
      "utf8": "There it goes."
    } ]
  }, {
    "tStartMs": 687150,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] There's the\nspread of infections."
    } ]
  }, {
    "tStartMs": 688920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 689753,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "- Wow.\n- So it takes over the world,"
    } ]
  }, {
    "tStartMs": 690900,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "completely."
    } ]
  }, {
    "tStartMs": 691740,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Well, if every step was a day,"
    } ]
  }, {
    "tStartMs": 692940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "it would take 73 days for\nthe, you know, infection"
    } ]
  }, {
    "tStartMs": 695880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to take over this entire world."
    } ]
  }, {
    "tStartMs": 697980,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Well, let's introduce"
    } ]
  }, {
    "tStartMs": 698813,
    "dDurationMs": 1174,
    "segs": [ {
      "utf8": "a few shortcuts and see."
    } ]
  }, {
    "tStartMs": 699987,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "- [Casper] Okay, let's make\nit small world, like 10%."
    } ]
  }, {
    "tStartMs": 703260,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "Let's go."
    } ]
  }, {
    "tStartMs": 706050,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Derek] Boom."
    } ]
  }, {
    "tStartMs": 707130,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "Wow, that's really dramatic.\n- (laughing) Whoa."
    } ]
  }, {
    "tStartMs": 709351,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "Right?\n- That's really dramatic"
    } ]
  }, {
    "tStartMs": 711090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and very fast.\n- Yeah, so fast."
    } ]
  }, {
    "tStartMs": 713100,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yeah, after 26 days,"
    } ]
  }, {
    "tStartMs": 715020,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "the whole world."
    } ]
  }, {
    "tStartMs": 716310,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- [Derek] And that ramp up"
    } ]
  }, {
    "tStartMs": 717180,
    "dDurationMs": 1496,
    "segs": [ {
      "utf8": "does look exponential at the beginning."
    } ]
  }, {
    "tStartMs": 718676,
    "dDurationMs": 1654,
    "segs": [ {
      "utf8": "- Right?\n- And then it kind of looks"
    } ]
  }, {
    "tStartMs": 720330,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "linear there as well,"
    } ]
  }, {
    "tStartMs": 721380,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but it's almost like\nyou can't go any faster."
    } ]
  }, {
    "tStartMs": 723330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 724163,
    "dDurationMs": 3141,
    "segs": [ {
      "utf8": "Okay, so now let's make it\na completely random network."
    } ]
  }, {
    "tStartMs": 727304,
    "dDurationMs": 2005,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 729309,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Boom."
    } ]
  }, {
    "tStartMs": 730142,
    "dDurationMs": 1798,
    "segs": [ {
      "utf8": "- Boom.\n- Crazy."
    } ]
  }, {
    "tStartMs": 731940,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "How many days now for\na fully random network?"
    } ]
  }, {
    "tStartMs": 734700,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Casper] 25."
    } ]
  }, {
    "tStartMs": 736020,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Derek] Basically identical."
    } ]
  }, {
    "tStartMs": 737400,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Casper] Which is crazy\nbecause in the random case,"
    } ]
  }, {
    "tStartMs": 739830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "all your links are random."
    } ]
  }, {
    "tStartMs": 740663,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "You know, in the small-world case,"
    } ]
  }, {
    "tStartMs": 742710,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "it's just 10%."
    } ]
  }, {
    "tStartMs": 743580,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "It's like if one out of your\n10 friends are a shortcut,"
    } ]
  }, {
    "tStartMs": 747330,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which, you know, for some\npeople might be a bit much,"
    } ]
  }, {
    "tStartMs": 749490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but I reckon for you,"
    } ]
  }, {
    "tStartMs": 751170,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "it's probably about right."
    } ]
  }, {
    "tStartMs": 752670,
    "dDurationMs": 1311,
    "segs": [ {
      "utf8": "- [Derek] Yeah, I got lots of shortcuts."
    } ]
  }, {
    "tStartMs": 753981,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "(Casper laughing)"
    } ]
  }, {
    "tStartMs": 756300,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Casper] But the crazy thing is"
    } ]
  }, {
    "tStartMs": 757830,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that in this simulation,"
    } ]
  }, {
    "tStartMs": 759300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "we only use 100 nodes."
    } ]
  }, {
    "tStartMs": 761610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And if you use the same model"
    } ]
  }, {
    "tStartMs": 763440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to the eight billion people on Earth,"
    } ]
  }, {
    "tStartMs": 765360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "then you would actually need less than 1%"
    } ]
  }, {
    "tStartMs": 767610,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "of all your links to be shortcuts."
    } ]
  }, {
    "tStartMs": 770310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] In 1998, Watts and Strogatz"
    } ]
  }, {
    "tStartMs": 772440,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "published their findings"
    } ]
  }, {
    "tStartMs": 773430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in a three-page article in \"Nature,\""
    } ]
  }, {
    "tStartMs": 775620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and the paper took off."
    } ]
  }, {
    "tStartMs": 777450,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Within a few years,"
    } ]
  }, {
    "tStartMs": 778440,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the paper already had\nhundreds of citations."
    } ]
  }, {
    "tStartMs": 781170,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "By 2014, it was ranked\nthe 63rd-most-cited paper"
    } ]
  }, {
    "tStartMs": 784800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "of all time."
    } ]
  }, {
    "tStartMs": 785970,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And today, it's got\naround 58,000 citations."
    } ]
  }, {
    "tStartMs": 789420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "That's higher than Peter Higgs'\npaper on the Higgs boson,"
    } ]
  }, {
    "tStartMs": 791940,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and almost three times as many"
    } ]
  }, {
    "tStartMs": 793500,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "as Watson and Crick's Nobel\nPrize-winning paper on DNA."
    } ]
  }, {
    "tStartMs": 797160,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Steven] So it's probably\nworth making that distinction"
    } ]
  }, {
    "tStartMs": 799290,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that citations are one measure of impact."
    } ]
  }, {
    "tStartMs": 801660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We're cited a lot more than Einstein,"
    } ]
  }, {
    "tStartMs": 803340,
    "dDurationMs": 3071,
    "segs": [ {
      "utf8": "and I think you know who's more important?"
    } ]
  }, {
    "tStartMs": 806411,
    "dDurationMs": 1729,
    "segs": [ {
      "utf8": "(Derek laughing)"
    } ]
  }, {
    "tStartMs": 808140,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "It's not us,"
    } ]
  }, {
    "tStartMs": 809040,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but it does mean people\nthought it was worth citing."
    } ]
  }, {
    "tStartMs": 811890,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "We had many tens of thousands of citations"
    } ]
  }, {
    "tStartMs": 814530,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "from people in far-flung fields,"
    } ]
  }, {
    "tStartMs": 816900,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "from neuroscience, to sociology,"
    } ]
  }, {
    "tStartMs": 818730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to graph theory, to computer science."
    } ]
  }, {
    "tStartMs": 820500,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Even, you know, English literature,"
    } ]
  }, {
    "tStartMs": 822240,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "people would do things like\ndraw networks between words."
    } ]
  }, {
    "tStartMs": 825930,
    "dDurationMs": 2694,
    "segs": [ {
      "utf8": "- [Derek] Is there any irony\nin the fact that this paper"
    } ]
  }, {
    "tStartMs": 828624,
    "dDurationMs": 2876,
    "segs": [ {
      "utf8": "on global networks goes viral itself?"
    } ]
  }, {
    "tStartMs": 831500,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "- [Steven] (laughing)\nYes, I think so, maybe so."
    } ]
  }, {
    "tStartMs": 836103,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(record scratching)"
    } ]
  }, {
    "tStartMs": 836936,
    "dDurationMs": 3274,
    "segs": [ {
      "utf8": "- [Derek] But then things\ngot a little weird."
    } ]
  }, {
    "tStartMs": 840210,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Steven] That's when I started getting"
    } ]
  }, {
    "tStartMs": 841170,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "some strange phone calls."
    } ]
  }, {
    "tStartMs": 842820,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "I got a call from somebody at the FBI."
    } ]
  }, {
    "tStartMs": 846600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I was a little scared,"
    } ]
  }, {
    "tStartMs": 847433,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "\"What's the FBI calling me about?\""
    } ]
  }, {
    "tStartMs": 849780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And so I called back,"
    } ]
  }, {
    "tStartMs": 851460,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "and the person who picks up says,"
    } ]
  }, {
    "tStartMs": 853297,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "\"Hair and Fiber.\""
    } ]
  }, {
    "tStartMs": 855742,
    "dDurationMs": 2768,
    "segs": [ {
      "utf8": "(laughing) I was calling\nthe Hair and Fiber network"
    } ]
  }, {
    "tStartMs": 858510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "at the FBI,"
    } ]
  }, {
    "tStartMs": 859343,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "the people who do you know criminology"
    } ]
  }, {
    "tStartMs": 861000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "based on what telltale hairs or fibers"
    } ]
  }, {
    "tStartMs": 863760,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "are left on the victim's clothes"
    } ]
  }, {
    "tStartMs": 865650,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "after they've been murdered."
    } ]
  }, {
    "tStartMs": 866940,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "There was a guy who said,"
    } ]
  }, {
    "tStartMs": 868147,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "\"What happens when the\npolice have a suspect"
    } ]
  }, {
    "tStartMs": 872190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and they say, \"You have\nfibers on your sweater"
    } ]
  }, {
    "tStartMs": 874680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that match the hair of the victim,\""
    } ]
  }, {
    "tStartMs": 876960,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "and then the defense lawyer says,"
    } ]
  }, {
    "tStartMs": 878317,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "\"Well, you know, maybe\nthe victim was on a bus"
    } ]
  }, {
    "tStartMs": 881550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and left her fibers on the bus,"
    } ]
  }, {
    "tStartMs": 883620,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and then my client sat on the,"
    } ]
  }, {
    "tStartMs": 885510,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "a secondary transfer,\" they\nwould call it, \"of these fibers,"
    } ]
  }, {
    "tStartMs": 888780,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "that doesn't prove anything?\""
    } ]
  }, {
    "tStartMs": 890280,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So the FBI wanted to know,"
    } ]
  }, {
    "tStartMs": 891570,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "what's the probability\nof secondary transfers"
    } ]
  }, {
    "tStartMs": 893880,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "compared to primary transfers"
    } ]
  }, {
    "tStartMs": 896220,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "from actually killing the person?"
    } ]
  }, {
    "tStartMs": 898110,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "And like I said, \"Well, I\ndon't, what do I know now?\""
    } ]
  }, {
    "tStartMs": 900031,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "(Steven and Derek laughing)"
    } ]
  }, {
    "tStartMs": 902280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- [Derek] Now, that's a\nSteve Strogatz problem."
    } ]
  }, {
    "tStartMs": 904650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "For most of us, a random caller"
    } ]
  }, {
    "tStartMs": 906330,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "telling you they're an FBI agent"
    } ]
  }, {
    "tStartMs": 908100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "is probably a scam."
    } ]
  }, {
    "tStartMs": 909930,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Chances are they got your number"
    } ]
  }, {
    "tStartMs": 911130,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "from a data leak or a data broker."
    } ]
  }, {
    "tStartMs": 913680,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Anytime you provide\nyour name, phone number,"
    } ]
  }, {
    "tStartMs": 915990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "even your Social Security number,"
    } ]
  }, {
    "tStartMs": 917850,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that personal information can be scraped,"
    } ]
  }, {
    "tStartMs": 920100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "packaged and sold to anyone who will pay."
    } ]
  }, {
    "tStartMs": 923280,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And if criminals get hold of it,"
    } ]
  }, {
    "tStartMs": 925140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "well, they can open credit\ncard accounts in your name"
    } ]
  }, {
    "tStartMs": 927480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "or even use it to stalk or harass you."
    } ]
  }, {
    "tStartMs": 930120,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Fortunately, today's video\nsponsor, Incogni, can help."
    } ]
  }, {
    "tStartMs": 933510,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "With your permission,"
    } ]
  }, {
    "tStartMs": 934530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "they'll send out a letter to each broker,"
    } ]
  }, {
    "tStartMs": 936690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "using the correct legal terms,"
    } ]
  }, {
    "tStartMs": 938520,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and keep insisting until\nyour data comes down."
    } ]
  }, {
    "tStartMs": 941850,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And remember, even one unremoved profile"
    } ]
  }, {
    "tStartMs": 944700,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "can be enough for criminals to target you."
    } ]
  }, {
    "tStartMs": 947190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "If you sign up to\nIncogni's Unlimited plan,"
    } ]
  }, {
    "tStartMs": 949980,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "you can even flag public websites"
    } ]
  }, {
    "tStartMs": 951810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "where your information appears"
    } ]
  }, {
    "tStartMs": 953370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "with their custom removals tool."
    } ]
  }, {
    "tStartMs": 955320,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Their data agents will\ntake care of the rest."
    } ]
  }, {
    "tStartMs": 957780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Since I started using\nIncogni 18 months ago,"
    } ]
  }, {
    "tStartMs": 960210,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "they filed almost 700 requests for me,"
    } ]
  }, {
    "tStartMs": 962940,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and over 600 of those have been completed."
    } ]
  }, {
    "tStartMs": 966000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "With their Unlimited Family plan,"
    } ]
  }, {
    "tStartMs": 967590,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "you can protect your whole family too."
    } ]
  }, {
    "tStartMs": 969720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So to keep your information safe,"
    } ]
  }, {
    "tStartMs": 971490,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "head over to incogni.com/veritasium"
    } ]
  }, {
    "tStartMs": 973950,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "by clicking the link in the description"
    } ]
  }, {
    "tStartMs": 975900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "or just use this QR code."
    } ]
  }, {
    "tStartMs": 978000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And when you do,"
    } ]
  }, {
    "tStartMs": 978833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "be sure to use the code Veritasium"
    } ]
  }, {
    "tStartMs": 980400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "for 60% off your annual subscription."
    } ]
  }, {
    "tStartMs": 983310,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So I wanna thank Incogni"
    } ]
  }, {
    "tStartMs": 984720,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "for sponsoring this video."
    } ]
  }, {
    "tStartMs": 986190,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "And now back to networks."
    } ]
  }, {
    "tStartMs": 989790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "In 1998, Albert-Laszlo Barabasi"
    } ]
  }, {
    "tStartMs": 992340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "was studying the internet."
    } ]
  }, {
    "tStartMs": 994260,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "At that time, there were\naround 800 million webpage,"
    } ]
  }, {
    "tStartMs": 998100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but despite the web's enormous size,"
    } ]
  }, {
    "tStartMs": 1000230,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Barabasi found that on average"
    } ]
  }, {
    "tStartMs": 1001850,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "you could connect any two sites"
    } ]
  }, {
    "tStartMs": 1003470,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "with just 19 clicks."
    } ]
  }, {
    "tStartMs": 1005960,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Apparently the web was a small world too,"
    } ]
  }, {
    "tStartMs": 1008930,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "but the strange thing was,"
    } ]
  }, {
    "tStartMs": 1010160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "it didn't look anything\nlike the small-world network"
    } ]
  }, {
    "tStartMs": 1012500,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "in Watts and Strogatz's model."
    } ]
  }, {
    "tStartMs": 1015500,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] We ended up mapping out"
    } ]
  }, {
    "tStartMs": 1016790,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "a region of World Wide Web,"
    } ]
  }, {
    "tStartMs": 1018423,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "and we had a very clear expectation"
    } ]
  }, {
    "tStartMs": 1020990,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "of how that network should look like."
    } ]
  }, {
    "tStartMs": 1023720,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Derek] Barabasi\nthought the distribution"
    } ]
  }, {
    "tStartMs": 1025250,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "of pages and links"
    } ]
  }, {
    "tStartMs": 1026210,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "would resemble a bell curve,"
    } ]
  }, {
    "tStartMs": 1027680,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "similar to what you'd get"
    } ]
  }, {
    "tStartMs": 1028760,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "for people's height across a population."
    } ]
  }, {
    "tStartMs": 1030980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Most sites would have some\naverage number of links"
    } ]
  }, {
    "tStartMs": 1033380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and there would be very\nfew outliers either side."
    } ]
  }, {
    "tStartMs": 1036410,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "But that is not what he saw."
    } ]
  }, {
    "tStartMs": 1038224,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 1039057,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] And so we\nmeasured the distribution,"
    } ]
  }, {
    "tStartMs": 1040820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and it didn't look anything like"
    } ]
  }, {
    "tStartMs": 1042380,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "what we expected. (laughing)"
    } ]
  }, {
    "tStartMs": 1043940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] The curve started out steep."
    } ]
  }, {
    "tStartMs": 1045860,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Loads of websites had not many links."
    } ]
  }, {
    "tStartMs": 1048740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Then there was this really long tail."
    } ]
  }, {
    "tStartMs": 1051560,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] And here we saw webpages"
    } ]
  }, {
    "tStartMs": 1053900,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that had not only a little more,"
    } ]
  }, {
    "tStartMs": 1056090,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "but sometimes 100 times more\nlinks than the average degree"
    } ]
  }, {
    "tStartMs": 1060140,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "or the average node on the website."
    } ]
  }, {
    "tStartMs": 1062390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] These were websites like Yahoo,"
    } ]
  }, {
    "tStartMs": 1064430,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "super-connectors that linked\nto thousands of other sites."
    } ]
  }, {
    "tStartMs": 1067580,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Barabasi called them hubs,"
    } ]
  }, {
    "tStartMs": 1069170,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "because when he mapped out the network,"
    } ]
  }, {
    "tStartMs": 1070790,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "they resembled the hub of a wheel,"
    } ]
  }, {
    "tStartMs": 1072770,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "with spokes going out to\nhundreds of other pages."
    } ]
  }, {
    "tStartMs": 1075950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And it was these hubs"
    } ]
  }, {
    "tStartMs": 1077330,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that made the web a small world,"
    } ]
  }, {
    "tStartMs": 1079250,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "not shortcuts."
    } ]
  }, {
    "tStartMs": 1080810,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "So Barabasi wondered,"
    } ]
  }, {
    "tStartMs": 1082017,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "\"How could this apply\nto other networks too?\""
    } ]
  }, {
    "tStartMs": 1085880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] Most real networks,"
    } ]
  }, {
    "tStartMs": 1087320,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "or virtually all large networks,"
    } ]
  }, {
    "tStartMs": 1090230,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "follow two very fundamental principles."
    } ]
  }, {
    "tStartMs": 1094220,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "First, any large network out there"
    } ]
  }, {
    "tStartMs": 1097040,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "never pops out as a large network,"
    } ]
  }, {
    "tStartMs": 1099410,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but it grows, right?"
    } ]
  }, {
    "tStartMs": 1101630,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You have a tiny World Wide Web in 1991,"
    } ]
  }, {
    "tStartMs": 1104630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and now we have trillions of nodes"
    } ]
  }, {
    "tStartMs": 1106700,
    "dDurationMs": 1013,
    "segs": [ {
      "utf8": "on the World Wide Web."
    } ]
  }, {
    "tStartMs": 1107713,
    "dDurationMs": 2827,
    "segs": [ {
      "utf8": "How did we get one to a trillion?"
    } ]
  }, {
    "tStartMs": 1110540,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "One node at a time,"
    } ]
  }, {
    "tStartMs": 1111770,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "one website at a time."
    } ]
  }, {
    "tStartMs": 1113390,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "All the networks out there,"
    } ]
  }, {
    "tStartMs": 1115010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "no matter how old,"
    } ]
  }, {
    "tStartMs": 1116600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "how fast they emerged,"
    } ]
  }, {
    "tStartMs": 1118370,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "they always emerged"
    } ]
  }, {
    "tStartMs": 1119870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with some kind of growth process."
    } ]
  }, {
    "tStartMs": 1121550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So if you think about networks,"
    } ]
  }, {
    "tStartMs": 1123200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you must build in that growth process."
    } ]
  }, {
    "tStartMs": 1125570,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Number two, when a new node comes in,"
    } ]
  }, {
    "tStartMs": 1128480,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "you join Facebook,"
    } ]
  }, {
    "tStartMs": 1129710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "whom you gonna connect to, right?"
    } ]
  }, {
    "tStartMs": 1131990,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And it is somewhat unpredictable,"
    } ]
  }, {
    "tStartMs": 1133550,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "but it's biased."
    } ]
  }, {
    "tStartMs": 1134900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Your connections are always biased"
    } ]
  }, {
    "tStartMs": 1136550,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "towards the more connected nodes,"
    } ]
  }, {
    "tStartMs": 1138350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "simply because you are more likely to know"
    } ]
  }, {
    "tStartMs": 1140630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "more connected node\nthan less connected node."
    } ]
  }, {
    "tStartMs": 1143180,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "We named this process\npreferential attachment."
    } ]
  }, {
    "tStartMs": 1146630,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] Barabasi reasoned\nthat these two principles"
    } ]
  }, {
    "tStartMs": 1148850,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "could explain how hubs naturally emerge"
    } ]
  }, {
    "tStartMs": 1151400,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "when a network grows."
    } ]
  }, {
    "tStartMs": 1153290,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So together with his\ncolleague, Reka Albert,"
    } ]
  }, {
    "tStartMs": 1155630,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "he ran a simulation."
    } ]
  }, {
    "tStartMs": 1157730,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- [Casper] We've also got\na simulation for this."
    } ]
  }, {
    "tStartMs": 1161030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "They started with a simple network"
    } ]
  }, {
    "tStartMs": 1162860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of just a few connected nodes."
    } ]
  }, {
    "tStartMs": 1164780,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Then they begin adding\nnew nodes to the network"
    } ]
  }, {
    "tStartMs": 1167090,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "one at a time,"
    } ]
  }, {
    "tStartMs": 1168530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "with just one condition,"
    } ]
  }, {
    "tStartMs": 1170180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they'd be more likely to connect the nodes"
    } ]
  }, {
    "tStartMs": 1172100,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "that already had more links."
    } ]
  }, {
    "tStartMs": 1175130,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] That's so cool."
    } ]
  }, {
    "tStartMs": 1176480,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Looks very biological, very organic."
    } ]
  }, {
    "tStartMs": 1179390,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Also, I like how the nodes come out"
    } ]
  }, {
    "tStartMs": 1182150,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and they don't just sort\nof stop in one spot,"
    } ]
  }, {
    "tStartMs": 1184880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "they kind of like wiggle around"
    } ]
  }, {
    "tStartMs": 1186380,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and like find their location."
    } ]
  }, {
    "tStartMs": 1188780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I really like enjoy this."
    } ]
  }, {
    "tStartMs": 1190730,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "Kind of like a space station."
    } ]
  }, {
    "tStartMs": 1193880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Casper] That's what I was thinking."
    } ]
  }, {
    "tStartMs": 1195800,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "- [Derek] Or like a space colony, right?"
    } ]
  }, {
    "tStartMs": 1197441,
    "dDurationMs": 925,
    "segs": [ {
      "utf8": "- [Casper] Yeah, yeah, right?"
    } ]
  }, {
    "tStartMs": 1198366,
    "dDurationMs": 2504,
    "segs": [ {
      "utf8": "Like each little center\none could be a planet,"
    } ]
  }, {
    "tStartMs": 1200870,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "then you've got all the sort of stations"
    } ]
  }, {
    "tStartMs": 1203390,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "going around it."
    } ]
  }, {
    "tStartMs": 1204890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] Yes."
    } ]
  }, {
    "tStartMs": 1206300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Casper] So when Barabasi and Albert"
    } ]
  }, {
    "tStartMs": 1208130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "let these networks evolve,"
    } ]
  }, {
    "tStartMs": 1209510,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "hubs emerged."
    } ]
  }, {
    "tStartMs": 1211010,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] And\nwe showed that growth"
    } ]
  }, {
    "tStartMs": 1213020,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and preferential attachment together"
    } ]
  }, {
    "tStartMs": 1215750,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "naturally lead to the emergence of hubs."
    } ]
  }, {
    "tStartMs": 1218870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Derek] With this simulation,"
    } ]
  }, {
    "tStartMs": 1220250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Barabasi and Albert showed how hubs"
    } ]
  }, {
    "tStartMs": 1222080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "could emerge in virtually\nany complex network."
    } ]
  }, {
    "tStartMs": 1225080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Take airports for example."
    } ]
  }, {
    "tStartMs": 1227480,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "In 1955, Chicago O'Hare\nopened to commercial flights."
    } ]
  }, {
    "tStartMs": 1231380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Unlike neighboring airport, Midway,"
    } ]
  }, {
    "tStartMs": 1233300,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "it had long runways"
    } ]
  }, {
    "tStartMs": 1234410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and plenty of space for new jet aircraft."
    } ]
  }, {
    "tStartMs": 1236870,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Airlines began shifting service there."
    } ]
  }, {
    "tStartMs": 1239030,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "As more airlines connected\nflights to O'Hare,"
    } ]
  }, {
    "tStartMs": 1241760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "passengers had more options to connect,"
    } ]
  }, {
    "tStartMs": 1243950,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "making it increasingly attractive."
    } ]
  }, {
    "tStartMs": 1246080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "After deregulation in the 1970s,"
    } ]
  }, {
    "tStartMs": 1248090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "more airlines were free to add routes"
    } ]
  }, {
    "tStartMs": 1250100,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and the feedback loop accelerated."
    } ]
  }, {
    "tStartMs": 1252170,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Each new route made the airport\nmore useful to passengers"
    } ]
  }, {
    "tStartMs": 1255410,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and more appealing to other airlines."
    } ]
  }, {
    "tStartMs": 1257960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Today, O'Hare is the\nmost connected airport"
    } ]
  }, {
    "tStartMs": 1260540,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "in the United States,"
    } ]
  }, {
    "tStartMs": 1261500,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "with direct flights to\nwell over 200 destinations."
    } ]
  }, {
    "tStartMs": 1265550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- [Casper] But we don't just\nsee hubs in manmade networks."
    } ]
  }, {
    "tStartMs": 1267920,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "In food webs,"
    } ]
  }, {
    "tStartMs": 1269240,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "you have a few keystone\nspecies, like Atlantic cods,"
    } ]
  }, {
    "tStartMs": 1272090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that connect hundreds\nof predators and prey."
    } ]
  }, {
    "tStartMs": 1274640,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And in the metabolic\nnetworks in our cells,"
    } ]
  }, {
    "tStartMs": 1276830,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "you have a few molecules, like ATP,"
    } ]
  }, {
    "tStartMs": 1279350,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that govern hundreds\nof chemical reactions."
    } ]
  }, {
    "tStartMs": 1281840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "In the neural networks in our brain,"
    } ]
  }, {
    "tStartMs": 1283670,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "you have a few regions,"
    } ]
  }, {
    "tStartMs": 1285080,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "like the prefrontal cortex"
    } ]
  }, {
    "tStartMs": 1286700,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that link hundreds of different functions."
    } ]
  }, {
    "tStartMs": 1289130,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now, as each of these networks evolved"
    } ]
  }, {
    "tStartMs": 1291680,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "and grew over time,"
    } ]
  }, {
    "tStartMs": 1292640,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "you had new species,"
    } ]
  }, {
    "tStartMs": 1293810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "new reactions and new circuits"
    } ]
  }, {
    "tStartMs": 1295820,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that latched on to what\nwas already well connected."
    } ]
  }, {
    "tStartMs": 1298730,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And so you get this\nsort of natural growth."
    } ]
  }, {
    "tStartMs": 1301490,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Now, preferential attachment"
    } ]
  }, {
    "tStartMs": 1302990,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "isn't the only mechanism\nthat can create hubs."
    } ]
  }, {
    "tStartMs": 1305720,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "There are plenty of other factors at play,"
    } ]
  }, {
    "tStartMs": 1308270,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "particularly in these more\ncomplex biological systems."
    } ]
  }, {
    "tStartMs": 1311930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But what Barabasi's and\nAlbert's simulation showed"
    } ]
  }, {
    "tStartMs": 1314570,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "is that all it takes is a tiny bias"
    } ]
  }, {
    "tStartMs": 1317570,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "when growing a network"
    } ]
  }, {
    "tStartMs": 1318860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and hubs end up being inevitable."
    } ]
  }, {
    "tStartMs": 1321560,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] Once hubs are there,"
    } ]
  }, {
    "tStartMs": 1322520,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "they fundamentally change (laughing)"
    } ]
  }, {
    "tStartMs": 1324384,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "the way the system behaves"
    } ]
  }, {
    "tStartMs": 1326480,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and the way we understand that system."
    } ]
  }, {
    "tStartMs": 1329030,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] Hubs like O'Hare"
    } ]
  }, {
    "tStartMs": 1330170,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "mean you can get pretty\nmuch anywhere in the world"
    } ]
  }, {
    "tStartMs": 1332450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in just a few flights."
    } ]
  }, {
    "tStartMs": 1334430,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "But that connectivity\nalso has consequences."
    } ]
  }, {
    "tStartMs": 1338420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "In August, 2025,"
    } ]
  }, {
    "tStartMs": 1340220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "thunderstorms shut down Chicago O'Hare,"
    } ]
  }, {
    "tStartMs": 1342770,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and 280 flights were canceled"
    } ]
  }, {
    "tStartMs": 1345050,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and 80 were diverted."
    } ]
  }, {
    "tStartMs": 1346850,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Overflow hit at least\nsix other US airports."
    } ]
  }, {
    "tStartMs": 1350120,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "While some planes stuck in Chicago"
    } ]
  }, {
    "tStartMs": 1351950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "never left for Europe or Asia."
    } ]
  }, {
    "tStartMs": 1354110,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] Bad weather in Chicago"
    } ]
  }, {
    "tStartMs": 1355280,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "totally changes not only the\nthe travel pattern in Chicago,"
    } ]
  }, {
    "tStartMs": 1359780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "but within 24 hours,"
    } ]
  }, {
    "tStartMs": 1361160,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the whole country is\nbeing affected by that."
    } ]
  }, {
    "tStartMs": 1364070,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Derek] And we see the same phenomenon"
    } ]
  }, {
    "tStartMs": 1365630,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "in natural networks,"
    } ]
  }, {
    "tStartMs": 1366890,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "knocking out one keystone species,"
    } ]
  }, {
    "tStartMs": 1368750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "like Atlantic cod,"
    } ]
  }, {
    "tStartMs": 1369950,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "can destabilize an entire ecosystem."
    } ]
  }, {
    "tStartMs": 1373040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Albert-Laszlo] So this is what we call"
    } ]
  }, {
    "tStartMs": 1373873,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "the Achilles' heel of networks."
    } ]
  }, {
    "tStartMs": 1376130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And this could be good news"
    } ]
  }, {
    "tStartMs": 1377330,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "or it could be bad news, right?"
    } ]
  }, {
    "tStartMs": 1378650,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Good news if you wanna create\ndrugs to kill bacteria,"
    } ]
  }, {
    "tStartMs": 1383090,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "then you're gonna go for the hub."
    } ]
  }, {
    "tStartMs": 1384800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Derek] This idea has created"
    } ]
  }, {
    "tStartMs": 1386030,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "a whole new field of network medicine"
    } ]
  }, {
    "tStartMs": 1388010,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "where researchers develop drugs"
    } ]
  }, {
    "tStartMs": 1389510,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to target crucial parts of a\ndisease's metabolic network."
    } ]
  }, {
    "tStartMs": 1392660,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "But understanding the role of hubs"
    } ]
  }, {
    "tStartMs": 1394220,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "doesn't just help develop\ncures for a disease,"
    } ]
  }, {
    "tStartMs": 1396830,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "it can help us control its spread."
    } ]
  }, {
    "tStartMs": 1398748,
    "dDurationMs": 1052,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 1399800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "In 1990, Thailand was facing"
    } ]
  }, {
    "tStartMs": 1402050,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "one of the fastest-growing\nHIV epidemics in the world."
    } ]
  }, {
    "tStartMs": 1405230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The government tried broad campaigns,"
    } ]
  }, {
    "tStartMs": 1407270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "like posters, TV ads and school talks,"
    } ]
  }, {
    "tStartMs": 1409820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "telling everyone to use condoms."
    } ]
  }, {
    "tStartMs": 1411890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But the infection kept spreading."
    } ]
  }, {
    "tStartMs": 1413990,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So in 1991, the government\ntried something different."
    } ]
  }, {
    "tStartMs": 1417170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "They started targeting hubs."
    } ]
  }, {
    "tStartMs": 1419270,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "They told brothels around the country"
    } ]
  }, {
    "tStartMs": 1420830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that every client must use a condom"
    } ]
  }, {
    "tStartMs": 1422540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or else they'd be shut down."
    } ]
  }, {
    "tStartMs": 1424280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And the impact was huge."
    } ]
  }, {
    "tStartMs": 1426020,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "For example, HIV\ninfections among young men"
    } ]
  }, {
    "tStartMs": 1428450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "joining the military"
    } ]
  }, {
    "tStartMs": 1429283,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "dropped by more than 50%."
    } ]
  }, {
    "tStartMs": 1431060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And by 2013, Thailand's\nMinistry of Public Health"
    } ]
  }, {
    "tStartMs": 1434000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "estimated the policy had prevented"
    } ]
  }, {
    "tStartMs": 1435440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "over five million infections."
    } ]
  }, {
    "tStartMs": 1438080,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "All because they realized\nthe importance of hubs."
    } ]
  }, {
    "tStartMs": 1442389,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 1443222,
    "dDurationMs": 2478,
    "segs": [ {
      "utf8": "- [Casper] Hubs and shortcuts\nmake any complex network"
    } ]
  }, {
    "tStartMs": 1445700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "more connected than it seems."
    } ]
  }, {
    "tStartMs": 1447380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "That means things spread quickly,"
    } ]
  }, {
    "tStartMs": 1449390,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "whether that's airport delays,\ninformation or disease."
    } ]
  }, {
    "tStartMs": 1453170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But could that impact run even deeper?"
    } ]
  }, {
    "tStartMs": 1455690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I mean, could the structure\nof our social network"
    } ]
  }, {
    "tStartMs": 1458270,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "influence our very behavior and beliefs"
    } ]
  }, {
    "tStartMs": 1461150,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "without us even being aware of it?"
    } ]
  }, {
    "tStartMs": 1464420,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] Back in 1997,"
    } ]
  }, {
    "tStartMs": 1465680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Watts and Strogatz investigated just that,"
    } ]
  }, {
    "tStartMs": 1467930,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "using a game called\nthe prisoner's dilemma."
    } ]
  }, {
    "tStartMs": 1470330,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "It's probably the most famous\nproblem in game theory,"
    } ]
  }, {
    "tStartMs": 1472550,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and it's used to represent\na ton of different conflicts"
    } ]
  }, {
    "tStartMs": 1475280,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "we see in the real world."
    } ]
  }, {
    "tStartMs": 1476870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We've actually done a\nfull video on it before,"
    } ]
  }, {
    "tStartMs": 1478550,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "but here's a quick recap."
    } ]
  }, {
    "tStartMs": 1480320,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The premise is simple."
    } ]
  }, {
    "tStartMs": 1481610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "A banker with a chest full of gold"
    } ]
  }, {
    "tStartMs": 1483350,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "invites you and another player to play."
    } ]
  }, {
    "tStartMs": 1485690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "You each get two choices,"
    } ]
  }, {
    "tStartMs": 1487220,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you can cooperate or defect."
    } ]
  }, {
    "tStartMs": 1489320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "If you both cooperate,"
    } ]
  }, {
    "tStartMs": 1490700,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "you each get three coins."
    } ]
  }, {
    "tStartMs": 1492470,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But if you defect while\nyour opponent cooperates,"
    } ]
  }, {
    "tStartMs": 1495140,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "you get five coins and they get nothing."
    } ]
  }, {
    "tStartMs": 1497810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And if you both defect,"
    } ]
  }, {
    "tStartMs": 1499370,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "then you each get one coin."
    } ]
  }, {
    "tStartMs": 1501500,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So what would you do?"
    } ]
  }, {
    "tStartMs": 1502970,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Suppose your opponent cooperates,"
    } ]
  }, {
    "tStartMs": 1505010,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "then you could also cooperate"
    } ]
  }, {
    "tStartMs": 1506540,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and get three coins,"
    } ]
  }, {
    "tStartMs": 1507920,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "or you could defect and\nget five coins instead."
    } ]
  }, {
    "tStartMs": 1511070,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So you're better off defecting."
    } ]
  }, {
    "tStartMs": 1513170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "But what if your opponent defects?"
    } ]
  }, {
    "tStartMs": 1515900,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Well, you could cooperate and get no coins"
    } ]
  }, {
    "tStartMs": 1518480,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "or you could defect and at least get one."
    } ]
  }, {
    "tStartMs": 1521720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So no matter what your opponent does,"
    } ]
  }, {
    "tStartMs": 1524240,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "your best option is always to defect."
    } ]
  }, {
    "tStartMs": 1527630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Now, if your opponent is also rational,"
    } ]
  }, {
    "tStartMs": 1530150,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they'll reach the same conclusion"
    } ]
  }, {
    "tStartMs": 1531860,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and therefore they'll also defect."
    } ]
  }, {
    "tStartMs": 1534050,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And as a result, when\nyou both act rationally,"
    } ]
  }, {
    "tStartMs": 1536930,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "you both end up in the\nsuboptimal situation"
    } ]
  }, {
    "tStartMs": 1539780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "of getting one coin each"
    } ]
  }, {
    "tStartMs": 1541430,
    "dDurationMs": 2172,
    "segs": [ {
      "utf8": "when you could have gotten three."
    } ]
  }, {
    "tStartMs": 1543602,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1544435,
    "dDurationMs": 2365,
    "segs": [ {
      "utf8": "But in 1980, Professor Robert Axelrod"
    } ]
  }, {
    "tStartMs": 1546800,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "found that if you play your\nopponent hundreds of times,"
    } ]
  }, {
    "tStartMs": 1549770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "well, then cooperation wins out."
    } ]
  }, {
    "tStartMs": 1552170,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "He ran a tournament among the\nworld's leading game theorists"
    } ]
  }, {
    "tStartMs": 1555380,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and all the most successful\nstrategies were nice."
    } ]
  }, {
    "tStartMs": 1558950,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The winning strategy\nwas called tit for tat,"
    } ]
  }, {
    "tStartMs": 1561230,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because its default\nposition was to cooperate"
    } ]
  }, {
    "tStartMs": 1564110,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and it would only defect in retaliation."
    } ]
  }, {
    "tStartMs": 1566900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "He also showed that a small\ncluster of cooperators"
    } ]
  }, {
    "tStartMs": 1569660,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "can work together to overcome\na world of defectors."
    } ]
  }, {
    "tStartMs": 1573620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Casper] So that's kind of\nthe scene we're setting, right?"
    } ]
  }, {
    "tStartMs": 1575870,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "You get to this realistic place"
    } ]
  }, {
    "tStartMs": 1577880,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "where you get tit-for-tat life strategies"
    } ]
  }, {
    "tStartMs": 1580010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to sort of dominate the world,"
    } ]
  }, {
    "tStartMs": 1581660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "because in Axelrod's tournament,"
    } ]
  }, {
    "tStartMs": 1583010,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "every strategy played\nagainst every other strategy,"
    } ]
  }, {
    "tStartMs": 1586460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "or they only interacted"
    } ]
  }, {
    "tStartMs": 1587660,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "sort of with their near neighborhood,"
    } ]
  }, {
    "tStartMs": 1589130,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "which is, you know, the small cluster."
    } ]
  }, {
    "tStartMs": 1590780,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "And now you could wonder,"
    } ]
  }, {
    "tStartMs": 1592137,
    "dDurationMs": 4313,
    "segs": [ {
      "utf8": "\"Well, what if we start\nchanging the way this works?"
    } ]
  }, {
    "tStartMs": 1596450,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "What if we put them on a network?\""
    } ]
  }, {
    "tStartMs": 1598700,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Derek] Well, Watts and Strogatz"
    } ]
  }, {
    "tStartMs": 1599930,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "simulated their own version"
    } ]
  }, {
    "tStartMs": 1601370,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "of the prisoner's dilemma\nthat did just that."
    } ]
  }, {
    "tStartMs": 1603590,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "They set up a regular network"
    } ]
  }, {
    "tStartMs": 1605180,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "where each player was connected"
    } ]
  }, {
    "tStartMs": 1606410,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to a few players on either side."
    } ]
  }, {
    "tStartMs": 1608780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Then they would simultaneously play"
    } ]
  }, {
    "tStartMs": 1611210,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "against all of their connections."
    } ]
  }, {
    "tStartMs": 1612980,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The rules were simple."
    } ]
  }, {
    "tStartMs": 1614300,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "If most of a player's\nconnections cooperated,"
    } ]
  }, {
    "tStartMs": 1616790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "then that player would also cooperate."
    } ]
  }, {
    "tStartMs": 1619220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But if most of their connections defected,"
    } ]
  }, {
    "tStartMs": 1621350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "then they would defect in retaliation."
    } ]
  }, {
    "tStartMs": 1624110,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "They started with a small\ncluster of cooperators"
    } ]
  }, {
    "tStartMs": 1626900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "surrounded by defectors,"
    } ]
  }, {
    "tStartMs": 1628580,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and they watched the network evolve."
    } ]
  }, {
    "tStartMs": 1630920,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Over time, what they saw\nwas cooperation spread,"
    } ]
  }, {
    "tStartMs": 1634130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "just like what Axelrod had found."
    } ]
  }, {
    "tStartMs": 1636470,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But then they reran the simulation,"
    } ]
  }, {
    "tStartMs": 1638840,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "this time with a few links\nrewired to shortcuts."
    } ]
  }, {
    "tStartMs": 1642290,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And all of a sudden,"
    } ]
  }, {
    "tStartMs": 1643670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "the cooperators were crushed"
    } ]
  }, {
    "tStartMs": 1645860,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and they ended up with\na world of defectors."
    } ]
  }, {
    "tStartMs": 1648350,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "(defectors whirring)"
    } ]
  }, {
    "tStartMs": 1649490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And when they started from\na totally regular network"
    } ]
  }, {
    "tStartMs": 1651920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and gradually increased\nthe fraction of shortcuts,"
    } ]
  }, {
    "tStartMs": 1654560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "they found there was\nthis critical fraction"
    } ]
  }, {
    "tStartMs": 1657260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "beyond which the percentage of cooperators"
    } ]
  }, {
    "tStartMs": 1659300,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "at the end of the game"
    } ]
  }, {
    "tStartMs": 1660170,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "drops to zero."
    } ]
  }, {
    "tStartMs": 1661760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- I think the\nthing that's really crazy"
    } ]
  }, {
    "tStartMs": 1664130,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "is that you've taken the\nexact same strategies"
    } ]
  }, {
    "tStartMs": 1666680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "with all the same properties,"
    } ]
  }, {
    "tStartMs": 1668120,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "same character traits and\npersonalities, if you will,"
    } ]
  }, {
    "tStartMs": 1671450,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and you're not changing any of that."
    } ]
  }, {
    "tStartMs": 1672860,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "All you're changing is\nthe way they're connected,"
    } ]
  }, {
    "tStartMs": 1675050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and you go from a world where\neveryone's completely nice"
    } ]
  }, {
    "tStartMs": 1677990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and working together"
    } ]
  }, {
    "tStartMs": 1679250,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to one where it's filled with nastiness"
    } ]
  }, {
    "tStartMs": 1682070,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and people betraying each other,"
    } ]
  }, {
    "tStartMs": 1683570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "only by changing how they're connected."
    } ]
  }, {
    "tStartMs": 1685550,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Derek] It's like if the\nbulk of your interactions"
    } ]
  }, {
    "tStartMs": 1687560,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "are sort of negative,"
    } ]
  }, {
    "tStartMs": 1689030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "then you start being negative too"
    } ]
  }, {
    "tStartMs": 1691220,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and you just contribute\nto the overall negativity."
    } ]
  }, {
    "tStartMs": 1694280,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Whereas if like a few people are nice,"
    } ]
  }, {
    "tStartMs": 1696140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and you can imagine, \"Oh,\nthat makes me feel good"
    } ]
  }, {
    "tStartMs": 1698030,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and so I'm gonna be nicer to that person.\""
    } ]
  }, {
    "tStartMs": 1700340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- [Steven] The intuition\nfor that is that cooperation"
    } ]
  }, {
    "tStartMs": 1702980,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "is fostered by having little clumps."
    } ]
  }, {
    "tStartMs": 1705500,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "If I have a little clump of people"
    } ]
  }, {
    "tStartMs": 1708230,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that are kind of my buds,"
    } ]
  }, {
    "tStartMs": 1709670,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "we get to have a lot of encounters,"
    } ]
  }, {
    "tStartMs": 1711320,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and cooperation tends to\nemerge from familiarity,"
    } ]
  }, {
    "tStartMs": 1714230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the same way that iteration helps,"
    } ]
  }, {
    "tStartMs": 1716120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that if I know that I'm\ngonna see you again,"
    } ]
  }, {
    "tStartMs": 1717770,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I'm gonna encounter you again,"
    } ]
  }, {
    "tStartMs": 1719390,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it ends up being to my\nadvantage to cooperate."
    } ]
  }, {
    "tStartMs": 1722090,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Whereas like the world of the internet,"
    } ]
  }, {
    "tStartMs": 1723830,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "where anyone can get on Twitter"
    } ]
  }, {
    "tStartMs": 1725390,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "and badmouth anyone else,"
    } ]
  }, {
    "tStartMs": 1728390,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that tends to discourage."
    } ]
  }, {
    "tStartMs": 1730100,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "We don't have pockets,"
    } ]
  }, {
    "tStartMs": 1732890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you don't have communities."
    } ]
  }, {
    "tStartMs": 1734330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] It kind of explains"
    } ]
  }, {
    "tStartMs": 1735163,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "this keyboard warrior phenomenon,"
    } ]
  }, {
    "tStartMs": 1737660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and that, yeah, people\nsay things on the internet"
    } ]
  }, {
    "tStartMs": 1739970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "they wouldn't say to--\n- They wouldn't."
    } ]
  }, {
    "tStartMs": 1741620,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Most people are nice in real life."
    } ]
  }, {
    "tStartMs": 1743700,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "- [Derek] (laughing) Yeah."
    } ]
  }, {
    "tStartMs": 1744680,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Steven] It's funny\nthat the small world,"
    } ]
  }, {
    "tStartMs": 1745970,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I know, you'd think the small world's,"
    } ]
  }, {
    "tStartMs": 1747170,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "well, 'cause it's a Disney song, right?"
    } ]
  }, {
    "tStartMs": 1749106,
    "dDurationMs": 1364,
    "segs": [ {
      "utf8": "♪ It's a small world after all ♪"
    } ]
  }, {
    "tStartMs": 1750470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Like it's supposed to be good,"
    } ]
  }, {
    "tStartMs": 1752270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and yet it does expose you\nto toxicity and malevolence"
    } ]
  }, {
    "tStartMs": 1755510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that you might've been shielded from"
    } ]
  }, {
    "tStartMs": 1757730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "in the small town."
    } ]
  }, {
    "tStartMs": 1759200,
    "dDurationMs": 2182,
    "segs": [ {
      "utf8": "Social media has kind of been"
    } ]
  }, {
    "tStartMs": 1761540,
    "dDurationMs": 926,
    "segs": [ {
      "utf8": "toxic."
    } ]
  }, {
    "tStartMs": 1762466,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The initial idea being"
    } ]
  }, {
    "tStartMs": 1764086,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "'hey we connect up a bunch of people\nand people who have been"
    } ]
  }, {
    "tStartMs": 1766946,
    "dDurationMs": 909,
    "segs": [ {
      "utf8": "separated geographically"
    } ]
  }, {
    "tStartMs": 1767855,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "we connect you with your old friends.'"
    } ]
  }, {
    "tStartMs": 1769598,
    "dDurationMs": 2991,
    "segs": [ {
      "utf8": "You look of the net effect of it\nand it's actually been"
    } ]
  }, {
    "tStartMs": 1772589,
    "dDurationMs": 3014,
    "segs": [ {
      "utf8": "pretty negative by a lot of measures."
    } ]
  }, {
    "tStartMs": 1775610,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Intrigued by the findings,"
    } ]
  }, {
    "tStartMs": 1776900,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Watts started wondering if the results"
    } ]
  }, {
    "tStartMs": 1778490,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "applied to the real world too."
    } ]
  }, {
    "tStartMs": 1780620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "For years after I did this work"
    } ]
  }, {
    "tStartMs": 1783380,
    "dDurationMs": 4484,
    "segs": [ {
      "utf8": "I had wanted to test the hypothesis"
    } ]
  }, {
    "tStartMs": 1788090,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with actual human subjects"
    } ]
  }, {
    "tStartMs": 1790490,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So he got some volunteers \nto play a similar game"
    } ]
  }, {
    "tStartMs": 1792740,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "called the public goods game \nacross different network structures"
    } ]
  }, {
    "tStartMs": 1796790,
    "dDurationMs": 3209,
    "segs": [ {
      "utf8": "He was expecting that, \nlike they found previously,"
    } ]
  }, {
    "tStartMs": 1799999,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "more shortcuts in a network,"
    } ]
  }, {
    "tStartMs": 1800999,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "would make cooperation less likely to emerge."
    } ]
  }, {
    "tStartMs": 1804446,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "But what he found was, \nthe structure of the network"
    } ]
  }, {
    "tStartMs": 1806969,
    "dDurationMs": 1791,
    "segs": [ {
      "utf8": "had no effect."
    } ]
  }, {
    "tStartMs": 1808760,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Cooperation was just as likely to emerge \nin a totally clustered network"
    } ]
  }, {
    "tStartMs": 1813080,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "as it was in a totally random one."
    } ]
  }, {
    "tStartMs": 1815570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Duncan] We were very\npuzzled by this result."
    } ]
  }, {
    "tStartMs": 1817970,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "And then we kind of did some more work."
    } ]
  }, {
    "tStartMs": 1820852,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "- [Derek] When Watts dug deeper,"
    } ]
  }, {
    "tStartMs": 1822587,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "he realized that the network\nstructure did matter."
    } ]
  }, {
    "tStartMs": 1824822,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "In the more clustered networks,\npeople were more likely"
    } ]
  }, {
    "tStartMs": 1827765,
    "dDurationMs": 1692,
    "segs": [ {
      "utf8": "to copy each other. "
    } ]
  }, {
    "tStartMs": 1829457,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "So if by chance someone\nstarted out cooperating,"
    } ]
  }, {
    "tStartMs": 1831830,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "then everyone would cooperate."
    } ]
  }, {
    "tStartMs": 1834260,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "But it was equally likely \nthat someone would start out by defecting,"
    } ]
  }, {
    "tStartMs": 1838010,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "in which case everyone else would defect."
    } ]
  }, {
    "tStartMs": 1840647,
    "dDurationMs": 4016,
    "segs": [ {
      "utf8": "And over all the games they played,\nthese two effects canceled each other out,"
    } ]
  }, {
    "tStartMs": 1844663,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "which is why it seemed like"
    } ]
  }, {
    "tStartMs": 1846500,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "the network structure didn't matter."
    } ]
  }, {
    "tStartMs": 1848203,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "- [Duncan] It's sort of\non a knife edge, right?"
    } ]
  }, {
    "tStartMs": 1850289,
    "dDurationMs": 4106,
    "segs": [ {
      "utf8": "Where like one person\ndoes something selfish"
    } ]
  }, {
    "tStartMs": 1854395,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "and everything goes south."
    } ]
  }, {
    "tStartMs": 1857210,
    "dDurationMs": 3131,
    "segs": [ {
      "utf8": "In another world, everybody\nkind of holds it together"
    } ]
  }, {
    "tStartMs": 1860341,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "and everything goes well."
    } ]
  }, {
    "tStartMs": 1862483,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": " It's crazy that the world"
    } ]
  }, {
    "tStartMs": 1864920,
    "dDurationMs": 1609,
    "segs": [ {
      "utf8": "could be like on a knife\nedge like that, you know,"
    } ]
  }, {
    "tStartMs": 1866529,
    "dDurationMs": 1154,
    "segs": [ {
      "utf8": "could tip one way or the other,"
    } ]
  }, {
    "tStartMs": 1867683,
    "dDurationMs": 4077,
    "segs": [ {
      "utf8": "kind of just depends on how someone\ngets out of bed that day."
    } ]
  }, {
    "tStartMs": 1871760,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "But then\nWatts realized something."
    } ]
  }, {
    "tStartMs": 1873170,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "See, in real life,"
    } ]
  }, {
    "tStartMs": 1874940,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you can choose who you hang out with."
    } ]
  }, {
    "tStartMs": 1877310,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So he reran the experiment"
    } ]
  }, {
    "tStartMs": 1878690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "allowing players to change\nwho they were playing with."
    } ]
  }, {
    "tStartMs": 1881270,
    "dDurationMs": 2272,
    "segs": [ {
      "utf8": "And this time he used\nthe prisoner's dilemma"
    } ]
  }, {
    "tStartMs": 1883542,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "so that players could easily\nidentify the defectors."
    } ]
  }, {
    "tStartMs": 1886303,
    "dDurationMs": 3697,
    "segs": [ {
      "utf8": "- [Derek] And the finding was clear,\nthe more you allowed players"
    } ]
  }, {
    "tStartMs": 1890000,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "to choose who they were playing with,"
    } ]
  }, {
    "tStartMs": 1891690,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "the more likely they were to cooperate."
    } ]
  }, {
    "tStartMs": 1893837,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- [Casper] You can make this\na lot better for yourself by just"
    } ]
  }, {
    "tStartMs": 1895910,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "acting and being decisive"
    } ]
  }, {
    "tStartMs": 1897980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and being proactive about things."
    } ]
  }, {
    "tStartMs": 1899600,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] Yeah, yeah, it's a thing I try "
    } ]
  }, {
    "tStartMs": 1900860,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "to teach my kids too, like if someone's annoying\nyou, just ignore them."
    } ]
  }, {
    "tStartMs": 1905900,
    "dDurationMs": 4527,
    "segs": [ {
      "utf8": "Like there's nothing to be gained\nby continuing to interact with people"
    } ]
  }, {
    "tStartMs": 1910427,
    "dDurationMs": 1725,
    "segs": [ {
      "utf8": "who are bringing\nnegativity into your life."
    } ]
  }, {
    "tStartMs": 1912152,
    "dDurationMs": 2748,
    "segs": [ {
      "utf8": "- [Casper] In fact, making\na choice can be powerful"
    } ]
  }, {
    "tStartMs": 1914900,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "in more than one way."
    } ]
  }, {
    "tStartMs": 1916221,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "There's\nsomething about the world"
    } ]
  }, {
    "tStartMs": 1917806,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "that makes it prone to those upheavals."
    } ]
  }, {
    "tStartMs": 1920225,
    "dDurationMs": 3996,
    "segs": [ {
      "utf8": "Meaning it's always kind of poised\non an edge of instability."
    } ]
  }, {
    "tStartMs": 1924221,
    "dDurationMs": 3724,
    "segs": [ {
      "utf8": "And that gives each of us more power\nthan you'd think we would have."
    } ]
  }, {
    "tStartMs": 1927945,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "It is actually possible\nfor individual people"
    } ]
  }, {
    "tStartMs": 1930110,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "to start movements that grow and take off."
    } ]
  }, {
    "tStartMs": 1934163,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "And ultimately, if you look at history,"
    } ]
  }, {
    "tStartMs": 1936350,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "that is what happens."
    } ]
  }, {
    "tStartMs": 1937520,
    "dDurationMs": 3741,
    "segs": [ {
      "utf8": "It's always one person who is stubborn\nand does something"
    } ]
  }, {
    "tStartMs": 1941261,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "that leads to 10 people, 1,000 people,"
    } ]
  }, {
    "tStartMs": 1944262,
    "dDurationMs": 1998,
    "segs": [ {
      "utf8": "and things change because of it."
    } ]
  }, {
    "tStartMs": 1946460,
    "dDurationMs": 2295,
    "segs": [ {
      "utf8": "It always starts with one person somehow."
    } ]
  }, {
    "tStartMs": 1948755,
    "dDurationMs": 1245,
    "segs": [ {
      "utf8": "It's the\nSteve Jobs quote, right?"
    } ]
  }, {
    "tStartMs": 1950000,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "The people who are crazy enough\nto think they can change the world"
    } ]
  }, {
    "tStartMs": 1952541,
    "dDurationMs": 1806,
    "segs": [ {
      "utf8": "are the ones who do."
    } ]
  }, {
    "tStartMs": 1954347,
    "dDurationMs": 2648,
    "segs": [ {
      "utf8": "And the wonderful thing is,\nit all starts with you"
    } ]
  }, {
    "tStartMs": 1956995,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "believing you have that power.\n- Yeah"
    } ]
  }, {
    "tStartMs": 1960358,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "Learning all about network science\nhas taught me many things,"
    } ]
  }, {
    "tStartMs": 1962971,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but perhaps the most important"
    } ]
  }, {
    "tStartMs": 1964971,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is that our networks shape us,"
    } ]
  }, {
    "tStartMs": 1966971,
    "dDurationMs": 3227,
    "segs": [ {
      "utf8": "but our actions shape the networks."
    } ]
  }, {
    "tStartMs": 1970198,
    "dDurationMs": 2954,
    "segs": [ {
      "utf8": "So choose both wisely."
    } ]
  }, {
    "tStartMs": 1980546,
    "dDurationMs": 1591,
    "segs": [ {
      "utf8": "- [Casper] Hey, if you made it this far,"
    } ]
  }, {
    "tStartMs": 1982137,
    "dDurationMs": 2375,
    "segs": [ {
      "utf8": "all the simulations we\nran through with Derek,"
    } ]
  }, {
    "tStartMs": 1984512,
    "dDurationMs": 1284,
    "segs": [ {
      "utf8": "we will actually make them available"
    } ]
  }, {
    "tStartMs": 1985796,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "on a website that you can go to\nso you can play around with them yourself."
    } ]
  }, {
    "tStartMs": 1990317,
    "dDurationMs": 1489,
    "segs": [ {
      "utf8": "So thank you so much for watching,"
    } ]
  }, {
    "tStartMs": 1991806,
    "dDurationMs": 1114,
    "segs": [ {
      "utf8": "we really appreciate it."
    } ]
  }, {
    "tStartMs": 1992920,
    "dDurationMs": 3636,
    "segs": [ {
      "utf8": "And yeah, see you for the next one."
    } ]
  } ]
}
