    } ]
  }, {
    "tStartMs": 1058710,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "Now, I sometimes get asked"
    } ]
  }, {
    "tStartMs": 1059900,
    "dDurationMs": 2150,
    "segs": [ {
