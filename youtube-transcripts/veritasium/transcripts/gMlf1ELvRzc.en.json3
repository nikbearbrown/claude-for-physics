    } ]
  }, {
    "tStartMs": 1064780,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "and the answer is because\nI don't think a video"
    } ]
  }, {
    "tStartMs": 1067410,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "is the best way to learn those skills."
    } ]
  }, {
    "tStartMs": 1069250,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The best way is to engage\nyourself in problem solving"
    } ]
  }, {
    "tStartMs": 1072340,
