    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "to watching fun educational videos."
    } ]
  }, {
    "tStartMs": 1101700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "And for viewers of this channel,"
    } ]
  }, {
    "tStartMs": 1103100,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "Brilliant are offering 20% off"
    } ]
  }, {
    "tStartMs": 1104910,
