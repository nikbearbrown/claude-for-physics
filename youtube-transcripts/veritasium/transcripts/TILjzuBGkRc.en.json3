{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 120,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- In this US Government lab,"
    } ]
  }, {
    "tStartMs": 1830,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "they study air flow to solve crimes,"
    } ]
  }, {
    "tStartMs": 5670,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "using mirrors, lights and lasers,"
    } ]
  }, {
    "tStartMs": 8310,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they can illuminate\nthe tiniest differences"
    } ]
  }, {
    "tStartMs": 10560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "in air temperature and density,"
    } ]
  }, {
    "tStartMs": 12180,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and track how drug powder\nsettles in the rooms of a house,"
    } ]
  }, {
    "tStartMs": 16020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "determine which person fired a gun,"
    } ]
  }, {
    "tStartMs": 18420,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "or spot particles escaping\nfrom a sealed package."
    } ]
  }, {
    "tStartMs": 22350,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "A portion of this video was\nsponsored by Caseta by Lutron."
    } ]
  }, {
    "tStartMs": 26670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Our best tool for picking\nup trace substances"
    } ]
  }, {
    "tStartMs": 28890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "has been the same for centuries."
    } ]
  }, {
    "tStartMs": 31440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- So it turns out nature\nhas already provided us"
    } ]
  }, {
    "tStartMs": 33840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "with the best chemical detector,"
    } ]
  }, {
    "tStartMs": 36120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and that is the dog's nose."
    } ]
  }, {
    "tStartMs": 38250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So this is Bubbles."
    } ]
  }, {
    "tStartMs": 40200,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "She's a 3D-printed,\nanatomically-correct model"
    } ]
  }, {
    "tStartMs": 43410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of a female Labrador Retriever."
    } ]
  }, {
    "tStartMs": 45210,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "We tried to get one of the\npolice canines to come in here"
    } ]
  }, {
    "tStartMs": 47640,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "and get in front of the mirror,"
    } ]
  }, {
    "tStartMs": 48510,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "but dogs get hungry and\ncranky very quickly."
    } ]
  }, {
    "tStartMs": 51210,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And we got about four\nseconds of good footage,"
    } ]
  }, {
    "tStartMs": 52950,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and I'm like, okay, we\ncan do better than this."
    } ]
  }, {
    "tStartMs": 54990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Dogs can sniff very faint scents"
    } ]
  }, {
    "tStartMs": 57330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and from far away,"
    } ]
  }, {
    "tStartMs": 58950,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but they don't do it just by breathing in."
    } ]
  }, {
    "tStartMs": 61590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "What they do is breathe out and in rapidly"
    } ]
  }, {
    "tStartMs": 64920,
    "dDurationMs": 2212,
    "segs": [ {
      "utf8": "around five times a second."
    } ]
  }, {
    "tStartMs": 67132,
    "dDurationMs": 2258,
    "segs": [ {
      "utf8": "(air whizzing)"
    } ]
  }, {
    "tStartMs": 69390,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "- What I want you to notice\nis this pulsating motion"
    } ]
  }, {
    "tStartMs": 73440,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "by the, we'll call it\nthe doggy treat, right?"
    } ]
  }, {
    "tStartMs": 77400,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "This is our doggy treat."
    } ]
  }, {
    "tStartMs": 78780,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "If you notice this pulsating motion."
    } ]
  }, {
    "tStartMs": 81240,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- And what allows them to\ndetect scents from far away"
    } ]
  }, {
    "tStartMs": 84060,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "is the rapid and turbulent exhale."
    } ]
  }, {
    "tStartMs": 87240,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- When the dog exhales,"
    } ]
  }, {
    "tStartMs": 88980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "there's a turbulent air jet\nthat comes out of each nostril,"
    } ]
  }, {
    "tStartMs": 91200,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "just like when you and I exhale."
    } ]
  }, {
    "tStartMs": 92340,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "If you put your hand under here"
    } ]
  }, {
    "tStartMs": 93210,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and just exhale outta your nose,"
    } ]
  }, {
    "tStartMs": 94620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "those are two turbulent air jets coming"
    } ]
  }, {
    "tStartMs": 96300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "out of the dog's nose."
    } ]
  }, {
    "tStartMs": 97920,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But when the dog is down on the ground,"
    } ]
  }, {
    "tStartMs": 99990,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "those air jets are vectored\nback towards its rear."
    } ]
  }, {
    "tStartMs": 103770,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The dog is pushing air back,"
    } ]
  }, {
    "tStartMs": 105990,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and when by doing that, it's\npulling air from ahead of it."
    } ]
  }, {
    "tStartMs": 109350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So imagine me, I'm blowing air this way,"
    } ]
  }, {
    "tStartMs": 112050,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and when I do that,"
    } ]
  }, {
    "tStartMs": 112883,
    "dDurationMs": 2797,
    "segs": [ {
      "utf8": "I actually reach out\nand pull air towards me."
    } ]
  }, {
    "tStartMs": 115680,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The dog reverses flow inhales, right?"
    } ]
  }, {
    "tStartMs": 119070,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Gets a new sample, analyzes it"
    } ]
  }, {
    "tStartMs": 121410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "with an amazing chemical\ndetector upstairs, right?"
    } ]
  }, {
    "tStartMs": 123720,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Its olfactory region,"
    } ]
  }, {
    "tStartMs": 125100,
    "dDurationMs": 2614,
    "segs": [ {
      "utf8": "and does it at five times a second."
    } ]
  }, {
    "tStartMs": 127714,
    "dDurationMs": 3116,
    "segs": [ {
      "utf8": "On average, a dog when it's\nsniffing for something,"
    } ]
  }, {
    "tStartMs": 130830,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "five times a second repetitive sine wave."
    } ]
  }, {
    "tStartMs": 133620,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "So that's what makes the dog"
    } ]
  }, {
    "tStartMs": 134880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "this incredible sampling system."
    } ]
  }, {
    "tStartMs": 136800,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "It kind of didn't matter the breed of dog."
    } ]
  }, {
    "tStartMs": 139266,
    "dDurationMs": 3894,
    "segs": [ {
      "utf8": "Somehow their evolution\nallowed them to figure out,"
    } ]
  }, {
    "tStartMs": 143160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "okay, one over five seconds is what I need"
    } ]
  }, {
    "tStartMs": 145560,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "before I take the next\npuff or the next inhale."
    } ]
  }, {
    "tStartMs": 148890,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "If the dog had infinite lung capacity,"
    } ]
  }, {
    "tStartMs": 151500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and it just inhaled constantly,"
    } ]
  }, {
    "tStartMs": 153360,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "it has a very limited reach."
    } ]
  }, {
    "tStartMs": 155130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But because of this in\nand out bellows effect,"
    } ]
  }, {
    "tStartMs": 158070,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "its reach goes up by\nroughly a factor of 18."
    } ]
  }, {
    "tStartMs": 161160,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "We have a number of commercially\navailable vapor detectors,"
    } ]
  }, {
    "tStartMs": 164640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "okay? Because some of\nthese are really good"
    } ]
  }, {
    "tStartMs": 166320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "for various explosives and drugs,"
    } ]
  }, {
    "tStartMs": 167880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "some are very good for chemical\nand biological hazards,"
    } ]
  }, {
    "tStartMs": 170490,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but they all just inhale air."
    } ]
  }, {
    "tStartMs": 172650,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "What we did is we designed and printed"
    } ]
  }, {
    "tStartMs": 175620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "what are essentially nostrils"
    } ]
  }, {
    "tStartMs": 177720,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that plug onto this thing\nand make it sniff like a dog."
    } ]
  }, {
    "tStartMs": 180540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And then by doing a set\nof controlled experiments,"
    } ]
  }, {
    "tStartMs": 182820,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "by moving your vapor\nsource farther and farther,"
    } ]
  }, {
    "tStartMs": 185250,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "we were able to, on average,"
    } ]
  }, {
    "tStartMs": 186720,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "improve the detection\ncapabilities of these"
    } ]
  }, {
    "tStartMs": 189510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "by roughly a factor of 16 to 18."
    } ]
  }, {
    "tStartMs": 191340,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- Whoa1"
    } ]
  }, {
    "tStartMs": 192210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Just by making them\nsniff like a real dog."
    } ]
  }, {
    "tStartMs": 194880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- We're able to see this dog breath"
    } ]
  }, {
    "tStartMs": 196890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "using Schlieren imaging."
    } ]
  }, {
    "tStartMs": 198840,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I've actually done a video on this before."
    } ]
  }, {
    "tStartMs": 201210,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- This is an automotive headlamp."
    } ]
  }, {
    "tStartMs": 202920,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "After that, I have a condenser lens,"
    } ]
  }, {
    "tStartMs": 205050,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "so it takes this light and\nfocuses it down to a point."
    } ]
  }, {
    "tStartMs": 208950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So from there our light diverges,"
    } ]
  }, {
    "tStartMs": 211830,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and it comes up and it fills our mirror."
    } ]
  }, {
    "tStartMs": 213840,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Think of these light\nbeams as arrows, okay?"
    } ]
  }, {
    "tStartMs": 217230,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And there are a bunch of\narrows that are coming up,"
    } ]
  }, {
    "tStartMs": 218730,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "they're straight as can be,"
    } ]
  }, {
    "tStartMs": 220230,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but when they pass something"
    } ]
  }, {
    "tStartMs": 222300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of a different refractive index,"
    } ]
  }, {
    "tStartMs": 224370,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "which could be the heat from my hand,"
    } ]
  }, {
    "tStartMs": 226620,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "or a different density,"
    } ]
  }, {
    "tStartMs": 227490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which could be a gas\nof a different density,"
    } ]
  }, {
    "tStartMs": 230370,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "those light rays, they shift a little bit,"
    } ]
  }, {
    "tStartMs": 233610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "they shift very slightly, okay?"
    } ]
  }, {
    "tStartMs": 235290,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They refract, they bend."
    } ]
  }, {
    "tStartMs": 237210,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Then they all come back."
    } ]
  }, {
    "tStartMs": 239910,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "So we're coming back here,"
    } ]
  }, {
    "tStartMs": 240897,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "and right here we have a two-way mirror."
    } ]
  }, {
    "tStartMs": 243720,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So light can travel through\nthe mirror this way,"
    } ]
  }, {
    "tStartMs": 246630,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "but when it comes back,\nit turns 90 degrees."
    } ]
  }, {
    "tStartMs": 250020,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And if you look right\nhere, I have a razor blade."
    } ]
  }, {
    "tStartMs": 253110,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And what this is doing,"
    } ]
  }, {
    "tStartMs": 254460,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "it is positioned exactly at\nthe focal point of that mirror."
    } ]
  }, {
    "tStartMs": 258120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I have that razor blade edge,"
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "it's able to move in and\nout of the focal plane."
    } ]
  }, {
    "tStartMs": 262890,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "And so what I do is I cut\noff those arrows of light,"
    } ]
  }, {
    "tStartMs": 267480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "those beams of light that\nshifted a little bit,"
    } ]
  }, {
    "tStartMs": 270240,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and I cut 'em off, I block 'em."
    } ]
  }, {
    "tStartMs": 271950,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "As I move the knife edge out,"
    } ]
  }, {
    "tStartMs": 275250,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "so I'm not cutting off\nany light right now,"
    } ]
  }, {
    "tStartMs": 277370,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "so you basically have a\nreally expensive mirror,"
    } ]
  }, {
    "tStartMs": 279420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "it's not doing anything for you."
    } ]
  }, {
    "tStartMs": 281130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But as I take this razor blade,"
    } ]
  }, {
    "tStartMs": 283440,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and push it in,"
    } ]
  }, {
    "tStartMs": 284970,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "you start to see, you know,\nturbulence in the air,"
    } ]
  }, {
    "tStartMs": 288390,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and as I take it more and\nmore, yeah, there you go,"
    } ]
  }, {
    "tStartMs": 290070,
    "dDurationMs": 1451,
    "segs": [ {
      "utf8": "get your hand in there."
    } ]
  }, {
    "tStartMs": 291521,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "- Whoa, your Schlieren setup is"
    } ]
  }, {
    "tStartMs": 294120,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "so much better than mine."
    } ]
  }, {
    "tStartMs": 298170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So take a look at this."
    } ]
  }, {
    "tStartMs": 299003,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "So this is in a Shadowgraph system."
    } ]
  }, {
    "tStartMs": 300990,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Wow.\n- So it's Schlieren's"
    } ]
  }, {
    "tStartMs": 302520,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "little brother, okay?"
    } ]
  }, {
    "tStartMs": 303978,
    "dDurationMs": 1512,
    "segs": [ {
      "utf8": "It's not a Schlieren\nsystem, but it's very close,"
    } ]
  }, {
    "tStartMs": 305490,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "a Shadowgraph."
    } ]
  }, {
    "tStartMs": 306570,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Shadowgraph is not as sensitive, okay?"
    } ]
  }, {
    "tStartMs": 309330,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But it's easier to build."
    } ]
  }, {
    "tStartMs": 311310,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Look, we have a flashlight\nand a white wall,"
    } ]
  }, {
    "tStartMs": 312750,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and we're already seeing\na shadowgraph there."
    } ]
  }, {
    "tStartMs": 313583,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "- So why does this work?"
    } ]
  }, {
    "tStartMs": 316140,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- What's happening is we have light,"
    } ]
  }, {
    "tStartMs": 318210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "it's not as focused as I would like,"
    } ]
  }, {
    "tStartMs": 319770,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "but the more focus, the better."
    } ]
  }, {
    "tStartMs": 322440,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "The light's coming up this way,"
    } ]
  }, {
    "tStartMs": 323610,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "it's passing through a hot\nflame of a different density"
    } ]
  }, {
    "tStartMs": 327480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and refractive index,"
    } ]
  }, {
    "tStartMs": 329190,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and we're basically casting\na shadow of that plume"
    } ]
  }, {
    "tStartMs": 332820,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "on the wall, which is why\nit's called a Shadowgraph."
    } ]
  }, {
    "tStartMs": 336270,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- These can still be used\nto visualize flow patterns"
    } ]
  }, {
    "tStartMs": 339120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in detail."
    } ]
  }, {
    "tStartMs": 340320,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Just by looking at the\nfootage of guns fired"
    } ]
  }, {
    "tStartMs": 342690,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "in a Shadowgraph,"
    } ]
  }, {
    "tStartMs": 343680,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "we can actually figure out\nthe speed of the bullet"
    } ]
  }, {
    "tStartMs": 345870,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and how loud the bang was."
    } ]
  }, {
    "tStartMs": 348750,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- And there's our bullet whizzing off,"
    } ]
  }, {
    "tStartMs": 351750,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "it is supersonic because it\nhas a very small bow shock."
    } ]
  }, {
    "tStartMs": 356370,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You see it there?"
    } ]
  }, {
    "tStartMs": 357203,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "- Yep.\n- Very, very small."
    } ]
  }, {
    "tStartMs": 358170,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So it's, you know, roughly\nwhat Mach 1.05 maybe,"
    } ]
  }, {
    "tStartMs": 361440,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "just above sonic."
    } ]
  }, {
    "tStartMs": 362850,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Compare that to the\ninfamous AK47 assault rifle."
    } ]
  }, {
    "tStartMs": 368340,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "There's two things that we can\nqualitatively observe here."
    } ]
  }, {
    "tStartMs": 371490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "One is, if you compare these side to side,"
    } ]
  }, {
    "tStartMs": 373920,
    "dDurationMs": 2308,
    "segs": [ {
      "utf8": "the Smith \u0026 Wesson versus the AK47,"
    } ]
  }, {
    "tStartMs": 376228,
    "dDurationMs": 3422,
    "segs": [ {
      "utf8": "the darkness of this line is different."
    } ]
  }, {
    "tStartMs": 379650,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "This is a quieter firearm,"
    } ]
  }, {
    "tStartMs": 382080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "it's not as loud,"
    } ]
  }, {
    "tStartMs": 382913,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "the report is not as loud.\n- Because"
    } ]
  }, {
    "tStartMs": 384120,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "it's less pronounced."
    } ]
  }, {
    "tStartMs": 385170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Matt] It's less pronounced, yep."
    } ]
  }, {
    "tStartMs": 387090,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- The hot gases released"
    } ]
  }, {
    "tStartMs": 388530,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "when the gun is fired expand outwards,"
    } ]
  }, {
    "tStartMs": 390960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "creating a shockwave."
    } ]
  }, {
    "tStartMs": 393000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Across this shock,"
    } ]
  }, {
    "tStartMs": 394440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "the pressure, temperature,"
    } ]
  }, {
    "tStartMs": 395880,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and density of the air changes rapidly."
    } ]
  }, {
    "tStartMs": 398790,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And the bigger that change,\nthe darker this shows up"
    } ]
  }, {
    "tStartMs": 401820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "in the Shadowgraph."
    } ]
  }, {
    "tStartMs": 403110,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So you can get a sense of how loud it is"
    } ]
  }, {
    "tStartMs": 405000,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "by how dark that shock appears."
    } ]
  }, {
    "tStartMs": 407790,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "- And then here we see our\nbullet whizzing off at about,"
    } ]
  }, {
    "tStartMs": 411960,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "oh gosh, Mach two,"
    } ]
  }, {
    "tStartMs": 413070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- two and a half,\n- It's like"
    } ]
  }, {
    "tStartMs": 413903,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "two, three degrees, right?"
    } ]
  }, {
    "tStartMs": 414870,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- You could actually measure that"
    } ]
  }, {
    "tStartMs": 416070,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and calculate the Mach number."
    } ]
  }, {
    "tStartMs": 417840,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Any object moving"
    } ]
  }, {
    "tStartMs": 418800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "through air creates pressure\nwaves that travel out"
    } ]
  }, {
    "tStartMs": 421380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "at the speed of sound."
    } ]
  }, {
    "tStartMs": 422820,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Since this bullet is moving\nfaster than the speed of sound,"
    } ]
  }, {
    "tStartMs": 425970,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "the pressure waves it creates\nall get compressed together"
    } ]
  }, {
    "tStartMs": 429510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "into a single conical shock wave."
    } ]
  }, {
    "tStartMs": 432390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It's like a tiny sonic boom."
    } ]
  }, {
    "tStartMs": 435630,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And you can use this to determine\nthe speed of the bullet."
    } ]
  }, {
    "tStartMs": 438600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The sine of the angle is the\nratio of the speed of sound"
    } ]
  }, {
    "tStartMs": 442500,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "to the speed of the object."
    } ]
  }, {
    "tStartMs": 445500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "There is a different\nway to visualize flow,"
    } ]
  }, {
    "tStartMs": 447780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which is with a laser sheet."
    } ]
  }, {
    "tStartMs": 450000,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It illuminates fine particles."
    } ]
  }, {
    "tStartMs": 452010,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So we can see the plumes of\ngun powder residue created"
    } ]
  }, {
    "tStartMs": 455640,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "when a gun is fired."
    } ]
  }, {
    "tStartMs": 457530,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- We call this laser light sheet."
    } ]
  }, {
    "tStartMs": 459570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And the reason is, okay,\nso now our light's there,"
    } ]
  }, {
    "tStartMs": 461550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I can barely see it because I\nhave laser safety glasses on."
    } ]
  }, {
    "tStartMs": 463890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Yep. I can only see it in the camera."
    } ]
  }, {
    "tStartMs": 465630,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "- Yeah, so what's happening\nhere is we have a laser beam,"
    } ]
  }, {
    "tStartMs": 470100,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and we send it, we steer it\nthrough a cylindrical glass rod."
    } ]
  }, {
    "tStartMs": 474390,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "All it is, is a piece of\nglass that's a cylinder."
    } ]
  }, {
    "tStartMs": 476790,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And what that does is it spreads that beam"
    } ]
  }, {
    "tStartMs": 480150,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "into a two-dimensional\nwall of laser light. Okay?"
    } ]
  }, {
    "tStartMs": 483810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And so the way this works is"
    } ]
  }, {
    "tStartMs": 485760,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "whenever particles or theatrical fog cross"
    } ]
  }, {
    "tStartMs": 490950,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "through this sheet, they\nlight up because of the laser."
    } ]
  }, {
    "tStartMs": 494550,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "There's a lot of effort now going"
    } ]
  }, {
    "tStartMs": 495930,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "into understanding gunshot residue."
    } ]
  }, {
    "tStartMs": 498030,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So gunshot residue is the kind of burned"
    } ]
  }, {
    "tStartMs": 501090,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and unburned propellant that occurs"
    } ]
  }, {
    "tStartMs": 504570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "whenever a firearm is discharged, right?"
    } ]
  }, {
    "tStartMs": 506550,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So what we're looking at\nhere is using laser lights"
    } ]
  }, {
    "tStartMs": 509580,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and high speed cameras,"
    } ]
  }, {
    "tStartMs": 510720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "is we're looking at the\nplume of gunshot residue"
    } ]
  }, {
    "tStartMs": 513720,
    "dDurationMs": 3683,
    "segs": [ {
      "utf8": "that's generated after a firing event."
    } ]
  }, {
    "tStartMs": 517403,
    "dDurationMs": 1507,
    "segs": [ {
      "utf8": "This is looking at ventilation"
    } ]
  }, {
    "tStartMs": 518910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "inside an actual gun range."
    } ]
  }, {
    "tStartMs": 520230,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But look at all this."
    } ]
  }, {
    "tStartMs": 521550,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "This is all gunshot\nresidue that you can't see"
    } ]
  }, {
    "tStartMs": 523560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "with the naked eye, but is there,"
    } ]
  }, {
    "tStartMs": 525840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "so you can imagine if\nyou're inside a home,"
    } ]
  }, {
    "tStartMs": 527460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "this is five shots in a few seconds."
    } ]
  }, {
    "tStartMs": 529740,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Enormous amounts of material."
    } ]
  }, {
    "tStartMs": 531660,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "A lot of this is landing on\nthe hands of the shooter,"
    } ]
  }, {
    "tStartMs": 534570,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but unfortunately a lot of\nit is also being dispersed"
    } ]
  }, {
    "tStartMs": 537450,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "into the local environment."
    } ]
  }, {
    "tStartMs": 539790,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "- It goes way farther than I expected."
    } ]
  }, {
    "tStartMs": 543360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- So the question is, can we differentiate"
    } ]
  }, {
    "tStartMs": 546210,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "between something that's\nactually been done by the shooter"
    } ]
  }, {
    "tStartMs": 550410,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and something, say, by a\nbystander that walked in"
    } ]
  }, {
    "tStartMs": 552750,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "two minutes later?"
    } ]
  }, {
    "tStartMs": 553890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So that this is what we're actively trying"
    } ]
  }, {
    "tStartMs": 555810,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to pursue right now."
    } ]
  }, {
    "tStartMs": 557520,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So these are tools and techniques\nthat we use here at NIST"
    } ]
  }, {
    "tStartMs": 561540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that are qualitative or\nsometimes semi-quantitative,"
    } ]
  }, {
    "tStartMs": 564540,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "but they really help\nillustrate what's happening."
    } ]
  }, {
    "tStartMs": 568980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And then the public security part of this,"
    } ]
  }, {
    "tStartMs": 571380,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "deals with trace contraband detection."
    } ]
  }, {
    "tStartMs": 573810,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "We're all generating heat, right?"
    } ]
  }, {
    "tStartMs": 576120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So we all have this warm plume\nof air. You wanna see it?"
    } ]
  }, {
    "tStartMs": 578250,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I'll show you. It's kind of crazy."
    } ]
  }, {
    "tStartMs": 581370,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "So you seeing it there?"
    } ]
  }, {
    "tStartMs": 583410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So that is called the human thermal plume."
    } ]
  }, {
    "tStartMs": 585870,
    "dDurationMs": 2507,
    "segs": [ {
      "utf8": "And guess what's in that plume?"
    } ]
  }, {
    "tStartMs": 588377,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "- Water?"
    } ]
  }, {
    "tStartMs": 589830,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "- Parts of me. Skin cells."
    } ]
  }, {
    "tStartMs": 593010,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- No way.\n- Yeah."
    } ]
  }, {
    "tStartMs": 594360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So we're shedding skin cells\nat a pretty creepy rate."
    } ]
  }, {
    "tStartMs": 597210,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I forget what the number\nis, but it's a lot."
    } ]
  }, {
    "tStartMs": 598860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Thousands an hour-ish."
    } ]
  }, {
    "tStartMs": 600750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So we are shedding these\nskin cells constantly,"
    } ]
  }, {
    "tStartMs": 603510,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and it's actually not\nnecessarily a bad thing"
    } ]
  }, {
    "tStartMs": 607050,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "from a trace detection standpoint."
    } ]
  }, {
    "tStartMs": 609540,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- What do you mean?"
    } ]
  }, {
    "tStartMs": 610620,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- Well, whenever we are\ntalking about trace detection,"
    } ]
  }, {
    "tStartMs": 613590,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "whether it's drugs or explosives,"
    } ]
  }, {
    "tStartMs": 615450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it's all based on this\nfundamental principle,"
    } ]
  }, {
    "tStartMs": 618000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "it's called Locard's Exchange Principle."
    } ]
  }, {
    "tStartMs": 620580,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It's in forensic science."
    } ]
  }, {
    "tStartMs": 621660,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It's that every contact leaves a trace."
    } ]
  }, {
    "tStartMs": 625260,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And what that means is when\nyou're done in this lab,"
    } ]
  }, {
    "tStartMs": 627450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "there will be parts of you\nleft behind in this lab,"
    } ]
  }, {
    "tStartMs": 629580,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "whether you like it or not, right?"
    } ]
  }, {
    "tStartMs": 631050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "'Cause we're all shedding\nskin cells and taking things,"
    } ]
  }, {
    "tStartMs": 633270,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "and taking stuff with us."
    } ]
  }, {
    "tStartMs": 634200,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "So if I'm a bomb maker, if\nI'm involved in manufacturing,"
    } ]
  }, {
    "tStartMs": 638670,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you know, illegal fentanyl in my basement,"
    } ]
  }, {
    "tStartMs": 641670,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "I am ultimately contaminating\nmyself with the bulk material."
    } ]
  }, {
    "tStartMs": 646050,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And this contamination comes"
    } ]
  }, {
    "tStartMs": 647370,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "in the form of very, very small particles."
    } ]
  }, {
    "tStartMs": 649920,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And the chemical detection systems"
    } ]
  }, {
    "tStartMs": 652290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that we have available\nnow are so sensitive,"
    } ]
  }, {
    "tStartMs": 655320,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "they can detect a single particle of say,"
    } ]
  }, {
    "tStartMs": 658980,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "an explosive residue."
    } ]
  }, {
    "tStartMs": 662760,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "Imagine you have a bomb\nin a package, right?"
    } ]
  }, {
    "tStartMs": 667710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And you're at some kind of\nscreening facility, right?"
    } ]
  }, {
    "tStartMs": 669990,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "You're at a facility"
    } ]
  }, {
    "tStartMs": 671490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that maybe is screening things\ncoming in from overseas,"
    } ]
  }, {
    "tStartMs": 673920,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "maybe you've got a sniffer,"
    } ]
  }, {
    "tStartMs": 675060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "you've got a commercially\navailable vapor detector,"
    } ]
  }, {
    "tStartMs": 677790,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and you've got 10 seconds\nto sample this package."
    } ]
  }, {
    "tStartMs": 681090,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Where do you point your device, right?"
    } ]
  }, {
    "tStartMs": 683940,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "These are the kinds of experiments"
    } ]
  }, {
    "tStartMs": 685380,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "that help us understand where\nyou should point your device."
    } ]
  }, {
    "tStartMs": 688860,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "We call this burping."
    } ]
  }, {
    "tStartMs": 690120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "We're burping the package."
    } ]
  }, {
    "tStartMs": 691680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So we have some acetone in here."
    } ]
  }, {
    "tStartMs": 693120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So wherever you burp it,\nwhere you squeeze it,"
    } ]
  }, {
    "tStartMs": 695370,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "you have acetone vapor coming\nout of all the gaps, right?"
    } ]
  }, {
    "tStartMs": 699840,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "So they're coming out in the gaps,"
    } ]
  }, {
    "tStartMs": 700770,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "so that gap gives you the highest chance"
    } ]
  }, {
    "tStartMs": 704850,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "of actually detecting\nwhat's inside, right?"
    } ]
  }, {
    "tStartMs": 708510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "You don't want to go over\nhere where there's no gaps."
    } ]
  }, {
    "tStartMs": 710340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "You don't want to go up\nthere where there's no gap."
    } ]
  }, {
    "tStartMs": 711870,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "You want to go in these corners here,"
    } ]
  }, {
    "tStartMs": 713370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "where stuff is actually\nkind of permeating through"
    } ]
  }, {
    "tStartMs": 715710,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and outside of the box."
    } ]
  }, {
    "tStartMs": 717600,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "This is some recent work we're doing."
    } ]
  }, {
    "tStartMs": 719610,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "We are basically simulating\nillicit drug manufacturing."
    } ]
  }, {
    "tStartMs": 724710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So here's some talc powder, right?"
    } ]
  }, {
    "tStartMs": 727380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "No big deal. I'm gonna\nshake it up a little bit."
    } ]
  }, {
    "tStartMs": 729540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "When I open this and squeeze,"
    } ]
  }, {
    "tStartMs": 732300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I can't see anything,"
    } ]
  }, {
    "tStartMs": 733890,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but are you seeing anything in the camera?"
    } ]
  }, {
    "tStartMs": 735180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 737310,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- So again, to the naked eye,"
    } ]
  }, {
    "tStartMs": 738360,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "we'd never be able to see this."
    } ]
  }, {
    "tStartMs": 740010,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But because the laser is\ndoing the illuminating for us,"
    } ]
  }, {
    "tStartMs": 743340,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "we're able to see this."
    } ]
  }, {
    "tStartMs": 748680,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Let's do a little experiment"
    } ]
  }, {
    "tStartMs": 750030,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "where I am taking illegal substance A"
    } ]
  }, {
    "tStartMs": 752760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and pouring it into substance B."
    } ]
  }, {
    "tStartMs": 755340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "First thing I'll do,"
    } ]
  }, {
    "tStartMs": 756900,
    "dDurationMs": 2468,
    "segs": [ {
      "utf8": "just watch when I take\nthe lid off of this."
    } ]
  }, {
    "tStartMs": 759368,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 769440,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "Take it from here."
    } ]
  }, {
    "tStartMs": 773850,
    "dDurationMs": 976,
    "segs": [ {
      "utf8": "- There is a little bit coming off,"
    } ]
  }, {
    "tStartMs": 774826,
    "dDurationMs": 944,
    "segs": [ {
      "utf8": "yeah.\n- A little bit?"
    } ]
  }, {
    "tStartMs": 775770,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh yeah."
    } ]
  }, {
    "tStartMs": 776603,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It's still going."
    } ]
  }, {
    "tStartMs": 779160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- So just imagine, you're in a basement,"
    } ]
  }, {
    "tStartMs": 782040,
    "dDurationMs": 1197,
    "segs": [ {
      "utf8": "and you're building stuff like this,"
    } ]
  }, {
    "tStartMs": 783237,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "and you don't realize that there's all"
    } ]
  }, {
    "tStartMs": 785940,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "this contamination spreading and landing"
    } ]
  }, {
    "tStartMs": 787620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "on other surfaces in your room."
    } ]
  }, {
    "tStartMs": 790260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And I can't talk about the numbers,"
    } ]
  }, {
    "tStartMs": 791580,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but they're pretty startling."
    } ]
  }, {
    "tStartMs": 793950,
    "dDurationMs": 1056,
    "segs": [ {
      "utf8": "- Like there's a lot."
    } ]
  }, {
    "tStartMs": 795006,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- There's a lot.\n- It spreads everywhere."
    } ]
  }, {
    "tStartMs": 795839,
    "dDurationMs": 1114,
    "segs": [ {
      "utf8": "- There's a lot, yeah."
    } ]
  }, {
    "tStartMs": 798463,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 802326,
    "dDurationMs": 3174,
    "segs": [ {
      "utf8": "This thing's going to be full of smoke in here. You ready?"
    } ]
  }, {
    "tStartMs": 805500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 807307,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 812460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "What I really love about\nthe laser sheet technique is"
    } ]
  }, {
    "tStartMs": 815280,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "it allows you to visualize the\nturbulence that's in the air."
    } ]
  }, {
    "tStartMs": 819000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Matt] So this is a way\nwe can see how the air flow"
    } ]
  }, {
    "tStartMs": 821130,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "in the room is actually being tracked."
    } ]
  }, {
    "tStartMs": 824040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh, that's nice."
    } ]
  }, {
    "tStartMs": 824873,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Matt] Yep."
    } ]
  }, {
    "tStartMs": 833490,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "If you look at the\ngraph and the top right,"
    } ]
  }, {
    "tStartMs": 835200,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "that is actually real-time\ncounts of the particles"
    } ]
  }, {
    "tStartMs": 839310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that are being generated\naround this person."
    } ]
  }, {
    "tStartMs": 841320,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "So that plot represents\nbasically inhalation exposure"
    } ]
  }, {
    "tStartMs": 846270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of the materials that he's working with."
    } ]
  }, {
    "tStartMs": 848190,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That's crazy, if you think about,"
    } ]
  }, {
    "tStartMs": 849390,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "'cause if that's fentanyl,"
    } ]
  }, {
    "tStartMs": 851370,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and that person doesn't have\na mask on, they're gone."
    } ]
  }, {
    "tStartMs": 854310,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We add fluorescent powder\nto this kind of stuff,"
    } ]
  }, {
    "tStartMs": 856560,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "so we can actually visualize\nwhere the contamination goes."
    } ]
  }, {
    "tStartMs": 860670,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "The other cool part of this is"
    } ]
  }, {
    "tStartMs": 862140,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that we can use a quantitative method"
    } ]
  }, {
    "tStartMs": 864870,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of sampling surfaces in the house."
    } ]
  }, {
    "tStartMs": 866760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We basically use swabbing."
    } ]
  }, {
    "tStartMs": 868440,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And it's the same idea\nwhen you go to the airport."
    } ]
  }, {
    "tStartMs": 870210,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Have you ever gone there\nand they ask for your hands?"
    } ]
  }, {
    "tStartMs": 871800,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Yeah.\n- Right? And they take"
    } ]
  }, {
    "tStartMs": 872850,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "a little swab and they wipe your hands."
    } ]
  }, {
    "tStartMs": 874560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "What they're doing is they're looking"
    } ]
  }, {
    "tStartMs": 875760,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "for these trace amounts\nof explosive particles"
    } ]
  }, {
    "tStartMs": 878910,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that could be on you if you were involved"
    } ]
  }, {
    "tStartMs": 881520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "in the manufacture of\nan explosive device."
    } ]
  }, {
    "tStartMs": 883830,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "But that's a drone."
    } ]
  }, {
    "tStartMs": 885390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That's looking at a drone."
    } ]
  }, {
    "tStartMs": 886223,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "And the question is, 'cause you know,"
    } ]
  }, {
    "tStartMs": 888030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you get this cool prop wash,"
    } ]
  }, {
    "tStartMs": 889770,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "and these four propellers"
    } ]
  }, {
    "tStartMs": 890730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that are are all\ninteracting with each other."
    } ]
  }, {
    "tStartMs": 892380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So the question is, can\nwe use the fluid dynamics"
    } ]
  }, {
    "tStartMs": 895440,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of a drone to do the sampling for us?"
    } ]
  }, {
    "tStartMs": 898680,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "And here's what I mean by that."
    } ]
  }, {
    "tStartMs": 899700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If there is a suspected, you know,"
    } ]
  }, {
    "tStartMs": 901980,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "manufacturing facility of something,"
    } ]
  }, {
    "tStartMs": 904530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "say it's a methamphetamine or fentanyl,"
    } ]
  }, {
    "tStartMs": 906690,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "you know, it's very, very expensive"
    } ]
  }, {
    "tStartMs": 909180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to get Hazmat crews involved."
    } ]
  }, {
    "tStartMs": 911460,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Have them come, they have to\ngown up, they have to go in,"
    } ]
  }, {
    "tStartMs": 913920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to a potential really dangerous situation."
    } ]
  }, {
    "tStartMs": 916320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "What if we had a drone?"
    } ]
  }, {
    "tStartMs": 919080,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "We just flew the drone in, right?"
    } ]
  }, {
    "tStartMs": 921630,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "It buzzes around and it's got\nsome special kind of collector"
    } ]
  }, {
    "tStartMs": 924600,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "on the belly of the drone\nand we're using the prop wash"
    } ]
  }, {
    "tStartMs": 928320,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "of the drone to stir up\nparticles off of a surface,"
    } ]
  }, {
    "tStartMs": 931320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and then somehow inhale\nthem, collect them."
    } ]
  }, {
    "tStartMs": 933540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The drone comes back to base,"
    } ]
  }, {
    "tStartMs": 935070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you run your chemical analysis, you say,"
    } ]
  }, {
    "tStartMs": 936660,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "okay, the house is clean,"
    } ]
  }, {
    "tStartMs": 937890,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "or no, we found stuff."
    } ]
  }, {
    "tStartMs": 939360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Okay, now it's time to pull\nout the Hazmat crew. You know?"
    } ]
  }, {
    "tStartMs": 942210,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So the big-picture idea\nthat I want you to keep"
    } ]
  }, {
    "tStartMs": 944250,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in the back of your head the whole time is"
    } ]
  }, {
    "tStartMs": 946440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "this idea of public safety and security."
    } ]
  }, {
    "tStartMs": 949320,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So that's really what happens in this lab."
    } ]
  }, {
    "tStartMs": 951810,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But underneath that kind of umbrella term,"
    } ]
  }, {
    "tStartMs": 955110,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "think mask research."
    } ]
  }, {
    "tStartMs": 957180,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So when the Covid pandemic hit,"
    } ]
  }, {
    "tStartMs": 958920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "we kind of switched gears in\nhere to try to address some"
    } ]
  }, {
    "tStartMs": 962040,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "of the issues related to masks."
    } ]
  }, {
    "tStartMs": 964950,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "This thing will actually\nbreathe as a human does,"
    } ]
  }, {
    "tStartMs": 967920,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that human happens to be me."
    } ]
  }, {
    "tStartMs": 969330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So I measured my own\nkind of breathing rate,"
    } ]
  }, {
    "tStartMs": 971160,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and then built a system,"
    } ]
  }, {
    "tStartMs": 972720,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "kinda engineered a pneumatic\nsystem that replicates that,"
    } ]
  }, {
    "tStartMs": 976050,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "but it also has a fog\nmachine, a fog generator."
    } ]
  }, {
    "tStartMs": 979470,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So this thing basically just\nlooks like it took a drag off"
    } ]
  }, {
    "tStartMs": 982080,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "of a cigarette and exhaled."
    } ]
  }, {
    "tStartMs": 983730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "What's kind of cool with this is"
    } ]
  }, {
    "tStartMs": 985380,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "it looks like there's nothing\ncoming through, right?"
    } ]
  }, {
    "tStartMs": 987810,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But there is millions and millions"
    } ]
  }, {
    "tStartMs": 988980,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of particles trying to make it through."
    } ]
  }, {
    "tStartMs": 991350,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Some do, 'cause it's not 100%."
    } ]
  }, {
    "tStartMs": 993510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So I wrote an image-processing code."
    } ]
  }, {
    "tStartMs": 996060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So you take this information,\nyou plug it into a code,"
    } ]
  }, {
    "tStartMs": 998730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and it analyzes,"
    } ]
  }, {
    "tStartMs": 1000350,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "based on pixels and it's\ncounting white pixels,"
    } ]
  }, {
    "tStartMs": 1003350,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and sure enough, if you use an N95,"
    } ]
  }, {
    "tStartMs": 1006170,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "you put an N95 on here,"
    } ]
  }, {
    "tStartMs": 1007400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you run it through an\nimage processing code,"
    } ]
  }, {
    "tStartMs": 1010040,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "guess what percentage of\npixels light up white?"
    } ]
  }, {
    "tStartMs": 1013850,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "- 5%?"
    } ]
  }, {
    "tStartMs": 1014710,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- 5%."
    } ]
  }, {
    "tStartMs": 1016430,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Okay.\n- Now I just want you"
    } ]
  }, {
    "tStartMs": 1017330,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "to breathe naturally."
    } ]
  }, {
    "tStartMs": 1021560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So when you're inhaling, it gets dark."
    } ]
  }, {
    "tStartMs": 1024260,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And when you're exhaling, it gets lighter,"
    } ]
  }, {
    "tStartMs": 1026030,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "because the air is being\nwarmed by your lungs"
    } ]
  }, {
    "tStartMs": 1028760,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and then coming back out."
    } ]
  }, {
    "tStartMs": 1030410,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Like it's interesting\nhow fast you can see"
    } ]
  }, {
    "tStartMs": 1032690,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "the effect of the breathing in,"
    } ]
  }, {
    "tStartMs": 1035602,
    "dDurationMs": 2245,
    "segs": [ {
      "utf8": "like just makes it go dark so quickly."
    } ]
  }, {
    "tStartMs": 1037847,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "- But that shows me that,"
    } ]
  }, {
    "tStartMs": 1040108,
    "dDurationMs": 1372,
    "segs": [ {
      "utf8": "like this now doesn't change color at all."
    } ]
  }, {
    "tStartMs": 1041480,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "So this is being used\nto seal versus filter."
    } ]
  }, {
    "tStartMs": 1046268,
    "dDurationMs": 3132,
    "segs": [ {
      "utf8": "I notice the color\nchange is a lot more dramatic."
    } ]
  }, {
    "tStartMs": 1049400,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1050233,
    "dDurationMs": 1254,
    "segs": [ {
      "utf8": "- With this, you know, it was in and out."
    } ]
  }, {
    "tStartMs": 1051487,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "- I feel like that's\na thinner mask, right?"
    } ]
  }, {
    "tStartMs": 1054830,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Matt] Yeah. So the\nheat transfer-through,"
    } ]
  }, {
    "tStartMs": 1056120,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "it is gonna be greater."
    } ]
  }, {
    "tStartMs": 1060200,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- I feel like there's a lot coming out"
    } ]
  }, {
    "tStartMs": 1061610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "over the top.\n- There is, yeah,"
    } ]
  }, {
    "tStartMs": 1062443,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "there's a lot."
    } ]
  }, {
    "tStartMs": 1063320,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If you just breathe naturally,"
    } ]
  }, {
    "tStartMs": 1065840,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "you'll see a lot coming out there."
    } ]
  }, {
    "tStartMs": 1073490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- The thing with masks, right, is like,"
    } ]
  }, {
    "tStartMs": 1075170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "initially they were\nlike, masks don't work,"
    } ]
  }, {
    "tStartMs": 1077690,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "don't wear a mask."
    } ]
  }, {
    "tStartMs": 1079250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And then they were like, masks do work,"
    } ]
  }, {
    "tStartMs": 1081530,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "like, and wear a cloth mask,"
    } ]
  }, {
    "tStartMs": 1083000,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "and then they were like, no,\nno cloth masks don't work,"
    } ]
  }, {
    "tStartMs": 1084973,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "like, I don't know, there\nwas a lot of confusion"
    } ]
  }, {
    "tStartMs": 1087170,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "around masks."
    } ]
  }, {
    "tStartMs": 1088340,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "- What we learned early on\nwas that the communication of,"
    } ]
  }, {
    "tStartMs": 1092870,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "you know, mask effectiveness\ncould have been improved,"
    } ]
  }, {
    "tStartMs": 1096500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "right? And so that's kind\nof why I did what we did"
    } ]
  }, {
    "tStartMs": 1098570,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "with the Schlieren."
    } ]
  }, {
    "tStartMs": 1099710,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "The truth is, the average\nAmerican is not gonna sit down"
    } ]
  }, {
    "tStartMs": 1102740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and read a scientific journal article."
    } ]
  }, {
    "tStartMs": 1104720,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "But they will sit down and\nwatch a 90-second video"
    } ]
  }, {
    "tStartMs": 1109190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of me coughing with a mask on and off."
    } ]
  }, {
    "tStartMs": 1111590,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "And that's what we did."
    } ]
  }, {
    "tStartMs": 1115970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's kind of a unique relationship we have"
    } ]
  }, {
    "tStartMs": 1117890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "with other federal agencies here."
    } ]
  }, {
    "tStartMs": 1119630,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So you have a three-letter\nagency that has a specific need"
    } ]
  }, {
    "tStartMs": 1122300,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "for something, right?"
    } ]
  }, {
    "tStartMs": 1123320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "In the security arena."
    } ]
  }, {
    "tStartMs": 1126140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "What they'll often do is\nthey'll come here to NIST,"
    } ]
  }, {
    "tStartMs": 1128570,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and they'll say,"
    } ]
  }, {
    "tStartMs": 1129403,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "hey, we're really interested\nin sampling people's shoes"
    } ]
  }, {
    "tStartMs": 1131660,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for explosives for whatever reason, right?"
    } ]
  }, {
    "tStartMs": 1133790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So what we do here, and\nin this lab in particular,"
    } ]
  }, {
    "tStartMs": 1136400,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "is we figure out what are\nsome good ways to sample shoes"
    } ]
  }, {
    "tStartMs": 1139820,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for explosives?"
    } ]
  }, {
    "tStartMs": 1141470,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "What are some not so good ways, right?"
    } ]
  }, {
    "tStartMs": 1143903,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "What do the measurements need to look like"
    } ]
  }, {
    "tStartMs": 1147230,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to evaluate a shoe-sampling system"
    } ]
  }, {
    "tStartMs": 1149900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that doesn't even exist yet?"
    } ]
  }, {
    "tStartMs": 1151100,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And then what do the\nstandards need to look like"
    } ]
  }, {
    "tStartMs": 1153950,
    "dDurationMs": 2217,
    "segs": [ {
      "utf8": "that support those measurements, right?"
    } ]
  }, {
    "tStartMs": 1156167,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "And so we figure all this\nstuff out in the lab,"
    } ]
  }, {
    "tStartMs": 1158930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "package it up nice and neat,"
    } ]
  }, {
    "tStartMs": 1160580,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "give it back to the sponsoring agency,"
    } ]
  }, {
    "tStartMs": 1162230,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and then they take it to industry."
    } ]
  }, {
    "tStartMs": 1164810,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "And industry already has a\nleg up on the development"
    } ]
  }, {
    "tStartMs": 1168440,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "of these kinds of systems,"
    } ]
  }, {
    "tStartMs": 1169460,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "because we did a lot of the\nheavy lifting here in the lab."
    } ]
  }, {
    "tStartMs": 1172610,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Because with the success of, you know,"
    } ]
  }, {
    "tStartMs": 1175520,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "doing the Covid-related visualization,"
    } ]
  }, {
    "tStartMs": 1178490,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "we're realizing now that\nthe application space"
    } ]
  }, {
    "tStartMs": 1180590,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "for this kind of technology is huge."
    } ]
  }, {
    "tStartMs": 1183620,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Indoor air quality."
    } ]
  }, {
    "tStartMs": 1185240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "You can imagine a bigger\nmirror where we could look"
    } ]
  }, {
    "tStartMs": 1187340,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "at two people interacting with each other,"
    } ]
  }, {
    "tStartMs": 1189650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and what that transfer looks like"
    } ]
  }, {
    "tStartMs": 1191660,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "from one person to the other."
    } ]
  }, {
    "tStartMs": 1192980,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The take-home message\nis flow visualization"
    } ]
  }, {
    "tStartMs": 1196040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "is a critical tool that\nwe use here at NIST"
    } ]
  }, {
    "tStartMs": 1198740,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to really help understand\nwhat's happening, right?"
    } ]
  }, {
    "tStartMs": 1201860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "It's one thing to do quantitative analysis"
    } ]
  }, {
    "tStartMs": 1204080,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "on various surfaces, but now we can see,"
    } ]
  }, {
    "tStartMs": 1206690,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "we can actually see what's happening,"
    } ]
  }, {
    "tStartMs": 1208250,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and where these particles are generated."
    } ]
  }, {
    "tStartMs": 1213350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- Thanks to Lutron for\nsponsoring this portion"
    } ]
  }, {
    "tStartMs": 1215360,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "of this video."
    } ]
  }, {
    "tStartMs": 1217100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Perfect lighting isn't just important"
    } ]
  }, {
    "tStartMs": 1218900,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "for visualizing air flow,"
    } ]
  }, {
    "tStartMs": 1220490,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it's also essential for making\nyour house feel welcoming,"
    } ]
  }, {
    "tStartMs": 1223550,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "cozy and safe."
    } ]
  }, {
    "tStartMs": 1224870,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And with the sponsor of this\nvideo, Caseta by Lutron,"
    } ]
  }, {
    "tStartMs": 1227540,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "you can easily set up\nyour own perfect lighting."
    } ]
  }, {
    "tStartMs": 1230600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "You know, Caseta provides\npremium smart lighting control,"
    } ]
  }, {
    "tStartMs": 1233090,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "including switches, remotes\nand plug-in smart dimmers,"
    } ]
  }, {
    "tStartMs": 1236060,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "which allow you to\ncustomize your home lighting"
    } ]
  }, {
    "tStartMs": 1238130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "from anywhere in the house."
    } ]
  }, {
    "tStartMs": 1240140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "What I love about smart switches is"
    } ]
  }, {
    "tStartMs": 1242030,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that one switch can\ncontrol many regular bulbs."
    } ]
  }, {
    "tStartMs": 1244760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So you can effectively\nmake all your bulbs smart"
    } ]
  }, {
    "tStartMs": 1246950,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "just by replacing the switch."
    } ]
  }, {
    "tStartMs": 1248870,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And installation is easy."
    } ]
  }, {
    "tStartMs": 1251000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "First, make sure you turn\noff power to the switch,"
    } ]
  }, {
    "tStartMs": 1253400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and then disconnect the existing wires,"
    } ]
  }, {
    "tStartMs": 1255410,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and connect them to Caseta's Smart Switch."
    } ]
  }, {
    "tStartMs": 1258080,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "If you need any help, they're\njust a click or a call away."
    } ]
  }, {
    "tStartMs": 1261740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And then with the Smart Hub,"
    } ]
  }, {
    "tStartMs": 1263240,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "you can turn your lights on\nand off just using your phone."
    } ]
  }, {
    "tStartMs": 1266210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Or you can use another device,"
    } ]
  }, {
    "tStartMs": 1267440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "like Alexa or Google Assistant."
    } ]
  }, {
    "tStartMs": 1270080,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Caseta works with more smart home brands"
    } ]
  }, {
    "tStartMs": 1272420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "than any other smart\nlighting control system."
    } ]
  }, {
    "tStartMs": 1275120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Plus their switches don't rely on Wi-Fi,"
    } ]
  }, {
    "tStartMs": 1277580,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "so they always stay connected,"
    } ]
  }, {
    "tStartMs": 1278750,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and you always have\ncontrol over your lights."
    } ]
  }, {
    "tStartMs": 1281690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I personally like setting\ntimers in my house,"
    } ]
  }, {
    "tStartMs": 1284000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for example the lights\nin my office turn on"
    } ]
  }, {
    "tStartMs": 1286130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "by themselves in the evening."
    } ]
  }, {
    "tStartMs": 1287510,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And this gives me peace of mind"
    } ]
  }, {
    "tStartMs": 1288890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that my family will always\ncome home to a well-lit house."
    } ]
  }, {
    "tStartMs": 1291830,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And the best part of it all\nis if I'm already in bed,"
    } ]
  }, {
    "tStartMs": 1295100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I can just check which\nlights are still on,"
    } ]
  }, {
    "tStartMs": 1297350,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and turn them off without\nhaving to run around the house."
    } ]
  }, {
    "tStartMs": 1300320,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Learn more about Caseta at\ncasetawireless.com/veritasium."
    } ]
  }, {
    "tStartMs": 1304820,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "Thanks to Lutron for sponsoring\nthat part of my video."
    } ]
  } ]
}
