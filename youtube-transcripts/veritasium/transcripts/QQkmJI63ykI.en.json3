{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- The 1918 Nobel Prize for Chemistry"
    } ]
  }, {
    "tStartMs": 2820,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "is probably the most important\nNobel Prize ever awarded."
    } ]
  }, {
    "tStartMs": 7260,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It was given to German\nscientist Fritz Haber"
    } ]
  }, {
    "tStartMs": 10260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "for solving one of the biggest problems"
    } ]
  }, {
    "tStartMs": 12600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "humanity has ever faced."
    } ]
  }, {
    "tStartMs": 14940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "His invention is directly responsible"
    } ]
  }, {
    "tStartMs": 17670,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "for the lives of 4 billion people today."
    } ]
  }, {
    "tStartMs": 22140,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But when he received his prize,"
    } ]
  }, {
    "tStartMs": 24510,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "many of his peers refused to attend."
    } ]
  }, {
    "tStartMs": 27960,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Two other Nobel Prize winners"
    } ]
  }, {
    "tStartMs": 29580,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "rejected their awards in protest"
    } ]
  }, {
    "tStartMs": 32010,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and the New York Times wrote\na scathing article about him."
    } ]
  }, {
    "tStartMs": 36210,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "He is simultaneously one\nof the most impactful"
    } ]
  }, {
    "tStartMs": 39870,
    "dDurationMs": 3384,
    "segs": [ {
      "utf8": "and tragic scientists of all time."
    } ]
  }, {
    "tStartMs": 43254,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "(dramatic orchestral music)"
    } ]
  }, {
    "tStartMs": 45990,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Perhaps more than any other single person,"
    } ]
  }, {
    "tStartMs": 48450,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "he has shaped the world we live in today."
    } ]
  }, {
    "tStartMs": 52032,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "(dramatic orchestral music)"
    } ]
  }, {
    "tStartMs": 57387,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 63270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "If you are an American citizen"
    } ]
  }, {
    "tStartMs": 65430,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and you find an island with\na lot of bird poop on it,"
    } ]
  }, {
    "tStartMs": 68700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "well then you can claim that island"
    } ]
  }, {
    "tStartMs": 70920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "for the United States and\nthe US will have your back."
    } ]
  }, {
    "tStartMs": 74700,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "The president is authorized to\nsend in the Navy and the Army"
    } ]
  }, {
    "tStartMs": 78630,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "to defend your newly\ndiscovered poop-covered island."
    } ]
  }, {
    "tStartMs": 82740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "There are currently 10 American islands"
    } ]
  }, {
    "tStartMs": 85080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that were claimed in this way."
    } ]
  }, {
    "tStartMs": 87810,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And even though the law\nthat made this possible"
    } ]
  }, {
    "tStartMs": 90810,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "was passed in 1856,"
    } ]
  }, {
    "tStartMs": 93480,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "it is still in effect to this day."
    } ]
  }, {
    "tStartMs": 97230,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So, why did people want\npoop-covered islands so badly?"
    } ]
  }, {
    "tStartMs": 102233,
    "dDurationMs": 3217,
    "segs": [ {
      "utf8": "(birds chirping)\n(\"The Blue Danube\")"
    } ]
  }, {
    "tStartMs": 105450,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "There are a few dozen\nislands off the coast of Peru"
    } ]
  }, {
    "tStartMs": 108360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "where millions of seabirds gather to mate"
    } ]
  }, {
    "tStartMs": 111480,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and the waters near the\nisland are full of fish,"
    } ]
  }, {
    "tStartMs": 114660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and these millions of birds eat the fish,"
    } ]
  }, {
    "tStartMs": 117960,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "and then they poop,"
    } ]
  }, {
    "tStartMs": 120510,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "a lot."
    } ]
  }, {
    "tStartMs": 122227,
    "dDurationMs": 953,
    "segs": [ {
      "utf8": "(\"The Blue Danube\")"
    } ]
  }, {
    "tStartMs": 123180,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Since the region is hot and dry,"
    } ]
  }, {
    "tStartMs": 125310,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "this poop solidifies and\naccumulates over millennia."
    } ]
  }, {
    "tStartMs": 129810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "There are cliffs of bird poop"
    } ]
  }, {
    "tStartMs": 131880,
    "dDurationMs": 3818,
    "segs": [ {
      "utf8": "30 meters or a hundred feet high."
    } ]
  }, {
    "tStartMs": 135698,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(\"The Blue Danube\")"
    } ]
  }, {
    "tStartMs": 141180,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "And technically bird poop is called guano"
    } ]
  }, {
    "tStartMs": 143790,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and by the mid 1800s,"
    } ]
  }, {
    "tStartMs": 145800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "buying and selling bird\nguano was big business."
    } ]
  }, {
    "tStartMs": 149160,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "The price rose as high as $76 per pound"
    } ]
  }, {
    "tStartMs": 153510,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "meaning you could trade\nfour pounds of guano"
    } ]
  }, {
    "tStartMs": 156420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "for one pound of gold."
    } ]
  }, {
    "tStartMs": 158910,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So, why was there such a\nbig market for bird poop?"
    } ]
  }, {
    "tStartMs": 162540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Well, to answer that"
    } ]
  }, {
    "tStartMs": 163740,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "we have to look inside the human body."
    } ]
  }, {
    "tStartMs": 168630,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "By weight, most of our\nbodies are made up of"
    } ]
  }, {
    "tStartMs": 171360,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "oxygen, carbon, and hydrogen."
    } ]
  }, {
    "tStartMs": 174420,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But the fourth most common\nelement is nitrogen."
    } ]
  }, {
    "tStartMs": 178380,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Nitrogen is part of the amino\nacids that form proteins."
    } ]
  }, {
    "tStartMs": 182340,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It's part of hemoglobin,"
    } ]
  }, {
    "tStartMs": 183660,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the compound that carries\noxygen in red blood cells"
    } ]
  }, {
    "tStartMs": 186420,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and it's a central\ncomponent of DNA and RNA."
    } ]
  }, {
    "tStartMs": 190680,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Nitrogen is essential\nfor all life on earth."
    } ]
  }, {
    "tStartMs": 195060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "We get our nitrogen by eating plants"
    } ]
  }, {
    "tStartMs": 197820,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or animals which have eaten plants,"
    } ]
  }, {
    "tStartMs": 200490,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "and plants get their\nnitrogen from the soil."
    } ]
  }, {
    "tStartMs": 204630,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "The problem is if you farm\nthe same soil year after year,"
    } ]
  }, {
    "tStartMs": 208920,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "you harvest the nitrogen out of it"
    } ]
  }, {
    "tStartMs": 211680,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and eventually there isn't enough nitrogen"
    } ]
  }, {
    "tStartMs": 213810,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for healthy plants to grow."
    } ]
  }, {
    "tStartMs": 215940,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "They can't produce enough\nchlorophyll to photosynthesize"
    } ]
  }, {
    "tStartMs": 219210,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which stunts their growth."
    } ]
  }, {
    "tStartMs": 221610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Their leaves turn yellow"
    } ]
  }, {
    "tStartMs": 223020,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and they are more susceptible\nto pests and disease."
    } ]
  }, {
    "tStartMs": 226440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Crucially, for farmers,"
    } ]
  }, {
    "tStartMs": 228090,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "nitrogen deficiency means smaller yields."
    } ]
  }, {
    "tStartMs": 232230,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "The way to fix this is to add\nnitrogen back into the soil"
    } ]
  }, {
    "tStartMs": 236520,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "which is where bird guano comes in."
    } ]
  }, {
    "tStartMs": 239710,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "(rhythmic music)"
    } ]
  }, {
    "tStartMs": 240630,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Guano is up to 20% nitrogen."
    } ]
  }, {
    "tStartMs": 244110,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Hundreds of years ago,\nIncan farmers realized"
    } ]
  }, {
    "tStartMs": 246960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that adding guano to their\nsoil made crops grow taller."
    } ]
  }, {
    "tStartMs": 250560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is what allowed them to grow food"
    } ]
  }, {
    "tStartMs": 252600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "in places that were previously unfarmable"
    } ]
  }, {
    "tStartMs": 255060,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and expand their empire."
    } ]
  }, {
    "tStartMs": 258780,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "South America's rich deposits of bird poop"
    } ]
  }, {
    "tStartMs": 261150,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "did not go unnoticed by\nthe rest of the world."
    } ]
  }, {
    "tStartMs": 264000,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "In 1865, Spain went to war\nagainst its former colonies"
    } ]
  }, {
    "tStartMs": 267870,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "of Peru, Chile, Ecuador, and Bolivia"
    } ]
  }, {
    "tStartMs": 270690,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "for control of their guano-laden islands."
    } ]
  }, {
    "tStartMs": 274650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But such was the world's\nappetite for nitrogen"
    } ]
  }, {
    "tStartMs": 276840,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "that by 1872 guano was running out"
    } ]
  }, {
    "tStartMs": 280710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and Peru banned further exports."
    } ]
  }, {
    "tStartMs": 283320,
    "dDurationMs": 4312,
    "segs": [ {
      "utf8": "The world would need another\nway to get its nitrogen fix."
    } ]
  }, {
    "tStartMs": 287632,
    "dDurationMs": 2468,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 290100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This was a crisis."
    } ]
  }, {
    "tStartMs": 292080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "William Crooks, a British chemist,"
    } ]
  }, {
    "tStartMs": 293940,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "made a dire prophecy in 1898."
    } ]
  }, {
    "tStartMs": 297090,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "With the world's growing population"
    } ]
  }, {
    "tStartMs": 298920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and dwindling supplies of nitrogen,"
    } ]
  }, {
    "tStartMs": 301590,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "he said, \"We stand in deadly peril"
    } ]
  }, {
    "tStartMs": 304410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of not having enough to eat.\""
    } ]
  }, {
    "tStartMs": 306210,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "In less than 30 years time, he argued,"
    } ]
  }, {
    "tStartMs": 308790,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "people all over the world\nwill be dying of starvation,"
    } ]
  }, {
    "tStartMs": 313320,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "but he also proposed a solution."
    } ]
  }, {
    "tStartMs": 316507,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "\"It is the chemist who\nmust come to the rescue."
    } ]
  }, {
    "tStartMs": 319890,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "It is through the laboratory"
    } ]
  }, {
    "tStartMs": 321360,
    "dDurationMs": 3717,
    "segs": [ {
      "utf8": "that starvation may ultimately\nbe turned into plenty.\""
    } ]
  }, {
    "tStartMs": 327150,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Because here's the thing,\nnitrogen isn't rare,"
    } ]
  }, {
    "tStartMs": 330750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "it's common."
    } ]
  }, {
    "tStartMs": 332100,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "78% of the air is nitrogen"
    } ]
  }, {
    "tStartMs": 335970,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "but it's in a form that\nplants and animals can't use."
    } ]
  }, {
    "tStartMs": 339600,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "Two atoms of nitrogen\ntriple bonded together."
    } ]
  }, {
    "tStartMs": 344370,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This bond is one of the\nstrongest in nature."
    } ]
  }, {
    "tStartMs": 348210,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The way to measure the\nstrength of a chemical bond"
    } ]
  }, {
    "tStartMs": 350460,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "is by the amount of energy\nthat's required to break it."
    } ]
  }, {
    "tStartMs": 353910,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, to break apart two\nchlorine atoms, for example,"
    } ]
  }, {
    "tStartMs": 356910,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "would take 2 1/2 electron volts."
    } ]
  }, {
    "tStartMs": 360150,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "To break apart two\ncarbons requires 3.8 eV."
    } ]
  }, {
    "tStartMs": 364470,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Two oxygens, 5.2 eV."
    } ]
  }, {
    "tStartMs": 367650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But to break apart two atoms of nitrogen"
    } ]
  }, {
    "tStartMs": 370440,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "requires 9.8 electron volts,\na tremendous amount of energy."
    } ]
  }, {
    "tStartMs": 376739,
    "dDurationMs": 2911,
    "segs": [ {
      "utf8": "(models clattering)"
    } ]
  }, {
    "tStartMs": 379650,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I just want to interject to say"
    } ]
  }, {
    "tStartMs": 381210,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that the molecular models in this video"
    } ]
  }, {
    "tStartMs": 383040,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "were actually invented by me."
    } ]
  }, {
    "tStartMs": 385410,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "These are Snatoms, a product I kickstarted"
    } ]
  }, {
    "tStartMs": 388470,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "about eight years ago"
    } ]
  }, {
    "tStartMs": 390090,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "where all the atoms snapped\ntogether magnetically."
    } ]
  }, {
    "tStartMs": 393840,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So, you can feel the\nattraction between atoms"
    } ]
  }, {
    "tStartMs": 397410,
    "dDurationMs": 2226,
    "segs": [ {
      "utf8": "and hear the energy released"
    } ]
  }, {
    "tStartMs": 399636,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(atoms clicks)"
    } ]
  }, {
    "tStartMs": 400469,
    "dDurationMs": 1111,
    "segs": [ {
      "utf8": "when bonds form."
    } ]
  }, {
    "tStartMs": 401580,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The resulting molecules look and behave"
    } ]
  }, {
    "tStartMs": 404340,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "more like real molecules"
    } ]
  }, {
    "tStartMs": 406350,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and they are quicker and\neasier to form and break apart."
    } ]
  }, {
    "tStartMs": 410100,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Snatoms are for sale on\nAmazon and snatoms.com."
    } ]
  }, {
    "tStartMs": 413940,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So, I will put some links\ndown in the description."
    } ]
  }, {
    "tStartMs": 417330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Now, this video is a repost."
    } ]
  }, {
    "tStartMs": 420060,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The original upload got\nover 14 million views"
    } ]
  }, {
    "tStartMs": 423000,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "and then suddenly it was\nage-restricted and demonetized."
    } ]
  }, {
    "tStartMs": 427410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But I think it's a really good video,"
    } ]
  }, {
    "tStartMs": 429510,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "so we're reposting it with\nthe offending section removed."
    } ]
  }, {
    "tStartMs": 433380,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It's a reminder that\nyou can't always count"
    } ]
  }, {
    "tStartMs": 435570,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "on YouTube monetization."
    } ]
  }, {
    "tStartMs": 437310,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, if you want to support these videos,"
    } ]
  }, {
    "tStartMs": 439650,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "please consider purchasing Snatoms"
    } ]
  }, {
    "tStartMs": 441450,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "if you want some or\nsupporting us on Patreon."
    } ]
  }, {
    "tStartMs": 444510,
    "dDurationMs": 4435,
    "segs": [ {
      "utf8": "And now back to splitting\nnitrogen molecules."
    } ]
  }, {
    "tStartMs": 448945,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "(models clattering)"
    } ]
  }, {
    "tStartMs": 451158,
    "dDurationMs": 1782,
    "segs": [ {
      "utf8": "(thunder claps)"
    } ]
  }, {
    "tStartMs": 452940,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "There are two processes\nthat do this naturally."
    } ]
  }, {
    "tStartMs": 457140,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Lightning releases so much energy,"
    } ]
  }, {
    "tStartMs": 459870,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "it breaks apart in two into\nindividual nitrogen atoms."
    } ]
  }, {
    "tStartMs": 464430,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "They then quickly react\nto form nitrogen oxides"
    } ]
  }, {
    "tStartMs": 468570,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and these molecules stay in the atmosphere"
    } ]
  }, {
    "tStartMs": 471420,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "until they react with\nwater droplets in clouds"
    } ]
  }, {
    "tStartMs": 474690,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and fall to the ground in rain."
    } ]
  }, {
    "tStartMs": 477600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "There are also a few types\nof bacteria living in soil"
    } ]
  }, {
    "tStartMs": 480780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that can break the N2 bond"
    } ]
  }, {
    "tStartMs": 482940,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "using a tremendous amount\nof energy to do so,"
    } ]
  }, {
    "tStartMs": 486480,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and they make nitrogen\navailable for plants."
    } ]
  }, {
    "tStartMs": 490020,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But bacteria only replenish\nthe nitrogen slowly"
    } ]
  }, {
    "tStartMs": 493500,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and there's not enough lightning"
    } ]
  }, {
    "tStartMs": 495060,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "to produce nitrogen compounds at scale."
    } ]
  }, {
    "tStartMs": 497610,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, chemists tried."
    } ]
  }, {
    "tStartMs": 500040,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "In 1811, Georg Hildebrandt\nmixed nitrogen and hydrogen"
    } ]
  }, {
    "tStartMs": 504270,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "in a sealed flask trying to make ammonia,"
    } ]
  }, {
    "tStartMs": 507600,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "one of the nitrogen-containing\nmolecules found in guano."
    } ]
  }, {
    "tStartMs": 512130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "When that didn't work,\nhe submerged the flask"
    } ]
  }, {
    "tStartMs": 515070,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "300 meters underwater\nto increase the pressure"
    } ]
  }, {
    "tStartMs": 518940,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and that didn't work either,"
    } ]
  }, {
    "tStartMs": 520350,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but he was on the right track."
    } ]
  }, {
    "tStartMs": 522930,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Increasingly sophisticated\nversions of these experiments"
    } ]
  }, {
    "tStartMs": 525750,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "were carried out over the\nfollowing hundred years."
    } ]
  }, {
    "tStartMs": 528810,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "All of them failed."
    } ]
  }, {
    "tStartMs": 532050,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So, when Fritz Haber became"
    } ]
  }, {
    "tStartMs": 533610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "interested in this problem in 1904,"
    } ]
  }, {
    "tStartMs": 536010,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "he was joining a long\nline of failed chemists."
    } ]
  }, {
    "tStartMs": 539970,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "He was 36 years old, working\nas a low level academic"
    } ]
  }, {
    "tStartMs": 543630,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "at the University of Karlsruhe."
    } ]
  }, {
    "tStartMs": 546000,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "He was also a new father"
    } ]
  }, {
    "tStartMs": 547710,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "with a two-year-old boy named\nHerman and a wife, Clara,"
    } ]
  }, {
    "tStartMs": 551370,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "who was one of the first women\nto get a PhD in chemistry."
    } ]
  }, {
    "tStartMs": 555660,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Driven by pride and competition\nwith another scientist,"
    } ]
  }, {
    "tStartMs": 558990,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Haber spent five years on the problem."
    } ]
  }, {
    "tStartMs": 561990,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "His idea was to combine\nnitrogen and hydrogen"
    } ]
  }, {
    "tStartMs": 565140,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "not only at high pressure,\nbut also at high temperature,"
    } ]
  }, {
    "tStartMs": 569310,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and in the presence of a catalyst,"
    } ]
  }, {
    "tStartMs": 571230,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "something that lowers the amount of energy"
    } ]
  }, {
    "tStartMs": 573300,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "required to split diatomic nitrogen."
    } ]
  }, {
    "tStartMs": 576630,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "To do this, new experimental\napparatus had to be invented."
    } ]
  }, {
    "tStartMs": 580740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Haber worked tirelessly on this project"
    } ]
  }, {
    "tStartMs": 583500,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "building equipment that could tolerate"
    } ]
  }, {
    "tStartMs": 585210,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "ever higher temperatures and pressures."
    } ]
  }, {
    "tStartMs": 588180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "He also got lucky."
    } ]
  }, {
    "tStartMs": 590100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "At the time he was moonlighting\nas a technical consultant"
    } ]
  }, {
    "tStartMs": 593100,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "for a light bulb manufacturer."
    } ]
  }, {
    "tStartMs": 595440,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So, there he had access"
    } ]
  }, {
    "tStartMs": 597180,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to lots of really hard to find materials."
    } ]
  }, {
    "tStartMs": 600420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Like the element osmium."
    } ]
  }, {
    "tStartMs": 602520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Osmium is rare."
    } ]
  }, {
    "tStartMs": 604200,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "In his day, there was\nonly about 100 kilograms"
    } ]
  }, {
    "tStartMs": 607260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of the refined metal in existence"
    } ]
  }, {
    "tStartMs": 609750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but the company he worked\nfor was experimenting"
    } ]
  }, {
    "tStartMs": 612180,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "with using it for filaments\nin their light bulbs."
    } ]
  }, {
    "tStartMs": 614910,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So, they had most of the world's supply."
    } ]
  }, {
    "tStartMs": 618450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Haber suspected it might\nmake the perfect catalyst"
    } ]
  }, {
    "tStartMs": 621930,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "so he brought a sample back to his lab."
    } ]
  }, {
    "tStartMs": 625440,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And there in the third week of March 1909,"
    } ]
  }, {
    "tStartMs": 628500,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "Haber placed his sheet of\nosmium in the pressure chamber"
    } ]
  }, {
    "tStartMs": 632550,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and then he pressurized\nand heated the nitrogen"
    } ]
  }, {
    "tStartMs": 635160,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and hydrogen to 200 atmospheres\nand 500 degrees Celsius."
    } ]
  }, {
    "tStartMs": 640650,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Under these conditions, the\ntriple bonds broke apart"
    } ]
  }, {
    "tStartMs": 645030,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and nitrogen reacted with hydrogen."
    } ]
  }, {
    "tStartMs": 648120,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Of the total gas mixture,\n6% turned into ammonia."
    } ]
  }, {
    "tStartMs": 653550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "When the gas was cooled,"
    } ]
  }, {
    "tStartMs": 655200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "one milliliter of ammonia dripped out"
    } ]
  }, {
    "tStartMs": 657420,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "the end of a narrow tube into a beaker."
    } ]
  }, {
    "tStartMs": 660870,
    "dDurationMs": 3427,
    "segs": [ {
      "utf8": "An elated Haber rushed from\none lab to another, yelling,"
    } ]
  }, {
    "tStartMs": 664297,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "\"Come on down."
    } ]
  }, {
    "tStartMs": 665730,
    "dDurationMs": 1227,
    "segs": [ {
      "utf8": "There's ammonia.\""
    } ]
  }, {
    "tStartMs": 668130,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Germany's biggest chemical company, BASF,"
    } ]
  }, {
    "tStartMs": 671310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "commercialized Haber's process."
    } ]
  }, {
    "tStartMs": 673410,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Within four years, they had\nopened a factory in Oppau"
    } ]
  }, {
    "tStartMs": 676560,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "producing five tons of ammonia per day."
    } ]
  }, {
    "tStartMs": 679941,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "(\"Symphony No. 9 in D Minor\")"
    } ]
  }, {
    "tStartMs": 683040,
    "dDurationMs": 3074,
    "segs": [ {
      "utf8": "People spoke of making bread from the air."
    } ]
  }, {
    "tStartMs": 686114,
    "dDurationMs": 3016,
    "segs": [ {
      "utf8": "(\"Symphony No. 9 in D Minor\")"
    } ]
  }, {
    "tStartMs": 689130,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "With the fertilizer from\nthis industrial process"
    } ]
  }, {
    "tStartMs": 691920,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "on the same plot of land,"
    } ]
  }, {
    "tStartMs": 693630,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "farmers were able to grow\nfour times as much food"
    } ]
  }, {
    "tStartMs": 697260,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "and as a result, the population\nof the earth quadrupled."
    } ]
  }, {
    "tStartMs": 701910,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "There's a good chance you owe your life"
    } ]
  }, {
    "tStartMs": 704460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to Haber's invention."
    } ]
  }, {
    "tStartMs": 706290,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The Earth supports 4\nbillion more people today"
    } ]
  }, {
    "tStartMs": 709710,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "than it could without nitrogen fertilizer."
    } ]
  }, {
    "tStartMs": 713550,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "In fact, around 50% of the\nnitrogen atoms in your body"
    } ]
  }, {
    "tStartMs": 718380,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "came from the Haber process."
    } ]
  }, {
    "tStartMs": 720993,
    "dDurationMs": 2637,
    "segs": [ {
      "utf8": "(wheat rustling)"
    } ]
  }, {
    "tStartMs": 723630,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The invention made Fritz\nHaber a wealthy man."
    } ]
  }, {
    "tStartMs": 727050,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "He got a promotion becoming\nthe founding director"
    } ]
  }, {
    "tStartMs": 730080,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "of the Kaiser Wilhelm Institute"
    } ]
  }, {
    "tStartMs": 731730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "for Physical Chemistry in Berlin."
    } ]
  }, {
    "tStartMs": 734610,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "He also befriended some of\nthe best scientists of his day"
    } ]
  }, {
    "tStartMs": 737880,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "including Max Planck, Max\nBorn, and Albert Einstein."
    } ]
  }, {
    "tStartMs": 742530,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "After Einstein separated\nfrom his first wife in 1914,"
    } ]
  }, {
    "tStartMs": 746340,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "he stayed the night at Haber's house."
    } ]
  }, {
    "tStartMs": 749610,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But if Haber was so well-regarded,"
    } ]
  }, {
    "tStartMs": 752700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "why was he shunned by colleagues"
    } ]
  }, {
    "tStartMs": 754890,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "when he won the Nobel Prize?"
    } ]
  }, {
    "tStartMs": 757800,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "Well, it all comes down to\nwhat happened in World War I."
    } ]
  }, {
    "tStartMs": 763470,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "When the war broke out,"
    } ]
  }, {
    "tStartMs": 765000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Haber volunteered for military duty."
    } ]
  }, {
    "tStartMs": 768120,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Unlike pacifist Einstein\nwho denounced the war,"
    } ]
  }, {
    "tStartMs": 771210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Haber was a patriot."
    } ]
  }, {
    "tStartMs": 773010,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "He wanted to use his\nexpertise to help his country."
    } ]
  }, {
    "tStartMs": 777300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Only a few months into the war,"
    } ]
  }, {
    "tStartMs": 779370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the German army was already"
    } ]
  }, {
    "tStartMs": 781080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "running out of gunpowder and explosives."
    } ]
  }, {
    "tStartMs": 784080,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Ammonium nitrate, besides\nbeing an excellent fertilizer,"
    } ]
  }, {
    "tStartMs": 787530,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is also an explosive."
    } ]
  }, {
    "tStartMs": 789810,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "Just look at what happened\nin Beirut in August of 2020."
    } ]
  }, {
    "tStartMs": 795323,
    "dDurationMs": 2164,
    "segs": [ {
      "utf8": "(explosion booming)"
    } ]
  }, {
    "tStartMs": 797487,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "(crowd screaming)"
    } ]
  }, {
    "tStartMs": 799530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "A warehouse containing almost 3,000 tons"
    } ]
  }, {
    "tStartMs": 802920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of ammonium nitrate caught fire."
    } ]
  }, {
    "tStartMs": 805560,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "And in the extreme heat,\nthe fertilizer detonated."
    } ]
  }, {
    "tStartMs": 809970,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "The blast which could be heard\nhundreds of kilometers away"
    } ]
  }, {
    "tStartMs": 813960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "killed at least 217 people"
    } ]
  }, {
    "tStartMs": 816720,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and injured thousands more."
    } ]
  }, {
    "tStartMs": 819060,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Seismometers registered\nan artificial earthquake"
    } ]
  }, {
    "tStartMs": 822090,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "measuring 3.3 on the Richter scale."
    } ]
  }, {
    "tStartMs": 825090,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "This is just one of many\nfertilizer-related explosions."
    } ]
  }, {
    "tStartMs": 829500,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "The Oppau plant where Haber's process"
    } ]
  }, {
    "tStartMs": 832110,
    "dDurationMs": 4293,
    "segs": [ {
      "utf8": "was first put into practice\nwould also explode in 1921."
    } ]
  }, {
    "tStartMs": 837780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And the reason is nitrogen."
    } ]
  }, {
    "tStartMs": 840210,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We've already seen that\nit takes a tremendous"
    } ]
  }, {
    "tStartMs": 842940,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "amount of energy to break\napart nitrogen's triple bond."
    } ]
  }, {
    "tStartMs": 846930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But the flip side of that coin"
    } ]
  }, {
    "tStartMs": 848730,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is that when two nitrogen\natoms come together"
    } ]
  }, {
    "tStartMs": 850830,
    "dDurationMs": 1431,
    "segs": [ {
      "utf8": "and form that bond,"
    } ]
  }, {
    "tStartMs": 852261,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(atoms clicks)"
    } ]
  }, {
    "tStartMs": 853094,
    "dDurationMs": 3826,
    "segs": [ {
      "utf8": "a huge amount of energy is released."
    } ]
  }, {
    "tStartMs": 856920,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The explosions of gunpowder,\nTNT, nitroglycerin,"
    } ]
  }, {
    "tStartMs": 860460,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and ammonium nitrate all form"
    } ]
  }, {
    "tStartMs": 863340,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "diatomic nitrogen gas as a product."
    } ]
  }, {
    "tStartMs": 866250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And the formation of that triple bond"
    } ]
  }, {
    "tStartMs": 868530,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is where these chemicals derive"
    } ]
  }, {
    "tStartMs": 870630,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "much of their explosive energy."
    } ]
  }, {
    "tStartMs": 874530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Haber lobbied to convert the factories"
    } ]
  }, {
    "tStartMs": 876870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "using his process to make\nammonia for fertilizer"
    } ]
  }, {
    "tStartMs": 879660,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "to create nitrate for explosives instead."
    } ]
  }, {
    "tStartMs": 884040,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "His superiors believed such a\nconversion to be impossible,"
    } ]
  }, {
    "tStartMs": 887640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but Haber persisted,"
    } ]
  }, {
    "tStartMs": 889140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and soon his chemical process"
    } ]
  }, {
    "tStartMs": 891450,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "was at the heart of\nthe German war machine."
    } ]
  }, {
    "tStartMs": 894840,
    "dDurationMs": 4773,
    "segs": [ {
      "utf8": "From bread out of the air\nto bombs out of the air."
    } ]
  }, {
    "tStartMs": 901208,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "(gun popping)"
    } ]
  }, {
    "tStartMs": 903930,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But Haber thought chemistry could make"
    } ]
  }, {
    "tStartMs": 905790,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "an even bigger contribution to the war."
    } ]
  }, {
    "tStartMs": 908490,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "In December 1914, he witnessed\na chemical weapons test."
    } ]
  }, {
    "tStartMs": 912600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "He was unimpressed."
    } ]
  }, {
    "tStartMs": 915090,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Haber believed that he could do better."
    } ]
  }, {
    "tStartMs": 917850,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "He set out to make a gas"
    } ]
  }, {
    "tStartMs": 919410,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that was deadly at low concentrations"
    } ]
  }, {
    "tStartMs": 922170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and heavier than air"
    } ]
  }, {
    "tStartMs": 924120,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "so it would sink into enemy trenches."
    } ]
  }, {
    "tStartMs": 927570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Projectiles carrying\nchemical weapons were banned,"
    } ]
  }, {
    "tStartMs": 930300,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "at least in theory, by the\nHague Convention of 1899."
    } ]
  }, {
    "tStartMs": 934710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But in practice after\nthe start of the war,"
    } ]
  }, {
    "tStartMs": 936990,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Germany, France, and Britain"
    } ]
  }, {
    "tStartMs": 938640,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "all experimented with chemical weapons."
    } ]
  }, {
    "tStartMs": 942090,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Haber converted his wing of the institute"
    } ]
  }, {
    "tStartMs": 944520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "into a chemical weapons laboratory"
    } ]
  }, {
    "tStartMs": 946890,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and after only a few months of work,"
    } ]
  }, {
    "tStartMs": 949050,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "he zeroed in on chlorine gas."
    } ]
  }, {
    "tStartMs": 952410,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "An employee, Otto Hahn,"
    } ]
  }, {
    "tStartMs": 953850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "expressed his discomfort\nabout the new weapon."
    } ]
  }, {
    "tStartMs": 956790,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Haber told him, \"Innumerable\nhuman lives would be saved"
    } ]
  }, {
    "tStartMs": 960570,
    "dDurationMs": 3196,
    "segs": [ {
      "utf8": "if the war could be ended\nmore quickly in this way.\""
    } ]
  }, {
    "tStartMs": 963766,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(somber music)"
    } ]
  }, {
    "tStartMs": 967740,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "At 6:00 p.m. on the 22nd of April,"
    } ]
  }, {
    "tStartMs": 970320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "with the wind blowing\ntoward the allied trenches,"
    } ]
  }, {
    "tStartMs": 973170,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "German troops released\n168 tons of chlorine"
    } ]
  }, {
    "tStartMs": 976710,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "from over 5,000 gas cylinders."
    } ]
  }, {
    "tStartMs": 981030,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "The wall of gas advanced\nacross the battlefield."
    } ]
  }, {
    "tStartMs": 984990,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Since chlorine gas is 2\n1/2 times heavier than air,"
    } ]
  }, {
    "tStartMs": 988740,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "it sank into the trenches\nof the Allied soldiers."
    } ]
  }, {
    "tStartMs": 993000,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Any soldier that inhaled\na lung full of the gas"
    } ]
  }, {
    "tStartMs": 996330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "suffered a terrible death."
    } ]
  }, {
    "tStartMs": 998880,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Chlorine irritates the\nmucus lining of the lungs"
    } ]
  }, {
    "tStartMs": 1002030,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "so violently that they fill with liquid."
    } ]
  }, {
    "tStartMs": 1006320,
    "dDurationMs": 3981,
    "segs": [ {
      "utf8": "The soldiers effectively\ndrowned on dry land."
    } ]
  }, {
    "tStartMs": 1010301,
    "dDurationMs": 2379,
    "segs": [ {
      "utf8": "(somber music)"
    } ]
  }, {
    "tStartMs": 1012680,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "More than 5,000 Allied\nsoldiers died this way"
    } ]
  }, {
    "tStartMs": 1015950,
    "dDurationMs": 1478,
    "segs": [ {
      "utf8": "in the first attack."
    } ]
  }, {
    "tStartMs": 1017428,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(somber music)"
    } ]
  }, {
    "tStartMs": 1021770,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Haber was promoted to the rank of captain."
    } ]
  }, {
    "tStartMs": 1025490,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Haber spent the rest of the\nwar running his institute"
    } ]
  }, {
    "tStartMs": 1028580,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "researching chemical weapons,\ngas masks, and pesticides."
    } ]
  }, {
    "tStartMs": 1032360,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "By 1917, the institute\nemployed 1,500 people"
    } ]
  }, {
    "tStartMs": 1035870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "including 150 scientists."
    } ]
  }, {
    "tStartMs": 1038240,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It was like a mini Manhattan project"
    } ]
  }, {
    "tStartMs": 1040730,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "but for chemical weapons."
    } ]
  }, {
    "tStartMs": 1043370,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "In total, 100,000 soldiers were killed"
    } ]
  }, {
    "tStartMs": 1046700,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "by chemical weapons in World War I."
    } ]
  }, {
    "tStartMs": 1049580,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "When Germany surrendered,\nHaber was crushed."
    } ]
  }, {
    "tStartMs": 1053000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "All the money he made\nfrom his ammonia patent"
    } ]
  }, {
    "tStartMs": 1055610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "was lost to hyperinflation."
    } ]
  }, {
    "tStartMs": 1058010,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "In an attempt to pay off\nGermany's crippling war debt,"
    } ]
  }, {
    "tStartMs": 1061400,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "he tried to distill gold from seawater"
    } ]
  }, {
    "tStartMs": 1065060,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "but the project was futile."
    } ]
  }, {
    "tStartMs": 1068210,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "In 1933, the Nazis came to power"
    } ]
  }, {
    "tStartMs": 1070700,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and passed a law that\nall Jewish civil servants"
    } ]
  }, {
    "tStartMs": 1073430,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "including scientists, were\nto be fired from their jobs."
    } ]
  }, {
    "tStartMs": 1078110,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Haber was Jewish but he\nnever practiced the religion."
    } ]
  }, {
    "tStartMs": 1081950,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Regardless, his military service\nexempted him from the law"
    } ]
  }, {
    "tStartMs": 1085280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but he resigned from his role as director"
    } ]
  }, {
    "tStartMs": 1087200,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in solidarity with all\nthe Jewish scientists"
    } ]
  }, {
    "tStartMs": 1089720,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "who worked at the institute."
    } ]
  }, {
    "tStartMs": 1091744,
    "dDurationMs": 2356,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1094100,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "The next year in a hotel\nroom in Basel, Switzerland,"
    } ]
  }, {
    "tStartMs": 1097850,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "he died of heart failure."
    } ]
  }, {
    "tStartMs": 1109040,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Immediately after World War I,"
    } ]
  }, {
    "tStartMs": 1110990,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Haber's Institute developed\na cyanide-based insecticide."
    } ]
  }, {
    "tStartMs": 1115190,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "It had a barely detectable odor"
    } ]
  }, {
    "tStartMs": 1117860,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "so, they mixed in a foul-smelling chemical"
    } ]
  }, {
    "tStartMs": 1120650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to alert people to the danger."
    } ]
  }, {
    "tStartMs": 1123260,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The resulting gas was called Zyklon B."
    } ]
  }, {
    "tStartMs": 1127160,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "A decade after Haber's death,"
    } ]
  }, {
    "tStartMs": 1129410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the Nazis requested chemists remove"
    } ]
  }, {
    "tStartMs": 1131810,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the foul-smelling component"
    } ]
  }, {
    "tStartMs": 1134120,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and this form of Zyklon B,"
    } ]
  }, {
    "tStartMs": 1136610,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the chemical developed\nat Haber's Institute"
    } ]
  }, {
    "tStartMs": 1139730,
    "dDurationMs": 3864,
    "segs": [ {
      "utf8": "was then used to perpetrate the Holocaust."
    } ]
  }, {
    "tStartMs": 1143594,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(slow tense music)"
    } ]
  }, {
    "tStartMs": 1149120,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Thinking about this story,"
    } ]
  }, {
    "tStartMs": 1151220,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "it would be easy to\npaint Haber as a villain"
    } ]
  }, {
    "tStartMs": 1154640,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "or as a hero for inventing the process"
    } ]
  }, {
    "tStartMs": 1158180,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "used to feed half the world."
    } ]
  }, {
    "tStartMs": 1161480,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But another approach is to regard him as"
    } ]
  }, {
    "tStartMs": 1164810,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "irrelevant to the larger story"
    } ]
  }, {
    "tStartMs": 1167540,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "because someone else\nwould've figured out a way"
    } ]
  }, {
    "tStartMs": 1170240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to process nitrogen out of the air"
    } ]
  }, {
    "tStartMs": 1173000,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "and other scientists were\ndeveloping chemical weapons."
    } ]
  }, {
    "tStartMs": 1177530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Over the past few centuries,"
    } ]
  }, {
    "tStartMs": 1179360,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "science and technology have\nimproved our lives immeasurably"
    } ]
  }, {
    "tStartMs": 1184340,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but they have also given\nus ever increasing ways"
    } ]
  }, {
    "tStartMs": 1187940,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to destroy ourselves."
    } ]
  }, {
    "tStartMs": 1190340,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "I think it'd be great to believe"
    } ]
  }, {
    "tStartMs": 1191600,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "that we could ask scientists\nto only work on problems"
    } ]
  }, {
    "tStartMs": 1195710,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that are good for humanity."
    } ]
  }, {
    "tStartMs": 1197750,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But the reality is that\nevery bit of information"
    } ]
  }, {
    "tStartMs": 1200720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "is a potential double-edged sword."
    } ]
  }, {
    "tStartMs": 1203390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "You don't know the\noutcome of your research"
    } ]
  }, {
    "tStartMs": 1205970,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "or how it might later be used."
    } ]
  }, {
    "tStartMs": 1209000,
    "dDurationMs": 4653,
    "segs": [ {
      "utf8": "Ammonium nitrate is both a\nfertilizer and an explosive."
    } ]
  }, {
    "tStartMs": 1214910,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So the real question is"
    } ]
  }, {
    "tStartMs": 1217580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "how do we keep increasing our knowledge"
    } ]
  }, {
    "tStartMs": 1220040,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and control of the natural world"
    } ]
  }, {
    "tStartMs": 1223310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "without destroying ourselves"
    } ]
  }, {
    "tStartMs": 1224990,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "and everything else on\nthis planet in the process?"
    } ]
  } ]
}
