      "utf8": "Nord VPN can teleport your digital"
    } ]
  }, {
    "tStartMs": 950720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "presence anywhere in the world."
    } ]
  }, {
    "tStartMs": 952800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's not actually faster than light,"
