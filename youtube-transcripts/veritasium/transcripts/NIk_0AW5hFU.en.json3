{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- In 1935."
    } ]
  }, {
    "tStartMs": 1200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Einstein came up with a thought experiment"
    } ]
  }, {
    "tStartMs": 2960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that showed quantum mechanics breaks one"
    } ]
  }, {
    "tStartMs": 4880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "of the most sacred principles in physics,"
    } ]
  }, {
    "tStartMs": 7440,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that nothing can go faster\nthan the speed of light."
    } ]
  }, {
    "tStartMs": 10400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Physicists assumed he was wrong."
    } ]
  }, {
    "tStartMs": 12640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "They thought that at 56\nEinstein was an old man,"
    } ]
  }, {
    "tStartMs": 15920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "past his prime"
    } ]
  }, {
    "tStartMs": 17360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and just unable to accept\nthe new theory of physics"
    } ]
  }, {
    "tStartMs": 20480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "because it was too radical."
    } ]
  }, {
    "tStartMs": 22800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "But 30 years later,"
    } ]
  }, {
    "tStartMs": 24160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "one man stumbled across\nEinstein's forgotten paper when he"
    } ]
  }, {
    "tStartMs": 27280,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "realized something, the prediction\ncould actually be tested."
    } ]
  }, {
    "tStartMs": 30960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "When scientists ran the\nexperiment, they were shocked."
    } ]
  }, {
    "tStartMs": 34080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Quantum physics really does break the"
    } ]
  }, {
    "tStartMs": 36320,
    "dDurationMs": 1315,
    "segs": [ {
      "utf8": "universal speed limit."
    } ]
  }, {
    "tStartMs": 37635,
    "dDurationMs": 3245,
    "segs": [ {
      "utf8": "- We are obliged to invoke something\nlike actions going faster"
    } ]
  }, {
    "tStartMs": 40880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "than light from one place to another."
    } ]
  }, {
    "tStartMs": 43120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- This is a video about\none of the spookiest"
    } ]
  }, {
    "tStartMs": 46240,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and most misunderstood\nexperiments in all of physics,"
    } ]
  }, {
    "tStartMs": 50160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and it might even be the\nstrongest evidence we have"
    } ]
  }, {
    "tStartMs": 53120,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "that we live in many worlds."
    } ]
  }, {
    "tStartMs": 57760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "If the sun were to\ndisappear all of a sudden,"
    } ]
  }, {
    "tStartMs": 60240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "how long would it take until we noticed"
    } ]
  }, {
    "tStartMs": 62400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and were released out into space?"
    } ]
  }, {
    "tStartMs": 64800,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Newton's theory says"
    } ]
  }, {
    "tStartMs": 65840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that gravity acts instantly\nacross any distance,"
    } ]
  }, {
    "tStartMs": 68720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "so if there's a change in gravity,"
    } ]
  }, {
    "tStartMs": 70400,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "we should feel it immediately."
    } ]
  }, {
    "tStartMs": 72720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "But Newton himself was disturbed by this."
    } ]
  }, {
    "tStartMs": 75760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That one body may act upon\nanother at a distance is to me"
    } ]
  }, {
    "tStartMs": 79360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "so great an absurdity\nthat I believe no man"
    } ]
  }, {
    "tStartMs": 81920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "who has a competent faculty"
    } ]
  }, {
    "tStartMs": 83360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "of thinking can ever fall into it."
    } ]
  }, {
    "tStartMs": 86560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But in 1905,"
    } ]
  }, {
    "tStartMs": 87760,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Einstein realized action at\na distance isn't just absurd,"
    } ]
  }, {
    "tStartMs": 91440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it leads to outright paradoxes."
    } ]
  }, {
    "tStartMs": 94320,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Einstein had discovered"
    } ]
  }, {
    "tStartMs": 95360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that observers moving at different\nspeeds can disagree about"
    } ]
  }, {
    "tStartMs": 98080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "when events happened."
    } ]
  }, {
    "tStartMs": 99680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Let's say you see two things\nhappen at the same time."
    } ]
  }, {
    "tStartMs": 102400,
    "dDurationMs": 2665,
    "segs": [ {
      "utf8": "An observer speeding past would\nsee it differently. "
    } ]
  }, {
    "tStartMs": 105065,
    "dDurationMs": 1975,
    "segs": [ {
      "utf8": "To them, one of these happened first,"
    } ]
  }, {
    "tStartMs": 107040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and both points of view are equally valid,"
    } ]
  }, {
    "tStartMs": 109920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "but in the case of gravity,\nthis leads to disaster."
    } ]
  }, {
    "tStartMs": 113120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Say you see the sun disappearing"
    } ]
  }, {
    "tStartMs": 114720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and earth flying off at the\nsame time as Newton predicted,"
    } ]
  }, {
    "tStartMs": 118240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "then the other observer\nsees something impossible."
    } ]
  }, {
    "tStartMs": 121120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "They see the earth flying off first,"
    } ]
  }, {
    "tStartMs": 122960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "even while the sun is still there"
    } ]
  }, {
    "tStartMs": 124800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and it should of course\nbe pulling the earth in."
    } ]
  }, {
    "tStartMs": 127280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So to them, it looks like\ncause and effect are reversed."
    } ]
  }, {
    "tStartMs": 130640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The only way out of this paradox is"
    } ]
  }, {
    "tStartMs": 132400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to reject the assumption we started with."
    } ]
  }, {
    "tStartMs": 134320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So gravity can't be instant."
    } ]
  }, {
    "tStartMs": 137040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It took Einstein 10\nyears to fix this issue,"
    } ]
  }, {
    "tStartMs": 139680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and in the process he\ncompletely overhauled our"
    } ]
  }, {
    "tStartMs": 142080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "understanding of gravity."
    } ]
  }, {
    "tStartMs": 143520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Gravity is caused by the bending\nof spacetime."
    } ]
  }, {
    "tStartMs": 146240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "When there's a change in gravity"
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that only affects the local space time,"
    } ]
  }, {
    "tStartMs": 150240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and then that ripple spreads out"
    } ]
  }, {
    "tStartMs": 152160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to nearby regions which spread farther out"
    } ]
  }, {
    "tStartMs": 154720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "until eventually they reach us."
    } ]
  }, {
    "tStartMs": 156960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This theory of gravity is local"
    } ]
  }, {
    "tStartMs": 158880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "because effects spread from\nplace to place at the speed"
    } ]
  }, {
    "tStartMs": 161520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of light instead of being instant"
    } ]
  }, {
    "tStartMs": 163920,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "from our frame of reference."
    } ]
  }, {
    "tStartMs": 165200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "If the sun disappeared,"
    } ]
  }, {
    "tStartMs": 166320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that ripple would take about\neight minutes to reach us."
    } ]
  }, {
    "tStartMs": 169200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Another observer might\ndisagree about the length"
    } ]
  }, {
    "tStartMs": 171280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "of the delay, but now we all agree"
    } ]
  }, {
    "tStartMs": 173520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that the sun disappeared first."
    } ]
  }, {
    "tStartMs": 175520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "This is why nothing can\ngo faster than light."
    } ]
  }, {
    "tStartMs": 178000,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "The delay between cause"
    } ]
  }, {
    "tStartMs": 179280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and effect ensures all observers agree\non the order."
    } ]
  }, {
    "tStartMs": 182800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "After Einstein fixed gravity,"
    } ]
  }, {
    "tStartMs": 184480,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "all of classical physics\nobeyed this important rule."
    } ]
  }, {
    "tStartMs": 187520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But then Einstein studied the new theory"
    } ]
  }, {
    "tStartMs": 189920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "of quantum mechanics and\nmade a terrible discovery."
    } ]
  }, {
    "tStartMs": 195040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "This is one of the most\nfamous photographs in physics."
    } ]
  }, {
    "tStartMs": 197600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It was taken at the 1927 Solvay Conference"
    } ]
  }, {
    "tStartMs": 200480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "where the architects of\nthe brand new quantum"
    } ]
  }, {
    "tStartMs": 202560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "theory gathered to discuss it."
    } ]
  }, {
    "tStartMs": 204480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Around 60% of the attendees\nwould win Nobel prizes,"
    } ]
  }, {
    "tStartMs": 207840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but Einstein thought they'd\ngotten something fundamentally"
    } ]
  }, {
    "tStartMs": 210400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "wrong and this was his chance to prove it."
    } ]
  }, {
    "tStartMs": 213280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So he took to the stage\nwith a thought experiment."
    } ]
  }, {
    "tStartMs": 215920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Imagine you fire a single electron"
    } ]
  }, {
    "tStartMs": 217840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "through a narrow slit toward\na circular detection screen."
    } ]
  }, {
    "tStartMs": 221040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Well, quantum mechanics says"
    } ]
  }, {
    "tStartMs": 222080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that this electron has some\nsort of wave associated"
    } ]
  }, {
    "tStartMs": 224480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "with it called a wave\nfunction, which spreads out"
    } ]
  }, {
    "tStartMs": 227280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "through space as it travels."
    } ]
  }, {
    "tStartMs": 228960,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "When the electron hits the screen,"
    } ]
  }, {
    "tStartMs": 230480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "you detect it at a single point."
    } ]
  }, {
    "tStartMs": 232640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Where it turns up depends on\nthe amplitude of the wave."
    } ]
  }, {
    "tStartMs": 235920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If the wave is very big\nin a particular area,"
    } ]
  }, {
    "tStartMs": 238320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the electron is more\nlikely to turn up there."
    } ]
  }, {
    "tStartMs": 240640,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Let's say it appears here, so\nfar, everyone was following."
    } ]
  }, {
    "tStartMs": 244880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This is what quantum mechanics predicts,"
    } ]
  }, {
    "tStartMs": 246800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but Einstein's next\nquestion surprised them."
    } ]
  }, {
    "tStartMs": 249440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Why doesn't the electron\nturn up at this other"
    } ]
  }, {
    "tStartMs": 251200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "spot a moment later?"
    } ]
  }, {
    "tStartMs": 252880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "There's only one electron,\nso we can't detect it twice,"
    } ]
  }, {
    "tStartMs": 255520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but the way quantum\nmechanics ensures this is"
    } ]
  }, {
    "tStartMs": 257680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that when the electron was\ndetected at the first spot,"
    } ]
  }, {
    "tStartMs": 260080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "its wave function collapsed"
    } ]
  }, {
    "tStartMs": 261600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to zero everywhere else instantly."
    } ]
  }, {
    "tStartMs": 264320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's why the probability\nof finding it at the second"
    } ]
  }, {
    "tStartMs": 266320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "spot is now a zero."
    } ]
  }, {
    "tStartMs": 267760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "There's no longer any wave there,"
    } ]
  }, {
    "tStartMs": 270240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but Einstein asked the audience"
    } ]
  }, {
    "tStartMs": 271680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to think about what this means."
    } ]
  }, {
    "tStartMs": 273360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The measurement here must\ninstantly affect the wave function"
    } ]
  }, {
    "tStartMs": 276560,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "over here no matter how far\napart these locations are."
    } ]
  }, {
    "tStartMs": 280800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "In other words, quantum\nmechanics requires instant"
    } ]
  }, {
    "tStartMs": 283600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "influences across distance."
    } ]
  }, {
    "tStartMs": 285680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It violates locality."
    } ]
  }, {
    "tStartMs": 288720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Einstein concluded his talk"
    } ]
  }, {
    "tStartMs": 290080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "by saying this is an\nentirely peculiar mechanism"
    } ]
  }, {
    "tStartMs": 292880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "of action at a distance,"
    } ]
  }, {
    "tStartMs": 294400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and that this implies to\nmy mind a contradiction"
    } ]
  }, {
    "tStartMs": 297120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "with the postulate of relativity."
    } ]
  }, {
    "tStartMs": 299120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Einstein's argument was so simple"
    } ]
  }, {
    "tStartMs": 300720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and his talk so short"
    } ]
  }, {
    "tStartMs": 302160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that people didn't know\nwhat to make of it."
    } ]
  }, {
    "tStartMs": 304400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "One audience member said,"
    } ]
  }, {
    "tStartMs": 305600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "'I feel myself in a very difficult position"
    } ]
  }, {
    "tStartMs": 307600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "because I don't understand"
    } ]
  }, {
    "tStartMs": 309120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "what precisely is the point\nwhich Einstein wants to make."
    } ]
  }, {
    "tStartMs": 312240,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "No doubt it is my fault.'"
    } ]
  }, {
    "tStartMs": 313720,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "That man was Niels Bohr, the\nmost influential figure in"
    } ]
  }, {
    "tStartMs": 317200,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "quantum physics at the time."
    } ]
  }, {
    "tStartMs": 321680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Bohr's Institute in\nCopenhagen had become the hub"
    } ]
  }, {
    "tStartMs": 324080,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "for the new field."
    } ]
  }, {
    "tStartMs": 325200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Dozens of young scientists\nlike Werner Heisenberg"
    } ]
  }, {
    "tStartMs": 327520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "came to learn from him."
    } ]
  }, {
    "tStartMs": 328960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "As one of his disciples remembers,"
    } ]
  }, {
    "tStartMs": 330880,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "'Bohr had invited a\nnumber of us to his home"
    } ]
  }, {
    "tStartMs": 333200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "where we sat close to him,"
    } ]
  }, {
    "tStartMs": 334720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "some literally at his feet\non the floor so as not"
    } ]
  }, {
    "tStartMs": 337520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to miss a word.'"
    } ]
  }, {
    "tStartMs": 338880,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Bohr wasn't the one who wrote the mathematical\nrules of quantum mechanics."
    } ]
  }, {
    "tStartMs": 342320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Instead, he told everyone what they meant."
    } ]
  }, {
    "tStartMs": 344880,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "While others were confused"
    } ]
  }, {
    "tStartMs": 346000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "by the theory Bohr offered answers,"
    } ]
  }, {
    "tStartMs": 348320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "his philosophy became known"
    } ]
  }, {
    "tStartMs": 349600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "as the Copenhagen interpretation\nof quantum mechanics."
    } ]
  }, {
    "tStartMs": 352800,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "My general understanding"
    } ]
  }, {
    "tStartMs": 353840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of the Copenhagen interpretation\nis you have the wave"
    } ]
  }, {
    "tStartMs": 356800,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "function, it describes everything that\nyou can know about a particle"
    } ]
  }, {
    "tStartMs": 360640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "or a system,\nand it evolves according"
    } ]
  }, {
    "tStartMs": 362960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "to the Schrödinger equation."
    } ]
  }, {
    "tStartMs": 364560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And at some point you're\ngonna make a measurement"
    } ]
  }, {
    "tStartMs": 366480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and at that point the\nwave function collapses."
    } ]
  }, {
    "tStartMs": 369360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- I think that one bit of\nthat that you said was like"
    } ]
  }, {
    "tStartMs": 372960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the wave function is all you\ncan know about the particle,"
    } ]
  }, {
    "tStartMs": 375760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and I think that was like a\npretty important point to Bohr."
    } ]
  }, {
    "tStartMs": 378160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- As Bohr would put it.\n'It's wrong to think that the task"
    } ]
  }, {
    "tStartMs": 380800,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "of physics is to find out how nature is.'"
    } ]
  }, {
    "tStartMs": 383120,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "The job of physics is just"
    } ]
  }, {
    "tStartMs": 384640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to predict measurements in the lab,"
    } ]
  }, {
    "tStartMs": 386640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "which quantum mechanics\ndoes incredibly well as for"
    } ]
  }, {
    "tStartMs": 390000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "what the electron is doing\nwhen you're not looking well"
    } ]
  }, {
    "tStartMs": 392800,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to Bohr, that question didn't\neven make sense to ask."
    } ]
  }, {
    "tStartMs": 396480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The wave function tells\nyou everything physics can"
    } ]
  }, {
    "tStartMs": 399600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "or should tell you."
    } ]
  }, {
    "tStartMs": 401120,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Einstein couldn't stand the\nCopenhagen interpretation In a"
    } ]
  }, {
    "tStartMs": 404400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "letter to his ally Schrodinger,"
    } ]
  }, {
    "tStartMs": 405920,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "he called it a tranquilizing\nphilosophy or religion."
    } ]
  }, {
    "tStartMs": 409440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Einstein felt his thought\nexperiment exposed a critical"
    } ]
  }, {
    "tStartMs": 411920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "weakness in the Copenhagen interpretation."
    } ]
  }, {
    "tStartMs": 414080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "He'd shown that the way the\nwave function collapses is"
    } ]
  }, {
    "tStartMs": 416480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "non-local, and so he\nreasoned maybe the wave"
    } ]
  }, {
    "tStartMs": 419200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "function is the problem."
    } ]
  }, {
    "tStartMs": 420720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Maybe it's not the best way\nto describe the electron."
    } ]
  }, {
    "tStartMs": 423200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "After all, he may not have\nconvinced Bohr of this"
    } ]
  }, {
    "tStartMs": 425520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "during his talk, but he\nwas determined to do it"
    } ]
  }, {
    "tStartMs": 427680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "during the rest of the conference."
    } ]
  }, {
    "tStartMs": 429360,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "- Physicists tell a version\nof this story, you know"
    } ]
  }, {
    "tStartMs": 433280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that you will find in physics textbooks"
    } ]
  }, {
    "tStartMs": 435040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and in pop science books"
    } ]
  }, {
    "tStartMs": 436960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and that you know physicists\ntell amongst ourselves that"
    } ]
  }, {
    "tStartMs": 440880,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "what happened was Einstein\nand Bohr had a great debate"
    } ]
  }, {
    "tStartMs": 445040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and Einstein was unhappy\nwith quantum mechanics"
    } ]
  }, {
    "tStartMs": 447840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "because it was\nfundamentally probabilistic."
    } ]
  }, {
    "tStartMs": 450560,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "He tried to show that there\nwere conceivable experiments"
    } ]
  }, {
    "tStartMs": 452800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that you could use to get around\nthose uncertainty relations"
    } ]
  }, {
    "tStartMs": 455680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and Bohr showed over and over"
    } ]
  }, {
    "tStartMs": 457280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and over again that you couldn't do that."
    } ]
  }, {
    "tStartMs": 459440,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And eventually everybody agreed with Bohr."
    } ]
  }, {
    "tStartMs": 462840,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- That's Adam Becker,\nauthor of What is Real,"
    } ]
  }, {
    "tStartMs": 465760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "a great book about the\nhistory of quantum mechanics."
    } ]
  }, {
    "tStartMs": 468400,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "As he explained to us,"
    } ]
  }, {
    "tStartMs": 469520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Bohr may have just\nmisunderstood the purpose"
    } ]
  }, {
    "tStartMs": 471440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of Einstein's thought experiments."
    } ]
  }, {
    "tStartMs": 473120,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "We have documented evidence\nof this in at least one case."
    } ]
  }, {
    "tStartMs": 476080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Einstein described a thought\nexperiment that involved a box"
    } ]
  }, {
    "tStartMs": 478480,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of photons and a mirror."
    } ]
  }, {
    "tStartMs": 480160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Its purpose was to show the non-locality"
    } ]
  }, {
    "tStartMs": 482160,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "of the Copenhagen\ninterpretation in action."
    } ]
  }, {
    "tStartMs": 484760,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Bohr just misunderstood it,"
    } ]
  }, {
    "tStartMs": 487360,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and when he recounted\nit to others later on,"
    } ]
  }, {
    "tStartMs": 491200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "he drew a little diagram of"
    } ]
  }, {
    "tStartMs": 493040,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "what Einstein's thought\nexperiment setup was,"
    } ]
  }, {
    "tStartMs": 495640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and it just didn't have\nthe mirror in it at all."
    } ]
  }, {
    "tStartMs": 498160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And yet this is taken as\nlike the great victory"
    } ]
  }, {
    "tStartMs": 501360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for Bohr over Einstein, which is crazy,"
    } ]
  }, {
    "tStartMs": 503760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but history is written\nby the victors right"
    } ]
  }, {
    "tStartMs": 506040,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- To understand what\nEinstein was arguing for."
    } ]
  }, {
    "tStartMs": 509040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Think of the relationship\nbetween Newton's gravity"
    } ]
  }, {
    "tStartMs": 510960,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and general relativity."
    } ]
  }, {
    "tStartMs": 512480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Newton's theory works\nwell in most situations,"
    } ]
  }, {
    "tStartMs": 515200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but in that theory, gravity\nis a non-local force"
    } ]
  }, {
    "tStartMs": 517680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "leading to paradoxes."
    } ]
  }, {
    "tStartMs": 519360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "This was the motivation for coming up"
    } ]
  }, {
    "tStartMs": 520880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "with Einstein's general\nrelativity, which is local."
    } ]
  }, {
    "tStartMs": 523840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Einstein believed the same logic"
    } ]
  }, {
    "tStartMs": 525440,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "applied to quantum mechanics."
    } ]
  }, {
    "tStartMs": 526720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "His thought experiment revealed"
    } ]
  }, {
    "tStartMs": 527920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that quantum theory is non-local."
    } ]
  }, {
    "tStartMs": 529760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So just like with Newton's gravity,"
    } ]
  }, {
    "tStartMs": 531440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "quantum mechanics must\nnot be the final theory."
    } ]
  }, {
    "tStartMs": 533760,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "There must be a local one that replace it,"
    } ]
  }, {
    "tStartMs": 536560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and as a bonus, he thought\nthis new theory"
    } ]
  }, {
    "tStartMs": 538880,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "might even unify gravity,"
    } ]
  }, {
    "tStartMs": 540240,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "with the quantum world."
    } ]
  }, {
    "tStartMs": 541280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It would be hard to imagine coming\nto the final theory right away."
    } ]
  }, {
    "tStartMs": 544800,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And yeah,"
    } ]
  }, {
    "tStartMs": 545760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and the fact that you can see\nparadoxes like this,"
    } ]
  }, {
    "tStartMs": 548240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "would make you think\nthere's gotta be more to it"
    } ]
  }, {
    "tStartMs": 550640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that we just don't have yet.\n- Absolutely."
    } ]
  }, {
    "tStartMs": 552560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But Einstein\nhadn't even persuaded Bohr"
    } ]
  }, {
    "tStartMs": 554400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that quantum mechanics\nreally is non-local."
    } ]
  }, {
    "tStartMs": 556880,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So in 1935, he made one last attempt"
    } ]
  }, {
    "tStartMs": 559200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to convince the community\nthat there was a contradiction"
    } ]
  }, {
    "tStartMs": 561520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "between quantum mechanics and relativity."
    } ]
  }, {
    "tStartMs": 563760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "With the help of two younger\ncolleagues, Boris Podolsky"
    } ]
  }, {
    "tStartMs": 566480,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and Nathan Rosen, he formulated\nanother even more striking"
    } ]
  }, {
    "tStartMs": 569760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "thought experiment that shows the"
    } ]
  }, {
    "tStartMs": 571040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "non-locality of quantum mechanics."
    } ]
  }, {
    "tStartMs": 573120,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "This paper is now known as the\nEPR paper after its authors."
    } ]
  }, {
    "tStartMs": 579440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Here is a simplified version\nof their thought experiment."
    } ]
  }, {
    "tStartMs": 582160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Imagine a single high\nenergy photon suddenly"
    } ]
  }, {
    "tStartMs": 584400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "becomes two particles."
    } ]
  }, {
    "tStartMs": 585920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "One of them is an electron\nand to conserve total charge."
    } ]
  }, {
    "tStartMs": 588720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The other is a positron\nsince one is negative"
    } ]
  }, {
    "tStartMs": 591120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the other is\npositive, they cancel out."
    } ]
  }, {
    "tStartMs": 593520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "But both electrons and positrons\nhave a property called spin"
    } ]
  }, {
    "tStartMs": 596800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and like electric charge, this\nalso needs to be conserved."
    } ]
  }, {
    "tStartMs": 600240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "If the light started out with zero spin,"
    } ]
  }, {
    "tStartMs": 602240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "well then the two particles\ntogether must have zero"
    } ]
  }, {
    "tStartMs": 604720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "total spin as well."
    } ]
  }, {
    "tStartMs": 606240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "For example, if the direction\nof the electron spin is this,"
    } ]
  }, {
    "tStartMs": 609200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the positron has to have spin\nin the opposite direction so"
    } ]
  }, {
    "tStartMs": 612560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that they perfectly cancel out."
    } ]
  }, {
    "tStartMs": 614640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "But the electron spin could\nhave been this instead or this."
    } ]
  }, {
    "tStartMs": 618720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "All of these possibilities are valid."
    } ]
  }, {
    "tStartMs": 620560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So the rules of quantum mechanics say"
    } ]
  }, {
    "tStartMs": 622000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that the electron does all"
    } ]
  }, {
    "tStartMs": 623200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "of these possible things at\nonce until it's measured."
    } ]
  }, {
    "tStartMs": 625920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's not just that we don't\nknow what the spin is,"
    } ]
  }, {
    "tStartMs": 627920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the electron really is doing everything."
    } ]
  }, {
    "tStartMs": 630720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The only restriction is\nwhatever the electron is doing."
    } ]
  }, {
    "tStartMs": 633600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The positron must do the exact opposite."
    } ]
  }, {
    "tStartMs": 636400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This also means that when\nthe electron is measured"
    } ]
  }, {
    "tStartMs": 638400,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and its state is determined,\nso is the positrons."
    } ]
  }, {
    "tStartMs": 642160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is what we mean by entanglement."
    } ]
  }, {
    "tStartMs": 644160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The two particles states\ndepend on each other."
    } ]
  }, {
    "tStartMs": 646880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "But how do we measure the particles"
    } ]
  }, {
    "tStartMs": 648320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and force them to do one thing?"
    } ]
  }, {
    "tStartMs": 650560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Well for that we use the\nStern-Gerlach machine."
    } ]
  }, {
    "tStartMs": 653760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's essentially a strangely shaped magnet"
    } ]
  }, {
    "tStartMs": 656160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and it's how we measure spin."
    } ]
  }, {
    "tStartMs": 657920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The orientation of the magnets determines"
    } ]
  }, {
    "tStartMs": 660080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "what axis you're measuring the spin in."
    } ]
  }, {
    "tStartMs": 662320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "For example, if the machine is like this"
    } ]
  }, {
    "tStartMs": 664080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and we shoot in a particle"
    } ]
  }, {
    "tStartMs": 665360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with spin in the positive Z\ndirection, it will certainly go"
    } ]
  }, {
    "tStartMs": 668000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to this spot we'll call plus."
    } ]
  }, {
    "tStartMs": 670000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "If instead a particle has negative Z spin,"
    } ]
  }, {
    "tStartMs": 672480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "it will certainly go down to minus."
    } ]
  }, {
    "tStartMs": 675120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So this Stern-Gerlach machine\nmeasures spin in the Z axis."
    } ]
  }, {
    "tStartMs": 679120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So what happens when we put in one"
    } ]
  }, {
    "tStartMs": 680720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of our entangled particles?"
    } ]
  }, {
    "tStartMs": 682640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "When the electron goes into\nthis machine, it either goes"
    } ]
  }, {
    "tStartMs": 685040,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to plus or to minus."
    } ]
  }, {
    "tStartMs": 686400,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "With 50/50 probability, let's\nsay our electron goes to plus."
    } ]
  }, {
    "tStartMs": 690560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Well, this means it went from\nbeing in an indeterminate"
    } ]
  }, {
    "tStartMs": 693040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "state to positive Z spin."
    } ]
  }, {
    "tStartMs": 695600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But what about the positron?"
    } ]
  }, {
    "tStartMs": 697280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Well, the only way to conserve\nspin is if it's now in the"
    } ]
  }, {
    "tStartMs": 699920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "negative Z spin state."
    } ]
  }, {
    "tStartMs": 701440,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "When it's measured, there\nis a 100% chance it's minus."
    } ]
  }, {
    "tStartMs": 705120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It has to be that way to conserve spin."
    } ]
  }, {
    "tStartMs": 707600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But the authors of the paper\nrealized there's something very"
    } ]
  }, {
    "tStartMs": 710480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "odd about this result."
    } ]
  }, {
    "tStartMs": 711840,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- To see what's wrong with\nthis let's imagine that the electron"
    } ]
  }, {
    "tStartMs": 715680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and the positron carry\nthese envelopes with them."
    } ]
  }, {
    "tStartMs": 718400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "These envelopes represent the state"
    } ]
  }, {
    "tStartMs": 720320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "of the two particles."
    } ]
  }, {
    "tStartMs": 721840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Until they're measured,\nboth of the particles are in a superposition"
    } ]
  }, {
    "tStartMs": 725520,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of being plus and minus at the same time."
    } ]
  }, {
    "tStartMs": 728960,
    "dDurationMs": 9280,
    "segs": [ {
      "utf8": "So both options are in the envelope,"
    } ]
  }, {
    "tStartMs": 738240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but now let's move the positron"
    } ]
  }, {
    "tStartMs": 739760,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "to someone who's far far away."
    } ]
  }, {
    "tStartMs": 744560,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "In this analogy, opening the\nenvelope is like measuring the"
    } ]
  }, {
    "tStartMs": 748160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "spin of the electron,"
    } ]
  }, {
    "tStartMs": 749840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "but that causes the wave\nfunction of the electron"
    } ]
  }, {
    "tStartMs": 752800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "to collapse to just one possibility."
    } ]
  }, {
    "tStartMs": 755840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "In this case, it's plus,"
    } ]
  }, {
    "tStartMs": 759040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but what happens to the\nother envelope far away?"
    } ]
  }, {
    "tStartMs": 762160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Well, it needs to instantly\ncollapse to minus because"
    } ]
  }, {
    "tStartMs": 765520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "otherwise when the experimenter\nopens their envelope,"
    } ]
  }, {
    "tStartMs": 768640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "they have a chance of seeing plus,"
    } ]
  }, {
    "tStartMs": 770960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "which would violate the\nconservation of spin."
    } ]
  }, {
    "tStartMs": 773920,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "But if it needs to collapse\ninstantly when the electron is"
    } ]
  }, {
    "tStartMs": 777440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "measured, then how does it\nknow what to collapse to?"
    } ]
  }, {
    "tStartMs": 780560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "It must receive intel from\nthe far away electron,"
    } ]
  }, {
    "tStartMs": 783840,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but that message has to travel\nmuch faster than the speed"
    } ]
  }, {
    "tStartMs": 787840,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "of light to get to the positron in time."
    } ]
  }, {
    "tStartMs": 790640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And so with this argument,\nEinstein Podolski"
    } ]
  }, {
    "tStartMs": 793120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and Rosen had shown that the\nCopenhagen interpretation"
    } ]
  }, {
    "tStartMs": 796000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of quantum mechanics really is non-local."
    } ]
  }, {
    "tStartMs": 799120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Einstein had already shown\nthis in his conference talk,"
    } ]
  }, {
    "tStartMs": 802640,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "but this argument was even more decisive."
    } ]
  }, {
    "tStartMs": 805080,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- It does seem like it's the same thing,"
    } ]
  }, {
    "tStartMs": 808320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but now it's ramped up"
    } ]
  }, {
    "tStartMs": 810320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and you've got these\ntwo separate particles"
    } ]
  }, {
    "tStartMs": 812640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "to do those two separate measurements"
    } ]
  }, {
    "tStartMs": 814240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and one measurement influencing\nthe other measurement"
    } ]
  }, {
    "tStartMs": 816400,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "definitely feels wrong."
    } ]
  }, {
    "tStartMs": 817320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Yeah, exactly. I\nthink he really realized"
    } ]
  }, {
    "tStartMs": 819360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "that it's measurements"
    } ]
  }, {
    "tStartMs": 820720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that are the problem\nin quantum mechanics."
    } ]
  }, {
    "tStartMs": 822720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- The wave function of a single particle"
    } ]
  }, {
    "tStartMs": 824640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "or of this pair of particles\ncan end up spread over"
    } ]
  }, {
    "tStartMs": 827120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "vast distances."
    } ]
  }, {
    "tStartMs": 828480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That isn't itself an issue,"
    } ]
  }, {
    "tStartMs": 830240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "but when the wave function\ncollapses, the information about"
    } ]
  }, {
    "tStartMs": 833040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that collapse needs to spread everywhere."
    } ]
  }, {
    "tStartMs": 835040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The wave function is that's"
    } ]
  }, {
    "tStartMs": 836720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "what makes quantum mechanics non-local."
    } ]
  }, {
    "tStartMs": 838520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- The EPR paper didn't just point out this"
    } ]
  }, {
    "tStartMs": 841280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "non-locality issue."
    } ]
  }, {
    "tStartMs": 842960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "They proved that there is only\none local alternative theory"
    } ]
  }, {
    "tStartMs": 846880,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "for explaining this experiment\nin this local story."
    } ]
  }, {
    "tStartMs": 850560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Instead of the electron\nchoosing whether to be plus"
    } ]
  }, {
    "tStartMs": 853360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "or minus when it's\nmeasured, it actually makes"
    } ]
  }, {
    "tStartMs": 856080,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "that choice when it's still\nin contact with the positron."
    } ]
  }, {
    "tStartMs": 859360,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "There's some random way that this plus"
    } ]
  }, {
    "tStartMs": 861680,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "or minus gets put into\nthese two envelopes,"
    } ]
  }, {
    "tStartMs": 869600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "which is why the plus and minus\nare called hidden variables."
    } ]
  }, {
    "tStartMs": 872800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And because this alternative\ntheory assigns these hidden"
    } ]
  }, {
    "tStartMs": 875840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "variables in a local way,\nwhile they're still in contact"
    } ]
  }, {
    "tStartMs": 878960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "with each other rather\nthan over a big distance,"
    } ]
  }, {
    "tStartMs": 881680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "we call this a local\nhidden variable theory."
    } ]
  }, {
    "tStartMs": 885040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now, this local hidden variable\ntheory is going to be able"
    } ]
  }, {
    "tStartMs": 887840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to explain this experiment really simply."
    } ]
  }, {
    "tStartMs": 890800,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Let's pass away the positron,"
    } ]
  }, {
    "tStartMs": 895040,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and now when the electron\nis measured as a plus,"
    } ]
  }, {
    "tStartMs": 899040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "it doesn't have to rush\nto tell the positron."
    } ]
  }, {
    "tStartMs": 901840,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "The positron already knows, there\nis no action at a distance."
    } ]
  }, {
    "tStartMs": 907120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This local hidden variable story is"
    } ]
  }, {
    "tStartMs": 909520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "so much more sensible\nthan the quantum one."
    } ]
  }, {
    "tStartMs": 911920,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "- So we're forced to accept\none of two explanations"
    } ]
  }, {
    "tStartMs": 915360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "for this experiment."
    } ]
  }, {
    "tStartMs": 916640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Either non-locality like the\nCopenhagen interpretation"
    } ]
  }, {
    "tStartMs": 919680,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "of quantum mechanics or a local\nhidden variable theory given"
    } ]
  }, {
    "tStartMs": 924240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "that non-local action at a\ndistance contradicts relativity."
    } ]
  }, {
    "tStartMs": 927680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Einstein thought this was definitive proof"
    } ]
  }, {
    "tStartMs": 929680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that the Copenhagen interpretation"
    } ]
  }, {
    "tStartMs": 931120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "of quantum mechanics is wrong, and"
    } ]
  }, {
    "tStartMs": 933120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "therefore there must be some\nlocal hidden variable theory"
    } ]
  }, {
    "tStartMs": 936160,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that will replace it."
    } ]
  }, {
    "tStartMs": 937760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Einstein showed us that quantum\nmechanics allows influences"
    } ]
  }, {
    "tStartMs": 940400,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that seem to travel faster than light,"
    } ]
  }, {
    "tStartMs": 942720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "but with today's video sponsor,"
    } ]
  }, {
    "tStartMs": 944320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "you can have your own spooky action at a"
    } ]
  }, {
    "tStartMs": 946800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "distance with one click."
    } ]
  }, {
