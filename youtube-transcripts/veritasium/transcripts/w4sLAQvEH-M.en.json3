{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 120,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- These are bacteria growing into\nincreasingly concentrated antibiotics."
    } ]
  }, {
    "tStartMs": 5510,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "The bacteria stop growing"
    } ]
  }, {
    "tStartMs": 6750,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "when they hit the first antibiotic strip,"
    } ]
  }, {
    "tStartMs": 9450,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "but then a mutant appears\ncapable of surviving"
    } ]
  }, {
    "tStartMs": 12260,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "in the antibiotic."
    } ]
  }, {
    "tStartMs": 13820,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Then another mutation occurs"
    } ]
  }, {
    "tStartMs": 15610,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "and now the bacteria can survive\n10 times the concentration,"
    } ]
  }, {
    "tStartMs": 19910,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "then a hundred times,"
    } ]
  }, {
    "tStartMs": 22000,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "and finally, after just\n11 days of evolution,"
    } ]
  }, {
    "tStartMs": 25010,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "these bacteria can survive antibiotics"
    } ]
  }, {
    "tStartMs": 27370,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "a thousand times stronger"
    } ]
  }, {
    "tStartMs": 29020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "than what would have\nkilled them at the start."
    } ]
  }, {
    "tStartMs": 31150,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "You're watching evolution in action."
    } ]
  }, {
    "tStartMs": 34420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This video was sponsored by Bounty,"
    } ]
  }, {
    "tStartMs": 36460,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "reminding you that a hygienic\nway to clean up messes"
    } ]
  }, {
    "tStartMs": 38520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and spills is with paper towel."
    } ]
  }, {
    "tStartMs": 40480,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Now, bacteria are everywhere,"
    } ]
  }, {
    "tStartMs": 42300,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "especially in damp places like dishcloths."
    } ]
  }, {
    "tStartMs": 45040,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "So I'm gonna do a little experiment"
    } ]
  }, {
    "tStartMs": 46610,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "where I add some fluorescent\npowder to this dishcloth"
    } ]
  }, {
    "tStartMs": 49890,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "to represent bacteria"
    } ]
  }, {
    "tStartMs": 50970,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "without telling anyone in my household."
    } ]
  }, {
    "tStartMs": 52970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And then I'm gonna come back later"
    } ]
  }, {
    "tStartMs": 54890,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "to see where all of this powder ends up."
    } ]
  }, {
    "tStartMs": 58700,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "But for now, I'm off to Michigan"
    } ]
  }, {
    "tStartMs": 60360,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to see the world's longest-running\nevolution experiment."
    } ]
  }, {
    "tStartMs": 63690,
    "dDurationMs": 1037,
    "segs": [ {
      "utf8": "Let's go."
    } ]
  }, {
    "tStartMs": 64727,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "(plane engine roaring)"
    } ]
  }, {
    "tStartMs": 66534,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(bright upbeat music)"
    } ]
  }, {
    "tStartMs": 71450,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- This is Richard Lenski."
    } ]
  }, {
    "tStartMs": 72970,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "He started the experiment 33 years ago,"
    } ]
  }, {
    "tStartMs": 75450,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "and along with a team of colleagues,"
    } ]
  }, {
    "tStartMs": 77320,
    "dDurationMs": 4173,
    "segs": [ {
      "utf8": "he has kept it going even\non weekends ever since."
    } ]
  }, {
    "tStartMs": 82950,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "In this lab are 12 flasks\nof live E. coli bacteria."
    } ]
  }, {
    "tStartMs": 87660,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "They are the lucky few,\nthe ones that have survived"
    } ]
  }, {
    "tStartMs": 91030,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "over three decades of evolution in a lab."
    } ]
  }, {
    "tStartMs": 94710,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- So there are 12 long-term lines."
    } ]
  }, {
    "tStartMs": 98670,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "- [Derek] In 1988, a\nsingle common ancestor"
    } ]
  }, {
    "tStartMs": 101330,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "spawned these 12 separate populations."
    } ]
  }, {
    "tStartMs": 103830,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "And ever since that day,"
    } ]
  }, {
    "tStartMs": 105080,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "they have been growing and\ndividing independently."
    } ]
  }, {
    "tStartMs": 108570,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "So how have they evolved?"
    } ]
  }, {
    "tStartMs": 110960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "There are other long running\nevolution experiments"
    } ]
  }, {
    "tStartMs": 113300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "like since 1896,"
    } ]
  }, {
    "tStartMs": 114980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "scientists at the University of Illinois"
    } ]
  }, {
    "tStartMs": 116630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "have selectively bred corn,"
    } ]
  }, {
    "tStartMs": 118670,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "but they get only one generation per year,"
    } ]
  }, {
    "tStartMs": 121840,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "whereas these bacteria go through six"
    } ]
  }, {
    "tStartMs": 124250,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "or seven generations a day."
    } ]
  }, {
    "tStartMs": 127100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So after 33 years,"
    } ]
  }, {
    "tStartMs": 128600,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "the bacteria in these flasks\nare generation 74,500."
    } ]
  }, {
    "tStartMs": 133620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If those were human generations,"
    } ]
  }, {
    "tStartMs": 135360,
    "dDurationMs": 4613,
    "segs": [ {
      "utf8": "it would represent 1.5 million\nyears of hominid evolution."
    } ]
  }, {
    "tStartMs": 141350,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- What we do to start the experiment"
    } ]
  }, {
    "tStartMs": 142960,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "is we dilute a large\npopulation of bacteria"
    } ]
  }, {
    "tStartMs": 146130,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "onto a Petri dish and each\nindividual cell makes a colony."
    } ]
  }, {
    "tStartMs": 150850,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And so then we take a\nlittle bit from one colony"
    } ]
  }, {
    "tStartMs": 153190,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "to start one population,"
    } ]
  }, {
    "tStartMs": 154400,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "a little bit from another colony"
    } ]
  }, {
    "tStartMs": 155740,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "to start another population,"
    } ]
  }, {
    "tStartMs": 157320,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but effectively they all\nstarted from individual cells."
    } ]
  }, {
    "tStartMs": 161320,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "And that's important because it means"
    } ]
  }, {
    "tStartMs": 163460,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "if we see the same thing happening\nin replicate populations,"
    } ]
  }, {
    "tStartMs": 167540,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "it's not because they started out"
    } ]
  }, {
    "tStartMs": 170080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "with the same genetic variants"
    } ]
  }, {
    "tStartMs": 172540,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "and natural selection just fished out"
    } ]
  }, {
    "tStartMs": 174330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "the same thing over and over."
    } ]
  }, {
    "tStartMs": 175740,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "You actually had to have\nindependent mutations"
    } ]
  }, {
    "tStartMs": 178370,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "that would give rise to\nthese competitive advantages,"
    } ]
  }, {
    "tStartMs": 181860,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "whatever it might be that\nwould produce the repeatability"
    } ]
  }, {
    "tStartMs": 185000,
    "dDurationMs": 2713,
    "segs": [ {
      "utf8": "across the 12 replicate populations."
    } ]
  }, {
    "tStartMs": 188900,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- [Derek] The lab\nenvironment is very different"
    } ]
  }, {
    "tStartMs": 190660,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "from the one the bacteria are used to."
    } ]
  }, {
    "tStartMs": 192610,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It's much simpler,"
    } ]
  }, {
    "tStartMs": 193930,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "there are no other organisms present,"
    } ]
  }, {
    "tStartMs": 195930,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "they're kept at 37 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 197950,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "and they live in the same solution,"
    } ]
  }, {
    "tStartMs": 200180,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "a mixture including glucose,\npotassium phosphate, citrate,"
    } ]
  }, {
    "tStartMs": 203700,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "and a few other things."
    } ]
  }, {
    "tStartMs": 205280,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "Their only carbon source is\nglucose, which is limited."
    } ]
  }, {
    "tStartMs": 208690,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "- Above all else,"
    } ]
  }, {
    "tStartMs": 209870,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "consuming that glucose and\nconverting it to offspring,"
    } ]
  }, {
    "tStartMs": 213530,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "replicating as fast as possible"
    } ]
  }, {
    "tStartMs": 215410,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "has been essentially what\nwe seem to be selecting for."
    } ]
  }, {
    "tStartMs": 218900,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- [Derek] Every day in each flask"
    } ]
  }, {
    "tStartMs": 220660,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the bacteria divide six or seven times,"
    } ]
  }, {
    "tStartMs": 223570,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "which increases their\nnumbers a hundred fold."
    } ]
  }, {
    "tStartMs": 226840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Normally we think of generations"
    } ]
  }, {
    "tStartMs": 228440,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "as being limited by the\ntime that has elapsed,"
    } ]
  }, {
    "tStartMs": 231140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but in the case of these bacteria,"
    } ]
  }, {
    "tStartMs": 233000,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "they're limited by the\nresources available to them."
    } ]
  }, {
    "tStartMs": 236090,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "If they had 10 times the solution,"
    } ]
  }, {
    "tStartMs": 237930,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "they would increase their\nnumbers an additional 10 times."
    } ]
  }, {
    "tStartMs": 241840,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Then almost every day\nfor the past 33 years"
    } ]
  }, {
    "tStartMs": 245710,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "this transfer process has taken place."
    } ]
  }, {
    "tStartMs": 248610,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "0.1 milliliters or 1% of\nthe solution from each flask"
    } ]
  }, {
    "tStartMs": 252740,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "is transferred to a sterile new flask"
    } ]
  }, {
    "tStartMs": 255660,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "containing the same solution."
    } ]
  }, {
    "tStartMs": 257630,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "It essentially dilutes the\nbacteria a hundred fold."
    } ]
  }, {
    "tStartMs": 261200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "This gives them the space and resources"
    } ]
  }, {
    "tStartMs": 263300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "they need to grow and divide again,"
    } ]
  }, {
    "tStartMs": 265760,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "increasing their\npopulation a hundred times"
    } ]
  }, {
    "tStartMs": 268580,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "before this same process\nis repeated the next day."
    } ]
  }, {
    "tStartMs": 272360,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And then the day after that\nand the day after that,"
    } ]
  }, {
    "tStartMs": 275150,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "even on weekends,"
    } ]
  }, {
    "tStartMs": 276970,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "this process has been going\non for over three decades."
    } ]
  }, {
    "tStartMs": 281710,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "What happens to bacteria\nthat are not transferred"
    } ]
  }, {
    "tStartMs": 284160,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "to the new flasks, the 99%?"
    } ]
  }, {
    "tStartMs": 287350,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "- That's the autoclave room."
    } ]
  }, {
    "tStartMs": 289340,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "- [Derek] What happens\nin the autoclave room?"
    } ]
  }, {
    "tStartMs": 291610,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "- Every day 99% of the\nE. Coli meet their demise"
    } ]
  }, {
    "tStartMs": 295240,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "in this horrible room."
    } ]
  }, {
    "tStartMs": 296960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Derek] Is this like\na bacterial crematorium?"
    } ]
  }, {
    "tStartMs": 298940,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "- Yeah. Yeah, exactly."
    } ]
  }, {
    "tStartMs": 301473,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "- [Derek] You can imagine if\nthe scientists didn't do this,"
    } ]
  }, {
    "tStartMs": 303970,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "but instead gave all the bacteria"
    } ]
  }, {
    "tStartMs": 305760,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "a hundred times more solution\nto grow on every day,"
    } ]
  }, {
    "tStartMs": 308800,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "well, the experiment would\nsoon become unmanageable."
    } ]
  }, {
    "tStartMs": 311720,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "On day two, you would need\na cubic meter of solution,"
    } ]
  }, {
    "tStartMs": 315270,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "but by day 13 the experiment would be"
    } ]
  }, {
    "tStartMs": 317450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "10 times the volume of earth."
    } ]
  }, {
    "tStartMs": 319970,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "And by day 42,"
    } ]
  }, {
    "tStartMs": 321630,
    "dDurationMs": 4798,
    "segs": [ {
      "utf8": "the experiment would fill up\nthe entire observable universe."
    } ]
  }, {
    "tStartMs": 326428,
    "dDurationMs": 2782,
    "segs": [ {
      "utf8": "To me it seems like the\nwhole idea of genetics"
    } ]
  }, {
    "tStartMs": 329210,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is for them to stay constant"
    } ]
  }, {
    "tStartMs": 330650,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "and for mutations to be rare."
    } ]
  }, {
    "tStartMs": 332460,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 333293,
    "dDurationMs": 3127,
    "segs": [ {
      "utf8": "- Yet in your experiment\nit seems they're not rare."
    } ]
  }, {
    "tStartMs": 336420,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "- So we estimate that in our bacteria"
    } ]
  }, {
    "tStartMs": 340390,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "only about one out of maybe a hundred"
    } ]
  }, {
    "tStartMs": 343140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "or one out of a thousand cells"
    } ]
  }, {
    "tStartMs": 345120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "will have even a single mutation."
    } ]
  }, {
    "tStartMs": 346890,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "So that's not very much."
    } ]
  }, {
    "tStartMs": 349190,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "By contrast, in humans it's\nestimated that each one"
    } ]
  }, {
    "tStartMs": 352310,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "of our offspring has perhaps\n10, 20, 50 new mutations."
    } ]
  }, {
    "tStartMs": 357260,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So the bacteria are\nextremely conservative,"
    } ]
  }, {
    "tStartMs": 359210,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "but they're also billions of\nthem and even a tiny flask."
    } ]
  }, {
    "tStartMs": 362670,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And so if you have a chance\nin a thousand of mutating"
    } ]
  }, {
    "tStartMs": 365390,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "and you have a billion individuals,"
    } ]
  }, {
    "tStartMs": 367240,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "then every day in one of these flasks"
    } ]
  }, {
    "tStartMs": 369840,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "we might have a million new mutations."
    } ]
  }, {
    "tStartMs": 372580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So that's a lot of variation"
    } ]
  }, {
    "tStartMs": 374080,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "on which natural selection can act."
    } ]
  }, {
    "tStartMs": 375900,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Maybe half of those mutations\nhave no effect whatsoever"
    } ]
  }, {
    "tStartMs": 380460,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "on the bacteria's ability to grow"
    } ]
  }, {
    "tStartMs": 382050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and thrive in that particular environment."
    } ]
  }, {
    "tStartMs": 384090,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "They might be mutations that would matter"
    } ]
  }, {
    "tStartMs": 386620,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "out in the great outdoors,"
    } ]
  }, {
    "tStartMs": 387940,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "but this was a very simple environment,"
    } ]
  }, {
    "tStartMs": 389570,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "maybe those genes aren't even expressed."
    } ]
  }, {
    "tStartMs": 392020,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Another half of the mutations\nspeaking very, very roughly"
    } ]
  }, {
    "tStartMs": 394790,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "might actually be deleterious mutations."
    } ]
  }, {
    "tStartMs": 396610,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "They make the bacteria\nan inferior competitor,"
    } ]
  }, {
    "tStartMs": 399350,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "but there's maybe out of\nthose million mutations"
    } ]
  }, {
    "tStartMs": 402570,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that occur every day,"
    } ]
  }, {
    "tStartMs": 403890,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "maybe there's 10, maybe there's a hundred,"
    } ]
  }, {
    "tStartMs": 405920,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "maybe there's a thousand of them"
    } ]
  }, {
    "tStartMs": 407200,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "that actually change something in the cell"
    } ]
  }, {
    "tStartMs": 409820,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "that gives the bacteria\na competitive advantage"
    } ]
  }, {
    "tStartMs": 412320,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "over their progenitors."
    } ]
  }, {
    "tStartMs": 413710,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "And those then grow over\nthe course of that day."
    } ]
  }, {
    "tStartMs": 416600,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "Then every day 99% of the\npopulation is eliminated."
    } ]
  }, {
    "tStartMs": 421190,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "It's lucky 1% prevails,"
    } ]
  }, {
    "tStartMs": 423620,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and if those lucky 1%\ninclude one of the guys"
    } ]
  }, {
    "tStartMs": 426120,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "from the previous day that\nwas growing at 10% faster"
    } ]
  }, {
    "tStartMs": 429410,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "than the other guys,"
    } ]
  }, {
    "tStartMs": 430480,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "it has a higher\nprobability of contributing"
    } ]
  }, {
    "tStartMs": 433020,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "to that next flask, the next day's flask"
    } ]
  }, {
    "tStartMs": 436501,
    "dDurationMs": 1749,
    "segs": [ {
      "utf8": "and in the fresh medium,"
    } ]
  }, {
    "tStartMs": 438250,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and it will continue to\ngrow faster at a 10% clip,"
    } ]
  }, {
    "tStartMs": 441750,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and that compounds by\nan exponential process."
    } ]
  }, {
    "tStartMs": 444810,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "So the mutations, y'know, are\nreally rare when they first occur"
    } ]
  }, {
    "tStartMs": 448420,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and many of them are lost,"
    } ]
  }, {
    "tStartMs": 449950,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "but once they get common"
    } ]
  }, {
    "tStartMs": 451140,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "if they have that competitive advantage,"
    } ]
  }, {
    "tStartMs": 453150,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "they'll just sweep through the population."
    } ]
  }, {
    "tStartMs": 456070,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Derek] But how do you\nknow that the bacteria"
    } ]
  }, {
    "tStartMs": 457810,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "actually have a competitive advantage?"
    } ]
  }, {
    "tStartMs": 460510,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "I mean, how can you tell that\nthey're getting better suited"
    } ]
  }, {
    "tStartMs": 462990,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "to their environment?"
    } ]
  }, {
    "tStartMs": 464660,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Well, this is where one\nof the unique properties"
    } ]
  }, {
    "tStartMs": 466670,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "of bacteria come in."
    } ]
  }, {
    "tStartMs": 468360,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "They can be frozen for\nlong periods of time"
    } ]
  }, {
    "tStartMs": 471200,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "and then revived."
    } ]
  }, {
    "tStartMs": 472770,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- And so they're stored in\nsuspended animation here."
    } ]
  }, {
    "tStartMs": 476290,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "So these are the racks that\ncontain the frozen samples"
    } ]
  }, {
    "tStartMs": 479600,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "of the bacteria from\nthe various generations."
    } ]
  }, {
    "tStartMs": 483760,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "- [Derek] Every 500\ngenerations, roughly 75 days,"
    } ]
  }, {
    "tStartMs": 487260,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "they freeze a sample of each population."
    } ]
  }, {
    "tStartMs": 490480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "By freezing previous generations,"
    } ]
  }, {
    "tStartMs": 492310,
    "dDurationMs": 3113,
    "segs": [ {
      "utf8": "Lenski and his team have\na frozen fossil record."
    } ]
  }, {
    "tStartMs": 496570,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- So our samples from over 30 years ago"
    } ]
  }, {
    "tStartMs": 499010,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "remain perfectly viable."
    } ]
  }, {
    "tStartMs": 500880,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And so that gives us an ability to do"
    } ]
  }, {
    "tStartMs": 503250,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "what I like to call time travel."
    } ]
  }, {
    "tStartMs": 505040,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "We can literally compare\norganisms that lived"
    } ]
  }, {
    "tStartMs": 507800,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "at different points in time."
    } ]
  }, {
    "tStartMs": 509560,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So we can compete bacteria"
    } ]
  }, {
    "tStartMs": 510850,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "from generation 70,000\nagainst their ancestor."
    } ]
  }, {
    "tStartMs": 514950,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "- [Derek] That's right."
    } ]
  }, {
    "tStartMs": 516010,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "The way they measure\nfitness is by competing"
    } ]
  }, {
    "tStartMs": 518500,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "the current generation of bacteria"
    } ]
  }, {
    "tStartMs": 520230,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "against older generations."
    } ]
  }, {
    "tStartMs": 522350,
    "dDurationMs": 2948,
    "segs": [ {
      "utf8": "It's like a strange bacteria fight club."
    } ]
  }, {
    "tStartMs": 525298,
    "dDurationMs": 1372,
    "segs": [ {
      "utf8": "- Hey!"
    } ]
  }, {
    "tStartMs": 526670,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "- [Derek] They thaw\nout the old generation,"
    } ]
  }, {
    "tStartMs": 528730,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "mix it into a flask with\nthe current generation,"
    } ]
  }, {
    "tStartMs": 531110,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "and then plate out a\nsample of the solution"
    } ]
  }, {
    "tStartMs": 533040,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "to see the relative abundances"
    } ]
  }, {
    "tStartMs": 534580,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "of the two populations at the start."
    } ]
  }, {
    "tStartMs": 536970,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Then they incubate the flask for a day,"
    } ]
  }, {
    "tStartMs": 539810,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "and then plate them out again."
    } ]
  }, {
    "tStartMs": 541750,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And the point is to compare\ntheir relative growth rates,"
    } ]
  }, {
    "tStartMs": 544960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "which generation was better\nable to utilize the glucose"
    } ]
  }, {
    "tStartMs": 548170,
    "dDurationMs": 1583,
    "segs": [ {
      "utf8": "and divide faster?"
    } ]
  }, {
    "tStartMs": 551423,
    "dDurationMs": 1157,
    "segs": [ {
      "utf8": "- Well, how the heck do you\ntell the evolve bacterium"
    } ]
  }, {
    "tStartMs": 552580,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "from its ancestor?"
    } ]
  }, {
    "tStartMs": 553630,
    "dDurationMs": 1797,
    "segs": [ {
      "utf8": "Do they wave little flags at you and say,"
    } ]
  }, {
    "tStartMs": 555427,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "\"Hey, I'm the evolved guy.\""
    } ]
  }, {
    "tStartMs": 556710,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "And of course they don't."
    } ]
  }, {
    "tStartMs": 558290,
    "dDurationMs": 3195,
    "segs": [ {
      "utf8": "But what we have is this color marker"
    } ]
  }, {
    "tStartMs": 561485,
    "dDurationMs": 1795,
    "segs": [ {
      "utf8": "embedded in the experiment."
    } ]
  }, {
    "tStartMs": 563280,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "So six of our populations on\na certain kind of agar plate"
    } ]
  }, {
    "tStartMs": 567070,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "make red colonies and six\nof them make white colonies."
    } ]
  }, {
    "tStartMs": 570350,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "And we have one version of the ancestor"
    } ]
  }, {
    "tStartMs": 572550,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "that makes red colonies and\none that makes white colonies."
    } ]
  }, {
    "tStartMs": 575740,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "We can compete one of the\nred evolved populations"
    } ]
  }, {
    "tStartMs": 578850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "against the white ancestor,"
    } ]
  }, {
    "tStartMs": 580500,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "or one of the white evolved populations"
    } ]
  }, {
    "tStartMs": 582230,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "against the red ancestor\nand we can distinguish them."
    } ]
  }, {
    "tStartMs": 585490,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] In this case,"
    } ]
  }, {
    "tStartMs": 586323,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "it's clear that the evolved red population"
    } ]
  }, {
    "tStartMs": 588610,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "outcompeted their white ancestor."
    } ]
  }, {
    "tStartMs": 591610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Now, to determine the winner,"
    } ]
  }, {
    "tStartMs": 593380,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "all of the colonies are counted by hand."
    } ]
  }, {
    "tStartMs": 597230,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "- So what was the earliest\nsort of big findings"
    } ]
  }, {
    "tStartMs": 599640,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "from the experiment?"
    } ]
  }, {
    "tStartMs": 600870,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- The first thing we found,"
    } ]
  }, {
    "tStartMs": 602630,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "not that there was any doubt about it,"
    } ]
  }, {
    "tStartMs": 604240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but it's one of the most\ndirect demonstrations"
    } ]
  }, {
    "tStartMs": 606720,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "of Darwinian adaptation\nby natural selection,"
    } ]
  }, {
    "tStartMs": 608900,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "you can imagine."
    } ]
  }, {
    "tStartMs": 609800,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Yes, they're getting to be\nbetter competitors over time."
    } ]
  }, {
    "tStartMs": 613620,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "It's a common observation in\nother evolution experiments"
    } ]
  }, {
    "tStartMs": 616460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that evolution in a new\nenvironment gets off"
    } ]
  }, {
    "tStartMs": 618320,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "to a rip-roaring start"
    } ]
  }, {
    "tStartMs": 620010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and then tends to slow down over time."
    } ]
  }, {
    "tStartMs": 622980,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "And so we repeated that observation"
    } ]
  }, {
    "tStartMs": 625070,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "and I imagined that the longterm lines"
    } ]
  }, {
    "tStartMs": 627340,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "would actually sort of\nflat line at some point."
    } ]
  }, {
    "tStartMs": 629490,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "And I actually thought about\nstopping the experiment,"
    } ]
  }, {
    "tStartMs": 631790,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "but I got wise advice from colleagues"
    } ]
  }, {
    "tStartMs": 633960,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "and from my wife, Madeline,\nlet's keep it going."
    } ]
  }, {
    "tStartMs": 636710,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "And so I agreed to that."
    } ]
  }, {
    "tStartMs": 638290,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- [Derek] And it's good\nthing he did because in 2003,"
    } ]
  }, {
    "tStartMs": 641800,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the bacteria started doing\nsomething remarkable."
    } ]
  }, {
    "tStartMs": 644980,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "- One of the 12 lineages\nsuddenly began to consume"
    } ]
  }, {
    "tStartMs": 649080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "a second carbon source, citrate,"
    } ]
  }, {
    "tStartMs": 651540,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "which had been present in our medium"
    } ]
  }, {
    "tStartMs": 653770,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "throughout the experiment."
    } ]
  }, {
    "tStartMs": 655500,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "It's in the medium is what's\ncalled a chelating agent"
    } ]
  }, {
    "tStartMs": 658110,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to bind metals in the medium."
    } ]
  }, {
    "tStartMs": 661380,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But E. coli going back to\nits original definition"
    } ]
  }, {
    "tStartMs": 663600,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "as a species is incapable of that."
    } ]
  }, {
    "tStartMs": 666440,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "But one day we found one of\nour flasks had more turbidity."
    } ]
  }, {
    "tStartMs": 669820,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "I thought we probably had\na contaminant in there."
    } ]
  }, {
    "tStartMs": 671750,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Some bacterium had gotten in there"
    } ]
  }, {
    "tStartMs": 673160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that could eat the citrate"
    } ]
  }, {
    "tStartMs": 674480,
    "dDurationMs": 2697,
    "segs": [ {
      "utf8": "and, therefore, had raised the turbidity."
    } ]
  }, {
    "tStartMs": 677177,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "We went back into the freezer\nand restarted evolution."
    } ]
  }, {
    "tStartMs": 680380,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "We also started checking those bacteria"
    } ]
  }, {
    "tStartMs": 682810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to see whether they really were E. coli."
    } ]
  }, {
    "tStartMs": 684490,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Yep, they were E. Coli."
    } ]
  }, {
    "tStartMs": 685730,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Were the really E. coli"
    } ]
  }, {
    "tStartMs": 686870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that had come from the ancestral strain?"
    } ]
  }, {
    "tStartMs": 688790,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Yep. So we started doing genetics on it."
    } ]
  }, {
    "tStartMs": 691080,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "It was very clear that one\nof our bacteria lineages"
    } ]
  }, {
    "tStartMs": 694250,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "had essentially I like to\nsay sort of woken up one day,"
    } ]
  }, {
    "tStartMs": 697570,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "eaten the glucose,"
    } ]
  }, {
    "tStartMs": 698810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and unlike any of the other lineages"
    } ]
  }, {
    "tStartMs": 700610,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "discovered that there was\nthis nice lemony dessert,"
    } ]
  }, {
    "tStartMs": 703330,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "and they'd begun consuming that"
    } ]
  }, {
    "tStartMs": 704840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and getting a second source\nof carbon and energy."
    } ]
  }, {
    "tStartMs": 708040,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Zack was interested in the question"
    } ]
  }, {
    "tStartMs": 709820,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "of why did it take so long to evolve this"
    } ]
  }, {
    "tStartMs": 712790,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and has only one population\nevolve that ability?"
    } ]
  }, {
    "tStartMs": 716090,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "He went into the freezer"
    } ]
  }, {
    "tStartMs": 717660,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and he picked bacterial\nindividuals or clones"
    } ]
  }, {
    "tStartMs": 720450,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "from that lineage that\neventually evolved that ability."
    } ]
  }, {
    "tStartMs": 723490,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And then he tried to\nevolve that ability again"
    } ]
  }, {
    "tStartMs": 726990,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "starting from different points."
    } ]
  }, {
    "tStartMs": 728510,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "So in a sense, it's almost like,"
    } ]
  }, {
    "tStartMs": 730000,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "well, it's like rewinding the tape"
    } ]
  }, {
    "tStartMs": 731910,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "and starting let's go back to\nthe minute five of the movie."
    } ]
  }, {
    "tStartMs": 734900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Let's go back to a minute 10 of the movie,"
    } ]
  }, {
    "tStartMs": 736430,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "minute 20 of the movie"
    } ]
  }, {
    "tStartMs": 737700,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and see if the result changes\ndepending on when we did it,"
    } ]
  }, {
    "tStartMs": 741660,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "because this citrate phenotype"
    } ]
  }, {
    "tStartMs": 743500,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "there were essentially\ntwo competing explanations"
    } ]
  }, {
    "tStartMs": 745830,
    "dDurationMs": 3292,
    "segs": [ {
      "utf8": "for why it was so difficult to evolve."
    } ]
  }, {
    "tStartMs": 749122,
    "dDurationMs": 2798,
    "segs": [ {
      "utf8": "One was that it was just\na really rare mutation."
    } ]
  }, {
    "tStartMs": 751920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It wasn't like one of these\njust change one letter."
    } ]
  }, {
    "tStartMs": 754200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It was something where\nmaybe you had to flip"
    } ]
  }, {
    "tStartMs": 756520,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "a certain segment of DNA"
    } ]
  }, {
    "tStartMs": 757810,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and you had to have\nexactly this break point"
    } ]
  }, {
    "tStartMs": 759730,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and exactly that break point."
    } ]
  }, {
    "tStartMs": 761320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And that was the only way to do it."
    } ]
  }, {
    "tStartMs": 762760,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "So it was a rare event,"
    } ]
  }, {
    "tStartMs": 764540,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "but it could have happened\nat any point in time."
    } ]
  }, {
    "tStartMs": 767380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The alternative hypothesis is that,"
    } ]
  }, {
    "tStartMs": 770020,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "well, what happened was a series of events"
    } ]
  }, {
    "tStartMs": 774770,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "that made something perfectly\nordinary become possible"
    } ]
  }, {
    "tStartMs": 778470,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "that wasn't possible at the beginning"
    } ]
  }, {
    "tStartMs": 780500,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "because a mutation would\nonly have this effect"
    } ]
  }, {
    "tStartMs": 783730,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "once other aspects of\nthe organism had changed."
    } ]
  }, {
    "tStartMs": 787380,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "To make a long story short,"
    } ]
  }, {
    "tStartMs": 789130,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "it turns out it's such a\ndifficult trait to evolve"
    } ]
  }, {
    "tStartMs": 791480,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "because both of those hypotheses are true."
    } ]
  }, {
    "tStartMs": 794860,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] The experiment uncovered"
    } ]
  }, {
    "tStartMs": 796300,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "other surprising findings."
    } ]
  }, {
    "tStartMs": 797850,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Like instead of the bacteria"
    } ]
  }, {
    "tStartMs": 799450,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "getting more numerous over time,"
    } ]
  }, {
    "tStartMs": 801510,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "they actually decreased in number,"
    } ]
  }, {
    "tStartMs": 804130,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "but each individual bacterium got larger."
    } ]
  }, {
    "tStartMs": 808240,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Six of the 12 populations\nevolved hypermutability,"
    } ]
  }, {
    "tStartMs": 811810,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "mutation rates a hundred times\nhigher than their ancestors,"
    } ]
  }, {
    "tStartMs": 815550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but these populations\nsubsequently acquired"
    } ]
  }, {
    "tStartMs": 817890,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "additional mutations"
    } ]
  }, {
    "tStartMs": 819050,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "that brought the mutation rate back down."
    } ]
  }, {
    "tStartMs": 821400,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "I mean, it's advantageous"
    } ]
  }, {
    "tStartMs": 822480,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to be able to evolve faster than others,"
    } ]
  }, {
    "tStartMs": 824250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but if the mutation rate is too high,"
    } ]
  }, {
    "tStartMs": 826830,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "then offspring have too\nmany deleterious mutations."
    } ]
  }, {
    "tStartMs": 830340,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But maybe the most\nsurprising finding of all"
    } ]
  }, {
    "tStartMs": 833060,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "is what didn't happen."
    } ]
  }, {
    "tStartMs": 835180,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "- This view I had that\nthey were flat lining"
    } ]
  }, {
    "tStartMs": 837590,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "turned out to be quite false."
    } ]
  }, {
    "tStartMs": 839470,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "I had sort of imagined a very\nsimple mathematical model."
    } ]
  }, {
    "tStartMs": 843090,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "You can create something\ncalled a rectangular hyperbola,"
    } ]
  }, {
    "tStartMs": 846020,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "I guess, which has an initial high slope"
    } ]
  }, {
    "tStartMs": 848760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and then reaches an asymptote,"
    } ]
  }, {
    "tStartMs": 850950,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but they're equally simple models."
    } ]
  }, {
    "tStartMs": 853410,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "There's a model that also\nhas just two parameters"
    } ]
  }, {
    "tStartMs": 855460,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "called a power law model\nthat says things slow down,"
    } ]
  }, {
    "tStartMs": 859220,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "but it doesn't have an upper bound."
    } ]
  }, {
    "tStartMs": 860690,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "It says, just keep going\nfor time immemorial,"
    } ]
  }, {
    "tStartMs": 863210,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and things will just keep going faster,"
    } ]
  }, {
    "tStartMs": 865330,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "but at a slower and slower\nrate of further improvement."
    } ]
  }, {
    "tStartMs": 868700,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "And it turned out that\nmodel actually fits our data"
    } ]
  }, {
    "tStartMs": 872110,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "better than that original\nmodel I had imagined."
    } ]
  }, {
    "tStartMs": 875290,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "And not only does it fit it better,"
    } ]
  }, {
    "tStartMs": 877670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "okay, you say statistics,\nscience, fitting curves,"
    } ]
  }, {
    "tStartMs": 880460,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "it actually predicts the future."
    } ]
  }, {
    "tStartMs": 881960,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And that's what's really cool\nbecause the original model,"
    } ]
  }, {
    "tStartMs": 885410,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "if you give it say just 5,000 generations"
    } ]
  }, {
    "tStartMs": 887910,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "worth of our fitness data"
    } ]
  }, {
    "tStartMs": 889370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and ask it to predict into the future,"
    } ]
  }, {
    "tStartMs": 891650,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "it says the asymptote is here."
    } ]
  }, {
    "tStartMs": 893850,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "But then when we get more data, no!"
    } ]
  }, {
    "tStartMs": 895570,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "The bacteria are up here."
    } ]
  }, {
    "tStartMs": 896740,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "They've passed that asymptote."
    } ]
  }, {
    "tStartMs": 898610,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Whereas this power law model,"
    } ]
  }, {
    "tStartMs": 900090,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "which says things are slowing down,"
    } ]
  }, {
    "tStartMs": 901520,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "but never reaching an asymptote?"
    } ]
  }, {
    "tStartMs": 903220,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "We give it just 1/10 of\nour data from the past"
    } ]
  }, {
    "tStartMs": 906200,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "and it projects very\naccurately out to 50,000"
    } ]
  }, {
    "tStartMs": 909510,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "and even 60,000 generations\nwhen we last looked."
    } ]
  }, {
    "tStartMs": 912290,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It predicts sort of the future course"
    } ]
  }, {
    "tStartMs": 914290,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of the evolutionary trajectory."
    } ]
  }, {
    "tStartMs": 916090,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And to me, that's kind of profound"
    } ]
  }, {
    "tStartMs": 917800,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and it's sort of changed the\nway I look at this experiment,"
    } ]
  }, {
    "tStartMs": 921520,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "and even a little bit how\nI look at life on earth."
    } ]
  }, {
    "tStartMs": 925430,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "I mean, life on earth\ndoesn't stop evolving."
    } ]
  }, {
    "tStartMs": 927910,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "We know that."
    } ]
  }, {
    "tStartMs": 928743,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And we know that,"
    } ]
  }, {
    "tStartMs": 929576,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but we think that's,"
    } ]
  }, {
    "tStartMs": 930409,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "oh, that's because\nthey're asteroid impacts."
    } ]
  }, {
    "tStartMs": 931760,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "That's because of human impacts."
    } ]
  }, {
    "tStartMs": 933400,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "That's because they're viruses"
    } ]
  }, {
    "tStartMs": 935090,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that are attacking their hosts"
    } ]
  }, {
    "tStartMs": 936110,
    "dDurationMs": 2713,
    "segs": [ {
      "utf8": "and that the co-evolution\nis causing evolution"
    } ]
  }, {
    "tStartMs": 938823,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "is causing evolution to never stop."
    } ]
  }, {
    "tStartMs": 940880,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The world is always changing."
    } ]
  }, {
    "tStartMs": 942140,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "So of course, evolution never stops."
    } ]
  }, {
    "tStartMs": 944310,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And that is 100% true."
    } ]
  }, {
    "tStartMs": 946950,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "But what our experiment suggests"
    } ]
  }, {
    "tStartMs": 949310,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "is that even in the absence\nof environmental change,"
    } ]
  }, {
    "tStartMs": 953090,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "there are so many opportunities of smaller"
    } ]
  }, {
    "tStartMs": 956380,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "and smaller magnitude to\ncontinue to make progress"
    } ]
  }, {
    "tStartMs": 959930,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "that, in fact, progress\nprobably would never stop"
    } ]
  }, {
    "tStartMs": 963720,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "even in a constant environment."
    } ]
  }, {
    "tStartMs": 967030,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "To me, it's one of the reasons"
    } ]
  }, {
    "tStartMs": 968050,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to keep this experiment going."
    } ]
  }, {
    "tStartMs": 969640,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Does this model continue\nto predict the unfolding"
    } ]
  }, {
    "tStartMs": 972660,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "of the future fitness trajectory?"
    } ]
  }, {
    "tStartMs": 978790,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "- Okay. Now the conclusion\nof the experiment"
    } ]
  }, {
    "tStartMs": 981570,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "where I look for that fluorescent powder"
    } ]
  }, {
    "tStartMs": 984700,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "using this UV torch."
    } ]
  }, {
    "tStartMs": 986270,
    "dDurationMs": 1513,
    "segs": [ {
      "utf8": "So let's hit the lights."
    } ]
  }, {
    "tStartMs": 988995,
    "dDurationMs": 885,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 989880,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Whoa. There is a lot of\nfluorescent powder around here."
    } ]
  }, {
    "tStartMs": 994620,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Obviously there's a lot in the sink,"
    } ]
  }, {
    "tStartMs": 996890,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but also here on the tap,"
    } ]
  }, {
    "tStartMs": 999740,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "it looks like someone wiped\ndown the handle and the faucet."
    } ]
  }, {
    "tStartMs": 1004180,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "Oh, check out the dishwasher."
    } ]
  }, {
    "tStartMs": 1006960,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Yeah, and on the handle."
    } ]
  }, {
    "tStartMs": 1009290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This is a great way of visualizing"
    } ]
  }, {
    "tStartMs": 1011450,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "how dishcloths can spread\nbacteria around the house."
    } ]
  }, {
    "tStartMs": 1014950,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "What? (laughs)"
    } ]
  }, {
    "tStartMs": 1018230,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "It looks like finger marks."
    } ]
  }, {
    "tStartMs": 1022070,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "As a dad, I encounter lots of big messes"
    } ]
  }, {
    "tStartMs": 1024910,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and sticky hands and slimy faces."
    } ]
  }, {
    "tStartMs": 1027670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So when there is a mess or spill in my kitchen"
    } ]
  }, {
    "tStartMs": 1030220,
    "dDurationMs": 2773,
    "segs": [ {
      "utf8": "I choose to clean it up with Bounty"
    } ]
  }, {
    "tStartMs": 1032993,
