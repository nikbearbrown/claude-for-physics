{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- Do you bring this trick out at parties?"
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Oh no. It's a terrible party trick."
    } ]
  }, {
    "tStartMs": 5460,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Here we go."
    } ]
  }, {
    "tStartMs": 6900,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "3.141592653589793"
    } ]
  }, {
    "tStartMs": 10020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- This is Grant Gussman."
    } ]
  }, {
    "tStartMs": 11640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "He watched an old video of mine"
    } ]
  }, {
    "tStartMs": 13080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "about how we think"
    } ]
  }, {
    "tStartMs": 13913,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "that there are two systems of thought."
    } ]
  }, {
    "tStartMs": 16110,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "System two is the conscious\nslow effortful system."
    } ]
  }, {
    "tStartMs": 19650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And system one is subconscious."
    } ]
  }, {
    "tStartMs": 21660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Fast and automatic."
    } ]
  }, {
    "tStartMs": 23820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "To explore how these systems\nwork in his own head,"
    } ]
  }, {
    "tStartMs": 26460,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Grant decided to memorize\na hundred digits of pi."
    } ]
  }, {
    "tStartMs": 29760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Three eight four four six..."
    } ]
  }, {
    "tStartMs": 30593,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "- Then he just kept going."
    } ]
  }, {
    "tStartMs": 33000,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "He has now memorized 23,000 digits of pi"
    } ]
  }, {
    "tStartMs": 36480,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "in preparation to challenge\nthe north American record"
    } ]
  }, {
    "tStartMs": 38947,
    "dDurationMs": 1806,
    "segs": [ {
      "utf8": "- .95493038196."
    } ]
  }, {
    "tStartMs": 40753,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That's 200."
    } ]
  }, {
    "tStartMs": 41586,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 45060,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "- That's amazing."
    } ]
  }, {
    "tStartMs": 47970,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "I have wanted to make a video\nabout experts for a long time."
    } ]
  }, {
    "tStartMs": 56790,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This is Magnus Carlsen,"
    } ]
  }, {
    "tStartMs": 58470,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the five time world chess champion."
    } ]
  }, {
    "tStartMs": 60570,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "He's being shown chessboards"
    } ]
  }, {
    "tStartMs": 62070,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and asked to identify the\ngame in which they occurred."
    } ]
  }, {
    "tStartMs": 65460,
    "dDurationMs": 4863,
    "segs": [ {
      "utf8": "- This looks an awful\nlot like Tal V Botvinnik."
    } ]
  }, {
    "tStartMs": 70323,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "(playful music)"
    } ]
  }, {
    "tStartMs": 73584,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoops."
    } ]
  }, {
    "tStartMs": 76075,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "- Okay. This is the 24th\ngame from Sevilla obviously."
    } ]
  }, {
    "tStartMs": 78524,
    "dDurationMs": 856,
    "segs": [ {
      "utf8": "(chuckling)"
    } ]
  }, {
    "tStartMs": 79380,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Now I'm going to play\nthrough an opening."
    } ]
  }, {
    "tStartMs": 82140,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And stop me when you recognize the game."
    } ]
  }, {
    "tStartMs": 85050,
    "dDurationMs": 3394,
    "segs": [ {
      "utf8": "And if you can tell me who\nwas playing black in this one."
    } ]
  }, {
    "tStartMs": 88444,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 89277,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "(playful music)"
    } ]
  }, {
    "tStartMs": 92550,
    "dDurationMs": 2005,
    "segs": [ {
      "utf8": "I'm sure you've seen this opening before."
    } ]
  }, {
    "tStartMs": 94555,
    "dDurationMs": 1386,
    "segs": [ {
      "utf8": "- Okay. It's gonna be Anand."
    } ]
  }, {
    "tStartMs": 95941,
    "dDurationMs": 1756,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 97697,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Against?"
    } ]
  }, {
    "tStartMs": 99047,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "- Zapata."
    } ]
  }, {
    "tStartMs": 100500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- How can he do this?"
    } ]
  }, {
    "tStartMs": 102000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It seems like superhuman ability."
    } ]
  }, {
    "tStartMs": 104700,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Well decades ago,"
    } ]
  }, {
    "tStartMs": 105540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "scientists wanted to know"
    } ]
  }, {
    "tStartMs": 106740,
    "dDurationMs": 2412,
    "segs": [ {
      "utf8": "what makes experts like\nchess masters special."
    } ]
  }, {
    "tStartMs": 109152,
    "dDurationMs": 2808,
    "segs": [ {
      "utf8": "Do they have incredibly high IQ's,"
    } ]
  }, {
    "tStartMs": 111960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "much better spatial\nreasoning than average,"
    } ]
  }, {
    "tStartMs": 114300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "bigger short term memory spans?"
    } ]
  }, {
    "tStartMs": 116520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Well, it turns out that as a group,"
    } ]
  }, {
    "tStartMs": 118560,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "chess masters are not exceptional\non any of these measures."
    } ]
  }, {
    "tStartMs": 122640,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But one experiment showed"
    } ]
  }, {
    "tStartMs": 124380,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "how their performance was\nvastly superior to amateurs."
    } ]
  }, {
    "tStartMs": 128100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "In 1973, William Chase and Herbert Simon"
    } ]
  }, {
    "tStartMs": 130980,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "recruited three chess players,"
    } ]
  }, {
    "tStartMs": 132900,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "a master, an A player,"
    } ]
  }, {
    "tStartMs": 134610,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "who's an advanced amateur, and a beginner."
    } ]
  }, {
    "tStartMs": 138030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "A chess board was set\nup with around 25 pieces"
    } ]
  }, {
    "tStartMs": 140430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "positioned as they might be during a game."
    } ]
  }, {
    "tStartMs": 142740,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "And each player was allowed"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to look at the board for five seconds."
    } ]
  }, {
    "tStartMs": 146460,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Then they were asked"
    } ]
  }, {
    "tStartMs": 147390,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to replicate the setup from memory"
    } ]
  }, {
    "tStartMs": 149100,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "on a second board in front of them."
    } ]
  }, {
    "tStartMs": 151260,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The players could take as many"
    } ]
  }, {
    "tStartMs": 152550,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "five second peeks as they needed"
    } ]
  }, {
    "tStartMs": 154140,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to get their board to match."
    } ]
  }, {
    "tStartMs": 156150,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "From just the first look,"
    } ]
  }, {
    "tStartMs": 158130,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "the master could recall\nthe positions of 16 pieces."
    } ]
  }, {
    "tStartMs": 161370,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "The A player could recall eight,"
    } ]
  }, {
    "tStartMs": 163017,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "and the beginner only four."
    } ]
  }, {
    "tStartMs": 165119,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "The master only needed\nhalf the number of peeks"
    } ]
  }, {
    "tStartMs": 168000,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "as the A player to get\ntheir board perfect."
    } ]
  }, {
    "tStartMs": 170730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But then the researchers\narranged the board"
    } ]
  }, {
    "tStartMs": 172620,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "with pieces in random positions"
    } ]
  }, {
    "tStartMs": 174600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that would never arise in a real game."
    } ]
  }, {
    "tStartMs": 177240,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "And now, the chess master performed"
    } ]
  }, {
    "tStartMs": 179325,
    "dDurationMs": 2265,
    "segs": [ {
      "utf8": "no better than the beginner."
    } ]
  }, {
    "tStartMs": 181590,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "After the first look,"
    } ]
  }, {
    "tStartMs": 182520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "all players, regardless of rank"
    } ]
  }, {
    "tStartMs": 184020,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "could remember the location\nof only three pieces."
    } ]
  }, {
    "tStartMs": 186810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "The data are clear."
    } ]
  }, {
    "tStartMs": 188220,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Chess experts don't have\nbetter memory in general,"
    } ]
  }, {
    "tStartMs": 190980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but they have better memory specifically"
    } ]
  }, {
    "tStartMs": 192870,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "for chess positions that\ncould occur in a real game."
    } ]
  }, {
    "tStartMs": 195960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The implication is what makes\nthe chess master special,"
    } ]
  }, {
    "tStartMs": 198720,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "is that they have seen lots\nand lots of chess games."
    } ]
  }, {
    "tStartMs": 202110,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And over that time,"
    } ]
  }, {
    "tStartMs": 202943,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "their brains have learned patterns."
    } ]
  }, {
    "tStartMs": 204570,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "So rather than seeing"
    } ]
  }, {
    "tStartMs": 205650,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "individual pieces at individual positions,"
    } ]
  }, {
    "tStartMs": 208170,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "they see a smaller number of\nrecognizable configurations."
    } ]
  }, {
    "tStartMs": 212160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "This is called 'chunking'."
    } ]
  }, {
    "tStartMs": 213960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "What we have stored in long-term memory"
    } ]
  }, {
    "tStartMs": 216000,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "allows us to recognize complex\nstimuli as just one thing."
    } ]
  }, {
    "tStartMs": 220050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "For example, you recognize this as pi"
    } ]
  }, {
    "tStartMs": 222660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "rather than a string of\nsix unrelated numbers"
    } ]
  }, {
    "tStartMs": 225000,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "or meaningless squiggles for that matter."
    } ]
  }, {
    "tStartMs": 227790,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- There's a wonderful\nsequence I like a lot"
    } ]
  }, {
    "tStartMs": 229980,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which is three zero one seven three."
    } ]
  }, {
    "tStartMs": 232830,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "Which to me, means Stephen\nCurry number 30, won 73 games,"
    } ]
  }, {
    "tStartMs": 237720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which is the record back in 2016."
    } ]
  }, {
    "tStartMs": 239820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So three oh one seven three."
    } ]
  }, {
    "tStartMs": 241680,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- At its core, expertise\nis about recognition."
    } ]
  }, {
    "tStartMs": 245460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Magnus Carlsen recognizes chess positions"
    } ]
  }, {
    "tStartMs": 247950,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "the same way we recognize faces."
    } ]
  }, {
    "tStartMs": 250650,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "And recognition leads\ndirectly to intuition."
    } ]
  }, {
    "tStartMs": 253954,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "If you see an angry face,"
    } ]
  }, {
    "tStartMs": 255930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "you have a pretty good idea"
    } ]
  }, {
    "tStartMs": 257580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "of what's gonna come next."
    } ]
  }, {
    "tStartMs": 259320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Chess masters recognize board positions"
    } ]
  }, {
    "tStartMs": 261540,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and instinctively know the best move."
    } ]
  }, {
    "tStartMs": 264270,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "- Most of the time, I know what to do."
    } ]
  }, {
    "tStartMs": 268410,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "I don't have to figure it out."
    } ]
  }, {
    "tStartMs": 272310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- To develop the long\nterm memory of an expert"
    } ]
  }, {
    "tStartMs": 274710,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "takes a long time."
    } ]
  }, {
    "tStartMs": 276440,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "10,000 hours is the rule of thumb"
    } ]
  }, {
    "tStartMs": 278550,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "popularized by Malcolm Gladwell,"
    } ]
  }, {
    "tStartMs": 280560,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "but 10,000 hours of practice\nby itself is not sufficient."
    } ]
  }, {
    "tStartMs": 284940,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "There are four additional\ncriteria that must be met."
    } ]
  }, {
    "tStartMs": 288570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And in areas where these\ncriteria aren't met,"
    } ]
  }, {
    "tStartMs": 291390,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "it's impossible to become an expert."
    } ]
  }, {
    "tStartMs": 294420,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So the first one is many\nrepeated attempts with feedback."
    } ]
  }, {
    "tStartMs": 298080,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Tennis players hit hundreds\nof fore hands in practice."
    } ]
  }, {
    "tStartMs": 301410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Chess players play thousands of games"
    } ]
  }, {
    "tStartMs": 303510,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "before they're grand masters"
    } ]
  }, {
    "tStartMs": 304920,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and physicists solve\nthousands of physics problems."
    } ]
  }, {
    "tStartMs": 308580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Each one gets feedback."
    } ]
  }, {
    "tStartMs": 310080,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The tennis player sees"
    } ]
  }, {
    "tStartMs": 311370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "whether each shot clears\nthe net and is in or out."
    } ]
  }, {
    "tStartMs": 314040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The chess player either\nwins or loses the game."
    } ]
  }, {
    "tStartMs": 316770,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And the physicist gets the\nproblem right or wrong."
    } ]
  }, {
    "tStartMs": 319980,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But some professionals don't\nget repeated experience"
    } ]
  }, {
    "tStartMs": 322680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with the same sorts of problems."
    } ]
  }, {
    "tStartMs": 324600,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Political scientist, Philip\nTetlock picked 284 people"
    } ]
  }, {
    "tStartMs": 328020,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "who make their living\ncommenting or offering advice"
    } ]
  }, {
    "tStartMs": 330750,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "on political and economic trends."
    } ]
  }, {
    "tStartMs": 332760,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "This included journalists,"
    } ]
  }, {
    "tStartMs": 334140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "foreign policy specialists,"
    } ]
  }, {
    "tStartMs": 335550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "economists, and intelligence analysts."
    } ]
  }, {
    "tStartMs": 337920,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Over two decades,"
    } ]
  }, {
    "tStartMs": 339030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "he peppered them with questions like"
    } ]
  }, {
    "tStartMs": 340800,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Would George Bush be re-elected?"
    } ]
  }, {
    "tStartMs": 342810,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Would apartheid in South\nAfrica end peacefully?"
    } ]
  }, {
    "tStartMs": 345690,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Would Quebec secede from Canada?"
    } ]
  }, {
    "tStartMs": 348150,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And would the .com bubble burst?"
    } ]
  }, {
    "tStartMs": 350730,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "In each case, the pundits\nrated the probability"
    } ]
  }, {
    "tStartMs": 353100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of several possible outcomes."
    } ]
  }, {
    "tStartMs": 354930,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And by the end of the study,"
    } ]
  }, {
    "tStartMs": 356130,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Tetlock had quantified 82,361 predictions."
    } ]
  }, {
    "tStartMs": 360690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, how did they do?"
    } ]
  }, {
    "tStartMs": 363000,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Pretty terribly."
    } ]
  }, {
    "tStartMs": 364410,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "These experts, most of whom\nhad post graduate degrees,"
    } ]
  }, {
    "tStartMs": 367292,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "performed worse than if they had just"
    } ]
  }, {
    "tStartMs": 369360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "assigned equal probabilities\nto all the outcomes."
    } ]
  }, {
    "tStartMs": 372480,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In other words,"
    } ]
  }, {
    "tStartMs": 373313,
    "dDurationMs": 1177,
    "segs": [ {
      "utf8": "people who spend their time"
    } ]
  }, {
    "tStartMs": 374490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and earned their living\nstudying a particular topic,"
    } ]
  }, {
    "tStartMs": 377010,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "produce poorer predictions\nthan random chance."
    } ]
  }, {
    "tStartMs": 380130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Even in the areas they knew best,"
    } ]
  }, {
    "tStartMs": 381960,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "experts were not significantly\nbetter than non-specialists."
    } ]
  }, {
    "tStartMs": 385260,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "The problem is,"
    } ]
  }, {
    "tStartMs": 386160,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "most of the events they have\nto predict are one-offs."
    } ]
  }, {
    "tStartMs": 388980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "They haven't had the experience"
    } ]
  }, {
    "tStartMs": 390180,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "of going through these events"
    } ]
  }, {
    "tStartMs": 391260,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or very similar ones many times before."
    } ]
  }, {
    "tStartMs": 393930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Even presidential elections\nonly happen infrequently,"
    } ]
  }, {
    "tStartMs": 396570,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and each one in a slightly\ndifferent environment."
    } ]
  }, {
    "tStartMs": 399330,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So we should be wary of experts"
    } ]
  }, {
    "tStartMs": 401850,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "who don't have repeated\nexperience with feedback."
    } ]
  }, {
    "tStartMs": 404911,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 406320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The next requirement\nis a valid environment."
    } ]
  }, {
    "tStartMs": 409170,
    "dDurationMs": 1475,
    "segs": [ {
      "utf8": "One that contains regularities"
    } ]
  }, {
    "tStartMs": 410645,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "that make it at least\nsomewhat predictable."
    } ]
  }, {
    "tStartMs": 413520,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "A gambler betting at the\nroulette wheel for example,"
    } ]
  }, {
    "tStartMs": 415860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "may have thousands of repeated experiences"
    } ]
  }, {
    "tStartMs": 418140,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "with the same event."
    } ]
  }, {
    "tStartMs": 419100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And for each one,"
    } ]
  }, {
    "tStartMs": 419933,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "they get clear feedback"
    } ]
  }, {
    "tStartMs": 420900,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "in the form of whether they win or lose,"
    } ]
  }, {
    "tStartMs": 423270,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but you would rightfully\nnot consider them an expert"
    } ]
  }, {
    "tStartMs": 425940,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "because the environment is low validity."
    } ]
  }, {
    "tStartMs": 428610,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "A roulette wheel is essentially random,"
    } ]
  }, {
    "tStartMs": 430740,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "so there are no\nregularities to be learned."
    } ]
  }, {
    "tStartMs": 433920,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "In 2006, legendary investor, Warren Buffet"
    } ]
  }, {
    "tStartMs": 436770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "offered to bet a million dollars"
    } ]
  }, {
    "tStartMs": 438750,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "that he could pick an investment"
    } ]
  }, {
    "tStartMs": 440130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that would outperform Wall\nStreet's best hedge funds"
    } ]
  }, {
    "tStartMs": 442440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "over a 10 year period."
    } ]
  }, {
    "tStartMs": 444120,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Hedge funds are pools of money"
    } ]
  }, {
    "tStartMs": 445380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that are actively managed\nby some of the brightest"
    } ]
  }, {
    "tStartMs": 447300,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and most experienced\ntraders on Wall Street."
    } ]
  }, {
    "tStartMs": 449910,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "They use advanced techniques\nlike short selling,"
    } ]
  }, {
    "tStartMs": 452190,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "leverage, and derivatives"
    } ]
  }, {
    "tStartMs": 453420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in an attempt to provide outsized returns."
    } ]
  }, {
    "tStartMs": 456060,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And consequently, they\ncharge significant fees."
    } ]
  }, {
    "tStartMs": 459150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "One person took Buffet up on the bet;"
    } ]
  }, {
    "tStartMs": 461520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Ted Seides of Protege Partners."
    } ]
  }, {
    "tStartMs": 463890,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "For his investment, he\nselected five hedge funds."
    } ]
  }, {
    "tStartMs": 466650,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Well actually, five funds of hedge funds."
    } ]
  }, {
    "tStartMs": 469620,
    "dDurationMs": 3891,
    "segs": [ {
      "utf8": "So in total, a collection of\nover 200 individual funds."
    } ]
  }, {
    "tStartMs": 473511,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Warren Buffet took a\nvery different approach."
    } ]
  }, {
    "tStartMs": 476430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "He picked the most basic,"
    } ]
  }, {
    "tStartMs": 477840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "boring investment imaginable;"
    } ]
  }, {
    "tStartMs": 479760,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "a passive index fund that just tracks"
    } ]
  }, {
    "tStartMs": 481710,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the weighted value of the 500 biggest"
    } ]
  }, {
    "tStartMs": 483540,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "public companies in America, the S\u0026P 500."
    } ]
  }, {
    "tStartMs": 487050,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "They started the bet on January 1st, 2008,"
    } ]
  }, {
    "tStartMs": 489780,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and immediately things did\nnot look good for Buffet."
    } ]
  }, {
    "tStartMs": 492960,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It was the start of the\nglobal financial crisis,"
    } ]
  }, {
    "tStartMs": 495150,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the market tanked."
    } ]
  }, {
    "tStartMs": 496650,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But the hedge funds could\nchange their holdings"
    } ]
  }, {
    "tStartMs": 499410,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and even profit from market falls."
    } ]
  }, {
    "tStartMs": 501480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So they lost some value,"
    } ]
  }, {
    "tStartMs": 502920,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "but not as much as the market average."
    } ]
  }, {
    "tStartMs": 504954,
    "dDurationMs": 1716,
    "segs": [ {
      "utf8": "The hedge funds stayed ahead"
    } ]
  }, {
    "tStartMs": 506670,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for the next three years,"
    } ]
  }, {
    "tStartMs": 507930,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "but by 2011, the S\u0026P 500 had pulled even."
    } ]
  }, {
    "tStartMs": 511051,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "And from then on, it wasn't even close."
    } ]
  }, {
    "tStartMs": 513870,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The market average surged"
    } ]
  }, {
    "tStartMs": 515190,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "leaving the hedge funds in the dust."
    } ]
  }, {
    "tStartMs": 517230,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "After 10 years, Buffet's\nindex fund gained 125.8%"
    } ]
  }, {
    "tStartMs": 521610,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to the hedge funds' 36%."
    } ]
  }, {
    "tStartMs": 524400,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Now the market performance"
    } ]
  }, {
    "tStartMs": 525690,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "was not unusual over this time."
    } ]
  }, {
    "tStartMs": 527790,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "At eight and a half percent annual growth,"
    } ]
  }, {
    "tStartMs": 529560,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "it nearly matches the stock\nmarket's long run average."
    } ]
  }, {
    "tStartMs": 532800,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So why did so many\ninvestment professionals"
    } ]
  }, {
    "tStartMs": 534870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "with years of industry experience,"
    } ]
  }, {
    "tStartMs": 536610,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "research at their fingertips,"
    } ]
  }, {
    "tStartMs": 537840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and big financial incentives to perform,"
    } ]
  }, {
    "tStartMs": 540180,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "fail to beat the market?"
    } ]
  }, {
    "tStartMs": 542040,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Well because stocks are a\nlow validity environment."
    } ]
  }, {
    "tStartMs": 544860,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Over the short term,"
    } ]
  }, {
    "tStartMs": 545730,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "stock price movements are\nalmost entirely random."
    } ]
  }, {
    "tStartMs": 548520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So the feedback, although\nclear and immediate"
    } ]
  }, {
    "tStartMs": 550770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "doesn't actually reflect anything"
    } ]
  }, {
    "tStartMs": 552150,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "about the quality of the decision making."
    } ]
  }, {
    "tStartMs": 555270,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "It's closer to a roulette\nwheel than to Chess."
    } ]
  }, {
    "tStartMs": 559320,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Over a 10 year period,"
    } ]
  }, {
    "tStartMs": 560460,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "around 80% of all actively\nmanaged investment funds"
    } ]
  }, {
    "tStartMs": 564060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "fail to beat the market average."
    } ]
  }, {
    "tStartMs": 566190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And if you look at longer time periods,"
    } ]
  }, {
    "tStartMs": 567870,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "under performance rises to 90%."
    } ]
  }, {
    "tStartMs": 570690,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And before you say,"
    } ]
  }, {
    "tStartMs": 571523,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "\"Well that means 10% of\nmanagers have actual skill,"
    } ]
  }, {
    "tStartMs": 574770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "consider that just through random chance,"
    } ]
  }, {
    "tStartMs": 576420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "some people would beat the market anyway."
    } ]
  }, {
    "tStartMs": 578490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Portfolios picked by\ncats or throwing darts"
    } ]
  }, {
    "tStartMs": 581010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "have been shown to do just that."
    } ]
  }, {
    "tStartMs": 582930,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And in addition to luck,"
    } ]
  }, {
    "tStartMs": 584280,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "there are nefarious practices"
    } ]
  }, {
    "tStartMs": 585750,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "from insider trading to\npump and dump schemes."
    } ]
  }, {
    "tStartMs": 588600,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Now I don't mean to say there\nare no expert investors."
    } ]
  }, {
    "tStartMs": 591110,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Warren Buffet himself is a clear example."
    } ]
  }, {
    "tStartMs": 593790,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But the vast majority of stock pickers"
    } ]
  }, {
    "tStartMs": 596310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and active investment managers,"
    } ]
  }, {
    "tStartMs": 597780,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "do not demonstrate expert performance"
    } ]
  }, {
    "tStartMs": 600330,
    "dDurationMs": 3027,
    "segs": [ {
      "utf8": "because of the low validity\nof their environment."
    } ]
  }, {
    "tStartMs": 603357,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "Brief side note,"
    } ]
  }, {
    "tStartMs": 604740,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "if we know that stock picking"
    } ]
  }, {
    "tStartMs": 606120,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "will usually yield worse\nresults over the long term,"
    } ]
  }, {
    "tStartMs": 609180,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and that what active\nmanagers charge in fees"
    } ]
  }, {
    "tStartMs": 611490,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "is rarely compensated for\nin improved performance,"
    } ]
  }, {
    "tStartMs": 614172,
    "dDurationMs": 2028,
    "segs": [ {
      "utf8": "then why is so much money"
    } ]
  }, {
    "tStartMs": 616200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "invested in individual stocks,"
    } ]
  }, {
    "tStartMs": 618000,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "mutual funds, and hedge funds?"
    } ]
  }, {
    "tStartMs": 620250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Well let me answer that with a story."
    } ]
  }, {
    "tStartMs": 622530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "There was an experiment carried\nout with rats and humans,"
    } ]
  }, {
    "tStartMs": 625350,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "where there's a red\nbutton and a green button"
    } ]
  }, {
    "tStartMs": 627210,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that can each light up."
    } ]
  }, {
    "tStartMs": 629190,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "80% of the time, the\ngreen button lights up."
    } ]
  }, {
    "tStartMs": 631470,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And 20% of the time the\nred button lights up,"
    } ]
  }, {
    "tStartMs": 634140,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but randomly."
    } ]
  }, {
    "tStartMs": 635430,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So you can never be sure\nwhich button will light."
    } ]
  }, {
    "tStartMs": 638790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And the task for the subject,"
    } ]
  }, {
    "tStartMs": 640170,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "either rat or human,"
    } ]
  }, {
    "tStartMs": 641310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "is to guess beforehand\nwhich button will light up"
    } ]
  }, {
    "tStartMs": 643620,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "by pressing it."
    } ]
  }, {
    "tStartMs": 644760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "For the rat,"
    } ]
  }, {
    "tStartMs": 645593,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "if they guess right,\nthey get a bit of food."
    } ]
  }, {
    "tStartMs": 647130,
    "dDurationMs": 2471,
    "segs": [ {
      "utf8": "And if they guess wrong,\na mild electric shock."
    } ]
  }, {
    "tStartMs": 649601,
    "dDurationMs": 3319,
    "segs": [ {
      "utf8": "The rat quickly learns to\npress only the green button"
    } ]
  }, {
    "tStartMs": 652920,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and accept the 80% win percentage."
    } ]
  }, {
    "tStartMs": 655980,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Humans on the other hand,"
    } ]
  }, {
    "tStartMs": 657300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "usually press the green button."
    } ]
  }, {
    "tStartMs": 659040,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "But once in a while,"
    } ]
  }, {
    "tStartMs": 660000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "they try to predict when\nthe red light will go on."
    } ]
  }, {
    "tStartMs": 662550,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "And as a result, they guess\nright only 68% of the time."
    } ]
  }, {
    "tStartMs": 666360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We have a hard time\naccepting average results."
    } ]
  }, {
    "tStartMs": 668610,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And we see patterns everywhere,\nincluding in randomness."
    } ]
  }, {
    "tStartMs": 671850,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So we try to beat the average\nby predicting the pattern."
    } ]
  }, {
    "tStartMs": 675030,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "But when there is no pattern,\nthis is a terrible strategy."
    } ]
  }, {
    "tStartMs": 678900,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Even when there are patterns,"
    } ]
  }, {
    "tStartMs": 680520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "you need timely feedback\nin order to learn them."
    } ]
  }, {
    "tStartMs": 683310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And YouTube knows this,"
    } ]
  }, {
    "tStartMs": 684660,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "which is why within the first hour"
    } ]
  }, {
    "tStartMs": 685950,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "after posting a video,"
    } ]
  }, {
    "tStartMs": 687240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "they tell you how its performance compares"
    } ]
  }, {
    "tStartMs": 689430,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to your last 10 videos."
    } ]
  }, {
    "tStartMs": 691110,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "There's even confetti fireworks"
    } ]
  }, {
    "tStartMs": 692880,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "when the video is number one."
    } ]
  }, {
    "tStartMs": 694740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I know it seems like a silly thing,"
    } ]
  }, {
    "tStartMs": 696570,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but you have no idea how\npowerful a reward this is"
    } ]
  }, {
    "tStartMs": 699510,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and how much YouTuber effort"
    } ]
  }, {
    "tStartMs": 700710,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "is spent chasing this\nsupercharged dopamine hit."
    } ]
  }, {
    "tStartMs": 704250,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "To understand the difference between"
    } ]
  }, {
    "tStartMs": 705780,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "immediate and delayed feedback,"
    } ]
  }, {
    "tStartMs": 707370,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "psychologist Daniel Kahneman contrasts"
    } ]
  }, {
    "tStartMs": 709680,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the experiences of\nanesthesiologists and radiologists."
    } ]
  }, {
    "tStartMs": 713310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Anesthesiologists work\nalongside the patient"
    } ]
  }, {
    "tStartMs": 715710,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and get feedback straight away."
    } ]
  }, {
    "tStartMs": 717300,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Is the patient unconscious\nwith stable vital signs?"
    } ]
  }, {
    "tStartMs": 720390,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "With this immediate feedback,"
    } ]
  }, {
    "tStartMs": 721920,
    "dDurationMs": 884,
    "segs": [ {
      "utf8": "it's easier for them to learn"
    } ]
  }, {
    "tStartMs": 722804,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "the regularities of their environment."
    } ]
  }, {
    "tStartMs": 725070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Radiologists, on the other hand,"
    } ]
  }, {
    "tStartMs": 726660,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "don't get rapid feedback\non their diagnoses"
    } ]
  }, {
    "tStartMs": 728910,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "if they get it at all."
    } ]
  }, {
    "tStartMs": 730037,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "This makes it much harder\nfor them to improve."
    } ]
  }, {
    "tStartMs": 732870,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Radiologists typically correctly diagnose"
    } ]
  }, {
    "tStartMs": 735210,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "breast cancer from x-rays\njust 70% of the time."
    } ]
  }, {
    "tStartMs": 738963,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "Delayed feedback also\nseems to be a problem"
    } ]
  }, {
    "tStartMs": 741270,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "for college admissions officers\nand recruitment specialists."
    } ]
  }, {
    "tStartMs": 744540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "After admitting someone to college,"
    } ]
  }, {
    "tStartMs": 746070,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or hiring someone at a big company,"
    } ]
  }, {
    "tStartMs": 747810,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "you may never, or only much\nlater find out how they did."
    } ]
  }, {
    "tStartMs": 751140,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This makes it harder to\nrecognize the patterns"
    } ]
  }, {
    "tStartMs": 753360,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "in ideal candidates."
    } ]
  }, {
    "tStartMs": 755130,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "In one study,"
    } ]
  }, {
    "tStartMs": 755970,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Richard Melton tried to predict"
    } ]
  }, {
    "tStartMs": 757350,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "the grades of freshmen"
    } ]
  }, {
    "tStartMs": 758400,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "at the end of their first year of college."
    } ]
  }, {
    "tStartMs": 760620,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "A set of 14 counselors"
    } ]
  }, {
    "tStartMs": 762090,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "interviewed each student"
    } ]
  }, {
    "tStartMs": 763230,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "for 45 minutes to an hour."
    } ]
  }, {
    "tStartMs": 765300,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "They also had access\nto high school grades,"
    } ]
  }, {
    "tStartMs": 767430,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "several aptitude tests,"
    } ]
  }, {
    "tStartMs": 768810,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and a four page personal statement."
    } ]
  }, {
    "tStartMs": 771270,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "For comparison, Melton\ncreated an algorithm"
    } ]
  }, {
    "tStartMs": 774060,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that used as input,"
    } ]
  }, {
    "tStartMs": 775380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "only a fraction of the information."
    } ]
  }, {
    "tStartMs": 777300,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Just high school grades\nand one aptitude test."
    } ]
  }, {
    "tStartMs": 779940,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Nevertheless, the\nformula was more accurate"
    } ]
  }, {
    "tStartMs": 782700,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "than 11 of the 14 counselors."
    } ]
  }, {
    "tStartMs": 785088,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "Melton's study was reported alongside"
    } ]
  }, {
    "tStartMs": 787230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "over a dozen similar results"
    } ]
  }, {
    "tStartMs": 789000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "across a variety of other domains,"
    } ]
  }, {
    "tStartMs": 790830,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "from predicting who would violate parole"
    } ]
  }, {
    "tStartMs": 792720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to who'd succeed in pilot training."
    } ]
  }, {
    "tStartMs": 795240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "If you've ever been denied admission"
    } ]
  }, {
    "tStartMs": 796680,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to an educational institution,"
    } ]
  }, {
    "tStartMs": 798270,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "or turned down for a job,"
    } ]
  }, {
    "tStartMs": 799710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "it feels like an expert has\nconsidered your potential"
    } ]
  }, {
    "tStartMs": 802200,
    "dDurationMs": 2727,
    "segs": [ {
      "utf8": "and decided that you don't\nhave what it takes to succeed."
    } ]
  }, {
    "tStartMs": 804927,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "I was rejected twice from film school"
    } ]
  }, {
    "tStartMs": 807120,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and twice from a drama program."
    } ]
  }, {
    "tStartMs": 809190,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "So it's comforting to know"
    } ]
  }, {
    "tStartMs": 810240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that the gatekeepers at these institutions"
    } ]
  }, {
    "tStartMs": 812160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "aren't great predictors of future success."
    } ]
  }, {
    "tStartMs": 814800,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So if you're in a valid environment,"
    } ]
  }, {
    "tStartMs": 816870,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and you get repeated experience\nwith the same events,"
    } ]
  }, {
    "tStartMs": 819030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "with clear, timely\nfeedback from each attempt,"
    } ]
  }, {
    "tStartMs": 821700,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "will you definitely become an expert"
    } ]
  }, {
    "tStartMs": 823290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "in 10,000 hours or so?"
    } ]
  }, {
    "tStartMs": 825120,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The answer unfortunately is no."
    } ]
  }, {
    "tStartMs": 827460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Because most of us want to be comfortable."
    } ]
  }, {
    "tStartMs": 830040,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "For a lot of tasks in life,"
    } ]
  }, {
    "tStartMs": 831630,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "we can become competent in a\nfairly short period of time."
    } ]
  }, {
    "tStartMs": 834660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Take driving a car for example,"
    } ]
  }, {
    "tStartMs": 836400,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "initially it's pretty challenging."
    } ]
  }, {
    "tStartMs": 837870,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It takes up all of system two."
    } ]
  }, {
    "tStartMs": 839730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Bu after 50 hours or so\nit becomes automatic."
    } ]
  }, {
    "tStartMs": 842610,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "System one takes over,"
    } ]
  }, {
    "tStartMs": 843570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and you can do it without\nmuch conscious thought."
    } ]
  }, {
    "tStartMs": 845940,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "After that, more time spent driving"
    } ]
  }, {
    "tStartMs": 848190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "doesn't improve performance."
    } ]
  }, {
    "tStartMs": 849990,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "If you wanted to keep improving,"
    } ]
  }, {
    "tStartMs": 851220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "you would have to try driving\nin challenging situations"
    } ]
  }, {
    "tStartMs": 853440,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "like new terrain, higher\nspeeds, or in difficult weather."
    } ]
  }, {
    "tStartMs": 857070,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "Now I have played guitar for 25 years,"
    } ]
  }, {
    "tStartMs": 858853,
    "dDurationMs": 3557,
    "segs": [ {
      "utf8": "but I'm not an expert because\nI usually play the same songs."
    } ]
  }, {
    "tStartMs": 862410,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It's easier and more fun."
    } ]
  }, {
    "tStartMs": 864240,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "But in order to learn,"
    } ]
  }, {
    "tStartMs": 865230,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "you have to be practicing\nat the edge of your ability,"
    } ]
  }, {
    "tStartMs": 867750,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "pushing beyond your comfort zone."
    } ]
  }, {
    "tStartMs": 869760,
    "dDurationMs": 1303,
    "segs": [ {
      "utf8": "You have to use a lot of concentration"
    } ]
  }, {
    "tStartMs": 871063,
    "dDurationMs": 2747,
    "segs": [ {
      "utf8": "and methodically repeatedly attempt things"
    } ]
  }, {
    "tStartMs": 873810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "you aren't good at."
    } ]
  }, {
    "tStartMs": 875220,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- You can practice\neverything exactly as it is"
    } ]
  }, {
    "tStartMs": 878940,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and exactly as it's written,"
    } ]
  }, {
    "tStartMs": 881190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "but at just such a speed that"
    } ]
  }, {
    "tStartMs": 883680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "you have to think about"
    } ]
  }, {
    "tStartMs": 885180,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and know exactly where you are"
    } ]
  }, {
    "tStartMs": 886860,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and what your fingers are doing"
    } ]
  }, {
    "tStartMs": 887693,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "and what it feels like."
    } ]
  }, {
    "tStartMs": 889260,
    "dDurationMs": 1825,
    "segs": [ {
      "utf8": "- This is known as deliberate practice."
    } ]
  }, {
    "tStartMs": 891085,
    "dDurationMs": 1175,
    "segs": [ {
      "utf8": "And in many areas"
    } ]
  }, {
    "tStartMs": 892260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "professionals don't engage\nin deliberate practice,"
    } ]
  }, {
    "tStartMs": 894600,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "so their performance doesn't improve."
    } ]
  }, {
    "tStartMs": 896310,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "In fact, sometimes it declines."
    } ]
  }, {
    "tStartMs": 898770,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "If you're experiencing chest pain"
    } ]
  }, {
    "tStartMs": 900090,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and you walk into a hospital,"
    } ]
  }, {
    "tStartMs": 901650,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "would you rather the\ndoctor is a recent graduate"
    } ]
  }, {
    "tStartMs": 904320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "or someone with 20 years experience?"
    } ]
  }, {
    "tStartMs": 906540,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Researchers have found"
    } ]
  }, {
    "tStartMs": 907470,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that diagnostic skills of medical students"
    } ]
  }, {
    "tStartMs": 909180,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "increase with their\ntime in medical school,"
    } ]
  }, {
    "tStartMs": 911010,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "which makes sense."
    } ]
  }, {
    "tStartMs": 912000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The more cases you've seen with feedback,"
    } ]
  }, {
    "tStartMs": 914070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the better you are at spotting patterns."
    } ]
  }, {
    "tStartMs": 915960,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But this only works up to a point."
    } ]
  }, {
    "tStartMs": 917730,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "When it comes to rare diseases\nof the heart or lungs,"
    } ]
  }, {
    "tStartMs": 920700,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "doctors with 20 years\nexperience were actually worse"
    } ]
  }, {
    "tStartMs": 923310,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "at diagnosing them than recent graduates."
    } ]
  }, {
    "tStartMs": 925290,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And that's because they\nhaven't thought about"
    } ]
  }, {
    "tStartMs": 926970,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "those rare diseases in a long time."
    } ]
  }, {
    "tStartMs": 928800,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So they're less able to\nrecognize the symptoms."
    } ]
  }, {
    "tStartMs": 931320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Only after a refresher course,"
    } ]
  }, {
    "tStartMs": 933060,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "could doctors accurately\ndiagnose these diseases."
    } ]
  }, {
    "tStartMs": 936360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And you can see the same effect in chess."
    } ]
  }, {
    "tStartMs": 938400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The best predictor of skill level,"
    } ]
  }, {
    "tStartMs": 940110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is not the number of games\nor tournaments played,"
    } ]
  }, {
    "tStartMs": 942690,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but the number of hours dedicated"
    } ]
  }, {
    "tStartMs": 944310,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "to serious solitary study."
    } ]
  }, {
    "tStartMs": 946251,
    "dDurationMs": 2529,
    "segs": [ {
      "utf8": "Players spend thousands of hours alone"
    } ]
  }, {
    "tStartMs": 948780,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "learning chess theory,"
    } ]
  }, {
    "tStartMs": 949920,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "studying their own games\nand those of others."
    } ]
  }, {
    "tStartMs": 952170,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And they play through compositions,"
    } ]
  }, {
    "tStartMs": 953790,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "which are puzzles designed"
    } ]
  }, {
    "tStartMs": 954840,
    "dDurationMs": 2117,
    "segs": [ {
      "utf8": "to help you recognize tactical patterns."
    } ]
  }, {
    "tStartMs": 956957,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "In chess, as in other areas,"
    } ]
  }, {
    "tStartMs": 958830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "it can be challenging to force yourself"
    } ]
  }, {
    "tStartMs": 960540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to practice deliberately."
    } ]
  }, {
    "tStartMs": 962130,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And this is why coaches and\nteachers are so valuable."
    } ]
  }, {
    "tStartMs": 965220,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They can recognize your weaknesses"
    } ]
  }, {
    "tStartMs": 966840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and assign tasks to address them."
    } ]
  }, {
    "tStartMs": 969450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "To become an expert,"
    } ]
  }, {
    "tStartMs": 970530,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you have to practice\nfor thousands of hours"
    } ]
  }, {
    "tStartMs": 972630,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "in the uncomfortable zone,"
    } ]
  }, {
    "tStartMs": 974040,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "attempting the things\nyou can't do quite yet."
    } ]
  }, {
    "tStartMs": 977280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "True expertise is amazing to watch."
    } ]
  }, {
    "tStartMs": 979890,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "To me, it looks like magic, but it isn't."
    } ]
  }, {
    "tStartMs": 982650,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "At its core, expertise is recognition."
    } ]
  }, {
    "tStartMs": 985230,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And recognition comes\nfrom the incredible amount"
    } ]
  }, {
    "tStartMs": 987540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of highly structured information"
    } ]
  }, {
    "tStartMs": 988950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "stored in long-term memory."
    } ]
  }, {
    "tStartMs": 990810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "To build that memory,\nrequires four things:"
    } ]
  }, {
    "tStartMs": 993420,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "a valid environment, many\nrepetitions, timely feedback,"
    } ]
  }, {
    "tStartMs": 997110,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and thousands of hours\nof deliberate practice."
    } ]
  }, {
    "tStartMs": 1000140,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "When those criteria are met,"
    } ]
  }, {
    "tStartMs": 1001700,
    "dDurationMs": 2119,
    "segs": [ {
      "utf8": "human performance is astonishing."
    } ]
  }, {
    "tStartMs": 1003819,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "And when it's not,"
    } ]
  }, {
    "tStartMs": 1005048,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you get people we think of as experts"
    } ]
  }, {
    "tStartMs": 1007298,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "who actually aren't."
    } ]
  }, {
    "tStartMs": 1009431,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(techno sound)"
    } ]
  }, {
    "tStartMs": 1013880,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If you want to become a STEM expert,"
    } ]
  }, {
    "tStartMs": 1016310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you have to actively\ninteract with problems."
    } ]
  }, {
    "tStartMs": 1018620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And that's what you can do with Brilliant,"
    } ]
  }, {
    "tStartMs": 1020420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "the sponsor of this video."
    } ]
  }, {
    "tStartMs": 1021830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Check out this course on computer science,"
    } ]
  }, {
    "tStartMs": 1023540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "where you can uncover the optimal strategy"
    } ]
  }, {
    "tStartMs": 1025400,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "for finding a key in a room."
    } ]
  }, {
    "tStartMs": 1027350,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And you quickly learn"
    } ]
  }, {
    "tStartMs": 1028183,
    "dDurationMs": 3307,
    "segs": [ {
      "utf8": "how your own strategy can be\nreplicated in a neural network."
    } ]
  }, {
    "tStartMs": 1031490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Logic is another great course"
    } ]
  }, {
    "tStartMs": 1033110,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that I find challenges me mentally."
    } ]
  }, {
    "tStartMs": 1034970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "You go from thinking\nyou understand something"
    } ]
  }, {
    "tStartMs": 1036620,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to actually getting it."
    } ]
  }, {
    "tStartMs": 1038090,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And if it feels difficult,\nthat's a good thing."
    } ]
  }, {
    "tStartMs": 1040280,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It means you're getting pushed\noutside your comfort zone."
    } ]
  }, {
    "tStartMs": 1043220,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "This is how Brilliant\nfacilitates deliberate practice."
    } ]
  }, {
    "tStartMs": 1046220,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "And if you ever get stuck,"
    } ]
  }, {
    "tStartMs": 1047390,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "a helpful hint is always close at hand."
    } ]
  }, {
    "tStartMs": 1049520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So don't fall into the trap\nof just getting comfortable"
    } ]
  }, {
    "tStartMs": 1052130,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "in doing what you know how to do."
    } ]
  }, {
    "tStartMs": 1053750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Build in the habit of being uncomfortable,"
    } ]
  }, {
    "tStartMs": 1056060,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and regularly learning something new."
    } ]
  }, {
    "tStartMs": 1058340,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "That is the way to lifelong\nlearning and growth."
    } ]
  }, {
    "tStartMs": 1060890,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So I invite you to check out the courses"
    } ]
  }, {
    "tStartMs": 1062600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "over at Brilliant.org/veritasium,"
    } ]
  }, {
    "tStartMs": 1065060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and I bet you will find something there"
    } ]
  }, {
    "tStartMs": 1066590,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "that you wanna learn."
    } ]
  }, {
    "tStartMs": 1067580,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Plus if you click through right now,"
    } ]
  }, {
    "tStartMs": 1068900,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Brilliant are offering 20% off"
    } ]
  }, {
    "tStartMs": 1070640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "an annual premium subscription"
    } ]
  }, {
    "tStartMs": 1072260,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to the first 200 people to sign up."
    } ]
  }, {
    "tStartMs": 1074090,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So I wanna thank Brilliant\nfor supporting Veritasium,"
    } ]
  }, {
    "tStartMs": 1076430,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
