  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "For most of us, thinking\nis at least somewhat unpleasant."
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "We try to avoid it, where possible."
    } ]
  }, {
    "tStartMs": 5500,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "For example:"
    } ]
  }, {
    "tStartMs": 6100,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "I asked these guys how long does it take for the earth to go around the Sun."
    } ]
  }, {
    "tStartMs": 9680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- What do you reckon, cuz?"
    } ]
  }, {
    "tStartMs": 12000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Isn't it 24 hours ?\n- Obviously a day, yes."
    } ]
  }, {
    "tStartMs": 14400,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Or take this problem"
    } ]
  }, {
    "tStartMs": 15440,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "which has been given to thousands of college students."
    } ]
  }, {
    "tStartMs": 18120,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "You go into a toy store,"
    } ]
  }, {
    "tStartMs": 20000,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and there's a toy bat and a toy ball."
    } ]
  }, {
    "tStartMs": 23400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Together they cost 1.10$."
    } ]
  }, {
    "tStartMs": 26200,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "And the bat costs a dollar more than the ball."
    } ]
  }, {
    "tStartMs": 29280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "How much does the ball cost ?"
    } ]
  }, {
    "tStartMs": 31000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- Ten cents."
    } ]
  }, {
    "tStartMs": 33000,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "- We're all wrong aren't we?"
    } ]
  }, {
    "tStartMs": 35300,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- WHAT'S THE ANSWER ?"
    } ]
  }, {
    "tStartMs": 37260,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "If you think about it for just a second"
    } ]
  }, {
    "tStartMs": 38700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it's obvious that the ball can't cost ten cents,"
    } ]
  }, {
    "tStartMs": 41400,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "because if it did, then the bat"
    } ]
  }, {
    "tStartMs": 42870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "would cost 1.10$ and the two items"
    } ]
  }, {
    "tStartMs": 44550,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "together would cost 1.20$."
    } ]
  }, {
    "tStartMs": 46500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The correct answer is five cents."
    } ]
  }, {
    "tStartMs": 49350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Now, the point of these questions is not that they're difficult."
    } ]
  }, {
    "tStartMs": 51600,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "Any of these people"
    } ]
  }, {
    "tStartMs": 52220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "could have quickly check their answer if they wanted to."
    } ]
  }, {
    "tStartMs": 54200,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "The point is that they don't check"
    } ]
  }, {
    "tStartMs": 57100,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "because thinking is uncomfortable."
    } ]
  }, {
    "tStartMs": 59620,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "It takes effort."
    } ]
  }, {
    "tStartMs": 65180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Hey, the Earth doesn't take one day to get around the Sun."
    } ]
  }, {
    "tStartMs": 69780,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "- Takes like a year!"
    } ]
  }, {
    "tStartMs": 72760,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "[LAUGHS]"
    } ]
  }, {
    "tStartMs": 73860,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Now, I think it would be easy to put these mistakes down to"
    } ]
  }, {
    "tStartMs": 76120,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "stupidity,"
    } ]
  }, {
    "tStartMs": 77200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and believe that you, being much smarter, could never fall into such traps."
    } ]
  }, {
    "tStartMs": 80440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But then I think you'd be fooling yourself."
    } ]
  }, {
    "tStartMs": 82980,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I think these examples reveal blind spots in all of our thinking"
    } ]
  }, {
    "tStartMs": 86260,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "due to the fundamental way that our brains work ."
    } ]
  }, {
    "tStartMs": 88940,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Now, one way of modeling how the brain"
    } ]
  }, {
    "tStartMs": 90400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "operates is as though there are two"
    } ]
  }, {
    "tStartMs": 92380,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "systems at work"
    } ]
  }, {
    "tStartMs": 93940,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "psychologists call them system one and"
    } ]
  }, {
    "tStartMs": 95500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "system two but maybe it's useful to"
    } ]
  }, {
    "tStartMs": 97600,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "think of them as characters so let's"
    } ]
  }, {
    "tStartMs": 99490,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "call system one Gun and system two Drew."
    } ]
  }, {
    "tStartMs": 102070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "You are Drew. he represents your"
    } ]
  }, {
    "tStartMs": 104830,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "conscious thought,  the voice in your head."
    } ]
  }, {
    "tStartMs": 107000,
    "dDurationMs": 2479,
    "segs": [ {
      "utf8": "\u003cDrew\u003e\"I am who you think you are\""
    } ]
  }, {
    "tStartMs": 109479,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "he's the one capable of following instructions."
    } ]
  }, {
    "tStartMs": 111700,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "He can execute a series of steps."
    } ]
  }, {
    "tStartMs": 113900,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "If you are asked to calculate 13 x 17 in your head, for example,"
    } ]
  }, {
    "tStartMs": 117260,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "he is the one who has to do it."
    } ]
  }, {
    "tStartMs": 118700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "\u003cDrew\u003e\"can just use my calculator?\""
    } ]
  }, {
    "tStartMs": 120520,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "no...\u003cDrew\u003e\"all right, um, seventeen times....\""
    } ]
  }, {
    "tStartMs": 123820,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Drew is lazy"
    } ]
  }, {
    "tStartMs": 124780,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "it takes effort to get Drew to do anything"
    } ]
  }, {
    "tStartMs": 126600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and he is slow but he's the careful one,"
    } ]
  }, {
    "tStartMs": 129100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "capable of catching and fixing mistakes..."
    } ]
  }, {
    "tStartMs": 133100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "\u003cDrew\u003e\"221\"."
    } ]
  }, {
    "tStartMs": 134600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Now meet system one Gun."
    } ]
  }, {
    "tStartMs": 136400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "He is incredibly quick,"
    } ]
  }, {
    "tStartMs": 138100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which he needs to be since he's constantly"
    } ]
  }, {
    "tStartMs": 139720,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "processing copious amounts of"
    } ]
  }, {
    "tStartMs": 141100,
