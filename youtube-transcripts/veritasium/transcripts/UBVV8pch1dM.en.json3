  }, {
    "tStartMs": 165250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "'A' in 'cat' are actually the same symbol"
    } ]
  }, {
    "tStartMs": 167500,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "but you had no trouble reading it"
