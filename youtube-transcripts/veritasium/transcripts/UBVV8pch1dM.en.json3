      "utf8": "novel things in mind"
    } ]
  }, {
    "tStartMs": 197950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "at a time.  This is perhaps one of the"
    } ]
  }, {
    "tStartMs": 199660,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "best-known findings from psychology.  That"
