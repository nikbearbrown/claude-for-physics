  }, {
    "tStartMs": 748920,
    "dDurationMs": 2864,
    "segs": [ {
      "utf8": "But brilliant gets around this\nbecause it is interactive."
    } ]
  }, {
    "tStartMs": 751890,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "You can manipulate simulations and visuals"
