  }, {
    "tStartMs": 741840,
    "dDurationMs": 3805,
    "segs": [ {
      "utf8": "Now I did my PhD studying how\nmuch people learn from videos,"
    } ]
  }, {
    "tStartMs": 745740,
    "dDurationMs": 3075,
    "segs": [ {
      "utf8": "and unfortunately it's\noften shockingly little."
