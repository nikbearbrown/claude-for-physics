  }, {
    "tStartMs": 754500,
    "dDurationMs": 3224,
    "segs": [ {
      "utf8": "and you have to answer\nquestions every step of the way."
    } ]
  }, {
    "tStartMs": 757830,
    "dDurationMs": 1362,
    "segs": [ {
      "utf8": "This is the best way to learn"
    } ]
  }, {
    "tStartMs": 759270,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "because it allows you to\ncheck your understanding."
