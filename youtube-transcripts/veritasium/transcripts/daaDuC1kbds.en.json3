    "dDurationMs": 3232,
    "segs": [ {
      "utf8": "there are always helpful\nhints and full explanations."
    } ]
  }, {
    "tStartMs": 765930,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "I like to incorporate\nbrilliant into my daily routine"
    } ]
  }, {
    "tStartMs": 768780,
    "dDurationMs": 2757,
    "segs": [ {
