{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1900,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "When you touch an object and it feels warm\nor cold, what is that really telling you about"
    } ]
  }, {
    "tStartMs": 5940,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "the object?"
    } ]
  }, {
    "tStartMs": 6940,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Here, I have a metal hard drive and a book\nand I'm going to ask people to compare their"
    } ]
  }, {
    "tStartMs": 11700,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "temperatures."
    } ]
  }, {
    "tStartMs": 13280,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "Which one do you think will feel warmer - the\nbook or the hard drive?"
    } ]
  }, {
    "tStartMs": 17570,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "The temperatures?"
    } ]
  }, {
    "tStartMs": 18570,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "Yeah, tell me if one is hotter or colder or\nif they're the same temperature."
    } ]
  }, {
    "tStartMs": 20939,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "How do they feel?"
    } ]
  }, {
    "tStartMs": 22580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This is slightly cooler than this one."
    } ]
  }, {
    "tStartMs": 24080,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "Oh, that's warmer."
    } ]
  }, {
    "tStartMs": 25349,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah, agreed."
    } ]
  }, {
    "tStartMs": 26349,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "I'd say the hard drive is a lot colder than\nthe book."
    } ]
  }, {
    "tStartMs": 30599,
    "dDurationMs": 4241,
    "segs": [ {
      "utf8": "'Cause the book's got more knowledge."
    } ]
  }, {
    "tStartMs": 34840,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Why do you think that is?"
    } ]
  }, {
    "tStartMs": 36160,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "Metal's normally a little bit chillier if\nyou leave it in a colder temperature."
    } ]
  }, {
    "tStartMs": 40210,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "What if I said they're both the same temperature?"
    } ]
  }, {
    "tStartMs": 42770,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What would you say?"
    } ]
  }, {
    "tStartMs": 43770,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I'd tell you you're lying."
    } ]
  }, {
    "tStartMs": 45170,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I'd think you were lying, yeah."
    } ]
  }, {
    "tStartMs": 47390,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "Well, maybe the way I can prove it is I have\nan infrared thermometer."
    } ]
  }, {
    "tStartMs": 51640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "What do you think we're going to see?"
    } ]
  }, {
    "tStartMs": 53480,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "I think science might be able to answer that."
    } ]
  }, {
    "tStartMs": 55890,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "And I'm not a scientist!"
    } ]
  }, {
    "tStartMs": 57190,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Make a prediction for me."
    } ]
  }, {
    "tStartMs": 58420,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "I still think that's colder."
    } ]
  }, {
    "tStartMs": 60030,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Would you bet me money?"
    } ]
  }, {
    "tStartMs": 61510,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I don't have any cash."
    } ]
  }, {
    "tStartMs": 64010,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "Let's measure the temperature of the book."
    } ]
  }, {
    "tStartMs": 65560,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "What do you see?"
    } ]
  }, {
    "tStartMs": 67470,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "19.0."
    } ]
  }, {
    "tStartMs": 68470,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "OK."
    } ]
  }, {
    "tStartMs": 69470,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Now measure the temperature of that."
    } ]
  }, {
    "tStartMs": 72390,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "19.0."
    } ]
  }, {
    "tStartMs": 73390,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Alright, well, now I believe you."
    } ]
  }, {
    "tStartMs": 76090,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I'm trying to figure it out, actually."
    } ]
  }, {
    "tStartMs": 78330,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Trying to figure out why'd they be the same\ntemperature."
    } ]
  }, {
    "tStartMs": 79890,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "They don't feel the same temperature, though."
    } ]
  }, {
    "tStartMs": 82270,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So, why does that feel colder if they're the\nsame?"
    } ]
  }, {
    "tStartMs": 84250,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Good one."
    } ]
  }, {
    "tStartMs": 85250,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "You know the answer?"
    } ]
  }, {
    "tStartMs": 87270,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I'm coming to you guys for answers."
    } ]
  }, {
    "tStartMs": 88470,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "We're creatives, not intellectuals."
    } ]
  }, {
    "tStartMs": 89470,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Well, create an answer for me!"
    } ]
  }, {
    "tStartMs": 92350,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "I'm not a scientist!"
    } ]
  }, {
    "tStartMs": 93610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Come on, you tell me."
    } ]
  }, {
    "tStartMs": 95440,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "I'll try to answer that question with another\nlittle experiment."
    } ]
  }, {
    "tStartMs": 98390,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Here is an aluminium block."
    } ]
  }, {
    "tStartMs": 99780,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Ooh!"
    } ]
  }, {
    "tStartMs": 100780,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Nice and cold."
    } ]
  }, {
    "tStartMs": 101780,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And a plastic block."
    } ]
  }, {
    "tStartMs": 103740,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "How do their temperatures compare?"
    } ]
  }, {
    "tStartMs": 106340,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Completely different."
    } ]
  }, {
    "tStartMs": 107360,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "Aluminium's going to be much colder."
    } ]
  }, {
    "tStartMs": 110590,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah?"
    } ]
  }, {
    "tStartMs": 111590,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "This actually feels colder."
    } ]
  }, {
    "tStartMs": 112590,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "Let's take this to the next level."
    } ]
  }, {
    "tStartMs": 113909,
    "dDurationMs": 2931,
    "segs": [ {
      "utf8": "I'll put an ice cube on both plates."
    } ]
  }, {
    "tStartMs": 116840,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "What will we see?"
    } ]
  }, {
    "tStartMs": 118630,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "I'm guessing it would stay solid on this one\nand melt on this one."
    } ]
  }, {
    "tStartMs": 123450,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "So it's going to melt on the plastic but stay\nsolid on the aluminium?"
    } ]
  }, {
    "tStartMs": 127310,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "Yes, but maybe I'm wrong."
    } ]
  }, {
    "tStartMs": 129269,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "That one will melt more quickly than on the\naluminium."
    } ]
  }, {
    "tStartMs": 131299,
    "dDurationMs": 1141,
    "segs": [ {
      "utf8": "You'd think so."
    } ]
  }, {
    "tStartMs": 132440,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "Yeah, 'cause it's cold."
    } ]
  }, {
    "tStartMs": 133959,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "I think they're the same."
    } ]
  }, {
    "tStartMs": 135719,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We put an ice cube on each of those."
    } ]
  }, {
    "tStartMs": 137969,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "What do you see?"
    } ]
  }, {
    "tStartMs": 139109,
    "dDurationMs": 1871,
    "segs": [ {
      "utf8": "It's melting quicker on the aluminium."
    } ]
  }, {
    "tStartMs": 140980,
    "dDurationMs": 1489,
    "segs": [ {
      "utf8": "My God, it's melting!"
    } ]
  }, {
    "tStartMs": 142469,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "This is melting quicker than that one, even\nthough this is aluminium and that's plastic."
    } ]
  }, {
    "tStartMs": 146889,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "So which one felt colder?"
    } ]
  }, {
    "tStartMs": 147999,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "This one."
    } ]
  }, {
    "tStartMs": 148999,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "How does that make sense?"
    } ]
  }, {
    "tStartMs": 151319,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "No idea."
    } ]
  }, {
    "tStartMs": 152319,
    "dDurationMs": 2431,
    "segs": [ {
      "utf8": "Could aluminium be bad for the environment?"
    } ]
  }, {
    "tStartMs": 154750,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "How would aluminium be bad for the environment?"
    } ]
  }, {
    "tStartMs": 156639,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "It's thawing the ice quicker, isn't it?"
    } ]
  }, {
    "tStartMs": 158680,
    "dDurationMs": 1789,
    "segs": [ {
      "utf8": "You want the answer?"
    } ]
  }, {
    "tStartMs": 160469,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Yes, please!"
    } ]
  }, {
    "tStartMs": 162069,
    "dDurationMs": 3841,
    "segs": [ {
      "utf8": "It's about thermoconductivity - the rate at\nwhich heat is transferred from one object"
    } ]
  }, {
    "tStartMs": 165910,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "to another."
    } ]
  }, {
    "tStartMs": 166980,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "So when you felt these blocks originally,\nI know this one felt a lot colder."
    } ]
  }, {
    "tStartMs": 170019,
    "dDurationMs": 3791,
    "segs": [ {
      "utf8": "But you know from the other example we did,\nthat they must both be the same temperature."
    } ]
  }, {
    "tStartMs": 173810,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "True."
    } ]
  }, {
    "tStartMs": 174810,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "They've both been outside for a while."
    } ]
  }, {
    "tStartMs": 176560,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "We see the aluminium block is melting the\nice faster than the plastic block because"
    } ]
  }, {
    "tStartMs": 181260,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "it's conducting the heat to the ice cube faster."
    } ]
  }, {
    "tStartMs": 184870,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "With the plastic block, it's a worse thermoconductor."
    } ]
  }, {
    "tStartMs": 187920,
    "dDurationMs": 4849,
    "segs": [ {
      "utf8": "So, heat is being transferred less quickly\nto this ice block and so it's staying iced."
    } ]
  }, {
    "tStartMs": 192769,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "OK."
    } ]
  }, {
    "tStartMs": 193769,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I believe you."
    } ]
  }, {
    "tStartMs": 194769,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Make sense?"
    } ]
  }, {
    "tStartMs": 195769,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 196769,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Definitely."
    } ]
  }, {
    "tStartMs": 197769,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "In our first example, the hard drive felt\ncolder, even though it was at the same temperature"
    } ]
  }, {
    "tStartMs": 201599,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "as the book."
    } ]
  }, {
    "tStartMs": 202889,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "That's because the aluminium conducts heat\naway from your hand faster than the book conducts"
    } ]
  }, {
    "tStartMs": 207239,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "heat away from your hand."
    } ]
  }, {
    "tStartMs": 208239,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Sure."
    } ]
  }, {
    "tStartMs": 209239,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That seems logical."
    } ]
  }, {
    "tStartMs": 210239,
    "dDurationMs": 3191,
    "segs": [ {
      "utf8": "Which makes the hard drive feel colder and\nthe book feel warmer."
    } ]
  }, {
    "tStartMs": 213430,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So when you touch something, you don't actually\nfeel temperature."
    } ]
  }, {
    "tStartMs": 217530,
    "dDurationMs": 4919,
    "segs": [ {
      "utf8": "You feel the rate at which heat is conducted,\neither towards or away from you."
    } ]
  }, {
    "tStartMs": 222449,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Think about this next time you hop out of\nthe shower in winter."
    } ]
  }, {
    "tStartMs": 225129,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "It's much nicer to stand on the bath mat than\non a towel beside it."
    } ]
  }, {
    "tStartMs": 228269,
    "dDurationMs": 4631,
    "segs": [ {
      "utf8": "Not because the bath mat is warmer but because\nit conducts heat less quickly away from you."
    } ]
  } ]
}
