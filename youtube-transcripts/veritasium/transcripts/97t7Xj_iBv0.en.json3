  }, {
    "tStartMs": 438900,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So another advantage of compliant"
    } ]
  }, {
    "tStartMs": 440530,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "mechanisms is that they can be made with\nsignificantly smaller proportions"
    } ]
  }, {
    "tStartMs": 444250,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "because they take advantage of\nproduction processes like photo-lithography"
    } ]
  }, {
    "tStartMs": 448180,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "And we have motion that we\nwant at the microscopic level -that's brilliant."
    } ]
  }, {
    "tStartMs": 452880,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Plus since they simplify design\ncompliant mechanisms are much more"
    } ]
  }, {
    "tStartMs": 457000,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "portable meaning lightweight which makes\nthem perfect for space applications."
    } ]
  }, {
    "tStartMs": 461700,
