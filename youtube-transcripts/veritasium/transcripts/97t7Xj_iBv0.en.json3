  }, {
    "tStartMs": 289860,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "it's a trick question!"
    } ]
  }, {
    "tStartMs": 291100,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "now since I was fooled by it I\nhad to try it out on my friend the"
    } ]
  }, {
    "tStartMs": 294020,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "physics girl. That's so trippy. That is so cool! I don't understand - what?!"
    } ]
  }, {
    "tStartMs": 301260,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "it's modeled after the mechanisms you use in"
    } ]
  }, {
    "tStartMs": 303740,
    "dDurationMs": 5850,
    "segs": [ {
      "utf8": "wind tunnels where you want to have say\na model that's that's attached here but"
    } ]
  }, {
    "tStartMs": 309590,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "you move it and all you want to do is is\ncontrol its its angle and move it around"
