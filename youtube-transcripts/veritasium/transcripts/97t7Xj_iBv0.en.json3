  }, {
    "tStartMs": 351200,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "give in the hinge."
    } ]
  }, {
    "tStartMs": 352920,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "This also causes wear\nand requires lubricant and that is why"
    } ]
  }, {
    "tStartMs": 357710,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "compliant mechanisms have better\nperformance than their traditional counterparts."
    } ]
  }, {
    "tStartMs": 362920,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "This one though is my favorite. \nThat is is one of my favorites too."
    } ]
  }, {
    "tStartMs": 367240,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It's just so pleasing, right?"
    } ]
  }, {
    "tStartMs": 371180,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "Ahhh, that sound is so satisfying."
    } ]
  }, {
    "tStartMs": 373784,
    "dDurationMs": 4506,
    "segs": [ {
      "utf8": "This actually, believe it or not was inspired when we\nwere doing things at the microscopic"
    } ]
  }, {
    "tStartMs": 378290,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "level, where we're building compliant\nmechanisms"
    } ]
  }, {
    "tStartMs": 380590,
    "dDurationMs": 7170,
    "segs": [ {
      "utf8": "on chips. We had to be able to make these\ncompliant mechanisms out of silicon,"
    } ]
  }, {
    "tStartMs": 387760,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "which is as brittle as glass. \n-mm hmm"
