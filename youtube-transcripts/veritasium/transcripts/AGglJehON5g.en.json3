{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- This is what the inside"
    } ]
  }, {
    "tStartMs": 1620,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of a lithium-ion battery looks like."
    } ]
  }, {
    "tStartMs": 3810,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "It's not exactly high tech,\njust two meters of foil"
    } ]
  }, {
    "tStartMs": 7560,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "coated in black paste,"
    } ]
  }, {
    "tStartMs": 8820,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "all packed into this\ntiny 45 gram cylinder."
    } ]
  }, {
    "tStartMs": 12150,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But these are some of the\nbest batteries we have."
    } ]
  }, {
    "tStartMs": 15150,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "They power everything from laptops"
    } ]
  }, {
    "tStartMs": 16920,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and electric vehicles\nto orbiting satellites."
    } ]
  }, {
    "tStartMs": 20610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Yet when a battery fails,"
    } ]
  }, {
    "tStartMs": 21870,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "all that energy can get\nreleased in the wrong way."
    } ]
  }, {
    "tStartMs": 26220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh my God."
    } ]
  }, {
    "tStartMs": 27053,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "- [Reporter] The latest incident"
    } ]
  }, {
    "tStartMs": 28110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "involving a lithium-ion battery."
    } ]
  }, {
    "tStartMs": 30450,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- So how did something\nso rudimentary looking"
    } ]
  }, {
    "tStartMs": 33090,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "end up in almost every\nelectronic device on the planet?"
    } ]
  }, {
    "tStartMs": 37050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And why don't we have anything better?"
    } ]
  }, {
    "tStartMs": 39990,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In the early 1980s, most\nrechargeable batteries"
    } ]
  }, {
    "tStartMs": 42630,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "were stuck at just 40 to\n60 watt hours per kilogram,"
    } ]
  }, {
    "tStartMs": 46110,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "meaning you would need\na kilogram of battery"
    } ]
  }, {
    "tStartMs": 48600,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to power a 40 watt light\nbulb for just an hour."
    } ]
  }, {
    "tStartMs": 52080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "As a result, when the first commercial"
    } ]
  }, {
    "tStartMs": 53820,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "mobile phone launched in 1983,\nit was pretty unimpressive."
    } ]
  }, {
    "tStartMs": 58020,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It took 10 hours to charge"
    } ]
  }, {
    "tStartMs": 59730,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "for just 30 minutes of talk time."
    } ]
  }, {
    "tStartMs": 62190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Laptops, cameras, even medical devices"
    } ]
  }, {
    "tStartMs": 64590,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "all suffered from the\nsame bulky batteries."
    } ]
  }, {
    "tStartMs": 67380,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Everyone from electronics giants"
    } ]
  }, {
    "tStartMs": 69090,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to oil companies were trying\nto make a better battery,"
    } ]
  }, {
    "tStartMs": 71820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "because they knew that even just doubling"
    } ]
  }, {
    "tStartMs": 73890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "the energy density could unlock"
    } ]
  }, {
    "tStartMs": 75540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "a new era of portable electronics"
    } ]
  }, {
    "tStartMs": 77400,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "and power the digital revolution."
    } ]
  }, {
    "tStartMs": 79950,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "But what no one realized"
    } ]
  }, {
    "tStartMs": 81390,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "is that someone had\nalready found the solution."
    } ]
  }, {
    "tStartMs": 85980,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "In 1972, a 32-year-old British chemist"
    } ]
  }, {
    "tStartMs": 88530,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "named Stanley Whittingham"
    } ]
  }, {
    "tStartMs": 89940,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "was studying how different\nmaterials store energy"
    } ]
  }, {
    "tStartMs": 92610,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "at Exxon's research lab in New Jersey."
    } ]
  }, {
    "tStartMs": 95280,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Yes, that Exxon, the\nmultinational oil giant,"
    } ]
  }, {
    "tStartMs": 98850,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "then the largest oil company in the world."
    } ]
  }, {
    "tStartMs": 101580,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "They were researching batteries."
    } ]
  }, {
    "tStartMs": 105270,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The next year, war broke out"
    } ]
  }, {
    "tStartMs": 106890,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "between Egypt, Syria, and Israel."
    } ]
  }, {
    "tStartMs": 109170,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "When the US backed Israel,"
    } ]
  }, {
    "tStartMs": 110850,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Arab oil producers cut off\noil exports in retaliation."
    } ]
  }, {
    "tStartMs": 114600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And on December 22nd,\nthe price of crude oil"
    } ]
  }, {
    "tStartMs": 117240,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "more than doubled from\n$5.12 a barrel to 11.65."
    } ]
  }, {
    "tStartMs": 122040,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "In response, President\nNixon created policies"
    } ]
  }, {
    "tStartMs": 124530,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "to try to keep oil prices\ndown, but they backfired"
    } ]
  }, {
    "tStartMs": 128130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and the shortage only got worse."
    } ]
  }, {
    "tStartMs": 130350,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Americans were left queuing\nfor hours at gas stations"
    } ]
  }, {
    "tStartMs": 133440,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "as the government introduced\na rationing program."
    } ]
  }, {
    "tStartMs": 136050,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It got so bad that they even dropped"
    } ]
  }, {
    "tStartMs": 137970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the national speed limit\nto 55 miles per hour"
    } ]
  }, {
    "tStartMs": 140610,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "just to cut consumption."
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "At Exxon, executives were worried"
    } ]
  }, {
    "tStartMs": 145980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that supplies would run out entirely,"
    } ]
  }, {
    "tStartMs": 148170,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "so they started looking\nseriously at alternatives,"
    } ]
  }, {
    "tStartMs": 150960,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "like electricity."
    } ]
  }, {
    "tStartMs": 153060,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "This wasn't a new idea."
    } ]
  }, {
    "tStartMs": 154680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "In fact, in 1900 when cars\nwere first taking off,"
    } ]
  }, {
    "tStartMs": 157560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the top selling car was electric,"
    } ]
  }, {
    "tStartMs": 159930,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "ahead of steam and gas powered cars."
    } ]
  }, {
    "tStartMs": 162840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But the problem with these electric cars"
    } ]
  }, {
    "tStartMs": 164340,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "was their batteries."
    } ]
  }, {
    "tStartMs": 165450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "They weighed 360 kilograms,"
    } ]
  }, {
    "tStartMs": 167580,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "around 40% of the car's weight,"
    } ]
  }, {
    "tStartMs": 170100,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but they could only take\nyou around 60 kilometers."
    } ]
  }, {
    "tStartMs": 173130,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And the energy density wasn't just low,"
    } ]
  }, {
    "tStartMs": 175020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it also degraded over time."
    } ]
  }, {
    "tStartMs": 177090,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Every time you recharged, it got worse."
    } ]
  }, {
    "tStartMs": 179580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "After fewer than 500 charges,"
    } ]
  }, {
    "tStartMs": 181680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "your range would've dropped\nto about 40 kilometers."
    } ]
  }, {
    "tStartMs": 185040,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So by 1924, gas powered cars"
    } ]
  }, {
    "tStartMs": 187560,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "outnumbered electric 10,000 to one."
    } ]
  }, {
    "tStartMs": 191040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "But now that the oil\nsupplies were running out,"
    } ]
  }, {
    "tStartMs": 193050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it seemed to Exxon that\nthere was no other solution"
    } ]
  }, {
    "tStartMs": 195660,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "than to bring back the electric car,"
    } ]
  }, {
    "tStartMs": 197910,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and to do that, they needed a battery"
    } ]
  }, {
    "tStartMs": 199620,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "with a much higher energy density."
    } ]
  }, {
    "tStartMs": 201750,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So suddenly, Whittingham's side project"
    } ]
  }, {
    "tStartMs": 203940,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "became a top priority."
    } ]
  }, {
    "tStartMs": 205890,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Exxon poured in resources,\ngiving him free rein to,"
    } ]
  }, {
    "tStartMs": 208920,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "in his words, \"Do pretty\nmuch what I wanted,"
    } ]
  }, {
    "tStartMs": 211350,
    "dDurationMs": 2427,
    "segs": [ {
      "utf8": "as long as it did not involve petroleum.\""
    } ]
  }, {
    "tStartMs": 215070,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "The very first battery dates back"
    } ]
  }, {
    "tStartMs": 216480,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to a curious incident in the 1780s"
    } ]
  }, {
    "tStartMs": 219390,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "when Italian scientist Luigi Galvani"
    } ]
  }, {
    "tStartMs": 221670,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "was dissecting a frog\nto study its anatomy."
    } ]
  }, {
    "tStartMs": 225060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "He anchored one side of\nthe frog on a brass hook"
    } ]
  }, {
    "tStartMs": 227640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and went to cut it open\nwith a steel scalpel."
    } ]
  }, {
    "tStartMs": 230700,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But when he touched the\nscalpel to the frog's leg,"
    } ]
  }, {
    "tStartMs": 232830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "he noticed it suddenly twitched,"
    } ]
  }, {
    "tStartMs": 234900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "as if it had come back to life."
    } ]
  }, {
    "tStartMs": 237060,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Galvani believed he'd discovered"
    } ]
  }, {
    "tStartMs": 238620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "a sort of animal electricity,"
    } ]
  }, {
    "tStartMs": 240660,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "a living force produced\nby the tissue itself."
    } ]
  }, {
    "tStartMs": 243660,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "But Galvani's rival\nAlessandro Volta disagreed."
    } ]
  }, {
    "tStartMs": 247170,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "He thought it came from\nthe metals themselves."
    } ]
  }, {
    "tStartMs": 250230,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And you can see this with\nlots of different materials."
    } ]
  }, {
    "tStartMs": 253080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Veritasium producer\nGregor set up a version"
    } ]
  }, {
    "tStartMs": 255450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "of this experiment, minus\nthe frog, to test it out."
    } ]
  }, {
    "tStartMs": 258930,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- [Gregor] I have zinc,\nmagnesium, and iron here."
    } ]
  }, {
    "tStartMs": 261990,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I can take any of these metals,"
    } ]
  }, {
    "tStartMs": 263610,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "stick them into one side of a lemon"
    } ]
  }, {
    "tStartMs": 267000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and stick some copper on the other side."
    } ]
  }, {
    "tStartMs": 269190,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "If I hook these up to a volt meter,"
    } ]
  }, {
    "tStartMs": 270960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I should be getting a voltage."
    } ]
  }, {
    "tStartMs": 273300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And we got around 0.8 volts."
    } ]
  }, {
    "tStartMs": 275880,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Now, the reason this happens"
    } ]
  }, {
    "tStartMs": 277020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is because some elements want to get rid"
    } ]
  }, {
    "tStartMs": 278760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "of their electrons more than others."
    } ]
  }, {
    "tStartMs": 280800,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So if you pair one that really\ndoesn't want its electrons"
    } ]
  }, {
    "tStartMs": 284250,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "with one that really wants some,"
    } ]
  }, {
    "tStartMs": 286050,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "well, then the electrons are\ngonna be traveling across."
    } ]
  }, {
    "tStartMs": 289590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Narrator] Let's look at the zinc."
    } ]
  }, {
    "tStartMs": 290970,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "What's happening here is that\nzinc is losing its electrons."
    } ]
  }, {
    "tStartMs": 294270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The zinc ions enter the juice,"
    } ]
  }, {
    "tStartMs": 296100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and the electrons are forced\nto go through the circuit"
    } ]
  }, {
    "tStartMs": 298290,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to get to the other side."
    } ]
  }, {
    "tStartMs": 300300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "There, hydrogen ions in the lemon juice"
    } ]
  }, {
    "tStartMs": 302400,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "want those electrons,"
    } ]
  }, {
    "tStartMs": 303480,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "so they receive them and\nturn into hydrogen gas."
    } ]
  }, {
    "tStartMs": 307320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "You've got one side\nthat gives up electrons,"
    } ]
  }, {
    "tStartMs": 309360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that's the anode, and you've got one"
    } ]
  }, {
    "tStartMs": 311040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that receives them, that's the cathode."
    } ]
  }, {
    "tStartMs": 313650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- But why do you need the lemon at all?"
    } ]
  }, {
    "tStartMs": 315870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If there's no flow of the positive ions"
    } ]
  }, {
    "tStartMs": 317460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "through to the other side,"
    } ]
  }, {
    "tStartMs": 319080,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the electrons stop moving\nalmost immediately."
    } ]
  }, {
    "tStartMs": 322680,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "This happens because all of the electrons"
    } ]
  }, {
    "tStartMs": 324810,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "now get bunched up in the copper,"
    } ]
  }, {
    "tStartMs": 326250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "making it extremely negatively charged,"
    } ]
  }, {
    "tStartMs": 328500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and that is just gonna push\naway any more electrons"
    } ]
  }, {
    "tStartMs": 331140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "from coming over to the other side."
    } ]
  }, {
    "tStartMs": 333120,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Derek] That's because electrons"
    } ]
  }, {
    "tStartMs": 334080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "can't travel through lemon juice."
    } ]
  }, {
    "tStartMs": 335820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Liquids like this don't have"
    } ]
  }, {
    "tStartMs": 337170,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "free electrons the way metals do,"
    } ]
  }, {
    "tStartMs": 338700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "so electrons stay in the wire."
    } ]
  }, {
    "tStartMs": 341250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They'll only leave the\ncircuit at the copper side"
    } ]
  }, {
    "tStartMs": 343500,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "if there's something in the juice,"
    } ]
  }, {
    "tStartMs": 344670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "like hydrogen ions ready to take them,"
    } ]
  }, {
    "tStartMs": 347070,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and if the reaction releases enough energy"
    } ]
  }, {
    "tStartMs": 348990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to make that transfer happen."
    } ]
  }, {
    "tStartMs": 351030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But positive ions in the juice can move."
    } ]
  }, {
    "tStartMs": 353520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "They travel across to balance the charge,"
    } ]
  }, {
    "tStartMs": 355890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "allowing the current to keep flowing."
    } ]
  }, {
    "tStartMs": 357870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "A solution that carries charge this way"
    } ]
  }, {
    "tStartMs": 359790,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "by moving ions is called an electrolyte."
    } ]
  }, {
    "tStartMs": 363690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- But we could also do\nthis with the other metals"
    } ]
  }, {
    "tStartMs": 365970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to get a similar reaction,"
    } ]
  }, {
    "tStartMs": 367740,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and we can actually quantify how much"
    } ]
  }, {
    "tStartMs": 369750,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "each of these metals wants\nor doesn't want electrons."
    } ]
  }, {
    "tStartMs": 373260,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "With zinc, we already\ngot around 0.9 volts,"
    } ]
  }, {
    "tStartMs": 376440,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but if you try it with iron, for example,"
    } ]
  }, {
    "tStartMs": 378510,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "you get something lower, 0.5 or 0.6 volts."
    } ]
  }, {
    "tStartMs": 382170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Now, magnesium is tricky and\nit would be a bit higher,"
    } ]
  }, {
    "tStartMs": 384540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but it oxidizes so quickly\nthat even if I scrape"
    } ]
  }, {
    "tStartMs": 387210,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "some of the oxide from the surface,"
    } ]
  }, {
    "tStartMs": 389040,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I'm still getting only around 0.7 volts."
    } ]
  }, {
    "tStartMs": 394290,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The idea is that the larger\nthe voltage on the volt meter,"
    } ]
  }, {
    "tStartMs": 397440,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the more energy each electron has to give"
    } ]
  }, {
    "tStartMs": 399960,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "as it passes through the circuit."
    } ]
  }, {
    "tStartMs": 402150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But there's also a limit to this."
    } ]
  }, {
    "tStartMs": 404520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "See, this beaker is full of lemon juice"
    } ]
  }, {
    "tStartMs": 406740,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "from the lemons we used earlier,"
    } ]
  }, {
    "tStartMs": 408450,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and they're hooked up using spoons"
    } ]
  }, {
    "tStartMs": 409890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and these wires to a\nvariable power source."
    } ]
  }, {
    "tStartMs": 412590,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Now look what happens\nwhen I up the voltage."
    } ]
  }, {
    "tStartMs": 416640,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "You'll actually start to see\nbubbles forming on both spoons,"
    } ]
  }, {
    "tStartMs": 420450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and that's water in the lemon juice"
    } ]
  }, {
    "tStartMs": 422370,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "actually being broken down\ninto oxygen and hydrogen gas."
    } ]
  }, {
    "tStartMs": 426900,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This already starts\nhappening at 1.23 volts,"
    } ]
  }, {
    "tStartMs": 429930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and that sets a limit on how much voltage"
    } ]
  }, {
    "tStartMs": 432690,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "you can push through this electrolyte."
    } ]
  }, {
    "tStartMs": 435930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Up until the early 1970s,"
    } ]
  }, {
    "tStartMs": 437610,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "just about every commercial battery"
    } ]
  }, {
    "tStartMs": 439200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "used a water-based\nelectrolyte, and as a result,"
    } ]
  }, {
    "tStartMs": 442080,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "none of these battery cells could push"
    } ]
  }, {
    "tStartMs": 443850,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "much beyond the 1.23 volt limit."
    } ]
  }, {
    "tStartMs": 447210,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Now, the total energy a battery can store"
    } ]
  }, {
    "tStartMs": 449520,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "depends on how much energy\neach charge has to give"
    } ]
  }, {
    "tStartMs": 452820,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "times how much charge can move,"
    } ]
  }, {
    "tStartMs": 454950,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that is the battery's\nvoltage times its capacity."
    } ]
  }, {
    "tStartMs": 458280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So if you can't increase the voltage,"
    } ]
  }, {
    "tStartMs": 460080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "your only option is to make more battery,"
    } ]
  }, {
    "tStartMs": 462450,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "more cells or bigger cells,"
    } ]
  }, {
    "tStartMs": 464910,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "but that won't increase\nthe energy density."
    } ]
  }, {
    "tStartMs": 468930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And this is exactly the problem"
    } ]
  }, {
    "tStartMs": 470700,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Whittingham was trying to solve."
    } ]
  }, {
    "tStartMs": 472320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "He was searching for materials"
    } ]
  }, {
    "tStartMs": 473520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that could store large amounts of energy"
    } ]
  }, {
    "tStartMs": 475500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "in a compact space with light weight."
    } ]
  }, {
    "tStartMs": 478350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "That led him to a class of compounds"
    } ]
  }, {
    "tStartMs": 479940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "called transition metal dichalcogenides."
    } ]
  }, {
    "tStartMs": 482670,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "He zeroed in on one in\nparticular, titanium disulfide."
    } ]
  }, {
    "tStartMs": 486750,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Titanium in this compound"
    } ]
  }, {
    "tStartMs": 488130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "has effectively lost four electrons,"
    } ]
  }, {
    "tStartMs": 490380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "two to each sulfur atom,"
    } ]
  }, {
    "tStartMs": 492120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "meaning it sits at a plus\nfour oxidation state."
    } ]
  }, {
    "tStartMs": 495480,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "That leaves it very electron hungry,"
    } ]
  }, {
    "tStartMs": 497820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "exactly what you want\nin a battery cathode."
    } ]
  }, {
    "tStartMs": 500460,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But titanium disulfide has\na second key advantage,"
    } ]
  }, {
    "tStartMs": 504000,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "this material is made of stacked layers"
    } ]
  }, {
    "tStartMs": 505950,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "held together by weak\nVan der Waals forces."
    } ]
  }, {
    "tStartMs": 508620,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This creates natural gaps\nbetween sheets of titanium"
    } ]
  }, {
    "tStartMs": 511170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and sulfur atoms just wide enough"
    } ]
  }, {
    "tStartMs": 512730,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to let certain ions\nslip between the layers,"
    } ]
  }, {
    "tStartMs": 515730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "a process known as intercalation."
    } ]
  }, {
    "tStartMs": 518400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Better still, the structure can expand"
    } ]
  }, {
    "tStartMs": 520320,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and contract repeatedly\nwithout breaking down."
    } ]
  }, {
    "tStartMs": 523650,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "Now Whittingham just had to\ndecide which ions to use."
    } ]
  }, {
    "tStartMs": 528690,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "He initially looked at potassium,"
    } ]
  }, {
    "tStartMs": 530700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "but it was just too reactive"
    } ]
  }, {
    "tStartMs": 532080,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and far too dangerous to work with."
    } ]
  }, {
    "tStartMs": 534420,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Oh, yeah! (laughs)"
    } ]
  }, {
    "tStartMs": 537630,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- He turned to this,"
    } ]
  }, {
    "tStartMs": 538740,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "a soft, silvery metal called lithium."
    } ]
  }, {
    "tStartMs": 543060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "What makes lithium unique is not the fact"
    } ]
  }, {
    "tStartMs": 545670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that it has one electron\nin its outer shell"
    } ]
  }, {
    "tStartMs": 548070,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that it wants to get rid of."
    } ]
  }, {
    "tStartMs": 549510,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "No, that it shares with the\nother elements in its group."
    } ]
  }, {
    "tStartMs": 552570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "What sets it apart is how much energy"
    } ]
  }, {
    "tStartMs": 554970,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you can get out of lithium\nwhen it reacts in a battery."
    } ]
  }, {
    "tStartMs": 558330,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "See, when it loses that outer electron,"
    } ]
  }, {
    "tStartMs": 560850,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "it forms a tiny, incredibly\nstable positive ion,"
    } ]
  }, {
    "tStartMs": 564300,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and so that reaction paired\nwith the right cathode"
    } ]
  }, {
    "tStartMs": 567810,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "releases more energy per\nelectron than any other metal."
    } ]
  }, {
    "tStartMs": 571710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "That's why it produces the highest voltage"
    } ]
  }, {
    "tStartMs": 573780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of any metal used in batteries."
    } ]
  }, {
    "tStartMs": 576360,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And because it's so small\nwith just three protons,"
    } ]
  }, {
    "tStartMs": 579420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "lithium is also the least dense metal,"
    } ]
  }, {
    "tStartMs": 581460,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "at just 0.53 grams per cubic centimeter."
    } ]
  }, {
    "tStartMs": 584610,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This combination of low\ndensity and the tendency"
    } ]
  }, {
    "tStartMs": 587370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to give away its electron\nmade lithium perfect"
    } ]
  }, {
    "tStartMs": 590190,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "for Whittingham's vision"
    } ]
  }, {
    "tStartMs": 591300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "of this high energy density battery."
    } ]
  }, {
    "tStartMs": 593550,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But while lithium was easier\nto work with than potassium,"
    } ]
  }, {
    "tStartMs": 597510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "easier still didn't mean easy."
    } ]
  }, {
    "tStartMs": 599670,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I mean, they only let me\nhold it in this glove box,"
    } ]
  }, {
    "tStartMs": 602250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and matter of fact, here's what happens"
    } ]
  }, {
    "tStartMs": 604170,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "to lithium if you put\nit in a glass of water."
    } ]
  }, {
    "tStartMs": 608011,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "(water bubbles)\n(tense music)"
    } ]
  }, {
    "tStartMs": 611310,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Safe to say, you don't want"
    } ]
  }, {
    "tStartMs": 612210,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "this happening inside your battery."
    } ]
  }, {
    "tStartMs": 614940,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- So, Whittingham had to switch out"
    } ]
  }, {
    "tStartMs": 616710,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the water-based electrolyte\nfor something else,"
    } ]
  }, {
    "tStartMs": 619620,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "and that change unlocked the\npossibility of higher voltages."
    } ]
  }, {
    "tStartMs": 624000,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "He turned to a solution of lithium salt"
    } ]
  }, {
    "tStartMs": 627090,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "in an organic solvent, and it worked,"
    } ]
  }, {
    "tStartMs": 630060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "but it came with serious risks."
    } ]
  }, {
    "tStartMs": 633300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The solvent was volatile,"
    } ]
  }, {
    "tStartMs": 634890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the lithium salt was chemically unstable."
    } ]
  }, {
    "tStartMs": 637440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Together, they formed a\nmixture that could explode"
    } ]
  }, {
    "tStartMs": 639600,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "or release toxic fumes if mishandled."
    } ]
  }, {
    "tStartMs": 642120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Everything had to be done\nwith extreme caution."
    } ]
  }, {
    "tStartMs": 644400,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "A stray spark or a trace of moisture"
    } ]
  }, {
    "tStartMs": 646530,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "could destroy the\nexperiment or start a fire."
    } ]
  }, {
    "tStartMs": 649890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But if you could get around the danger,"
    } ]
  }, {
    "tStartMs": 651780,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "this new electrolyte was a huge perk."
    } ]
  }, {
    "tStartMs": 654540,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It let lithium-ions shuttle"
    } ]
  }, {
    "tStartMs": 656370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "between electrodes without\nbreaking down the solvent"
    } ]
  }, {
    "tStartMs": 659040,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "or the cell, at least not\nuntil much higher voltages."
    } ]
  }, {
    "tStartMs": 662520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Whittingham had unlocked\nlithium's potential,"
    } ]
  }, {
    "tStartMs": 664830,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and in the process, he'd broken through"
    } ]
  }, {
    "tStartMs": 667020,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the 1.23 volt ceiling."
    } ]
  }, {
    "tStartMs": 669030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "His new chemistry delivered nearly double,"
    } ]
  }, {
    "tStartMs": 670980,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "a huge 2.4 volts per cell."
    } ]
  }, {
    "tStartMs": 674310,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "He now had a working prototype,"
    } ]
  }, {
    "tStartMs": 676050,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "a metallic lithium anode on one side,"
    } ]
  }, {
    "tStartMs": 678360,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "a titanium disulfide cathode on the other,"
    } ]
  }, {
    "tStartMs": 681150,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "his new liquid electrolyte in between."
    } ]
  }, {
    "tStartMs": 683790,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "There was also a thin porous separator"
    } ]
  }, {
    "tStartMs": 685620,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that kept the electrodes apart,"
    } ]
  }, {
    "tStartMs": 686970,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so they couldn't touch and short circuit."
    } ]
  }, {
    "tStartMs": 689220,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Here's how it works."
    } ]
  }, {
    "tStartMs": 690810,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "When you close the circuit,"
    } ]
  }, {
    "tStartMs": 692070,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "lithium atoms at the anode\ngive up their electrons."
    } ]
  }, {
    "tStartMs": 695040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Those electrons travel\nthrough the external circuit"
    } ]
  }, {
    "tStartMs": 697050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "toward the cathode, generating a current"
    } ]
  }, {
    "tStartMs": 699090,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that powers whatever's connected."
    } ]
  }, {
    "tStartMs": 700980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "At the same time, the lithium-ions"
    } ]
  }, {
    "tStartMs": 703170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "are released into the electrolyte,"
    } ]
  }, {
    "tStartMs": 705120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and then they pass through\nthe porous separator"
    } ]
  }, {
    "tStartMs": 707250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and migrate toward the cathode."
    } ]
  }, {
    "tStartMs": 709410,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The electrons arriving through the circuit"
    } ]
  }, {
    "tStartMs": 711090,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "are taken up by the titanium atoms"
    } ]
  }, {
    "tStartMs": 712920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and the titanium disulfide."
    } ]
  }, {
    "tStartMs": 714780,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The positive lithium-ions\nslide between the layers"
    } ]
  }, {
    "tStartMs": 717930,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to balance out the negative\ncharge of the electrons,"
    } ]
  }, {
    "tStartMs": 720150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and they become locked in place."
    } ]
  }, {
    "tStartMs": 722490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And this process is reversible."
    } ]
  }, {
    "tStartMs": 724380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "When you apply a voltage to recharge,"
    } ]
  }, {
    "tStartMs": 726480,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the extra electrons are\nstripped from the titanium"
    } ]
  }, {
    "tStartMs": 728910,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and pulled back to the anode."
    } ]
  }, {
    "tStartMs": 730800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The lithium-ions are forced out"
    } ]
  }, {
    "tStartMs": 732300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of the titanium disulfide\nlayers into the electrolyte,"
    } ]
  }, {
    "tStartMs": 735060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and they too migrate to the anode"
    } ]
  }, {
    "tStartMs": 736890,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "where metallic lithium reforms."
    } ]
  }, {
    "tStartMs": 739650,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "What Whittingham had created here"
    } ]
  }, {
    "tStartMs": 741240,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "was a rechargeable battery,\none that worked reliably"
    } ]
  }, {
    "tStartMs": 744570,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "cycle after cycle with\nincredible consistency."
    } ]
  }, {
    "tStartMs": 748500,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I don't normally think\nabout batteries this way,"
    } ]
  }, {
    "tStartMs": 750870,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but what they really are\nis tiny little contained"
    } ]
  }, {
    "tStartMs": 754320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "chemical reactions."
    } ]
  }, {
    "tStartMs": 755760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And in a chemical reaction,"
    } ]
  }, {
    "tStartMs": 757050,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "if you could get a 60% yield,"
    } ]
  }, {
    "tStartMs": 759390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that would be considered good."
    } ]
  }, {
    "tStartMs": 761340,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "But in a battery,"
    } ]
  }, {
    "tStartMs": 762420,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "especially one that you\nwanna recharge 1000 times,"
    } ]
  }, {
    "tStartMs": 765570,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "you need that reaction to\nbe say 99.9% efficient,"
    } ]
  }, {
    "tStartMs": 769950,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "because if it's not, the\ncapacity of that battery"
    } ]
  }, {
    "tStartMs": 772890,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "rapidly deteriorates."
    } ]
  }, {
    "tStartMs": 774660,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If you have, say, a 95% yield,"
    } ]
  }, {
    "tStartMs": 776940,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "then you'd lose a significant fraction"
    } ]
  }, {
    "tStartMs": 778650,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of lithium-ions every cycle."
    } ]
  }, {
    "tStartMs": 780210,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "After just 50 cycles, you'd only have 8%"
    } ]
  }, {
    "tStartMs": 782910,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of your original capacity left."
    } ]
  }, {
    "tStartMs": 785220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So that's pretty incredible"
    } ]
  }, {
    "tStartMs": 787140,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that every single lithium-ion"
    } ]
  }, {
    "tStartMs": 788790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "has to leave one electrode,\npass through the electrolyte,"
    } ]
  }, {
    "tStartMs": 791160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and slot neatly into the\nlayered crystal structure"
    } ]
  }, {
    "tStartMs": 793500,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of titanium disulfide."
    } ]
  }, {
    "tStartMs": 794790,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And then when you recharge it,"
    } ]
  }, {
    "tStartMs": 796620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they have to leave again\ncleanly without incident,"
    } ]
  }, {
    "tStartMs": 799380,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "without getting stuck, make their way"
    } ]
  }, {
    "tStartMs": 800970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "all the way back to the anode."
    } ]
  }, {
    "tStartMs": 802770,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Amazingly, despite just\nbeing an early prototype,"
    } ]
  }, {
    "tStartMs": 805560,
    "dDurationMs": 3953,
    "segs": [ {
      "utf8": "Whittingham's battery\ncame close to that 99%."
    } ]
  }, {
    "tStartMs": 811020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "In the winter of 1973,"
    } ]
  }, {
    "tStartMs": 812760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Exxon's managers summoned Whittingham"
    } ]
  }, {
    "tStartMs": 814680,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "to the company's New York office."
    } ]
  }, {
    "tStartMs": 817800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Whittingham later said, \"I\nwent in there and explained it,"
    } ]
  }, {
    "tStartMs": 820260,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "five minutes, 10 minutes at the most,"
    } ]
  }, {
    "tStartMs": 822330,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and within a week they said yes,"
    } ]
  }, {
    "tStartMs": 824010,
    "dDurationMs": 1857,
    "segs": [ {
      "utf8": "they wanted to invest in this.\""
    } ]
  }, {
    "tStartMs": 827490,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They got to work at the Exxon laboratory,"
    } ]
  }, {
    "tStartMs": 829470,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but it wasn't all smooth sailing."
    } ]
  }, {
    "tStartMs": 831720,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Firefighters had to be\ncalled out repeatedly."
    } ]
  }, {
    "tStartMs": 834270,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "They were called so often,"
    } ]
  }, {
    "tStartMs": 835530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "they threatened to start charging the lab"
    } ]
  }, {
    "tStartMs": 837120,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "for the special chemicals needed"
    } ]
  }, {
    "tStartMs": 838410,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to extinguish the burning lithium."
    } ]
  }, {
    "tStartMs": 840540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- The problem was the anode."
    } ]
  }, {
    "tStartMs": 842280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Whittingham's design used pure lithium,"
    } ]
  }, {
    "tStartMs": 844530,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "which worked brilliantly, until it didn't."
    } ]
  }, {
    "tStartMs": 847980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Billy] We've made a special cell."
    } ]
  }, {
    "tStartMs": 849600,
    "dDurationMs": 1007,
    "segs": [ {
      "utf8": "We've made a transparent battery."
    } ]
  }, {
    "tStartMs": 850607,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "- [Gregor] That's so cool."
    } ]
  }, {
    "tStartMs": 852150,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- But they're very, very small,"
    } ]
  }, {
    "tStartMs": 853290,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "so we have a microscope lens"
    } ]
  }, {
    "tStartMs": 855420,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "just to allow us to see it."
    } ]
  }, {
    "tStartMs": 857970,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "What you're seeing here\nis a piece of copper,"
    } ]
  }, {
    "tStartMs": 860880,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which we're gradually\nplating with lithium."
    } ]
  }, {
    "tStartMs": 863340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So this is analogous\nto the first generation"
    } ]
  }, {
    "tStartMs": 865920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "lithium metal batteries,"
    } ]
  }, {
    "tStartMs": 867840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which use lithium metal as the anode."
    } ]
  }, {
    "tStartMs": 870000,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "On this side, we have a piece of lithium."
    } ]
  }, {
    "tStartMs": 872970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "As we charge the battery,\nwe're stripping the lithium"
    } ]
  }, {
    "tStartMs": 875640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "from that electrode and we're plating it."
    } ]
  }, {
    "tStartMs": 877680,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And actually what's happening right now"
    } ]
  }, {
    "tStartMs": 879270,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "is the ideal reaction\nwhere it's very slow."
    } ]
  }, {
    "tStartMs": 882660,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We're getting a dense plate."
    } ]
  }, {
    "tStartMs": 884700,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "The challenge then\nbecomes if we go too fast."
    } ]
  }, {
    "tStartMs": 889380,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Gregor] Oh, that is huge!"
    } ]
  }, {
    "tStartMs": 891330,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Everything's fine"
    } ]
  }, {
    "tStartMs": 892530,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "until all of a sudden it's not fine."
    } ]
  }, {
    "tStartMs": 895800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So we want the lithium to\nplate evenly across everywhere,"
    } ]
  }, {
    "tStartMs": 898620,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but instead, it forms\nin that one location,"
    } ]
  }, {
    "tStartMs": 901740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and that is what is a lithium dendrite."
    } ]
  }, {
    "tStartMs": 904620,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "That lithium dendrite can grow."
    } ]
  }, {
    "tStartMs": 906840,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The length scales of\nthis is on the order of,"
    } ]
  }, {
    "tStartMs": 910500,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "you know, millimeters,"
    } ]
  }, {
    "tStartMs": 911370,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "so that would've easily\nshort circuited the battery."
    } ]
  }, {
    "tStartMs": 915000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Gregor] And that dendrite\ncan just keep growing,"
    } ]
  }, {
    "tStartMs": 917130,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and eventually it's gonna\npoke through the separator"
    } ]
  }, {
    "tStartMs": 919560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and reach to the other side."
    } ]
  }, {
    "tStartMs": 921600,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Now the electrons are\ngonna have a shortcut,"
    } ]
  }, {
    "tStartMs": 923580,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so instead of going through the circuit,"
    } ]
  }, {
    "tStartMs": 925650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "they race straight from the anode"
    } ]
  }, {
    "tStartMs": 927330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to the cathode using the dendrite,"
    } ]
  }, {
    "tStartMs": 929400,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and that sudden surge of\nelectrons cause intense heating,"
    } ]
  }, {
    "tStartMs": 932880,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and that can trigger a chain\nreaction inside the battery,"
    } ]
  }, {
    "tStartMs": 936360,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "leading to a fire, or even an explosion."
    } ]
  }, {
    "tStartMs": 941070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- For all its promise,"
    } ]
  }, {
    "tStartMs": 942690,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Whittingham's battery\nwas just too dangerous,"
    } ]
  }, {
    "tStartMs": 944790,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and then the oil crisis ended."
    } ]
  }, {
    "tStartMs": 947070,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Prices dropped and Exxon's\nurgency evaporated."
    } ]
  }, {
    "tStartMs": 950310,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The company shut down its\nlithium battery program."
    } ]
  }, {
    "tStartMs": 953700,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Whittingham published his design in 1976,"
    } ]
  }, {
    "tStartMs": 956070,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and Exxon licensed the patent\nto a few manufacturers,"
    } ]
  }, {
    "tStartMs": 959430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but with no funding and no momentum,"
    } ]
  }, {
    "tStartMs": 961320,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the first lithium battery revolution died"
    } ]
  }, {
    "tStartMs": 963660,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "before it had a chance to take off."
    } ]
  }, {
    "tStartMs": 966090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Fortunately, a copy of Whittingham's paper"
    } ]
  }, {
    "tStartMs": 968070,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "made it across the Atlantic"
    } ]
  }, {
    "tStartMs": 969420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to Oxford University in England,"
    } ]
  }, {
    "tStartMs": 971490,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "where it caught the attention\nof John B. Goodenough,"
    } ]
  }, {
    "tStartMs": 974100,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "an American physicist leading\na solid state chemistry group."
    } ]
  }, {
    "tStartMs": 978570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "As he read the paper, one thing stood out,"
    } ]
  }, {
    "tStartMs": 981030,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the cell voltage was being held back."
    } ]
  }, {
    "tStartMs": 983850,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The material Whittingham\nchose for the cathode,"
    } ]
  }, {
    "tStartMs": 986070,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "titanium disulfide, capped\nthe cell at just 2.4 volts,"
    } ]
  }, {
    "tStartMs": 990180,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "but Goodenough believed that"
    } ]
  }, {
    "tStartMs": 991440,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with a better cathode\nmaterial, he could do better."
    } ]
  }, {
    "tStartMs": 995490,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "He had previously worked"
    } ]
  }, {
    "tStartMs": 996540,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with compounds called\ntransition metal oxides."
    } ]
  }, {
    "tStartMs": 999240,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "They were more stable than sulfides,"
    } ]
  }, {
    "tStartMs": 1001010,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and some he knew were\nextremely hungry for electrons,"
    } ]
  }, {
    "tStartMs": 1004460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "perfect for a cathode."
    } ]
  }, {
    "tStartMs": 1006260,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "He tried one of these\ncompounds in his battery,"
    } ]
  }, {
    "tStartMs": 1008450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and the voltage immediately spiked"
    } ]
  }, {
    "tStartMs": 1009980,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "from 2.4 volts to four volts."
    } ]
  }, {
    "tStartMs": 1012620,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "This jump was incredible."
    } ]
  }, {
    "tStartMs": 1014690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But what was even more\nsurprising was the fact"
    } ]
  }, {
    "tStartMs": 1016970,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that this compound\nalready had lithium in it."
    } ]
  }, {
    "tStartMs": 1020000,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "The material was lithium cobalt oxide."
    } ]
  }, {
    "tStartMs": 1024080,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Lithium cobalt oxide is\narranged so that the cobalt"
    } ]
  }, {
    "tStartMs": 1026870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and oxygen atoms form\ntightly bonded layers,"
    } ]
  }, {
    "tStartMs": 1029630,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "with lithium-ions nestled in between."
    } ]
  }, {
    "tStartMs": 1032420,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This means that your\nsupply of lithium-ions"
    } ]
  }, {
    "tStartMs": 1034760,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "doesn't just have to come"
    } ]
  }, {
    "tStartMs": 1035660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "from the dangerous lithium\nmetal on the anode side,"
    } ]
  }, {
    "tStartMs": 1038180,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "it's already there\nprebuilt into the cathode."
    } ]
  }, {
    "tStartMs": 1041090,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "So theoretically, you don't\neven need lithium metal at all."
    } ]
  }, {
    "tStartMs": 1045050,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "You could assemble the\ncell in a discharged state"
    } ]
  }, {
    "tStartMs": 1047630,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "with all your lithium-ions in the cathode,"
    } ]
  }, {
    "tStartMs": 1049940,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "then when you connect it to a charger,"
    } ]
  }, {
    "tStartMs": 1051320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "these ions will get expelled"
    } ]
  }, {
    "tStartMs": 1052760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "from the cathode crystal lattice\nand into the electrolyte."
    } ]
  }, {
    "tStartMs": 1055520,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "At the same time, nearby cobalt atoms"
    } ]
  }, {
    "tStartMs": 1057650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "will give up an electron\nto balance out the charge,"
    } ]
  }, {
    "tStartMs": 1060110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and those electrons\nthen go through the wire"
    } ]
  }, {
    "tStartMs": 1062360,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to the anode to meet with the ions."
    } ]
  }, {
    "tStartMs": 1064850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If Goodenough could find an anode"
    } ]
  }, {
    "tStartMs": 1066590,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that would replace lithium metal,"
    } ]
  }, {
    "tStartMs": 1068360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "the battery would become\nsafe enough to leave the lab"
    } ]
  }, {
    "tStartMs": 1070610,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "and actually power real world devices."
    } ]
  }, {
    "tStartMs": 1073910,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Goodenough was so excited about\nthe potential of his design"
    } ]
  }, {
    "tStartMs": 1076910,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that he reached out to battery\ncompanies across the US,"
    } ]
  }, {
    "tStartMs": 1079820,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "the UK and Europe, but\nincredibly, no one was interested."
    } ]
  }, {
    "tStartMs": 1084860,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "So he asked Oxford to file\na patent, but they refused."
    } ]
  }, {
    "tStartMs": 1089420,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So he took it to a\ngovernment lab near Oxford,"
    } ]
  }, {
    "tStartMs": 1092300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the Atomic Energy Research Establishment,"
    } ]
  }, {
    "tStartMs": 1094580,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and finally, they agreed\nto fund the patent,"
    } ]
  }, {
    "tStartMs": 1097670,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "but only if Goodenough signed\naway his financial rights."
    } ]
  }, {
    "tStartMs": 1101990,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Seeing no other option, he agreed,"
    } ]
  }, {
    "tStartMs": 1104240,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and the lab patented\nthe invention in 1981."
    } ]
  }, {
    "tStartMs": 1107660,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Now, this should have been a gold mine,"
    } ]
  }, {
    "tStartMs": 1110240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "but the lab didn't realize what they had."
    } ]
  }, {
    "tStartMs": 1112940,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And so for the second time,"
    } ]
  }, {
    "tStartMs": 1114290,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "the lithium battery revolution\nwas boxed up and shelved."
    } ]
  }, {
    "tStartMs": 1118190,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This should have been a turning\npoint for battery science,"
    } ]
  }, {
    "tStartMs": 1120830,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "but bureaucracy and\ninertia stalled progress."
    } ]
  }, {
    "tStartMs": 1124100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Every field has its bottlenecks."
    } ]
  }, {
    "tStartMs": 1126230,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "For batteries, it was\nslow moving institutions."
    } ]
  }, {
    "tStartMs": 1129500,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "For developers today, it's\nslow moving code reviews."
    } ]
  }, {
    "tStartMs": 1132950,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And I can relate."
    } ]
  }, {
    "tStartMs": 1134270,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "When we make these videos,"
    } ]
  }, {
    "tStartMs": 1135440,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "especially the ones with simulations"
    } ]
  }, {
    "tStartMs": 1137060,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "or complex animations,\nit's rarely the ideas"
    } ]
  }, {
    "tStartMs": 1139280,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that slow us down, it is the reviews."
    } ]
  }, {
    "tStartMs": 1142070,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Developers face the same thing."
    } ]
  }, {
    "tStartMs": 1143840,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They're writing code faster than ever,"
    } ]
  }, {
    "tStartMs": 1145880,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "thanks to tools like Copilot and Cursor."
    } ]
  }, {
    "tStartMs": 1148340,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "But code reviews, well, they're\nstill manual and still slow."
    } ]
  }, {
    "tStartMs": 1152660,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "That's where this video's\nsponsor CodeRabbit comes in."
    } ]
  }, {
    "tStartMs": 1155420,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "CodeRabbit automates code\nreviews with generative AI."
    } ]
  }, {
    "tStartMs": 1158750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Unlike basic tools, it\nunderstands your code base,"
    } ]
  }, {
    "tStartMs": 1161150,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "your architecture, standards,\neven naming conventions."
    } ]
  }, {
    "tStartMs": 1164420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It pulls context from over 40 sources"
    } ]
  }, {
    "tStartMs": 1166520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to give feedback that\nfeels precise and human"
    } ]
  }, {
    "tStartMs": 1168920,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and tailored to your team,\nright in the Git workflow."
    } ]
  }, {
    "tStartMs": 1171620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "That's why it catches\nwhat other tools miss,"
    } ]
  }, {
    "tStartMs": 1173870,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "logic errors, bad\nconditions, math mistakes,"
    } ]
  }, {
    "tStartMs": 1176390,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "even security vulnerabilities,\nlike SQL injections."
    } ]
  }, {
    "tStartMs": 1179330,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "The result?"
    } ]
  }, {
    "tStartMs": 1180170,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Well, your senior engineers"
    } ]
  }, {
    "tStartMs": 1181520,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "spend less time buried in reviews"
    } ]
  }, {
    "tStartMs": 1183410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and more time solving the problems"
    } ]
  }, {
    "tStartMs": 1185210,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "that only humans can solve."
    } ]
  }, {
    "tStartMs": 1187520,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Try it out at CodeRabbit.link/veritasium"
    } ]
  }, {
    "tStartMs": 1190250,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to cut code review time and bugs in half."
    } ]
  }, {
    "tStartMs": 1192770,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And if you're working\non open source projects,"
    } ]
  }, {
    "tStartMs": 1194720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "it's completely free."
    } ]
  }, {
    "tStartMs": 1196220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That's CodeRabbit.link/veritasium."
    } ]
  }, {
    "tStartMs": 1198620,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "I would like to thank CodeRabbit"
    } ]
  }, {
    "tStartMs": 1199700,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "for sponsoring this part of the video."
    } ]
  }, {
    "tStartMs": 1201740,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And now back to Goodenough's design,"
    } ]
  }, {
    "tStartMs": 1203750,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "a breakthrough with nowhere to go, yet."
    } ]
  }, {
    "tStartMs": 1207530,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "While Goodenough's battery\ndesign was gathering dust,"
    } ]
  }, {
    "tStartMs": 1209830,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "10,000 kilometers away in Japan,"
    } ]
  }, {
    "tStartMs": 1212240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "a 34-year-old chemist named Akira Yoshino"
    } ]
  }, {
    "tStartMs": 1214940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "was trying to find a safer battery anode,"
    } ]
  }, {
    "tStartMs": 1217460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "one that didn't require lithium metal."
    } ]
  }, {
    "tStartMs": 1219950,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Yoshino was actually looking at plastic."
    } ]
  }, {
    "tStartMs": 1222560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Now, normally plastic is an insulator,"
    } ]
  }, {
    "tStartMs": 1224960,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but the kind Yoshino was\nlooking at is different."
    } ]
  }, {
    "tStartMs": 1227990,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It's called polyacetylene,"
    } ]
  }, {
    "tStartMs": 1229880,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and its carbon atoms are\narranged in a repeating chain"
    } ]
  }, {
    "tStartMs": 1232910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of single and double bonds,"
    } ]
  }, {
    "tStartMs": 1234710,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "a structure that gives it\nunusual electronic properties."
    } ]
  }, {
    "tStartMs": 1238220,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "If you tweak polyacetylene by\nadding or removing electrons,"
    } ]
  }, {
    "tStartMs": 1241940,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "electrons can actually move\nalong this carbon chain."
    } ]
  }, {
    "tStartMs": 1245000,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So the plastic conducts\nelectricity like a metal."
    } ]
  }, {
    "tStartMs": 1248840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And that got Yoshino thinking,"
    } ]
  }, {
    "tStartMs": 1250760,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "what if polyacetylene could\nwork as a battery anode?"
    } ]
  }, {
    "tStartMs": 1253850,
    "dDurationMs": 3357,
    "segs": [ {
      "utf8": "During charging, it could absorb\nlithium-ions and electrons,"
    } ]
  }, {
    "tStartMs": 1257207,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "and then during discharge, it\nwould give up those electrons"
    } ]
  }, {
    "tStartMs": 1260240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to the circuit, just\nlike lithium metal does."
    } ]
  }, {
    "tStartMs": 1262700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "If it worked, it could eliminate\nthe most dangerous part"
    } ]
  }, {
    "tStartMs": 1265460,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "of the battery, the metallic lithium."
    } ]
  }, {
    "tStartMs": 1268190,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But for months, Yoshino struggled."
    } ]
  }, {
    "tStartMs": 1270140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Obviously, since he removed\nlithium metal from the anode,"
    } ]
  }, {
    "tStartMs": 1272900,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "he had to get lithium-ions\nfrom somewhere else"
    } ]
  }, {
    "tStartMs": 1275690,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and he couldn't figure it out."
    } ]
  }, {
    "tStartMs": 1277850,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And then just as he was losing hope,"
    } ]
  }, {
    "tStartMs": 1279680,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "on the last workday of 1982\nwhile cleaning out his office,"
    } ]
  }, {
    "tStartMs": 1282920,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "he stumbled upon a 1980\npaper by John B. Goodenough."
    } ]
  }, {
    "tStartMs": 1286850,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It described a cathode made\nof lithium cobalt oxide,"
    } ]
  }, {
    "tStartMs": 1289850,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "a cathode that already contained lithium."
    } ]
  }, {
    "tStartMs": 1293030,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "This was the missing piece."
    } ]
  }, {
    "tStartMs": 1295970,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "He sketched out the reaction\nbetween lithium cobalt oxide"
    } ]
  }, {
    "tStartMs": 1298880,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and his lithium free anode,"
    } ]
  }, {
    "tStartMs": 1300590,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and then built a test cell\nusing the two materials."
    } ]
  }, {
    "tStartMs": 1303560,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It worked safely and reliably,"
    } ]
  }, {
    "tStartMs": 1306470,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but Yoshino wasn't satisfied."
    } ]
  }, {
    "tStartMs": 1308690,
    "dDurationMs": 1677,
    "segs": [ {
      "utf8": "The material he used for the anode,"
    } ]
  }, {
    "tStartMs": 1310367,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "the polyacetylene had an\nextremely low density."
    } ]
  }, {
    "tStartMs": 1313490,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I mean, it couldn't\npack in enough lithium,"
    } ]
  }, {
    "tStartMs": 1316220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "so the energy density of\nthe battery was terrible."
    } ]
  }, {
    "tStartMs": 1319250,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Yoshino needed something\nmore lightweight, compact,"
    } ]
  }, {
    "tStartMs": 1322160,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "conductive, and crucially,"
    } ]
  }, {
    "tStartMs": 1323990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "something that could reversibly accept"
    } ]
  }, {
    "tStartMs": 1325850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and release lithium-ions\nwithin its structure"
    } ]
  }, {
    "tStartMs": 1327950,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "without breaking down."
    } ]
  }, {
    "tStartMs": 1329540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "He tested material after material,"
    } ]
  }, {
    "tStartMs": 1331580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and every single one failed,"
    } ]
  }, {
    "tStartMs": 1333500,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "until a breakthrough came\nfrom within his own company."
    } ]
  }, {
    "tStartMs": 1336890,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Another team had developed\na new form of carbon"
    } ]
  }, {
    "tStartMs": 1339290,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "with a unique crystalline structure."
    } ]
  }, {
    "tStartMs": 1341510,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They called it vapor grown carbon fiber."
    } ]
  }, {
    "tStartMs": 1344030,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "He got his hands on a sample,"
    } ]
  }, {
    "tStartMs": 1345650,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "tried it in the lab, and it worked."
    } ]
  }, {
    "tStartMs": 1349760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "To prove it, he placed a test cell"
    } ]
  }, {
    "tStartMs": 1351680,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "containing metallic\nlithium into a safety rig,"
    } ]
  }, {
    "tStartMs": 1354650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "one that's designed to test explosives."
    } ]
  }, {
    "tStartMs": 1356930,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Then he dropped a heavy iron rod onto it."
    } ]
  }, {
    "tStartMs": 1360380,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It exploded violently."
    } ]
  }, {
    "tStartMs": 1362450,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Then he ran the same test again,"
    } ]
  }, {
    "tStartMs": 1364130,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but this time with his new design,"
    } ]
  }, {
    "tStartMs": 1365810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "using carbon as the anode."
    } ]
  }, {
    "tStartMs": 1367760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "He charged the cell, placed it in the rig,"
    } ]
  }, {
    "tStartMs": 1369920,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and dropped the rod but nothing happened."
    } ]
  }, {
    "tStartMs": 1373670,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "The contrast was undeniable."
    } ]
  }, {
    "tStartMs": 1377600,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Later, Yoshino would say,"
    } ]
  }, {
    "tStartMs": 1379227,
    "dDurationMs": 4073,
    "segs": [ {
      "utf8": "\"That was the moment when the\nlithium-ion battery was born.\""
    } ]
  }, {
    "tStartMs": 1383300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But his employer, Asahi Chemical,"
    } ]
  }, {
    "tStartMs": 1385610,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "well, they weren't a battery company,"
    } ]
  }, {
    "tStartMs": 1388070,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and they didn't know\nhow to make batteries."
    } ]
  }, {
    "tStartMs": 1390890,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So in 1986, Asahi\nexecutive Isao Kuribayashi"
    } ]
  }, {
    "tStartMs": 1394910,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "flew to Boston on a top secret mission,"
    } ]
  }, {
    "tStartMs": 1397430,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "carrying three jars containing cathode,"
    } ]
  }, {
    "tStartMs": 1399770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "anode and electrolyte materials."
    } ]
  }, {
    "tStartMs": 1402290,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "He handed them to a tiny firm\ncalled Battery Engineering,"
    } ]
  }, {
    "tStartMs": 1405590,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "working out of a converted truck garage,"
    } ]
  }, {
    "tStartMs": 1408020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and he asked them to turn the materials"
    } ]
  }, {
    "tStartMs": 1409760,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "into cylindrical cells,"
    } ]
  }, {
    "tStartMs": 1411170,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "like the kind you might\nbuy for a flashlight."
    } ]
  }, {
    "tStartMs": 1413990,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The team did just that,"
    } ]
  }, {
    "tStartMs": 1415520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "completely unaware of\nwhat they were handling."
    } ]
  }, {
    "tStartMs": 1418280,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It wasn't until 2020 that\nemployees learned the truth"
    } ]
  }, {
    "tStartMs": 1421550,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that they had helped\nassemble the world's first"
    } ]
  }, {
    "tStartMs": 1423860,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "pre-production lithium-ion batteries."
    } ]
  }, {
    "tStartMs": 1427070,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Two weeks later, Kuribayashi\nreturned to Japan"
    } ]
  }, {
    "tStartMs": 1429740,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "with 200 finished perfectly\nfunctioning cells."
    } ]
  }, {
    "tStartMs": 1433130,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Even then, Asahi's leadership hesitated."
    } ]
  }, {
    "tStartMs": 1436760,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Kuribayashi refused to give up."
    } ]
  }, {
    "tStartMs": 1438470,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "On the 21st of January, 1987,"
    } ]
  }, {
    "tStartMs": 1440450,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "he visited Sony and he took\none of the prototype cells"
    } ]
  }, {
    "tStartMs": 1443360,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and rolled it across the\nconference table to the Sony execs,"
    } ]
  }, {
    "tStartMs": 1446540,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and at last, they saw its potential."
    } ]
  }, {
    "tStartMs": 1450440,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "They reworked the design,"
    } ]
  }, {
    "tStartMs": 1451850,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "swapping out Yoshino's carbon material"
    } ]
  }, {
    "tStartMs": 1453650,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "for graphite that could better\nintercalate lithium-ions"
    } ]
  }, {
    "tStartMs": 1456650,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "between its layers."
    } ]
  }, {
    "tStartMs": 1458090,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And in 1991, Sony launched"
    } ]
  }, {
    "tStartMs": 1460280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the first commercial lithium-ion battery"
    } ]
  }, {
    "tStartMs": 1462560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "inside this, the Sony Handycam."
    } ]
  }, {
    "tStartMs": 1465500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Their battery was compact,\nrechargeable, powerful,"
    } ]
  }, {
    "tStartMs": 1468320,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and crucially, free of\nunstable lithium metal."
    } ]
  }, {
    "tStartMs": 1472280,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It was Sony who first coined the name"
    } ]
  }, {
    "tStartMs": 1474470,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "lithium-ion and it stuck."
    } ]
  }, {
    "tStartMs": 1478790,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But this wasn't just about one camcorder."
    } ]
  }, {
    "tStartMs": 1481280,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Competing companies like Panasonic"
    } ]
  }, {
    "tStartMs": 1482990,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and Sanyo raced to catch up."
    } ]
  }, {
    "tStartMs": 1485210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Lithium-ion batteries started appearing"
    } ]
  }, {
    "tStartMs": 1487010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in phones, CD players, laptops."
    } ]
  }, {
    "tStartMs": 1489650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Manufacturers actually began to advertise"
    } ]
  }, {
    "tStartMs": 1491810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the use of lithium-ion batteries"
    } ]
  }, {
    "tStartMs": 1493370,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "as a key selling point of their products."
    } ]
  }, {
    "tStartMs": 1495500,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- I'm showing my age here."
    } ]
  }, {
    "tStartMs": 1496640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I joined the industry\nwhen lithium-ion cells"
    } ]
  }, {
    "tStartMs": 1498920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "were first introduced,"
    } ]
  }, {
    "tStartMs": 1500210,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and there was a Sony\ncamcorder that was introduced,"
    } ]
  }, {
    "tStartMs": 1503480,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and then there was Dell computer."
    } ]
  }, {
    "tStartMs": 1504740,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And I still remember the\nads when Dell computer"
    } ]
  }, {
    "tStartMs": 1506630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "introduced their lithium-ion battery,"
    } ]
  }, {
    "tStartMs": 1508100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and they had eight hours of runtime,"
    } ]
  }, {
    "tStartMs": 1510500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so they had an advertisement in a magazine"
    } ]
  }, {
    "tStartMs": 1512570,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and it was eight pages long."
    } ]
  }, {
    "tStartMs": 1514070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Each one was an hour longer,\nso it was a big deal."
    } ]
  }, {
    "tStartMs": 1517250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- But what's crazy is\nthat even after all this,"
    } ]
  }, {
    "tStartMs": 1519620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "these batteries should never have worked."
    } ]
  }, {
    "tStartMs": 1521870,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "See, when you charge the\nbattery for the first time,"
    } ]
  }, {
    "tStartMs": 1524150,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "lithium-ions move from the\ncathode to the graphite anode."
    } ]
  }, {
    "tStartMs": 1527570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And here, they react with the electrolyte"
    } ]
  }, {
    "tStartMs": 1529610,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to form this weird complex\npatchwork of compounds"
    } ]
  }, {
    "tStartMs": 1533690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that build up on the anode's surface."
    } ]
  }, {
    "tStartMs": 1535970,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "These parasitic side reactions"
    } ]
  }, {
    "tStartMs": 1538010,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "should keep going on indefinitely,"
    } ]
  }, {
    "tStartMs": 1539630,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "using up all the lithium"
    } ]
  }, {
    "tStartMs": 1540950,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and destroying the cell but they don't."
    } ]
  }, {
    "tStartMs": 1544490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Instead they form a thin protective layer"
    } ]
  }, {
    "tStartMs": 1546860,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "known as the solid\nelectrolyte interface, or SEI."
    } ]
  }, {
    "tStartMs": 1550520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's a kind of chemical shield"
    } ]
  }, {
    "tStartMs": 1552200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "protecting both the graphite anode"
    } ]
  }, {
    "tStartMs": 1553910,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and the electrolyte\nfrom further reactions."
    } ]
  }, {
    "tStartMs": 1556430,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "But crucially, lithium-ions\ncan still slip through it."
    } ]
  }, {
    "tStartMs": 1560600,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "When the SEI originally forms"
    } ]
  }, {
    "tStartMs": 1562670,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "during the first charging cycle,"
    } ]
  }, {
    "tStartMs": 1564260,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "around 5% of the lithium in the cell"
    } ]
  }, {
    "tStartMs": 1566480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "actually gets stuck in this layer,"
    } ]
  }, {
    "tStartMs": 1568490,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "decreasing the battery's capacity."
    } ]
  }, {
    "tStartMs": 1570590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But this little trade off"
    } ]
  }, {
    "tStartMs": 1571970,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is what makes the battery stable enough"
    } ]
  }, {
    "tStartMs": 1573590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to be used for years or even decades,"
    } ]
  }, {
    "tStartMs": 1575990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which is why today lithium-ion batteries"
    } ]
  }, {
    "tStartMs": 1578270,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "are virtually everywhere."
    } ]
  }, {
    "tStartMs": 1580790,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "From 1991 to 2023, the\nprice per kilowatt hour"
    } ]
  }, {
    "tStartMs": 1584450,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "dropped by 99% from nearly\n$9,000 to just $100."
    } ]
  }, {
    "tStartMs": 1589820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "At the same time, energy\ndensity and cycle life,"
    } ]
  }, {
    "tStartMs": 1592610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "how many times a battery can be charged"
    } ]
  }, {
    "tStartMs": 1594260,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and discharged before it wears\nout, improved dramatically,"
    } ]
  }, {
    "tStartMs": 1597530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "crossing a critical threshold."
    } ]
  }, {
    "tStartMs": 1599330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Lithium-ion batteries had\nbecome powerful enough"
    } ]
  }, {
    "tStartMs": 1601670,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and finally cheap enough\nfor something bigger,"
    } ]
  }, {
    "tStartMs": 1604370,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "the return of the electric car."
    } ]
  }, {
    "tStartMs": 1608930,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "Today, lithium-ion powers\na $100 billion industry."
    } ]
  }, {
    "tStartMs": 1612980,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "In 2019, Whittingham, Goodenough"
    } ]
  }, {
    "tStartMs": 1614960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and Yoshino finally received"
    } ]
  }, {
    "tStartMs": 1616460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the Nobel Prize in\nchemistry for an invention"
    } ]
  }, {
    "tStartMs": 1618770,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "that in the committee's words"
    } ]
  }, {
    "tStartMs": 1620307,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "\"Revolutionized our way of life.\""
    } ]
  }, {
    "tStartMs": 1623000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This made Goodenough the oldest\nNobel laureate in history,"
    } ]
  }, {
    "tStartMs": 1626120,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "receiving the award at the age of 97."
    } ]
  }, {
    "tStartMs": 1630380,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But lithium-ion isn't perfect."
    } ]
  }, {
    "tStartMs": 1632810,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Scary moments aboard a JetBlue plane,"
    } ]
  }, {
    "tStartMs": 1635120,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "a fire erupting after\na passenger's backpack"
    } ]
  }, {
    "tStartMs": 1638270,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "suddenly exploded."
    } ]
  }, {
    "tStartMs": 1639350,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Every week, inside an airplane,"
    } ]
  }, {
    "tStartMs": 1640850,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "there is at least one event of a battery,"
    } ]
  }, {
    "tStartMs": 1644080,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "of a phone, of an iPad\nor a toy or something"
    } ]
  }, {
    "tStartMs": 1647420,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "that catches fire."
    } ]
  }, {
    "tStartMs": 1648470,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- What, every week?"
    } ]
  }, {
    "tStartMs": 1649880,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Yeah, every week."
    } ]
  }, {
    "tStartMs": 1650930,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- It's just the latest\nincident aboard a plane"
    } ]
  }, {
    "tStartMs": 1653210,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "involving lithium-ion batteries."
    } ]
  }, {
    "tStartMs": 1655310,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Reporter] So far this year,"
    } ]
  }, {
    "tStartMs": 1656450,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "60 onboard battery incidents\nthrough early October."
    } ]
  }, {
    "tStartMs": 1660080,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- Every flight in the US\nhas a bag, a specialized bag"
    } ]
  }, {
    "tStartMs": 1664040,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "with very thick non-flammable materials"
    } ]
  }, {
    "tStartMs": 1667490,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "where you put the phone inside,"
    } ]
  }, {
    "tStartMs": 1669710,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and you close it, and\nyou still have a hazard"
    } ]
  }, {
    "tStartMs": 1672110,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and you have to deal with these gases,"
    } ]
  }, {
    "tStartMs": 1673700,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but now you have put\nthe fire ignition away"
    } ]
  }, {
    "tStartMs": 1676760,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "from anything else."
    } ]
  }, {
    "tStartMs": 1678230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And if it burst into fireworks,"
    } ]
  }, {
    "tStartMs": 1680570,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "then at least it's in a container."
    } ]
  }, {
    "tStartMs": 1682190,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "And then you tell the captain,"
    } ]
  }, {
    "tStartMs": 1683817,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "\"We need to land immediately.\""
    } ]
  }, {
    "tStartMs": 1685970,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Derek] So what is actually happening"
    } ]
  }, {
    "tStartMs": 1687350,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "when a battery fails like that?"
    } ]
  }, {
    "tStartMs": 1689300,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- This is a classic lithium-ion battery,"
    } ]
  }, {
    "tStartMs": 1691910,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and today we're gonna do\nsomething I always wanted to do."
    } ]
  }, {
    "tStartMs": 1694670,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "We're gonna tear one down."
    } ]
  }, {
    "tStartMs": 1696830,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I guess safe to say don't do this at home."
    } ]
  }, {
    "tStartMs": 1699350,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But what would happen\nif you were to do this"
    } ]
  }, {
    "tStartMs": 1701150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "outside of the gloved box?"
    } ]
  }, {
    "tStartMs": 1702770,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- If you charged up the cell"
    } ]
  }, {
    "tStartMs": 1704780,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "and then you tried to tear it up,"
    } ]
  }, {
    "tStartMs": 1705950,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "then you could accidentally short it,"
    } ]
  }, {
    "tStartMs": 1708290,
    "dDurationMs": 1827,
    "segs": [ {
      "utf8": "and then it could burn"
    } ]
  }, {
    "tStartMs": 1710117,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and it could even explode or fire."
    } ]
  }, {
    "tStartMs": 1712910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "If you discharged it and you opened it up,"
    } ]
  }, {
    "tStartMs": 1714890,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you'd release all the different gases"
    } ]
  }, {
    "tStartMs": 1717140,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and really toxic chemicals,\nand if you inhale those,"
    } ]
  }, {
    "tStartMs": 1720290,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "then you'd probably end up in hospitals."
    } ]
  }, {
    "tStartMs": 1724580,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So at this point, we have\nwhat we call the jelly roll."
    } ]
  }, {
    "tStartMs": 1727100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So that's a roll off the cathode,"
    } ]
  }, {
    "tStartMs": 1728900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "separates that anode."
    } ]
  }, {
    "tStartMs": 1730250,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Gregor] Yeah."
    } ]
  }, {
    "tStartMs": 1731083,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "- Stuck together with bit of tape."
    } ]
  }, {
    "tStartMs": 1732050,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So Li Ren's just gonna\nscalpel off the tape,"
    } ]
  }, {
    "tStartMs": 1734420,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and then we should be able to\nunroll it into a nice sheet."
    } ]
  }, {
    "tStartMs": 1737960,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Gregor] So these little\npatches are the electrolyte or?"
    } ]
  }, {
    "tStartMs": 1740090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah.\n- Okay."
    } ]
  }, {
    "tStartMs": 1740923,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "- [Derek S.] So as time goes by,\nit'll start evaporating out."
    } ]
  }, {
    "tStartMs": 1743330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- That is so cool."
    } ]
  }, {
    "tStartMs": 1745670,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It's so obvious when you see it,"
    } ]
  }, {
    "tStartMs": 1746990,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but I don't think anyone\nintuitively thinks"
    } ]
  }, {
    "tStartMs": 1749720,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that it's a rolled up like sheet"
    } ]
  }, {
    "tStartMs": 1751460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of anode and cathode inside."
    } ]
  }, {
    "tStartMs": 1753410,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "But these layers inside the battery,"
    } ]
  }, {
    "tStartMs": 1754970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "they're not gonna stay perfect forever."
    } ]
  }, {
    "tStartMs": 1757130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Here's an electrode from a new cell"
    } ]
  }, {
    "tStartMs": 1759260,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "compared to one from an old one."
    } ]
  }, {
    "tStartMs": 1761270,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "You can see that the\nlithium is building up"
    } ]
  }, {
    "tStartMs": 1763330,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "in all of the wrong places,"
    } ]
  }, {
    "tStartMs": 1764960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and if this sort of\ndegradation gets out of hand,"
    } ]
  }, {
    "tStartMs": 1767840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "well, we're about to push the cell"
    } ]
  }, {
    "tStartMs": 1770000,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "past its breaking point."
    } ]
  }, {
    "tStartMs": 1772340,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "How do we blow up a battery?"
    } ]
  }, {
    "tStartMs": 1773630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- So today we've got a prismatic battery."
    } ]
  }, {
    "tStartMs": 1776480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "It's a small battery\nfrom sort of a power tool"
    } ]
  }, {
    "tStartMs": 1779780,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "or a phone or something similar."
    } ]
  }, {
    "tStartMs": 1781010,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "We're gonna wrap it in some nichrome wire,"
    } ]
  }, {
    "tStartMs": 1783470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "so we pass current through this wire."
    } ]
  }, {
    "tStartMs": 1785870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Something like 200 watts we pass through-"
    } ]
  }, {
    "tStartMs": 1788240,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- That's a lot.\n- This wire."
    } ]
  }, {
    "tStartMs": 1789260,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Yeah, and it's a significant battery."
    } ]
  }, {
    "tStartMs": 1790940,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "We want it to go and we want it"
    } ]
  }, {
    "tStartMs": 1792260,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "to go pretty spectacularly."
    } ]
  }, {
    "tStartMs": 1794709,
    "dDurationMs": 2773,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 1797482,
    "dDurationMs": 1018,
    "segs": [ {
      "utf8": "(scientists laughing)"
    } ]
  }, {
    "tStartMs": 1798500,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Gregor] Good luck, Harry."
    } ]
  }, {
    "tStartMs": 1799640,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "What we're simulating here"
    } ]
  }, {
    "tStartMs": 1800690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is a catastrophic battery failure,"
    } ]
  }, {
    "tStartMs": 1802970,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "the kind that could happen"
    } ]
  }, {
    "tStartMs": 1804350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "if a cell is damaged or overheated,"
    } ]
  }, {
    "tStartMs": 1806630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "or even just badly manufactured."
    } ]
  }, {
    "tStartMs": 1808580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It starts around 80 degrees Celsius"
    } ]
  }, {
    "tStartMs": 1810680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "when the protective SEI layer"
    } ]
  }, {
    "tStartMs": 1812510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "on the anode starts to break down."
    } ]
  }, {
    "tStartMs": 1814880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It's gonna try to reform,"
    } ]
  }, {
    "tStartMs": 1816500,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but these reactions are\ngonna release more heat,"
    } ]
  }, {
    "tStartMs": 1819290,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and if that heat can escape,"
    } ]
  }, {
    "tStartMs": 1821060,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "the temperature is gonna keep rising."
    } ]
  }, {
    "tStartMs": 1824780,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "How close is it to exploding now?"
    } ]
  }, {
    "tStartMs": 1826220,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "What do you think?"
    } ]
  }, {
    "tStartMs": 1827441,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "- It should burst very soon.\n- Seconds."
    } ]
  }, {
    "tStartMs": 1829040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Gregor] At roughly 130 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 1831380,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the polymer separator is gonna melt,"
    } ]
  }, {
    "tStartMs": 1833840,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and now the anode and cathode\ncan come into direct contact,"
    } ]
  }, {
    "tStartMs": 1837410,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and a massive internal short follows."
    } ]
  }, {
    "tStartMs": 1840110,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The cathode itself starts to decompose."
    } ]
  }, {
    "tStartMs": 1842930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And because transition metal oxides"
    } ]
  }, {
    "tStartMs": 1844640,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "release oxygen from\ntheir crystal structure,"
    } ]
  }, {
    "tStartMs": 1847370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they're gonna fuel the combustion,"
    } ]
  }, {
    "tStartMs": 1849080,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and now the fire is just feeding itself."
    } ]
  }, {
    "tStartMs": 1852590,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "Oh.\n- Yes!"
    } ]
  }, {
    "tStartMs": 1854125,
    "dDurationMs": 1363,
    "segs": [ {
      "utf8": "- Oh, oh my God."
    } ]
  }, {
    "tStartMs": 1855488,
    "dDurationMs": 1962,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1857450,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "That's really violent."
    } ]
  }, {
    "tStartMs": 1859700,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This is insane, from one\nsmall battery like that."
    } ]
  }, {
    "tStartMs": 1862310,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "- And it's only 50% state of charge."
    } ]
  }, {
    "tStartMs": 1865733,
    "dDurationMs": 1527,
    "segs": [ {
      "utf8": "- What we call ignition happens"
    } ]
  }, {
    "tStartMs": 1867260,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "inside the battery, not\noutside the battery,"
    } ]
  }, {
    "tStartMs": 1868910,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and it requires a fuel"
    } ]
  }, {
    "tStartMs": 1871970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "or a substance that\nwill undergo a reaction,"
    } ]
  }, {
    "tStartMs": 1874850,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "it requires an oxidizer"
    } ]
  }, {
    "tStartMs": 1876320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "or the equivalent oxidizer\nand it requires heat."
    } ]
  }, {
    "tStartMs": 1879080,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The battery contains these three inside,"
    } ]
  }, {
    "tStartMs": 1881510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "so it has its own\nequivalent to an oxidizer,"
    } ]
  }, {
    "tStartMs": 1884000,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "its own equivalent to a fuel"
    } ]
  }, {
    "tStartMs": 1885320,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and its own source of heat."
    } ]
  }, {
    "tStartMs": 1887390,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "- Yeah.\n- All of it in one device."
    } ]
  }, {
    "tStartMs": 1890480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- So it's not actually lithium that burns."
    } ]
  }, {
    "tStartMs": 1892940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "A modern lithium-ion battery"
    } ]
  }, {
    "tStartMs": 1895040,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "like this one here contains"
    } ]
  }, {
    "tStartMs": 1896810,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "very little lithium, ironically."
    } ]
  }, {
    "tStartMs": 1898460,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "It's actually everything else\ninside here that's dangerous."
    } ]
  }, {
    "tStartMs": 1902750,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "It must be really hard\nputting out a battery fire"
    } ]
  }, {
    "tStartMs": 1905480,
    "dDurationMs": 1886,
    "segs": [ {
      "utf8": "if it really has everything that it needs."
    } ]
  }, {
    "tStartMs": 1907366,
    "dDurationMs": 874,
    "segs": [ {
      "utf8": "- Yeah, exactly."
    } ]
  }, {
    "tStartMs": 1908240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So you can still put the blanket"
    } ]
  }, {
    "tStartMs": 1910580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and stop the oxygen from arriving,"
    } ]
  }, {
    "tStartMs": 1912320,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but you will not, the\nfire will not go to zero."
    } ]
  }, {
    "tStartMs": 1914570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It will still, it will be smaller,"
    } ]
  }, {
    "tStartMs": 1916160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "but it will still be there."
    } ]
  }, {
    "tStartMs": 1917300,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "And then with water,"
    } ]
  }, {
    "tStartMs": 1918410,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "yeah, water has the\nability to take heat away,"
    } ]
  }, {
    "tStartMs": 1920570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so it is possible to take the heat away"
    } ]
  }, {
    "tStartMs": 1922550,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "from the battery with water."
    } ]
  }, {
    "tStartMs": 1923810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The best thing is to put\nand immerse the battery"
    } ]
  }, {
    "tStartMs": 1925820,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "into a bath of water."
    } ]
  }, {
    "tStartMs": 1927980,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1928813,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "- It's brutal."
    } ]
  }, {
    "tStartMs": 1930050,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "You can do it with one\nbattery, with 10 batteries,"
    } ]
  }, {
    "tStartMs": 1932317,
    "dDurationMs": 1363,
    "segs": [ {
      "utf8": "with 15 batteries,"
    } ]
  }, {
    "tStartMs": 1933680,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but when you have very\nlarge packs of batteries"
    } ]
  }, {
    "tStartMs": 1936500,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "with thousands of batteries,"
    } ]
  }, {
    "tStartMs": 1937640,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "you cannot physically\nput that under water."
    } ]
  }, {
    "tStartMs": 1940550,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Yeah, one thing that is\npopping up recently as a threat"
    } ]
  }, {
    "tStartMs": 1943100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to cities is electric car fires."
    } ]
  }, {
    "tStartMs": 1946280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Guillermo] Well, we\nknow a lot of water works."
    } ]
  }, {
    "tStartMs": 1948050,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Yeah, well, if there's a water source"
    } ]
  }, {
    "tStartMs": 1949910,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "nearby, I guess, yeah."
    } ]
  }, {
    "tStartMs": 1951260,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- Yeah, I mean, this is what they do"
    } ]
  }, {
    "tStartMs": 1952550,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "in some countries around the world."
    } ]
  }, {
    "tStartMs": 1954080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They have a truck, a specialist truck"
    } ]
  }, {
    "tStartMs": 1956480,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "full of water, and you just take the car"
    } ]
  }, {
    "tStartMs": 1958580,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that has been involved in electric fire"
    } ]
  }, {
    "tStartMs": 1960110,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and they dump it into it."
    } ]
  }, {
    "tStartMs": 1961460,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- No way.\n- Yeah, they do."
    } ]
  }, {
    "tStartMs": 1962900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But, and actually it works."
    } ]
  }, {
    "tStartMs": 1964940,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "- [Derek] So, how dangerous is it really?"
    } ]
  }, {
    "tStartMs": 1967970,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- It's very rare."
    } ]
  }, {
    "tStartMs": 1969200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Every million batteries, there is a fire."
    } ]
  }, {
    "tStartMs": 1971000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay.\n- Right."
    } ]
  }, {
    "tStartMs": 1971833,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "So that's very safe, that in the standards"
    } ]
  }, {
    "tStartMs": 1973610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of engineering, that's like,\noh, you have a good system."
    } ]
  }, {
    "tStartMs": 1975440,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "One out of a million, that's fine."
    } ]
  }, {
    "tStartMs": 1977330,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But batteries are everywhere."
    } ]
  }, {
    "tStartMs": 1979190,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "We don't even think about it."
    } ]
  }, {
    "tStartMs": 1981710,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So within our lifetimes, we\nare going to reach a point"
    } ]
  }, {
    "tStartMs": 1984890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "where we would have been exposed"
    } ]
  }, {
    "tStartMs": 1986540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to more than a million batteries,"
    } ]
  }, {
    "tStartMs": 1987950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so we would be all of us experiencing"
    } ]
  }, {
    "tStartMs": 1990020,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "a fire of a battery."
    } ]
  }, {
    "tStartMs": 1991520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- With billions of\nbatteries in circulation,"
    } ]
  }, {
    "tStartMs": 1993770,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "even rare failures become inevitable."
    } ]
  }, {
    "tStartMs": 1997820,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Meanwhile, demand is skyrocketing."
    } ]
  }, {
    "tStartMs": 2000280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "By 2030, we're projected to need"
    } ]
  }, {
    "tStartMs": 2002080,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "over 17 million tons of\nbattery grade materials,"
    } ]
  }, {
    "tStartMs": 2005860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and making lithium-ion\nbatteries comes at a cost."
    } ]
  }, {
    "tStartMs": 2008800,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Lithium only makes up"
    } ]
  }, {
    "tStartMs": 2009850,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "around 20 parts per\nmillion of Earth's crust."
    } ]
  }, {
    "tStartMs": 2012400,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "It's expensive and water\nintensive to extract,"
    } ]
  }, {
    "tStartMs": 2015430,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and 70% of cobalt, another key ingredient"
    } ]
  }, {
    "tStartMs": 2018160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "in many lithium-ion designs"
    } ]
  }, {
    "tStartMs": 2019900,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "comes from the Democratic\nRepublic of Congo,"
    } ]
  }, {
    "tStartMs": 2022240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "much of it mined under hazardous,"
    } ]
  }, {
    "tStartMs": 2023800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "often exploitative conditions."
    } ]
  }, {
    "tStartMs": 2025960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "We need more batteries\nand we need them fast."
    } ]
  }, {
    "tStartMs": 2028480,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "We can't just rely on lithium alone."
    } ]
  }, {
    "tStartMs": 2031150,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- So it's not like lithium's\nas good as we're gonna get."
    } ]
  }, {
    "tStartMs": 2033370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Like that we're gonna get much better"
    } ]
  }, {
    "tStartMs": 2035080,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "batteries in the future."
    } ]
  }, {
    "tStartMs": 2036370,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "If our priorities are about"
    } ]
  }, {
    "tStartMs": 2038530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "saving the planet from\nrunaway climate change,"
    } ]
  }, {
    "tStartMs": 2041350,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "we need to have massive\nscale energy storage system"
    } ]
  }, {
    "tStartMs": 2044020,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and electrify almost\neverything else that we do."
    } ]
  }, {
    "tStartMs": 2047620,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- The hunt is still on\nfor safer batteries,"
    } ]
  }, {
    "tStartMs": 2050650,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "for cheaper ones, ones that last longer,"
    } ]
  }, {
    "tStartMs": 2052960,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "charge faster, and ones\nthat store far more energy."
    } ]
  }, {
    "tStartMs": 2056140,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The lithium-ion battery changed the world,"
    } ]
  }, {
    "tStartMs": 2058840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but the future of energy storage"
    } ]
  }, {
    "tStartMs": 2060460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "won't be about just\nconquering one element,"
    } ]
  }, {
    "tStartMs": 2063280,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "it'll be about mastering many."
    } ]
  }, {
    "tStartMs": 2067597,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "(whooshing)"
    } ]
  } ]
}
