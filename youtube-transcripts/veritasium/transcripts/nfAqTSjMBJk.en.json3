{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 60,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- You are not looking at a yellow ball."
    } ]
  }, {
    "tStartMs": 3270,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Your brain might think you're\nlooking at a yellow ball,"
    } ]
  }, {
    "tStartMs": 6090,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "but look closer."
    } ]
  }, {
    "tStartMs": 7830,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The screen you're watching this\non displays color using only"
    } ]
  }, {
    "tStartMs": 11250,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "red, green, and blue subpixels."
    } ]
  }, {
    "tStartMs": 13860,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The yellow your brain thinks\nit's seeing is actually"
    } ]
  }, {
    "tStartMs": 16440,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "a mix of red and green light."
    } ]
  }, {
    "tStartMs": 19050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The camera I'm talking to\nright now has a sensor composed"
    } ]
  }, {
    "tStartMs": 21750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of red, green, and\nblue-sensitive photosites."
    } ]
  }, {
    "tStartMs": 24420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Again, no yellow."
    } ]
  }, {
    "tStartMs": 27150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Of course, I have the\nball here in my hand,"
    } ]
  }, {
    "tStartMs": 29820,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "so I am looking at a yellow ball,"
    } ]
  }, {
    "tStartMs": 33390,
    "dDurationMs": 984,
    "segs": [ {
      "utf8": "or am I?"
    } ]
  }, {
    "tStartMs": 34374,
    "dDurationMs": 1056,
    "segs": [ {
      "utf8": "(light mysterious music)"
    } ]
  }, {
    "tStartMs": 35430,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "After all my eyes aren't so\ndifferent from that camera."
    } ]
  }, {
    "tStartMs": 39030,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The human retina only has\ncone cells sensitive to red,"
    } ]
  }, {
    "tStartMs": 42420,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "green, or blue wavelengths of light."
    } ]
  }, {
    "tStartMs": 44970,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "To perceive other colors, we\nhave to integrate the inputs"
    } ]
  }, {
    "tStartMs": 48330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "from those three cone types."
    } ]
  }, {
    "tStartMs": 50580,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "When yellow light enters my\neye, it stimulates my red"
    } ]
  }, {
    "tStartMs": 54270,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and green-sensitive cone cells,"
    } ]
  }, {
    "tStartMs": 56400,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "although not as much as pure\nred, or green light would."
    } ]
  }, {
    "tStartMs": 60120,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "With red and green-sensitive\ncones equally excited,"
    } ]
  }, {
    "tStartMs": 63510,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "my brain tells me I'm looking at yellow."
    } ]
  }, {
    "tStartMs": 66930,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is how our technology, our cameras,"
    } ]
  }, {
    "tStartMs": 68910,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and screens, and projectors\ncan trick our brains"
    } ]
  }, {
    "tStartMs": 71610,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "into seeing a whole rainbow of colors"
    } ]
  }, {
    "tStartMs": 74400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "using just three wavelengths of light"
    } ]
  }, {
    "tStartMs": 76710,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "by triggering our three\ndifferent types of cone cells"
    } ]
  }, {
    "tStartMs": 79470,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "in different proportions."
    } ]
  }, {
    "tStartMs": 82200,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So is the ball really yellow?"
    } ]
  }, {
    "tStartMs": 85470,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "What does yellow even mean?"
    } ]
  }, {
    "tStartMs": 88230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "A lot of people would say that color is"
    } ]
  }, {
    "tStartMs": 90000,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the wavelengths of light\nthat an object reflects."
    } ]
  }, {
    "tStartMs": 92730,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "In other words, like Aristotle thought,"
    } ]
  }, {
    "tStartMs": 94440,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "color is a property of the object."
    } ]
  }, {
    "tStartMs": 97170,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But looking at the same ball on a screen,"
    } ]
  }, {
    "tStartMs": 99720,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "your eyes only sensed red and green light,"
    } ]
  }, {
    "tStartMs": 102150,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "yet your brain still\nperceived it as yellow."
    } ]
  }, {
    "tStartMs": 105720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So it's also possible,\nlike Galileo believed,"
    } ]
  }, {
    "tStartMs": 108390,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that color isn't a property\nof an object at all,"
    } ]
  }, {
    "tStartMs": 111150,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "but a phenomenon of the mind instead."
    } ]
  }, {
    "tStartMs": 115110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But whose mind?"
    } ]
  }, {
    "tStartMs": 116640,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Because we aren't the only animals"
    } ]
  }, {
    "tStartMs": 118740,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that can see the world in color."
    } ]
  }, {
    "tStartMs": 120900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- We oftentimes don't really think about"
    } ]
  }, {
    "tStartMs": 123060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "how other animals see color."
    } ]
  }, {
    "tStartMs": 124980,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So for example, we buy\nour dogs bright red,"
    } ]
  }, {
    "tStartMs": 128010,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "or orange toys that are only\nbright red, or orange for us,"
    } ]
  }, {
    "tStartMs": 131580,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and not for them, because\nthey can't see orange,"
    } ]
  }, {
    "tStartMs": 133860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "or red as being distinct from green."
    } ]
  }, {
    "tStartMs": 136080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] So maybe we should\nstart taking in the world"
    } ]
  }, {
    "tStartMs": 138030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "from more than just the human perspective."
    } ]
  }, {
    "tStartMs": 140490,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Doing that might just\nteach us why color vision"
    } ]
  }, {
    "tStartMs": 142740,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "evolved in the first place."
    } ]
  }, {
    "tStartMs": 145500,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- We're actually towards"
    } ]
  }, {
    "tStartMs": 147030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the lower end of the spectrum, honestly."
    } ]
  }, {
    "tStartMs": 149520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We're a step up from our\nhousehold pets, maybe,"
    } ]
  }, {
    "tStartMs": 152880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "if they're cats, or dogs,"
    } ]
  }, {
    "tStartMs": 154500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but not nearly as good as\nmany animal groups out there,"
    } ]
  }, {
    "tStartMs": 158100,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "butterflies, birds, fish,\nlizards, jumping spiders."
    } ]
  }, {
    "tStartMs": 162900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Jumping spiders are harmless\ncreatures, actually."
    } ]
  }, {
    "tStartMs": 165300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "They don't ever really\nget big enough to pose"
    } ]
  }, {
    "tStartMs": 167040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "much of a threat to humans."
    } ]
  }, {
    "tStartMs": 168390,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Of course, if you were a small insect,"
    } ]
  }, {
    "tStartMs": 170130,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "yes, you would absolutely\nneed to be afraid"
    } ]
  }, {
    "tStartMs": 172200,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of a jumping spider."
    } ]
  }, {
    "tStartMs": 173760,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Lisa] They'll take\ndown prey that's sometimes"
    } ]
  }, {
    "tStartMs": 175350,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "like two, or three times\ntheir own body size."
    } ]
  }, {
    "tStartMs": 178980,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- The Chinese word for jumping\nspider translates literally"
    } ]
  }, {
    "tStartMs": 181830,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to fly tiger, and that's the\nway I like to think about them"
    } ]
  }, {
    "tStartMs": 184830,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "is the kind of small\ncats of the undergrowth."
    } ]
  }, {
    "tStartMs": 188370,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Jumping spiders are everywhere."
    } ]
  }, {
    "tStartMs": 190110,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "They're in your backyard."
    } ]
  }, {
    "tStartMs": 191130,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They're probably in your kitchen."
    } ]
  }, {
    "tStartMs": 192930,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- There are about 6,000 species\nof jumping spiders known."
    } ]
  }, {
    "tStartMs": 198090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Some are sort of furry,\nsome are sort of shiny,"
    } ]
  }, {
    "tStartMs": 200640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "striped, spotted, red, green, blue."
    } ]
  }, {
    "tStartMs": 204000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Pretty much anything you can imagine."
    } ]
  }, {
    "tStartMs": 205620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It's like every one is\na little work of art."
    } ]
  }, {
    "tStartMs": 208080,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- As a group, spiders aren't\nknown for their vision."
    } ]
  }, {
    "tStartMs": 211170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I mean, most species are nocturnal,"
    } ]
  }, {
    "tStartMs": 212970,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and for many, their webs act\nas a sort of extra sense organ,"
    } ]
  }, {
    "tStartMs": 217020,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "so they just don't need to see that well."
    } ]
  }, {
    "tStartMs": 220950,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "But jumping spiders, as\nactive daytime hunters,"
    } ]
  }, {
    "tStartMs": 224700,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "well, they're different."
    } ]
  }, {
    "tStartMs": 225780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Not only do they have great eyesight,"
    } ]
  }, {
    "tStartMs": 227940,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "but different species have\ndifferent forms of color vision."
    } ]
  }, {
    "tStartMs": 231990,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "Look at those eyes."
    } ]
  }, {
    "tStartMs": 234150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Jumping spider eyes are fascinating,"
    } ]
  }, {
    "tStartMs": 236490,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and when I say eyes, I mean eight eyes."
    } ]
  }, {
    "tStartMs": 239550,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Jumping spiders split up\nthings like motion detection"
    } ]
  }, {
    "tStartMs": 242550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and light sensitivity to some eyes,"
    } ]
  }, {
    "tStartMs": 244980,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and then color vision and fine\ndetail vision into others."
    } ]
  }, {
    "tStartMs": 248760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The pair of eyes that are\nperhaps the most fascinating,"
    } ]
  }, {
    "tStartMs": 251130,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "or most unusual are what\nwe call the principal eyes,"
    } ]
  }, {
    "tStartMs": 254340,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and those are the really big\neyes in the front of the face"
    } ]
  }, {
    "tStartMs": 257640,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that make jumping spiders\nlook a little cute"
    } ]
  }, {
    "tStartMs": 260190,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "if you're willing to say\na spider looks cute ever,"
    } ]
  }, {
    "tStartMs": 263670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and those are built unlike any other eye"
    } ]
  }, {
    "tStartMs": 265800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "in the animal kingdom."
    } ]
  }, {
    "tStartMs": 267480,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Derek] It turns out"
    } ]
  }, {
    "tStartMs": 268440,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the way jumping spiders perceive\ncolor has everything to do"
    } ]
  }, {
    "tStartMs": 272070,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "with the anatomy of those principal eyes."
    } ]
  }, {
    "tStartMs": 275340,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Nathan] They're really actually built"
    } ]
  }, {
    "tStartMs": 276570,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "a lot like a Galilean\ntelescope, or binoculars."
    } ]
  }, {
    "tStartMs": 281010,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "That big lens that you see from\nthe outside of the animal is"
    } ]
  }, {
    "tStartMs": 284400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "one of two lenses in these eyes,"
    } ]
  }, {
    "tStartMs": 286860,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and in between those two lenses is"
    } ]
  }, {
    "tStartMs": 289110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "a long fluid-filled tube."
    } ]
  }, {
    "tStartMs": 291450,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "At the end of that fluid-filled\ntube is a second lens,"
    } ]
  }, {
    "tStartMs": 295350,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and what that lens does is\nit magnifies the image that"
    } ]
  }, {
    "tStartMs": 298740,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "that first lens projects\ndown that long tube,"
    } ]
  }, {
    "tStartMs": 301830,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "and in that way, it increases\nthe ability to see detail"
    } ]
  }, {
    "tStartMs": 305760,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "by the retina that sits right below it."
    } ]
  }, {
    "tStartMs": 308550,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] And when it\ncomes to seeing detail,"
    } ]
  }, {
    "tStartMs": 310590,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it's hard to beat a jumping spider."
    } ]
  }, {
    "tStartMs": 313650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- For most animals, the bigger the eye,"
    } ]
  }, {
    "tStartMs": 315300,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the better it functions."
    } ]
  }, {
    "tStartMs": 317190,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Jumping spiders absolutely\nbreak this rule."
    } ]
  }, {
    "tStartMs": 320790,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The secondary eyes can see the world"
    } ]
  }, {
    "tStartMs": 323520,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "about as well as the absolute\nbest insect eyes out there,"
    } ]
  }, {
    "tStartMs": 327990,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "better than the world's\nbiggest dragonflies,"
    } ]
  }, {
    "tStartMs": 330360,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "whose entire head is consumed by an eye."
    } ]
  }, {
    "tStartMs": 333990,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The principal eyes,"
    } ]
  }, {
    "tStartMs": 336150,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they can actually see pattern in the world"
    } ]
  }, {
    "tStartMs": 338460,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "better than a lap dog,"
    } ]
  }, {
    "tStartMs": 340560,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "a house cat, an elephant,"
    } ]
  }, {
    "tStartMs": 344280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and nearly as good as\nthe sharp-sighted pigeon,"
    } ]
  }, {
    "tStartMs": 347970,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "but it's a very narrow slice\nof the world that they can see."
    } ]
  }, {
    "tStartMs": 351480,
    "dDurationMs": 4173,
    "segs": [ {
      "utf8": "It's about like your thumb\nheld at arm's length."
    } ]
  }, {
    "tStartMs": 356490,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- [Derek] And it's only in\nthat narrow slice of the world"
    } ]
  }, {
    "tStartMs": 359430,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "that jumping spiders can\nsee fine detail and color."
    } ]
  }, {
    "tStartMs": 363570,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- So the jumping spider's\nsecondary eyes give them"
    } ]
  }, {
    "tStartMs": 367350,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "a full 360-degree view of the world."
    } ]
  }, {
    "tStartMs": 371730,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now, imagine most of\nthat's in black and white."
    } ]
  }, {
    "tStartMs": 374640,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "When you see something move,\nyou can swivel to look at it."
    } ]
  }, {
    "tStartMs": 378750,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And now, anything that's\nreally of curiosity to you,"
    } ]
  }, {
    "tStartMs": 382950,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "you can add to this world\nof black and white vision"
    } ]
  }, {
    "tStartMs": 387960,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "fine detail and color."
    } ]
  }, {
    "tStartMs": 391260,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But you can only do it moment by moment."
    } ]
  }, {
    "tStartMs": 393930,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "So you're really kind of\npainting additional details"
    } ]
  }, {
    "tStartMs": 397920,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "about color and pattern that\nyou couldn't see otherwise."
    } ]
  }, {
    "tStartMs": 402660,
    "dDurationMs": 3127,
    "segs": [ {
      "utf8": "It's a wild world to try\nto put yourself into."
    } ]
  }, {
    "tStartMs": 405787,
    "dDurationMs": 953,
    "segs": [ {
      "utf8": "(bee buzzing)"
    } ]
  }, {
    "tStartMs": 406740,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- As they sweep their\nprincipal eyes across a scene,"
    } ]
  }, {
    "tStartMs": 409980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "some species of jumping spiders are adding"
    } ]
  }, {
    "tStartMs": 412140,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "a lot more color information\nto their world than others."
    } ]
  }, {
    "tStartMs": 416970,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Most jumping spiders, including\nthis one, are dichromats,"
    } ]
  }, {
    "tStartMs": 420270,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "meaning they have two types\nof color-sensitive cone cells"
    } ]
  }, {
    "tStartMs": 423150,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "in their retinas, just like\ndogs and most other mammals."
    } ]
  }, {
    "tStartMs": 426810,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Nathan] And by comparing\nthose two kinds of cells"
    } ]
  }, {
    "tStartMs": 429120,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and how they respond to\nlight in the environment,"
    } ]
  }, {
    "tStartMs": 431700,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "they get a coarse understanding of color."
    } ]
  }, {
    "tStartMs": 434070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "They can tell the difference between UV,"
    } ]
  }, {
    "tStartMs": 436650,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "violet, blue, and green."
    } ]
  }, {
    "tStartMs": 439050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- But some types of jumping\nspiders are trichromats"
    } ]
  }, {
    "tStartMs": 441990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "with three types of cones, like humans,"
    } ]
  }, {
    "tStartMs": 444540,
    "dDurationMs": 3557,
    "segs": [ {
      "utf8": "and other are tetrachromats, like birds."
    } ]
  }, {
    "tStartMs": 448097,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 449310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The weird thing is all these species"
    } ]
  }, {
    "tStartMs": 451710,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "with expanded color vision"
    } ]
  }, {
    "tStartMs": 453360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "aren't necessarily close relatives."
    } ]
  }, {
    "tStartMs": 455880,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- In jumping spiders,\nwe have huge variation,"
    } ]
  }, {
    "tStartMs": 458670,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "even from closely related groups,"
    } ]
  }, {
    "tStartMs": 460500,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "in how well they're able\nto see color in the world."
    } ]
  }, {
    "tStartMs": 463080,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Jumping spiders are\nreinventing, in some ways,"
    } ]
  }, {
    "tStartMs": 466770,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "the ability to see color\nover and over again"
    } ]
  }, {
    "tStartMs": 469020,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in different ways."
    } ]
  }, {
    "tStartMs": 470520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- That makes jumping\nspiders pretty special."
    } ]
  }, {
    "tStartMs": 473310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I mean, consider primates."
    } ]
  }, {
    "tStartMs": 475260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Old World monkeys, apes,"
    } ]
  }, {
    "tStartMs": 476670,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and humans all have\ntrichromatic color vision,"
    } ]
  }, {
    "tStartMs": 479850,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but we also share a common ancestor."
    } ]
  }, {
    "tStartMs": 482430,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So our color vision\nprobably evolved only once,"
    } ]
  }, {
    "tStartMs": 485550,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and then it stuck around."
    } ]
  }, {
    "tStartMs": 487710,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "This is where jumping\nspiders really stand out."
    } ]
  }, {
    "tStartMs": 490890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The ability to see red, for example,"
    } ]
  }, {
    "tStartMs": 493440,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "has evolved several\ntimes in jumping spiders."
    } ]
  }, {
    "tStartMs": 496920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Researchers know that,"
    } ]
  }, {
    "tStartMs": 498120,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "because they've figured out"
    } ]
  }, {
    "tStartMs": 499080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "how different groups are related,"
    } ]
  }, {
    "tStartMs": 501450,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and by they, I mostly mean"
    } ]
  }, {
    "tStartMs": 503280,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "jumping spider fanatic Wayne Maddison."
    } ]
  }, {
    "tStartMs": 506520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Oh my gosh, Havaika."
    } ]
  }, {
    "tStartMs": 509580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Fantastic!"
    } ]
  }, {
    "tStartMs": 511680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Beautiful male."
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Ah, it's been, it's been\n30 years since I've seen"
    } ]
  }, {
    "tStartMs": 515880,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "a live Havaika."
    } ]
  }, {
    "tStartMs": 517710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Megan] He is absolutely\nMr. Jumping Spider."
    } ]
  }, {
    "tStartMs": 520320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "His expertise really is in\njumping spider taxonomy."
    } ]
  }, {
    "tStartMs": 525570,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- I work on the evolutionary\ntree of jumping spiders."
    } ]
  }, {
    "tStartMs": 529440,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The evolutionary tree of life is basically"
    } ]
  }, {
    "tStartMs": 532350,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "the pathway of genetic\ndescent that links all of us."
    } ]
  }, {
    "tStartMs": 536760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Derek] The position\nof different species"
    } ]
  }, {
    "tStartMs": 538590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "on this evolutionary tree\ncan tell us how they ended up"
    } ]
  }, {
    "tStartMs": 541800,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "with the traits they have."
    } ]
  }, {
    "tStartMs": 543810,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Like if most jumping\nspiders don't see red,"
    } ]
  }, {
    "tStartMs": 547020,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "but two species on two very\ndifferent parts of the tree do,"
    } ]
  }, {
    "tStartMs": 551190,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "chances are that those two species"
    } ]
  }, {
    "tStartMs": 553350,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "evolved those abilities independently."
    } ]
  }, {
    "tStartMs": 557310,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- In which case, then we can\nstart to ask questions like"
    } ]
  }, {
    "tStartMs": 561270,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "what's driving that evolution?"
    } ]
  }, {
    "tStartMs": 562560,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Do they have similar ecologies?"
    } ]
  }, {
    "tStartMs": 564030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Do they hunt similar prey?"
    } ]
  }, {
    "tStartMs": 566220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And try to really understand"
    } ]
  }, {
    "tStartMs": 568440,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "what selective forces are leading"
    } ]
  }, {
    "tStartMs": 570990,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to these expanded color vision systems."
    } ]
  }, {
    "tStartMs": 574440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- It might help them find food,"
    } ]
  }, {
    "tStartMs": 576000,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "or discriminate tasty prey\nfrom prey that can harm them."
    } ]
  }, {
    "tStartMs": 579990,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- [Nathan] Because, of course,"
    } ]
  }, {
    "tStartMs": 580920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "lots of small insects\nare brightly colored,"
    } ]
  }, {
    "tStartMs": 583080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and some of them are\nusing those bright colors"
    } ]
  }, {
    "tStartMs": 585060,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to advertise that they're toxic."
    } ]
  }, {
    "tStartMs": 588330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Derek] Another\npossibility is that seeing"
    } ]
  }, {
    "tStartMs": 590340,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "a richer world of color\nmight help animals,"
    } ]
  }, {
    "tStartMs": 592890,
    "dDurationMs": 3843,
    "segs": [ {
      "utf8": "from lizards to spiders,\nchoose better mates."
    } ]
  }, {
    "tStartMs": 597630,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "To test these ideas, the\nresearchers needed to know"
    } ]
  }, {
    "tStartMs": 600810,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "which of the 6,000 species\nof jumping spiders had"
    } ]
  }, {
    "tStartMs": 603900,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "expanded color vision and which didn't,"
    } ]
  }, {
    "tStartMs": 607110,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and outside of a few well-studied species,"
    } ]
  }, {
    "tStartMs": 609750,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "no one really knew."
    } ]
  }, {
    "tStartMs": 611820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So the team set out to collect spiders"
    } ]
  }, {
    "tStartMs": 613800,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "from every major branch of the\njumping spider family tree."
    } ]
  }, {
    "tStartMs": 618450,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- One of our first things is\njust prioritizing where to go"
    } ]
  }, {
    "tStartMs": 621270,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and what to look for."
    } ]
  }, {
    "tStartMs": 622500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And so, it's a lot of\nsampling in a lot of places."
    } ]
  }, {
    "tStartMs": 625140,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Let's see who lives here."
    } ]
  }, {
    "tStartMs": 627510,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] It's kind of like \"Pokemon GO,\""
    } ]
  }, {
    "tStartMs": 629640,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "except the Pokemon are real,"
    } ]
  }, {
    "tStartMs": 631650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "they're smaller than\nyour pinky fingernail,"
    } ]
  }, {
    "tStartMs": 634110,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "and they're really good at hiding."
    } ]
  }, {
    "tStartMs": 637290,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Some jumping spiders have evolved"
    } ]
  }, {
    "tStartMs": 639240,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "to be really fine-tuned\nto a particular situation."
    } ]
  }, {
    "tStartMs": 642450,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "So for example,"
    } ]
  }, {
    "tStartMs": 643320,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "there are termite-eating\nspecialist jumping spiders"
    } ]
  }, {
    "tStartMs": 646890,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that you're only gonna\nfind around termites."
    } ]
  }, {
    "tStartMs": 650340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "There was this one\nspecies that we only found"
    } ]
  }, {
    "tStartMs": 652860,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "in piles of bones in South Africa."
    } ]
  }, {
    "tStartMs": 656520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Who knows what it was doing there,"
    } ]
  }, {
    "tStartMs": 658530,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but we quickly learned that"
    } ]
  }, {
    "tStartMs": 660660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that was the only place in the environment"
    } ]
  }, {
    "tStartMs": 662340,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "we were gonna find it."
    } ]
  }, {
    "tStartMs": 663180,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And so, that's part of the fun of it."
    } ]
  }, {
    "tStartMs": 664470,
    "dDurationMs": 2444,
    "segs": [ {
      "utf8": "I feel like it's a bit of\na treasure hunt, really."
    } ]
  }, {
    "tStartMs": 666914,
    "dDurationMs": 2176,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 669090,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- With no proverbial stone left unturned,"
    } ]
  }, {
    "tStartMs": 672150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "the team returns to their\nlabs with hundreds of spiders"
    } ]
  }, {
    "tStartMs": 675480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "representing many different species."
    } ]
  }, {
    "tStartMs": 677940,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They want to figure out which species have"
    } ]
  }, {
    "tStartMs": 680190,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "expanded color vision, how\neach species does it, and why."
    } ]
  }, {
    "tStartMs": 685230,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It's actually a hard question"
    } ]
  }, {
    "tStartMs": 686940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to tell how animals can see color."
    } ]
  }, {
    "tStartMs": 688980,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "We can't just connect our\nbrains to see what they see."
    } ]
  }, {
    "tStartMs": 692070,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "So how do we do it?"
    } ]
  }, {
    "tStartMs": 694530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Nathan] We begin by using a technique"
    } ]
  }, {
    "tStartMs": 696870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "called microspectrophotometry."
    } ]
  }, {
    "tStartMs": 699420,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "It's a really long word."
    } ]
  }, {
    "tStartMs": 700950,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "What it simply means is a\nmicroscope paired with a device"
    } ]
  }, {
    "tStartMs": 706290,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that measures different\nwavelengths of light,"
    } ]
  }, {
    "tStartMs": 709080,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "a spectrophotometer."
    } ]
  }, {
    "tStartMs": 710970,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- [Derek] The researchers\ntake ultra-thin slices"
    } ]
  }, {
    "tStartMs": 713550,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "of jumping spider retinas,"
    } ]
  }, {
    "tStartMs": 715050,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and then they measure the\nwavelengths of light absorbed"
    } ]
  }, {
    "tStartMs": 717540,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "by individual cone cells."
    } ]
  }, {
    "tStartMs": 720090,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "With enough of these measurements,"
    } ]
  }, {
    "tStartMs": 721920,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they can tell if a species is a dichromat,"
    } ]
  }, {
    "tStartMs": 724680,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "trichromat, or tetrachromat,"
    } ]
  }, {
    "tStartMs": 727230,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and what wavelengths of light"
    } ]
  }, {
    "tStartMs": 728820,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "its cells are best at detecting."
    } ]
  }, {
    "tStartMs": 731550,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But that's not the whole story."
    } ]
  }, {
    "tStartMs": 734400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- Having that knowledge of\nwhat's in the retina tells us"
    } ]
  }, {
    "tStartMs": 737760,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "what is, or isn't possible\nfor these animals to see,"
    } ]
  }, {
    "tStartMs": 740910,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but it doesn't actually\ntell us what they do see,"
    } ]
  }, {
    "tStartMs": 743310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "or how they might use that."
    } ]
  }, {
    "tStartMs": 744840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And so, the gold standard for establishing"
    } ]
  }, {
    "tStartMs": 748200,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "that an animal can see color\nis to do so behaviorally."
    } ]
  }, {
    "tStartMs": 752640,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- In other words, we somehow\nneed to ask the spiders"
    } ]
  }, {
    "tStartMs": 755820,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "what they can see and then\nunderstand their answers."
    } ]
  }, {
    "tStartMs": 760110,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Figuring out what's going on"
    } ]
  }, {
    "tStartMs": 761250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "inside a spider's mind is difficult."
    } ]
  }, {
    "tStartMs": 763530,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "It's no surprise that it takes"
    } ]
  }, {
    "tStartMs": 764670,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "a group of expert zoologists to do so."
    } ]
  }, {
    "tStartMs": 767550,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But our own minds can\nbe just as complicated,"
    } ]
  }, {
    "tStartMs": 770130,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "yet we rarely talk with\nmental health experts"
    } ]
  }, {
    "tStartMs": 772410,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to help us interpret our\nthoughts and emotions."
    } ]
  }, {
    "tStartMs": 775110,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Whether you're feeling depressed, anxious,"
    } ]
  }, {
    "tStartMs": 776970,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or are just stressed and\nwant someone to talk to,"
    } ]
  }, {
    "tStartMs": 779310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "a therapist lets you see things"
    } ]
  }, {
    "tStartMs": 780930,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "from a different perspective,"
    } ]
  }, {
    "tStartMs": 782310,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and that's where today's\nsponsor, BetterHelp, comes in."
    } ]
  }, {
    "tStartMs": 785280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I know finding a therapist\nyou're comfortable around"
    } ]
  }, {
    "tStartMs": 787620,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "can be intimidating, especially\nif you're only limited"
    } ]
  }, {
    "tStartMs": 790530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to the options in your city,"
    } ]
  }, {
    "tStartMs": 792180,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but BetterHelp lets you get around this,"
    } ]
  }, {
    "tStartMs": 793890,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "because it's an online platform,"
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and they make it really easy to connect"
    } ]
  }, {
    "tStartMs": 797100,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "with a professional therapist,"
    } ]
  }, {
    "tStartMs": 798660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "who can help you work through\nwhatever you're facing."
    } ]
  }, {
    "tStartMs": 801390,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "It's easy to sign up."
    } ]
  }, {
    "tStartMs": 802440,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "There's a link in the description,"
    } ]
  }, {
    "tStartMs": 803670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "betterhelp.com/veritasium,"
    } ]
  }, {
    "tStartMs": 805800,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and after answering a few questions,"
    } ]
  }, {
    "tStartMs": 807750,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "BetterHelp will match you"
    } ]
  }, {
    "tStartMs": 808740,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "with one of their more\nthan 30,000 therapists."
    } ]
  }, {
    "tStartMs": 812040,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Each therapist is licensed,\nhas a master's, or a PhD,"
    } ]
  }, {
    "tStartMs": 814800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and has spent over three years"
    } ]
  }, {
    "tStartMs": 816420,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and over 1,000 hours with people."
    } ]
  }, {
    "tStartMs": 818640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And if you don't click\nwith your first therapist,"
    } ]
  }, {
    "tStartMs": 820320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "you can simply switch\nto a new one for free"
    } ]
  }, {
    "tStartMs": 822750,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "without things getting awkward."
    } ]
  }, {
    "tStartMs": 824310,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "If you feel like you'd benefit\nfrom talking to someone,"
    } ]
  }, {
    "tStartMs": 826230,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "getting advice, feedback, and help,"
    } ]
  }, {
    "tStartMs": 828330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "then visit betterhelp.com/veritasium\nto get started."
    } ]
  }, {
    "tStartMs": 831330,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Clicking that link both\nhelps support this channel,"
    } ]
  }, {
    "tStartMs": 833700,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but it also gets you 10%\noff your first month."
    } ]
  }, {
    "tStartMs": 836070,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So I wanna thank BetterHelp\nfor sponsoring this video,"
    } ]
  }, {
    "tStartMs": 838560,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and now, back to jumping\nspiders and how they see color."
    } ]
  }, {
    "tStartMs": 841950,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- These animals are particularly motivated"
    } ]
  }, {
    "tStartMs": 844260,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to investigate things that move,"
    } ]
  }, {
    "tStartMs": 846570,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and these responses\ncan be guided by color."
    } ]
  }, {
    "tStartMs": 849660,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Derek] The theory is simple."
    } ]
  }, {
    "tStartMs": 851130,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "You show the spider a\nscreen with a moving shape"
    } ]
  }, {
    "tStartMs": 854340,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that differs from the background in color,"
    } ]
  }, {
    "tStartMs": 856650,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but not in brightness,"
    } ]
  }, {
    "tStartMs": 858540,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and you see if the spider tries to follow."
    } ]
  }, {
    "tStartMs": 861420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Nathan] The problem with\nletting the jumping spider"
    } ]
  }, {
    "tStartMs": 863280,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "actually turn and respond is\nthat they'll absolutely do so,"
    } ]
  }, {
    "tStartMs": 867030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but it changes some of what they see."
    } ]
  }, {
    "tStartMs": 870060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So what we want is to\nreally have some control"
    } ]
  }, {
    "tStartMs": 872730,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "over what the spiders can\nsee at any given moment."
    } ]
  }, {
    "tStartMs": 876000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- So the researchers hold them in place"
    } ]
  }, {
    "tStartMs": 878340,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "with tiny magnets attached to their heads."
    } ]
  }, {
    "tStartMs": 881970,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "- [Nathan] What we do is we\ngive them a ball to stand on."
    } ]
  }, {
    "tStartMs": 885720,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "They actually hold it with their feet,"
    } ]
  }, {
    "tStartMs": 887790,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "and we can monitor how that\nball moves around in their feet"
    } ]
  }, {
    "tStartMs": 892560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to know where they would want to go."
    } ]
  }, {
    "tStartMs": 895260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- If the spider turns\nthe ball to the left,"
    } ]
  }, {
    "tStartMs": 897660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it's probably trying to look to the right"
    } ]
  }, {
    "tStartMs": 899850,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to follow the moving shape,"
    } ]
  }, {
    "tStartMs": 901800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and that's evidence the\nspider can discriminate"
    } ]
  }, {
    "tStartMs": 903900,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "between the colors of the\nshape and the background."
    } ]
  }, {
    "tStartMs": 906641,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(playful music)"
    } ]
  }, {
    "tStartMs": 911400,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Once the team knows which\nspecies can see which colors,"
    } ]
  }, {
    "tStartMs": 914790,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the next question is how do they do it?"
    } ]
  }, {
    "tStartMs": 917670,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "What's different in the DNA\nof these spiders that can see"
    } ]
  }, {
    "tStartMs": 921030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and discriminate more colors?"
    } ]
  }, {
    "tStartMs": 923490,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "If you ask Megan Porter, a\nlot of it comes down to genes"
    } ]
  }, {
    "tStartMs": 926310,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that encode proteins called opsins."
    } ]
  }, {
    "tStartMs": 929640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The way that animals\nachieve color vision is"
    } ]
  }, {
    "tStartMs": 932100,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to have different copies\nof this opsin gene,"
    } ]
  }, {
    "tStartMs": 935340,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "and those variations then\nare what produce proteins"
    } ]
  }, {
    "tStartMs": 939840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that are sensitive to\ndifferent colors of light."
    } ]
  }, {
    "tStartMs": 943140,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The first technique\nthat we generally go to"
    } ]
  }, {
    "tStartMs": 946350,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "with a new species is called\ntranscriptome sequencing,"
    } ]
  }, {
    "tStartMs": 949950,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and this is where we\ncan take the entire head"
    } ]
  }, {
    "tStartMs": 952590,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "of a jumping spider, and\nwe can get the sequences"
    } ]
  }, {
    "tStartMs": 956370,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "for every single gene that\nis expressed in that tissue."
    } ]
  }, {
    "tStartMs": 960900,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Derek] This method gives\nthe researchers an inventory"
    } ]
  }, {
    "tStartMs": 963510,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of all the genes being expressed,"
    } ]
  }, {
    "tStartMs": 965700,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "in other words, all the genes\nthat are copied out of the DNA"
    } ]
  }, {
    "tStartMs": 968970,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and sent to make a protein."
    } ]
  }, {
    "tStartMs": 971250,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Then the team can figure out"
    } ]
  }, {
    "tStartMs": 972720,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "where each of these genes is expressed,"
    } ]
  }, {
    "tStartMs": 975630,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "in which eyes, and in\nwhich parts of the eye."
    } ]
  }, {
    "tStartMs": 979620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- And we do that using"
    } ]
  }, {
    "tStartMs": 981270,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "a fancy technique called\nimmunohistochemistry."
    } ]
  }, {
    "tStartMs": 984660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Derek] The researchers basically create"
    } ]
  }, {
    "tStartMs": 986370,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "glowing molecular tags\nspecific to each protein"
    } ]
  }, {
    "tStartMs": 989700,
    "dDurationMs": 1789,
    "segs": [ {
      "utf8": "they're interested in."
    } ]
  }, {
    "tStartMs": 991489,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "- [Megan] And then looking\nfor which parts glow"
    } ]
  }, {
    "tStartMs": 993510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "in the right color, we can figure out"
    } ]
  }, {
    "tStartMs": 995670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "where each opsin is being expressed,"
    } ]
  }, {
    "tStartMs": 997680,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "where the protein is located."
    } ]
  }, {
    "tStartMs": 1000050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- The team is especially\ninterested in genes"
    } ]
  }, {
    "tStartMs": 1002270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "that are expressed in the\nretinas of the principal eyes."
    } ]
  }, {
    "tStartMs": 1005510,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "These are the genes most\nlikely to be related"
    } ]
  }, {
    "tStartMs": 1007580,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "to changes in color vision."
    } ]
  }, {
    "tStartMs": 1010220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Already, this process of asking"
    } ]
  }, {
    "tStartMs": 1012350,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which species have expanded color vision"
    } ]
  }, {
    "tStartMs": 1014150,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and how they accomplish it has led"
    } ]
  }, {
    "tStartMs": 1016040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to some surprising discoveries."
    } ]
  }, {
    "tStartMs": 1018740,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The researchers already\nknew that the ability to see"
    } ]
  }, {
    "tStartMs": 1021410,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and discriminate more colors\nhad evolved more than once"
    } ]
  }, {
    "tStartMs": 1024050,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "among jumping spiders."
    } ]
  }, {
    "tStartMs": 1025730,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But they hadn't realized"
    } ]
  }, {
    "tStartMs": 1027110,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "just how widespread this ability would be."
    } ]
  }, {
    "tStartMs": 1030890,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "After measuring 45 species\nacross the evolutionary tree,"
    } ]
  }, {
    "tStartMs": 1034820,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "the team has already found"
    } ]
  }, {
    "tStartMs": 1035960,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "as many as 12 independent\nchanges in color vision."
    } ]
  }, {
    "tStartMs": 1040220,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "In evolutionary terms, jumping\nspiders seem to be evolving"
    } ]
  }, {
    "tStartMs": 1043670,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "new expanded forms of\ncolor vision all the time,"
    } ]
  }, {
    "tStartMs": 1047780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and different species have acquired"
    } ]
  }, {
    "tStartMs": 1049490,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "their new visual capabilities\nin very different ways."
    } ]
  }, {
    "tStartMs": 1053210,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Take, for example, the ability to see red."
    } ]
  }, {
    "tStartMs": 1056780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Most jumping spiders\nonly have green-sensitive"
    } ]
  }, {
    "tStartMs": 1059270,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and UV-sensitive photo\npigments in their retinas."
    } ]
  }, {
    "tStartMs": 1062990,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But some species became sensitive to red"
    } ]
  }, {
    "tStartMs": 1065420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "when their green-sensitive opsin gene"
    } ]
  }, {
    "tStartMs": 1067160,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "was accidentally duplicated in the genome,"
    } ]
  }, {
    "tStartMs": 1069710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and the new copy started to evolve,"
    } ]
  }, {
    "tStartMs": 1072320,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "shifting its sensitivity\nto longer wavelengths."
    } ]
  }, {
    "tStartMs": 1076580,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- So in our eyes, that's\nexactly what happened."
    } ]
  }, {
    "tStartMs": 1079190,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "The opsin gene for our\ngreen-sensitive visual pigment"
    } ]
  }, {
    "tStartMs": 1083150,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "was duplicated, and the\nsecond version evolved to be"
    } ]
  }, {
    "tStartMs": 1086870,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "more red-sensitive,"
    } ]
  }, {
    "tStartMs": 1088280,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and we see this happen over\nand over and over again"
    } ]
  }, {
    "tStartMs": 1091340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "in jumping spiders."
    } ]
  }, {
    "tStartMs": 1093170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- But other jumping spiders see red"
    } ]
  }, {
    "tStartMs": 1094970,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "in a totally different way."
    } ]
  }, {
    "tStartMs": 1097460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Rather than evolving new photo pigments,"
    } ]
  }, {
    "tStartMs": 1099770,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "they added an internal filter"
    } ]
  }, {
    "tStartMs": 1101750,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to some of their\ngreen-sensitive cone cells,"
    } ]
  }, {
    "tStartMs": 1104090,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "which cuts out green light,"
    } ]
  }, {
    "tStartMs": 1105650,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and forces those cells to respond"
    } ]
  }, {
    "tStartMs": 1107690,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "only to longer wavelengths, like red."
    } ]
  }, {
    "tStartMs": 1111110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- They can basically\ncreate two kinds of cells"
    } ]
  }, {
    "tStartMs": 1114050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "from the same type of photoreceptor"
    } ]
  }, {
    "tStartMs": 1116270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "simply by using a filter\nin front of some of them"
    } ]
  }, {
    "tStartMs": 1118820,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "and not in front of others."
    } ]
  }, {
    "tStartMs": 1121610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- All this evolutionary innovation"
    } ]
  }, {
    "tStartMs": 1123470,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "makes the original question\neven more intriguing."
    } ]
  }, {
    "tStartMs": 1126800,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Why evolve expanded color\nvision in the first place?"
    } ]
  }, {
    "tStartMs": 1130610,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "That's the question Lisa\nTaylor is trying to answer."
    } ]
  }, {
    "tStartMs": 1134120,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "For a visual predator,\nlike a jumping spider,"
    } ]
  }, {
    "tStartMs": 1136940,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "better color vision could\nmean finding more prey."
    } ]
  }, {
    "tStartMs": 1139910,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "It could also mean avoiding\nprey that might harmful."
    } ]
  }, {
    "tStartMs": 1143780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Lisa] And so, a lot of prey\nin the environment advertise"
    } ]
  }, {
    "tStartMs": 1146120,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "their toxicity with bright colors,"
    } ]
  }, {
    "tStartMs": 1147710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and particularly with\nlong wavelength colors,"
    } ]
  }, {
    "tStartMs": 1149630,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "such as red and orange."
    } ]
  }, {
    "tStartMs": 1151520,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So we're testing the idea that the ability"
    } ]
  }, {
    "tStartMs": 1153590,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to use color vision will help\nthese spiders learn to avoid"
    } ]
  }, {
    "tStartMs": 1156290,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and continue to avoid\nred prey that taste bad."
    } ]
  }, {
    "tStartMs": 1159290,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- [Derek] In this experiment,\nall the prey are termites."
    } ]
  }, {
    "tStartMs": 1162290,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Some have a dab of red\npaint on their backs,"
    } ]
  }, {
    "tStartMs": 1164960,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "and others have a dab of gray,"
    } ]
  }, {
    "tStartMs": 1168170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- And this doesn't affect\ntheir behavior in any way."
    } ]
  }, {
    "tStartMs": 1170120,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "They still move around naturally,"
    } ]
  }, {
    "tStartMs": 1172070,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and the spiders really\nlike to eat termites."
    } ]
  }, {
    "tStartMs": 1173720,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Derek] The red\ntermites also get treated"
    } ]
  }, {
    "tStartMs": 1176270,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "with a compound called Bitrex,"
    } ]
  }, {
    "tStartMs": 1178400,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "which is actually the most\nbitter substance known."
    } ]
  }, {
    "tStartMs": 1182480,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- And yeah, it turns out\nthat the spiders also think"
    } ]
  }, {
    "tStartMs": 1185030,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "it tastes disgusting."
    } ]
  }, {
    "tStartMs": 1186020,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So we can simultaneously"
    } ]
  }, {
    "tStartMs": 1187670,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and independently manipulate\ncolor and palatability."
    } ]
  }, {
    "tStartMs": 1191360,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- In other words, the researchers can make"
    } ]
  }, {
    "tStartMs": 1193160,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "the termites red and\nbitter, gray and tasty,"
    } ]
  }, {
    "tStartMs": 1196850,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "or if they want to mess with the spiders,"
    } ]
  }, {
    "tStartMs": 1199250,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "gray and bitter, or red and tasty."
    } ]
  }, {
    "tStartMs": 1203000,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The first part of the experiment\nis the training phase."
    } ]
  }, {
    "tStartMs": 1206270,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Basically, the spiders get\nto choose from a tiny buffet"
    } ]
  }, {
    "tStartMs": 1209150,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "of termite prey, each one in\nits own little Petri dish."
    } ]
  }, {
    "tStartMs": 1213980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Lisa] In three of the Petri dishes,"
    } ]
  }, {
    "tStartMs": 1215360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "they get a red-painted,\nbitter-tasting termite,"
    } ]
  }, {
    "tStartMs": 1217940,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and then the other three Petri dishes,"
    } ]
  }, {
    "tStartMs": 1219440,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "they get a gray-painted,\nvery tasty termite."
    } ]
  }, {
    "tStartMs": 1223370,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "As they interact with this prey,"
    } ]
  }, {
    "tStartMs": 1224690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they are constantly learning"
    } ]
  }, {
    "tStartMs": 1227000,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and it's constantly being reinforced that"
    } ]
  }, {
    "tStartMs": 1228380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "whenever they attack something red,"
    } ]
  }, {
    "tStartMs": 1230060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "they get a mouthful of\nbitter-tasting termite,"
    } ]
  }, {
    "tStartMs": 1232700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and whenever they attack something gray,"
    } ]
  }, {
    "tStartMs": 1234080,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "they get a mouthful of tasty termite."
    } ]
  }, {
    "tStartMs": 1237500,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "The first spiders to go\nthrough this experiment are"
    } ]
  }, {
    "tStartMs": 1239603,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "Habronattus pyrrithrix,\nand we started with them"
    } ]
  }, {
    "tStartMs": 1241790,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "because we know that they\nhave good color vision"
    } ]
  }, {
    "tStartMs": 1244970,
    "dDurationMs": 2118,
    "segs": [ {
      "utf8": "that extends into the long wavelengths."
    } ]
  }, {
    "tStartMs": 1247088,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "- [Derek] Habronattus\npyrrithrix is one of the species"
    } ]
  }, {
    "tStartMs": 1249530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that can see red using a red filter"
    } ]
  }, {
    "tStartMs": 1251840,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "in front of some of its\ngreen-sensitive cone cells."
    } ]
  }, {
    "tStartMs": 1255230,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Lisa] Our data so far suggests"
    } ]
  }, {
    "tStartMs": 1256490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that the spiders are really\ngood at learning the rules."
    } ]
  }, {
    "tStartMs": 1259370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- And once they learn the rules,"
    } ]
  }, {
    "tStartMs": 1261320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "then the real experiment begins."
    } ]
  }, {
    "tStartMs": 1263960,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The spiders hunt for all\ntheir food in a setup"
    } ]
  }, {
    "tStartMs": 1266690,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "just like the termite buffet\nwhere they were trained,"
    } ]
  }, {
    "tStartMs": 1269330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "except that for half of the spiders"
    } ]
  }, {
    "tStartMs": 1271730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "there's a big difference."
    } ]
  }, {
    "tStartMs": 1273560,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Some of the termites are still\nbitter, but they're all gray."
    } ]
  }, {
    "tStartMs": 1277550,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "The color cues are gone."
    } ]
  }, {
    "tStartMs": 1280760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Now, the question becomes"
    } ]
  }, {
    "tStartMs": 1282440,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "do the spiders that have\ncolor cues available,"
    } ]
  }, {
    "tStartMs": 1284960,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in other words, the ones\nfor which bitter termites"
    } ]
  }, {
    "tStartMs": 1287150,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "are still red, do they do better?"
    } ]
  }, {
    "tStartMs": 1290810,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- So our data so far show\nthat they do fare better"
    } ]
  }, {
    "tStartMs": 1293510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "when they have access to those color cues,"
    } ]
  }, {
    "tStartMs": 1295460,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "they lay eggs sooner,"
    } ]
  }, {
    "tStartMs": 1296750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and that they're also heavier\nat the end of the experiment"
    } ]
  }, {
    "tStartMs": 1298880,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "if they're in the treatment group"
    } ]
  }, {
    "tStartMs": 1300230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "where they have access to color cues."
    } ]
  }, {
    "tStartMs": 1302420,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- One hypothesis for why primates evolved"
    } ]
  }, {
    "tStartMs": 1304730,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "expanded color vision is"
    } ]
  }, {
    "tStartMs": 1306200,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to distinguish ripe from unripe fruit,"
    } ]
  }, {
    "tStartMs": 1309290,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "or tender new leaves\nfrom older, tougher ones,"
    } ]
  }, {
    "tStartMs": 1312770,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "in other words, telling good\nfood apart from bad food,"
    } ]
  }, {
    "tStartMs": 1316700,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "kind of like what these spiders are doing."
    } ]
  }, {
    "tStartMs": 1319310,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "- Here, we've got this kind of\nevidence in a jumping spider,"
    } ]
  }, {
    "tStartMs": 1322970,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "and we're gonna repeatedly test that"
    } ]
  }, {
    "tStartMs": 1325300,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "in other jumping spider species"
    } ]
  }, {
    "tStartMs": 1327260,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that have different forms of color vision."
    } ]
  }, {
    "tStartMs": 1329870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- The team predicts that spiders"
    } ]
  }, {
    "tStartMs": 1331460,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "with expanded color\nvision will use color cues"
    } ]
  }, {
    "tStartMs": 1334250,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to their advantage."
    } ]
  }, {
    "tStartMs": 1335570,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So they'll do better\nwhen color can tell them"
    } ]
  }, {
    "tStartMs": 1337790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "which prey items taste bad."
    } ]
  }, {
    "tStartMs": 1340160,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Species that can't see\nred won't get any benefit"
    } ]
  }, {
    "tStartMs": 1343070,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "from the warning colors,\nor from the training."
    } ]
  }, {
    "tStartMs": 1346400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "If the data support these predictions,"
    } ]
  }, {
    "tStartMs": 1348470,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "these will be some of the first\nexperiments in any species"
    } ]
  }, {
    "tStartMs": 1351290,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to reveal an evolutionary\nadvantage to seeing"
    } ]
  }, {
    "tStartMs": 1354260,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "and discriminating more colors."
    } ]
  }, {
    "tStartMs": 1357170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But feeding behavior\ncan't be the whole story,"
    } ]
  }, {
    "tStartMs": 1359930,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "because the spiders had some\nmore surprises in store."
    } ]
  }, {
    "tStartMs": 1363680,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- For example, there's a\ngenus of jumping spiders"
    } ]
  }, {
    "tStartMs": 1366290,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "in Central America called Mexigonus,"
    } ]
  }, {
    "tStartMs": 1369530,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "where males and only males sport"
    } ]
  }, {
    "tStartMs": 1372050,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "incredibly bright red colors\non parts of their body"
    } ]
  }, {
    "tStartMs": 1376400,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that they use during courtship."
    } ]
  }, {
    "tStartMs": 1378830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- We thought for sure"
    } ]
  }, {
    "tStartMs": 1379663,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "the female has gotta be\npaying attention to red,"
    } ]
  }, {
    "tStartMs": 1381920,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "distinguishing it from other colors."
    } ]
  }, {
    "tStartMs": 1383300,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "They've gotta have red color\nvision in some special way."
    } ]
  }, {
    "tStartMs": 1387320,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- And it turns out that at\nleast by our measurements,"
    } ]
  }, {
    "tStartMs": 1390620,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "they don't have the ability to see red."
    } ]
  }, {
    "tStartMs": 1393440,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "They just have UV and\ngreen-sensitive cells"
    } ]
  }, {
    "tStartMs": 1396340,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "in those principal eye retinas."
    } ]
  }, {
    "tStartMs": 1398690,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- I don't mind being proved wrong at all."
    } ]
  }, {
    "tStartMs": 1401810,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It usually means something more exciting,"
    } ]
  }, {
    "tStartMs": 1403910,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "because it means that, oh my\nGod, there's something cool"
    } ]
  }, {
    "tStartMs": 1406340,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "and new in the world, right?"
    } ]
  }, {
    "tStartMs": 1407450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And you've learned something new."
    } ]
  }, {
    "tStartMs": 1409400,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- So what's going on here?"
    } ]
  }, {
    "tStartMs": 1411980,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "To help answer that question"
    } ]
  }, {
    "tStartMs": 1413420,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and maybe understand why\nsome spiders are displaying"
    } ]
  }, {
    "tStartMs": 1416000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to one another with colors they can't see,"
    } ]
  }, {
    "tStartMs": 1418760,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "it's time to revisit the\njumping spider retina."
    } ]
  }, {
    "tStartMs": 1422090,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Instead of just one retina like we have,"
    } ]
  }, {
    "tStartMs": 1424550,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they have a stack of translucent retinas"
    } ]
  }, {
    "tStartMs": 1426800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "right on top of each other."
    } ]
  }, {
    "tStartMs": 1428330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- One thing that we think\nthat this layering does is"
    } ]
  }, {
    "tStartMs": 1430730,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to correct for a problem"
    } ]
  }, {
    "tStartMs": 1432890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that the optics present to the retina."
    } ]
  }, {
    "tStartMs": 1435470,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "It's called chromatic aberration."
    } ]
  }, {
    "tStartMs": 1438680,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- Most optical materials,\nlike these glass prisms,"
    } ]
  }, {
    "tStartMs": 1441920,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "refract, or bend short wavelength light,"
    } ]
  }, {
    "tStartMs": 1445100,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "like blue and UV, more strongly"
    } ]
  }, {
    "tStartMs": 1447860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "than long wavelength light, like red."
    } ]
  }, {
    "tStartMs": 1450560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "That's chromatic aberration."
    } ]
  }, {
    "tStartMs": 1452930,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Lenses do this, too."
    } ]
  }, {
    "tStartMs": 1454850,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "In photos taken with\nvintage camera lenses,"
    } ]
  }, {
    "tStartMs": 1456920,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "you can often see a fringe of color"
    } ]
  }, {
    "tStartMs": 1458810,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "around high contrast edges."
    } ]
  }, {
    "tStartMs": 1461510,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The sensor in a camera is a\nsingle flat layer of photosites."
    } ]
  }, {
    "tStartMs": 1466010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So getting the different\ncolors of light to focus"
    } ]
  }, {
    "tStartMs": 1468410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in the same plane is critical."
    } ]
  }, {
    "tStartMs": 1470810,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Modern camera lenses correct\nfor chromatic aberration"
    } ]
  }, {
    "tStartMs": 1473660,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "using complicated optical designs"
    } ]
  }, {
    "tStartMs": 1475790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "with lots of lens elements."
    } ]
  }, {
    "tStartMs": 1478130,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- But the other solution is to put"
    } ]
  }, {
    "tStartMs": 1480410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "different color-sensitive\ncells at the right depths"
    } ]
  }, {
    "tStartMs": 1483950,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "behind the lenses, so that the colors"
    } ]
  }, {
    "tStartMs": 1487280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "that they're sensitive\nto are in proper focus."
    } ]
  }, {
    "tStartMs": 1490130,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "- That's exactly what\njumping spider retinas do,"
    } ]
  }, {
    "tStartMs": 1493940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and this gets us one step\ncloser to understanding"
    } ]
  }, {
    "tStartMs": 1496460,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "what red might mean to a spider\nthat can't actually see red."
    } ]
  }, {
    "tStartMs": 1501860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "In the jumping spider\neye, the cells sensitive"
    } ]
  }, {
    "tStartMs": 1504890,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to shorter wavelengths are\ngenerally closer to the lens,"
    } ]
  }, {
    "tStartMs": 1508310,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and those sensitive to longer\nwavelengths are farther away."
    } ]
  }, {
    "tStartMs": 1512570,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But most jumping spiders are dichromats."
    } ]
  }, {
    "tStartMs": 1515090,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They only have two cone cell types."
    } ]
  }, {
    "tStartMs": 1517550,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So why have four layers in their retinas?"
    } ]
  }, {
    "tStartMs": 1521450,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Nathan] Typically, the bottom,"
    } ]
  }, {
    "tStartMs": 1523070,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "or farthest away from the lens two tiers,"
    } ]
  }, {
    "tStartMs": 1526010,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "we call those tiers 1 and 2."
    } ]
  }, {
    "tStartMs": 1528920,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Those are both typically\nsensitive just to green light."
    } ]
  }, {
    "tStartMs": 1532520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And with a retina like that,"
    } ]
  }, {
    "tStartMs": 1534500,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "an object in that world might\nappear in different focus"
    } ]
  }, {
    "tStartMs": 1538430,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "in tier 2 than in tier 1."
    } ]
  }, {
    "tStartMs": 1541430,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] Researchers in Japan have shown"
    } ]
  }, {
    "tStartMs": 1543020,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "that jumping spiders can\nactually use this discrepancy"
    } ]
  }, {
    "tStartMs": 1546200,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in focus to perceive depth"
    } ]
  }, {
    "tStartMs": 1548720,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and distance in their environment."
    } ]
  }, {
    "tStartMs": 1551660,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- But there is a liability\nwith this system."
    } ]
  }, {
    "tStartMs": 1554930,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It only works if you're just\nusing one color of light,"
    } ]
  }, {
    "tStartMs": 1558770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "like green."
    } ]
  }, {
    "tStartMs": 1560420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If you start to mix in\nother colors of light,"
    } ]
  }, {
    "tStartMs": 1562820,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "for example, red, then\nthe system creates errors."
    } ]
  }, {
    "tStartMs": 1566840,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Essentially, colors like red\nmight create this perception"
    } ]
  }, {
    "tStartMs": 1571220,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "of being close, or being\nlooming towards the receiver,"
    } ]
  }, {
    "tStartMs": 1576050,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and that would provide"
    } ]
  }, {
    "tStartMs": 1577400,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "a totally different perceptual\nexperience for the viewer."
    } ]
  }, {
    "tStartMs": 1582350,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "- So a jumping spider's red\ncoloration might not look red"
    } ]
  }, {
    "tStartMs": 1586250,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to another jumping spider,"
    } ]
  }, {
    "tStartMs": 1587660,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "but instead create a\nsort of depth illusion."
    } ]
  }, {
    "tStartMs": 1591350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But why would a male spider benefit"
    } ]
  }, {
    "tStartMs": 1593480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "from displaying an optical illusion?"
    } ]
  }, {
    "tStartMs": 1596780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- One thing about jumping spiders is"
    } ]
  }, {
    "tStartMs": 1599210,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that females often are quite aggressive"
    } ]
  }, {
    "tStartMs": 1601820,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "towards prospective mates."
    } ]
  }, {
    "tStartMs": 1603230,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "In fact, they can often eat the male"
    } ]
  }, {
    "tStartMs": 1606200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "rather than allowing\nhim to mate with them."
    } ]
  }, {
    "tStartMs": 1608360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So these males, when\nthey're dancing for females,"
    } ]
  }, {
    "tStartMs": 1610520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "are really actually\ndancing for their lives"
    } ]
  }, {
    "tStartMs": 1612680,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "in many instances."
    } ]
  }, {
    "tStartMs": 1614870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- [Derek] If a female\nthinks a male is closer"
    } ]
  }, {
    "tStartMs": 1617240,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "than he really is, that\ncould throw off her attack,"
    } ]
  }, {
    "tStartMs": 1621140,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "or maybe confusing the female\npays off in other ways."
    } ]
  }, {
    "tStartMs": 1625190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- If she can't quite figure\nout the male's display,"
    } ]
  }, {
    "tStartMs": 1627980,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "she might stick around paying\nattention to it for longer,"
    } ]
  }, {
    "tStartMs": 1630890,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and this might result in better outcomes"
    } ]
  }, {
    "tStartMs": 1633080,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "for the male at the end of courtship."
    } ]
  }, {
    "tStartMs": 1635840,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] And amorous\nmale spiders might not be"
    } ]
  }, {
    "tStartMs": 1638060,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "the only ones exploiting\nthese depth delusions."
    } ]
  }, {
    "tStartMs": 1641660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- So imagine a red prey item."
    } ]
  }, {
    "tStartMs": 1643520,
    "dDurationMs": 3517,
    "segs": [ {
      "utf8": "We might look at it and\nsay, \"That's probably toxic,"
    } ]
  }, {
    "tStartMs": 1647037,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "\"and it's warning birds that it's toxic.\""
    } ]
  }, {
    "tStartMs": 1649520,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But another possibility is that it's red"
    } ]
  }, {
    "tStartMs": 1651350,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "simply to look like it's\ncloser to a jumping spider,"
    } ]
  }, {
    "tStartMs": 1654350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "so that it has a better\nchance of escaping."
    } ]
  }, {
    "tStartMs": 1657200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "We also see small insects"
    } ]
  }, {
    "tStartMs": 1659630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "with red and blue patterns on them,"
    } ]
  }, {
    "tStartMs": 1662150,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "which would create a really\ncomplicated visual illusion"
    } ]
  }, {
    "tStartMs": 1666290,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that might simply baffle it,"
    } ]
  }, {
    "tStartMs": 1668180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and require it a longer period of time"
    } ]
  }, {
    "tStartMs": 1670430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "before it judge this distance."
    } ]
  }, {
    "tStartMs": 1672860,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "Even a split second can really matter."
    } ]
  }, {
    "tStartMs": 1676430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- But in this tiny game of cat and mouse,"
    } ]
  }, {
    "tStartMs": 1678800,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "a spider that could see and\ndiscriminate red from green"
    } ]
  }, {
    "tStartMs": 1682130,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "would be a lot harder to fool,"
    } ]
  }, {
    "tStartMs": 1684980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and this could be another\nsurprising benefit"
    } ]
  }, {
    "tStartMs": 1687170,
    "dDurationMs": 4173,
    "segs": [ {
      "utf8": "of color vision, one that isn't\nreally about color at all."
    } ]
  }, {
    "tStartMs": 1692360,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- And what we really need to ask"
    } ]
  }, {
    "tStartMs": 1693980,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "whether, or not this\nhypothesis is even plausible"
    } ]
  }, {
    "tStartMs": 1697130,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "is really good high\nresolution measurements"
    } ]
  }, {
    "tStartMs": 1700820,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of the distances of things in their eyes,"
    } ]
  }, {
    "tStartMs": 1703280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "including the retina and the\nlenses, from live animals."
    } ]
  }, {
    "tStartMs": 1707120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- [Derek] This information\nyou can't just get"
    } ]
  }, {
    "tStartMs": 1709010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "from preserved specimens\non microscope slides,"
    } ]
  }, {
    "tStartMs": 1711800,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "but there is another way."
    } ]
  }, {
    "tStartMs": 1713993,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "(light music)\n(air whooshing)"
    } ]
  }, {
    "tStartMs": 1716600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "By using a particle accelerator called"
    } ]
  }, {
    "tStartMs": 1718700,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the Advanced Photon Source,\nthe researchers have started"
    } ]
  }, {
    "tStartMs": 1721490,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to collect high resolution X-ray videos"
    } ]
  }, {
    "tStartMs": 1724340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "through the spider's exoskeletons."
    } ]
  }, {
    "tStartMs": 1726860,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- This has never been done before."
    } ]
  }, {
    "tStartMs": 1728210,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's in X-ray, so we can\nsee through their eyes,"
    } ]
  }, {
    "tStartMs": 1730550,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "and we can see how these\neye tubes are moving around."
    } ]
  }, {
    "tStartMs": 1734690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] If the spider's\nretinal movements change"
    } ]
  }, {
    "tStartMs": 1736970,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the shape, or length of their eye tubes,"
    } ]
  }, {
    "tStartMs": 1739460,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that'll affect what they're\ncapable of perceiving."
    } ]
  }, {
    "tStartMs": 1742760,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- It would change how\nthey experience depth."
    } ]
  }, {
    "tStartMs": 1744770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It would change how they experience color."
    } ]
  }, {
    "tStartMs": 1747170,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Previously, this information"
    } ]
  }, {
    "tStartMs": 1748370,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "has only been collected from dissections."
    } ]
  }, {
    "tStartMs": 1751160,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "So we're very excited to get\nsuper high resolution videos"
    } ]
  }, {
    "tStartMs": 1755450,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "of the inside of the spider's head"
    } ]
  }, {
    "tStartMs": 1757550,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "as it's performing\ncomplicated visual motions."
    } ]
  }, {
    "tStartMs": 1761270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- Unfortunately, a few months\nafter their initial tests,"
    } ]
  }, {
    "tStartMs": 1763850,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the Advanced Photon Source\nshut down for upgrades"
    } ]
  }, {
    "tStartMs": 1766310,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that'll take over a year to complete."
    } ]
  }, {
    "tStartMs": 1768740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So it looks like we'll have\nto wait a little longer"
    } ]
  }, {
    "tStartMs": 1771110,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "for some of the answers the\nteam has been looking for."
    } ]
  }, {
    "tStartMs": 1774860,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- We know that the retinas\ncan be moved around"
    } ]
  }, {
    "tStartMs": 1777170,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "and that they maybe have between\na 50 and 60-degree travel."
    } ]
  }, {
    "tStartMs": 1781340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Not only can they be moved\nin the horizontal plane,"
    } ]
  }, {
    "tStartMs": 1783980,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "but in the vertical plane,"
    } ]
  }, {
    "tStartMs": 1785120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and they can actually be twisted"
    } ]
  }, {
    "tStartMs": 1787040,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to change the orientation\nof their field of view."
    } ]
  }, {
    "tStartMs": 1790340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- The question is how do\nthese movements affect"
    } ]
  }, {
    "tStartMs": 1793370,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "what the spiders can focus\non, or how they sense depth,"
    } ]
  }, {
    "tStartMs": 1797480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "or even how they perceive color?"
    } ]
  }, {
    "tStartMs": 1800780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's this connection between focus, depth,"
    } ]
  }, {
    "tStartMs": 1803900,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and color that makes these\nspiders so intriguing."
    } ]
  }, {
    "tStartMs": 1807620,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- It opens up all sorts of questions about"
    } ]
  }, {
    "tStartMs": 1809990,
    "dDurationMs": 2468,
    "segs": [ {
      "utf8": "what color is in the first place."
    } ]
  }, {
    "tStartMs": 1812458,
    "dDurationMs": 1822,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 1814280,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- It's already clear\nthat these spiders have"
    } ]
  }, {
    "tStartMs": 1816170,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "a lot to teach us about color vision,"
    } ]
  }, {
    "tStartMs": 1818300,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "how and why it evolves,"
    } ]
  }, {
    "tStartMs": 1819680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and how many forms it can take"
    } ]
  }, {
    "tStartMs": 1821660,
    "dDurationMs": 2735,
    "segs": [ {
      "utf8": "even within a single group of animals."
    } ]
  }, {
    "tStartMs": 1824395,
    "dDurationMs": 1555,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 1825950,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "If our understanding of their\nvisual system is correct,"
    } ]
  }, {
    "tStartMs": 1829280,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the experience of color\nfor jumping spiders"
    } ]
  }, {
    "tStartMs": 1832340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "might even be three-dimensional"
    } ]
  }, {
    "tStartMs": 1834920,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "in a way that's totally different\nfrom how we see the world."
    } ]
  }, {
    "tStartMs": 1840170,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And we haven't even talked\nabout their other senses,"
    } ]
  }, {
    "tStartMs": 1842390,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "like their ability to\ncommunicate through vibration."
    } ]
  }, {
    "tStartMs": 1846740,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "When you think about it,"
    } ]
  }, {
    "tStartMs": 1847820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "you realize that the\nuniverse we humans perceive,"
    } ]
  }, {
    "tStartMs": 1851000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "even with all our technology,"
    } ]
  }, {
    "tStartMs": 1852830,
    "dDurationMs": 3552,
    "segs": [ {
      "utf8": "is just a sliver of what's out there."
    } ]
  }, {
    "tStartMs": 1856382,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 1857300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- If we owe anything to the world,"
    } ]
  }, {
    "tStartMs": 1859760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it's to allow the world to be experienced"
    } ]
  }, {
    "tStartMs": 1862160,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "in the fullness of itself."
    } ]
  }, {
    "tStartMs": 1865070,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "I think this is one of the\ntragedies of extinction"
    } ]
  }, {
    "tStartMs": 1867980,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "is the loss of oftentimes\na totally unique way"
    } ]
  }, {
    "tStartMs": 1872720,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "of experiencing our world,"
    } ]
  }, {
    "tStartMs": 1875330,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "a way of experiencing our world"
    } ]
  }, {
    "tStartMs": 1877760,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "that we probably couldn't even imagine."
    } ]
  }, {
    "tStartMs": 1881720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- So color,"
    } ]
  }, {
    "tStartMs": 1883820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "what is it?"
    } ]
  }, {
    "tStartMs": 1885380,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Is it an intrinsic property of an object,"
    } ]
  }, {
    "tStartMs": 1887750,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "like Aristotle thought,"
    } ]
  }, {
    "tStartMs": 1889280,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "or something that exists only\nin the mind perceiving it,"
    } ]
  }, {
    "tStartMs": 1892880,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "like Galileo believed?"
    } ]
  }, {
    "tStartMs": 1895070,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "Maybe it's not an either/or question."
    } ]
  }, {
    "tStartMs": 1899030,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- My belief is that color\nis something that emerges"
    } ]
  }, {
    "tStartMs": 1902270,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "through the evolution of\nthe eyes that see the world"
    } ]
  }, {
    "tStartMs": 1906800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and the world that the eyes see."
    } ]
  }, {
    "tStartMs": 1908900,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Color as a thing emerges\nthrough this dance,"
    } ]
  }, {
    "tStartMs": 1912530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "this evolutionary dance between"
    } ]
  }, {
    "tStartMs": 1914840,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "what can be sensed about the world"
    } ]
  }, {
    "tStartMs": 1917150,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "and those that are sensing it."
    } ]
  }, {
    "tStartMs": 1920000,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "- It's that dance playing out\nover millions of generations"
    } ]
  }, {
    "tStartMs": 1923660,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that created the colorful\nworld we inhabit,"
    } ]
  }, {
    "tStartMs": 1926660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and shaped the countless ways"
    } ]
  }, {
    "tStartMs": 1928850,
    "dDurationMs": 3491,
    "segs": [ {
      "utf8": "that we and our fellow\nlife forms experience it."
    } ]
  }, {
    "tStartMs": 1932341,
    "dDurationMs": 2649,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 1934990,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "(graphics beeping)"
    } ]
  }, {
    "tStartMs": 1937760,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Come to me."
    } ]
  }, {
    "tStartMs": 1938600,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "Okay, not that far."
    } ]
  }, {
    "tStartMs": 1940693,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Ah!"
    } ]
  }, {
    "tStartMs": 1941526,
    "dDurationMs": 2474,
    "segs": [ {
      "utf8": "(Derek laughing)"
    } ]
  }, {
    "tStartMs": 1944000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "They're not called jumping\nspiders for nothing."
    } ]
  }, {
    "tStartMs": 1946070,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "Yeah, come on."
    } ]
  } ]
}
