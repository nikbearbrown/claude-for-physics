{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 230,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- All right, I'm about to\ngo for my first ever ride"
    } ]
  }, {
    "tStartMs": 2840,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "in a fully autonomous vehicle."
    } ]
  }, {
    "tStartMs": 9890,
    "dDurationMs": 1693,
    "segs": [ {
      "utf8": "Whoa, no driver."
    } ]
  }, {
    "tStartMs": 14230,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 15063,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "- [Electronic Voice] Good morning, Derek."
    } ]
  }, {
    "tStartMs": 16410,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "This car is all yours\nwith no one up front."
    } ]
  }, {
    "tStartMs": 19220,
    "dDurationMs": 3747,
    "segs": [ {
      "utf8": "- I really like the idea of\nfully autonomous vehicles,"
    } ]
  }, {
    "tStartMs": 22967,
    "dDurationMs": 3923,
    "segs": [ {
      "utf8": "but it's weird getting\ninto a car with no driver"
    } ]
  }, {
    "tStartMs": 26890,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and just trusting the car."
    } ]
  }, {
    "tStartMs": 28940,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "I'm gonna report back how this ride goes"
    } ]
  }, {
    "tStartMs": 32310,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "and how I feel about it."
    } ]
  }, {
    "tStartMs": 34210,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "Oh, but full disclosure, this\nvideo is sponsored by Waymo."
    } ]
  }, {
    "tStartMs": 41585,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "(car door clicking)"
    } ]
  }, {
    "tStartMs": 43274,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(seatbelt clicking)"
    } ]
  }, {
    "tStartMs": 44107,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "Start ride.\n(car navigation chiming)"
    } ]
  }, {
    "tStartMs": 46577,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Ha ha!"
    } ]
  }, {
    "tStartMs": 47410,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "- [Electronic Voice] Make sure\nyour seatbelt is fastened."
    } ]
  }, {
    "tStartMs": 49127,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "(Derek vocalizes)\nFor any questions,"
    } ]
  }, {
    "tStartMs": 50450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "press the Help button to speak\nwith a rider support agent."
    } ]
  }, {
    "tStartMs": 53930,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Okay. Now let's see where we go."
    } ]
  }, {
    "tStartMs": 56630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It's looking at this car coming\nhere. What's it gonna do?"
    } ]
  }, {
    "tStartMs": 60590,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Oh, and it pulls in\nvery smoothly behind it."
    } ]
  }, {
    "tStartMs": 64070,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "No problems. Did not turn into traffic."
    } ]
  }, {
    "tStartMs": 66430,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Waited until the cars\nwent, and then it turned."
    } ]
  }, {
    "tStartMs": 69460,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I like that."
    } ]
  }, {
    "tStartMs": 71350,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I polled YouTube viewers\nabout autonomous vehicles"
    } ]
  }, {
    "tStartMs": 74250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and half of you are excited"
    } ]
  }, {
    "tStartMs": 76500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and ready for them to be on the roads,"
    } ]
  }, {
    "tStartMs": 78500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but over 40% said you\nthought the technology"
    } ]
  }, {
    "tStartMs": 81350,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "was still over 10 years away."
    } ]
  }, {
    "tStartMs": 84010,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "And for those people, I have news,"
    } ]
  }, {
    "tStartMs": 86990,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "which is that, well, there\nis no driver in this car."
    } ]
  }, {
    "tStartMs": 90420,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "I'm currently inside a fully\nautonomous vehicle driving"
    } ]
  }, {
    "tStartMs": 94580,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "around a suburb of Phoenix, Arizona."
    } ]
  }, {
    "tStartMs": 97880,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Now I get that in some parts of the world,"
    } ]
  }, {
    "tStartMs": 99930,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "like, the roads aren't\nwell enough maintained"
    } ]
  }, {
    "tStartMs": 101960,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and people don't stay in\ntheir lane necessarily,"
    } ]
  }, {
    "tStartMs": 104570,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and so it'd be very hard for\na computer to drive there,"
    } ]
  }, {
    "tStartMs": 106850,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but at least under good conditions,"
    } ]
  }, {
    "tStartMs": 109090,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "the technology is currently functional."
    } ]
  }, {
    "tStartMs": 111583,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(downtempo music)"
    } ]
  }, {
    "tStartMs": 117104,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "(bright comedic music)"
    } ]
  }, {
    "tStartMs": 118840,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "- Now Waymo started out"
    } ]
  }, {
    "tStartMs": 120170,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "as the Google self-driving car project"
    } ]
  }, {
    "tStartMs": 122910,
    "dDurationMs": 2873,
    "segs": [ {
      "utf8": "with what is possibly one of\nthe cutest cars ever made."
    } ]
  }, {
    "tStartMs": 128770,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "I am inside the world's first\nfully autonomous vehicle."
    } ]
  }, {
    "tStartMs": 132980,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "Back in October 2015, this\ncar went on a public road,"
    } ]
  }, {
    "tStartMs": 137770,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "ridden by Steve Mann,"
    } ]
  }, {
    "tStartMs": 139360,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "who has a disability, he is legally blind,"
    } ]
  }, {
    "tStartMs": 142180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but he could get around in this thing,"
    } ]
  }, {
    "tStartMs": 145180,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "which is affectionately\nknown as the Firefly."
    } ]
  }, {
    "tStartMs": 148600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "This is such a simple vehicle."
    } ]
  }, {
    "tStartMs": 150300,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "There's basically nothing in here."
    } ]
  }, {
    "tStartMs": 152360,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "There's no steering wheel, no dashboard."
    } ]
  }, {
    "tStartMs": 154640,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "This car is super basic."
    } ]
  }, {
    "tStartMs": 156170,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "There is no AC, but there\nis an emergency stop button."
    } ]
  }, {
    "tStartMs": 160700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(button cover clicks)"
    } ]
  }, {
    "tStartMs": 161533,
    "dDurationMs": 1727,
    "segs": [ {
      "utf8": "That's my favorite button in the car."
    } ]
  }, {
    "tStartMs": 163260,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "It reminds me of elevators."
    } ]
  }, {
    "tStartMs": 165370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "One of the important\nmeasures that they had to put"
    } ]
  }, {
    "tStartMs": 167410,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "in automatic elevators\nwas a big red stop button."
    } ]
  }, {
    "tStartMs": 171150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Did you know that before the 1940s,"
    } ]
  }, {
    "tStartMs": 173610,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "almost all elevators had drivers in them?"
    } ]
  }, {
    "tStartMs": 176710,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And when people started putting\nin driverless elevators,"
    } ]
  }, {
    "tStartMs": 180370,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "well, the public was very concerned,"
    } ]
  }, {
    "tStartMs": 182160,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "and they didn't wanna\nride in those elevators."
    } ]
  }, {
    "tStartMs": 183910,
    "dDurationMs": 1087,
    "segs": [ {
      "utf8": "There was one guy who was like,"
    } ]
  }, {
    "tStartMs": 184997,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "\"I don't care if I have to\nwalk up 12 flights of stairs"
    } ]
  }, {
    "tStartMs": 187930,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "for the rest of my life."
    } ]
  }, {
    "tStartMs": 188980,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "I'm not taking that elevator.\""
    } ]
  }, {
    "tStartMs": 190560,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "And adoption was slow."
    } ]
  }, {
    "tStartMs": 191550,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "I mean, they tried to advertise"
    } ]
  }, {
    "tStartMs": 192840,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "to help people understand\nthat it was in fact safe,"
    } ]
  }, {
    "tStartMs": 195410,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "but, ultimately, there was\nan elevator drivers strike"
    } ]
  }, {
    "tStartMs": 198810,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "in New York City, and that\nreally annoyed people,"
    } ]
  }, {
    "tStartMs": 201800,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "and it helped the adoption\nof automated elevators."
    } ]
  }, {
    "tStartMs": 205170,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "If you found a driver\nin an elevator today,"
    } ]
  }, {
    "tStartMs": 207370,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "you would wonder, \"Why are they there?\""
    } ]
  }, {
    "tStartMs": 210050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Now you might think an\nelevator is just so simple,"
    } ]
  }, {
    "tStartMs": 212660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I mean, it is effectively\none dimensional motion,"
    } ]
  }, {
    "tStartMs": 215390,
    "dDurationMs": 4971,
    "segs": [ {
      "utf8": "but airplanes are also flown\nextensively by computers."
    } ]
  }, {
    "tStartMs": 220361,
    "dDurationMs": 1749,
    "segs": [ {
      "utf8": "(tense percussive music)"
    } ]
  }, {
    "tStartMs": 222110,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "I saw this particular landing"
    } ]
  }, {
    "tStartMs": 224550,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "where a plane is coming in into Vienna,"
    } ]
  }, {
    "tStartMs": 227100,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "and it's just so foggy"
    } ]
  }, {
    "tStartMs": 228590,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "that the pilots can see almost nothing."
    } ]
  }, {
    "tStartMs": 230370,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "I mean, this is the view from the cockpit,"
    } ]
  }, {
    "tStartMs": 233210,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "and yet, they make a perfect,"
    } ]
  }, {
    "tStartMs": 235680,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "a textbook landing right on target."
    } ]
  }, {
    "tStartMs": 238340,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "So how do they do it?"
    } ]
  }, {
    "tStartMs": 240360,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "The answer is the pilots didn't do it."
    } ]
  }, {
    "tStartMs": 243100,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It was a CAT II autoland procedure."
    } ]
  }, {
    "tStartMs": 245820,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "The plane just came in and\nlanded itself essentially."
    } ]
  }, {
    "tStartMs": 249990,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "Now, of course, the pilots are important"
    } ]
  }, {
    "tStartMs": 251840,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "and they're monitoring all of\nthe instruments and controls,"
    } ]
  }, {
    "tStartMs": 255480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "but it's actually the plane"
    } ]
  }, {
    "tStartMs": 257010,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and its computer getting the\nplane to land appropriately."
    } ]
  }, {
    "tStartMs": 260400,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "I was surprised to learn that\nhumans are much more likely"
    } ]
  }, {
    "tStartMs": 264230,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "to take manual control\nand land on sunny days,"
    } ]
  }, {
    "tStartMs": 268050,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "like July 6th, 2013, when\nAsiana Airlines flight 214"
    } ]
  }, {
    "tStartMs": 272600,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "was on final approach to San Francisco."
    } ]
  }, {
    "tStartMs": 275420,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Attempting to manually land the plane,"
    } ]
  }, {
    "tStartMs": 277620,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "the pilot accidentally\nleft the throttle at zero,"
    } ]
  }, {
    "tStartMs": 280960,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "and by the time they realized"
    } ]
  }, {
    "tStartMs": 282210,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "and tried to abort the\nlanding, it was too late."
    } ]
  }, {
    "tStartMs": 286500,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "The plane crashed into the\nrunway seawall and split in two."
    } ]
  }, {
    "tStartMs": 291070,
    "dDurationMs": 3413,
    "segs": [ {
      "utf8": "Three people died in the\naftermath of this accident."
    } ]
  }, {
    "tStartMs": 295600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I think the counterintuitive thing"
    } ]
  }, {
    "tStartMs": 297680,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "is that we expect the humans to be better,"
    } ]
  }, {
    "tStartMs": 300540,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "particularly in tough situations,"
    } ]
  }, {
    "tStartMs": 302430,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "but when it comes to\nairplanes, if it's bad weather,"
    } ]
  }, {
    "tStartMs": 305320,
    "dDurationMs": 3313,
    "segs": [ {
      "utf8": "you actually want the plane flying itself."
    } ]
  }, {
    "tStartMs": 309840,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "So the obvious next question is,"
    } ]
  }, {
    "tStartMs": 311990,
    "dDurationMs": 1545,
    "segs": [ {
      "utf8": "would you want the same thing for cars?"
    } ]
  }, {
    "tStartMs": 313535,
    "dDurationMs": 1795,
    "segs": [ {
      "utf8": "(oscillating music)"
    } ]
  }, {
    "tStartMs": 315330,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "There are all these\ndifferent levels of autonomy,"
    } ]
  }, {
    "tStartMs": 317570,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and everything up to four\nrequires a human driver"
    } ]
  }, {
    "tStartMs": 320780,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "to be responsible and have\nthe wheel at all times."
    } ]
  }, {
    "tStartMs": 324370,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "In the early days of the Google\nself-driving car project,"
    } ]
  }, {
    "tStartMs": 327110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "they had a vehicle that\nwas not yet level four,"
    } ]
  }, {
    "tStartMs": 329510,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "so it still required a human driver."
    } ]
  }, {
    "tStartMs": 331590,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "They let Google employees borrow the cars,"
    } ]
  }, {
    "tStartMs": 334280,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but they still had to be\nin control of the wheel."
    } ]
  }, {
    "tStartMs": 336830,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "And the volunteers were informed"
    } ]
  }, {
    "tStartMs": 338340,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "that they were responsible\nfor the car at all times"
    } ]
  }, {
    "tStartMs": 341210,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and that they would be\nconstantly recorded,"
    } ]
  }, {
    "tStartMs": 342890,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "like video recorded, while\nthey were in the car."
    } ]
  }, {
    "tStartMs": 345630,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "But still, within a short period of time,"
    } ]
  }, {
    "tStartMs": 347810,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the engineers observed\ndrivers rummaging around"
    } ]
  }, {
    "tStartMs": 350240,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "in their bags or checking\nphones, putting on makeup,"
    } ]
  }, {
    "tStartMs": 353900,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "or even sleeping in the driver's seat."
    } ]
  }, {
    "tStartMs": 357480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "All these drivers were trusting\nthe technology too much,"
    } ]
  }, {
    "tStartMs": 360540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which makes almost fully\nautonomous vehicles"
    } ]
  }, {
    "tStartMs": 363120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "potentially more dangerous\nthan regular cars,"
    } ]
  }, {
    "tStartMs": 366360,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "I mean, if the driver is distracted"
    } ]
  }, {
    "tStartMs": 367910,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "or not prepared to take over."
    } ]
  }, {
    "tStartMs": 370140,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So this is why Waymo decided"
    } ]
  }, {
    "tStartMs": 372460,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "that the only safe way\nto proceed is with a car"
    } ]
  }, {
    "tStartMs": 374840,
    "dDurationMs": 1993,
    "segs": [ {
      "utf8": "that has at least level four autonomy."
    } ]
  }, {
    "tStartMs": 381240,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "This is the depot where the cars go"
    } ]
  }, {
    "tStartMs": 383150,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "when they're not on the road."
    } ]
  }, {
    "tStartMs": 384417,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "And it's also where people monitor"
    } ]
  }, {
    "tStartMs": 386620,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "all the rides in progress."
    } ]
  }, {
    "tStartMs": 388550,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Yes, so that's where my team sits."
    } ]
  }, {
    "tStartMs": 390590,
    "dDurationMs": 2097,
    "segs": [ {
      "utf8": "You see three teams basically here."
    } ]
  }, {
    "tStartMs": 392687,
    "dDurationMs": 2773,
    "segs": [ {
      "utf8": "One of the teams is my\nteam of fleet dispatchers,"
    } ]
  }, {
    "tStartMs": 395460,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "so basically making sure"
    } ]
  }, {
    "tStartMs": 396770,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "that all the mission\nare assigned every day"
    } ]
  }, {
    "tStartMs": 399310,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "and they are completed\nsuccessfully on the road."
    } ]
  }, {
    "tStartMs": 401330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And then you have the Rider Support team"
    } ]
  }, {
    "tStartMs": 402740,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "that takes the calls."
    } ]
  }, {
    "tStartMs": 405661,
    "dDurationMs": 869,
    "segs": [ {
      "utf8": "(electronic tone chiming)"
    } ]
  }, {
    "tStartMs": 406530,
    "dDurationMs": 2098,
    "segs": [ {
      "utf8": "- [Beulah] Thank you for\ncalling the Waymo Rider Support."
    } ]
  }, {
    "tStartMs": 408628,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "This is Beulah, how can I help today?"
    } ]
  }, {
    "tStartMs": 410630,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "- I just completed my ride,"
    } ]
  }, {
    "tStartMs": 411960,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but I don't wanna get out of the car."
    } ]
  }, {
    "tStartMs": 413610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "I just wanna keep driving."
    } ]
  }, {
    "tStartMs": 414820,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Is there a way that I can do that?"
    } ]
  }, {
    "tStartMs": 415970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Beulah] Right now, I\ndon't see a trip started."
    } ]
  }, {
    "tStartMs": 418130,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Give me one moment here while\nI partner with my team, okay?"
    } ]
  }, {
    "tStartMs": 420900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 426397,
    "dDurationMs": 4773,
    "segs": [ {
      "utf8": "(chuckling) Well, I just\nleft all my stuff in the car."
    } ]
  }, {
    "tStartMs": 431170,
    "dDurationMs": 1243,
    "segs": [ {
      "utf8": "I hope it comes back."
    } ]
  }, {
    "tStartMs": 437211,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "(car humming)"
    } ]
  }, {
    "tStartMs": 438980,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- I think there's a lot\nof, still, resistance"
    } ]
  }, {
    "tStartMs": 441740,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "in terms of trusting the vehicle."
    } ]
  }, {
    "tStartMs": 444370,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "And they ask you like,"
    } ]
  }, {
    "tStartMs": 446147,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "\"How does it feel to be in\na car without the driver?\""
    } ]
  }, {
    "tStartMs": 449080,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "I was the first person to do public roads,"
    } ]
  }, {
    "tStartMs": 453090,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "fully driverless ride at night."
    } ]
  }, {
    "tStartMs": 455370,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "I always share the experience with them."
    } ]
  }, {
    "tStartMs": 456760,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "It takes about two minutes\nfor you to completely forget"
    } ]
  }, {
    "tStartMs": 460180,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "that you are in a driverless vehicle."
    } ]
  }, {
    "tStartMs": 462800,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "If the system really provides\nthat feeling that you're safe"
    } ]
  }, {
    "tStartMs": 467040,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and you see a couple of maneuvers,"
    } ]
  }, {
    "tStartMs": 468930,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "in less than two minutes,"
    } ]
  }, {
    "tStartMs": 469950,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "you're talking to whoever is next to you"
    } ]
  }, {
    "tStartMs": 471790,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "and not paying attention to\nwhat's happening anymore."
    } ]
  }, {
    "tStartMs": 476720,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "- Whoa, all right, it doesn't\nmake the indicator sound,"
    } ]
  }, {
    "tStartMs": 480270,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "so I just don't know\nwhen it's going to turn,"
    } ]
  }, {
    "tStartMs": 484280,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "but if I was watching\nthe map, I would know."
    } ]
  }, {
    "tStartMs": 488770,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "I think we have this bias to believe"
    } ]
  }, {
    "tStartMs": 491070,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "that we're better at certain\ntasks than we actually are,"
    } ]
  }, {
    "tStartMs": 494290,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "like thinking that people\nare good at driving."
    } ]
  }, {
    "tStartMs": 497290,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "Surveys show 74% of people believe"
    } ]
  }, {
    "tStartMs": 500480,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "they are above average drivers."
    } ]
  }, {
    "tStartMs": 503870,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Think about that."
    } ]
  }, {
    "tStartMs": 505230,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "In the 20th century,"
    } ]
  }, {
    "tStartMs": 506170,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "60 million people were killed on the road."
    } ]
  }, {
    "tStartMs": 508600,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "That's basically an extra\nworld war's worth of deaths."
    } ]
  }, {
    "tStartMs": 512290,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And we really have no one\nto blame but ourselves."
    } ]
  }, {
    "tStartMs": 514970,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The National Transportation\nand Safety Board"
    } ]
  }, {
    "tStartMs": 516710,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "has identified human error as\nthe cause of 94% of accidents."
    } ]
  }, {
    "tStartMs": 521480,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Most of these errors are\nimpossible for a machine to make."
    } ]
  }, {
    "tStartMs": 526210,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Every year when people are backing out"
    } ]
  }, {
    "tStartMs": 528690,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "of driveways or parking spaces,"
    } ]
  }, {
    "tStartMs": 531260,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "in the U.S, up to 200 people are killed,"
    } ]
  }, {
    "tStartMs": 534640,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "and it's frequently\nolder people or children,"
    } ]
  }, {
    "tStartMs": 537380,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "the children of the drivers."
    } ]
  }, {
    "tStartMs": 539370,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's awful."
    } ]
  }, {
    "tStartMs": 540630,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "And it comes down to the fact"
    } ]
  }, {
    "tStartMs": 541810,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "that we don't have eyes\nin the back of our head,"
    } ]
  }, {
    "tStartMs": 543960,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and even the backup cameras\nstill have blind spots."
    } ]
  }, {
    "tStartMs": 547360,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "But if you have a vehicle that has LiDAR"
    } ]
  }, {
    "tStartMs": 550170,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "and radar and 29 cameras,"
    } ]
  }, {
    "tStartMs": 553280,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "you're just not going to hit them."
    } ]
  }, {
    "tStartMs": 556450,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Up here in the very prominent\ntop, there is a 360 LiDAR."
    } ]
  }, {
    "tStartMs": 561480,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So it can see all around the car."
    } ]
  }, {
    "tStartMs": 563790,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "It can see up to 300\nmeters away with a LiDAR."
    } ]
  }, {
    "tStartMs": 567340,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The way the LiDAR works"
    } ]
  }, {
    "tStartMs": 569080,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "is it shoots out invisible laser beams,"
    } ]
  }, {
    "tStartMs": 572100,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "scanning around millions\nof times a second,"
    } ]
  }, {
    "tStartMs": 575080,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "and then it detects the reflection,"
    } ]
  }, {
    "tStartMs": 577050,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and how long it takes\nto come back allows you"
    } ]
  }, {
    "tStartMs": 579420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to determine how far it is to that object."
    } ]
  }, {
    "tStartMs": 582120,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "So what it's doing is\nlike painting a 3D picture"
    } ]
  }, {
    "tStartMs": 585820,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "of the world."
    } ]
  }, {
    "tStartMs": 587090,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "There are 29 cameras around this vehicle,"
    } ]
  }, {
    "tStartMs": 590990,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "which gives you full 360 vision."
    } ]
  }, {
    "tStartMs": 593550,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "It gives you close range vision,"
    } ]
  }, {
    "tStartMs": 595450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "what is right next to the car,"
    } ]
  }, {
    "tStartMs": 596800,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "and also long range vision,\ngoing out 500 meters."
    } ]
  }, {
    "tStartMs": 601080,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "This car could detect a stop sign"
    } ]
  }, {
    "tStartMs": 602810,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "or a pedestrian 500 meters away."
    } ]
  }, {
    "tStartMs": 605610,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "How many of us have\neyesight that is that good?"
    } ]
  }, {
    "tStartMs": 608580,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "There is also a microphone up on top"
    } ]
  }, {
    "tStartMs": 612120,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "to listen to what's\nhappening in the environment,"
    } ]
  }, {
    "tStartMs": 614650,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "and if there are sirens,"
    } ]
  }, {
    "tStartMs": 616340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "then the car will pull over\nto the side of the road."
    } ]
  }, {
    "tStartMs": 619340,
    "dDurationMs": 3352,
    "segs": [ {
      "utf8": "It's gotta be able to respond\nto emergency vehicles."
    } ]
  }, {
    "tStartMs": 622692,
    "dDurationMs": 3417,
    "segs": [ {
      "utf8": "(light percussive music)"
    } ]
  }, {
    "tStartMs": 631520,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "What I wanna see here is, how\ndoes it handle a parking lot"
    } ]
  }, {
    "tStartMs": 636010,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "where there's people\ndriving in unusual ways"
    } ]
  }, {
    "tStartMs": 639380,
    "dDurationMs": 2838,
    "segs": [ {
      "utf8": "and possibly pedestrians walking around?"
    } ]
  }, {
    "tStartMs": 642218,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(car humming)"
    } ]
  }, {
    "tStartMs": 646900,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "(tires squeak)\nWhoa."
    } ]
  }, {
    "tStartMs": 648220,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "That was a sudden stop."
    } ]
  }, {
    "tStartMs": 652130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The car made a pretty hard stop there."
    } ]
  }, {
    "tStartMs": 653730,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I think it saw that guy\nwith a cart coming up"
    } ]
  }, {
    "tStartMs": 656190,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "on a pedestrian crosswalk."
    } ]
  }, {
    "tStartMs": 657570,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "And one of the interesting things"
    } ]
  }, {
    "tStartMs": 659240,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that the vehicle is always doing"
    } ]
  }, {
    "tStartMs": 661040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "is not only seeing where things are"
    } ]
  }, {
    "tStartMs": 663280,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and where they're going,\nbut also making predictions"
    } ]
  }, {
    "tStartMs": 666070,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "about where they're likely to go."
    } ]
  }, {
    "tStartMs": 668140,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "So this car doesn't just\nhave one potential future."
    } ]
  }, {
    "tStartMs": 672280,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "It's constantly imagining,"
    } ]
  }, {
    "tStartMs": 673847,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "\"Well, he might cross at the crosswalk,\""
    } ]
  }, {
    "tStartMs": 675970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or, \"He might keep going,\"\nor, \"He might turn left,\""
    } ]
  }, {
    "tStartMs": 678640,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and so it has to be prepared"
    } ]
  }, {
    "tStartMs": 680340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "for all of those different options."
    } ]
  }, {
    "tStartMs": 682170,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "And it even weights the options\nof like how likely it thinks"
    } ]
  }, {
    "tStartMs": 685600,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that he's gonna go on the crosswalk"
    } ]
  }, {
    "tStartMs": 687070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "versus go straight versus turn."
    } ]
  }, {
    "tStartMs": 689380,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And you can see that with\nthe thickness of the line"
    } ]
  }, {
    "tStartMs": 692100,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "in the little simulated\ngraphic that they have."
    } ]
  }, {
    "tStartMs": 697201,
    "dDurationMs": 1329,
    "segs": [ {
      "utf8": "(seatbelt clicking)\nPhew."
    } ]
  }, {
    "tStartMs": 698530,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "A few years back, I think a\nlot of people were talking"
    } ]
  }, {
    "tStartMs": 700860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "about how autonomous\nvehicles have to figure out"
    } ]
  }, {
    "tStartMs": 704220,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "who to hit in case of an accident,"
    } ]
  }, {
    "tStartMs": 706170,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "like do the pick the orphan or the nun?"
    } ]
  }, {
    "tStartMs": 709090,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Should the car hit the\nmotorcyclist with the helmet on"
    } ]
  }, {
    "tStartMs": 711630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because his injuries might be less severe"
    } ]
  }, {
    "tStartMs": 713910,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "or should the car hit the motorcyclist"
    } ]
  }, {
    "tStartMs": 715540,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "who does not have a helmet on"
    } ]
  }, {
    "tStartMs": 716840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "because he did not\nproperly protect himself?"
    } ]
  }, {
    "tStartMs": 719000,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "If cars were programmed"
    } ]
  }, {
    "tStartMs": 720010,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to hit the motorcyclist with the helmet,"
    } ]
  }, {
    "tStartMs": 722050,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "that would mean that, in a way,"
    } ]
  }, {
    "tStartMs": 723500,
    "dDurationMs": 1808,
    "segs": [ {
      "utf8": "it would become safer to\nride without a helmet."
    } ]
  }, {
    "tStartMs": 725308,
    "dDurationMs": 882,
    "segs": [ {
      "utf8": "(whimsical music)"
    } ]
  }, {
    "tStartMs": 726190,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But the reality is that 99%\nof accidents aren't like that."
    } ]
  }, {
    "tStartMs": 731840,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "Every year, around 1.3\nmillion people are killed"
    } ]
  }, {
    "tStartMs": 735990,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "on the roads, almost all\nof them due to human error."
    } ]
  }, {
    "tStartMs": 739200,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "If autonomous cars can\nreduce these fatalities,"
    } ]
  }, {
    "tStartMs": 742250,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "then the real moral dilemma"
    } ]
  }, {
    "tStartMs": 743680,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "is not getting them on the road sooner"
    } ]
  }, {
    "tStartMs": 745710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "for fear we haven't worked\nout exactly how they'll react"
    } ]
  }, {
    "tStartMs": 748380,
    "dDurationMs": 3893,
    "segs": [ {
      "utf8": "to extremely unlikely\nhypothetical scenarios."
    } ]
  }, {
    "tStartMs": 753460,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "I think humans are becoming worse drivers"
    } ]
  }, {
    "tStartMs": 756420,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "because we're just so\nprone to distraction."
    } ]
  }, {
    "tStartMs": 758808,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(light contemplative music)"
    } ]
  }, {
    "tStartMs": 759641,
    "dDurationMs": 4609,
    "segs": [ {
      "utf8": "Think about the main\nreasons why cars crash:"
    } ]
  }, {
    "tStartMs": 764250,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "because people are speeding,"
    } ]
  }, {
    "tStartMs": 766510,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "they're under the influence,\nthey're distracted."
    } ]
  }, {
    "tStartMs": 770220,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I mean, these sorts of problems,"
    } ]
  }, {
    "tStartMs": 773220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "an autonomous vehicle would not have."
    } ]
  }, {
    "tStartMs": 775350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "You don't get a distracted driver."
    } ]
  }, {
    "tStartMs": 777360,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The ultimate question, right,\nthat everyone wants to know,"
    } ]
  }, {
    "tStartMs": 779700,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that I want to know the answer to is,"
    } ]
  }, {
    "tStartMs": 782130,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "as these vehicles stand,\n(car electronic beeping)"
    } ]
  }, {
    "tStartMs": 783820,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "are they better than the average human?"
    } ]
  }, {
    "tStartMs": 785810,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Not than the best human, but\njust like an average human."
    } ]
  }, {
    "tStartMs": 788590,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Like replacing some\nrandom car on the street"
    } ]
  }, {
    "tStartMs": 791000,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "with one of these vehicles,\ndoes that make the road safer?"
    } ]
  }, {
    "tStartMs": 793860,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "- Yes, it does."
    } ]
  }, {
    "tStartMs": 794920,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "I think we would never\nlaunch a rider-only service"
    } ]
  }, {
    "tStartMs": 799840,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "if we did not meet that\nbase safety framework."
    } ]
  }, {
    "tStartMs": 803290,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "- If that's true, it\nmeans like every vehicle"
    } ]
  }, {
    "tStartMs": 807170,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "that's not on the road is\nkind of a worse situation,"
    } ]
  }, {
    "tStartMs": 811290,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "do you know what I mean?\n- We are really working"
    } ]
  }, {
    "tStartMs": 813160,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "really hard to launch this in larger areas"
    } ]
  }, {
    "tStartMs": 816870,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and new areas too, but we\nneed to have the experience"
    } ]
  }, {
    "tStartMs": 819780,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "to show the regulators\nwhy we believe it's safer,"
    } ]
  }, {
    "tStartMs": 822410,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "and, for that, you need\nto be driving miles,"
    } ]
  }, {
    "tStartMs": 825190,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "a number of miles that\nyou feel comfortable with,"
    } ]
  }, {
    "tStartMs": 828360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "statistically speaking."
    } ]
  }, {
    "tStartMs": 830120,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- These vehicles have way more experience"
    } ]
  }, {
    "tStartMs": 832800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "than any human driver because\nthey've now accumulated data"
    } ]
  }, {
    "tStartMs": 836300,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "over 20 million miles of\ndriving on public roads."
    } ]
  }, {
    "tStartMs": 840770,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "If you were an average driver,"
    } ]
  }, {
    "tStartMs": 842620,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "you'd have to drive for a thousand years"
    } ]
  }, {
    "tStartMs": 845220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to accumulate that sort of experience."
    } ]
  }, {
    "tStartMs": 847140,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And all of that experience can be used"
    } ]
  }, {
    "tStartMs": 849660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to train the systems, to fix the software,"
    } ]
  }, {
    "tStartMs": 851980,
    "dDurationMs": 2383,
    "segs": [ {
      "utf8": "and used across all the\nvehicles in the fleet."
    } ]
  }, {
    "tStartMs": 855770,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "In 2019, Waymo released\na study of its data,"
    } ]
  }, {
    "tStartMs": 858850,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "over 6.1 million miles\nof automated driving"
    } ]
  }, {
    "tStartMs": 861940,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "in the Phoenix, Arizona metropolitan area."
    } ]
  }, {
    "tStartMs": 864610,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Of the 18 total accidents that\noccurred during the study,"
    } ]
  }, {
    "tStartMs": 867700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "none were serious enough"
    } ]
  }, {
    "tStartMs": 869080,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "to expect significant injury or death."
    } ]
  }, {
    "tStartMs": 871580,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "In Waymo's Safety Report,"
    } ]
  }, {
    "tStartMs": 872800,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "they found some types of accidents"
    } ]
  }, {
    "tStartMs": 874810,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "have been completely eliminated"
    } ]
  }, {
    "tStartMs": 877070,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "by this autonomous driving system,"
    } ]
  }, {
    "tStartMs": 879400,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "like the car doesn't go off the road"
    } ]
  }, {
    "tStartMs": 882070,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "and it doesn't hit stationary objects."
    } ]
  }, {
    "tStartMs": 884580,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "Humans, humans do those things."
    } ]
  }, {
    "tStartMs": 887810,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "If you look at the eight\nsignificant accidents"
    } ]
  }, {
    "tStartMs": 891220,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "that happened with Waymo vehicles"
    } ]
  }, {
    "tStartMs": 892700,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "over the six million miles of driving,"
    } ]
  }, {
    "tStartMs": 895810,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "all eight of them involve a human driver"
    } ]
  }, {
    "tStartMs": 898950,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "of another vehicle doing something stupid,"
    } ]
  }, {
    "tStartMs": 901070,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "like driving on the wrong side of the road"
    } ]
  }, {
    "tStartMs": 903480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "or running a red light"
    } ]
  }, {
    "tStartMs": 904920,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "or going through a stop\nsign or failing to yield"
    } ]
  }, {
    "tStartMs": 907870,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "or going 20 miles per\nhour over the speed limit."
    } ]
  }, {
    "tStartMs": 910610,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "There were three incidents\ninvolving Waymo vehicles"
    } ]
  }, {
    "tStartMs": 913830,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "and pedestrians, but in all three,"
    } ]
  }, {
    "tStartMs": 917570,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "the Waymo vehicle was\nstationary and the pedestrian"
    } ]
  }, {
    "tStartMs": 921330,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "or cyclist/skateboarder\nran into the vehicle."
    } ]
  }, {
    "tStartMs": 926936,
    "dDurationMs": 2714,
    "segs": [ {
      "utf8": "Waymo also takes some\nof that real-world data"
    } ]
  }, {
    "tStartMs": 929650,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and they put it into simulations\nand they tweak it a bit."
    } ]
  }, {
    "tStartMs": 933490,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "So they try adding like\na bicyclist going fast"
    } ]
  }, {
    "tStartMs": 936230,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "or going slow, or they make\nthe car turn faster or slower."
    } ]
  }, {
    "tStartMs": 939660,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "So they change all these\nparameters and variables,"
    } ]
  }, {
    "tStartMs": 942670,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "and they see what the software will do."
    } ]
  }, {
    "tStartMs": 944960,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "And they've trained the software"
    } ]
  }, {
    "tStartMs": 946020,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "on an additional 20\nbillion miles of driving,"
    } ]
  }, {
    "tStartMs": 949480,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "not on the road but in the simulation,"
    } ]
  }, {
    "tStartMs": 951700,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "so that's a thousand times\nmore experience again."
    } ]
  }, {
    "tStartMs": 956620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The question for me is,"
    } ]
  }, {
    "tStartMs": 958870,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "when is stepping inside an autonomous car"
    } ]
  }, {
    "tStartMs": 961680,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "gonna feel the same as\nstepping inside an elevator?"
    } ]
  }, {
    "tStartMs": 965710,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "Because I think that\ntime may be coming sooner"
    } ]
  }, {
    "tStartMs": 967820,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "than you think."
    } ]
  }, {
    "tStartMs": 969150,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "I like the idea of this technology,"
    } ]
  }, {
    "tStartMs": 970570,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "but, honestly, getting in the car,"
    } ]
  }, {
    "tStartMs": 971930,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "I wasn't quite sure how I would feel."
    } ]
  }, {
    "tStartMs": 974470,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "I was a little bit uncertain,"
    } ]
  }, {
    "tStartMs": 976010,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "but once I saw it just\nhandles so confidently..."
    } ]
  }, {
    "tStartMs": 979240,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Like driving is one of those things"
    } ]
  }, {
    "tStartMs": 980260,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "that I feel like you can't hide"
    } ]
  }, {
    "tStartMs": 981440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "whether you're a good or bad driver."
    } ]
  }, {
    "tStartMs": 982640,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "It's just like, \"Oh, what's gonna happen"
    } ]
  }, {
    "tStartMs": 984280,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "when there's a parked car or\na cyclist or a pedestrian,\""
    } ]
  }, {
    "tStartMs": 987680,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "and it just sort of handles\nall those situations"
    } ]
  }, {
    "tStartMs": 990310,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "with such confidence and ease"
    } ]
  }, {
    "tStartMs": 992170,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "that I think I stopped thinking about it."
    } ]
  }, {
    "tStartMs": 994610,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "- After they pass a couple\nof your mental tests,"
    } ]
  }, {
    "tStartMs": 996900,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "you're like, \"I'm good.\""
    } ]
  }, {
    "tStartMs": 998230,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "I think, again, \"I'll\nbe okay.\" (chuckling)"
    } ]
  }, {
    "tStartMs": 1000130,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Yeah, yeah, I felt the same way."
    } ]
  }, {
    "tStartMs": 1001900,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "I think a lot of people\nmiss the bigger implications"
    } ]
  }, {
    "tStartMs": 1004250,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "of what is achievable"
    } ]
  }, {
    "tStartMs": 1005390,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "once fully autonomous\ndriving is commonplace."
    } ]
  }, {
    "tStartMs": 1008140,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Riders with disabilities, seniors,"
    } ]
  }, {
    "tStartMs": 1010370,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and the blind can get around more easily."
    } ]
  }, {
    "tStartMs": 1012620,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Transportation will get cheaper."
    } ]
  }, {
    "tStartMs": 1014610,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Think of all the wasted value in the cars"
    } ]
  }, {
    "tStartMs": 1016700,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "that spend over 95% of their time parked."
    } ]
  }, {
    "tStartMs": 1020240,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "We can regain a bunch\nof time and feel happier"
    } ]
  }, {
    "tStartMs": 1023250,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "because commuting and being\nstuck in traffic sucks."
    } ]
  }, {
    "tStartMs": 1027390,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "We can reduce traffic"
    } ]
  }, {
    "tStartMs": 1029010,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "because vehicles will have\nbetter awareness of each other."
    } ]
  }, {
    "tStartMs": 1031840,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "You can imagine one day"
    } ]
  }, {
    "tStartMs": 1033110,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "when all the cars are fully autonomous,"
    } ]
  }, {
    "tStartMs": 1034950,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "they can execute a beautiful\nballet driving together,"
    } ]
  }, {
    "tStartMs": 1038540,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and when that time comes, we\ncan eliminate parking lots"
    } ]
  }, {
    "tStartMs": 1041220,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and add green spaces to our cities."
    } ]
  }, {
    "tStartMs": 1043700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And, most importantly,"
    } ]
  }, {
    "tStartMs": 1044533,
    "dDurationMs": 1887,
    "segs": [ {
      "utf8": "widespread adoption of autonomous cars"
    } ]
  }, {
    "tStartMs": 1046420,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "could prevent tens of\nthousands of fatalities"
    } ]
  }, {
    "tStartMs": 1049010,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "in the U.S. alone."
    } ]
  }, {
    "tStartMs": 1050490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "When do you think that\nthis will be a reality,"
    } ]
  }, {
    "tStartMs": 1053040,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "but clearly it's coming,"
    } ]
  }, {
    "tStartMs": 1054200,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "but when?\n- Yeah."
    } ]
  }, {
    "tStartMs": 1055190,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "If you're talking about big cities,"
    } ]
  }, {
    "tStartMs": 1057460,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "I'm hoping the next five years\nwill be really game changing."
    } ]
  }, {
    "tStartMs": 1060470,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- [Derek] I'm excited to see it."
    } ]
  }, {
    "tStartMs": 1061400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Me too, believe me. Believe me."
    } ]
  }, {
    "tStartMs": 1063110,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I just don't want to\ncommute to work anymore."
    } ]
  }, {
    "tStartMs": 1065210,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I would love to sit in the backseat,"
    } ]
  }, {
    "tStartMs": 1066570,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "do my work on the way there and\non the way back. (chuckling)"
    } ]
  }, {
    "tStartMs": 1069591,
    "dDurationMs": 1571,
    "segs": [ {
      "utf8": "- [Derek] Or do something\nfun, watch a movie."
    } ]
  }, {
    "tStartMs": 1071162,
    "dDurationMs": 1211,
    "segs": [ {
      "utf8": "- Or sleep, yeah. (chuckling)"
    } ]
  }, {
    "tStartMs": 1072373,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(futuristic tones beeping)"
    } ]
  }, {
    "tStartMs": 1073206,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "(frequency tone whistling)"
    } ]
  } ]
}
