{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I am about to get buried in concrete."
    } ]
  }, {
    "tStartMs": 3180,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And while that's happening,"
    } ]
  }, {
    "tStartMs": 4410,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm going to explain\neverything you need to know"
    } ]
  }, {
    "tStartMs": 7410,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "about this substance."
    } ]
  }, {
    "tStartMs": 9360,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So the first thing that I want\nto clear up is the difference"
    } ]
  }, {
    "tStartMs": 11970,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "between cement and concrete,"
    } ]
  }, {
    "tStartMs": 13920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "because people often mix these up, okay?"
    } ]
  }, {
    "tStartMs": 15870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Cement is like the glue."
    } ]
  }, {
    "tStartMs": 17820,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It's the matrix of stuff."
    } ]
  }, {
    "tStartMs": 20280,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Oh there, I feel it."
    } ]
  }, {
    "tStartMs": 21810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Okay, that feels good."
    } ]
  }, {
    "tStartMs": 23850,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Now concrete is cement plus aggregate,"
    } ]
  }, {
    "tStartMs": 27570,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "so plus gravel and sand."
    } ]
  }, {
    "tStartMs": 30060,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And this is filling up\nreally rather quickly."
    } ]
  }, {
    "tStartMs": 33810,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Cement is the most\nimportant man-made substance"
    } ]
  }, {
    "tStartMs": 36840,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "on the planet."
    } ]
  }, {
    "tStartMs": 37890,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "We use more of it than any other\nsubstance apart from water."
    } ]
  }, {
    "tStartMs": 42360,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Every year, 500 kilograms\nof cement are created"
    } ]
  }, {
    "tStartMs": 46800,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "for every man, woman, and child on earth."
    } ]
  }, {
    "tStartMs": 49890,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "And that amount of cement\ncan make two cubic meters"
    } ]
  }, {
    "tStartMs": 53700,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "of concrete, which is about\ntwo of these big fishbowls."
    } ]
  }, {
    "tStartMs": 59160,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "This video is sponsored by Wren."
    } ]
  }, {
    "tStartMs": 61920,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I don't think people realize\njust how important concrete is."
    } ]
  }, {
    "tStartMs": 64710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So here's another way to think about it."
    } ]
  }, {
    "tStartMs": 67020,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Every year, we make a certain\nweight of goods out of copper,"
    } ]
  }, {
    "tStartMs": 70650,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "more out of aluminum,"
    } ]
  }, {
    "tStartMs": 72360,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and then you have glass, asphalt, lime,"
    } ]
  }, {
    "tStartMs": 76110,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "iron is a big one for all the steel,"
    } ]
  }, {
    "tStartMs": 78780,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and then there's ceramic and wood."
    } ]
  }, {
    "tStartMs": 81660,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But by far, the solid\nproduct we make the most of,"
    } ]
  }, {
    "tStartMs": 84600,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "is cementitious material,\nessentially cement."
    } ]
  }, {
    "tStartMs": 88320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "We use as much of it as we do\nall other materials combined."
    } ]
  }, {
    "tStartMs": 93450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And it's easy to see why."
    } ]
  }, {
    "tStartMs": 95730,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Concrete is liquid rock."
    } ]
  }, {
    "tStartMs": 98040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "You can pour it into any shape you like."
    } ]
  }, {
    "tStartMs": 100770,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "It's strong and durable and inexpensive."
    } ]
  }, {
    "tStartMs": 103920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And it is so easy to produce"
    } ]
  }, {
    "tStartMs": 105870,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that people have been\nmaking a version of it"
    } ]
  }, {
    "tStartMs": 107610,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for thousands of years."
    } ]
  }, {
    "tStartMs": 112030,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "To make primitive cement,"
    } ]
  }, {
    "tStartMs": 113290,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the key ingredient is limestone,"
    } ]
  }, {
    "tStartMs": 115570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which is basically calcium carbonate."
    } ]
  }, {
    "tStartMs": 117610,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "If you heat it up to around\n1,000 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 120430,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "that drives off CO2 out of the rock,"
    } ]
  }, {
    "tStartMs": 123280,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "leaving calcium oxide, which\nis also known as quicklime."
    } ]
  }, {
    "tStartMs": 127180,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Now if you grind up the calcium\noxide and mix it with water,"
    } ]
  }, {
    "tStartMs": 130930,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "you get an exothermic reaction"
    } ]
  }, {
    "tStartMs": 132550,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that creates calcium hydroxide,"
    } ]
  }, {
    "tStartMs": 134830,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "which you can pour into a mold."
    } ]
  }, {
    "tStartMs": 137440,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "And over a time, it will\nabsorb CO2 from the atmosphere,"
    } ]
  }, {
    "tStartMs": 141400,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "turning back into calcium\ncarbonate as the water evaporates."
    } ]
  }, {
    "tStartMs": 146620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Now, that's a pretty\ngood primitive cement."
    } ]
  }, {
    "tStartMs": 148420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It's the first way that\npeople ever made cement,"
    } ]
  }, {
    "tStartMs": 151060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "but there are several drawbacks to it."
    } ]
  }, {
    "tStartMs": 152860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I mean, for one thing, you\ncan't make the molds very big"
    } ]
  }, {
    "tStartMs": 155800,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "because otherwise, CO2 can't\npenetrate all of the material"
    } ]
  }, {
    "tStartMs": 159490,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "and harden it."
    } ]
  }, {
    "tStartMs": 160510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Plus, it's not gonna work underwater"
    } ]
  }, {
    "tStartMs": 162340,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "where there is no CO2\nto harden your mixture."
    } ]
  }, {
    "tStartMs": 166270,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The Romans discovered the\nsolution to these problems."
    } ]
  }, {
    "tStartMs": 169150,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "They added volcanic ash called pozzolana"
    } ]
  }, {
    "tStartMs": 171640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to the crushed limestone\nbefore heating it up."
    } ]
  }, {
    "tStartMs": 174100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And they discovered this\ncement was much stronger"
    } ]
  }, {
    "tStartMs": 176770,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and much more durable."
    } ]
  }, {
    "tStartMs": 178390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "They used it"
    } ]
  }, {
    "tStartMs": 179223,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "to create the largest\nunreinforced concrete dome"
    } ]
  }, {
    "tStartMs": 182080,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "in the world, the Pantheon,\nwhich has stood for 2,000 years."
    } ]
  }, {
    "tStartMs": 187360,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "And they built concrete\npiers into the sea,"
    } ]
  }, {
    "tStartMs": 190060,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "which hardened underwater."
    } ]
  }, {
    "tStartMs": 192130,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "Some of which are still standing today."
    } ]
  }, {
    "tStartMs": 195850,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "I did not expect it to feel this heavy,"
    } ]
  }, {
    "tStartMs": 198460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "like it's already really\nweighing down my feet"
    } ]
  }, {
    "tStartMs": 200410,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "and making me slightly concerned"
    } ]
  }, {
    "tStartMs": 201580,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "about being able to get out."
    } ]
  }, {
    "tStartMs": 203770,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "What I can tell you is that\nconcrete is about three times"
    } ]
  }, {
    "tStartMs": 207700,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "as dense as water."
    } ]
  }, {
    "tStartMs": 209830,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Are you able to lift a leg?"
    } ]
  }, {
    "tStartMs": 210970,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I just wanna make sure"
    } ]
  }, {
    "tStartMs": 211803,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "that you're not gonna\nhave like some suction."
    } ]
  }, {
    "tStartMs": 213220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- Yeah, okay, I'm gonna try to lift a leg"
    } ]
  }, {
    "tStartMs": 215050,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "just to see how bad it's gonna be."
    } ]
  }, {
    "tStartMs": 216460,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "What I like is having\nmy feet on the bottom"
    } ]
  }, {
    "tStartMs": 218110,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and I'm not sure I can\nget them back down there"
    } ]
  }, {
    "tStartMs": 219550,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "after I lift it up,"
    } ]
  }, {
    "tStartMs": 220383,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "but oh, boy."
    } ]
  }, {
    "tStartMs": 221500,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Okay, so that was like..."
    } ]
  }, {
    "tStartMs": 223240,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "I'm gonna try to lifting\nthis leg pretty slowly"
    } ]
  }, {
    "tStartMs": 226600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and I was able to lift it."
    } ]
  }, {
    "tStartMs": 228100,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 229210,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So at least up to this\npoint, I am able to get out."
    } ]
  }, {
    "tStartMs": 231940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "My fear is that the concrete is so dense"
    } ]
  }, {
    "tStartMs": 234040,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that when it gets up around my chest,"
    } ]
  }, {
    "tStartMs": 235510,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it may apply a lot of pressure,"
    } ]
  }, {
    "tStartMs": 237040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "making it hard to breathe."
    } ]
  }, {
    "tStartMs": 237873,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "Yeah.\n- It's like being in a trench"
    } ]
  }, {
    "tStartMs": 239890,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "and having it cave in on you."
    } ]
  }, {
    "tStartMs": 241387,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "You cave in your lungs\nso you can't breathe,"
    } ]
  }, {
    "tStartMs": 244240,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "so that once they contract"
    } ]
  }, {
    "tStartMs": 245470,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "and the weight gets against your lungs."
    } ]
  }, {
    "tStartMs": 248350,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- That's gonna be hard."
    } ]
  }, {
    "tStartMs": 249220,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Have you thought about that?"
    } ]
  }, {
    "tStartMs": 250900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Well, now that you mention it."
    } ]
  }, {
    "tStartMs": 252550,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But we do have oxygen\non hand, just in case."
    } ]
  }, {
    "tStartMs": 255550,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Earlier, I practiced how I\ncould get out of the bowl"
    } ]
  }, {
    "tStartMs": 258190,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "if I'm in trouble."
    } ]
  }, {
    "tStartMs": 259600,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Do you feel that's okay?"
    } ]
  }, {
    "tStartMs": 260590,
    "dDurationMs": 951,
    "segs": [ {
      "utf8": "- That's no problem."
    } ]
  }, {
    "tStartMs": 261541,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- Okay, great."
    } ]
  }, {
    "tStartMs": 262461,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(truck signal beeping)"
    } ]
  }, {
    "tStartMs": 271630,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So how did Roman concrete\nharden underwater?"
    } ]
  }, {
    "tStartMs": 274510,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "And in thick slabs that CO2\ncouldn't possibly penetrate?"
    } ]
  }, {
    "tStartMs": 280000,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "There is a claim that it was\nsuperior to modern concrete."
    } ]
  }, {
    "tStartMs": 284260,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "So, was it?"
    } ]
  }, {
    "tStartMs": 286360,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "For centuries, the Roman recipe was lost."
    } ]
  }, {
    "tStartMs": 289600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It was only discovered in a book"
    } ]
  }, {
    "tStartMs": 291280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in a Swiss monastery in the 1400s."
    } ]
  }, {
    "tStartMs": 293800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And since then, architects, scientists,"
    } ]
  }, {
    "tStartMs": 296260,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and engineers have been experimenting"
    } ]
  }, {
    "tStartMs": 298330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "with different cement recipes to try"
    } ]
  }, {
    "tStartMs": 300340,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to achieve the best result."
    } ]
  }, {
    "tStartMs": 302470,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now it turns out that\nthat incredible strength,"
    } ]
  }, {
    "tStartMs": 305230,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "durability, and ability to set underwater"
    } ]
  }, {
    "tStartMs": 307870,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of the Roman cement,"
    } ]
  }, {
    "tStartMs": 309160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that came from the pozzolana,"
    } ]
  }, {
    "tStartMs": 310840,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that volcanic ash that was added."
    } ]
  }, {
    "tStartMs": 313060,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And nearly 2,000 years later,"
    } ]
  }, {
    "tStartMs": 315340,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "people discovered that adding\nclay or shale to the limestone"
    } ]
  }, {
    "tStartMs": 318580,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "before it was crushed and\nheated, produced the same effect."
    } ]
  }, {
    "tStartMs": 322540,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "And the reason is that all of\nthese materials contain silica"
    } ]
  }, {
    "tStartMs": 326080,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "and silica totally changes\nthe chemistry of the cement."
    } ]
  }, {
    "tStartMs": 330190,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It means that it doesn't need\nto dry in order to harden."
    } ]
  }, {
    "tStartMs": 334030,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "In fact, the water\nbecomes an integral part"
    } ]
  }, {
    "tStartMs": 338170,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of that hardened concrete"
    } ]
  }, {
    "tStartMs": 339850,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "so that it actually\nachieves maximum strength"
    } ]
  }, {
    "tStartMs": 342610,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "when it sets underwater."
    } ]
  }, {
    "tStartMs": 346270,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- So this is the compressive\ncylinder curing room."
    } ]
  }, {
    "tStartMs": 349150,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "We're required to maintain\nthe concrete samples"
    } ]
  }, {
    "tStartMs": 351910,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "in 100% humidity."
    } ]
  }, {
    "tStartMs": 353050,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So we've chose to submerge\nthem in water in a lime bath."
    } ]
  }, {
    "tStartMs": 356950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Every time concrete\nsuppliers pour concrete"
    } ]
  }, {
    "tStartMs": 359140,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "on a job site,"
    } ]
  }, {
    "tStartMs": 360250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "they cast sample cylinders of the material"
    } ]
  }, {
    "tStartMs": 362380,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "so they can later test it"
    } ]
  }, {
    "tStartMs": 363640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to ensure it has the strength required."
    } ]
  }, {
    "tStartMs": 366010,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- So we actually intercept a little bit"
    } ]
  }, {
    "tStartMs": 367570,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "of the concrete going"
    } ]
  }, {
    "tStartMs": 368410,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "into whatever structure they're pouring:"
    } ]
  }, {
    "tStartMs": 369880,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "a slab, a wall."
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "We'll intercept it into a wheelbarrow,"
    } ]
  }, {
    "tStartMs": 372850,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "take the wheelbarrow over\nto our testing station,"
    } ]
  }, {
    "tStartMs": 374770,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and start casting these\ncompressive cylinders."
    } ]
  }, {
    "tStartMs": 377350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Every day we're breaking these cylinders,"
    } ]
  }, {
    "tStartMs": 378910,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "checking it for strength."
    } ]
  }, {
    "tStartMs": 379930,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You can see these have been broken today."
    } ]
  }, {
    "tStartMs": 381910,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- This strength increases over time,"
    } ]
  }, {
    "tStartMs": 384100,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "so samples are tested\nat 7, 14, and 28 days"
    } ]
  }, {
    "tStartMs": 388480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "when the concrete is said to\nhave reached full strength."
    } ]
  }, {
    "tStartMs": 391480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- So what we do is we list the date"
    } ]
  }, {
    "tStartMs": 393940,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that there will be placed\nin the compression machine"
    } ]
  }, {
    "tStartMs": 395950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "on top of every cylinder."
    } ]
  }, {
    "tStartMs": 397450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- In reality, it will\ncontinue strengthening"
    } ]
  }, {
    "tStartMs": 399970,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "after that."
    } ]
  }, {
    "tStartMs": 402790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Samples are placed in a hydraulic press"
    } ]
  }, {
    "tStartMs": 405160,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and then the pressure is\nincreased on them until they fail."
    } ]
  }, {
    "tStartMs": 408610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- All right, ready?\n- Yeah, let's do it."
    } ]
  }, {
    "tStartMs": 409443,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "- I'll start loading.\n- Sure."
    } ]
  }, {
    "tStartMs": 411070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- We want to maintain\naround 30 psi per second."
    } ]
  }, {
    "tStartMs": 413650,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- And it's important to load at that rate."
    } ]
  }, {
    "tStartMs": 415570,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Yeah, you don't want to shock it."
    } ]
  }, {
    "tStartMs": 416890,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "You don't want to shock it"
    } ]
  }, {
    "tStartMs": 417760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "by applying too much load too fast."
    } ]
  }, {
    "tStartMs": 419890,
    "dDurationMs": 2011,
    "segs": [ {
      "utf8": "This middle number is\nshowing us our strength"
    } ]
  }, {
    "tStartMs": 421901,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "in pounds per square inch."
    } ]
  }, {
    "tStartMs": 424150,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "And then the top number,"
    } ]
  }, {
    "tStartMs": 425080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the big number is showing us the force"
    } ]
  }, {
    "tStartMs": 426940,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "of pounds we're applying."
    } ]
  }, {
    "tStartMs": 428260,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "- What are we gonna get\nup to, like 7,000 psi?"
    } ]
  }, {
    "tStartMs": 430413,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- 10,000."
    } ]
  }, {
    "tStartMs": 431246,
    "dDurationMs": 1154,
    "segs": [ {
      "utf8": "- 10,000."
    } ]
  }, {
    "tStartMs": 432400,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So this is gonna be really strong."
    } ]
  }, {
    "tStartMs": 433780,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Very strong."
    } ]
  }, {
    "tStartMs": 434770,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Okay.\n- Yeah."
    } ]
  }, {
    "tStartMs": 435730,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- It's always fun when we get something"
    } ]
  }, {
    "tStartMs": 436840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "over 10,000 in a free show."
    } ]
  }, {
    "tStartMs": 439960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Bang!"
    } ]
  }, {
    "tStartMs": 440793,
    "dDurationMs": 1887,
    "segs": [ {
      "utf8": "- It'll shake this room."
    } ]
  }, {
    "tStartMs": 442680,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "- And it has reinforced concrete walls."
    } ]
  }, {
    "tStartMs": 447040,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "- It's amazingly just like you\ncan't see anything happening"
    } ]
  }, {
    "tStartMs": 451960,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "even under all that pressure."
    } ]
  }, {
    "tStartMs": 454450,
    "dDurationMs": 1336,
    "segs": [ {
      "utf8": "- It's still holding."
    } ]
  }, {
    "tStartMs": 455786,
    "dDurationMs": 1091,
    "segs": [ {
      "utf8": "- I know, right?"
    } ]
  }, {
    "tStartMs": 456877,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh, here it goes."
    } ]
  }, {
    "tStartMs": 457710,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It's starting to dry.\n- Really?"
    } ]
  }, {
    "tStartMs": 458543,
    "dDurationMs": 1287,
    "segs": [ {
      "utf8": "- Here it goes.\n- 11,000."
    } ]
  }, {
    "tStartMs": 459830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Mm-hmm."
    } ]
  }, {
    "tStartMs": 461890,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "- Over 11,000 now."
    } ]
  }, {
    "tStartMs": 465091,
    "dDurationMs": 2079,
    "segs": [ {
      "utf8": "(cement cylinder pops)"
    } ]
  }, {
    "tStartMs": 467170,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "Oh yeah!"
    } ]
  }, {
    "tStartMs": 468689,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It still got a life."
    } ]
  }, {
    "tStartMs": 469522,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "Having it, it didn't even-\n- Fun."
    } ]
  }, {
    "tStartMs": 471539,
    "dDurationMs": 914,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 472453,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "- It's my favorite part."
    } ]
  }, {
    "tStartMs": 473762,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(cement cylinder blows)"
    } ]
  }, {
    "tStartMs": 479722,
    "dDurationMs": 1997,
    "segs": [ {
      "utf8": "- Yeah, that's cool!"
    } ]
  }, {
    "tStartMs": 481719,
    "dDurationMs": 1144,
    "segs": [ {
      "utf8": "- Let's see.\n- Yeah, I like that."
    } ]
  }, {
    "tStartMs": 482863,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "- Like the strongest\nconcrete in the world."
    } ]
  }, {
    "tStartMs": 485230,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Well, the strongest concrete"
    } ]
  }, {
    "tStartMs": 486063,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "in the world is gonna be\nlike a lab-only thing."
    } ]
  }, {
    "tStartMs": 488980,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "- In a competition, it\nwas above 100,000 psi."
    } ]
  }, {
    "tStartMs": 493210,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Today, virtually all concrete is made"
    } ]
  }, {
    "tStartMs": 495250,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "with a cement formulation\ndiscovered in the 1840s."
    } ]
  }, {
    "tStartMs": 497950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's known as Portland cement,"
    } ]
  }, {
    "tStartMs": 500110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but the name is really\njust a marketing term."
    } ]
  }, {
    "tStartMs": 502690,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "You know, they claimed that the gray color"
    } ]
  }, {
    "tStartMs": 504910,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "of the cement would resemble\nthese very desirable rocks,"
    } ]
  }, {
    "tStartMs": 508540,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "which were quarried near the\ntown of Portland, England."
    } ]
  }, {
    "tStartMs": 512050,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "But the Portland cement was\nmade by crushing up limestone"
    } ]
  }, {
    "tStartMs": 515620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and then mixing it with\na certain percentage"
    } ]
  }, {
    "tStartMs": 517720,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "of shale or clay to provide the silicates."
    } ]
  }, {
    "tStartMs": 520900,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And that was all ground\nup into a fine powder"
    } ]
  }, {
    "tStartMs": 523450,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and put in a kiln and heated\nto very high temperatures."
    } ]
  }, {
    "tStartMs": 526990,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "And what comes out are these\nnodules that are really hard."
    } ]
  }, {
    "tStartMs": 531340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "They're called clinker."
    } ]
  }, {
    "tStartMs": 532870,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Now, it's suspected that cement chemists"
    } ]
  }, {
    "tStartMs": 534490,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "in the past may have\nproduced clinker by accident"
    } ]
  }, {
    "tStartMs": 536980,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "when they overcooked their lime mixtures."
    } ]
  }, {
    "tStartMs": 539530,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But since this clinker\nis so hard to grind down,"
    } ]
  }, {
    "tStartMs": 543070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they just considered it waste."
    } ]
  }, {
    "tStartMs": 545380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But if you do grind it down,"
    } ]
  }, {
    "tStartMs": 547120,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the cement that it\nproduces is far superior"
    } ]
  }, {
    "tStartMs": 550210,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to basically any other\nchemistry we've discovered,"
    } ]
  }, {
    "tStartMs": 552970,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which is why it is so commonly used today."
    } ]
  }, {
    "tStartMs": 555820,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Now there are lots of compounds\ninside Portland cement."
    } ]
  }, {
    "tStartMs": 558910,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "The most common one is\ntricalcium silicate."
    } ]
  }, {
    "tStartMs": 563590,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "I'm now feeling incredibly buoyant,"
    } ]
  }, {
    "tStartMs": 566500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "like I am now floating in concrete,"
    } ]
  }, {
    "tStartMs": 569020,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "which is pretty ridiculous"
    } ]
  }, {
    "tStartMs": 570220,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "because most of my body\nis out of the material."
    } ]
  }, {
    "tStartMs": 573790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But because it's three\ntimes as dense as water,"
    } ]
  }, {
    "tStartMs": 576160,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "you can float just up to your waist."
    } ]
  }, {
    "tStartMs": 579250,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This is totally unexpected."
    } ]
  }, {
    "tStartMs": 580750,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "I did not expect to be able\nto, like, float in concrete."
    } ]
  }, {
    "tStartMs": 583960,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "My feet are off the floor."
    } ]
  }, {
    "tStartMs": 585250,
    "dDurationMs": 2087,
    "segs": [ {
      "utf8": "That's where my feet are."
    } ]
  }, {
    "tStartMs": 587337,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "- My feet are here and my shoulders are up"
    } ]
  }, {
    "tStartMs": 588880,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and I'm just being pushed up out of this."
    } ]
  }, {
    "tStartMs": 592780,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Once you have the cement powder,"
    } ]
  }, {
    "tStartMs": 594340,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the other things you need to make concrete"
    } ]
  }, {
    "tStartMs": 595960,
    "dDurationMs": 2754,
    "segs": [ {
      "utf8": "are the aggregates, sand, and gravel."
    } ]
  }, {
    "tStartMs": 598714,
    "dDurationMs": 2016,
    "segs": [ {
      "utf8": "(quarry blasting)"
    } ]
  }, {
    "tStartMs": 600730,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "These are blasted out of a quarry."
    } ]
  }, {
    "tStartMs": 604600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Then they're ground up\nto be particular sizes."
    } ]
  }, {
    "tStartMs": 607690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "There are very strict\nrequirements about the sizes"
    } ]
  }, {
    "tStartMs": 610000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and shapes of the aggregate,"
    } ]
  }, {
    "tStartMs": 611830,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "which is gonna get\npoured into the concrete"
    } ]
  }, {
    "tStartMs": 613210,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "because, of course, that\nwill affect the strength"
    } ]
  }, {
    "tStartMs": 616240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "of the concrete that results."
    } ]
  }, {
    "tStartMs": 617770,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "- Yeah, this is a just a\nwell-grated concrete sand."
    } ]
  }, {
    "tStartMs": 621880,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The most well-rounded\nmaterial helps the contractor"
    } ]
  }, {
    "tStartMs": 624790,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "as far as their finishability goes."
    } ]
  }, {
    "tStartMs": 627333,
    "dDurationMs": 1507,
    "segs": [ {
      "utf8": "- You know when they're running\nthat trowel over that slab,"
    } ]
  }, {
    "tStartMs": 628840,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "they want a rounded particle,"
    } ]
  }, {
    "tStartMs": 630490,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "not a jagged crushed particle."
    } ]
  }, {
    "tStartMs": 632410,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Do you really want\nlike a spherical sand?"
    } ]
  }, {
    "tStartMs": 634660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Around it, yeah,"
    } ]
  }, {
    "tStartMs": 635493,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "a spherical sand,"
    } ]
  }, {
    "tStartMs": 636326,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "like a river stone,"
    } ]
  }, {
    "tStartMs": 637930,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "like a river sand."
    } ]
  }, {
    "tStartMs": 639490,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Designers on the strip want\nto pour concrete elevated."
    } ]
  }, {
    "tStartMs": 642520,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They want to lighten up\nthe load of the deck."
    } ]
  }, {
    "tStartMs": 644980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We'll incorporate some\nlightweight aggregate"
    } ]
  }, {
    "tStartMs": 647080,
    "dDurationMs": 1562,
    "segs": [ {
      "utf8": "in place of this normal weight."
    } ]
  }, {
    "tStartMs": 648642,
    "dDurationMs": 2608,
    "segs": [ {
      "utf8": "(rocks rattling)"
    } ]
  }, {
    "tStartMs": 651250,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "3/8 size."
    } ]
  }, {
    "tStartMs": 652330,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Typical concrete will weigh\n150 pounds per cubic foot,"
    } ]
  }, {
    "tStartMs": 655360,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "normal weight."
    } ]
  }, {
    "tStartMs": 656260,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "This gets us about 110\npounds per cubic foot."
    } ]
  }, {
    "tStartMs": 666430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- The aggregates are hauled\nto the concrete plant"
    } ]
  }, {
    "tStartMs": 668380,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "in big trucks."
    } ]
  }, {
    "tStartMs": 669370,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "All right, I'm gonna release the rock,"
    } ]
  }, {
    "tStartMs": 670990,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "(hydraulics hissing)"
    } ]
  }, {
    "tStartMs": 673300,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "where they're dumped"
    } ]
  }, {
    "tStartMs": 674301,
    "dDurationMs": 3499,
    "segs": [ {
      "utf8": "(rocks rattling)"
    } ]
  }, {
    "tStartMs": 677800,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "and then they travel"
    } ]
  }, {
    "tStartMs": 678670,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "on big conveyor belts\nup into storage piles."
    } ]
  }, {
    "tStartMs": 682240,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "These get loaded into big hoppers"
    } ]
  }, {
    "tStartMs": 684490,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and then weighed out and\npoured into the trucks."
    } ]
  }, {
    "tStartMs": 687340,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Control operators can open this gate"
    } ]
  }, {
    "tStartMs": 689230,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and drop material into this hopper,"
    } ]
  }, {
    "tStartMs": 691810,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "down into the mixer truck below."
    } ]
  }, {
    "tStartMs": 695590,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "This is where the batch\noperator's controlling the plant."
    } ]
  }, {
    "tStartMs": 700480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Right here in front of our\nbatch operator, William,"
    } ]
  }, {
    "tStartMs": 702760,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "is the actual recipe\nthat he's gonna dispense"
    } ]
  }, {
    "tStartMs": 705280,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "into the concrete mixer."
    } ]
  }, {
    "tStartMs": 706900,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Each line represents a different\ncomponent in the concrete."
    } ]
  }, {
    "tStartMs": 710080,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "That top one there is a 3/4 rock."
    } ]
  }, {
    "tStartMs": 712270,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We have an intermediate 3/8 rock below it"
    } ]
  }, {
    "tStartMs": 714370,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "and there's your sand."
    } ]
  }, {
    "tStartMs": 715360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Over here in this column,"
    } ]
  }, {
    "tStartMs": 717070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "he's targeting, for instance, 3/4 rock."
    } ]
  }, {
    "tStartMs": 719650,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "He wants to hit 13,000 pounds\nof material for that load."
    } ]
  }, {
    "tStartMs": 724480,
    "dDurationMs": 4893,
    "segs": [ {
      "utf8": "The computer's gonna try to\nhit 13,042 pounds of 3/4 rock."
    } ]
  }, {
    "tStartMs": 731680,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- So everything's..."
    } ]
  }, {
    "tStartMs": 733090,
    "dDurationMs": 865,
    "segs": [ {
      "utf8": "- Everything's weighed up-"
    } ]
  }, {
    "tStartMs": 733955,
    "dDurationMs": 988,
    "segs": [ {
      "utf8": "- Filling up?\n- Right now."
    } ]
  }, {
    "tStartMs": 735880,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Now if he goes out tolerance"
    } ]
  }, {
    "tStartMs": 737230,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and he overshoots a target,"
    } ]
  }, {
    "tStartMs": 738460,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it's gonna change the red,"
    } ]
  }, {
    "tStartMs": 739990,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "a red color."
    } ]
  }, {
    "tStartMs": 741790,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Up here on this screen,"
    } ]
  }, {
    "tStartMs": 742870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "we're actually showing the holding hopper."
    } ]
  }, {
    "tStartMs": 745060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "This material he's weighing is directly"
    } ]
  }, {
    "tStartMs": 747310,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "above the mixer truck that\njust pulled under the plant."
    } ]
  }, {
    "tStartMs": 751240,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- What about the water, William,"
    } ]
  }, {
    "tStartMs": 753100,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "being orange?"
    } ]
  }, {
    "tStartMs": 754510,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "- Yeah, we're a little under on that."
    } ]
  }, {
    "tStartMs": 755864,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 756697,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "- But we can always add little water."
    } ]
  }, {
    "tStartMs": 758770,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 759603,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "- We cannot take it away."
    } ]
  }, {
    "tStartMs": 762640,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "All right, I'm gonna take a\nlook inside the truck here."
    } ]
  }, {
    "tStartMs": 765720,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "(rotary gears whining)"
    } ]
  }, {
    "tStartMs": 768340,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "That's what it looks like\ndown inside a cement truck."
    } ]
  }, {
    "tStartMs": 773110,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So I was interested to see\nwhat would be the difference"
    } ]
  }, {
    "tStartMs": 775390,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "in strength between pure\ncement, cement with sand,"
    } ]
  }, {
    "tStartMs": 778750,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and cement with sand and gravel"
    } ]
  }, {
    "tStartMs": 780550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "like the typical concrete\nmix that they would make."
    } ]
  }, {
    "tStartMs": 782740,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So I had them make up\nthese special cylinders"
    } ]
  }, {
    "tStartMs": 784930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and test them in the hydraulic press."
    } ]
  }, {
    "tStartMs": 787000,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "You might think that since\npure cement has the most glue,"
    } ]
  }, {
    "tStartMs": 789910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it would be the strongest."
    } ]
  }, {
    "tStartMs": 791230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Cement's the magic, right?"
    } ]
  }, {
    "tStartMs": 793210,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "The glue."
    } ]
  }, {
    "tStartMs": 794260,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So if we lessen"
    } ]
  }, {
    "tStartMs": 795490,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or lower the amount of\ncement per unit volume,"
    } ]
  }, {
    "tStartMs": 798070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "we're gonna have less strength."
    } ]
  }, {
    "tStartMs": 799450,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- [Derek] But when we tested\nthe pure cement cylinder,"
    } ]
  }, {
    "tStartMs": 801550,
    "dDurationMs": 2479,
    "segs": [ {
      "utf8": "it fractured a lot as\nthe load was applied."
    } ]
  }, {
    "tStartMs": 804029,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "(cement cylinder pops)"
    } ]
  }, {
    "tStartMs": 805390,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Is that it?"
    } ]
  }, {
    "tStartMs": 806320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 807153,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "- Not officially.\n- Looks like it keep going."
    } ]
  }, {
    "tStartMs": 808390,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It can take some more pressure."
    } ]
  }, {
    "tStartMs": 809650,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 810493,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "(cement cylinder pops)"
    } ]
  }, {
    "tStartMs": 811630,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- 8,000 psi,"
    } ]
  }, {
    "tStartMs": 812770,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "now it failed."
    } ]
  }, {
    "tStartMs": 814570,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "- Now, cement plus sand."
    } ]
  }, {
    "tStartMs": 817389,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "(cement cylinder blows)"
    } ]
  }, {
    "tStartMs": 820600,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "9,163 psi\n- Again."
    } ]
  }, {
    "tStartMs": 823303,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Edit the prediction."
    } ]
  }, {
    "tStartMs": 824470,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Oh, my prediction was based"
    } ]
  }, {
    "tStartMs": 825760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "on the strength it was two weeks ago,"
    } ]
  }, {
    "tStartMs": 829120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "which we have here."
    } ]
  }, {
    "tStartMs": 831250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "We got 14 days of 6,600."
    } ]
  }, {
    "tStartMs": 833530,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So, you know, reason would\nbe it'd probably break"
    } ]
  }, {
    "tStartMs": 835810,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "another 1000 psi above that,"
    } ]
  }, {
    "tStartMs": 837310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but it definitely gained a lot."
    } ]
  }, {
    "tStartMs": 839440,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- And finally, cement\nplus sand and gravel."
    } ]
  }, {
    "tStartMs": 842200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "This is the normal concrete mix."
    } ]
  }, {
    "tStartMs": 844964,
    "dDurationMs": 1195,
    "segs": [ {
      "utf8": "(cement cylinder pops)"
    } ]
  }, {
    "tStartMs": 846159,
    "dDurationMs": 931,
    "segs": [ {
      "utf8": "Is that it?"
    } ]
  }, {
    "tStartMs": 847090,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "No?"
    } ]
  }, {
    "tStartMs": 848466,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- A part of it."
    } ]
  }, {
    "tStartMs": 850917,
    "dDurationMs": 943,
    "segs": [ {
      "utf8": "(glass shatters)"
    } ]
  }, {
    "tStartMs": 851860,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoa!"
    } ]
  }, {
    "tStartMs": 853720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay, so that's it."
    } ]
  }, {
    "tStartMs": 854553,
    "dDurationMs": 1324,
    "segs": [ {
      "utf8": "- That's it.\n- We'll take it."
    } ]
  }, {
    "tStartMs": 855877,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "- That's it."
    } ]
  }, {
    "tStartMs": 856912,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(cement cylinder blows)"
    } ]
  }, {
    "tStartMs": 861390,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "- So it did fail at 8,300."
    } ]
  }, {
    "tStartMs": 865210,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 866200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I was surprised to see that\nall the cylinders broke"
    } ]
  }, {
    "tStartMs": 868630,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "under about the same pressure."
    } ]
  }, {
    "tStartMs": 870010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "I think, to me, really interesting"
    } ]
  }, {
    "tStartMs": 871480,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "that you could have all\nof that cement, right?"
    } ]
  }, {
    "tStartMs": 874870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But you don't get appreciably..."
    } ]
  }, {
    "tStartMs": 876820,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Right.\n- Stronger than like this"
    } ]
  }, {
    "tStartMs": 879130,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "or that."
    } ]
  }, {
    "tStartMs": 880750,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Cement is the most\nexpensive part of concrete."
    } ]
  }, {
    "tStartMs": 883570,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So if you can get away\nwith reducing it down"
    } ]
  }, {
    "tStartMs": 885430,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "to 30% in the mix"
    } ]
  }, {
    "tStartMs": 886540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and still get the same\nstrength characteristics,"
    } ]
  }, {
    "tStartMs": 888700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "well then you should definitely do that."
    } ]
  }, {
    "tStartMs": 891160,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The other thing that was\ninteresting was pure cement seemed"
    } ]
  }, {
    "tStartMs": 893410,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to flake and chip more as it was loaded."
    } ]
  }, {
    "tStartMs": 896770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So it seemed like adding the aggregate"
    } ]
  }, {
    "tStartMs": 898420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "actually helped the sample cohere"
    } ]
  }, {
    "tStartMs": 900520,
    "dDurationMs": 3013,
    "segs": [ {
      "utf8": "and stay together even\nunder all that load."
    } ]
  }, {
    "tStartMs": 903533,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(cement cylinder blows)"
    } ]
  }, {
    "tStartMs": 907780,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "So was Roman concrete\nsuperior to modern concrete?"
    } ]
  }, {
    "tStartMs": 912010,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Well, the answer is no in short."
    } ]
  }, {
    "tStartMs": 914560,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "I mean there were some\nsurprising advantages"
    } ]
  }, {
    "tStartMs": 917050,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that Roman concrete had."
    } ]
  }, {
    "tStartMs": 918070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "For example,"
    } ]
  }, {
    "tStartMs": 918903,
    "dDurationMs": 3007,
    "segs": [ {
      "utf8": "it was actually less well-mixed\nthan modern concrete."
    } ]
  }, {
    "tStartMs": 921910,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "So there were little blocks\nof undissolved calcium oxide"
    } ]
  }, {
    "tStartMs": 926770,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "or quicklime that remained\ninside Roman concrete."
    } ]
  }, {
    "tStartMs": 930340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And then what happened is\nwhen the concrete cracked"
    } ]
  }, {
    "tStartMs": 932530,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and water got in there,"
    } ]
  }, {
    "tStartMs": 933730,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it would dissolve that calcium oxide,"
    } ]
  }, {
    "tStartMs": 936130,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "forming calcium hydroxide,"
    } ]
  }, {
    "tStartMs": 937660,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and then you would get the new\ngrowth of calcium carbonate."
    } ]
  }, {
    "tStartMs": 941560,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So Roman concrete was\nactually self-healing."
    } ]
  }, {
    "tStartMs": 945130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "That's kind of a fascinating advantage."
    } ]
  }, {
    "tStartMs": 948070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But I would say by and large, you know,"
    } ]
  }, {
    "tStartMs": 949930,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "when we look back at the Roman structures,"
    } ]
  }, {
    "tStartMs": 951400,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "we only see the ones that\nhave survived to this day."
    } ]
  }, {
    "tStartMs": 953290,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So there is a survivor bias."
    } ]
  }, {
    "tStartMs": 955510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And finally, there's the issue of cost."
    } ]
  }, {
    "tStartMs": 957460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "We could make very strong concretes"
    } ]
  }, {
    "tStartMs": 959320,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that could last an incredibly long time"
    } ]
  }, {
    "tStartMs": 961660,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but we choose not to\nbecause it's just cheaper"
    } ]
  }, {
    "tStartMs": 964540,
    "dDurationMs": 2573,
    "segs": [ {
      "utf8": "and we don't expect our\nbuildings to last that long."
    } ]
  }, {
    "tStartMs": 968530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Before the concrete goes out on site,"
    } ]
  }, {
    "tStartMs": 970450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they have to make sure\nit's the right consistency"
    } ]
  }, {
    "tStartMs": 972370,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "for the customer;"
    } ]
  }, {
    "tStartMs": 973240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "not too dry and not too runny."
    } ]
  }, {
    "tStartMs": 975880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This can be adjusted with water"
    } ]
  }, {
    "tStartMs": 977800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "but you don't really wanna do that"
    } ]
  }, {
    "tStartMs": 979330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because that can also affect the strength."
    } ]
  }, {
    "tStartMs": 981460,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "So here, they use modern\nchemicals like superplasticizers."
    } ]
  }, {
    "tStartMs": 985660,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Up here on the top left,"
    } ]
  }, {
    "tStartMs": 986830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you have our dispensing units"
    } ]
  }, {
    "tStartMs": 988690,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "for all our chemical add mixtures."
    } ]
  }, {
    "tStartMs": 991180,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- And that's what they're adding now"
    } ]
  }, {
    "tStartMs": 992620,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "of superplasticizer."
    } ]
  }, {
    "tStartMs": 993850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It makes the concrete easier\nto work and spread around"
    } ]
  }, {
    "tStartMs": 996640,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "without really changing the\nwater content very much."
    } ]
  }, {
    "tStartMs": 999730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "To check that the consistency is right,"
    } ]
  }, {
    "tStartMs": 1001410,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "they perform something called\na slump test or spread test."
    } ]
  }, {
    "tStartMs": 1004770,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "- We're gonna fill the cone\nto the top nice and level,"
    } ]
  }, {
    "tStartMs": 1010140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and we're gonna pull that metal cone off."
    } ]
  }, {
    "tStartMs": 1012450,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Measure the distance it\ntravels on the board."
    } ]
  }, {
    "tStartMs": 1014910,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- The concrete they're pouring on me"
    } ]
  }, {
    "tStartMs": 1016800,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "should have a spread of 27 inches."
    } ]
  }, {
    "tStartMs": 1020730,
    "dDurationMs": 1391,
    "segs": [ {
      "utf8": "- We're gonna measure it both sides."
    } ]
  }, {
    "tStartMs": 1022121,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(crew member cheering)"
    } ]
  }, {
    "tStartMs": 1022954,
    "dDurationMs": 2072,
    "segs": [ {
      "utf8": "Right on a 27 on that one."
    } ]
  }, {
    "tStartMs": 1025026,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1025859,
    "dDurationMs": 1591,
    "segs": [ {
      "utf8": "- And go this way,"
    } ]
  }, {
    "tStartMs": 1027450,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "right on a 27 on that one."
    } ]
  }, {
    "tStartMs": 1030270,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- So why is it so important"
    } ]
  }, {
    "tStartMs": 1031260,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that you got the right\nconsistency of concrete?"
    } ]
  }, {
    "tStartMs": 1033390,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- You don't want it too dry."
    } ]
  }, {
    "tStartMs": 1034980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "You want it wet enough to flow"
    } ]
  }, {
    "tStartMs": 1037020,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and fill up whatever container\nyou're trying to fill,"
    } ]
  }, {
    "tStartMs": 1039840,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "in this case, the sphere with you in it."
    } ]
  }, {
    "tStartMs": 1043140,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- So the question you're\nprobably wondering is,"
    } ]
  }, {
    "tStartMs": 1044850,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "how long can I stay in here\nbefore the concrete hardens?"
    } ]
  }, {
    "tStartMs": 1048450,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "The usual answer is about\nfour hours without agitation."
    } ]
  }, {
    "tStartMs": 1052140,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And that's why when you\nsee concrete trucks driving"
    } ]
  }, {
    "tStartMs": 1054270,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "down the road, that drum has to be turning"
    } ]
  }, {
    "tStartMs": 1056580,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to keep the concrete agitated"
    } ]
  }, {
    "tStartMs": 1058170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and prevent it from setting up."
    } ]
  }, {
    "tStartMs": 1060000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But what happens if the truck breaks down"
    } ]
  }, {
    "tStartMs": 1062340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "or there's a traffic\njam or something breaks,"
    } ]
  }, {
    "tStartMs": 1065340,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "then, at times, concrete\ndoes harden inside the drum"
    } ]
  }, {
    "tStartMs": 1068700,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "of these trucks and that\nis a terrible outcome."
    } ]
  }, {
    "tStartMs": 1071670,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But there is one thing you can do"
    } ]
  }, {
    "tStartMs": 1073440,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to slow the concrete down from setting"
    } ]
  }, {
    "tStartMs": 1076350,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "and that is to add some\nregular pop like Coke."
    } ]
  }, {
    "tStartMs": 1082140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The sugars inside this coke"
    } ]
  }, {
    "tStartMs": 1084570,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "actually prevent the setting\nup process from happening"
    } ]
  }, {
    "tStartMs": 1089010,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and that can buy you a few hours."
    } ]
  }, {
    "tStartMs": 1091680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So apparently these truck drivers,"
    } ]
  }, {
    "tStartMs": 1093690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "they drive around with a\nfew two-liter bottles of pop"
    } ]
  }, {
    "tStartMs": 1097140,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "inside their cab"
    } ]
  }, {
    "tStartMs": 1098610,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and so they can dump it in\ntheir load if they have to"
    } ]
  }, {
    "tStartMs": 1101640,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "to prevent it from setting up."
    } ]
  }, {
    "tStartMs": 1102810,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "So hopefully that means\nI'll get out okay too."
    } ]
  }, {
    "tStartMs": 1108240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "But how does concrete actually harden?"
    } ]
  }, {
    "tStartMs": 1111150,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Well, you have the dry\nmixture of gravel, sand,"
    } ]
  }, {
    "tStartMs": 1114090,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and cement powder and then you add water."
    } ]
  }, {
    "tStartMs": 1117660,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The water starts dissolving\nthe cement powder grains,"
    } ]
  }, {
    "tStartMs": 1120810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so ions enter solution,"
    } ]
  }, {
    "tStartMs": 1123090,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and some of those ions\nare calcium hydroxide."
    } ]
  }, {
    "tStartMs": 1126390,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "So that's what makes concrete\na very basic solution."
    } ]
  }, {
    "tStartMs": 1130800,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "What do you see?"
    } ]
  }, {
    "tStartMs": 1132120,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- We're approaching 12, 11.8."
    } ]
  }, {
    "tStartMs": 1135180,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "- So the pH of concrete\ncan get up to 12 or 13."
    } ]
  }, {
    "tStartMs": 1139620,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "The pH of this is 11.8 and\nthat's incredibly basic,"
    } ]
  }, {
    "tStartMs": 1143910,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which means if it's on your\nskin, if it's on your body,"
    } ]
  }, {
    "tStartMs": 1146130,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "it can be dissolving your skin and cells."
    } ]
  }, {
    "tStartMs": 1150210,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Being buried in concrete\nis sort of like jumping"
    } ]
  }, {
    "tStartMs": 1152760,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in a bath of bleach."
    } ]
  }, {
    "tStartMs": 1154260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And that's why I'm\nactually wearing a dry suit"
    } ]
  }, {
    "tStartMs": 1156540,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and some latex gloves."
    } ]
  }, {
    "tStartMs": 1158100,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Yeah, it's not something\nyou want to try at home."
    } ]
  }, {
    "tStartMs": 1159960,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So do not try swimming in concrete."
    } ]
  }, {
    "tStartMs": 1163800,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So now the ions are\ndissolved in the solution."
    } ]
  }, {
    "tStartMs": 1166860,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And remember, the most common compound"
    } ]
  }, {
    "tStartMs": 1168510,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "in cement is tricalcium silicate."
    } ]
  }, {
    "tStartMs": 1171480,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "As it reacts with the water,"
    } ]
  }, {
    "tStartMs": 1173370,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "crystals start to form of\ncalcium silicate hydrates,"
    } ]
  }, {
    "tStartMs": 1177480,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "plus other hydrate minerals."
    } ]
  }, {
    "tStartMs": 1179700,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "And all these crystals grow\nand become interlocking,"
    } ]
  }, {
    "tStartMs": 1183690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "causing the concrete to harden."
    } ]
  }, {
    "tStartMs": 1186000,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Note that the water is essential"
    } ]
  }, {
    "tStartMs": 1187740,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to the formation of these crystals."
    } ]
  }, {
    "tStartMs": 1189930,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So water is not evaporating,"
    } ]
  }, {
    "tStartMs": 1192030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "it's not drying out."
    } ]
  }, {
    "tStartMs": 1193680,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "It's actually becoming part of\nthe solid concrete material."
    } ]
  }, {
    "tStartMs": 1197760,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And that's why this chemistry\nis called cement hydration."
    } ]
  }, {
    "tStartMs": 1201210,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It's also why freshly poured\nconcrete should be kept"
    } ]
  }, {
    "tStartMs": 1203670,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "in as damp an environment as possible."
    } ]
  }, {
    "tStartMs": 1208620,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Las Vegas is so dry they\nfrequently set up misters"
    } ]
  }, {
    "tStartMs": 1211320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to spray around new concrete"
    } ]
  }, {
    "tStartMs": 1213360,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "to ensure the humidity was high enough."
    } ]
  }, {
    "tStartMs": 1216450,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "One of the things I realized\nwhile making this video is"
    } ]
  }, {
    "tStartMs": 1219150,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "that limestone, the core\ncomponent of cement and concrete,"
    } ]
  }, {
    "tStartMs": 1223770,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "well it comes from ancient sea life."
    } ]
  }, {
    "tStartMs": 1226380,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Limestone is formed from\nthe skeletons and shells"
    } ]
  }, {
    "tStartMs": 1230460,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of ancient sea organisms\nthat, you know, died millions"
    } ]
  }, {
    "tStartMs": 1233580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of years ago,"
    } ]
  }, {
    "tStartMs": 1234413,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "and then all of that got compressed."
    } ]
  }, {
    "tStartMs": 1236700,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "And now we use that to\nmake huge skyscrapers"
    } ]
  }, {
    "tStartMs": 1239883,
    "dDurationMs": 1317,
    "segs": [ {
      "utf8": "and, you know, overpasses,"
    } ]
  }, {
    "tStartMs": 1241200,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "basically every huge\npiece of infrastructure,"
    } ]
  }, {
    "tStartMs": 1243510,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it's made with concrete."
    } ]
  }, {
    "tStartMs": 1245040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And so now when you look at\na beautiful city skyline,"
    } ]
  }, {
    "tStartMs": 1247920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "what you're really seeing\nis ancient marine life."
    } ]
  }, {
    "tStartMs": 1251700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Skyscrapers are made of seashells."
    } ]
  }, {
    "tStartMs": 1256844,
    "dDurationMs": 4531,
    "segs": [ {
      "utf8": "♪ Skyscrapers are made seashells ♪"
    } ]
  }, {
    "tStartMs": 1261375,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "♪ Skyscrapers are made seashells ♪"
    } ]
  }, {
    "tStartMs": 1268800,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "- Yeah, this is wild."
    } ]
  }, {
    "tStartMs": 1270546,
    "dDurationMs": 1074,
    "segs": [ {
      "utf8": "This is hilarious."
    } ]
  }, {
    "tStartMs": 1271620,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I like,"
    } ]
  }, {
    "tStartMs": 1272453,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "I have no words."
    } ]
  }, {
    "tStartMs": 1273330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- I'm like trying to\npush myself down into it"
    } ]
  }, {
    "tStartMs": 1275370,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "but it's like,"
    } ]
  }, {
    "tStartMs": 1276900,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "it pushes me up."
    } ]
  }, {
    "tStartMs": 1278160,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Like I'm pushing down into the concrete,"
    } ]
  }, {
    "tStartMs": 1280470,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but it's like bop!"
    } ]
  }, {
    "tStartMs": 1281760,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "I'm getting pushed out of this thing."
    } ]
  }, {
    "tStartMs": 1283290,
    "dDurationMs": 2952,
    "segs": [ {
      "utf8": "I'm just gonna try to\npush myself down in here."
    } ]
  }, {
    "tStartMs": 1286242,
    "dDurationMs": 1548,
    "segs": [ {
      "utf8": "Ooh!"
    } ]
  }, {
    "tStartMs": 1287790,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Like that is it."
    } ]
  }, {
    "tStartMs": 1288810,
    "dDurationMs": 1019,
    "segs": [ {
      "utf8": "There is no..."
    } ]
  }, {
    "tStartMs": 1289829,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- You can use that."
    } ]
  }, {
    "tStartMs": 1290662,
    "dDurationMs": 1555,
    "segs": [ {
      "utf8": "- You cannot get buried in concrete."
    } ]
  }, {
    "tStartMs": 1292217,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Okay?"
    } ]
  }, {
    "tStartMs": 1293550,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "I'm doing my best right\nnow to like sink down"
    } ]
  }, {
    "tStartMs": 1297270,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "and it is not happening."
    } ]
  }, {
    "tStartMs": 1298230,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "But I'm gonna use my\narms to push myself in."
    } ]
  }, {
    "tStartMs": 1302351,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "(Derek grunts)"
    } ]
  }, {
    "tStartMs": 1303519,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "(Derek exclaims)"
    } ]
  }, {
    "tStartMs": 1305880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Working against buoyancy."
    } ]
  }, {
    "tStartMs": 1307800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "This is hard."
    } ]
  }, {
    "tStartMs": 1309240,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "We were worried about getting me out,"
    } ]
  }, {
    "tStartMs": 1311190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but like I can't stay in."
    } ]
  }, {
    "tStartMs": 1313380,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I'm gonna try to jump in."
    } ]
  }, {
    "tStartMs": 1314520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Here we go."
    } ]
  }, {
    "tStartMs": 1316980,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "That's it.\n(crew members laughing)"
    } ]
  }, {
    "tStartMs": 1317940,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "All right, here we go."
    } ]
  }, {
    "tStartMs": 1318900,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "One, two, three."
    } ]
  }, {
    "tStartMs": 1326040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That's great."
    } ]
  }, {
    "tStartMs": 1327764,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(Derek exclaims)"
    } ]
  }, {
    "tStartMs": 1333360,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That feels so good."
    } ]
  }, {
    "tStartMs": 1335280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I, like, don't wanna get out."
    } ]
  }, {
    "tStartMs": 1336480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This is so nice."
    } ]
  }, {
    "tStartMs": 1338850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Has anyone had a time check?"
    } ]
  }, {
    "tStartMs": 1340950,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "This stuff is not gonna\nset up on me, is it?"
    } ]
  }, {
    "tStartMs": 1348090,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "So as we've seen,"
    } ]
  }, {
    "tStartMs": 1348960,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "concrete is one of the\nmost important materials"
    } ]
  }, {
    "tStartMs": 1351090,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "in the world."
    } ]
  }, {
    "tStartMs": 1351930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It's made possible most"
    } ]
  }, {
    "tStartMs": 1353250,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of the large-scale\ninfrastructure we rely on,"
    } ]
  }, {
    "tStartMs": 1355710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but it also creates a lot of CO2,"
    } ]
  }, {
    "tStartMs": 1358230,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "an estimated 8% of the global total."
    } ]
  }, {
    "tStartMs": 1361050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "That is more than the\nentire aviation sector."
    } ]
  }, {
    "tStartMs": 1363990,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But together, we can do\nsomething about that."
    } ]
  }, {
    "tStartMs": 1366510,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "I would personally like"
    } ]
  }, {
    "tStartMs": 1367590,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to offset one month of\nyour carbon emissions."
    } ]
  }, {
    "tStartMs": 1369750,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And I will do that through\nthis video sponsor, Wren."
    } ]
  }, {
    "tStartMs": 1372930,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Wren is a website"
    } ]
  }, {
    "tStartMs": 1373830,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "where you can calculate\nyour carbon footprint,"
    } ]
  }, {
    "tStartMs": 1375810,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "see which aspects of your lifestyle"
    } ]
  }, {
    "tStartMs": 1377160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "make the biggest contribution,"
    } ]
  }, {
    "tStartMs": 1378300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and learn how to reduce your impact."
    } ]
  }, {
    "tStartMs": 1380700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And then if you like, you can\noffset your carbon footprint"
    } ]
  }, {
    "tStartMs": 1383160,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "by funding a diverse mix of\ncarbon reduction projects"
    } ]
  }, {
    "tStartMs": 1386160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "like tree planting, mineral weathering,"
    } ]
  }, {
    "tStartMs": 1388260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and rainforest protection."
    } ]
  }, {
    "tStartMs": 1389880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "For the first hundred people to sign up,"
    } ]
  }, {
    "tStartMs": 1391560,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I will personally offset your\nfirst month of emissions."
    } ]
  }, {
    "tStartMs": 1394530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Just click on the link in the description."
    } ]
  }, {
    "tStartMs": 1396690,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Now, I don't think we're\ngoing to solve climate change"
    } ]
  }, {
    "tStartMs": 1399060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "using individual action alone."
    } ]
  }, {
    "tStartMs": 1400980,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If you can change your light\nbulbs or install solar,"
    } ]
  }, {
    "tStartMs": 1403410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that is great."
    } ]
  }, {
    "tStartMs": 1404243,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "But what we really need is\nchange on a systemic scale."
    } ]
  }, {
    "tStartMs": 1407340,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And that's what I like\nabout Wren's approach."
    } ]
  }, {
    "tStartMs": 1409050,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "They not only plant trees\nand protect rainforests,"
    } ]
  }, {
    "tStartMs": 1411480,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "they also support policy\ngroups lobbying for change,"
    } ]
  }, {
    "tStartMs": 1414870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "like the Clean Air Task Force,"
    } ]
  }, {
    "tStartMs": 1416460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which advocates for new\ntechnologies and policies"
    } ]
  }, {
    "tStartMs": 1418980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to get to a zero-emissions economy."
    } ]
  }, {
    "tStartMs": 1421380,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "The way I see it,"
    } ]
  }, {
    "tStartMs": 1422400,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "there are moneyed interests lobbying"
    } ]
  }, {
    "tStartMs": 1424170,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to keep things the way they are."
    } ]
  }, {
    "tStartMs": 1425610,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So we need to band together"
    } ]
  }, {
    "tStartMs": 1426900,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "through organizations like\nWren to lobby for change."
    } ]
  }, {
    "tStartMs": 1429540,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And if you agree with me,"
    } ]
  }, {
    "tStartMs": 1430770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "then I invite you to click\nthe link in the description"
    } ]
  }, {
    "tStartMs": 1432870,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and join me in offsetting\nour carbon emissions"
    } ]
  }, {
    "tStartMs": 1435270,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and investing in\nlarge-scale systemic change."
    } ]
  }, {
    "tStartMs": 1438060,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So I want to thank Wren\nfor sponsoring Veritasium,"
    } ]
  }, {
    "tStartMs": 1440250,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
