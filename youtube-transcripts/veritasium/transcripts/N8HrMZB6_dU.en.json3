{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 260,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 1260,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Let’s watch it."
    } ]
  }, {
    "tStartMs": 2260,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "Hopefully I am not horribly wrong."
    } ]
  }, {
    "tStartMs": 3699,
    "dDurationMs": 2671,
    "segs": [ {
      "utf8": "Derek is giggling to himself right now."
    } ]
  }, {
    "tStartMs": 6370,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "\u003e\u003e Ok, you have made your prediction."
    } ]
  }, {
    "tStartMs": 8460,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Now it is time to find out which block went\nhigher, the one that is shot off center or"
    } ]
  }, {
    "tStartMs": 12870,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "the one that is shot right into the center\nof mass."
    } ]
  }, {
    "tStartMs": 15610,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "Ok, we are just getting set for shooting straight\ninto the block."
    } ]
  }, {
    "tStartMs": 18720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "How are you feeling about this one, Dave?"
    } ]
  }, {
    "tStartMs": 20580,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "\u003e\u003e I think this is the one."
    } ]
  }, {
    "tStartMs": 21590,
    "dDurationMs": 1279,
    "segs": [ {
      "utf8": "I really do."
    } ]
  }, {
    "tStartMs": 22869,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "\u003e\u003e Ok."
    } ]
  }, {
    "tStartMs": 23869,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "Range is going hot."
    } ]
  }, {
    "tStartMs": 27410,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "In three, two, one."
    } ]
  }, {
    "tStartMs": 31050,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "\u003e\u003e We have moved this block so now the gun\nis actually firing into the right side of"
    } ]
  }, {
    "tStartMs": 36870,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "the block."
    } ]
  }, {
    "tStartMs": 37870,
    "dDurationMs": 7459,
    "segs": [ {
      "utf8": "So presumably one imagines that the block\nwill spin anticlockwise."
    } ]
  }, {
    "tStartMs": 45329,
    "dDurationMs": 15190,
    "segs": [ {
      "utf8": "\u003e\u003e Three, two, one."
    } ]
  }, {
    "tStartMs": 60519,
    "dDurationMs": 4441,
    "segs": [ {
      "utf8": "\u003e\u003e Now check out the high speed footage."
    } ]
  }, {
    "tStartMs": 64960,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "You can clearly see that both blocks go to\nthe exact same height, even though one is"
    } ]
  }, {
    "tStartMs": 70030,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "rotating."
    } ]
  }, {
    "tStartMs": 71030,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "And that is a bit strange, because they were\nboth hit by the same type of bullet from the"
    } ]
  }, {
    "tStartMs": 75530,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "same rifle, so presumably it had the same\nkinetic energy."
    } ]
  }, {
    "tStartMs": 78330,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "And they both go the same height so they both\nhave the same gravitational potential energy,"
    } ]
  }, {
    "tStartMs": 83390,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "but one is rotating."
    } ]
  }, {
    "tStartMs": 85800,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "And so it has that additional rotational energy."
    } ]
  }, {
    "tStartMs": 88570,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So one block has more energy than the other\nblock."
    } ]
  }, {
    "tStartMs": 91720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "\u003e\u003e I don’t know if I buy that, Dr. Muller."
    } ]
  }, {
    "tStartMs": 94520,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "\u003e\u003e Talk to me."
    } ]
  }, {
    "tStartMs": 95520,
    "dDurationMs": 3709,
    "segs": [ {
      "utf8": "\u003e\u003e Yeah, I mean so you are telling me you\njust created energy."
    } ]
  }, {
    "tStartMs": 99229,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "\u003e\u003e Not necessarily created energy."
    } ]
  }, {
    "tStartMs": 100810,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "So what are you thinking there?"
    } ]
  }, {
    "tStartMs": 103140,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "\u003e\u003e I am potentially surprised."
    } ]
  }, {
    "tStartMs": 105050,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "\u003e\u003e Shoot at the same height?"
    } ]
  }, {
    "tStartMs": 106460,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "\u003e\u003e Obviously I am wrong."
    } ]
  }, {
    "tStartMs": 110020,
    "dDurationMs": 7580,
    "segs": [ {
      "utf8": "\u003e\u003e I think went up to the same height, which\nis incredibly confusing to me."
    } ]
  }, {
    "tStartMs": 117600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "\u003e\u003e Why is that confusing?"
    } ]
  }, {
    "tStartMs": 118600,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "\u003e\u003e Because that doesn’t... where is that\nextra energy coming from?"
    } ]
  }, {
    "tStartMs": 119890,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "\u003e\u003e Well, the fact is that one block clearly\ndoes have more energy."
    } ]
  }, {
    "tStartMs": 122780,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "You think about them both at the top, one\nis spinning, one is not."
    } ]
  }, {
    "tStartMs": 125760,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "They basically have identical gravitational\nenergy, but one does have additional rotational"
    } ]
  }, {
    "tStartMs": 129530,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "energy."
    } ]
  }, {
    "tStartMs": 130530,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "\u003e\u003e How is that possible and why is it happening?"
    } ]
  }, {
    "tStartMs": 132760,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "\u003e\u003e No."
    } ]
  }, {
    "tStartMs": 133760,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "Explain it to me."
    } ]
  }, {
    "tStartMs": 136699,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "\u003e\u003e I don’t want to give you the answer right\naway."
    } ]
  }, {
    "tStartMs": 137979,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "\u003e\u003e I love it when you say that."
    } ]
  }, {
    "tStartMs": 138979,
    "dDurationMs": 1111,
    "segs": [ {
      "utf8": "I don’t want to give you the answer."
    } ]
  }, {
    "tStartMs": 140090,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "That means you don’t know."
    } ]
  }, {
    "tStartMs": 141379,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "I love that."
    } ]
  }, {
    "tStartMs": 142780,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "\u003e\u003e So if you can make me a video response,\nI would love that."
    } ]
  }, {
    "tStartMs": 146630,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Or if you just want to post your idea in the\ncomments below, that would be great."
    } ]
  }, {
    "tStartMs": 150090,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And I will reveal the correct answer next\nweek."
    } ]
  }, {
    "tStartMs": 152730,
    "dDurationMs": 3679,
    "segs": [ {
      "utf8": "So subscribe to the channel if you haven’t\nalready and you will find out in a week’s"
    } ]
  }, {
    "tStartMs": 156409,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "time."
    } ]
  }, {
    "tStartMs": 157409,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "\u003e\u003e After I have time to pore over the footage\nand consult a very smart man in the subject."
    } ]
  }, {
    "tStartMs": 159870,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "That is what you didn’t say."
    } ]
  } ]
}
