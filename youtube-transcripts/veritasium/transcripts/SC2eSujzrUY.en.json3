{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "In 1929 in Chicago,"
    } ]
  }, {
    "tStartMs": 2560,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "people kept mysteriously\ndying inside their homes."
    } ]
  }, {
    "tStartMs": 6640,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It took 15 deaths for the\nauthorities to realize"
    } ]
  }, {
    "tStartMs": 9360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "that these people were getting\nkilled by..."
    } ]
  }, {
    "tStartMs": 12560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "their fridges"
    } ]
  }, {
    "tStartMs": 14240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "because fridges back then were\nno longer just boxes of ice."
    } ]
  }, {
    "tStartMs": 17680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Instead, they relied\non a chemical looping"
    } ]
  }, {
    "tStartMs": 20000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "through the back to stay cold."
    } ]
  }, {
    "tStartMs": 21920,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And the best chemical for\nthe job was methyl chloride,"
    } ]
  }, {
    "tStartMs": 24960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "a toxic and virtually odorless gas."
    } ]
  }, {
    "tStartMs": 27840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So if it somehow leaked from the fridge,"
    } ]
  }, {
    "tStartMs": 30160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "it could kill you without warning."
    } ]
  }, {
    "tStartMs": 32240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Other fridges used\nflammable gases instead,"
    } ]
  }, {
    "tStartMs": 35040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "so a leak combined with\na spark from the stove,"
    } ]
  }, {
    "tStartMs": 37840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and your house could\nsuddenly go up in flames."
    } ]
  }, {
    "tStartMs": 41200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So one company tried\nto solve this problem,"
    } ]
  }, {
    "tStartMs": 44080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "but in the process,"
    } ]
  }, {
    "tStartMs": 45280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "they accidentally created a\nseemingly magical substance."
    } ]
  }, {
    "tStartMs": 49200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Soon, it made its way into\na huge range of products,"
    } ]
  }, {
    "tStartMs": 52720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "which were so popular they ended up"
    } ]
  }, {
    "tStartMs": 54960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in nearly every home in America."
    } ]
  }, {
    "tStartMs": 57840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "But what people didn't know"
    } ]
  }, {
    "tStartMs": 59360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "was that these products came at a price."
    } ]
  }, {
    "tStartMs": 62240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The chemicals used to make them"
    } ]
  }, {
    "tStartMs": 63840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "were being released into the environment,"
    } ]
  }, {
    "tStartMs": 66400,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "slowly poisoning everyone\non the planet,"
    } ]
  }, {
    "tStartMs": 69680,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "including me."
    } ]
  }, {
    "tStartMs": 72382,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(swelling music)"
    } ]
  }, {
    "tStartMs": 72398,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "- You have high levels of a\nchemical you never heard of."
    } ]
  }, {
    "tStartMs": 74320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- It shocks me."
    } ]
  }, {
    "tStartMs": 75600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Like, where could this have come from?"
    } ]
  }, {
    "tStartMs": 77280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Almost every living creature,"
    } ]
  }, {
    "tStartMs": 78880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "from polar bears to birds to fish,"
    } ]
  }, {
    "tStartMs": 81920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "massive worldwide contamination"
    } ]
  }, {
    "tStartMs": 83920,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "by completely manmade\nchemicals that are fingerprints"
    } ]
  }, {
    "tStartMs": 88240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "back to just a couple of companies."
    } ]
  }, {
    "tStartMs": 90240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- This is a video about one"
    } ]
  }, {
    "tStartMs": 92240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "of the biggest chemical\ncoverups in history."
    } ]
  }, {
    "tStartMs": 95280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "For legal reasons, I want to\nnote that this investigation"
    } ]
  }, {
    "tStartMs": 98400,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "is based on publicly available\ndocuments, recordings,"
    } ]
  }, {
    "tStartMs": 101440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and third-party opinions."
    } ]
  }, {
    "tStartMs": 103200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "All sources are linked in the description."
    } ]
  }, {
    "tStartMs": 106240,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "The story all began with\nan attempt to save lives."
    } ]
  }, {
    "tStartMs": 110400,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "In 1936, a chemical company\ncalled DuPont set out"
    } ]
  }, {
    "tStartMs": 114080,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to find a safer alternative\nto the gases used in fridges,"
    } ]
  }, {
    "tStartMs": 118160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "one that was neither toxic nor flammable."
    } ]
  }, {
    "tStartMs": 121120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Their lead scientist on the project"
    } ]
  }, {
    "tStartMs": 122720,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "was a 27-year-old chemist\nnamed Roy J. Plunkett."
    } ]
  }, {
    "tStartMs": 126800,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "He was experimenting"
    } ]
  }, {
    "tStartMs": 127920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "with a gas called\ntetrafluoroethylene, or TFE."
    } ]
  }, {
    "tStartMs": 131600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It's a pair of double-bonded carbons,"
    } ]
  }, {
    "tStartMs": 133840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "each bonded to two fluorine atoms."
    } ]
  }, {
    "tStartMs": 137520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "One morning, as Plunkett\nwas setting up a test,"
    } ]
  }, {
    "tStartMs": 140000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "his assistant picked out\na cylinder full of TFE"
    } ]
  }, {
    "tStartMs": 142640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and twisted the valve,"
    } ]
  }, {
    "tStartMs": 144720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "but nothing came out."
    } ]
  }, {
    "tStartMs": 148240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Plunkett thought the gas must have leaked,"
    } ]
  }, {
    "tStartMs": 150640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but the cylinder still weighed\nabout as much as a full one,"
    } ]
  }, {
    "tStartMs": 153760,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "so he grabbed a saw and\ncut the cylinder in half."
    } ]
  }, {
    "tStartMs": 158880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Inside, he was shocked to see it was full"
    } ]
  }, {
    "tStartMs": 161920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "of a white, slippery powder."
    } ]
  }, {
    "tStartMs": 165200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So what happened to the gas?"
    } ]
  }, {
    "tStartMs": 167680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Well, what the chemist reasoned"
    } ]
  }, {
    "tStartMs": 169040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "was that under the high\npressure of the cylinder,"
    } ]
  }, {
    "tStartMs": 171200,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "one of the double bonds"
    } ]
  }, {
    "tStartMs": 172080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "between the carbons in\nTFE must have broken."
    } ]
  }, {
    "tStartMs": 174880,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And now those two carbon atoms\neach had a bonding site free."
    } ]
  }, {
    "tStartMs": 178320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So one of them probably\ngrabbed onto a carbon"
    } ]
  }, {
    "tStartMs": 180640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "from a different TFE molecule,\nbreaking its double bond."
    } ]
  }, {
    "tStartMs": 184000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And then that molecule did the same,"
    } ]
  }, {
    "tStartMs": 185920,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and the process repeated again and again"
    } ]
  }, {
    "tStartMs": 188800,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "until all of the TFE was\ntrapped in these long chains."
    } ]
  }, {
    "tStartMs": 192960,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The gas had polymerized into\npolytetrafluoroethylene,"
    } ]
  }, {
    "tStartMs": 196960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "forming this slippery powder."
    } ]
  }, {
    "tStartMs": 199280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Plunkett just wanted to get rid of it"
    } ]
  }, {
    "tStartMs": 201360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "because it ruined his experiment."
    } ]
  }, {
    "tStartMs": 203840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "But before throwing it out,"
    } ]
  }, {
    "tStartMs": 205280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "he decided to do some tests on it."
    } ]
  }, {
    "tStartMs": 207680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So he tried pouring water on it,"
    } ]
  }, {
    "tStartMs": 209360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but the water just beaded off."
    } ]
  }, {
    "tStartMs": 211600,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "So he tried acid. Again, nothing happened."
    } ]
  }, {
    "tStartMs": 216160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Then he tried the strongest base he had,"
    } ]
  }, {
    "tStartMs": 219040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but that wouldn't melt it either."
    } ]
  }, {
    "tStartMs": 221200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Plunkett went through all\nof the solvents in the lab,"
    } ]
  }, {
    "tStartMs": 224080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but the powder remained intact."
    } ]
  }, {
    "tStartMs": 226320,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "It wouldn't melt, corrode,\nor react with anything."
    } ]
  }, {
    "tStartMs": 230080,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "It was seemingly indestructible."
    } ]
  }, {
    "tStartMs": 233360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The reason it was so indestructible"
    } ]
  }, {
    "tStartMs": 235200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "was because of this bond,\nthe carbon-fluorine bond."
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "See, out of all of the elements,\nfluorine is the greediest,"
    } ]
  }, {
    "tStartMs": 243200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the most electron-hungry atom."
    } ]
  }, {
    "tStartMs": 246400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Its outer shell is a single electron away"
    } ]
  }, {
    "tStartMs": 248800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "from being complete, which\nwould make it perfectly stable."
    } ]
  }, {
    "tStartMs": 251920,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "So fluorine really, really\nwants that electron."
    } ]
  }, {
    "tStartMs": 255680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And because it's so small\ncompared to most other elements,"
    } ]
  }, {
    "tStartMs": 258720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the protons in its nucleus can get close"
    } ]
  }, {
    "tStartMs": 260640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to the electrons of other atoms."
    } ]
  }, {
    "tStartMs": 262480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And because of their positive charge,"
    } ]
  }, {
    "tStartMs": 264000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "they pull on them really hard."
    } ]
  }, {
    "tStartMs": 266960,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So near a carbon atom,"
    } ]
  }, {
    "tStartMs": 268640,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "fluorine grabs onto one\nof the carbon's electrons"
    } ]
  }, {
    "tStartMs": 271360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to complete its outer shell,"
    } ]
  }, {
    "tStartMs": 273440,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and this keeps the two\natoms bonded together."
    } ]
  }, {
    "tStartMs": 277120,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But the fluorine isn't done there."
    } ]
  }, {
    "tStartMs": 279840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It keeps tugging on\nthe carbon's electrons,"
    } ]
  }, {
    "tStartMs": 282240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "pulling them closer to itself,"
    } ]
  }, {
    "tStartMs": 284480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which makes fluorine\nslightly negatively charged"
    } ]
  }, {
    "tStartMs": 286880,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and the carbon slightly positive."
    } ]
  }, {
    "tStartMs": 289200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So now there's an electrostatic attraction"
    } ]
  }, {
    "tStartMs": 291520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that makes this bond even stronger."
    } ]
  }, {
    "tStartMs": 293920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now, in reality, electrons\nbehave more like fuzzy clouds"
    } ]
  }, {
    "tStartMs": 297040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "than the orbiting points\nin this animation,"
    } ]
  }, {
    "tStartMs": 299120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but the principle still holds."
    } ]
  }, {
    "tStartMs": 301360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "In terms of energy,"
    } ]
  }, {
    "tStartMs": 302720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "this is actually the strongest single bond"
    } ]
  }, {
    "tStartMs": 304800,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "a carbon can form."
    } ]
  }, {
    "tStartMs": 306080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So if other atoms or molecules get close,"
    } ]
  }, {
    "tStartMs": 308800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "they're essentially ignored."
    } ]
  }, {
    "tStartMs": 310880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And Plunkett's magic powder\nwas completely covered"
    } ]
  }, {
    "tStartMs": 313920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "in carbon-fluorine bonds,"
    } ]
  }, {
    "tStartMs": 315680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "so it hardly reacted with anything."
    } ]
  }, {
    "tStartMs": 319200,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Okay, so he is got this\nincredibly inert stuff."
    } ]
  }, {
    "tStartMs": 321440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Was he really trying to get rid of it?"
    } ]
  }, {
    "tStartMs": 322880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- He actually didn't\nknow what to do with it"
    } ]
  }, {
    "tStartMs": 324560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "'cause like what do you\ndo with the material"
    } ]
  }, {
    "tStartMs": 326000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that doesn't, you know,\nreact with anything?"
    } ]
  }, {
    "tStartMs": 329600,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But luckily his employer, DuPont,\nthey were actually working"
    } ]
  }, {
    "tStartMs": 332080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with the US Army on the Manhattan Project."
    } ]
  }, {
    "tStartMs": 334000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So they were refining\nuranium and plutonium"
    } ]
  }, {
    "tStartMs": 336160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "'cause of course there's\na World War II reference"
    } ]
  }, {
    "tStartMs": 337680,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "in a Veritasium video."
    } ]
  }, {
    "tStartMs": 338960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "You just have to have it."
    } ]
  }, {
    "tStartMs": 340160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "- To get the fuel for nuclear\nbombs, enriched uranium,"
    } ]
  }, {
    "tStartMs": 344080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "you first have to turn the uranium"
    } ]
  }, {
    "tStartMs": 345680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "into a gas, uranium hexafluoride."
    } ]
  }, {
    "tStartMs": 348480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It was a nasty chemical\nthat corroded everything."
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So all the gaskets, seals,"
    } ]
  }, {
    "tStartMs": 353440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and miles of pipe in\nthe plant at Oak Ridge"
    } ]
  }, {
    "tStartMs": 355920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "had to constantly replaced,\nslowing down production."
    } ]
  }, {
    "tStartMs": 359120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- But then DuPont was like, \"Listen,"
    } ]
  }, {
    "tStartMs": 361360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "we have this seemingly\nindestructible chemical, right?"
    } ]
  }, {
    "tStartMs": 363920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It doesn't react with\nstuff it doesn't corrode,"
    } ]
  }, {
    "tStartMs": 366320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "so maybe we can try and use it"
    } ]
  }, {
    "tStartMs": 367760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "against uranium hexafluoride.\""
    } ]
  }, {
    "tStartMs": 369600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So they get a bunch of this powder,"
    } ]
  }, {
    "tStartMs": 371200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "they cram it together under high pressure"
    } ]
  }, {
    "tStartMs": 373280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to create these cakes, essentially."
    } ]
  }, {
    "tStartMs": 375920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Now you had a solid of this material"
    } ]
  }, {
    "tStartMs": 377520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that you could machine\ninto gaskets and cylinders"
    } ]
  }, {
    "tStartMs": 380000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that you could push into these pipes"
    } ]
  }, {
    "tStartMs": 381760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and put these tube linings into the pipe,"
    } ]
  }, {
    "tStartMs": 384480,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and boom, it works like\nmagic, like a charm."
    } ]
  }, {
    "tStartMs": 387040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The uranium hexafluoride was no match"
    } ]
  }, {
    "tStartMs": 389920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "for this magic material."
    } ]
  }, {
    "tStartMs": 391280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- As Gordon Fee, the manager"
    } ]
  }, {
    "tStartMs": 393120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "of the nuclear weapons plant, put it,"
    } ]
  }, {
    "tStartMs": 394880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "\"There was never a substitute\nconsidered, as far as I know.\""
    } ]
  }, {
    "tStartMs": 399360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The material worked so well"
    } ]
  }, {
    "tStartMs": 401040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that the army wanted to\nuse it for everything."
    } ]
  }, {
    "tStartMs": 404080,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The same gaskets and seals\nwere installed into fuel tanks"
    } ]
  }, {
    "tStartMs": 407040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and airplane engines to protect\nthem from oil and water."
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And weapons manufacturing\nplants no longer had issues"
    } ]
  }, {
    "tStartMs": 413040,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "with the corrosive nitric acid\nneeded to make explosives."
    } ]
  }, {
    "tStartMs": 416640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "DuPont saw the potential too,"
    } ]
  }, {
    "tStartMs": 418480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "so they trademarked the material in 1944."
    } ]
  }, {
    "tStartMs": 420800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- They didn't trademark it"
    } ]
  }, {
    "tStartMs": 422320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "under the name polytetrafluoroethylene"
    } ]
  }, {
    "tStartMs": 424560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "'cause, admittedly,\nthat name kind of sucks."
    } ]
  }, {
    "tStartMs": 426400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So they took T-E from\ntetra, F-L from fluoro,"
    } ]
  }, {
    "tStartMs": 429840,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "and then they had a bunch"
    } ]
  }, {
    "tStartMs": 430880,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "of these other miracle\nmaterials, rayon, nylon."
    } ]
  }, {
    "tStartMs": 434560,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So they took O-N from the end\nof those, and boom, Teflon."
    } ]
  }, {
    "tStartMs": 438800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "- Nice. Okay, that's a good name."
    } ]
  }, {
    "tStartMs": 442240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Under the army's order, DuPont\nramped up Teflon production"
    } ]
  }, {
    "tStartMs": 445200,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "at their test plant in\nArlington, New Jersey,"
    } ]
  }, {
    "tStartMs": 447440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "giving their whole\nsupply to the government."
    } ]
  }, {
    "tStartMs": 449840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But DuPont struggled to\nproduce enough Teflon"
    } ]
  }, {
    "tStartMs": 452560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to meet the military's demand."
    } ]
  }, {
    "tStartMs": 455040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "As their Arlington scientists put it,"
    } ]
  }, {
    "tStartMs": 457200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the major advantages of\npolytetrafluoroethylene,"
    } ]
  }, {
    "tStartMs": 460160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "solvent resistance and\nhigh thermal stability,"
    } ]
  }, {
    "tStartMs": 462560,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "offer obstacles from the\nstandpoint of ease in fabrication."
    } ]
  }, {
    "tStartMs": 466280,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- You could only really\nmold Teflon into solids,"
    } ]
  }, {
    "tStartMs": 469440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "so gasket, seals, pipes,"
    } ]
  }, {
    "tStartMs": 471040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but you couldn't put it\ninto water to make a spray"
    } ]
  }, {
    "tStartMs": 473040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "because it doesn't dissolve in water."
    } ]
  }, {
    "tStartMs": 474320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They actually didn't know\nanything that dissolved Teflon,"
    } ]
  }, {
    "tStartMs": 476720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but there was an even bigger\nproblem at that point."
    } ]
  }, {
    "tStartMs": 479200,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "- To polymerize TFE into Teflon,\nyou can add a reactive atom"
    } ]
  }, {
    "tStartMs": 483200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "or molecule that will hijack\nthe first carbon double bond"
    } ]
  }, {
    "tStartMs": 486240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and start the reaction."
    } ]
  }, {
    "tStartMs": 487920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "This is called the initiator."
    } ]
  }, {
    "tStartMs": 489680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And the bond formed between\nit and the first TFE molecule"
    } ]
  }, {
    "tStartMs": 493040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "releases a small amount of energy."
    } ]
  }, {
    "tStartMs": 495520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Then a bit of energy is also released"
    } ]
  }, {
    "tStartMs": 497280,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "when the next TFE molecule joins the chain"
    } ]
  }, {
    "tStartMs": 499840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the next and the next."
    } ]
  }, {
    "tStartMs": 501760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And if the process isn't controlled,"
    } ]
  }, {
    "tStartMs": 504000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "the reaction gets very hot very quickly."
    } ]
  }, {
    "tStartMs": 507440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And if it gets above 200 degrees celsius,"
    } ]
  }, {
    "tStartMs": 509920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "TFE rapidly decomposes into\ncarbon and tetrafluoromethane,"
    } ]
  }, {
    "tStartMs": 513760,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "which releases even\nmore energy all at once."
    } ]
  }, {
    "tStartMs": 518640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "This caused a massive explosion"
    } ]
  }, {
    "tStartMs": 520400,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "at the Arlington plant in\n1944, killing two workers."
    } ]
  }, {
    "tStartMs": 525680,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "You need a way to dissipate the heat,"
    } ]
  }, {
    "tStartMs": 528960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "take the heat away from the reaction"
    } ]
  }, {
    "tStartMs": 530800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "without it staying in there"
    } ]
  }, {
    "tStartMs": 532800,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "and, therefore, expanding\nand creating that force."
    } ]
  }, {
    "tStartMs": 535880,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- Yeah, and one of the ways to do that"
    } ]
  }, {
    "tStartMs": 538240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "was to have the reaction\nhappening in water,"
    } ]
  }, {
    "tStartMs": 540080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "because water can absorb\na huge amount of energy"
    } ]
  }, {
    "tStartMs": 542320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "before it ever heats up."
    } ]
  }, {
    "tStartMs": 543880,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- But if you inject TFE\ninto a water cylinder,"
    } ]
  }, {
    "tStartMs": 547120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the gas doesn't dissolve."
    } ]
  }, {
    "tStartMs": 549520,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Even at high pressure, most\nof the TFE just stays on top."
    } ]
  }, {
    "tStartMs": 553280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So if you add an initiator,"
    } ]
  }, {
    "tStartMs": 554880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "the polymerization is\ntriggered in one place,"
    } ]
  }, {
    "tStartMs": 557360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and so it can still cause an explosion."
    } ]
  }, {
    "tStartMs": 560400,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "What you need is some way"
    } ]
  }, {
    "tStartMs": 561760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "to disperse the TFE\nthroughout the water first."
    } ]
  }, {
    "tStartMs": 565040,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And to do that, DuPont needed help."
    } ]
  }, {
    "tStartMs": 568960,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "In 1951, they purchased\na special acid from 3M,"
    } ]
  }, {
    "tStartMs": 572720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the company behind Scotch Tape."
    } ]
  }, {
    "tStartMs": 574880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This acid, called PFOA,"
    } ]
  }, {
    "tStartMs": 576800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "looked almost exactly like Teflon."
    } ]
  }, {
    "tStartMs": 579280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It had a chain of eight carbon\natoms covered in fluorines,"
    } ]
  }, {
    "tStartMs": 582400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "but at the other end, there\nwas a double-bonded oxygen"
    } ]
  }, {
    "tStartMs": 585360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and an OH group."
    } ]
  }, {
    "tStartMs": 586960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That's what makes it an acid."
    } ]
  }, {
    "tStartMs": 588880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And since there were eight\ncarbons in the chain,"
    } ]
  }, {
    "tStartMs": 591040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "DuPont also referred to the acid as C8."
    } ]
  }, {
    "tStartMs": 595200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The tail end of C8, like\nTeflon, was hydrophobic,"
    } ]
  }, {
    "tStartMs": 598400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but the acid head group loved water,"
    } ]
  }, {
    "tStartMs": 600800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it was hydrophilic."
    } ]
  }, {
    "tStartMs": 602480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So when you add C8 into water,"
    } ]
  }, {
    "tStartMs": 604400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the molecules rearrange themselves"
    } ]
  }, {
    "tStartMs": 606480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "so that the heads touch the water,"
    } ]
  }, {
    "tStartMs": 608320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but the Teflon-like tails don't."
    } ]
  }, {
    "tStartMs": 610800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "They create little bubbles\nall throughout the water,"
    } ]
  }, {
    "tStartMs": 613840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "which are virtually dry on the inside."
    } ]
  }, {
    "tStartMs": 616880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "If you now inject TFE and\nstir the whole mixture up,"
    } ]
  }, {
    "tStartMs": 620160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "well, the hydrophobic gas ends up"
    } ]
  }, {
    "tStartMs": 622080,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "in the middle of these C8 bubbles."
    } ]
  }, {
    "tStartMs": 625360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And those bubbles are dispersed everywhere"
    } ]
  }, {
    "tStartMs": 628160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "evenly throughout the water."
    } ]
  }, {
    "tStartMs": 630720,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "You know what this reminds me of, is soap."
    } ]
  }, {
    "tStartMs": 634640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "So it's the great combiner"
    } ]
  }, {
    "tStartMs": 636160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that allows, like, oil and water to mix."
    } ]
  }, {
    "tStartMs": 638320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- And now if you sprinkle\nin initiator molecules,"
    } ]
  }, {
    "tStartMs": 641200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the initiator molecules\nalso go into these bubbles."
    } ]
  }, {
    "tStartMs": 643600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "They start the polymerization reaction,"
    } ]
  }, {
    "tStartMs": 645120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "so from TFE to Teflon."
    } ]
  }, {
    "tStartMs": 647360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But now since it's happening spread all"
    } ]
  }, {
    "tStartMs": 649360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "throughout these bubbles,\nthe heat is evenly dissipated"
    } ]
  }, {
    "tStartMs": 652080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "throughout the water, and no one explodes."
    } ]
  }, {
    "tStartMs": 653880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- And since Teflon is now\nsuspended in a solution,"
    } ]
  }, {
    "tStartMs": 657600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you can spray it onto\nsurfaces like a coating."
    } ]
  }, {
    "tStartMs": 660960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "This thing doesn't stick to anything."
    } ]
  }, {
    "tStartMs": 662560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "How do you stick it to the gaskets?"
    } ]
  }, {
    "tStartMs": 664240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "You know, how do you actually use it?"
    } ]
  }, {
    "tStartMs": 666160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- Yeah, yeah, yeah,\nthat's a good question."
    } ]
  }, {
    "tStartMs": 668160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "So the trick was actually the surface"
    } ]
  }, {
    "tStartMs": 669680,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "had to be really rough."
    } ]
  }, {
    "tStartMs": 670720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So what you do is you\nsandblast it to create grooves"
    } ]
  }, {
    "tStartMs": 673680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and imperfections at this,\nlike, nanoscopic level."
    } ]
  }, {
    "tStartMs": 676240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Now if you spray the coating on,"
    } ]
  }, {
    "tStartMs": 678080,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "what happens is, if you heat\nit up, the water evaporates,"
    } ]
  }, {
    "tStartMs": 681840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the C8, it also evaporates,"
    } ]
  }, {
    "tStartMs": 683520,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "but Teflon, instead of it\nevaporating, it just softens up."
    } ]
  }, {
    "tStartMs": 686960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So although there's no\nchemical interaction here,"
    } ]
  }, {
    "tStartMs": 689200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "now it's mechanically\nstuck to the surface."
    } ]
  }, {
    "tStartMs": 691760,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "That's how they got it to stick."
    } ]
  }, {
    "tStartMs": 698320,
    "dDurationMs": 75,
    "segs": [ {
      "utf8": "(suspenseful music)\n(quirky music)"
    } ]
  }, {
    "tStartMs": 698395,
    "dDurationMs": 1045,
    "segs": [ {
      "utf8": "- With the war over,"
    } ]
  }, {
    "tStartMs": 699440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "the army lifted the secrecy\nbans on the Teflon patents,"
    } ]
  }, {
    "tStartMs": 702880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and DuPont was allowed\nto sell it commercially."
    } ]
  }, {
    "tStartMs": 705520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And suddenly, people all over the world"
    } ]
  }, {
    "tStartMs": 707600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "were coating everyday items in Teflon,"
    } ]
  }, {
    "tStartMs": 710000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "trying to create a world-changing product."
    } ]
  }, {
    "tStartMs": 713440,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "One day in 1954, a French\nengineer, Marc Gregoire,"
    } ]
  }, {
    "tStartMs": 717200,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "tried putting Teflon on his\nfishing gear to prevent tangles."
    } ]
  }, {
    "tStartMs": 720760,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- But then his wife saw him doing that,"
    } ]
  }, {
    "tStartMs": 722880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and her reaction was that,\n\"This is absolute nonsense."
    } ]
  }, {
    "tStartMs": 725920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "No one is ever gonna use this."
    } ]
  }, {
    "tStartMs": 727440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You should do something that\nsomeone's actually gonna use."
    } ]
  }, {
    "tStartMs": 730080,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "So how about you put it on a\npan? Make a pan non-stick.\""
    } ]
  }, {
    "tStartMs": 733160,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- And once these pans hit the market,"
    } ]
  }, {
    "tStartMs": 736480,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "it was a cooking revolution."
    } ]
  }, {
    "tStartMs": 738120,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- Teflon.\n- Teflon."
    } ]
  }, {
    "tStartMs": 739840,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "- Teflon."
    } ]
  }, {
    "tStartMs": 740440,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- And DuPont knew\nexactly how to market it."
    } ]
  }, {
    "tStartMs": 743440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- Even oatmeal won't stick to Teflon."
    } ]
  }, {
    "tStartMs": 745680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- Hey, neat. Let me try."
    } ]
  }, {
    "tStartMs": 748400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- And it wasn't just non-stick pans."
    } ]
  }, {
    "tStartMs": 750960,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Teflon, C8, and chemicals like\nit were used in everything."
    } ]
  }, {
    "tStartMs": 754040,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Slip-Away contains the\nmagic of DuPont's Teflon."
    } ]
  }, {
    "tStartMs": 756640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- Suddenly, we had Teflon\nstain-resistant carpets"
    } ]
  }, {
    "tStartMs": 759840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and stain protection sprays\nlike 3M's Scotchgard."
    } ]
  }, {
    "tStartMs": 763520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Jackets lined with Teflon were\nwaterproof and breathable."
    } ]
  }, {
    "tStartMs": 766640,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- Gore-Tex is the brand name."
    } ]
  }, {
    "tStartMs": 768360,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "- Teflon was so inert that\nmedical implants made out of it"
    } ]
  }, {
    "tStartMs": 772640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "wouldn't be rejected by the body."
    } ]
  }, {
    "tStartMs": 774880,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It was used to coat the Statue\nof Liberty's steel framework"
    } ]
  }, {
    "tStartMs": 778400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to save it from corrosion."
    } ]
  }, {
    "tStartMs": 780400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And even bullets were coated with Teflon"
    } ]
  }, {
    "tStartMs": 782880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to minimize the damage they did coming out"
    } ]
  }, {
    "tStartMs": 784880,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "of the gun barrel."
    } ]
  }, {
    "tStartMs": 786240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The term Teflon was so ubiquitous"
    } ]
  }, {
    "tStartMs": 787920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that when the Italian mobster John Gotti"
    } ]
  }, {
    "tStartMs": 789920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "was being prosecuted in the late 1980s,"
    } ]
  }, {
    "tStartMs": 792320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "none of the charges\nagainst him would stick."
    } ]
  }, {
    "tStartMs": 794720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So he was dubbed Teflon Don."
    } ]
  }, {
    "tStartMs": 797280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "By the late 1990s,"
    } ]
  }, {
    "tStartMs": 798720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the Teflon business generated\nroughly a billion dollars"
    } ]
  }, {
    "tStartMs": 801680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "in yearly sales for DuPont."
    } ]
  }, {
    "tStartMs": 803440,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "- Teflon has a great future,\nand its uses will be many."
    } ]
  }, {
    "tStartMs": 807600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- The chemicals were everywhere,"
    } ]
  }, {
    "tStartMs": 811200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "even where they shouldn't be."
    } ]
  }, {
    "tStartMs": 827320,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- He suspected that\nsomething in this creek"
    } ]
  }, {
    "tStartMs": 830160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "was poisoning his cows."
    } ]
  }, {
    "tStartMs": 849080,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "- Earl was desperate.\nSo he hired a lawyer."
    } ]
  }, {
    "tStartMs": 853840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- He came to our offices armed"
    } ]
  }, {
    "tStartMs": 856880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "with boxes of VHS videotapes."
    } ]
  }, {
    "tStartMs": 860640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "We started watching these videotapes,"
    } ]
  }, {
    "tStartMs": 862480,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and you know, there was\na serious problem here."
    } ]
  }, {
    "tStartMs": 869800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- The animals were wasting away,"
    } ]
  }, {
    "tStartMs": 872800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and they were skin and bones,"
    } ]
  }, {
    "tStartMs": 874240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and they had tumors and black teeth."
    } ]
  }, {
    "tStartMs": 876560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And you could see, on the videotape,"
    } ]
  }, {
    "tStartMs": 879280,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "white foam coming out of the pipe"
    } ]
  }, {
    "tStartMs": 882560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "on this landfill next door"
    } ]
  }, {
    "tStartMs": 884640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "with these animals\nstanding in the white foam."
    } ]
  }, {
    "tStartMs": 887680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The hair on their hooves\nwas being eaten off"
    } ]
  }, {
    "tStartMs": 890480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "by whatever was in the water."
    } ]
  }, {
    "tStartMs": 897240,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- It was a discharge pipe,"
    } ]
  }, {
    "tStartMs": 899840,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "and it had the marking"
    } ]
  }, {
    "tStartMs": 900880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of E.I. du Pont de Nemours and Company."
    } ]
  }, {
    "tStartMs": 903640,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- And the landfill that pipe\nwas draining from belonged"
    } ]
  }, {
    "tStartMs": 906800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to DuPont's massive factory complex"
    } ]
  }, {
    "tStartMs": 908960,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "outside of Parkersburg, West\nVirginia, just six miles away."
    } ]
  }, {
    "tStartMs": 914080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That factory was Washington Works,"
    } ]
  }, {
    "tStartMs": 916240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the first commercial Teflon plant."
    } ]
  }, {
    "tStartMs": 919120,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It provided jobs for almost\n2,000 people in the town."
    } ]
  }, {
    "tStartMs": 922960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And DuPont's presence was felt everywhere."
    } ]
  }, {
    "tStartMs": 925520,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- I have been a resident of\nParkersburg for 48 years."
    } ]
  }, {
    "tStartMs": 929040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I do not work for the DuPont company,"
    } ]
  }, {
    "tStartMs": 931040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "but I have seen how their\npeople have done much"
    } ]
  }, {
    "tStartMs": 933120,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "for the cultural growth of this community."
    } ]
  }, {
    "tStartMs": 934840,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "- There are facilities for\ntennis, camping, swimming,"
    } ]
  }, {
    "tStartMs": 939680,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "softball, and more than 20\nareas equipped for cookouts"
    } ]
  }, {
    "tStartMs": 943120,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "and family picnics."
    } ]
  }, {
    "tStartMs": 944000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- DuPont took care of the community."
    } ]
  }, {
    "tStartMs": 946960,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So when the town folk got word"
    } ]
  }, {
    "tStartMs": 948240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that Earl Tennant hired\na lawyer to investigate,"
    } ]
  }, {
    "tStartMs": 950480,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "they shunned him and his family."
    } ]
  }, {
    "tStartMs": 953440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "As his sister-in-law put it,\nwe'd walk into a restaurant"
    } ]
  }, {
    "tStartMs": 956320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and everybody in the restaurant\nwould get up and leave."
    } ]
  }, {
    "tStartMs": 959920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "But Earl wasn't scared\noff, and neither was Rob."
    } ]
  }, {
    "tStartMs": 962880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- I thought this was gonna\nbe pretty straightforward."
    } ]
  }, {
    "tStartMs": 965640,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "- See, the US Environmental\nProtection Agency, the EPA,"
    } ]
  }, {
    "tStartMs": 969760,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "dictates exactly which chemicals are safe"
    } ]
  }, {
    "tStartMs": 972080,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "to be disposed of in a\nlandfill and in what amounts."
    } ]
  }, {
    "tStartMs": 975160,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- We would get those records and permits,"
    } ]
  }, {
    "tStartMs": 977600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and it would tell us which chemical"
    } ]
  }, {
    "tStartMs": 979840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "was causing this problem."
    } ]
  }, {
    "tStartMs": 981680,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "But none of those records\nwere really showing anything"
    } ]
  }, {
    "tStartMs": 986000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that was really causing a problem,"
    } ]
  }, {
    "tStartMs": 988000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "you know, nothing that would\nexplain that white foam."
    } ]
  }, {
    "tStartMs": 990320,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "- Whatever was in Earl's\nwater wasn't on the permits."
    } ]
  }, {
    "tStartMs": 995200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Now, already in the 1950s,\npeople knew that Teflon,"
    } ]
  }, {
    "tStartMs": 998080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "specifically PTFE, was pretty safe."
    } ]
  }, {
    "tStartMs": 1000960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It's a long and extremely inert molecule."
    } ]
  }, {
    "tStartMs": 1003440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So if you ingest it, your\nbody just flushes it out."
    } ]
  }, {
    "tStartMs": 1006560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "However, if you heat Teflon\nto 350 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 1009600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "it starts releasing fumes\nthat make people sick."
    } ]
  }, {
    "tStartMs": 1012800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "This often happened to\nworkers in Teflon plants."
    } ]
  }, {
    "tStartMs": 1015520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Stray PTFE powder would\nfall onto their cigarettes"
    } ]
  }, {
    "tStartMs": 1018400,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "as they were working,"
    } ]
  }, {
    "tStartMs": 1019440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and then later they would\naccidentally smoke one"
    } ]
  }, {
    "tStartMs": 1022160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of these cigarettes."
    } ]
  }, {
    "tStartMs": 1023360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Luckily, the symptoms were mild:"
    } ]
  }, {
    "tStartMs": 1025520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "fatigue, tightness of chest, headaches,"
    } ]
  }, {
    "tStartMs": 1028080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and they would usually\npass within 48 hours."
    } ]
  }, {
    "tStartMs": 1030800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It was called polymer fume fever."
    } ]
  }, {
    "tStartMs": 1033840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And even though it rarely happens today,"
    } ]
  }, {
    "tStartMs": 1035760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "it's why you should never\noverheat your Teflon pan"
    } ]
  }, {
    "tStartMs": 1038240,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "to these temperatures,"
    } ]
  }, {
    "tStartMs": 1039520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "especially if you have pet birds at home,"
    } ]
  }, {
    "tStartMs": 1041680,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "because the fumes are\nmuch more toxic to them."
    } ]
  }, {
    "tStartMs": 1045440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But Teflon couldn't have\npoisoned Earl's cows."
    } ]
  }, {
    "tStartMs": 1048560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "There were no fumes or high temperatures,"
    } ]
  }, {
    "tStartMs": 1050720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "so there must have been\nsomething else in the water."
    } ]
  }, {
    "tStartMs": 1054160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Rob filed a legal request"
    } ]
  }, {
    "tStartMs": 1055600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for all of the Washington\nWorks operational records,"
    } ]
  }, {
    "tStartMs": 1058000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and DuPont sent them over,"
    } ]
  }, {
    "tStartMs": 1060720,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "more than 60,000 documents."
    } ]
  }, {
    "tStartMs": 1063320,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- A lot of folks would try to say,"
    } ]
  }, {
    "tStartMs": 1066240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "\"Okay, you you want a lot of documents,"
    } ]
  }, {
    "tStartMs": 1068160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "we'll give you a of documents\""
    } ]
  }, {
    "tStartMs": 1070080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and hope that there'd be no way\nsomebody could actually wade"
    } ]
  }, {
    "tStartMs": 1073600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "through all of these files\nand all of these materials."
    } ]
  }, {
    "tStartMs": 1077200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "But I am the kind of\nperson that I do dig in,"
    } ]
  }, {
    "tStartMs": 1080240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and I do want to go\nthrough those documents,"
    } ]
  }, {
    "tStartMs": 1082400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so I actually did read all of that."
    } ]
  }, {
    "tStartMs": 1084200,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- And in those files,"
    } ]
  }, {
    "tStartMs": 1085760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "a certain chemical kept\npopping up everywhere,"
    } ]
  }, {
    "tStartMs": 1089280,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "C8."
    } ]
  }, {
    "tStartMs": 1090200,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "- I never saw the kinds\nof things I was seeing now"
    } ]
  }, {
    "tStartMs": 1094240,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "in these documents from DuPont."
    } ]
  }, {
    "tStartMs": 1097660,
    "dDurationMs": 18,
    "segs": [ {
      "utf8": "(foreboding music)"
    } ]
  }, {
    "tStartMs": 1097678,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "- In 1961, the same year\nTeflon pans hit the US market,"
    } ]
  }, {
    "tStartMs": 1101680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "DuPont's in-house scientists\ntested C8 on rats."
    } ]
  }, {
    "tStartMs": 1105600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Ingesting as little as 1.5 milligrams"
    } ]
  }, {
    "tStartMs": 1108240,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "of C8 per kilogram of body\nweight caused the rat's livers"
    } ]
  }, {
    "tStartMs": 1111760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to grow abnormally."
    } ]
  }, {
    "tStartMs": 1113440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And a dose of 570 milligrams\nper kilogram was lethal."
    } ]
  }, {
    "tStartMs": 1117280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "For reference, sodium cyanide,"
    } ]
  }, {
    "tStartMs": 1119200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "one of the most dangerous\npoisons, is lethal to rats"
    } ]
  }, {
    "tStartMs": 1121920,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "in doses of five to 15\nmilligrams per kilogram."
    } ]
  }, {
    "tStartMs": 1125440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But even though C8 was less fatal,"
    } ]
  }, {
    "tStartMs": 1127440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "it was concerning for two other reasons."
    } ]
  }, {
    "tStartMs": 1130880,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "First, like Teflon,"
    } ]
  }, {
    "tStartMs": 1132240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "its tail is made of carbon-fluorine bonds,"
    } ]
  }, {
    "tStartMs": 1134640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which makes it incredibly stable."
    } ]
  }, {
    "tStartMs": 1136800,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "So C8 wouldn't break down in\nthe environment for decades."
    } ]
  }, {
    "tStartMs": 1140720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And second, C8 looks like the fatty acids"
    } ]
  }, {
    "tStartMs": 1143680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that humans and animals\nneed for normal functioning,"
    } ]
  }, {
    "tStartMs": 1146160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "just with fluorines instead of hydrogens."
    } ]
  }, {
    "tStartMs": 1148800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So the concern was that C8\ncould get into the bloodstream,"
    } ]
  }, {
    "tStartMs": 1151840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "hitch a ride on the proteins"
    } ]
  }, {
    "tStartMs": 1153040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that transport fatty acids around,"
    } ]
  }, {
    "tStartMs": 1154880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and get almost anywhere in the body."
    } ]
  }, {
    "tStartMs": 1157440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And because of the carbon-fluorine bonds,"
    } ]
  }, {
    "tStartMs": 1159680,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "humans and animals have\nno way to break down C8,"
    } ]
  }, {
    "tStartMs": 1163360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "so it could slowly build up,\nmimicking those fatty acids"
    } ]
  }, {
    "tStartMs": 1166960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and potentially disrupting\nthe systems they regulate,"
    } ]
  }, {
    "tStartMs": 1169520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "like the liver."
    } ]
  }, {
    "tStartMs": 1170720,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- Toxic, persistent, bioaccumulative."
    } ]
  }, {
    "tStartMs": 1174320,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So the concern was it's\nlike a ticking time bomb."
    } ]
  }, {
    "tStartMs": 1177520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It's got more opportunity to cause harm."
    } ]
  }, {
    "tStartMs": 1179840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- As a safety measure, that\nsame rat study suggested"
    } ]
  }, {
    "tStartMs": 1182960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "that all these materials should\nbe handled with extreme care"
    } ]
  }, {
    "tStartMs": 1186880,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and that contact with skin\nshould be strictly avoided."
    } ]
  }, {
    "tStartMs": 1191200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "In 1962, DuPont redid the study"
    } ]
  }, {
    "tStartMs": 1193760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and confirmed that high\ndoses of C8 kill rats"
    } ]
  }, {
    "tStartMs": 1196960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "through injury to the stomach, intestine,"
    } ]
  }, {
    "tStartMs": 1199280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "brain, lungs, and pancreas."
    } ]
  }, {
    "tStartMs": 1201760,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Then in 1965, they found those\nsame toxic effects in dogs."
    } ]
  }, {
    "tStartMs": 1206640,
    "dDurationMs": 6284,
    "segs": [ {
      "utf8": "The evidence was mounting."
    } ]
  }, {
    "tStartMs": 1212924,
    "dDurationMs": 34,
    "segs": [ {
      "utf8": "(suspenseful music)\n(camera clicks)"
    } ]
  }, {
    "tStartMs": 1212958,
    "dDurationMs": 1682,
    "segs": [ {
      "utf8": "- They were even studying monkeys."
    } ]
  }, {
    "tStartMs": 1214640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Some of the monkeys were dropping dead."
    } ]
  }, {
    "tStartMs": 1216560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "These chemicals were causing toxic effects"
    } ]
  }, {
    "tStartMs": 1218960,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "in multiple organ systems\nin multiple species."
    } ]
  }, {
    "tStartMs": 1223440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "All these studies weren't being shared"
    } ]
  }, {
    "tStartMs": 1225680,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "with the scientific community."
    } ]
  }, {
    "tStartMs": 1227240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- And likely no one outside"
    } ]
  }, {
    "tStartMs": 1229280,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "of DuPont would've noticed\nsomething was wrong"
    } ]
  }, {
    "tStartMs": 1231840,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "if it was not for..."
    } ]
  }, {
    "tStartMs": 1232880,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "- Tooth decay, the most\nwidespread of all diseases."
    } ]
  }, {
    "tStartMs": 1236440,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- In the 1950s, tooth decay\nwas a nationwide problem."
    } ]
  }, {
    "tStartMs": 1239920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So the US started adding\ninorganic fluorides"
    } ]
  }, {
    "tStartMs": 1242720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "like sodium fluoride to\nthe public water supply."
    } ]
  }, {
    "tStartMs": 1246160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "This helped fight cavities."
    } ]
  }, {
    "tStartMs": 1247680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- 16 years after fluoridation,"
    } ]
  }, {
    "tStartMs": 1250400,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "all children will have\n65% less tooth decay."
    } ]
  }, {
    "tStartMs": 1255080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- In 1975, researchers wanted to know"
    } ]
  }, {
    "tStartMs": 1258240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "if that inorganic fluoride was\ngetting into people's blood."
    } ]
  }, {
    "tStartMs": 1261440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So they sampled blood from around the US,"
    } ]
  }, {
    "tStartMs": 1263840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and the results were as expected."
    } ]
  }, {
    "tStartMs": 1266320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "More fluoride in the tap\nwater meant more fluoride"
    } ]
  }, {
    "tStartMs": 1269040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "in the blood."
    } ]
  }, {
    "tStartMs": 1270080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "But they found another type\nof fluorine in the blood too,"
    } ]
  }, {
    "tStartMs": 1273600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "which was organic fluorine,"
    } ]
  }, {
    "tStartMs": 1275440,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "carbon-fluorine bonds, and it\ndidn't follow the same trend."
    } ]
  }, {
    "tStartMs": 1279560,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- Well, these researchers were wondering,"
    } ]
  }, {
    "tStartMs": 1282240,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "where's this coming from?"
    } ]
  }, {
    "tStartMs": 1283600,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Because this is not a\nnaturally occurring substance."
    } ]
  }, {
    "tStartMs": 1287520,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "And they did research,"
    } ]
  }, {
    "tStartMs": 1288560,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and they found that 3M was\nmaking these organic fluorides,"
    } ]
  }, {
    "tStartMs": 1293440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "things like PFOA."
    } ]
  }, {
    "tStartMs": 1294880,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "All right, so they approached\n3M in 1975, asking them,"
    } ]
  }, {
    "tStartMs": 1299840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "\"Hey, we found this stuff"
    } ]
  }, {
    "tStartMs": 1302000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "in the general US population's blood."
    } ]
  }, {
    "tStartMs": 1304480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You know, could it be yours?\""
    } ]
  }, {
    "tStartMs": 1306640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And 3M pled ignorance."
    } ]
  }, {
    "tStartMs": 1309440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- But just three months later,"
    } ]
  }, {
    "tStartMs": 1311840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "3M compared the spectrum of\norganic fluorine from the study"
    } ]
  }, {
    "tStartMs": 1315040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to their own chemicals, and"
    } ]
  }, {
    "tStartMs": 1317440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it was a match."
    } ]
  }, {
    "tStartMs": 1318880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Their chemicals were\ngetting into the blood"
    } ]
  }, {
    "tStartMs": 1320880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "of people all across the United States,"
    } ]
  }, {
    "tStartMs": 1323440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "but they didn't tell the researchers."
    } ]
  }, {
    "tStartMs": 1326720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "3M and DuPont were worried,"
    } ]
  }, {
    "tStartMs": 1328800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "so they checked their own workers' blood,"
    } ]
  }, {
    "tStartMs": 1331040,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and they found that they too\nwere contaminated with C8"
    } ]
  }, {
    "tStartMs": 1334480,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "at levels 1,000 times higher\nthan those in the study."
    } ]
  }, {
    "tStartMs": 1338480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And when DuPont checked\ntheir medical records,"
    } ]
  }, {
    "tStartMs": 1340880,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "many of these workers were\nshowing signs of liver disease."
    } ]
  }, {
    "tStartMs": 1344800,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Meanwhile, DuPont was\ndumping almost 10 tons of C8"
    } ]
  }, {
    "tStartMs": 1348720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "into the Ohio River each year,"
    } ]
  }, {
    "tStartMs": 1351040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and they were piling\nup thousands more tons"
    } ]
  }, {
    "tStartMs": 1353600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "as C8 sludge that would leach"
    } ]
  }, {
    "tStartMs": 1355680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "from the landfill next to Earl's farm,"
    } ]
  }, {
    "tStartMs": 1358400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "all while showing commercials like these."
    } ]
  }, {
    "tStartMs": 1360640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- And the water that\neventually flows to the river"
    } ]
  }, {
    "tStartMs": 1363840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "is collected at five points and analyzed"
    } ]
  }, {
    "tStartMs": 1366080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to make sure we don't pollute the Ohio."
    } ]
  }, {
    "tStartMs": 1368240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- And by the early '80s,"
    } ]
  }, {
    "tStartMs": 1369840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the first cancer study is done in rats,"
    } ]
  }, {
    "tStartMs": 1372160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and it confirms PFOA causes,"
    } ]
  }, {
    "tStartMs": 1376080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "not just might be linked with,"
    } ]
  }, {
    "tStartMs": 1377520,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "but causes testicular tumors, all right?"
    } ]
  }, {
    "tStartMs": 1381440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "That sends alarm bells\noff within the company"
    } ]
  }, {
    "tStartMs": 1384720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "because the concern is, of course,"
    } ]
  }, {
    "tStartMs": 1386880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "we're putting this in the air,\nwe're putting in the water."
    } ]
  }, {
    "tStartMs": 1389120,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "It's in Teflon."
    } ]
  }, {
    "tStartMs": 1390240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "- DuPont collected samples\naround Washington Works,"
    } ]
  }, {
    "tStartMs": 1393520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and C8 wasn't just in the river,"
    } ]
  }, {
    "tStartMs": 1395440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "it was in the public water supply."
    } ]
  }, {
    "tStartMs": 1398240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So in 1984, DuPont officials met"
    } ]
  }, {
    "tStartMs": 1401040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to assess whether C8 should be swapped"
    } ]
  }, {
    "tStartMs": 1403280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for a safer chemical."
    } ]
  }, {
    "tStartMs": 1405200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But their conclusion\nwas that currently none"
    } ]
  }, {
    "tStartMs": 1407680,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "of the options developed are,"
    } ]
  }, {
    "tStartMs": 1409200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "from a fine powder business standpoint,"
    } ]
  }, {
    "tStartMs": 1411840,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "economically attractive,\nso C8 stuck around,"
    } ]
  }, {
    "tStartMs": 1415920,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and DuPont just came up with a\nsafe dose for drinking water."
    } ]
  }, {
    "tStartMs": 1419920,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- DuPont scientists are the\nfirst people on the planet"
    } ]
  }, {
    "tStartMs": 1422960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to say what would be a\nsafe level for humans."
    } ]
  }, {
    "tStartMs": 1425840,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "They calculated something\nlike 0.6 parts per billion,"
    } ]
  }, {
    "tStartMs": 1430400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "which they rounded up to one."
    } ]
  }, {
    "tStartMs": 1432080,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And the importance of\nthat is, at that time,"
    } ]
  }, {
    "tStartMs": 1434560,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "that was about the lowest level\nyou could detect in water."
    } ]
  }, {
    "tStartMs": 1438720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Essentially, if we can\ndetect it, it's too high."
    } ]
  }, {
    "tStartMs": 1442080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- So to put that into perspective,"
    } ]
  }, {
    "tStartMs": 1444400,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "here is one 2,500-liter tank of water."
    } ]
  }, {
    "tStartMs": 1448240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It filled to the brim."
    } ]
  }, {
    "tStartMs": 1449680,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Now, imagine you take one drop\nof PFOA, 0.05 milliliters,"
    } ]
  }, {
    "tStartMs": 1453840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and you place it not in one of these tanks"
    } ]
  }, {
    "tStartMs": 1455840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "or two or three,"
    } ]
  }, {
    "tStartMs": 1457520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "20 of these tanks."
    } ]
  }, {
    "tStartMs": 1459120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "That's one part per billion,"
    } ]
  }, {
    "tStartMs": 1460720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and that's the number DuPont thought"
    } ]
  }, {
    "tStartMs": 1462480,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "would be unsafe for humans to drink."
    } ]
  }, {
    "tStartMs": 1464160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- And after determining\nits own safety metric,"
    } ]
  }, {
    "tStartMs": 1467120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "DuPont tested the landfill\nwastewater leaching"
    } ]
  }, {
    "tStartMs": 1469680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "into Earl's creek."
    } ]
  }, {
    "tStartMs": 1471040,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "It came back at 1,600 parts per billion."
    } ]
  }, {
    "tStartMs": 1474840,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- They didn't tell anybody."
    } ]
  }, {
    "tStartMs": 1476960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So at that point, I\nthought I had figured out"
    } ]
  }, {
    "tStartMs": 1479760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "what had finally happened to the cows."
    } ]
  }, {
    "tStartMs": 1481840,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "- Rob compiled all the\nevidence into a 900-page letter"
    } ]
  }, {
    "tStartMs": 1486240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and sent it to the EPA,\nthe Department of Justice,"
    } ]
  }, {
    "tStartMs": 1488960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and even the US Attorney General."
    } ]
  }, {
    "tStartMs": 1492000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And just a few months later,"
    } ]
  }, {
    "tStartMs": 1493520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "DuPont settled with Earl Tennant"
    } ]
  }, {
    "tStartMs": 1495200,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and his family for an undisclosed sum,"
    } ]
  }, {
    "tStartMs": 1497440,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "although they didn't\nadmit to any wrongdoing."
    } ]
  }, {
    "tStartMs": 1500440,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- But this stuff wasn't just"
    } ]
  }, {
    "tStartMs": 1502720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in the water the cows were drinking."
    } ]
  }, {
    "tStartMs": 1505120,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "This was in"
    } ]
  }, {
    "tStartMs": 1506160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the surrounding communities'\npublic wells, right?"
    } ]
  }, {
    "tStartMs": 1509280,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "People around Mr. Tennant,"
    } ]
  }, {
    "tStartMs": 1510800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "the tens of thousands of people"
    } ]
  }, {
    "tStartMs": 1512320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "in that community had\nlikely been drinking this"
    } ]
  }, {
    "tStartMs": 1514640,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "for decades and didn't know."
    } ]
  }, {
    "tStartMs": 1516360,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- So Rob sued DuPont again,"
    } ]
  }, {
    "tStartMs": 1518960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "now on behalf of the 70,000\npeople around Parkersburg"
    } ]
  }, {
    "tStartMs": 1522880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "who were unwittingly exposed to C8."
    } ]
  }, {
    "tStartMs": 1525680,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And it wasn't just\nParkersburg or West Virginia."
    } ]
  }, {
    "tStartMs": 1529360,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "In the year 2000, researchers\nanalyzed blood samples"
    } ]
  }, {
    "tStartMs": 1532320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "from thousands of Americans\nall across the country,"
    } ]
  }, {
    "tStartMs": 1535440,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and 100% of those samples\ncame back positive for C8"
    } ]
  }, {
    "tStartMs": 1540320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "at an average of five parts per billion."
    } ]
  }, {
    "tStartMs": 1543920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "But if virtually everyone\nin the US is contaminated,"
    } ]
  }, {
    "tStartMs": 1547600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "how harmful could C8 really be?"
    } ]
  }, {
    "tStartMs": 1550560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is exactly what Rob had to find out"
    } ]
  }, {
    "tStartMs": 1552560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to have a fighting chance against DuPont."
    } ]
  }, {
    "tStartMs": 1554960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So in 2005, he spearheaded a medical study"
    } ]
  }, {
    "tStartMs": 1558080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "of everyone around Washington Works."
    } ]
  }, {
    "tStartMs": 1560800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- Scientists need to know"
    } ]
  }, {
    "tStartMs": 1562160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "if the chemical C8 causes\nany health problems."
    } ]
  }, {
    "tStartMs": 1564800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "By completing a health questionnaire"
    } ]
  }, {
    "tStartMs": 1566160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and having your blood\ntested, you can help."
    } ]
  }, {
    "tStartMs": 1568440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Analyzing the blood samples"
    } ]
  }, {
    "tStartMs": 1570000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and medical records took seven long years,"
    } ]
  }, {
    "tStartMs": 1573200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and many in Parkersburg passed away"
    } ]
  }, {
    "tStartMs": 1575200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "before a verdict was even reached,"
    } ]
  }, {
    "tStartMs": 1576960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "including Earl and his wife Sandra."
    } ]
  }, {
    "tStartMs": 1580560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But finally, in 2013,"
    } ]
  }, {
    "tStartMs": 1582640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "an independent science\npanel had the results."
    } ]
  }, {
    "tStartMs": 1585680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "They confirmed a probable link between C8"
    } ]
  }, {
    "tStartMs": 1588160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and six human diseases,\nincluding thyroid disease,"
    } ]
  }, {
    "tStartMs": 1591840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "testicular cancer, and kidney cancer."
    } ]
  }, {
    "tStartMs": 1594800,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And these findings were based\nsolely on the nearby community"
    } ]
  }, {
    "tStartMs": 1598080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "with an average C8 blood\nlevel of 28 parts per billion."
    } ]
  }, {
    "tStartMs": 1602000,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So for example, an American\nmale has around a 1 in 43 chance"
    } ]
  }, {
    "tStartMs": 1605520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of developing kidney cancer."
    } ]
  }, {
    "tStartMs": 1607200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It's around 1 in 73 for females,"
    } ]
  }, {
    "tStartMs": 1609840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but a person with more\nthan 30 parts per billion"
    } ]
  }, {
    "tStartMs": 1611840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of C8 in their blood serum"
    } ]
  }, {
    "tStartMs": 1613280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "might have about double the odds,"
    } ]
  }, {
    "tStartMs": 1615280,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "so roughly 1 in 22 for males\nand 1 in 37 for females."
    } ]
  }, {
    "tStartMs": 1620320,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "But the data in many"
    } ]
  }, {
    "tStartMs": 1621360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of these studies only included survivors,"
    } ]
  }, {
    "tStartMs": 1623760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "not people who might have\nalready died from C8 exposure."
    } ]
  }, {
    "tStartMs": 1626960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "So the verdict was"
    } ]
  }, {
    "tStartMs": 1627920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that the findings must be\ninterpreted with caution."
    } ]
  }, {
    "tStartMs": 1631280,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The true risk of C8 might be even higher."
    } ]
  }, {
    "tStartMs": 1635440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Luckily, once these studies\nwere published in 2013,"
    } ]
  }, {
    "tStartMs": 1638720,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "DuPont was pressured by the\nregulators to phase out C8."
    } ]
  }, {
    "tStartMs": 1642640,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And by 2017, they had to\npay out over $600 million"
    } ]
  }, {
    "tStartMs": 1646480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "to victims of C8 exposure,"
    } ]
  }, {
    "tStartMs": 1649280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "which is a pretty small price to pay"
    } ]
  }, {
    "tStartMs": 1651040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "for a company that made almost $80 billion"
    } ]
  }, {
    "tStartMs": 1653280,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "in sales just that year."
    } ]
  }, {
    "tStartMs": 1656000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And all throughout, DuPont\ndenied any wrongdoing,"
    } ]
  }, {
    "tStartMs": 1660000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but that wasn't the end of it\nfor Parkersburg or anyone else"
    } ]
  }, {
    "tStartMs": 1664000,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "because DuPont separated\nits entire Teflon business"
    } ]
  }, {
    "tStartMs": 1667280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "into a spinoff company, Chemours,"
    } ]
  }, {
    "tStartMs": 1669760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that agreed to use a different chemical."
    } ]
  }, {
    "tStartMs": 1673360,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "So what was it?"
    } ]
  }, {
    "tStartMs": 1674520,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "- They simply took C8 and\nknocked two carbons off"
    } ]
  }, {
    "tStartMs": 1678880,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and started making C6."
    } ]
  }, {
    "tStartMs": 1680760,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- They called it GenX."
    } ]
  }, {
    "tStartMs": 1683440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Because it was shorter"
    } ]
  }, {
    "tStartMs": 1684480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and had an oxygen atom\ninterrupting the carbon chain,"
    } ]
  }, {
    "tStartMs": 1687360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it was expected to be more degradable."
    } ]
  }, {
    "tStartMs": 1689760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So Chemours claimed a dose as\nhigh as 70 parts per billion"
    } ]
  }, {
    "tStartMs": 1692960,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "of GenX in drinking water\nwould still be safe."
    } ]
  }, {
    "tStartMs": 1695880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- That chemical gets shipped"
    } ]
  }, {
    "tStartMs": 1697920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to the same plant in West Virginia."
    } ]
  }, {
    "tStartMs": 1700240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So now GenX goes into the air."
    } ]
  }, {
    "tStartMs": 1702480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "GenX goes into the Ohio River."
    } ]
  }, {
    "tStartMs": 1704480,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "GenX is found in public water supplies."
    } ]
  }, {
    "tStartMs": 1707440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So GenX is allowed to\ncome out into the world,"
    } ]
  }, {
    "tStartMs": 1710640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "be used in Teflon."
    } ]
  }, {
    "tStartMs": 1712560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Then the cancer study is done,"
    } ]
  }, {
    "tStartMs": 1714560,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "which shows GenX causes\nthe exact same three tumors"
    } ]
  }, {
    "tStartMs": 1719040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "in rats that PFOA did:"
    } ]
  }, {
    "tStartMs": 1721520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "liver, testicular, and pancreatic."
    } ]
  }, {
    "tStartMs": 1723680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- And the fact that its chain"
    } ]
  }, {
    "tStartMs": 1725600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "is shorter also makes GenX more mobile,"
    } ]
  }, {
    "tStartMs": 1728320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "so it could contaminate larger areas."
    } ]
  }, {
    "tStartMs": 1731280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The truth is we just don't\nknow enough about it,"
    } ]
  }, {
    "tStartMs": 1734240,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and that's exactly the problem."
    } ]
  }, {
    "tStartMs": 1735960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- It took us decades to get to the point"
    } ]
  }, {
    "tStartMs": 1738720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of finally addressing C8."
    } ]
  }, {
    "tStartMs": 1741120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "They simply tweak it a bit,\nchange the chemical name."
    } ]
  }, {
    "tStartMs": 1744720,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "All of the science and all\nof the concern, that's on C8."
    } ]
  }, {
    "tStartMs": 1749360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This is C6 or C9 or C4."
    } ]
  }, {
    "tStartMs": 1752480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "You don't have enough evidence"
    } ]
  }, {
    "tStartMs": 1754800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that these other ones are bad."
    } ]
  }, {
    "tStartMs": 1756720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "This is Whac-A-Mole."
    } ]
  }, {
    "tStartMs": 1757920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "We get to the point we're addressing one"
    } ]
  }, {
    "tStartMs": 1759840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "and the new one pops up"
    } ]
  }, {
    "tStartMs": 1760960,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "and we're told we have to start over."
    } ]
  }, {
    "tStartMs": 1762600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- And it isn't just C8 or GenX."
    } ]
  }, {
    "tStartMs": 1766640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "They belong to a family"
    } ]
  }, {
    "tStartMs": 1767840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of over 14,000 different\nmanmade chemicals,"
    } ]
  }, {
    "tStartMs": 1770960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "all covered in carbon-fluorine bonds."
    } ]
  }, {
    "tStartMs": 1773600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And companies can make\nthem however they want,"
    } ]
  }, {
    "tStartMs": 1775840,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "C7s, C9s, branched, polymers, acids."
    } ]
  }, {
    "tStartMs": 1779840,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The generic term for all of\nthese substances is PFAS,"
    } ]
  }, {
    "tStartMs": 1783680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "per- and polyfluoroalkyl substances,"
    } ]
  }, {
    "tStartMs": 1786880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and like Teflon, they have\nalmost magical qualities."
    } ]
  }, {
    "tStartMs": 1790640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "They repel liquids,"
    } ]
  }, {
    "tStartMs": 1791840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "so PFAS are used to make\nclothing waterproof."
    } ]
  }, {
    "tStartMs": 1794880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "They're also grease-resistant,"
    } ]
  }, {
    "tStartMs": 1796400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "so we coat things like fast food wrappers"
    } ]
  }, {
    "tStartMs": 1798400,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and microwave popcorn bags\nin PFAS to prevent stains."
    } ]
  }, {
    "tStartMs": 1802160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Waterproof lipstick and\nmascara, hygiene products,"
    } ]
  }, {
    "tStartMs": 1805040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and even contact lenses have PFAS in."
    } ]
  }, {
    "tStartMs": 1807680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Even the screen you're watching this on,"
    } ]
  }, {
    "tStartMs": 1809760,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "likely has a PFAS anti-smudge coating."
    } ]
  }, {
    "tStartMs": 1813520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "(brooding music)"
    } ]
  }, {
    "tStartMs": 1814880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The trouble is that the\nsame carbon-fluorine bonds"
    } ]
  }, {
    "tStartMs": 1817520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that make PFAS so stable"
    } ]
  }, {
    "tStartMs": 1819120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and useful in consumer products"
    } ]
  }, {
    "tStartMs": 1821440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "also make them incredibly\npersistent in the environment."
    } ]
  }, {
    "tStartMs": 1825040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Which is why you might also know PFAS"
    } ]
  }, {
    "tStartMs": 1826960,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "under a different name, forever chemicals."
    } ]
  }, {
    "tStartMs": 1830160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "They have been found\neverywhere from bustling cities"
    } ]
  }, {
    "tStartMs": 1833520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to untouched areas of wilderness."
    } ]
  }, {
    "tStartMs": 1836240,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Every continent, including\nAntarctica, has PFAS all over it."
    } ]
  }, {
    "tStartMs": 1840960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- Almost every living creature"
    } ]
  }, {
    "tStartMs": 1843440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "from polar bears to birds to fish,"
    } ]
  }, {
    "tStartMs": 1846640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I mean, this stuff is\nbeing found everywhere."
    } ]
  }, {
    "tStartMs": 1849680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So massive worldwide contamination,"
    } ]
  }, {
    "tStartMs": 1852800,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "but by completely manmade chemicals"
    } ]
  }, {
    "tStartMs": 1856720,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "that are fingerprints back to\njust a couple of companies."
    } ]
  }, {
    "tStartMs": 1860920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Even though companies knew"
    } ]
  }, {
    "tStartMs": 1863200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "how dangerous these\nchemicals were 50 years ago,"
    } ]
  }, {
    "tStartMs": 1865680,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "they decided not to inform\nthe public and the regulators."
    } ]
  }, {
    "tStartMs": 1868960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So we're only finding out"
    } ]
  }, {
    "tStartMs": 1870400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "about this global contamination now."
    } ]
  }, {
    "tStartMs": 1872880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And there've been many cases"
    } ]
  }, {
    "tStartMs": 1874160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "where important public health information"
    } ]
  }, {
    "tStartMs": 1876240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "doesn't get widely disseminated for years."
    } ]
  }, {
    "tStartMs": 1879040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And whenever that happens,"
    } ]
  }, {
    "tStartMs": 1880320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "media coverage can be inconsistent,"
    } ]
  }, {
    "tStartMs": 1882400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "which is why I've partnered\nup with Ground News"
    } ]
  }, {
    "tStartMs": 1884960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "as the sponsor of this video."
    } ]
  }, {
    "tStartMs": 1887120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Their platform reveals how\nstories like these are covered"
    } ]
  }, {
    "tStartMs": 1889760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "across the media landscape."
    } ]
  }, {
    "tStartMs": 1891600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "For example, a recent study suggested"
    } ]
  }, {
    "tStartMs": 1893440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that 23 million Americans"
    } ]
  }, {
    "tStartMs": 1895360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "were exposed to forever\nchemicals through wastewater,"
    } ]
  }, {
    "tStartMs": 1898560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "but you probably haven't seen the story"
    } ]
  }, {
    "tStartMs": 1900640,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "since fewer than 40\noutlets even published it."
    } ]
  }, {
    "tStartMs": 1903600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And take a look at how different some"
    } ]
  }, {
    "tStartMs": 1905600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of these headlines are."
    } ]
  }, {
    "tStartMs": 1907040,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "With Ground News,"
    } ]
  }, {
    "tStartMs": 1908160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "you can also see that\ngovernment-funded sources"
    } ]
  }, {
    "tStartMs": 1910320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "had limited reporting of this story,"
    } ]
  }, {
    "tStartMs": 1912640,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and only 9% of the publications\nwere right-leaning."
    } ]
  }, {
    "tStartMs": 1916080,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So Ground News flagged this\nas a potential blind spot."
    } ]
  }, {
    "tStartMs": 1919440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It's highlighted on their blind-spot feed"
    } ]
  }, {
    "tStartMs": 1921680,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "where you can see stories"
    } ]
  }, {
    "tStartMs": 1922720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that are disproportionately covered"
    } ]
  }, {
    "tStartMs": 1924320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "by one side of the political spectrum."
    } ]
  }, {
    "tStartMs": 1927360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The whole point of\nVeritasium is to make videos"
    } ]
  }, {
    "tStartMs": 1929920,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "that get to the truth,"
    } ]
  }, {
    "tStartMs": 1931040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "whether that's explaining misconceptions"
    } ]
  }, {
    "tStartMs": 1932800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "or getting to the bottom of\npotentially dangerous chemicals."
    } ]
  }, {
    "tStartMs": 1936240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Ground News helps us do that,\nand they can help you too."
    } ]
  }, {
    "tStartMs": 1939440,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So if you, like us, care\nabout getting to the truth,"
    } ]
  }, {
    "tStartMs": 1942400,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "go to ground.news/ve or scan this QR code."
    } ]
  }, {
    "tStartMs": 1946240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Our link gets you 40%\noff their vantage plan."
    } ]
  }, {
    "tStartMs": 1949440,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And now back to PFAS."
    } ]
  }, {
    "tStartMs": 1952480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "(quirky music)"
    } ]
  }, {
    "tStartMs": 1953920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Okay, now I wanna find out how much"
    } ]
  }, {
    "tStartMs": 1957120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of these chemicals is\nactually in my blood."
    } ]
  }, {
    "tStartMs": 1960000,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "So I have a little test here. (groans)"
    } ]
  }, {
    "tStartMs": 1965520,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "I hate the idea of drawing\nmy own blood. (groans)"
    } ]
  }, {
    "tStartMs": 1972320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Okay, that was pretty easy, actually."
    } ]
  }, {
    "tStartMs": 1974720,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "I was really worried"
    } ]
  }, {
    "tStartMs": 1975520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that there was not gonna\nbe enough blood coming out."
    } ]
  }, {
    "tStartMs": 1978480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But there was plenty."
    } ]
  }, {
    "tStartMs": 1980400,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "(sighs) So the question is,"
    } ]
  }, {
    "tStartMs": 1983440,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "how much of these dangerous\nchemicals are in my blood?"
    } ]
  }, {
    "tStartMs": 1986360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- Has anyone ever come back with blood"
    } ]
  }, {
    "tStartMs": 1988880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that has zero PFAS whatsoever?"
    } ]
  }, {
    "tStartMs": 1990720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "- I've been doing blood\ntesting on PFAS since 2007,"
    } ]
  }, {
    "tStartMs": 1994400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and I've never seen a non-detect."
    } ]
  }, {
    "tStartMs": 1996200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- No way.\n- So I hear that 98%"
    } ]
  }, {
    "tStartMs": 1999440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "of the population has PFAS in their blood,"
    } ]
  }, {
    "tStartMs": 2001440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but I'm looking for that 2% that doesn't"
    } ]
  }, {
    "tStartMs": 2003680,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "because I've yet to see them."
    } ]
  }, {
    "tStartMs": 2005320,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- That's incredible, I mean very,"
    } ]
  }, {
    "tStartMs": 2007440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "very bad incredible, but wow."
    } ]
  }, {
    "tStartMs": 2009840,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- But if everyone on\nEarth has trace amounts"
    } ]
  }, {
    "tStartMs": 2013360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of these chemicals in their blood,"
    } ]
  }, {
    "tStartMs": 2015040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "how much harm could they really be doing?"
    } ]
  }, {
    "tStartMs": 2017200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- I wanna make a distinction"
    } ]
  }, {
    "tStartMs": 2018880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "because it turns out not all\nPFAS are equally dangerous."
    } ]
  }, {
    "tStartMs": 2022160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You can kind of split\nthem up into two groups."
    } ]
  }, {
    "tStartMs": 2024160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "First up, you have long, repeating chains"
    } ]
  }, {
    "tStartMs": 2026320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "of carbon-fluorine bonds"
    } ]
  }, {
    "tStartMs": 2027440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "that are tens or hundreds\nof thousands of atoms long,"
    } ]
  }, {
    "tStartMs": 2030880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "so stuff like Teflon."
    } ]
  }, {
    "tStartMs": 2032480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "These are so big and inert that\neven if you do ingest them,"
    } ]
  }, {
    "tStartMs": 2035120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "your body's just gonna flush them out."
    } ]
  }, {
    "tStartMs": 2036560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "They can't be absorbed\ninto your bloodstream,"
    } ]
  }, {
    "tStartMs": 2038400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so you're pretty safe."
    } ]
  }, {
    "tStartMs": 2040320,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "They're called fluoropolymers"
    } ]
  }, {
    "tStartMs": 2041680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "because of the long repeating chains"
    } ]
  }, {
    "tStartMs": 2043280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "of carbon and fluorine bonds."
    } ]
  }, {
    "tStartMs": 2044880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But the catch is to make\nthese fluoropolymers,"
    } ]
  }, {
    "tStartMs": 2047440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "stuff like Teflon, you need\nto use processing aids,"
    } ]
  }, {
    "tStartMs": 2049840,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "things like PFOA or GenX,\nand those are the nasty ones."
    } ]
  }, {
    "tStartMs": 2053600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "These molecules are 5 to 10 carbons long,"
    } ]
  }, {
    "tStartMs": 2055840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "which makes them small enough"
    } ]
  }, {
    "tStartMs": 2057040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to actually enter the bloodstream."
    } ]
  }, {
    "tStartMs": 2059760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They have functional groups at the ends"
    } ]
  }, {
    "tStartMs": 2061200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "that are usually acids."
    } ]
  }, {
    "tStartMs": 2062480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The most common ones are\nperfluoroalkyl acids,"
    } ]
  }, {
    "tStartMs": 2065920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "which means that they can bind\nto the proteins in your blood"
    } ]
  }, {
    "tStartMs": 2068160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and be transported anywhere in the body."
    } ]
  }, {
    "tStartMs": 2070960,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "So they slowly accumulate\nand build up over time."
    } ]
  }, {
    "tStartMs": 2075360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Now, there are more than\njust two groups of PFAS"
    } ]
  }, {
    "tStartMs": 2077440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and even different definitions\nof what PFAS even are,"
    } ]
  }, {
    "tStartMs": 2080800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "but most of what we know really relates"
    } ]
  }, {
    "tStartMs": 2082640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to just a handful of chemicals\nfrom this group here,"
    } ]
  }, {
    "tStartMs": 2085280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to these perfluoroalkyl acids."
    } ]
  }, {
    "tStartMs": 2088160,
    "dDurationMs": 924,
    "segs": [ {
      "utf8": "(wondrous music)"
    } ]
  }, {
    "tStartMs": 2089084,
    "dDurationMs": 3156,
    "segs": [ {
      "utf8": "- Perhaps the most comprehensive\ndocument on PFAS toxicity"
    } ]
  }, {
    "tStartMs": 2092240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "was published in 2022"
    } ]
  }, {
    "tStartMs": 2094080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "by the National Academies of Sciences,"
    } ]
  }, {
    "tStartMs": 2096480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Engineering, and Medicine."
    } ]
  }, {
    "tStartMs": 2098080,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And it looked at only\nseven perfluoroalkyl acids."
    } ]
  }, {
    "tStartMs": 2102400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "These are sister chemicals to PFOA."
    } ]
  }, {
    "tStartMs": 2104880,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And some of them, like PFOS and PFHxS,"
    } ]
  }, {
    "tStartMs": 2108560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "were used heavily in\nthe production of stain"
    } ]
  }, {
    "tStartMs": 2110880,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and water-resistant products\nlike 3M's Scotchgard"
    } ]
  }, {
    "tStartMs": 2114400,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "before they too got phased\nout due to toxicity concerns."
    } ]
  }, {
    "tStartMs": 2118960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The report surmised that if the sum"
    } ]
  }, {
    "tStartMs": 2121040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "of these seven acids in your blood"
    } ]
  }, {
    "tStartMs": 2122800,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "is below two parts per billion,\nthere shouldn't be any harm."
    } ]
  }, {
    "tStartMs": 2127120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If your level is between 2\nand 20 parts per billion,"
    } ]
  }, {
    "tStartMs": 2129760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "there's a potential for\nharmful health effects."
    } ]
  }, {
    "tStartMs": 2132400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Although the exact mechanism"
    } ]
  }, {
    "tStartMs": 2134160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "by which PFAS cause harm\nisn't fully understood,"
    } ]
  }, {
    "tStartMs": 2137600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "exposure has most\nconsistently been associated"
    } ]
  }, {
    "tStartMs": 2140480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "with high cholesterol, a\ndecreased immune system response"
    } ]
  }, {
    "tStartMs": 2143280,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to vaccines and infections, kidney cancer,"
    } ]
  }, {
    "tStartMs": 2146000,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and decreased growth in infants."
    } ]
  }, {
    "tStartMs": 2148560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But PFAS have also been linked"
    } ]
  }, {
    "tStartMs": 2150240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to dozens of other conditions,"
    } ]
  }, {
    "tStartMs": 2152240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and above 20 parts per billion,\nthe risk is even greater."
    } ]
  }, {
    "tStartMs": 2156240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So where do I fall on this graph?"
    } ]
  }, {
    "tStartMs": 2159240,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- Right, so I have your results here."
    } ]
  }, {
    "tStartMs": 2162400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- You're not gonna tell me what yours were"
    } ]
  }, {
    "tStartMs": 2163840,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "before I see mine?"
    } ]
  }, {
    "tStartMs": 2165120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 2166320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- All right."
    } ]
  }, {
    "tStartMs": 2167600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- You're positive for PFOA."
    } ]
  }, {
    "tStartMs": 2169760,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 2170560,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "- The level for PFOA for\na US person went down"
    } ]
  }, {
    "tStartMs": 2175120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "from five parts per\nbillion around the 2000s"
    } ]
  }, {
    "tStartMs": 2177440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to around 1.46, what you have."
    } ]
  }, {
    "tStartMs": 2180320,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "So you're super average for a US person."
    } ]
  }, {
    "tStartMs": 2183400,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- Great. Okay."
    } ]
  }, {
    "tStartMs": 2184640,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- The good news is though,\nno GenX for you or for me,"
    } ]
  }, {
    "tStartMs": 2188160,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "which is great."
    } ]
  }, {
    "tStartMs": 2188760,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- All right, let's go."
    } ]
  }, {
    "tStartMs": 2190520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- But the real surprise, I ,guess is PFOS,"
    } ]
  }, {
    "tStartMs": 2193760,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the sister chemical, and it\nwas used in a similar way,"
    } ]
  }, {
    "tStartMs": 2196080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "so stain-resistant\ncarpets, treated clothing,"
    } ]
  }, {
    "tStartMs": 2198080,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and your result is at\n8.93 parts per billion,"
    } ]
  }, {
    "tStartMs": 2201520,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "whereas the US average is 4.3."
    } ]
  }, {
    "tStartMs": 2205760,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "-Yeah."
    } ]
  }, {
    "tStartMs": 2206160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- That's crazy."
    } ]
  }, {
    "tStartMs": 2207360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- Yeah, it is crazy"
    } ]
  }, {
    "tStartMs": 2208640,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "'cause it was discontinued\npretty much in 2002."
    } ]
  }, {
    "tStartMs": 2211600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- This is not the results I expected."
    } ]
  }, {
    "tStartMs": 2213920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "I honestly expected very boring results"
    } ]
  }, {
    "tStartMs": 2215760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of, like, yeah, you're\naround the middle of the pack"
    } ]
  }, {
    "tStartMs": 2218640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "or a little bit on the low side."
    } ]
  }, {
    "tStartMs": 2220320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- And then for PFHxS,"
    } ]
  }, {
    "tStartMs": 2222960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "basically PFOS but six\ninstead of eight carbons,"
    } ]
  }, {
    "tStartMs": 2225760,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "your levels here are almost\nseven parts per billion,"
    } ]
  }, {
    "tStartMs": 2228560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but the US average average\nis one part per billion."
    } ]
  }, {
    "tStartMs": 2230960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "You're higher than 95% of Americans."
    } ]
  }, {
    "tStartMs": 2232800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- It just, like, it shocks me"
    } ]
  }, {
    "tStartMs": 2234960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "'cause, like, I was fully walking"
    } ]
  }, {
    "tStartMs": 2236400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "into this meeting expecting to be,"
    } ]
  }, {
    "tStartMs": 2238080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "you know, roughly average."
    } ]
  }, {
    "tStartMs": 2239360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- Yeah, to me, it's scary."
    } ]
  }, {
    "tStartMs": 2240880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You know, you live in\na normal life thinking"
    } ]
  }, {
    "tStartMs": 2242880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "that you're taking care of everything,"
    } ]
  }, {
    "tStartMs": 2244400,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "and then you have high levels"
    } ]
  }, {
    "tStartMs": 2245520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of a chemical you never heard of."
    } ]
  }, {
    "tStartMs": 2246960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- The combined sum of all\nthe PFAS detected in my blood"
    } ]
  }, {
    "tStartMs": 2250560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "was 17.92 parts per billion,"
    } ]
  }, {
    "tStartMs": 2253840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "more than double the US median."
    } ]
  }, {
    "tStartMs": 2256480,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "I'm just below the level"
    } ]
  }, {
    "tStartMs": 2257760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "where the National Academies\nrecommend additional screenings"
    } ]
  }, {
    "tStartMs": 2260960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "for PFAS-related diseases."
    } ]
  }, {
    "tStartMs": 2263840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I had no idea I would come\nback with such elevated levels."
    } ]
  }, {
    "tStartMs": 2266880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I'd love to get the\nlevel, sort of, down a bit"
    } ]
  }, {
    "tStartMs": 2268960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to a level where I feel\nlike it's more in line"
    } ]
  }, {
    "tStartMs": 2270960,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "with the general population."
    } ]
  }, {
    "tStartMs": 2272280,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 2273200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- But, like, where could\nthis have come from?"
    } ]
  }, {
    "tStartMs": 2275920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "There are three main ways we get exposed"
    } ]
  }, {
    "tStartMs": 2277840,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to forever chemicals,"
    } ]
  }, {
    "tStartMs": 2279200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and the one you'll hear\nthe most about in the media"
    } ]
  }, {
    "tStartMs": 2281280,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "is likely PFAS-containing products."
    } ]
  }, {
    "tStartMs": 2283960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- Shampoo, dental floss,\npaints, varnishes."
    } ]
  }, {
    "tStartMs": 2286480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Potentially dangerous chemicals."
    } ]
  }, {
    "tStartMs": 2288080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- Dangerous chemicals, toxic chemicals."
    } ]
  }, {
    "tStartMs": 2290320,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- People are throwing out\ntheir non-stick cookware."
    } ]
  }, {
    "tStartMs": 2293680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- My wife threw out all our\nnon-stick pans over a year ago,"
    } ]
  }, {
    "tStartMs": 2296800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and since then, we've been\nusing stainless steel."
    } ]
  }, {
    "tStartMs": 2299040,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "She is very good at making it\nnot stick. Me, not so much."
    } ]
  }, {
    "tStartMs": 2302720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But are pans really the problem?"
    } ]
  }, {
    "tStartMs": 2305200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The actual coating on the pan is Teflon,"
    } ]
  }, {
    "tStartMs": 2307680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "which, again, is just a long, inert chain"
    } ]
  }, {
    "tStartMs": 2310000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "of carbon-fluorine bonds."
    } ]
  }, {
    "tStartMs": 2311760,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "So even if you ingest it, it\ndoesn't react with your body."
    } ]
  }, {
    "tStartMs": 2315920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "If you have a pan like that at home,"
    } ]
  }, {
    "tStartMs": 2317840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "you probably don't need to throw it out."
    } ]
  }, {
    "tStartMs": 2320160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The same goes for most other\nPFAS-containing products."
    } ]
  }, {
    "tStartMs": 2323840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Waterproof clothing,\nstain-resistant furniture,"
    } ]
  }, {
    "tStartMs": 2326240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and sweat-proof watchbands"
    } ]
  }, {
    "tStartMs": 2327920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "might all release some level of PFAS,"
    } ]
  }, {
    "tStartMs": 2330720,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "but the risk of direct exposure\nthrough skin is likely low."
    } ]
  }, {
    "tStartMs": 2335440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So the bigger problem is how easily PFAS"
    } ]
  }, {
    "tStartMs": 2338160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "from these products can\nend up in the environment."
    } ]
  }, {
    "tStartMs": 2341040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And many of the factories"
    } ]
  }, {
    "tStartMs": 2342320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that make these products\ndon't have a good track record"
    } ]
  }, {
    "tStartMs": 2345440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of keeping the chemicals contained."
    } ]
  }, {
    "tStartMs": 2347240,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "- People don't understand\nthat the stories that you see,"
    } ]
  }, {
    "tStartMs": 2351280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "for example, what was happening"
    } ]
  }, {
    "tStartMs": 2352560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "in the community in West Virginia,"
    } ]
  }, {
    "tStartMs": 2355120,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "this is the same chemical\nand the same things"
    } ]
  }, {
    "tStartMs": 2357840,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "that we're seeing play\nout now in Australia"
    } ]
  }, {
    "tStartMs": 2361360,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and in Japan, in Italy,\nin Germany, in the UK."
    } ]
  }, {
    "tStartMs": 2365440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I mean, there are a lot of folks"
    } ]
  }, {
    "tStartMs": 2367040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that are still not grasping the fact"
    } ]
  }, {
    "tStartMs": 2369520,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "that these are the same chemicals."
    } ]
  }, {
    "tStartMs": 2371960,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "- Our second main source\nof exposure is food."
    } ]
  }, {
    "tStartMs": 2375840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "A lot of it comes packaged\nin PFAS-treated materials,"
    } ]
  }, {
    "tStartMs": 2379040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "like takeout boxes,\nmicrowave popcorn bags,"
    } ]
  }, {
    "tStartMs": 2382160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and burger wrappers."
    } ]
  }, {
    "tStartMs": 2384320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It's on a burger wrapper."
    } ]
  }, {
    "tStartMs": 2386160,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Is it a tiny amount? Is it\na ridiculously tiny amount?"
    } ]
  }, {
    "tStartMs": 2390680,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- We actually did tests at the lab"
    } ]
  }, {
    "tStartMs": 2393120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with stuff that usually contains PFAS."
    } ]
  }, {
    "tStartMs": 2395440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So microwave popcorn, fast food wrappers,"
    } ]
  }, {
    "tStartMs": 2398240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "paper cups that are waterproof."
    } ]
  }, {
    "tStartMs": 2400480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So I have tap water here\nfrom a house in London."
    } ]
  }, {
    "tStartMs": 2402800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Could we boil some water?"
    } ]
  }, {
    "tStartMs": 2404160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Because usually you\ninteract with these products"
    } ]
  }, {
    "tStartMs": 2406480,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "when they're hot and then see\nif any of the PFAS leaches off"
    } ]
  }, {
    "tStartMs": 2410000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and you potentially\neat them or drink them."
    } ]
  }, {
    "tStartMs": 2412040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- This is citizen science, right?"
    } ]
  }, {
    "tStartMs": 2413840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So it's, like, there might be some error,"
    } ]
  }, {
    "tStartMs": 2415680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "but with a solid control"
    } ]
  }, {
    "tStartMs": 2417520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and then with the same tap\nwater going to all of them,"
    } ]
  }, {
    "tStartMs": 2420240,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "we can at least get something, yeah."
    } ]
  }, {
    "tStartMs": 2421640,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- Yeah, and even if we get nothing,"
    } ]
  }, {
    "tStartMs": 2423120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "we'll know that people are probably safe"
    } ]
  }, {
    "tStartMs": 2424720,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "using these products."
    } ]
  }, {
    "tStartMs": 2425760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "All right.\n- Whisk it around."
    } ]
  }, {
    "tStartMs": 2427560,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- Yeah, really get that PFAS"
    } ]
  }, {
    "tStartMs": 2430000,
    "dDurationMs": 1727,
    "segs": [ {
      "utf8": "in that water, right.\n- The juices going."
    } ]
  }, {
    "tStartMs": 2431727,
    "dDurationMs": 13,
    "segs": [ {
      "utf8": "- And get the"
    } ]
  }, {
    "tStartMs": 2431740,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "PFAS juices going.\n- Well, it's supposed"
    } ]
  }, {
    "tStartMs": 2432320,
    "dDurationMs": 2631,
    "segs": [ {
      "utf8": "to be safe for human consumption."
    } ]
  }, {
    "tStartMs": 2434951,
    "dDurationMs": 929,
    "segs": [ {
      "utf8": "- Yeah.\n- That's the wild thing."
    } ]
  }, {
    "tStartMs": 2435880,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- We sloshed it around there,"
    } ]
  }, {
    "tStartMs": 2437360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "hot water, boiling water\nfor around 30 seconds,"
    } ]
  }, {
    "tStartMs": 2439760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and then we tested that water\nto see if any of the PFAS"
    } ]
  }, {
    "tStartMs": 2442160,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "that are used to coat these items"
    } ]
  }, {
    "tStartMs": 2443280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "would actually make it into the water."
    } ]
  }, {
    "tStartMs": 2444880,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "So here's what I got."
    } ]
  }, {
    "tStartMs": 2445840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And these are parts per trillion now."
    } ]
  }, {
    "tStartMs": 2447680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So for PFOA, good news."
    } ]
  }, {
    "tStartMs": 2450160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Basically no detection anywhere"
    } ]
  }, {
    "tStartMs": 2452320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "except for the microwave popcorn."
    } ]
  }, {
    "tStartMs": 2453760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "I will say these are very low\nlevels, but hold your horses"
    } ]
  }, {
    "tStartMs": 2457280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "'cause microwave popcorn gets worse."
    } ]
  }, {
    "tStartMs": 2459280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "- The thing about microwave popcorn,"
    } ]
  }, {
    "tStartMs": 2461360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "it's sitting in there\nwrapped up with the popcorn"
    } ]
  }, {
    "tStartMs": 2464400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "for months or years"
    } ]
  }, {
    "tStartMs": 2466240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "before you ever stick\nit in your microwave."
    } ]
  }, {
    "tStartMs": 2468400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "That gives those chemicals plenty of time"
    } ]
  }, {
    "tStartMs": 2470960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to, like, leach into the oils,"
    } ]
  }, {
    "tStartMs": 2473360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and it's gonna go all over the popcorn,"
    } ]
  }, {
    "tStartMs": 2474720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and you're gonna eat it."
    } ]
  }, {
    "tStartMs": 2476160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "This could explain some\nof our own results."
    } ]
  }, {
    "tStartMs": 2478400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The level for PFPeA,"
    } ]
  }, {
    "tStartMs": 2480320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "which is a shorter variation of PFOA,"
    } ]
  }, {
    "tStartMs": 2482960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "came back at 10 parts per trillion"
    } ]
  }, {
    "tStartMs": 2484880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "after the popcorn bag test."
    } ]
  }, {
    "tStartMs": 2487440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And you can see similar results"
    } ]
  }, {
    "tStartMs": 2488880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "in some of the other PFAS species."
    } ]
  }, {
    "tStartMs": 2491120,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "- But then microwave popcorn\nactually drops for PFOS."
    } ]
  }, {
    "tStartMs": 2496080,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Why could that be? We don't actually know."
    } ]
  }, {
    "tStartMs": 2497960,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- I was gonna say maybe the PFOS, like,"
    } ]
  }, {
    "tStartMs": 2500080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "went on that wrapper and found its friends"
    } ]
  }, {
    "tStartMs": 2502320,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "and just hung out there."
    } ]
  }, {
    "tStartMs": 2503800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- Yeah, could be."
    } ]
  }, {
    "tStartMs": 2504800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I know we've only done,\nlike, one test here."
    } ]
  }, {
    "tStartMs": 2507040,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "No repeat measurements, so we\ncan't conclude much from this,"
    } ]
  }, {
    "tStartMs": 2510320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but there's something to be said"
    } ]
  }, {
    "tStartMs": 2512080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "for when you're using these products,"
    } ]
  }, {
    "tStartMs": 2514320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "they're gonna leach into your\nwater and leach into your food"
    } ]
  }, {
    "tStartMs": 2516400,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "- And research tends to agree."
    } ]
  }, {
    "tStartMs": 2519680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "A 2019 study found that eating fast food"
    } ]
  }, {
    "tStartMs": 2522240,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and microwave popcorn especially\ncan increase your PFAS load"
    } ]
  }, {
    "tStartMs": 2526000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "while eating homecooked meals doesn't."
    } ]
  }, {
    "tStartMs": 2528640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But even something as simple\nas reheating your food"
    } ]
  }, {
    "tStartMs": 2531280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "on a plate instead of in\nthe original packaging"
    } ]
  }, {
    "tStartMs": 2533760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "could prevent PFAS from\nmigrating to your food."
    } ]
  }, {
    "tStartMs": 2537360,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Now, you might expect"
    } ]
  }, {
    "tStartMs": 2538240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that these part per\ntrillion levels we detected"
    } ]
  }, {
    "tStartMs": 2540560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "in the London tap water\nare nothing compared"
    } ]
  }, {
    "tStartMs": 2542720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to the parts per billion\nyou'd find in human blood,"
    } ]
  }, {
    "tStartMs": 2546400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but the surprising thing is that"
    } ]
  }, {
    "tStartMs": 2547920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "to have two parts per billion\nof PFOA in your blood,"
    } ]
  }, {
    "tStartMs": 2551200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you don't need to drink water"
    } ]
  }, {
    "tStartMs": 2552640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "with two parts per billion of PFOA in it"
    } ]
  }, {
    "tStartMs": 2555920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "because PFAS accumulate\nin your body over time."
    } ]
  }, {
    "tStartMs": 2559760,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So even water with as little\nas four parts per trillion"
    } ]
  }, {
    "tStartMs": 2562720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "of PFOA combined with other\nexposure can be enough"
    } ]
  }, {
    "tStartMs": 2566400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "to maintain your blood levels this high."
    } ]
  }, {
    "tStartMs": 2569600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And this is why, in addition to food,"
    } ]
  }, {
    "tStartMs": 2571920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "water is your biggest source of exposure."
    } ]
  }, {
    "tStartMs": 2574720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This is especially true if\nyou live near a PFAS factory"
    } ]
  }, {
    "tStartMs": 2577840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "where the local water is\noften heavily contaminated."
    } ]
  }, {
    "tStartMs": 2581200,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "But the same goes for areas\nnear military bases or airports."
    } ]
  }, {
    "tStartMs": 2585920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "See, adding chemicals like PFOA"
    } ]
  }, {
    "tStartMs": 2587840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or PFOS to water lowers\nits surface tension"
    } ]
  }, {
    "tStartMs": 2591200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "so the water gets more slippery,"
    } ]
  }, {
    "tStartMs": 2593680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and these chemicals also tend to foam up."
    } ]
  }, {
    "tStartMs": 2596400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So they make for an excellent ingredient"
    } ]
  }, {
    "tStartMs": 2598320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "in firefighting foams,\nthey spread quicker,"
    } ]
  }, {
    "tStartMs": 2601040,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and the foam blocks access\nto oxygen extremely well."
    } ]
  }, {
    "tStartMs": 2604800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And since both military bases"
    } ]
  }, {
    "tStartMs": 2606320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and airports frequently do\nfire drills with these foams,"
    } ]
  }, {
    "tStartMs": 2609360,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "they end up seeping"
    } ]
  }, {
    "tStartMs": 2610240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "into the surrounding soil and groundwater."
    } ]
  }, {
    "tStartMs": 2613120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But it doesn't stop there."
    } ]
  }, {
    "tStartMs": 2614800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "- Currently, we have reached\nplanetary saturation levels"
    } ]
  }, {
    "tStartMs": 2618560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "for PFAS, which means that\nwhen you look up at that cloud"
    } ]
  }, {
    "tStartMs": 2622560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and it rains, it rains unsafe levels"
    } ]
  }, {
    "tStartMs": 2625280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "of at least four PFAS species."
    } ]
  }, {
    "tStartMs": 2627280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- It turns out that our entire water cycle"
    } ]
  }, {
    "tStartMs": 2630320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is contaminated with PFAS."
    } ]
  }, {
    "tStartMs": 2632720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So even when it rains\non the Tibetan Plateau,"
    } ]
  }, {
    "tStartMs": 2635920,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that rain contains PFAS."
    } ]
  }, {
    "tStartMs": 2638960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "To check the water levels in your area,"
    } ]
  }, {
    "tStartMs": 2640960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "you can use these maps"
    } ]
  }, {
    "tStartMs": 2642160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that show PFAS\ncontamination across the US,"
    } ]
  }, {
    "tStartMs": 2645040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Europe, and Australia."
    } ]
  }, {
    "tStartMs": 2646960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "What about Los Angeles, Encino?"
    } ]
  }, {
    "tStartMs": 2649920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That's where I spent, like,\n7 of the last 10 years."
    } ]
  }, {
    "tStartMs": 2653040,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- Crescenta Valley."
    } ]
  }, {
    "tStartMs": 2655000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Those are all high."
    } ]
  }, {
    "tStartMs": 2657040,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 2657760,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "- Santa Clarita, some.\nPFHxS level is crazy."
    } ]
  }, {
    "tStartMs": 2662240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So maybe you're getting your\nwater from Santa Clarita."
    } ]
  }, {
    "tStartMs": 2665280,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 2666160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- There's a calculator."
    } ]
  }, {
    "tStartMs": 2667600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It could give you what an\nestimate in your blood serum is."
    } ]
  }, {
    "tStartMs": 2670320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "What we can try to do now is\nput that up in the calculator,"
    } ]
  }, {
    "tStartMs": 2672640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "see if you get something close"
    } ]
  }, {
    "tStartMs": 2674080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to what you have, if you want."
    } ]
  }, {
    "tStartMs": 2675440,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "- Sure."
    } ]
  }, {
    "tStartMs": 2676200,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- PFHxS, so typical value for an adult"
    } ]
  }, {
    "tStartMs": 2679680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is one part per billion,"
    } ]
  }, {
    "tStartMs": 2681680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and then the Santa Clarita water"
    } ]
  }, {
    "tStartMs": 2683120,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "is around 37 parts per trillion."
    } ]
  }, {
    "tStartMs": 2685800,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- If you look after, like, 10 years."
    } ]
  }, {
    "tStartMs": 2688000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- So after roughly 10 years of exposure,"
    } ]
  }, {
    "tStartMs": 2689920,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "you would have to have 6.85\nparts per billion in your blood."
    } ]
  }, {
    "tStartMs": 2694160,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "And then I can tell you\nthat you are at 6.84."
    } ]
  }, {
    "tStartMs": 2697000,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- That would explain things."
    } ]
  }, {
    "tStartMs": 2699440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now, I can't say for sure"
    } ]
  }, {
    "tStartMs": 2700880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "where my drinking water was coming from,"
    } ]
  }, {
    "tStartMs": 2703120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but if I was consistently\ndrinking water contaminated"
    } ]
  }, {
    "tStartMs": 2706000,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "at similar levels, then that\nwould explain my results."
    } ]
  }, {
    "tStartMs": 2710080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But if you are worried\nabout your own water,"
    } ]
  }, {
    "tStartMs": 2712160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you should contact your provider directly"
    } ]
  }, {
    "tStartMs": 2714080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "for the most relevant information."
    } ]
  }, {
    "tStartMs": 2716880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's concerning just"
    } ]
  }, {
    "tStartMs": 2718080,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "how unregulated drinking water has been."
    } ]
  }, {
    "tStartMs": 2721120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It was actually only a\nyear ago in April 2024"
    } ]
  }, {
    "tStartMs": 2723680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that the US EPA finally set legal limits"
    } ]
  }, {
    "tStartMs": 2726400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "for PFAS in drinking water."
    } ]
  }, {
    "tStartMs": 2728640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The safe level for PFOA went down"
    } ]
  }, {
    "tStartMs": 2730960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "from DuPont's initial one part per billion"
    } ]
  }, {
    "tStartMs": 2733440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to four parts per trillion."
    } ]
  }, {
    "tStartMs": 2735280,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- So we're no longer talking\nabout one drop of PFOA"
    } ]
  }, {
    "tStartMs": 2738000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "in 20 of these tanks,"
    } ]
  }, {
    "tStartMs": 2739520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "we're talking about one drop in 5,000."
    } ]
  }, {
    "tStartMs": 2742320,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "That's five Olympic-sized swimming pools."
    } ]
  }, {
    "tStartMs": 2745840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And if there's even a\ndrop of PFOA in there,"
    } ]
  }, {
    "tStartMs": 2748800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the EPA is concerned."
    } ]
  }, {
    "tStartMs": 2750480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- The same four parts per trillion limit"
    } ]
  }, {
    "tStartMs": 2753280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "was also set for PFOS,\nthe sister chemical."
    } ]
  }, {
    "tStartMs": 2756240,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And GenX went down"
    } ]
  }, {
    "tStartMs": 2757360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "from the 70,000 parts per\ntrillion initially proposed"
    } ]
  }, {
    "tStartMs": 2759920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "by Chemours to just 10."
    } ]
  }, {
    "tStartMs": 2762160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The same goes for PFHxS."
    } ]
  }, {
    "tStartMs": 2764960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "For reference, the EPA's\nlimit for lead in water"
    } ]
  }, {
    "tStartMs": 2767600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "is 10,000 parts per trillion,"
    } ]
  }, {
    "tStartMs": 2769840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and for cyanide, 200,000,"
    } ]
  }, {
    "tStartMs": 2772480,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- It gives you a pretty clear indication"
    } ]
  }, {
    "tStartMs": 2775040,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "of how concerned the\nscientific community is."
    } ]
  }, {
    "tStartMs": 2777720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- And just when we got EPA limits,"
    } ]
  }, {
    "tStartMs": 2780240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "we got a new administration in the US,"
    } ]
  }, {
    "tStartMs": 2782560,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which might be reversing\nsome of the PFAS bans."
    } ]
  }, {
    "tStartMs": 2785440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So you can't always\ndepend on the regulators,"
    } ]
  }, {
    "tStartMs": 2787600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and you seemingly can't\ndepend on the companies"
    } ]
  }, {
    "tStartMs": 2790000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "that make this stuff to\ndispose of it safely."
    } ]
  }, {
    "tStartMs": 2793200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So what can you do?"
    } ]
  }, {
    "tStartMs": 2795840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "If your water is contaminated,"
    } ]
  }, {
    "tStartMs": 2797360,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "you might want to consider\ngetting a PFAS-certified filter."
    } ]
  }, {
    "tStartMs": 2801600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Reverse osmosis, granulated active carbon,"
    } ]
  }, {
    "tStartMs": 2804320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and ion exchange filters are all capable"
    } ]
  }, {
    "tStartMs": 2806720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of removing PFAS out of drinking water."
    } ]
  }, {
    "tStartMs": 2809600,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But the responsibility\nto filter drinking water"
    } ]
  }, {
    "tStartMs": 2812080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "shouldn't come down to the individual."
    } ]
  }, {
    "tStartMs": 2814320,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "PFAS should be captured at the\nsource, during manufacturing,"
    } ]
  }, {
    "tStartMs": 2818000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "before they ever reach the environment."
    } ]
  }, {
    "tStartMs": 2820720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And some companies like Puraffinity"
    } ]
  }, {
    "tStartMs": 2822880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "are developing custom\nfilters to make that happen."
    } ]
  }, {
    "tStartMs": 2825760,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "- So very lab-looking lab."
    } ]
  }, {
    "tStartMs": 2828180,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Exactly. Yeah, yeah."
    } ]
  }, {
    "tStartMs": 2829440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So could you walk me through, like,"
    } ]
  }, {
    "tStartMs": 2830640,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "what all these pipes do, and\nwhat do you have in here?"
    } ]
  }, {
    "tStartMs": 2832760,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- So this water is representative"
    } ]
  }, {
    "tStartMs": 2834960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of where you've had a big\nfirefighting foam incident."
    } ]
  }, {
    "tStartMs": 2837600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So you wanna filter this water,"
    } ]
  }, {
    "tStartMs": 2839360,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "but basically, the concept\nis take it from the top"
    } ]
  }, {
    "tStartMs": 2842320,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "through the vessel."
    } ]
  }, {
    "tStartMs": 2843360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "As it passes through this material,"
    } ]
  }, {
    "tStartMs": 2845360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "it basically sticks on"
    } ]
  }, {
    "tStartMs": 2847120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to some of the PFAS chemicals in water,"
    } ]
  }, {
    "tStartMs": 2849360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and then you run into\nanother part of treatment"
    } ]
  }, {
    "tStartMs": 2852080,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "and a third one."
    } ]
  }, {
    "tStartMs": 2853200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- To me, it seems like if PFAS\nare so, like, bioaccumulative"
    } ]
  }, {
    "tStartMs": 2856720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and actually persistent and stable,"
    } ]
  }, {
    "tStartMs": 2858800,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "they don't really react with things."
    } ]
  }, {
    "tStartMs": 2860080,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So how do you force them to\nreact with stuff in here?"
    } ]
  }, {
    "tStartMs": 2863440,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- Basically, taking advantage\nof this long organic tail"
    } ]
  }, {
    "tStartMs": 2866960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "as well as the polar head,"
    } ]
  }, {
    "tStartMs": 2868400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and so you can have some\nelectrostatic interactions"
    } ]
  }, {
    "tStartMs": 2870960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "with the polar head,"
    } ]
  }, {
    "tStartMs": 2871920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and then you can have some hydrophilic"
    } ]
  }, {
    "tStartMs": 2873520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and hydrophobic\ninteractions with the tail."
    } ]
  }, {
    "tStartMs": 2875600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And by combining these\nthree binding mechanisms,"
    } ]
  }, {
    "tStartMs": 2878560,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "you increase massively your\nlikelihood of binding PFAS,"
    } ]
  }, {
    "tStartMs": 2882640,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "even if it's still difficult."
    } ]
  }, {
    "tStartMs": 2883720,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- Right, do the levels\ndrop 100% already here,"
    } ]
  }, {
    "tStartMs": 2886880,
    "dDurationMs": 2148,
    "segs": [ {
      "utf8": "or do you see a gradual decrease in PFAS"
    } ]
  }, {
    "tStartMs": 2889028,
    "dDurationMs": 732,
    "segs": [ {
      "utf8": "as you go?\n- That's the cool question."
    } ]
  }, {
    "tStartMs": 2889760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- Okay.\n- So in the beginning,"
    } ]
  }, {
    "tStartMs": 2891120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "it drops 100% after this one."
    } ]
  }, {
    "tStartMs": 2893040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Oh, so problem solved, or?"
    } ]
  }, {
    "tStartMs": 2894840,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "- Problem solved for the time being."
    } ]
  }, {
    "tStartMs": 2896632,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "- Okay. Okay.\n- What we see right now"
    } ]
  }, {
    "tStartMs": 2898000,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "is it will last about 40,000\nvolumes of this vessel."
    } ]
  }, {
    "tStartMs": 2902320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So a 10-liter vessel would\nbasically provides all"
    } ]
  }, {
    "tStartMs": 2905120,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "of the PFAS treatment for a household."
    } ]
  }, {
    "tStartMs": 2906840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- In a year.\n- For a year."
    } ]
  }, {
    "tStartMs": 2908280,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- You want this to be in factories first,"
    } ]
  }, {
    "tStartMs": 2910160,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "so it never gets into the water."
    } ]
  }, {
    "tStartMs": 2911280,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "- Yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 2911920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- We are talking to the\nfluorochemicals manufacturers,"
    } ]
  }, {
    "tStartMs": 2915040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and they're really trying to,"
    } ]
  }, {
    "tStartMs": 2916720,
    "dDurationMs": 5344,
    "segs": [ {
      "utf8": "yeah, move forward rather than\njust wait for regulations."
    } ]
  }, {
    "tStartMs": 2922064,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 2922078,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "- Everyone's true risk from\nPFAS will be different."
    } ]
  }, {
    "tStartMs": 2925040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It depends on dozens of factors,"
    } ]
  }, {
    "tStartMs": 2926880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "like your water\ncontamination, your lifestyle,"
    } ]
  }, {
    "tStartMs": 2929520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "what you eat."
    } ]
  }, {
    "tStartMs": 2930800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But how much should you\nreally worry about it?"
    } ]
  }, {
    "tStartMs": 2933680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Like, if I'm at 17 or\n18 parts per billion,"
    } ]
  }, {
    "tStartMs": 2936400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is that the equivalent of\ndrinking a beer a night"
    } ]
  }, {
    "tStartMs": 2938800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "or going out in the Australian\nsun without sunscreen?"
    } ]
  }, {
    "tStartMs": 2941800,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- So what I like to do is\ncreate this hierarchy of risk."
    } ]
  }, {
    "tStartMs": 2945040,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And in terms of hierarchy\nof risk reduction,"
    } ]
  }, {
    "tStartMs": 2948800,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "number one on that is\nstopping smoking, exercising,"
    } ]
  }, {
    "tStartMs": 2953520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "consuming a healthy, whole-food diet,"
    } ]
  }, {
    "tStartMs": 2955680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and making sure you're getting\nseven to nine hours of sleep."
    } ]
  }, {
    "tStartMs": 2958480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Then you have medium\nlevels of intervention,"
    } ]
  }, {
    "tStartMs": 2960800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "seeing your primary care doctor,"
    } ]
  }, {
    "tStartMs": 2962640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "controlling your cholesterol numbers."
    } ]
  }, {
    "tStartMs": 2964240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And then on the lower tier that you have,"
    } ]
  }, {
    "tStartMs": 2966320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "PFAS probably falls into that lower tier."
    } ]
  }, {
    "tStartMs": 2968800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Being preventative about PFAS exposure"
    } ]
  }, {
    "tStartMs": 2971680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "is currently our only option"
    } ]
  }, {
    "tStartMs": 2973520,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "because there are no approved\nmedical treatments available."
    } ]
  }, {
    "tStartMs": 2978080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "However, if you compare PFAS contamination"
    } ]
  }, {
    "tStartMs": 2980800,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "between the sexes, male levels\nare consistently higher,"
    } ]
  }, {
    "tStartMs": 2984880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "at least up until around the age of 50"
    } ]
  }, {
    "tStartMs": 2987440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "when menopause usually starts."
    } ]
  }, {
    "tStartMs": 2989760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "This is partly because\nmenstruation, birth,"
    } ]
  }, {
    "tStartMs": 2992000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and lactation are all ways\nPFAS can escape the body."
    } ]
  }, {
    "tStartMs": 2996000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "PFAS can pass through the placenta"
    } ]
  }, {
    "tStartMs": 2997920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and into the fetus during pregnancy,"
    } ]
  }, {
    "tStartMs": 3000320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and then the baby can also get\nexposed through breast milk."
    } ]
  }, {
    "tStartMs": 3003280,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- It's something that pregnant people"
    } ]
  }, {
    "tStartMs": 3005840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "should be extremely careful about."
    } ]
  }, {
    "tStartMs": 3008000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You know, young children\nare incredibly susceptible."
    } ]
  }, {
    "tStartMs": 3010800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "They're drinking more\nwater, they're growing,"
    } ]
  }, {
    "tStartMs": 3012880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they're near surfaces\nlike treated carpets."
    } ]
  }, {
    "tStartMs": 3015640,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- Now, not everyone has\nto change their lifestyle"
    } ]
  }, {
    "tStartMs": 3018480,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "because of PFAS, but if you\nare in a high-risk group"
    } ]
  }, {
    "tStartMs": 3022240,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "because of pregnancy"
    } ]
  }, {
    "tStartMs": 3023280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "or because you live or work\nin a PFAS-contaminated area,"
    } ]
  }, {
    "tStartMs": 3027280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you might want to consider it."
    } ]
  }, {
    "tStartMs": 3030320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "(fire roaring)"
    } ]
  }, {
    "tStartMs": 3031600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Firefighters have\nespecially high PFAS levels"
    } ]
  }, {
    "tStartMs": 3034160,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "because their gear and\nfoams are laced with them."
    } ]
  }, {
    "tStartMs": 3037440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Remarkably, a 2022 study found"
    } ]
  }, {
    "tStartMs": 3039680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that when firefighters donated blood"
    } ]
  }, {
    "tStartMs": 3041760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "or plasma frequently enough,"
    } ]
  }, {
    "tStartMs": 3043680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "they reduced their PFAS levels\nby up to 30% within a year."
    } ]
  }, {
    "tStartMs": 3047600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- And it's kind of ironic that,"
    } ]
  }, {
    "tStartMs": 3049840,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "you know, our health system's\ncoming back to bloodletting."
    } ]
  }, {
    "tStartMs": 3052640,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- What do you think about\nthe idea of donating blood"
    } ]
  }, {
    "tStartMs": 3056160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "as a way to reduce PFAS in the body?"
    } ]
  }, {
    "tStartMs": 3058800,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- I've never heard of that as a strategy."
    } ]
  }, {
    "tStartMs": 3061120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "That's kind of interesting."
    } ]
  }, {
    "tStartMs": 3062480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Well, I definitely recommend"
    } ]
  }, {
    "tStartMs": 3063840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "people donate blood more frequently,"
    } ]
  }, {
    "tStartMs": 3065520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "not because of PFAS exposure,"
    } ]
  }, {
    "tStartMs": 3067040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but because of the fact\nwe desperately need blood."
    } ]
  }, {
    "tStartMs": 3070400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "What's important to note is that,"
    } ]
  }, {
    "tStartMs": 3072160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "especially in this current administration,"
    } ]
  }, {
    "tStartMs": 3074080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "we need to be very careful\nabout shifting budgets away"
    } ]
  }, {
    "tStartMs": 3076640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "from research agencies\nbecause without that research,"
    } ]
  }, {
    "tStartMs": 3079440,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "the guidance that I'm giving"
    } ]
  }, {
    "tStartMs": 3080720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "is gonna be significantly more flawed."
    } ]
  }, {
    "tStartMs": 3083280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The reason I'm able to\ntalk about what we know"
    } ]
  }, {
    "tStartMs": 3085200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and what we don't know\ncomes from that research."
    } ]
  }, {
    "tStartMs": 3087120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So if we're gonna be cutting the budgets"
    } ]
  }, {
    "tStartMs": 3088720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "to these major agencies\nand letting scientists go,"
    } ]
  }, {
    "tStartMs": 3091520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "we're only gonna get worse\nand worse information."
    } ]
  }, {
    "tStartMs": 3093840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- We are still a good few years away"
    } ]
  }, {
    "tStartMs": 3096400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "from proper medical treatment\nand better PFAS regulations"
    } ]
  }, {
    "tStartMs": 3099600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "because this is extremely tricky."
    } ]
  }, {
    "tStartMs": 3101600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "There are places where we\nshould ban PFAS completely,"
    } ]
  }, {
    "tStartMs": 3104320,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "like hygiene products,\ncosmetics, and food packaging,"
    } ]
  }, {
    "tStartMs": 3107600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and some countries are already doing that."
    } ]
  }, {
    "tStartMs": 3110000,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "But we also can't ban PFAS\naltogether, at least not yet,"
    } ]
  }, {
    "tStartMs": 3113520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because we still rely on these chemicals"
    } ]
  }, {
    "tStartMs": 3115440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "for things like medical implants."
    } ]
  }, {
    "tStartMs": 3117520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And it's currently impossible\nto make semiconductors"
    } ]
  }, {
    "tStartMs": 3119920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "for our electronics without them"
    } ]
  }, {
    "tStartMs": 3121960,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- All the tubing"
    } ]
  }, {
    "tStartMs": 3123040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "for the vaccine\nmanufacturing is PFAS-based."
    } ]
  }, {
    "tStartMs": 3125520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "They take us to space as\nwell, our space suits."
    } ]
  }, {
    "tStartMs": 3128800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But even in these niche applications,"
    } ]
  }, {
    "tStartMs": 3130800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "we have to be responsible\naround how we use it."
    } ]
  }, {
    "tStartMs": 3133200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "- People are coming together"
    } ]
  }, {
    "tStartMs": 3134320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "from a lot of different disciplines"
    } ]
  }, {
    "tStartMs": 3136160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to create destruction mechanisms,"
    } ]
  }, {
    "tStartMs": 3138640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to create novel capture materials,"
    } ]
  }, {
    "tStartMs": 3141200,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and to create novel replacements."
    } ]
  }, {
    "tStartMs": 3143440,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "I am excited and inspired\nby all of the great work"
    } ]
  }, {
    "tStartMs": 3147680,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "that's going on around me."
    } ]
  }, {
    "tStartMs": 3148960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So I think if people want to learn more,"
    } ]
  }, {
    "tStartMs": 3151360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I would advise them to\nlearn about the risk,"
    } ]
  }, {
    "tStartMs": 3153520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but then also learn\nabout the new technology"
    } ]
  }, {
    "tStartMs": 3155920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that's being developed"
    } ]
  }, {
    "tStartMs": 3157520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that will hopefully put\nus in the right direction."
    } ]
  }, {
    "tStartMs": 3160000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- So to me,"
    } ]
  }, {
    "tStartMs": 3161600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "you know, one of the most\nimportant things we can do"
    } ]
  }, {
    "tStartMs": 3163680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "is have discussions like\nwhat we're doing right here."
    } ]
  }, {
    "tStartMs": 3166400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "If the story and the\ninformation's out there,"
    } ]
  }, {
    "tStartMs": 3169600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "people can make informed choices"
    } ]
  }, {
    "tStartMs": 3171520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "about whether they want to\ncontinue purchasing things"
    } ]
  }, {
    "tStartMs": 3174320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that have these materials in them."
    } ]
  }, {
    "tStartMs": 3176320,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "And what we're seeing is\nconsumers, as they do become aware,"
    } ]
  }, {
    "tStartMs": 3180880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "are saying, \"No, we don't\nwant these chemicals.\""
    } ]
  }, {
    "tStartMs": 3183840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And companies are\nvoluntarily coming forward"
    } ]
  }, {
    "tStartMs": 3186880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and taking these chemicals out of products"
    } ]
  }, {
    "tStartMs": 3189360,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "because the consumers\nare now demanding it."
    } ]
  }, {
    "tStartMs": 3191560,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "- We've been here before\nwith leaded gasoline,"
    } ]
  }, {
    "tStartMs": 3194640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Freon, and asbestos."
    } ]
  }, {
    "tStartMs": 3196240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And each time, we did the research"
    } ]
  }, {
    "tStartMs": 3198160,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and made the right decision\nto phase these chemicals out."
    } ]
  }, {
    "tStartMs": 3201440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "With PFAS, we're just starting\nto understand the problem."
    } ]
  }, {
    "tStartMs": 3204720,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "But I'm hopeful we'll make\nthe same decision again."
    } ]
  }, {
    "tStartMs": 3210880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "If you want to inform\nyourself more about PFAS,"
    } ]
  }, {
    "tStartMs": 3213360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "we've attached all the sources we've used"
    } ]
  }, {
    "tStartMs": 3215040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to make this video down\nin the description."
    } ]
  }, {
    "tStartMs": 3217520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It's actually our longest episode ever,"
    } ]
  }, {
    "tStartMs": 3219840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and we couldn't have made it"
    } ]
  }, {
    "tStartMs": 3221360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "without the help of our\nsponsor, Ground News."
    } ]
  }, {
    "tStartMs": 3223840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "So if you wanna be more informed"
    } ]
  }, {
    "tStartMs": 3225360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "about the issues around the\nworld that are affecting you"
    } ]
  }, {
    "tStartMs": 3227760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and everyone else out there,"
    } ]
  }, {
    "tStartMs": 3229360,
    "dDurationMs": 3360,
