{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 150,
    "dDurationMs": 2675,
    "segs": [ {
      "utf8": "- Democracy might be\nmathematically impossible."
    } ]
  }, {
    "tStartMs": 2825,
    "dDurationMs": 1225,
    "segs": [ {
      "utf8": "(serious music)"
    } ]
  }, {
    "tStartMs": 4050,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "This isn't a value judgment,\na comment about human nature,"
    } ]
  }, {
    "tStartMs": 8190,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "nor a statement about how rare"
    } ]
  }, {
    "tStartMs": 9720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and unstable democratic\nsocieties have been"
    } ]
  }, {
    "tStartMs": 11880,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "in the history of civilization."
    } ]
  }, {
    "tStartMs": 14430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Our current attempt at democracy,"
    } ]
  }, {
    "tStartMs": 16470,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the methods we're using\nto elect our leaders,"
    } ]
  }, {
    "tStartMs": 19380,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "are fundamentally irrational."
    } ]
  }, {
    "tStartMs": 21600,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "And this is a well-established\nmathematical fact."
    } ]
  }, {
    "tStartMs": 27030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "This is a video about the math"
    } ]
  }, {
    "tStartMs": 28740,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that proved that fact\nand led to a Nobel Prize."
    } ]
  }, {
    "tStartMs": 32190,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It's a video about how groups\nof people make decisions"
    } ]
  }, {
    "tStartMs": 35040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and the pitfalls that our\nvoting systems fall into."
    } ]
  }, {
    "tStartMs": 39814,
    "dDurationMs": 1436,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 41250,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "One of the simplest\nways to hold an election"
    } ]
  }, {
    "tStartMs": 43440,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "is to ask the voters to mark one candidate"
    } ]
  }, {
    "tStartMs": 45870,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "as their favorite on a ballot."
    } ]
  }, {
    "tStartMs": 47880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And when the votes are counted,"
    } ]
  }, {
    "tStartMs": 49200,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "the candidate with the most\nvotes wins the election."
    } ]
  }, {
    "tStartMs": 52590,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "This is known as \"first\npast the post\" voting."
    } ]
  }, {
    "tStartMs": 56160,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The name is kind of a misnomer though."
    } ]
  }, {
    "tStartMs": 58020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "There is no post"
    } ]
  }, {
    "tStartMs": 59280,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that any of the candidates\nneed to get past."
    } ]
  }, {
    "tStartMs": 61770,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "The winner is just the\ncandidate with the most votes."
    } ]
  }, {
    "tStartMs": 66090,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This method likely goes back to antiquity."
    } ]
  }, {
    "tStartMs": 68730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It has been used to elect members"
    } ]
  }, {
    "tStartMs": 70380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of the House of Commons in\nEngland since the 14th century,"
    } ]
  }, {
    "tStartMs": 73440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and it's still a common voting system"
    } ]
  }, {
    "tStartMs": 75690,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "with 44 countries in the world using it"
    } ]
  }, {
    "tStartMs": 78210,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to elect its leaders."
    } ]
  }, {
    "tStartMs": 79620,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "30 of these countries were\nformer British colonies."
    } ]
  }, {
    "tStartMs": 83790,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The US, being a former British colony,"
    } ]
  }, {
    "tStartMs": 85920,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "still uses first past the\npost in most of its states"
    } ]
  }, {
    "tStartMs": 88770,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "to elect their representatives\nto the electoral college."
    } ]
  }, {
    "tStartMs": 92400,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "But first past the post has problems."
    } ]
  }, {
    "tStartMs": 96060,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "If you are selecting\nrepresentatives in a parliament,"
    } ]
  }, {
    "tStartMs": 98850,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you can, and frequently do,"
    } ]
  }, {
    "tStartMs": 100530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "get situations where the\nmajority of the country"
    } ]
  }, {
    "tStartMs": 102840,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "did not vote for the party\nthat ends up holding the power."
    } ]
  }, {
    "tStartMs": 108210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "In the last a hundred years,"
    } ]
  }, {
    "tStartMs": 109770,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "there were 21 times a single party held"
    } ]
  }, {
    "tStartMs": 112320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "a majority of the seats\nin the British Parliament,"
    } ]
  }, {
    "tStartMs": 114750,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "but only two of those times\ndid the majority of the voters"
    } ]
  }, {
    "tStartMs": 118440,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "actually vote for that party."
    } ]
  }, {
    "tStartMs": 121500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So a party, which only a\nminority of the people voted for,"
    } ]
  }, {
    "tStartMs": 124710,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "ends up holding all of\nthe power in government."
    } ]
  }, {
    "tStartMs": 128520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Another thing that happens\nbecause of first past the post"
    } ]
  }, {
    "tStartMs": 130920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "is that similar parties\nend up stealing votes"
    } ]
  }, {
    "tStartMs": 133470,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "from each other."
    } ]
  }, {
    "tStartMs": 135420,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- The 2000 US presidential election,"
    } ]
  }, {
    "tStartMs": 138090,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "which was an election essentially"
    } ]
  }, {
    "tStartMs": 140040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "between Al Gore and George W. Bush."
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "At that point, every state in the nation"
    } ]
  }, {
    "tStartMs": 145320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "used first past the post"
    } ]
  }, {
    "tStartMs": 147120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to determine the outcome of the election."
    } ]
  }, {
    "tStartMs": 148980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Bush had more votes in Florida,"
    } ]
  }, {
    "tStartMs": 151560,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but by a ridiculously slim margin."
    } ]
  }, {
    "tStartMs": 154410,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "It was fewer than 600 votes."
    } ]
  }, {
    "tStartMs": 156780,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "But there was another candidate\non the ballot, Ralph Nader."
    } ]
  }, {
    "tStartMs": 161160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Nader was a Green candidate."
    } ]
  }, {
    "tStartMs": 163440,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "He was certainly to the\nleft of either Gore or Bush."
    } ]
  }, {
    "tStartMs": 168120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- And what we need is the upsurge"
    } ]
  }, {
    "tStartMs": 170280,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of citizen concern, people concern,"
    } ]
  }, {
    "tStartMs": 172860,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "poor, rich, or middle class,"
    } ]
  }, {
    "tStartMs": 174510,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to counteract the power\nof the special interests."
    } ]
  }, {
    "tStartMs": 177510,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "- And he got almost a hundred\nthousand votes in Florida."
    } ]
  }, {
    "tStartMs": 180960,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- I just don't know if I\ncan, with a conscience,"
    } ]
  }, {
    "tStartMs": 183240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "vote for Bush or Gore."
    } ]
  }, {
    "tStartMs": 185280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- I will vote for Ralph Nader."
    } ]
  }, {
    "tStartMs": 187080,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "- Most of those voters were devastated"
    } ]
  }, {
    "tStartMs": 191610,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that by voting for Nader rather than Gore,"
    } ]
  }, {
    "tStartMs": 194220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "they ended up electing Bush."
    } ]
  }, {
    "tStartMs": 196440,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "This is what is called a spoiler effect."
    } ]
  }, {
    "tStartMs": 199140,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Almost all Nader voters\npreferred Gore to Bush,"
    } ]
  }, {
    "tStartMs": 203310,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but in a first past the post system,"
    } ]
  }, {
    "tStartMs": 205380,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "they had no way of\nexpressing that preference"
    } ]
  }, {
    "tStartMs": 210450,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "because you could only\nvote for one candidate."
    } ]
  }, {
    "tStartMs": 213066,
    "dDurationMs": 1494,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 214560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- So first past the\npost incentivizes voters"
    } ]
  }, {
    "tStartMs": 217260,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to vote strategically."
    } ]
  }, {
    "tStartMs": 219330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Say there are five parties,"
    } ]
  }, {
    "tStartMs": 221370,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "one of them will be the smallest\none, and so they won't win."
    } ]
  }, {
    "tStartMs": 225630,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Why would you vote for them?"
    } ]
  }, {
    "tStartMs": 227400,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "This is also true if you have\nfour parties or three parties."
    } ]
  }, {
    "tStartMs": 231900,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "This winner-takes-all voting system leads"
    } ]
  }, {
    "tStartMs": 234420,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to a concentration of\npower in larger parties,"
    } ]
  }, {
    "tStartMs": 237750,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "eventually, leading to a two-party system."
    } ]
  }, {
    "tStartMs": 241620,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This effect is common enough"
    } ]
  }, {
    "tStartMs": 243120,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "that it has a name: Duverger's Law."
    } ]
  }, {
    "tStartMs": 248880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So first past the post\nisn't a great option."
    } ]
  }, {
    "tStartMs": 251640,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "So what else could we do?"
    } ]
  }, {
    "tStartMs": 253707,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "(subdued music)"
    } ]
  }, {
    "tStartMs": 255030,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Well, we can say that a candidate\ncan only win an election"
    } ]
  }, {
    "tStartMs": 257970,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "if they get a majority, at\nleast 50% plus one of the vote."
    } ]
  }, {
    "tStartMs": 262770,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "But what if we hold an election\nand no one gets a majority?"
    } ]
  }, {
    "tStartMs": 266520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "We could go to the people\nwho voted for the candidate"
    } ]
  }, {
    "tStartMs": 268260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "with the fewest votes and\nask them to vote again,"
    } ]
  }, {
    "tStartMs": 271080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "but choose a different candidate"
    } ]
  }, {
    "tStartMs": 273090,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and we could repeat this\nprocess over and over"
    } ]
  }, {
    "tStartMs": 276330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "eliminating the smallest candidate"
    } ]
  }, {
    "tStartMs": 278340,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "until one candidate reaches a majority."
    } ]
  }, {
    "tStartMs": 281790,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But holding many elections is a big hassle"
    } ]
  }, {
    "tStartMs": 284430,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "so instead we could just ask voters"
    } ]
  }, {
    "tStartMs": 286980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to rank their preferences"
    } ]
  }, {
    "tStartMs": 288630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "from their favorite to\ntheir least favorite."
    } ]
  }, {
    "tStartMs": 290910,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And if their favorite\ncandidate gets eliminated,"
    } ]
  }, {
    "tStartMs": 292920,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "we go to their second preferences."
    } ]
  }, {
    "tStartMs": 295290,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "When the polls close, you count\nthe voters' first choices."
    } ]
  }, {
    "tStartMs": 298890,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If any candidate has a\nmajority of the votes,"
    } ]
  }, {
    "tStartMs": 301170,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "then they're the winner."
    } ]
  }, {
    "tStartMs": 302430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But if no candidate has a majority,"
    } ]
  }, {
    "tStartMs": 304470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the candidate with the\nfewest votes gets eliminated"
    } ]
  }, {
    "tStartMs": 306870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and their ballots are distributed"
    } ]
  }, {
    "tStartMs": 308250,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to those voters' second preferences,"
    } ]
  }, {
    "tStartMs": 310350,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and this keeps happening"
    } ]
  }, {
    "tStartMs": 311820,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "until one candidate has\na majority of the votes."
    } ]
  }, {
    "tStartMs": 315720,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "This is mathematically identical"
    } ]
  }, {
    "tStartMs": 317460,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to holding repeated elections,"
    } ]
  }, {
    "tStartMs": 319290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "it just saves the time and hassle"
    } ]
  }, {
    "tStartMs": 321030,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "so it's referred to as instant runoff,"
    } ]
  }, {
    "tStartMs": 324390,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but the system is also known"
    } ]
  }, {
    "tStartMs": 325830,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "as preferential voting\nor ranked-choice voting."
    } ]
  }, {
    "tStartMs": 329670,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "An instant runoff doesn't\njust affect the voters,"
    } ]
  }, {
    "tStartMs": 332580,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "it affects how the candidates\nbehave towards each other."
    } ]
  }, {
    "tStartMs": 336390,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- It was the Minneapolis\nmayor's race, 2013,"
    } ]
  }, {
    "tStartMs": 339390,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "they were using ranked-choice voting."
    } ]
  }, {
    "tStartMs": 341400,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The incumbent mayor had stepped down"
    } ]
  }, {
    "tStartMs": 344370,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and there were all of these people"
    } ]
  }, {
    "tStartMs": 346830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "came out from the woodwork\nwanting to be mayor."
    } ]
  }, {
    "tStartMs": 348090,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "There're 35 candidates."
    } ]
  }, {
    "tStartMs": 350670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And so you would think\nif there's 35 candidates"
    } ]
  }, {
    "tStartMs": 353220,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you'd want to dunk on someone,"
    } ]
  }, {
    "tStartMs": 354960,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you'd wanna like kind of elbow\nyourself into the spotlight."
    } ]
  }, {
    "tStartMs": 358320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's not what happened."
    } ]
  }, {
    "tStartMs": 359760,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "These 35 candidates,"
    } ]
  }, {
    "tStartMs": 360840,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "all of them were really\nnice to each other."
    } ]
  }, {
    "tStartMs": 363810,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "They were all super cordial, super polite,"
    } ]
  }, {
    "tStartMs": 367230,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to the degree that at the end\nof the final mayoral debate,"
    } ]
  }, {
    "tStartMs": 373650,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "they all came together and\nthey sang \"Kumbaya\" together."
    } ]
  }, {
    "tStartMs": 379791,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "♪ Kumbaya, my Lord, kumbaya ♪"
    } ]
  }, {
    "tStartMs": 384797,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "♪ Oh, Lord, kumbaya ♪"
    } ]
  }, {
    "tStartMs": 390030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- The amount of vitriol and anger"
    } ]
  }, {
    "tStartMs": 392400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and partisan, you know,\nmudslinging that we're all used to,"
    } ]
  }, {
    "tStartMs": 396000,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "to see this vision of an actual \"Kumbaya.\""
    } ]
  }, {
    "tStartMs": 400020,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It's not even a joke."
    } ]
  }, {
    "tStartMs": 401400,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "All of these people getting along"
    } ]
  }, {
    "tStartMs": 403020,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so desperate for second and third choices"
    } ]
  }, {
    "tStartMs": 405240,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "from other people that they're like,"
    } ]
  }, {
    "tStartMs": 406477,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "\"I'm gonna be the picture-perfect,"
    } ]
  }, {
    "tStartMs": 408540,
    "dDurationMs": 2457,
    "segs": [ {
      "utf8": "kindest candidate possible.\""
    } ]
  }, {
    "tStartMs": 412170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- But there's also a\nproblem with instant runoff."
    } ]
  }, {
    "tStartMs": 415170,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "There can be cases where\na candidate doing worse"
    } ]
  }, {
    "tStartMs": 418530,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "can actually help get them elected."
    } ]
  }, {
    "tStartMs": 422100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Let's say we have three candidates:"
    } ]
  }, {
    "tStartMs": 424200,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Einstein, Curie, and Bohr."
    } ]
  }, {
    "tStartMs": 426660,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Now, Einstein and Bohr\nhave very conflicting views"
    } ]
  }, {
    "tStartMs": 430290,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "while Curie is\nideologically in the center."
    } ]
  }, {
    "tStartMs": 433770,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So let's say Einstein\ngets 25% of the vote,"
    } ]
  }, {
    "tStartMs": 436740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Curie gets 30, and Bohr gets 45."
    } ]
  }, {
    "tStartMs": 439620,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "No one got a majority."
    } ]
  }, {
    "tStartMs": 441090,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So it goes to the second round"
    } ]
  }, {
    "tStartMs": 442830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "with Einstein being eliminated"
    } ]
  }, {
    "tStartMs": 444780,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and because people who voted for Einstein"
    } ]
  }, {
    "tStartMs": 447060,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "put down Curie as their second choice,"
    } ]
  }, {
    "tStartMs": 449340,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "well, Curie ultimately gets elected."
    } ]
  }, {
    "tStartMs": 452760,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "But now imagine that Bohr has\na terrible campaign speech"
    } ]
  }, {
    "tStartMs": 456510,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "or proposes a very unpopular policy"
    } ]
  }, {
    "tStartMs": 459360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so bad that some of his voters"
    } ]
  }, {
    "tStartMs": 461550,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "actually switch over to Einstein's side."
    } ]
  }, {
    "tStartMs": 464370,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Well now it's Curie that gets eliminated"
    } ]
  }, {
    "tStartMs": 467940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and because she's more moderate,"
    } ]
  }, {
    "tStartMs": 469860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "half of her voters select Einstein"
    } ]
  }, {
    "tStartMs": 471990,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and the other half select\nBohr in the second round,"
    } ]
  }, {
    "tStartMs": 474570,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and this leads to Bohr winning."
    } ]
  }, {
    "tStartMs": 477810,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So Bohr doing worse in the first round"
    } ]
  }, {
    "tStartMs": 480960,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "actually leads to him\nwinning the election."
    } ]
  }, {
    "tStartMs": 484380,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Clearly, this isn't something"
    } ]
  }, {
    "tStartMs": 485850,
    "dDurationMs": 2409,
    "segs": [ {
      "utf8": "that we want in a voting system."
    } ]
  }, {
    "tStartMs": 488259,
    "dDurationMs": 1071,
    "segs": [ {
      "utf8": "(serious music)\nThis is what"
    } ]
  }, {
    "tStartMs": 489330,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the French mathematician\nCondorcet also thought."
    } ]
  }, {
    "tStartMs": 492690,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Condorcet was one of the\nfirst people applying logic"
    } ]
  }, {
    "tStartMs": 495330,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and mathematics to rigorously\nstudy voting systems"
    } ]
  }, {
    "tStartMs": 498600,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "making him one of the founders"
    } ]
  }, {
    "tStartMs": 500070,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "of a branch of mathematics\nknown as social choice theory."
    } ]
  }, {
    "tStartMs": 504600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "He was working during the\ntime of the French Revolution,"
    } ]
  }, {
    "tStartMs": 506940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so fairly determining\nthe will of the people"
    } ]
  }, {
    "tStartMs": 509220,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "was having a cultural moment right then."
    } ]
  }, {
    "tStartMs": 514740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "In 1784, Condorcet's contemporary"
    } ]
  }, {
    "tStartMs": 517500,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "at the French Royal Society of Science,"
    } ]
  }, {
    "tStartMs": 519660,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "Jean-Charles de Borda,\nproposed a voting method."
    } ]
  }, {
    "tStartMs": 524730,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "You ask the voters to rank the candidates."
    } ]
  }, {
    "tStartMs": 527100,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "If there are five candidates,"
    } ]
  }, {
    "tStartMs": 528540,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "ranking someone first gives\nthat candidate four points,"
    } ]
  }, {
    "tStartMs": 531720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "ranking them second would\ngive them three, and so on,"
    } ]
  }, {
    "tStartMs": 534720,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "with zero points being\nawarded for last place."
    } ]
  }, {
    "tStartMs": 539070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But the Borda count has a problem"
    } ]
  }, {
    "tStartMs": 541260,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "because the number of points\ngiven to each candidate"
    } ]
  }, {
    "tStartMs": 543810,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is dependent on the total\nnumber of candidates."
    } ]
  }, {
    "tStartMs": 546960,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Adding extra people that\nhave no chance of winning"
    } ]
  }, {
    "tStartMs": 549780,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "can affect the winner."
    } ]
  }, {
    "tStartMs": 551850,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Because of this, Condorcet\nhated Borda's idea."
    } ]
  }, {
    "tStartMs": 554820,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "He wrote that it was\n\"bound to lead to error"
    } ]
  }, {
    "tStartMs": 557130,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "because it relies on irrelevant\nfactors for its judgments.\""
    } ]
  }, {
    "tStartMs": 561420,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So in 1785, Condorcet published an essay"
    } ]
  }, {
    "tStartMs": 564450,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in which he proposed a new voting system,"
    } ]
  }, {
    "tStartMs": 567090,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "one he thought was the most fair."
    } ]
  }, {
    "tStartMs": 569800,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 570633,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "Basically the winner needs"
    } ]
  }, {
    "tStartMs": 571620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "to beat every other candidate\nin a head-to-head election."
    } ]
  }, {
    "tStartMs": 575520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But with more than two candidates,"
    } ]
  }, {
    "tStartMs": 577260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "do you need to hold a large number"
    } ]
  }, {
    "tStartMs": 578880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "of head-to-head elections\nto pick the winner?"
    } ]
  }, {
    "tStartMs": 581400,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Well, no."
    } ]
  }, {
    "tStartMs": 582330,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Just ask the voters to\nrank their preferences"
    } ]
  }, {
    "tStartMs": 584640,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "just like in instant runoff"
    } ]
  }, {
    "tStartMs": 586110,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and then count how many voters\nrank each candidate higher"
    } ]
  }, {
    "tStartMs": 589470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "than each other candidate."
    } ]
  }, {
    "tStartMs": 591150,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "This feels like the\nmost fair voting method."
    } ]
  }, {
    "tStartMs": 596790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "This voting system was actually discovered"
    } ]
  }, {
    "tStartMs": 598650,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "450 years earlier by Ramon Llull,"
    } ]
  }, {
    "tStartMs": 601380,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "a monk who was looking at how\nchurch leaders were chosen,"
    } ]
  }, {
    "tStartMs": 604560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but Llull's ideas didn't make an impact"
    } ]
  }, {
    "tStartMs": 606630,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "because his book, \"Ars\neleccionis,\" the art of elections,"
    } ]
  }, {
    "tStartMs": 610650,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "was lost and only rediscovered in 2001."
    } ]
  }, {
    "tStartMs": 613980,
    "dDurationMs": 4861,
    "segs": [ {
      "utf8": "So the voting system is named\nafter Condorcet and not Llull."
    } ]
  }, {
    "tStartMs": 618841,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 619674,
    "dDurationMs": 3186,
    "segs": [ {
      "utf8": "But will there always\nbe a winner in this way?"
    } ]
  }, {
    "tStartMs": 622860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Let's try Condorcet's\nmethod for choosing dinner"
    } ]
  }, {
    "tStartMs": 625080,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "between you and two friends."
    } ]
  }, {
    "tStartMs": 627150,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "There are three options:\nburgers, pizza or sushi."
    } ]
  }, {
    "tStartMs": 630990,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You really like burgers, so\nthat's your first preference,"
    } ]
  }, {
    "tStartMs": 633870,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "your second choice is pizza,\nand you put sushi last."
    } ]
  }, {
    "tStartMs": 637290,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Your friend prefers pizza,\nthen sushi, then burgers,"
    } ]
  }, {
    "tStartMs": 640890,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and your other friend prefers sushi,"
    } ]
  }, {
    "tStartMs": 642660,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "then burgers, then pizza."
    } ]
  }, {
    "tStartMs": 644700,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now if you choose\nburgers, it can be argued"
    } ]
  }, {
    "tStartMs": 647340,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that sushi should have won instead"
    } ]
  }, {
    "tStartMs": 649410,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "since two of you prefer sushi over burgers"
    } ]
  }, {
    "tStartMs": 652230,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and only one prefers burgers to sushi."
    } ]
  }, {
    "tStartMs": 655200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "However, by the same argument,\npizza is preferred to sushi"
    } ]
  }, {
    "tStartMs": 658800,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and burgers are preferred to pizza"
    } ]
  }, {
    "tStartMs": 661080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "by a margin of two-to-one\non each occasion."
    } ]
  }, {
    "tStartMs": 663960,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So it seems like you and your\nfriends are stuck in a loop."
    } ]
  }, {
    "tStartMs": 667530,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Burgers are preferred to pizza,\nwhich is preferred to sushi,"
    } ]
  }, {
    "tStartMs": 670050,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "which is preferred to burgers and so on."
    } ]
  }, {
    "tStartMs": 674910,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "This situation is known\nas Condorcet's paradox."
    } ]
  }, {
    "tStartMs": 680400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Condorcet died before he could resolve"
    } ]
  }, {
    "tStartMs": 682470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "this problem with his voting system."
    } ]
  }, {
    "tStartMs": 684360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "He was politically active\nduring the French Revolution"
    } ]
  }, {
    "tStartMs": 686730,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "writing a draft of France's constitution."
    } ]
  }, {
    "tStartMs": 690630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "In 1793 during the Reign of Terror"
    } ]
  }, {
    "tStartMs": 692910,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "when La Montagne came to power,"
    } ]
  }, {
    "tStartMs": 695400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "he was deemed a traitor\nfor criticizing the regime,"
    } ]
  }, {
    "tStartMs": 697920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "specifically their new constitution."
    } ]
  }, {
    "tStartMs": 700440,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "In the next year, he was\narrested and died in jail."
    } ]
  }, {
    "tStartMs": 705209,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 706290,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Over the next 150 years,\ndozens of mathematicians"
    } ]
  }, {
    "tStartMs": 709770,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "were proposing their own voting systems"
    } ]
  }, {
    "tStartMs": 711960,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "or modifications to\nCondorcet's or Borda's ideas."
    } ]
  }, {
    "tStartMs": 716490,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "One of those mathematicians\nwas Charles Dodgson,"
    } ]
  }, {
    "tStartMs": 719070,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "better known as Lewis Carroll."
    } ]
  }, {
    "tStartMs": 721320,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "When he wasn't writing\n\"Alice in Wonderland,\""
    } ]
  }, {
    "tStartMs": 723450,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "he was trying to find a\nsystem to hold fair elections."
    } ]
  }, {
    "tStartMs": 728370,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "But every voting system had\nsimilar kinds of problems,"
    } ]
  }, {
    "tStartMs": 731100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You'd either get Condorcet loops"
    } ]
  }, {
    "tStartMs": 733080,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "or other candidates that\nhad no chance of winning"
    } ]
  }, {
    "tStartMs": 736050,
    "dDurationMs": 2698,
    "segs": [ {
      "utf8": "would affect the outcome of the election."
    } ]
  }, {
    "tStartMs": 738748,
    "dDurationMs": 1772,
    "segs": [ {
      "utf8": "(lively jazz music)"
    } ]
  }, {
    "tStartMs": 740520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "In 1951, Kenneth Arrow\npublished his PhD thesis"
    } ]
  }, {
    "tStartMs": 744600,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and in it he outlined five very obvious"
    } ]
  }, {
    "tStartMs": 747420,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and reasonable conditions"
    } ]
  }, {
    "tStartMs": 748710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that a rational voting system should have."
    } ]
  }, {
    "tStartMs": 751320,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Condition number one:"
    } ]
  }, {
    "tStartMs": 752460,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "if everyone in the group\nchooses one option over another,"
    } ]
  }, {
    "tStartMs": 755700,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the outcome should reflect that."
    } ]
  }, {
    "tStartMs": 757650,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "If every individual in the group"
    } ]
  }, {
    "tStartMs": 759120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "prefers to eat sushi over pizza,"
    } ]
  }, {
    "tStartMs": 761280,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "then the group as a whole\nshould prefer sushi over pizza."
    } ]
  }, {
    "tStartMs": 764790,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "This is known as unanimity."
    } ]
  }, {
    "tStartMs": 767730,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Condition two: no single person's vote"
    } ]
  }, {
    "tStartMs": 770130,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "should override the\npreferences of everyone else."
    } ]
  }, {
    "tStartMs": 772770,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If everyone votes for pizza"
    } ]
  }, {
    "tStartMs": 774360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "except one person who votes for sushi,"
    } ]
  }, {
    "tStartMs": 776610,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the group should obviously choose pizza."
    } ]
  }, {
    "tStartMs": 779190,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "If a single vote is decisive,\nthat's not a democracy,"
    } ]
  }, {
    "tStartMs": 782700,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "that's a dictatorship."
    } ]
  }, {
    "tStartMs": 784800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Condition three: everyone should be able"
    } ]
  }, {
    "tStartMs": 787050,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to vote however they want"
    } ]
  }, {
    "tStartMs": 788610,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and the voting system must\nproduce a conclusion for society"
    } ]
  }, {
    "tStartMs": 791880,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "based on all the ballots, every time."
    } ]
  }, {
    "tStartMs": 794580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It can't avoid problematic ballots"
    } ]
  }, {
    "tStartMs": 796410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "or candidates by simply ignoring them"
    } ]
  }, {
    "tStartMs": 798870,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "or just guessing randomly,\nit must reach the same answer"
    } ]
  }, {
    "tStartMs": 802590,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "for the same set of ballots every time."
    } ]
  }, {
    "tStartMs": 805350,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This is called unrestricted domain."
    } ]
  }, {
    "tStartMs": 808590,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Condition four: the voting\nsystem should be transitive."
    } ]
  }, {
    "tStartMs": 811830,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "If a group prefers burgers over pizza"
    } ]
  }, {
    "tStartMs": 813810,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and pizza over sushi,"
    } ]
  }, {
    "tStartMs": 815340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "then they should also\nprefer burgers over sushi."
    } ]
  }, {
    "tStartMs": 818220,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This is known as transitivity."
    } ]
  }, {
    "tStartMs": 820830,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Condition five: if the\npreference of the group"
    } ]
  }, {
    "tStartMs": 823230,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "is sushi over pizza,"
    } ]
  }, {
    "tStartMs": 824700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the introduction of another\noption, like burgers,"
    } ]
  }, {
    "tStartMs": 827250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "should not change that preference."
    } ]
  }, {
    "tStartMs": 829560,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Sure, the group might collectively\nrank burgers above both"
    } ]
  }, {
    "tStartMs": 832710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "or in the middle or at the bottom,"
    } ]
  }, {
    "tStartMs": 834660,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but the ranking of sushi over pizza"
    } ]
  }, {
    "tStartMs": 836610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "should not be affected by the new option."
    } ]
  }, {
    "tStartMs": 839490,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "This is called the independence\nof irrelevant alternatives."
    } ]
  }, {
    "tStartMs": 844320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But here's the thing, Arrow\nproved that satisfying all five"
    } ]
  }, {
    "tStartMs": 847800,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "of these conditions in\na ranked voting system"
    } ]
  }, {
    "tStartMs": 849780,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "with three or more\ncandidates is impossible."
    } ]
  }, {
    "tStartMs": 852870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This is Arrow's Impossibility Theorem,"
    } ]
  }, {
    "tStartMs": 855180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and it was so groundbreaking"
    } ]
  }, {
    "tStartMs": 856710,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "that Arrow was awarded the Nobel\nPrize in Economics in 1972."
    } ]
  }, {
    "tStartMs": 860910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So I wanna go through\na version of his proof"
    } ]
  }, {
    "tStartMs": 863040,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "based on a formulation by Geanakoplos."
    } ]
  }, {
    "tStartMs": 866430,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So let's say there are"
    } ]
  }, {
    "tStartMs": 867630,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "three candidates running for election:"
    } ]
  }, {
    "tStartMs": 870210,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Aristotle, Bohr, and Curie,"
    } ]
  }, {
    "tStartMs": 873300,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "but we'll refer to them as A, B, and C,"
    } ]
  }, {
    "tStartMs": 876630,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and we have a collection of voters"
    } ]
  }, {
    "tStartMs": 878310,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that we'll line up in order."
    } ]
  }, {
    "tStartMs": 879720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "So we have voter 1, 2, 3, and\nso on all the way up to N."
    } ]
  }, {
    "tStartMs": 884640,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Each of these voters"
    } ]
  }, {
    "tStartMs": 885510,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is free to rank A, B\nand C however they like."
    } ]
  }, {
    "tStartMs": 888630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I'll even allow ties."
    } ]
  }, {
    "tStartMs": 890640,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And the first we wanna show\nis that if everyone ranks"
    } ]
  }, {
    "tStartMs": 893190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "a particular candidate first or last,"
    } ]
  }, {
    "tStartMs": 895680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "then society as a whole"
    } ]
  }, {
    "tStartMs": 897360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "must also rank that\ncandidate first or last."
    } ]
  }, {
    "tStartMs": 900960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Let's arbitrarily pick candidate B."
    } ]
  }, {
    "tStartMs": 903540,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "If say half of the voters rank B first"
    } ]
  }, {
    "tStartMs": 906000,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and half rank B last, then the claim is"
    } ]
  }, {
    "tStartMs": 908910,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "our voting system must\nput B either first or last"
    } ]
  }, {
    "tStartMs": 913530,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and we'll prove it by contradiction."
    } ]
  }, {
    "tStartMs": 916260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So say this is how everyone voted."
    } ]
  }, {
    "tStartMs": 919320,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "If our system does not\nput B first or last,"
    } ]
  }, {
    "tStartMs": 922500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "but rather in the middle,\nsay A is ranked above B,"
    } ]
  }, {
    "tStartMs": 925710,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "which is above C, then\nwe'll get a contradiction."
    } ]
  }, {
    "tStartMs": 929490,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "Because if each of our\nvoters moved C above A,"
    } ]
  }, {
    "tStartMs": 933720,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "then by unanimity, C\nmust be ranked above A."
    } ]
  }, {
    "tStartMs": 938190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "However, because we\ndidn't change the position"
    } ]
  }, {
    "tStartMs": 940530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of any A relative to B,"
    } ]
  }, {
    "tStartMs": 943110,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "A must still be ranked above B"
    } ]
  }, {
    "tStartMs": 946140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and because we didn't change the position"
    } ]
  }, {
    "tStartMs": 948030,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "of any C relative to B, C\nmust still be ranked below B,"
    } ]
  }, {
    "tStartMs": 952830,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and by transitivity,"
    } ]
  }, {
    "tStartMs": 954150,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "if A is preferred to B\nand B is preferred to C,"
    } ]
  }, {
    "tStartMs": 957720,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "then A must be ranked above C."
    } ]
  }, {
    "tStartMs": 960690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But this contradicts\nthe result by unanimity"
    } ]
  }, {
    "tStartMs": 963480,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and that proves that if everyone ranks"
    } ]
  }, {
    "tStartMs": 965670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a candidate first or last,"
    } ]
  }, {
    "tStartMs": 967590,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "then society must also\nrank them first or last."
    } ]
  }, {
    "tStartMs": 973200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now let's do a thought experiment"
    } ]
  }, {
    "tStartMs": 974640,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "where every voter puts B at\nthe bottom of their ranking,"
    } ]
  }, {
    "tStartMs": 978270,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "we'll leave the ranking\nof A and C arbitrary."
    } ]
  }, {
    "tStartMs": 981690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Well then, by unanimity,"
    } ]
  }, {
    "tStartMs": 983190,
    "dDurationMs": 3897,
    "segs": [ {
      "utf8": "we know that B must be at the\nbottom of society's ranking"
    } ]
  }, {
    "tStartMs": 987087,
    "dDurationMs": 2556,
    "segs": [ {
      "utf8": "and we'll call this setup Profile 0."
    } ]
  }, {
    "tStartMs": 990540,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Now we'll create Profile 1\nwhich is identical to Profile 0"
    } ]
  }, {
    "tStartMs": 994260,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "except the first voter moves\nB from the bottom to the top."
    } ]
  }, {
    "tStartMs": 998640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This, of course, doesn't\naffect the outcome,"
    } ]
  }, {
    "tStartMs": 1000950,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but we can keep doing this"
    } ]
  }, {
    "tStartMs": 1002240,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "creating Profiles 2, 3, 4, and so on"
    } ]
  }, {
    "tStartMs": 1005690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "with one more voter flipping B"
    } ]
  }, {
    "tStartMs": 1007520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "from the bottom to the top each time."
    } ]
  }, {
    "tStartMs": 1009890,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "If we keep doing this, there\nwill eventually come a voter"
    } ]
  }, {
    "tStartMs": 1013220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "whose change from having B\nat the bottom to B at the top"
    } ]
  }, {
    "tStartMs": 1016640,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "will first flip society's\nranking, moving B to the top."
    } ]
  }, {
    "tStartMs": 1021530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Let's call this voter the pivotal voter"
    } ]
  }, {
    "tStartMs": 1023870,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "and we'll label the Profile p."
    } ]
  }, {
    "tStartMs": 1026877,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "Profile o is then the profile"
    } ]
  }, {
    "tStartMs": 1028670,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "right before the pivotal change happens."
    } ]
  }, {
    "tStartMs": 1031280,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Let's now create a Profile\nq, which is the same as p,"
    } ]
  }, {
    "tStartMs": 1035210,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "except the pivotal voter moves A above B."
    } ]
  }, {
    "tStartMs": 1039920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "By independence of\nirrelevant alternatives,"
    } ]
  }, {
    "tStartMs": 1042320,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "the social rank must also put A above B."
    } ]
  }, {
    "tStartMs": 1046070,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Since for all of our voters,"
    } ]
  }, {
    "tStartMs": 1048050,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the relative position of A and B"
    } ]
  }, {
    "tStartMs": 1050180,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is the same as it was in Profile o,"
    } ]
  }, {
    "tStartMs": 1053330,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and B must be ranked above C"
    } ]
  }, {
    "tStartMs": 1056660,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "because the relative positions\nof B and C are the same"
    } ]
  }, {
    "tStartMs": 1060260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "as they were in Profile p,"
    } ]
  }, {
    "tStartMs": 1062750,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "where our pivotal voter\nmoved B to the top."
    } ]
  }, {
    "tStartMs": 1065930,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "By transitivity A must be ranked above C"
    } ]
  }, {
    "tStartMs": 1069620,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in the social ranking."
    } ]
  }, {
    "tStartMs": 1071210,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "This is true regardless"
    } ]
  }, {
    "tStartMs": 1072830,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of how any of the\nnon-pivotal voters rearrange"
    } ]
  }, {
    "tStartMs": 1075890,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "their positions of A and C,"
    } ]
  }, {
    "tStartMs": 1078110,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "because these rearrangements don't change"
    } ]
  }, {
    "tStartMs": 1080750,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "the position of A relative\nto B or C relative to B."
    } ]
  }, {
    "tStartMs": 1086420,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "This means the pivotal\nvoter is actually a dictator"
    } ]
  }, {
    "tStartMs": 1089570,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "for determining society's\npreference of A over C."
    } ]
  }, {
    "tStartMs": 1093350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The social rank will always\nagree with the pivotal voter"
    } ]
  }, {
    "tStartMs": 1096200,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "regardless of what the other voters do."
    } ]
  }, {
    "tStartMs": 1099860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We can run a similar thought experiment"
    } ]
  }, {
    "tStartMs": 1101960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "where we put C at the bottom"
    } ]
  }, {
    "tStartMs": 1103760,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and prove that there is again, a dictator,"
    } ]
  }, {
    "tStartMs": 1106310,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "who in this case determines"
    } ]
  }, {
    "tStartMs": 1108200,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "the social preference of A over B."
    } ]
  }, {
    "tStartMs": 1111380,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And it turns out this\nvoter is the same one"
    } ]
  }, {
    "tStartMs": 1113840,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "who determines the social\npreference for A over C."
    } ]
  }, {
    "tStartMs": 1118910,
    "dDurationMs": 3999,
    "segs": [ {
      "utf8": "The pivotal voter is\ntherefore a complete dictator."
    } ]
  }, {
    "tStartMs": 1122909,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "(dark music)"
    } ]
  }, {
    "tStartMs": 1124190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So is democracy doomed?"
    } ]
  }, {
    "tStartMs": 1126380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Well, Arrow's impossibility\ntheorem seems to say so."
    } ]
  }, {
    "tStartMs": 1129440,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "If there are three or more\ncandidates to choose from,"
    } ]
  }, {
    "tStartMs": 1132200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "there is no ranked-choice method"
    } ]
  }, {
    "tStartMs": 1134300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to rationally aggregate voter preferences."
    } ]
  }, {
    "tStartMs": 1136820,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "You always need to give something up."
    } ]
  }, {
    "tStartMs": 1142597,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(hopeful music)"
    } ]
  }, {
    "tStartMs": 1143430,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "But the mathematician, Duncan Black,"
    } ]
  }, {
    "tStartMs": 1145310,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "found a much more optimistic theorem"
    } ]
  }, {
    "tStartMs": 1147350,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "which might actually\nrepresent reality better."
    } ]
  }, {
    "tStartMs": 1151010,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If voters and candidates\nare naturally spread"
    } ]
  }, {
    "tStartMs": 1153350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "along a single dimension,"
    } ]
  }, {
    "tStartMs": 1154910,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "say ranging from liberal on the left"
    } ]
  }, {
    "tStartMs": 1156920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to conservative on the right,"
    } ]
  }, {
    "tStartMs": 1158600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but this could apply to any\nother political dimension."
    } ]
  }, {
    "tStartMs": 1161720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Well, then Black showed\nthat the preference"
    } ]
  }, {
    "tStartMs": 1164600,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "of the median voter will\nreflect the majority decision."
    } ]
  }, {
    "tStartMs": 1168560,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The median voter's choice"
    } ]
  }, {
    "tStartMs": 1170060,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "will often determine the\noutcome of the election,"
    } ]
  }, {
    "tStartMs": 1172850,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "a result that aligns with\nthe majority of voters,"
    } ]
  }, {
    "tStartMs": 1175700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "avoiding the paradoxes"
    } ]
  }, {
    "tStartMs": 1176900,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and inconsistencies highlighted by Arrow."
    } ]
  }, {
    "tStartMs": 1180140,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And there's more good news."
    } ]
  }, {
    "tStartMs": 1182090,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Arrow's Impossibility Theorem only applies"
    } ]
  }, {
    "tStartMs": 1184310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to ordinal voting systems,"
    } ]
  }, {
    "tStartMs": 1185990,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "ones in which the voters\nrank candidates over others."
    } ]
  }, {
    "tStartMs": 1189830,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "There is another way:\nrated voting systems."
    } ]
  }, {
    "tStartMs": 1193520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The simplest version is\nknown as approval voting"
    } ]
  }, {
    "tStartMs": 1196220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "where instead of ranking the candidates,"
    } ]
  }, {
    "tStartMs": 1198230,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "the voters just tick the\ncandidates they approve of."
    } ]
  }, {
    "tStartMs": 1201680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "There are also versions\nwhere you could indicate"
    } ]
  }, {
    "tStartMs": 1203720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "how strongly you like each candidate,"
    } ]
  }, {
    "tStartMs": 1205940,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "say from -10, strongly disapprove of,"
    } ]
  }, {
    "tStartMs": 1208700,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to +10, strongly approve."
    } ]
  }, {
    "tStartMs": 1211850,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Research has found"
    } ]
  }, {
    "tStartMs": 1212870,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that approval voting\nincreases voter turnout,"
    } ]
  }, {
    "tStartMs": 1215330,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "decreases negative campaigning"
    } ]
  }, {
    "tStartMs": 1217190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and prevents the spoiler effect."
    } ]
  }, {
    "tStartMs": 1219530,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Voters could express their\napproval for a candidate"
    } ]
  }, {
    "tStartMs": 1221810,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "without worrying about the size"
    } ]
  }, {
    "tStartMs": 1223280,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of the party they're voting for."
    } ]
  }, {
    "tStartMs": 1225230,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It's also simple to tally,"
    } ]
  }, {
    "tStartMs": 1227030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "just count up what\npercentage of the voters"
    } ]
  }, {
    "tStartMs": 1229070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "approve of each candidate"
    } ]
  }, {
    "tStartMs": 1230450,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and the one with the\nhighest approval wins."
    } ]
  }, {
    "tStartMs": 1233660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Kenneth Arrow was initially skeptical"
    } ]
  }, {
    "tStartMs": 1235850,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of rated-voting systems,"
    } ]
  }, {
    "tStartMs": 1237410,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "but toward the end of his life,"
    } ]
  }, {
    "tStartMs": 1238670,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "he agreed that they were\nlikely the best method."
    } ]
  }, {
    "tStartMs": 1241940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Approval voting is not new."
    } ]
  }, {
    "tStartMs": 1243860,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It was used by priests in the Vatican"
    } ]
  }, {
    "tStartMs": 1245810,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "to elect the Pope between 1294 and 1621."
    } ]
  }, {
    "tStartMs": 1249560,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "It's also used to elect"
    } ]
  }, {
    "tStartMs": 1251060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the Secretary General\nof the United Nations,"
    } ]
  }, {
    "tStartMs": 1253730,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "but it hasn't been widely\nused in large-scale elections."
    } ]
  }, {
    "tStartMs": 1257150,
    "dDurationMs": 3948,
    "segs": [ {
      "utf8": "And so more real-world\ntesting is likely required."
    } ]
  }, {
    "tStartMs": 1261098,
    "dDurationMs": 972,
    "segs": [ {
      "utf8": "(mellow music)"
    } ]
  }, {
    "tStartMs": 1262070,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So is democracy mathematically impossible?"
    } ]
  }, {
    "tStartMs": 1264980,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Well, yes, if we use ranked\nchoice methods of voting,"
    } ]
  }, {
    "tStartMs": 1267830,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "which is what most\ncountries in the world use"
    } ]
  }, {
    "tStartMs": 1270020,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to elect their leaders."
    } ]
  }, {
    "tStartMs": 1271400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And some methods are clearly better"
    } ]
  }, {
    "tStartMs": 1273440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "at aggregating the people's\npreferences than others,"
    } ]
  }, {
    "tStartMs": 1275810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the use of first past the post voting"
    } ]
  }, {
    "tStartMs": 1278090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "feels quite frankly ridiculous to me,"
    } ]
  }, {
    "tStartMs": 1280100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "given all of its flaws."
    } ]
  }, {
    "tStartMs": 1281690,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But just because things aren't perfect"
    } ]
  }, {
    "tStartMs": 1283640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "doesn't mean we shouldn't try."
    } ]
  }, {
    "tStartMs": 1285590,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Being interested in the world around us,"
    } ]
  }, {
    "tStartMs": 1287270,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "caring about issues,"
    } ]
  }, {
    "tStartMs": 1288590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and being politically\nengaged is important."
    } ]
  }, {
    "tStartMs": 1291590,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It might be one of the few ways"
    } ]
  }, {
    "tStartMs": 1293210,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "we can make a real\ndifference in the world."
    } ]
  }, {
    "tStartMs": 1295580,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "Like Winston Churchill said,"
    } ]
  }, {
    "tStartMs": 1296787,
    "dDurationMs": 3413,
    "segs": [ {
      "utf8": "\"Democracy is the worst form of government"
    } ]
  }, {
    "tStartMs": 1300200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "except for all the other\nforms that have been tried.\""
    } ]
  }, {
    "tStartMs": 1303500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Democracy is not perfect, but\nit's the best thing we've got."
    } ]
  }, {
    "tStartMs": 1307100,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "The game might be crooked, but\nit's the only game in town."
    } ]
  }, {
    "tStartMs": 1310720,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "(static buzzes and whines)"
    } ]
  }, {
    "tStartMs": 1315620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The world is changing."
    } ]
  }, {
    "tStartMs": 1317480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "How it works today is no guarantee"
    } ]
  }, {
    "tStartMs": 1319310,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of how it'll work tomorrow"
    } ]
  }, {
    "tStartMs": 1320600,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "from how we elect presidents\nto how we do our jobs."
    } ]
  }, {
    "tStartMs": 1323870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Luckily, there's an easy way to be ready"
    } ]
  }, {
    "tStartMs": 1325790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "for whatever the future holds\nby expanding your knowledge"
    } ]
  }, {
    "tStartMs": 1329000,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and critical thinking skills\na little bit every day."
    } ]
  }, {
    "tStartMs": 1331910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And you can get started\ndoing that right now for free"
    } ]
  }, {
    "tStartMs": 1334490,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "with today's sponsor: Brilliant."
    } ]
  }, {
    "tStartMs": 1336230,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Brilliant will make you a better\nthinker and problem solver"
    } ]
  }, {
    "tStartMs": 1339170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "while helping you build real skills"
    } ]
  }, {
    "tStartMs": 1341090,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in everything from math and data analysis"
    } ]
  }, {
    "tStartMs": 1343280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to programming and AI,"
    } ]
  }, {
    "tStartMs": 1345650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "whatever it is that you're curious about."
    } ]
  }, {
    "tStartMs": 1347870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "On Brilliant you'll\nlearn through discovery"
    } ]
  }, {
    "tStartMs": 1349820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "by trying things out for yourself,"
    } ]
  }, {
    "tStartMs": 1351380,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and you'll not only gain\nknowledge of key concepts,"
    } ]
  }, {
    "tStartMs": 1354380,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "you'll learn to apply them\nto real-world situations."
    } ]
  }, {
    "tStartMs": 1357710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Learning a little every day"
    } ]
  }, {
    "tStartMs": 1359240,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is one of the most\nimportant things you can do,"
    } ]
  }, {
    "tStartMs": 1361820,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and Brilliant is the perfect way to do it"
    } ]
  }, {
    "tStartMs": 1364250,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "with thousands of bite-sized\nlessons that take just minutes."
    } ]
  }, {
    "tStartMs": 1368660,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Now, thinking about\nelections for this video"
    } ]
  }, {
    "tStartMs": 1371090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "led me to revisit some of their courses"
    } ]
  }, {
    "tStartMs": 1373190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "on probability and statistics."
    } ]
  }, {
    "tStartMs": 1375440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They're a great on-ramp to learning"
    } ]
  }, {
    "tStartMs": 1377240,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "how we use data to make predictions."
    } ]
  }, {
    "tStartMs": 1379130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Plus, they get you hands-on with real data"
    } ]
  }, {
    "tStartMs": 1381470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and even let you run simulations"
    } ]
  }, {
    "tStartMs": 1383060,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "for things like who\nwill win the World Cup."
    } ]
  }, {
    "tStartMs": 1385370,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And the best part about Brilliant is"
    } ]
  }, {
    "tStartMs": 1387140,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "you can learn from anywhere\nright on your phone."
    } ]
  }, {
    "tStartMs": 1390320,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So whenever you have a few minutes,"
    } ]
  }, {
    "tStartMs": 1392210,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "you can be building a\nquicker, sharper mind."
    } ]
  }, {
    "tStartMs": 1395270,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "To try everything Brilliant has to offer"
    } ]
  }, {
    "tStartMs": 1397070,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for free for 30 days,"
    } ]
  }, {
    "tStartMs": 1398330,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "visit brilliant.org/veritasium"
    } ]
  }, {
    "tStartMs": 1401210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "or scan this QR code"
    } ]
  }, {
    "tStartMs": 1402770,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or click that link down\nin the description."
    } ]
  }, {
    "tStartMs": 1404930,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "You will also get 20% off an\nannual Premium subscription."
    } ]
  }, {
    "tStartMs": 1408380,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So I want to thank Brilliant\nfor supporting the show"
    } ]
  }, {
    "tStartMs": 1410780,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
