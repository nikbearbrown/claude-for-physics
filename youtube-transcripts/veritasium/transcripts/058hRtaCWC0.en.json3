    "tStartMs": 474720,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "- So this robot is even capable of picking\nobjects up off the ground."
    } ]
  }, {
    "tStartMs": 479620,
    "dDurationMs": 10769,
    "segs": [ {
      "utf8": "- We'll try that and see if we can grab it.\nBecause of the compliance of the tubes, it"
    } ]
  }, {
    "tStartMs": 490389,
    "dDurationMs": 4981,
    "segs": [ {
      "utf8": "has a natural ability to grasp and manipulate\nobjects because as it does so, the tubes bend"
    } ]
  }, {
    "tStartMs": 495370,
    "dDurationMs": 5519,
    "segs": [ {
      "utf8": "ever so slightly, which increases the contact\narea and distributes evenly, the forces that"
