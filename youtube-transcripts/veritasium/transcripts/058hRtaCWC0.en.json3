  }, {
    "tStartMs": 528839,
    "dDurationMs": 6081,
    "segs": [ {
      "utf8": "a small compressor, which isn't there to provide\npower to the robot, but would help you maintain"
    } ]
  }, {
    "tStartMs": 534920,
    "dDurationMs": 2439,
    "segs": [ {
      "utf8": "pressure, if there were any small leaks."
    } ]
  }, {
    "tStartMs": 537359,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "- when you tell someone you're working on\na robot and they see this, does it defy expectations?"
    } ]
  }, {
    "tStartMs": 541289,
    "dDurationMs": 5100,
    "segs": [ {
