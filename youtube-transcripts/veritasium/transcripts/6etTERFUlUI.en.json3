{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I am at a gold mine a couple hours"
    } ]
  }, {
    "tStartMs": 2560,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "outside of Melbourne,"
    } ]
  }, {
    "tStartMs": 3630,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "because, one kilometer underground,"
    } ]
  }, {
    "tStartMs": 5930,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "they're putting in a detector\nto look for dark matter."
    } ]
  }, {
    "tStartMs": 9430,
    "dDurationMs": 937,
    "segs": [ {
      "utf8": "Let's go."
    } ]
  }, {
    "tStartMs": 10367,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "(epic music)"
    } ]
  }, {
    "tStartMs": 12910,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "It's gonna take 30 minutes to go down"
    } ]
  }, {
    "tStartMs": 14930,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "a kilometer underground."
    } ]
  }, {
    "tStartMs": 16810,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Dark matter is thought to make up 85%"
    } ]
  }, {
    "tStartMs": 19580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of all the matter in existence."
    } ]
  }, {
    "tStartMs": 22130,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "It could form a shadow universe\nfive times more massive"
    } ]
  }, {
    "tStartMs": 25800,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "than everything we can see."
    } ]
  }, {
    "tStartMs": 28070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Over the past several decades,"
    } ]
  }, {
    "tStartMs": 29450,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "over 50 experiments have tried"
    } ]
  }, {
    "tStartMs": 31180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to make a direct detection of dark matter,"
    } ]
  }, {
    "tStartMs": 33580,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "but none of them has found anything,"
    } ]
  }, {
    "tStartMs": 36360,
    "dDurationMs": 1063,
    "segs": [ {
      "utf8": "except one."
    } ]
  }, {
    "tStartMs": 41750,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Under a mountain in the Italian Alps,"
    } ]
  }, {
    "tStartMs": 44160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "there is a dark matter\ndetector called DAMA/LIBRA."
    } ]
  }, {
    "tStartMs": 47340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's been collecting\ndata for around 20 years"
    } ]
  }, {
    "tStartMs": 50340,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "and, every year, it sees\nthe same peculiar results."
    } ]
  }, {
    "tStartMs": 55000,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "The rate of detections\nincreases to a peak in June"
    } ]
  }, {
    "tStartMs": 59040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and then decreases to\na minimum in November."
    } ]
  }, {
    "tStartMs": 62400,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Some scientists think"
    } ]
  }, {
    "tStartMs": 63640,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "this could be the first direct\nevidence of dark matter."
    } ]
  }, {
    "tStartMs": 67950,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "But why would dark matter\ncreate a periodic annual signal?"
    } ]
  }, {
    "tStartMs": 72810,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Well, this is our galaxy,"
    } ]
  }, {
    "tStartMs": 75100,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "or at least what it looks\nlike with visible light."
    } ]
  }, {
    "tStartMs": 77910,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Astronomers suspect it is surrounded"
    } ]
  }, {
    "tStartMs": 80400,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "and permeated by a huge\nsphere of dark matter,"
    } ]
  }, {
    "tStartMs": 85070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "invisible particles\nthat are zipping around"
    } ]
  }, {
    "tStartMs": 87650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "all in random directions."
    } ]
  }, {
    "tStartMs": 89840,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "According to most theories,"
    } ]
  }, {
    "tStartMs": 91181,
    "dDurationMs": 3949,
    "segs": [ {
      "utf8": "dark matter doesn't interact\nwith anything including itself,"
    } ]
  }, {
    "tStartMs": 95130,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "except through gravity."
    } ]
  }, {
    "tStartMs": 97320,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "We think there should be five\ntimes as much dark matter"
    } ]
  }, {
    "tStartMs": 101060,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "as there is ordinary matter."
    } ]
  }, {
    "tStartMs": 108590,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Now, our solar system is\nmoving around the galaxy"
    } ]
  }, {
    "tStartMs": 111610,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "at 220 kilometers per second."
    } ]
  }, {
    "tStartMs": 114650,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "That means we're also\nmoving through dark matter"
    } ]
  }, {
    "tStartMs": 117280,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "at this rate,"
    } ]
  }, {
    "tStartMs": 118570,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "except earth orbits the sun\nat 30 kilometers a second."
    } ]
  }, {
    "tStartMs": 121800,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "So, for half the year,"
    } ]
  }, {
    "tStartMs": 123620,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "we're moving with the sun,"
    } ]
  }, {
    "tStartMs": 125090,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "going faster through dark matter."
    } ]
  }, {
    "tStartMs": 127210,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "And, the other half the year,"
    } ]
  }, {
    "tStartMs": 128370,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "we're moving in the opposite direction,"
    } ]
  }, {
    "tStartMs": 130240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "so going slower through dark matter."
    } ]
  }, {
    "tStartMs": 132920,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "And, the idea is we\nencounter more dark matter"
    } ]
  }, {
    "tStartMs": 135810,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "when we're moving through it fastest,"
    } ]
  }, {
    "tStartMs": 137600,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "which happens to be in June,"
    } ]
  }, {
    "tStartMs": 139770,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "and less of it when we're moving slowest,"
    } ]
  }, {
    "tStartMs": 142460,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "which happens in November."
    } ]
  }, {
    "tStartMs": 144420,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "The actual geometry is a\nlittle more complicated."
    } ]
  }, {
    "tStartMs": 147790,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "The solar system is tilted at 60 degrees"
    } ]
  }, {
    "tStartMs": 150600,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "relative to the plane of the galaxy,"
    } ]
  }, {
    "tStartMs": 153170,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "but the idea still works."
    } ]
  }, {
    "tStartMs": 155580,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So, the signal observed at DAMA/LIBRA"
    } ]
  }, {
    "tStartMs": 158180,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "may be due to this motion\nthrough dark matter"
    } ]
  }, {
    "tStartMs": 162090,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "or it might not be due\nto dark matter at all."
    } ]
  }, {
    "tStartMs": 165170,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "It could just be something\nmundane, like the temperature,"
    } ]
  }, {
    "tStartMs": 168200,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "humidity, moisture in the\nsoil, the snow on the mountain,"
    } ]
  }, {
    "tStartMs": 172330,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "or the number of tourists in Italy."
    } ]
  }, {
    "tStartMs": 175170,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "All of these things fluctuate\nwith a period of one year."
    } ]
  }, {
    "tStartMs": 179230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And, that is why they're gonna build"
    } ]
  }, {
    "tStartMs": 181120,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "an almost identical experiment\nin the Southern hemisphere,"
    } ]
  }, {
    "tStartMs": 184310,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "down the bottom of this gold\nmine outside of Melbourne,"
    } ]
  }, {
    "tStartMs": 187020,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "because, there, the seasons are reversed,"
    } ]
  }, {
    "tStartMs": 190250,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "but our motion through dark\nmatter is still the same."
    } ]
  }, {
    "tStartMs": 193500,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "So, if we see the same signal,"
    } ]
  }, {
    "tStartMs": 195890,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "it's pretty strong evidence"
    } ]
  }, {
    "tStartMs": 197560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for the existence of dark matter."
    } ]
  }, {
    "tStartMs": 199960,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "One of the big problems\nthat DAMA/LIBRA has"
    } ]
  }, {
    "tStartMs": 202050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is that there are other\nvery similar experiments"
    } ]
  }, {
    "tStartMs": 204090,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that don't see anything."
    } ]
  }, {
    "tStartMs": 205680,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And, this has led to a lot of uncertainty"
    } ]
  }, {
    "tStartMs": 209160,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "about is the DAMA/LIBRA\nsignal really dark matter?"
    } ]
  }, {
    "tStartMs": 213740,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So, yeah, we don't know, right?"
    } ]
  }, {
    "tStartMs": 216220,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "The favorite thing in science..."
    } ]
  }, {
    "tStartMs": 219143,
    "dDurationMs": 1908,
    "segs": [ {
      "utf8": "But, why do we think dark matter exists"
    } ]
  }, {
    "tStartMs": 221051,
    "dDurationMs": 1032,
    "segs": [ {
      "utf8": "in the first place?"
    } ]
  }, {
    "tStartMs": 223060,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "In 1933, Swiss astronomer, Fritz Zwicky,"
    } ]
  }, {
    "tStartMs": 225900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "was studying the coma cluster,"
    } ]
  }, {
    "tStartMs": 227790,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "a collection of more\nthan a thousand galaxies."
    } ]
  }, {
    "tStartMs": 230860,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "These galaxies are\ngravitationally bound together."
    } ]
  }, {
    "tStartMs": 234060,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "So, they all orbit around their\ncollective center of mass."
    } ]
  }, {
    "tStartMs": 237830,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Zwicky measured the orbital\nspeeds of these galaxies"
    } ]
  }, {
    "tStartMs": 240660,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "and found that somewhere moving\nway faster than he expected,"
    } ]
  }, {
    "tStartMs": 244610,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "it was as if there was a lot more matter"
    } ]
  }, {
    "tStartMs": 246820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "in the cluster than he could see,"
    } ]
  }, {
    "tStartMs": 248890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "pulling everything inwards."
    } ]
  }, {
    "tStartMs": 251470,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So, he proposed the existence\nof invisible matter,"
    } ]
  }, {
    "tStartMs": 254650,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "which he called dunkle materie,"
    } ]
  }, {
    "tStartMs": 257290,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "the origin of the term dark matter."
    } ]
  }, {
    "tStartMs": 260460,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "No one really took this idea seriously,"
    } ]
  }, {
    "tStartMs": 262400,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "but 40 years later, dark\nmatter turned up again."
    } ]
  }, {
    "tStartMs": 266090,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Vera Ruben and Kent Ford\nobserved the motion of stars"
    } ]
  }, {
    "tStartMs": 269390,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "in the Andromeda Galaxy."
    } ]
  }, {
    "tStartMs": 271160,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "And, they expected"
    } ]
  }, {
    "tStartMs": 272020,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that the further out\nfrom the center you go,"
    } ]
  }, {
    "tStartMs": 274330,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "the slower the stars would be orbiting,"
    } ]
  }, {
    "tStartMs": 277020,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "but this is not what they found."
    } ]
  }, {
    "tStartMs": 279770,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The rotational velocity\nstays almost constant"
    } ]
  }, {
    "tStartMs": 282870,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with increasing distance from the center."
    } ]
  }, {
    "tStartMs": 285270,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Without additional mass in the galaxy"
    } ]
  }, {
    "tStartMs": 287070,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to pull those stars in,"
    } ]
  }, {
    "tStartMs": 288630,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "they should be flung off into space."
    } ]
  }, {
    "tStartMs": 291440,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "The result was the same in other galaxies."
    } ]
  }, {
    "tStartMs": 293890,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Using radio telescopes,"
    } ]
  }, {
    "tStartMs": 295370,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Albert Bosma and others\nmeasured hydrogen gas"
    } ]
  }, {
    "tStartMs": 298220,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "even further out from a galaxy center,"
    } ]
  }, {
    "tStartMs": 300890,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "but the rotational velocity\nstill stayed constant."
    } ]
  }, {
    "tStartMs": 305010,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "One way to explain this"
    } ]
  }, {
    "tStartMs": 306170,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "is to posit the existence\nof matter we can't see,"
    } ]
  }, {
    "tStartMs": 309790,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "dark matter,"
    } ]
  }, {
    "tStartMs": 310920,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "which holds all these galaxies together."
    } ]
  }, {
    "tStartMs": 316300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So, let's say you have a star"
    } ]
  }, {
    "tStartMs": 318100,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and this represents the mass of everything"
    } ]
  }, {
    "tStartMs": 320920,
    "dDurationMs": 3117,
    "segs": [ {
      "utf8": "in the center of the galaxy\nthat's pulling the star in."
    } ]
  }, {
    "tStartMs": 324037,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "The star can maintain a stable orbit"
    } ]
  }, {
    "tStartMs": 327400,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "if it's centripetal force is equal"
    } ]
  }, {
    "tStartMs": 330060,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "to the gravitational attraction"
    } ]
  }, {
    "tStartMs": 331970,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "to all the mass in the rest of the galaxy."
    } ]
  }, {
    "tStartMs": 335030,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "And, so you can see that at\nabout a distance of one meter,"
    } ]
  }, {
    "tStartMs": 337630,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "this is the speed of the orbit."
    } ]
  }, {
    "tStartMs": 340510,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Okay, but what happens if\nwe add some dark matter?"
    } ]
  }, {
    "tStartMs": 344090,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So, this water bottle represents\nthe matter we can't see,"
    } ]
  }, {
    "tStartMs": 347810,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "now there is more mass pulling\nthis star into the middle,"
    } ]
  }, {
    "tStartMs": 353520,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "which means, at the same orbit,"
    } ]
  }, {
    "tStartMs": 356020,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it can now go much faster,"
    } ]
  }, {
    "tStartMs": 358780,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "and, in fact, it must go\nfaster to maintain that orbit."
    } ]
  }, {
    "tStartMs": 363580,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And, this explains the observation."
    } ]
  }, {
    "tStartMs": 365740,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "This is what we see."
    } ]
  }, {
    "tStartMs": 367309,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(metal clanking)"
    } ]
  }, {
    "tStartMs": 368142,
    "dDurationMs": 2608,
    "segs": [ {
      "utf8": "(Derek laughing)"
    } ]
  }, {
    "tStartMs": 370750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "By looking at the\nrotation speeds of stars,"
    } ]
  }, {
    "tStartMs": 373180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "scientists estimate that about 85%"
    } ]
  }, {
    "tStartMs": 375760,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "of the mass of a galaxy is dark matter."
    } ]
  }, {
    "tStartMs": 379010,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But, there's another way to\nexplain these observations"
    } ]
  }, {
    "tStartMs": 381730,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "without invoking dark matter."
    } ]
  }, {
    "tStartMs": 383930,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And, that is to modify\nour theory of gravity."
    } ]
  }, {
    "tStartMs": 387290,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "What's the supporting\nevidence for thinking"
    } ]
  }, {
    "tStartMs": 389610,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "that the particle idea\nis totally misguided"
    } ]
  }, {
    "tStartMs": 393260,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "and we should actually be looking"
    } ]
  }, {
    "tStartMs": 394530,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "at a revised theory of gravity?"
    } ]
  }, {
    "tStartMs": 396660,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "We can either invoke\nsomething we can't see"
    } ]
  }, {
    "tStartMs": 399400,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "or you just say, well, the\nuniverse is what we can see,"
    } ]
  }, {
    "tStartMs": 402850,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "and we need a way to explain\nwhat's going on out there."
    } ]
  }, {
    "tStartMs": 405440,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "And, the only way we can do that"
    } ]
  }, {
    "tStartMs": 406700,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "is by modifying the laws of physics."
    } ]
  }, {
    "tStartMs": 409030,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, when you look at the\noutskirts of galaxies,"
    } ]
  }, {
    "tStartMs": 411850,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "they've got a lot of\ncentripetal acceleration."
    } ]
  }, {
    "tStartMs": 415010,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Dark matter says that well,\nthat centripetal acceleration"
    } ]
  }, {
    "tStartMs": 417840,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "is due to the gravitational\neffect of dark matter."
    } ]
  }, {
    "tStartMs": 420250,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Whereas, the people who\nlike MOND will say, no,"
    } ]
  }, {
    "tStartMs": 422770,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "that's centripetal acceleration,"
    } ]
  }, {
    "tStartMs": 424160,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that's just the fact that\nit's now reached this floor"
    } ]
  }, {
    "tStartMs": 426380,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "and can't get any lower."
    } ]
  }, {
    "tStartMs": 427690,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "So, they, they're saying that\nthere's not additional force"
    } ]
  }, {
    "tStartMs": 432060,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "due to dark matter,"
    } ]
  }, {
    "tStartMs": 433230,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but there's a limit to how\nlow the acceleration could go."
    } ]
  }, {
    "tStartMs": 436200,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "I think the consensus is hugely"
    } ]
  }, {
    "tStartMs": 438070,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "in favor of it being a physical substance,"
    } ]
  }, {
    "tStartMs": 440840,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "in that it just seems reasonable that"
    } ]
  }, {
    "tStartMs": 444660,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "is that it could be\nother particles out there"
    } ]
  }, {
    "tStartMs": 446750,
    "dDurationMs": 1403,
    "segs": [ {
      "utf8": "that we haven't seen yet."
    } ]
  }, {
    "tStartMs": 449490,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And, there's more evidence."
    } ]
  }, {
    "tStartMs": 451610,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "This is the bullet cluster,"
    } ]
  }, {
    "tStartMs": 453510,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "a site where two clusters\nof galaxies collided."
    } ]
  }, {
    "tStartMs": 456900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Most of the ordinary\nmass of these clusters"
    } ]
  }, {
    "tStartMs": 459300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is in the interstellar gas."
    } ]
  }, {
    "tStartMs": 461880,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "And, when the collision occurred,"
    } ]
  }, {
    "tStartMs": 463370,
    "dDurationMs": 4970,
    "segs": [ {
      "utf8": "the interstellar gas interacted,\nheated up, and slowed down."
    } ]
  }, {
    "tStartMs": 468340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, you'd expect that most of\nthe mass of the bullet cluster"
    } ]
  }, {
    "tStartMs": 471220,
    "dDurationMs": 3274,
    "segs": [ {
      "utf8": "would be in the middle\nwhere all of this gas is."
    } ]
  }, {
    "tStartMs": 474494,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "But, if you use gravitational lensing,"
    } ]
  }, {
    "tStartMs": 476860,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "the way that gravity bends light,"
    } ]
  }, {
    "tStartMs": 479210,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "you can actually measure"
    } ]
  }, {
    "tStartMs": 480530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "where most of the mass in this picture is."
    } ]
  }, {
    "tStartMs": 482870,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "And, it isn't in the middle."
    } ]
  }, {
    "tStartMs": 484960,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "It's actually on either side."
    } ]
  }, {
    "tStartMs": 487570,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "So, the best way to explain this"
    } ]
  }, {
    "tStartMs": 489450,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "is that when the clusters collided,"
    } ]
  }, {
    "tStartMs": 491560,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "all that gas got stuck in the middle,"
    } ]
  }, {
    "tStartMs": 493690,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "but the dark matter passed right through,"
    } ]
  }, {
    "tStartMs": 496760,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "creating the most gravitational lensing"
    } ]
  }, {
    "tStartMs": 499350,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "where we can see the\nleast ordinary matter."
    } ]
  }, {
    "tStartMs": 503880,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Even more evidence for dark matter"
    } ]
  }, {
    "tStartMs": 505670,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "comes from the oldest\nlight in the universe."
    } ]
  }, {
    "tStartMs": 509280,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "380,000 years after the big bang,"
    } ]
  }, {
    "tStartMs": 512110,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "light could finally travel\nthrough the universe unimpeded."
    } ]
  }, {
    "tStartMs": 515740,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "And, this is what we see"
    } ]
  }, {
    "tStartMs": 517470,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "as the cosmic microwave background or CMB."
    } ]
  }, {
    "tStartMs": 521330,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The red spots show\nwhere the early universe"
    } ]
  }, {
    "tStartMs": 523610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "was a little hotter"
    } ]
  }, {
    "tStartMs": 524870,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and the blue spots show\nwhere it was a little cooler,"
    } ]
  }, {
    "tStartMs": 527750,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but these temperature\ndifferences were tiny."
    } ]
  }, {
    "tStartMs": 529970,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "Just 0.01%, but they are there."
    } ]
  }, {
    "tStartMs": 534600,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And, you can turn this\npicture into a graph"
    } ]
  }, {
    "tStartMs": 537180,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "by counting up how many blobs\nthere are of different sizes."
    } ]
  }, {
    "tStartMs": 541460,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, there's the most common size blob,"
    } ]
  }, {
    "tStartMs": 544310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which results in this peak,"
    } ]
  }, {
    "tStartMs": 546410,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "but there are also\nother common size blobs."
    } ]
  }, {
    "tStartMs": 549390,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "And, so you get these other\npeaks of decreasing size."
    } ]
  }, {
    "tStartMs": 553000,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Now, the height of these peaks"
    } ]
  }, {
    "tStartMs": 554250,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "depends on how much dark matter there is."
    } ]
  }, {
    "tStartMs": 556950,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "In a universe without dark matter,"
    } ]
  }, {
    "tStartMs": 558960,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "the graph looks like this,"
    } ]
  }, {
    "tStartMs": 561260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but as dark matter increases,"
    } ]
  }, {
    "tStartMs": 563510,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "the amplitudes of even\nnumbered peaks decreases."
    } ]
  }, {
    "tStartMs": 567500,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "To match the measurements of the CMB,"
    } ]
  }, {
    "tStartMs": 569680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "we need about five times\nas much dark matter"
    } ]
  }, {
    "tStartMs": 572240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "as ordinary matter."
    } ]
  }, {
    "tStartMs": 574000,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "This figure also agrees with\nthe amount of dark matter"
    } ]
  }, {
    "tStartMs": 576450,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "required to explain the\nmotion of stars in galaxies"
    } ]
  }, {
    "tStartMs": 579800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and the motion of galaxies in clusters."
    } ]
  }, {
    "tStartMs": 582800,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "So, the dark matter hypothesis"
    } ]
  }, {
    "tStartMs": 584550,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "explains a lot of different observations"
    } ]
  }, {
    "tStartMs": 587100,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "with a simple theoretical framework,"
    } ]
  }, {
    "tStartMs": 589550,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that there's some type\nof particle out there"
    } ]
  }, {
    "tStartMs": 592100,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that only interacts through gravity."
    } ]
  }, {
    "tStartMs": 594820,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "But, what is this particle exactly?"
    } ]
  }, {
    "tStartMs": 597600,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Well, since we don't know,"
    } ]
  }, {
    "tStartMs": 599490,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "scientists have proposed a\nwhole bunch of different things"
    } ]
  }, {
    "tStartMs": 602410,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "that it could be."
    } ]
  }, {
    "tStartMs": 603740,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "And, now we have to try\nto go out and find them."
    } ]
  }, {
    "tStartMs": 606490,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "The approach differs"
    } ]
  }, {
    "tStartMs": 608150,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "depending on what you're trying to find."
    } ]
  }, {
    "tStartMs": 610670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Dama Libra and the detector\nat the bottom of the gold mine"
    } ]
  }, {
    "tStartMs": 613460,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "are looking for WIMPs,"
    } ]
  }, {
    "tStartMs": 615200,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "weakly interacting massive particles."
    } ]
  }, {
    "tStartMs": 618070,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "These particles are expected to weigh"
    } ]
  }, {
    "tStartMs": 619830,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "about as much as a proton,"
    } ]
  }, {
    "tStartMs": 621740,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "but interact with ordinary\nmatter extremely weakly."
    } ]
  }, {
    "tStartMs": 628250,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "At the heart of the detector,"
    } ]
  }, {
    "tStartMs": 629380,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "our seven seven kilogram\ncrystals of pure sodium iodide."
    } ]
  }, {
    "tStartMs": 633900,
    "dDurationMs": 2098,
    "segs": [ {
      "utf8": "So, that's actually\nsodium iodide in there."
    } ]
  }, {
    "tStartMs": 635998,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 637065,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "I didn't expect it to be so clear."
    } ]
  }, {
    "tStartMs": 639372,
    "dDurationMs": 2678,
    "segs": [ {
      "utf8": "The idea is that very, very\nrarely a dark matter particle"
    } ]
  }, {
    "tStartMs": 642050,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "may hit a nucleus in the crystal"
    } ]
  }, {
    "tStartMs": 644530,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and transfer its energy."
    } ]
  }, {
    "tStartMs": 646540,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "This creates a flash of\nlight called a scintillation,"
    } ]
  }, {
    "tStartMs": 650260,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which is detected by\nphotomultiplier tubes,"
    } ]
  }, {
    "tStartMs": 652960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "very sensitive light detectors,"
    } ]
  }, {
    "tStartMs": 654720,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "which are positioned above\nand below each crystal."
    } ]
  }, {
    "tStartMs": 657970,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But, there's a problem,"
    } ]
  }, {
    "tStartMs": 659950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "even the purest sodium iodide crystal"
    } ]
  }, {
    "tStartMs": 662200,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "contains radioactive potassium."
    } ]
  }, {
    "tStartMs": 664530,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "And, when a potassium atom decays,"
    } ]
  }, {
    "tStartMs": 666100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "it emits an electron and a gamma ray."
    } ]
  }, {
    "tStartMs": 668470,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Now, the electron can cause a\nscintillation in the crystal"
    } ]
  }, {
    "tStartMs": 670810,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "just like the hypothesized\ndark matter particle."
    } ]
  }, {
    "tStartMs": 673930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So, to eliminate these events,"
    } ]
  }, {
    "tStartMs": 676000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the sodium iodide crystals are submerged"
    } ]
  }, {
    "tStartMs": 678800,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "in a tank full of 12 tons\nof linear alkylbenzene."
    } ]
  }, {
    "tStartMs": 683620,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "This is a liquid scintillator"
    } ]
  }, {
    "tStartMs": 685140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that emits light when\nexposed to a gamma ray"
    } ]
  }, {
    "tStartMs": 688080,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and that light can then be detected"
    } ]
  }, {
    "tStartMs": 689540,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "by photo multiplier tubes in the tank."
    } ]
  }, {
    "tStartMs": 692330,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So, if there's a simultaneous\ndetection in the crystal"
    } ]
  }, {
    "tStartMs": 695240,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "and in the tank,"
    } ]
  }, {
    "tStartMs": 696570,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "it was most likely a potassium decay,"
    } ]
  }, {
    "tStartMs": 699010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "not a dark matter event,"
    } ]
  }, {
    "tStartMs": 701800,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "but there's another problem, cosmic rays."
    } ]
  }, {
    "tStartMs": 704820,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "Energetic particles from the sun"
    } ]
  }, {
    "tStartMs": 706450,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "and other galaxies hit the\ntop of Earth's atmosphere"
    } ]
  }, {
    "tStartMs": 709740,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "creating muons,"
    } ]
  }, {
    "tStartMs": 711110,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "essentially heavy electrons,"
    } ]
  }, {
    "tStartMs": 713120,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "which stream toward the earth"
    } ]
  }, {
    "tStartMs": 715020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "at close to the speed of light."
    } ]
  }, {
    "tStartMs": 717090,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Muons can also create flashes\nof light in the crystal."
    } ]
  }, {
    "tStartMs": 720810,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "This is Muon detector,"
    } ]
  }, {
    "tStartMs": 723550,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "and it's got these three\npaddles of plastic here"
    } ]
  }, {
    "tStartMs": 727460,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "separated by some pieces of steel."
    } ]
  }, {
    "tStartMs": 729790,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "If we see a flash of light in all three,"
    } ]
  }, {
    "tStartMs": 732590,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "basically the same time,"
    } ]
  }, {
    "tStartMs": 733920,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "then we know that Muon\nhas passed through them."
    } ]
  }, {
    "tStartMs": 736530,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "So, if I hit reset, we can see,"
    } ]
  }, {
    "tStartMs": 740910,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "counting up the muons being seen."
    } ]
  }, {
    "tStartMs": 743530,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "So, it's at least a few a second."
    } ]
  }, {
    "tStartMs": 746410,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "This is why all sensitive\nparticle detectors"
    } ]
  }, {
    "tStartMs": 748940,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "are located deep underground"
    } ]
  }, {
    "tStartMs": 751330,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Here, we have the muon detector,"
    } ]
  }, {
    "tStartMs": 754210,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "now one kilometer underground,"
    } ]
  }, {
    "tStartMs": 756750,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and it's been running for\nsomething like 15 minutes,"
    } ]
  }, {
    "tStartMs": 759250,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "and there have been no muon counts."
    } ]
  }, {
    "tStartMs": 764170,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Yeah, we have to leave this\nrunning for a long time,"
    } ]
  }, {
    "tStartMs": 766330,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "I think, even if we wanted\nto get a single hit."
    } ]
  }, {
    "tStartMs": 768540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "We expect the number of muons down here"
    } ]
  }, {
    "tStartMs": 770670,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "to be about a million less."
    } ]
  }, {
    "tStartMs": 772820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And, we didn't see a million at the top,"
    } ]
  }, {
    "tStartMs": 774320,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "so we're probably not\ngonna see any down here."
    } ]
  }, {
    "tStartMs": 776770,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "And, this is the whole point"
    } ]
  }, {
    "tStartMs": 777840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of putting a dark matter\ndetector underground."
    } ]
  }, {
    "tStartMs": 780120,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "You wanna get rid of all the background"
    } ]
  }, {
    "tStartMs": 781810,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that would create noise in the detector."
    } ]
  }, {
    "tStartMs": 784150,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "But, even this shielding is not enough."
    } ]
  }, {
    "tStartMs": 786770,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We all have muon detectors\nimmediately above the tank."
    } ]
  }, {
    "tStartMs": 790130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So, if a flash is seen in a crystal"
    } ]
  }, {
    "tStartMs": 792140,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "at the same time a muon is detected,"
    } ]
  }, {
    "tStartMs": 794620,
    "dDurationMs": 1373,
    "segs": [ {
      "utf8": "it can be ruled out."
    } ]
  }, {
    "tStartMs": 797950,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "Being underground brings\nits own challenges."
    } ]
  }, {
    "tStartMs": 800820,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "The walls of the mine\ncontain trace amounts"
    } ]
  }, {
    "tStartMs": 802970,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "of radioactive elements\nlike uranium and thorium,"
    } ]
  }, {
    "tStartMs": 805740,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which decay into radon gas."
    } ]
  }, {
    "tStartMs": 808020,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The requirements here are fairly serious"
    } ]
  }, {
    "tStartMs": 810200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "for dark matter experiments."
    } ]
  }, {
    "tStartMs": 811640,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "We have to completely\ncontrol the environment,"
    } ]
  }, {
    "tStartMs": 813830,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in particular, the radon level."
    } ]
  }, {
    "tStartMs": 815480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "To counteract this, the walls\nof the cavern are coated"
    } ]
  }, {
    "tStartMs": 818200,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "with special paint to contain\nradioactive particles."
    } ]
  }, {
    "tStartMs": 821290,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "The crystals are immersed"
    } ]
  }, {
    "tStartMs": 822810,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "in a continuous stream\nof pure nitrogen gas."
    } ]
  }, {
    "tStartMs": 826060,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "And, the entire detector is shielded"
    } ]
  }, {
    "tStartMs": 828200,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "by 120 tons of steel and plastic."
    } ]
  }, {
    "tStartMs": 831950,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Wow, look at the size of that cavern."
    } ]
  }, {
    "tStartMs": 836510,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "There is a lot riding on this experiment."
    } ]
  }, {
    "tStartMs": 839160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It will validate or disprove"
    } ]
  }, {
    "tStartMs": 841480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "one of the most contentious\nresults in physics."
    } ]
  }, {
    "tStartMs": 844480,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "So, if we see nothing, well,"
    } ]
  }, {
    "tStartMs": 846470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "this is the death of DAMA/LIBRA"
    } ]
  }, {
    "tStartMs": 848480,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "but if we see something,\nwell, we are all happy."
    } ]
  }, {
    "tStartMs": 850920,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "I actually like the idea that"
    } ]
  }, {
    "tStartMs": 852740,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "because 80% of the mass of\nthe universe is dark matter"
    } ]
  }, {
    "tStartMs": 856290,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "or dark stuff,"
    } ]
  }, {
    "tStartMs": 857430,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "maybe there's more than just one particle"
    } ]
  }, {
    "tStartMs": 859780,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "that dark matter is made of."
    } ]
  }, {
    "tStartMs": 860720,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "It could be an entire dark\nstandard model if you like."
    } ]
  }, {
    "tStartMs": 863970,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "A dark version of\neverything that we can see"
    } ]
  }, {
    "tStartMs": 865590,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "or maybe something more complex,"
    } ]
  }, {
    "tStartMs": 866820,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "'cause there's so much more of it."
    } ]
  }, {
    "tStartMs": 868120,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Like I really hope it's that."
    } ]
  }, {
    "tStartMs": 870460,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "- Do you think that dark matter interacts"
    } ]
  }, {
    "tStartMs": 872400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "with ordinary matter?"
    } ]
  }, {
    "tStartMs": 873660,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "- If we want to find\nout what this stuff is,"
    } ]
  }, {
    "tStartMs": 875290,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "we better hope there's\nsome level of interaction"
    } ]
  }, {
    "tStartMs": 878150,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "that we can at least probe"
    } ]
  }, {
    "tStartMs": 879670,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "when it comes to doing experiments."
    } ]
  }, {
    "tStartMs": 881490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If God gave me the great book of physics"
    } ]
  }, {
    "tStartMs": 884010,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "and there were two sections,\nsection A and section B,"
    } ]
  }, {
    "tStartMs": 887780,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "one for the luminous matter"
    } ]
  }, {
    "tStartMs": 889340,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and one for dark matter,"
    } ]
  }, {
    "tStartMs": 890840,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and they didn't talk to each other,"
    } ]
  }, {
    "tStartMs": 892400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I would say that was a\nvery peculiar universe."
    } ]
  }, {
    "tStartMs": 895130,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But, in science, we have to\nlive with the possibility"
    } ]
  }, {
    "tStartMs": 897770,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "that, at some level, we\nmay never find the answer."
    } ]
  }, {
    "tStartMs": 900780,
    "dDurationMs": 3943,
    "segs": [ {
      "utf8": "It may elude us, but at least we tried."
    } ]
  }, {
    "tStartMs": 910830,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "The sponsor of this video, Brilliant,"
    } ]
  }, {
    "tStartMs": 912770,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "is the opposite of dark matter."
    } ]
  }, {
    "tStartMs": 915120,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "You see it everywhere and\nit's highly interactive."
    } ]
  }, {
    "tStartMs": 919060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Brilliant is an innovative\nstem learning platform"
    } ]
  }, {
    "tStartMs": 921670,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "that guides you through engaging,"
    } ]
  }, {
    "tStartMs": 923340,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "hands on courses in math,\nscience, and computer science."
    } ]
  }, {
    "tStartMs": 927080,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "They have great courses on so\nmany topics from pre-algebra"
    } ]
  }, {
    "tStartMs": 930460,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "to probability, to computer\nscience fundamentals."
    } ]
  }, {
    "tStartMs": 933380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's the ideal compliment"
    } ]
  }, {
    "tStartMs": 935300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to watching educational YouTube videos."
    } ]
  }, {
    "tStartMs": 938000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "After learning about a topic,"
    } ]
  }, {
    "tStartMs": 939230,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "you can dive deeper and\nget your hands dirty,"
    } ]
  }, {
    "tStartMs": 941610,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "so you really understand it."
    } ]
  }, {
    "tStartMs": 943600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "For example,"
    } ]
  }, {
    "tStartMs": 944433,
    "dDurationMs": 1757,
    "segs": [ {
      "utf8": "if you wanna learn more about dark matter,"
    } ]
  }, {
    "tStartMs": 946190,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "gravitational lensing,"
    } ]
  }, {
    "tStartMs": 947400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and the cosmic microwave background,"
    } ]
  }, {
    "tStartMs": 949440,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I highly recommend their\nastrophysics course."
    } ]
  }, {
    "tStartMs": 952380,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "A lot of care and attention\ngoes into all their courses."
    } ]
  }, {
    "tStartMs": 955910,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Every lesson and interactive simulation"
    } ]
  }, {
    "tStartMs": 958160,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "builds on what you've learned previously."
    } ]
  }, {
    "tStartMs": 960670,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "And, every step of the way,\nyour knowledge is tested"
    } ]
  }, {
    "tStartMs": 963380,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "through quizzes, which\ncheck your understanding"
    } ]
  }, {
    "tStartMs": 965370,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and reinforce what you've learned."
    } ]
  }, {
    "tStartMs": 967370,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "If you get stuck, there's\nalways a helpful hint."
    } ]
  }, {
    "tStartMs": 970060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, I encourage you to check\nout the courses on offer"
    } ]
  }, {
    "tStartMs": 972880,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "over at brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 975750,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And, I bet you'll find something there"
    } ]
  }, {
    "tStartMs": 977550,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "that you wanna learn more about."
    } ]
  }, {
    "tStartMs": 979280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Plus, if you click through right now,"
    } ]
  }, {
    "tStartMs": 981020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Brilliant are offering 20% off"
    } ]
  }, {
    "tStartMs": 982760,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "an annual premium subscription"
    } ]
  }, {
    "tStartMs": 984280,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "to the first 200 people to sign up."
    } ]
  }, {
    "tStartMs": 986400,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "So, I want to thank Brilliant\nfor supporting Veritasium"
    } ]
  }, {
    "tStartMs": 989090,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
