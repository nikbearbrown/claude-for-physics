    } ]
  }, {
    "tStartMs": 1805520,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Want to follow in the\nfootsteps of Euclid and Bolyai?"
    } ]
  }, {
    "tStartMs": 1809000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Then Brilliant's latest\ncourse, Measurement,"
    } ]
  }, {
    "tStartMs": 1811400,
    "dDurationMs": 3270,
    "segs": [ {
