  }, {
    "tStartMs": 1795620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to programming and technology."
    } ]
  }, {
    "tStartMs": 1797960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "All you have to do is set your goal,"
    } ]
  }, {
    "tStartMs": 1799940,
    "dDurationMs": 2760,
    "segs": [ {
