{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "- When QR codes first came\nout, I thought they were awful,"
    } ]
  }, {
    "tStartMs": 3253,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "never going to catch on."
    } ]
  }, {
    "tStartMs": 4963,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "This is a flow chart from the time"
    } ]
  }, {
    "tStartMs": 6548,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "that really resonated with me."
    } ]
  }, {
    "tStartMs": 9676,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "The problem as I saw it\nwas that QR codes are ugly,"
    } ]
  }, {
    "tStartMs": 13346,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "and they mean nothing to people."
    } ]
  }, {
    "tStartMs": 15515,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "I would rather just see a website"
    } ]
  }, {
    "tStartMs": 17350,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "or a word that I could Google."
    } ]
  }, {
    "tStartMs": 19477,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "QR codes are a language for\nmachines, and I am a human."
    } ]
  }, {
    "tStartMs": 24733,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "But I was wrong."
    } ]
  }, {
    "tStartMs": 26026,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "QR codes obviously turned\nout to be so useful"
    } ]
  }, {
    "tStartMs": 28778,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "that they are now ubiquitous,"
    } ]
  }, {
    "tStartMs": 30655,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "used in everything from tickets"
    } ]
  }, {
    "tStartMs": 32115,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "to restaurant menus and advertising."
    } ]
  }, {
    "tStartMs": 34659,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "In some countries,"
    } ]
  }, {
    "tStartMs": 35744,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "they're the most common\nway to exchange money."
    } ]
  }, {
    "tStartMs": 39164,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And the story of QR codes\nis a very human one."
    } ]
  }, {
    "tStartMs": 42584,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "The origin of these checkerboard\npatterns actually dates"
    } ]
  }, {
    "tStartMs": 45003,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "back to our first efforts\nat digitizing information."
    } ]
  }, {
    "tStartMs": 49841,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "In 1825, there was a renowned painter"
    } ]
  }, {
    "tStartMs": 52469,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "who lived in New Haven, Connecticut,"
    } ]
  }, {
    "tStartMs": 54220,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "with his wife and two kids."
    } ]
  }, {
    "tStartMs": 56264,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "His big break came one\nday when he was invited"
    } ]
  }, {
    "tStartMs": 58516,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "to paint a portrait of\nthe Marquis de Lafayette,"
    } ]
  }, {
    "tStartMs": 60935,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "a hero of the American Revolution."
    } ]
  }, {
    "tStartMs": 63563,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "Even though his wife"
    } ]
  }, {
    "tStartMs": 64522,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "was expecting their third child any day,"
    } ]
  }, {
    "tStartMs": 67025,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "the opportunity was too good to pass up,"
    } ]
  }, {
    "tStartMs": 69611,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "and he hastily set off for Washington DC"
    } ]
  }, {
    "tStartMs": 71946,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "where Lafayette was waiting."
    } ]
  }, {
    "tStartMs": 74616,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "There the painter wrote"
    } ]
  }, {
    "tStartMs": 75867,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "to his wife describing his\nfirst meeting with Lafayette,"
    } ]
  }, {
    "tStartMs": 78912,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "signing off with the words,"
    } ]
  }, {
    "tStartMs": 80330,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "\"Will write again soon."
    } ]
  }, {
    "tStartMs": 81831,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "Love to all the children."
    } ]
  }, {
    "tStartMs": 83208,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "In the greatest haste,"
    } ]
  }, {
    "tStartMs": 84334,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "but with the same ardent\naffection as ever,"
    } ]
  }, {
    "tStartMs": 87003,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "thy loving husband.\""
    } ]
  }, {
    "tStartMs": 88922,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "After a few days with no reply,"
    } ]
  }, {
    "tStartMs": 90924,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "a courier delivered a letter"
    } ]
  }, {
    "tStartMs": 92467,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "which said his wife was\nill after childbirth."
    } ]
  }, {
    "tStartMs": 95887,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Worried, the painter rushed home."
    } ]
  }, {
    "tStartMs": 98473,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "He traveled by horse and\nwagon, day and night,"
    } ]
  }, {
    "tStartMs": 101476,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "managing to arrive back in\nNew Haven in several days."
    } ]
  }, {
    "tStartMs": 104354,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "(melancholic music)"
    } ]
  }, {
    "tStartMs": 106231,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "But it was far too late."
    } ]
  }, {
    "tStartMs": 108942,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "His wife had died."
    } ]
  }, {
    "tStartMs": 110777,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Not only that, he had missed the funeral."
    } ]
  }, {
    "tStartMs": 113822,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Her body was already buried in the ground."
    } ]
  }, {
    "tStartMs": 117075,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "The painter's name was\nSamuel Finley Breese Morse."
    } ]
  }, {
    "tStartMs": 121663,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 122705,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "From that day forward, Morse\nset out to find a faster way"
    } ]
  }, {
    "tStartMs": 125834,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "to communicate over long distances."
    } ]
  }, {
    "tStartMs": 127836,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "He got a job at New York University"
    } ]
  }, {
    "tStartMs": 129587,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "where he attended lectures on electricity,"
    } ]
  }, {
    "tStartMs": 132132,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "a rapidly developing field at the time."
    } ]
  }, {
    "tStartMs": 134801,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "In 1836, along with Joseph\nHenry and Alfred Vail,"
    } ]
  }, {
    "tStartMs": 138054,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "he devised a machine"
    } ]
  }, {
    "tStartMs": 139389,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "that could send electrical\npulses along a wire."
    } ]
  }, {
    "tStartMs": 142725,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "This was not the first electric telegraph,"
    } ]
  }, {
    "tStartMs": 145645,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "but it was the simplest."
    } ]
  }, {
    "tStartMs": 147397,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "In the UK, another team had\nset up a series of circuits"
    } ]
  }, {
    "tStartMs": 150525,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "to move five magnetic needles"
    } ]
  }, {
    "tStartMs": 152652,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "to point at letters and numbers."
    } ]
  }, {
    "tStartMs": 155238,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Morse's system required\nonly a single circuit,"
    } ]
  }, {
    "tStartMs": 158741,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "but the simplicity of the apparatus"
    } ]
  }, {
    "tStartMs": 160827,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "demanded a cleverer method\nof encoding information."
    } ]
  }, {
    "tStartMs": 165915,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "On the circuit, you could\nsend short or long pulses."
    } ]
  }, {
    "tStartMs": 169627,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Morse turned these into dots and dashes."
    } ]
  }, {
    "tStartMs": 173506,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "The most common letters could be sent"
    } ]
  }, {
    "tStartMs": 175300,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "with a single key press,"
    } ]
  }, {
    "tStartMs": 177177,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "a dot for an E and a dash for a T."
    } ]
  }, {
    "tStartMs": 180638,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "The other letters were\narranged by frequency"
    } ]
  }, {
    "tStartMs": 182974,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "and assigned increasingly complex codes."
    } ]
  }, {
    "tStartMs": 187187,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "These symbols were meant to be printed"
    } ]
  }, {
    "tStartMs": 189105,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "at the receiver on a paper strip,"
    } ]
  }, {
    "tStartMs": 191107,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "but operators soon realized"
    } ]
  }, {
    "tStartMs": 192984,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "they could recognize the\nletters just by the sound."
    } ]
  }, {
    "tStartMs": 195820,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "(Morse code beeping)"
    } ]
  }, {
    "tStartMs": 199199,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "This sped up the rate"
    } ]
  }, {
    "tStartMs": 200408,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "at which information could\nbe sent and received,"
    } ]
  }, {
    "tStartMs": 203203,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "so Morse code became an\ninternational standard"
    } ]
  }, {
    "tStartMs": 205914,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "for rapid messaging."
    } ]
  }, {
    "tStartMs": 207290,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "(Morse code rapidly beeping)"
    } ]
  }, {
    "tStartMs": 209209,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Widely used in the military,"
    } ]
  }, {
    "tStartMs": 210877,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "maritime communications, and aviation,"
    } ]
  }, {
    "tStartMs": 214005,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "the universally recognized\ndistress call, SOS,"
    } ]
  }, {
    "tStartMs": 217550,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "what does it stand for?"
    } ]
  }, {
    "tStartMs": 220386,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Nothing, it just happens\nto be easy to send"
    } ]
  }, {
    "tStartMs": 223848,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "and recognize in Morse code."
    } ]
  }, {
    "tStartMs": 226851,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Morse code revolutionized communication,"
    } ]
  }, {
    "tStartMs": 230021,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "but in the next century,"
    } ]
  }, {
    "tStartMs": 231689,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "it would transform a\ntotally different industry."
    } ]
  }, {
    "tStartMs": 236027,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "(mellow jazz music)"
    } ]
  }, {
    "tStartMs": 238446,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "In the late 1940s,"
    } ]
  }, {
    "tStartMs": 239906,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Bernard Silver was an engineering student"
    } ]
  }, {
    "tStartMs": 242075,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "at Drexel University in Pennsylvania."
    } ]
  }, {
    "tStartMs": 244786,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "One day, he overheard the president"
    } ]
  }, {
    "tStartMs": 246746,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "of a local supermarket chain\nasking the engineering dean"
    } ]
  }, {
    "tStartMs": 249582,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "to find a way to speed\nup the checkout process."
    } ]
  }, {
    "tStartMs": 252877,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "At that time, cashiers\nhad to type in each item"
    } ]
  }, {
    "tStartMs": 255505,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "and its price by hand."
    } ]
  }, {
    "tStartMs": 257257,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "A process so tedious and repetitive"
    } ]
  }, {
    "tStartMs": 259550,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "that many cashiers had developed\ncarpal tunnel syndrome."
    } ]
  }, {
    "tStartMs": 262887,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Silver told his friend\nNorman Joseph Woodland"
    } ]
  }, {
    "tStartMs": 265390,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "about the problem,"
    } ]
  }, {
    "tStartMs": 266224,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and together, they began experimenting."
    } ]
  }, {
    "tStartMs": 270561,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "After several false starts,\nWoodland moved down to Florida."
    } ]
  }, {
    "tStartMs": 274649,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "And one day on the beach,"
    } ]
  }, {
    "tStartMs": 276401,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "he drew some dots and dashes\nof Morse code in the sand,"
    } ]
  }, {
    "tStartMs": 280571,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "something he was very\nfamiliar with as a Boy Scout."
    } ]
  }, {
    "tStartMs": 283950,
    "dDurationMs": 4629,
    "segs": [ {
      "utf8": "He recalls, \"I just extended\nthe dots and dashes downwards"
    } ]
  }, {
    "tStartMs": 288579,
    "dDurationMs": 3838,
    "segs": [ {
      "utf8": "and made narrow lines and\nwide lines out of them,\""
    } ]
  }, {
    "tStartMs": 292417,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and thus the first barcode was created."
    } ]
  }, {
    "tStartMs": 295837,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "From this humble beginning,"
    } ]
  }, {
    "tStartMs": 297130,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "evolved the universal\nproduct code or UPC barcode,"
    } ]
  }, {
    "tStartMs": 300508,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "capable of storing a simple\nstring of 12 numbers."
    } ]
  }, {
    "tStartMs": 305513,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "It's read by scanning a laser across it"
    } ]
  }, {
    "tStartMs": 307682,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and checking how much light is reflected"
    } ]
  }, {
    "tStartMs": 309642,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "to read the black and white lines,"
    } ]
  }, {
    "tStartMs": 311978,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "essentially as dots and dashes."
    } ]
  }, {
    "tStartMs": 315356,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "A pair of vertical lines are placed"
    } ]
  }, {
    "tStartMs": 317233,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "at the beginning, middle, and end"
    } ]
  }, {
    "tStartMs": 318943,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "to ensure the scanner\nreads the code properly."
    } ]
  }, {
    "tStartMs": 321988,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "The code is divided into\nleft and right halves."
    } ]
  }, {
    "tStartMs": 324949,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Numbers at either side have their black"
    } ]
  }, {
    "tStartMs": 327118,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "and white lines flipped"
    } ]
  }, {
    "tStartMs": 328369,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "so that the scanner can\ntell left and right apart,"
    } ]
  }, {
    "tStartMs": 330913,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "even while reading upside down."
    } ]
  }, {
    "tStartMs": 333708,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "When viewed upright,"
    } ]
  }, {
    "tStartMs": 334959,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "the numbers typically specify\nthe manufacturer on the left"
    } ]
  }, {
    "tStartMs": 338171,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "and the product on the right."
    } ]
  }, {
    "tStartMs": 340006,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Manufacturers actually\npay large sums of money"
    } ]
  }, {
    "tStartMs": 342592,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "to reserve a given amount\nof numbers to themselves"
    } ]
  }, {
    "tStartMs": 345720,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "so that they can exclusively\nregister their products."
    } ]
  }, {
    "tStartMs": 349140,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "(scanner beeps)"
    } ]
  }, {
    "tStartMs": 350141,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "In this way, the 12 digits\nof a barcode uniquely specify"
    } ]
  }, {
    "tStartMs": 353186,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "every single grocery\nitem you've ever bought."
    } ]
  }, {
    "tStartMs": 356064,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "This jar of Jif peanut butter"
    } ]
  }, {
    "tStartMs": 357482,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "is identified by the same\n12 digits no matter where"
    } ]
  }, {
    "tStartMs": 360193,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "in the world it's found."
    } ]
  }, {
    "tStartMs": 361861,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "And all forms of peanut\nbutter, smooth, crunchy, stir,"
    } ]
  }, {
    "tStartMs": 365490,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "no-stir, sugar-free, low-sodium"
    } ]
  }, {
    "tStartMs": 367450,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "across all brands get\ntheir own unique barcode."
    } ]
  }, {
    "tStartMs": 372205,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "Will we ever run out of barcodes?"
    } ]
  }, {
    "tStartMs": 374540,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "Well, 12 digits could combine\nto provide 10 to the 12,"
    } ]
  }, {
    "tStartMs": 378044,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "that is a trillion different\npossible sequences."
    } ]
  }, {
    "tStartMs": 381464,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "That should be more than enough,"
    } ]
  }, {
    "tStartMs": 382965,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "even if companies keep making\nstuff like Sour Patch Oreos"
    } ]
  }, {
    "tStartMs": 386427,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "and Flaming Hot Mountain Dew."
    } ]
  }, {
    "tStartMs": 390181,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "But there is a catch."
    } ]
  }, {
    "tStartMs": 391182,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "The last digit is not\nindependent of the others."
    } ]
  }, {
    "tStartMs": 395061,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "The barcode creators were aware\nthat it could get scratched,"
    } ]
  }, {
    "tStartMs": 398022,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "stained, or tampered with, so\nthey reserved the last digit"
    } ]
  }, {
    "tStartMs": 401651,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "to verify that the barcode is complete."
    } ]
  }, {
    "tStartMs": 405988,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Take any barcode"
    } ]
  }, {
    "tStartMs": 407156,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "and sum the digits at\nodd-numbered positions,"
    } ]
  }, {
    "tStartMs": 411494,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "multiply this result by three,"
    } ]
  }, {
    "tStartMs": 414372,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "add the digit sum at even-numbered\npositions to the result,"
    } ]
  }, {
    "tStartMs": 418626,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "and take the remainder when\nthis number is divided by 10."
    } ]
  }, {
    "tStartMs": 422296,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "If this remainder is zero,\nthen the check digit is zero."
    } ]
  }, {
    "tStartMs": 425466,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Otherwise, the check digit\nis 10 minus this remainder."
    } ]
  }, {
    "tStartMs": 428886,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "(bright electronic music)"
    } ]
  }, {
    "tStartMs": 430805,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "If a scanner is unable to read\nany one digit of the barcode,"
    } ]
  }, {
    "tStartMs": 434559,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "it can use the final digit"
    } ]
  }, {
    "tStartMs": 436018,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "to back-calculate what it\nmust be using this algorithm."
    } ]
  }, {
    "tStartMs": 441357,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "But if two digits are damaged,\nwell, then we're out of luck."
    } ]
  }, {
    "tStartMs": 444318,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "In that case,"
    } ]
  }, {
    "tStartMs": 445153,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "we have to type in the numbers\nprinted below the barcode."
    } ]
  }, {
    "tStartMs": 448448,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "So without that last digit,"
    } ]
  }, {
    "tStartMs": 449949,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the number of unique\npossibilities is 10 to the 11"
    } ]
  }, {
    "tStartMs": 452952,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "or 100 billion options."
    } ]
  }, {
    "tStartMs": 455580,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "To date, 1.24 billion\nbarcodes have been registered,"
    } ]
  }, {
    "tStartMs": 459500,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "a number that is rising every day,"
    } ]
  }, {
    "tStartMs": 461961,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "so they won't last us forever."
    } ]
  }, {
    "tStartMs": 464046,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "(scanner beeping)"
    } ]
  }, {
    "tStartMs": 466090,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "But that's not why people began"
    } ]
  }, {
    "tStartMs": 467925,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "to look for alternatives to barcodes."
    } ]
  }, {
    "tStartMs": 470386,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "It was really the amount"
    } ]
  }, {
    "tStartMs": 471846,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "of information a single\nbarcode could store."
    } ]
  }, {
    "tStartMs": 474765,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "12 digits by themselves could\nonly identify one product."
    } ]
  }, {
    "tStartMs": 478936,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "But what if someone wanted\nto know more information,"
    } ]
  }, {
    "tStartMs": 481772,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "like where that product came from?"
    } ]
  }, {
    "tStartMs": 484609,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "(brooding music)"
    } ]
  }, {
    "tStartMs": 489489,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "In 1986, cattle in the\nUK began showing symptoms"
    } ]
  }, {
    "tStartMs": 492825,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "of a curious brain disease,"
    } ]
  }, {
    "tStartMs": 494744,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "bovine spongiform encephalopathy,"
    } ]
  }, {
    "tStartMs": 497413,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "or mad cow disease for short."
    } ]
  }, {
    "tStartMs": 499957,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "It is spread"
    } ]
  }, {
    "tStartMs": 500791,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "when cattle ate feed containing\nprions, misfolded proteins,"
    } ]
  }, {
    "tStartMs": 505004,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "and if people ate beef containing tissue"
    } ]
  }, {
    "tStartMs": 507256,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "from the brain or spinal\ncord of infected cattle,"
    } ]
  }, {
    "tStartMs": 509717,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "they could contract a\nrelated brain illness"
    } ]
  }, {
    "tStartMs": 512261,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "that literally turns\nyour brain into a sponge."
    } ]
  }, {
    "tStartMs": 516057,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "Now, as no test could detect\nmad cow disease in living cows,"
    } ]
  }, {
    "tStartMs": 519435,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "millions of cattle were culled."
    } ]
  }, {
    "tStartMs": 521938,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Health officials sought\na method to track sources"
    } ]
  }, {
    "tStartMs": 524398,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "in imports of beef."
    } ]
  }, {
    "tStartMs": 526192,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "But with all the information\nthis would require"
    } ]
  }, {
    "tStartMs": 528361,
    "dDurationMs": 4754,
    "segs": [ {
      "utf8": "for any one piece of beef,\nbarcodes were insufficient."
    } ]
  }, {
    "tStartMs": 533115,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "American inventor David Allais\ntried to solve the problem"
    } ]
  }, {
    "tStartMs": 535868,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "by stacking many barcodes\non top of each other."
    } ]
  }, {
    "tStartMs": 538871,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "The result, Code 49,\nlooked like a bookshelf."
    } ]
  }, {
    "tStartMs": 542708,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "This is actually the\npredecessor of PDF417,"
    } ]
  }, {
    "tStartMs": 545920,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "a code often used on\nairline boarding passes."
    } ]
  }, {
    "tStartMs": 549590,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "But Code 49 didn't solve\nthe data quantity problem."
    } ]
  }, {
    "tStartMs": 553636,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "At best, it multiplied the\ninformation a barcode could carry"
    } ]
  }, {
    "tStartMs": 556305,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "by a handful."
    } ]
  }, {
    "tStartMs": 558182,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "A more efficient way"
    } ]
  }, {
    "tStartMs": 559392,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "was to extend barcodes\ninto two dimensions,"
    } ]
  }, {
    "tStartMs": 562520,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "creating a data matrix."
    } ]
  }, {
    "tStartMs": 564939,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "NASA tried this in 1994 with Vericode,"
    } ]
  }, {
    "tStartMs": 568150,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "used to track and identify\nspace shuttle parts."
    } ]
  }, {
    "tStartMs": 571320,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "This code was read"
    } ]
  }, {
    "tStartMs": 572572,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "by early digital cameras\nrather than lasers"
    } ]
  }, {
    "tStartMs": 575241,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "and was initially proprietary."
    } ]
  }, {
    "tStartMs": 578452,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Around the same time, Masahiro Hara,"
    } ]
  }, {
    "tStartMs": 580454,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "an engineer at a Japanese auto\nparts manufacturer, DENSO,"
    } ]
  }, {
    "tStartMs": 584083,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "was getting frustrated at\nhaving to scan multiple barcodes"
    } ]
  }, {
    "tStartMs": 587044,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "for filling in the same\nbox of car components."
    } ]
  }, {
    "tStartMs": 605521,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "- Hara set out to develop\nan alternative on his own."
    } ]
  }, {
    "tStartMs": 609108,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "He took inspiration\nfrom an unusual source."
    } ]
  }, {
    "tStartMs": 634091,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- To understand how information\nis stored in a QR code,"
    } ]
  }, {
    "tStartMs": 637511,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "I am going to build one myself"
    } ]
  }, {
    "tStartMs": 639764,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "in the way Masahiro Hara\nfirst conceptualized it,"
    } ]
  }, {
    "tStartMs": 643184,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with a Go board."
    } ]
  }, {
    "tStartMs": 644894,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "I have the usual black and white stones."
    } ]
  }, {
    "tStartMs": 647730,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "White represents zero.\nBlack represents one."
    } ]
  }, {
    "tStartMs": 651025,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "And we're going to encode the link"
    } ]
  }, {
    "tStartMs": 653402,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "to our YouTube channel on this board."
    } ]
  }, {
    "tStartMs": 656238,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "So the first step"
    } ]
  }, {
    "tStartMs": 657073,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "is to convert www.youtube.com/veritasium"
    } ]
  }, {
    "tStartMs": 660284,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "into ones and zeros, and we'll\ndo that using byte encoding."
    } ]
  }, {
    "tStartMs": 664580,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "By encoding uses ASCII,"
    } ]
  }, {
    "tStartMs": 666248,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "which itself has roots in Morse code."
    } ]
  }, {
    "tStartMs": 669043,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "Every character is assigned\na number from 1 to 256."
    } ]
  }, {
    "tStartMs": 673756,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "Then we convert the ASCII\ndecimal into its binary form."
    } ]
  }, {
    "tStartMs": 678135,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Since 256 is 2 to the power of 8,"
    } ]
  }, {
    "tStartMs": 680638,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "we can use the eight\nbinary bit combinations"
    } ]
  }, {
    "tStartMs": 683349,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "to represent all ASCII characters."
    } ]
  }, {
    "tStartMs": 685768,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "These eight bits make up\none byte of information."
    } ]
  }, {
    "tStartMs": 689105,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "(upbeat techno music)"
    } ]
  }, {
    "tStartMs": 690856,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "The letter W is assigned\nthe ASCII decimal 119"
    } ]
  }, {
    "tStartMs": 694777,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "or 01110111."
    } ]
  }, {
    "tStartMs": 698656,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Doing the same for all characters"
    } ]
  }, {
    "tStartMs": 700700,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "in www.youtube.com/veritasium,"
    } ]
  }, {
    "tStartMs": 703452,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "this is what the string\nlooks like in binary."
    } ]
  }, {
    "tStartMs": 707623,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "This is 26 characters long,"
    } ]
  }, {
    "tStartMs": 709625,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "so it takes up 26 bytes of information."
    } ]
  }, {
    "tStartMs": 714213,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Now, our board is 25 by 25."
    } ]
  }, {
    "tStartMs": 717091,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "This is known as a version 2 QR code,"
    } ]
  }, {
    "tStartMs": 720010,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "but there are many different sizes,"
    } ]
  }, {
    "tStartMs": 721721,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "all readable by your phone."
    } ]
  }, {
    "tStartMs": 724098,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Hara's version 1 QR code was 21 by 21,"
    } ]
  }, {
    "tStartMs": 727351,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "and the largest version\ntoday is 177 by 177."
    } ]
  }, {
    "tStartMs": 731522,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "That is large enough to hold\nthree kilobytes of information."
    } ]
  }, {
    "tStartMs": 735067,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Just 26 of these would've been enough"
    } ]
  }, {
    "tStartMs": 737278,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "to store all the information\nApollo 11's computer needed"
    } ]
  }, {
    "tStartMs": 740948,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "to send humans to the moon."
    } ]
  }, {
    "tStartMs": 742616,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 744493,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "One programmer (MattKC) even coded\nup a computer game, Snake,"
    } ]
  }, {
    "tStartMs": 748122,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "into a version 40 QR code."
    } ]
  }, {
    "tStartMs": 750541,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 752626,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "The region around a QR code must be empty"
    } ]
  }, {
    "tStartMs": 755212,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "and of uniform color."
    } ]
  }, {
    "tStartMs": 756756,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "This is the quiet zone."
    } ]
  }, {
    "tStartMs": 759216,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "A distinguishing feature of QR codes"
    } ]
  }, {
    "tStartMs": 761093,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "is the three square\npatterns in the corners."
    } ]
  }, {
    "tStartMs": 765014,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "These position squares allow the reader"
    } ]
  }, {
    "tStartMs": 767099,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "to identify the orientation of the code."
    } ]
  }, {
    "tStartMs": 770311,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Now, almost all QR codes\nalso have a fourth square"
    } ]
  }, {
    "tStartMs": 773731,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "in the last corner,"
    } ]
  }, {
    "tStartMs": 775024,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "but it's smaller and,\nhence, trickier to spot."
    } ]
  }, {
    "tStartMs": 778694,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "This is the alignment pattern."
    } ]
  }, {
    "tStartMs": 780696,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "It's used to rescale the QR code"
    } ]
  }, {
    "tStartMs": 782948,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "when it's read from varying distances"
    } ]
  }, {
    "tStartMs": 784992,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "or from crazy oblique angles."
    } ]
  }, {
    "tStartMs": 787453,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "The relative size and distance\nof the alignment square"
    } ]
  }, {
    "tStartMs": 790039,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "with respect to the position\nsquares allows the software"
    } ]
  }, {
    "tStartMs": 792792,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "to rescale it into a proper square."
    } ]
  }, {
    "tStartMs": 796754,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Next to the position squares\nare plain white strips"
    } ]
  }, {
    "tStartMs": 799423,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "that isolate them from\nthe rest of the code."
    } ]
  }, {
    "tStartMs": 802593,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "And these are timing strips,"
    } ]
  }, {
    "tStartMs": 805179,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "zebra pedestrian crossings"
    } ]
  }, {
    "tStartMs": 806931,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "which connect the top left position square"
    } ]
  }, {
    "tStartMs": 809642,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "with the other two."
    } ]
  }, {
    "tStartMs": 811393,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Every QR code has these\nalternating strips."
    } ]
  }, {
    "tStartMs": 814104,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "You should look out for them."
    } ]
  }, {
    "tStartMs": 815773,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "QR codes of all sizes\nvisibly look the same,"
    } ]
  }, {
    "tStartMs": 818609,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "so this tells your phone\nwhich version it is"
    } ]
  }, {
    "tStartMs": 820986,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "and, therefore, how much data to expect."
    } ]
  }, {
    "tStartMs": 823739,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "If there are five alternating\nsquares, it's version one."
    } ]
  }, {
    "tStartMs": 826659,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "If there are nine, it's\nversion two, and so on."
    } ]
  }, {
    "tStartMs": 830079,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "And next to those are format strips"
    } ]
  }, {
    "tStartMs": 832331,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "that contain rules for\nhow to scan the code."
    } ]
  }, {
    "tStartMs": 835209,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "I'm placing red stones in the\nspace they occupy for now."
    } ]
  }, {
    "tStartMs": 839630,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "There is another feature\nevery QR code has."
    } ]
  }, {
    "tStartMs": 842925,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "This one pixel adjacent to the\nbottom right position square,"
    } ]
  }, {
    "tStartMs": 846637,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "it is always dark."
    } ]
  }, {
    "tStartMs": 848472,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "I asked Hara-san if it had\nany special significance,"
    } ]
  }, {
    "tStartMs": 851725,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "but he said no."
    } ]
  }, {
    "tStartMs": 860234,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "All of this remaining\nspace is for data storage."
    } ]
  }, {
    "tStartMs": 863904,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Data inside a QR code always starts"
    } ]
  }, {
    "tStartMs": 866407,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "at the bottom right corner."
    } ]
  }, {
    "tStartMs": 868284,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Here, the first four\nsquares carry four bits"
    } ]
  }, {
    "tStartMs": 871537,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "that specify the data format:"
    } ]
  }, {
    "tStartMs": 873622,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "0001 if it's just numbers;"
    } ]
  }, {
    "tStartMs": 876375,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "0010 if it's alphanumeric, so\ncapital letters and numbers;"
    } ]
  }, {
    "tStartMs": 881672,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "0100 if it's information stored in bytes;"
    } ]
  }, {
    "tStartMs": 885551,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "and 1000 for Japanese kanji."
    } ]
  }, {
    "tStartMs": 890097,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "The following eight bits"
    } ]
  }, {
    "tStartMs": 891515,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "are used to indicate\nthe number of characters"
    } ]
  }, {
    "tStartMs": 893809,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "in our message."
    } ]
  }, {
    "tStartMs": 895185,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "So since we have 26 characters,"
    } ]
  }, {
    "tStartMs": 897730,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "that should be 00011010."
    } ]
  }, {
    "tStartMs": 903736,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Next, we start arranging our bytes"
    } ]
  }, {
    "tStartMs": 905654,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "for youtube.com/veritasium"
    } ]
  }, {
    "tStartMs": 907740,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "starting in eight-bit, two-column cells;."
    } ]
  }, {
    "tStartMs": 910659,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "They follow a zigzag pattern"
    } ]
  }, {
    "tStartMs": 912578,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "that snakes its way to the top left."
    } ]
  }, {
    "tStartMs": 915331,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Within each cell that represents a byte,"
    } ]
  }, {
    "tStartMs": 917291,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "the most significant bit,"
    } ]
  }, {
    "tStartMs": 918667,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "corresponding to two to the\nseven, is at the bottom right."
    } ]
  }, {
    "tStartMs": 921629,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "And the least significant,\nor two to the zero,"
    } ]
  }, {
    "tStartMs": 924006,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "is at the opposite end."
    } ]
  }, {
    "tStartMs": 925883,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "01110111 for w"
    } ]
  }, {
    "tStartMs": 929386,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "will hence be filled like this."
    } ]
  }, {
    "tStartMs": 933057,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "And we'll follow along with the rest."
    } ]
  }, {
    "tStartMs": 935684,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Once we fill in the bytes for www.you,"
    } ]
  }, {
    "tStartMs": 938562,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "we encounter the alignment\npattern after four bits."
    } ]
  }, {
    "tStartMs": 942900,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "To put in the next T, we simply\nbypass it and do the same"
    } ]
  }, {
    "tStartMs": 947279,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "for any of the other\nfixed regions of the code."
    } ]
  }, {
    "tStartMs": 950741,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Thus, we keep filling in our data"
    } ]
  }, {
    "tStartMs": 952868,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "in the same zigzag pattern."
    } ]
  }, {
    "tStartMs": 955663,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "After we complete www.youtube.c,"
    } ]
  }, {
    "tStartMs": 958749,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "the cells start looking less\nregular and more Tetris-like."
    } ]
  }, {
    "tStartMs": 962378,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "But the way we put the stones byte"
    } ]
  }, {
    "tStartMs": 964380,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "after byte remains the same."
    } ]
  }, {
    "tStartMs": 967174,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "(hopeful music)"
    } ]
  }, {
    "tStartMs": 974431,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "And there go the last eight\nbits for the last letter M."
    } ]
  }, {
    "tStartMs": 978894,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "But wait a minute,"
    } ]
  }, {
    "tStartMs": 979812,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "we've only covered about\nhalf of our QR code."
    } ]
  }, {
    "tStartMs": 983065,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Well, that's because this\nwhole remaining space"
    } ]
  }, {
    "tStartMs": 985776,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "is reserved for redundancy."
    } ]
  }, {
    "tStartMs": 988237,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "These extra bytes of\nerror-correction code allow us"
    } ]
  }, {
    "tStartMs": 991365,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to reconstruct information\nif the QR code is damaged."
    } ]
  }, {
    "tStartMs": 995828,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "(menu whooshing)"
    } ]
  }, {
    "tStartMs": 997663,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "For a fully intact QR code,"
    } ]
  }, {
    "tStartMs": 999915,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "error correction makes\nsomething else possible,"
    } ]
  }, {
    "tStartMs": 1002501,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "putting a company logo at the center,"
    } ]
  }, {
    "tStartMs": 1005212,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "just like the sponsor\nof this video, Saily."
    } ]
  }, {
    "tStartMs": 1008340,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Now, I travel a lot."
    } ]
  }, {
    "tStartMs": 1009883,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Recently, I was in Germany."
    } ]
  }, {
    "tStartMs": 1011301,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Right now, I'm in Australia,"
    } ]
  }, {
    "tStartMs": 1012511,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and soon, I'm going to the UK."
    } ]
  }, {
    "tStartMs": 1014638,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "But wherever you are, you\nneed to have a working phone."
    } ]
  }, {
    "tStartMs": 1018225,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Either you pay your home\ncarrier's hefty roaming fees,"
    } ]
  }, {
    "tStartMs": 1021520,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "or you have to find a place\nto buy a local SIM card,"
    } ]
  }, {
    "tStartMs": 1024106,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "put it in the phone, and hope it works."
    } ]
  }, {
    "tStartMs": 1026275,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "This video's sponsor Saily makes it easy"
    } ]
  }, {
    "tStartMs": 1028986,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to set up a cell plan and data\nin more than 150 countries."
    } ]
  }, {
    "tStartMs": 1032906,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "You can pick how much data you want"
    } ]
  }, {
    "tStartMs": 1034575,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "and how long you want it for."
    } ]
  }, {
    "tStartMs": 1036785,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "And it is so much cheaper than roaming."
    } ]
  }, {
    "tStartMs": 1039663,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I'm actually going to the UK really soon,"
    } ]
  }, {
    "tStartMs": 1041373,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "and here's how quickly I can\nset up an e-SIM with Saily."
    } ]
  }, {
    "tStartMs": 1044877,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "All I have to do is click on the country,"
    } ]
  }, {
    "tStartMs": 1047337,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "select a plan, and activate the e-SIM."
    } ]
  }, {
    "tStartMs": 1050299,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Then when I land, I'll\nautomatically connect"
    } ]
  }, {
    "tStartMs": 1052342,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "to a local network with no hidden charges."
    } ]
  }, {
    "tStartMs": 1055554,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "That's it. There's no need\nto hunt for public wifi."
    } ]
  }, {
    "tStartMs": 1058474,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "And you don't have to stand in line"
    } ]
  }, {
    "tStartMs": 1060309,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "at the airport to get a physical SIM."
    } ]
  }, {
    "tStartMs": 1062644,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "With Saily, you set it up once,"
    } ]
  }, {
    "tStartMs": 1064605,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "and you'll always be connected."
    } ]
  }, {
    "tStartMs": 1066148,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "And if you find out that your phone"
    } ]
  }, {
    "tStartMs": 1067733,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "isn't compatible with e-SIMs,\nyou will get a full refund."
    } ]
  }, {
    "tStartMs": 1071403,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "So to check out Saily for free,\ngo to Saily.com/veritasium"
    } ]
  }, {
    "tStartMs": 1075240,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "or click the link in the description."
    } ]
  }, {
    "tStartMs": 1077576,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "Use the code VERITASIUM"
    } ]
  }, {
    "tStartMs": 1079078,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "to get an exclusive 15%\noff your first purchase."
    } ]
  }, {
    "tStartMs": 1082706,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "That's Saily.com/veritasium,"
    } ]
  }, {
    "tStartMs": 1085459,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "or you can scan this handy\nQR code to get 15% off."
    } ]
  }, {
    "tStartMs": 1089379,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "So I wanna thank Saily"
    } ]
  }, {
    "tStartMs": 1090506,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "for sponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 1092091,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "and now back to building our own QR code."
    } ]
  }, {
    "tStartMs": 1094802,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "(playful music)"
    } ]
  }, {
    "tStartMs": 1096720,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "QR codes offer four levels\nof error correction:"
    } ]
  }, {
    "tStartMs": 1100015,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "low, which can still be read\nwith 7% of the code missing;"
    } ]
  }, {
    "tStartMs": 1103560,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "medium, which can handle 14%;"
    } ]
  }, {
    "tStartMs": 1106230,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "quartile, 25%; and high, up to 30%."
    } ]
  }, {
    "tStartMs": 1111026,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "This means a QR code could\nstill be read properly,"
    } ]
  }, {
    "tStartMs": 1114029,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "even with nearly 1/3 of it missing."
    } ]
  }, {
    "tStartMs": 1117241,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Higher levels require more\nspace for error correction."
    } ]
  }, {
    "tStartMs": 1121078,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "So knowing how much"
    } ]
  }, {
    "tStartMs": 1122996,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "of the code is error correction is vital."
    } ]
  }, {
    "tStartMs": 1125833,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "This information is protected in two ways."
    } ]
  }, {
    "tStartMs": 1129419,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "First, the level of error correction"
    } ]
  }, {
    "tStartMs": 1131463,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "is indicated in the format strip,"
    } ]
  }, {
    "tStartMs": 1133715,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "which is present\nidentically in two places."
    } ]
  }, {
    "tStartMs": 1138137,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "The simplest way to avoid errors"
    } ]
  }, {
    "tStartMs": 1140013,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "is to duplicate the information."
    } ]
  }, {
    "tStartMs": 1142266,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "Here we'll choose the M\nlevel by placing one blue"
    } ]
  }, {
    "tStartMs": 1145894,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "and one yellow stone here at the top left."
    } ]
  }, {
    "tStartMs": 1148856,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "So what if this part gets damaged?"
    } ]
  }, {
    "tStartMs": 1151608,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "We have a copy in the second format strip"
    } ]
  }, {
    "tStartMs": 1154111,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "starting at the bottom left."
    } ]
  }, {
    "tStartMs": 1156363,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "The format strip contains three more bits"
    } ]
  }, {
    "tStartMs": 1158365,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "of important information\nthat we'll get to later."
    } ]
  }, {
    "tStartMs": 1161201,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "So for now, I'm just gonna\nput down three blue stones"
    } ]
  }, {
    "tStartMs": 1164454,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "in both copies."
    } ]
  }, {
    "tStartMs": 1166915,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "But what about all the\nrest of the format strip?"
    } ]
  }, {
    "tStartMs": 1170252,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Well, this is the second\nlayer of protection."
    } ]
  }, {
    "tStartMs": 1173297,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "These other 10 bits are all just designed"
    } ]
  }, {
    "tStartMs": 1175591,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "to correct mistakes in\nthe first five bits."
    } ]
  }, {
    "tStartMs": 1178886,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "So how does this work?"
    } ]
  }, {
    "tStartMs": 1180721,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Let's say I only wanted\nto communicate two levels"
    } ]
  }, {
    "tStartMs": 1184016,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "of error correction to you, low or high."
    } ]
  }, {
    "tStartMs": 1188645,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "If one of the bits flips in transmission"
    } ]
  }, {
    "tStartMs": 1190981,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "to 01 or 10, it's easy to know\nthat an error has occurred,"
    } ]
  }, {
    "tStartMs": 1195152,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "but no way to know which\nthe original message was."
    } ]
  }, {
    "tStartMs": 1198906,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "An easy way to fix this\nis to add another bit."
    } ]
  }, {
    "tStartMs": 1201533,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "So 000 for low, 111 for high."
    } ]
  }, {
    "tStartMs": 1205412,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Now, these are at opposite ends of a cube,"
    } ]
  }, {
    "tStartMs": 1207956,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and hence, they are further apart."
    } ]
  }, {
    "tStartMs": 1210667,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "If you then receive 011,"
    } ]
  }, {
    "tStartMs": 1212711,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "it's more likely that the\nintended message was 111,"
    } ]
  }, {
    "tStartMs": 1215839,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "so it's easy to correct."
    } ]
  }, {
    "tStartMs": 1218175,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "In this scheme, the\nonly allowed code words"
    } ]
  }, {
    "tStartMs": 1220761,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "are 000 and 111."
    } ]
  }, {
    "tStartMs": 1223555,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "The rest act as disallowed buffers"
    } ]
  }, {
    "tStartMs": 1226141,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "to indicate errors in transmission."
    } ]
  }, {
    "tStartMs": 1229019,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "The allowed code words should\nbe as far apart as possible."
    } ]
  }, {
    "tStartMs": 1234566,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Here, they are three vertices apart."
    } ]
  }, {
    "tStartMs": 1238528,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "This is known as the Hamming distance,"
    } ]
  }, {
    "tStartMs": 1240656,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "after Richard Hamming"
    } ]
  }, {
    "tStartMs": 1242074,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "who pioneered the field\nof error correction."
    } ]
  }, {
    "tStartMs": 1245994,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "For a Hamming distance of N,"
    } ]
  }, {
    "tStartMs": 1247621,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "you can correct up to N - 1 over 2 errors"
    } ]
  }, {
    "tStartMs": 1250707,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "in a binary string,"
    } ]
  }, {
    "tStartMs": 1252000,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "so one bit flip in the previous example."
    } ]
  }, {
    "tStartMs": 1256129,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "So back to the five bits\nof our format string."
    } ]
  }, {
    "tStartMs": 1259174,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "If I only wanted to communicate\nall zeros or all ones,"
    } ]
  }, {
    "tStartMs": 1262469,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "I could place them at opposite corners"
    } ]
  }, {
    "tStartMs": 1264513,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "of a five-dimensional hypercube."
    } ]
  }, {
    "tStartMs": 1267599,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "However, our string includes\nall 2 to the 5, or 32,"
    } ]
  }, {
    "tStartMs": 1271478,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "combinations of ones and\nzeros as valid code words."
    } ]
  }, {
    "tStartMs": 1275065,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "So to provide buffers like before,"
    } ]
  }, {
    "tStartMs": 1277150,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "we can extend the 5-bit\nstring into a 15-bit string."
    } ]
  }, {
    "tStartMs": 1281822,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "And now the 32 valid code words"
    } ]
  }, {
    "tStartMs": 1283824,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "are each separated by seven vertices,"
    } ]
  }, {
    "tStartMs": 1286076,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "or a Hamming distance of seven,"
    } ]
  }, {
    "tStartMs": 1288120,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "which means we can correct\nup to three bit flip errors."
    } ]
  }, {
    "tStartMs": 1293458,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "The easiest way to do this\nis using a lookup table."
    } ]
  }, {
    "tStartMs": 1296837,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "The table takes a slightly misread vertex"
    } ]
  }, {
    "tStartMs": 1299589,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "and finds the closest valid vertex,"
    } ]
  }, {
    "tStartMs": 1302342,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "likely the intended code word."
    } ]
  }, {
    "tStartMs": 1306847,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "But for our main QR code data,"
    } ]
  }, {
    "tStartMs": 1308849,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "we need a far more efficient scheme,"
    } ]
  }, {
    "tStartMs": 1310976,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "one that doesn't require lookup tables"
    } ]
  }, {
    "tStartMs": 1312811,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "or doubling or tripling our data size."
    } ]
  }, {
    "tStartMs": 1315147,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1316815,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Let's say I wanna send you a message"
    } ]
  }, {
    "tStartMs": 1318734,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "that is the four numbers 1, -2, 3 and 5."
    } ]
  }, {
    "tStartMs": 1323655,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "If I just send these numbers,"
    } ]
  }, {
    "tStartMs": 1325365,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "one of them could get\ncorrupted in transmission,"
    } ]
  }, {
    "tStartMs": 1327909,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "and you wouldn't know\nthat an error had occurred"
    } ]
  }, {
    "tStartMs": 1330454,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "or which digit was wrong."
    } ]
  }, {
    "tStartMs": 1332789,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "So before I send the message,\nwe come up with a plan."
    } ]
  }, {
    "tStartMs": 1336877,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "First, instead of sending you\nfour numbers, I will send six."
    } ]
  }, {
    "tStartMs": 1340922,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "The first four are my actual message,"
    } ]
  }, {
    "tStartMs": 1343091,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and the last two, A and B,"
    } ]
  }, {
    "tStartMs": 1345385,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "will help you check if\nthere were any errors."
    } ]
  }, {
    "tStartMs": 1348221,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "Now, I want you to treat these six numbers"
    } ]
  }, {
    "tStartMs": 1350557,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "as the coefficients of a\ndegree-five polynomial,"
    } ]
  }, {
    "tStartMs": 1353810,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and I will pick the values of A and B"
    } ]
  }, {
    "tStartMs": 1356104,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "so that this polynomial\ncould also be written"
    } ]
  }, {
    "tStartMs": 1358982,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "in the form of a degree-three\npolynomial, call it q of x,"
    } ]
  }, {
    "tStartMs": 1362819,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "times (x - 1)(x - 2)."
    } ]
  }, {
    "tStartMs": 1366865,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Now, we could set these last two terms"
    } ]
  }, {
    "tStartMs": 1368408,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "to be x minus any number,"
    } ]
  }, {
    "tStartMs": 1370202,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "but for simplicity, let's\nsay we pick one and two."
    } ]
  }, {
    "tStartMs": 1375082,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "That way, when you receive my polynomial,"
    } ]
  }, {
    "tStartMs": 1377125,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "you know that if you\nplug in x = 1 or x = 2,"
    } ]
  }, {
    "tStartMs": 1380379,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "you should get zero for both"
    } ]
  }, {
    "tStartMs": 1382464,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "because that's how I\nconstructed the polynomial."
    } ]
  }, {
    "tStartMs": 1385258,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "And if you don't get zero,"
    } ]
  }, {
    "tStartMs": 1386551,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "you know there has been\nan error in transmission."
    } ]
  }, {
    "tStartMs": 1389596,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "They are called syndromes."
    } ]
  }, {
    "tStartMs": 1392557,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Which is an apt term since syndromes are defined as"
    } ]
  }, {
    "tStartMs": 1395685,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "a group of signs that occur together and characterize"
    } ]
  }, {
    "tStartMs": 1398188,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "a particular abnormality."
    } ]
  }, {
    "tStartMs": 1400148,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "If the message polynomial is not 0 at any of the syndrome values"
    } ]
  }, {
    "tStartMs": 1403944,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "then there is an error in the code."
    } ]
  }, {
    "tStartMs": 1407614,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "So how do I find the values\nof 'a' and 'b' in our example?"
    } ]
  }, {
    "tStartMs": 1411868,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Well, I take the\npolynomial without 'a' and 'b'"
    } ]
  }, {
    "tStartMs": 1414663,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "and divide it by x - 1, x - 2."
    } ]
  }, {
    "tStartMs": 1417707,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "I get a degree-three polynomial,"
    } ]
  }, {
    "tStartMs": 1419626,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "which is what I want, but\nthere is also a remainder"
    } ]
  }, {
    "tStartMs": 1423213,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "of 37x - 30."
    } ]
  }, {
    "tStartMs": 1425882,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "So I can move this to the left-hand side."
    } ]
  }, {
    "tStartMs": 1428927,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "For the polynomial\nto take the form I want,"
    } ]
  }, {
    "tStartMs": 1431930,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "'a' must be negative 37 and 'b' positive 30."
    } ]
  }, {
    "tStartMs": 1435851,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "So I send the message 1, -2, 3, 5,"
    } ]
  }, {
    "tStartMs": 1439980,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "- 37, and 30."
    } ]
  }, {
    "tStartMs": 1442482,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "You can plug in x = 1 and x = 2,"
    } ]
  }, {
    "tStartMs": 1445610,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "and if you get zero for both,"
    } ]
  }, {
    "tStartMs": 1447362,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "you know the message was sent correctly."
    } ]
  }, {
    "tStartMs": 1450198,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "But what if there was an\nerror in transmission?"
    } ]
  }, {
    "tStartMs": 1453160,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "Say at position four, the\nnumber has changed to a six."
    } ]
  }, {
    "tStartMs": 1456746,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Well, now if you evaluate at x = 1 and 2,"
    } ]
  }, {
    "tStartMs": 1460083,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "the polynomial is no longer zero."
    } ]
  }, {
    "tStartMs": 1463795,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "To figure out where the error occurred,"
    } ]
  }, {
    "tStartMs": 1465922,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "one at a time, you set each\ncoefficient to be a variable."
    } ]
  }, {
    "tStartMs": 1469926,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Then find the value of that variable,"
    } ]
  }, {
    "tStartMs": 1472137,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "setting the polynomial\nequal to 0 at x = 1."
    } ]
  }, {
    "tStartMs": 1475891,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "You repeat this for x = 2."
    } ]
  }, {
    "tStartMs": 1478685,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "And what you find is that\nthe two values are different."
    } ]
  }, {
    "tStartMs": 1482189,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "This indicates that the second coefficient"
    } ]
  }, {
    "tStartMs": 1484191,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "was not the error."
    } ]
  }, {
    "tStartMs": 1486193,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "You find the same for all\nthe other coefficients,"
    } ]
  }, {
    "tStartMs": 1488737,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "except when you reach the\none where the error occurred."
    } ]
  }, {
    "tStartMs": 1492157,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Here, not only are the two values equal,"
    } ]
  }, {
    "tStartMs": 1494576,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "they're also equal to the\noriginally transmitted number."
    } ]
  }, {
    "tStartMs": 1497537,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "That is, five."
    } ]
  }, {
    "tStartMs": 1499456,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "So this method allows us both to check"
    } ]
  }, {
    "tStartMs": 1501958,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "and correct errors with only a\nmodest increase in data size."
    } ]
  }, {
    "tStartMs": 1506546,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "(inquisitive music)"
    } ]
  }, {
    "tStartMs": 1510509,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "This is a toy example"
    } ]
  }, {
    "tStartMs": 1511968,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "of a Reed-Solomon error correcting code,"
    } ]
  }, {
    "tStartMs": 1514387,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "developed by mathematicians Irving S. Reed"
    } ]
  }, {
    "tStartMs": 1516556,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "and Gustav Solomon in 1960."
    } ]
  }, {
    "tStartMs": 1519643,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 1523146,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "(QR code whooshing)"
    } ]
  }, {
    "tStartMs": 1526983,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "The job of decoding Reed-Solomon\ncodes in a brute-force way,"
    } ]
  }, {
    "tStartMs": 1530278,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "as we described, can\nquickly get intensive."
    } ]
  }, {
    "tStartMs": 1533865,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "In fact, as the Voyager spacecraft floated"
    } ]
  }, {
    "tStartMs": 1536326,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "into the outer solar system,"
    } ]
  }, {
    "tStartMs": 1537786,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "NASA engineers knew their\nsignal-to-noise ratio"
    } ]
  }, {
    "tStartMs": 1540413,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "would get incredibly small."
    } ]
  }, {
    "tStartMs": 1542415,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "But the promise of\nReed-Solomon codes was such"
    } ]
  }, {
    "tStartMs": 1545126,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "that they put an experimental\nencoder in before launch,"
    } ]
  }, {
    "tStartMs": 1548505,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "wagering that that smarter\nencoding algorithms"
    } ]
  }, {
    "tStartMs": 1550632,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "would follow in the next decade."
    } ]
  }, {
    "tStartMs": 1552842,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "And that's exactly what happened."
    } ]
  }, {
    "tStartMs": 1555262,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "To this day,"
    } ]
  }, {
    "tStartMs": 1556096,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "we can make out Voyager's\never-faintening whispers,"
    } ]
  }, {
    "tStartMs": 1558974,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "thanks to Reed-Solomon codes."
    } ]
  }, {
    "tStartMs": 1561309,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "These codes also ensure that your old CDs"
    } ]
  }, {
    "tStartMs": 1563603,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "or DVDs can still play your favorite songs"
    } ]
  }, {
    "tStartMs": 1565939,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and movies despite multiple scratches."
    } ]
  }, {
    "tStartMs": 1569568,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "And they are the reason"
    } ]
  }, {
    "tStartMs": 1570944,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "why QR codes still work when damaged."
    } ]
  }, {
    "tStartMs": 1573822,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "In a QR code, the entire data,"
    } ]
  }, {
    "tStartMs": 1576157,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "starting from the data\ntype, character length byte,"
    } ]
  }, {
    "tStartMs": 1579286,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "our message bytes, and final padding,"
    } ]
  }, {
    "tStartMs": 1581371,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "are laid out in a line"
    } ]
  }, {
    "tStartMs": 1582831,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "and converted back into ASCII decimals."
    } ]
  }, {
    "tStartMs": 1585542,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Fitting a high-degree\npolynomial using these"
    } ]
  }, {
    "tStartMs": 1587836,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "can easily make the coefficients blow up."
    } ]
  }, {
    "tStartMs": 1590922,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "Hence, Reed-Solomon encoding\nuses finite-field arithmetic,"
    } ]
  }, {
    "tStartMs": 1594593,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Galois fields, to obtain\nthe error correcting terms."
    } ]
  }, {
    "tStartMs": 1598138,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "These, converted back into binary,"
    } ]
  }, {
    "tStartMs": 1599806,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "are used to fill out\nthe rest of the QR code."
    } ]
  }, {
    "tStartMs": 1603226,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1610400,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "And there we have our complete QR code."
    } ]
  }, {
    "tStartMs": 1613737,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "But why can't we scan it yet?"
    } ]
  }, {
    "tStartMs": 1616406,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "See how these regions here\nappear uniformly white and black?"
    } ]
  }, {
    "tStartMs": 1621578,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "Well, sometimes the encoded\ndata can insert plain patterns"
    } ]
  }, {
    "tStartMs": 1625206,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "and blank spaces just by chance."
    } ]
  }, {
    "tStartMs": 1627709,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "These can confound the readers"
    } ]
  }, {
    "tStartMs": 1629336,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "which expect to see a noisy checkerboard."
    } ]
  }, {
    "tStartMs": 1631880,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "They think maybe it's a big damage patch,"
    } ]
  }, {
    "tStartMs": 1634007,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "or maybe it's not a QR code at all."
    } ]
  }, {
    "tStartMs": 1636509,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "But there is a way to fix this."
    } ]
  }, {
    "tStartMs": 1638386,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Remember the three blue stones I put in"
    } ]
  }, {
    "tStartMs": 1640305,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "for masking in the format string?"
    } ]
  }, {
    "tStartMs": 1642724,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "Well, they specify one of eight ways"
    } ]
  }, {
    "tStartMs": 1645060,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "to reshuffle the appearance\nof our QR code pixels"
    } ]
  }, {
    "tStartMs": 1648647,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "to make them seem truly jumbled."
    } ]
  }, {
    "tStartMs": 1651483,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Now, this particular mask says,"
    } ]
  }, {
    "tStartMs": 1653610,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "flip the pixels so white becomes black"
    } ]
  }, {
    "tStartMs": 1656237,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "and black becomes white for\nevery third column of data."
    } ]
  }, {
    "tStartMs": 1661159,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "But this does not apply"
    } ]
  }, {
    "tStartMs": 1662952,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "to the functional elements of the code."
    } ]
  }, {
    "tStartMs": 1664621,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "They remain unchanged."
    } ]
  }, {
    "tStartMs": 1666581,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "(bars whooshing)"
    } ]
  }, {
    "tStartMs": 1669959,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "(QR code beeping)"
    } ]
  }, {
    "tStartMs": 1673880,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "The QR code standard specifies the use"
    } ]
  }, {
    "tStartMs": 1676007,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "of eight masking patterns."
    } ]
  }, {
    "tStartMs": 1677884,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "In principle, when combined\nwith the correct masking bits,"
    } ]
  }, {
    "tStartMs": 1680929,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "all eight forms of the code are readable,"
    } ]
  }, {
    "tStartMs": 1683515,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "which is why some QR code generators"
    } ]
  }, {
    "tStartMs": 1685684,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "will return different looking codes"
    } ]
  }, {
    "tStartMs": 1687477,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "for the same input string."
    } ]
  }, {
    "tStartMs": 1689604,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "But which one works best?"
    } ]
  }, {
    "tStartMs": 1691981,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Well, every continuous\nor bad patch adds points,"
    } ]
  }, {
    "tStartMs": 1696194,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "and each mask gets assigned a score."
    } ]
  }, {
    "tStartMs": 1698780,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "The mask with the lowest\nscore at the end wins."
    } ]
  }, {
    "tStartMs": 1702826,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "It's easiest for any reader to scan."
    } ]
  }, {
    "tStartMs": 1705745,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "(confetti cannon pops)"
    } ]
  }, {
    "tStartMs": 1707789,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "(audience applauds)"
    } ]
  }, {
    "tStartMs": 1709207,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "For our handmade QR code,"
    } ]
  }, {
    "tStartMs": 1711000,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "I'm going to use the simplest mask."
    } ]
  }, {
    "tStartMs": 1714671,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "And now we have a working QR code."
    } ]
  }, {
    "tStartMs": 1718007,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Try it out."
    } ]
  }, {
    "tStartMs": 1718967,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1722387,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "And moment of truth."
    } ]
  }, {
    "tStartMs": 1726516,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "- Ahh, it worked."
    } ]
  }, {
    "tStartMs": 1728810,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "You know, going through this\nexercise made me realize again"
    } ]
  }, {
    "tStartMs": 1731229,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "why I hate QR codes."
    } ]
  }, {
    "tStartMs": 1732897,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "They're not meant for people."
    } ]
  }, {
    "tStartMs": 1734441,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "I made all kinds of mistakes"
    } ]
  }, {
    "tStartMs": 1735942,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "while I was trying to put down\nthese black and white stones."
    } ]
  }, {
    "tStartMs": 1738778,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "This was really hard to get this perfect."
    } ]
  }, {
    "tStartMs": 1742490,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "I guess it didn't have to be perfect,"
    } ]
  }, {
    "tStartMs": 1743575,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "but it had to be close enough, all right."
    } ]
  }, {
    "tStartMs": 1746202,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Initially, QR codes had\nonly industrial uses."
    } ]
  }, {
    "tStartMs": 1764679,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But it wasn't long before the value"
    } ]
  }, {
    "tStartMs": 1766139,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "of their data storage\ncapacity was realized."
    } ]
  }, {
    "tStartMs": 1768725,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "In 2002, mad cow disease\nresurfaced in the UK."
    } ]
  }, {
    "tStartMs": 1772812,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "179 people died from\neating contaminated beef,"
    } ]
  }, {
    "tStartMs": 1776775,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "and people panicked."
    } ]
  }, {
    "tStartMs": 1778276,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "They wanted to know exactly\nwhere their meat was coming from"
    } ]
  }, {
    "tStartMs": 1780945,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "and how it was stored before\nit reached the supermarket."
    } ]
  }, {
    "tStartMs": 1784157,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "This time, the QR code\nwas available to help."
    } ]
  }, {
    "tStartMs": 1787243,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "It was one of the first instances"
    } ]
  }, {
    "tStartMs": 1788870,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "where the curious checkerboards started"
    } ]
  }, {
    "tStartMs": 1790789,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "to appear in common use."
    } ]
  }, {
    "tStartMs": 1793374,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "But why are QR codes so successful?"
    } ]
  }, {
    "tStartMs": 1795919,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "There are plenty of other\n2D matrix codes out there."
    } ]
  }, {
    "tStartMs": 1799214,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Well, one reason is that\nDENSO Wave decided not"
    } ]
  }, {
    "tStartMs": 1801925,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "to exercise patent rights on QR codes."
    } ]
  }, {
    "tStartMs": 1818016,
    "dDurationMs": 5465,
    "segs": [ {
      "utf8": "We made the patent open to everyone, which made the QR code so popular."
    } ]
  }, {
    "tStartMs": 1828409,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "DENSO instead opted to monetize\nand sell QR code scanners."
    } ]
  }, {
    "tStartMs": 1833331,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Of course, with the rise of smartphones,"
    } ]
  }, {
    "tStartMs": 1834916,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "most people would soon\ncarry a QR code scanner"
    } ]
  }, {
    "tStartMs": 1837377,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "in their pocket."
    } ]
  }, {
    "tStartMs": 1838586,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "But initially, QR code reading apps"
    } ]
  }, {
    "tStartMs": 1840630,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "were third-party and rather niche."
    } ]
  }, {
    "tStartMs": 1842966,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "But then in 2017,"
    } ]
  }, {
    "tStartMs": 1845009,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "Android and Apple built\nQR code readers right"
    } ]
  }, {
    "tStartMs": 1847637,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "into their camera apps,"
    } ]
  }, {
    "tStartMs": 1849264,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "so the use of these codes took off."
    } ]
  }, {
    "tStartMs": 1852016,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "The COVID-19 pandemic also gave\nQR codes a boost worldwide."
    } ]
  }, {
    "tStartMs": 1856062,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Suddenly, restaurants and\nvendors wanted a contactless way"
    } ]
  }, {
    "tStartMs": 1858857,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "to hand out menus and product information."
    } ]
  }, {
    "tStartMs": 1861609,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Contactless payment\nusing QR codes took off"
    } ]
  }, {
    "tStartMs": 1864028,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "in India and China."
    } ]
  }, {
    "tStartMs": 1865572,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "Today, India sees"
    } ]
  }, {
    "tStartMs": 1866656,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "over 12 billion QR code-enabled\ntransactions per month."
    } ]
  }, {
    "tStartMs": 1870618,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "QR codes also proved handy\nin storing vaccine records"
    } ]
  }, {
    "tStartMs": 1873872,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "and personal health\ninformation in phone wallets."
    } ]
  }, {
    "tStartMs": 1877333,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "But their enormous spread\nhas also created problems."
    } ]
  }, {
    "tStartMs": 1880712,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "A question about QR code safety:"
    } ]
  }, {
    "tStartMs": 1883965,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "In recent years, some\nscammers have used QR codes"
    } ]
  }, {
    "tStartMs": 1887302,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "to try to defraud people who read them."
    } ]
  }, {
    "tStartMs": 1891097,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Do you have concerns about these uses?"
    } ]
  }, {
    "tStartMs": 1934724,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "So as with anything on the internet,"
    } ]
  }, {
    "tStartMs": 1936351,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "you have to pay extra attention to safety."
    } ]
  }, {
    "tStartMs": 1939228,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Check where a scanned\nQR code is taking you"
    } ]
  }, {
    "tStartMs": 1941731,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "before actually clicking on a link."
    } ]
  }, {
    "tStartMs": 1944108,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "So I wanna know about\nthe future of QR codes."
    } ]
  }, {
    "tStartMs": 1947987,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "What is next for QR codes?"
    } ]
  }, {
    "tStartMs": 2009132,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Now, if the possibility"
    } ]
  }, {
    "tStartMs": 2010425,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "of running out of UPC barcodes is remote,"
    } ]
  }, {
    "tStartMs": 2012844,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "for QR codes, it is impossible."
    } ]
  }, {
    "tStartMs": 2016472,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "The number of unique version 1 QR codes"
    } ]
  }, {
    "tStartMs": 2018933,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "using the lowest redundancy\nlevel is 2 to the 152."
    } ]
  }, {
    "tStartMs": 2024230,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "This is about 10 times the total number"
    } ]
  }, {
    "tStartMs": 2026441,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "of legal chessboard configurations,"
    } ]
  }, {
    "tStartMs": 2029318,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "which is also why a random distribution"
    } ]
  }, {
    "tStartMs": 2031571,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "of pixels filled into a QR code pattern"
    } ]
  }, {
    "tStartMs": 2033906,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "generally cannot be\ninterpreted as a message."
    } ]
  }, {
    "tStartMs": 2038202,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "You have scanned countless QR codes,"
    } ]
  }, {
    "tStartMs": 2040747,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "and when you scan your next one,"
    } ]
  }, {
    "tStartMs": 2042248,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "you'll have a better idea of how it works."
    } ]
  }, {
    "tStartMs": 2044792,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "But have you ever thought about\nwhat QR itself stands for?"
    } ]
  }, {
    "tStartMs": 2058056,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "What is your favorite\napplication of the QR code?"
    } ]
  }, {
    "tStartMs": 2096719,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "(space tones beeping)"
    } ]
  } ]
}
