  "events": [ {
    "tStartMs": 2169,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "There are a lot of misconceptions out there and this a video about one of the most common ones."
    } ]
  }, {
    "tStartMs": 8860,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "So I went around asking people 'what makes the Moon go around the Earth?'  and they told me.."
    } ]
  }, {
    "tStartMs": 15190,
    "dDurationMs": 7429,
    "segs": [ {
      "utf8": "The Earth puts a gravitational force on the moon\nBut does the moon put a gravitational pull on the Earth?"
    } ]
  }, {
    "tStartMs": 24699,
    "dDurationMs": 7340,
    "segs": [ {
      "utf8": "Pull on the Earth yes. It does hence we have tides ETc the moon falls on the earth, [too] it affects like the tides and"
    } ]
  }, {
    "tStartMs": 33010,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "women and yes"
    } ]
  }, {
    "tStartMs": 35170,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It [does] very powerful"
    } ]
  }, {
    "tStartMs": 38440,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "does the moon pull on the Earth"
    } ]
  }, {
    "tStartMs": 39775,
    "dDurationMs": 905,
    "segs": [ {
      "utf8": "probably that as well"
    } ]
  }, {
    "tStartMs": 40680,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "Yeah"
    } ]
  }, {
    "tStartMs": 41440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So what I want to know is"
    } ]
  }, {
    "tStartMs": 42760,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "How does that force that the moon exerts on the Earth how does that compare in terms of size?"
    } ]
  }, {
    "tStartMs": 47380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "To the Force the Earth exerts on the moon"
    } ]
  }, {
    "tStartMs": 50000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Well..."
    } ]
  }, {
    "tStartMs": 51060,
    "dDurationMs": 3819,
    "segs": [ {
      "utf8": "No scientist, but I think that one would be more powerful than that one"
    } ]
  }, {
    "tStartMs": 54879,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "It's got a greater force coming from the Earth because it's greater mass is the Earth has more"
    } ]
  }, {
    "tStartMs": 59309,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Mass [cuz] it's a bigger mess. I thought greater mass is more [equals] more force [guys]"
    } ]
  }, {
    "tStartMs": 64189,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Does the moon pull on the earth?"
    } ]
  }, {
    "tStartMs": 64689,
    "dDurationMs": 1219,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 66640,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "But a lot less"
    } ]
  }, {
    "tStartMs": 68229,
    "dDurationMs": 1611,
    "segs": [ {
      "utf8": "Yeah, not as much as the Earth pulls on the moon."
    } ]
  }, {
    "tStartMs": 70400,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "Yeah"
    } ]
  }, {
    "tStartMs": 71180,
    "dDurationMs": 1358,
    "segs": [ {
      "utf8": "Yeah, but a little bit"
    } ]
  }, {
    "tStartMs": 72538,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "not [very] strongly."
    } ]
  }, {
    "tStartMs": 73038,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 74340,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "But much much much much smaller because if it's mass [less], [not] size"
    } ]
  }, {
    "tStartMs": 79540,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Because it's smaller. It's much smaller than [that] than the Earth"
    } ]
  }, {
    "tStartMs": 83560,
    "dDurationMs": 1219,
    "segs": [ {
      "utf8": "because it's smaller. This is small"
    } ]
  }, {
    "tStartMs": 85479,
    "dDurationMs": 2029,
    "segs": [ {
      "utf8": "Allow me to let you in on a little secret"
    } ]
  }, {
    "tStartMs": 88390,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Everyone got it wrong"
    } ]
  }, {
    "tStartMs": 91270,
    "dDurationMs": 6739,
    "segs": [ {
      "utf8": "The Force that attracts the moon to the Earth is exactly the same size as the force that attracts the Earth to the moon"
    } ]
  }, {
    "tStartMs": 99189,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So what's going on here? Why did everyone get it wrong?"
    } ]
  }, {
    "tStartMs": 102460,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Well, I think it comes down to cause and effect"
    } ]
  }, {
    "tStartMs": 105430,
    "dDurationMs": 6349,
    "segs": [ {
      "utf8": "The effect of the force on the moon is quite clear the moon goes in circles around the Earth"
    } ]
  }, {
    "tStartMs": 112630,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "but the effect of that force on the Earth is"
    } ]
  }, {
    "tStartMs": 115600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "basically negligible; the Earth"
    } ]
  }, {
    "tStartMs": 117939,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "barely wobbles at all So people interpret this"
    } ]
  }, {
    "tStartMs": 121750,
    "dDurationMs": 1979,
    "segs": [ {
      "utf8": "Negligible effect as"
    } ]
  }, {
    "tStartMs": 123729,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "Indicating there's very little force affecting the Earth"
    } ]
  }, {
    "tStartMs": 127240,
    "dDurationMs": 4819,
    "segs": [ {
      "utf8": "But that is forgetting the third key piece of the puzzle which is inertia"
    } ]
  }, {
    "tStartMs": 132790,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Inertia is the tendency of Mass to Maintain State of motion"
    } ]
  }, {
    "tStartMs": 137510,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Since the Earth has a greater, mass"
    } ]
  }, {
    "tStartMs": 140170,
    "dDurationMs": 4589,
    "segs": [ {
      "utf8": "It has a greater, inertia and so even with the same amount of force on it"
    } ]
  }, {
    "tStartMs": 144890,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "It doesn't accelerate that much now the funny thing [is] many of the [people] I interviewed"
    } ]
  }, {
    "tStartMs": 151280,
    "dDurationMs": 6050,
    "segs": [ {
      "utf8": "Could state Newton's third law which is every [force] has not equal and opposite reaction"
    } ]
  }, {
    "tStartMs": 158230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Something about Newton's law doesn't seem to fit into that"
    } ]
  }, {
    "tStartMs": 162080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "[just] yet. You're good at this wait"
    } ]
  }, {
    "tStartMs": 164510,
    "dDurationMs": 3289,
    "segs": [ {
      "utf8": "Which Newton's law are we talking about the whole equal and opposite force thing?"
    } ]
  }, {
    "tStartMs": 168230,
    "dDurationMs": 3619,
    "segs": [ {
      "utf8": "Yeah, that one. So tell me what you're thinking man [ah] well"
    } ]
  }, {
    "tStartMs": 171850,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "Did one would think that if you're into putting a force on me I would be putting an equal Force upon it"
    } ]
  }, {
    "tStartMs": 177440,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "So why didn't they apply it to this problem?"
    } ]
  }, {
    "tStartMs": 180830,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "Well, I think they may have memorized the words, but not really [believed] Newton's third law in their core"
    } ]
  }, {
    "tStartMs": 187610,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "Did they really feel it in their spleen [I]?"
    } ]
  }, {
    "tStartMs": 191180,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Don't think they did so"
    } ]
  }, {
    "tStartMs": 193730,
    "dDurationMs": 7009,
    "segs": [ {
      "utf8": "Allow me to try to convince you, all of you spleen included, that Newton's third law really is true"
    } ]
  }, {
    "tStartMs": 201170,
    "dDurationMs": 2029,
    "segs": [ {
      "utf8": "Let's consider two objects"
    } ]
  }, {
    "tStartMs": 204230,
    "dDurationMs": 3139,
    "segs": [ {
      "utf8": "Initially they have the same Mass 1 kilogram each"
    } ]
  }, {
    "tStartMs": 208010,
    "dDurationMs": 5839,
    "segs": [ {
      "utf8": "So obviously the gravitational force of attraction must be the same on both of the objects"
    } ]
  }, {
    "tStartMs": 215270,
    "dDurationMs": 3529,
    "segs": [ {
      "utf8": "Now let's add a second kilogram to the first object"
    } ]
  }, {
    "tStartMs": 219620,
    "dDurationMs": 6410,
    "segs": [ {
      "utf8": "The Force on the second object will now be twice as great because that 1 kilogram is attracted"
    } ]
  }, {
    "tStartMs": 226340,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "equally to each of the kilograms in the first object"
    } ]
  }, {
    "tStartMs": 230210,
    "dDurationMs": 3589,
    "segs": [ {
      "utf8": "But what is often forgotten is that new kilogram is"
    } ]
  }, {
    "tStartMs": 233960,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "also"
    } ]
  }, {
    "tStartMs": 234530,
    "dDurationMs": 7850,
    "segs": [ {
      "utf8": "attracted to the second object meaning that the total force on each object is still the same they're attracted to each other with an"
    } ]
  }, {
    "tStartMs": 242540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "equal and opposite Force"
    } ]
  }, {
    "tStartMs": 245150,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "We could add a third kilogram"
    } ]
  }, {
    "tStartMs": 247400,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "And we would find the same thing the force on both objects is still the same"
    } ]
  }, {
    "tStartMs": 251540,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "Even though the object on the left has [3] times the mass of the object on the right?"
    } ]
  }, {
    "tStartMs": 256310,
    "dDurationMs": 7489,
    "segs": [ {
      "utf8": "So we can see that no matter what the mass, any two objects will have the same gravitational force towards each other."
    } ]
  }, {
    "tStartMs": 265070,
    "dDurationMs": 7739,
    "segs": [ {
      "utf8": "Can you feel Newton's third law in your spleen now? It should settle inside you and become a part of you"
    } ]
  } ]
}
