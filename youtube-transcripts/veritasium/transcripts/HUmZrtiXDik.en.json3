{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 2980,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Hey Nige, can you get me another coke?"
    } ]
  }, {
    "tStartMs": 5480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Nah, I'm good, thanks."
    } ]
  }, {
    "tStartMs": 6600,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "It's just downstairs."
    } ]
  }, {
    "tStartMs": 7720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nah, the tennis is on."
    } ]
  }, {
    "tStartMs": 9880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You come to my house to watch the tennis and you're not even going to get me another coke?"
    } ]
  }, {
    "tStartMs": 12000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah, it's the tiebreaker.  Relax."
    } ]
  }, {
    "tStartMs": 15440,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "You know what I wish we had? Like a really long straw so we don't even have to go downstairs to the kitchen."
    } ]
  }, {
    "tStartMs": 19660,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That would be pretty good. Yeah. Yeah.  Right?"
    } ]
  }, {
    "tStartMs": 22740,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "How long of a straw could we actually make that you could use?"
    } ]
  }, {
    "tStartMs": 26880,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Downstairs is a bit of a stretch I reckon.  Yeah.  How much is that, like, 3, 4 meters? Do you think we could?"
    } ]
  }, {
    "tStartMs": 31740,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I reckon we could do it."
    } ]
  }, {
    "tStartMs": 33740,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "We'd need a lot of straws though."
    } ]
  }, {
    "tStartMs": 35960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "We got a pack here."
    } ]
  }, {
    "tStartMs": 37760,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "Oh, okay."
    } ]
  }, {
    "tStartMs": 38760,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "Now our first test, just to see that Nigel can use a straw properly, we've got about a 1 meter length of straw here."
    } ]
  }, {
    "tStartMs": 44560,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Think you can suck through that?"
    } ]
  }, {
    "tStartMs": 46600,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "I could give it a go.  So we just taped these drinking straws together, and hopefully"
    } ]
  }, {
    "tStartMs": 56520,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Yeah, that's alright.  But there's a lot of air coming through I think from the"
    } ]
  }, {
    "tStartMs": 59480,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "The joints in the straw, yeah.  We've gotta come up with some better way to test this out."
    } ]
  }, {
    "tStartMs": 65020,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "I happen to have 6 meters of plastic tubing here."
    } ]
  }, {
    "tStartMs": 68740,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Non-toxic?"
    } ]
  }, {
    "tStartMs": 70180,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Uhh, that's what they said at the hardware store."
    } ]
  }, {
    "tStartMs": 72360,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "We're preparing the preliminary tests.  Nigel is lowering some tubing off the balcony."
    } ]
  }, {
    "tStartMs": 77720,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "He actually thinks he's got a shot at sucking through 6 meters of tubing"
    } ]
  }, {
    "tStartMs": 82200,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "I think he's got no chance and he's going to be nowhere close, but"
    } ]
  }, {
    "tStartMs": 85400,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "I think this will allow us to establish how much Nigel actually sucks."
    } ]
  }, {
    "tStartMs": 90540,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 91960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "He's getting ready up there.  He knows there's a lot riding on it."
    } ]
  }, {
    "tStartMs": 95640,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "When you're ready!"
    } ]
  }, {
    "tStartMs": 99400,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Look at that! Look at that!  Woah, he shoots up!"
    } ]
  }, {
    "tStartMs": 102460,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "He's got 2 meters! He's got three meters!"
    } ]
  }, {
    "tStartMs": 105160,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Look at that guy go! He's getting 4 meters, 4 meters!"
    } ]
  }, {
    "tStartMs": 107720,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "5! 5 meters! 6!"
    } ]
  }, {
    "tStartMs": 111820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah!  (Cheering)"
    } ]
  }, {
    "tStartMs": 114260,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Now I'm going to try to do the same thing, but the tube I'm using has a thicker diameter."
    } ]
  }, {
    "tStartMs": 119920,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Mine is about 5 mil, where as Nigel's was 3mil."
    } ]
  }, {
    "tStartMs": 123660,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "So we're going to see if this makes any difference."
    } ]
  }, {
    "tStartMs": 125680,
    "dDurationMs": 14360,
    "segs": [ {
      "utf8": "(Inspiring music)"
    } ]
  }, {
    "tStartMs": 145700,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Now, I guess the obvious question is, can Nigel do it?"
    } ]
  }, {
    "tStartMs": 149500,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 150440,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Nigel thinks that's the obvious answer but I'm pretty sure he's going to fail."
    } ]
  }, {
    "tStartMs": 155160,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Now, maybe what's worth talking about is how a straw works in the first place."
    } ]
  }, {
    "tStartMs": 159460,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "How does it work?"
    } ]
  }, {
    "tStartMs": 160660,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "Yeah, cause this is really just a big bendy straw.  If we look at a smaller version of a straw here"
    } ]
  }, {
    "tStartMs": 166280,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "We should all be familiar with how this works.  Or should we?"
    } ]
  }, {
    "tStartMs": 170040,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "I don't know.  I think most people think you're just sucking the liquid in and swallowing it."
    } ]
  }, {
    "tStartMs": 173620,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But, you knid of have to think about air pressure."
    } ]
  }, {
    "tStartMs": 176560,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "Yeah, because actually what's happening is that air pressure is causing the, coke in this case, to go up the straw."
    } ]
  }, {
    "tStartMs": 182940,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Well there's a difference in pressure in the atmospheric pressure and the pressure that you create"
    } ]
  }, {
    "tStartMs": 187500,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "by opening up your lungs and pulling your diaphragm down."
    } ]
  }, {
    "tStartMs": 191400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So you reduce the pressure in your mouth, and it's that difference in pressure"
    } ]
  }, {
    "tStartMs": 194360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "between the atmospheric pressure and the pressure inside you"
    } ]
  }, {
    "tStartMs": 196880,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "which gets that liquid flowing into you."
    } ]
  }, {
    "tStartMs": 200740,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "someone has failed at the 5 mm diameter and you're the next guy to take it on."
    } ]
  }, {
    "tStartMs": 204980,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "You ready for this?"
    } ]
  }, {
    "tStartMs": 205860,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "I am ready."
    } ]
  }, {
    "tStartMs": 206640,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "He's been practicing his whole life for this."
    } ]
  }, {
    "tStartMs": 210080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah, you can see it's a strong start."
    } ]
  }, {
    "tStartMs": 213300,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Strong start from Quan"
    } ]
  }, {
    "tStartMs": 215400,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "You've got it.  Oh, he's going big right here."
    } ]
  }, {
    "tStartMs": 218600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You can see there's a lot of determination."
    } ]
  }, {
    "tStartMs": 222280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "He's getting close, getting close.  Look at this."
    } ]
  }, {
    "tStartMs": 224920,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Look at this.  Can he do it? Can he do it?"
    } ]
  }, {
    "tStartMs": 230060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ohhhhhh, and he's done it!"
    } ]
  }, {
    "tStartMs": 232060,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "(cheering)"
    } ]
  }, {
    "tStartMs": 234240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Agh.  That tastes disgusting."
    } ]
  }, {
    "tStartMs": 236100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yeah I definitely felt like my tounge, while I was trying to suck it up"
    } ]
  }, {
    "tStartMs": 239320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "was being pulled out into the straw"
    } ]
  }, {
    "tStartMs": 241540,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "(off) I felt the same thing"
    } ]
  }, {
    "tStartMs": 243200,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "But."
    } ]
  }, {
    "tStartMs": 243680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And it was tougher, definitely tougher."
    } ]
  }, {
    "tStartMs": 245740,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Well done sir."
    } ]
  }, {
    "tStartMs": 246820,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Thank you.  Means a lot."
    } ]
  }, {
    "tStartMs": 248060,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "For his next challenge, we're going to try to get him to suck through 10.3 meters"
    } ]
  }, {
    "tStartMs": 252440,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "which is the theoretical maximum, size of straw"
    } ]
  }, {
    "tStartMs": 255580,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "How are you feeling?"
    } ]
  }, {
    "tStartMs": 257080,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Well, that theoretical maximum, kind of relies on being able to get a perfect vacuum"
    } ]
  }, {
    "tStartMs": 261900,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "and, although I am perfect in a lot of ways, I don't know that I can create a perfect vacuum."
    } ]
  }, {
    "tStartMs": 266220,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "I have often thought that there is actually a perfect vacuum inside Nigel's head"
    } ]
  }, {
    "tStartMs": 269800,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Today we're going to really find out, won't we?"
    } ]
  }, {
    "tStartMs": 272340,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Ok, we've got the setup here.  We're down at Tamarama Beach"
    } ]
  }, {
    "tStartMs": 277020,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "And we have 10.5 meters worth of tubing"
    } ]
  }, {
    "tStartMs": 280860,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Which goes all the way up to Nigel at the very top there."
    } ]
  }, {
    "tStartMs": 283700,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So I'm going to see if I can relive some of my former glory"
    } ]
  }, {
    "tStartMs": 288100,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and get the red liquid up this height."
    } ]
  }, {
    "tStartMs": 290940,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "3!  2!  1!"
    } ]
  }, {
    "tStartMs": 297080,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "There you have it.  Nigel is starting to suck on that straw."
    } ]
  }, {
    "tStartMs": 301960,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "There he goes."
    } ]
  }, {
    "tStartMs": 304240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Looking strong.  Create that vacuum."
    } ]
  }, {
    "tStartMs": 306800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Approaching the edge of the cliff there.  Go, Nigel, Go!"
    } ]
  }, {
    "tStartMs": 309400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "C'mon, Nigel!"
    } ]
  }, {
    "tStartMs": 313700,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Doesn't seem to be going anywhere.  We seem a bit stuck."
    } ]
  }, {
    "tStartMs": 316740,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "At that point right there.  You can see the determination, the focus."
    } ]
  }, {
    "tStartMs": 320300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Trying to see how high that is"
    } ]
  }, {
    "tStartMs": 323120,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "He's done well"
    } ]
  }, {
    "tStartMs": 325060,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But it just doesn't look like it's going to happen."
    } ]
  }, {
    "tStartMs": 328800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "(Music stops, and breaks down. Signalling failure)"
    } ]
  }, {
    "tStartMs": 333460,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Alright, so Nigel did pretty well there"
    } ]
  }, {
    "tStartMs": 335600,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "We saw that he could get that liquid up the tube about 7 meters."
    } ]
  }, {
    "tStartMs": 339560,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Not the theoretical maximum of ten meters."
    } ]
  }, {
    "tStartMs": 342160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Still more than you.  Just saying."
    } ]
  }, {
    "tStartMs": 344120,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "That's a good point. That's a good point."
    } ]
  }, {
    "tStartMs": 345880,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "If Nigel could have created a perfect vacuum, then the water would have"
    } ]
  }, {
    "tStartMs": 348920,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "gone up to 10.3 meters, according to our calculations."
    } ]
  }, {
    "tStartMs": 352720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "This is kind of similar to how they used to measure atmospheric pressure in the old days."
    } ]
  }, {
    "tStartMs": 356000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "by millimeters of mercury."
    } ]
  }, {
    "tStartMs": 357880,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "So atmospheric pressure would push mercury up a tube with  a vacuum at the other end"
    } ]
  }, {
    "tStartMs": 362780,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "760 millimeters."
    } ]
  }, {
    "tStartMs": 364300,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "760 millimeters. So about .76 of a meter."
    } ]
  }, {
    "tStartMs": 367860,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So you can see why they used mercury and not water"
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "because if you were doing this with water, you'd need"
    } ]
  }, {
    "tStartMs": 372740,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "a cliff"
    } ]
  }, {
    "tStartMs": 373460,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "yeah, you'd need a ten meter long barometer."
    } ]
  }, {
    "tStartMs": 376660,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "so much better to do it with millimeters of mercury."
    } ]
  }, {
    "tStartMs": 378620,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "and of course now we measure it in kilopascals."
    } ]
  }, {
    "tStartMs": 381820,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "So anyway, well done Nigel.  You really suck."
    } ]
  }, {
    "tStartMs": 389620,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "So how do we work out the maximum length of straw that you could suck through vertically?"
    } ]
  }, {
    "tStartMs": 394640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Well think about this.  You place the straw into the liquid."
    } ]
  }, {
    "tStartMs": 397880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and you start sucking from the top."
    } ]
  }, {
    "tStartMs": 400200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that decreases the pressure at the top"
    } ]
  }, {
    "tStartMs": 402400,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and the difference in pressure between your mouth and atmospheric pressure"
    } ]
  }, {
    "tStartMs": 405800,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "creates a force that pushes the liquid upwards."
    } ]
  }, {
    "tStartMs": 409500,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Now that liquid which is in the straw has a weight"
    } ]
  }, {
    "tStartMs": 412860,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "which is equal to the volume of the liquid, times its density, times the gravitational field strength."
    } ]
  }, {
    "tStartMs": 418300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "so if we set these two forces equal to each other"
    } ]
  }, {
    "tStartMs": 421300,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "you can see that the pressure difference must be equal to the density of fluid"
    } ]
  }, {
    "tStartMs": 424960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "times its height, times the gravitational field strength"
    } ]
  }, {
    "tStartMs": 428000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and if we sub in the numbers, we can see that the maximum height of liquid"
    } ]
  }, {
    "tStartMs": 431780,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "that anyone could lift, even if they created a perfect vacuum inside their mouth"
    } ]
  }, {
    "tStartMs": 436140,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "would be about 10.3 meters."
    } ]
  } ]
}
