{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- In the summer of 1841,"
    } ]
  }, {
    "tStartMs": 1980,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Florida Doctor John Gorrie\nfaced a dire situation."
    } ]
  }, {
    "tStartMs": 5580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Yellow fever, also known\nas the black vomit,"
    } ]
  }, {
    "tStartMs": 8130,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "was sweeping through his town,\nwiping out entire families."
    } ]
  }, {
    "tStartMs": 12420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Patients came to Gorrie's small infirmary,"
    } ]
  }, {
    "tStartMs": 14820,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "jaundiced and burning with\nfevers up to 40 degrees Celsius."
    } ]
  }, {
    "tStartMs": 19020,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "To cool his patients down,"
    } ]
  }, {
    "tStartMs": 20790,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Gorrie couldn't turn to refrigeration"
    } ]
  }, {
    "tStartMs": 22890,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "because that hadn't been invented yet."
    } ]
  }, {
    "tStartMs": 25110,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, he came up with a radical treatment."
    } ]
  }, {
    "tStartMs": 27960,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "He suspended pans of ice in his infirmary,"
    } ]
  }, {
    "tStartMs": 30450,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "allowing the cool, dense air\nto flow down over his patients,"
    } ]
  }, {
    "tStartMs": 34020,
    "dDurationMs": 1737,
    "segs": [ {
      "utf8": "providing much-needed relief."
    } ]
  }, {
    "tStartMs": 35757,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "(patient exhaling)"
    } ]
  }, {
    "tStartMs": 37470,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But, this treatment was\nalmost impossible to sustain"
    } ]
  }, {
    "tStartMs": 40530,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "because it required hundreds\nof kilograms of ice per day,"
    } ]
  }, {
    "tStartMs": 44250,
    "dDurationMs": 2409,
    "segs": [ {
      "utf8": "and Gorrie had only one way to get it."
    } ]
  }, {
    "tStartMs": 46659,
    "dDurationMs": 2062,
    "segs": [ {
      "utf8": "(ice scraping)"
    } ]
  }, {
    "tStartMs": 48721,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "(train engine whirring)\n(ice block thudding)"
    } ]
  }, {
    "tStartMs": 50190,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "He relied on ice blocks"
    } ]
  }, {
    "tStartMs": 51600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that were transported\nthousands of kilometers"
    } ]
  }, {
    "tStartMs": 53700,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "through a now-forgotten ice empire,"
    } ]
  }, {
    "tStartMs": 56310,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "a vast network of ships and ice houses"
    } ]
  }, {
    "tStartMs": 58560,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "all built and controlled by one man."
    } ]
  }, {
    "tStartMs": 60812,
    "dDurationMs": 958,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 61770,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "Known to the world as the Ice King."
    } ]
  }, {
    "tStartMs": 64615,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 66150,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Over the previous 35 years,"
    } ]
  }, {
    "tStartMs": 67830,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "he had forged a monopoly\nthat spanned the globe,"
    } ]
  }, {
    "tStartMs": 70770,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "and anyone who wanted\nice was at his mercy."
    } ]
  }, {
    "tStartMs": 73692,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 75450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Gorrie only got a\nfew deliveries each year,"
    } ]
  }, {
    "tStartMs": 78240,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and now, by the peak of summer,"
    } ]
  }, {
    "tStartMs": 80010,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the cost of just a few\ndays' ice for the infirmary"
    } ]
  }, {
    "tStartMs": 83040,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "would've been more expensive\nthan the average yearly wage."
    } ]
  }, {
    "tStartMs": 86550,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So, locals began to refer\nto the ice as white gold."
    } ]
  }, {
    "tStartMs": 90390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "As Gorrie's supply ran out,"
    } ]
  }, {
    "tStartMs": 91950,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "he was forced to watch his\npatients suffer and die."
    } ]
  }, {
    "tStartMs": 95670,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It was in that moment that he\ndecided he would find a way"
    } ]
  }, {
    "tStartMs": 98310,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "to free the world from\nthe grip of the Ice King."
    } ]
  }, {
    "tStartMs": 103765,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "By the turn of the 19th century,"
    } ]
  }, {
    "tStartMs": 105355,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "most of America's ice came\nfrom the northern states,"
    } ]
  }, {
    "tStartMs": 108175,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "where thousands of square\nkilometers of lakes"
    } ]
  }, {
    "tStartMs": 110695,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "would freeze over for much of the year."
    } ]
  }, {
    "tStartMs": 113155,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The hard part was\ngetting all that ice out."
    } ]
  }, {
    "tStartMs": 116995,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- To get ice out of a lake or river,"
    } ]
  }, {
    "tStartMs": 118945,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "first of all, you had to\ntrust that it was deep enough"
    } ]
  }, {
    "tStartMs": 121225,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "to support your weight,"
    } ]
  }, {
    "tStartMs": 122335,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and there's no way to really tell."
    } ]
  }, {
    "tStartMs": 124405,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Then, you had to walk out several feet"
    } ]
  }, {
    "tStartMs": 126535,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "onto this plane of ice,"
    } ]
  }, {
    "tStartMs": 128095,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "take a saw, that's as long as I am tall,"
    } ]
  }, {
    "tStartMs": 131575,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and then carve the very\nice that you're standing on"
    } ]
  }, {
    "tStartMs": 134815,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "and just hope to heaven\nthat it doesn't sink."
    } ]
  }, {
    "tStartMs": 138041,
    "dDurationMs": 3344,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 141385,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Then, you had to kind\nof float it to shore,"
    } ]
  }, {
    "tStartMs": 143605,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and a horse would help\nto kind of pull the ice"
    } ]
  }, {
    "tStartMs": 146035,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "into the back of a wagon."
    } ]
  }, {
    "tStartMs": 148675,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "It was frequently common"
    } ]
  }, {
    "tStartMs": 150145,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "for the harvesters and their horses"
    } ]
  }, {
    "tStartMs": 152575,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "to fall through into the ice,"
    } ]
  }, {
    "tStartMs": 153805,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "sometimes to their death."
    } ]
  }, {
    "tStartMs": 155515,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- This dangerous and painstaking process"
    } ]
  }, {
    "tStartMs": 157705,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "meant that ice remained a rare commodity,"
    } ]
  }, {
    "tStartMs": 159895,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "available mostly to wealthy landowners."
    } ]
  }, {
    "tStartMs": 162505,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "One of the few who had access to it"
    } ]
  }, {
    "tStartMs": 164095,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "was 22-year-old Boston\nmerchant Frederic Tudor."
    } ]
  }, {
    "tStartMs": 168205,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "In the winter of 1805,"
    } ]
  }, {
    "tStartMs": 170155,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Tudor was thinking back\nto a tragic incident"
    } ]
  }, {
    "tStartMs": 172885,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that had happened four years earlier."
    } ]
  }, {
    "tStartMs": 174955,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "He and his brother came\ndown with a bad fever"
    } ]
  }, {
    "tStartMs": 177595,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "while visiting the Caribbean."
    } ]
  }, {
    "tStartMs": 179335,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Back home, they would've\njust asked their servants"
    } ]
  }, {
    "tStartMs": 182095,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to get some ice."
    } ]
  }, {
    "tStartMs": 183535,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But on the islands, ice was unheard of."
    } ]
  }, {
    "tStartMs": 186775,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "With no way to cool down,"
    } ]
  }, {
    "tStartMs": 188305,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the brothers cut their trip\nshort and returned to America."
    } ]
  }, {
    "tStartMs": 191935,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "And while Frederic recovered,\nhis brother did not."
    } ]
  }, {
    "tStartMs": 195178,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 196585,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Today, we know"
    } ]
  }, {
    "tStartMs": 197665,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that ice wouldn't have\nsaved his brother's life"
    } ]
  }, {
    "tStartMs": 199795,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "because he likely\nsuffered from a rare case"
    } ]
  }, {
    "tStartMs": 202375,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "of bone tuberculosis."
    } ]
  }, {
    "tStartMs": 204145,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "But at the time,"
    } ]
  }, {
    "tStartMs": 205165,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tudor believed that it was\nthe lack of ice on the islands"
    } ]
  }, {
    "tStartMs": 208165,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that was responsible\nfor his brother's death."
    } ]
  }, {
    "tStartMs": 210865,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "It was this painful memory\nthat gave him an idea."
    } ]
  }, {
    "tStartMs": 214645,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "What if he could be the one\nto bring ice to the Caribbean?"
    } ]
  }, {
    "tStartMs": 217795,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And, in the process, make his fortune."
    } ]
  }, {
    "tStartMs": 220855,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So, Tudor got to work."
    } ]
  }, {
    "tStartMs": 222355,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "He hired dozens of men to gather ice"
    } ]
  }, {
    "tStartMs": 224695,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and approached investors\nto help finance a ship."
    } ]
  }, {
    "tStartMs": 227905,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But to the investors, this\nplan seemed ridiculous."
    } ]
  }, {
    "tStartMs": 231235,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Tudor wrote, \"People only laugh"
    } ]
  }, {
    "tStartMs": 233545,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "when I tell them I'm going to\ncarry ice to the West Indies,\""
    } ]
  }, {
    "tStartMs": 236845,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "which is understandable"
    } ]
  }, {
    "tStartMs": 238585,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "because the journey\nwould take three weeks,"
    } ]
  }, {
    "tStartMs": 241105,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "sailing through warm seas under\nthe blazing Caribbean sun."
    } ]
  }, {
    "tStartMs": 244855,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I mean, can you really transport ice"
    } ]
  }, {
    "tStartMs": 247165,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in those conditions for that long?"
    } ]
  }, {
    "tStartMs": 249265,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Wouldn't it all just melt?"
    } ]
  }, {
    "tStartMs": 251425,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It turns, out people had figured out ways"
    } ]
  }, {
    "tStartMs": 253585,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to make ice last a long time,"
    } ]
  }, {
    "tStartMs": 255235,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "even thousands of years ago."
    } ]
  }, {
    "tStartMs": 257875,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "As far back as 500 BC,"
    } ]
  }, {
    "tStartMs": 260055,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "in the scorching summers\nof the Persian Empire,"
    } ]
  }, {
    "tStartMs": 262945,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "ancient kings, like Xerxes,"
    } ]
  }, {
    "tStartMs": 264625,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "enjoyed refreshing frozen desserts,"
    } ]
  }, {
    "tStartMs": 267205,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "even when the outside temperature"
    } ]
  }, {
    "tStartMs": 268645,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "climbed as high as 35 degrees Celsius."
    } ]
  }, {
    "tStartMs": 271795,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Now, ice in the desert might seem strange,"
    } ]
  }, {
    "tStartMs": 274075,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but during the winter months,"
    } ]
  }, {
    "tStartMs": 275485,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "temperatures can drop dramatically."
    } ]
  }, {
    "tStartMs": 277285,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So, the Persians filled\nshallow pools with water,"
    } ]
  }, {
    "tStartMs": 279865,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which would freeze overnight,"
    } ]
  }, {
    "tStartMs": 281485,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and in the morning,"
    } ]
  }, {
    "tStartMs": 282318,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "they would break up the ice\nsheets and collect the pieces."
    } ]
  }, {
    "tStartMs": 285175,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "To make that ice last until the summer,"
    } ]
  }, {
    "tStartMs": 287755,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "they used three key techniques."
    } ]
  }, {
    "tStartMs": 290875,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Let's try simple a experiment."
    } ]
  }, {
    "tStartMs": 292465,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "I have eight ice cubes spread\nevenly in one dish here"
    } ]
  }, {
    "tStartMs": 297235,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and I have another eight ice cubes"
    } ]
  }, {
    "tStartMs": 299845,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "now stacked together in one mega cube"
    } ]
  }, {
    "tStartMs": 301915,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "in this dish over here."
    } ]
  }, {
    "tStartMs": 303355,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Now, if you leave these two\nplates to melt for a few hours,"
    } ]
  }, {
    "tStartMs": 306415,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the stacked ice cubes fare a lot better,"
    } ]
  }, {
    "tStartMs": 309505,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and that's because the main way ice melts"
    } ]
  }, {
    "tStartMs": 311425,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "is through heat conduction on its surface."
    } ]
  }, {
    "tStartMs": 313195,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So, even though the volume was the same,"
    } ]
  }, {
    "tStartMs": 314845,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "the surface area exposed here\nis double what we had here."
    } ]
  }, {
    "tStartMs": 318235,
    "dDurationMs": 1727,
    "segs": [ {
      "utf8": "The key idea here is that\nyou wanna pack your ice"
    } ]
  }, {
    "tStartMs": 319962,
    "dDurationMs": 1696,
    "segs": [ {
      "utf8": "as tightly as possible."
    } ]
  }, {
    "tStartMs": 322525,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] In fact, the best shape"
    } ]
  }, {
    "tStartMs": 323725,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "to minimize the surface area is a sphere."
    } ]
  }, {
    "tStartMs": 326935,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So, if you think about it,"
    } ]
  }, {
    "tStartMs": 328165,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "a snowman is pretty much\nmathematically optimal to survive"
    } ]
  }, {
    "tStartMs": 331645,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "as long as possible."
    } ]
  }, {
    "tStartMs": 334285,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But, you don't need perfect geometry"
    } ]
  }, {
    "tStartMs": 336475,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to make ice last a long time."
    } ]
  }, {
    "tStartMs": 338605,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "In the winter of 2010,"
    } ]
  }, {
    "tStartMs": 340105,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "the city of Helsinki dumped all the snow"
    } ]
  }, {
    "tStartMs": 342295,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "plowed from their streets\nonto this huge pile,"
    } ]
  }, {
    "tStartMs": 345655,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "around 30 meters high and 100 meters wide."
    } ]
  }, {
    "tStartMs": 348865,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Almost a year later,"
    } ]
  }, {
    "tStartMs": 350185,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that very same pile was still around,"
    } ]
  }, {
    "tStartMs": 352915,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "despite being exposed"
    } ]
  }, {
    "tStartMs": 354085,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "to one of the country's\nhottest summers in decades."
    } ]
  }, {
    "tStartMs": 356612,
    "dDurationMs": 1253,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 357865,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The main reason it lasted so long"
    } ]
  }, {
    "tStartMs": 359995,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is because the ratio of\nsurface area to volume"
    } ]
  }, {
    "tStartMs": 362335,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "actually decreases for larger\nand larger amounts of ice."
    } ]
  }, {
    "tStartMs": 365845,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "For example, if you double\nthe radius of this snowman,"
    } ]
  }, {
    "tStartMs": 368605,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "then the volume of ice"
    } ]
  }, {
    "tStartMs": 370075,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "increases by a factor\nof two cubed or eight,"
    } ]
  }, {
    "tStartMs": 372835,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "but the surface area"
    } ]
  }, {
    "tStartMs": 373705,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "only increases by a factor\nof two squared or four."
    } ]
  }, {
    "tStartMs": 377245,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "This is known as the square cube law,"
    } ]
  }, {
    "tStartMs": 379495,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which was the second technique\nused by the Persians."
    } ]
  }, {
    "tStartMs": 382375,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And finally, they needed a way"
    } ]
  }, {
    "tStartMs": 383875,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "to shield the ice from the harsh desert."
    } ]
  }, {
    "tStartMs": 385896,
    "dDurationMs": 1279,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 387175,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Okay, I have another example."
    } ]
  }, {
    "tStartMs": 388645,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Two ice cubes, two dishes."
    } ]
  }, {
    "tStartMs": 390475,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "The only difference, really,"
    } ]
  }, {
    "tStartMs": 391345,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "is gonna be that I have this fan,"
    } ]
  }, {
    "tStartMs": 392755,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "which is gonna be blowing\nair onto this ice cube."
    } ]
  }, {
    "tStartMs": 395365,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now, it's not heating any of the air,"
    } ]
  }, {
    "tStartMs": 396805,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "it's just blowing away any air"
    } ]
  }, {
    "tStartMs": 398995,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the ice would've chilled for itself."
    } ]
  }, {
    "tStartMs": 400705,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And it's introducing more\nwarmer, ambient-temperature air,"
    } ]
  }, {
    "tStartMs": 403555,
    "dDurationMs": 1404,
    "segs": [ {
      "utf8": "which heats the ice cube better."
    } ]
  }, {
    "tStartMs": 404959,
    "dDurationMs": 1956,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 406915,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "After about an hour of the fan blowing,"
    } ]
  }, {
    "tStartMs": 408715,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "this ice cube is completely gone,"
    } ]
  }, {
    "tStartMs": 410395,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "whereas this one is only about 40% melted."
    } ]
  }, {
    "tStartMs": 412915,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, obviously, you wanna\nminimize the amount of airflow"
    } ]
  }, {
    "tStartMs": 415225,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that you're getting around your ice."
    } ]
  }, {
    "tStartMs": 417145,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "One way you can do that"
    } ]
  }, {
    "tStartMs": 418885,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "is by putting the ice in\na deeper dish, like a pit,"
    } ]
  }, {
    "tStartMs": 422995,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "because colder air sinks to the bottom,"
    } ]
  }, {
    "tStartMs": 424945,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "so it collects around the ice"
    } ]
  }, {
    "tStartMs": 426445,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and lets it stay there for longer."
    } ]
  }, {
    "tStartMs": 428695,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And a way you can one-up\nthat is to seal the ice,"
    } ]
  }, {
    "tStartMs": 431755,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which is exactly what the Persians did."
    } ]
  }, {
    "tStartMs": 433675,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "- [Derek] This is a yakhchal,\nan ancient Persian ice house."
    } ]
  }, {
    "tStartMs": 437305,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It's a massive dome structure"
    } ]
  }, {
    "tStartMs": 438925,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with walls up to two\nmeters thick at the base."
    } ]
  }, {
    "tStartMs": 441565,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Here, the Persians collected\nup to 220 tonnes of ice"
    } ]
  }, {
    "tStartMs": 445195,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and packed it tightly together in a pit."
    } ]
  }, {
    "tStartMs": 447685,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This allowed the cold,\ndense air to collect"
    } ]
  }, {
    "tStartMs": 450235,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "while warm air was funneled\nup and out of the dome."
    } ]
  }, {
    "tStartMs": 453565,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "After the winter,"
    } ]
  }, {
    "tStartMs": 454405,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the entire structure was sealed up,"
    } ]
  }, {
    "tStartMs": 456805,
    "dDurationMs": 1994,
    "segs": [ {
      "utf8": "insulating the ice until summer."
    } ]
  }, {
    "tStartMs": 458799,
    "dDurationMs": 1306,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 460105,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "For the next 2,300 years, these\ntechniques barely changed."
    } ]
  }, {
    "tStartMs": 463885,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And now, Tudor was\nready to bet his fortune"
    } ]
  }, {
    "tStartMs": 466525,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "on these ancient principles."
    } ]
  }, {
    "tStartMs": 468355,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So, he mortgaged land on his\nfamily estate to buy a ship,"
    } ]
  }, {
    "tStartMs": 471565,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and he began modifying it"
    } ]
  }, {
    "tStartMs": 473065,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for the long journey to the West Indies."
    } ]
  }, {
    "tStartMs": 475255,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "- He did that by building\nout a cargo hole in a ship"
    } ]
  }, {
    "tStartMs": 479425,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "that was built similarly\nto the ice houses."
    } ]
  }, {
    "tStartMs": 483205,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The ice was elevated off the ground,"
    } ]
  }, {
    "tStartMs": 485125,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "so it wasn't sitting in melt water"
    } ]
  }, {
    "tStartMs": 486805,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because melt water speeds\nup the melting of ice."
    } ]
  }, {
    "tStartMs": 489685,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And the blocks of ice were\nalso packed really tightly."
    } ]
  }, {
    "tStartMs": 493345,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Tudor went all in,"
    } ]
  }, {
    "tStartMs": 494725,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "sinking a full $10,000\nof mostly borrowed money"
    } ]
  }, {
    "tStartMs": 497725,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "into the venture,"
    } ]
  }, {
    "tStartMs": 498775,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "which is the equivalent of\nover a quarter million dollars today."
    } ]
  }, {
    "tStartMs": 502675,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "He sent his youngest brother"
    } ]
  }, {
    "tStartMs": 503965,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and his cousin ahead to\nthe island of Martinique"
    } ]
  }, {
    "tStartMs": 505945,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "to build an ice house\nready to receive the cargo."
    } ]
  }, {
    "tStartMs": 509335,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "On the morning of February 13th, 1806,"
    } ]
  }, {
    "tStartMs": 511825,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Tudor departed Boston Harbor,"
    } ]
  }, {
    "tStartMs": 513535,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "carrying with him over\n80 metric tonnes of ice,"
    } ]
  }, {
    "tStartMs": 516715,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the first shipment of its kind."
    } ]
  }, {
    "tStartMs": 518845,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The Boston Gazette ran an\narticle that read, \"No joke."
    } ]
  }, {
    "tStartMs": 521725,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "A vessel has cleared at the Custom House"
    } ]
  }, {
    "tStartMs": 523825,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with a cargo of ice."
    } ]
  }, {
    "tStartMs": 525535,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "We hope this will not prove\na slippery speculation.\""
    } ]
  }, {
    "tStartMs": 529585,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "After nearly three weeks at\nsea, Tudor's ship arrived,"
    } ]
  }, {
    "tStartMs": 532645,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and to his relief,"
    } ]
  }, {
    "tStartMs": 533935,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "around half of the ice\nhad survived the trip."
    } ]
  }, {
    "tStartMs": 537115,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But there was a problem."
    } ]
  }, {
    "tStartMs": 538285,
    "dDurationMs": 3436,
    "segs": [ {
      "utf8": "His brother and cousin had\nfailed to build an ice house."
    } ]
  }, {
    "tStartMs": 541721,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 542554,
    "dDurationMs": 1611,
    "segs": [ {
      "utf8": "So, with no place to store the ice,"
    } ]
  }, {
    "tStartMs": 544165,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Tudor had to sell it\nstraight off the dock,"
    } ]
  }, {
    "tStartMs": 546175,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "under the hot sun."
    } ]
  }, {
    "tStartMs": 547315,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "He sold as quickly as possible,"
    } ]
  }, {
    "tStartMs": 549505,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but after two days, he\nhad only made about $50."
    } ]
  }, {
    "tStartMs": 552955,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The locals were confused by\nthe strange frozen water,"
    } ]
  }, {
    "tStartMs": 555955,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and many were shocked"
    } ]
  }, {
    "tStartMs": 557455,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "when their new product\ndisappeared before their eyes."
    } ]
  }, {
    "tStartMs": 560425,
    "dDurationMs": 1944,
    "segs": [ {
      "utf8": "One customer tried to\nsave his precious ice"
    } ]
  }, {
    "tStartMs": 562369,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "by submerging it in a bath of water,"
    } ]
  }, {
    "tStartMs": 565105,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "only to find it vanishing even faster."
    } ]
  }, {
    "tStartMs": 568045,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In the end,"
    } ]
  }, {
    "tStartMs": 568878,
    "dDurationMs": 4417,
    "segs": [ {
      "utf8": "all Tudor could do was watch\nhis remaining ice melt away."
    } ]
  }, {
    "tStartMs": 573295,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Yet somehow, he was undeterred,"
    } ]
  }, {
    "tStartMs": 575545,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and over the next four years,"
    } ]
  }, {
    "tStartMs": 576985,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "he continued to borrow money,"
    } ]
  }, {
    "tStartMs": 578695,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "using every cent to\nship ice to new markets,"
    } ]
  }, {
    "tStartMs": 581335,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "like Cuba, Jamaica, Barbados, and Antigua."
    } ]
  }, {
    "tStartMs": 585025,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But, business remained difficult."
    } ]
  }, {
    "tStartMs": 587185,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Tudor wrote, \"I found myself without money"
    } ]
  }, {
    "tStartMs": 589705,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and without friends,"
    } ]
  }, {
    "tStartMs": 591025,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and with only a cargo of ice\nin a torrid zone to depend on"
    } ]
  }, {
    "tStartMs": 595225,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "for the supply of both.\""
    } ]
  }, {
    "tStartMs": 597025,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "By 1809, Tudor owed $40,000 to investors,"
    } ]
  }, {
    "tStartMs": 600895,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which is over 1 million bucks today."
    } ]
  }, {
    "tStartMs": 603475,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "He was hounded by creditors,"
    } ]
  }, {
    "tStartMs": 605365,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "he was forced to hide from\nsheriffs on his own ships,"
    } ]
  }, {
    "tStartMs": 608815,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "and he was even sent to\ndebtor's prison twice."
    } ]
  }, {
    "tStartMs": 611917,
    "dDurationMs": 948,
    "segs": [ {
      "utf8": "(jail bars clanging)"
    } ]
  }, {
    "tStartMs": 612865,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "He later described it as,\n\"The winter of my discontent,\""
    } ]
  }, {
    "tStartMs": 615985,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but during that time, he had a revelation."
    } ]
  }, {
    "tStartMs": 618925,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The reason demand wasn't picking up"
    } ]
  }, {
    "tStartMs": 620785,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "was because the people of the West Indies"
    } ]
  }, {
    "tStartMs": 623095,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "didn't know what to do with ice."
    } ]
  }, {
    "tStartMs": 625285,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So, all he had to do, he reasoned,"
    } ]
  }, {
    "tStartMs": 627415,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "was make them understand"
    } ]
  }, {
    "tStartMs": 629305,
    "dDurationMs": 3015,
    "segs": [ {
      "utf8": "by offering them some refreshing drinks."
    } ]
  }, {
    "tStartMs": 632320,
    "dDurationMs": 2175,
    "segs": [ {
      "utf8": "(beverage sloshing)"
    } ]
  }, {
    "tStartMs": 634495,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- He convinces the bartenders there"
    } ]
  }, {
    "tStartMs": 636655,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "to let him show them how\nto make icy cocktails,"
    } ]
  }, {
    "tStartMs": 641485,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "and he gives the ice initially\nto the bartenders for free."
    } ]
  }, {
    "tStartMs": 645355,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So, the bartenders can\nsell both the icy drink"
    } ]
  }, {
    "tStartMs": 648985,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and the room temperature\ndrink at the same price,"
    } ]
  }, {
    "tStartMs": 652105,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "just to see what their customers prefer."
    } ]
  }, {
    "tStartMs": 654565,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And lo and behold, they\nprefer the icy drink."
    } ]
  }, {
    "tStartMs": 657115,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "- [Derek] In Tudor's own words,"
    } ]
  }, {
    "tStartMs": 658262,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "\"A man who has drank his drinks cold"
    } ]
  }, {
    "tStartMs": 660325,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "at the same expense for one week"
    } ]
  }, {
    "tStartMs": 661945,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "can never be presented\nwith them warm again.\""
    } ]
  }, {
    "tStartMs": 664795,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Tudor even showed them\nhow to make ice cream,"
    } ]
  }, {
    "tStartMs": 666535,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "which became an instant\nhit, especially in Cuba."
    } ]
  }, {
    "tStartMs": 669715,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "150 years later, during\nthe Cuban Revolution,"
    } ]
  }, {
    "tStartMs": 672235,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "its leader, Fidel Castro,\nwas obsessed with ice cream."
    } ]
  }, {
    "tStartMs": 675505,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "He was actually known"
    } ]
  }, {
    "tStartMs": 676375,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to eat up to 18 scoops after lunchtime,"
    } ]
  }, {
    "tStartMs": 679405,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "which is a bit crazy."
    } ]
  }, {
    "tStartMs": 680425,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "His sweet tooth was so famous"
    } ]
  }, {
    "tStartMs": 682315,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that the CIA actually\ntried to assassinate him"
    } ]
  }, {
    "tStartMs": 684715,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "with a poisoned milkshake."
    } ]
  }, {
    "tStartMs": 687055,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Now, back in Tudor's day, his\nwork was finally paying off."
    } ]
  }, {
    "tStartMs": 690355,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The cafe owners in the West Indies"
    } ]
  }, {
    "tStartMs": 692215,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "started asking him for more and more ice,"
    } ]
  }, {
    "tStartMs": 694495,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and he realized that he\ncould increase his profits,"
    } ]
  }, {
    "tStartMs": 696775,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "just by refining his methods."
    } ]
  }, {
    "tStartMs": 698305,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So, he started using sawdust"
    } ]
  }, {
    "tStartMs": 700285,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to insulate his ice on the ships"
    } ]
  }, {
    "tStartMs": 702475,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "because sawdust was a phenomenal insulator"
    } ]
  }, {
    "tStartMs": 704965,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that you could basically get for free"
    } ]
  }, {
    "tStartMs": 706705,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "from all the sawmills around Boston."
    } ]
  }, {
    "tStartMs": 708655,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They were just trying to get rid of it."
    } ]
  }, {
    "tStartMs": 710095,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And he also replaced the\nmanual saws at the lakes"
    } ]
  }, {
    "tStartMs": 713485,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "with horse-drawn plows,"
    } ]
  }, {
    "tStartMs": 715105,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which made it all the\neasier to get the ice out."
    } ]
  }, {
    "tStartMs": 717415,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Because of that,"
    } ]
  }, {
    "tStartMs": 718248,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "the price of extracting a tonne of ice"
    } ]
  }, {
    "tStartMs": 720445,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "dropped from around 30 cents\nall the way down to 10 cents."
    } ]
  }, {
    "tStartMs": 724495,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- By the 1820s, Tudor was\nfinally turning a profit,"
    } ]
  }, {
    "tStartMs": 727615,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and the ice trade began to pick up."
    } ]
  }, {
    "tStartMs": 729925,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So much so that copycat\nbusinesses began to crop up."
    } ]
  }, {
    "tStartMs": 733285,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But Tudor wasn't about to let anyone else"
    } ]
  }, {
    "tStartMs": 735715,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "have a share of the market he created."
    } ]
  }, {
    "tStartMs": 737995,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, to maintain his monopoly,"
    } ]
  }, {
    "tStartMs": 739855,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "he often undercut his competition"
    } ]
  }, {
    "tStartMs": 742285,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "until they either gave up\nor went out of business."
    } ]
  }, {
    "tStartMs": 745735,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "Tudor's ambition didn't end\nthere, and he wrote that,"
    } ]
  }, {
    "tStartMs": 748292,
    "dDurationMs": 2813,
    "segs": [ {
      "utf8": "There was \"an experiment I\nhave been desirous of making"
    } ]
  }, {
    "tStartMs": 751105,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for 20 years.\""
    } ]
  }, {
    "tStartMs": 752845,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "In 1833, he took on his\nbiggest challenge yet,"
    } ]
  }, {
    "tStartMs": 756175,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "a four-month journey"
    } ]
  }, {
    "tStartMs": 757165,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "to ship ice halfway across\nthe world to Calcutta, India."
    } ]
  }, {
    "tStartMs": 760875,
    "dDurationMs": 977,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 761852,
    "dDurationMs": 1472,
    "segs": [ {
      "utf8": "(rain splashing)\n(thunder rumbling)"
    } ]
  }, {
    "tStartMs": 763324,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "(waves crashing)"
    } ]
  }, {
    "tStartMs": 764884,
    "dDurationMs": 1171,
    "segs": [ {
      "utf8": "(wind whooshing)"
    } ]
  }, {
    "tStartMs": 766055,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "(waves crashing)"
    } ]
  }, {
    "tStartMs": 769375,
    "dDurationMs": 1549,
    "segs": [ {
      "utf8": "And despite the trip\nbeing five times longer"
    } ]
  }, {
    "tStartMs": 770924,
    "dDurationMs": 2231,
    "segs": [ {
      "utf8": "than his first one to the Caribbean,"
    } ]
  }, {
    "tStartMs": 773155,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "more than half of the ice survived."
    } ]
  }, {
    "tStartMs": 775145,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "(compelling music)"
    } ]
  }, {
    "tStartMs": 777445,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "In India, the ice was a big hit."
    } ]
  }, {
    "tStartMs": 779905,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Over the next 20 years,"
    } ]
  }, {
    "tStartMs": 781075,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Tudor made around $220,000\nin Calcutta alone,"
    } ]
  }, {
    "tStartMs": 785515,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "making it one of his\nmost profitable ventures."
    } ]
  }, {
    "tStartMs": 788095,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Over that same period, he\nrapidly expanded his empire,"
    } ]
  }, {
    "tStartMs": 791155,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "opening roots to Brazil,\nSingapore, Hong Kong,"
    } ]
  }, {
    "tStartMs": 793675,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and even Australia."
    } ]
  }, {
    "tStartMs": 795025,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "His yearly sales"
    } ]
  }, {
    "tStartMs": 796105,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "went from less than\n10,000 tonnes in the 1830s"
    } ]
  }, {
    "tStartMs": 798985,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to a record high of 132,000 tonnes in 1856."
    } ]
  }, {
    "tStartMs": 804355,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Seeing the wealth and\npower of his monopoly,"
    } ]
  }, {
    "tStartMs": 806845,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "the world gave Tudor a new name:"
    } ]
  }, {
    "tStartMs": 808915,
    "dDurationMs": 1089,
    "segs": [ {
      "utf8": "the Ice King."
    } ]
  }, {
    "tStartMs": 810004,
    "dDurationMs": 1791,
    "segs": [ {
      "utf8": "(suspenseful music)\n(ice cracking)"
    } ]
  }, {
    "tStartMs": 811795,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "In under 50 years,"
    } ]
  }, {
    "tStartMs": 813445,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "the ice trade had become one\nof the largest industries"
    } ]
  }, {
    "tStartMs": 816595,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in the US,"
    } ]
  }, {
    "tStartMs": 817428,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "and it's second largest export by weight."
    } ]
  }, {
    "tStartMs": 820165,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "What was once a luxury\nproduct became a commodity."
    } ]
  }, {
    "tStartMs": 823375,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "By the 1860s, devices known as ice boxes"
    } ]
  }, {
    "tStartMs": 826315,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "started popping up in ordinary kitchens."
    } ]
  }, {
    "tStartMs": 828835,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Essentially, they were\ninsulated wooden cabinets"
    } ]
  }, {
    "tStartMs": 831205,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "with a compartment for ice at the top,"
    } ]
  }, {
    "tStartMs": 833305,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which would then cool\ndown the food underneath,"
    } ]
  }, {
    "tStartMs": 835465,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "keeping it fresh."
    } ]
  }, {
    "tStartMs": 836995,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Families across the country\nsoon bought ice daily or weekly,"
    } ]
  }, {
    "tStartMs": 840955,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "with the average New Yorker"
    } ]
  }, {
    "tStartMs": 842245,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "buying over 600 kilograms a year."
    } ]
  }, {
    "tStartMs": 845065,
    "dDurationMs": 3819,
    "segs": [ {
      "utf8": "This surge in demand resulted\nin a curious new profession."
    } ]
  }, {
    "tStartMs": 848884,
    "dDurationMs": 1524,
    "segs": [ {
      "utf8": "The iceman."
    } ]
  }, {
    "tStartMs": 851305,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The iceman would go door to door,"
    } ]
  }, {
    "tStartMs": 852985,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "delivering huge blocks of\nice up to 45 kilograms."
    } ]
  }, {
    "tStartMs": 856375,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And while home delivery was\nnothing new in the 19th century,"
    } ]
  }, {
    "tStartMs": 859465,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the iceman was unique,"
    } ]
  }, {
    "tStartMs": 861055,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in that he needed to go inside your house"
    } ]
  }, {
    "tStartMs": 863455,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "to make his delivery."
    } ]
  }, {
    "tStartMs": 864595,
    "dDurationMs": 995,
    "segs": [ {
      "utf8": "- [Homeowner] Yoo-hoo!"
    } ]
  }, {
    "tStartMs": 865590,
    "dDurationMs": 1405,
    "segs": [ {
      "utf8": "Iceman!"
    } ]
  }, {
    "tStartMs": 866995,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- All kinds of rumors and jokes"
    } ]
  }, {
    "tStartMs": 870325,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and cultural thoughts\nstarted to to crop up."
    } ]
  }, {
    "tStartMs": 873295,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And if you look at"
    } ]
  }, {
    "tStartMs": 874525,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "some of the most popular\nsongs at the time,"
    } ]
  }, {
    "tStartMs": 877772,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "\"She Fell In Love with the Iceman,\""
    } ]
  }, {
    "tStartMs": 879595,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or \"The Iceman Took My Wife.\""
    } ]
  }, {
    "tStartMs": 881785,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "If you look at old Valentine's Day cards"
    } ]
  }, {
    "tStartMs": 884515,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "that were circulating at this time,"
    } ]
  }, {
    "tStartMs": 885745,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "they all had puns about the iceman."
    } ]
  }, {
    "tStartMs": 888415,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The iceman made my wife too hot;"
    } ]
  }, {
    "tStartMs": 891175,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "he was supposed to deliver ice."
    } ]
  }, {
    "tStartMs": 892465,
    "dDurationMs": 1582,
    "segs": [ {
      "utf8": "Like, it was so silly."
    } ]
  }, {
    "tStartMs": 894047,
    "dDurationMs": 1118,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 895165,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Consumption of ice"
    } ]
  }, {
    "tStartMs": 896155,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "in big cities like New York skyrocketed."
    } ]
  }, {
    "tStartMs": 898585,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And by the end of the 19th century,"
    } ]
  }, {
    "tStartMs": 900535,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "ice had grown into a\nbillion-dollar business."
    } ]
  }, {
    "tStartMs": 903775,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And while part of the demand\nwas due to home ice boxes,"
    } ]
  }, {
    "tStartMs": 906835,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "the real driving force was\nseveral new industries."
    } ]
  }, {
    "tStartMs": 911035,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- The ice industry also\nlaunched the fish industry,"
    } ]
  }, {
    "tStartMs": 914215,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "the meat packing industry,\nthe brewery industry."
    } ]
  }, {
    "tStartMs": 917695,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "It became like this multi-level industry."
    } ]
  }, {
    "tStartMs": 921162,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "(train horn honking)"
    } ]
  }, {
    "tStartMs": 922495,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "When we get to the point\nwhere there are railroads,"
    } ]
  }, {
    "tStartMs": 924565,
    "dDurationMs": 2782,
    "segs": [ {
      "utf8": "then comes the invention\nof the refrigeration car,"
    } ]
  }, {
    "tStartMs": 927347,
    "dDurationMs": 3608,
    "segs": [ {
      "utf8": "railroad cars that were\ninsulated with ice blocks"
    } ]
  }, {
    "tStartMs": 930955,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "to carry things that are perishable."
    } ]
  }, {
    "tStartMs": 933385,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So, if you think about it,"
    } ]
  }, {
    "tStartMs": 934218,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "fresh fruits and vegetables\nthat have been region-locked"
    } ]
  }, {
    "tStartMs": 936715,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "now can become national staples."
    } ]
  }, {
    "tStartMs": 938545,
    "dDurationMs": 2565,
    "segs": [ {
      "utf8": "So, you have apricots and\ncherries from California,"
    } ]
  }, {
    "tStartMs": 941110,
    "dDurationMs": 3705,
    "segs": [ {
      "utf8": "you have strawberries from\nFlorida, they can all go inland."
    } ]
  }, {
    "tStartMs": 944815,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Actually, you want to guess\nthe name of a vegetable"
    } ]
  }, {
    "tStartMs": 947605,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that was really popularized\nwith these chilled cars?"
    } ]
  }, {
    "tStartMs": 950545,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Chilled vegetable."
    } ]
  }, {
    "tStartMs": 951745,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I'm gonna guess lettuce?"
    } ]
  }, {
    "tStartMs": 953335,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Which one?"
    } ]
  }, {
    "tStartMs": 954985,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Iceberg."
    } ]
  }, {
    "tStartMs": 956095,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "It's gotta be iceberg, right?"
    } ]
  }, {
    "tStartMs": 957565,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Gregor] Exactly."
    } ]
  }, {
    "tStartMs": 958975,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- It's like crunchy water."
    } ]
  }, {
    "tStartMs": 960055,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It's like ice, iceberg lettuce."
    } ]
  }, {
    "tStartMs": 962005,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Gregor] It is crunchy water,"
    } ]
  }, {
    "tStartMs": 963235,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but it was actually called iceberg"
    } ]
  }, {
    "tStartMs": 964855,
    "dDurationMs": 1659,
    "segs": [ {
      "utf8": "because of the ice that kept it fresh."
    } ]
  }, {
    "tStartMs": 966514,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 968215,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- This change marked the\nbeginning of a new system"
    } ]
  }, {
    "tStartMs": 970405,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "called the cold chain."
    } ]
  }, {
    "tStartMs": 971965,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And for the meat packing\nindustry, it was a huge upgrade."
    } ]
  }, {
    "tStartMs": 975415,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Previously, the only way\nto transport fresh meat"
    } ]
  }, {
    "tStartMs": 977995,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "was by sending rail cars\nfilled with live cattle"
    } ]
  }, {
    "tStartMs": 981355,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "straight from farms to cities."
    } ]
  }, {
    "tStartMs": 983485,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Then, the animals had to\nbe brought into the city"
    } ]
  }, {
    "tStartMs": 985645,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and held in local stockyards"
    } ]
  }, {
    "tStartMs": 987295,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "before they were prepared"
    } ]
  }, {
    "tStartMs": 988585,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "by local slaughterhouses and butchers."
    } ]
  }, {
    "tStartMs": 990865,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The result was that city centers"
    } ]
  }, {
    "tStartMs": 992455,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "were filled with dirty, noisy cows."
    } ]
  }, {
    "tStartMs": 995245,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And on top of that,"
    } ]
  }, {
    "tStartMs": 996078,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "since almost half of\nthe animal was inedible,"
    } ]
  }, {
    "tStartMs": 998575,
    "dDurationMs": 3064,
    "segs": [ {
      "utf8": "shipping was extremely\ninefficient, pushing up the cost."
    } ]
  }, {
    "tStartMs": 1001639,
    "dDurationMs": 1196,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 1002835,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But, with chilled rail\ncars, all this changed,"
    } ]
  }, {
    "tStartMs": 1005475,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and the country's supply chain\nreorganized into three parts."
    } ]
  }, {
    "tStartMs": 1009045,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "First, ranches across the Great Plains"
    } ]
  }, {
    "tStartMs": 1011145,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "funneled their cattle to\ncities in the Midwest."
    } ]
  }, {
    "tStartMs": 1013845,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Taking on the role"
    } ]
  }, {
    "tStartMs": 1014685,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "of industrial food\npreparation and distribution,"
    } ]
  }, {
    "tStartMs": 1017115,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "these cities built up vast\nstockyards, slaughterhouses,"
    } ]
  }, {
    "tStartMs": 1020145,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and rail hubs to send the meat onward."
    } ]
  }, {
    "tStartMs": 1022845,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Chicago emerged as the\nnation's meat packing capital,"
    } ]
  }, {
    "tStartMs": 1025815,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "ballooning in size from\njust 30,000 people in 1850"
    } ]
  }, {
    "tStartMs": 1029475,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to 1.7 million in 1900."
    } ]
  }, {
    "tStartMs": 1032715,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And at the end of the chain"
    } ]
  }, {
    "tStartMs": 1034005,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "were the large, insatiable cities."
    } ]
  }, {
    "tStartMs": 1036315,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "With the new system in place,"
    } ]
  }, {
    "tStartMs": 1037605,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "almost twice as much edible meat"
    } ]
  }, {
    "tStartMs": 1039225,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "could be transported in each rail car,"
    } ]
  }, {
    "tStartMs": 1041415,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "eventually dropping the\ncost in urban areas by 39%."
    } ]
  }, {
    "tStartMs": 1045345,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "As a result, demand soared."
    } ]
  }, {
    "tStartMs": 1047445,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "In New York City alone,"
    } ]
  }, {
    "tStartMs": 1048675,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "beef shipments rose from\njust 2,400 tonnes in 1882"
    } ]
  }, {
    "tStartMs": 1052455,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to around 63,000 tons in 1886."
    } ]
  }, {
    "tStartMs": 1055935,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "That's a 25-fold increase\nin just four years."
    } ]
  }, {
    "tStartMs": 1059835,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But more importantly,"
    } ]
  }, {
    "tStartMs": 1061005,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "with a national distribution\nnetwork to rely on,"
    } ]
  }, {
    "tStartMs": 1063525,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "these cities no longer needed\nto prepare meat locally."
    } ]
  }, {
    "tStartMs": 1066495,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They could finally get rid\nof all the infrastructure"
    } ]
  }, {
    "tStartMs": 1068895,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and herds of cows in the city center,"
    } ]
  }, {
    "tStartMs": 1071205,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "freeing up the land"
    } ]
  }, {
    "tStartMs": 1072285,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "for things like housing,\noffices, and factories."
    } ]
  }, {
    "tStartMs": 1075585,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This fundamentally changed their structure"
    } ]
  }, {
    "tStartMs": 1078135,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "and gave rise to the modern city of today."
    } ]
  }, {
    "tStartMs": 1080776,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1082485,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But, while the cold chain\nwas redefining America,"
    } ]
  }, {
    "tStartMs": 1084885,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "a new invention"
    } ]
  }, {
    "tStartMs": 1085935,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "was about to overthrow\nthe natural ice industry,"
    } ]
  }, {
    "tStartMs": 1089205,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "which brings us back to Dr.\nJohn Gorrie in the 1840s."
    } ]
  }, {
    "tStartMs": 1092955,
    "dDurationMs": 1225,
    "segs": [ {
      "utf8": "A few scientists had devised"
    } ]
  }, {
    "tStartMs": 1094180,
    "dDurationMs": 2405,
    "segs": [ {
      "utf8": "and even built prototype cooling machines,"
    } ]
  }, {
    "tStartMs": 1096585,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but they weren't commercially viable."
    } ]
  }, {
    "tStartMs": 1098835,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And Gorrie wasn't faring any better."
    } ]
  }, {
    "tStartMs": 1101085,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "He had spent three years\nstruggling to make artificial ice"
    } ]
  }, {
    "tStartMs": 1104475,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "with no success."
    } ]
  }, {
    "tStartMs": 1106125,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "But one night,"
    } ]
  }, {
    "tStartMs": 1106958,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "while experimenting with an\nair pump to drain a bucket,"
    } ]
  }, {
    "tStartMs": 1109725,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "he noticed that if you let\nthe air expand quickly,"
    } ]
  }, {
    "tStartMs": 1112605,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "it formed a thin layer of ice\non the surface of the water."
    } ]
  }, {
    "tStartMs": 1115965,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "He had just stumbled upon\nthe breakthrough he needed,"
    } ]
  }, {
    "tStartMs": 1119445,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "and he set about creating a\nprototype based on this idea."
    } ]
  }, {
    "tStartMs": 1124245,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Take a sealed cylinder filled with air"
    } ]
  }, {
    "tStartMs": 1126375,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and a piston that can move inside it."
    } ]
  }, {
    "tStartMs": 1128505,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "We'll assume there's no friction"
    } ]
  }, {
    "tStartMs": 1129735,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "or heat lost to the environment."
    } ]
  }, {
    "tStartMs": 1131595,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "When the piston pushes\ndown, the air is compressed,"
    } ]
  }, {
    "tStartMs": 1134595,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "increasing its pressure and temperature."
    } ]
  }, {
    "tStartMs": 1137685,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The reason the temperature increases"
    } ]
  }, {
    "tStartMs": 1139185,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is because as the piston pushes down,"
    } ]
  }, {
    "tStartMs": 1141285,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "it moves toward the air molecules."
    } ]
  }, {
    "tStartMs": 1144105,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So, when a molecule bounces\noff this moving surface,"
    } ]
  }, {
    "tStartMs": 1146565,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "it gains a little bit of speed."
    } ]
  }, {
    "tStartMs": 1148995,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "And since the temperature"
    } ]
  }, {
    "tStartMs": 1149895,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "is proportional to the\nmolecules speed squared,"
    } ]
  }, {
    "tStartMs": 1152925,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "well, the air must heat up."
    } ]
  }, {
    "tStartMs": 1155145,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "But, notice that this process\nis completely reversible."
    } ]
  }, {
    "tStartMs": 1158055,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "If the piston is released,"
    } ]
  }, {
    "tStartMs": 1159555,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the high pressure air\npushes the piston back"
    } ]
  }, {
    "tStartMs": 1161655,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "until the pressure equalizes."
    } ]
  }, {
    "tStartMs": 1164145,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So now, when one of the\nmolecules bounces off the piston,"
    } ]
  }, {
    "tStartMs": 1167055,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it loses a little bit of speed."
    } ]
  }, {
    "tStartMs": 1169665,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Gorrie knew that if he simply let"
    } ]
  }, {
    "tStartMs": 1171855,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "all of this hot, high-pressure air expand,"
    } ]
  }, {
    "tStartMs": 1174825,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "it would return back to roughly\nits original temperature,"
    } ]
  }, {
    "tStartMs": 1178185,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "which wouldn't be very helpful."
    } ]
  }, {
    "tStartMs": 1179835,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "But what if he first cooled\nthe air and then let it expand?"
    } ]
  }, {
    "tStartMs": 1184275,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Well, then, its temperature\nwould drop far lower"
    } ]
  }, {
    "tStartMs": 1186615,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "than the ambient air."
    } ]
  }, {
    "tStartMs": 1188445,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "He started with a similar setup,"
    } ]
  }, {
    "tStartMs": 1190305,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "a cylinder and a piston that\nwere powered by a hand crank,"
    } ]
  }, {
    "tStartMs": 1193245,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which he then attached\nto a large air tank."
    } ]
  }, {
    "tStartMs": 1196365,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "As Gorrie turned the crank,\nthe piston moved down,"
    } ]
  }, {
    "tStartMs": 1198975,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "compressing the air and\nraising its temperature."
    } ]
  }, {
    "tStartMs": 1202125,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "To prevent the air from being\nsucked out of the large tank,"
    } ]
  }, {
    "tStartMs": 1204975,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Gorrie added a one-way valve\nat the bottom of the cylinder."
    } ]
  }, {
    "tStartMs": 1208035,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "He also added a similar valve\nat the top of the piston,"
    } ]
  }, {
    "tStartMs": 1210735,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "so that the cylinder could\nrefill with fresh air."
    } ]
  }, {
    "tStartMs": 1213915,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So, now, with each turn of the crank,"
    } ]
  }, {
    "tStartMs": 1215925,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "more and more air was added to the tank,"
    } ]
  }, {
    "tStartMs": 1218145,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which allowed to increase the pressure"
    } ]
  }, {
    "tStartMs": 1220485,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to around 10 atmospheres."
    } ]
  }, {
    "tStartMs": 1223005,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But then, he added one extra step."
    } ]
  }, {
    "tStartMs": 1225975,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "In between the piston and the tank,"
    } ]
  }, {
    "tStartMs": 1227565,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "he placed a big bucket of water"
    } ]
  }, {
    "tStartMs": 1229665,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and he forced the air\nthrough a submerged pipe."
    } ]
  }, {
    "tStartMs": 1232965,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "This cooled the air down"
    } ]
  }, {
    "tStartMs": 1234255,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to around the same\ntemperature as the water."
    } ]
  }, {
    "tStartMs": 1236715,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The result was that his tank"
    } ]
  }, {
    "tStartMs": 1238365,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "was still filled with high-pressure air,"
    } ]
  }, {
    "tStartMs": 1240345,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but instead of being hot, it was cool."
    } ]
  }, {
    "tStartMs": 1243285,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, now, when Gorrie\nreleased some of his cool air"
    } ]
  }, {
    "tStartMs": 1246135,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "into another cylinder with a piston,"
    } ]
  }, {
    "tStartMs": 1247995,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the air rapidly expanded."
    } ]
  }, {
    "tStartMs": 1250125,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This cooled the air down\nbelow its starting point"
    } ]
  }, {
    "tStartMs": 1252525,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and dropped it to freezing temperatures."
    } ]
  }, {
    "tStartMs": 1254925,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Gorrie then placed this entire cylinder"
    } ]
  }, {
    "tStartMs": 1256845,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "inside a large tank of water,"
    } ]
  }, {
    "tStartMs": 1258915,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "finally making ice."
    } ]
  }, {
    "tStartMs": 1261015,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But to avoid the entire\ntank freezing solid"
    } ]
  }, {
    "tStartMs": 1263565,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and clogging up his machine,"
    } ]
  }, {
    "tStartMs": 1265185,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "he used one final trick."
    } ]
  }, {
    "tStartMs": 1267435,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Instead of fresh water,"
    } ]
  }, {
    "tStartMs": 1268575,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "he filled the final tank with salt water,"
    } ]
  }, {
    "tStartMs": 1271065,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which freezes below zero degrees Celsius."
    } ]
  }, {
    "tStartMs": 1273765,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Since the salt water remained liquid,"
    } ]
  }, {
    "tStartMs": 1275595,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "he then submerged metal\nmolds of fresh water"
    } ]
  }, {
    "tStartMs": 1277935,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "until they froze into solid blocks,"
    } ]
  }, {
    "tStartMs": 1280365,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "essentially creating the\nworld's first ice cube tray."
    } ]
  }, {
    "tStartMs": 1283725,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "For the first time ever, ice\ncould be created anywhere,"
    } ]
  }, {
    "tStartMs": 1286335,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "even in the heat of the Florida summer."
    } ]
  }, {
    "tStartMs": 1288182,
    "dDurationMs": 2263,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1290445,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "- And when he says to the world\nlike, \"I've invented ice,\""
    } ]
  }, {
    "tStartMs": 1295395,
    "dDurationMs": 2365,
    "segs": [ {
      "utf8": "the reaction was, \"The hell you have."
    } ]
  }, {
    "tStartMs": 1297760,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "(Amy laughing)"
    } ]
  }, {
    "tStartMs": 1299865,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "No man should be creating ice."
    } ]
  }, {
    "tStartMs": 1301425,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Only God can create ice.\""
    } ]
  }, {
    "tStartMs": 1302925,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And what John Gorrie also didn't realize"
    } ]
  }, {
    "tStartMs": 1305505,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "is that in the first public venues"
    } ]
  }, {
    "tStartMs": 1307365,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "in which he announces his ice machine,"
    } ]
  }, {
    "tStartMs": 1310275,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Frederic Tudor has his\nassociates in the audience."
    } ]
  }, {
    "tStartMs": 1313515,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And Frederic Tudor is a man\nwho does not take lightly"
    } ]
  }, {
    "tStartMs": 1316755,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to threats to his empire."
    } ]
  }, {
    "tStartMs": 1318795,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And what bigger threat"
    } ]
  }, {
    "tStartMs": 1320235,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to the naturalized\nharvesting empire is there"
    } ]
  }, {
    "tStartMs": 1323745,
    "dDurationMs": 1365,
    "segs": [ {
      "utf8": "than human-made ice?"
    } ]
  }, {
    "tStartMs": 1325110,
    "dDurationMs": 1665,
    "segs": [ {
      "utf8": "- [Derek] There was no way the Ice King"
    } ]
  }, {
    "tStartMs": 1326775,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "was giving up his empire without a fight."
    } ]
  }, {
    "tStartMs": 1329475,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- What he ends up doing is\nhe ends up paying editors"
    } ]
  }, {
    "tStartMs": 1332565,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "up and down the eastern\nseaboard at newspapers"
    } ]
  }, {
    "tStartMs": 1335295,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "to publish scandalous news\narticles about John Gorrie."
    } ]
  }, {
    "tStartMs": 1339525,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So, everywhere from\nTallahassee up to New York,"
    } ]
  }, {
    "tStartMs": 1341925,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you see newspapers publishing headlines,"
    } ]
  }, {
    "tStartMs": 1344385,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "like, \"There's this crank"
    } ]
  }, {
    "tStartMs": 1345585,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that thinks he can make ice\nas good as God Almighty.\""
    } ]
  }, {
    "tStartMs": 1348615,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "And ultimately, John Gorrie,\nhe does patent his machine,"
    } ]
  }, {
    "tStartMs": 1352545,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but he never makes a dime on it."
    } ]
  }, {
    "tStartMs": 1354525,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- Gorrie spent the next few\nyears in financial ruin."
    } ]
  }, {
    "tStartMs": 1357675,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "A decade later, he died\nalone and penniless,"
    } ]
  }, {
    "tStartMs": 1360735,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "most likely succumbing to malaria."
    } ]
  }, {
    "tStartMs": 1363165,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "There are reports he suffered\nan extremely high fever"
    } ]
  }, {
    "tStartMs": 1366105,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in his final days,"
    } ]
  }, {
    "tStartMs": 1367695,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the very symptom he had tried to alleviate"
    } ]
  }, {
    "tStartMs": 1370035,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "for so many years."
    } ]
  }, {
    "tStartMs": 1372795,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "But, Gorrie's invention hadn't\nbeen completely ignored."
    } ]
  }, {
    "tStartMs": 1376305,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Soon, others began work on\nartificial cooling machines,"
    } ]
  }, {
    "tStartMs": 1379335,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "including James Harrison,"
    } ]
  }, {
    "tStartMs": 1380985,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "a Scottish-born engineer\nWorking in Australia."
    } ]
  }, {
    "tStartMs": 1384165,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Harrison noticed that Gorrie's\nmachine had one big drawback."
    } ]
  }, {
    "tStartMs": 1388335,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It relied on just two\ncomponents to move heat:"
    } ]
  }, {
    "tStartMs": 1390825,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "a compressor and an expansion engine."
    } ]
  }, {
    "tStartMs": 1393465,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So, instead of using\nair to cool his machine,"
    } ]
  }, {
    "tStartMs": 1396225,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "he tried a different approach."
    } ]
  }, {
    "tStartMs": 1398685,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- I have a can of freeze spray here,"
    } ]
  }, {
    "tStartMs": 1400785,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which is a liquid that when\nI press down on this button,"
    } ]
  }, {
    "tStartMs": 1403575,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "comes out and immediately evaporates"
    } ]
  }, {
    "tStartMs": 1405585,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "into a very, very low-temperature gas."
    } ]
  }, {
    "tStartMs": 1408105,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So, what I'm gonna do\nis I'm gonna blast it"
    } ]
  }, {
    "tStartMs": 1409815,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "at this cup of water."
    } ]
  }, {
    "tStartMs": 1411315,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And the process is actually so effective"
    } ]
  }, {
    "tStartMs": 1413805,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that in essentially under a minute,"
    } ]
  }, {
    "tStartMs": 1415845,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I'm able to get some ice to form in there."
    } ]
  }, {
    "tStartMs": 1418275,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 1419175,
    "dDurationMs": 3209,
    "segs": [ {
      "utf8": "So, after a layer of\nwater, what you get is..."
    } ]
  }, {
    "tStartMs": 1422384,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "(ice clattering)"
    } ]
  }, {
    "tStartMs": 1423735,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "A bunch of ice."
    } ]
  }, {
    "tStartMs": 1425110,
    "dDurationMs": 1145,
    "segs": [ {
      "utf8": "(ice clattering)"
    } ]
  }, {
    "tStartMs": 1426255,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Now, the reason this works"
    } ]
  }, {
    "tStartMs": 1427215,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "is because something special happens"
    } ]
  }, {
    "tStartMs": 1428745,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "when a substance changes phase."
    } ]
  }, {
    "tStartMs": 1430665,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, in order to go from a liquid to a gas,"
    } ]
  }, {
    "tStartMs": 1432975,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "it needs to absorb a lot of energy."
    } ]
  }, {
    "tStartMs": 1435285,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And pretty much all this energy"
    } ]
  }, {
    "tStartMs": 1436665,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "goes into overcoming\nthe force of attraction"
    } ]
  }, {
    "tStartMs": 1439215,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "between molecules,"
    } ]
  }, {
    "tStartMs": 1440085,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "so that they can disperse\nand go into the gas phase."
    } ]
  }, {
    "tStartMs": 1443355,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Harrison realized he could\ntake advantage of this effect"
    } ]
  }, {
    "tStartMs": 1446025,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "by forcing a fluid to continuously\nevaporate and condense"
    } ]
  }, {
    "tStartMs": 1450405,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "as it's going through a loop."
    } ]
  }, {
    "tStartMs": 1452265,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "A modern version looks\nsomething like this."
    } ]
  }, {
    "tStartMs": 1454995,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] Start by adding a\nliquid under high pressure"
    } ]
  }, {
    "tStartMs": 1457275,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "to a loop."
    } ]
  }, {
    "tStartMs": 1459075,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Passing this liquid\nthrough an expansion valve"
    } ]
  }, {
    "tStartMs": 1461085,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "quickly drops the\npressure and temperature,"
    } ]
  }, {
    "tStartMs": 1463245,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "causing some of the liquid to\nimmediately turn into a gas."
    } ]
  }, {
    "tStartMs": 1467025,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The mixture then passes\ninto an evaporator coil,"
    } ]
  }, {
    "tStartMs": 1470025,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "where the remaining\nliquid continues to boil."
    } ]
  }, {
    "tStartMs": 1472875,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But, this phase change\nrequires a lot of energy."
    } ]
  }, {
    "tStartMs": 1476085,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So, the liquid absorbs\nheat from the environment,"
    } ]
  }, {
    "tStartMs": 1478575,
    "dDurationMs": 2415,
    "segs": [ {
      "utf8": "and this is what creates\nthe cooling effect."
    } ]
  }, {
    "tStartMs": 1480990,
    "dDurationMs": 885,
    "segs": [ {
      "utf8": "(ice cracking)"
    } ]
  }, {
    "tStartMs": 1481875,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The cold gas is then cycled\nthrough a compressor,"
    } ]
  }, {
    "tStartMs": 1484695,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "raising its temperature,"
    } ]
  }, {
    "tStartMs": 1486015,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and then it's pushed\nthrough a condenser coil."
    } ]
  }, {
    "tStartMs": 1488745,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Here, the hot gas cools and\nturns back into a liquid,"
    } ]
  }, {
    "tStartMs": 1492075,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "releasing the absorbed heat\nback into the environment"
    } ]
  }, {
    "tStartMs": 1494685,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "before returning to the expansion valve."
    } ]
  }, {
    "tStartMs": 1497046,
    "dDurationMs": 1659,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1498705,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "By repeating this cycle\nover and over again,"
    } ]
  }, {
    "tStartMs": 1501495,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Harrison was reportedly\nable to manufacture"
    } ]
  }, {
    "tStartMs": 1503475,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "as much as 3,000 kilograms of ice per day."
    } ]
  }, {
    "tStartMs": 1506535,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And his machine was a\nhuge commercial success."
    } ]
  }, {
    "tStartMs": 1510615,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- Meanwhile, public\nresistance to Godless ice"
    } ]
  }, {
    "tStartMs": 1513615,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and artificial cooling began to fade,"
    } ]
  }, {
    "tStartMs": 1516045,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "overshadowed by a growing health crisis"
    } ]
  }, {
    "tStartMs": 1518295,
    "dDurationMs": 1697,
    "segs": [ {
      "utf8": "linked to natural ice."
    } ]
  }, {
    "tStartMs": 1519992,
    "dDurationMs": 2593,
    "segs": [ {
      "utf8": "One of the reasons artificial\nice was so much better"
    } ]
  }, {
    "tStartMs": 1522585,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "is because we make it on our own terms."
    } ]
  }, {
    "tStartMs": 1524955,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "With natural ice,"
    } ]
  }, {
    "tStartMs": 1526035,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "we had to wait until the right\nseason, in the right place,"
    } ]
  }, {
    "tStartMs": 1528885,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and then whatever happened\nin the water that froze,"
    } ]
  }, {
    "tStartMs": 1531885,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "like something died or\nwas rotting in there,"
    } ]
  }, {
    "tStartMs": 1534645,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "you had to work with it."
    } ]
  }, {
    "tStartMs": 1535545,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- By the time we get to\nthe mid-19th century,"
    } ]
  }, {
    "tStartMs": 1537705,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the peak of the Industrial Revolution,"
    } ]
  }, {
    "tStartMs": 1540285,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "factories and farms"
    } ]
  }, {
    "tStartMs": 1541815,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "just letting loose their\nchemicals and detritus"
    } ]
  }, {
    "tStartMs": 1544035,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "into the nearby lakes and rivers."
    } ]
  }, {
    "tStartMs": 1545475,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- You put an ice block into your cocktail,"
    } ]
  }, {
    "tStartMs": 1547695,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "you could get cholera."
    } ]
  }, {
    "tStartMs": 1548595,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "There are, like, stories of hospitals"
    } ]
  }, {
    "tStartMs": 1550815,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "treating wounds with ice,"
    } ]
  }, {
    "tStartMs": 1552285,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and then the ice makes you get a disease,"
    } ]
  }, {
    "tStartMs": 1555615,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and your wound isn't even the problem."
    } ]
  }, {
    "tStartMs": 1557925,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- They're getting cholera,"
    } ]
  }, {
    "tStartMs": 1559455,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "they're getting food\npoisoning or ice poisoning."
    } ]
  }, {
    "tStartMs": 1562755,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I mean, they're getting very, very sick."
    } ]
  }, {
    "tStartMs": 1565395,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It's so funny,"
    } ]
  }, {
    "tStartMs": 1566228,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "when we were first\ntalking about this story,"
    } ]
  }, {
    "tStartMs": 1568065,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "I was thinking about this\nfrozen New England ice,"
    } ]
  }, {
    "tStartMs": 1572595,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and I was just imagining\nlike the purest lake water,"
    } ]
  }, {
    "tStartMs": 1576885,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "this crystal-clear ice,"
    } ]
  }, {
    "tStartMs": 1578745,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and, like, just this\nincredible product, right?"
    } ]
  }, {
    "tStartMs": 1581925,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "But now that you mentioned it,"
    } ]
  }, {
    "tStartMs": 1582945,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "like, yeah, it probably\nis a lot less hygienic."
    } ]
  }, {
    "tStartMs": 1586155,
    "dDurationMs": 2404,
    "segs": [ {
      "utf8": "And yeah, there's probably germs in there."
    } ]
  }, {
    "tStartMs": 1588559,
    "dDurationMs": 926,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1589485,
    "dDurationMs": 3727,
    "segs": [ {
      "utf8": "- And so the human-made\nice companies were like,"
    } ]
  }, {
    "tStartMs": 1593212,
    "dDurationMs": 2453,
    "segs": [ {
      "utf8": "\"Sure, our ice isn't made by God."
    } ]
  }, {
    "tStartMs": 1595665,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But, natural ice will kill you."
    } ]
  }, {
    "tStartMs": 1597645,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So, which one do you want?\""
    } ]
  }, {
    "tStartMs": 1599595,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] After the first\naffordable home refrigerator"
    } ]
  }, {
    "tStartMs": 1601815,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "landed in the mass market in 1927,"
    } ]
  }, {
    "tStartMs": 1604335,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "it became one of the fastest\nadopted new technologies"
    } ]
  }, {
    "tStartMs": 1607335,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of the entire 20th century,"
    } ]
  }, {
    "tStartMs": 1609495,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "going from less than 1% of\nhomes having one in the 1920s"
    } ]
  }, {
    "tStartMs": 1612765,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to 85% by 1944."
    } ]
  }, {
    "tStartMs": 1615795,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This made its take off even\nfaster than the motorcar"
    } ]
  }, {
    "tStartMs": 1618435,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "replacing the horse-drawn cart."
    } ]
  }, {
    "tStartMs": 1620925,
    "dDurationMs": 1177,
    "segs": [ {
      "utf8": "- There's this argument of,"
    } ]
  }, {
    "tStartMs": 1622102,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "\"Would the world really be so different"
    } ]
  }, {
    "tStartMs": 1624345,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "without refrigeration?\""
    } ]
  }, {
    "tStartMs": 1625665,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Like, sure, food,\nstrawberries, iceberg lettuce,"
    } ]
  }, {
    "tStartMs": 1628455,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "but then you think about vaccines,\nblood donations, insulin,"
    } ]
  }, {
    "tStartMs": 1632175,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that the same cold chain\ntransports those things."
    } ]
  }, {
    "tStartMs": 1634725,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "And then, beyond medicine,"
    } ]
  }, {
    "tStartMs": 1635985,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the same principles that Harrison"
    } ]
  }, {
    "tStartMs": 1637695,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and Gorrie used for their fridges"
    } ]
  }, {
    "tStartMs": 1639675,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "are what allow us to cool things down"
    } ]
  }, {
    "tStartMs": 1641895,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to almost absolute zero."
    } ]
  }, {
    "tStartMs": 1643575,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Over the past century,"
    } ]
  }, {
    "tStartMs": 1644505,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so many of the discoveries that we made"
    } ]
  }, {
    "tStartMs": 1646305,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "rely on this principle of refrigeration:"
    } ]
  }, {
    "tStartMs": 1649125,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "MRIs, the Large Hadron Collider at CERN,"
    } ]
  }, {
    "tStartMs": 1652425,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "the James Webb Telescope."
    } ]
  }, {
    "tStartMs": 1653535,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "All of that is also refrigeration."
    } ]
  }, {
    "tStartMs": 1655755,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And my favorite is the PCR story,"
    } ]
  }, {
    "tStartMs": 1657795,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "where Thermus aquaticus was\nin a fridge for 16 years"
    } ]
  }, {
    "tStartMs": 1660645,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "before Kary Mullis discovered it."
    } ]
  }, {
    "tStartMs": 1662355,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "There wouldn't have been that connection"
    } ]
  }, {
    "tStartMs": 1663705,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "to make PCR viable in\nthat way without a fridge."
    } ]
  }, {
    "tStartMs": 1666915,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- I think it's easier"
    } ]
  }, {
    "tStartMs": 1668055,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "to focus on the movement\nof macroscopic objects"
    } ]
  }, {
    "tStartMs": 1671865,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and macroscopic things happening,"
    } ]
  }, {
    "tStartMs": 1674115,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "but this is really\nabout controlling motion"
    } ]
  }, {
    "tStartMs": 1678345,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "on the smallest scale,"
    } ]
  }, {
    "tStartMs": 1679695,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "controlling thermal motion,"
    } ]
  }, {
    "tStartMs": 1681615,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which is a pretty remarkable breakthrough."
    } ]
  }, {
    "tStartMs": 1683415,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I mean, we could heat\nthings up for a long time,"
    } ]
  }, {
    "tStartMs": 1685995,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "so you wanna increase the\nthermal energy of molecules."
    } ]
  }, {
    "tStartMs": 1688605,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You could do that from\nthe time we had fire."
    } ]
  }, {
    "tStartMs": 1690585,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But actually, taking those molecules"
    } ]
  }, {
    "tStartMs": 1692475,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and figuring out how to\nremove their thermal energy"
    } ]
  }, {
    "tStartMs": 1694665,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and really slow them down,"
    } ]
  }, {
    "tStartMs": 1696285,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that's the refrigeration story."
    } ]
  }, {
    "tStartMs": 1697635,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And that's really recent."
    } ]
  }, {
    "tStartMs": 1699885,
    "dDurationMs": 2754,
    "segs": [ {
      "utf8": "But as you point out, like,\nit has profound effects."
    } ]
  }, {
    "tStartMs": 1707025,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Gorrie was able to make ice"
    } ]
  }, {
    "tStartMs": 1708705,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "because he wasn't afraid"
    } ]
  }, {
    "tStartMs": 1709965,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to step outside his own\nprofession, medicine,"
    } ]
  }, {
    "tStartMs": 1712665,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and venture into a new\nfield, thermodynamics."
    } ]
  }, {
    "tStartMs": 1715845,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And while you probably don't\nneed to reinvent the fridge,"
    } ]
  }, {
    "tStartMs": 1718575,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "learning a new skill is always handy."
    } ]
  }, {
    "tStartMs": 1721335,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Here at Veritasium, we\ncreate simulations and models"
    } ]
  }, {
    "tStartMs": 1724245,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to test our ideas and illustrate them."
    } ]
  }, {
    "tStartMs": 1726285,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And along the way, our team\nhas learned to code in Python"
    } ]
  }, {
    "tStartMs": 1729495,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to make sure our animations\nare as accurate as possible."
    } ]
  }, {
    "tStartMs": 1733005,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So, if you, like us,"
    } ]
  }, {
    "tStartMs": 1734535,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "want to understand coding"
    } ]
  }, {
    "tStartMs": 1736005,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and strengthen your programming skills,"
    } ]
  }, {
    "tStartMs": 1737715,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "a great place to start is\ntoday's video sponsor, Brilliant."
    } ]
  }, {
    "tStartMs": 1740895,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Brilliant have recently added\nnew Python and coding courses,"
    } ]
  }, {
    "tStartMs": 1744105,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "starting from the basics"
    } ]
  }, {
    "tStartMs": 1745335,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and working all the way\nup to complex topics,"
    } ]
  }, {
    "tStartMs": 1747525,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "like how AI works."
    } ]
  }, {
    "tStartMs": 1749595,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Each of these is designed"
    } ]
  }, {
    "tStartMs": 1750975,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to break down concepts\ninto smaller pieces,"
    } ]
  }, {
    "tStartMs": 1753345,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "train your intuition,"
    } ]
  }, {
    "tStartMs": 1754335,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and encourage you to\nexplore your own ideas."
    } ]
  }, {
    "tStartMs": 1757095,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Brilliant helps you build\nskills in math, science,"
    } ]
  }, {
    "tStartMs": 1759975,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and computer science"
    } ]
  }, {
    "tStartMs": 1761055,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "through step-by-step interactive learning."
    } ]
  }, {
    "tStartMs": 1763335,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This method is proven\nto be far more effective"
    } ]
  }, {
    "tStartMs": 1765555,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "than just watching\nlectures or videos alone."
    } ]
  }, {
    "tStartMs": 1768705,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "What I love most is that instead\nof dumping formulas on you,"
    } ]
  }, {
    "tStartMs": 1772065,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Brilliant guides you to\nthose, \"Aha!\" moments"
    } ]
  }, {
    "tStartMs": 1774555,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "where everything finally clicks."
    } ]
  }, {
    "tStartMs": 1777165,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I have changed my phone a fair few times"
    } ]
  }, {
    "tStartMs": 1779025,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "over the past five years,"
    } ]
  }, {
    "tStartMs": 1780555,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "but every time I do,"
    } ]
  }, {
    "tStartMs": 1781905,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I make sure to download the Brilliant app"
    } ]
  }, {
    "tStartMs": 1783825,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "because it's such a great\nway to keep my brain engaged."
    } ]
  }, {
    "tStartMs": 1787365,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So, if you want free access\nto Brilliant's courses"
    } ]
  }, {
    "tStartMs": 1790275,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for a full 30 days,"
    } ]
  }, {
    "tStartMs": 1791535,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1794145,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "You can scan this QR code"
    } ]
  }, {
    "tStartMs": 1795855,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "or click the link in the description."
    } ]
  }, {
    "tStartMs": 1798135,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Brilliant also gives our viewers 20% off"
    } ]
  }, {
    "tStartMs": 1800805,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "an annual premium subscription\nfor unlimited access."
    } ]
  }, {
    "tStartMs": 1804105,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, I wanna thank Brilliant\nfor sponsoring this video,"
    } ]
  }, {
    "tStartMs": 1806535,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
