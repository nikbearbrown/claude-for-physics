{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 150,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- On December 1st, 2022,"
    } ]
  }, {
    "tStartMs": 2010,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the journal \"Nature\"\npublished a cover story"
    } ]
  }, {
    "tStartMs": 4440,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "about a holographic wormhole."
    } ]
  }, {
    "tStartMs": 6900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It was purportedly created\ninside a quantum computer"
    } ]
  }, {
    "tStartMs": 9600,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "to probe the intersection of\nquantum mechanics and gravity."
    } ]
  }, {
    "tStartMs": 13440,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The story kicked off a frenzy\nof tweets and news headlines."
    } ]
  }, {
    "tStartMs": 17940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Nobody has seen the wormhole."
    } ]
  }, {
    "tStartMs": 19920,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Nobody has produced one."
    } ]
  }, {
    "tStartMs": 21630,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Well, we'll\ntake the world's best"
    } ]
  }, {
    "tStartMs": 23010,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "quantum computer and\nsee if we can map that"
    } ]
  }, {
    "tStartMs": 25440,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "into building the wormhole."
    } ]
  }, {
    "tStartMs": 26700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The wormhole becomes\ntraversable, it opens."
    } ]
  }, {
    "tStartMs": 29160,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "You really can go through."
    } ]
  }, {
    "tStartMs": 32820,
    "dDurationMs": 2395,
    "segs": [ {
      "utf8": "- Bull (beep).\n(host laughing)"
    } ]
  }, {
    "tStartMs": 35215,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(magnets clicking)"
    } ]
  }, {
    "tStartMs": 36048,
    "dDurationMs": 1732,
    "segs": [ {
      "utf8": "- This video is sponsored by Shopify."
    } ]
  }, {
    "tStartMs": 39510,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The problem was, of course,"
    } ]
  }, {
    "tStartMs": 41100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that no wormhole had been created."
    } ]
  }, {
    "tStartMs": 43470,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- It feeds on itself, right?"
    } ]
  }, {
    "tStartMs": 44580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "When one story starts,"
    } ]
  }, {
    "tStartMs": 46380,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "then other media outlets grab hold of it"
    } ]
  }, {
    "tStartMs": 48720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and so it spreads very, very quickly."
    } ]
  }, {
    "tStartMs": 50580,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- What actually happened is that a super,"
    } ]
  }, {
    "tStartMs": 52800,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "a quantum computer is built"
    } ]
  }, {
    "tStartMs": 54930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and within this quantum computer,"
    } ]
  }, {
    "tStartMs": 56730,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "you can do some calculations."
    } ]
  }, {
    "tStartMs": 58530,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Calculations that can\nbe done with my iPhone"
    } ]
  }, {
    "tStartMs": 62520,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "because all the most powerful\nquantum computers today,"
    } ]
  }, {
    "tStartMs": 66300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "at most do calculations"
    } ]
  }, {
    "tStartMs": 67650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that can easily be done on my iPhone."
    } ]
  }, {
    "tStartMs": 69870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- You basically have something"
    } ]
  }, {
    "tStartMs": 71460,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "that represents the\nmathematics of a wormhole."
    } ]
  }, {
    "tStartMs": 74670,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But the way the story was sold, of course,"
    } ]
  }, {
    "tStartMs": 76470,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "is that in doing this,\nwhatever calculation they did,"
    } ]
  }, {
    "tStartMs": 79680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "they had created the wormhole."
    } ]
  }, {
    "tStartMs": 82260,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "- They say so in the same\nsense in which I could say,"
    } ]
  }, {
    "tStartMs": 84397,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "\"Look, my children has built a rocket"
    } ]
  }, {
    "tStartMs": 87877,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "\"that goes to the moon.\""
    } ]
  }, {
    "tStartMs": 89670,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "Say, \"Wow, what kind of child you have?"
    } ]
  }, {
    "tStartMs": 93247,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "\"Yeah, here it is.\""
    } ]
  }, {
    "tStartMs": 94497,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "And I show you a little\nsketch on a piece of paper"
    } ]
  }, {
    "tStartMs": 98460,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "when there is a drawing of\na rocket going to the moon"
    } ]
  }, {
    "tStartMs": 100827,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "and say, \"Look!\""
    } ]
  }, {
    "tStartMs": 101940,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So what the quantum computer\nhas done is exactly that."
    } ]
  }, {
    "tStartMs": 104970,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "There's a little sketch of what\ncould be perhaps a warm hole"
    } ]
  }, {
    "tStartMs": 109920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "in some hypothetical theory,\nwhich is probably wrong."
    } ]
  }, {
    "tStartMs": 113040,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Is this interesting?"
    } ]
  }, {
    "tStartMs": 114000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Yes, it is interesting"
    } ]
  }, {
    "tStartMs": 115230,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because the fact that\nwith quantum computers"
    } ]
  }, {
    "tStartMs": 117150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "you can do these things\nmean that quantum computers,"
    } ]
  }, {
    "tStartMs": 119820,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a little bit, sort of begin working."
    } ]
  }, {
    "tStartMs": 121740,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So people get excited about\nthat and then they go out"
    } ]
  }, {
    "tStartMs": 124650,
    "dDurationMs": 4057,
    "segs": [ {
      "utf8": "and tell to the world, \"Oh,\nwe've created a wormhole"
    } ]
  }, {
    "tStartMs": 128707,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "\"in a quantum computer,\""
    } ]
  }, {
    "tStartMs": 130950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "over overemphasizing the wormhole,"
    } ]
  }, {
    "tStartMs": 133200,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "which probably don't exist,\nthe theory being used of that,"
    } ]
  }, {
    "tStartMs": 137010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "which probably is wrong,"
    } ]
  }, {
    "tStartMs": 138480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and the utility of quantum computers,"
    } ]
  }, {
    "tStartMs": 140310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "which is not yet there."
    } ]
  }, {
    "tStartMs": 141870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So that's an example of bad communication,"
    } ]
  }, {
    "tStartMs": 144180,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "very bad communication."
    } ]
  }, {
    "tStartMs": 145350,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "I was embarrassed,"
    } ]
  }, {
    "tStartMs": 146340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I was angry with my\ncolleagues who did that."
    } ]
  }, {
    "tStartMs": 148680,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- To me, it looks like the source"
    } ]
  }, {
    "tStartMs": 150420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of this problem is bad incentives."
    } ]
  }, {
    "tStartMs": 152820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Scientists need to secure\nfunding for their research"
    } ]
  }, {
    "tStartMs": 155370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and increasingly that depends on"
    } ]
  }, {
    "tStartMs": 157410,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "attracting public attention to their work."
    } ]
  }, {
    "tStartMs": 159630,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "- It's just become part\nof the culture of science,"
    } ]
  }, {
    "tStartMs": 161643,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "that it's expected that you will have some"
    } ]
  }, {
    "tStartMs": 164310,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "sort of media attention"
    } ]
  }, {
    "tStartMs": 166080,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and to get that attention,\nyou have to sell your science"
    } ]
  }, {
    "tStartMs": 169470,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and often it's not the\nresult of the science"
    } ]
  }, {
    "tStartMs": 172560,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that is the story, it's something else."
    } ]
  }, {
    "tStartMs": 175290,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Universities seek to promote themselves"
    } ]
  }, {
    "tStartMs": 177690,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to attract students and\nbolster their reputations."
    } ]
  }, {
    "tStartMs": 180990,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- And nowhere in the scientific method is,"
    } ]
  }, {
    "tStartMs": 183420,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and you release a press release,"
    } ]
  }, {
    "tStartMs": 186450,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but it's just become part of the norm now."
    } ]
  }, {
    "tStartMs": 189390,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "- Press releases simplify and\nmay overstate the research"
    } ]
  }, {
    "tStartMs": 193830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and journalists just want to get"
    } ]
  }, {
    "tStartMs": 195510,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "as many clicks on their\nstories as they can."
    } ]
  }, {
    "tStartMs": 198510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The end result of this incentivized game"
    } ]
  }, {
    "tStartMs": 201090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of telephone can be oversimplified"
    } ]
  }, {
    "tStartMs": 203640,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "sensationalized headlines,\nscience that is just plain wrong."
    } ]
  }, {
    "tStartMs": 208530,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Now, I myself have been guilty"
    } ]
  }, {
    "tStartMs": 210210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of over-hyping a science story."
    } ]
  }, {
    "tStartMs": 212070,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Back in 2014, I made a video\nabout the bicep two experiment."
    } ]
  }, {
    "tStartMs": 215760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So this is one of the hugest discoveries"
    } ]
  }, {
    "tStartMs": 218340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "in science of all time."
    } ]
  }, {
    "tStartMs": 220020,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Researchers reportedly\ndetected polarization"
    } ]
  }, {
    "tStartMs": 222690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "in the cosmic microwave\nbackground radiation."
    } ]
  }, {
    "tStartMs": 225270,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Allegedly it was caused by\ngravitational fluctuations"
    } ]
  }, {
    "tStartMs": 228360,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "just a fraction of a\nsecond after the big bang."
    } ]
  }, {
    "tStartMs": 231660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The result was considered\nthe first real evidence"
    } ]
  }, {
    "tStartMs": 234300,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of the quantum nature of gravity"
    } ]
  }, {
    "tStartMs": 235710,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and a smoking gun for inflation theory."
    } ]
  }, {
    "tStartMs": 239280,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Experimenters even surprised Andre Lind,"
    } ]
  }, {
    "tStartMs": 241830,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "one of the founders of\ninflation theory with the news."
    } ]
  }, {
    "tStartMs": 245100,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Let's just hope that it is not a trick."
    } ]
  }, {
    "tStartMs": 247830,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "I always leave with this feeling,"
    } ]
  }, {
    "tStartMs": 251520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "what if I'm tricked?"
    } ]
  }, {
    "tStartMs": 253320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "What if I believe in this\njust because it is beautiful?"
    } ]
  }, {
    "tStartMs": 260070,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Unfortunately, further\nobservations showed"
    } ]
  }, {
    "tStartMs": 262410,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that it was likely just\ndust in our own galaxy"
    } ]
  }, {
    "tStartMs": 264960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "rather than primordial gravitational waves"
    } ]
  }, {
    "tStartMs": 267000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that created the polarization in the CMB."
    } ]
  }, {
    "tStartMs": 269760,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So I took down my video"
    } ]
  }, {
    "tStartMs": 271830,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and to this day I am\nwary about making videos"
    } ]
  }, {
    "tStartMs": 274800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "about breaking science news."
    } ]
  }, {
    "tStartMs": 277020,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Like any type of breaking news,\nthere is a high probability"
    } ]
  }, {
    "tStartMs": 280230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that early reports will\nturn out to be wrong."
    } ]
  }, {
    "tStartMs": 282780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Just a few months ago,\na paper was uploaded"
    } ]
  }, {
    "tStartMs": 284910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to the Archive Pre-print Server"
    } ]
  }, {
    "tStartMs": 286710,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "claiming to have discovered\nthe first room temperature"
    } ]
  }, {
    "tStartMs": 289440,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "ambient pressure superconductor."
    } ]
  }, {
    "tStartMs": 291750,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "This again triggered a\nflood of media attention."
    } ]
  }, {
    "tStartMs": 295230,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Reporter] A monumental breakthrough,"
    } ]
  }, {
    "tStartMs": 297660,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "room temperature superconductor LK99."
    } ]
  }, {
    "tStartMs": 302130,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- One of the most important scientific"
    } ]
  }, {
    "tStartMs": 303870,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "breakthroughs of the 21st century."
    } ]
  }, {
    "tStartMs": 306090,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "- If the discovery were real,\nit would've been a big deal."
    } ]
  }, {
    "tStartMs": 309840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- The room temperature\nsuperconductor stuff,"
    } ]
  }, {
    "tStartMs": 311610,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "of course, is such a\ndream 'cause if it worked,"
    } ]
  }, {
    "tStartMs": 315300,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "it would revolutionize everything, right?"
    } ]
  }, {
    "tStartMs": 318390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Transmission of energy,\nthat kind of stuff."
    } ]
  }, {
    "tStartMs": 320760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The world would be different if it worked."
    } ]
  }, {
    "tStartMs": 323340,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- But even before attempts\nto replicate the material"
    } ]
  }, {
    "tStartMs": 325710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and its properties failed,"
    } ]
  }, {
    "tStartMs": 327180,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "there were clear signs\nthat the claim was false."
    } ]
  }, {
    "tStartMs": 330030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "In the only published\nplot showing resistivity"
    } ]
  }, {
    "tStartMs": 332400,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "versus temperature, the\nresistivity did not drop to zero"
    } ]
  }, {
    "tStartMs": 335880,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "as you'd expect at the\nsupposed critical temperature."
    } ]
  }, {
    "tStartMs": 339210,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Instead, it continued to\ndecrease below this value."
    } ]
  }, {
    "tStartMs": 342420,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Plus the resistivity\nscale was given in units"
    } ]
  }, {
    "tStartMs": 344640,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "of 10 to the minus two ohm centimeters."
    } ]
  }, {
    "tStartMs": 347670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "On that scale, any ordinary conductor"
    } ]
  }, {
    "tStartMs": 349890,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "would appear to have zero resistivity."
    } ]
  }, {
    "tStartMs": 352200,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Copper's resistivity, for example,"
    } ]
  }, {
    "tStartMs": 353940,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "is on the order of 10 to the\nminus six ohm centimeters."
    } ]
  }, {
    "tStartMs": 357360,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "A video showed the material\napparently levitating"
    } ]
  }, {
    "tStartMs": 360090,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "above a permanent magnet\nin a supposed demonstration"
    } ]
  }, {
    "tStartMs": 363210,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of the Meisner effect."
    } ]
  }, {
    "tStartMs": 364830,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But in that same video, the material"
    } ]
  }, {
    "tStartMs": 367020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "also sticks to the magnet,"
    } ]
  }, {
    "tStartMs": 368820,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "something a superconductor would not do."
    } ]
  }, {
    "tStartMs": 371850,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And finally there is this plot,"
    } ]
  }, {
    "tStartMs": 374250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "showing that over the\npast a hundred years,"
    } ]
  }, {
    "tStartMs": 376200,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "scientists have found new materials"
    } ]
  }, {
    "tStartMs": 378150,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "with progressively higher\ncritical temperatures."
    } ]
  }, {
    "tStartMs": 380910,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But as of now, all the\nhighest temperature materials"
    } ]
  }, {
    "tStartMs": 384210,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "only super conduct at very high pressures."
    } ]
  }, {
    "tStartMs": 386790,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "For an ambient pressure room\ntemperature superconductor,"
    } ]
  }, {
    "tStartMs": 389850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "we would need a jump\nin critical temperature"
    } ]
  }, {
    "tStartMs": 392040,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "of around 125 degrees Celsius."
    } ]
  }, {
    "tStartMs": 395370,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "That's a lot and this brings up the point"
    } ]
  }, {
    "tStartMs": 397920,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that it is the most unexpected\nand surprising results"
    } ]
  }, {
    "tStartMs": 401070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that get the most attention,"
    } ]
  }, {
    "tStartMs": 402930,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "but it is also these very same results"
    } ]
  }, {
    "tStartMs": 404970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that are the most likely to be false."
    } ]
  }, {
    "tStartMs": 407610,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "In social science, it's\nbeen shown that studies"
    } ]
  }, {
    "tStartMs": 409980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that later fail to be replicated,"
    } ]
  }, {
    "tStartMs": 411990,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "receive on average 153 more citations"
    } ]
  }, {
    "tStartMs": 415560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "than studies that can be replicated."
    } ]
  }, {
    "tStartMs": 417810,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Similar buzz surrounds faulty research"
    } ]
  }, {
    "tStartMs": 419570,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "in the physical sciences."
    } ]
  }, {
    "tStartMs": 421170,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- The Italians, I'm Italian,"
    } ]
  }, {
    "tStartMs": 423060,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "came out announcing into\nthe world some time ago"
    } ]
  }, {
    "tStartMs": 426240,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that the neutrino was faster than light"
    } ]
  }, {
    "tStartMs": 428010,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and then measured it and\nit turned out to be a plug"
    } ]
  }, {
    "tStartMs": 431430,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that was not fitting well"
    } ]
  }, {
    "tStartMs": 433500,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and so the entire machine\nwas not working well."
    } ]
  }, {
    "tStartMs": 436230,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- When the truth is discovered,"
    } ]
  }, {
    "tStartMs": 438030,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "it rarely gets as much attention\nas the original finding."
    } ]
  }, {
    "tStartMs": 441660,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "- The fallout where everybody was going,"
    } ]
  }, {
    "tStartMs": 443317,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "\"Oh, well this doesn't work\nand this doesn't look right"
    } ]
  }, {
    "tStartMs": 445957,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "\"and there's no way this material can do"
    } ]
  }, {
    "tStartMs": 447757,
    "dDurationMs": 1313,
    "segs": [ {
      "utf8": "\"what they say it's doing.\""
    } ]
  }, {
    "tStartMs": 449070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "That sort of fizzles in the background,"
    } ]
  }, {
    "tStartMs": 451380,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "it doesn't get the same media attention."
    } ]
  }, {
    "tStartMs": 453630,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "- There is the apt saying,"
    } ]
  }, {
    "tStartMs": 455107,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "\"A lie can travel around the world"
    } ]
  }, {
    "tStartMs": 456817,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "\"while the truth is still\nputting on its shoes.\""
    } ]
  }, {
    "tStartMs": 459780,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But that saying might need to be updated"
    } ]
  }, {
    "tStartMs": 461730,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "in the age of social\nmedia when lies now have"
    } ]
  }, {
    "tStartMs": 464430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "an even greater advantage."
    } ]
  }, {
    "tStartMs": 466620,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Do you think it's a bigger\nproblem now than it used to be?"
    } ]
  }, {
    "tStartMs": 470220,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- I must admit that I\nthink it's getting worse."
    } ]
  }, {
    "tStartMs": 472590,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "I think there's a feeling"
    } ]
  }, {
    "tStartMs": 473760,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "that you've got to change the world"
    } ]
  }, {
    "tStartMs": 477150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to be noticed by the media."
    } ]
  }, {
    "tStartMs": 479250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Over-hyping science\ndiscoveries can give people"
    } ]
  }, {
    "tStartMs": 481560,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "a false sense of how science works."
    } ]
  }, {
    "tStartMs": 485100,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "If that latest discovery I hear\nabout turns out to be false,"
    } ]
  }, {
    "tStartMs": 488130,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "what else could be untrue?"
    } ]
  }, {
    "tStartMs": 490050,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- People keep telling me\nthat cosmology's in crisis"
    } ]
  }, {
    "tStartMs": 492930,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and all this kind of stuff\nbecause that's the kind of stories"
    } ]
  }, {
    "tStartMs": 495210,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "they hear in the media."
    } ]
  }, {
    "tStartMs": 496680,
    "dDurationMs": 937,
    "segs": [ {
      "utf8": "Eventually people will say,"
    } ]
  }, {
    "tStartMs": 497617,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "\"Well, why are we funding these things"
    } ]
  }, {
    "tStartMs": 500137,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "\"if it's always just turmoil?\""
    } ]
  }, {
    "tStartMs": 502170,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Making bold unsubstantiated claims"
    } ]
  }, {
    "tStartMs": 504420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "also reduces trust in scientists."
    } ]
  }, {
    "tStartMs": 507120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- So we are enlarging a little bit."
    } ]
  }, {
    "tStartMs": 510360,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "The conversation here is not\njust single pieces of news."
    } ]
  }, {
    "tStartMs": 514980,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "I think there are entire\nfields which are hyped."
    } ]
  }, {
    "tStartMs": 518730,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "- Wait, entire fields of science that are-"
    } ]
  }, {
    "tStartMs": 522390,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Yes.\n- Hyped."
    } ]
  }, {
    "tStartMs": 523590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 524423,
    "dDurationMs": 1447,
    "segs": [ {
      "utf8": "- But aren't really legit"
    } ]
  }, {
    "tStartMs": 525870,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "or just they're all hot air or..."
    } ]
  }, {
    "tStartMs": 530040,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Oh no, no, they're not hot air."
    } ]
  }, {
    "tStartMs": 531300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Host] Fusion, fusion's big in the news."
    } ]
  }, {
    "tStartMs": 533610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "People think it's close, right?"
    } ]
  }, {
    "tStartMs": 534870,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There's startups,"
    } ]
  }, {
    "tStartMs": 535703,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "there's people getting\nbillions of dollars."
    } ]
  }, {
    "tStartMs": 537390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Exactly, I don't know\nwhere we are there."
    } ]
  }, {
    "tStartMs": 539610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Again, it's not my field,"
    } ]
  }, {
    "tStartMs": 541170,
    "dDurationMs": 2888,
    "segs": [ {
      "utf8": "but there was one particular announcement,"
    } ]
  }, {
    "tStartMs": 544058,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "what is it?"
    } ]
  }, {
    "tStartMs": 544891,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "One year ago or something."
    } ]
  }, {
    "tStartMs": 545724,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "- [Host] I remember this announcement."
    } ]
  }, {
    "tStartMs": 547290,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- Scientists have produced\na nuclear fusion reaction"
    } ]
  }, {
    "tStartMs": 550770,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that created more energy\nthan was expended,"
    } ]
  }, {
    "tStartMs": 553710,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "a breakthrough to tap into\nthe same kind of energy"
    } ]
  }, {
    "tStartMs": 556740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that powers the sun and the stars."
    } ]
  }, {
    "tStartMs": 559110,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- Simply put, this is one of the most"
    } ]
  }, {
    "tStartMs": 562350,
    "dDurationMs": 4316,
    "segs": [ {
      "utf8": "impressive scientific\nfeats of the 21st century."
    } ]
  }, {
    "tStartMs": 566666,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "(audience applauding)\nRight?"
    } ]
  }, {
    "tStartMs": 575158,
    "dDurationMs": 1142,
    "segs": [ {
      "utf8": "(audience applauding)"
    } ]
  }, {
    "tStartMs": 576300,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Which is bull (beep) again"
    } ]
  }, {
    "tStartMs": 578070,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "because it was in the\ncontext of military research,"
    } ]
  }, {
    "tStartMs": 583950,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "nuclear energy, basically for\nweapons in a way of doing it,"
    } ]
  }, {
    "tStartMs": 590400,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "which at the present, has no visible way"
    } ]
  }, {
    "tStartMs": 595260,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "of how to become industrial\nway of producing energy."
    } ]
  }, {
    "tStartMs": 599220,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Host] Yeah, there's no way to scale."
    } ]
  }, {
    "tStartMs": 600990,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- There's no way to scale it up."
    } ]
  }, {
    "tStartMs": 602370,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Host] This is just lasers at appellate."
    } ]
  }, {
    "tStartMs": 604800,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "- Just little thing and\nyou compress it enormously"
    } ]
  }, {
    "tStartMs": 608820,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and then it's basically it explodes"
    } ]
  }, {
    "tStartMs": 611640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "because it's a mini,\nmini nuclear explosion"
    } ]
  }, {
    "tStartMs": 614460,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and then you have more energy"
    } ]
  }, {
    "tStartMs": 617070,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "than the actual pressure energy"
    } ]
  }, {
    "tStartMs": 621390,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that was needed to compress it."
    } ]
  }, {
    "tStartMs": 623220,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "That's correct, but you\nneed huge amount of,"
    } ]
  }, {
    "tStartMs": 625507,
    "dDurationMs": 1673,
    "segs": [ {
      "utf8": "excessive energy for doing that."
    } ]
  }, {
    "tStartMs": 627180,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "That was sold as a big step\ntoward the solving the energetic"
    } ]
  }, {
    "tStartMs": 631140,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "problem of the world, but it's not."
    } ]
  }, {
    "tStartMs": 634110,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "- Back in '87, fusion,"
    } ]
  }, {
    "tStartMs": 637710,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "already people were talking about it"
    } ]
  }, {
    "tStartMs": 639060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "like it's around the corner."
    } ]
  }, {
    "tStartMs": 641040,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "We just need 20 years more\nwork and we'll crack it."
    } ]
  }, {
    "tStartMs": 645090,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And we have exactly the same story today"
    } ]
  }, {
    "tStartMs": 647130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "with the current experiments."
    } ]
  }, {
    "tStartMs": 650070,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Something that is not overhyped"
    } ]
  }, {
    "tStartMs": 652050,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is this video sponsor, Shopify."
    } ]
  }, {
    "tStartMs": 654450,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And I would know, because I've been"
    } ]
  }, {
    "tStartMs": 656250,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "personally using Shopify for eight years."
    } ]
  }, {
    "tStartMs": 659460,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "You know something a lot of\npeople don't know about me"
    } ]
  }, {
    "tStartMs": 661230,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is that before I was a YouTuber,"
    } ]
  }, {
    "tStartMs": 663240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I worked as a science\nteacher at a tutoring company"
    } ]
  }, {
    "tStartMs": 665880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in Sydney."
    } ]
  }, {
    "tStartMs": 667080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But I was always frustrated\nby this misconception"
    } ]
  }, {
    "tStartMs": 670200,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "students had that bonds\nstore energy, they don't."
    } ]
  }, {
    "tStartMs": 674220,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So I decided to make a better version"
    } ]
  }, {
    "tStartMs": 676260,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of the traditional ball and\nstick model of molecules."
    } ]
  }, {
    "tStartMs": 679500,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "One where the atoms snapped\ntogether magnetically."
    } ]
  }, {
    "tStartMs": 682950,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I came across these little ball magnets"
    } ]
  }, {
    "tStartMs": 685590,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and in my first prototype I pushed them"
    } ]
  }, {
    "tStartMs": 687570,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "inside little styrofoam\nballs and I learned"
    } ]
  }, {
    "tStartMs": 690540,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "about plastics and injection\nmolding, ultrasonic welding,"
    } ]
  }, {
    "tStartMs": 693450,
    "dDurationMs": 2895,
    "segs": [ {
      "utf8": "and I brought my\ninvention Snatoms to life."
    } ]
  }, {
    "tStartMs": 696345,
    "dDurationMs": 2445,
    "segs": [ {
      "utf8": "(magnets clicking)"
    } ]
  }, {
    "tStartMs": 698790,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But one thing I had no clue about"
    } ]
  }, {
    "tStartMs": 700410,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "was how to run an online store"
    } ]
  }, {
    "tStartMs": 702570,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and that's where Shopify came in."
    } ]
  }, {
    "tStartMs": 704580,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "They had simple templates."
    } ]
  }, {
    "tStartMs": 705840,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So I set up the Snatoms\nstore in just one day."
    } ]
  }, {
    "tStartMs": 709410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Shopify allowed me to process payments,"
    } ]
  }, {
    "tStartMs": 711810,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "withhold appropriate state taxes"
    } ]
  }, {
    "tStartMs": 713520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and see everything that was happening"
    } ]
  }, {
    "tStartMs": 715200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with my store at a glance."
    } ]
  }, {
    "tStartMs": 716910,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Plus, it also integrates"
    } ]
  }, {
    "tStartMs": 717990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with lots of third party apps and sites."
    } ]
  }, {
    "tStartMs": 720060,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, for example, I could offer\nmultiple different methods"
    } ]
  }, {
    "tStartMs": 723060,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of shipping and this\nmakes fulfillment a snap."
    } ]
  }, {
    "tStartMs": 726020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(magnet clicking)"
    } ]
  }, {
    "tStartMs": 726853,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "I also got set up for Google shopping"
    } ]
  }, {
    "tStartMs": 728700,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "right from within the app"
    } ]
  }, {
    "tStartMs": 730290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and it was simple to create\nautomated reminder emails"
    } ]
  }, {
    "tStartMs": 733320,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "like if someone forgets\nsomething in their cart."
    } ]
  }, {
    "tStartMs": 735810,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The whole store runs with\nvery little attention from me,"
    } ]
  }, {
    "tStartMs": 739170,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "which is great because I'm\nalways working on the next video."
    } ]
  }, {
    "tStartMs": 742980,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So I think there is a reason\nthat everyone is using Shopify"
    } ]
  }, {
    "tStartMs": 746160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "for their online store\nor their side hustle,"
    } ]
  }, {
    "tStartMs": 748800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "because it offers\neverything you could want,"
    } ]
  }, {
    "tStartMs": 751380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it's easy to use and it's very affordable."
    } ]
  }, {
    "tStartMs": 754080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I highly recommend Shopify to anyone"
    } ]
  }, {
    "tStartMs": 755880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "who's thinking about starting a business"
    } ]
  }, {
    "tStartMs": 757470,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and for a free trial of Shopify,"
    } ]
  }, {
    "tStartMs": 759570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "go to shopify.com/veritasium."
    } ]
  }, {
    "tStartMs": 762390,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "And now back to science hype."
    } ]
  }, {
    "tStartMs": 765720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Science is interesting in\nthat you can divide it up"
    } ]
  }, {
    "tStartMs": 768210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "into basically two categories."
    } ]
  }, {
    "tStartMs": 770490,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "One is an established body of knowledge"
    } ]
  }, {
    "tStartMs": 773100,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and the other is speculations,\nthings that might be true,"
    } ]
  }, {
    "tStartMs": 776850,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but we don't really have any\nsolid evidence for them yet."
    } ]
  }, {
    "tStartMs": 779370,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And because there can be\nan infinity of bad ideas"
    } ]
  }, {
    "tStartMs": 782790,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and only one truth,"
    } ]
  }, {
    "tStartMs": 783990,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "most of these speculations\nare likely wrong."
    } ]
  }, {
    "tStartMs": 787260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But the way certain topics\nare discussed in the media,"
    } ]
  }, {
    "tStartMs": 789540,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "it may be impossible to tell"
    } ]
  }, {
    "tStartMs": 791100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "if they're part of the\nestablished body of knowledge"
    } ]
  }, {
    "tStartMs": 793500,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "or just very fanciful speculation."
    } ]
  }, {
    "tStartMs": 796110,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "- There are too many\nbooks out there saying,"
    } ]
  }, {
    "tStartMs": 797737,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "\"We have understood that the world's"
    } ]
  }, {
    "tStartMs": 798877,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "\"made by strings and string theory.\""
    } ]
  }, {
    "tStartMs": 801120,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It's not true, not at all."
    } ]
  }, {
    "tStartMs": 803100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We have not understood that the world"
    } ]
  }, {
    "tStartMs": 804780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "is described as string theory."
    } ]
  }, {
    "tStartMs": 806160,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "We have a very interesting\ntentative theory,"
    } ]
  }, {
    "tStartMs": 808530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which is string theory,\nwhich has that some success"
    } ]
  }, {
    "tStartMs": 810840,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and some failures and that's interesting."
    } ]
  }, {
    "tStartMs": 814320,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "If you want to tell about this research,"
    } ]
  }, {
    "tStartMs": 818430,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "do tell about this research,"
    } ]
  }, {
    "tStartMs": 820050,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "but don't tell people that"
    } ]
  }, {
    "tStartMs": 823980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "it's what we have learned about the world."
    } ]
  }, {
    "tStartMs": 826440,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "- One question I have is,"
    } ]
  }, {
    "tStartMs": 830988,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "how do we get past the\nover-hyping of science?"
    } ]
  }, {
    "tStartMs": 833100,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Because it seems like the system is set up"
    } ]
  }, {
    "tStartMs": 835410,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to reward over-hyping."
    } ]
  }, {
    "tStartMs": 837540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "It rewards the journalists\n'cause they get the clicks."
    } ]
  }, {
    "tStartMs": 839670,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "It rewards the scientists,"
    } ]
  }, {
    "tStartMs": 840840,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they may get the money or the attention."
    } ]
  }, {
    "tStartMs": 843150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So I don't know, I'm kind of curious"
    } ]
  }, {
    "tStartMs": 845250,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "whether a solution is possible."
    } ]
  }, {
    "tStartMs": 848160,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "- Yeah, I think there is one,"
    } ]
  }, {
    "tStartMs": 851670,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "and it's exactly what you're doing."
    } ]
  }, {
    "tStartMs": 855750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "By talking about the fact"
    } ]
  }, {
    "tStartMs": 858510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that there is a risk of overhyping."
    } ]
  }, {
    "tStartMs": 861090,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "If I can go out and say,"
    } ]
  }, {
    "tStartMs": 862327,
    "dDurationMs": 3653,
    "segs": [ {
      "utf8": "\"Oh, my quantum computer\nproduced a wormhole,\""
    } ]
  }, {
    "tStartMs": 865980,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and nobody says anything,\nthat's a problem."
    } ]
  }, {
    "tStartMs": 870000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If we talk about the risk of over-hyping,"
    } ]
  }, {
    "tStartMs": 872400,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "if we talk about the\nrisk of presenting ideas,"
    } ]
  }, {
    "tStartMs": 876510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "theories, radical results,"
    } ]
  }, {
    "tStartMs": 878610,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "which are very, very tentative, as solid,"
    } ]
  }, {
    "tStartMs": 882720,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "then we sort of immunize\nourself against this danger."
    } ]
  }, {
    "tStartMs": 887910,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Science is not presented on the news"
    } ]
  }, {
    "tStartMs": 889380,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "like sport is presented on the news."
    } ]
  }, {
    "tStartMs": 891680,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "At the end of the news, you\nget 10 minutes of sports"
    } ]
  }, {
    "tStartMs": 894120,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "where they will talk about the fact"
    } ]
  }, {
    "tStartMs": 895470,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that somebody kicked a\nball around in a field"
    } ]
  }, {
    "tStartMs": 897600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and it's not that particularly important."
    } ]
  }, {
    "tStartMs": 899460,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So you get the full rundown"
    } ]
  }, {
    "tStartMs": 900870,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "of lots of bits and\npieces of what's going on."
    } ]
  }, {
    "tStartMs": 903810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But to get a science story,"
    } ]
  }, {
    "tStartMs": 905880,
    "dDurationMs": 2007,
    "segs": [ {
      "utf8": "it has to be Earth\nshattering kind of thing."
    } ]
  }, {
    "tStartMs": 907887,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "It has to be a big story."
    } ]
  }, {
    "tStartMs": 910320,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "What many scientists would\nlike is this larger picture"
    } ]
  }, {
    "tStartMs": 914790,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "of the fact that the entire\nenterprise is moving forward."
    } ]
  }, {
    "tStartMs": 918810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That there are lots of things happening"
    } ]
  }, {
    "tStartMs": 920850,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and we definitely know more\ntomorrow than we do today,"
    } ]
  }, {
    "tStartMs": 924360,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "but that's not the way that it\ngets picked up by the media."
    } ]
  }, {
    "tStartMs": 927750,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Well, ultimately, almost\neveryone is incentivized"
    } ]
  }, {
    "tStartMs": 930450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to sensationalize scientific findings."
    } ]
  }, {
    "tStartMs": 932970,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So I think it's important to remember that"
    } ]
  }, {
    "tStartMs": 934650,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "anytime you hear a\nscience story on the news,"
    } ]
  }, {
    "tStartMs": 937650,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "surprising, unexpected results"
    } ]
  }, {
    "tStartMs": 939690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that have not been\nindependently replicated,"
    } ]
  }, {
    "tStartMs": 942270,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "they are more likely than not to be wrong."
    } ]
  }, {
    "tStartMs": 945300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But despite this, I remain\nconvinced that science"
    } ]
  }, {
    "tStartMs": 947880,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "is the best way to get at the truth."
    } ]
  }, {
    "tStartMs": 950370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I mean, sure, in the short term,"
    } ]
  }, {
    "tStartMs": 952650,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "some may seek the spotlight"
    } ]
  }, {
    "tStartMs": 954030,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "by rushing the data analysis,"
    } ]
  }, {
    "tStartMs": 955830,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "overstating results or\ncircumventing peer review."
    } ]
  }, {
    "tStartMs": 959250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but in the long term,"
    } ]
  }, {
    "tStartMs": 960900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that is not going to\nwin you the Nobel Prize."
    } ]
  }, {
    "tStartMs": 964200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The bold claims, mistakes and dead ends,"
    } ]
  }, {
    "tStartMs": 966900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "they will fade into oblivion"
    } ]
  }, {
    "tStartMs": 969300,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and only sound science\nthat is vigorously tested"
    } ]
  }, {
    "tStartMs": 972150,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and independently validated,"
    } ]
  }, {
    "tStartMs": 973950,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "that is what makes it into the\naccepted body of knowledge."
    } ]
  }, {
    "tStartMs": 981394,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(magnets clicking)"
    } ]
  } ]
}
