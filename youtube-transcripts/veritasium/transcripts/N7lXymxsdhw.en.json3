    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "veritasium to five hundred five hundred\nand browse their unmatched selection of"
    } ]
  }, {
    "tStartMs": 456000,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "audio content. So I want to thank Audible\nfor supporting me and I want to thank"
    } ]
  }, {
