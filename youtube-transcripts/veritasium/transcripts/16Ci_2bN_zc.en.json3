{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] What would happen\nif you dropped a penny"
    } ]
  }, {
    "tStartMs": 1890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "off the Empire State Building?"
    } ]
  }, {
    "tStartMs": 3810,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Could it kill someone walking\non the sidewalk below?"
    } ]
  }, {
    "tStartMs": 6930,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "What does it take to\ncreate a deadly projectile?"
    } ]
  }, {
    "tStartMs": 11610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Well, I'm gonna put this to the test"
    } ]
  }, {
    "tStartMs": 13170,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "with original MythBuster Adam Savage."
    } ]
  }, {
    "tStartMs": 15630,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "He's going up in a helicopter\nto throw pennies at me."
    } ]
  }, {
    "tStartMs": 19530,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "No one hasn't heard that story."
    } ]
  }, {
    "tStartMs": 21270,
    "dDurationMs": 1115,
    "segs": [ {
      "utf8": "- When you talk about it,"
    } ]
  }, {
    "tStartMs": 22385,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "people are like, \"Oh yeah,"
    } ]
  }, {
    "tStartMs": 23218,
    "dDurationMs": 1112,
    "segs": [ {
      "utf8": "the penny from the Empire State Building.\""
    } ]
  }, {
    "tStartMs": 24330,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And when we went to the\nEmpire State Building,"
    } ]
  }, {
    "tStartMs": 26400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "every ledge below the observation deck"
    } ]
  }, {
    "tStartMs": 28800,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "is filled with change."
    } ]
  }, {
    "tStartMs": 31170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I just love the idea of all these people."
    } ]
  }, {
    "tStartMs": 33000,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "They're not murderers, but they're like,"
    } ]
  }, {
    "tStartMs": 34560,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it's probably not true."
    } ]
  }, {
    "tStartMs": 35880,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "They're like throwing\npennies over the side"
    } ]
  }, {
    "tStartMs": 37290,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "thinking it's probably not true."
    } ]
  }, {
    "tStartMs": 39360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- [Derek] A penny weighs\naround two and a half grams,"
    } ]
  }, {
    "tStartMs": 41880,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "which is about half to a\nquarter the weight of a bullet."
    } ]
  }, {
    "tStartMs": 45810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "If you ignore air resistance,"
    } ]
  }, {
    "tStartMs": 47580,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "a penny dropped from the\nEmpire State Building,"
    } ]
  }, {
    "tStartMs": 50070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which is 443 meters to the very top,"
    } ]
  }, {
    "tStartMs": 53190,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "would accelerate to over\n300 kilometers per hour"
    } ]
  }, {
    "tStartMs": 56400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "by the time it hits the ground."
    } ]
  }, {
    "tStartMs": 58410,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "That's around half as\nfast as a typical bullet."
    } ]
  }, {
    "tStartMs": 64650,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The MythBusters made contraptions"
    } ]
  }, {
    "tStartMs": 66360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to shoot pennies at each other."
    } ]
  }, {
    "tStartMs": 67800,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- Stephen Colbert shot me in\nthe ass with it a few times."
    } ]
  }, {
    "tStartMs": 71010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- How did it feel?"
    } ]
  }, {
    "tStartMs": 71843,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": "It's a baseball pitcher\nthrowing a penny hard at you."
    } ]
  }, {
    "tStartMs": 74280,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "- Yeah.\n- It'll sting."
    } ]
  }, {
    "tStartMs": 76350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] But they never\ntried the ultimate test."
    } ]
  }, {
    "tStartMs": 78630,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Dropping pennies"
    } ]
  }, {
    "tStartMs": 79463,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "from the height of the\nEmpire State Building"
    } ]
  }, {
    "tStartMs": 81330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "onto someone below."
    } ]
  }, {
    "tStartMs": 83160,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And that's what we're\ngonna do here with Adam."
    } ]
  }, {
    "tStartMs": 86190,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- That'd be great watching\nit bounce off your body."
    } ]
  }, {
    "tStartMs": 89040,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] Yeah, yeah."
    } ]
  }, {
    "tStartMs": 91320,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "- I say this thinking it's\nalways been my body until now."
    } ]
  }, {
    "tStartMs": 96840,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "First one, I'll drop the pennies"
    } ]
  }, {
    "tStartMs": 98160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "to see where it's gonna land."
    } ]
  }, {
    "tStartMs": 99300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You're gonna walk there."
    } ]
  }, {
    "tStartMs": 100133,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "I'll throw a second one,"
    } ]
  }, {
    "tStartMs": 101520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "that's good for you.\n- Yeah."
    } ]
  }, {
    "tStartMs": 102780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- And then you're ready for the full dump."
    } ]
  }, {
    "tStartMs": 104820,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 105660,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(tense music)\n(helicopter engine revving)"
    } ]
  }, {
    "tStartMs": 118710,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- I'm going underneath helicopter"
    } ]
  }, {
    "tStartMs": 120750,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where Adam Savage is gonna\ndrop a whole bunch of pennies"
    } ]
  }, {
    "tStartMs": 123450,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "on me."
    } ]
  }, {
    "tStartMs": 124916,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "What are we even doing?"
    } ]
  }, {
    "tStartMs": 127350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I know I agreed to do this"
    } ]
  }, {
    "tStartMs": 128940,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and I didn't think I'd get hurt,"
    } ]
  }, {
    "tStartMs": 130950,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but as I'm walking out\nunder the helicopter,"
    } ]
  }, {
    "tStartMs": 133740,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I started to think, no one\nhas actually done this."
    } ]
  }, {
    "tStartMs": 137310,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "We planned for pennies\nfalling through still air,"
    } ]
  }, {
    "tStartMs": 140610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but the helicopter\ncreates a huge downdraft"
    } ]
  }, {
    "tStartMs": 143460,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "to support its weight."
    } ]
  }, {
    "tStartMs": 144682,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "- In 3, 2, 1."
    } ]
  }, {
    "tStartMs": 151098,
    "dDurationMs": 4152,
    "segs": [ {
      "utf8": "- Oh boy, I hear them landing around me."
    } ]
  }, {
    "tStartMs": 155250,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "I start to imagine pennies\ngouging into my shoulders."
    } ]
  }, {
    "tStartMs": 159420,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "You can see how tense my body looks."
    } ]
  }, {
    "tStartMs": 162630,
    "dDurationMs": 3209,
    "segs": [ {
      "utf8": "- Ah, one hit my helmet"
    } ]
  }, {
    "tStartMs": 165839,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "in 3, 2, 1."
    } ]
  }, {
    "tStartMs": 171006,
    "dDurationMs": 4164,
    "segs": [ {
      "utf8": "- Aaaaaa-hahaha-owwww,\nthat hit my shoulder."
    } ]
  }, {
    "tStartMs": 175170,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "AAAAaAAh."
    } ]
  }, {
    "tStartMs": 176453,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(slow-motion screaming)"
    } ]
  }, {
    "tStartMs": 181020,
    "dDurationMs": 1304,
    "segs": [ {
      "utf8": "- That's really good."
    } ]
  }, {
    "tStartMs": 182324,
    "dDurationMs": 4216,
    "segs": [ {
      "utf8": "In 3, 2, 1."
    } ]
  }, {
    "tStartMs": 186540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- They feel like tiny little bullets."
    } ]
  }, {
    "tStartMs": 188760,
    "dDurationMs": 3135,
    "segs": [ {
      "utf8": "I feel like I'm gonna\nbe bruised after this."
    } ]
  }, {
    "tStartMs": 191895,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 194976,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Okay, I'm laying down, I'm going for it."
    } ]
  }, {
    "tStartMs": 200103,
    "dDurationMs": 2395,
    "segs": [ {
      "utf8": "- Here we go, doing the whole thing."
    } ]
  }, {
    "tStartMs": 202498,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "In 3, 2, 1."
    } ]
  }, {
    "tStartMs": 207213,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(Guitar riff)"
    } ]
  }, {
    "tStartMs": 228225,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "Unbelievable."
    } ]
  }, {
    "tStartMs": 231661,
    "dDurationMs": 929,
    "segs": [ {
      "utf8": "There you have it."
    } ]
  }, {
    "tStartMs": 232590,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "A penny dropped from the\nEmpire State Building"
    } ]
  }, {
    "tStartMs": 235260,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is not gonna hurt."
    } ]
  }, {
    "tStartMs": 237360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I mean it hurts a little, but not a lot."
    } ]
  }, {
    "tStartMs": 239610,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "You'll be alright."
    } ]
  }, {
    "tStartMs": 241500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That was great."
    } ]
  }, {
    "tStartMs": 242333,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "I saw little dust clouds all around you."
    } ]
  }, {
    "tStartMs": 243930,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Amazing."
    } ]
  }, {
    "tStartMs": 244763,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "- Tell me what it was like down here."
    } ]
  }, {
    "tStartMs": 246000,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- I was terrified."
    } ]
  }, {
    "tStartMs": 246900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I got out there and the\nrotor wash is so heavy."
    } ]
  }, {
    "tStartMs": 248910,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "I'm like, maybe we haven't\ncalculated for rotor wash."
    } ]
  }, {
    "tStartMs": 253410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It stung to get hit by\npennies falling that far,"
    } ]
  }, {
    "tStartMs": 256500,
    "dDurationMs": 3108,
    "segs": [ {
      "utf8": "but it certainly wasn't fatal."
    } ]
  }, {
    "tStartMs": 259608,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 263250,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "So why aren't pennies more dangerous?"
    } ]
  }, {
    "tStartMs": 266970,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "Well, the reason is air resistance."
    } ]
  }, {
    "tStartMs": 270480,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [David Scott] And I'll\ndrop the two of 'em here"
    } ]
  }, {
    "tStartMs": 272340,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and hopefully they'll hit\nthe ground at the same time."
    } ]
  }, {
    "tStartMs": 275040,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Take the classic experiment\nof a hammer and feather"
    } ]
  }, {
    "tStartMs": 277290,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "dropped simultaneously on the moon."
    } ]
  }, {
    "tStartMs": 279720,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "In the near vacuum of the moon's surface,"
    } ]
  }, {
    "tStartMs": 281850,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "both objects speed up at the same rate"
    } ]
  }, {
    "tStartMs": 283890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "due to the moon's gravity,"
    } ]
  }, {
    "tStartMs": 285330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and they're both still accelerating"
    } ]
  }, {
    "tStartMs": 287460,
    "dDurationMs": 2305,
    "segs": [ {
      "utf8": "when they hit the ground at the same time."
    } ]
  }, {
    "tStartMs": 289765,
    "dDurationMs": 1805,
    "segs": [ {
      "utf8": "- [David Scott] How 'bout that?"
    } ]
  }, {
    "tStartMs": 291570,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "- Repeat the experiment on earth."
    } ]
  }, {
    "tStartMs": 295200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And of course, the hammer\nlands way before the feather."
    } ]
  }, {
    "tStartMs": 298800,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "If you watch the feather closely,"
    } ]
  }, {
    "tStartMs": 300120,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you'll notice that it\ndoesn't speed up as it falls."
    } ]
  }, {
    "tStartMs": 303120,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "For most of its journey,"
    } ]
  }, {
    "tStartMs": 304080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "it's moving at a constant speed"
    } ]
  }, {
    "tStartMs": 305670,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "known as its terminal velocity."
    } ]
  }, {
    "tStartMs": 310740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Terminal velocity is reached\nwhen the force of gravity"
    } ]
  }, {
    "tStartMs": 313110,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "pulling an object down"
    } ]
  }, {
    "tStartMs": 314310,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "is equal to the force of air\nresistance pushing it up."
    } ]
  }, {
    "tStartMs": 317850,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "In this case,"
    } ]
  }, {
    "tStartMs": 318690,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which object, the hammer or the feather,"
    } ]
  }, {
    "tStartMs": 320850,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "experiences a greater\nforce of air resistance."
    } ]
  }, {
    "tStartMs": 324330,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Well, I bet most people\nwould say the feather"
    } ]
  }, {
    "tStartMs": 326490,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "because its motion is\nclearly affected by drag."
    } ]
  }, {
    "tStartMs": 330120,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But the answer is actually the hammer."
    } ]
  }, {
    "tStartMs": 333210,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Air resistance is\nproportional to speed squared"
    } ]
  }, {
    "tStartMs": 336180,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and the hammer gets going\nmuch faster than the feather"
    } ]
  }, {
    "tStartMs": 338850,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "so it experiences the larger\nforce of air resistance,"
    } ]
  }, {
    "tStartMs": 342690,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but its weight is so much greater"
    } ]
  }, {
    "tStartMs": 345630,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "that drag is negligible in comparison."
    } ]
  }, {
    "tStartMs": 348600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And that's why the\nhammer keeps speeding up"
    } ]
  }, {
    "tStartMs": 351000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "while the feather reaches\nterminal velocity early"
    } ]
  }, {
    "tStartMs": 353430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and just stays at that speed."
    } ]
  }, {
    "tStartMs": 355440,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "It all comes down to the ratio\nof weight to air resistance."
    } ]
  }, {
    "tStartMs": 361140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Every object has its\nown terminal velocity,"
    } ]
  }, {
    "tStartMs": 363720,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the maximum speed it will reach"
    } ]
  }, {
    "tStartMs": 365670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in free fall through still air."
    } ]
  }, {
    "tStartMs": 367860,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "And I went indoor skydiving\nto experience this first hand."
    } ]
  }, {
    "tStartMs": 381363,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "That was so amazing,\nthat was totally wild."
    } ]
  }, {
    "tStartMs": 384450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Objects that have the same size and shape"
    } ]
  }, {
    "tStartMs": 386520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "experience the same air resistance."
    } ]
  }, {
    "tStartMs": 388740,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "But if one is heavier, here\nI've got two identical balls,"
    } ]
  }, {
    "tStartMs": 392550,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "but this one has water added\nto it, so it's heavier,"
    } ]
  }, {
    "tStartMs": 395643,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "then it has a higher terminal velocity"
    } ]
  }, {
    "tStartMs": 397920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so it doesn't float at the same wind speed"
    } ]
  }, {
    "tStartMs": 400440,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "as the lighter object."
    } ]
  }, {
    "tStartMs": 403590,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Conversely,"
    } ]
  }, {
    "tStartMs": 404460,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "some objects are very\ndifferent in size and shape"
    } ]
  }, {
    "tStartMs": 407730,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "like a person and a lacrosse ball,"
    } ]
  }, {
    "tStartMs": 409950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and obviously they have\nvery different weights,"
    } ]
  }, {
    "tStartMs": 412860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but they also experience very different"
    } ]
  }, {
    "tStartMs": 414990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "forces of air resistance."
    } ]
  }, {
    "tStartMs": 416820,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And the key thing is that\nthe ratio of their weight"
    } ]
  }, {
    "tStartMs": 419910,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "to air resistance is\nthe same for both bodies"
    } ]
  }, {
    "tStartMs": 423510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "so they have the same terminal velocity,"
    } ]
  }, {
    "tStartMs": 426090,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "which means they will both\nfloat together in the tunnel."
    } ]
  }, {
    "tStartMs": 429930,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "If you transported the sky\ndiver and lacrosse ball"
    } ]
  }, {
    "tStartMs": 432510,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to the stratosphere,"
    } ]
  }, {
    "tStartMs": 433770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "they would continue to fall together,"
    } ]
  }, {
    "tStartMs": 436290,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "but their joint terminal\nvelocity would be much faster."
    } ]
  }, {
    "tStartMs": 441240,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "In 2012, Felix Baumgartner\njumped from a weather balloon"
    } ]
  }, {
    "tStartMs": 444720,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "39 kilometers above sea level."
    } ]
  }, {
    "tStartMs": 446910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "After just 40 seconds of free fall,"
    } ]
  }, {
    "tStartMs": 449040,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "he reached a terminal velocity"
    } ]
  }, {
    "tStartMs": 450630,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "over 1300 kilometers per hour."
    } ]
  }, {
    "tStartMs": 453630,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It was 25% faster than the speed of sound"
    } ]
  }, {
    "tStartMs": 456840,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "making him the first person\nto break the sound barrier"
    } ]
  }, {
    "tStartMs": 459510,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "outside of a vehicle."
    } ]
  }, {
    "tStartMs": 461400,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "What allowed him to do\nthis was the lack of air"
    } ]
  }, {
    "tStartMs": 463980,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "at that altitude."
    } ]
  }, {
    "tStartMs": 465390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Air resistance is directly proportional"
    } ]
  }, {
    "tStartMs": 467430,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to the density of air\nyou're moving through."
    } ]
  }, {
    "tStartMs": 469560,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And at that altitude,"
    } ]
  }, {
    "tStartMs": 470970,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "the air is 60 times less\ndense than at sea level."
    } ]
  }, {
    "tStartMs": 474690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "As he continued falling\ninto thicker atmosphere,"
    } ]
  }, {
    "tStartMs": 477480,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "the increasing air density\nreduced his terminal velocity"
    } ]
  }, {
    "tStartMs": 481200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and by two and a half\nkilometers above sea level,"
    } ]
  }, {
    "tStartMs": 483480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "he had slowed to 200 kilometers per hour,"
    } ]
  }, {
    "tStartMs": 486360,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "at which point he opened his parachute."
    } ]
  }, {
    "tStartMs": 490200,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now rain also falls kilometers,"
    } ]
  }, {
    "tStartMs": 492960,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "but through the thicker\nair of the troposphere."
    } ]
  }, {
    "tStartMs": 496620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "One of the coolest\nthings in the wind tunnel"
    } ]
  }, {
    "tStartMs": 498540,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "was to see water floating."
    } ]
  }, {
    "tStartMs": 501450,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Poured from a jug,"
    } ]
  }, {
    "tStartMs": 502500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it quickly breaks up into droplets"
    } ]
  }, {
    "tStartMs": 504570,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the same size as raindrops"
    } ]
  }, {
    "tStartMs": 506340,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "from around 0.5 to four\nmillimeters in diameter."
    } ]
  }, {
    "tStartMs": 510870,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And standing there,"
    } ]
  }, {
    "tStartMs": 512430,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "you can experience what it would be like"
    } ]
  }, {
    "tStartMs": 514140,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "to fall with raindrops."
    } ]
  }, {
    "tStartMs": 516543,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 522390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "They have a low terminal velocity"
    } ]
  }, {
    "tStartMs": 524340,
    "dDurationMs": 2427,
    "segs": [ {
      "utf8": "of just 25 kilometers per hour"
    } ]
  }, {
    "tStartMs": 526767,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and that's what the wind speed was set to"
    } ]
  }, {
    "tStartMs": 528690,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for this demonstration."
    } ]
  }, {
    "tStartMs": 530430,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And what you can see"
    } ]
  }, {
    "tStartMs": 531960,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "is that raindrops aren't\nshaped like cartoon raindrops."
    } ]
  }, {
    "tStartMs": 536070,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They are closer to spherical,"
    } ]
  }, {
    "tStartMs": 538320,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but a bit flatter on the bottom"
    } ]
  }, {
    "tStartMs": 540300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "where they encounter oncoming air."
    } ]
  }, {
    "tStartMs": 542760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "If a raindrop gets too big,"
    } ]
  }, {
    "tStartMs": 544440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it flattens out, caves in in the middle"
    } ]
  }, {
    "tStartMs": 546840,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and briefly resembles a little parachute"
    } ]
  }, {
    "tStartMs": 549300,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "before breaking up into smaller droplets."
    } ]
  }, {
    "tStartMs": 552090,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So raindrops aren't damaging,"
    } ]
  }, {
    "tStartMs": 554730,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "but it's a different story for hail."
    } ]
  }, {
    "tStartMs": 557564,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "(hail hitting the ground)"
    } ]
  }, {
    "tStartMs": 559620,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- [Man] I just completely\nlost my windshield right here."
    } ]
  }, {
    "tStartMs": 562320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Derek] Every year in the US,"
    } ]
  }, {
    "tStartMs": 563700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "hail injures around 20 people"
    } ]
  }, {
    "tStartMs": 565890,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and since 2000 it's\ncaused four fatalities."
    } ]
  }, {
    "tStartMs": 569310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "That's because hail can\nreach terminal velocities"
    } ]
  }, {
    "tStartMs": 571590,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "of over 200 kilometers per hour."
    } ]
  }, {
    "tStartMs": 574440,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "That's around 10 times the\nterminal velocity of rain."
    } ]
  }, {
    "tStartMs": 577980,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But why is its terminal\nvelocity so much higher"
    } ]
  }, {
    "tStartMs": 581520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "even though ice itself\nis slightly less dense"
    } ]
  }, {
    "tStartMs": 584280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "than liquid water?"
    } ]
  }, {
    "tStartMs": 586050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "The main thing is that\nhail can get much bigger"
    } ]
  }, {
    "tStartMs": 588660,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "than a raindrop."
    } ]
  }, {
    "tStartMs": 589800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Hailstones have been\nmeasured up to 20 centimeters"
    } ]
  }, {
    "tStartMs": 592560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "in diameter."
    } ]
  }, {
    "tStartMs": 594000,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Now drag is proportional\nto cross sectional area,"
    } ]
  }, {
    "tStartMs": 597540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "so it scales with radius squared,"
    } ]
  }, {
    "tStartMs": 600120,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "whereas weight scales with radius cubed."
    } ]
  }, {
    "tStartMs": 603540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So the bigger the hailstone,"
    } ]
  }, {
    "tStartMs": 605460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the faster its terminal velocity."
    } ]
  }, {
    "tStartMs": 608040,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It also has more mass,"
    } ]
  }, {
    "tStartMs": 609660,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so it carries even more kinetic energy"
    } ]
  }, {
    "tStartMs": 612090,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and packs a bigger punch\nwhen it hits something."
    } ]
  }, {
    "tStartMs": 615930,
    "dDurationMs": 1512,
    "segs": [ {
      "utf8": "Pennies reach terminal\nvelocity after falling"
    } ]
  }, {
    "tStartMs": 617442,
    "dDurationMs": 2808,
    "segs": [ {
      "utf8": "only around 15 meters."
    } ]
  }, {
    "tStartMs": 620250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You can see in this shot the\naverage speed of the pennies"
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "in the top of the frame"
    } ]
  }, {
    "tStartMs": 623970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "is the same as at the bottom of the frame."
    } ]
  }, {
    "tStartMs": 626850,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "They aren't speeding up."
    } ]
  }, {
    "tStartMs": 628260,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "They've reached terminal velocity."
    } ]
  }, {
    "tStartMs": 630690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So it wouldn't matter if\npennies were dropped on you"
    } ]
  }, {
    "tStartMs": 632970,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "from 15 meters or 300\nmeters or 3000 meters,"
    } ]
  }, {
    "tStartMs": 637110,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "it would feel the same"
    } ]
  }, {
    "tStartMs": 638760,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "because they would be\ngoing the same speed."
    } ]
  }, {
    "tStartMs": 641790,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "In fact, we didn't take the helicopter"
    } ]
  }, {
    "tStartMs": 643890,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "all the way up to Empire\nState Building height"
    } ]
  }, {
    "tStartMs": 646110,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "because that wouldn't have increased"
    } ]
  }, {
    "tStartMs": 648150,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the speed of the pennies at all"
    } ]
  }, {
    "tStartMs": 649890,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and it would've just\nmade aiming much harder."
    } ]
  }, {
    "tStartMs": 652770,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- By the end, I'm throwing to account"
    } ]
  }, {
    "tStartMs": 654990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "for this secondary air current"
    } ]
  }, {
    "tStartMs": 656970,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that's moving between\nyou and the helicopter."
    } ]
  }, {
    "tStartMs": 659340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And so the pennies are\nmaking this like 12 foot arc"
    } ]
  }, {
    "tStartMs": 662220,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "all the way over and then coming back."
    } ]
  }, {
    "tStartMs": 667680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- [Derek] One of the reasons\npennies are so hard to aim"
    } ]
  }, {
    "tStartMs": 670320,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "is because they flutter\nand tumble as they fall."
    } ]
  }, {
    "tStartMs": 673680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This tumbling behavior means\npennies don't actually have"
    } ]
  }, {
    "tStartMs": 677520,
    "dDurationMs": 1993,
    "segs": [ {
      "utf8": "a single terminal velocity."
    } ]
  }, {
    "tStartMs": 679513,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "- A penny actually has\ntwo terminal velocities"
    } ]
  }, {
    "tStartMs": 682350,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and it oscillates between them."
    } ]
  }, {
    "tStartMs": 683490,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So it's got one on its\nface and one on its edge."
    } ]
  }, {
    "tStartMs": 686400,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "I've got a wind tunnel that can show you"
    } ]
  }, {
    "tStartMs": 687870,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "exactly how that works."
    } ]
  }, {
    "tStartMs": 688950,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "It's really beautiful."
    } ]
  }, {
    "tStartMs": 689970,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] I gotta see that."
    } ]
  }, {
    "tStartMs": 690803,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "- Yeah, it's really neat."
    } ]
  }, {
    "tStartMs": 691680,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "- Throw to the...\n- Yeah."
    } ]
  }, {
    "tStartMs": 694500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Derek] Adam built a custom wind tunnel"
    } ]
  }, {
    "tStartMs": 696300,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to witness this for himself."
    } ]
  }, {
    "tStartMs": 698190,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So I went to San Francisco\nto his cave to check it out."
    } ]
  }, {
    "tStartMs": 701910,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- This is literally like my\nMythBusters origin story,"
    } ]
  }, {
    "tStartMs": 704400,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "this device."
    } ]
  }, {
    "tStartMs": 705233,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "I'm so delighted to fire this up again."
    } ]
  }, {
    "tStartMs": 707580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- It's like looking at a\npiece of piece of history."
    } ]
  }, {
    "tStartMs": 710040,
    "dDurationMs": 1138,
    "segs": [ {
      "utf8": "How old is this?"
    } ]
  }, {
    "tStartMs": 711178,
    "dDurationMs": 1412,
    "segs": [ {
      "utf8": "- 19 years old now."
    } ]
  }, {
    "tStartMs": 712590,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- It's old enough to drive\nand vote, but not drink."
    } ]
  }, {
    "tStartMs": 715440,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- There's people watching this video,"
    } ]
  }, {
    "tStartMs": 717030,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "you know?\n- Yeah."
    } ]
  }, {
    "tStartMs": 717930,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "- Who weren't alive when\nyou were making this."
    } ]
  }, {
    "tStartMs": 721110,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [Derek] Because of the holes\nwhich allow air to escape,"
    } ]
  }, {
    "tStartMs": 724080,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "this wind tunnel has a\ngradient of wind speeds"
    } ]
  }, {
    "tStartMs": 726870,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "from around a hundred kilometers\nper hour at the bottom"
    } ]
  }, {
    "tStartMs": 729540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "up to 25 kilometers per hour at the top."
    } ]
  }, {
    "tStartMs": 732210,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- This creates a little\nbit of back pressure"
    } ]
  }, {
    "tStartMs": 734130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that popsicle, the tongue\ndepressors up here,"
    } ]
  }, {
    "tStartMs": 735960,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and that back pressure is\nrelieved by these holes enough"
    } ]
  }, {
    "tStartMs": 739590,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "so that the penny spins."
    } ]
  }, {
    "tStartMs": 741000,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] If a penny really has"
    } ]
  }, {
    "tStartMs": 742410,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "two different terminal velocities,"
    } ]
  }, {
    "tStartMs": 744120,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "it should oscillate up and\ndown in this wind tunnel"
    } ]
  }, {
    "tStartMs": 746850,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "as a result."
    } ]
  }, {
    "tStartMs": 747683,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "- There you go."
    } ]
  }, {
    "tStartMs": 749050,
    "dDurationMs": 3314,
    "segs": [ {
      "utf8": "(sound of air rushing by)"
    } ]
  }, {
    "tStartMs": 752364,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "- That's amazing to see\nit oscillate, right?"
    } ]
  }, {
    "tStartMs": 754394,
    "dDurationMs": 886,
    "segs": [ {
      "utf8": "- I know."
    } ]
  }, {
    "tStartMs": 755280,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "The fact that it goes up and down"
    } ]
  }, {
    "tStartMs": 756510,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "and then comes back up again."
    } ]
  }, {
    "tStartMs": 758091,
    "dDurationMs": 1385,
    "segs": [ {
      "utf8": "- Yeah.\n- Oh yeah."
    } ]
  }, {
    "tStartMs": 759476,
    "dDurationMs": 4327,
    "segs": [ {
      "utf8": "- It was just hanging out like that."
    } ]
  }, {
    "tStartMs": 764640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- When in 2003 I dropped\nthe penny on the top"
    } ]
  }, {
    "tStartMs": 767400,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and it went up and down, like I'm still,"
    } ]
  }, {
    "tStartMs": 770550,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "every single time I tell\nthat story, I get goosebumps"
    } ]
  }, {
    "tStartMs": 773040,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "because I remember that\nfeeling of like, Oh wow."
    } ]
  }, {
    "tStartMs": 776820,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] We made a separate\nvideo on Adam's channel"
    } ]
  }, {
    "tStartMs": 778950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that discusses the wind\ntunnel in more detail."
    } ]
  }, {
    "tStartMs": 781050,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "So check it out after this."
    } ]
  }, {
    "tStartMs": 783810,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So the reason pennies aren't dangerous"
    } ]
  }, {
    "tStartMs": 785700,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "is because their terminal\nvelocity is at most"
    } ]
  }, {
    "tStartMs": 788010,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "about 80 kilometers per hour."
    } ]
  }, {
    "tStartMs": 790740,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Yeah, it's not gonna hurt you."
    } ]
  }, {
    "tStartMs": 791730,
    "dDurationMs": 1699,
    "segs": [ {
      "utf8": "- That's busted.\n- Right."
    } ]
  }, {
    "tStartMs": 793429,
    "dDurationMs": 1937,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 795366,
    "dDurationMs": 1194,
    "segs": [ {
      "utf8": "- Think I'm allowed to say like."
    } ]
  }, {
    "tStartMs": 796560,
    "dDurationMs": 949,
    "segs": [ {
      "utf8": "- Like old habit."
    } ]
  }, {
    "tStartMs": 797509,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 798870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But something more aerodynamic"
    } ]
  }, {
    "tStartMs": 800970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "would have a higher terminal velocity."
    } ]
  }, {
    "tStartMs": 803370,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And this has led some to\nsuggest ballpoint pens"
    } ]
  }, {
    "tStartMs": 806580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "falling from a skyscraper\nlike the Empire State Building"
    } ]
  }, {
    "tStartMs": 809640,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "could be lethal."
    } ]
  }, {
    "tStartMs": 810930,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- But supposedly."
    } ]
  }, {
    "tStartMs": 811920,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Yeah, a pen, a ballpoint pen."
    } ]
  }, {
    "tStartMs": 813720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- Is as dangerous as a penny\nis mythically dangerous?"
    } ]
  }, {
    "tStartMs": 816760,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "- Yeah, yeah, like that's."
    } ]
  }, {
    "tStartMs": 817860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Is meant to actually be lethal."
    } ]
  }, {
    "tStartMs": 819780,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "- It's worth really trying."
    } ]
  }, {
    "tStartMs": 824100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- [Derek] These pens weigh\nabout twice as much as a penny"
    } ]
  }, {
    "tStartMs": 827160,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and they have a smaller\ncross-sectional area."
    } ]
  }, {
    "tStartMs": 831390,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- All right, I'm gonna\nstart the first drop."
    } ]
  }, {
    "tStartMs": 833910,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- [Derek] So this will increase\nthe ratio of weight to drag,"
    } ]
  }, {
    "tStartMs": 837000,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "but will it be enough?"
    } ]
  }, {
    "tStartMs": 840000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Now, because I'm not\nsure what will happen,"
    } ]
  }, {
    "tStartMs": 842160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I'm not putting my body\non the line for this one."
    } ]
  }, {
    "tStartMs": 844950,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Instead we'll use a ballistics gel dummy."
    } ]
  }, {
    "tStartMs": 847620,
    "dDurationMs": 889,
    "segs": [ {
      "utf8": "- Here we go."
    } ]
  }, {
    "tStartMs": 848509,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "In 3, 2, 1."
    } ]
  }, {
    "tStartMs": 852380,
    "dDurationMs": 1029,
    "segs": [ {
      "utf8": "Oh, that's very close."
    } ]
  }, {
    "tStartMs": 853409,
    "dDurationMs": 2091,
    "segs": [ {
      "utf8": "Back up again (murmuring)"
    } ]
  }, {
    "tStartMs": 855500,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "3, 2, 1."
    } ]
  }, {
    "tStartMs": 859107,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Oh oh, very close, very close."
    } ]
  }, {
    "tStartMs": 862110,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "Here we go, 3, 2, 1."
    } ]
  }, {
    "tStartMs": 866182,
    "dDurationMs": 1518,
    "segs": [ {
      "utf8": "Oh, oh, almost."
    } ]
  }, {
    "tStartMs": 867700,
    "dDurationMs": 3997,
    "segs": [ {
      "utf8": "Okay, 3, 2, 1."
    } ]
  }, {
    "tStartMs": 871697,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "Oh, almost."
    } ]
  }, {
    "tStartMs": 873166,
    "dDurationMs": 2396,
    "segs": [ {
      "utf8": "3, 2, 1."
    } ]
  }, {
    "tStartMs": 875562,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Okay, last one."
    } ]
  }, {
    "tStartMs": 877222,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "3, 2, 1."
    } ]
  }, {
    "tStartMs": 879972,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Ah, over."
    } ]
  }, {
    "tStartMs": 884292,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "- That might be it"
    } ]
  }, {
    "tStartMs": 885794,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "- Yeah, we're outta pens"
    } ]
  }, {
    "tStartMs": 887214,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(helicopter revving)"
    } ]
  }, {
    "tStartMs": 891990,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The second to last drop,"
    } ]
  }, {
    "tStartMs": 894210,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "we had almost no crosswinds at all."
    } ]
  }, {
    "tStartMs": 896970,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So they dropped perfectly down"
    } ]
  }, {
    "tStartMs": 899220,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and kind of hit right below where we were"
    } ]
  }, {
    "tStartMs": 901680,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "and they were all cattywampus."
    } ]
  }, {
    "tStartMs": 904774,
    "dDurationMs": 4483,
    "segs": [ {
      "utf8": "If the myth was true, I would\nexpect to see this everywhere."
    } ]
  }, {
    "tStartMs": 909257,
    "dDurationMs": 1273,
    "segs": [ {
      "utf8": "- [Derek] Right.\n- [Adam] Right?"
    } ]
  }, {
    "tStartMs": 910530,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "That's what I would expect to see."
    } ]
  }, {
    "tStartMs": 912510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And I don't see a single one"
    } ]
  }, {
    "tStartMs": 915000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and I didn't after we dropped 'em all."
    } ]
  }, {
    "tStartMs": 917430,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "- Are you gonna call it I?"
    } ]
  }, {
    "tStartMs": 918770,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "- (laughs) I will, sure."
    } ]
  }, {
    "tStartMs": 920430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I'll come back outta\nretirement to say busted."
    } ]
  }, {
    "tStartMs": 922590,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Pens are not dangerous\nfalling from tall objects."
    } ]
  }, {
    "tStartMs": 925620,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Ball point pens with their caps off."
    } ]
  }, {
    "tStartMs": 928350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- [Derek] Narrow metal pens\nmight still be dangerous,"
    } ]
  }, {
    "tStartMs": 931050,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "but these plastic ones still\nseem to have too much drag"
    } ]
  }, {
    "tStartMs": 934380,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "relative to their weight\nfor them to achieve"
    } ]
  }, {
    "tStartMs": 936420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "a high terminal velocity."
    } ]
  }, {
    "tStartMs": 938580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "One of the curious things\nabout air resistance"
    } ]
  }, {
    "tStartMs": 940560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is that it depends not only\non the cross sectional area"
    } ]
  }, {
    "tStartMs": 943200,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "of the object, but also\non its overall shape."
    } ]
  }, {
    "tStartMs": 946590,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This dependence is captured\nin a dimensionless number"
    } ]
  }, {
    "tStartMs": 949230,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "known as the Drag Coefficient."
    } ]
  }, {
    "tStartMs": 951810,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The Drag Coefficient is all about"
    } ]
  }, {
    "tStartMs": 953550,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "how smoothly air can flow around an object"
    } ]
  }, {
    "tStartMs": 956700,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "and without creating vortices."
    } ]
  }, {
    "tStartMs": 960510,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "The word bullet comes from\nthe French boule meaning ball."
    } ]
  }, {
    "tStartMs": 964740,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So a boulette is a small ball,"
    } ]
  }, {
    "tStartMs": 967590,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "exactly what the earliest bullets were."
    } ]
  }, {
    "tStartMs": 970080,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But the drag Coefficient\nof a sphere is 0.5"
    } ]
  }, {
    "tStartMs": 973350,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "so people modified the\nshape to reduce drag"
    } ]
  }, {
    "tStartMs": 976410,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and eventually, they settled\non a modern bullet shape,"
    } ]
  }, {
    "tStartMs": 978840,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "which has a drag coefficient\nbetween 0.1 and 0.3."
    } ]
  }, {
    "tStartMs": 982710,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So drag coefficient is the reason a bullet"
    } ]
  }, {
    "tStartMs": 985890,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "is no longer a boulette."
    } ]
  }, {
    "tStartMs": 989400,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So what would happen\nif you dropped a bullet"
    } ]
  }, {
    "tStartMs": 991350,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "from a skyscraper?"
    } ]
  }, {
    "tStartMs": 993420,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Not what you'd expect."
    } ]
  }, {
    "tStartMs": 995370,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Instead of falling pointy side down,"
    } ]
  }, {
    "tStartMs": 997950,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "a bullet would tumble and likely\nend up falling on its side."
    } ]
  }, {
    "tStartMs": 1002480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- The thing is that cylinders\ntend to fall on their sides"
    } ]
  }, {
    "tStartMs": 1004850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "if given enough chance.\n- Really?"
    } ]
  }, {
    "tStartMs": 1006590,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- But the object falls"
    } ]
  }, {
    "tStartMs": 1007880,
    "dDurationMs": 2594,
    "segs": [ {
      "utf8": "in relation to the highest resistance."
    } ]
  }, {
    "tStartMs": 1010474,
    "dDurationMs": 2626,
    "segs": [ {
      "utf8": "It ends up finding the highest resistance"
    } ]
  }, {
    "tStartMs": 1013100,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "as the most stable."
    } ]
  }, {
    "tStartMs": 1014060,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "- Why doesn't it fall\nin lowest resistance?"
    } ]
  }, {
    "tStartMs": 1015793,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "- I know.\n- That seems intuitive."
    } ]
  }, {
    "tStartMs": 1017570,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Bullets, if you let them,"
    } ]
  }, {
    "tStartMs": 1018890,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "they'll fall and make bullet shape holes--"
    } ]
  }, {
    "tStartMs": 1021050,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- On their side."
    } ]
  }, {
    "tStartMs": 1022790,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "A bullet fired straight up\nslows down as its kinetic energy"
    } ]
  }, {
    "tStartMs": 1026510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is turned into gravitational energy."
    } ]
  }, {
    "tStartMs": 1028610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And at its highest point,"
    } ]
  }, {
    "tStartMs": 1030350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which could be up to\nthree kilometers high,"
    } ]
  }, {
    "tStartMs": 1033200,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it stops and then falls back down."
    } ]
  }, {
    "tStartMs": 1036170,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "At that moment, it's just\nlike dropping a bullet"
    } ]
  }, {
    "tStartMs": 1038570,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "from a really tall building."
    } ]
  }, {
    "tStartMs": 1040460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "As it starts to fall,"
    } ]
  }, {
    "tStartMs": 1041840,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "it will tumble and so it\nexperiences far more air resistance"
    } ]
  }, {
    "tStartMs": 1045620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "than on the way up."
    } ]
  }, {
    "tStartMs": 1046820,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And so it's not gonna get\nback a lot of that energy"
    } ]
  }, {
    "tStartMs": 1049640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that went into its height,"
    } ]
  }, {
    "tStartMs": 1051680,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which means that by the\ntime it reaches the ground,"
    } ]
  }, {
    "tStartMs": 1054470,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it will be much slower than it was shot."
    } ]
  }, {
    "tStartMs": 1057440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Now if the bullet isn't\nfired completely vertical,"
    } ]
  }, {
    "tStartMs": 1060320,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "then it poses much greater danger."
    } ]
  }, {
    "tStartMs": 1063260,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "At the peak of its trajectory,"
    } ]
  }, {
    "tStartMs": 1065060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "only the vertical component\nof velocity is zero."
    } ]
  }, {
    "tStartMs": 1067670,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It still maintains its\nhorizontal velocity,"
    } ]
  }, {
    "tStartMs": 1070670,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and that combined with the\nspin imparted to the bullet"
    } ]
  }, {
    "tStartMs": 1073430,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "by the grooves inside the gun barrel,"
    } ]
  }, {
    "tStartMs": 1075290,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "keep it moving pointy and forwards."
    } ]
  }, {
    "tStartMs": 1078380,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And so as the bullet\ncomes back to the ground,"
    } ]
  }, {
    "tStartMs": 1080750,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "it speeds up to a significant\nfraction of its launch speed."
    } ]
  }, {
    "tStartMs": 1086870,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "There are hundreds of cases\nof people being struck"
    } ]
  }, {
    "tStartMs": 1089540,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "and killed by celebratory\ngunfire from all over the world."
    } ]
  }, {
    "tStartMs": 1094850,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Now this is accidental,"
    } ]
  }, {
    "tStartMs": 1096080,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but the concept of dropping\ndeadly projectiles on enemies"
    } ]
  }, {
    "tStartMs": 1098720,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is almost as old as aircraft."
    } ]
  }, {
    "tStartMs": 1101000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "In World War I,"
    } ]
  }, {
    "tStartMs": 1102200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "these little pieces of metal\nwere dropped out of planes"
    } ]
  }, {
    "tStartMs": 1105500,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and they look like nails with\nlittle feathers on the back"
    } ]
  }, {
    "tStartMs": 1108080,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to make sure they fall straight."
    } ]
  }, {
    "tStartMs": 1109460,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "They're called fléchettes,"
    } ]
  }, {
    "tStartMs": 1110720,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which is French for little arrow,"
    } ]
  }, {
    "tStartMs": 1112730,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but some were up to 15 centimeters long."
    } ]
  }, {
    "tStartMs": 1115100,
    "dDurationMs": 993,
    "segs": [ {
      "utf8": "- That is great."
    } ]
  }, {
    "tStartMs": 1117230,
    "dDurationMs": 2071,
    "segs": [ {
      "utf8": "I totally wanna make a\nthing that shoots these."
    } ]
  }, {
    "tStartMs": 1119301,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "(Derek laughing)"
    } ]
  }, {
    "tStartMs": 1120890,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- And how big were these things?"
    } ]
  }, {
    "tStartMs": 1122210,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- About the size of a dart,"
    } ]
  }, {
    "tStartMs": 1123530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "a little heavier than a standard pub dart."
    } ]
  }, {
    "tStartMs": 1126110,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And there were like\nendless different shapes."
    } ]
  }, {
    "tStartMs": 1128300,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] From a military perspective,"
    } ]
  }, {
    "tStartMs": 1129560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the advantages were they\ndidn't require any explosives"
    } ]
  }, {
    "tStartMs": 1131960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and they were cheap to\nproduce and deploy at scale."
    } ]
  }, {
    "tStartMs": 1134390,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "They could pierce helmets\nleading to enemy casualties"
    } ]
  }, {
    "tStartMs": 1136940,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and some nasty injuries."
    } ]
  }, {
    "tStartMs": 1139550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- They found darts that\nhad gone through a rider"
    } ]
  }, {
    "tStartMs": 1141920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and his horse."
    } ]
  }, {
    "tStartMs": 1144080,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- That's insane."
    } ]
  }, {
    "tStartMs": 1145250,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- But I also just love the idea\nof a guy in an open cockpit,"
    } ]
  }, {
    "tStartMs": 1148250,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "cloth and wood plane just\nhurling handfuls of darts out."
    } ]
  }, {
    "tStartMs": 1152120,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "That is like a 10 year old's\nidea of warfare, right?"
    } ]
  }, {
    "tStartMs": 1155090,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Then I'm gonna hit him with darts."
    } ]
  }, {
    "tStartMs": 1156980,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- Later, the US created similar\nweapons called Lazy Dogs,"
    } ]
  }, {
    "tStartMs": 1160220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which were a bit heftier\nused in the Korean"
    } ]
  }, {
    "tStartMs": 1162620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and Vietnam wars."
    } ]
  }, {
    "tStartMs": 1164270,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The damage they inflicted\nwas indiscriminate"
    } ]
  }, {
    "tStartMs": 1166310,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and unpredictable,"
    } ]
  }, {
    "tStartMs": 1167510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but at least they didn't\nleave unexploded ordinances"
    } ]
  }, {
    "tStartMs": 1169790,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "in the field."
    } ]
  }, {
    "tStartMs": 1171110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And militaries continue to use"
    } ]
  }, {
    "tStartMs": 1172640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "kinetic projectiles to this day,"
    } ]
  }, {
    "tStartMs": 1174320,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "For example, to make precision\nstrikes on terrorist leaders."
    } ]
  }, {
    "tStartMs": 1177500,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Falling objects are also\ndangerous in civilian life."
    } ]
  }, {
    "tStartMs": 1180290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Nearly 700 Americans die each year"
    } ]
  }, {
    "tStartMs": 1182450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "by being struck by a falling object."
    } ]
  }, {
    "tStartMs": 1184430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "These range from loose tiles and bricks"
    } ]
  }, {
    "tStartMs": 1186470,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to falling construction tools,"
    } ]
  }, {
    "tStartMs": 1188180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "falling rocks and tree branches,"
    } ]
  }, {
    "tStartMs": 1189980,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and even icicles."
    } ]
  }, {
    "tStartMs": 1191540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Death by icicle is rare"
    } ]
  }, {
    "tStartMs": 1193220,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "but they were a serious enough concern"
    } ]
  }, {
    "tStartMs": 1194810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that in the winter of 2014,"
    } ]
  }, {
    "tStartMs": 1196220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "streets around New York's\nOne World Trade Center"
    } ]
  }, {
    "tStartMs": 1198200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "were closed due to the danger caused"
    } ]
  }, {
    "tStartMs": 1200180,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "by icicles hanging on the building."
    } ]
  }, {
    "tStartMs": 1202370,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So which projectiles are\nlethal and which aren't?"
    } ]
  }, {
    "tStartMs": 1205490,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Honestly, a lot of them are."
    } ]
  }, {
    "tStartMs": 1207710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The lower limit of the energy required"
    } ]
  }, {
    "tStartMs": 1209330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to fracture a human skull\nis around 68 Joules."
    } ]
  }, {
    "tStartMs": 1212180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So anything that has kinetic\nenergy greater than that"
    } ]
  }, {
    "tStartMs": 1214250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "is very likely to kill you."
    } ]
  }, {
    "tStartMs": 1215960,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "A raindrop at terminal\nvelocity with its tiny mass"
    } ]
  }, {
    "tStartMs": 1218630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "will only deliver 2000th of a Joule."
    } ]
  }, {
    "tStartMs": 1221480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "A falling penny has\nabout a fifth of a Joule."
    } ]
  }, {
    "tStartMs": 1224180,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "But a baseball and the\nlargest hailstone measured"
    } ]
  }, {
    "tStartMs": 1227090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "deliver more than 80 Joules."
    } ]
  }, {
    "tStartMs": 1229010,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "That is plenty to crack your skull."
    } ]
  }, {
    "tStartMs": 1231860,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "In 2014, a man was killed"
    } ]
  }, {
    "tStartMs": 1233510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "when he was hit by a\nfalling measuring tape"
    } ]
  }, {
    "tStartMs": 1235490,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that had fallen 50 stories."
    } ]
  }, {
    "tStartMs": 1237650,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And this is just calculating\nfor blunt force trauma."
    } ]
  }, {
    "tStartMs": 1240230,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The energy stored in a falling Flechette"
    } ]
  }, {
    "tStartMs": 1242180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "is not enough to crack your skull,"
    } ]
  }, {
    "tStartMs": 1244160,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "but it can apply a large\nforce to a very small area."
    } ]
  }, {
    "tStartMs": 1247910,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "So yeah,"
    } ]
  }, {
    "tStartMs": 1248840,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "a penny falling from the\nEmpire State Building"
    } ]
  }, {
    "tStartMs": 1250940,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "won't kill you."
    } ]
  }, {
    "tStartMs": 1251930,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "A pen likely won't either."
    } ]
  }, {
    "tStartMs": 1253670,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Anything that weighs a few\ngrams and isn't aerodynamic"
    } ]
  }, {
    "tStartMs": 1256580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "isn't going to be fatal."
    } ]
  }, {
    "tStartMs": 1258080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But objects that weigh more\nthan a few hundred grams"
    } ]
  }, {
    "tStartMs": 1260480,
    "dDurationMs": 3625,
    "segs": [ {
      "utf8": "traveling at terminal velocity\nare likely to be deadly."
    } ]
  }, {
    "tStartMs": 1264105,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 1270830,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You have made it to\nthis part of the video,"
    } ]
  }, {
    "tStartMs": 1273470,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "which means you like learning stuff."
    } ]
  }, {
    "tStartMs": 1276080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And I wanna tell you one thing"
    } ]
  }, {
    "tStartMs": 1277160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that will help you learn even more."
    } ]
  }, {
    "tStartMs": 1278960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Right now for free,"
    } ]
  }, {
    "tStartMs": 1280340,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "you can get started with\nmy favorite learning tool"
    } ]
  }, {
    "tStartMs": 1282320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and the sponsor of this video, Brilliant,"
    } ]
  }, {
    "tStartMs": 1284060,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "by going to brilliant.org/veritasium,"
    } ]
  }, {
    "tStartMs": 1286430,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "link in the description."
    } ]
  }, {
    "tStartMs": 1287900,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So why should you try Brilliant?"
    } ]
  }, {
    "tStartMs": 1290210,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Well, because it allows you to learn"
    } ]
  }, {
    "tStartMs": 1291410,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "a wide range of STEM concepts\nin an interactive way."
    } ]
  }, {
    "tStartMs": 1294770,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "They have advanced topics like calculus"
    } ]
  }, {
    "tStartMs": 1296840,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and gravitational physics."
    } ]
  }, {
    "tStartMs": 1298220,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "But if you need a refresher,"
    } ]
  }, {
    "tStartMs": 1299300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "they also have fundamentals\nof algebra or computer science"
    } ]
  }, {
    "tStartMs": 1302300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or logic."
    } ]
  }, {
    "tStartMs": 1303133,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "There are so many courses to choose from."
    } ]
  }, {
    "tStartMs": 1305540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "You know, people sometimes ask"
    } ]
  }, {
    "tStartMs": 1306740,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "why I don't show more equations"
    } ]
  }, {
    "tStartMs": 1308210,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "or work through numerical\nexamples in my videos."
    } ]
  }, {
    "tStartMs": 1310850,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And the reason is I don't think"
    } ]
  }, {
    "tStartMs": 1312710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that's really where video shines."
    } ]
  }, {
    "tStartMs": 1314630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I did my PhD on how to make\nvideos to teach physics,"
    } ]
  }, {
    "tStartMs": 1317150,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and I think they're a great way to inspire"
    } ]
  }, {
    "tStartMs": 1319790,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and excite people about science."
    } ]
  }, {
    "tStartMs": 1321230,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But if you actually want\nto develop expertise"
    } ]
  }, {
    "tStartMs": 1323300,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and problem solving skills,"
    } ]
  }, {
    "tStartMs": 1324560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "you need to try things out for yourself."
    } ]
  }, {
    "tStartMs": 1326540,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And that's where Brilliant comes in."
    } ]
  }, {
    "tStartMs": 1328310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "You can experiment with\ndemos and simulations,"
    } ]
  }, {
    "tStartMs": 1330890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "see the effects of changing parameters,"
    } ]
  }, {
    "tStartMs": 1332780,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and every step of the way\nyou are asked questions"
    } ]
  }, {
    "tStartMs": 1335510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which ensure you understand the concepts."
    } ]
  }, {
    "tStartMs": 1338060,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "And if you ever get stuck,"
    } ]
  }, {
    "tStartMs": 1339080,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "there's always a helpful\nhint close at hand"
    } ]
  }, {
    "tStartMs": 1340910,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and full explanations if you want them."
    } ]
  }, {
    "tStartMs": 1343550,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "For the first 200 people to sign up,"
    } ]
  }, {
    "tStartMs": 1344990,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Brilliant are offering 20%\noff a premium subscription,"
    } ]
  }, {
    "tStartMs": 1348080,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "just use my link brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1350630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And remember using that same link,"
    } ]
  }, {
    "tStartMs": 1352700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "you can get started for free."
    } ]
  }, {
    "tStartMs": 1354230,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So go check it out."
    } ]
  }, {
    "tStartMs": 1355610,
    "dDurationMs": 1827,
    "segs": [ {
      "utf8": "I wanna thank Brilliant\nfor supporting Veritasium"
    } ]
  }, {
    "tStartMs": 1357437,
    "dDurationMs": 2046,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
