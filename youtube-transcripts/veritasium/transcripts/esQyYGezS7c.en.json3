    "segs": [ {
      "utf8": "as soon as you can."
    } ]
  }, {
    "tStartMs": 525810,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "It's like claiming a social media handle."
    } ]
  }, {
    "tStartMs": 528180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And Google Domains makes this easy."
    } ]
  }, {
    "tStartMs": 530760,
    "dDurationMs": 2400,
