      "utf8": "So the domain resolves lightning fast,"
    } ]
  }, {
    "tStartMs": 552780,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "no matter where in the world,"
    } ]
  }, {
    "tStartMs": 554520,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "your users are."
    } ]
  }, {
    "tStartMs": 555690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I also get peace of mind\nfrom Google Domain's"
