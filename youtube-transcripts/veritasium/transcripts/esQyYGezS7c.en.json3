  }, {
    "tStartMs": 559830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and two factor authentication."
    } ]
  }, {
    "tStartMs": 561780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Plus it automatically connects to tools"
