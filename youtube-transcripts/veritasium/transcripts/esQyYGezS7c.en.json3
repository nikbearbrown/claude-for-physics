  }, {
    "tStartMs": 535050,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "If you're building an\nonline store from scratch,"
    } ]
  }, {
    "tStartMs": 536850,
    "dDurationMs": 1830,
