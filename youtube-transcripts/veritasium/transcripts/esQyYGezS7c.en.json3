  }, {
    "tStartMs": 538680,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "using Google Domains\nsimple templates and tools."
    } ]
  }, {
    "tStartMs": 541140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "No coding required."
    } ]
  }, {
    "tStartMs": 543000,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Now, with snatoms.com\nset up on Google Domains,"
    } ]
  }, {
    "tStartMs": 545460,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I never have to worry about reliability."
    } ]
  }, {
    "tStartMs": 547680,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It runs on Google Cloud's super\nfast DNS infrastructure,"
    } ]
  }, {
    "tStartMs": 550920,
    "dDurationMs": 1860,
