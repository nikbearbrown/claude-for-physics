{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Inside the tank is Brandon Birchak,"
    } ]
  }, {
    "tStartMs": 2760,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and he is going to\nattempt to hold his breath"
    } ]
  }, {
    "tStartMs": 5610,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "for this entire video."
    } ]
  }, {
    "tStartMs": 7257,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 9210,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Brandon is one of the\nworld's foremost experts"
    } ]
  }, {
    "tStartMs": 11730,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in breath work,"
    } ]
  }, {
    "tStartMs": 12563,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "so please don't try this at home."
    } ]
  }, {
    "tStartMs": 15330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I'll put his info in the description"
    } ]
  }, {
    "tStartMs": 16830,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "if you want to learn more."
    } ]
  }, {
    "tStartMs": 18660,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I'm going to keep this\nshot going continuously"
    } ]
  }, {
    "tStartMs": 21210,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "on the right side of the video,"
    } ]
  }, {
    "tStartMs": 23190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and while he's holding his breath,"
    } ]
  }, {
    "tStartMs": 24840,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "we will figure out how he does it."
    } ]
  }, {
    "tStartMs": 27150,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And I'm even going to\nlearn how to hold my breath"
    } ]
  }, {
    "tStartMs": 30510,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "way longer than I ever have before."
    } ]
  }, {
    "tStartMs": 32760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I failed the very first level of swimming"
    } ]
  }, {
    "tStartMs": 35340,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "'cause I refused to\nput my head underwater."
    } ]
  }, {
    "tStartMs": 38730,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "This is somewhat terrifying."
    } ]
  }, {
    "tStartMs": 42146,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 46380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "All the cells of the human body"
    } ]
  }, {
    "tStartMs": 48150,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "need oxygen in order to survive,"
    } ]
  }, {
    "tStartMs": 51150,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "oxygen to react with\nglucose and produce ATP,"
    } ]
  }, {
    "tStartMs": 54630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the molecule that delivers energy"
    } ]
  }, {
    "tStartMs": 56640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "wherever it's needed in a cell."
    } ]
  }, {
    "tStartMs": 59010,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Breathing is so important,"
    } ]
  }, {
    "tStartMs": 61140,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "it happens without conscious thought."
    } ]
  }, {
    "tStartMs": 63090,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It's under the control of\nthe autonomic nervous system."
    } ]
  }, {
    "tStartMs": 66270,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "When resting, we breathe\nabout 12 times per minute."
    } ]
  }, {
    "tStartMs": 70170,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "But that rate automatically\nincreases when exercising."
    } ]
  }, {
    "tStartMs": 74190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The brain knows how\noften we need to breathe"
    } ]
  }, {
    "tStartMs": 76530,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "using chemical sensors\ncalled chemoreceptors."
    } ]
  }, {
    "tStartMs": 79710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "There are chemoreceptors for CO2"
    } ]
  }, {
    "tStartMs": 81900,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "in the carotid arteries\nand in the brainstem."
    } ]
  }, {
    "tStartMs": 84810,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Increasing CO2 in the\nblood makes it more acidic,"
    } ]
  }, {
    "tStartMs": 88650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and it's thought that this CO2 acidity"
    } ]
  }, {
    "tStartMs": 91110,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "is the main feedback mechanism\nthat regulates breathing."
    } ]
  }, {
    "tStartMs": 94650,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "CO2 is created at the same\nrate oxygen is used up,"
    } ]
  }, {
    "tStartMs": 98430,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "so acidic blood tells the body"
    } ]
  }, {
    "tStartMs": 100140,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "we're building up too much CO2,"
    } ]
  }, {
    "tStartMs": 101910,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and therefore, running out of oxygen,"
    } ]
  }, {
    "tStartMs": 103800,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "so we better breathe."
    } ]
  }, {
    "tStartMs": 105360,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The only known chemoreceptors\nfor low blood oxygen"
    } ]
  }, {
    "tStartMs": 108150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "are in the carotid arteries,"
    } ]
  }, {
    "tStartMs": 109770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but these are thought\nto play a smaller role"
    } ]
  }, {
    "tStartMs": 111870,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "in regulating breathing."
    } ]
  }, {
    "tStartMs": 114210,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And this is why hyperventilating\nbefore going underwater"
    } ]
  }, {
    "tStartMs": 117210,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "is a really bad idea,"
    } ]
  }, {
    "tStartMs": 119130,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "because hyperventilating\nexpels a lot of CO2,"
    } ]
  }, {
    "tStartMs": 122910,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "making the blood more alkaline."
    } ]
  }, {
    "tStartMs": 125340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But it doesn't actually\nincrease the amount"
    } ]
  }, {
    "tStartMs": 127500,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of oxygen in the blood,"
    } ]
  }, {
    "tStartMs": 129090,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "which is limited by the\nconcentration of oxygen in the air"
    } ]
  }, {
    "tStartMs": 132570,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and the number of red blood cells."
    } ]
  }, {
    "tStartMs": 135150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So, with the blood starting out alkaline,"
    } ]
  }, {
    "tStartMs": 137610,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "more CO2 must be produced\nbefore the CO2 chemoreceptors"
    } ]
  }, {
    "tStartMs": 141390,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "give you the urge to breathe,"
    } ]
  }, {
    "tStartMs": 143490,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "which means more oxygen will be used up,"
    } ]
  }, {
    "tStartMs": 146820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "sometimes to the point where the brain"
    } ]
  }, {
    "tStartMs": 148620,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "runs out of oxygen to stay conscious,"
    } ]
  }, {
    "tStartMs": 150990,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so you can black out underwater"
    } ]
  }, {
    "tStartMs": 153240,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "before even getting the urge to breathe."
    } ]
  }, {
    "tStartMs": 157140,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "If you want to maximize the time"
    } ]
  }, {
    "tStartMs": 159090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "you can hold your breath for,"
    } ]
  }, {
    "tStartMs": 160470,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you have to optimize two\nsides of an equation."
    } ]
  }, {
    "tStartMs": 163470,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "First, you need to maximize\nthe amount of oxygen"
    } ]
  }, {
    "tStartMs": 165960,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "in your body before you\nstart, and minimize CO2."
    } ]
  }, {
    "tStartMs": 168750,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And second, you have to reduce the rate"
    } ]
  }, {
    "tStartMs": 171330,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "at which oxygen is used\nup during the breath hold."
    } ]
  }, {
    "tStartMs": 174810,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- So, when we work with an athlete,"
    } ]
  }, {
    "tStartMs": 176340,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "one of the first things we do"
    } ]
  }, {
    "tStartMs": 177480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "is we check their BOLT score."
    } ]
  }, {
    "tStartMs": 178830,
    "dDurationMs": 1557,
    "segs": [ {
      "utf8": "Just tell them, \"All\nright, hold your breath.\""
    } ]
  }, {
    "tStartMs": 180387,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "(inhales) And then they hold their breath"
    } ]
  }, {
    "tStartMs": 181977,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "30, 40 seconds or something."
    } ]
  }, {
    "tStartMs": 183690,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "They breathe, that's your new BOLT score."
    } ]
  }, {
    "tStartMs": 185910,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "- [Brandon] Where BOLT stands\nfor Body Oxygen Level Test."
    } ]
  }, {
    "tStartMs": 190170,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "If you want, you can try to\nhold your breath along with me."
    } ]
  }, {
    "tStartMs": 193500,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Whenever you're ready,\ngive a really nice exhale"
    } ]
  }, {
    "tStartMs": 195960,
    "dDurationMs": 1805,
    "segs": [ {
      "utf8": "and then a really big inhale."
    } ]
  }, {
    "tStartMs": 197765,
    "dDurationMs": 1945,
    "segs": [ {
      "utf8": "(Brandon inhaling)"
    } ]
  }, {
    "tStartMs": 199710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The BOLT score just measures\nthe number of seconds"
    } ]
  }, {
    "tStartMs": 202020,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "you can hold your breath"
    } ]
  }, {
    "tStartMs": 203310,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "before you feel the first urge to breathe."
    } ]
  }, {
    "tStartMs": 207780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Your first inkling to breathe"
    } ]
  }, {
    "tStartMs": 209760,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "is when most people choose to breathe."
    } ]
  }, {
    "tStartMs": 211740,
    "dDurationMs": 1307,
    "segs": [ {
      "utf8": "- Yeah, that's,"
    } ]
  }, {
    "tStartMs": 213047,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 217200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "That is exactly when I'm\ngoing to want to breathe."
    } ]
  }, {
    "tStartMs": 220680,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Some people are naturally\nbetter at holding their breath."
    } ]
  }, {
    "tStartMs": 223860,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The bigger your lungs, for example,"
    } ]
  }, {
    "tStartMs": 225630,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "the more air, and hence,\noxygen, you can hold."
    } ]
  }, {
    "tStartMs": 229470,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Most people have a lung capacity"
    } ]
  }, {
    "tStartMs": 230820,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "between four and six liters,"
    } ]
  }, {
    "tStartMs": 232860,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "but some people have a 10-liter capacity."
    } ]
  }, {
    "tStartMs": 236261,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 240521,
    "dDurationMs": 3284,
    "segs": [ {
      "utf8": "- (exhales) I dunno, how was that?"
    } ]
  }, {
    "tStartMs": 243805,
    "dDurationMs": 988,
    "segs": [ {
      "utf8": "- [Timer] 40 seconds."
    } ]
  }, {
    "tStartMs": 244793,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "- [Brandon] There you go, 40 seconds!"
    } ]
  }, {
    "tStartMs": 246810,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "- [Derek] Stretching can\nhelp expand what you've got."
    } ]
  }, {
    "tStartMs": 250440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- I'll do degrees this way,"
    } ]
  }, {
    "tStartMs": 252000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "90, 90, and then also on my chest."
    } ]
  }, {
    "tStartMs": 254550,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And then I'll do it again"
    } ]
  }, {
    "tStartMs": 255750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "at about half the volume of a lung pack,"
    } ]
  }, {
    "tStartMs": 258000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so I (exhales) and then I'll do it again."
    } ]
  }, {
    "tStartMs": 260430,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] The ideal\nphysique for breath holding"
    } ]
  }, {
    "tStartMs": 262710,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "is someone tall and skinny\nwith plenty of lung capacity,"
    } ]
  }, {
    "tStartMs": 266460,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but not too much tissue to use up oxygen."
    } ]
  }, {
    "tStartMs": 269430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Aleix Segura, excellent breath holder."
    } ]
  }, {
    "tStartMs": 271680,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "He's also built for it, too."
    } ]
  }, {
    "tStartMs": 274140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "He's six feet tall, weighs less than me."
    } ]
  }, {
    "tStartMs": 277200,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "I mean, he's like a lung with a brain."
    } ]
  }, {
    "tStartMs": 281070,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Another technique that can increase"
    } ]
  }, {
    "tStartMs": 282540,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "the amount of air stored in the lungs"
    } ]
  }, {
    "tStartMs": 284190,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "is called lung packing."
    } ]
  }, {
    "tStartMs": 287250,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "After taking a full, deep breath,"
    } ]
  }, {
    "tStartMs": 289740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "you continue to take little sips of air,"
    } ]
  }, {
    "tStartMs": 292290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "packing it in on top."
    } ]
  }, {
    "tStartMs": 294030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- I'll hold my breath (exhales)"
    } ]
  }, {
    "tStartMs": 295470,
    "dDurationMs": 1632,
    "segs": [ {
      "utf8": "and then I'll do about 20 packs."
    } ]
  }, {
    "tStartMs": 297102,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(inhales rhythmically)"
    } ]
  }, {
    "tStartMs": 305070,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Derek] The other side of the equation"
    } ]
  }, {
    "tStartMs": 306630,
    "dDurationMs": 3026,
    "segs": [ {
      "utf8": "involves reducing the rate oxygen is used."
    } ]
  }, {
    "tStartMs": 309656,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(ethereal music)"
    } ]
  }, {
    "tStartMs": 313350,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And since muscles use oxygen to contract,"
    } ]
  }, {
    "tStartMs": 316560,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "it's very important to be relaxed."
    } ]
  }, {
    "tStartMs": 320400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Go through the whole body"
    } ]
  }, {
    "tStartMs": 321660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and we're going to do a muscle check."
    } ]
  }, {
    "tStartMs": 323370,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "We're going to go all the way\ndown and then all the way up."
    } ]
  }, {
    "tStartMs": 325350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So, once I hold my breath, (inhales)"
    } ]
  }, {
    "tStartMs": 327630,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "now I'm just going to check to make sure"
    } ]
  }, {
    "tStartMs": 329370,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "that nothing is engaged."
    } ]
  }, {
    "tStartMs": 335400,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] Brandon\nsometimes does performances"
    } ]
  }, {
    "tStartMs": 337350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "where he's active during the breath hold,"
    } ]
  }, {
    "tStartMs": 340110,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but since he's moving around,"
    } ]
  }, {
    "tStartMs": 341520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "he uses up oxygen faster,"
    } ]
  }, {
    "tStartMs": 343530,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "and so doesn't hold\nhis breath for as long."
    } ]
  }, {
    "tStartMs": 347520,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "People actually have a secret weapon"
    } ]
  }, {
    "tStartMs": 349410,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "when it comes to reducing\noxygen consumption"
    } ]
  }, {
    "tStartMs": 352230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "by virtue of our evolution."
    } ]
  }, {
    "tStartMs": 354420,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "It's called the mammalian dive reflex."
    } ]
  }, {
    "tStartMs": 357750,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "All mammals have this\nphysiological adaptation"
    } ]
  }, {
    "tStartMs": 360330,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "that helps us survive when\nwe're submerged in water."
    } ]
  }, {
    "tStartMs": 364050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The trigeminal nerve in our face"
    } ]
  }, {
    "tStartMs": 366270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "detects the coolness of the water"
    } ]
  }, {
    "tStartMs": 368430,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and triggers a series of responses."
    } ]
  }, {
    "tStartMs": 371400,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The heart beats slower,"
    } ]
  }, {
    "tStartMs": 373050,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "decreasing the rate at which\nblood, and hence, oxygen,"
    } ]
  }, {
    "tStartMs": 376050,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "are circulated around the body."
    } ]
  }, {
    "tStartMs": 378390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Our blood vessels in our\nextremities constrict,"
    } ]
  }, {
    "tStartMs": 381000,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "confining blood to our\nvital organs and brain,"
    } ]
  }, {
    "tStartMs": 384300,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "ensuring we have enough\noxygen to stay conscious."
    } ]
  }, {
    "tStartMs": 387090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- If you take a free diving class,"
    } ]
  }, {
    "tStartMs": 389100,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you can see your fingers, your hand,"
    } ]
  }, {
    "tStartMs": 392460,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "very sort of like a pale color."
    } ]
  }, {
    "tStartMs": 395610,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- If I do a 10-minute breath hold,"
    } ]
  }, {
    "tStartMs": 397320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "this will read at 50 or 60."
    } ]
  }, {
    "tStartMs": 400170,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And then it'll just turn off,"
    } ]
  }, {
    "tStartMs": 401580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "'cause I'll have no blood in my hands"
    } ]
  }, {
    "tStartMs": 403680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "by the end of that long breath hold."
    } ]
  }, {
    "tStartMs": 405360,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "It's all from here to here."
    } ]
  }, {
    "tStartMs": 407130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] And the spleen releases extra"
    } ]
  }, {
    "tStartMs": 409350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "pre-oxygenated red blood\ncells into the bloodstream,"
    } ]
  }, {
    "tStartMs": 412140,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "increasing the available supply of oxygen."
    } ]
  }, {
    "tStartMs": 416760,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The brain also uses a\ndisproportionate amount of oxygen."
    } ]
  }, {
    "tStartMs": 421140,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- Mental activity, neuronal\nactivity also uses oxygen,"
    } ]
  }, {
    "tStartMs": 424110,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "so you're trying to\npreserve as much as you can."
    } ]
  }, {
    "tStartMs": 427500,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- When your body's not moving,"
    } ]
  }, {
    "tStartMs": 429090,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "your brain is using 80% of the oxygen"
    } ]
  }, {
    "tStartMs": 431580,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that your body is utilizing."
    } ]
  }, {
    "tStartMs": 434100,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "80%, it's a biblical amount."
    } ]
  }, {
    "tStartMs": 436320,
    "dDurationMs": 2611,
    "segs": [ {
      "utf8": "So, you want to turn\nthat off a little bit."
    } ]
  }, {
    "tStartMs": 438931,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 442500,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "You want to give yourself\nsome sort of mantra"
    } ]
  }, {
    "tStartMs": 444990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that you can just keep\ncycling back and forth."
    } ]
  }, {
    "tStartMs": 447540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "You want to stop thinking,"
    } ]
  }, {
    "tStartMs": 449220,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but you do need to pass the time somehow"
    } ]
  }, {
    "tStartMs": 452040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and you have to fight\nagainst this urge to breathe."
    } ]
  }, {
    "tStartMs": 455400,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, give yourself something short,"
    } ]
  }, {
    "tStartMs": 457650,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "something that you can remember."
    } ]
  }, {
    "tStartMs": 459270,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And then, you get through\nthe mantra enough times"
    } ]
  }, {
    "tStartMs": 461700,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that you'll pass another\nmaybe 20, 30 seconds"
    } ]
  }, {
    "tStartMs": 464190,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "toward the end of the breath hold,"
    } ]
  }, {
    "tStartMs": 465420,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "particularly when it's really\nhard and the CO2 is high"
    } ]
  }, {
    "tStartMs": 468330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and you're dealing with a really bad about"
    } ]
  }, {
    "tStartMs": 470460,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "of acidotic response."
    } ]
  }, {
    "tStartMs": 476430,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Once you do your body check,"
    } ]
  }, {
    "tStartMs": 478080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I want you to go through the alphabet"
    } ]
  }, {
    "tStartMs": 479670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and I want you to have a\ngratitude for each letter."
    } ]
  }, {
    "tStartMs": 483270,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The more you practice this,"
    } ]
  }, {
    "tStartMs": 485250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the better you'll get at just"
    } ]
  }, {
    "tStartMs": 487380,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the sensation of compassion or gratitude."
    } ]
  }, {
    "tStartMs": 490170,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "And then, that in itself\nwill be very, very relaxing."
    } ]
  }, {
    "tStartMs": 494100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "When I do a really big breath hold,"
    } ]
  }, {
    "tStartMs": 495780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I'm not thinking about anything."
    } ]
  }, {
    "tStartMs": 497640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I'm on cloud nine."
    } ]
  }, {
    "tStartMs": 499200,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "I'm just, between five and 15 minutes,"
    } ]
  }, {
    "tStartMs": 502860,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I feel like I'm just on a rocket ship"
    } ]
  }, {
    "tStartMs": 505740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "at 1,000 miles an hour."
    } ]
  }, {
    "tStartMs": 507240,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I'm just like, I'm not\nthinking or feeling anything."
    } ]
  }, {
    "tStartMs": 510510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I just have a sensation and a color."
    } ]
  }, {
    "tStartMs": 512880,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But that's because of\nthe whole experience."
    } ]
  }, {
    "tStartMs": 514590,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "It's a little bit psychedelic."
    } ]
  }, {
    "tStartMs": 519567,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 520650,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Derek] After a half hour"
    } ]
  }, {
    "tStartMs": 521700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of practicing with Brandon in the pool,"
    } ]
  }, {
    "tStartMs": 523890,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "this is the longest breath\nhold I was able to achieve."
    } ]
  }, {
    "tStartMs": 527290,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- Nice, nice and relaxed."
    } ]
  }, {
    "tStartMs": 528570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Immediately relaxing."
    } ]
  }, {
    "tStartMs": 530160,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Derek] I'll leave it running"
    } ]
  }, {
    "tStartMs": 531270,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "in the bottom of frame, here."
    } ]
  }, {
    "tStartMs": 533040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Just know that that urge to breathe"
    } ]
  }, {
    "tStartMs": 535920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "is just your body lying to you."
    } ]
  }, {
    "tStartMs": 537600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "You do not need to breathe."
    } ]
  }, {
    "tStartMs": 539280,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "You have plenty more time."
    } ]
  }, {
    "tStartMs": 540840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, when you get that\nurge to breathe, relax."
    } ]
  }, {
    "tStartMs": 543840,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Just appreciate it for what it is."
    } ]
  }, {
    "tStartMs": 545220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "It's just your body taking\na real-time pH readout,"
    } ]
  }, {
    "tStartMs": 548250,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "sending a signal,\ntelling you to expel CO2."
    } ]
  }, {
    "tStartMs": 550860,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "But you're totally fine."
    } ]
  }, {
    "tStartMs": 552150,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "You've got maybe four or\nfive minutes until you drown,"
    } ]
  }, {
    "tStartMs": 555570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "so you're totally, totally good."
    } ]
  }, {
    "tStartMs": 557940,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So, when you get that urge\nto breathe, around a minute,"
    } ]
  }, {
    "tStartMs": 560430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "relax, appreciate it for what it is."
    } ]
  }, {
    "tStartMs": 562620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And then I want you to try to count to 10"
    } ]
  }, {
    "tStartMs": 564960,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "as slowly as you can."
    } ]
  }, {
    "tStartMs": 566010,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Just give yourself 10 extra seconds"
    } ]
  }, {
    "tStartMs": 567780,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "after the urge to breathe, okay?"
    } ]
  }, {
    "tStartMs": 570060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Okay.\n- All right."
    } ]
  }, {
    "tStartMs": 571770,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Derek] I practiced\nbreathing at a set rhythm."
    } ]
  }, {
    "tStartMs": 573960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Brandon] And I want you to\nbreathe about five seconds in,"
    } ]
  }, {
    "tStartMs": 576360,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "five seconds out,"
    } ]
  }, {
    "tStartMs": 577650,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "just through your stomach\nand through your nose."
    } ]
  }, {
    "tStartMs": 579720,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And again, as much as you can,"
    } ]
  }, {
    "tStartMs": 581130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "but without engaging any muscles."
    } ]
  }, {
    "tStartMs": 582510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, one, two, three, four, five in,"
    } ]
  }, {
    "tStartMs": 585390,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and then one, two, three, four, five out."
    } ]
  }, {
    "tStartMs": 588030,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "- Followed by holding my breath\nfor increasing durations."
    } ]
  }, {
    "tStartMs": 594000,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "I feel like, psychologically, I was like,"
    } ]
  }, {
    "tStartMs": 596913,
    "dDurationMs": 2824,
    "segs": [ {
      "utf8": "\"I'm not comfortable not\nbreathing for this long.\""
    } ]
  }, {
    "tStartMs": 599737,
    "dDurationMs": 2873,
    "segs": [ {
      "utf8": "- Well, you made it about a minute."
    } ]
  }, {
    "tStartMs": 604223,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "Nice, you made 1:30."
    } ]
  }, {
    "tStartMs": 606630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Oh, wow.\n- Yeah, crushed it!"
    } ]
  }, {
    "tStartMs": 608670,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Easy, and we're we're just starting!"
    } ]
  }, {
    "tStartMs": 612930,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Amazing, amazing, amazing!"
    } ]
  }, {
    "tStartMs": 615270,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "- For real, what was that?"
    } ]
  }, {
    "tStartMs": 616130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- We made about 1:45,\nI think, close to 1:50."
    } ]
  }, {
    "tStartMs": 620130,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- I modified the strategies\nBrandon suggested"
    } ]
  }, {
    "tStartMs": 622560,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to keep my mind calm."
    } ]
  }, {
    "tStartMs": 624540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I think what I was doing that time"
    } ]
  }, {
    "tStartMs": 625950,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "was going through the alphabet,"
    } ]
  }, {
    "tStartMs": 627720,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "and just, I couldn't do gratitudes."
    } ]
  }, {
    "tStartMs": 629933,
    "dDurationMs": 1427,
    "segs": [ {
      "utf8": "(Brandon laughing)"
    } ]
  }, {
    "tStartMs": 631360,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "They were too hard."
    } ]
  }, {
    "tStartMs": 632730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But I was just doing animals."
    } ]
  }, {
    "tStartMs": 634350,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Brandon] Yeah, great, great."
    } ]
  }, {
    "tStartMs": 635370,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "Good way to gently distract the mind."
    } ]
  }, {
    "tStartMs": 638880,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- I was singing nursery rhymes"
    } ]
  }, {
    "tStartMs": 641610,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "because it's something do for my kids."
    } ]
  }, {
    "tStartMs": 644443,
    "dDurationMs": 1094,
    "segs": [ {
      "utf8": "- (laughs) I love that!"
    } ]
  }, {
    "tStartMs": 645537,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I was like, \"I'm just going to sing"
    } ]
  }, {
    "tStartMs": 646370,
    "dDurationMs": 2679,
    "segs": [ {
      "utf8": "some of the songs I sing for them.\""
    } ]
  }, {
    "tStartMs": 649049,
    "dDurationMs": 2971,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 652020,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I was skeptical that my heart rate"
    } ]
  }, {
    "tStartMs": 653430,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "would drop significantly,"
    } ]
  }, {
    "tStartMs": 654750,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but my watch showed that\nthe mammalian dive reflex"
    } ]
  }, {
    "tStartMs": 657750,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "really did kick in."
    } ]
  }, {
    "tStartMs": 659370,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- My average heart rate was 72-"
    } ]
  }, {
    "tStartMs": 661050,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- 48, you got down to, nice!"
    } ]
  }, {
    "tStartMs": 663990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Look at that."
    } ]
  }, {
    "tStartMs": 664823,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's wild."
    } ]
  }, {
    "tStartMs": 665656,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "I don't even get down to 48 when I sleep."
    } ]
  }, {
    "tStartMs": 668700,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "That is, that's low."
    } ]
  }, {
    "tStartMs": 669750,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "That's low for me."
    } ]
  }, {
    "tStartMs": 671070,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "- That's awesome."
    } ]
  }, {
    "tStartMs": 674670,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "- It's that thing of, when have\nI not breathed for a minute?"
    } ]
  }, {
    "tStartMs": 680550,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Maybe never in my whole life."
    } ]
  }, {
    "tStartMs": 683154,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 688034,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- How'd you go?"
    } ]
  }, {
    "tStartMs": 688867,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Timekeeper] 2:36."
    } ]
  }, {
    "tStartMs": 689700,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- 2:36, look at that!"
    } ]
  }, {
    "tStartMs": 691140,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah, baby!"
    } ]
  }, {
    "tStartMs": 693630,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- I think I can guarantee"
    } ]
  }, {
    "tStartMs": 694620,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "that I've never held my\nbreath for 2 1/2 minutes."
    } ]
  }, {
    "tStartMs": 698160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The psychological side is the hardest."
    } ]
  }, {
    "tStartMs": 700500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "How do you distract your\nmind for a few minutes?"
    } ]
  }, {
    "tStartMs": 703950,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "How do you stay calm when you feel like,"
    } ]
  }, {
    "tStartMs": 706357,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "\"This is not something I'm used to?\""
    } ]
  }, {
    "tStartMs": 710100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Calming my mind while holding my breath"
    } ]
  }, {
    "tStartMs": 712230,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "was honestly the most challenging part."
    } ]
  }, {
    "tStartMs": 714510,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But it really helped to have"
    } ]
  }, {
    "tStartMs": 715680,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "a knowledgeable, experienced\nguide there in Brandon"
    } ]
  }, {
    "tStartMs": 718470,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to help me through it."
    } ]
  }, {
    "tStartMs": 719940,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And I think that sort of assistance"
    } ]
  }, {
    "tStartMs": 721680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "can be helpful in everyday life, too,"
    } ]
  }, {
    "tStartMs": 723510,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "which is why this part of the video"
    } ]
  }, {
    "tStartMs": 724740,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "was sponsored by BetterHelp."
    } ]
  }, {
    "tStartMs": 726630,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The idea of BetterHelp is simple,"
    } ]
  }, {
    "tStartMs": 728310,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to connect you with an\nexperienced, licensed therapist"
    } ]
  }, {
    "tStartMs": 730800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "who is trained to listen"
    } ]
  }, {
    "tStartMs": 732300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and give you helpful, unbiased advice."
    } ]
  }, {
    "tStartMs": 734550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And I know from personal experience"
    } ]
  }, {
    "tStartMs": 736440,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that finding a good therapist is hard,"
    } ]
  }, {
    "tStartMs": 738420,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "especially when you only have\nthe options in your city."
    } ]
  }, {
    "tStartMs": 741090,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But BetterHelp changes the game on this."
    } ]
  }, {
    "tStartMs": 743220,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's an online platform,"
    } ]
  }, {
    "tStartMs": 744480,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and by filling out a few questions,"
    } ]
  }, {
    "tStartMs": 746220,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "you'll get matched with\na professional therapist,"
    } ]
  }, {
    "tStartMs": 748260,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "so you can get talking in\nas little as a few days."
    } ]
  }, {
    "tStartMs": 751350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "You can have your therapy\nsessions as a phone call,"
    } ]
  }, {
    "tStartMs": 753630,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "as a video chat, or even via\nmessaging if you prefer that,"
    } ]
  }, {
    "tStartMs": 756960,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "whatever's the most comfortable\nversion of therapy for you."
    } ]
  }, {
    "tStartMs": 760470,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "It's easy to sign up."
    } ]
  }, {
    "tStartMs": 761820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "There's a link in the description."
    } ]
  }, {
    "tStartMs": 763380,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It is betterhelp.com/veritasium."
    } ]
  }, {
    "tStartMs": 766650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Clicking that link both\nhelps support this channel"
    } ]
  }, {
    "tStartMs": 768930,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and it also gets you 10% off\nyour first month of BetterHelp,"
    } ]
  }, {
    "tStartMs": 771930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "so you can try it out\nand see if it helps you."
    } ]
  }, {
    "tStartMs": 774570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And if you don't really fit\nwith your first therapist,"
    } ]
  }, {
    "tStartMs": 777030,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "which is common,"
    } ]
  }, {
    "tStartMs": 777990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "you can easily switch\nto a new one for free"
    } ]
  }, {
    "tStartMs": 779970,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "without stressing about insurance,"
    } ]
  }, {
    "tStartMs": 781680,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "who's in your network,\nor anything like that."
    } ]
  }, {
    "tStartMs": 784110,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Regardless of if you have a\nclinical mental health issue"
    } ]
  }, {
    "tStartMs": 786390,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "like depression or anxiety,"
    } ]
  }, {
    "tStartMs": 788280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or if you're just a human\nwho lives in this world"
    } ]
  }, {
    "tStartMs": 790620,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "who has fears or stresses,"
    } ]
  }, {
    "tStartMs": 792210,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "I can't recommend speaking"
    } ]
  }, {
    "tStartMs": 793500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to an experienced professional enough."
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "To give BetterHelp a try,"
    } ]
  }, {
    "tStartMs": 796890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "visit betterhelp.com/veritasium"
    } ]
  }, {
    "tStartMs": 798900,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "or click that link in the description."
    } ]
  }, {
    "tStartMs": 800520,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "And now, back to breath holding."
    } ]
  }, {
    "tStartMs": 804420,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I managed to hold my breath\nfor two minutes and 36 seconds,"
    } ]
  }, {
    "tStartMs": 807420,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but that is nowhere near the record."
    } ]
  }, {
    "tStartMs": 810540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "In 2014, Branko Petrovic held his breath"
    } ]
  }, {
    "tStartMs": 813780,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "for an astonishing 11\nminutes and 54 seconds."
    } ]
  }, {
    "tStartMs": 817830,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "He did this after\nbreathing just regular air."
    } ]
  }, {
    "tStartMs": 821910,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But there are additional ways"
    } ]
  }, {
    "tStartMs": 823440,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to extend breath hold duration."
    } ]
  }, {
    "tStartMs": 826380,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "One way is to spend time at high altitude"
    } ]
  }, {
    "tStartMs": 829050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or in low oxygen chambers."
    } ]
  }, {
    "tStartMs": 831720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Right now it's set to 5,000 meters."
    } ]
  }, {
    "tStartMs": 834210,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- In the chamber,"
    } ]
  }, {
    "tStartMs": 835590,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "there's not a lot of O2 in there?"
    } ]
  }, {
    "tStartMs": 836850,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Right, very little."
    } ]
  }, {
    "tStartMs": 838200,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- This triggers your body to\ncreate more red blood cells,"
    } ]
  }, {
    "tStartMs": 840780,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "increasing your oxygen carrying capacity."
    } ]
  }, {
    "tStartMs": 843840,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But if you really want\nto extend your time,"
    } ]
  }, {
    "tStartMs": 846540,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "you could breathe pure oxygen beforehand."
    } ]
  }, {
    "tStartMs": 850290,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Brandon's record for a\nnon-oxygenated breath hold"
    } ]
  }, {
    "tStartMs": 853260,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "is 10 minutes."
    } ]
  }, {
    "tStartMs": 854640,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But with oxygen, he has held\nhis breath for 23 minutes."
    } ]
  }, {
    "tStartMs": 859710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Breathing pure oxygen is dangerous"
    } ]
  }, {
    "tStartMs": 861660,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "if you don't know what you're doing,"
    } ]
  }, {
    "tStartMs": 863250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "especially dangerous for free divers."
    } ]
  }, {
    "tStartMs": 865380,
    "dDurationMs": 1197,
    "segs": [ {
      "utf8": "- The theory says if you do that"
    } ]
  }, {
    "tStartMs": 866577,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and you pass six meters,\nor five or six meters,"
    } ]
  }, {
    "tStartMs": 869580,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "your risk of oxygen\ntoxicity is much higher."
    } ]
  }, {
    "tStartMs": 873240,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] But if done correctly,"
    } ]
  }, {
    "tStartMs": 874590,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "breathing pure oxygen before a hold"
    } ]
  }, {
    "tStartMs": 876780,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "can extend it dramatically."
    } ]
  }, {
    "tStartMs": 879060,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The current record is\nheld by Budimir Sobat,"
    } ]
  }, {
    "tStartMs": 881850,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "who held his breath for\n24 minutes and 37 seconds"
    } ]
  }, {
    "tStartMs": 885780,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "after breathing pure oxygen."
    } ]
  }, {
    "tStartMs": 888690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "For this video, Brandon went through"
    } ]
  }, {
    "tStartMs": 890730,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "a lengthy breathe-up process,"
    } ]
  }, {
    "tStartMs": 892530,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "and the last part involved\nbreathing pure oxygen."
    } ]
  }, {
    "tStartMs": 896850,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Here he is packing in the last few gulps."
    } ]
  }, {
    "tStartMs": 902021,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "(ethereal music)"
    } ]
  }, {
    "tStartMs": 904194,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "- [Timekeeper] 15 minutes, 15 minutes!"
    } ]
  }, {
    "tStartMs": 908460,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] But even with oxygen,"
    } ]
  }, {
    "tStartMs": 910110,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "remaining submerged for\nall this time isn't easy."
    } ]
  }, {
    "tStartMs": 914910,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "With his wife, Brandon has pioneered"
    } ]
  }, {
    "tStartMs": 916920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the first active underwater performance"
    } ]
  }, {
    "tStartMs": 919080,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that lasts 10 minutes."
    } ]
  }, {
    "tStartMs": 921270,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- It's one thing to choreograph a piece"
    } ]
  }, {
    "tStartMs": 923670,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and direct it and put it together"
    } ]
  }, {
    "tStartMs": 925740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "when you are able to communicate normally,"
    } ]
  }, {
    "tStartMs": 928560,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "when you're not dealing\nwith different elements."
    } ]
  }, {
    "tStartMs": 931050,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But when you have a man underwater"
    } ]
  }, {
    "tStartMs": 933900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and you're trying to\nset something to music"
    } ]
  }, {
    "tStartMs": 935670,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and you're trying to give direction"
    } ]
  }, {
    "tStartMs": 937230,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and you're trying to piece this together"
    } ]
  }, {
    "tStartMs": 938640,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "with an aerial dance,"
    } ]
  }, {
    "tStartMs": 940860,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "we've done some really big\nprojects in our careers,"
    } ]
  }, {
    "tStartMs": 942870,
    "dDurationMs": 1364,
    "segs": [ {
      "utf8": "but this was unlike"
    } ]
  }, {
    "tStartMs": 944234,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "(Brandon laughing)"
    } ]
  }, {
    "tStartMs": 945167,
    "dDurationMs": 2773,
    "segs": [ {
      "utf8": "any other challenging piece of theater"
    } ]
  }, {
    "tStartMs": 947940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that we've had to put\ntogether, that's for sure."
    } ]
  }, {
    "tStartMs": 950220,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "This has never been done before,"
    } ]
  }, {
    "tStartMs": 951300,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "so we're literally\nwriting the book as we go"
    } ]
  }, {
    "tStartMs": 952950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and we're trying to make sure that,"
    } ]
  }, {
    "tStartMs": 955140,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "we have to take risks to make\nsomething that's this crazy."
    } ]
  }, {
    "tStartMs": 958770,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But it's that limit, right?"
    } ]
  }, {
    "tStartMs": 961620,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "How far do you go, how far do you push?"
    } ]
  }, {
    "tStartMs": 964050,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "I think we're dancing on that line."
    } ]
  }, {
    "tStartMs": 967500,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- You have the urge to breathe,"
    } ]
  }, {
    "tStartMs": 968760,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and it starts kind of like"
    } ]
  }, {
    "tStartMs": 970080,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "maybe a little bit in the\nchest or the lower diaphragm."
    } ]
  }, {
    "tStartMs": 973170,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But then, eventually,"
    } ]
  }, {
    "tStartMs": 974370,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "you'll start to really\nhave these convulsions."
    } ]
  }, {
    "tStartMs": 980550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "CO2 has a slight narcotic effect as well."
    } ]
  }, {
    "tStartMs": 982770,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "You get it high enough,\nyou lose sense of time,"
    } ]
  }, {
    "tStartMs": 985200,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and that's one of the ways that you know"
    } ]
  }, {
    "tStartMs": 986760,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that your breath hold is over."
    } ]
  }, {
    "tStartMs": 988380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- What do you mean, you\nlose a sense of time?"
    } ]
  }, {
    "tStartMs": 990390,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Time is slow or time is fast"
    } ]
  }, {
    "tStartMs": 992100,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or you have no idea how\nfast time is passing?"
    } ]
  }, {
    "tStartMs": 994440,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No idea."
    } ]
  }, {
    "tStartMs": 995273,
    "dDurationMs": 2707,
    "segs": [ {
      "utf8": "You're totally, you're screwed."
    } ]
  }, {
    "tStartMs": 997980,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Your urge to breathe increases, increases,"
    } ]
  }, {
    "tStartMs": 999840,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "increases, increases, increases."
    } ]
  }, {
    "tStartMs": 1001910,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "Then, the urge to breathe just plummets."
    } ]
  }, {
    "tStartMs": 1004123,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1008360,
    "dDurationMs": 2059,
    "segs": [ {
      "utf8": "- [Melissa] 16:45."
    } ]
  }, {
    "tStartMs": 1010419,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "- And you're like, \"Oh, I'm fine.\""
    } ]
  }, {
    "tStartMs": 1011780,
    "dDurationMs": 3053,
    "segs": [ {
      "utf8": "but your body's not fine."
    } ]
  }, {
    "tStartMs": 1014833,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(laughs maniacally)"
    } ]
  }, {
    "tStartMs": 1021650,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Timekeeper] 17 minutes."
    } ]
  }, {
    "tStartMs": 1022940,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "- So, that's when you\ngot to pull the plug."
    } ]
  }, {
    "tStartMs": 1024763,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(laughs maniacally)"
    } ]
  }, {
    "tStartMs": 1029810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] And if you want to\nlearn how to hold your breath"
    } ]
  }, {
    "tStartMs": 1031490,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for up to five minutes,"
    } ]
  }, {
    "tStartMs": 1032750,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "check out Brandon's\ninformation in the description."
    } ]
  }, {
    "tStartMs": 1037070,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "What was going on in your head?"
    } ]
  }, {
    "tStartMs": 1038900,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- In the first few minutes,"
    } ]
  }, {
    "tStartMs": 1040070,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "I'm just focused on retaining\nthat really heavy pack"
    } ]
  }, {
    "tStartMs": 1043880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and not letting my epiglottis\ncome open or losing any air."
    } ]
  }, {
    "tStartMs": 1047000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Making sure that while I'm engaging that,"
    } ]
  }, {
    "tStartMs": 1049400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I'm not also engaging other muscles,"
    } ]
  }, {
    "tStartMs": 1051410,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "like my traps or my\nback or my intercostals."
    } ]
  }, {
    "tStartMs": 1055400,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So, just focusing on that\none tiny muscle group"
    } ]
  }, {
    "tStartMs": 1058430,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "that I need to engage,"
    } ]
  }, {
    "tStartMs": 1059480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "making sure that everything else is calm."
    } ]
  }, {
    "tStartMs": 1061490,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And then, after about five minutes,"
    } ]
  }, {
    "tStartMs": 1063230,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "my lung volume goes down\nenough that I can really relax."
    } ]
  }, {
    "tStartMs": 1066320,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So, then, typically between\nfive and 15 minutes,"
    } ]
  }, {
    "tStartMs": 1069110,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "I'm super relaxed."
    } ]
  }, {
    "tStartMs": 1070580,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "I have this sense of falling,\nI feel super euphoric."
    } ]
  }, {
    "tStartMs": 1074780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And then, typically, after 15,"
    } ]
  }, {
    "tStartMs": 1076760,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "then the CO2 starts to encroach on me."
    } ]
  }, {
    "tStartMs": 1079970,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And as it goes up, I have\nto focus more and more"
    } ]
  }, {
    "tStartMs": 1082790,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "on fighting the mechanisms\nof the urge to breathe,"
    } ]
  }, {
    "tStartMs": 1085880,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "like my diaphragm, like my intercostals,"
    } ]
  }, {
    "tStartMs": 1087860,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "like my epiglottis fluttering,"
    } ]
  }, {
    "tStartMs": 1089270,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "stuff like that."
    } ]
  }, {
    "tStartMs": 1090350,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Can you feel a difference in your blood"
    } ]
  }, {
    "tStartMs": 1092660,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "when you're getting really acidic?"
    } ]
  }, {
    "tStartMs": 1094220,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Yeah, yeah, absolutely."
    } ]
  }, {
    "tStartMs": 1095150,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] What does that feel like?"
    } ]
  }, {
    "tStartMs": 1096920,
    "dDurationMs": 836,
    "segs": [ {
      "utf8": "- Acidic."
    } ]
