  }, {
    "tStartMs": 1099200,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Feels like the urge to breathe."
    } ]
  }, {
    "tStartMs": 1100670,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "If you do it enough\ntimes, you get used to it."
