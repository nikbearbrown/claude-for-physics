  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 30,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "Recently I made a video about what the world looks like in the ultraviolet"
    } ]
  }, {
    "tStartMs": 4640,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Some things look the same but generally it's hazier"
    } ]
  }, {
    "tStartMs": 8480,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "sometimes light and dark are flipped"
    } ]
  }, {
    "tStartMs": 10920,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "skin looks blotchier and fake teeth stand out"
    } ]
  }, {
    "tStartMs": 15340,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Whoa!"
    } ]
  }, {
    "tStartMs": 17180,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Smile for me"
    } ]
  }, {
    "tStartMs": 18880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Oh my goodness"
    } ]
  }, {
    "tStartMs": 20080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Are my teeth black?"
    } ]
  }, {
    "tStartMs": 25360,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Do you have a fake tooth baby?"
    } ]
  }, {
    "tStartMs": 27680,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "--Yes --Which one?"
    } ]
  }, {
    "tStartMs": 30200,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "but the idea for this video started a long time ago with a question I had which is,"
    } ]
  }, {
    "tStartMs": 34520,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "How does non ionizing radiation like ultraviolet light"
    } ]
  }, {
    "tStartMs": 38260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "like ultraviolet light damage skin and lead to cancer?"
    } ]
  }, {
    "tStartMs": 41080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "I do like to tell people that if you want to see how good your skin could look,"
    } ]
  }, {
    "tStartMs": 44240,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "look at your butt"
    } ]
  }, {
    "tStartMs": 45340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "because that's an area that doesn't get sun"
    } ]
  }, {
    "tStartMs": 47380,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and even old people have perfect butts"
    } ]
  }, {
    "tStartMs": 49700,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "it's how your skin would age without the sun"
    } ]
  }, {
    "tStartMs": 52560,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "when I thought about what UV light must be doing to our cells and our DNA,"
    } ]
  }, {
    "tStartMs": 56840,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "I imagined it would be getting in there and breaking all these bonds and that would be the problem"
    } ]
  }, {
    "tStartMs": 61440,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "but in fact it's kinda the opposite"
    } ]
  }, {
    "tStartMs": 63800,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "UV actually facilitates the formation of covalent bonds in our DNA that shouldn't be there."
    } ]
  }, {
    "tStartMs": 70340,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "It comes in and it kind of creates these unauthorized bonds between the bases"
    } ]
  }, {
    "tStartMs": 75020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "called pyrimidine dimers"
    } ]
  }, {
    "tStartMs": 76820,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "instead of having them bonded across it bonds the one next to each other"
    } ]
  }, {
    "tStartMs": 80440,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "if that makes sense. -- Oh. -- Yeah."
    } ]
  }, {
    "tStartMs": 81980,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "so what happens is two thymines, which are side be side,"
    } ]
  }, {
    "tStartMs": 85140,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "can actually get covalently bonded together"
    } ]
  }, {
    "tStartMs": 87820,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and that creates a lesion on the DNA you can think of it like a little bump"
    } ]
  }, {
    "tStartMs": 91600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that makes the DNA hard to read and work with"
    } ]
  }, {
    "tStartMs": 94540,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "That's not enough in itself to cause skin cancer. If that were the case we would just be covered in skin cancers"
    } ]
  }, {
    "tStartMs": 99060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "then the next step is that we have to repair it"
    } ]
  }, {
    "tStartMs": 101820,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and in the repair,"
    } ]
  }, {
    "tStartMs": 103360,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "that's when you form mutations that could eventually lead to cancer through a bunch of different pathways"
    } ]
  }, {
    "tStartMs": 108320,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and there's actually people who have specific"
    } ]
  }, {
    "tStartMs": 111220,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "genetic issues that they can't repair these issues and they are covered in skin cancer"
    } ]
  }, {
    "tStartMs": 116700,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "UV has other effects on the body like"
    } ]
  }, {
    "tStartMs": 119080,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "suppresses the immune system so, as Haley says, it's a \"double whammy\""
    } ]
  }, {
    "tStartMs": 123520,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "There's also kind of a double whammy because UV not only induces these unauthorized bonds"
    } ]
  }, {
    "tStartMs": 129000,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "it actually tamps down our natural immune system"
    } ]
  }, {
    "tStartMs": 132660,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "so one of the best ways we fight cancer is through our immune system"
    } ]
  }, {
    "tStartMs": 135980,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "we have constantly need surveillance through our skin"
    } ]
  }, {
    "tStartMs": 138580,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "so not only is sunlight creating these problems,"
    } ]
  }, {
    "tStartMs": 141340,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "It's actually reducing our ability to fix them."
    } ]
  }, {
    "tStartMs": 144900,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "So unfair"
    } ]
  }, {
    "tStartMs": 145920,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "UV light also causes us to visibly age. It's called photo-aging"
    } ]
  }, {
    "tStartMs": 151400,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "I should clear up a misconception here that I had which was, I thought glass blocks all ultra-violet light."
    } ]
  }, {
    "tStartMs": 157280,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "so I thought if you're inside a car, for example, you really don't need to put on sunscreen because,"
    } ]
  }, {
    "tStartMs": 161840,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "you're not being exposed to UV light"
    } ]
  }, {
    "tStartMs": 163560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The car does not block UVA. It's glass"
    } ]
  }, {
    "tStartMs": 165840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It does block most UVB"
    } ]
  }, {
    "tStartMs": 168040,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "but you're still susceptible to those sunspots and those wrinkles through the glass"
    } ]
  }, {
    "tStartMs": 172560,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "and a lot of my patients if you look and you compare their hands,"
    } ]
  }, {
    "tStartMs": 175540,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "the left is is more wrinkled or has more sunspots on it because they're driving."
    } ]
  }, {
    "tStartMs": 181000,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "So they're sticking that hand... --Sticking that hand out their truckers. Absolutely you can see it the worst"
    } ]
  }, {
    "tStartMs": 186140,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And there's a really famous picture of someone whose left side of their face"
    } ]
  }, {
    "tStartMs": 189900,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "is significantly more, as we'll call photo-aged, or old-looking, than the other side of their face."
    } ]
  }, {
    "tStartMs": 195620,
    "dDurationMs": 5780,
    "segs": [ {
      "utf8": "So that's mostly UVA and UVA, as I said, it's a longer wavelength, penetrates a little bit deeper."
    } ]
  }, {
    "tStartMs": 201400,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "so wrinkles mostly come from destruction of our collagen and elastin"
    } ]
  }, {
    "tStartMs": 206440,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "which is natural fibers that hold up the scaffolding of our skin"
    } ]
  }, {
    "tStartMs": 210380,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "so with age the cells that secrete collagen"
    } ]
  }, {
    "tStartMs": 213840,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "they're called fibroblasts they stop producing as much"
    } ]
  }, {
    "tStartMs": 217020,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "and what the Sun does is it breaks down the existing collagen and elastin we have"
    } ]
  }, {
    "tStartMs": 221800,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "so fibroblasts really like to be stretched, they like to be pulled and collagen does that, that collagen matrix"
    } ]
  }, {
    "tStartMs": 228040,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "so the Sun damages the collagen fibers leading to less stretch on fibroblasts"
    } ]
  }, {
    "tStartMs": 232760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and less production of collagen"
    } ]
  }, {
    "tStartMs": 235000,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "which means that you look a little more saggy"
    } ]
  }, {
    "tStartMs": 238020,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "I know it's very depressing so sun protection helps the degradation of those collagen and elastin fibers"
    } ]
  }, {
    "tStartMs": 244560,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "You know there are a lot of creams on the market that claim to be anti-aging"
    } ]
  }, {
    "tStartMs": 249120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but the one that really works"
    } ]
  }, {
    "tStartMs": 251280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "is sunscreen"
    } ]
  }, {
    "tStartMs": 253360,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "preventing ultraviolet light from hitting your skin is the best thing you can do"
    } ]
  }, {
    "tStartMs": 258580,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "to avoid skin cancer and to avoid photo aging"
    } ]
  }, {
    "tStartMs": 262680,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "So yeah. It's good advice. Use sunscreen."
    } ]
  }, {
    "tStartMs": 270960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "hey I'm on set for Jurassic world fallen"
    } ]
  }, {
    "tStartMs": 273840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Kingdom and I'm here filming sci-fi test"
    } ]
  }, {
    "tStartMs": 276180,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "lab where we try to recreate some"
    } ]
  }, {
    "tStartMs": 278190,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "dinosaur parts out of machinery and test"
    } ]
  }, {
    "tStartMs": 280800,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "them out so if you want to see that then"
    } ]
  }, {
    "tStartMs": 282440,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "click here"
    } ]
  } ]
}
