{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "This metal is about as close to magic"
    } ]
  }, {
    "tStartMs": 2100,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "as it is possible to find in nature."
    } ]
  }, {
    "tStartMs": 3810,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "I just don't get it."
    } ]
  }, {
    "tStartMs": 5910,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It can adjust its arrangement of atoms"
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to return to some predefined shape,"
    } ]
  }, {
    "tStartMs": 11670,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "but it also converts between\nmechanical and thermal energy."
    } ]
  }, {
    "tStartMs": 16500,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And it can stretch up to 30 times more"
    } ]
  }, {
    "tStartMs": 19530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "than an ordinary metal"
    } ]
  }, {
    "tStartMs": 20820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and still spring back\nto its original size."
    } ]
  }, {
    "tStartMs": 23820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I can feel it in my hands shrinking back."
    } ]
  }, {
    "tStartMs": 26160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Because of these unique properties,"
    } ]
  }, {
    "tStartMs": 28080,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "it's being used in everything\nfrom medical devices to toys,"
    } ]
  }, {
    "tStartMs": 31950,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "to bulletproof bike tires."
    } ]
  }, {
    "tStartMs": 36000,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And it's allowing NASA\nto reinvent the wheel"
    } ]
  }, {
    "tStartMs": 39210,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "for a space exploration."
    } ]
  }, {
    "tStartMs": 41580,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- This is the bones of the tire."
    } ]
  }, {
    "tStartMs": 44490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] The bones of\nthe tire is a slinky."
    } ]
  }, {
    "tStartMs": 46110,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "- So basically this is the\nslinky applied to the rim."
    } ]
  }, {
    "tStartMs": 51090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- You just wrapped a slinky around a rim."
    } ]
  }, {
    "tStartMs": 53190,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 54023,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "It doesn't get any\nsimpler than that, right?"
    } ]
  }, {
    "tStartMs": 55320,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "Here is a bicycle that has\nslinkies inside a polymer,"
    } ]
  }, {
    "tStartMs": 59670,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "if you look inside there."
    } ]
  }, {
    "tStartMs": 61140,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- [Derek] This tire does not\nrequire air pressure to work."
    } ]
  }, {
    "tStartMs": 64290,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The structure and shock absorption"
    } ]
  }, {
    "tStartMs": 66510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "are all provided by that metal slinky."
    } ]
  }, {
    "tStartMs": 68670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Jim] So that's like\naround a hundred psi"
    } ]
  }, {
    "tStartMs": 70860,
    "dDurationMs": 1573,
    "segs": [ {
      "utf8": "or what a normal road\nbike would feel like."
    } ]
  }, {
    "tStartMs": 72433,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Yeah."
    } ]
  }, {
    "tStartMs": 73266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "Which means you should\nbe able to puncture it"
    } ]
  }, {
    "tStartMs": 75000,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "with no loss of performance."
    } ]
  }, {
    "tStartMs": 76560,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So we're gonna drive\nit over a bed of nails,"
    } ]
  }, {
    "tStartMs": 79530,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but first we'll test a\ntraditional pneumatic tire"
    } ]
  }, {
    "tStartMs": 82650,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "just to make sure these nails are sharp."
    } ]
  }, {
    "tStartMs": 84890,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(tires popping)"
    } ]
  }, {
    "tStartMs": 88223,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 94080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- [Jim] Another puncture,\nanother flat tire."
    } ]
  }, {
    "tStartMs": 96660,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- This one, kind of expected."
    } ]
  }, {
    "tStartMs": 98430,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "So now I'm going to put these\nairless tires to the test"
    } ]
  }, {
    "tStartMs": 102510,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "driving over the same bed of nails."
    } ]
  }, {
    "tStartMs": 105660,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "Here we go."
    } ]
  }, {
    "tStartMs": 107017,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(tires popping)"
    } ]
  }, {
    "tStartMs": 111660,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I heard a lot of pops."
    } ]
  }, {
    "tStartMs": 113070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I must have hit some nails."
    } ]
  }, {
    "tStartMs": 115230,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I don't feel anything different."
    } ]
  }, {
    "tStartMs": 118491,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 124830,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "Still rides well."
    } ]
  }, {
    "tStartMs": 127350,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I'm gonna get up some speed."
    } ]
  }, {
    "tStartMs": 133170,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Jim] That's definitely a nail."
    } ]
  }, {
    "tStartMs": 134310,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] I think the nail broke in it,"
    } ]
  }, {
    "tStartMs": 135450,
    "dDurationMs": 902,
    "segs": [ {
      "utf8": "why does it look like-"
    } ]
  }, {
    "tStartMs": 136352,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Jim] That's what it looks like."
    } ]
  }, {
    "tStartMs": 137185,
    "dDurationMs": 1895,
    "segs": [ {
      "utf8": "- [Derek] Yeah the nail's in the tire."
    } ]
  }, {
    "tStartMs": 139080,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "- We're now gonna try to\nshoot a bullet into the tire"
    } ]
  }, {
    "tStartMs": 142890,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "and see what happens."
    } ]
  }, {
    "tStartMs": 143956,
    "dDurationMs": 1526,
    "segs": [ {
      "utf8": "3, 2, 1."
    } ]
  }, {
    "tStartMs": 145482,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "(bullet firing)"
    } ]
  }, {
    "tStartMs": 147402,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 153360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- There it is."
    } ]
  }, {
    "tStartMs": 154193,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- There it is."
    } ]
  }, {
    "tStartMs": 155026,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "- Whoo!\n- Look at that."
    } ]
  }, {
    "tStartMs": 156143,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "(Derek chuckling)"
    } ]
  }, {
    "tStartMs": 157860,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] Wow."
    } ]
  }, {
    "tStartMs": 159300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's a really clean shot straight through."
    } ]
  }, {
    "tStartMs": 161700,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- [Jim] Yep, you can barely\neven see the mark on the tire."
    } ]
  }, {
    "tStartMs": 164580,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "Looks like this one actually hit the-"
    } ]
  }, {
    "tStartMs": 167940,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Alloy?"
    } ]
  }, {
    "tStartMs": 168773,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "- [Jim] Yep, it does to me."
    } ]
  }, {
    "tStartMs": 170010,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] Yeah that's what it feels like."
    } ]
  }, {
    "tStartMs": 171150,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Jim] You can see we\nspliced off some of the bullet"
    } ]
  }, {
    "tStartMs": 173190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "before we even got to the cardboard."
    } ]
  }, {
    "tStartMs": 175080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Jim] How's the ride?"
    } ]
  }, {
    "tStartMs": 176640,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Yeah no problems."
    } ]
  }, {
    "tStartMs": 178410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Bulletproof bicycle."
    } ]
  }, {
    "tStartMs": 180270,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "This bulletproof bike tire actually"
    } ]
  }, {
    "tStartMs": 182340,
    "dDurationMs": 1555,
    "segs": [ {
      "utf8": "comes out of NASA's research"
    } ]
  }, {
    "tStartMs": 183895,
    "dDurationMs": 2738,
    "segs": [ {
      "utf8": "into making wheels for space missions."
    } ]
  }, {
    "tStartMs": 188245,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 189078,
    "dDurationMs": 2772,
    "segs": [ {
      "utf8": "It is really hard to make\ngood wheels for other planets."
    } ]
  }, {
    "tStartMs": 191850,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I mean a lot of the places\nwe wanna send rovers to,"
    } ]
  }, {
    "tStartMs": 194070,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "there is no or very low\natmospheric pressure."
    } ]
  }, {
    "tStartMs": 197430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- We can't use rubber pneumatic tires"
    } ]
  }, {
    "tStartMs": 199530,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because of the extreme\nconditions on the moon and Mars"
    } ]
  }, {
    "tStartMs": 201660,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "there's no confining\npressure outside of it."
    } ]
  }, {
    "tStartMs": 203250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It can basically explode."
    } ]
  }, {
    "tStartMs": 204930,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] Besides with temperatures"
    } ]
  }, {
    "tStartMs": 206340,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "dropping to extreme lows,\nrubber becomes brittle."
    } ]
  }, {
    "tStartMs": 209520,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "- If this were a flagpole,\nthe temperature facing the sun"
    } ]
  }, {
    "tStartMs": 213510,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "would be 250 degrees\nFahrenheit above zero."
    } ]
  }, {
    "tStartMs": 216900,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "In the shadow it's 250 degrees below zero."
    } ]
  }, {
    "tStartMs": 219750,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Let's put some rubber on the moon."
    } ]
  }, {
    "tStartMs": 222300,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- 90 is the glass transition temperature."
    } ]
  }, {
    "tStartMs": 224970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's when the polymer\ngoes from being flexible"
    } ]
  }, {
    "tStartMs": 227850,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to a rigid element."
    } ]
  }, {
    "tStartMs": 229620,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] This is what\nhappens when you dip rubber"
    } ]
  }, {
    "tStartMs": 231840,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "in liquid nitrogen."
    } ]
  }, {
    "tStartMs": 235845,
    "dDurationMs": 3349,
    "segs": [ {
      "utf8": "(rubber exploding)"
    } ]
  }, {
    "tStartMs": 239194,
    "dDurationMs": 1007,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 240201,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Jim chuckling)"
    } ]
  }, {
    "tStartMs": 241034,
    "dDurationMs": 2446,
    "segs": [ {
      "utf8": "That's why you can't\nsend rubber to the moon."
    } ]
  }, {
    "tStartMs": 243480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "This is why almost all the wheels used"
    } ]
  }, {
    "tStartMs": 245490,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "for exploring other planets\nhave been made of hard metal."
    } ]
  }, {
    "tStartMs": 248760,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- This is actually a spare\nfor the curiosity rover."
    } ]
  }, {
    "tStartMs": 251970,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "They're made out of aluminum."
    } ]
  }, {
    "tStartMs": 252990,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "A single billet that gets machined down"
    } ]
  }, {
    "tStartMs": 254580,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "so you don't have to worry\nabout fasteners or welds"
    } ]
  }, {
    "tStartMs": 256590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or anything like that,"
    } ]
  }, {
    "tStartMs": 257423,
    "dDurationMs": 2617,
    "segs": [ {
      "utf8": "that could potentially be a failure point."
    } ]
  }, {
    "tStartMs": 260040,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- But with it being so expensive"
    } ]
  }, {
    "tStartMs": 261690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to launch matter into space,"
    } ]
  }, {
    "tStartMs": 263220,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the wheels have to be as\nlightweight as possible."
    } ]
  }, {
    "tStartMs": 265590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's lightish, but it's still heavy."
    } ]
  }, {
    "tStartMs": 268590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- To meet those mass\nlimitations they made the skin"
    } ]
  }, {
    "tStartMs": 271530,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "0.7 millimeters thick thin."
    } ]
  }, {
    "tStartMs": 272880,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Thinner than a credit card."
    } ]
  }, {
    "tStartMs": 273990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Yep, these structural members here,"
    } ]
  }, {
    "tStartMs": 275970,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which we also call grousers,"
    } ]
  }, {
    "tStartMs": 277590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "they're there to give the wheel strength,"
    } ]
  }, {
    "tStartMs": 279390,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "but also help grab onto\nobstacles and help grab the soil."
    } ]
  }, {
    "tStartMs": 282930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The problem is that because\nthis rubber is so large"
    } ]
  }, {
    "tStartMs": 285240,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and heavy and the terrain is\njust so aggressive and nasty,"
    } ]
  }, {
    "tStartMs": 289050,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "they're actually seeing\nmuch higher peak loads"
    } ]
  }, {
    "tStartMs": 291690,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "kind of focused on areas\nbetween these grousers"
    } ]
  }, {
    "tStartMs": 294390,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "than what was predicted."
    } ]
  }, {
    "tStartMs": 295560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "This is the actual condition of the wheels"
    } ]
  }, {
    "tStartMs": 297840,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "on Mars right now."
    } ]
  }, {
    "tStartMs": 298860,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And as you can see, we've\ngot big holes and cracks"
    } ]
  }, {
    "tStartMs": 301440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "where that skin was."
    } ]
  }, {
    "tStartMs": 303120,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Now the wheel still operates,\nhasn't immobilized the rover."
    } ]
  }, {
    "tStartMs": 306450,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's still gonna complete its mission,"
    } ]
  }, {
    "tStartMs": 308040,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "but it does affect where it\ncan go and how efficient it is."
    } ]
  }, {
    "tStartMs": 312690,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Derek] When you apply\na force to a material"
    } ]
  }, {
    "tStartMs": 314670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that is known as a stress."
    } ]
  }, {
    "tStartMs": 316590,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And what you're really doing is tugging"
    } ]
  }, {
    "tStartMs": 318780,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "on all the atoms inside the object,"
    } ]
  }, {
    "tStartMs": 321570,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and as a result, their\nspacing changes a little bit"
    } ]
  }, {
    "tStartMs": 324360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and so the material deforms."
    } ]
  }, {
    "tStartMs": 326610,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "For example, if you pull on an object,"
    } ]
  }, {
    "tStartMs": 328710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "it will get slightly longer."
    } ]
  }, {
    "tStartMs": 330660,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "And the per unit change in\nlength is called strain."
    } ]
  }, {
    "tStartMs": 334290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now for most materials under low stresses,"
    } ]
  }, {
    "tStartMs": 337050,
    "dDurationMs": 3057,
    "segs": [ {
      "utf8": "strain is directly proportional\nto the stress applied."
    } ]
  }, {
    "tStartMs": 340107,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "And the more you stress\nit the more it stretches,"
    } ]
  }, {
    "tStartMs": 343080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and the material is elastic."
    } ]
  }, {
    "tStartMs": 345360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "If you remove the stress,"
    } ]
  }, {
    "tStartMs": 346620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the object goes back to its original size."
    } ]
  }, {
    "tStartMs": 349200,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So no atoms have moved around"
    } ]
  }, {
    "tStartMs": 350730,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and no bonds have been broken or formed."
    } ]
  }, {
    "tStartMs": 353160,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "You've just made them flex\nwhen you apply that stress."
    } ]
  }, {
    "tStartMs": 356790,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "But if the stress applied exceeds"
    } ]
  }, {
    "tStartMs": 358800,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the yield strength of the material,"
    } ]
  }, {
    "tStartMs": 360690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "well then the strain is so great"
    } ]
  }, {
    "tStartMs": 362340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that the atoms can't\nmaintain their positions"
    } ]
  }, {
    "tStartMs": 364380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "relative to each other."
    } ]
  }, {
    "tStartMs": 366060,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Defects called edge dislocations"
    } ]
  }, {
    "tStartMs": 367920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "can move through the material."
    } ]
  }, {
    "tStartMs": 369960,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The atoms are actually\nrearranging themselves,"
    } ]
  }, {
    "tStartMs": 372510,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and so the deformation is not reversible."
    } ]
  }, {
    "tStartMs": 375450,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "It's plastic deformation."
    } ]
  }, {
    "tStartMs": 377880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So the object won't go\nback to its original shape"
    } ]
  }, {
    "tStartMs": 380460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "when the stress is removed."
    } ]
  }, {
    "tStartMs": 382260,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "If enough stress is applied,"
    } ]
  }, {
    "tStartMs": 383640,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "the material can completely fracture."
    } ]
  }, {
    "tStartMs": 386910,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "In the worst case scenario,\nthis results in holes"
    } ]
  }, {
    "tStartMs": 389670,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "like in the Mars rover wheels,"
    } ]
  }, {
    "tStartMs": 391260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "which reduce their performance"
    } ]
  }, {
    "tStartMs": 393000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and ultimately could\njeopardize the mission."
    } ]
  }, {
    "tStartMs": 395760,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Ordinary metals can withstand a strain"
    } ]
  }, {
    "tStartMs": 397710,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "of only around 0.3 to 0.8% elastically."
    } ]
  }, {
    "tStartMs": 401670,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Any more than that, and they\nundergo plastic deformation"
    } ]
  }, {
    "tStartMs": 404730,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "so they won't return to\ntheir original shape."
    } ]
  }, {
    "tStartMs": 407670,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "Ultimately, they could even fracture."
    } ]
  }, {
    "tStartMs": 412470,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 413303,
    "dDurationMs": 1454,
    "segs": [ {
      "utf8": "- [Jim] Yeah and you kinked it too."
    } ]
  }, {
    "tStartMs": 414757,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- Kinked it and stretched it."
    } ]
  }, {
    "tStartMs": 416877,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "And that's why every\ncomponent of a space vehicle"
    } ]
  }, {
    "tStartMs": 419640,
    "dDurationMs": 3473,
    "segs": [ {
      "utf8": "is designed never to stretch\nmore than that 0.3 to 0.8%."
    } ]
  }, {
    "tStartMs": 424140,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "But that's a significant limitation."
    } ]
  }, {
    "tStartMs": 428460,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "There is a different type of wheel"
    } ]
  }, {
    "tStartMs": 430020,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that NASA has tried in space,"
    } ]
  }, {
    "tStartMs": 431550,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "which are those on the Apollo\nLunar Roving Vehicle or LVR."
    } ]
  }, {
    "tStartMs": 436230,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Jim] That particular\nstructure that they built"
    } ]
  }, {
    "tStartMs": 438660,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "is something that we call pantograph."
    } ]
  }, {
    "tStartMs": 440220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "All it is is a set of wires"
    } ]
  }, {
    "tStartMs": 442140,
    "dDurationMs": 2428,
    "segs": [ {
      "utf8": "that have been over,\nunder, over, under woven."
    } ]
  }, {
    "tStartMs": 444568,
    "dDurationMs": 1892,
    "segs": [ {
      "utf8": "- [Derek] And this on the surface here"
    } ]
  }, {
    "tStartMs": 446460,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to get ripped also to strengthen?"
    } ]
  }, {
    "tStartMs": 448500,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- It's primarily to ensure that"
    } ]
  }, {
    "tStartMs": 450420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the tire does not sink into the ground."
    } ]
  }, {
    "tStartMs": 452580,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So they did some studies\nwith these tread strips"
    } ]
  }, {
    "tStartMs": 455370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to figure out how much\ncoverage they needed."
    } ]
  }, {
    "tStartMs": 457080,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And so they found out that\nroughly 50% was enough"
    } ]
  }, {
    "tStartMs": 459990,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to keep the tire kind of\nfloating on the surface"
    } ]
  }, {
    "tStartMs": 461940,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and still maintain that flexibility."
    } ]
  }, {
    "tStartMs": 464940,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] The Lunar Roving\nVehicle wheels worked well"
    } ]
  }, {
    "tStartMs": 466890,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "for the short distance\njourneys traveled on the moon."
    } ]
  }, {
    "tStartMs": 469560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I mean the farthest this vehicle ever went"
    } ]
  }, {
    "tStartMs": 471480,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "was 36 kilometers, but still, these wheels"
    } ]
  }, {
    "tStartMs": 475110,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "needed to be designed to\nminimize plastic deformation"
    } ]
  }, {
    "tStartMs": 477720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of the steel mesh."
    } ]
  }, {
    "tStartMs": 478920,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- And so they put this internal\nstructure inside there."
    } ]
  }, {
    "tStartMs": 482010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "We call it a bump stop."
    } ]
  }, {
    "tStartMs": 483480,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So as they hit a bump,\nand this is deformed,"
    } ]
  }, {
    "tStartMs": 486090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "when it hits that it stops the deformation"
    } ]
  }, {
    "tStartMs": 488880,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "to keep it just below\nthat proportional limit"
    } ]
  }, {
    "tStartMs": 493140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "where they would induce plasticity."
    } ]
  }, {
    "tStartMs": 495570,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Derek] This wheel was good enough"
    } ]
  }, {
    "tStartMs": 496890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for the short Apollo missions,"
    } ]
  }, {
    "tStartMs": 498630,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but for longer journeys a\nbump stop won't be enough"
    } ]
  }, {
    "tStartMs": 501780,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to prevent plastic deformation\nbuilding up over time."
    } ]
  }, {
    "tStartMs": 505260,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Mesh steel wheels have\nbeen tried on earth,"
    } ]
  }, {
    "tStartMs": 508200,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but their performance\ndoes degrade over time."
    } ]
  }, {
    "tStartMs": 511170,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- This was the Mars steel\nspring tire we made and drove"
    } ]
  }, {
    "tStartMs": 514770,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "on that same test rig."
    } ]
  }, {
    "tStartMs": 515910,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "And there's no fracture"
    } ]
  }, {
    "tStartMs": 517080,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but you see a lot of\npermanent deformation there."
    } ]
  }, {
    "tStartMs": 519630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Derek] What we need is a material"
    } ]
  }, {
    "tStartMs": 521100,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that is strong and durable like steel,"
    } ]
  }, {
    "tStartMs": 523410,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but which can endure much more strain"
    } ]
  }, {
    "tStartMs": 525060,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "without deforming permanently."
    } ]
  }, {
    "tStartMs": 527970,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "And that is where this stuff comes in."
    } ]
  }, {
    "tStartMs": 532440,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "In 1961, the Naval Ordnance Laboratory"
    } ]
  }, {
    "tStartMs": 535230,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "was doing experiments\nwith different alloys"
    } ]
  }, {
    "tStartMs": 537360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "involving nickel and titanium."
    } ]
  }, {
    "tStartMs": 539610,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "A sample that had been repeatedly\nworked, heated and cooled"
    } ]
  }, {
    "tStartMs": 543780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "was shown to one of the\nassociate technical directors"
    } ]
  }, {
    "tStartMs": 546750,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "who just happened to be a pipe smoker."
    } ]
  }, {
    "tStartMs": 549450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So he decided to see\nwhat the sample would do"
    } ]
  }, {
    "tStartMs": 551520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "if he applied a bit of\nheat from his lighter."
    } ]
  }, {
    "tStartMs": 554280,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And when he did that,"
    } ]
  }, {
    "tStartMs": 555570,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "he found that the material changed shape."
    } ]
  }, {
    "tStartMs": 558690,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "This shocked everyone and\nled to more investigations"
    } ]
  }, {
    "tStartMs": 561630,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "into the material."
    } ]
  }, {
    "tStartMs": 562710,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Which became known as nitinol,"
    } ]
  }, {
    "tStartMs": 564960,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "for its components nickel and titanium,"
    } ]
  }, {
    "tStartMs": 567750,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and for the Naval Ordinance laboratory"
    } ]
  }, {
    "tStartMs": 570120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "where it was discovered."
    } ]
  }, {
    "tStartMs": 572250,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So why did nitinol change shape?"
    } ]
  }, {
    "tStartMs": 575640,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Well it's really because\nthe alloy can undergo"
    } ]
  }, {
    "tStartMs": 577410,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "a phase change in the solid state."
    } ]
  }, {
    "tStartMs": 580560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "In heated nitinol the atoms are arranged"
    } ]
  }, {
    "tStartMs": 582810,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "in a cubic lattice arrangement,"
    } ]
  }, {
    "tStartMs": 585120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and this phase is known as austenite."
    } ]
  }, {
    "tStartMs": 587640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But upon cooling, the\natoms ease into a form"
    } ]
  }, {
    "tStartMs": 590640,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "known as twinned martensite."
    } ]
  }, {
    "tStartMs": 593640,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "It's a messier lower symmetry\narrangement of the atoms."
    } ]
  }, {
    "tStartMs": 597990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And in this phase, you can\napply stress to the material"
    } ]
  }, {
    "tStartMs": 600540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and deform it."
    } ]
  }, {
    "tStartMs": 601740,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But unlike in an ordinary metal,"
    } ]
  }, {
    "tStartMs": 603690,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "this deformation is not causing\nbonds between atoms to break"
    } ]
  }, {
    "tStartMs": 607170,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and edge dislocations moving\nthroughout the material."
    } ]
  }, {
    "tStartMs": 609960,
    "dDurationMs": 1219,
    "segs": [ {
      "utf8": "Now in this case,"
    } ]
  }, {
    "tStartMs": 611179,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "the crystal structure\nis changing once again"
    } ]
  }, {
    "tStartMs": 614490,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to a detwinned form of martensite."
    } ]
  }, {
    "tStartMs": 617790,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And now when you heat it back up,"
    } ]
  }, {
    "tStartMs": 619290,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the material goes from martensite\nback to being austenite."
    } ]
  }, {
    "tStartMs": 623130,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Which means all the atoms go back"
    } ]
  }, {
    "tStartMs": 624810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to their original locations,"
    } ]
  }, {
    "tStartMs": 626580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and so the material returns\nto its original shape."
    } ]
  }, {
    "tStartMs": 629640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- We can basically set this shape"
    } ]
  }, {
    "tStartMs": 632760,
    "dDurationMs": 4457,
    "segs": [ {
      "utf8": "as the parent known memory shape."
    } ]
  }, {
    "tStartMs": 637217,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "That's why we call it shape memory."
    } ]
  }, {
    "tStartMs": 639570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "I can stretch this out."
    } ]
  }, {
    "tStartMs": 641640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "If I cooled it down I could\nstretch it out even more,"
    } ]
  }, {
    "tStartMs": 643680,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "but as soon as I heat it back up,"
    } ]
  }, {
    "tStartMs": 646950,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "it'll remember that original parent shape."
    } ]
  }, {
    "tStartMs": 650790,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Derek] And that's why\nnitinol is considered"
    } ]
  }, {
    "tStartMs": 652530,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "a shape memory alloy."
    } ]
  }, {
    "tStartMs": 656040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The shape is set at high temperature"
    } ]
  }, {
    "tStartMs": 658050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "when the material is\nin the austenite phase."
    } ]
  }, {
    "tStartMs": 660750,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Then as the material is cooled down,"
    } ]
  }, {
    "tStartMs": 663090,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "it undergoes a phase transition\ninto twinned martensite."
    } ]
  }, {
    "tStartMs": 667140,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "If stress is now applied to\nthe material in this phase,"
    } ]
  }, {
    "tStartMs": 670020,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "it can be extensively deformed\nby changing the crystal"
    } ]
  }, {
    "tStartMs": 673440,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "structure into detwinned martensite."
    } ]
  }, {
    "tStartMs": 676500,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "When the stress is released"
    } ]
  }, {
    "tStartMs": 677970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "most of that deformation remains."
    } ]
  }, {
    "tStartMs": 680640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But when the sample is heated,"
    } ]
  }, {
    "tStartMs": 682950,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the atoms return to the austenite phase,"
    } ]
  }, {
    "tStartMs": 685890,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "which returns the material\nto its original shape."
    } ]
  }, {
    "tStartMs": 691408,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "(Derek laughing)"
    } ]
  }, {
    "tStartMs": 693510,
    "dDurationMs": 1727,
    "segs": [ {
      "utf8": "It's like you're barely in the water."
    } ]
  }, {
    "tStartMs": 695237,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 696070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- And it just-"
    } ]
  }, {
    "tStartMs": 696903,
    "dDurationMs": 1257,
    "segs": [ {
      "utf8": "- It's as fast as you\ncan conduct heat to it"
    } ]
  }, {
    "tStartMs": 698160,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "or get heat away from it."
    } ]
  }, {
    "tStartMs": 700280,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "- [Derek] Whoa, whoa."
    } ]
  }, {
    "tStartMs": 701940,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "I mean that's cool."
    } ]
  }, {
    "tStartMs": 703950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "This is the property of nitinol"
    } ]
  }, {
    "tStartMs": 705660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that most people are aware of,"
    } ]
  }, {
    "tStartMs": 707340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and one that makes it useful\nfor a lot of applications."
    } ]
  }, {
    "tStartMs": 710310,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So that's a stint."
    } ]
  }, {
    "tStartMs": 711600,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- They slightly cool these\ndown right below to martensite,"
    } ]
  }, {
    "tStartMs": 716610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and then they crush it or elongate it."
    } ]
  }, {
    "tStartMs": 718290,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So you can see it gets real thin."
    } ]
  }, {
    "tStartMs": 720060,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And then they put in a catheter"
    } ]
  }, {
    "tStartMs": 722070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and that catheter goes through the body"
    } ]
  }, {
    "tStartMs": 723690,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to the place where they\nwanna deploy the stent."
    } ]
  }, {
    "tStartMs": 726300,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And then upon deploying\nit, it bounces right back."
    } ]
  }, {
    "tStartMs": 729390,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Increasing that outer diameter\nand opening that artery."
    } ]
  }, {
    "tStartMs": 732330,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Nitinol is absolutely perfect for that."
    } ]
  }, {
    "tStartMs": 734430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] Shape memory\nalloys can actually generate"
    } ]
  }, {
    "tStartMs": 736350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "significant forces when they're heated,"
    } ]
  }, {
    "tStartMs": 738360,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "which means they can also\nbe used as actuators."
    } ]
  }, {
    "tStartMs": 741510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- You're gonna see a huge amount of force"
    } ]
  }, {
    "tStartMs": 743490,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and stress build up in the wire,"
    } ]
  }, {
    "tStartMs": 745440,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "which we can see here with\nhow much it's pulling."
    } ]
  }, {
    "tStartMs": 750930,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "- [Derek] Six pounds, seven,"
    } ]
  }, {
    "tStartMs": 753750,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "you can really see it contracting there."
    } ]
  }, {
    "tStartMs": 756247,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "13, 15, 16, 17, 20 pounds."
    } ]
  }, {
    "tStartMs": 764190,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Oh it's lifting it."
    } ]
  }, {
    "tStartMs": 766050,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "That's about 90 newtons of force."
    } ]
  }, {
    "tStartMs": 770130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Scientists have even\nused shape memory alloys"
    } ]
  }, {
    "tStartMs": 772440,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "to fracture a rock."
    } ]
  }, {
    "tStartMs": 776910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Shape memory alloys are being investigated"
    } ]
  }, {
    "tStartMs": 779070,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for use in aviation."
    } ]
  }, {
    "tStartMs": 780720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I made a video before\nabout vortex generators."
    } ]
  }, {
    "tStartMs": 782880,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Which are these little fins that stick up"
    } ]
  }, {
    "tStartMs": 784650,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "outta the wing of a plane"
    } ]
  }, {
    "tStartMs": 785910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to trip the airflow into turbulence."
    } ]
  }, {
    "tStartMs": 788370,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This is important for takeoff and landing"
    } ]
  }, {
    "tStartMs": 790680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to keep the flow attached to\nthe wings so you don't stall."
    } ]
  }, {
    "tStartMs": 793680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- But when you're up at cruise"
    } ]
  }, {
    "tStartMs": 795450,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and you don't need those\nvortices being generated,"
    } ]
  }, {
    "tStartMs": 798690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you want these to stow because\nthey're a drag penalty."
    } ]
  }, {
    "tStartMs": 802050,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "As the plane just climbs\nfrom takeoff to cruise"
    } ]
  }, {
    "tStartMs": 806070,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "we go from some temperature on the ground"
    } ]
  }, {
    "tStartMs": 809880,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "to something close to\n-50, -60 C at cruise."
    } ]
  }, {
    "tStartMs": 813870,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The alloy is designed in between those"
    } ]
  }, {
    "tStartMs": 815910,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "so that we can just take\nadvantage of the ambient"
    } ]
  }, {
    "tStartMs": 818820,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "temperature change that\nhappens in the environment."
    } ]
  }, {
    "tStartMs": 821700,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "When we cool this one down,\nno controller, no operator,"
    } ]
  }, {
    "tStartMs": 827190,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it autonomously stays flat."
    } ]
  }, {
    "tStartMs": 829260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] The temperature at\nwhich the material transitions"
    } ]
  }, {
    "tStartMs": 831540,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "between austenite and\nmartensite can be tuned"
    } ]
  }, {
    "tStartMs": 834270,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to be anywhere between -150\nto -350 degrees Celsius."
    } ]
  }, {
    "tStartMs": 841200,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This is done by changing\nthe ratio of the elements"
    } ]
  }, {
    "tStartMs": 843990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and using different heat treatments."
    } ]
  }, {
    "tStartMs": 846030,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "- [Santo] And then as\nthat would heat back up"
    } ]
  }, {
    "tStartMs": 848660,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "coming into landing,\nit goes right back up."
    } ]
  }, {
    "tStartMs": 858570,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] This principle has been extended"
    } ]
  }, {
    "tStartMs": 860010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to operate the main flaps on an aircraft."
    } ]
  }, {
    "tStartMs": 862980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Now the heating and\ncooling is not passive,"
    } ]
  }, {
    "tStartMs": 865560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but controlled by a heating element."
    } ]
  }, {
    "tStartMs": 867930,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "- So we've done demonstrations\nwhere you have a 737 aircraft"
    } ]
  }, {
    "tStartMs": 872460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and no hydraulic\nactuators on the wing box."
    } ]
  }, {
    "tStartMs": 875160,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "All we have is a shuttle mechanism"
    } ]
  }, {
    "tStartMs": 877200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that's driven by two tubes in nitinol"
    } ]
  }, {
    "tStartMs": 879570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and we've driven those\nair arms and flap elements"
    } ]
  }, {
    "tStartMs": 882210,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "on the wing box of a 737 in flight,"
    } ]
  }, {
    "tStartMs": 885000,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "60 degrees flap angle down,\n30 degrees flap angle up"
    } ]
  }, {
    "tStartMs": 888210,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "just by heating and cooling\ntwo tubes of nitinol,"
    } ]
  }, {
    "tStartMs": 890730,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "replaces all the hydraulics."
    } ]
  }, {
    "tStartMs": 892860,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] The shape memory effect"
    } ]
  }, {
    "tStartMs": 894120,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "is the main thing people know\nabout materials like nitinol,"
    } ]
  }, {
    "tStartMs": 897450,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but they have another unique property"
    } ]
  }, {
    "tStartMs": 899820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "which makes them ideal\nfor making durable wheels."
    } ]
  }, {
    "tStartMs": 903360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- And you're just gonna take\nit and you're gonna loop it"
    } ]
  }, {
    "tStartMs": 905400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "a couple times around your hand like that,"
    } ]
  }, {
    "tStartMs": 907200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and you're just gonna pull on that wire"
    } ]
  }, {
    "tStartMs": 909360,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "and feel 6 to 8% strain\nin a piece of metal."
    } ]
  }, {
    "tStartMs": 913920,
    "dDurationMs": 1693,
    "segs": [ {
      "utf8": "- Oh that's really weird."
    } ]
  }, {
    "tStartMs": 915613,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "- [Santo] That's 6 to 8% strain,"
    } ]
  }, {
    "tStartMs": 917640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which you can't do in other wires, right?"
    } ]
  }, {
    "tStartMs": 920220,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- But what's weird about it"
    } ]
  }, {
    "tStartMs": 921510,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is that it feels a little crunchy."
    } ]
  }, {
    "tStartMs": 924660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Santo] 'Cause you're feeling\nall of the reorientation."
    } ]
  }, {
    "tStartMs": 927270,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] Oh so weird."
    } ]
  }, {
    "tStartMs": 929040,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Santo] So cool though, right?"
    } ]
  }, {
    "tStartMs": 930360,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "- [Derek] Yes, very cool."
    } ]
  }, {
    "tStartMs": 933619,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "(nitinol pinging)"
    } ]
  }, {
    "tStartMs": 935610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Can you hear that?"
    } ]
  }, {
    "tStartMs": 936443,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Emily] Yep."
    } ]
  }, {
    "tStartMs": 939180,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- [Derek] How weird is that?"
    } ]
  }, {
    "tStartMs": 940050,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "- [Santo] That pinging is 20."
    } ]
  }, {
    "tStartMs": 942780,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Derek] Shape memory\nalloys can stretch up to 8%"
    } ]
  }, {
    "tStartMs": 945390,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of their length and still spring back"
    } ]
  }, {
    "tStartMs": 947280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to their original size."
    } ]
  }, {
    "tStartMs": 949050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "This property is known as super elasticity"
    } ]
  }, {
    "tStartMs": 951720,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "or pseudo elasticity,"
    } ]
  }, {
    "tStartMs": 953850,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but they're kind of misnomers\nbecause the material"
    } ]
  }, {
    "tStartMs": 956100,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "is not actually operating\nin its elastic regime."
    } ]
  }, {
    "tStartMs": 959340,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "What's actually happening\nis that this nitinol"
    } ]
  }, {
    "tStartMs": 961770,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "is in the austenite phase."
    } ]
  }, {
    "tStartMs": 963570,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "It's transition temperature is\nlower than room temperature."
    } ]
  }, {
    "tStartMs": 967440,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But by applying a stress, even\nwith no temperature change,"
    } ]
  }, {
    "tStartMs": 971220,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "you can force the crystal structure"
    } ]
  }, {
    "tStartMs": 972990,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "to change from austenite\ninto detwinned martensite."
    } ]
  }, {
    "tStartMs": 977010,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And this rearrangement allows the nitinol"
    } ]
  }, {
    "tStartMs": 979380,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "to deform by that 8% and\nstill it'll snap back"
    } ]
  }, {
    "tStartMs": 983880,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to its original configuration\nonce the stress is removed"
    } ]
  }, {
    "tStartMs": 987120,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "and the atoms return\nto the austenite phase."
    } ]
  }, {
    "tStartMs": 991431,
    "dDurationMs": 1449,
    "segs": [ {
      "utf8": "(nitinol pinging)"
    } ]
  }, {
    "tStartMs": 992880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "That sound you're hearing is the material"
    } ]
  }, {
    "tStartMs": 994950,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "undergoing a stress-induced\nphase change in the solid state."
    } ]
  }, {
    "tStartMs": 999120,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "If you wanna think about it\non a stress strain curve."
    } ]
  }, {
    "tStartMs": 1001730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Now this transformation is occurring"
    } ]
  }, {
    "tStartMs": 1003620,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "entirely above the martensite\ntransition temperature."
    } ]
  }, {
    "tStartMs": 1007100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So the material starts off\nin the austenite phase,"
    } ]
  }, {
    "tStartMs": 1010160,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and then the applied stress is\nwhat induces the phase change"
    } ]
  }, {
    "tStartMs": 1014000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "from austenite to detwinned martensite."
    } ]
  }, {
    "tStartMs": 1016700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And when that stress is removed,"
    } ]
  }, {
    "tStartMs": 1018200,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the atoms spring back\nto the austenite phase,"
    } ]
  }, {
    "tStartMs": 1021020,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and so the material goes\nback to its original size"
    } ]
  }, {
    "tStartMs": 1023330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and shape."
    } ]
  }, {
    "tStartMs": 1025010,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- If this were a normal\ntube I would bend it to here"
    } ]
  }, {
    "tStartMs": 1027170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and it would plasticize."
    } ]
  }, {
    "tStartMs": 1028640,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "If it was a brass tube,"
    } ]
  }, {
    "tStartMs": 1029930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which you know has a\nplastic buckling mode,"
    } ]
  }, {
    "tStartMs": 1032450,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it would go like this and it\nwould actually buckle a wall."
    } ]
  }, {
    "tStartMs": 1035060,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "I would never take my hands\nand bend them like this"
    } ]
  }, {
    "tStartMs": 1038870,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and have it completely returned to shape."
    } ]
  }, {
    "tStartMs": 1041120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] At the bend the\nnitinol is transforming"
    } ]
  }, {
    "tStartMs": 1043400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "from austenite to martensite and back."
    } ]
  }, {
    "tStartMs": 1046040,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "- When we go from the\nhigher symmetry phase,"
    } ]
  }, {
    "tStartMs": 1050180,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "the austenite to the lower\nsymmetry daughter phase,"
    } ]
  }, {
    "tStartMs": 1054170,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "which one is it?"
    } ]
  }, {
    "tStartMs": 1055460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Exothermic or endothermic?"
    } ]
  }, {
    "tStartMs": 1056660,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- I feel like that should be exothermic."
    } ]
  }, {
    "tStartMs": 1060020,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "- Good job science guy."
    } ]
  }, {
    "tStartMs": 1061183,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "(Derek and Santo laughing)"
    } ]
  }, {
    "tStartMs": 1062960,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "If you were to put your\nhand around this tube,"
    } ]
  }, {
    "tStartMs": 1065420,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "you'll actually feel the heat energy,"
    } ]
  }, {
    "tStartMs": 1068510,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "the enthalpy of that\ntransformation evolving as heat."
    } ]
  }, {
    "tStartMs": 1072590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You ready?"
    } ]
  }, {
    "tStartMs": 1073423,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1075500,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "Oh yeah that's real hot."
    } ]
  }, {
    "tStartMs": 1077838,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "- Ooh, ooh, ooh."
    } ]
  }, {
    "tStartMs": 1079300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "That actually is like burning."
    } ]
  }, {
    "tStartMs": 1080900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Like I can't keep my hands on it."
    } ]
  }, {
    "tStartMs": 1081733,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "- [Santo] No keep your\nhand on it, it won't burn."
    } ]
  }, {
    "tStartMs": 1083780,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Geez that's hot."
    } ]
  }, {
    "tStartMs": 1084613,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- When the stress is removed"
    } ]
  }, {
    "tStartMs": 1085446,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "and the material goes\nback to being austenite,"
    } ]
  }, {
    "tStartMs": 1087530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that phase change is endothermic."
    } ]
  }, {
    "tStartMs": 1089780,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "It absorbs heat."
    } ]
  }, {
    "tStartMs": 1092210,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Woo.\n(Derek chuckling)"
    } ]
  }, {
    "tStartMs": 1093680,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 1095360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It's like you could use\nthat for a refrigerator."
    } ]
  }, {
    "tStartMs": 1097220,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- So it's exactly right."
    } ]
  }, {
    "tStartMs": 1099110,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "So another area where these\nmaterials are being applied"
    } ]
  }, {
    "tStartMs": 1102890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is in a field called elastocalorics"
    } ]
  }, {
    "tStartMs": 1105470,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "where we use this\ntransformation to do things"
    } ]
  }, {
    "tStartMs": 1109160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "equivalent to heat pumping.\n- Like heat pumping."
    } ]
  }, {
    "tStartMs": 1111110,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I wanna shoot this with\nour thermal camera."
    } ]
  }, {
    "tStartMs": 1112970,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "We got a FLIR with us."
    } ]
  }, {
    "tStartMs": 1115760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "How's that?"
    } ]
  }, {
    "tStartMs": 1117950,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- This dissipation potential\ncan act a little bit"
    } ]
  }, {
    "tStartMs": 1120410,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "like the dissipation in\nthe shock absorber, right?"
    } ]
  }, {
    "tStartMs": 1123410,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So the tire itself could actually perform"
    } ]
  }, {
    "tStartMs": 1126020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "some of that dissipation\npotential on its own."
    } ]
  }, {
    "tStartMs": 1128480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- It almost acts as a damper, right?"
    } ]
  }, {
    "tStartMs": 1130730,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "To get rid of that energy loss."
    } ]
  }, {
    "tStartMs": 1132440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So then your tire actually has a potential"
    } ]
  }, {
    "tStartMs": 1134840,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of becoming a complete suspension system."
    } ]
  }, {
    "tStartMs": 1137900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Hmm."
    } ]
  }, {
    "tStartMs": 1138733,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "- Which obviously really simplifies"
    } ]
  }, {
    "tStartMs": 1141290,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "building vehicles for space."
    } ]
  }, {
    "tStartMs": 1143930,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The original tire, when\nI put a load on it,"
    } ]
  }, {
    "tStartMs": 1147200,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "okay you can see I'm\nonly transferring a load"
    } ]
  }, {
    "tStartMs": 1150950,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "from the footprint to this little section"
    } ]
  }, {
    "tStartMs": 1153070,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "of the tire, all right?"
    } ]
  }, {
    "tStartMs": 1155540,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "By tying this bump stop element to here,"
    } ]
  }, {
    "tStartMs": 1160580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "when I go through a footprint,"
    } ]
  }, {
    "tStartMs": 1162620,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "you can see now I'm\ntransferring load 360 degrees"
    } ]
  }, {
    "tStartMs": 1166490,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "around the tire, right?"
    } ]
  }, {
    "tStartMs": 1168560,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "By doing that, I have now increased"
    } ]
  }, {
    "tStartMs": 1171350,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "my load carrying capacity significantly"
    } ]
  }, {
    "tStartMs": 1174560,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "without adding any more mass."
    } ]
  }, {
    "tStartMs": 1177920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Derek] So to make a tire\nout of shape memory alloy,"
    } ]
  }, {
    "tStartMs": 1180470,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "they weave nitinol springs\ntogether into a mesh."
    } ]
  }, {
    "tStartMs": 1184460,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "It's a pretty tedious and\ntime consuming process."
    } ]
  }, {
    "tStartMs": 1187850,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Engineer] So you're\ngonna take it like so."
    } ]
  }, {
    "tStartMs": 1189410,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- [Derek] Yep."
    } ]
  }, {
    "tStartMs": 1190400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- [Engineer] You're gonna grab both ends?"
    } ]
  }, {
    "tStartMs": 1193100,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Derek] No."
    } ]
  }, {
    "tStartMs": 1194150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Engineer] And I'll take it."
    } ]
  }, {
    "tStartMs": 1194983,
    "dDurationMs": 1264,
    "segs": [ {
      "utf8": "- [Derek] No you're not.\n- [Engineer] Take it."
    } ]
  }, {
    "tStartMs": 1196247,
    "dDurationMs": 861,
    "segs": [ {
      "utf8": "- [Derek] Yep."
    } ]
  }, {
    "tStartMs": 1197108,
    "dDurationMs": 1232,
    "segs": [ {
      "utf8": "- [Engineer] And screw it in."
    } ]
  }, {
    "tStartMs": 1198340,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- Oh my goodness."
    } ]
  }, {
    "tStartMs": 1200780,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Are you kidding me?"
    } ]
  }, {
    "tStartMs": 1203030,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Is this what you do every day?"
    } ]
  }, {
    "tStartMs": 1205310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- [Engineer] 684 Times."
    } ]
  }, {
    "tStartMs": 1207890,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "- [Derek] 684 times-"
    } ]
  }, {
    "tStartMs": 1209700,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "- [Engineer] Per tire."
    } ]
  }, {
    "tStartMs": 1212120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] But will these wheels work"
    } ]
  }, {
    "tStartMs": 1213320,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "on rovers on the moon and Mars?"
    } ]
  }, {
    "tStartMs": 1216830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Will they test the wheels extensively"
    } ]
  }, {
    "tStartMs": 1218540,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "on a rotating carousel of\ndifferent terrain types"
    } ]
  }, {
    "tStartMs": 1221450,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "from sand to small rocks to bigger rocks?"
    } ]
  }, {
    "tStartMs": 1225380,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- So the terrain endurance\nrig basically consists"
    } ]
  }, {
    "tStartMs": 1228140,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "of a circular carousel that\nis independently driven."
    } ]
  }, {
    "tStartMs": 1232340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The wheel tire assembly is\nalso independently driven."
    } ]
  }, {
    "tStartMs": 1235220,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So we can create a force slip condition,"
    } ]
  }, {
    "tStartMs": 1237320,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "so we can drive with zero slip."
    } ]
  }, {
    "tStartMs": 1240179,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(rover wheel whirring)"
    } ]
  }, {
    "tStartMs": 1246740,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "And this is about how slow a\nMars rover would be traveling."
    } ]
  }, {
    "tStartMs": 1251150,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Average speed is about 6.7\ncentimeters per second."
    } ]
  }, {
    "tStartMs": 1254030,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "That's a nominal speed,\nthey don't go too fast."
    } ]
  }, {
    "tStartMs": 1259880,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "- All right, I'm gonna go walk\non simulated moon regular."
    } ]
  }, {
    "tStartMs": 1264800,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It looks like beach and\nit feels like beach."
    } ]
  }, {
    "tStartMs": 1268400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "This side is meant to simulate\nthe surface of the moon,"
    } ]
  }, {
    "tStartMs": 1270860,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "and this side is meant to\nbe the surface of Mars."
    } ]
  }, {
    "tStartMs": 1275720,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "It is very sinky sand."
    } ]
  }, {
    "tStartMs": 1279590,
    "dDurationMs": 3432,
    "segs": [ {
      "utf8": "The wheel is rolling along,\nrolling along, it's a rock."
    } ]
  }, {
    "tStartMs": 1283022,
    "dDurationMs": 3198,
    "segs": [ {
      "utf8": "Am I pushing into it or\ndo I wanna get it on top?"
    } ]
  }, {
    "tStartMs": 1286220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Santo] I'd say get on top"
    } ]
  }, {
    "tStartMs": 1287053,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "and just put all your body weight onto it."
    } ]
  }, {
    "tStartMs": 1290870,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- That's basically my full weight on it."
    } ]
  }, {
    "tStartMs": 1292700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The shape memory alloy is strong enough"
    } ]
  }, {
    "tStartMs": 1294770,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to support the weight of a\nvehicle or vehicle and crew,"
    } ]
  }, {
    "tStartMs": 1298040,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but it's also incredibly flexible."
    } ]
  }, {
    "tStartMs": 1300110,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "So it can deform up to 8% without\nbeing permanently damaged."
    } ]
  }, {
    "tStartMs": 1303890,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "And that's what's needed\nfor long space missions."
    } ]
  }, {
    "tStartMs": 1310580,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Santo] So that's a pretty good amount"
    } ]
  }, {
    "tStartMs": 1311690,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "of deformation, right?"
    } ]
  }, {
    "tStartMs": 1313070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] That's a great\namount of deformation."
    } ]
  }, {
    "tStartMs": 1314690,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "- [Santo] And still not beyond 8%."
    } ]
  }, {
    "tStartMs": 1319220,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "- It's so gooey."
    } ]
  }, {
    "tStartMs": 1321320,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Just walking back to\nthe car after the beach."
    } ]
  }, {
    "tStartMs": 1323660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Tricky for a rover, right?"
    } ]
  }, {
    "tStartMs": 1326000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But these tires won't just be for space."
    } ]
  }, {
    "tStartMs": 1328400,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "They're also looking at\nterrestrial applications."
    } ]
  }, {
    "tStartMs": 1331670,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "- Most aircraft, the\ntires on those aircraft,"
    } ]
  }, {
    "tStartMs": 1335210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "they have to be pressurized"
    } ]
  }, {
    "tStartMs": 1336740,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "to really, really high\npressurization, 300-400 psi."
    } ]
  }, {
    "tStartMs": 1341360,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Not the conventional 30-60 psi"
    } ]
  }, {
    "tStartMs": 1344750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "you do in a car or truck tire, right?"
    } ]
  }, {
    "tStartMs": 1346400,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "We have issues where at\nthose huge pressurization"
    } ]
  }, {
    "tStartMs": 1349850,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "they can explode."
    } ]
  }, {
    "tStartMs": 1351230,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The other construct is maintenance, right?"
    } ]
  }, {
    "tStartMs": 1354020,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So if I'm a pneumatic tire"
    } ]
  }, {
    "tStartMs": 1356870,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and I'm relying on that pneumatics"
    } ]
  }, {
    "tStartMs": 1359180,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "for the performance of the system,"
    } ]
  }, {
    "tStartMs": 1361280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I have to always be\nchecking the air pressure"
    } ]
  }, {
    "tStartMs": 1364100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "to make sure that I'm at\nthe right inflation pressure"
    } ]
  }, {
    "tStartMs": 1367160,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "so that I'm not burning too much fuel,"
    } ]
  }, {
    "tStartMs": 1369290,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "or I'm not at a place where I\ncould potentially pop a tire"
    } ]
  }, {
    "tStartMs": 1372980,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "because of the loads."
    } ]
  }, {
    "tStartMs": 1374420,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "By going to a structural\nsystem that doesn't rely on air"
    } ]
  }, {
    "tStartMs": 1377540,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and is designed specifically\nfor the application."
    } ]
  }, {
    "tStartMs": 1380570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "All of those things go away."
    } ]
  }, {
    "tStartMs": 1382400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- They've tested one on a Jeep."
    } ]
  }, {
    "tStartMs": 1384500,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Since it doesn't rely on\npressurized air for support,"
    } ]
  }, {
    "tStartMs": 1387830,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "you just can't get a flat tire."
    } ]
  }, {
    "tStartMs": 1390770,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Plus it can never be under inflated,"
    } ]
  }, {
    "tStartMs": 1392960,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "which significantly improves fuel economy."
    } ]
  }, {
    "tStartMs": 1395990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "With a metal that works like magic,"
    } ]
  }, {
    "tStartMs": 1398270,
    "dDurationMs": 2311,
    "segs": [ {
      "utf8": "you can make airless\ntires that will take us"
    } ]
  }, {
    "tStartMs": 1400581,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "off road, on road, into the\nair and across other worlds."
    } ]
  }, {
    "tStartMs": 1407007,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(fire swooshing)"
    } ]
  }, {
    "tStartMs": 1412005,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(logo plopping)"
    } ]
  }, {
    "tStartMs": 1415790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "NASA's nitinol tires are designed to last"
    } ]
  }, {
    "tStartMs": 1418160,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the entire lifetime of a rover mission,"
    } ]
  }, {
    "tStartMs": 1420590,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "even on a rough terrain of Mars."
    } ]
  }, {
    "tStartMs": 1422840,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But here on earth, few\nproducts last a lifetime."
    } ]
  }, {
    "tStartMs": 1425990,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "From bike tires to phones to toothbrushes,"
    } ]
  }, {
    "tStartMs": 1428000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "pretty much everything wears out."
    } ]
  }, {
    "tStartMs": 1430040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But with Henson Shaving,\nthe sponsor of this video,"
    } ]
  }, {
    "tStartMs": 1432650,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "you may never need to buy\nanother razor again in your life."
    } ]
  }, {
    "tStartMs": 1436130,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Henson actually came out of\nan aerospace machine shop"
    } ]
  }, {
    "tStartMs": 1439190,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that built parts for the\nMars rover and the ISS."
    } ]
  }, {
    "tStartMs": 1442010,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So they are experts in\nprecise high quality work."
    } ]
  }, {
    "tStartMs": 1445370,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "If the temperature to\nmanufacture their rover parts"
    } ]
  }, {
    "tStartMs": 1447440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "changed as little as one degree,"
    } ]
  }, {
    "tStartMs": 1449270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "they had to scrap the entire piece."
    } ]
  }, {
    "tStartMs": 1451160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And that sort of precision is overlooked"
    } ]
  }, {
    "tStartMs": 1452960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "by most razor manufacturers."
    } ]
  }, {
    "tStartMs": 1454760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In a typical razor, the\nblades flex and bend"
    } ]
  }, {
    "tStartMs": 1457400,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "when they make contact with the skin."
    } ]
  }, {
    "tStartMs": 1459140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And this movement causes micro cuts"
    } ]
  }, {
    "tStartMs": 1461570,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "leading to skin irritation\nand razor bumps."
    } ]
  }, {
    "tStartMs": 1464180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "To many people, this is just\nan inevitable part of shaving,"
    } ]
  }, {
    "tStartMs": 1467180,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but it doesn't need to be."
    } ]
  }, {
    "tStartMs": 1468890,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "You want advice about a good razor?"
    } ]
  }, {
    "tStartMs": 1471710,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Trust a guy with a beard."
    } ]
  }, {
    "tStartMs": 1474500,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This is Henson's AL 13 razor."
    } ]
  }, {
    "tStartMs": 1477260,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It's so precise that the blade extends"
    } ]
  }, {
    "tStartMs": 1479060,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "past the shave plane by\nexactly 0.0013 inches."
    } ]
  }, {
    "tStartMs": 1483020,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "That's less than the\nwidth of a human hair."
    } ]
  }, {
    "tStartMs": 1485210,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The blade is also securely\nfastened at exactly 30 degrees,"
    } ]
  }, {
    "tStartMs": 1488300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "leaving almost zero blade flex"
    } ]
  }, {
    "tStartMs": 1490130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for a smoother and cleaner shave."
    } ]
  }, {
    "tStartMs": 1492260,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This razor is designed to last a lifetime,"
    } ]
  }, {
    "tStartMs": 1494900,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and it's standard double-edged blades"
    } ]
  }, {
    "tStartMs": 1496490,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "cost only around 10 cents each."
    } ]
  }, {
    "tStartMs": 1498470,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Which means the cost of\nownership for an AL 13 razor"
    } ]
  }, {
    "tStartMs": 1501050,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "ends up lower than most\ncartridge or electric razors"
    } ]
  }, {
    "tStartMs": 1503870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "after only two years."
    } ]
  }, {
    "tStartMs": 1505670,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And besides price considerations,"
    } ]
  }, {
    "tStartMs": 1507290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "having one razor for the rest of your life"
    } ]
  }, {
    "tStartMs": 1509030,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "is both more convenient\nand better for the planet."
    } ]
  }, {
    "tStartMs": 1511850,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So if you want one aerospace quality razor"
    } ]
  }, {
    "tStartMs": 1514220,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to last the rest of your life,"
    } ]
  }, {
    "tStartMs": 1515540,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "go to hensonshaving.com/veritasium"
    } ]
  }, {
    "tStartMs": 1518270,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and enter code veritasium\nfor 100 free blades"
    } ]
  }, {
    "tStartMs": 1521090,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "with a purchase of a razor."
    } ]
  }, {
    "tStartMs": 1522500,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "That's two to four years\nworth of blades on me."
    } ]
  }, {
    "tStartMs": 1525650,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Make sure to add both\nthe razor and the blades"
    } ]
  }, {
    "tStartMs": 1527540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to your cart for the code to take effect."
    } ]
  }, {
    "tStartMs": 1529580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So I wanna thank Henson Shaving\nfor sponsoring this video,"
    } ]
  }, {
    "tStartMs": 1532040,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
