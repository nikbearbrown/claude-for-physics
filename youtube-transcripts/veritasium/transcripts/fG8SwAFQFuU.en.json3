{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- [Derek] Do people really\nunderstand the scale"
    } ]
  }, {
    "tStartMs": 2400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of the universe?"
    } ]
  }, {
    "tStartMs": 3840,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- Damn, really? That's... okay."
    } ]
  }, {
    "tStartMs": 5320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- This task is going to\nseem ridiculously easy."
    } ]
  }, {
    "tStartMs": 8440,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Rank these things from smallest at the top"
    } ]
  }, {
    "tStartMs": 12000,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "to biggest on the bottom."
    } ]
  }, {
    "tStartMs": 13480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But sometimes you have to ask the question"
    } ]
  }, {
    "tStartMs": 15720,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "no one would bother to\nin order to figure out"
    } ]
  }, {
    "tStartMs": 18000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "what people are actually thinking."
    } ]
  }, {
    "tStartMs": 20000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- This is really gonna\nput my astronomy skills"
    } ]
  }, {
    "tStartMs": 22240,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "to the test, so.\n- Moon. I don't know, moon."
    } ]
  }, {
    "tStartMs": 25800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- Yeah, I'd say moon"
    } ]
  }, {
    "tStartMs": 26600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "is probably the smallest.\n- I'd say stars are smallest."
    } ]
  }, {
    "tStartMs": 28280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- But the sun is a star."
    } ]
  }, {
    "tStartMs": 30040,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- So this is like a science quiz."
    } ]
  }, {
    "tStartMs": 31360,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- I'll say planets are the smallest."
    } ]
  }, {
    "tStartMs": 33240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "I'd say planet might\nbe the top of the line."
    } ]
  }, {
    "tStartMs": 36200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Is the sun bigger than the moon?"
    } ]
  }, {
    "tStartMs": 37800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- It depends on the planet, right?"
    } ]
  }, {
    "tStartMs": 39400,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- It does, but as a general category."
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- Stars, then moons.\n- And then there's stars-"
    } ]
  }, {
    "tStartMs": 45960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Yeah?\n- Around the planet."
    } ]
  }, {
    "tStartMs": 47760,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- The sun is a star, right?"
    } ]
  }, {
    "tStartMs": 49080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I think.\n- Yeah, it is."
    } ]
  }, {
    "tStartMs": 50520,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- You think this one's next? I trust you."
    } ]
  }, {
    "tStartMs": 52800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Dude, we're talking about a galaxy, bro."
    } ]
  }, {
    "tStartMs": 54600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We're talking everything."
    } ]
  }, {
    "tStartMs": 56280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- You're looking at the galaxy too?"
    } ]
  }, {
    "tStartMs": 58280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "(group laughs)\nOkay, like, okay."
    } ]
  }, {
    "tStartMs": 61480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- I think it's this one and then this one."
    } ]
  }, {
    "tStartMs": 63280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- You're right."
    } ]
  }, {
    "tStartMs": 64280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- You can do it.\n- Wait, no."
    } ]
  }, {
    "tStartMs": 65120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Unless you believe in the\nmultiverse, then you know-"
    } ]
  }, {
    "tStartMs": 66680,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- I think you're taking this, like,"
    } ]
  }, {
    "tStartMs": 68160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "four-dimensional chess level."
    } ]
  }, {
    "tStartMs": 69600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- I think the moon would be bigger, no?"
    } ]
  }, {
    "tStartMs": 72200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- I mean, you'd think right?"
    } ]
  }, {
    "tStartMs": 73720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Because like it looks bigger."
    } ]
  }, {
    "tStartMs": 75080,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 75920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Is this supposed to be like\na science lesson? (laughs)"
    } ]
  }, {
    "tStartMs": 77520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Like there is, there's\ndefinitely some science to this."
    } ]
  }, {
    "tStartMs": 80280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 81120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- We are not astrology majors."
    } ]
  }, {
    "tStartMs": 82800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 85520,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "- So what is a moon?"
    } ]
  }, {
    "tStartMs": 86560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Like, how's a moon\ndifferent from a planet?"
    } ]
  }, {
    "tStartMs": 90160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- It's collection of dust, maybe?"
    } ]
  }, {
    "tStartMs": 91480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- The way that they\ncome about in astrology"
    } ]
  }, {
    "tStartMs": 93960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and like the, I don't\nknow, like the meteors."
    } ]
  }, {
    "tStartMs": 96120,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- Planets is like human life."
    } ]
  }, {
    "tStartMs": 98000,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Already exists or potentially can exist."
    } ]
  }, {
    "tStartMs": 101480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- And a planet has its\nown like, I don't know-"
    } ]
  }, {
    "tStartMs": 105080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Atmosphere.\n- I think a planet's capable-"
    } ]
  }, {
    "tStartMs": 106640,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yes!\n- Of having its own atmosphere"
    } ]
  }, {
    "tStartMs": 107480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "or something.\n(hands slap)"
    } ]
  }, {
    "tStartMs": 108480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- And then the atmosphere\nof the moon and the planet"
    } ]
  }, {
    "tStartMs": 110760,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "are completely different."
    } ]
  }, {
    "tStartMs": 111560,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- Whether or not it\nhas like an atmosphere."
    } ]
  }, {
    "tStartMs": 113760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- I get why some people would think this,"
    } ]
  }, {
    "tStartMs": 115200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "because the Earth has an atmosphere,"
    } ]
  }, {
    "tStartMs": 117000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "while our moon has\nessentially no atmosphere,"
    } ]
  }, {
    "tStartMs": 119720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but Titan, Saturn's largest moon,"
    } ]
  }, {
    "tStartMs": 121960,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "actually has a thick atmosphere,"
    } ]
  }, {
    "tStartMs": 124320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "while mercury has no\nsubstantial atmosphere."
    } ]
  }, {
    "tStartMs": 127440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So if having an atmosphere\nisn't what makes a planet,"
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "then what is it?"
    } ]
  }, {
    "tStartMs": 131440,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- We don't know if the moon\nhas people on. It could."
    } ]
  }, {
    "tStartMs": 134280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- You think the moon\ncould have people on it?"
    } ]
  }, {
    "tStartMs": 135960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- There could be moon\npeople. We never know."
    } ]
  }, {
    "tStartMs": 138000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- I'm thinking like orbits or something."
    } ]
  }, {
    "tStartMs": 139800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Something around there."
    } ]
  }, {
    "tStartMs": 140800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- I think natural\nsatellite is the term used."
    } ]
  }, {
    "tStartMs": 142640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "So, like, you'll always have\nmoons around the planet."
    } ]
  }, {
    "tStartMs": 145920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "You can't see a planet around a moon."
    } ]
  }, {
    "tStartMs": 148720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- How many planets do we know of?"
    } ]
  }, {
    "tStartMs": 151920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- Uh...\n- Huh. (laughs)"
    } ]
  }, {
    "tStartMs": 154480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Mm. Mm.\n(Derek laughs)"
    } ]
  }, {
    "tStartMs": 156760,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- I don't know. Well-\n- Any guess?"
    } ]
  }, {
    "tStartMs": 158400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Let's see.\n- Seven, eight?"
    } ]
  }, {
    "tStartMs": 160000,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "- Seven or nine?"
    } ]
  }, {
    "tStartMs": 161160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Do we have 11 in our solar system?"
    } ]
  }, {
    "tStartMs": 162840,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- I think a planet has to be certain size"
    } ]
  }, {
    "tStartMs": 164320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to be considered a planet,\n'cause you look at Pluto,"
    } ]
  }, {
    "tStartMs": 166000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "they say it's not a planet\nbecause it's too small."
    } ]
  }, {
    "tStartMs": 167760,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- Pluto doesn't count as a planet anymore."
    } ]
  }, {
    "tStartMs": 169160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- Pluto's technically not a planet."
    } ]
  }, {
    "tStartMs": 170920,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "That's a dwarf planet?\n- Everyone knows"
    } ]
  }, {
    "tStartMs": 171760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "the poor story of Pluto, I think."
    } ]
  }, {
    "tStartMs": 173040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- Because everybody loves Pluto."
    } ]
  }, {
    "tStartMs": 175280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 176120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- When Pluto was discovered in 1930,"
    } ]
  }, {
    "tStartMs": 177800,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "it was hailed the ninth planet,"
    } ]
  }, {
    "tStartMs": 179760,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but it quickly became clear\nthat Pluto was different."
    } ]
  }, {
    "tStartMs": 184080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The real nail in the coffin came"
    } ]
  }, {
    "tStartMs": 185640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "(thunder cracks)\non the 5th of January, 2005,"
    } ]
  }, {
    "tStartMs": 187440,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "when astronomers discovered Eris,"
    } ]
  }, {
    "tStartMs": 189720,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "(gentle music)\nan object in the Kuiper belt"
    } ]
  }, {
    "tStartMs": 190640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that's around 30% more massive than Pluto."
    } ]
  }, {
    "tStartMs": 193680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Similar large objects had\nalready been discovered"
    } ]
  }, {
    "tStartMs": 195840,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and more were likely to follow."
    } ]
  }, {
    "tStartMs": 197960,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "So scientists faced a choice:"
    } ]
  }, {
    "tStartMs": 199920,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "either add a whole bunch\nmore planets or demote Pluto."
    } ]
  }, {
    "tStartMs": 204360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "In 2006, the decision was made,"
    } ]
  }, {
    "tStartMs": 206600,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and a new definition for\na planet was established."
    } ]
  }, {
    "tStartMs": 209760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- They should just, like, get over it."
    } ]
  }, {
    "tStartMs": 211120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- A planet anymore\n- Pluto had it coming"
    } ]
  }, {
    "tStartMs": 212320,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "from the beginning.\n(audience applauds)"
    } ]
  }, {
    "tStartMs": 213160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Stay in your lane?\n- Stay in your lane."
    } ]
  }, {
    "tStartMs": 214960,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "(audience applauds)\n- Stay in your lane."
    } ]
  }, {
    "tStartMs": 215760,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- Our moon-\n- Our moon."
    } ]
  }, {
    "tStartMs": 216680,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- Has five times the mass of Pluto."
    } ]
  }, {
    "tStartMs": 218640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- What?\n- So just get over it."
    } ]
  }, {
    "tStartMs": 220200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- Is our moon a planet?\n- No, it's a moon."
    } ]
  }, {
    "tStartMs": 223200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- [Derek] To be a planet,"
    } ]
  }, {
    "tStartMs": 224000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "an object now had to\nsatisfy three criteria."
    } ]
  }, {
    "tStartMs": 226800,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "First, it must orbit the sun."
    } ]
  }, {
    "tStartMs": 228920,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Second, it must have enough self-gravity"
    } ]
  }, {
    "tStartMs": 231120,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "so that it's round or almost round."
    } ]
  }, {
    "tStartMs": 233960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And third, it must be\ngravitationally dominant"
    } ]
  }, {
    "tStartMs": 236840,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "and cleared out its neighborhood."
    } ]
  }, {
    "tStartMs": 239200,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Pluto satisfies the first two\ncriteria, but not the third."
    } ]
  }, {
    "tStartMs": 242680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So now we're back to the set\nof planets without Pluto."
    } ]
  }, {
    "tStartMs": 247560,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Mercury, Venus, Earth, Mars, Jupiter,"
    } ]
  }, {
    "tStartMs": 250160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Saturn, Uranus, Neptune."
    } ]
  }, {
    "tStartMs": 252320,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Oh, it's eight.\n- Nice."
    } ]
  }, {
    "tStartMs": 253720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "(participant laughs)\nAnd he named them all."
    } ]
  }, {
    "tStartMs": 255600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Bonus points."
    } ]
  }, {
    "tStartMs": 257120,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "How many planets outside the solar system?"
    } ]
  }, {
    "tStartMs": 259800,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- Oh."
    } ]
  }, {
    "tStartMs": 262920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- Maybe around a couple\nhundred to 1,000, maybe?"
    } ]
  }, {
    "tStartMs": 266400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Participant] Probably\na couple million. (laughs)"
    } ]
  }, {
    "tStartMs": 268560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Probably more than that.\n- Probably more than that."
    } ]
  }, {
    "tStartMs": 270160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- I mean, in terms of\nthe number that we know"
    } ]
  }, {
    "tStartMs": 271600,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "is about 5,000 right now.\n- Oh."
    } ]
  }, {
    "tStartMs": 273720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- That have been identified, but like,"
    } ]
  }, {
    "tStartMs": 275520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you're right, there's many more,"
    } ]
  }, {
    "tStartMs": 276960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but we just haven't seen\nthem yet, so we don't know."
    } ]
  }, {
    "tStartMs": 279720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "So the moons are the smallest."
    } ]
  }, {
    "tStartMs": 281080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "They go around the planets.\nPlanets go around the stars."
    } ]
  }, {
    "tStartMs": 283360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "What makes a star a star?"
    } ]
  }, {
    "tStartMs": 286600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Kind of like a dead planet, right?"
    } ]
  }, {
    "tStartMs": 288160,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Like it's just emitting heat."
    } ]
  }, {
    "tStartMs": 290120,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- Like little gas things."
    } ]
  }, {
    "tStartMs": 292000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "And they explode all the time."
    } ]
  }, {
    "tStartMs": 293400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And we don't even see them."
    } ]
  }, {
    "tStartMs": 295000,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "But I don't know where they come from."
    } ]
  }, {
    "tStartMs": 296160,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Can you tell me?"
    } ]
  }, {
    "tStartMs": 296960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "- If you have a bunch of\njust like gas, as you say,"
    } ]
  }, {
    "tStartMs": 299040,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "like hydrogen, helium, and that\nall kind of clumps together,"
    } ]
  }, {
    "tStartMs": 302960,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "it forms a star.\n- Oh."
    } ]
  }, {
    "tStartMs": 304200,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- And then like you say, there's\nlike fusion in the middle,"
    } ]
  }, {
    "tStartMs": 306560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "explosions in the middle that\nare giving out light and heat"
    } ]
  }, {
    "tStartMs": 309040,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "and stuff like that.\n- Wow."
    } ]
  }, {
    "tStartMs": 310280,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "You just taught me something new."
    } ]
  }, {
    "tStartMs": 311680,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "I didn't even know that.\n- There you go."
    } ]
  }, {
    "tStartMs": 313160,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- Doesn't it take eight\nEarths to fill the sun?"
    } ]
  }, {
    "tStartMs": 315840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- A million Earths.\n- A million Earths."
    } ]
  }, {
    "tStartMs": 317280,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "I got it wrong. Okay, I'm stupid."
    } ]
  }, {
    "tStartMs": 319240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- (laughs) No, no, but\nlike it's a lot, right?"
    } ]
  }, {
    "tStartMs": 321600,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Here's one way to put this in perspective."
    } ]
  }, {
    "tStartMs": 324120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "In our solar system,\nthere are eight planets,"
    } ]
  }, {
    "tStartMs": 326440,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "hundreds of moons, millions\nof asteroids and more."
    } ]
  }, {
    "tStartMs": 330000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But in terms of mass,\nall that only makes up"
    } ]
  }, {
    "tStartMs": 333120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "0.14% of the mass of our solar system."
    } ]
  }, {
    "tStartMs": 336640,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "The other 99.86% of the mass is the sun."
    } ]
  }, {
    "tStartMs": 341520,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "That is just how much bigger\nand more massive the sun is."
    } ]
  }, {
    "tStartMs": 346240,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "- Moon's smallest, then planets and stars."
    } ]
  }, {
    "tStartMs": 350680,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "(students chattering faintly)"
    } ]
  }, {
    "tStartMs": 353760,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "(tone beeps)"
    } ]
  }, {
    "tStartMs": 354680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Well, what is a galaxy?\nLike, what is that?"
    } ]
  }, {
    "tStartMs": 356360,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- Uh..."
    } ]
  }, {
    "tStartMs": 357840,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "- A group of planets in, I'd say,"
    } ]
  }, {
    "tStartMs": 361480,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "a certain amount of proximity."
    } ]
  }, {
    "tStartMs": 363120,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- Like the solar system.\nLike the system of planets."
    } ]
  }, {
    "tStartMs": 365480,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So like just how we have our solar system"
    } ]
  }, {
    "tStartMs": 368080,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "is what makes the galaxy."
    } ]
  }, {
    "tStartMs": 369400,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- A ton of stars, moons,\nand planets in together"
    } ]
  }, {
    "tStartMs": 372720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "makes the galaxy?"
    } ]
  }, {
    "tStartMs": 375840,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- Maybe just a collection\nof like solar systems?"
    } ]
  }, {
    "tStartMs": 377720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- So how many is a\ncollection of solar systems?"
    } ]
  }, {
    "tStartMs": 380760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "How big is a galaxy? How many stars?"
    } ]
  }, {
    "tStartMs": 383240,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "(gentle music)\n- Uh..."
    } ]
  }, {
    "tStartMs": 385120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Help."
    } ]
  }, {
    "tStartMs": 386480,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "(group laughs)"
    } ]
  }, {
    "tStartMs": 387360,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "I don't know.\n- Phone a friend."
    } ]
  }, {
    "tStartMs": 388520,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- 60,000."
    } ]
  }, {
    "tStartMs": 389840,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Millions, I'd say, millions."
    } ]
  }, {
    "tStartMs": 391640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- Tens of millions of stars, perhaps?"
    } ]
  }, {
    "tStartMs": 393480,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- How many stars in a galaxy?"
    } ]
  }, {
    "tStartMs": 396080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Roughly. Ballpark."
    } ]
  }, {
    "tStartMs": 399360,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- Probably hundreds of millions."
    } ]
  }, {
    "tStartMs": 401320,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "- Million? Billion?"
    } ]
  }, {
    "tStartMs": 404720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- 100 billion.\n- Oh, you are way off."
    } ]
  }, {
    "tStartMs": 406720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- That was crazy. (laughs)\n- Oh my God. (laughs)"
    } ]
  }, {
    "tStartMs": 408480,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "- That was crazy. (laughs)\n- You said 60. 100 billion?"
    } ]
  }, {
    "tStartMs": 411880,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- 100 billion stars."
    } ]
  }, {
    "tStartMs": 412720,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Damn, really? That's... okay."
    } ]
  }, {
    "tStartMs": 414640,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- Number of stars in the galaxy,"
    } ]
  }, {
    "tStartMs": 415880,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "that can vary depending\non the size of the galaxy,"
    } ]
  }, {
    "tStartMs": 417840,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "but like 100 billion, 200\nbillion, 300 billion. 50 billion,"
    } ]
  }, {
    "tStartMs": 420760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "like that's like kind\nof the ballpark numbers"
    } ]
  }, {
    "tStartMs": 422640,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "from the galaxy.\n- Okay."
    } ]
  }, {
    "tStartMs": 423480,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "But the average is 100 billion?"
    } ]
  }, {
    "tStartMs": 424280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 425120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- That's crazy,\n- Right?"
    } ]
  }, {
    "tStartMs": 426720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- Yeah. (laughs)\n- They're huge."
    } ]
  }, {
    "tStartMs": 428600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "There's a funny question."
    } ]
  }, {
    "tStartMs": 429560,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Are there more trees on\nEarth or stars in our galaxy?"
    } ]
  }, {
    "tStartMs": 436360,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- (raspberries) Oh, actually, Mm."
    } ]
  }, {
    "tStartMs": 439680,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "I'm now thinking about like a math problem"
    } ]
  }, {
    "tStartMs": 441560,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "where it's basically, you\nhave to find, I guess,"
    } ]
  }, {
    "tStartMs": 444480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the whole entire surface\narea that, oh, huh."
    } ]
  }, {
    "tStartMs": 448080,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- The answer is, I'll\nsave you the trouble,"
    } ]
  }, {
    "tStartMs": 449800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "there are more trees on Earth"
    } ]
  }, {
    "tStartMs": 451240,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "than there are stars in the\ngalaxy, in our Milky Way Galaxy."
    } ]
  }, {
    "tStartMs": 455120,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- You know it figures, you know? (laughs)"
    } ]
  }, {
    "tStartMs": 457320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- So a galaxy is a huge\ncollection of stars, planets, gas,"
    } ]
  }, {
    "tStartMs": 461160,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "dust, dark matter, and other objects,"
    } ]
  }, {
    "tStartMs": 463600,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "all bound together by gravity."
    } ]
  }, {
    "tStartMs": 466440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And then what is around\nthe Milky Way galaxy?"
    } ]
  }, {
    "tStartMs": 470680,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- More galaxies.\n- There are more galaxies,"
    } ]
  }, {
    "tStartMs": 473040,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "but they're kind of far away."
    } ]
  }, {
    "tStartMs": 475160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So what's between us and\nthose other galaxies?"
    } ]
  }, {
    "tStartMs": 478200,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- The...\n- Uh..."
    } ]
  }, {
    "tStartMs": 479680,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Uh..."
    } ]
  }, {
    "tStartMs": 480520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- Like all types of vastness, you know?"
    } ]
  }, {
    "tStartMs": 482280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Super novas.\n- Dark matter?"
    } ]
  }, {
    "tStartMs": 483880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- Stars? (laughs)"
    } ]
  }, {
    "tStartMs": 485640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- You know, this is the\nthing that I find nuts,"
    } ]
  }, {
    "tStartMs": 487960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and one of the things I\nwanted to see if people know,"
    } ]
  }, {
    "tStartMs": 490680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but like the Milky Way is like one galaxy,"
    } ]
  }, {
    "tStartMs": 493240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but it's huge.\n- Right."
    } ]
  }, {
    "tStartMs": 494760,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- It's like 100,000 light-years across."
    } ]
  }, {
    "tStartMs": 496960,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "That's pretty big.\n- Mm."
    } ]
  }, {
    "tStartMs": 498280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- You know what I mean?"
    } ]
  }, {
    "tStartMs": 499120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But then around us, there's nothing."
    } ]
  }, {
    "tStartMs": 501520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Hmm.\n- Oh wow, I didn't know that."
    } ]
  }, {
    "tStartMs": 503440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Basically nothing.\n- Yeah."
    } ]
  }, {
    "tStartMs": 505000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's kind of like the continents, right?"
    } ]
  }, {
    "tStartMs": 506920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That you have a continent,\nbut then around it,"
    } ]
  }, {
    "tStartMs": 508360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "like there's all this ocean,"
    } ]
  }, {
    "tStartMs": 510120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and then there's like more galaxies,"
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and then there's nothing,\nand then more galaxies,"
    } ]
  }, {
    "tStartMs": 515200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "nothing more galaxies, nothing."
    } ]
  }, {
    "tStartMs": 517000,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But this animation is not to scale."
    } ]
  }, {
    "tStartMs": 519520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Really, it should look more like this."
    } ]
  }, {
    "tStartMs": 522080,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The distances between\ngalaxies are enormous,"
    } ]
  }, {
    "tStartMs": 525120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "typically millions of light-years."
    } ]
  }, {
    "tStartMs": 527520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "If you zoom out further,\nyou find that galaxies"
    } ]
  }, {
    "tStartMs": 530000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "are grouped together in clusters,"
    } ]
  }, {
    "tStartMs": 531760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and those clusters make up\neven larger superclusters,"
    } ]
  }, {
    "tStartMs": 535200,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "all separated by enormous voids."
    } ]
  }, {
    "tStartMs": 539040,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "And you know how many galaxies\nthere are in the universe?"
    } ]
  }, {
    "tStartMs": 542760,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- I'll take a guess and\nsay like 20-something."
    } ]
  }, {
    "tStartMs": 545600,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- How many galaxies in the universe?"
    } ]
  }, {
    "tStartMs": 548080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- (beep) If I know. (laughs)"
    } ]
  }, {
    "tStartMs": 551400,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- 12? I don't know."
    } ]
  }, {
    "tStartMs": 552480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Is it? Is that like close?"
    } ]
  }, {
    "tStartMs": 553920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- It's more, much more.\n- 20?"
    } ]
  }, {
    "tStartMs": 556080,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Oh, much more."
    } ]
  }, {
    "tStartMs": 557040,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- I'm gonna say 100.\n- More than hundreds."
    } ]
  }, {
    "tStartMs": 559960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- Thousands?\n- More than thousands."
    } ]
  }, {
    "tStartMs": 562280,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- (laughs) Oh my gosh.\n- 10,000."
    } ]
  }, {
    "tStartMs": 564880,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "(participants laughs)\n- 10,000?"
    } ]
  }, {
    "tStartMs": 565720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- 10,000.\n- 10,000?"
    } ]
  }, {
    "tStartMs": 567400,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- That's small."
    } ]
  }, {
    "tStartMs": 569040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- I mean 10,000 galaxies,"
    } ]
  }, {
    "tStartMs": 570840,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "but each galaxy's got 100 billion stars."
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- 16,482."
    } ]
  }, {
    "tStartMs": 575000,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- Hundreds of thousands?"
    } ]
  }, {
    "tStartMs": 577400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Millions? Billions?"
    } ]
  }, {
    "tStartMs": 579640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- 1 billion?"
    } ]
  }, {
    "tStartMs": 581480,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- 1 billion?\n- Or, is that too small?"
    } ]
  }, {
    "tStartMs": 583040,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- 1 billion galaxies, each\none with 100 billion stars?"
    } ]
  }, {
    "tStartMs": 587120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- I'll say 10 billion that we know of."
    } ]
  }, {
    "tStartMs": 590600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- What are you gonna say?\n- The answer is..."
    } ]
  }, {
    "tStartMs": 592840,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- The answer is..."
    } ]
  }, {
    "tStartMs": 594160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- How many galaxies in the universe?"
    } ]
  }, {
    "tStartMs": 595840,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "About?"
    } ]
  }, {
    "tStartMs": 598240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Oh jeez. (laughs)\n(wind rustling)"
    } ]
  }, {
    "tStartMs": 600280,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "100 billion."
    } ]
  }, {
    "tStartMs": 603280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- What, really?"
    } ]
  }, {
    "tStartMs": 604720,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- About 100 billion galaxies.\n- Holy. Seriously?"
    } ]
  }, {
    "tStartMs": 607960,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 608880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "About 100 billion."
    } ]
  }, {
    "tStartMs": 610600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- Dang, weird.\n- Oh man."
    } ]
  }, {
    "tStartMs": 612920,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "(participants laugh)\n- It's huge."
    } ]
  }, {
    "tStartMs": 614160,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "100 billion are observable."
    } ]
  }, {
    "tStartMs": 616040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- And these are just galaxies?\n- These are galaxies."
    } ]
  }, {
    "tStartMs": 618280,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Each galaxy then has\nabout 100 billion stars."
    } ]
  }, {
    "tStartMs": 621600,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "- Okay.\n- Right?"
    } ]
  }, {
    "tStartMs": 622720,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "That's mind blowing a little bit."
    } ]
  }, {
    "tStartMs": 624120,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "- Right?\n- Yeah."
    } ]
  }, {
    "tStartMs": 625000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- This is what I'm saying."
    } ]
  }, {
    "tStartMs": 625800,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "I feel like most people don't know"
    } ]
  }, {
    "tStartMs": 626960,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "the scale of the universe,"
    } ]
  }, {
    "tStartMs": 628440,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and that's what I'm\nout here to talk about."
    } ]
  }, {
    "tStartMs": 629800,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Mm-hmm.\n- That's why I wanted to be,"
    } ]
  }, {
    "tStartMs": 630640,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "like, it's so much bigger\nthan almost anyone thinks."
    } ]
  }, {
    "tStartMs": 634200,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 635040,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- In fact, there could be even more,"
    } ]
  }, {
    "tStartMs": 636640,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "because 100 billion galaxies\nis a conservative estimate."
    } ]
  }, {
    "tStartMs": 639880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Some believe there are\nup to 2 trillion galaxies"
    } ]
  }, {
    "tStartMs": 642880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "in the observable universe."
    } ]
  }, {
    "tStartMs": 645840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So it's huge, and between\nall these galaxies,"
    } ]
  }, {
    "tStartMs": 648560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "nothing.\n- Just nothing."
    } ]
  }, {
    "tStartMs": 650840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- What a wacky universe, right?"
    } ]
  }, {
    "tStartMs": 652600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- [Participant] Yeah.\n- And around each star,"
    } ]
  }, {
    "tStartMs": 654120,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "there might be, on\naverage, about six planets."
    } ]
  }, {
    "tStartMs": 657080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- Wow.\n- So you can think"
    } ]
  }, {
    "tStartMs": 658520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "about 100 billion times 100\nbillion times six, roughly,"
    } ]
  }, {
    "tStartMs": 662120,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and that's conservative.\n- Okay."
    } ]
  }, {
    "tStartMs": 663920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- Kind of like number of\nplanets may be in the universe."
    } ]
  }, {
    "tStartMs": 667040,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- Mm-hmm.\n- So it's insanely huge."
    } ]
  }, {
    "tStartMs": 668760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Yes. That sounds..."
    } ]
  }, {
    "tStartMs": 671040,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "That is actually, wow."
    } ]
  }, {
    "tStartMs": 674720,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- I feel like it makes me less stressed,"
    } ]
  }, {
    "tStartMs": 676360,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "because it's just a\nblip in the system, man."
    } ]
  }, {
    "tStartMs": 679800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Nothing's ever that deep.\n(gentle music)"
    } ]
  }, {
    "tStartMs": 681600,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Whoa. (laughs)\n- So the universe"
    } ]
  }, {
    "tStartMs": 682440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "is insanely huge.\n- And we're incredibly small."
    } ]
  }, {
    "tStartMs": 684520,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "I got you.\n(Derek laughs)"
    } ]
  }, {
    "tStartMs": 686400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- How does that make you feel?"
    } ]
  }, {
    "tStartMs": 688400,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Very small."
    } ]
  }, {
    "tStartMs": 689360,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- To think about the size of it."
    } ]
  }, {
    "tStartMs": 690160,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- Very small.\n- I don't know."
    } ]
  }, {
    "tStartMs": 691440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It doesn't make you feel that small."
    } ]
  }, {
    "tStartMs": 692760,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Nope?\n- Because there's not-"
    } ]
  }, {
    "tStartMs": 693600,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- You still feel pretty big?"
    } ]
  }, {
    "tStartMs": 694960,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "(participant laughs)\n- I don't feel big,"
    } ]
  }, {
    "tStartMs": 695800,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "but you know, I still feel like"
    } ]
  }, {
    "tStartMs": 697680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "this Earth in particular\nhas a pretty decent amount"
    } ]
  }, {
    "tStartMs": 701600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of significant whatever,\nyou know, significance."
    } ]
  }, {
    "tStartMs": 704560,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- This is a special place, for sure."
    } ]
  }, {
    "tStartMs": 706040,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "- Yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 707200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "On the 14th of February, 1990,"
    } ]
  }, {
    "tStartMs": 709480,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "the Voyager 1 spacecraft was\nabout 6 billion kilometers"
    } ]
  }, {
    "tStartMs": 713200,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "from the sun when it took this picture."
    } ]
  }, {
    "tStartMs": 717320,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "All you see are a few rays\nof light and a little dot."
    } ]
  }, {
    "tStartMs": 722000,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Carl Sagan described this picture best."
    } ]
  }, {
    "tStartMs": 725320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "(gentle music)\n\"Look again at that dot."
    } ]
  }, {
    "tStartMs": 727240,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "That's here, that's home, that's us."
    } ]
  }, {
    "tStartMs": 730640,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "On it, everyone you\nlove, everyone you know."
    } ]
  }, {
    "tStartMs": 733960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Everyone you ever heard of,"
    } ]
  }, {
    "tStartMs": 735800,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "every human being who ever\nwas lived out their lives,"
    } ]
  }, {
    "tStartMs": 739720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "every hero and coward,"
    } ]
  }, {
    "tStartMs": 741800,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "every creator and\ndestroyer of civilization,"
    } ]
  }, {
    "tStartMs": 745080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "every young couple in love,"
    } ]
  }, {
    "tStartMs": 746600,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "every mother and father,\ninventor and explorer,"
    } ]
  }, {
    "tStartMs": 750280,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "every superstar, every supreme leader,"
    } ]
  }, {
    "tStartMs": 753680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "every saint and sinner"
    } ]
  }, {
    "tStartMs": 755040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "in the history of our species lived there,"
    } ]
  }, {
    "tStartMs": 758000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "on a mote of dust suspended in a sunbeam.\""
    } ]
  }, {
    "tStartMs": 762200,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The earth is a very small\nstage in a vast cosmic arena."
    } ]
  }, {
    "tStartMs": 767400,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "To me, it underscores our responsibility"
    } ]
  }, {
    "tStartMs": 770240,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "to deal more kindly with one another,"
    } ]
  }, {
    "tStartMs": 772840,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and to preserve and\ncherish the pale blue dot,"
    } ]
  }, {
    "tStartMs": 776680,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "the only home we've ever known."
    } ]
  }, {
    "tStartMs": 779920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- I'm glad you taught me something today."
    } ]
  }, {
    "tStartMs": 781280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "I appreciate it. I like learning."
    } ]
  }, {
    "tStartMs": 782560,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- That's awesome."
    } ]
  }, {
    "tStartMs": 783400,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Well, thank you for\nbeing open to learning,"
    } ]
  }, {
    "tStartMs": 785840,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "'cause that's so important."
    } ]
  }, {
    "tStartMs": 787000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- The thing that people are worried about"
    } ]
  }, {
    "tStartMs": 788360,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "is making mistakes, but you can't learn"
    } ]
  }, {
    "tStartMs": 790080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "without making mistakes a lot of times."
    } ]
  }, {
    "tStartMs": 793160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 796360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- So many people don't know the basics"
    } ]
  }, {
    "tStartMs": 798200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "about the universe we live\nin, but it can even be hard"
    } ]
  }, {
    "tStartMs": 801320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to understand the world we live in,"
    } ]
  }, {
    "tStartMs": 803720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and this has a lot to do\nwith our media ecosystem,"
    } ]
  }, {
    "tStartMs": 806440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which often prioritizes\nspeed over accuracy"
    } ]
  }, {
    "tStartMs": 809560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and sensationalism over facts,"
    } ]
  }, {
    "tStartMs": 812080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the problem that's so big\nin science communication,"
    } ]
  }, {
    "tStartMs": 814240,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "I made a whole video about it."
    } ]
  }, {
    "tStartMs": 816680,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But Ground News, the\nsponsor of this video,"
    } ]
  }, {
    "tStartMs": 818920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "changes the game by giving you the tools"
    } ]
  }, {
    "tStartMs": 821080,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "to consume news in a more\nnuanced and transparent way."
    } ]
  }, {
    "tStartMs": 824880,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It was founded by a former NASA engineer,"
    } ]
  }, {
    "tStartMs": 827600,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "and it gathers articles from\naround the world in one spot."
    } ]
  }, {
    "tStartMs": 830920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So Ground News shows how different outlets"
    } ]
  }, {
    "tStartMs": 833080,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "cover the same story and gives you context"
    } ]
  }, {
    "tStartMs": 835600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "about the source of the information."
    } ]
  }, {
    "tStartMs": 837800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Take a look at this study on\nAmerica's trust in science."
    } ]
  }, {
    "tStartMs": 841160,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "I can see that more than 10\narticles were published on it,"
    } ]
  }, {
    "tStartMs": 844000,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and if I scroll down, I can\nread them all in one place."
    } ]
  }, {
    "tStartMs": 847400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Next to each headline,\nthere are tags showing me"
    } ]
  }, {
    "tStartMs": 849880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "who owns the outlet, how\nreliable their reporting is,"
    } ]
  }, {
    "tStartMs": 853080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and if they have a political bias."
    } ]
  }, {
    "tStartMs": 855360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What's interesting is that some headlines"
    } ]
  }, {
    "tStartMs": 857360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "just mention a decline in trust,"
    } ]
  }, {
    "tStartMs": 859360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "some link it to COVID, and\nothers focus on the trend"
    } ]
  }, {
    "tStartMs": 862360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "being worse in minorities."
    } ]
  }, {
    "tStartMs": 864520,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ground News also gives a\nbias distribution chart,"
    } ]
  }, {
    "tStartMs": 867520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "showing me that this\nstory is mostly covered"
    } ]
  }, {
    "tStartMs": 869520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "by center-leaning sources"
    } ]
  }, {
    "tStartMs": 871120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "with little coverage from the\nleft and none from the right,"
    } ]
  }, {
    "tStartMs": 874480,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "so for readers living in a\nright-leaning media bubble,"
    } ]
  }, {
    "tStartMs": 877560,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "this would be a blind spot."
    } ]
  }, {
    "tStartMs": 879760,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Ground News actually\nsorts stories like this"
    } ]
  }, {
    "tStartMs": 882080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "into a separate feed so\nyou can see what topics"
    } ]
  }, {
    "tStartMs": 884800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "both sides of the political\nspectrum tend to focus on"
    } ]
  }, {
    "tStartMs": 887560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and make sure you are\ngetting the full picture."
    } ]
  }, {
    "tStartMs": 890080,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Go to ground.news/veritasium\nto check it out,"
    } ]
  }, {
    "tStartMs": 893320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "or click the link in the description."
    } ]
  }, {
    "tStartMs": 895360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And if you sign up using our link,"
    } ]
  }, {
    "tStartMs": 897200,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "you'll get 30% off their\nunlimited access plan."
    } ]
  }, {
    "tStartMs": 900680,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "A subscription helps support Ground News"
    } ]
  }, {
    "tStartMs": 902640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "to make the media\nlandscape more transparent."
    } ]
  }, {
    "tStartMs": 905440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So I would like to thank Ground News"
    } ]
  }, {
    "tStartMs": 907000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "for sponsoring this video,"
    } ]
  }, {
    "tStartMs": 908400,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and I'd like to thank you for watching."
    } ]
  } ]
}
