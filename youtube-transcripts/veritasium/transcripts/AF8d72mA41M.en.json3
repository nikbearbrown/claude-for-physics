    "segs": [ {
      "utf8": "of interactive lessons on just about"
    } ]
  }, {
    "tStartMs": 1986420,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "anything that you're curious about."
    } ]
  }, {
    "tStartMs": 1987950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And because each lesson is bite-sized,"
    } ]
  }, {
    "tStartMs": 1990050,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you can do them in just minutes."
    } ]
  }, {
    "tStartMs": 1991730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So if you're like me and made a resolution"
    } ]
  }, {
    "tStartMs": 1993500,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to learn something new\nevery day this year,"
    } ]
  }, {
    "tStartMs": 1995720,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Brilliant will help you actually do it."
    } ]
  }, {
    "tStartMs": 1998150,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The best part is you\ncan learn from anywhere,"
    } ]
  }, {
    "tStartMs": 2000400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "right on your phone."
    } ]
  }, {
    "tStartMs": 2001840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So whenever you have a few minutes,"
    } ]
  }, {
    "tStartMs": 2003340,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "you can be building a\nquicker sharper mind."
    } ]
  }, {
    "tStartMs": 2006190,
    "dDurationMs": 2580,
    "segs": [ {
