  }, {
    "tStartMs": 65920,
    "dDurationMs": 1985,
    "segs": [ {
      "utf8": "infects other people."
    } ]
  }, {
    "tStartMs": 67905,
    "dDurationMs": 3055,
    "segs": [ {
      "utf8": "Derek: Hey, so recently i got the chance to interview"
    } ]
  }, {
    "tStartMs": 70960,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Bill Gates when his foundation's annual\nletter came out"
    } ]
  }, {
    "tStartMs": 74240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I'll link to it in the description and\nwe talked about lots of things including"
    } ]
  }, {
    "tStartMs": 78080,
    "dDurationMs": 4079,
    "segs": [ {
      "utf8": "conspiracy theories and misinformation\nbut about the pandemic i wanted to know"
    } ]
  }, {
    "tStartMs": 82159,
    "dDurationMs": 4081,
    "segs": [ {
      "utf8": "if so many people could see this coming\nand the costs of prevention were"
