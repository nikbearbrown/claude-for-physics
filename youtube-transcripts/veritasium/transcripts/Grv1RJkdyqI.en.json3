  }, {
    "tStartMs": 98840,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "hurricanes so you don't forget."
    } ]
  }, {
    "tStartMs": 100924,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "These pandemics only come along so irregularly "
    } ]
  }, {
    "tStartMs": 104504,
    "dDurationMs": 3575,
    "segs": [ {
      "utf8": "that being lulled into a sense of\nsecurity where it probably won't be a"
    } ]
  }, {
    "tStartMs": 108079,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "problem in the next few years, why should\nwe put money into that?"
    } ]
  }, {
    "tStartMs": 112159,
    "dDurationMs": 3258,
    "segs": [ {
      "utf8": "You don't buy the insurance policy,\nbasically."
