  }, {
    "tStartMs": 625040,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "can take and you know mess around with\nand so the the limitations on"
    } ]
  }, {
    "tStartMs": 630800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "how many vaccines are being made, that's\nbased on how many great"
    } ]
  }, {
    "tStartMs": 634560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "capable vaccine manufacturers there are\nin the world and we've made sure that"
