    "segs": [ {
      "utf8": "literally for months\nat a time when its output is needed to"
    } ]
  }, {
    "tStartMs": 615440,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "save millions of lives.\nSo vaccine factories are not"
