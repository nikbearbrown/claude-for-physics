  }, {
    "tStartMs": 231120,
    "dDurationMs": 2786,
    "segs": [ {
      "utf8": "uh anywhere near what we have today. "
    } ]
  }, {
    "tStartMs": 233906,
    "dDurationMs": 2094,
    "segs": [ {
      "utf8": "You know pandemics can be worse in terms of"
    } ]
  }, {
    "tStartMs": 236000,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "the fatalities. Smallpox was a\nover 30 per cent fatality. You know so a little"
