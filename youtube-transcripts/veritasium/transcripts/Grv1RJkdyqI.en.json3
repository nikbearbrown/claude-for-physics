    "dDurationMs": 5546,
    "segs": [ {
      "utf8": "Most of the developing world, those are the vaccines\nthat will be going to them"
    } ]
  }, {
    "tStartMs": 772240,
    "dDurationMs": 3039,
    "segs": [ {
