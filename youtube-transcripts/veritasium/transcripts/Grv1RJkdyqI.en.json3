  }, {
    "tStartMs": 241680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "bit we were lucky that the fatality here\nis not"
    } ]
  }, {
    "tStartMs": 244640,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "not super high but we can nip it in the\nbud it'll still"
