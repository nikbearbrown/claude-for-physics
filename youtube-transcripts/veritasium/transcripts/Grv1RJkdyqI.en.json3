  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Derek: So how did it feel to make this\nprediction and then"
    } ]
  }, {
    "tStartMs": 3760,
    "dDurationMs": 4159,
    "segs": [ {
      "utf8": "have the world essentially not listen\nand not prepare?"
    } ]
  }, {
    "tStartMs": 7919,
    "dDurationMs": 4569,
    "segs": [ {
      "utf8": "Bill Gates: Well there's no good feeling that comes\non something like this saying i told you so"
    } ]
  }, {
    "tStartMs": 12488,
    "dDurationMs": 3512,
    "segs": [ {
      "utf8": "If anything kills over 10 million people"
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "in the next few decades,\nit's most likely to be a highly"
    } ]
  }, {
    "tStartMs": 19920,
    "dDurationMs": 3406,
    "segs": [ {
      "utf8": "infectious virus\nrather than a war."
    } ]
  }, {
    "tStartMs": 23326,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "You know I just think back and could I have been more persuasive?"
    } ]
  }, {
    "tStartMs": 27356,
    "dDurationMs": 5924,
    "segs": [ {
      "utf8": "We've actually invested very little\nin a system to stop an epidemic."
    } ]
  }, {
    "tStartMs": 33280,
    "dDurationMs": 3258,
    "segs": [ {
      "utf8": "We're not ready for the next epidemic."
    } ]
  }, {
    "tStartMs": 36538,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "Derek: How did you make such a prescient prediction?"
    } ]
  }, {
    "tStartMs": 39437,
    "dDurationMs": 1805,
    "segs": [ {
      "utf8": "How did you know this was\ngoing to happen?"
    } ]
  }, {
    "tStartMs": 41242,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "BG: Well there's a number of respiratory\nviruses"
    } ]
  }, {
    "tStartMs": 43826,
    "dDurationMs": 7077,
    "segs": [ {
      "utf8": "and from time to time one will come along\nthat's very transmissive and causes some level of fatalities."
    } ]
  }, {
    "tStartMs": 50903,
    "dDurationMs": 2777,
    "segs": [ {
      "utf8": "Respiratory diseases are very scary"
    } ]
  }, {
    "tStartMs": 53680,
    "dDurationMs": 5519,
    "segs": [ {
      "utf8": "because you're still walking around\non a plane, a bus when you're infectious"
    } ]
  }, {
    "tStartMs": 59199,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "unlike some other diseases like ebola\nwhere you're mostly"
    } ]
  }, {
    "tStartMs": 62399,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "in a hospital bed by the time the viral\nload"
