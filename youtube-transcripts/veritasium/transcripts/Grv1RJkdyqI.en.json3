  }, {
    "tStartMs": 341520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "you know what the Internet might do for\nall of us and"
    } ]
  }, {
    "tStartMs": 344800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "i don't know if you have any thoughts\nabout the current state of it you know"
    } ]
  }, {
    "tStartMs": 347840,
    "dDurationMs": 1724,
    "segs": [ {
      "utf8": "how do we deal with this?"
    } ]
  }, {
    "tStartMs": 349564,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "BG: Well the internet has done something fantastic"
    } ]
  }, {
    "tStartMs": 352661,
    "dDurationMs": 3978,
    "segs": [ {
      "utf8": "which is if you want to learn\nyou know the people who watch you are"
    } ]
  }, {
    "tStartMs": 356639,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "you know getting an opportunity to\nunderstand"
    } ]
  }, {
    "tStartMs": 359120,
    "dDurationMs": 4079,
    "segs": [ {
      "utf8": "science and what's going on and that\njust wasn't there"
    } ]
  }, {
    "tStartMs": 363199,
    "dDurationMs": 4448,
    "segs": [ {
      "utf8": "uh and so for a lot of people they're\nso much more informed."
    } ]
  }, {
    "tStartMs": 367647,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "I mean I have friends who ask me about these variants\nwhere I'm just stunned at"
    } ]
  }, {
    "tStartMs": 371280,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "how up to date they are with the latest\ninformation so"
    } ]
  }, {
    "tStartMs": 374560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "for people who want to learn facts this\nis a golden age."
    } ]
  }, {
    "tStartMs": 378080,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "You know we focus on the negative part\nwith some of these conspiracy theories"
    } ]
  }, {
    "tStartMs": 381440,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "and anti-factual things\nand so because social media is so new"
