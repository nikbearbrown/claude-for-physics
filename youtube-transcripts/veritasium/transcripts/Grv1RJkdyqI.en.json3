  }, {
    "tStartMs": 317520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "what's not and you know what information\nto believe."
    } ]
  }, {
    "tStartMs": 320240,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "I've got to say that you know as i was\ngrowing up and coming into this"
    } ]
  }, {
    "tStartMs": 323039,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "information age it seemed like the\nInternet and all these tools were going"
