  }, {
    "tStartMs": 691200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "miraculously helping make these\nvaccines."
    } ]
  }, {
    "tStartMs": 695600,
    "dDurationMs": 3359,
    "segs": [ {
      "utf8": "These are the very good reasons that I\nsuspect exist but"
    } ]
  }, {
