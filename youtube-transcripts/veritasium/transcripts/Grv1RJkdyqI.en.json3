    "dDurationMs": 2415,
    "segs": [ {
      "utf8": "tangible but you could do a little bit. "
    } ]
  }, {
    "tStartMs": 172415,
    "dDurationMs": 1025,
    "segs": [ {
      "utf8": "I don't know it seems like humans are not"
    } ]
  }, {
    "tStartMs": 173440,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "very good at those sorts of problems."
    } ]
  }, {
    "tStartMs": 175526,
    "dDurationMs": 3993,
    "segs": [ {
      "utf8": "BG: Well my favorite writer, Vaclav Smil,\nyou know wrote about all the potential"
    } ]
  }, {
    "tStartMs": 179519,
    "dDurationMs": 4561,
    "segs": [ {
      "utf8": "kinds of disasters like you know\nthe risk of an asteroid, the risk of a"
