    "segs": [ {
      "utf8": "problem of too much and figuring out\nwhich is the good stuff and which is not."
    } ]
  }, {
    "tStartMs": 433199,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "BG: Well there are certainly\nclear things like you know saying"
    } ]
  }, {
    "tStartMs": 436319,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "completely false things about you know\nvaccines but there is kind of a gray"
    } ]
  }, {
    "tStartMs": 439840,
    "dDurationMs": 3759,
    "segs": [ {
      "utf8": "area in the middle\nthat figuring out what the rules are and"
    } ]
  }, {
    "tStartMs": 443599,
    "dDurationMs": 3531,
    "segs": [ {
      "utf8": "who should be the one looking\nand interpreting those rules"
    } ]
  }, {
    "tStartMs": 447130,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "Wow, we are missing that today.\nYou know can you get a group of experts"
    } ]
  }, {
    "tStartMs": 451280,
    "dDurationMs": 4305,
