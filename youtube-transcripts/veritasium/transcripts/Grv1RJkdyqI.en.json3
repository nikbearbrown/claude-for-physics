    "dDurationMs": 2598,
    "segs": [ {
      "utf8": "epidemics like the current one."
    } ]
  }, {
    "tStartMs": 161557,
    "dDurationMs": 957,
    "segs": [ {
      "utf8": "Derek: It feels to me like"
    } ]
  }, {
    "tStartMs": 162514,
    "dDurationMs": 4365,
    "segs": [ {
      "utf8": "there's something similar about\npandemics and you know climate change or"
    } ]
  }, {
    "tStartMs": 166879,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "like asteroid impact, which is that you\nknow they're not very"
    } ]
  }, {
