    "segs": [ {
      "utf8": "for the future."
    } ]
  }, {
    "tStartMs": 741868,
    "dDurationMs": 3132,
    "segs": [ {
      "utf8": "Derek: How do you feel about the vaccine roll-out so far? "
    } ]
  }, {
    "tStartMs": 745000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "BG: Well we you know we need the supply, "
