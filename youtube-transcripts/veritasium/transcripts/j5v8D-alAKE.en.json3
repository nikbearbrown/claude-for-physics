    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "to the UK and watch whatever they like."
    } ]
  }, {
    "tStartMs": 997620,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "If you're interested in seeing\nwhat streamers have to offer"
    } ]
  }, {
