{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3929,
    "segs": [ {
      "utf8": "Most people don't know\nhow bicycles actually work."
    } ]
  }, {
    "tStartMs": 3929,
    "dDurationMs": 716,
    "segs": [ {
      "utf8": "- [Off screen] Let's try it again."
    } ]
  }, {
    "tStartMs": 4645,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "So we modified this bike to prove it."
    } ]
  }, {
    "tStartMs": 11850,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "This video was sponsored by KiwiCo."
    } ]
  }, {
    "tStartMs": 14100,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 17630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- When you're riding a bike\nand you want to turn left,"
    } ]
  }, {
    "tStartMs": 20120,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "I think most people just imagine"
    } ]
  }, {
    "tStartMs": 21610,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "you turn the handlebars to the left."
    } ]
  }, {
    "tStartMs": 23840,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "This is a bike to test\nwhether that is true."
    } ]
  }, {
    "tStartMs": 26490,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "And it's made by my friend Rick here."
    } ]
  }, {
    "tStartMs": 29020,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "and he's got a radio\ncontroller that allows him"
    } ]
  }, {
    "tStartMs": 31490,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "to lock out the steering to one side."
    } ]
  }, {
    "tStartMs": 35040,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "So, what he's gonna do is as I'm biking,"
    } ]
  }, {
    "tStartMs": 36730,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "he's gonna pick whether I can turn"
    } ]
  }, {
    "tStartMs": 38900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "either to the left or to the right."
    } ]
  }, {
    "tStartMs": 40670,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "So, go for it."
    } ]
  }, {
    "tStartMs": 42210,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Rick] I'm giving it a left turn."
    } ]
  }, {
    "tStartMs": 43800,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "It pulls the pin out,"
    } ]
  }, {
    "tStartMs": 45140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but you can see that you\ncan still fully steer"
    } ]
  }, {
    "tStartMs": 48200,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "after I've pulled the pin out."
    } ]
  }, {
    "tStartMs": 49080,
    "dDurationMs": 1393,
    "segs": [ {
      "utf8": "I've armed it."
    } ]
  }, {
    "tStartMs": 51480,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "There's where it locks. - OK"
    } ]
  }, {
    "tStartMs": 52390,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Now, that that's when your LED comes on"
    } ]
  }, {
    "tStartMs": 55110,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "and that just says turn that way."
    } ]
  }, {
    "tStartMs": 56380,
    "dDurationMs": 1278,
    "segs": [ {
      "utf8": "- Turn left. - Yeah"
    } ]
  }, {
    "tStartMs": 57658,
    "dDurationMs": 2412,
    "segs": [ {
      "utf8": "And if I try to turn right, I can't."
    } ]
  }, {
    "tStartMs": 60070,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "And if I try to turn left-"
    } ]
  }, {
    "tStartMs": 61280,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- You can."
    } ]
  }, {
    "tStartMs": 62113,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I can."
    } ]
  }, {
    "tStartMs": 62946,
    "dDurationMs": 979,
    "segs": [ {
      "utf8": "So the question is"
    } ]
  }, {
    "tStartMs": 63925,
    "dDurationMs": 3511,
    "segs": [ {
      "utf8": "can I successfully execute\nthis left-hand turn?"
    } ]
  }, {
    "tStartMs": 67436,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Should we give it a shot?"
    } ]
  }, {
    "tStartMs": 68269,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "I mean, he's not gonna tell\nme whether it's left or right,"
    } ]
  }, {
    "tStartMs": 69910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so I have to look at the LED to know"
    } ]
  }, {
    "tStartMs": 71710,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "which way I can still turn."
    } ]
  }, {
    "tStartMs": 73770,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "- [Rick] You let me\nknow when you're ready."
    } ]
  }, {
    "tStartMs": 76880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 79296,
    "dDurationMs": 954,
    "segs": [ {
      "utf8": "(exclaims)"
    } ]
  }, {
    "tStartMs": 80250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "No!"
    } ]
  }, {
    "tStartMs": 82170,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "That was meant to be a turn to the right"
    } ]
  }, {
    "tStartMs": 83750,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "but there was no chance in hell."
    } ]
  }, {
    "tStartMs": 85500,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "Left."
    } ]
  }, {
    "tStartMs": 86553,
    "dDurationMs": 1277,
    "segs": [ {
      "utf8": "(exclaims)"
    } ]
  }, {
    "tStartMs": 87830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 92300,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 93181,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "(exclaims)"
    } ]
  }, {
    "tStartMs": 95460,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Right, right, right!"
    } ]
  }, {
    "tStartMs": 97580,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "God!"
    } ]
  }, {
    "tStartMs": 99100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- If you look closely,\nyou can see the problem."
    } ]
  }, {
    "tStartMs": 101900,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Here, I'm trying to turn right"
    } ]
  }, {
    "tStartMs": 104150,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "but steering that way puts me off balance."
    } ]
  }, {
    "tStartMs": 107930,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "If you could ride this bicycle,"
    } ]
  }, {
    "tStartMs": 109690,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "you would find it's\nimpossible to turn left"
    } ]
  }, {
    "tStartMs": 111950,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "without first steering right"
    } ]
  }, {
    "tStartMs": 113680,
    "dDurationMs": 1562,
    "segs": [ {
      "utf8": "and it's impossible to turn right"
    } ]
  }, {
    "tStartMs": 115242,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "without first steering left."
    } ]
  }, {
    "tStartMs": 118410,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This seems wrong."
    } ]
  }, {
    "tStartMs": 120410,
    "dDurationMs": 1598,
    "segs": [ {
      "utf8": "I think most people\nbelieve you turn a bike"
    } ]
  }, {
    "tStartMs": 122008,
    "dDurationMs": 1782,
    "segs": [ {
      "utf8": "simply by pointing the handlebars"
    } ]
  }, {
    "tStartMs": 123790,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "in the direction you want to go."
    } ]
  }, {
    "tStartMs": 125500,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "After all, this is how you drive a car."
    } ]
  }, {
    "tStartMs": 128550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Point the front wheels\nany direction you like"
    } ]
  }, {
    "tStartMs": 130950,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the car just goes that way."
    } ]
  }, {
    "tStartMs": 133350,
    "dDurationMs": 1478,
    "segs": [ {
      "utf8": "But the difference with a bicycle"
    } ]
  }, {
    "tStartMs": 134828,
    "dDurationMs": 3672,
    "segs": [ {
      "utf8": "is steering doesn't just affect\nthe direction you're headed;"
    } ]
  }, {
    "tStartMs": 138500,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "it also affects your balance."
    } ]
  }, {
    "tStartMs": 141690,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Imagine you want to make a right turn"
    } ]
  }, {
    "tStartMs": 144030,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "so you steer the handlebars to the right."
    } ]
  }, {
    "tStartMs": 146600,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "What you've done is effectively"
    } ]
  }, {
    "tStartMs": 148630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "steered the bike out from under you."
    } ]
  }, {
    "tStartMs": 151180,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "So now you're leaning to the left"
    } ]
  }, {
    "tStartMs": 153860,
    "dDurationMs": 2349,
    "segs": [ {
      "utf8": "and the ground puts a force\non the bike to the left"
    } ]
  }, {
    "tStartMs": 156209,
    "dDurationMs": 1831,
    "segs": [ {
      "utf8": "so the only way not to fall"
    } ]
  }, {
    "tStartMs": 158040,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "is to steer the bike to the left."
    } ]
  }, {
    "tStartMs": 160310,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You have made a left turn."
    } ]
  }, {
    "tStartMs": 162860,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "If you really wanted to turn right,"
    } ]
  }, {
    "tStartMs": 164810,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "you first have to\ncounter-steer to the left"
    } ]
  }, {
    "tStartMs": 167310,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "so you can lean right into the turn."
    } ]
  }, {
    "tStartMs": 170890,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "This is something anyone who\nrides a bike knows intuitively"
    } ]
  }, {
    "tStartMs": 174320,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but not explicitly."
    } ]
  }, {
    "tStartMs": 175970,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- Turn left!"
    } ]
  }, {
    "tStartMs": 177250,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- Film someone riding a bike towards you"
    } ]
  }, {
    "tStartMs": 179180,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "and tell them which direction to turn"
    } ]
  }, {
    "tStartMs": 181290,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "and you will find that they counter-steer"
    } ]
  }, {
    "tStartMs": 183100,
    "dDurationMs": 1472,
    "segs": [ {
      "utf8": "without even thinking about it."
    } ]
  }, {
    "tStartMs": 184572,
    "dDurationMs": 1208,
    "segs": [ {
      "utf8": "- Hard left!"
    } ]
  }, {
    "tStartMs": 188970,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "When you're riding a bike,"
    } ]
  }, {
    "tStartMs": 190640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "it's exactly the same as what\nwe call an inverted pendulum"
    } ]
  }, {
    "tStartMs": 193460,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "or balancing a broomstick on your hand."
    } ]
  }, {
    "tStartMs": 196200,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "If I'm balancing it and I\njust start walking toward you,"
    } ]
  }, {
    "tStartMs": 198770,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "it will always fall away from you."
    } ]
  }, {
    "tStartMs": 201150,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "If I want to walk towards\nyou, it's easy enough to do"
    } ]
  }, {
    "tStartMs": 203020,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and people inherently know how to do it."
    } ]
  }, {
    "tStartMs": 204720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "If I pull it backward, I can\nnow start walking that way."
    } ]
  }, {
    "tStartMs": 208400,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "I have to initiate the\nlean to turn into it."
    } ]
  }, {
    "tStartMs": 212710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- If you want to move\nthe pendulum somewhere,"
    } ]
  }, {
    "tStartMs": 214660,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "you first move the base\nin the opposite direction."
    } ]
  }, {
    "tStartMs": 217970,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "And now the pendulum is leaning"
    } ]
  }, {
    "tStartMs": 219960,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "in the direction you want to go"
    } ]
  }, {
    "tStartMs": 221430,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "so you can move with it."
    } ]
  }, {
    "tStartMs": 224350,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "And it's the same with a unicycle."
    } ]
  }, {
    "tStartMs": 227100,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "In order to go forward,"
    } ]
  }, {
    "tStartMs": 228510,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "first, you have to peddle back."
    } ]
  }, {
    "tStartMs": 230260,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, you're leaning forward"
    } ]
  }, {
    "tStartMs": 232030,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and then you can go forward with it."
    } ]
  }, {
    "tStartMs": 234710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Everything you're doing on a unicycle"
    } ]
  }, {
    "tStartMs": 236270,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "is all about keeping that contact patch"
    } ]
  }, {
    "tStartMs": 239120,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "right where it needs\nto be relative to you."
    } ]
  }, {
    "tStartMs": 241710,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "You're balancing the broomstick."
    } ]
  }, {
    "tStartMs": 243380,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "It's just that on a unicycle,"
    } ]
  }, {
    "tStartMs": 244860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you do the longitudinal\nbalance with the pedals"
    } ]
  }, {
    "tStartMs": 248220,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "and you do the lateral\nbalance, the side to side,"
    } ]
  }, {
    "tStartMs": 250810,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "the same as you do with a bike."
    } ]
  }, {
    "tStartMs": 251720,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "You essentially- sorta, small\ncounter-steer to get that weight,"
    } ]
  }, {
    "tStartMs": 254650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to get the contact patch out,"
    } ]
  }, {
    "tStartMs": 256660,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "and then you can pedal\nand bring it under you."
    } ]
  }, {
    "tStartMs": 259350,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "- Now I should point out"
    } ]
  }, {
    "tStartMs": 260390,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "that sometimes when the steering locked,"
    } ]
  }, {
    "tStartMs": 262570,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "we just happened to be\nleaning in the right direction"
    } ]
  }, {
    "tStartMs": 265140,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "to execute the turn."
    } ]
  }, {
    "tStartMs": 266347,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "- Right, right, right, right, right!"
    } ]
  }, {
    "tStartMs": 267960,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "Right, right, right, right."
    } ]
  }, {
    "tStartMs": 269390,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "- [Off Screen] Oh, managed it!"
    } ]
  }, {
    "tStartMs": 270540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Essentially by sheer luck,"
    } ]
  }, {
    "tStartMs": 271950,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "we had counter-steered"
    } ]
  }, {
    "tStartMs": 273200,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "before that side of the\nhandlebars locked out."
    } ]
  }, {
    "tStartMs": 276040,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Now, I can keep going."
    } ]
  }, {
    "tStartMs": 277760,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "- [Rick] Yeah, but don't turn left"
    } ]
  }, {
    "tStartMs": 278830,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "or you're gonna be screwed."
    } ]
  }, {
    "tStartMs": 279990,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "- I can't turn left."
    } ]
  }, {
    "tStartMs": 282140,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "What's interesting about this is it shows"
    } ]
  }, {
    "tStartMs": 283850,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "that you can still ride the\nbike perfectly well, right?"
    } ]
  }, {
    "tStartMs": 285970,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It's just you can't turn left."
    } ]
  }, {
    "tStartMs": 288730,
    "dDurationMs": 3486,
    "segs": [ {
      "utf8": "The funny thing is that you\ncouldn't initiate the turn."
    } ]
  }, {
    "tStartMs": 292216,
    "dDurationMs": 2484,
    "segs": [ {
      "utf8": "I mean, the wild takeaway is that"
    } ]
  }, {
    "tStartMs": 294700,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "steering is not just for turning the bike;"
    } ]
  }, {
    "tStartMs": 297680,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "steering is for balancing."
    } ]
  }, {
    "tStartMs": 298890,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- That's exactly right."
    } ]
  }, {
    "tStartMs": 300250,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- Why is it hard to balance\non a stationary bike?"
    } ]
  }, {
    "tStartMs": 303820,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "I think most people believe"
    } ]
  }, {
    "tStartMs": 304830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it's because the wheels aren't spinning"
    } ]
  }, {
    "tStartMs": 306690,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "so there's no gyroscopic effect,"
    } ]
  }, {
    "tStartMs": 309060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but that's not it."
    } ]
  }, {
    "tStartMs": 310890,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "The truth is you use steering"
    } ]
  }, {
    "tStartMs": 312760,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to keep the bike underneath you"
    } ]
  }, {
    "tStartMs": 314830,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "but steering doesn't work\nwhen you're stationary."
    } ]
  }, {
    "tStartMs": 317820,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Your balance comes not so much"
    } ]
  }, {
    "tStartMs": 319140,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "from how you position\nyour body over the bike,"
    } ]
  }, {
    "tStartMs": 321610,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "but by how you steer the bike\nto keep it underneath you."
    } ]
  }, {
    "tStartMs": 325270,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Even when going straight,"
    } ]
  }, {
    "tStartMs": 326620,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "you're constantly making\nsmall steering adjustments"
    } ]
  }, {
    "tStartMs": 329330,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "to maintain balance."
    } ]
  }, {
    "tStartMs": 331200,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- You're moving the contact patch"
    } ]
  }, {
    "tStartMs": 332650,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "of the front wheel under you."
    } ]
  }, {
    "tStartMs": 333770,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "You're doing exactly what you do"
    } ]
  }, {
    "tStartMs": 334810,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "when you balance a\nbroomstick on your hand."
    } ]
  }, {
    "tStartMs": 337990,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "- So, if the rider is responsible"
    } ]
  }, {
    "tStartMs": 339840,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "for steering the bike to keep it balanced,"
    } ]
  }, {
    "tStartMs": 341890,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "how do bikes without riders stay upright?"
    } ]
  }, {
    "tStartMs": 345210,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "As long as a bike is moving\nwith sufficient speed,"
    } ]
  }, {
    "tStartMs": 347740,
    "dDurationMs": 2818,
    "segs": [ {
      "utf8": "it can keep coasting indefinitely."
    } ]
  }, {
    "tStartMs": 350558,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "I first became aware of this phenomenon"
    } ]
  }, {
    "tStartMs": 352560,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "through the great videos by MinutePhysics,"
    } ]
  }, {
    "tStartMs": 354610,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which inspired me to make this video."
    } ]
  }, {
    "tStartMs": 356650,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "You should definitely check them out."
    } ]
  }, {
    "tStartMs": 358750,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But it turned out the ground"
    } ]
  }, {
    "tStartMs": 360210,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "where we went to test this\neffect was really bumpy,"
    } ]
  }, {
    "tStartMs": 363600,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "but the bike still manages to\nabsorb all these perturbations"
    } ]
  }, {
    "tStartMs": 366940,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "and remain stable."
    } ]
  }, {
    "tStartMs": 368880,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "So, how does it do this?"
    } ]
  }, {
    "tStartMs": 370990,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I think most people believe\nit's the wheels spinning"
    } ]
  }, {
    "tStartMs": 373310,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "that creates some sort\nof gyroscopic effect"
    } ]
  }, {
    "tStartMs": 375810,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "that resists falling over"
    } ]
  }, {
    "tStartMs": 377920,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "just like in this demonstration\nof gyroscopic precession."
    } ]
  }, {
    "tStartMs": 381300,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Yhe wheel stays upright"
    } ]
  }, {
    "tStartMs": 382530,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "even though gravity is pulling it down."
    } ]
  }, {
    "tStartMs": 385340,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "But this is not why bikes are stable."
    } ]
  }, {
    "tStartMs": 388320,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Just watch what happens"
    } ]
  }, {
    "tStartMs": 389290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "when we lock the handlebars completely"
    } ]
  }, {
    "tStartMs": 391390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "so you can only go straight ahead."
    } ]
  }, {
    "tStartMs": 393430,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- Locked out, locked out."
    } ]
  }, {
    "tStartMs": 394880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Whoa!"
    } ]
  }, {
    "tStartMs": 397570,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "- All that is happening\nis the steering is locked."
    } ]
  }, {
    "tStartMs": 400200,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "You just got to ride it."
    } ]
  }, {
    "tStartMs": 401120,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You don't have to turn."
    } ]
  }, {
    "tStartMs": 401953,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "You just ride."
    } ]
  }, {
    "tStartMs": 403360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Letting go."
    } ]
  }, {
    "tStartMs": 404193,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "- Some people tried going really fast."
    } ]
  }, {
    "tStartMs": 408315,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(group laughs)"
    } ]
  }, {
    "tStartMs": 412200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Others experimented with\nextreme balancing techniques."
    } ]
  }, {
    "tStartMs": 415800,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- He's leaning. Don't go too fast!"
    } ]
  }, {
    "tStartMs": 418882,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(group laughs)"
    } ]
  }, {
    "tStartMs": 422957,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "- But even with the gyroscopic"
    } ]
  }, {
    "tStartMs": 424380,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "effect of the wheels,"
    } ]
  }, {
    "tStartMs": 425530,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "no one was able to keep the bike upright"
    } ]
  }, {
    "tStartMs": 427470,
    "dDurationMs": 1607,
    "segs": [ {
      "utf8": "for more than a few seconds."
    } ]
  }, {
    "tStartMs": 429077,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "(crowd exclaims)"
    } ]
  }, {
    "tStartMs": 431540,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- This is not safe for a second."
    } ]
  }, {
    "tStartMs": 433370,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "- It is just as hard to balance"
    } ]
  }, {
    "tStartMs": 435040,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "on a bike with locked steering"
    } ]
  }, {
    "tStartMs": 436980,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "as it is to balance on a stationary bike."
    } ]
  }, {
    "tStartMs": 439000,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "- No, this one is impossible."
    } ]
  }, {
    "tStartMs": 441270,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "- Because you can't steer the bike"
    } ]
  }, {
    "tStartMs": 443260,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "back under you."
    } ]
  }, {
    "tStartMs": 444770,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "The real reason bicycles\nare stable without riders"
    } ]
  }, {
    "tStartMs": 447177,
    "dDurationMs": 4243,
    "segs": [ {
      "utf8": "is because they're cleverly\ndesigned to steer themselves."
    } ]
  }, {
    "tStartMs": 451420,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "If they start falling to one side,"
    } ]
  }, {
    "tStartMs": 453350,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "the handlebars turn in that direction"
    } ]
  }, {
    "tStartMs": 455680,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "to steer the wheels back underneath them."
    } ]
  }, {
    "tStartMs": 458600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "At least three mechanisms"
    } ]
  }, {
    "tStartMs": 460200,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "are responsible for a\nbike's corrective steering."
    } ]
  }, {
    "tStartMs": 463140,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The first is that due to\nthe angle of the front fork,"
    } ]
  }, {
    "tStartMs": 465960,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "the steering axis intersects the ground"
    } ]
  }, {
    "tStartMs": 468820,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "in front of where the\nwheel touches the ground."
    } ]
  }, {
    "tStartMs": 472060,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "So, if the bike starts\nleaning to the left,"
    } ]
  }, {
    "tStartMs": 474050,
    "dDurationMs": 1737,
    "segs": [ {
      "utf8": "the force from the ground on the tire"
    } ]
  }, {
    "tStartMs": 475787,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "turns the wheel to the left."
    } ]
  }, {
    "tStartMs": 478330,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "If the bike starts leaning right,"
    } ]
  }, {
    "tStartMs": 479730,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the force from the ground\npushes the wheel to the right."
    } ]
  }, {
    "tStartMs": 482760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The front wheel of a bicycle\nis essentially a caster wheel,"
    } ]
  }, {
    "tStartMs": 486240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "like those you find on\nstrollers or shopping carts."
    } ]
  }, {
    "tStartMs": 489480,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Whichever way you drive them,"
    } ]
  }, {
    "tStartMs": 490930,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "the wheel falls in line and\nrolls in the same direction."
    } ]
  }, {
    "tStartMs": 494740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The second reason for a\nbike's corrective steering"
    } ]
  }, {
    "tStartMs": 497380,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "is that the center of mass"
    } ]
  }, {
    "tStartMs": 498550,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "of the handlebars and front wheel"
    } ]
  }, {
    "tStartMs": 500490,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "are located slightly in\nfront of the steering axis."
    } ]
  }, {
    "tStartMs": 503810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, when the bike leans left,"
    } ]
  }, {
    "tStartMs": 505580,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "their weight pushes the\nfront wheel to the left."
    } ]
  }, {
    "tStartMs": 508240,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "If the bike leans right, their\nweight steers to the right."
    } ]
  }, {
    "tStartMs": 512310,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And the third mechanism\nis a gyroscopic effect"
    } ]
  }, {
    "tStartMs": 515220,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but it doesn't keep the\nbike upright directly;"
    } ]
  }, {
    "tStartMs": 518040,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "it just helps steer."
    } ]
  }, {
    "tStartMs": 520020,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "If you have a gyroscope"
    } ]
  }, {
    "tStartMs": 521180,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "and you push down on the left-hand side,"
    } ]
  }, {
    "tStartMs": 523470,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "the gyro will turn left."
    } ]
  }, {
    "tStartMs": 525700,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "If you push down on the right\nside, it will turn right."
    } ]
  }, {
    "tStartMs": 529400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "This is known as gyroscopic precession."
    } ]
  }, {
    "tStartMs": 532120,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "It seems as though the force you apply"
    } ]
  }, {
    "tStartMs": 534170,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "takes effect 90 degrees\nfrom where you applied it."
    } ]
  }, {
    "tStartMs": 537910,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So, bikes are stable\nprimarily because of steering."
    } ]
  }, {
    "tStartMs": 541720,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "They have built-in mechanisms\nfor steering themselves."
    } ]
  }, {
    "tStartMs": 545300,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "In fact, you don't need\nall three mechanisms"
    } ]
  }, {
    "tStartMs": 547810,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "to create a stable bike."
    } ]
  }, {
    "tStartMs": 549690,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Researchers created this\nweird-looking bicycle"
    } ]
  }, {
    "tStartMs": 552520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to prove a point."
    } ]
  }, {
    "tStartMs": 553880,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "It has no gyroscopic effect"
    } ]
  }, {
    "tStartMs": 555780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "thanks to counter-rotating wheels"
    } ]
  }, {
    "tStartMs": 557700,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "above the wheels that touch the floor."
    } ]
  }, {
    "tStartMs": 559750,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Plus, there is no caster effect"
    } ]
  }, {
    "tStartMs": 562080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "because the front wheel touches the floor"
    } ]
  }, {
    "tStartMs": 563920,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "in front of the steering axis."
    } ]
  }, {
    "tStartMs": 566350,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "But this bike is made stable\nby its mass distribution,"
    } ]
  }, {
    "tStartMs": 570080,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "the force of gravity on which"
    } ]
  }, {
    "tStartMs": 571610,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "steers it in the direction of any lean."
    } ]
  }, {
    "tStartMs": 575350,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Understanding how bicycles work"
    } ]
  }, {
    "tStartMs": 577340,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "is still an active area of research."
    } ]
  }, {
    "tStartMs": 580080,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "There is a program you can use to input"
    } ]
  }, {
    "tStartMs": 582100,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "all the different bicycle parameters"
    } ]
  }, {
    "tStartMs": 583770,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "and see the range of speeds\nover which it is self-stable."
    } ]
  }, {
    "tStartMs": 587650,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "And this research is\nleading to better bikes."
    } ]
  }, {
    "tStartMs": 590580,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "This prototype has a smart\nmotor in the handlebars"
    } ]
  }, {
    "tStartMs": 593300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to actively help steer,"
    } ]
  }, {
    "tStartMs": 595300,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "keeping the bike upright\neven at low speeds."
    } ]
  }, {
    "tStartMs": 598550,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I guess it's fitting that we are still"
    } ]
  }, {
    "tStartMs": 600650,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "learning new things about bicycles"
    } ]
  }, {
    "tStartMs": 602630,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "since most of us are able to ride one"
    } ]
  }, {
    "tStartMs": 604760,
    "dDurationMs": 4176,
    "segs": [ {
      "utf8": "without any knowledge of\nhow we're actually doing it."
    } ]
  }, {
    "tStartMs": 608936,
    "dDurationMs": 3584,
    "segs": [ {
      "utf8": "(futuristic sound effects play)"
    } ]
  }, {
    "tStartMs": 612520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Hey, this video is sponsored by KiwiCo,"
    } ]
  }, {
    "tStartMs": 614740,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "creator of awesome\nhands-on projects and toys"
    } ]
  }, {
    "tStartMs": 617170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "designed to expose kids to STEAM concepts."
    } ]
  }, {
    "tStartMs": 619690,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "And with the holidays fast approaching,"
    } ]
  }, {
    "tStartMs": 621330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "a KiwiCo subscription is the perfect gift"
    } ]
  }, {
    "tStartMs": 623880,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "for any of the young people in your life."
    } ]
  }, {
    "tStartMs": 625820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "KiwiCo now has nine\ndifferent subscription lines"
    } ]
  }, {
    "tStartMs": 628370,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for different age groups and topics."
    } ]
  }, {
    "tStartMs": 630500,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Plus, they ship to more than 40 countries."
    } ]
  }, {
    "tStartMs": 632770,
    "dDurationMs": 1470,
    "segs": [ {
