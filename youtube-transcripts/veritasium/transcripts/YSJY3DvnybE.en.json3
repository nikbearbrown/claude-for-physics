{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 40,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- Watch what happens if\nyou take a credit card"
    } ]
  }, {
    "tStartMs": 2240,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and stick it in a beaker of acetone."
    } ]
  }, {
    "tStartMs": 4360,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- Nail polish remover basically?"
    } ]
  }, {
    "tStartMs": 5600,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "- Nail polish remover.\n- Okay."
    } ]
  }, {
    "tStartMs": 7270,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "- [Henry] It does start\nto work very quickly."
    } ]
  }, {
    "tStartMs": 9428,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "- [Marques] That is crazy."
    } ]
  }, {
    "tStartMs": 11830,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "- [Henry] This is one that we\nstarted about 30 minutes ago."
    } ]
  }, {
    "tStartMs": 14960,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "We'll do a little-"
    } ]
  }, {
    "tStartMs": 15840,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- That's a credit card\nfrom 30 minutes ago?"
    } ]
  }, {
    "tStartMs": 18390,
    "dDurationMs": 718,
    "segs": [ {
      "utf8": "- [Henry] Yeah."
    } ]
  }, {
    "tStartMs": 19108,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "- [Marques] Why does it look,\nokay, so I see this like,"
    } ]
  }, {
    "tStartMs": 21360,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "this like frame on the inside now."
    } ]
  }, {
    "tStartMs": 23350,
    "dDurationMs": 478,
    "segs": [ {
      "utf8": "- [Henry] Yes."
    } ]
  }, {
    "tStartMs": 23828,
    "dDurationMs": 3132,
    "segs": [ {
      "utf8": "- [Marques] Is that all\nantenna bands basically?"
    } ]
  }, {
    "tStartMs": 26960,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- Exactly. That's the antenna."
    } ]
  }, {
    "tStartMs": 28320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And the chip right there in the middle."
    } ]
  }, {
    "tStartMs": 30320,
    "dDurationMs": 6624,
    "segs": [ {
      "utf8": "And what we're gonna do now\nis show it's still working."
    } ]
  }, {
    "tStartMs": 36944,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "- [Marques] Ah. Okay."
    } ]
  }, {
    "tStartMs": 37910,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "- [Henry] Oh, that's the\nimportant part, all right."
    } ]
  }, {
    "tStartMs": 40068,
    "dDurationMs": 722,
    "segs": [ {
      "utf8": "- [Marques] That's it."
    } ]
  }, {
    "tStartMs": 40790,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "- [Henry] Yeah, that's your credit card."
    } ]
  }, {
    "tStartMs": 42160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Theoretically, if you\njust touch that here,"
    } ]
  }, {
    "tStartMs": 45040,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I think it would work."
    } ]
  }, {
    "tStartMs": 46000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Come on, little card."
    } ]
  }, {
    "tStartMs": 47600,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "You can do it."
    } ]
  }, {
    "tStartMs": 49360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "You still have $20."
    } ]
  }, {
    "tStartMs": 50640,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "You gotta believe."
    } ]
  }, {
    "tStartMs": 51600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I guess that's why the\nantennas are so important."
    } ]
  }, {
    "tStartMs": 53600,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "- Yeah, right?"
    } ]
  }, {
    "tStartMs": 54720,
    "dDurationMs": 240,
    "segs": [ {
      "utf8": "(phone beeps)"
    } ]
  }, {
    "tStartMs": 54960,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- [Henry] Right, with the\nantenna, it works now."
    } ]
  }, {
    "tStartMs": 58320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- That worked? Wow!"
    } ]
  }, {
    "tStartMs": 60320,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- How cool is that?"
    } ]
  }, {
    "tStartMs": 61720,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- This is just one of the technologies"
    } ]
  }, {
    "tStartMs": 64160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "hidden inside a credit card."
    } ]
  }, {
    "tStartMs": 66560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And you can trace its origins"
    } ]
  }, {
    "tStartMs": 68240,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "back to a top secret CIA\ncounter surveillance operation."
    } ]
  }, {
    "tStartMs": 73040,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "In this pair of videos,"
    } ]
  }, {
    "tStartMs": 74400,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "we're going to uncover"
    } ]
  }, {
    "tStartMs": 75520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "all of the credit card's hidden features"
    } ]
  }, {
    "tStartMs": 77520,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and put them to the test to\nsee how secure they really are,"
    } ]
  }, {
    "tStartMs": 81520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "including attempting to steal $10,000"
    } ]
  }, {
    "tStartMs": 84240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "from MKBHD's locked iPhone."
    } ]
  }, {
    "tStartMs": 86320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- That's a lot of zeros."
    } ]
  }, {
    "tStartMs": 87760,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Careful with that."
    } ]
  }, {
    "tStartMs": 88640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Oh my God."
    } ]
  }, {
    "tStartMs": 89760,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "I don't like that at all. (chuckles)"
    } ]
  }, {
    "tStartMs": 93110,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "- [Derek] In 1945, at the\nend of the Second World War,"
    } ]
  }, {
    "tStartMs": 95440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "a group of Soviet school children"
    } ]
  }, {
    "tStartMs": 97120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "visited the US ambassador\nto the Soviet Union."
    } ]
  }, {
    "tStartMs": 99680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They presented him with\na hand-carved plaque,"
    } ]
  }, {
    "tStartMs": 102320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of the great seal of the United States,"
    } ]
  }, {
    "tStartMs": 104720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "a gift to acknowledge the\ncountry's recent alliance."
    } ]
  }, {
    "tStartMs": 108000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The ambassador proudly displayed\nthe plaque in his office."
    } ]
  }, {
    "tStartMs": 111600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But what he didn't know\nwas that hidden inside"
    } ]
  }, {
    "tStartMs": 114160,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "was a secret listening device, a bug."
    } ]
  }, {
    "tStartMs": 117680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This bug was the first of its kind."
    } ]
  }, {
    "tStartMs": 119760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It had no battery, no plug point,"
    } ]
  }, {
    "tStartMs": 122000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "no power source of any kind."
    } ]
  }, {
    "tStartMs": 123760,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So when the US counter\nsurveillance team swept the office,"
    } ]
  }, {
    "tStartMs": 126800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "they couldn't find it."
    } ]
  }, {
    "tStartMs": 128480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "In fact, the bug remained\nundetected for years."
    } ]
  }, {
    "tStartMs": 132080,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But then in 1951,\nsomething strange happened."
    } ]
  }, {
    "tStartMs": 135680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "An operator at the nearby British embassy"
    } ]
  }, {
    "tStartMs": 138000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "was monitoring Soviet radio channels"
    } ]
  }, {
    "tStartMs": 140240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "when he heard people speaking,"
    } ]
  }, {
    "tStartMs": 142400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "not Russian, but English."
    } ]
  }, {
    "tStartMs": 144800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "English that was coming"
    } ]
  }, {
    "tStartMs": 146000,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "from inside the US ambassador's residence."
    } ]
  }, {
    "tStartMs": 149280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But despite multiple\nsweeps of the building,"
    } ]
  }, {
    "tStartMs": 151120,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "the Americans couldn't find\nany hidden listening devices."
    } ]
  }, {
    "tStartMs": 154800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Then in 1952,"
    } ]
  }, {
    "tStartMs": 156400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they detected a radio signal"
    } ]
  }, {
    "tStartMs": 158320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "coming from the ambassador's office."
    } ]
  }, {
    "tStartMs": 160360,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- They said, \"It's coming from over there"
    } ]
  }, {
    "tStartMs": 162080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "behind that plaque on the wall.\""
    } ]
  }, {
    "tStartMs": 163600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And they took the plaque down\nand put it down somewhere,"
    } ]
  }, {
    "tStartMs": 166720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "so they tore all the plaster out,"
    } ]
  }, {
    "tStartMs": 168560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "trying to find the microphones\nthat were hidden in the wall."
    } ]
  }, {
    "tStartMs": 170640,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Of course, there was nothing."
    } ]
  }, {
    "tStartMs": 171920,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Absolutely nothing."
    } ]
  }, {
    "tStartMs": 172960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Joseph Bezjian, who was a total hero,"
    } ]
  }, {
    "tStartMs": 175440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "pointed at the plaque and said,"
    } ]
  }, {
    "tStartMs": 177840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "\"Don't say anything."
    } ]
  }, {
    "tStartMs": 179360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Just come outside and let's talk.\""
    } ]
  }, {
    "tStartMs": 181760,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "And then they said, \"Right,\nlet's take it to bits.\""
    } ]
  }, {
    "tStartMs": 184950,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "- [Derek] They prized open the seal,"
    } ]
  }, {
    "tStartMs": 187600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and to their horror, discovered the bug."
    } ]
  }, {
    "tStartMs": 190880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It looked simple,"
    } ]
  }, {
    "tStartMs": 192080,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "an antenna attached to\na small copper cavity."
    } ]
  }, {
    "tStartMs": 196720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "But what made this\ndevice so hard to detect"
    } ]
  }, {
    "tStartMs": 199040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "was that it had no power source."
    } ]
  }, {
    "tStartMs": 201040,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It laid totally dormant"
    } ]
  }, {
    "tStartMs": 202560,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "until it was activated\nremotely by the Soviets."
    } ]
  }, {
    "tStartMs": 208000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "To see how it works,"
    } ]
  }, {
    "tStartMs": 209360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "we're gonna simulate sending\nsome radio waves at the bug"
    } ]
  }, {
    "tStartMs": 212160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and monitor any signal we get back."
    } ]
  }, {
    "tStartMs": 214560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "We'll start at 800 megahertz"
    } ]
  }, {
    "tStartMs": 216400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and then gradually ramp up the frequency."
    } ]
  }, {
    "tStartMs": 218880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "At first, nothing much happens,"
    } ]
  }, {
    "tStartMs": 221840,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "but then around 900 megahertz,\nwe get a strong signal back."
    } ]
  }, {
    "tStartMs": 226720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "That's because as the radio\nwaves hit the antenna,"
    } ]
  }, {
    "tStartMs": 229280,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "their electric field tugs\non the electrons inside,"
    } ]
  }, {
    "tStartMs": 232000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "causing them to oscillate"
    } ]
  }, {
    "tStartMs": 233200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and create an alternating\ncurrent inside the antenna,"
    } ]
  }, {
    "tStartMs": 236080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which in turn re-radiates a signal out."
    } ]
  }, {
    "tStartMs": 239200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "At most frequencies,\nthat signal is very weak,"
    } ]
  }, {
    "tStartMs": 242080,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but around 900 megahertz,"
    } ]
  }, {
    "tStartMs": 243840,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "each push from the radio waves lines up"
    } ]
  }, {
    "tStartMs": 245920,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "almost perfectly with how\nthe electrons oscillate."
    } ]
  }, {
    "tStartMs": 248640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "So each cycle reinforces the\nlast and you get resonance."
    } ]
  }, {
    "tStartMs": 252720,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "As a result, you get a\nstrongly reradiated signal."
    } ]
  }, {
    "tStartMs": 257200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This resonant frequency is unique"
    } ]
  }, {
    "tStartMs": 259280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to a given object or circuit,"
    } ]
  }, {
    "tStartMs": 261040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and it changes based on\nits electrical properties"
    } ]
  }, {
    "tStartMs": 263520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "like capacitance."
    } ]
  }, {
    "tStartMs": 265200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So the Soviets realized\nthey could use this"
    } ]
  }, {
    "tStartMs": 267520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "by adding a cavity."
    } ]
  }, {
    "tStartMs": 269120,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "- What we need to do is\nhave a resonant cavity"
    } ]
  }, {
    "tStartMs": 272800,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "that's very, very highly tuned,\nlike a tuning fork for radio."
    } ]
  }, {
    "tStartMs": 277360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "(metal chimes)"
    } ]
  }, {
    "tStartMs": 279440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Now, obviously there's a capacitance"
    } ]
  }, {
    "tStartMs": 281360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "between this end and the sheet,"
    } ]
  }, {
    "tStartMs": 283760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and as the diaphragm moves in and out,"
    } ]
  }, {
    "tStartMs": 286480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the capacitance changes,"
    } ]
  }, {
    "tStartMs": 288320,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "so that changes the tuning of\nthis electronic tuning fork."
    } ]
  }, {
    "tStartMs": 292950,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- [Derek] So as people\nin the room speak,"
    } ]
  }, {
    "tStartMs": 294560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the sound vibrates the diaphragm,"
    } ]
  }, {
    "tStartMs": 296480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and that changes the capacitance\nbetween the two plates,"
    } ]
  }, {
    "tStartMs": 299200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "which in turn alters\nthe resonant frequency."
    } ]
  }, {
    "tStartMs": 302000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- So you get a 10-nanometer movement,"
    } ]
  }, {
    "tStartMs": 304160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that's enough to move\nthe resonant frequency."
    } ]
  }, {
    "tStartMs": 306320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- That changes the\namplitude of the radio waves"
    } ]
  }, {
    "tStartMs": 309120,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "that get reradiated."
    } ]
  }, {
    "tStartMs": 310640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So you end up with this,"
    } ]
  }, {
    "tStartMs": 312240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "a return signal that contains\nthe original radio wave,"
    } ]
  }, {
    "tStartMs": 315360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "but it's enveloped within the sound wave."
    } ]
  }, {
    "tStartMs": 318160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's a technique called\namplitude modulation,"
    } ]
  }, {
    "tStartMs": 320560,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and it's the same technique\nused to create AM radio."
    } ]
  }, {
    "tStartMs": 323920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So whenever the Soviets wanted\nto listen to a conversation,"
    } ]
  }, {
    "tStartMs": 326720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "they blasted radio waves from outside,"
    } ]
  }, {
    "tStartMs": 329120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "likely from a van or a nearby building."
    } ]
  }, {
    "tStartMs": 331680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And then they received the radio wave"
    } ]
  }, {
    "tStartMs": 333520,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "they got back from the bug"
    } ]
  }, {
    "tStartMs": 334640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and extracted the sound information"
    } ]
  }, {
    "tStartMs": 336640,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "modulating that radio signal."
    } ]
  }, {
    "tStartMs": 340480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The Americans nicknamed\nthe bug \"The Thing,\""
    } ]
  }, {
    "tStartMs": 342720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "since at first, they\ndidn't know how it worked."
    } ]
  }, {
    "tStartMs": 345520,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It was created by Soviet\ninventor, Leon Theremin,"
    } ]
  }, {
    "tStartMs": 348560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "who'd been coerced into\nbuilding the device"
    } ]
  }, {
    "tStartMs": 350640,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "while imprisoned in a\nGulag during the 1940s."
    } ]
  }, {
    "tStartMs": 354080,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "This is the same guy"
    } ]
  }, {
    "tStartMs": 355120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "who invented the contactless\nelectrical instrument"
    } ]
  }, {
    "tStartMs": 357760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "named after him."
    } ]
  }, {
    "tStartMs": 359840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So what did the president and the CIA do"
    } ]
  }, {
    "tStartMs": 362480,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "after discovering the bug"
    } ]
  }, {
    "tStartMs": 363600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that had been spying on\nthem for seven years?"
    } ]
  }, {
    "tStartMs": 366720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They told no one."
    } ]
  }, {
    "tStartMs": 369120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "They realized the thing was years ahead"
    } ]
  }, {
    "tStartMs": 371360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "of their own spying technology."
    } ]
  }, {
    "tStartMs": 373200,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "- This was new and\nnobody done this before."
    } ]
  }, {
    "tStartMs": 376640,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "There were no countermeasures."
    } ]
  }, {
    "tStartMs": 378390,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- [Derek] So they secretly began working"
    } ]
  }, {
    "tStartMs": 380000,
    "dDurationMs": 6449,
    "segs": [ {
      "utf8": "on their own enhanced\nversion of the device."
    } ]
  }, {
    "tStartMs": 386449,
    "dDurationMs": 21,
    "segs": [ {
      "utf8": "(bright upbeat music)"
    } ]
  }, {
    "tStartMs": 386470,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "- [Henry] Meanwhile, in the\nrest of the United States,"
    } ]
  }, {
    "tStartMs": 388320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the post-war economy was booming."
    } ]
  }, {
    "tStartMs": 390560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "For the first time, ordinary\nfamilies could afford things"
    } ]
  }, {
    "tStartMs": 393200,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "that used to be luxuries,\nTVs, cars, even flights."
    } ]
  }, {
    "tStartMs": 397760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But paying for these\nexpensive items was clunky."
    } ]
  }, {
    "tStartMs": 400240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "You either had to carry\na huge wad of cash,"
    } ]
  }, {
    "tStartMs": 402320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "or you wrote a check that\nmight take days to clear."
    } ]
  }, {
    "tStartMs": 404520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- So banks saw an opportunity."
    } ]
  }, {
    "tStartMs": 406480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "If you could make buying\nthings even easier,"
    } ]
  }, {
    "tStartMs": 408320,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "then spending could explode."
    } ]
  }, {
    "tStartMs": 411830,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "- [Henry] The first bank to\ncapitalize was Bank of America."
    } ]
  }, {
    "tStartMs": 414720,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "In 1958, they launched their-"
    } ]
  }, {
    "tStartMs": 416386,
    "dDurationMs": 814,
    "segs": [ {
      "utf8": "- [Announcer] BankAmericard."
    } ]
  }, {
    "tStartMs": 417920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's money in a more versatile form."
    } ]
  }, {
    "tStartMs": 419920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Allowing customers to buy"
    } ]
  }, {
    "tStartMs": 421520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "all kinds of expensive items on credit."
    } ]
  }, {
    "tStartMs": 424160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "This was the first universal credit card."
    } ]
  }, {
    "tStartMs": 426480,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "By the end of the decade,"
    } ]
  }, {
    "tStartMs": 427600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "two million cards were in circulation,"
    } ]
  }, {
    "tStartMs": 429600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and over 20,000 merchants\nhad agreed to accept it."
    } ]
  }, {
    "tStartMs": 432960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "A few decades later,"
    } ]
  }, {
    "tStartMs": 434080,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "this card was being used\nworldwide under a different name,"
    } ]
  }, {
    "tStartMs": 437840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Visa."
    } ]
  }, {
    "tStartMs": 439040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But these early cards\nhad two main problems."
    } ]
  }, {
    "tStartMs": 441840,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "First, for each transaction,"
    } ]
  }, {
    "tStartMs": 443200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the seller had to physically\nimprint the card details"
    } ]
  }, {
    "tStartMs": 445600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "onto two slips."
    } ]
  }, {
    "tStartMs": 447040,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "One for the customer,"
    } ]
  }, {
    "tStartMs": 447920,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and then one they'd\nlater send to the bank."
    } ]
  }, {
    "tStartMs": 450000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That's why the numbers on older\ncards are slightly raised."
    } ]
  }, {
    "tStartMs": 453120,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "However, this whole process"
    } ]
  }, {
    "tStartMs": 454400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "was inconvenient for the customer,"
    } ]
  }, {
    "tStartMs": 456000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "who was still used to\njust handing over cash,"
    } ]
  }, {
    "tStartMs": 458240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but it was even more\ninconvenient for the seller."
    } ]
  }, {
    "tStartMs": 460240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "They had to mail all\nthese slips to the bank"
    } ]
  }, {
    "tStartMs": 462080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "or take them over themselves."
    } ]
  }, {
    "tStartMs": 463680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The bank would then visually inspect them"
    } ]
  }, {
    "tStartMs": 465360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "in order to authorize a payment."
    } ]
  }, {
    "tStartMs": 466880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "This meant that it could take days"
    } ]
  }, {
    "tStartMs": 468320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "before the seller actually\nreceived the funds"
    } ]
  }, {
    "tStartMs": 470240,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "in their account."
    } ]
  }, {
    "tStartMs": 471360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So that first problem was speed."
    } ]
  }, {
    "tStartMs": 473920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And this actually led to the\nsecond problem, security."
    } ]
  }, {
    "tStartMs": 477040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "A criminal could buy something"
    } ]
  }, {
    "tStartMs": 478320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "with a stolen or counterfeit card,"
    } ]
  }, {
    "tStartMs": 479920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and by the time the banks realized"
    } ]
  }, {
    "tStartMs": 481360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "they'd been defrauded several days later,"
    } ]
  }, {
    "tStartMs": 483440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "well, the criminal was long gone."
    } ]
  }, {
    "tStartMs": 485440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And as criminals got\nsmarter, fraud kept growing."
    } ]
  }, {
    "tStartMs": 488240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "By the late '60s, credit card fraud"
    } ]
  }, {
    "tStartMs": 490160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "was costing the banks $100 million a year,"
    } ]
  }, {
    "tStartMs": 493360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "around a billion in today's money."
    } ]
  }, {
    "tStartMs": 495920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So the banks needed to\nmake a better system,"
    } ]
  }, {
    "tStartMs": 498160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "one that was faster, but also more secure."
    } ]
  }, {
    "tStartMs": 502800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Back at CIA headquarters,"
    } ]
  }, {
    "tStartMs": 504400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "they were facing a similar problem."
    } ]
  }, {
    "tStartMs": 506400,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "To enter the building, staff\npresented an ID card to a guard"
    } ]
  }, {
    "tStartMs": 510400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "who would inspect it and\ndecide whether to let them in."
    } ]
  }, {
    "tStartMs": 513360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "This process was slow"
    } ]
  }, {
    "tStartMs": 514640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and all the information was\nclearly visible on the cards."
    } ]
  }, {
    "tStartMs": 517840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "So if you think about it,"
    } ]
  }, {
    "tStartMs": 518960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "it wouldn't be that hard\nfor a card to be cloned by,"
    } ]
  }, {
    "tStartMs": 521920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "say, a Soviet spy."
    } ]
  }, {
    "tStartMs": 523920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Then in the early 1960s,"
    } ]
  }, {
    "tStartMs": 525600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "they wanted to create\na more secure ID card"
    } ]
  }, {
    "tStartMs": 527920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "for CIA officials,"
    } ]
  }, {
    "tStartMs": 529280,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "and to do that,"
    } ]
  }, {
    "tStartMs": 529920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "they brought in IBM\nengineer Forrest Parry."
    } ]
  }, {
    "tStartMs": 533600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Parry knew that audio cassettes\nstored their information"
    } ]
  }, {
    "tStartMs": 536160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "on magnetic tape,"
    } ]
  }, {
    "tStartMs": 537360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and he wondered if he\ncould use the same tape"
    } ]
  }, {
    "tStartMs": 539440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to store data on the ID cards."
    } ]
  }, {
    "tStartMs": 541600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "He managed that part easily enough,"
    } ]
  }, {
    "tStartMs": 543840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but no matter what he tried,"
    } ]
  }, {
    "tStartMs": 545280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "he couldn't get the tape\nto stick to the cards."
    } ]
  }, {
    "tStartMs": 547760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It would just keep falling off."
    } ]
  }, {
    "tStartMs": 549440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Frustrated, he shared\nthe issue with his wife"
    } ]
  }, {
    "tStartMs": 552080,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "while she was doing the\nironing, and legend has it,"
    } ]
  }, {
    "tStartMs": 554720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "she suggested just ironing\nthe tape onto the card,"
    } ]
  }, {
    "tStartMs": 557920,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and the idea quite literally stuck."
    } ]
  }, {
    "tStartMs": 562320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So what's very interesting\nabout magnetic stripes,"
    } ]
  }, {
    "tStartMs": 564080,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and this is an old card from\nour fellow writer, Casper,"
    } ]
  }, {
    "tStartMs": 567760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and what we're gonna\ndo is we're gonna show"
    } ]
  }, {
    "tStartMs": 569200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that if you get a little\nbit of iron filings"
    } ]
  }, {
    "tStartMs": 570800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "on the back of this card,"
    } ]
  }, {
    "tStartMs": 571600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "we're just gonna run it through here."
    } ]
  }, {
    "tStartMs": 573120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So you kinda see it's like\nsticking to that magnetic stripe."
    } ]
  }, {
    "tStartMs": 575640,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "- Yeah.\n- Right?"
    } ]
  }, {
    "tStartMs": 576400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And if we knock off a bit of this,"
    } ]
  }, {
    "tStartMs": 578160,
    "dDurationMs": 3428,
    "segs": [ {
      "utf8": "you see there's sort of ones and zeros."
    } ]
  }, {
    "tStartMs": 581588,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "- [Marques] Just because it's magnetic."
    } ]
  }, {
    "tStartMs": 582790,
    "dDurationMs": 330,
    "segs": [ {
      "utf8": "- [Henry] Yeah."
    } ]
  }, {
    "tStartMs": 583120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So you can read a magnetic stripe"
    } ]
  }, {
    "tStartMs": 584960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "with only magnetic filings."
    } ]
  }, {
    "tStartMs": 586560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- I don't know, I guess\nthat makes perfect sense."
    } ]
  }, {
    "tStartMs": 588320,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Right, okay."
    } ]
  }, {
    "tStartMs": 588960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- But you can also see\nhow simple it is, right?"
    } ]
  }, {
    "tStartMs": 591360,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "At the end of the day,"
    } ]
  }, {
    "tStartMs": 591920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "it's just ones and zeros,\nyou know, in a code."
    } ]
  }, {
    "tStartMs": 595200,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "And that code can be read by this machine"
    } ]
  }, {
    "tStartMs": 600080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "So that is all the information\nthere, Casper Mebius."
    } ]
  }, {
    "tStartMs": 603240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Oh, yeah.\n- Yep."
    } ]
  }, {
    "tStartMs": 605160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- That's the name, the card number?"
    } ]
  }, {
    "tStartMs": 607160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Yeah, right there."
    } ]
  }, {
    "tStartMs": 608480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The first magnetic stripe credit cards"
    } ]
  }, {
    "tStartMs": 610560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "were rolled out in 1970."
    } ]
  }, {
    "tStartMs": 612560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "These new cards slashed the time required"
    } ]
  }, {
    "tStartMs": 614560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to process transactions."
    } ]
  }, {
    "tStartMs": 616320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Not only did that make\nspending way easier,"
    } ]
  }, {
    "tStartMs": 618560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but it became easier for the bank"
    } ]
  }, {
    "tStartMs": 620080,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "to quickly identify and\nblock suspicious payments."
    } ]
  }, {
    "tStartMs": 624240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So these new cards seem\nto solve the problem,"
    } ]
  }, {
    "tStartMs": 626240,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "speed and security,"
    } ]
  }, {
    "tStartMs": 627280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and that's what today's\nsponsor Saily is all about."
    } ]
  }, {
    "tStartMs": 629600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And right now I'm traveling to New York,"
    } ]
  }, {
    "tStartMs": 631120,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "and when I touch down,"
    } ]
  }, {
    "tStartMs": 632160,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "I'm gonna use Saily to make sure"
    } ]
  }, {
    "tStartMs": 633280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that I'm seamlessly connected when I land."
    } ]
  }, {
    "tStartMs": 635040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "All you have to do is first\ndownload the Saily app,"
    } ]
  }, {
    "tStartMs": 637120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "then you're gonna search\nfor your destination,"
    } ]
  }, {
    "tStartMs": 638320,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I'm gonna select the United States,"
    } ]
  }, {
    "tStartMs": 639680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and then you pick a data\nplan that fits your trip."
    } ]
  }, {
    "tStartMs": 641520,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And then right here at checkout,"
    } ]
  }, {
    "tStartMs": 642640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "you can apply the code Veritasium"
    } ]
  }, {
    "tStartMs": 644160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to get 15% off on your order."
    } ]
  }, {
    "tStartMs": 646160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And the best part of this\nis the moment I touch down,"
    } ]
  }, {
    "tStartMs": 648320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "I can just use my mobile data as normal."
    } ]
  }, {
    "tStartMs": 650160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I can open Maps, call an Uber,"
    } ]
  }, {
    "tStartMs": 652080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "or call my mom to let her\nknow that I got there safely."
    } ]
  }, {
    "tStartMs": 654640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "All this without rushing\nto get on airport Wi-Fi"
    } ]
  }, {
    "tStartMs": 656800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "or any other unsecured public network,"
    } ]
  }, {
    "tStartMs": 658640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "or waiting in line for a local SIM,"
    } ]
  }, {
    "tStartMs": 660480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "or relying on hefty fees"
    } ]
  }, {
    "tStartMs": 661680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that your carrier charges for roaming."
    } ]
  }, {
    "tStartMs": 663600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "It's also so much better"
    } ]
  }, {
    "tStartMs": 664560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "than swapping tiny physical SIM cards."
    } ]
  }, {
    "tStartMs": 666640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Once the Saily eSIM is installed,"
    } ]
  }, {
    "tStartMs": 668480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "you don't have to install a new one"
    } ]
  }, {
    "tStartMs": 669680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "when you visit different countries."
    } ]
  }, {
    "tStartMs": 670880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You just go into the app\nand you can change it there."
    } ]
  }, {
    "tStartMs": 672880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And Saily offers plans across"
    } ]
  }, {
    "tStartMs": 674320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "over 200 different destinations."
    } ]
  }, {
    "tStartMs": 676160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So if you're traveling\nacross multiple countries,"
    } ]
  }, {
    "tStartMs": 678240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "get a regional plan or a global plan."
    } ]
  }, {
    "tStartMs": 680560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And the Saily Ultra Plan takes\nconvenience even further."
    } ]
  }, {
    "tStartMs": 683600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It gives you unlimited data"
    } ]
  }, {
    "tStartMs": 685280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and special perks like\naccess to airport lounges,"
    } ]
  }, {
    "tStartMs": 688080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "fast track services,"
    } ]
  }, {
    "tStartMs": 689280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and advanced online security tools."
    } ]
  }, {
    "tStartMs": 691280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So download the Saily app via\nthe QR code that's on screen,"
    } ]
  }, {
    "tStartMs": 694160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and when you're at checkout,\nuse code Veritasium,"
    } ]
  }, {
    "tStartMs": 696240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and then you can share\nyour own referral code"
    } ]
  }, {
    "tStartMs": 697680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with your friends to get\neven more off your next trip."
    } ]
  }, {
    "tStartMs": 700000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "I wanna thank Saily for\nsponsoring this video,"
    } ]
  }, {
    "tStartMs": 701840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and now back to the show."
    } ]
  }, {
    "tStartMs": 703760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "So, these new cards seem"
    } ]
  }, {
    "tStartMs": 705120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "to solve the problems\nof speed and security,"
    } ]
  }, {
    "tStartMs": 708160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but this magnetic stripe\nhad a critical weakness."
    } ]
  }, {
    "tStartMs": 711760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This is how you read credit cards,"
    } ]
  }, {
    "tStartMs": 713920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but also you can write to them, right?"
    } ]
  }, {
    "tStartMs": 715440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So this is just a blank card."
    } ]
  }, {
    "tStartMs": 717360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So if we get some, like,\nmagnetic dust on there,"
    } ]
  }, {
    "tStartMs": 720960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "it's not really doing anything,"
    } ]
  }, {
    "tStartMs": 723040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "but if we write to this one,"
    } ]
  }, {
    "tStartMs": 725760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "let's try reading it and\nsee if we got anything."
    } ]
  }, {
    "tStartMs": 727840,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- Oh, it's reading as if\nit's the same Casper's card"
    } ]
  }, {
    "tStartMs": 731680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "with the 0009 and the\nsuper long stripe number."
    } ]
  }, {
    "tStartMs": 734480,
    "dDurationMs": 280,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 734760,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- So does that mean if you\nput magnetic filings on it now"
    } ]
  }, {
    "tStartMs": 737360,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "it will show that it's written-"
    } ]
  }, {
    "tStartMs": 740710,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "- [Henry] So now you see\nwe're getting something."
    } ]
  }, {
    "tStartMs": 742468,
    "dDurationMs": 1412,
    "segs": [ {
      "utf8": "- [Marques] Yeah, yep."
    } ]
  }, {
    "tStartMs": 743880,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- But you can, like, line them up"
    } ]
  }, {
    "tStartMs": 745360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and you can see that\nthey're the same code."
    } ]
  }, {
    "tStartMs": 747120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Maybe it's a little hard\nto see in the light."
    } ]
  }, {
    "tStartMs": 751040,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Cloning cards in this way"
    } ]
  }, {
    "tStartMs": 752160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and then using that to steal money"
    } ]
  }, {
    "tStartMs": 753600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "was so easy and so effective"
    } ]
  }, {
    "tStartMs": 755200,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "that some people made\nentire businesses out of it."
    } ]
  }, {
    "tStartMs": 757560,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- Back then, right, we would\nhave what we call a grabber,"
    } ]
  }, {
    "tStartMs": 761040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "which is a card reader."
    } ]
  }, {
    "tStartMs": 762240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I ended up having, like, 300 people"
    } ]
  }, {
    "tStartMs": 764640,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "working for me in restaurants, bars."
    } ]
  }, {
    "tStartMs": 767510,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- [Henry] This is Tony Sales,"
    } ]
  }, {
    "tStartMs": 768960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "co-founder of We Fight Fincrime,"
    } ]
  }, {
    "tStartMs": 771120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "but around 20 years ago,\nhe had a different title,"
    } ]
  }, {
    "tStartMs": 774640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Britain's greatest fraudster."
    } ]
  }, {
    "tStartMs": 776160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "- I'd give them a grabber, yeah,"
    } ]
  }, {
    "tStartMs": 778240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and I'd just say to them,\n\"Just swipe the numbers."
    } ]
  }, {
    "tStartMs": 780480,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Just when someone comes\nto pay, swipe their card,"
    } ]
  }, {
    "tStartMs": 783040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "then swipe that one on there.\""
    } ]
  }, {
    "tStartMs": 784870,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "You know, I'm gathering thousands"
    } ]
  }, {
    "tStartMs": 786640,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and thousands of numbers weekly."
    } ]
  }, {
    "tStartMs": 789360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But I'm also becoming a\nwholesaler of the numbers."
    } ]
  }, {
    "tStartMs": 792560,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "You know, at 16, I was\npaying, like, loads of people,"
    } ]
  }, {
    "tStartMs": 796400,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "300 quid a week wages."
    } ]
  }, {
    "tStartMs": 797640,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- The problem is that the data"
    } ]
  }, {
    "tStartMs": 799120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "on that magnetic stripe is static."
    } ]
  }, {
    "tStartMs": 801040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So if you have a skimmer,"
    } ]
  }, {
    "tStartMs": 802240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "you can clone the card in seconds"
    } ]
  }, {
    "tStartMs": 803840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and then reuse it again and again,"
    } ]
  }, {
    "tStartMs": 806480,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "draining the funds before\nthe card owners realized."
    } ]
  }, {
    "tStartMs": 808840,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- Yeah, well, I had half a\nmillion quid under my bed,"
    } ]
  }, {
    "tStartMs": 811200,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "didn't I, at 16?"
    } ]
  }, {
    "tStartMs": 812560,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "It's crazy how easy it was."
    } ]
  }, {
    "tStartMs": 815030,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Henry] By the early 2000s,"
    } ]
  }, {
    "tStartMs": 816320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "card fraud was costing the UK"
    } ]
  }, {
    "tStartMs": 818160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "over 400 million pounds a year,"
    } ]
  }, {
    "tStartMs": 820480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and the single biggest culprit\nwas magnetic stripe skimming."
    } ]
  }, {
    "tStartMs": 823680,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "- The UK was just getting hit massively"
    } ]
  }, {
    "tStartMs": 828080,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "with credit card fraud."
    } ]
  }, {
    "tStartMs": 829840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- So the biggest card\nnetworks got together"
    } ]
  }, {
    "tStartMs": 832480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to solve the problem."
    } ]
  }, {
    "tStartMs": 833840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They created the EMV standard,"
    } ]
  }, {
    "tStartMs": 836240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a 700-page document that defined"
    } ]
  }, {
    "tStartMs": 838640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "how to make secure card payments."
    } ]
  }, {
    "tStartMs": 841040,
    "dDurationMs": 4226,
    "segs": [ {
      "utf8": "The result was this, the chip."
    } ]
  }, {
    "tStartMs": 845266,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(lively music)"
    } ]
  }, {
    "tStartMs": 845280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It's what you use every\ntime you enter your card"
    } ]
  }, {
    "tStartMs": 847120,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "to a payment terminal, and\nthen you enter the pin."
    } ]
  }, {
    "tStartMs": 850320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "In other words, chip and pin."
    } ]
  }, {
    "tStartMs": 852800,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Now, the way the chip works"
    } ]
  }, {
    "tStartMs": 854080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "is fundamentally different\nfrom the magnetic stripe."
    } ]
  }, {
    "tStartMs": 856400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's because the magnetic stripe"
    } ]
  }, {
    "tStartMs": 857840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "encodes information statically,\nso every time you use it,"
    } ]
  }, {
    "tStartMs": 860560,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "it sends the same information\nfirst onto the card reader,"
    } ]
  }, {
    "tStartMs": 863520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "then onto the issuing bank."
    } ]
  }, {
    "tStartMs": 865360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "But the chip is different."
    } ]
  }, {
    "tStartMs": 866880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That's because it's\nbasically a mini computer."
    } ]
  }, {
    "tStartMs": 869280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So it can encrypt its\ninformation using a secret key"
    } ]
  }, {
    "tStartMs": 871920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "known only by itself and the issuing bank."
    } ]
  }, {
    "tStartMs": 874160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "When you insert the chip,"
    } ]
  }, {
    "tStartMs": 875360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the reader sends it a long message"
    } ]
  }, {
    "tStartMs": 877200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "containing all the transaction details"
    } ]
  }, {
    "tStartMs": 879280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "as well as a long random\nnumber generated by the reader."
    } ]
  }, {
    "tStartMs": 882480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The chip then uses its secret\nkey to garble the message"
    } ]
  }, {
    "tStartMs": 885280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "into a unique code, which\nit sends back to the reader."
    } ]
  }, {
    "tStartMs": 888640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The reader then forwards\nthis onto the bank,"
    } ]
  }, {
    "tStartMs": 890720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "along with the raw transaction details"
    } ]
  }, {
    "tStartMs": 892560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and the random number."
    } ]
  }, {
    "tStartMs": 894240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The bank then applies its own\nkey to the raw data as well,"
    } ]
  }, {
    "tStartMs": 897200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and if the output matches\nthe code from the card,"
    } ]
  }, {
    "tStartMs": 899360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "well, the bank knows\nthe transaction's valid."
    } ]
  }, {
    "tStartMs": 902240,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Then, and only then does the\nbank authorize the transaction."
    } ]
  }, {
    "tStartMs": 906480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This process makes the chip\nmore secure for two reasons."
    } ]
  }, {
    "tStartMs": 910080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "First, each transaction\ncreates a new, unique code,"
    } ]
  }, {
    "tStartMs": 912960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "so you can't steal a code and reuse it."
    } ]
  }, {
    "tStartMs": 915280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Second, a chip is incredibly\ndifficult to clone."
    } ]
  }, {
    "tStartMs": 918160,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "That's because its secret key"
    } ]
  }, {
    "tStartMs": 919440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "is never revealed in a transaction,"
    } ]
  }, {
    "tStartMs": 921600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and it's stored in memory cells"
    } ]
  }, {
    "tStartMs": 923200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "buried deep within the chip silicon."
    } ]
  }, {
    "tStartMs": 926160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Now, to extract the secret key,"
    } ]
  }, {
    "tStartMs": 927680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "you'd have to pry open the card,"
    } ]
  }, {
    "tStartMs": 929760,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "strip away layers of silicon,"
    } ]
  }, {
    "tStartMs": 931280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and then overcome multiple countermeasures"
    } ]
  }, {
    "tStartMs": 933200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "designed to destroy the data\nif tampering is detected."
    } ]
  }, {
    "tStartMs": 936160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It is theoretically possible,"
    } ]
  }, {
    "tStartMs": 937600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but it would take days of work,"
    } ]
  }, {
    "tStartMs": 939120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "hundreds of thousands of\ndollars of specialist equipment,"
    } ]
  }, {
    "tStartMs": 942000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "so it's not really practical,"
    } ]
  }, {
    "tStartMs": 943840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "unless, of course, you get your hands"
    } ]
  }, {
    "tStartMs": 945040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "on a billionaire's credit card."
    } ]
  }, {
    "tStartMs": 946880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "With the move from the\nmag stripe to the chip,"
    } ]
  }, {
    "tStartMs": 948960,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the easiest way to commit\nfraud was just to steal a card."
    } ]
  }, {
    "tStartMs": 952160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "That's why banks paired each\nchip with a four-digit pin,"
    } ]
  }, {
    "tStartMs": 955200,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "known only to the card holder."
    } ]
  }, {
    "tStartMs": 956560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "- But stealing PIN numbers\nis not very difficult,"
    } ]
  }, {
    "tStartMs": 960880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and there are multiple\nways in which a PIN number"
    } ]
  }, {
    "tStartMs": 963360,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "could be stolen from you"
    } ]
  }, {
    "tStartMs": 964400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "before your card was then compromised."
    } ]
  }, {
    "tStartMs": 966800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Over the shoulder at the ATM,"
    } ]
  }, {
    "tStartMs": 968640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "with a hidden camera at the ATM,"
    } ]
  }, {
    "tStartMs": 971120,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "all these types of different things."
    } ]
  }, {
    "tStartMs": 972630,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Henry] It's not that hard,"
    } ]
  }, {
    "tStartMs": 973680,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "but it's much harder than\njust forging a signature."
    } ]
  }, {
    "tStartMs": 975880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- When chip and pin comes in,"
    } ]
  }, {
    "tStartMs": 977920,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "our business is dead in the water."
    } ]
  }, {
    "tStartMs": 980800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But then it weren't"
    } ]
  }, {
    "tStartMs": 982480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "because America didn't\nadopt it till much later,"
    } ]
  }, {
    "tStartMs": 985280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "so now we can sell them in the States."
    } ]
  }, {
    "tStartMs": 987280,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "- Chip and pin was\nintroduced in the UK in 2003,"
    } ]
  }, {
    "tStartMs": 990560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and over the next seven years,"
    } ]
  }, {
    "tStartMs": 992160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "counterfeit fraud in the UK fell by 63%,"
    } ]
  }, {
    "tStartMs": 995280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "leading to a 27% decline in fraud overall."
    } ]
  }, {
    "tStartMs": 998800,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "But over the same period, US\ncard fraud increased by 70%."
    } ]
  }, {
    "tStartMs": 1004000,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It took until 2013 for\na huge wake-up call."
    } ]
  }, {
    "tStartMs": 1007520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Criminals stole 40 million card numbers"
    } ]
  }, {
    "tStartMs": 1010000,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "from the superstore chain Target."
    } ]
  }, {
    "tStartMs": 1012080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "They used the details\nto create cloned cards,"
    } ]
  }, {
    "tStartMs": 1014800,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "which they then swiped around the country."
    } ]
  }, {
    "tStartMs": 1017120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Finally, the US began to recognize"
    } ]
  }, {
    "tStartMs": 1019280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the need to shift to chip and pin."
    } ]
  }, {
    "tStartMs": 1021600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And as EMV chip cards were\nrolled out more widely"
    } ]
  }, {
    "tStartMs": 1024320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "over the next few years,"
    } ]
  }, {
    "tStartMs": 1025520,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "counterfeit fraud dropped by 76%."
    } ]
  }, {
    "tStartMs": 1029440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But the improved security came at a price."
    } ]
  }, {
    "tStartMs": 1031520,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The time it took to do a\ntransaction more than doubled,"
    } ]
  }, {
    "tStartMs": 1034560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "adding on average around 10\nseconds onto each transaction."
    } ]
  }, {
    "tStartMs": 1038000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "That may not sound like much,"
    } ]
  }, {
    "tStartMs": 1039360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but if you consider all the transactions"
    } ]
  }, {
    "tStartMs": 1041120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "taking place across the country,"
    } ]
  }, {
    "tStartMs": 1042560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "it soon adds up."
    } ]
  }, {
    "tStartMs": 1044080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "In the US, it's been\nestimated that chip and pin"
    } ]
  }, {
    "tStartMs": 1046240,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "added about 116 million hours every year"
    } ]
  }, {
    "tStartMs": 1049920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "waiting at cash registers."
    } ]
  }, {
    "tStartMs": 1051760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That's why businesses care so much"
    } ]
  }, {
    "tStartMs": 1053440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "about the tiniest bit\nof friction to spending."
    } ]
  }, {
    "tStartMs": 1056160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "For example, it's been found"
    } ]
  }, {
    "tStartMs": 1057360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that one-click checkouts online"
    } ]
  }, {
    "tStartMs": 1058960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "can increase spending by almost 30%."
    } ]
  }, {
    "tStartMs": 1062560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So now the banks switched their attention"
    } ]
  }, {
    "tStartMs": 1064320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "from security back to speed."
    } ]
  }, {
    "tStartMs": 1066800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And they began to wonder."
    } ]
  }, {
    "tStartMs": 1068320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "What if you could take a second\noff of every transaction?"
    } ]
  }, {
    "tStartMs": 1070880,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "What about two?"
    } ]
  }, {
    "tStartMs": 1072160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What if you could make each transaction"
    } ]
  }, {
    "tStartMs": 1074160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "basically instant without\nhaving to make contact at all?"
    } ]
  }, {
    "tStartMs": 1077360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Well, that would require sending\na signal across a distance"
    } ]
  }, {
    "tStartMs": 1079840,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "and then getting back a\nreply at the speed of light."
    } ]
  }, {
    "tStartMs": 1082200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- Kind of like the Soviets\ndid with 'The Thing',"
    } ]
  }, {
    "tStartMs": 1085200,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "which brings us back to\nthe CIA in the 1950s."
    } ]
  }, {
    "tStartMs": 1088480,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "While reverse engineering\nthe Soviet device,"
    } ]
  }, {
    "tStartMs": 1091040,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "the Americans realized its\ndesign had one major flaw."
    } ]
  }, {
    "tStartMs": 1094600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- The main issue with it"
    } ]
  }, {
    "tStartMs": 1096480,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "is that it is so\nhypersensitive to disturbance,"
    } ]
  }, {
    "tStartMs": 1100560,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "they would have to retune"
    } ]
  }, {
    "tStartMs": 1101840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and recalibrate every\ntime the room temperature"
    } ]
  }, {
    "tStartMs": 1104800,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "changed drastically or\nsomebody slammed a door."
    } ]
  }, {
    "tStartMs": 1107080,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- The device is tuned to work"
    } ]
  }, {
    "tStartMs": 1108960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "over a small range of frequencies."
    } ]
  }, {
    "tStartMs": 1110880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "If the transmission signal"
    } ]
  }, {
    "tStartMs": 1112080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "is too close to the resonant frequency,"
    } ]
  }, {
    "tStartMs": 1113920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the change in amplitude"
    } ]
  }, {
    "tStartMs": 1115120,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "due to the movement of the\ndiaphragm is too small to detect."
    } ]
  }, {
    "tStartMs": 1118400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The same is true if it's too far away"
    } ]
  }, {
    "tStartMs": 1120400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "from the resonant frequency."
    } ]
  }, {
    "tStartMs": 1122000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Therefore, you only get enough sensitivity"
    } ]
  }, {
    "tStartMs": 1124240,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "in this tiny region,"
    } ]
  }, {
    "tStartMs": 1125520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "either side of the resonant frequency."
    } ]
  }, {
    "tStartMs": 1128400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So the Americans set about\ncreating something more robust,"
    } ]
  }, {
    "tStartMs": 1131840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "something that wasn't so reliant"
    } ]
  }, {
    "tStartMs": 1133440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "on this ultra-precise frequency."
    } ]
  }, {
    "tStartMs": 1135520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And to do that, they stopped\nthinking about radio waves"
    } ]
  }, {
    "tStartMs": 1138480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "as something they could modify with sound,"
    } ]
  }, {
    "tStartMs": 1140640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and instead, they started\nthinking of radio waves"
    } ]
  }, {
    "tStartMs": 1143440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "as a source of power."
    } ]
  }, {
    "tStartMs": 1145520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So inside the device,\nthey added a rectifier,"
    } ]
  }, {
    "tStartMs": 1148160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "which converted the alternating current"
    } ]
  }, {
    "tStartMs": 1149920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from the antenna into a direct current."
    } ]
  }, {
    "tStartMs": 1152320,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "- And they used that to\npower a hearing aid amplifier"
    } ]
  }, {
    "tStartMs": 1156960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "with a tiny little microphone."
    } ]
  }, {
    "tStartMs": 1158560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Derek] This amplified microphone output"
    } ]
  }, {
    "tStartMs": 1160720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "was sent back to the antenna,"
    } ]
  }, {
    "tStartMs": 1162480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "which created a modulated return signal"
    } ]
  }, {
    "tStartMs": 1164560,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "that was sent out and could be picked up."
    } ]
  }, {
    "tStartMs": 1166680,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- That microphone and the antenna"
    } ]
  }, {
    "tStartMs": 1169920,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and everything else was hidden\ninside pieces of furniture."
    } ]
  }, {
    "tStartMs": 1173840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "They tried it inside the hollow legs,"
    } ]
  }, {
    "tStartMs": 1176000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they actually drilled holes lengthwise"
    } ]
  }, {
    "tStartMs": 1177920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "through the legs of the furniture."
    } ]
  }, {
    "tStartMs": 1179920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "They compromised a furniture\nfactory to be able to do this,"
    } ]
  }, {
    "tStartMs": 1183600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "a stunning piece of work that one was."
    } ]
  }, {
    "tStartMs": 1185600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- [Derek] This became known\nas Project Easy Chair,"
    } ]
  }, {
    "tStartMs": 1188640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and the CIA used it to\nget back at the Soviets"
    } ]
  }, {
    "tStartMs": 1191280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "by planting their own listening device"
    } ]
  }, {
    "tStartMs": 1193040,
    "dDurationMs": 4866,
    "segs": [ {
      "utf8": "in the Soviet embassy in the Hague."
    } ]
  }, {
    "tStartMs": 1197906,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(horn honking)"
    } ]
  }, {
    "tStartMs": 1197920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "It wasn't until the 1970s\nwhen a former rocket engineer,"
    } ]
  }, {
    "tStartMs": 1201120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Mario Cardullo, gave this\ntechnology a modern twist"
    } ]
  }, {
    "tStartMs": 1204160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to solve a problem involving toll booths."
    } ]
  }, {
    "tStartMs": 1206800,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Throughout the States,"
    } ]
  }, {
    "tStartMs": 1207760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "cars had been queuing to pay for years."
    } ]
  }, {
    "tStartMs": 1210400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "To speed up the process\nand reduce queue times,"
    } ]
  }, {
    "tStartMs": 1212960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Cardullo invented a small\ntag that could be used"
    } ]
  }, {
    "tStartMs": 1215520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to identify a vehicle remotely."
    } ]
  }, {
    "tStartMs": 1218080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The tag had two key components,"
    } ]
  }, {
    "tStartMs": 1220320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "a coil of wire to act as\nthe antenna, and a chip."
    } ]
  }, {
    "tStartMs": 1223920,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Like the bugs, the antenna\nreceives a radio wave"
    } ]
  }, {
    "tStartMs": 1226640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "as it passes through the toll booth."
    } ]
  }, {
    "tStartMs": 1228480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "That creates alternating current,"
    } ]
  }, {
    "tStartMs": 1230080,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "which passes through a\ndiode to power the chip."
    } ]
  }, {
    "tStartMs": 1232560,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The chip then flips a series\nof transistors on and off,"
    } ]
  }, {
    "tStartMs": 1235440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "which subtly alters the\ncurrent in the antenna."
    } ]
  }, {
    "tStartMs": 1238160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "This modulates the radio wave,"
    } ]
  }, {
    "tStartMs": 1240000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "encoding the ID number of the card,"
    } ]
  }, {
    "tStartMs": 1242240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "which the antenna sends back\nto a reader in the toll booth."
    } ]
  }, {
    "tStartMs": 1245600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So the process is almost identical"
    } ]
  }, {
    "tStartMs": 1247680,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to the Cold War spying devices,"
    } ]
  }, {
    "tStartMs": 1249920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "but whereas they relied on\nsound to modulate the wave,"
    } ]
  }, {
    "tStartMs": 1252880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "here it's a tiny circuit inside the chip."
    } ]
  }, {
    "tStartMs": 1256000,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "This technology is called\nradio frequency identification,"
    } ]
  }, {
    "tStartMs": 1259040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "or RFID for short."
    } ]
  }, {
    "tStartMs": 1260960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And today, it's used in toll\nbooths, clothing stores,"
    } ]
  }, {
    "tStartMs": 1263760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and warehouses all over the world."
    } ]
  }, {
    "tStartMs": 1266960,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "(device beeps)"
    } ]
  }, {
    "tStartMs": 1267590,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "- And also, your credit card."
    } ]
  }, {
    "tStartMs": 1269280,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "This is a credit card"
    } ]
  }, {
    "tStartMs": 1270160,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that we're gonna go try to buy lunch with."
    } ]
  }, {
    "tStartMs": 1271920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You guys take tap?\n- Yeah."
    } ]
  }, {
    "tStartMs": 1274920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- This is a credit card."
    } ]
  }, {
    "tStartMs": 1276520,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- Yeah, yeah."
    } ]
  }, {
    "tStartMs": 1277440,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- And we're gonna see if it works."
    } ]
  }, {
    "tStartMs": 1278840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- Okay, yeah.\n- Where do I put it?"
    } ]
  }, {
    "tStartMs": 1280680,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- Don't lose it.\n- That's pretty cool, eh?"
    } ]
  }, {
    "tStartMs": 1284160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I ran it through the wash."
    } ]
  }, {
    "tStartMs": 1286400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But there is one more important difference"
    } ]
  }, {
    "tStartMs": 1288320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "in the way credit cards work."
    } ]
  }, {
    "tStartMs": 1289760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "See, some of these other RFID devices"
    } ]
  }, {
    "tStartMs": 1291920,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "function over ranges of 10 meters or more."
    } ]
  }, {
    "tStartMs": 1294640,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "But for a credit card,"
    } ]
  }, {
    "tStartMs": 1295600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that's just not how you want it to work."
    } ]
  }, {
    "tStartMs": 1297200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "You don't wanna accidentally\ntrigger a transaction"
    } ]
  }, {
    "tStartMs": 1299040,
    "dDurationMs": 2306,
    "segs": [ {
      "utf8": "from meters away."
    } ]
  }, {
    "tStartMs": 1301346,
    "dDurationMs": 1774,
    "segs": [ {
      "utf8": "(device beeps)\nSo the card providers had to find a way"
    } ]
  }, {
    "tStartMs": 1303120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to shorten the range."
    } ]
  }, {
    "tStartMs": 1304480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The solution was to stop\nrelying on radio waves,"
    } ]
  }, {
    "tStartMs": 1307280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and instead to rely on magnetic fields."
    } ]
  }, {
    "tStartMs": 1310320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Inside a card reader is a small coil."
    } ]
  }, {
    "tStartMs": 1313200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "When you pass an alternating\ncurrent through this coil,"
    } ]
  }, {
    "tStartMs": 1315520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "it creates a changing magnetic field."
    } ]
  }, {
    "tStartMs": 1317600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Then if you move your\ncredit card close enough"
    } ]
  }, {
    "tStartMs": 1319520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "so that the changing magnetic field"
    } ]
  }, {
    "tStartMs": 1321280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "cuts through the card's antenna,"
    } ]
  }, {
    "tStartMs": 1323120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "well, it induces an alternating\ncurrent in the antenna."
    } ]
  }, {
    "tStartMs": 1326160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And you can see this in action"
    } ]
  }, {
    "tStartMs": 1327360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "using a special chip with an LED."
    } ]
  }, {
    "tStartMs": 1329600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This is one of those chips."
    } ]
  }, {
    "tStartMs": 1331520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "What's very interesting is, like,"
    } ]
  }, {
    "tStartMs": 1332880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that these chips don't have batteries in them."
    } ]
  }, {
    "tStartMs": 1335520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "If I come in with the reader,"
    } ]
  }, {
    "tStartMs": 1336800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "if you watch really closely,"
    } ]
  }, {
    "tStartMs": 1338000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "you'll see it'll start to light up."
    } ]
  }, {
    "tStartMs": 1340480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Yeah, there you go."
    } ]
  }, {
    "tStartMs": 1342320,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "See?"
    } ]
  }, {
    "tStartMs": 1343680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Yeah, so that's showing that all the power"
    } ]
  }, {
    "tStartMs": 1345120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is coming from the reader."
    } ]
  }, {
    "tStartMs": 1347920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That current passes through a diode"
    } ]
  }, {
    "tStartMs": 1349680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to power the card's chip."
    } ]
  }, {
    "tStartMs": 1351040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The chip then alters the\ncurrent in its antenna."
    } ]
  }, {
    "tStartMs": 1353200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "This modulates the magnetic\nfield around the antenna,"
    } ]
  }, {
    "tStartMs": 1355680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which the coil in the reader detects."
    } ]
  }, {
    "tStartMs": 1357680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That modulated signal\ncarries the unique code"
    } ]
  }, {
    "tStartMs": 1360320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "for that transaction,"
    } ]
  }, {
    "tStartMs": 1361440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which the reader then sends onto the bank."
    } ]
  }, {
    "tStartMs": 1363600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Cryptographically, this\nworks just like chip and pin."
    } ]
  }, {
    "tStartMs": 1366400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Except now, instead of\nusing metal contacts,"
    } ]
  }, {
    "tStartMs": 1368560,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "the chip and reader"
    } ]
  }, {
    "tStartMs": 1369520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "communicate through a\nshared magnetic field."
    } ]
  }, {
    "tStartMs": 1372880,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "This technology is called\nnear-field communication, or NFC,"
    } ]
  }, {
    "tStartMs": 1376400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and it's what powers all\ncontactless credit cards today."
    } ]
  }, {
    "tStartMs": 1379200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The first contactless payment cards"
    } ]
  }, {
    "tStartMs": 1380880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "were launched in the mid-2000s,"
    } ]
  }, {
    "tStartMs": 1382560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "around the same time as chip and pin,"
    } ]
  }, {
    "tStartMs": 1384480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but contactless took\nmuch longer to catch on,"
    } ]
  }, {
    "tStartMs": 1386960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "particularly in the United States."
    } ]
  }, {
    "tStartMs": 1389120,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Customers were cautious,"
    } ]
  }, {
    "tStartMs": 1390400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and banks were waiting\nfor enough retailers"
    } ]
  }, {
    "tStartMs": 1392160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to get the right card readers,"
    } ]
  }, {
    "tStartMs": 1393600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "while retailers were\nwaiting for enough customers"
    } ]
  }, {
    "tStartMs": 1395520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to get the contactless\ncards from the banks."
    } ]
  }, {
    "tStartMs": 1398480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That all changed in 2020."
    } ]
  }, {
    "tStartMs": 1400400,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Suddenly, touching keypads"
    } ]
  }, {
    "tStartMs": 1401760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and handing over cards felt risky."
    } ]
  }, {
    "tStartMs": 1403840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And tap to pay meant"
    } ]
  }, {
    "tStartMs": 1404960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "you could avoid physical\ncontact altogether."
    } ]
  }, {
    "tStartMs": 1407520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So in the first three months of 2020,"
    } ]
  }, {
    "tStartMs": 1409520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "global contactless\ntransactions grew by over 40%."
    } ]
  }, {
    "tStartMs": 1413360,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And over that same year,"
    } ]
  }, {
    "tStartMs": 1414480,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "contactless payments\nin the US grew by 150%."
    } ]
  }, {
    "tStartMs": 1417720,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "- And so, along comes contactless."
    } ]
  }, {
    "tStartMs": 1421280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And the first thing that struck me was,"
    } ]
  }, {
    "tStartMs": 1424160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "what if you could read a contactless card"
    } ]
  }, {
    "tStartMs": 1427520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "through somebody's pocket?"
    } ]
  }, {
    "tStartMs": 1428800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- This is a Flipper Zero."
    } ]
  }, {
    "tStartMs": 1430720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "One thing it does is has\nan NFC reader in there."
    } ]
  }, {
    "tStartMs": 1433040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Okay.\n- So we're just gonna put"
    } ]
  }, {
    "tStartMs": 1434960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "a little read, do a little tap,"
    } ]
  }, {
    "tStartMs": 1437200,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "and then you get the\ncredit card information."
    } ]
  }, {
    "tStartMs": 1439588,
    "dDurationMs": 2642,
    "segs": [ {
      "utf8": "- [Marques] It pulled the\ncard number, the expiration."
    } ]
  }, {
    "tStartMs": 1442230,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "- [Henry] So this seems\nkinda crazy, right?"
    } ]
  }, {
    "tStartMs": 1443360,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "That you can just go up and tap"
    } ]
  }, {
    "tStartMs": 1444160,
    "dDurationMs": 2468,
    "segs": [ {
      "utf8": "and get any information\nabout any card that simply."
    } ]
  }, {
    "tStartMs": 1446628,
    "dDurationMs": 932,
    "segs": [ {
      "utf8": "- [Marques] That was pretty quick, yeah."
    } ]
  }, {
    "tStartMs": 1447560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- But the same thing can be done"
    } ]
  }, {
    "tStartMs": 1449600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "with any old land NFC cable device."
    } ]
  }, {
    "tStartMs": 1452560,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Like, I have a credit card\nreader app right here."
    } ]
  }, {
    "tStartMs": 1456400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And"
    } ]
  }, {
    "tStartMs": 1459040,
    "dDurationMs": 1188,
    "segs": [ {
      "utf8": "so there you go."
    } ]
  }, {
    "tStartMs": 1460228,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "- [Marques] It's the same\ncard number right there."
    } ]
  }, {
    "tStartMs": 1462040,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- But in terms of credit card fraud,"
    } ]
  }, {
    "tStartMs": 1464080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that's actually a lot less\nuseful than you might think."
    } ]
  }, {
    "tStartMs": 1466240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The chip secret key is never revealed"
    } ]
  }, {
    "tStartMs": 1468080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "in any sort of communication,"
    } ]
  }, {
    "tStartMs": 1469360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and without that, you\ncan't clone the card."
    } ]
  }, {
    "tStartMs": 1471440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Now, you might think\nto use the card details"
    } ]
  }, {
    "tStartMs": 1473120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "in an online transaction, but\nfor that, you need the CVV,"
    } ]
  }, {
    "tStartMs": 1476640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "three-digit code that's not\nstored on the chip itself."
    } ]
  }, {
    "tStartMs": 1479280,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "It's actually only written"
    } ]
  }, {
    "tStartMs": 1480240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "on the back of the card physically."
    } ]
  }, {
    "tStartMs": 1482080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So if you wanna read that number,"
    } ]
  }, {
    "tStartMs": 1483520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "you're gonna have to find a way"
    } ]
  }, {
    "tStartMs": 1484880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to socially engineer that\nnumber out of someone."
    } ]
  }, {
    "tStartMs": 1487440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "- But the truth is that\nif I can clone a card"
    } ]
  }, {
    "tStartMs": 1490720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "by getting close to it,"
    } ]
  }, {
    "tStartMs": 1492400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "then I can almost certainly\nvideo that card as well."
    } ]
  }, {
    "tStartMs": 1495040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I take a photograph of that card."
    } ]
  }, {
    "tStartMs": 1497040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "That three-digit number on\nthe back is on the back."
    } ]
  }, {
    "tStartMs": 1499840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So if I can get access\nto the card to clone it,"
    } ]
  }, {
    "tStartMs": 1502320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "all I gotta do is add the extra step"
    } ]
  }, {
    "tStartMs": 1504000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to get access to the card to see it."
    } ]
  }, {
    "tStartMs": 1506040,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- But there's an even easier way"
    } ]
  }, {
    "tStartMs": 1507760,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "to commit contactless fraud."
    } ]
  }, {
    "tStartMs": 1516560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This is called digital\npickpocketing or ghost tapping,"
    } ]
  }, {
    "tStartMs": 1519360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and when I tried it, I found you had to be"
    } ]
  }, {
    "tStartMs": 1520960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "within about two centimeters\nof the victim's pocket."
    } ]
  }, {
    "tStartMs": 1523920,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "But in most countries,"
    } ]
  }, {
    "tStartMs": 1525040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "contactless transactions\nhave an upper limit,"
    } ]
  }, {
    "tStartMs": 1527360,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "so you can only lose so much\nin a single transaction."
    } ]
  }, {
    "tStartMs": 1531520,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "In the UK, that's grown\nover time to 100 pounds."
    } ]
  }, {
    "tStartMs": 1534200,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "- But what if you could\ndo it thousands of times?"
    } ]
  }, {
    "tStartMs": 1537830,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "- [Henry] That's exactly\nwhat a 36-year-old woman"
    } ]
  }, {
    "tStartMs": 1540000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "thought in Italy in 2025."
    } ]
  }, {
    "tStartMs": 1542160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "She was arrested after tapping money"
    } ]
  }, {
    "tStartMs": 1543840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "from unknowing tourists in\nthe busy streets of Rome."
    } ]
  }, {
    "tStartMs": 1547120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And crowded places like\nthis could be vulnerable"
    } ]
  }, {
    "tStartMs": 1549200,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "to even more sophisticated scams."
    } ]
  }, {
    "tStartMs": 1551160,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "- So what if you were to\nput a contactless reader"
    } ]
  }, {
    "tStartMs": 1554560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "into a public space, like, for example,"
    } ]
  }, {
    "tStartMs": 1556880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "between the walkway where you\ngo through into the subway"
    } ]
  }, {
    "tStartMs": 1559840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "or the underground, right?"
    } ]
  }, {
    "tStartMs": 1560960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "You have to go through a narrow space."
    } ]
  }, {
    "tStartMs": 1562400,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "What if I could hide a reader in there?"
    } ]
  }, {
    "tStartMs": 1563880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Or if enough people have cards"
    } ]
  }, {
    "tStartMs": 1565600,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "in a pocket at the right position,"
    } ]
  }, {
    "tStartMs": 1567120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I could maybe read hundreds\nor thousands of cards a day."
    } ]
  }, {
    "tStartMs": 1570240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- [Henry] And while\nmost countries do limit"
    } ]
  }, {
    "tStartMs": 1572080,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "the amount you can pay in a\nsingle tap, the US doesn't."
    } ]
  }, {
    "tStartMs": 1575760,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "So in a single tap, you could\nlose thousands of dollars."
    } ]
  }, {
    "tStartMs": 1580480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "One way to protect against\ndigital pick pockets"
    } ]
  }, {
    "tStartMs": 1582640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "is keeping your cards in\na Faraday cage wallet,"
    } ]
  }, {
    "tStartMs": 1585120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or having multiple\ncards next to each other"
    } ]
  }, {
    "tStartMs": 1587280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "also makes each individual\ncard a lot harder to read."
    } ]
  }, {
    "tStartMs": 1590160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "But of course, that's not\nmuch use if you lose your card"
    } ]
  }, {
    "tStartMs": 1592480,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "or it gets stolen."
    } ]
  }, {
    "tStartMs": 1593600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- What happens when you make a payment?"
    } ]
  }, {
    "tStartMs": 1596000,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Do you get a notification on your phone?"
    } ]
  }, {
    "tStartMs": 1598080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Does the bank tell you?"
    } ]
  }, {
    "tStartMs": 1599600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "'Cause the banks will offer that service,"
    } ]
  }, {
    "tStartMs": 1601680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and you should do it."
    } ]
  }, {
    "tStartMs": 1603040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And I think if everybody watching this,"
    } ]
  }, {
    "tStartMs": 1604720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I watch, you know, I watch Veritasium,"
    } ]
  }, {
    "tStartMs": 1606640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "by the way, I'm a fan, I like them a lot."
    } ]
  }, {
    "tStartMs": 1609120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "With the millions of people\nyou have watching it,"
    } ]
  }, {
    "tStartMs": 1610720,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "if you can get half of those people"
    } ]
  }, {
    "tStartMs": 1612000,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "just to go onto their phone\napp and put notifications on."
    } ]
  }, {
    "tStartMs": 1615280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "If you do that,"
    } ]
  }, {
    "tStartMs": 1617040,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "you will have the biggest\nimpact on vulnerability"
    } ]
  }, {
    "tStartMs": 1622160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "when it comes to contactless\npayment than anybody."
    } ]
  }, {
    "tStartMs": 1624880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- With notifications on,"
    } ]
  }, {
    "tStartMs": 1626400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "you can contact your bank as soon"
    } ]
  }, {
    "tStartMs": 1627920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "as you spot a suspicious payment."
    } ]
  }, {
    "tStartMs": 1630240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But why not go one step further"
    } ]
  }, {
    "tStartMs": 1631920,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and transfer all your cards"
    } ]
  }, {
    "tStartMs": 1633200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to the mobile wallet on your phone?"
    } ]
  }, {
    "tStartMs": 1635520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There, your real card\nnumbers aren't stored,"
    } ]
  }, {
    "tStartMs": 1637520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "so they can't be stolen."
    } ]
  }, {
    "tStartMs": 1639040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And even if you lose your\nphone, your card is safe,"
    } ]
  }, {
    "tStartMs": 1641360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "protected by fingerprint\nor facial recognition."
    } ]
  }, {
    "tStartMs": 1643760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "It seems like the mobile phone"
    } ]
  }, {
    "tStartMs": 1645360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "is the perfect blend\nof speed and security."
    } ]
  }, {
    "tStartMs": 1648960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But the thing is, tap to pay has evolved"
    } ]
  }, {
    "tStartMs": 1651440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "far beyond its original design."
    } ]
  }, {
    "tStartMs": 1653600,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Over the last 20 years, new\nfeatures have been added,"
    } ]
  }, {
    "tStartMs": 1656080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "some for security, others for convenience,"
    } ]
  }, {
    "tStartMs": 1658880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and that convenience comes at a cost."
    } ]
  }, {
    "tStartMs": 1662640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Coming soon to Veritasium."
    } ]
  }, {
    "tStartMs": 1664400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I'm here with MKBHD,"
    } ]
  }, {
    "tStartMs": 1665600,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and we're gonna try to steal\n$10,000 from his locked iPhone."
    } ]
  }, {
    "tStartMs": 1669040,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "- Really hope it doesn't work."
    } ]
  }, {
    "tStartMs": 1670160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I really hope it doesn't work."
    } ]
  }, {
    "tStartMs": 1671360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- I'm gonna get you to put that phone down"
    } ]
  }, {
    "tStartMs": 1673040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "on top of this device."
    } ]
  }, {
    "tStartMs": 1674240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This is just a regular payment terminal."
    } ]
  }, {
    "tStartMs": 1675920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Nothing weird about that."
    } ]
  }, {
    "tStartMs": 1677440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "- Careful."
    } ]
  }, {
    "tStartMs": 1678480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Careful with that, careful, careful."
    } ]
  }, {
    "tStartMs": 1680800,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "That's a lot of zeros."
    } ]
  }, {
    "tStartMs": 1682080,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Careful with that."
    } ]
  }, {
    "tStartMs": 1683040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Oh my God, okay."
    } ]
  }, {
    "tStartMs": 1684240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- Do you even think it's\npossible, firstly, $10,000?"
    } ]
  }, {
    "tStartMs": 1687040,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "- I don't know if Apple\nPay will let you do that."
    } ]
  }, {
    "tStartMs": 1691160,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- Let's see, let's see if it works,"
    } ]
  }, {
    "tStartMs": 1692560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I feel like I'm a bit of a magician,"
    } ]
  }, {
    "tStartMs": 1693760,
    "dDurationMs": 1748,
    "segs": [ {
      "utf8": "but I'm like, I haven't\nchanged anything, right?"
    } ]
  }, {
    "tStartMs": 1695508,
    "dDurationMs": 732,
    "segs": [ {
      "utf8": "- [Marques] Okay, yeah."
    } ]
  }, {
    "tStartMs": 1696240,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- It's still locked.\n- It's locked."
    } ]
  }, {
    "tStartMs": 1698070,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "- [Henry] Nothing else."
    } ]
  }, {
    "tStartMs": 1698640,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Yeah.\n- Okay."
    } ]
  }, {
    "tStartMs": 1699600,
    "dDurationMs": 8039,
    "segs": [ {
      "utf8": "We're gonna start the script again."
    } ]
  }, {
    "tStartMs": 1707639,
    "dDurationMs": 29,
    "segs": [ {
      "utf8": "(dramatic music)\n(phone beeps)"
    } ]
  }, {
    "tStartMs": 1707668,
    "dDurationMs": 3372,
    "segs": [ {
      "utf8": "- [Marques] What just\nhappened on my phone?"
    } ]
  }, {
    "tStartMs": 1711040,
    "dDurationMs": 839,
    "segs": [ {
      "utf8": "(Henry laughs)"
    } ]
  } ]
}
