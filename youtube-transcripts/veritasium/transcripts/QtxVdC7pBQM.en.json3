{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 115,
    "dDurationMs": 3325,
    "segs": [ {
      "utf8": "- This is one of the most\npowerful jet engines in the world,"
    } ]
  }, {
    "tStartMs": 3440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "and it actually runs"
    } ]
  }, {
    "tStartMs": 4480,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "at temperatures 250 degrees Celsius hotter"
    } ]
  }, {
    "tStartMs": 7520,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "than the melting point of the\nmaterials that make it up."
    } ]
  }, {
    "tStartMs": 9986,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "- [Assistant] That's 1,200 degrees."
    } ]
  }, {
    "tStartMs": 11278,
    "dDurationMs": 3362,
    "segs": [ {
      "utf8": "- So the question is,\nwhy doesn't a jet engine"
    } ]
  }, {
    "tStartMs": 14640,
    "dDurationMs": 2304,
    "segs": [ {
      "utf8": "just melt into a puddle?\n(intense music)"
    } ]
  }, {
    "tStartMs": 16944,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(jet hovering)"
    } ]
  }, {
    "tStartMs": 16958,
    "dDurationMs": 4465,
    "segs": [ {
      "utf8": "- We are right at the boundaries\nof the laws of physics"
    } ]
  }, {
    "tStartMs": 21423,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 21438,
    "dDurationMs": 882,
    "segs": [ {
      "utf8": "- That is wild."
    } ]
  }, {
    "tStartMs": 22320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's at the same temperature\nnow as it would be inside"
    } ]
  }, {
    "tStartMs": 25200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "the jet engine."
    } ]
  }, {
    "tStartMs": 26640,
    "dDurationMs": 2062,
    "segs": [ {
      "utf8": "But here, they're liquid.\n(dramatic music)"
    } ]
  }, {
    "tStartMs": 28702,
    "dDurationMs": 1218,
    "segs": [ {
      "utf8": "- Every time I get on a plane,"
    } ]
  }, {
    "tStartMs": 29920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "I'm thinking, \"This is never gonna work.\""
    } ]
  }, {
    "tStartMs": 31440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- And yet, it does work."
    } ]
  }, {
    "tStartMs": 33440,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Right now, there are over\n10,000 planes in the sky powered"
    } ]
  }, {
    "tStartMs": 37200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "by engines just like these."
    } ]
  }, {
    "tStartMs": 39200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Maybe you are on one right now."
    } ]
  }, {
    "tStartMs": 41680,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So, how do they work?"
    } ]
  }, {
    "tStartMs": 45490,
    "dDurationMs": 30,
    "segs": [ {
      "utf8": "(energetic music)\n(jet humming)"
    } ]
  }, {
    "tStartMs": 45520,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "This is a jet engine,\nspecifically a turbofan engine."
    } ]
  }, {
    "tStartMs": 49040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "At the front is this giant fan."
    } ]
  }, {
    "tStartMs": 51520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "During takeoff, these\nrotating blades push 1.3 tons"
    } ]
  }, {
    "tStartMs": 55360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "of air backwards every second,"
    } ]
  }, {
    "tStartMs": 57600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and around 10% of that\nair gets compressed."
    } ]
  }, {
    "tStartMs": 60640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The compressors force the air"
    } ]
  }, {
    "tStartMs": 62240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "into increasingly narrow chambers."
    } ]
  }, {
    "tStartMs": 64320,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "They compress the air"
    } ]
  }, {
    "tStartMs": 65360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "to about 50 times atmospheric pressure."
    } ]
  }, {
    "tStartMs": 68400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And just by doing that, the air heats up"
    } ]
  }, {
    "tStartMs": 70880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to around 600 degrees Celsius."
    } ]
  }, {
    "tStartMs": 73520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "This compressed air is then forced"
    } ]
  }, {
    "tStartMs": 75360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "into the combustion chamber,"
    } ]
  }, {
    "tStartMs": 76800,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "where fuel is sprayed in\nthrough a ring of nozzles"
    } ]
  }, {
    "tStartMs": 79760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and ignited.\n(flames blasting)"
    } ]
  }, {
    "tStartMs": 81360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That chemical reaction\ngives off a lot of heat."
    } ]
  }, {
    "tStartMs": 84000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So the temperature jumps to\naround 1,500 degrees Celsius."
    } ]
  }, {
    "tStartMs": 88000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So now you've got this\nhigh-pressure gas from the combustor"
    } ]
  }, {
    "tStartMs": 90720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that just wants to expand,"
    } ]
  }, {
    "tStartMs": 92560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and now it's got an incredible\namount of thermal energy."
    } ]
  }, {
    "tStartMs": 96080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "But between the combustion chamber"
    } ]
  }, {
    "tStartMs": 97360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and the outside air is this.\n(intense music)"
    } ]
  }, {
    "tStartMs": 100560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Rows of turbine blades.\n(blades humming)"
    } ]
  }, {
    "tStartMs": 102640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So, in order for the gas\nto expand and get out,"
    } ]
  }, {
    "tStartMs": 104880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it needs to push these\nturbine blades out of the way."
    } ]
  }, {
    "tStartMs": 107760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And in pushing the blades, that is"
    } ]
  }, {
    "tStartMs": 109840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "how it transfers its energy to the engine."
    } ]
  }, {
    "tStartMs": 112720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This is where all the\npower really comes from"
    } ]
  }, {
    "tStartMs": 115520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in modern jets on takeoff,"
    } ]
  }, {
    "tStartMs": 117440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "each high-pressure turbine blade\nis generating as much power"
    } ]
  }, {
    "tStartMs": 120320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "as a Formula 1 car.\n(car droning)"
    } ]
  }, {
    "tStartMs": 122400,
    "dDurationMs": 2386,
    "segs": [ {
      "utf8": "And there are 68 of them."
    } ]
  }, {
    "tStartMs": 124786,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(lively music)"
    } ]
  }, {
    "tStartMs": 124800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "As the gas rushes through\nthe turbine and nozzle,"
    } ]
  }, {
    "tStartMs": 127040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "its pressure drops from around\n50 atmospheres down to one,"
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and it expands by almost 20 times."
    } ]
  }, {
    "tStartMs": 132800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And that spins these turbine blades up"
    } ]
  }, {
    "tStartMs": 134800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to 12,500 revolutions per minute."
    } ]
  }, {
    "tStartMs": 138160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The fan that is pushing\nall that air backward"
    } ]
  }, {
    "tStartMs": 140160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and all those compressors\nthat squeeze the air down,"
    } ]
  }, {
    "tStartMs": 142640,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "all of that is powered by\nthe turbines back here."
    } ]
  }, {
    "tStartMs": 146160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It's a kind of funny,\nreally counterintuitive way"
    } ]
  }, {
    "tStartMs": 149200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to think about an engine."
    } ]
  }, {
    "tStartMs": 150720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's what's happening in the back"
    } ]
  }, {
    "tStartMs": 152400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that's actually driving\neverything up front."
    } ]
  }, {
    "tStartMs": 155360,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 155760,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "As the hot exhaust gas is shot\nout the back of the engine,"
    } ]
  }, {
    "tStartMs": 159440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "it pushes the engine forward."
    } ]
  }, {
    "tStartMs": 161360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That generates thrust."
    } ]
  }, {
    "tStartMs": 163120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But did you know that in\na modern passenger jet,"
    } ]
  }, {
    "tStartMs": 165680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "this accounts for less than\n20% the thrust of the engine?"
    } ]
  }, {
    "tStartMs": 169200,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The vast majority of the thrust,\nover 80% of it, just comes"
    } ]
  }, {
    "tStartMs": 172880,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "from that big fan at the front of the jet."
    } ]
  }, {
    "tStartMs": 175983,
    "dDurationMs": 17,
    "segs": [ {
      "utf8": "(numbers beeping)"
    } ]
  }, {
    "tStartMs": 176000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Remember how only 10% of the\nincoming air gets compressed?"
    } ]
  }, {
    "tStartMs": 179600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The other 90% bypasses all that."
    } ]
  }, {
    "tStartMs": 182720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's simply propelled\nbackwards by the fan."
    } ]
  }, {
    "tStartMs": 184880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "It goes right around\nthe guts of the engine"
    } ]
  }, {
    "tStartMs": 186480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and comes straight out the back."
    } ]
  }, {
    "tStartMs": 188560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The fan pushes that air backwards,"
    } ]
  }, {
    "tStartMs": 190960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "so the air pushes the fan forwards."
    } ]
  }, {
    "tStartMs": 193360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That's how you get 80% of the thrust."
    } ]
  }, {
    "tStartMs": 195520,
    "dDurationMs": 3186,
    "segs": [ {
      "utf8": "It's basically a huge ducted propeller."
    } ]
  }, {
    "tStartMs": 198706,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(jet hovering)"
    } ]
  }, {
    "tStartMs": 198720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So, why do it this way?"
    } ]
  }, {
    "tStartMs": 200320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "I mean, why not compress\nall the incoming air"
    } ]
  }, {
    "tStartMs": 203040,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "and put it all through the\ncombustion chamber and turbines?"
    } ]
  }, {
    "tStartMs": 207680,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "(flames blasting)"
    } ]
  }, {
    "tStartMs": 207840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Well, some fighter jets do exactly this,"
    } ]
  }, {
    "tStartMs": 210320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and it makes for very powerful engines,"
    } ]
  }, {
    "tStartMs": 212560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but they're also horribly inefficient."
    } ]
  }, {
    "tStartMs": 215200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "To see why, remember\nthat the impulse pushing"
    } ]
  }, {
    "tStartMs": 217760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the plane forward is equal to the change"
    } ]
  }, {
    "tStartMs": 219840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "in the momentum of the air backwards."
    } ]
  }, {
    "tStartMs": 222160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So you've got options."
    } ]
  }, {
    "tStartMs": 223360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "For example, you could push twice"
    } ]
  }, {
    "tStartMs": 225120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "as much air back half as fast,"
    } ]
  }, {
    "tStartMs": 227360,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "or you could push half as\nmuch air back twice as fast."
    } ]
  }, {
    "tStartMs": 231280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Both will generate the exact same impulse,"
    } ]
  }, {
    "tStartMs": 233920,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but the kinetic energy of\nthe air is proportional"
    } ]
  }, {
    "tStartMs": 236800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to v squared."
    } ]
  }, {
    "tStartMs": 238160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So it takes four times as much energy"
    } ]
  }, {
    "tStartMs": 240240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to speed up the air in the second case,"
    } ]
  }, {
    "tStartMs": 242320,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and a lot of that energy is\njust wasted in the exhaust."
    } ]
  }, {
    "tStartMs": 245760,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So, ideally, you want to\npush as much air backwards"
    } ]
  }, {
    "tStartMs": 248720,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "as possible with only a\nsmall change in velocity."
    } ]
  }, {
    "tStartMs": 253103,
    "dDurationMs": 17,
    "segs": [ {
      "utf8": "(enchanted music)"
    } ]
  }, {
    "tStartMs": 253120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "That's why jets have gotten bigger"
    } ]
  }, {
    "tStartMs": 254720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and bigger over the years,"
    } ]
  }, {
    "tStartMs": 256480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and the increasing fraction"
    } ]
  }, {
    "tStartMs": 258000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "of bypass air has the added benefit"
    } ]
  }, {
    "tStartMs": 260480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that it surrounds the hot exhaust gases,"
    } ]
  }, {
    "tStartMs": 263280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and that reduces noise\ncoming away from the jet."
    } ]
  }, {
    "tStartMs": 266480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But there is another\nmajor factor when it comes"
    } ]
  }, {
    "tStartMs": 268640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "to engine efficiency,\nand that is temperature."
    } ]
  }, {
    "tStartMs": 271840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "At cruising altitudes around 35,000 feet,"
    } ]
  }, {
    "tStartMs": 274480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the outside air is around\nnegative 55 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 278080,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "while inside the engine, it's\nover 1,500 degrees Celsius."
    } ]
  }, {
    "tStartMs": 282240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The hot, high-pressure gas\ninside the engine wants"
    } ]
  }, {
    "tStartMs": 284960,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "to expand into the much colder,\nlower-pressure air outside."
    } ]
  }, {
    "tStartMs": 289200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It's that difference that\nlets the engine turn heat"
    } ]
  }, {
    "tStartMs": 291680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "into useful work.\n(ominous music)"
    } ]
  }, {
    "tStartMs": 293360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "But there's a fundamental limit"
    } ]
  }, {
    "tStartMs": 294640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to how much work any heat\nengine can get from that."
    } ]
  }, {
    "tStartMs": 297520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's called the Carnot efficiency."
    } ]
  }, {
    "tStartMs": 299520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's equal to one minus the temperature"
    } ]
  }, {
    "tStartMs": 301680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of the cold outside air\ndivided by the temperature"
    } ]
  }, {
    "tStartMs": 304320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of the hot gas inside\nthe combustion chamber."
    } ]
  }, {
    "tStartMs": 307200,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 307600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So, looking at this, you\ncan improve the efficiency"
    } ]
  }, {
    "tStartMs": 310400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "of the engine in two ways,"
    } ]
  }, {
    "tStartMs": 312240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "either fly where the air is colder"
    } ]
  }, {
    "tStartMs": 314080,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or raise the temperature\nin the combustion chamber."
    } ]
  }, {
    "tStartMs": 317440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "One problem with that, though,\nis that it turned the inside"
    } ]
  }, {
    "tStartMs": 320640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "of a jet engine into one"
    } ]
  }, {
    "tStartMs": 322400,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "of the harshest environments\nwe have ever built"
    } ]
  }, {
    "tStartMs": 325440,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "in which machinery has to survive."
    } ]
  }, {
    "tStartMs": 328000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- To keep a turbine blade whole"
    } ]
  }, {
    "tStartMs": 330000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and unaffected within an engine\nis like putting an ice cube"
    } ]
  }, {
    "tStartMs": 332800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "inside your oven, turning\nup to max, leaving for work,"
    } ]
  }, {
    "tStartMs": 335280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "coming back after an eight-hour shift,"
    } ]
  }, {
    "tStartMs": 336720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and finding it's still\ncompletely frozen in the oven."
    } ]
  }, {
    "tStartMs": 338720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "That's what we've got to try\nand do within that engine."
    } ]
  }, {
    "tStartMs": 340240,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "- It sounds absurd."
    } ]
  }, {
    "tStartMs": 342145,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 342160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Not only do the turbine blades sit"
    } ]
  }, {
    "tStartMs": 344160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "in a stream of gas that's\nover 1,500 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 347840,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "they're also spinning at 12,500 RPM"
    } ]
  }, {
    "tStartMs": 351280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "with the tip of each blade slicing"
    } ]
  }, {
    "tStartMs": 353280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "through the air at nearly\n1,900 kilometers per hour."
    } ]
  }, {
    "tStartMs": 357280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Now, every blade wants to fly straight,"
    } ]
  }, {
    "tStartMs": 359760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but it's forced to spin in a circle,"
    } ]
  }, {
    "tStartMs": 362160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "which means, something has"
    } ]
  }, {
    "tStartMs": 363600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to be constantly pulling it inwards."
    } ]
  }, {
    "tStartMs": 365840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That's the centripetal force."
    } ]
  }, {
    "tStartMs": 367600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "If you take a representative 300 gram"
    } ]
  }, {
    "tStartMs": 369840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "high-pressure turbine blade\nand run it at that speed"
    } ]
  }, {
    "tStartMs": 372400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and radius, it has to be pulled\ninwards with a force equal"
    } ]
  }, {
    "tStartMs": 375520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to the weight of 20 metric tons."
    } ]
  }, {
    "tStartMs": 377920,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "That's roughly the weight"
    } ]
  }, {
    "tStartMs": 378800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of two London double-decker\nbuses tugging on each blade"
    } ]
  }, {
    "tStartMs": 382240,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "as it spins, all while\nthey're glowing hot."
    } ]
  }, {
    "tStartMs": 386560,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 386720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "To make matters worse, at these\ntemperatures, oxygen wants"
    } ]
  }, {
    "tStartMs": 389920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to react with the metal\nof the blades itself."
    } ]
  }, {
    "tStartMs": 392480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And on top of all that, the air rushing"
    } ]
  }, {
    "tStartMs": 394800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "through the engine often\ncarries dust, sand,"
    } ]
  }, {
    "tStartMs": 397200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and pollutants that can damage"
    } ]
  }, {
    "tStartMs": 398880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and erode the surfaces inside."
    } ]
  }, {
    "tStartMs": 401520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And somehow, these blades have\nto survive this punishment"
    } ]
  }, {
    "tStartMs": 404880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "for tens of thousands"
    } ]
  }, {
    "tStartMs": 406720,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "of flight hours without\ndeforming, cracking, or failing."
    } ]
  }, {
    "tStartMs": 410800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "They really determine how\nefficient you can make the engine"
    } ]
  }, {
    "tStartMs": 413840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because you can't make the engine so hot"
    } ]
  }, {
    "tStartMs": 415760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that the blades can't\nwithstand that temperature."
    } ]
  }, {
    "tStartMs": 418400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So they determine the maximum temperature"
    } ]
  }, {
    "tStartMs": 420320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "of the combustion chamber,"
    } ]
  }, {
    "tStartMs": 421440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and therefore, the maximum\nefficiency you can realize"
    } ]
  }, {
    "tStartMs": 424640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with a jet engine."
    } ]
  }, {
    "tStartMs": 426320,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "So what kind"
    } ]
  }, {
    "tStartMs": 427200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "of metal could possibly\nsurvive these conditions?"
    } ]
  }, {
    "tStartMs": 430800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Well, we sent Veritasium producer, Emilia,"
    } ]
  }, {
    "tStartMs": 433040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to the Department of Materials\nScience \u0026 Metallurgical"
    } ]
  }, {
    "tStartMs": 435200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "at Cambridge University"
    } ]
  }, {
    "tStartMs": 436480,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "to put some different metals to the test."
    } ]
  }, {
    "tStartMs": 439103,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 439118,
    "dDurationMs": 962,
    "segs": [ {
      "utf8": "- So this is the steel?"
    } ]
  }, {
    "tStartMs": 440080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This is the steel sample, yes."
    } ]
  }, {
    "tStartMs": 441760,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Okay.\n- So we've got"
    } ]
  }, {
    "tStartMs": 442720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "about 200 megapascals to start with,"
    } ]
  }, {
    "tStartMs": 444720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "which is sort of comparable\nto some of the stress"
    } ]
  }, {
    "tStartMs": 447440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that's seen by these components\nin real applications."
    } ]
  }, {
    "tStartMs": 450320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And we're gonna put that stress on,"
    } ]
  }, {
    "tStartMs": 452240,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "and then slowly increase the temperature."
    } ]
  }, {
    "tStartMs": 454630,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "- [Derek] This is a mild steel."
    } ]
  }, {
    "tStartMs": 456000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's relatively strong and easy\nto form into complex shapes."
    } ]
  }, {
    "tStartMs": 459120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It seems like a pretty good\nbet for a turbine blade."
    } ]
  }, {
    "tStartMs": 461680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And at first, under this load"
    } ]
  }, {
    "tStartMs": 463120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and at these low temperatures,\nit holds up pretty well."
    } ]
  }, {
    "tStartMs": 466240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "We're essentially tugging on\nall the atoms within the metal."
    } ]
  }, {
    "tStartMs": 469520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "We're not breaking or forming any bonds."
    } ]
  }, {
    "tStartMs": 472000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "We're just making them flex a little."
    } ]
  }, {
    "tStartMs": 473520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And that slightly changes the\nspacing between the atoms."
    } ]
  }, {
    "tStartMs": 476320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And as a result, the metal\ngets slightly longer."
    } ]
  }, {
    "tStartMs": 479360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This resulting change in size,"
    } ]
  }, {
    "tStartMs": 481360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "specifically the per-unit\nchange in length,"
    } ]
  }, {
    "tStartMs": 483600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "is what we call strain."
    } ]
  }, {
    "tStartMs": 485280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Critically, at this stage,"
    } ]
  }, {
    "tStartMs": 486560,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the material is behaving elastically."
    } ]
  }, {
    "tStartMs": 488800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "If we remove the load right now,"
    } ]
  }, {
    "tStartMs": 490640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the material just snaps\nback to its original size."
    } ]
  }, {
    "tStartMs": 494000,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "In an engine, some elastic\ndeformation like this will occur."
    } ]
  }, {
    "tStartMs": 497840,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It can't be too big or\nit'll cause problems."
    } ]
  }, {
    "tStartMs": 500640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But what we really don't\nwant is plastic deformation"
    } ]
  }, {
    "tStartMs": 503840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "if the shape changes permanently."
    } ]
  }, {
    "tStartMs": 506480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And that's exactly what starts to happen"
    } ]
  }, {
    "tStartMs": 508240,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "as we keep increasing the temperature."
    } ]
  }, {
    "tStartMs": 510309,
    "dDurationMs": 1451,
    "segs": [ {
      "utf8": "- [Howard] It's getting hot now."
    } ]
  }, {
    "tStartMs": 511760,
    "dDurationMs": 3585,
    "segs": [ {
      "utf8": "That's a little bit of oxide."
    } ]
  }, {
    "tStartMs": 515345,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 515360,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "There you go, see this starting to deform?"
    } ]
  }, {
    "tStartMs": 518390,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "- [Derek] Now, bonds are breaking"
    } ]
  }, {
    "tStartMs": 520240,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and reforming as the metal\nat us deforms permanently."
    } ]
  }, {
    "tStartMs": 525120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 526560,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But this doesn't happen all at once."
    } ]
  }, {
    "tStartMs": 528800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So I got the mechanical\nengineer on our team,"
    } ]
  }, {
    "tStartMs": 530880,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "Henry, to build this demo."
    } ]
  }, {
    "tStartMs": 533743,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 533758,
    "dDurationMs": 1682,
    "segs": [ {
      "utf8": "- Okay, so you can see\nwe're getting a bunch"
    } ]
  }, {
    "tStartMs": 535440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of tiny little bubbles,\nand just naturally,"
    } ]
  }, {
    "tStartMs": 537840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "they're packing into this\nhexagonal arrangement."
    } ]
  }, {
    "tStartMs": 540160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And there are actually a lot of materials"
    } ]
  }, {
    "tStartMs": 541520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that have atomic\nstructures just like this."
    } ]
  }, {
    "tStartMs": 543760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But you can see it's not perfect."
    } ]
  }, {
    "tStartMs": 545840,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Like, right here,"
    } ]
  }, {
    "tStartMs": 546880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you can see there's an\nextra half-plane of atoms."
    } ]
  }, {
    "tStartMs": 549920,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Well, in this case, bubbles,"
    } ]
  }, {
    "tStartMs": 551200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "this is called an edge dislocation."
    } ]
  }, {
    "tStartMs": 556960,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 557120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It becomes really interesting when I try"
    } ]
  }, {
    "tStartMs": 559200,
    "dDurationMs": 2785,
    "segs": [ {
      "utf8": "to pull this raft apart."
    } ]
  }, {
    "tStartMs": 561985,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 562000,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "You can see these little dark\nlines that zip back and forth."
    } ]
  }, {
    "tStartMs": 565920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Those are dislocations, and\nthey move through the lattice."
    } ]
  }, {
    "tStartMs": 568880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "As the dislocation moves, it'll\ncause one plane, a bubbles,"
    } ]
  }, {
    "tStartMs": 572160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to sheer past the other one,\nwhich shifts the structure"
    } ]
  }, {
    "tStartMs": 574800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "by exactly one spacing."
    } ]
  }, {
    "tStartMs": 576640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But there isn't just one dislocation."
    } ]
  }, {
    "tStartMs": 579040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "There are plenty of them."
    } ]
  }, {
    "tStartMs": 580080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And altogether, their movement\nproduces dramatic changes"
    } ]
  }, {
    "tStartMs": 582800,
    "dDurationMs": 2295,
    "segs": [ {
      "utf8": "in the overall shape."
    } ]
  }, {
    "tStartMs": 585095,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 585110,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "- [Derek] That's exactly\nwhat's happening here."
    } ]
  }, {
    "tStartMs": 587200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Everywhere that stress is high enough,"
    } ]
  }, {
    "tStartMs": 589120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "billions of dislocations\nare moving and interacting."
    } ]
  }, {
    "tStartMs": 592160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The steel starts to deform continuously"
    } ]
  }, {
    "tStartMs": 594400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "under this constant load\nin a process called creep."
    } ]
  }, {
    "tStartMs": 597840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It takes energy to break the atomic bonds"
    } ]
  }, {
    "tStartMs": 600240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "as the dislocation travels\nthrough the lattice."
    } ]
  }, {
    "tStartMs": 602400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "So, as we ramp up the temperature"
    } ]
  }, {
    "tStartMs": 603920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and all the atoms get more thermal energy,"
    } ]
  }, {
    "tStartMs": 606080,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "it no longer requires as much\nstress to break these bonds,"
    } ]
  }, {
    "tStartMs": 609520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "becomes much easier for\nthe dislocations to move."
    } ]
  }, {
    "tStartMs": 612160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The metal effectively gets softer."
    } ]
  }, {
    "tStartMs": 614720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Now the steel strength drops so much"
    } ]
  }, {
    "tStartMs": 617200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that the slow, time-dependent\ncreep gives way"
    } ]
  }, {
    "tStartMs": 619920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to rapid deformation."
    } ]
  }, {
    "tStartMs": 621760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "As it stretches, it rapidly\ndecreases in cross-section,"
    } ]
  }, {
    "tStartMs": 625360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and eventually, the remaining\nmetal can no longer bear"
    } ]
  }, {
    "tStartMs": 627760,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the load.\n(ominous music)"
    } ]
  }, {
    "tStartMs": 630720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Now, you could try doing similar tests"
    } ]
  }, {
    "tStartMs": 632560,
    "dDurationMs": 3505,
    "segs": [ {
      "utf8": "for other metals like this titanium alloy."
    } ]
  }, {
    "tStartMs": 636065,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 636080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Titanium is about half as dense as steel."
    } ]
  }, {
    "tStartMs": 638360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- Should feel that's quite a bit lighter."
    } ]
  }, {
    "tStartMs": 639800,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "- Yeah, it's like loads lighter."
    } ]
  }, {
    "tStartMs": 641430,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- [Derek] So if we were\nto make turbine blades out"
    } ]
  }, {
    "tStartMs": 643360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "of titanium, each blade\nwould be much lighter,"
    } ]
  }, {
    "tStartMs": 645600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "and that would reduce"
    } ]
  }, {
    "tStartMs": 646400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the enormous centripetal\nforces it would experience."
    } ]
  }, {
    "tStartMs": 649360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So it seems like a great choice."
    } ]
  }, {
    "tStartMs": 651520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And at first, it performs really well."
    } ]
  }, {
    "tStartMs": 653320,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- That's 100 degrees."
    } ]
  }, {
    "tStartMs": 654800,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "It's hanging in there."
    } ]
  }, {
    "tStartMs": 656230,
    "dDurationMs": 1999,
    "segs": [ {
      "utf8": "- [Derek] But as we push\nthe temperature higher..."
    } ]
  }, {
    "tStartMs": 658229,
    "dDurationMs": 3194,
    "segs": [ {
      "utf8": "- [Howard] Oh, I can see some glowing."
    } ]
  }, {
    "tStartMs": 661423,
    "dDurationMs": 17,
    "segs": [ {
      "utf8": "(energetic music)"
    } ]
  }, {
    "tStartMs": 661440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Oh, look at this, oh, it's gone already."
    } ]
  }, {
    "tStartMs": 664160,
    "dDurationMs": 384,
    "segs": [ {
      "utf8": "(Emilia laughs)"
    } ]
  }, {
    "tStartMs": 664544,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "- [Derek] Just like the steel,\nits strength drops rapidly"
    } ]
  }, {
    "tStartMs": 667360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "as temperature increases."
    } ]
  }, {
    "tStartMs": 668960,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "And that's true for most metals."
    } ]
  }, {
    "tStartMs": 672226,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(lively music)"
    } ]
  }, {
    "tStartMs": 672240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Yet, the first jet engine,\ndating back all the way"
    } ]
  }, {
    "tStartMs": 674640,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to 1941, actually did\nuse steel turbine blades."
    } ]
  }, {
    "tStartMs": 678560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "It was designed by British pilot\nand engineer Frank Whittle."
    } ]
  }, {
    "tStartMs": 681840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "His engine powered the first flight"
    } ]
  }, {
    "tStartMs": 683600,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "of a British jet aircraft,\nthe Gloster E.28/39 prototype."
    } ]
  }, {
    "tStartMs": 687920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "When a colleague excitedly told Whittle,"
    } ]
  }, {
    "tStartMs": 689920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "\"Frank, it flies,\" he dryly\nquipped, \"That was bloody well"
    } ]
  }, {
    "tStartMs": 693600,
    "dDurationMs": 2454,
    "segs": [ {
      "utf8": "what it was designed to do, wasn't it?\""
    } ]
  }, {
    "tStartMs": 696054,
    "dDurationMs": 26,
    "segs": [ {
      "utf8": "(film whirs)\n(lively music)"
    } ]
  }, {
    "tStartMs": 696080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But Whittle's prototype\nhad two major flaws."
    } ]
  }, {
    "tStartMs": 698960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The first was that the gas"
    } ]
  }, {
    "tStartMs": 700400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "inside the engine, only\nreached temperatures"
    } ]
  }, {
    "tStartMs": 702480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of around 780 degrees\nCelsius, which was one"
    } ]
  }, {
    "tStartMs": 705840,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "of the reasons it was inefficient."
    } ]
  }, {
    "tStartMs": 707920,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And the second was that\nit was only allowed"
    } ]
  }, {
    "tStartMs": 710000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to fly for up to 10 hours."
    } ]
  }, {
    "tStartMs": 712000,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Any longer, and it was too likely parts"
    } ]
  }, {
    "tStartMs": 714080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "inside the engine would fail."
    } ]
  }, {
    "tStartMs": 715760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And both of these\ndrawbacks were largely due"
    } ]
  }, {
    "tStartMs": 717920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to the steel turbine blades."
    } ]
  }, {
    "tStartMs": 719920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Something that occurred to me is,"
    } ]
  }, {
    "tStartMs": 721680,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "why aren't they made out of tungsten?"
    } ]
  }, {
    "tStartMs": 723920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I mean, because tungsten doesn't melt"
    } ]
  }, {
    "tStartMs": 726080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "until 3,400 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 728480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which is more than twice the temperature"
    } ]
  }, {
    "tStartMs": 730400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "inside a modern jet engine."
    } ]
  }, {
    "tStartMs": 732400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But tungsten is also incredibly dense."
    } ]
  }, {
    "tStartMs": 734800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It's about two and a half\ntimes denser than steel,"
    } ]
  }, {
    "tStartMs": 737840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and it's also brittle, which\nmakes it hard to manufacture."
    } ]
  }, {
    "tStartMs": 741200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And using a material"
    } ]
  }, {
    "tStartMs": 742400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that heavy wouldn't just\nmake the blade a problem."
    } ]
  }, {
    "tStartMs": 745520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The components that hold the\nblade in the engine would"
    } ]
  }, {
    "tStartMs": 748400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "also have to carry much higher loads,"
    } ]
  }, {
    "tStartMs": 750400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "well beyond what current\nmaterials can handle."
    } ]
  }, {
    "tStartMs": 753520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So, you can optimize for one\nthing, like the melting point,"
    } ]
  }, {
    "tStartMs": 756720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "or a different thing\nlike strength or weight."
    } ]
  }, {
    "tStartMs": 759440,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But the turbine pushes\nevery variable to its limit."
    } ]
  }, {
    "tStartMs": 763440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So what are these blades"
    } ]
  }, {
    "tStartMs": 765200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "actually made of?\n(energetic music)"
    } ]
  }, {
    "tStartMs": 767280,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Well, to find out, we went"
    } ]
  }, {
    "tStartMs": 768400,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to Rolls-Royce's precision\nCasting Facility in Derby,"
    } ]
  }, {
    "tStartMs": 772080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and it turns out the world's"
    } ]
  }, {
    "tStartMs": 773920,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "most advanced metal parts\nbegin life as, well,"
    } ]
  }, {
    "tStartMs": 777360,
    "dDurationMs": 2386,
    "segs": [ {
      "utf8": "something surprising."
    } ]
  }, {
    "tStartMs": 779746,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(lively music)"
    } ]
  }, {
    "tStartMs": 779760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "What is with the, like the\npink and the green there?"
    } ]
  }, {
    "tStartMs": 782400,
    "dDurationMs": 1278,
    "segs": [ {
      "utf8": "- Well, come, I'll show you.\n- Okay, all right."
    } ]
  }, {
    "tStartMs": 783678,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "- I'll come and show you.\n- I'm just seeing"
    } ]
  }, {
    "tStartMs": 784880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "so many cool things around here."
    } ]
  }, {
    "tStartMs": 786200,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "I'm like, \"What is that?"
    } ]
  }, {
    "tStartMs": 787360,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Why does it look like that?\""
    } ]
  }, {
    "tStartMs": 788640,
    "dDurationMs": 2865,
    "segs": [ {
      "utf8": "You just enter this room,\nand I smell the wax."
    } ]
  }, {
    "tStartMs": 791505,
    "dDurationMs": 495,
    "segs": [ {
      "utf8": "- Yeah, yeah.\n- Smells like"
    } ]
  }, {
    "tStartMs": 792000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a candle factory in here."
    } ]
  }, {
    "tStartMs": 793200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- Absolutely, so investment\ncasting is a really,"
    } ]
  }, {
    "tStartMs": 795840,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "really ancient technology."
    } ]
  }, {
    "tStartMs": 797200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So our ancestors have been\ndoing investment casting"
    } ]
  }, {
    "tStartMs": 799840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to make jewelry, to make\nweapons for millennia."
    } ]
  }, {
    "tStartMs": 802720,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "We've just perfected it\nhere to make turbine blades."
    } ]
  }, {
    "tStartMs": 805080,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- It's so wacky."
    } ]
  }, {
    "tStartMs": 806400,
    "dDurationMs": 3585,
    "segs": [ {
      "utf8": "This is just not how I'd\nexpect it to happen at all."
    } ]
  }, {
    "tStartMs": 809985,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 810000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Turbine blades strike me as one"
    } ]
  }, {
    "tStartMs": 811600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "of the most high-tech things in the world."
    } ]
  }, {
    "tStartMs": 813920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Yep.\n- And yet,"
    } ]
  }, {
    "tStartMs": 815600,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "this facility is using\nwax as a starting point."
    } ]
  }, {
    "tStartMs": 819480,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- What you will see through\nour tour today is that,"
    } ]
  }, {
    "tStartMs": 822320,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "actually, it's a really\nhighly technological process."
    } ]
  }, {
    "tStartMs": 825520,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 826400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is our wax pattern die."
    } ]
  }, {
    "tStartMs": 828400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "This is how a turbine\nblade starts its life."
    } ]
  }, {
    "tStartMs": 831360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So, this is what's gonna\ngo inside the wax pattern,"
    } ]
  }, {
    "tStartMs": 834080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "a ceramic core."
    } ]
  }, {
    "tStartMs": 835520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This is gonna create a hollow\ninside the turbine blade."
    } ]
  }, {
    "tStartMs": 839120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So what's happening now is\nwe're injecting into the die."
    } ]
  }, {
    "tStartMs": 842640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So that's the very start of\nthe life of a turbine blade."
    } ]
  }, {
    "tStartMs": 846000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- That is really neat.\n- What we'll actually see is"
    } ]
  }, {
    "tStartMs": 848320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that a lot of these features,\nsuch as the aerofoil"
    } ]
  }, {
    "tStartMs": 850560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and the annular surfaces\nare not touched further."
    } ]
  }, {
    "tStartMs": 853040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So we will cast that, and\nthat will remain as cast"
    } ]
  }, {
    "tStartMs": 855360,
    "dDurationMs": 2055,
    "segs": [ {
      "utf8": "as it goes into the engine."
    } ]
  }, {
    "tStartMs": 857415,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 857430,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- [Derek] Every surface\nhere has to be perfect"
    } ]
  }, {
    "tStartMs": 859360,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "because this wax is what\nwill become the blade."
    } ]
  }, {
    "tStartMs": 862600,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- So Kim is our wax pattern assembler."
    } ]
  }, {
    "tStartMs": 866560,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So she's responsible for\ntaking the product straight"
    } ]
  }, {
    "tStartMs": 869440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "from that die, making sure"
    } ]
  }, {
    "tStartMs": 871440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that things like die\nlines have been removed."
    } ]
  }, {
    "tStartMs": 874160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So where the die box come together"
    } ]
  }, {
    "tStartMs": 875360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and leave a small amount of flash,"
    } ]
  }, {
    "tStartMs": 877040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the operative word in all\nof wax assembly is smooth."
    } ]
  }, {
    "tStartMs": 880160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- [Derek] Every tiny imperfection\nin the wax would become"
    } ]
  }, {
    "tStartMs": 882720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a flaw in the metal."
    } ]
  }, {
    "tStartMs": 883920,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "So this takes an\nincredible amount of skill."
    } ]
  }, {
    "tStartMs": 887103,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 887118,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "- Then it's the case of getting\nthat wax pattern attached"
    } ]
  }, {
    "tStartMs": 889680,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to the unit runner to create the assembly."
    } ]
  }, {
    "tStartMs": 891240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- I mean, the thought\nthat occurs to me, right?"
    } ]
  }, {
    "tStartMs": 893520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Shouldn't you be doing this with a robot?"
    } ]
  }, {
    "tStartMs": 895560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Can, you know, like-\n- Yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 897600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, Rolls-Royce has facilities\nthat do this by robot,"
    } ]
  }, {
    "tStartMs": 900480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "but our facility in particular\nis very much focused"
    } ]
  }, {
    "tStartMs": 903680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "on bringing in those new products."
    } ]
  }, {
    "tStartMs": 905120,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "And it's far, far easier for\nus to work with human beings"
    } ]
  }, {
    "tStartMs": 909600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to develop that method of\nmanufacture that's going"
    } ]
  }, {
    "tStartMs": 911840,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to bring the next generation\nof product through."
    } ]
  }, {
    "tStartMs": 913880,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- I'll bet, I can see the skill here,"
    } ]
  }, {
    "tStartMs": 915760,
    "dDurationMs": 878,
    "segs": [ {
      "utf8": "like it's phenomenal.\n- Absolutely."
    } ]
  }, {
    "tStartMs": 916638,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "- I'll just make a mess of it."
    } ]
  }, {
    "tStartMs": 917760,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Absolutely, so would I."
    } ]
  }, {
    "tStartMs": 918600,
    "dDurationMs": 3225,
    "segs": [ {
      "utf8": "- Would you like a go?\n- No. (laughs)"
    } ]
  }, {
    "tStartMs": 921825,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 921840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Once the wax assembly is perfect,"
    } ]
  }, {
    "tStartMs": 923680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it's ready for the next stage."
    } ]
  }, {
    "tStartMs": 925360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- Everything that is\nwax is gonna become air,"
    } ]
  }, {
    "tStartMs": 928400,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "it's gonna become negative space, right?"
    } ]
  }, {
    "tStartMs": 929760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "It's gonna become our cavity."
    } ]
  }, {
    "tStartMs": 931120,
    "dDurationMs": 3185,
    "segs": [ {
      "utf8": "And then we're gonna\nfill that air with metal."
    } ]
  }, {
    "tStartMs": 934305,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 934320,
    "dDurationMs": 4305,
    "segs": [ {
      "utf8": "So we take that wax assembly,\nand we've gotta build a shell."
    } ]
  }, {
    "tStartMs": 938625,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 938640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Shell is made of many different layers."
    } ]
  }, {
    "tStartMs": 940480,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It's a zircon-based shell system."
    } ]
  }, {
    "tStartMs": 943520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "We're gonna dip into a primary story."
    } ]
  }, {
    "tStartMs": 945280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It's really quite thin, like\na light syrup or a thin honey."
    } ]
  }, {
    "tStartMs": 948080,
    "dDurationMs": 2055,
    "segs": [ {
      "utf8": "- Oh yeah."
    } ]
  }, {
    "tStartMs": 950135,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 950150,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Henry] And what that's\ndesigned to do is map all"
    } ]
  }, {
    "tStartMs": 951920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of those really complex\ngeometric features."
    } ]
  }, {
    "tStartMs": 954880,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- Beautiful.\n(engine droning)"
    } ]
  }, {
    "tStartMs": 956240,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It's like making icing."
    } ]
  }, {
    "tStartMs": 958310,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- [Henry] So that's\nactually the analogy we use."
    } ]
  }, {
    "tStartMs": 960240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So, it's a bit like if you\nput icing on top of a bun"
    } ]
  }, {
    "tStartMs": 963280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "or a cake, you need to sprinkle it"
    } ]
  }, {
    "tStartMs": 965280,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "with some sugar afterwards,"
    } ]
  }, {
    "tStartMs": 966320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "otherwise, it's all\ngonna slop off the top."
    } ]
  }, {
    "tStartMs": 968160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So we've got the slurry on there."
    } ]
  }, {
    "tStartMs": 969600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "We're gonna get a nice even\ncoat, drain it, make sure"
    } ]
  }, {
    "tStartMs": 971840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that it's an even thin layer."
    } ]
  }, {
    "tStartMs": 973520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And then we're gonna sand,"
    } ]
  }, {
    "tStartMs": 974960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and that's then gonna\nset that layer in place."
    } ]
  }, {
    "tStartMs": 977280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- So cool.\n(machine droning)"
    } ]
  }, {
    "tStartMs": 979120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Whoa.\n(machine droning)"
    } ]
  }, {
    "tStartMs": 981040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "We're then gonna dry it,"
    } ]
  }, {
    "tStartMs": 982240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "so it's air-dried for many, many hours."
    } ]
  }, {
    "tStartMs": 984480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And then we can create our backup layers."
    } ]
  }, {
    "tStartMs": 986320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So our backup layers, it's\na much thicker slurry,"
    } ]
  }, {
    "tStartMs": 988800,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "more like a treacle,"
    } ]
  }, {
    "tStartMs": 989840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and the sand is much coarser,\nmore like a granulated sugar."
    } ]
  }, {
    "tStartMs": 992960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And we're gonna maybe put four,\nfive, maybe even six layers"
    } ]
  }, {
    "tStartMs": 995920,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to back up, because what\nwe need is we need a mold"
    } ]
  }, {
    "tStartMs": 998640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "that can withstand"
    } ]
  }, {
    "tStartMs": 999760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that casting parameters that\nwe're putting in the die."
    } ]
  }, {
    "tStartMs": 1001920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "You know, it's got a lot of work to do."
    } ]
  }, {
    "tStartMs": 1004240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- The wax is then melted out,"
    } ]
  }, {
    "tStartMs": 1007040,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and the mold is fired."
    } ]
  }, {
    "tStartMs": 1008480,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Oh, yeah."
    } ]
  }, {
    "tStartMs": 1010941,
    "dDurationMs": 19,
    "segs": [ {
      "utf8": "(machine whooshing)"
    } ]
  }, {
    "tStartMs": 1010960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That is wild."
    } ]
  }, {
    "tStartMs": 1012800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Cleaned and tested to make\nsure there aren't any cracks."
    } ]
  }, {
    "tStartMs": 1015840,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "When it's done, this shell is\nready to hold molten metal."
    } ]
  }, {
    "tStartMs": 1019000,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- This is a billet of alloy"
    } ]
  }, {
    "tStartMs": 1020720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that's gonna fill the whole of that mold."
    } ]
  }, {
    "tStartMs": 1022160,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "So just that amount"
    } ]
  }, {
    "tStartMs": 1023120,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "of metal is gonna fill\nthat whole mold there."
    } ]
  }, {
    "tStartMs": 1025560,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- It doesn't look like an F."
    } ]
  }, {
    "tStartMs": 1026480,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1027760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This is a nickel alloy."
    } ]
  }, {
    "tStartMs": 1029440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The first nickel alloys used\nin jet engines were developed"
    } ]
  }, {
    "tStartMs": 1032160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "in the 1940s."
    } ]
  }, {
    "tStartMs": 1033680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "By adding chromium and cobalt,"
    } ]
  }, {
    "tStartMs": 1035600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "engineers created alloys\nthat could handle 800"
    } ]
  }, {
    "tStartMs": 1038160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to 900 degrees Celsius,"
    } ]
  }, {
    "tStartMs": 1040000,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "around 100 degrees hotter\nthan the steel used before."
    } ]
  }, {
    "tStartMs": 1043680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And these alloys could keep\ntheir strength for thousands"
    } ]
  }, {
    "tStartMs": 1046560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "of hours, a tenfold improvement in life."
    } ]
  }, {
    "tStartMs": 1049840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But the real breakthrough\ncame when they added"
    } ]
  }, {
    "tStartMs": 1051840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "a touch of aluminum.\n(film whirring)"
    } ]
  }, {
    "tStartMs": 1053840,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "So we wanted to see"
    } ]
  }, {
    "tStartMs": 1054720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "how it held up under\nthe same lab conditions"
    } ]
  }, {
    "tStartMs": 1056960,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "as the steel and titanium."
    } ]
  }, {
    "tStartMs": 1058629,
    "dDurationMs": 1596,
    "segs": [ {
      "utf8": "- [Emilia] What temperature are we in now?"
    } ]
  }, {
    "tStartMs": 1060225,
    "dDurationMs": 3192,
    "segs": [ {
      "utf8": "- [Howard] Oh, that's 700 degrees."
    } ]
  }, {
    "tStartMs": 1063417,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "- [Emilia] 700, so the steel's long gone."
    } ]
  }, {
    "tStartMs": 1064320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Steel's, long gone."
    } ]
  }, {
    "tStartMs": 1065520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "That's 800 degrees."
    } ]
  }, {
    "tStartMs": 1066880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "800, yes.\n(flames blasting)"
    } ]
  }, {
    "tStartMs": 1068630,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- [Derek] In around this temperature,"
    } ]
  }, {
    "tStartMs": 1070560,
    "dDurationMs": 2465,
    "segs": [ {
      "utf8": "it's actually getting stronger."
    } ]
  }, {
    "tStartMs": 1073025,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1073040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So why would heating a\nmetal make it stronger?"
    } ]
  }, {
    "tStartMs": 1076880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Well, when these nickel\nalloys were first used"
    } ]
  }, {
    "tStartMs": 1078800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in jet engines, no one actually knew."
    } ]
  }, {
    "tStartMs": 1081440,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "But about 10 years later,"
    } ]
  }, {
    "tStartMs": 1082720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "electron microscopes had\nimproved enough for engineers"
    } ]
  }, {
    "tStartMs": 1085440,
    "dDurationMs": 3105,
    "segs": [ {
      "utf8": "to finally see what was happening inside."
    } ]
  }, {
    "tStartMs": 1088545,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1088560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "As we zoom in on the\nalloy, a pattern emerges."
    } ]
  }, {
    "tStartMs": 1092080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The microstructure isn't uniform."
    } ]
  }, {
    "tStartMs": 1094480,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Instead, it kind of looks like\na city grid made up of blocks"
    } ]
  }, {
    "tStartMs": 1098320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "with rods in between them."
    } ]
  }, {
    "tStartMs": 1100400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Only, each block is so small,"
    } ]
  }, {
    "tStartMs": 1102480,
    "dDurationMs": 4225,
    "segs": [ {
      "utf8": "over 300 would line up across\nthe width of a human hair."
    } ]
  }, {
    "tStartMs": 1106705,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1106720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Now, surprisingly, both the rods"
    } ]
  }, {
    "tStartMs": 1108320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and the blocks are made up\nof the exact same atoms,"
    } ]
  }, {
    "tStartMs": 1110960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "mostly nickel with a little aluminum."
    } ]
  }, {
    "tStartMs": 1113280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "They even have the same crystal structure,"
    } ]
  }, {
    "tStartMs": 1115440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "a grid of tiny cubes with\natoms sitting at the corners"
    } ]
  }, {
    "tStartMs": 1118640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and at the center of each face."
    } ]
  }, {
    "tStartMs": 1120480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The only difference is"
    } ]
  }, {
    "tStartMs": 1121680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that the atoms are arranged\nslightly differently."
    } ]
  }, {
    "tStartMs": 1124320,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "In the road structure,"
    } ]
  }, {
    "tStartMs": 1125680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the aluminum and nickel can take any spot."
    } ]
  }, {
    "tStartMs": 1128320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "There is no repeating\nsequence from cube to cube."
    } ]
  }, {
    "tStartMs": 1131200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And this is known as the gamma phase."
    } ]
  }, {
    "tStartMs": 1133600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But in the blocks, aluminum\nalways takes the corner spots,"
    } ]
  }, {
    "tStartMs": 1137200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and nickel the faces,"
    } ]
  }, {
    "tStartMs": 1139040,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and you get a perfect repeating\npattern cube after cube."
    } ]
  }, {
    "tStartMs": 1142640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is the gamma prime phase."
    } ]
  }, {
    "tStartMs": 1144640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And it's this difference"
    } ]
  }, {
    "tStartMs": 1145760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that is crucial when a\ndislocation tries to glide"
    } ]
  }, {
    "tStartMs": 1148320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "through the lattice."
    } ]
  }, {
    "tStartMs": 1149440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "In the rods, this motion is easy."
    } ]
  }, {
    "tStartMs": 1151680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Each layer of atoms can\nshear smoothly past the next,"
    } ]
  }, {
    "tStartMs": 1154400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "leaving the structure\nlooking unchanged behind it."
    } ]
  }, {
    "tStartMs": 1157120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But if you try to do the\nsame thing in the blocks,"
    } ]
  }, {
    "tStartMs": 1159760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "well, now you're actually\nchanging the order of the atoms,"
    } ]
  }, {
    "tStartMs": 1162960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "nickel and aluminum end up\nsitting in the wrong places."
    } ]
  }, {
    "tStartMs": 1166000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That takes energy, so\nthe lattice resists it."
    } ]
  }, {
    "tStartMs": 1169120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "So, when a dislocation moving"
    } ]
  }, {
    "tStartMs": 1170480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "through the rods hits\na block, it gets stuck."
    } ]
  }, {
    "tStartMs": 1173280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And that's what makes\nthis alloy so strong."
    } ]
  }, {
    "tStartMs": 1175760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- [Henry] But if you keep pushing"
    } ]
  }, {
    "tStartMs": 1177120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and the stress gets high enough,"
    } ]
  }, {
    "tStartMs": 1178800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "dislocation can finally force its way in."
    } ]
  }, {
    "tStartMs": 1181440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The catch is that this\ndislocation leaves the lattice"
    } ]
  }, {
    "tStartMs": 1183840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in such a high-energy\nmess that the only way"
    } ]
  }, {
    "tStartMs": 1186240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that it can keep moving\nis if there's a second one"
    } ]
  }, {
    "tStartMs": 1188720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "right behind it that puts\nthings back in order."
    } ]
  }, {
    "tStartMs": 1191280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So in the gamma prime\nphase, dislocations have"
    } ]
  }, {
    "tStartMs": 1193680,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "to travel in pairs,\ncalled super dislocations."
    } ]
  }, {
    "tStartMs": 1196520,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "- I need that creation of\nthose super dislocations,"
    } ]
  }, {
    "tStartMs": 1200160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and I need that very high\nstress to be able to shear."
    } ]
  }, {
    "tStartMs": 1202640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So that's why the strength is very high"
    } ]
  }, {
    "tStartMs": 1204800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "relative to other alloys."
    } ]
  }, {
    "tStartMs": 1206240,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "What happens is, ultimately,"
    } ]
  }, {
    "tStartMs": 1207600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "because you're shearing\nthrough that gamma prime"
    } ]
  }, {
    "tStartMs": 1210000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "with two dislocations,"
    } ]
  }, {
    "tStartMs": 1211360,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as the temperature continuously increases,"
    } ]
  }, {
    "tStartMs": 1213280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "you're adding more and more\nthermal energy in the material."
    } ]
  }, {
    "tStartMs": 1215360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "What happens is the\natoms are gonna vibrate"
    } ]
  }, {
    "tStartMs": 1216720,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "more and more and more."
    } ]
  }, {
    "tStartMs": 1217680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So there's a likelihood, as I'm doing this"
    } ]
  }, {
    "tStartMs": 1220080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and I'm oscillating in three dimensions,"
    } ]
  }, {
    "tStartMs": 1222640,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that the thermal energy is gonna drive me"
    } ]
  }, {
    "tStartMs": 1225360,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "to actually slip down rather\nthan just slip in one plane."
    } ]
  }, {
    "tStartMs": 1229120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So, now, if one cross slips,"
    } ]
  }, {
    "tStartMs": 1231120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "they're no longer on the same plane."
    } ]
  }, {
    "tStartMs": 1232960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Think of it as if we're standing in line,"
    } ]
  }, {
    "tStartMs": 1235280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and the only way that you can\nmove is I push you, right?"
    } ]
  }, {
    "tStartMs": 1238320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And then, I keep on pushing you,"
    } ]
  }, {
    "tStartMs": 1239600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and then suddenly, you drop."
    } ]
  }, {
    "tStartMs": 1240800,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So if I now try to push you,\nI cannot find you, right?"
    } ]
  }, {
    "tStartMs": 1243360,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You're not in front of me anymore."
    } ]
  }, {
    "tStartMs": 1244480,
    "dDurationMs": 2152,
    "segs": [ {
      "utf8": "Your shoulders are now below me."
    } ]
  }, {
    "tStartMs": 1246632,
    "dDurationMs": 3111,
    "segs": [ {
      "utf8": "- Well, how do you touch 'em? (laughs)"
    } ]
  }, {
    "tStartMs": 1249743,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(Jaafar laughs)"
    } ]
  }, {
    "tStartMs": 1249758,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "- I should have used the\nother example, you pushing me."
    } ]
  }, {
    "tStartMs": 1251680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But anyway.\n(both laughing)"
    } ]
  }, {
    "tStartMs": 1253600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "But it's exactly that."
    } ]
  }, {
    "tStartMs": 1255040,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It's the exact same analogy."
    } ]
  }, {
    "tStartMs": 1256480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "There's nothing to push me anymore."
    } ]
  }, {
    "tStartMs": 1257840,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "There's like, I am not able to do it."
    } ]
  }, {
    "tStartMs": 1260303,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1260318,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "- So now you've got these two dislocations"
    } ]
  }, {
    "tStartMs": 1262240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that are on different planes,"
    } ]
  }, {
    "tStartMs": 1263920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "so they can't travel together anymore."
    } ]
  }, {
    "tStartMs": 1265760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And as a result, they're\nboth now locked into place."
    } ]
  }, {
    "tStartMs": 1268480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And you can see that effect on this graph."
    } ]
  }, {
    "tStartMs": 1270560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "While steel and titanium\nstrength drops off,"
    } ]
  }, {
    "tStartMs": 1272960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "in the nickel super alloy,\nyou actually get a peak."
    } ]
  }, {
    "tStartMs": 1275680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That's because the extra thermal energy"
    } ]
  }, {
    "tStartMs": 1277360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "lets more dislocations\ncross-slip and get separated."
    } ]
  }, {
    "tStartMs": 1280560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And it's that that shuts down\nthe motion of dislocations."
    } ]
  }, {
    "tStartMs": 1283760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But if gamma prime is so strong,"
    } ]
  }, {
    "tStartMs": 1286160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "why don't we just make the\nentire turbine blade out of it?"
    } ]
  }, {
    "tStartMs": 1289040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Well, that strength comes at a cost."
    } ]
  }, {
    "tStartMs": 1290960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Gamma prime stops the\ndislocation so effectively"
    } ]
  }, {
    "tStartMs": 1293600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that it becomes brittle."
    } ]
  }, {
    "tStartMs": 1295360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "All it takes is one\ncrack or a sudden impact,"
    } ]
  }, {
    "tStartMs": 1297520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and it could lead to a sudden failure."
    } ]
  }, {
    "tStartMs": 1300080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So the real trick is in\nstriking the right balance"
    } ]
  }, {
    "tStartMs": 1302960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "between enough gamma prime\nto trap the dislocations"
    } ]
  }, {
    "tStartMs": 1305520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and to prevent this creep,"
    } ]
  }, {
    "tStartMs": 1306720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but also enough gamma to\nkeep the alloy ductile,"
    } ]
  }, {
    "tStartMs": 1309280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so that it can bend without breaking."
    } ]
  }, {
    "tStartMs": 1311200,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- [Derek] And in our test,"
    } ]
  }, {
    "tStartMs": 1312560,
    "dDurationMs": 2956,
    "segs": [ {
      "utf8": "you can see exactly how that plays out."
    } ]
  }, {
    "tStartMs": 1315516,
    "dDurationMs": 1764,
    "segs": [ {
      "utf8": "- A 1,000 degrees, and still nothing."
    } ]
  }, {
    "tStartMs": 1317280,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "- Still nothing."
    } ]
  }, {
    "tStartMs": 1320201,
    "dDurationMs": 28,
    "segs": [ {
      "utf8": "(ominous music)\n(mold clanks)"
    } ]
  }, {
    "tStartMs": 1320229,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "- [Howard] There we go."
    } ]
  }, {
    "tStartMs": 1321109,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "- [Emilia] Oh my gosh."
    } ]
  }, {
    "tStartMs": 1323493,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(suspense music)"
    } ]
  }, {
    "tStartMs": 1323509,
    "dDurationMs": 3611,
    "segs": [ {
      "utf8": "- [Howard] That's 1,100 degrees C."
    } ]
  }, {
    "tStartMs": 1327120,
    "dDurationMs": 3104,
    "segs": [ {
      "utf8": "- It's stretching."
    } ]
  }, {
    "tStartMs": 1330224,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(suspense music)"
    } ]
  }, {
    "tStartMs": 1330240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "I mean, it's still holding up like-"
    } ]
  }, {
    "tStartMs": 1332000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- It's doing a good job."
    } ]
  }, {
    "tStartMs": 1333840,
    "dDurationMs": 2788,
    "segs": [ {
      "utf8": "That's 1,200 degrees C."
    } ]
  }, {
    "tStartMs": 1336628,
    "dDurationMs": 177,
    "segs": [ {
      "utf8": "- [Emilia] 1,200. (laughs)"
    } ]
  }, {
    "tStartMs": 1336805,
    "dDurationMs": 2555,
    "segs": [ {
      "utf8": "- [Howard] That's the\ntemperature program that stops."
    } ]
  }, {
    "tStartMs": 1339360,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "And it's still surviving."
    } ]
  }, {
    "tStartMs": 1341029,
    "dDurationMs": 771,
    "segs": [ {
      "utf8": "- [Emilia] Still going."
    } ]
  }, {
    "tStartMs": 1341800,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- But if you push the temperature too far,"
    } ]
  }, {
    "tStartMs": 1344240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "even this alloy reaches its limits."
    } ]
  }, {
    "tStartMs": 1346480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Cross-slip becomes easier."
    } ]
  }, {
    "tStartMs": 1347920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The paired dislocations can now hop"
    } ]
  }, {
    "tStartMs": 1349760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "between the planes together,"
    } ]
  }, {
    "tStartMs": 1351440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and the ordered cubes of gamma\nprimes start to dissolve."
    } ]
  }, {
    "tStartMs": 1354320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So the dislocations break free,"
    } ]
  }, {
    "tStartMs": 1356000,
    "dDurationMs": 1909,
    "segs": [ {
      "utf8": "and it finally gives out."
    } ]
  }, {
    "tStartMs": 1357909,
    "dDurationMs": 1771,
    "segs": [ {
      "utf8": "- [Howard] Oh, it may\nhave just, did it break?"
    } ]
  }, {
    "tStartMs": 1359680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Oh, yeah, yeah, it did, it broke."
    } ]
  }, {
    "tStartMs": 1361280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- But strength alone isn't what\nmakes these alloys special."
    } ]
  }, {
    "tStartMs": 1365120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "When you heat up the alloy,\naluminum at the surface reacts"
    } ]
  }, {
    "tStartMs": 1368000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "with oxygen to form a\nthin continuous layer"
    } ]
  }, {
    "tStartMs": 1370800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "of aluminum oxide."
    } ]
  }, {
    "tStartMs": 1372400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Unlike the brittle oxides"
    } ]
  }, {
    "tStartMs": 1373680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that form on other materials\nlike steel or titanium,"
    } ]
  }, {
    "tStartMs": 1376800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "this layer stays intact\nat high temperatures,"
    } ]
  }, {
    "tStartMs": 1379280,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "protecting the metal below."
    } ]
  }, {
    "tStartMs": 1381824,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(suspense music)"
    } ]
  }, {
    "tStartMs": 1381840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And by adding other elements,"
    } ]
  }, {
    "tStartMs": 1383280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "we can tune these super alloys."
    } ]
  }, {
    "tStartMs": 1385360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Each one brings a specific\nproperty that we want."
    } ]
  }, {
    "tStartMs": 1388240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Most modern super alloys contain as many"
    } ]
  }, {
    "tStartMs": 1390320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "as 10 different elements,"
    } ]
  }, {
    "tStartMs": 1392000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "all carefully balanced in\ntheir relative abundances"
    } ]
  }, {
    "tStartMs": 1394720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "for the desired properties."
    } ]
  }, {
    "tStartMs": 1396720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Chromium improves resistance\nto oxidation and corrosion."
    } ]
  }, {
    "tStartMs": 1400160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Cobalt, titanium, niobium, tantalum,"
    } ]
  }, {
    "tStartMs": 1402560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and vanadium help stabilize\nthe gamma prime phase."
    } ]
  }, {
    "tStartMs": 1405760,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Molybdenum and iron\nstrengthen the gamma matrix."
    } ]
  }, {
    "tStartMs": 1408800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And then there's rhenium."
    } ]
  }, {
    "tStartMs": 1410240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Rhenium has one of the\nhighest melting points"
    } ]
  }, {
    "tStartMs": 1412240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of any metal at 3,180 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1415680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's second only to tungsten."
    } ]
  }, {
    "tStartMs": 1417600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "In the nickel super alloy,"
    } ]
  }, {
    "tStartMs": 1419040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It slows the atomic-scale rearrangements,"
    } ]
  }, {
    "tStartMs": 1421200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "enhancing the alloy's resistance"
    } ]
  }, {
    "tStartMs": 1422720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to deformation even at temperatures"
    } ]
  }, {
    "tStartMs": 1424800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "above 1,000 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1426960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It's one of the rarest\nelements in the Earth's crust"
    } ]
  }, {
    "tStartMs": 1429760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "at less than one part per billion."
    } ]
  }, {
    "tStartMs": 1432240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And more than 80%"
    } ]
  }, {
    "tStartMs": 1433680,
    "dDurationMs": 5103,
    "segs": [ {
      "utf8": "of what we mine ends up\nright here in jet engines."
    } ]
  }, {
    "tStartMs": 1438783,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1438798,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "- But even with these\nadvancements in alloy chemistry,"
    } ]
  }, {
    "tStartMs": 1441520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "there's still one fundamental problem."
    } ]
  }, {
    "tStartMs": 1444320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And that's that metals are crystalline."
    } ]
  }, {
    "tStartMs": 1446560,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Any metal you see from the\ntip of this ballpoint pen"
    } ]
  }, {
    "tStartMs": 1449920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to the spoon in my coffee cup,\nthey're all actually made up"
    } ]
  }, {
    "tStartMs": 1453280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of millions of little\ncrystals stuck together."
    } ]
  }, {
    "tStartMs": 1456240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It's kind of like grains\nin the sugar cube."
    } ]
  }, {
    "tStartMs": 1458480,
    "dDurationMs": 2865,
    "segs": [ {
      "utf8": "If I crush it..."
    } ]
  }, {
    "tStartMs": 1461345,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1461360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It's not like I've broken\nany individual crystal,"
    } ]
  }, {
    "tStartMs": 1464400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "I've just broken them apart."
    } ]
  }, {
    "tStartMs": 1466240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It's the boundaries between the grains"
    } ]
  }, {
    "tStartMs": 1468000,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "that are the weak point."
    } ]
  }, {
    "tStartMs": 1469040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And it's the same thing in a metal."
    } ]
  }, {
    "tStartMs": 1471120,
    "dDurationMs": 494,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1471614,
    "dDurationMs": 1826,
    "segs": [ {
      "utf8": "- So, if we zoom out from the gamma"
    } ]
  }, {
    "tStartMs": 1473440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and gamma prime structure,\nit looks something like this."
    } ]
  }, {
    "tStartMs": 1476720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "One crystal is basically a\nthree-dimensional lattice"
    } ]
  }, {
    "tStartMs": 1479040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "of atoms all lined up\nin the same orientation."
    } ]
  }, {
    "tStartMs": 1481520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But the crystals themselves are"
    } ]
  }, {
    "tStartMs": 1483200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "all in different orientations."
    } ]
  }, {
    "tStartMs": 1485280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So where they meet, their\nlattices don't line up."
    } ]
  }, {
    "tStartMs": 1487920,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And that mismatch leaves more\nopen spaces and broken bonds."
    } ]
  }, {
    "tStartMs": 1491680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And you also get defects there,"
    } ]
  }, {
    "tStartMs": 1493280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "like vacancies and impurities,"
    } ]
  }, {
    "tStartMs": 1495200,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "all of which make grain\nboundaries the weakest point."
    } ]
  }, {
    "tStartMs": 1498640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And this also has another consequence."
    } ]
  }, {
    "tStartMs": 1500640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It makes it easier for atoms\nto move along the boundaries."
    } ]
  }, {
    "tStartMs": 1504000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "They become kind of super\nhighways for atomic diffusion."
    } ]
  }, {
    "tStartMs": 1507440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "This becomes even more"
    } ]
  }, {
    "tStartMs": 1508480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "of a problem at high\ntemperatures when atoms have"
    } ]
  }, {
    "tStartMs": 1510800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "more energy to move around,"
    } ]
  }, {
    "tStartMs": 1512720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "add stress like the\nmassive centrifugal loads"
    } ]
  }, {
    "tStartMs": 1515520,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "on a turbine blade, and the\ngrains can actually start"
    } ]
  }, {
    "tStartMs": 1518560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to slide past each other."
    } ]
  }, {
    "tStartMs": 1520080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The whole structure slowly\ndeforms, stretching,"
    } ]
  }, {
    "tStartMs": 1523200,
    "dDurationMs": 2305,
    "segs": [ {
      "utf8": "almost like warm taffy."
    } ]
  }, {
    "tStartMs": 1525505,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1525520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "As long as it has grains\nin it, it will creep,"
    } ]
  }, {
    "tStartMs": 1528080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and fail far more easily."
    } ]
  }, {
    "tStartMs": 1530080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And that's a really hard problem to solve"
    } ]
  }, {
    "tStartMs": 1532160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because normally, as a molten alloy cools,"
    } ]
  }, {
    "tStartMs": 1535040,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "tiny crystals start to form\nall throughout the liquid."
    } ]
  }, {
    "tStartMs": 1538320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So you have to find some\nway to control them."
    } ]
  }, {
    "tStartMs": 1541120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- This is one of our furnaces."
    } ]
  }, {
    "tStartMs": 1543280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "They're all induction-heated,\nthere's no kind of gas, fire,"
    } ]
  }, {
    "tStartMs": 1546320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "or anything like that, and\nthey're all under vacuum."
    } ]
  }, {
    "tStartMs": 1548400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So, we only cast to the\nvacuum in the absence"
    } ]
  }, {
    "tStartMs": 1550480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of any atmosphere, but\nparticularly oxygen,"
    } ]
  }, {
    "tStartMs": 1552400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "which is obviously metallurgically\ngonna cause us all kinds"
    } ]
  }, {
    "tStartMs": 1554960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of problems with oxides."
    } ]
  }, {
    "tStartMs": 1556160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- [Derek] You start by\npouring molten super alloy"
    } ]
  }, {
    "tStartMs": 1558640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "into a ceramic mold\nthat's mounted vertically"
    } ]
  }, {
    "tStartMs": 1560960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and heated to about the same\ntemperature as the melt."
    } ]
  }, {
    "tStartMs": 1563600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The mold fills from the\nroot up toward the tip."
    } ]
  }, {
    "tStartMs": 1566640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "At the very bottom of the mold sits"
    } ]
  }, {
    "tStartMs": 1568400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a copper plate cooled by water."
    } ]
  }, {
    "tStartMs": 1570320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Its surface is patterned\nwith tiny grooves that act"
    } ]
  }, {
    "tStartMs": 1572720,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "as nucleation points"
    } ]
  }, {
    "tStartMs": 1573760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for the first crystals to start to form."
    } ]
  }, {
    "tStartMs": 1576160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It's here that solidification begins."
    } ]
  }, {
    "tStartMs": 1578960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Then, the entire mold is slowly\nlowered out of the hot zone,"
    } ]
  }, {
    "tStartMs": 1582880,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "so the solidification continues\nin just one direction."
    } ]
  }, {
    "tStartMs": 1585960,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "- It's a very slow process\nin the magnitude of hours."
    } ]
  }, {
    "tStartMs": 1589040,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Once that's finished,"
    } ]
  }, {
    "tStartMs": 1590160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the whole machine will then index round,"
    } ]
  }, {
    "tStartMs": 1592560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and it will push the completed mold"
    } ]
  }, {
    "tStartMs": 1594240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "up out of the other side."
    } ]
  }, {
    "tStartMs": 1596080,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "- Oh."
    } ]
  }, {
    "tStartMs": 1597903,
    "dDurationMs": 17,
    "segs": [ {
      "utf8": "(machine humming)"
    } ]
  }, {
    "tStartMs": 1597920,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 1598280,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- So our casting temperatures are"
    } ]
  }, {
    "tStartMs": 1600480,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "roughly 1,500 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1602360,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- It's kind of at the same\ntemperature now as it would be"
    } ]
  }, {
    "tStartMs": 1605680,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "inside the jet engine.\n- Exactly."
    } ]
  }, {
    "tStartMs": 1607013,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "- It's absurd, they like,"
    } ]
  }, {
    "tStartMs": 1608160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you're making the turbine blades"
    } ]
  }, {
    "tStartMs": 1609840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "at the same temperature\nthat they're gonna operate,"
    } ]
  }, {
    "tStartMs": 1611360,
    "dDurationMs": 2305,
    "segs": [ {
      "utf8": "but they like, here, they're liquid."
    } ]
  }, {
    "tStartMs": 1613665,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1613680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now, if we just did that\non its own, you'd end up"
    } ]
  }, {
    "tStartMs": 1616320,
    "dDurationMs": 2783,
    "segs": [ {
      "utf8": "with a blade that looks like this."
    } ]
  }, {
    "tStartMs": 1619103,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1619118,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "- Here's a directionally solidified blade."
    } ]
  }, {
    "tStartMs": 1622240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And what you can probably\nsee there is the contrast"
    } ]
  }, {
    "tStartMs": 1625520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "between the grains."
    } ]
  }, {
    "tStartMs": 1627120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "These are all different crystals,"
    } ]
  }, {
    "tStartMs": 1628800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "but they're all running\non this axis of the blade,"
    } ]
  }, {
    "tStartMs": 1632560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which makes it significantly stronger"
    } ]
  }, {
    "tStartMs": 1634480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "than an alloy that is cast,"
    } ]
  }, {
    "tStartMs": 1636480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "where all of the crystals\nare separate from each other."
    } ]
  }, {
    "tStartMs": 1638800,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- So those are like individual crystals."
    } ]
  }, {
    "tStartMs": 1640920,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- [Henry] These are individual\ncrystals, yeah, absolutely."
    } ]
  }, {
    "tStartMs": 1643520,
    "dDurationMs": 1518,
    "segs": [ {
      "utf8": "So we are looking at-\n- Wow."
    } ]
  }, {
    "tStartMs": 1645038,
    "dDurationMs": 2242,
    "segs": [ {
      "utf8": "- At crystals on kind of a macro level,"
    } ]
  }, {
    "tStartMs": 1647280,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "where normally, we'd be talking"
    } ]
  }, {
    "tStartMs": 1648400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "about crystals on a micro level."
    } ]
  }, {
    "tStartMs": 1651600,
    "dDurationMs": 71,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1651671,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "- In a rotating turbine,"
    } ]
  }, {
    "tStartMs": 1653040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the blade is being\npulled along its length."
    } ]
  }, {
    "tStartMs": 1655200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "With columnar crystals all\nlined up along this span,"
    } ]
  }, {
    "tStartMs": 1658080,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the blade can carry those\nstresses far more effectively."
    } ]
  }, {
    "tStartMs": 1661120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "There are no grain boundaries"
    } ]
  }, {
    "tStartMs": 1662320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that cut across the blade,\ncreating weak points"
    } ]
  }, {
    "tStartMs": 1664400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "for it to crack."
    } ]
  }, {
    "tStartMs": 1665680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "But scientists have found\na way to do even better."
    } ]
  }, {
    "tStartMs": 1668720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "If you introduce a bend in the mold"
    } ]
  }, {
    "tStartMs": 1671040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "just above the chill plate,\nsomething strange happens."
    } ]
  }, {
    "tStartMs": 1674160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The number of columnar\ncrystals that make it"
    } ]
  }, {
    "tStartMs": 1676720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "through drops sharply."
    } ]
  }, {
    "tStartMs": 1678560,
    "dDurationMs": 3905,
    "segs": [ {
      "utf8": "And if you add another\nbend, even fewer survive."
    } ]
  }, {
    "tStartMs": 1682465,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1682480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, engineers added a\nhelical passage known"
    } ]
  }, {
    "tStartMs": 1685360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "as the pigtail here at\nthe bottom of the mold."
    } ]
  }, {
    "tStartMs": 1687760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- The pigtail is doing the job\nto select the single crystal."
    } ]
  }, {
    "tStartMs": 1691280,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "The spiral is gonna choke out\nevery other grain bar one."
    } ]
  }, {
    "tStartMs": 1695920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So we're only gonna have one\ngrain that is then gonna grow"
    } ]
  }, {
    "tStartMs": 1698880,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "through the entirety of that blade,"
    } ]
  }, {
    "tStartMs": 1701200,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and cast that blade as a single crystal."
    } ]
  }, {
    "tStartMs": 1703440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Or at least, that's the theory."
    } ]
  }, {
    "tStartMs": 1705040,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- That's crazy."
    } ]
  }, {
    "tStartMs": 1706560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- So this is a starter\nattached to a spiral"
    } ]
  }, {
    "tStartMs": 1709200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that we've etched so that we\ncan reveal that structure."
    } ]
  }, {
    "tStartMs": 1711680,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "So you can see down at the\nbottom, we are starting"
    } ]
  }, {
    "tStartMs": 1715440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "to grow directionally solidified grains."
    } ]
  }, {
    "tStartMs": 1718720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But as we get up here, we can start to see"
    } ]
  }, {
    "tStartMs": 1720640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "that we're growing\ndirectionally solidified grains."
    } ]
  }, {
    "tStartMs": 1723920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And then, as we're going up the spiral,"
    } ]
  }, {
    "tStartMs": 1727040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "the grains are starting to be choked out"
    } ]
  }, {
    "tStartMs": 1728800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "by the upper surfaces of that\nspiral until, when we get"
    } ]
  }, {
    "tStartMs": 1731920,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to the top, we're just\nas a single crystal."
    } ]
  }, {
    "tStartMs": 1734000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And then, that then allows that"
    } ]
  }, {
    "tStartMs": 1735920,
    "dDurationMs": 2072,
    "segs": [ {
      "utf8": "to grow right the way through the blade."
    } ]
  }, {
    "tStartMs": 1737992,
    "dDurationMs": 368,
    "segs": [ {
      "utf8": "- Yeah, that's amazing."
    } ]
  }, {
    "tStartMs": 1738360,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- And what we should end up\nwith is a blade like this."
    } ]
  }, {
    "tStartMs": 1741680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So this is a blade of a single crystal."
    } ]
  }, {
    "tStartMs": 1744640,
    "dDurationMs": 2705,
    "segs": [ {
      "utf8": "It's a really impressive thing to look at."
    } ]
  }, {
    "tStartMs": 1747345,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 1747360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The shimmer is beautiful."
    } ]
  }, {
    "tStartMs": 1748800,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1749640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Even after the blade solidifies,"
    } ]
  }, {
    "tStartMs": 1751680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "it's still not ready for the engine."
    } ]
  }, {
    "tStartMs": 1753520,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It's heated again, almost\nto its melting point."
    } ]
  }, {
    "tStartMs": 1756240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And that might sound risky"
    } ]
  }, {
    "tStartMs": 1757840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "because we've spent all\nthis time making sure it's"
    } ]
  }, {
    "tStartMs": 1759840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "a perfect single crystal."
    } ]
  }, {
    "tStartMs": 1761600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But this heating step lets\nthe atoms shuffle around"
    } ]
  }, {
    "tStartMs": 1764480,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "just enough to spread out evenly,"
    } ]
  }, {
    "tStartMs": 1767040,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and form the final desired\nmicrostructure of the gamma"
    } ]
  }, {
    "tStartMs": 1770480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and gamma prime phases"
    } ]
  }, {
    "tStartMs": 1771680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that make these super alloys so strong."
    } ]
  }, {
    "tStartMs": 1774240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- And as if casting, as a\nsingle crystal is not enough,"
    } ]
  }, {
    "tStartMs": 1777360,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "actually, the orientation\nof that crystal is"
    } ]
  }, {
    "tStartMs": 1780640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "also of paramount significance."
    } ]
  }, {
    "tStartMs": 1782880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So you may have cast\nthis as a single crystal,"
    } ]
  }, {
    "tStartMs": 1785840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "but if the crystal orientation is off"
    } ]
  }, {
    "tStartMs": 1788160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "by a certain amount,"
    } ]
  }, {
    "tStartMs": 1789360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "you get completely\ndifferent stress responses"
    } ]
  }, {
    "tStartMs": 1792480,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "within that blade."
    } ]
  }, {
    "tStartMs": 1793400,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "- Today, after decades\nof development, over 95%"
    } ]
  }, {
    "tStartMs": 1797280,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "of blades can be cast\nsuccessfully as single crystals."
    } ]
  }, {
    "tStartMs": 1801440,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Just think about how incredible that is."
    } ]
  }, {
    "tStartMs": 1804000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "We've gone from a turbine blade\nthat contained on the order"
    } ]
  }, {
    "tStartMs": 1806720,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "of 50,000 crystal grains down to just one."
    } ]
  }, {
    "tStartMs": 1810960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "When we grow these things,\nthey don't solidify"
    } ]
  }, {
    "tStartMs": 1813360,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as a uniform front."
    } ]
  }, {
    "tStartMs": 1815280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "On a microscopic scale,"
    } ]
  }, {
    "tStartMs": 1816640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the solidification front\nlooks like a forest"
    } ]
  }, {
    "tStartMs": 1819440,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of tiny tree-like\nbranches called dendrites"
    } ]
  }, {
    "tStartMs": 1822400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that are pushing their\nway into the liquid."
    } ]
  }, {
    "tStartMs": 1824880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "At first glance, it looks\nmessy, like millions"
    } ]
  }, {
    "tStartMs": 1827680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "of separate trees jostling for space."
    } ]
  }, {
    "tStartMs": 1830400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "There are up to 10 elements in there,"
    } ]
  }, {
    "tStartMs": 1832800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "each with its own density\nand melting point."
    } ]
  }, {
    "tStartMs": 1835440,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Yet somehow, every one\nof those trees is locked"
    } ]
  }, {
    "tStartMs": 1839600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "into the exact same crystal lattice."
    } ]
  }, {
    "tStartMs": 1842160,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "So the final crystal is comprised\nof more than six times 10"
    } ]
  }, {
    "tStartMs": 1846040,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "to the 24 atoms,"
    } ]
  }, {
    "tStartMs": 1847680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that is more stars than there are"
    } ]
  }, {
    "tStartMs": 1850000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in the observable universe."
    } ]
  }, {
    "tStartMs": 1851920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "When all these atoms are\nrepeating the same pattern,"
    } ]
  }, {
    "tStartMs": 1855040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "perfectly aligned from root to tip,"
    } ]
  }, {
    "tStartMs": 1858160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "this completely transformed\nwhat jet engines can do."
    } ]
  }, {
    "tStartMs": 1861280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Single-crystal blades\ncan withstand stresses"
    } ]
  }, {
    "tStartMs": 1863600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and temperatures that would\ndestroy ordinary alloys."
    } ]
  }, {
    "tStartMs": 1866560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They last up to nine\ntimes longer against creep"
    } ]
  }, {
    "tStartMs": 1869200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and thermal fatigue,"
    } ]
  }, {
    "tStartMs": 1870400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and are more than three\ntimes more resistant"
    } ]
  }, {
    "tStartMs": 1872560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "to corrosion than blades\nmade from multiple grains."
    } ]
  }, {
    "tStartMs": 1875600,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "That's why modern jet engines\ncan now run for 25,000 hours"
    } ]
  }, {
    "tStartMs": 1879280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "between major overhauls,"
    } ]
  }, {
    "tStartMs": 1881040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "something that would've been unthinkable"
    } ]
  }, {
    "tStartMs": 1882720,
    "dDurationMs": 2784,
    "segs": [ {
      "utf8": "before single crystal blades."
    } ]
  }, {
    "tStartMs": 1885504,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(suspense music)"
    } ]
  }, {
    "tStartMs": 1885520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And the impact has been huge."
    } ]
  }, {
    "tStartMs": 1887360,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Between 1960 and 2010,"
    } ]
  }, {
    "tStartMs": 1889280,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "jet aircraft became about\n55% more fuel efficient."
    } ]
  }, {
    "tStartMs": 1893520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And a huge part of that\nimprovement comes down"
    } ]
  }, {
    "tStartMs": 1895760,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to advances in these nickel super alloys."
    } ]
  }, {
    "tStartMs": 1898720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Back in the 1960s,"
    } ]
  }, {
    "tStartMs": 1900080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "flying was a luxury few could afford."
    } ]
  }, {
    "tStartMs": 1902320,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "A one-way flight from New York"
    } ]
  }, {
    "tStartMs": 1903680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to Paris would set you back $310,"
    } ]
  }, {
    "tStartMs": 1906320,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "which is about $3,750\nadjusted for inflation."
    } ]
  }, {
    "tStartMs": 1910480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But as engines became more efficient,"
    } ]
  }, {
    "tStartMs": 1912400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "able to handle hotter cores"
    } ]
  }, {
    "tStartMs": 1914240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and equipped with much larger fans,"
    } ]
  }, {
    "tStartMs": 1916560,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "airlines could carry more\npeople farther using less fuel."
    } ]
  }, {
    "tStartMs": 1920160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So, tickets got cheaper\nand air travel exploded."
    } ]
  }, {
    "tStartMs": 1923280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Today, at any given moment,\nthere are roughly 10,000"
    } ]
  }, {
    "tStartMs": 1926160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to 14,000 planes in the sky."
    } ]
  }, {
    "tStartMs": 1928880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That scale of movement is possible"
    } ]
  }, {
    "tStartMs": 1930800,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "because of these turbine blades."
    } ]
  }, {
    "tStartMs": 1935200,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "(jet hovering)"
    } ]
  }, {
    "tStartMs": 1935360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "In the furnace, the nickel\nsuper alloy outperforms"
    } ]
  }, {
    "tStartMs": 1938080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "all the other samples,"
    } ]
  }, {
    "tStartMs": 1939280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "surviving up to 1,200 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1942480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But wait, that's still 300 degrees less"
    } ]
  }, {
    "tStartMs": 1944960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "than the temperature inside a jet engine."
    } ]
  }, {
    "tStartMs": 1947520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So why don't the blades melt?"
    } ]
  }, {
    "tStartMs": 1949840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Well, there are two\nfinal layers of defense."
    } ]
  }, {
    "tStartMs": 1952880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The first is built into the\nshape of the blade itself."
    } ]
  }, {
    "tStartMs": 1955520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- We then have to leach the core out."
    } ]
  }, {
    "tStartMs": 1957840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So we do that in a caustic solution"
    } ]
  }, {
    "tStartMs": 1960800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of potassium-sodium\nhydroxide under pressure"
    } ]
  }, {
    "tStartMs": 1964240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and temperature to leach the core out,"
    } ]
  }, {
    "tStartMs": 1967040,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "that will leave those core\npassages completely empty."
    } ]
  }, {
    "tStartMs": 1971110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Derek] And those\npassages are the real secret"
    } ]
  }, {
    "tStartMs": 1973360,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "to the turbine blade survival."
    } ]
  }, {
    "tStartMs": 1974760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- So as the air's flowing\nthrough, it is turbulent,"
    } ]
  }, {
    "tStartMs": 1978240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and as such, it can remove much more heat"
    } ]
  }, {
    "tStartMs": 1980480,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "from the surface of the blade."
    } ]
  }, {
    "tStartMs": 1981640,
    "dDurationMs": 1398,
    "segs": [ {
      "utf8": "- Yeah.\n- Than it was."
    } ]
  }, {
    "tStartMs": 1983038,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "- Is it these ridges here\nthat we're talking about?"
    } ]
  }, {
    "tStartMs": 1984943,
    "dDurationMs": 777,
    "segs": [ {
      "utf8": "- Exactly, yeah, yeah, these ridges here."
    } ]
  }, {
    "tStartMs": 1985720,
    "dDurationMs": 3238,
    "segs": [ {
      "utf8": "- [Derek] They're intentional\nto the trip the flow into-"
    } ]
  }, {
    "tStartMs": 1988958,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "- Trip and turbulate that air\nflow so that it's removing"
    } ]
  }, {
    "tStartMs": 1991360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "as much heat as possible from the metal."
    } ]
  }, {
    "tStartMs": 1993360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So then we get onto the really juicy part,"
    } ]
  }, {
    "tStartMs": 1995200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "which is film cooling."
    } ]
  }, {
    "tStartMs": 1996480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So we talked about the\nice cube in the ovens"
    } ]
  }, {
    "tStartMs": 1998800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that keeping our blades\nas cool as possible."
    } ]
  }, {
    "tStartMs": 2001680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So this is where we start to drill in"
    } ]
  }, {
    "tStartMs": 2003440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "what we call film cool holes."
    } ]
  }, {
    "tStartMs": 2005280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And what we're aiming\nto do is we're aiming"
    } ]
  }, {
    "tStartMs": 2007600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to get into those cooling passages."
    } ]
  }, {
    "tStartMs": 2009600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So we saw that core earlier on."
    } ]
  }, {
    "tStartMs": 2011760,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "They are the cooling passages inside."
    } ]
  }, {
    "tStartMs": 2014080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And these holes have got"
    } ]
  }, {
    "tStartMs": 2015600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to get right into those cooling passages"
    } ]
  }, {
    "tStartMs": 2017520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to allow the air to come out."
    } ]
  }, {
    "tStartMs": 2019600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And the air is then gonna blow\nas a film over the surface"
    } ]
  }, {
    "tStartMs": 2022960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "of the blade, a film-cool\nhole to create a film"
    } ]
  }, {
    "tStartMs": 2026000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "of air, which is preventing"
    } ]
  }, {
    "tStartMs": 2027600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that metal from melting\nin those temperatures."
    } ]
  }, {
    "tStartMs": 2030960,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "- This cooling air isn't exactly cold."
    } ]
  }, {
    "tStartMs": 2034400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It actually comes from the\nhigh-pressure compressor section"
    } ]
  }, {
    "tStartMs": 2036800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "of the engine at around\n600 degrees Celsius."
    } ]
  }, {
    "tStartMs": 2039520,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "But that is cool enough"
    } ]
  }, {
    "tStartMs": 2040560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to help keep the blades from melting."
    } ]
  }, {
    "tStartMs": 2042720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But it's still not quite enough."
    } ]
  }, {
    "tStartMs": 2044720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And you can't just add more cooling air"
    } ]
  }, {
    "tStartMs": 2047120,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "because every extra bit of air\nyou use from the compressor,"
    } ]
  }, {
    "tStartMs": 2050800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you lose from thrust,"
    } ]
  }, {
    "tStartMs": 2052240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and actually make the\nengine less efficient."
    } ]
  }, {
    "tStartMs": 2054800,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So every turbine blade is also coated"
    } ]
  }, {
    "tStartMs": 2057360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "with two protective layers."
    } ]
  }, {
    "tStartMs": 2059120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "First, a thin metallic bond\ncoat that resists oxidation,"
    } ]
  }, {
    "tStartMs": 2063120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and then a ceramic topcoat."
    } ]
  }, {
    "tStartMs": 2065360,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Even though it's only about a\nquarter of a millimeter thick,"
    } ]
  }, {
    "tStartMs": 2068320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "this ceramic coating can\nkeep the metal beneath it"
    } ]
  }, {
    "tStartMs": 2071040,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "100 to 170 degrees cooler\nthan it would otherwise be."
    } ]
  }, {
    "tStartMs": 2075200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And this is the final barrier"
    } ]
  }, {
    "tStartMs": 2076640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that stops the blades from melting."
    } ]
  }, {
    "tStartMs": 2078960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So, now we've got this\ninsane piece of engineering"
    } ]
  }, {
    "tStartMs": 2081680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that can survive the 1,500-degree gas."
    } ]
  }, {
    "tStartMs": 2084560,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "The intense load and the oxidation\nproblem should be solved."
    } ]
  }, {
    "tStartMs": 2089280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Well, it would be, except for one thing,"
    } ]
  }, {
    "tStartMs": 2093120,
    "dDurationMs": 141,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 2093261,
    "dDurationMs": 3459,
    "segs": [ {
      "utf8": "- At 36,000 feet, you\nwouldn't believe this,"
    } ]
  }, {
    "tStartMs": 2096720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "but there's dirt and\ndust in the atmosphere"
    } ]
  }, {
    "tStartMs": 2099680,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "that our engines are ingesting."
    } ]
  }, {
    "tStartMs": 2102225,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 2102240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The dirt and dust comes,\nit sticks on the blades,"
    } ]
  }, {
    "tStartMs": 2104960,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "but it also goes through\nthe whole cooling circuit,"
    } ]
  }, {
    "tStartMs": 2108160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and it walks the cooling\nfrom getting through"
    } ]
  }, {
    "tStartMs": 2111920,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "to cool the blades, and\nthen the blades burn up."
    } ]
  }, {
    "tStartMs": 2115680,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Usually, every time I get on a plane,"
    } ]
  }, {
    "tStartMs": 2117200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "I'm thinking, \"This is\nnever gonna work.\" (laughs)"
    } ]
  }, {
    "tStartMs": 2119680,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "No, I mean it's incredible\nhow an engine can work"
    } ]
  }, {
    "tStartMs": 2123120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "'cause there's so many moving\npieces, there's so many parts"
    } ]
  }, {
    "tStartMs": 2125440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to the environment, so terrible."
    } ]
  }, {
    "tStartMs": 2127200,
    "dDurationMs": 4783,
    "segs": [ {
      "utf8": "And now, we have this dust\nand dirt, which is really bad."
    } ]
  }, {
    "tStartMs": 2131983,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 2131998,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "- I am at Testbed 80,"
    } ]
  }, {
    "tStartMs": 2133760,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and they're about to\nfire up this jet engine"
    } ]
  }, {
    "tStartMs": 2136560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and then throw dust into it."
    } ]
  }, {
    "tStartMs": 2139040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The same stuff that makes\nup sand and volcanic ash,"
    } ]
  }, {
    "tStartMs": 2142240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "exactly what real engines\nencounter in flight."
    } ]
  }, {
    "tStartMs": 2144880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- So this engine is the 97K."
    } ]
  }, {
    "tStartMs": 2147280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "It goes on the A350"
    } ]
  }, {
    "tStartMs": 2148560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and is our high-thrust version of that."
    } ]
  }, {
    "tStartMs": 2150400,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "So 97,000 pounds of thrust is\nwhat this engine's producing."
    } ]
  }, {
    "tStartMs": 2154160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "When we're running a bit\nan engine like this, we try"
    } ]
  }, {
    "tStartMs": 2156240,
    "dDurationMs": 6383,
    "segs": [ {
      "utf8": "and carefully recreate exactly\nwhat happens in service,"
    } ]
  }, {
    "tStartMs": 2162623,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 2162638,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "- How much dust goes"
    } ]
  }, {
    "tStartMs": 2163760,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "in the engine?\n- Not very much."
    } ]
  }, {
    "tStartMs": 2165520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It was surprising when I found out"
    } ]
  }, {
    "tStartMs": 2166720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "exactly how much we put in."
    } ]
  }, {
    "tStartMs": 2167920,
    "dDurationMs": 3352,
    "segs": [ {
      "utf8": "It's in the order of\ntablespoons worth per cycle."
    } ]
  }, {
    "tStartMs": 2171272,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "- So, I (indistinct) master on."
    } ]
  }, {
    "tStartMs": 2173040,
    "dDurationMs": 3007,
    "segs": [ {
      "utf8": "Condition power on."
    } ]
  }, {
    "tStartMs": 2176047,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(fan swooshing)"
    } ]
  }, {
    "tStartMs": 2176062,
    "dDurationMs": 18,
    "segs": [ {
      "utf8": "(buttons clicking)"
    } ]
  }, {
    "tStartMs": 2176080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Master fuel lever on."
    } ]
  }, {
    "tStartMs": 2177600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Start request in three, two, one."
    } ]
  }, {
    "tStartMs": 2180640,
    "dDurationMs": 7805,
    "segs": [ {
      "utf8": "Now.\n(computer beeps)"
    } ]
  }, {
    "tStartMs": 2188445,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 2188460,
    "dDurationMs": 18,
    "segs": [ {
      "utf8": "(blades swooshing)"
    } ]
  }, {
    "tStartMs": 2188478,
    "dDurationMs": 3482,
    "segs": [ {
      "utf8": "- So, what does the dust\nactually do inside a jet engine?"
    } ]
  }, {
    "tStartMs": 2191960,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- So, once it goes through to\nthe hot section of the engine"
    } ]
  }, {
    "tStartMs": 2194960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and hits kind of turbine\nblades, it's gonna be melted."
    } ]
  }, {
    "tStartMs": 2197760,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And so, it sticks to the outside\nof our turbine components"
    } ]
  }, {
    "tStartMs": 2201680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and it slowly rips layers"
    } ]
  }, {
    "tStartMs": 2203280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of that thermal barrier coating off."
    } ]
  }, {
    "tStartMs": 2206240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And then, you lose your\ntemperature reduction"
    } ]
  }, {
    "tStartMs": 2209680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "that comes from the barrier coating,"
    } ]
  }, {
    "tStartMs": 2211040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "so that your nickel alloy\nunderneath it gets hotter"
    } ]
  }, {
    "tStartMs": 2213600,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and hotter, and that's when it starts"
    } ]
  }, {
    "tStartMs": 2214960,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "to deteriorate the turbine."
    } ]
  }, {
    "tStartMs": 2218960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "(blades swooshing)"
    } ]
  }, {
    "tStartMs": 2221480,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- That's why engineers at\nRolls-Royce are still refining"
    } ]
  }, {
    "tStartMs": 2224320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "these blades, developing new\nceramic coatings designed"
    } ]
  }, {
    "tStartMs": 2227280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to resist mold and dust,"
    } ]
  }, {
    "tStartMs": 2228720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and extend the life of\nthe turbine by up to 30%."
    } ]
  }, {
    "tStartMs": 2232080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "That's just the latest step in a story"
    } ]
  }, {
    "tStartMs": 2233920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that's been unfolding for decades."
    } ]
  }, {
    "tStartMs": 2235920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "These blades have been refined"
    } ]
  }, {
    "tStartMs": 2237520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and perfected to the point"
    } ]
  }, {
    "tStartMs": 2239120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where they operate right at the edge"
    } ]
  }, {
    "tStartMs": 2241280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "of what is physically possible."
    } ]
  }, {
    "tStartMs": 2243280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "You're always on a knife-edge,\npushing every material,"
    } ]
  }, {
    "tStartMs": 2246400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "every process to the\nlimit to build an engine"
    } ]
  }, {
    "tStartMs": 2248640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that can do the seemingly impossible,"
    } ]
  }, {
    "tStartMs": 2250960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "run hotter than its own melting point."
    } ]
  }, {
    "tStartMs": 2253440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The more I learned about\nthe brutal environment"
    } ]
  }, {
    "tStartMs": 2255680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "these blades have to\nsurvive, the more it felt"
    } ]
  }, {
    "tStartMs": 2258560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "like they shouldn't work at all."
    } ]
  }, {
    "tStartMs": 2260720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And yet, they do."
    } ]
  }, {
    "tStartMs": 2262400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Every day, these machines\ncarry millions of people"
    } ]
  }, {
    "tStartMs": 2265360,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "across the world and we barely\nstop to think about them,"
    } ]
  }, {
    "tStartMs": 2268640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "they're a monument to human ingenuity."
    } ]
  }, {
    "tStartMs": 2271120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "What happens when we refuse"
    } ]
  }, {
    "tStartMs": 2272480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to accept limits, when\nwe turn the impossible"
    } ]
  }, {
    "tStartMs": 2275200,
    "dDurationMs": 6350,
    "segs": [ {
      "utf8": "into the routine?"
    } ]
  }, {
    "tStartMs": 2281550,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(ominous music)"
    } ]
  }, {
    "tStartMs": 2281565,
    "dDurationMs": 35,
    "segs": [ {
      "utf8": "(scene change zooms)\n(ominous music)"
    } ]
  }, {
    "tStartMs": 2281600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "I can't grow a single-crystal\nturbine blade in my kitchen,"
    } ]
  }, {
    "tStartMs": 2285120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but with the help from\nthis video sponsor, KiwiCo,"
    } ]
  }, {
    "tStartMs": 2287760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I can grow a crystal garden with my kids."
    } ]
  }, {
    "tStartMs": 2291040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "This month, they sent us their\nCrystal Garden Chemistry Kit."
    } ]
  }, {
    "tStartMs": 2294240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "We set everything in place,\nmixed up the chemical solution,"
    } ]
  }, {
    "tStartMs": 2296800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and then watched as\ncolorful crystals started"
    } ]
  }, {
    "tStartMs": 2299040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to bloom over the next 48 hours."
    } ]
  }, {
    "tStartMs": 2301360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Every few hours, my kids\nwould run back to check"
    } ]
  }, {
    "tStartMs": 2303840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "how much the garden had grown."
    } ]
  }, {
    "tStartMs": 2305360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They were totally fascinated,"
    } ]
  }, {
    "tStartMs": 2306800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and it sparked so many\nquestions about crystals"
    } ]
  }, {
    "tStartMs": 2309520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and atoms, how things arrange."
    } ]
  }, {
    "tStartMs": 2311600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Pretty soon, we were talking"
    } ]
  }, {
    "tStartMs": 2312560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "about how metals are crystalline, too,"
    } ]
  }, {
    "tStartMs": 2314960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and setting ourselves the challenge"
    } ]
  }, {
    "tStartMs": 2316400,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "of growing one giant\ncrystal turbine-blade style."
    } ]
  }, {
    "tStartMs": 2319901,
    "dDurationMs": 19,
    "segs": [ {
      "utf8": "(camera shuttering)"
    } ]
  }, {
    "tStartMs": 2319920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I love how simple KiwiCo makes this."
    } ]
  }, {
    "tStartMs": 2322080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Everything we needed\ncame right in the box,"
    } ]
  }, {
    "tStartMs": 2324320,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "so we could just open it up"
    } ]
  }, {
    "tStartMs": 2325680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and dive straight in,\ndoing the experiment."
    } ]
  }, {
    "tStartMs": 2328240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And it's not just chemistry."
    } ]
  }, {
    "tStartMs": 2329840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "They've got crates for robotics,"
    } ]
  }, {
    "tStartMs": 2331440,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "engineering, art, design\ntechniques, and so much more."
    } ]
  }, {
    "tStartMs": 2334960,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "There is something for\nevery age and interest."
    } ]
  }, {
    "tStartMs": 2337899,
    "dDurationMs": 21,
    "segs": [ {
      "utf8": "(scene change chimes)"
    } ]
  }, {
    "tStartMs": 2337920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "KiwiCo crates also make a\ngreat gift for the holidays."
    } ]
  }, {
    "tStartMs": 2341200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It's creative, hands-on,"
    } ]
  }, {
    "tStartMs": 2342720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and gives kids something\nthey can actually make"
    } ]
  }, {
    "tStartMs": 2344960,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "and be proud of."
    } ]
  }, {
    "tStartMs": 2345840,
    "dDurationMs": 2718,
    "segs": [ {
      "utf8": "- They're kind of messy.\n- Mm-hmm."
    } ]
  }, {
    "tStartMs": 2348558,
    "dDurationMs": 4402,
    "segs": [ {
      "utf8": "- And like hard to make, but not too hard,"
    } ]
  }, {
    "tStartMs": 2352960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but hard enough to make it fun."
    } ]
  }, {
    "tStartMs": 2354720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "- So if you wanna try out KiwiCo,"
    } ]
  }, {
    "tStartMs": 2356480,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "click the link in the\ndescription or scan this QR code."
    } ]
  }, {
    "tStartMs": 2359440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Use my code Veritasium"
    } ]
  }, {
    "tStartMs": 2360640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to get 50% off your first monthly crate."
    } ]
  }, {
    "tStartMs": 2363520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I wanna thank KiwiCo for\nsponsoring this video,"
    } ]
  }, {
    "tStartMs": 2365920,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
