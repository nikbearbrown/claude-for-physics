{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 4420,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Come take a walk with me, around Longyearbyen."
    } ]
  }, {
    "tStartMs": 7520,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "That's the largest town on the Norwegian islands of Svalbard."
    } ]
  }, {
    "tStartMs": 25240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Parts of it may look familiar."
    } ]
  }, {
    "tStartMs": 35360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "But make no mistake,"
    } ]
  }, {
    "tStartMs": 37220,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "this place IS different."
    } ]
  }, {
    "tStartMs": 46840,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "At 78° north,"
    } ]
  }, {
    "tStartMs": 48740,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "It is just 1800mi/1300km from the North Pole."
    } ]
  }, {
    "tStartMs": 67180,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And with over 2000 permanent residents,"
    } ]
  }, {
    "tStartMs": 69740,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "it is the northernmost real town on Earth."
    } ]
  }, {
    "tStartMs": 86320,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "There are only 50km (31mi) of road, including the small streets between houses."
    } ]
  }, {
    "tStartMs": 91620,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So people get around the island mainly on snowmobile."
    } ]
  }, {
    "tStartMs": 100980,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "In fact, there are more registered snowmobiles, than residents."
    } ]
  }, {
    "tStartMs": 124680,
    "dDurationMs": 6380,
    "segs": [ {
      "utf8": "Anyone leaving town is required to travel with a gun and someone who knows how to use it."
    } ]
  }, {
    "tStartMs": 139200,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Because the islands are also home to polar bears."
    } ]
  }, {
    "tStartMs": 153740,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The average daytime high,"
    } ]
  }, {
    "tStartMs": 155720,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "is below freezing for all but four months of the year."
    } ]
  }, {
    "tStartMs": 159520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Hi."
    } ]
  }, {
    "tStartMs": 161480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And from the end of October to mid February,"
    } ]
  }, {
    "tStartMs": 164640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "the sun doesn't rise at all."
    } ]
  }, {
    "tStartMs": 170720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "This is the long polar night."
    } ]
  }, {
    "tStartMs": 177160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Living here, is tough."
    } ]
  }, {
    "tStartMs": 186360,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "This past December, an avalanche in town destroyed 10 homes,"
    } ]
  }, {
    "tStartMs": 190700,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "which used to be here, killing two people."
    } ]
  }, {
    "tStartMs": 206140,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "So how did this cold, remote, ice-covered archipelago come to be inhabited?"
    } ]
  }, {
    "tStartMs": 214920,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Well, the hills around town are rich in coal deposits,"
    } ]
  }, {
    "tStartMs": 219040,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "that have been mined for over 100 years."
    } ]
  }, {
    "tStartMs": 228560,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "The coal was transported to the port via a series of aerial tramways."
    } ]
  }, {
    "tStartMs": 233640,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Some of which remain today, though they are no longer operational."
    } ]
  }, {
    "tStartMs": 242360,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Coal is a reminder that Svalbard was not always an Arctic ice world."
    } ]
  }, {
    "tStartMs": 247400,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "360 million yaers ago it was actually in the tropics, just north of the equator."
    } ]
  }, {
    "tStartMs": 252620,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "A swampy area it was covered with a precursor to modern ferns,"
    } ]
  }, {
    "tStartMs": 256460,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "which were much larger than they are today, reaching 10-30m (33-98ft) in height."
    } ]
  }, {
    "tStartMs": 262780,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "This vegetation was then covered in mud and sand,"
    } ]
  }, {
    "tStartMs": 265820,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and submerged under the sea."
    } ]
  }, {
    "tStartMs": 269400,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Over time, it turned into the coal deposites that in the 20th century"
    } ]
  }, {
    "tStartMs": 273400,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "brought miners from Norway, Russia and the US."
    } ]
  }, {
    "tStartMs": 288160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Most of the coal mines have now closed and the economy"
    } ]
  }, {
    "tStartMs": 291600,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "is gradually shifting towards tourism, education and research."
    } ]
  }, {
    "tStartMs": 300500,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Tourists take trips on snowmobiles and dog sleds."
    } ]
  }, {
    "tStartMs": 306480,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "There is a university center in Svalbard which offers semester courses"
    } ]
  }, {
    "tStartMs": 310600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "in biology, physics and geology."
    } ]
  }, {
    "tStartMs": 316800,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "And up on the side of a mountain, is the Svalbard Global Seed Vault."
    } ]
  }, {
    "tStartMs": 322440,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "But that's a story for another time."
    } ]
  }, {
    "tStartMs": 329560,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "The locals tell me that interest in the region from different nations"
    } ]
  }, {
    "tStartMs": 332720,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "is increasing."
    } ]
  }, {
    "tStartMs": 334620,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "As the globe warms and Arctic ice shrinks"
    } ]
  }, {
    "tStartMs": 337820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "trade routs are opening up across the north."
    } ]
  }, {
    "tStartMs": 345040,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "And Svalbard is strategically placed between North America, Asia and Europe."
    } ]
  }, {
    "tStartMs": 354720,
    "dDurationMs": 7820,
    "segs": [ {
      "utf8": "So one day in the future, Svaldbard may no longer be as cold or as remote as it once was."
    } ]
  }, {
    "tStartMs": 370280,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "But for now, it is a reminder of how through our ingenuity people can live"
    } ]
  }, {
    "tStartMs": 376460,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "in even the most inhospitable of places."
    } ]
  } ]
}
