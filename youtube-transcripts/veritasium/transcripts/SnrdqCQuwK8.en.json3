{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 3120,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Hey, Veritasium! Michael [Stevens] from Vsauce here, and we're gonna ask some important questions."
    } ]
  }, {
    "tStartMs": 7740,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Let's find some random bystanders...how about you?"
    } ]
  }, {
    "tStartMs": 11980,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yes?"
    } ]
  }, {
    "tStartMs": 13380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Michael: I don't believe you're scientifically literate."
    } ]
  }, {
    "tStartMs": 15380,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 15880,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Michael: If a tomato is a fruit, does that mean ketchup is a smoothie?"
    } ]
  }, {
    "tStartMs": 21060,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "John Green: So, can you name any of the cities in the Indus Valley civilization?"
    } ]
  }, {
    "tStartMs": 24380,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Are we talking about, like, Cairo?"
    } ]
  }, {
    "tStartMs": 27040,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "John: (scoffs) Yeah, Cairo would not qualify as one of the cities in the Indus Valley civilisation."
    } ]
  }, {
    "tStartMs": 31620,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "John: Cairo!...Cairo!"
    } ]
  }, {
    "tStartMs": 33680,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "This is Brady Haran from Periodic Videos,"
    } ]
  }, {
    "tStartMs": 36200,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and Sixty Symbols,"
    } ]
  }, {
    "tStartMs": 37560,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and bibledex,"
    } ]
  }, {
    "tStartMs": 38960,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and DeepSkyVideos,"
    } ]
  }, {
    "tStartMs": 40700,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and Numberphile,"
    } ]
  }, {
    "tStartMs": 42020,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and nottinghamscience,"
    } ]
  }, {
    "tStartMs": 43540,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "and foodskey, and--"
    } ]
  }, {
    "tStartMs": 44480,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Alright, and I'm Derek from Veritasium.\nand foodskey, and--"
    } ]
  }, {
    "tStartMs": 45200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Alright, and I'm Derek from Veritasium."
    } ]
  }, {
    "tStartMs": 46640,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Brady: Wait, you only got one channel?"
    } ]
  }, {
    "tStartMs": 47700,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "I know!"
    } ]
  }, {
    "tStartMs": 48380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Brady: You call yourself a Youtuber?"
    } ]
  }, {
    "tStartMs": 50680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Vi Hart, uh, you want to ask me a question?"
    } ]
  }, {
    "tStartMs": 54960,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Vi: Triangle."
    } ]
  }, {
    "tStartMs": 57920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Um, that's not a question?"
    } ]
  }, {
    "tStartMs": 61520,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Vi: Triangle."
    } ]
  }, {
    "tStartMs": 62480,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "(laughs awkwardly)\nUh...ah-um..."
    } ]
  }, {
    "tStartMs": 64400,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "John: In what year did the French Revolution began?"
    } ]
  }, {
    "tStartMs": 68740,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "17...72?"
    } ]
  }, {
    "tStartMs": 71700,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "John: You had the--the first two numbers were awesome!\n(Derek chuckles)"
    } ]
  }, {
    "tStartMs": 75280,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Brady: We have a Veritasium exclusive right now."
    } ]
  }, {
    "tStartMs": 77980,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "We're gonna show you the first, unauthorized picture of CGP Grey, who's standing here right next to me."
    } ]
  }, {
    "tStartMs": 84380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Here's a question for--oh."
    } ]
  }, {
    "tStartMs": 86620,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Hang on."
    } ]
  }, {
    "tStartMs": 88440,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "He was here a minute ago."
    } ]
  }, {
    "tStartMs": 89740,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Henry Reich: Okay, so what I was thinking I might have you, uh, try to calculate here is some Feynman diagrams in curved spacetime."
    } ]
  }, {
    "tStartMs": 94480,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "But to start off with something a bit easier, uh, I think we should start off with the Christoffel symbol for the Schwartzchild metric."
    } ]
  }, {
    "tStartMs": 99460,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Um, and in case you've forgotten I've written it, I've even written the metric here--"
    } ]
  }, {
    "tStartMs": 102380,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Derek: No, I know it--I know what it is. I don't need you to show me.\nHenry: Okay."
    } ]
  }, {
    "tStartMs": 104460,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "Derek: No, I know it--I know what it is. I don't need you to show me.\nHenry: So like--"
    } ]
  }, {
    "tStartMs": 105040,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Derek: No, I know it--I know what it is. I don't need you to show me.\nHenry: I know."
    } ]
  }, {
    "tStartMs": 121900,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "Henry: You have something on your face."
    } ]
  }, {
    "tStartMs": 124140,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Vi: Triangle, triangle, triangle, triangle, triangle, triangle, triangle, triangle, triangle."
    } ]
  }, {
    "tStartMs": 128240,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Vi: Triangle, triangle, triangle..."
    } ]
  }, {
    "tStartMs": 129560,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I am actually quite concerned about what you're doing to my face."
    } ]
  }, {
    "tStartMs": 131800,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Vi: (laughs) TRIANGLE!\nI am actually quite concerned about what you're doing to my face."
    } ]
  }, {
    "tStartMs": 133880,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Right, so this is CGP Grey and Veritasium at the BrainSTEM Conference here in Canada and it's been a great couple of days."
    } ]
  }, {
    "tStartMs": 139140,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "You gonna come visit me Derek?"
    } ]
  }, {
    "tStartMs": 140480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Definitely! I've always wanted to visit Great Britain."
    } ]
  }, {
    "tStartMs": 142720,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "(CGP Grey sighs)"
    } ]
  }, {
    "tStartMs": 143360,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "I mean...the United Kingdom?"
    } ]
  }, {
    "tStartMs": 146340,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "England?"
    } ]
  }, {
    "tStartMs": 147640,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Derek: The British Isles?\nCGP Grey: Great."
    } ]
  }, {
    "tStartMs": 148740,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "CGP Grey: Great, yeah. I look forward to it."
    } ]
  }, {
    "tStartMs": 150860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Going through U.S. customs in, like, an hour."
    } ]
  }, {
    "tStartMs": 155100,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "(Vi laughs)"
    } ]
  }, {
    "tStartMs": 156340,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "I was expecting, like, 𝘢 triangle, but this is feeling like lots of triangles."
    } ]
  }, {
    "tStartMs": 161460,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Vi: Well, they--they're happier in groups."
    } ]
  }, {
    "tStartMs": 163820,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 164500,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Vi: Like, they're like sheep. They get sad and lonely by themselves."
    } ]
  }, {
    "tStartMs": 171260,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Destin Sandlin: So, we're in the Corolla. I don't--I just met these guys."
    } ]
  }, {
    "tStartMs": 174880,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Henry: Look, look, there's like the Mennonite farms out there."
    } ]
  }, {
    "tStartMs": 177800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "If this car crashes right now, like, all of science on YouTube is going down."
    } ]
  }, {
    "tStartMs": 180920,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "(everyone laughs)"
    } ]
  } ]
}
