  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 130,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "- Just press play, you mean?"
    } ]
  }, {
    "tStartMs": 2140,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "- [Voiceover] Yeah, go for it. Whoa!"
    } ]
  }, {
    "tStartMs": 6260,
    "dDurationMs": 8540,
    "segs": [ {
      "utf8": "[Music]"
    } ]
  }, {
    "tStartMs": 15060,
    "dDurationMs": 4359,
    "segs": [ {
      "utf8": "- Now, you may have seen a Ruben's tube before.\nThat's basically a pipe with a bunch of holes"
    } ]
  }, {
    "tStartMs": 19419,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "in it, and you pump in a flammable gas, and\nlight it on fire, so you basically create"
    } ]
  }, {
    "tStartMs": 24409,
    "dDurationMs": 4391,
    "segs": [ {
      "utf8": "a row of Bunsen burners. What's really cool\nis to play some sounds into the tube, and"
    } ]
  }, {
    "tStartMs": 28800,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "you can actually set up standing waves. That\nis, there are areas, there are patterns of"
    } ]
  }, {
    "tStartMs": 33410,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "the vibration of the air where there's a lot\nof vibration in some parts, and not very much"
    } ]
  }, {
    "tStartMs": 38080,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "vibration in other parts. Now, that affects\nthe flow rate of the gas inside that tube"
    } ]
  }, {
    "tStartMs": 43710,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "into the atmosphere, and so it affects the\nheight of those flames. So basically, you"
    } ]
  }, {
    "tStartMs": 48000,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "can visualize the standing wave pattern. I'm\ncurrently in Denmark with a team of physics"
    } ]
  }, {
    "tStartMs": 52700,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "and chemistry demonstrators who have taken\nthis experiment to the next level. They've"
    } ]
  }, {
    "tStartMs": 56010,
    "dDurationMs": 6060,
    "segs": [ {
      "utf8": "actually created a two-dimensional Ruben's\ntube, a whole plane of Bunsen burners, effectively."
    } ]
  }, {
    "tStartMs": 62070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "How many holes in this tube?"
    } ]
  }, {
    "tStartMs": 63870,
    "dDurationMs": 789,
    "segs": [ {
      "utf8": "- 2,500"
    } ]
  }, {
    "tStartMs": 64659,
    "dDurationMs": 2291,
    "segs": [ {
      "utf8": "- [Voiceover] 2,500 in this Pyro Board?"
    } ]
  }, {
    "tStartMs": 66950,
    "dDurationMs": 239,
    "segs": [ {
      "utf8": "- Yeah"
    } ]
  }, {
    "tStartMs": 67189,
    "dDurationMs": 3091,
    "segs": [ {
      "utf8": "- [Voiceover] So we're gonna see 2,500 little\nflames. Yeah. So, do you want to light it"
    } ]
  }, {
    "tStartMs": 70280,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "up?"
    } ]
  }, {
    "tStartMs": 70860,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "- Yes, I really want to light it up."
    } ]
  }, {
    "tStartMs": 72530,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "- [Voiceover] Why did you make this?"
    } ]
  }, {
    "tStartMs": 74000,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "- Because, we really liked the Ruben's tube,\nbut then we thought, \"when you put on more\nfire, then it always gets better.\""
    } ]
  }, {
    "tStartMs": 82560,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Let's just turn [the frequency] down"
    } ]
  }, {
    "tStartMs": 85700,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "...and then we can just find the standing wave."
    } ]
  }, {
    "tStartMs": 88380,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "So, this is below the normal standing wave"
    } ]
  }, {
    "tStartMs": 102840,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Voiceover] So what are we seeing here?"
    } ]
  }, {
    "tStartMs": 104600,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "- It's pretty much like the standing wave\non the Ruben's tube. It's just in this direction."
    } ]
  }, {
    "tStartMs": 109260,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "This is the lowest frequency that makes a\nstanding wave in this pulse."
    } ]
  }, {
    "tStartMs": 115840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Voiceover] So this is like the fundamental."
    } ]
  }, {
    "tStartMs": 117420,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- It's the fundamental."
    } ]
  }, {
    "tStartMs": 119980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Voiceover] Can you show me what happens\nwhen you vary the volume a little bit?"
    } ]
  }, {
    "tStartMs": 124740,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "- [Voiceover] Whoa! That was awesome. Okay,\nshould we try to find another standing wave?"
    } ]
  }, {
    "tStartMs": 131600,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "- Yes"
    } ]
  }, {
    "tStartMs": 139000,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "You can see it. You can see\nit. You can hear it before you can see it."
    } ]
  }, {
    "tStartMs": 143580,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "- Woah"
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "- [Voiceover] It's weird. With the microphones,\nI can actually hear, like here, I'm in a node."
    } ]
  }, {
    "tStartMs": 153340,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "And then here, I'm in an anti-node. Here I'm in\na node."
    } ]
  }, {
    "tStartMs": 159020,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- [Sune] Because you can measure the sound\npressure?"
    } ]
  }, {
    "tStartMs": 162080,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "- [Voiceover] I can hear it. Like here is\nvery much an anti-node."
    } ]
  }, {
    "tStartMs": 166380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Sune] I never thought about that."
    } ]
  }, {
    "tStartMs": 168540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Voiceover] This is a node, and you guys\ncan hear it."
    } ]
  }, {
    "tStartMs": 170800,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Sune] That's true."
    } ]
  }, {
    "tStartMs": 171700,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "- [Voiceover] It's incredible. The flames\nmust be coming out in the anti-nodes."
    } ]
  }, {
    "tStartMs": 176020,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- The flames are coming up in the anti-nodes,\nyeah."
    } ]
  }, {
    "tStartMs": 177460,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- [Voiceover] And you can even hear it. That’s\nincredible."
    } ]
  }, {
    "tStartMs": 178860,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Yeah It's nice that it can do that."
    } ]
  }, {
    "tStartMs": 181330,
    "dDurationMs": 1129,
    "segs": [ {
      "utf8": "- [Voiceover] That is awesome."
    } ]
  }, {
    "tStartMs": 182459,
    "dDurationMs": 1541,
    "segs": [ {
      "utf8": "- [Sune] We just learned something."
    } ]
  }, {
    "tStartMs": 184000,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- [Voiceover] What happens if we try to go\nhigher frequency?"
    } ]
  }, {
    "tStartMs": 190660,
    "dDurationMs": 5490,
    "segs": [ {
      "utf8": "- [Sune] Yeah. We have something. Oh, that's\na good one."
    } ]
  }, {
    "tStartMs": 196150,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "- [Voiceover] That is crazy. We're right in\nthe anti-node."
    } ]
  }, {
    "tStartMs": 204060,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- [Sune] Is your ears okay?"
    } ]
  }, {
    "tStartMs": 205080,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- [Voiceover] Oh, God!"
    } ]
  }, {
    "tStartMs": 206080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- My ears are hurting now."
    } ]
  }, {
    "tStartMs": 208460,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "- [Voiceover] That was painful. Why don't\nwe try to put something more pleasing to the"
    } ]
  }, {
    "tStartMs": 212920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "ear through the speaker and see what happens."
    } ]
  }, {
    "tStartMs": 215020,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- I think that's a good idea."
    } ]
  }, {
    "tStartMs": 216320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- [Voiceover] Let's put some music on there.\nYou ready?"
    } ]
  }, {
    "tStartMs": 218640,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "- Go."
    } ]
  }, {
    "tStartMs": 219980,
    "dDurationMs": 83280,
    "segs": [ {
      "utf8": "[Music with bass thumping]"
    } ]
  }, {
    "tStartMs": 303680,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "- So, you go around Denmark showing kids all\nabout physics?"
    } ]
  }, {
    "tStartMs": 306940,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- We do. That's what we do."
    } ]
  }, {
    "tStartMs": 308520,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- You show them the Pyro Board?"
    } ]
  }, {
    "tStartMs": 309930,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "- We show them the Pyro Board, and we show\nthem a whole lot of other stuff."
    } ]
  }, {
    "tStartMs": 312640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- You guys are also on YouTube?"
    } ]
  }, {
    "tStartMs": 314150,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "- Yep, we have a YouTube channel. You can\ngo to this link, right here."
    } ]
  }, {
    "tStartMs": 317500,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "- Go check it out if you want to see more\nof what these guys are up to. It's awesome."
    } ]
  }, {
    "tStartMs": 320370,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "- [Sune] It's great."
    } ]
  }, {
    "tStartMs": 323720,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "- Ahoy. That is the actual Czech word for\nhello. I have made it to Olomouc in the Czech"
    } ]
  }, {
    "tStartMs": 328800,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Republic, and this is partly thanks to support\nfrom Audible.com, the leading provider of"
    } ]
  }, {
    "tStartMs": 333680,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "audio books, with over 150,000 titles in all\nareas of literature, including fiction, non-fiction,"
    } ]
  }, {
    "tStartMs": 339180,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "and periodicals. Now, today I wanted to recommend\na book, which is a little bit European, and"
    } ]
  }, {
    "tStartMs": 343610,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "it's called Galileo's Daughter by Dava Sobel.\nI love this book because it includes the actual"
    } ]
  }, {
    "tStartMs": 349150,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "letters written from Galileo's daughter to\nhim during his life, and it really reveals"
    } ]
  }, {
    "tStartMs": 353860,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "what he must have gone through as a human\nbeing. We all know about his science, and"
    } ]
  }, {
    "tStartMs": 358010,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "about the trials that he went through, but\nto see this kind of insight into his personal"
    } ]
  }, {
    "tStartMs": 362080,
    "dDurationMs": 4059,
    "segs": [ {
      "utf8": "life, I think is remarkable, so you should\nreally check out this book, and you can download"
    } ]
  }, {
    "tStartMs": 366139,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "it for free by going to audible.com/veritasium,\nor you can pick any other book of your choosing"
    } ]
  }, {
    "tStartMs": 370669,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "for a one month free trial. So I really want\nto thank Audible for supporting me, and allowing"
    } ]
  }, {
    "tStartMs": 374669,
    "dDurationMs": 6311,
    "segs": [ {
      "utf8": "me to go and meet great scientists, and filmmakers,\nand lots of people all around the world. Also,"
    } ]
  }, {
    "tStartMs": 380980,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "I should note that I will be hosting Michio\nKaku in Brisbane and Melbourne on June 5th"
    } ]
  }, {
    "tStartMs": 385620,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "and 6th. Links in the doobly-doo. I would\nlove to see you there. Thank you so much for"
    } ]
  }, {
    "tStartMs": 389730,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "watching, and I will see you somewhere else\nin the world. Bye."
    } ]
  } ]
}
