  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "I'm gonna try to demonstrate something called regelation."
    } ]
  }, {
    "tStartMs": 2700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Which is where you provide a pressure onto ice"
    } ]
  }, {
    "tStartMs": 5100,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and that turns it into water but after that pressure is removed it freezes again"
    } ]
  }, {
    "tStartMs": 10100,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So, in order to demonstrate this I've taken apart the high E string from my guitar."
    } ]
  }, {
    "tStartMs": 15100,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "I chose the E string because it's thinner than a G string and that's important."
    } ]
  }, {
    "tStartMs": 19500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And I've weighted it with these two bottles of water."
    } ]
  }, {
    "tStartMs": 22300,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "When I apply the string across the ice we should see the wire start to cut through the ice"
    } ]
  }, {
    "tStartMs": 29500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "And perform the regelation of the ice."
    } ]
  }, {
    "tStartMs": 31700,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "where we'll see if it works because we are outside in Sydney and it's warmer than 0°C obviously."
    } ]
  }, {
    "tStartMs": 65000,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "All right, it's past 3 A.M. but the experiment has been a success"
    } ]
  }, {
    "tStartMs": 69100,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "I passed this wire through this giant block of ice"
    } ]
  }, {
    "tStartMs": 73800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And it 's still a solid block."
    } ]
  }, {
    "tStartMs": 75800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "You can actually see the point where the wire went through, here."
    } ]
  }, {
    "tStartMs": 78900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 79900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So, we pretty clearly demonstrated regelation."
    } ]
  }, {
    "tStartMs": 81900,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The idea that you can compress the ice, turn it into water and then"
    } ]
  }, {
    "tStartMs": 86900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "when that pressure is gone it solidifies again as ice."
    } ]
  }, {
    "tStartMs": 91400,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Pretty cool stuff."
    } ]
  } ]
}
