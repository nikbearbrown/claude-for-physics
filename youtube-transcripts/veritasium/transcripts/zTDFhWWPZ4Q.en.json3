{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 720,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- [Derek] As the sun\nrose on July 2nd, 1937,"
    } ]
  }, {
    "tStartMs": 4200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Amelia Earhart knew she was in trouble."
    } ]
  }, {
    "tStartMs": 7440,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Over the radio, she called,"
    } ]
  }, {
    "tStartMs": 9067,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "\"We must be on you but cannot see you."
    } ]
  }, {
    "tStartMs": 11670,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Gas is running low."
    } ]
  }, {
    "tStartMs": 13350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Been unable to reach you by radio."
    } ]
  }, {
    "tStartMs": 15600,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "We are flying at 1,000 feet.\""
    } ]
  }, {
    "tStartMs": 18690,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Beneath her was water"
    } ]
  }, {
    "tStartMs": 20550,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "in every direction as\nfar as the eye could see."
    } ]
  }, {
    "tStartMs": 24600,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "She got herself into this predicament"
    } ]
  }, {
    "tStartMs": 26550,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "through a series of unfortunate\nevents and bad decisions."
    } ]
  }, {
    "tStartMs": 30960,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Many of them could have been avoided"
    } ]
  }, {
    "tStartMs": 32490,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "with a better knowledge of physics."
    } ]
  }, {
    "tStartMs": 35220,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "But even so,"
    } ]
  }, {
    "tStartMs": 36270,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "there was one thing she could\nhave done in this moment,"
    } ]
  }, {
    "tStartMs": 39360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "one switch she could have flipped"
    } ]
  }, {
    "tStartMs": 41940,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "that would likely have saved\nher life and changed history."
    } ]
  }, {
    "tStartMs": 48570,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "This video is sponsored by KiwiCo."
    } ]
  }, {
    "tStartMs": 50520,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 54300,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Amelia Earhart was vying to\nbecome the first female pilot"
    } ]
  }, {
    "tStartMs": 57570,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to fly around the world."
    } ]
  }, {
    "tStartMs": 58950,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- I hope to accomplish something"
    } ]
  }, {
    "tStartMs": 60390,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "really scientifically\nworthwhile for aviation."
    } ]
  }, {
    "tStartMs": 64260,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- And she wasn't taking any shortcuts."
    } ]
  }, {
    "tStartMs": 66960,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Other successful circumnavigations"
    } ]
  }, {
    "tStartMs": 68670,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "had followed a northern route,"
    } ]
  }, {
    "tStartMs": 70320,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "mostly staying close to land."
    } ]
  }, {
    "tStartMs": 73110,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But Earhart's route would be the longest"
    } ]
  }, {
    "tStartMs": 75390,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "by following a path close to the Equator."
    } ]
  }, {
    "tStartMs": 79590,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "This meant the last part of\nher journey was the hardest,"
    } ]
  }, {
    "tStartMs": 83040,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "crossing the full width\nof the Pacific Ocean."
    } ]
  }, {
    "tStartMs": 86910,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The starting point for\nthis crossing was Lae,"
    } ]
  }, {
    "tStartMs": 89550,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "a city on the eastern side of New Guinea."
    } ]
  }, {
    "tStartMs": 92550,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "At the time, it was one of\nthe world's busiest airports,"
    } ]
  }, {
    "tStartMs": 95640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "a hub of traffic from Asia and Australia."
    } ]
  }, {
    "tStartMs": 99000,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "At 10:00 a.m. on a hot July day,"
    } ]
  }, {
    "tStartMs": 101520,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Earhart piloted her Lockheed\nElectra down the runway"
    } ]
  }, {
    "tStartMs": 104970,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "and took off on what\nwould be her final flight."
    } ]
  }, {
    "tStartMs": 112920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The Pacific Ocean is huge."
    } ]
  }, {
    "tStartMs": 115080,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It's way bigger than the Atlantic."
    } ]
  }, {
    "tStartMs": 117630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I mean, if you look at\nthe globe from that side,"
    } ]
  }, {
    "tStartMs": 120180,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you see almost no land."
    } ]
  }, {
    "tStartMs": 122880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The problem was, in 1937,"
    } ]
  }, {
    "tStartMs": 125280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "most planes could only fly a maximum"
    } ]
  }, {
    "tStartMs": 127650,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of a few thousand kilometers,"
    } ]
  }, {
    "tStartMs": 130050,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "so Earhart removed everything\nunnecessary from her plane."
    } ]
  }, {
    "tStartMs": 134490,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "She ripped out the\ninsulation to reduce weight,"
    } ]
  }, {
    "tStartMs": 137400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but that made the engine\nnoise so overwhelming"
    } ]
  }, {
    "tStartMs": 140130,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "she had to communicate with her navigator"
    } ]
  }, {
    "tStartMs": 142410,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "sitting right beside her"
    } ]
  }, {
    "tStartMs": 143940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "using written notes."
    } ]
  }, {
    "tStartMs": 146220,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "She packed almost nothing,\ntelling her husband,"
    } ]
  }, {
    "tStartMs": 149257,
    "dDurationMs": 1913,
    "segs": [ {
      "utf8": "\"Extra clothes and extra food"
    } ]
  }, {
    "tStartMs": 151170,
    "dDurationMs": 2517,
    "segs": [ {
      "utf8": "would have been extra\nweight and extra worry.\""
    } ]
  }, {
    "tStartMs": 154890,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "She replaced the passenger\nseats with fuel tanks,"
    } ]
  }, {
    "tStartMs": 158340,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "effectively turning her\nplane into a flying gas can."
    } ]
  }, {
    "tStartMs": 162720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But even so, the Electra's maximum range"
    } ]
  }, {
    "tStartMs": 165210,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "was between 6,600 and 7,200\nkilometers in perfect weather."
    } ]
  }, {
    "tStartMs": 170220,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It could be just enough\nto reach Hawaii from Lae,"
    } ]
  }, {
    "tStartMs": 173400,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "or she might come up disastrously short."
    } ]
  }, {
    "tStartMs": 178380,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "So Earhart needed a place to\nstop and refuel along the way."
    } ]
  }, {
    "tStartMs": 183150,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now, it might seem like\nthere's no land here,"
    } ]
  }, {
    "tStartMs": 185910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but if you zoom in,"
    } ]
  }, {
    "tStartMs": 187560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "there is this tiny island"
    } ]
  }, {
    "tStartMs": 189600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "halfway between Australia and Hawaii."
    } ]
  }, {
    "tStartMs": 192540,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Howland Island is just\nover two kilometers long"
    } ]
  }, {
    "tStartMs": 196170,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and less than one kilometer wide."
    } ]
  }, {
    "tStartMs": 198870,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The US had claimed it"
    } ]
  }, {
    "tStartMs": 200160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "as part of the Guano Islands Act of 1856."
    } ]
  }, {
    "tStartMs": 202770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But in 1937, it was barely inhabited"
    } ]
  }, {
    "tStartMs": 205800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "with just a handful of colonists."
    } ]
  }, {
    "tStartMs": 208260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It would be an ideal location to refuel,"
    } ]
  }, {
    "tStartMs": 211320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "if only it had a runway."
    } ]
  }, {
    "tStartMs": 214080,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Fortunately for Earhart,"
    } ]
  }, {
    "tStartMs": 215340,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "by the time of her\naround the world flight,"
    } ]
  }, {
    "tStartMs": 217590,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "she was already famous."
    } ]
  }, {
    "tStartMs": 220140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "In 1928, she became the\nfirst female passenger"
    } ]
  }, {
    "tStartMs": 223080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to cross the Atlantic by airplane."
    } ]
  }, {
    "tStartMs": 225480,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "This made her an international celebrity."
    } ]
  }, {
    "tStartMs": 228005,
    "dDurationMs": 2893,
    "segs": [ {
      "utf8": "- [Announcer] She said\nshe could, and she did it."
    } ]
  }, {
    "tStartMs": 230898,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(lively music)"
    } ]
  }, {
    "tStartMs": 234780,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "- [Derek] But she wanted\nto fly herself, saying,"
    } ]
  }, {
    "tStartMs": 237247,
    "dDurationMs": 2573,
    "segs": [ {
      "utf8": "\"Maybe someday I'll try it alone.\""
    } ]
  }, {
    "tStartMs": 239820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So, in 1932,"
    } ]
  }, {
    "tStartMs": 241560,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "she attempted to pilot a\nplane solo across the Atlantic"
    } ]
  }, {
    "tStartMs": 245310,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "heading for Paris."
    } ]
  }, {
    "tStartMs": 246720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "She brought with her only a toothbrush,"
    } ]
  }, {
    "tStartMs": 248610,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "one container of soup and\nthree cans of tomato juice."
    } ]
  }, {
    "tStartMs": 252480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "(thunder booms)"
    } ]
  }, {
    "tStartMs": 255120,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "But storms, ice, and dense\nfog battered her small plane."
    } ]
  }, {
    "tStartMs": 260040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "A seam in the exhaust manifold cracked"
    } ]
  }, {
    "tStartMs": 262440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and flames from the engine\nspewed out into the night."
    } ]
  }, {
    "tStartMs": 266040,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Gas leaked down her\nneck from a broken tank,"
    } ]
  }, {
    "tStartMs": 269040,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and after 14 hours,"
    } ]
  }, {
    "tStartMs": 270750,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "she landed in a pasture\nin Northern Ireland."
    } ]
  }, {
    "tStartMs": 273900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Her face was so covered in grease,"
    } ]
  }, {
    "tStartMs": 275910,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "a farmhand couldn't tell if\nshe was a man or a woman."
    } ]
  }, {
    "tStartMs": 279390,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "He asked if she had flown far."
    } ]
  }, {
    "tStartMs": 281617,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "\"From America,\" she replied."
    } ]
  }, {
    "tStartMs": 284040,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- I wish I could have done it faster."
    } ]
  }, {
    "tStartMs": 286530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] These adventures brought her"
    } ]
  }, {
    "tStartMs": 288120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "into the orbits of powerful people,"
    } ]
  }, {
    "tStartMs": 290280,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "like the First Lady, Eleanor Roosevelt."
    } ]
  }, {
    "tStartMs": 292682,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- And Mrs. Roosevelt,"
    } ]
  }, {
    "tStartMs": 293850,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "won't you go for a ride\ntonight over Washington?"
    } ]
  }, {
    "tStartMs": 296130,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's really lovely from the air at night."
    } ]
  }, {
    "tStartMs": 298530,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- And using her new connections,"
    } ]
  }, {
    "tStartMs": 300090,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "she lobbied the president to\nhire her friend, Eugene Vidal,"
    } ]
  }, {
    "tStartMs": 303750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to head the Bureau of Commerce."
    } ]
  }, {
    "tStartMs": 305880,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Vidal had promised Earhart\na runway on Howland Island,"
    } ]
  }, {
    "tStartMs": 309540,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but red tape stalled progress"
    } ]
  }, {
    "tStartMs": 311490,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "only months before her planned takeoff."
    } ]
  }, {
    "tStartMs": 314520,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So Earhart wrote directly\nto President Roosevelt."
    } ]
  }, {
    "tStartMs": 318030,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "She explained that the airstrip funds"
    } ]
  }, {
    "tStartMs": 319920,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "required immediate approval,"
    } ]
  }, {
    "tStartMs": 321690,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "writing, \"Please forgive\ntroublesome female flyer"
    } ]
  }, {
    "tStartMs": 324750,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "for whom this Howland\nIsland project is key"
    } ]
  }, {
    "tStartMs": 327300,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to world flight attempt.\""
    } ]
  }, {
    "tStartMs": 329430,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The president approved the\nproject four days later,"
    } ]
  }, {
    "tStartMs": 332640,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "and three runways were soon cleared."
    } ]
  }, {
    "tStartMs": 337050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So she had a place to land,"
    } ]
  }, {
    "tStartMs": 339660,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "but how would she find this\ntiny speck of an island"
    } ]
  }, {
    "tStartMs": 343620,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "in a vast ocean?"
    } ]
  }, {
    "tStartMs": 346920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Well, flying with her in the Electra"
    } ]
  }, {
    "tStartMs": 348780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "was her navigator, Fred Noonan,"
    } ]
  }, {
    "tStartMs": 350910,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and he would calculate the flight plan."
    } ]
  }, {
    "tStartMs": 353520,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "They knew the direction of Howland,"
    } ]
  }, {
    "tStartMs": 355290,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so they could use the onboard compass"
    } ]
  }, {
    "tStartMs": 357510,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to set their bearing toward it."
    } ]
  }, {
    "tStartMs": 359760,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "They knew their air speed"
    } ]
  }, {
    "tStartMs": 360990,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and could figure out their ground speed"
    } ]
  }, {
    "tStartMs": 362640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "by subtracting or adding the wind,"
    } ]
  }, {
    "tStartMs": 365160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and then they could calculate\nhow long it should take"
    } ]
  }, {
    "tStartMs": 367800,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to reach the island."
    } ]
  }, {
    "tStartMs": 369360,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "This method is known as dead reckoning."
    } ]
  }, {
    "tStartMs": 373020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But they wouldn't aim\ndirectly at the island,"
    } ]
  }, {
    "tStartMs": 375600,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "because if they did that"
    } ]
  }, {
    "tStartMs": 376620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and they didn't see it\nat the prescribed time,"
    } ]
  }, {
    "tStartMs": 379380,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "they wouldn't know in which\ndirection they were off."
    } ]
  }, {
    "tStartMs": 382710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So instead, they\nintentionally picked a point"
    } ]
  }, {
    "tStartMs": 385200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "either north or south of the island."
    } ]
  }, {
    "tStartMs": 387570,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Let's say they picked south."
    } ]
  }, {
    "tStartMs": 389430,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "They estimated the trip\nwould take 18 hours,"
    } ]
  }, {
    "tStartMs": 392670,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "so they would fly through day and night."
    } ]
  }, {
    "tStartMs": 396120,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And once they had traveled"
    } ]
  }, {
    "tStartMs": 397260,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "for the calculated length of time,"
    } ]
  }, {
    "tStartMs": 399120,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "they could confidently turn\nnorth and spot the island."
    } ]
  }, {
    "tStartMs": 404640,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Before takeoff, the ground crew estimated"
    } ]
  }, {
    "tStartMs": 406710,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "they would encounter a headwind\nof 24 kilometers per hour."
    } ]
  }, {
    "tStartMs": 410250,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But just 20 minutes after takeoff,"
    } ]
  }, {
    "tStartMs": 412470,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "Lae radioed Earhart to warn"
    } ]
  }, {
    "tStartMs": 414375,
    "dDurationMs": 2205,
    "segs": [ {
      "utf8": "that the headwinds would be stronger."
    } ]
  }, {
    "tStartMs": 416580,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "She didn't acknowledge their message."
    } ]
  }, {
    "tStartMs": 420030,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Knowing the correct\nwind speed was critical"
    } ]
  }, {
    "tStartMs": 422190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "because it would affect\nhow long it would take"
    } ]
  }, {
    "tStartMs": 424080,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "to reach the island."
    } ]
  }, {
    "tStartMs": 425430,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "If it took longer, Earhart\nwould have to turn later."
    } ]
  }, {
    "tStartMs": 428700,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So she couldn't rely\non dead reckoning alone"
    } ]
  }, {
    "tStartMs": 431550,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "to reach Howland."
    } ]
  }, {
    "tStartMs": 434280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "As an independent check on their location,"
    } ]
  }, {
    "tStartMs": 436620,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "Noonan would take measurements\nof the sun, moon, and stars."
    } ]
  }, {
    "tStartMs": 440970,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "This is known as celestial navigation."
    } ]
  }, {
    "tStartMs": 444240,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "He had an almanac that\nlisted 58 navigation stars"
    } ]
  }, {
    "tStartMs": 447930,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and the point on Earth each\none would be directly overhead"
    } ]
  }, {
    "tStartMs": 451110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "for the day and time of his measurement."
    } ]
  }, {
    "tStartMs": 454020,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "If they found themselves\ndirectly under a navigation star,"
    } ]
  }, {
    "tStartMs": 457290,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "well, then they would\nimmediately know their position."
    } ]
  }, {
    "tStartMs": 460470,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But generally they\nwould not be that lucky,"
    } ]
  }, {
    "tStartMs": 463560,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "so Noonan would measure\nthe angle above the horizon"
    } ]
  }, {
    "tStartMs": 466830,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to a navigation star"
    } ]
  }, {
    "tStartMs": 468360,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and use that to work out\nhow far away they were"
    } ]
  }, {
    "tStartMs": 471690,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "from the point on the Earth"
    } ]
  }, {
    "tStartMs": 473100,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "where that star would\nbe directly overhead."
    } ]
  }, {
    "tStartMs": 475680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So he could trace out\na circle on the globe"
    } ]
  }, {
    "tStartMs": 478350,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of possible locations,"
    } ]
  }, {
    "tStartMs": 480300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and then he would measure the angle"
    } ]
  }, {
    "tStartMs": 481650,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to another navigation star"
    } ]
  }, {
    "tStartMs": 483720,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and draw out a second circle."
    } ]
  }, {
    "tStartMs": 486450,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And now they must be"
    } ]
  }, {
    "tStartMs": 487590,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "at one of these two circle intersections."
    } ]
  }, {
    "tStartMs": 491160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Normally the circles were so large"
    } ]
  }, {
    "tStartMs": 493140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that only one of the intersections"
    } ]
  }, {
    "tStartMs": 494940,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "would be a plausible position."
    } ]
  }, {
    "tStartMs": 497400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "That way they could continually\nupdate their location"
    } ]
  }, {
    "tStartMs": 500130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and adjust bearings as needed."
    } ]
  }, {
    "tStartMs": 502350,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But even with celestial navigation,"
    } ]
  }, {
    "tStartMs": 504570,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "errors could accumulate over long trips."
    } ]
  }, {
    "tStartMs": 507930,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Earlier in the journey, when\nEarhart crossed the Atlantic,"
    } ]
  }, {
    "tStartMs": 510930,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "they missed their intended\nairport in hazy conditions."
    } ]
  }, {
    "tStartMs": 514410,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Noonan's calculations were reasonable,"
    } ]
  }, {
    "tStartMs": 516360,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but small errors put them off course."
    } ]
  }, {
    "tStartMs": 519120,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Luckily, in Africa,"
    } ]
  }, {
    "tStartMs": 520440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "there were plenty of other\nplaces to land safely."
    } ]
  }, {
    "tStartMs": 523410,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "The same could not be said for Howland."
    } ]
  }, {
    "tStartMs": 528570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So, for the flight across the Pacific,"
    } ]
  }, {
    "tStartMs": 530610,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Earhart commandeered three US\nNavy and Coast Guard ships."
    } ]
  }, {
    "tStartMs": 534540,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The Itasca would be\nstationed at Howland Island,"
    } ]
  }, {
    "tStartMs": 537690,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the Ontario would be\nhalfway along the route,"
    } ]
  }, {
    "tStartMs": 540810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and the Swan was positioned midway"
    } ]
  }, {
    "tStartMs": 542760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "between Howland and Hawaii."
    } ]
  }, {
    "tStartMs": 545400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The Itasca would send out smoke signals"
    } ]
  }, {
    "tStartMs": 547710,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "as Earhart approached to\nhelp her spot the island."
    } ]
  }, {
    "tStartMs": 551160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But even more importantly,"
    } ]
  }, {
    "tStartMs": 552960,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "all ships were equipped with radio."
    } ]
  }, {
    "tStartMs": 556470,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Now, in 1937, radio was\nstill fairly new tech."
    } ]
  }, {
    "tStartMs": 560400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "German physicist Heinrich\nHertz discovered radio waves"
    } ]
  }, {
    "tStartMs": 563220,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "in the late 1880s."
    } ]
  }, {
    "tStartMs": 564990,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "He excited electrons to\noscillate back and forth"
    } ]
  }, {
    "tStartMs": 567900,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "in his transmitter,"
    } ]
  }, {
    "tStartMs": 569280,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and a few meters away his\nreceiver was a loop of wire"
    } ]
  }, {
    "tStartMs": 572610,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "with a small gap in it."
    } ]
  }, {
    "tStartMs": 574770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "When Hertz looked at it through\na microscope in the dark,"
    } ]
  }, {
    "tStartMs": 577800,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "he saw faint sparks\njumping across the gap."
    } ]
  }, {
    "tStartMs": 581520,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The sparks were strongest when\nthe receiving loop was flat."
    } ]
  }, {
    "tStartMs": 584610,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "If it was vertical, then\nno sparks were observed."
    } ]
  }, {
    "tStartMs": 588360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "This demonstrated that radio\nwaves are transverse waves"
    } ]
  }, {
    "tStartMs": 591900,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "with electric and magnetic fields"
    } ]
  }, {
    "tStartMs": 593700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "oscillating perpendicular to each other"
    } ]
  }, {
    "tStartMs": 596100,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and perpendicular to the\ndirection of the wave motion."
    } ]
  }, {
    "tStartMs": 599550,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "When the receiving loop was aligned"
    } ]
  }, {
    "tStartMs": 601260,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "with the direction the wave was traveling,"
    } ]
  }, {
    "tStartMs": 603150,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the changing magnetic\nfield through the loop"
    } ]
  }, {
    "tStartMs": 605190,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "induced an EMF that created the spark."
    } ]
  }, {
    "tStartMs": 608640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But if the loop was\nfacing the transmitter,"
    } ]
  }, {
    "tStartMs": 611340,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "then there was no change in\nmagnetic flux through the loop,"
    } ]
  }, {
    "tStartMs": 614550,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "and so no spark was observed."
    } ]
  }, {
    "tStartMs": 618090,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Now, Hertz couldn't see the\nfuture he had ushered in."
    } ]
  }, {
    "tStartMs": 621510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "He said, \"I do not think"
    } ]
  }, {
    "tStartMs": 623490,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that the wireless waves I have discovered"
    } ]
  }, {
    "tStartMs": 625770,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "will have any practical application.\""
    } ]
  }, {
    "tStartMs": 628710,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "But within a few years,"
    } ]
  }, {
    "tStartMs": 629760,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "people started sending\nmessages using radio."
    } ]
  }, {
    "tStartMs": 632310,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "And by the 1920s, radio\nentertainment broadcast took off."
    } ]
  }, {
    "tStartMs": 636420,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Ships and planes routinely\nused radio to send Morse code,"
    } ]
  }, {
    "tStartMs": 639990,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and some, including Earhart,"
    } ]
  }, {
    "tStartMs": 641760,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "could send and receive voice messages."
    } ]
  }, {
    "tStartMs": 646560,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "In fact, Earhart had five radio\nantennas around the plane,"
    } ]
  }, {
    "tStartMs": 650580,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "each for a specific purpose."
    } ]
  }, {
    "tStartMs": 652770,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The largest antenna could\nbe reeled in and out"
    } ]
  }, {
    "tStartMs": 655230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "like a fishing line behind the plane."
    } ]
  }, {
    "tStartMs": 657480,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It was 76 meters long,"
    } ]
  }, {
    "tStartMs": 659340,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "which was necessary"
    } ]
  }, {
    "tStartMs": 660420,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to efficiently send and receive Morse code"
    } ]
  }, {
    "tStartMs": 663180,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "via the 4 or 500 kilohertz radio waves"
    } ]
  }, {
    "tStartMs": 666030,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "used by ships and remote stations."
    } ]
  }, {
    "tStartMs": 669090,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Ideally, an antenna should be\nat least 1/4 of the wavelength"
    } ]
  }, {
    "tStartMs": 672480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of the radio wave it's\ntransmitting or receiving."
    } ]
  }, {
    "tStartMs": 675060,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "This improves the efficiency"
    } ]
  }, {
    "tStartMs": 676950,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of the conversion from electrical energy"
    } ]
  }, {
    "tStartMs": 679350,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to radiated electromagnetic energy."
    } ]
  }, {
    "tStartMs": 682500,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Earhart's trailing antenna"
    } ]
  }, {
    "tStartMs": 683790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "was only around 1/8 of the wavelength."
    } ]
  }, {
    "tStartMs": 686160,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But it was connected to\na high-power transmitter,"
    } ]
  }, {
    "tStartMs": 689130,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so its signals could still be detected"
    } ]
  }, {
    "tStartMs": 691200,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "over 1,000 kilometers away."
    } ]
  }, {
    "tStartMs": 693690,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Next were two antennas\nfor voice communications"
    } ]
  }, {
    "tStartMs": 696360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "on higher frequencies."
    } ]
  }, {
    "tStartMs": 698070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "A transmitting V antenna\non the roof of the plane"
    } ]
  }, {
    "tStartMs": 700860,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "and a receiving antenna along its belly."
    } ]
  }, {
    "tStartMs": 704430,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Higher frequencies were\nuseful for two reasons."
    } ]
  }, {
    "tStartMs": 707370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "First, they require smaller antennas,"
    } ]
  }, {
    "tStartMs": 709650,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which save weight and can\nbe better accommodated"
    } ]
  }, {
    "tStartMs": 712350,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "on small sparse planes."
    } ]
  }, {
    "tStartMs": 714330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And second, high frequency radio waves"
    } ]
  }, {
    "tStartMs": 716580,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "can travel long distances"
    } ]
  }, {
    "tStartMs": 718110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "by bouncing off a layer of the atmosphere"
    } ]
  }, {
    "tStartMs": 720450,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "called the ionosphere."
    } ]
  }, {
    "tStartMs": 722610,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Starting about 50 kilometers\nabove Earth's surface,"
    } ]
  }, {
    "tStartMs": 725940,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "radiation from the Sun splits\nelectrons off molecules"
    } ]
  }, {
    "tStartMs": 729060,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "forming a layer of ions\nand free electrons."
    } ]
  }, {
    "tStartMs": 732810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Radio waves with certain frequencies"
    } ]
  }, {
    "tStartMs": 735090,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "interact with these free electrons"
    } ]
  }, {
    "tStartMs": 736740,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and are effectively\nreflected back to Earth."
    } ]
  }, {
    "tStartMs": 739830,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "It's as if they've bounced off"
    } ]
  }, {
    "tStartMs": 741360,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "a big wobbly mirror in the sky."
    } ]
  }, {
    "tStartMs": 744840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "This effect is called skipping"
    } ]
  }, {
    "tStartMs": 746610,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and it scatters radio\nwaves all over the place."
    } ]
  }, {
    "tStartMs": 749880,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "These radio waves can\nthen reflect off the ocean"
    } ]
  }, {
    "tStartMs": 752550,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and back off the ionosphere,"
    } ]
  }, {
    "tStartMs": 754230,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "making multiple hops to travel\nthousands of kilometers."
    } ]
  }, {
    "tStartMs": 759030,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "During the daytime,"
    } ]
  }, {
    "tStartMs": 759930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the intense radiation from the sun"
    } ]
  }, {
    "tStartMs": 761820,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "means the ionosphere starts\nlower in denser atmosphere."
    } ]
  }, {
    "tStartMs": 765600,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And because of this,"
    } ]
  }, {
    "tStartMs": 766920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "lower frequency radio\nwaves are more likely"
    } ]
  }, {
    "tStartMs": 769200,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "to be absorbed than reflected."
    } ]
  }, {
    "tStartMs": 771960,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So aviators would typically\nuse the higher 6210 kilohertz"
    } ]
  }, {
    "tStartMs": 775440,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to skip their signals during the day,"
    } ]
  }, {
    "tStartMs": 777150,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and then the lower 3105 kilohertz at night"
    } ]
  }, {
    "tStartMs": 780150,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "once the bottom of the\nionosphere had lifted"
    } ]
  }, {
    "tStartMs": 782550,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "into thinner air."
    } ]
  }, {
    "tStartMs": 787050,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Four hours after takeoff,"
    } ]
  }, {
    "tStartMs": 788820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Earhart radioed an update to Lae"
    } ]
  }, {
    "tStartMs": 790800,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "on her daytime frequency of 6210."
    } ]
  }, {
    "tStartMs": 793770,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "She reported her altitude at 7,000 feet"
    } ]
  }, {
    "tStartMs": 796500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and speed at 140 knots"
    } ]
  }, {
    "tStartMs": 798750,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "before concluding with"
    } ]
  }, {
    "tStartMs": 799740,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "her typical sign-off, \"Everything okay.\""
    } ]
  }, {
    "tStartMs": 803190,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But she never acknowledged calls from Lae"
    } ]
  }, {
    "tStartMs": 805350,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "about the headwind."
    } ]
  }, {
    "tStartMs": 806820,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "They radioed again at 11:20 and 12:20,"
    } ]
  }, {
    "tStartMs": 810510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but never got a response from Earhart."
    } ]
  }, {
    "tStartMs": 813390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "In all likelihood, she never heard them."
    } ]
  }, {
    "tStartMs": 816000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "She did radio six hours into her flight"
    } ]
  }, {
    "tStartMs": 818340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to report stronger headwinds,"
    } ]
  }, {
    "tStartMs": 820260,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "but she makes no mention\nof Lae's earlier warnings."
    } ]
  }, {
    "tStartMs": 824610,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It's possible the receiving belly antenna"
    } ]
  }, {
    "tStartMs": 826920,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "was broken, fell off,"
    } ]
  }, {
    "tStartMs": 828570,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "or something in the receiving\nelectronics wasn't working."
    } ]
  }, {
    "tStartMs": 832350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But her ability to receive voice messages"
    } ]
  }, {
    "tStartMs": 835200,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "was clearly impaired."
    } ]
  }, {
    "tStartMs": 838170,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Nine hours into the flight,"
    } ]
  }, {
    "tStartMs": 839760,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Earhart expected to come upon the Ontario."
    } ]
  }, {
    "tStartMs": 843030,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "She listened for Morse\ncode Ns on 400 kilohertz,"
    } ]
  }, {
    "tStartMs": 847830,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "but she heard nothing."
    } ]
  }, {
    "tStartMs": 851910,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "The original plan was"
    } ]
  }, {
    "tStartMs": 853260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that the Ontario would\nwait for her to radio them"
    } ]
  }, {
    "tStartMs": 856080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to request that they start transmitting."
    } ]
  }, {
    "tStartMs": 858960,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "But the day before takeoff,"
    } ]
  }, {
    "tStartMs": 860520,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Earhart realized she had made a mistake."
    } ]
  }, {
    "tStartMs": 863550,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The Ontario had told her"
    } ]
  }, {
    "tStartMs": 865170,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "they wouldn't be able to receive\nany high frequency signals,"
    } ]
  }, {
    "tStartMs": 868560,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which meant no voice communication."
    } ]
  }, {
    "tStartMs": 871620,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So she sent an urgent\ntelegram asking the Ontario"
    } ]
  }, {
    "tStartMs": 874920,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to transmit the Morse code Ns repeatedly"
    } ]
  }, {
    "tStartMs": 877740,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "10 minutes after each hour."
    } ]
  }, {
    "tStartMs": 881670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The purpose of the Morse\ncode from the Ontario"
    } ]
  }, {
    "tStartMs": 884070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "was actually to allow Amelia Earhart"
    } ]
  }, {
    "tStartMs": 886230,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to make use of her two final antennas."
    } ]
  }, {
    "tStartMs": 888900,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So she had a loop antenna\njust like this one"
    } ]
  }, {
    "tStartMs": 892080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and a sense antenna."
    } ]
  }, {
    "tStartMs": 894090,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "These were designed to allow her"
    } ]
  }, {
    "tStartMs": 895620,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to locate the source of radio waves."
    } ]
  }, {
    "tStartMs": 898020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This was the final and most critical way"
    } ]
  }, {
    "tStartMs": 900360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that Earhart planned to stay on course"
    } ]
  }, {
    "tStartMs": 902430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and locate Howland Island."
    } ]
  }, {
    "tStartMs": 904380,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "She wrote, \"I doubt if I'd try the flight"
    } ]
  }, {
    "tStartMs": 906570,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to tiny Howland Island"
    } ]
  }, {
    "tStartMs": 907830,
    "dDurationMs": 2457,
    "segs": [ {
      "utf8": "without it supplementing\nFred Noonan's skill.\""
    } ]
  }, {
    "tStartMs": 911220,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Woo. Alright, so I have an antenna here"
    } ]
  }, {
    "tStartMs": 916800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and I'm aligning it\nvertically in this tree."
    } ]
  }, {
    "tStartMs": 918600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "How are we, how are we there?"
    } ]
  }, {
    "tStartMs": 920160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So the Ontario was sending\nout Morse code signals"
    } ]
  }, {
    "tStartMs": 923760,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "on their antenna,"
    } ]
  }, {
    "tStartMs": 925020,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "and here we have a transmitter\ntuned to about 3.6 megahertz."
    } ]
  }, {
    "tStartMs": 929880,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I'm gonna put on this blindfold"
    } ]
  }, {
    "tStartMs": 932940,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and use the loop antenna to\ntry to locate the transmitter."
    } ]
  }, {
    "tStartMs": 937260,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And because I already know\nwhere the transmitter is,"
    } ]
  }, {
    "tStartMs": 938850,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "we'll spin me around a few\ntimes to really disorient me."
    } ]
  }, {
    "tStartMs": 941460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So, Clifford. Oh, sorry."
    } ]
  }, {
    "tStartMs": 943950,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- [Clifford] Oh, which way are you going?"
    } ]
  }, {
    "tStartMs": 947550,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "- Alright. Whoa, I'm a bit dizzy."
    } ]
  }, {
    "tStartMs": 951774,
    "dDurationMs": 4386,
    "segs": [ {
      "utf8": "So the radio waves are gonna\nbe emitted in all directions"
    } ]
  }, {
    "tStartMs": 956160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "radially away from the antenna,"
    } ]
  }, {
    "tStartMs": 957840,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the electric field will be\noscillating up and down,"
    } ]
  }, {
    "tStartMs": 960900,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and the magnetic field will\nbe oscillating back and forth."
    } ]
  }, {
    "tStartMs": 964950,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "So if I hold up this loop like this"
    } ]
  }, {
    "tStartMs": 968640,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "sort of parallel to the direction"
    } ]
  }, {
    "tStartMs": 970770,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that the waves are traveling,"
    } ]
  }, {
    "tStartMs": 972180,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "then the magnetic field\nis gonna be changing"
    } ]
  }, {
    "tStartMs": 974490,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "through the loop."
    } ]
  }, {
    "tStartMs": 975510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And because of that,"
    } ]
  }, {
    "tStartMs": 976343,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "it's going to create an EMF and current"
    } ]
  }, {
    "tStartMs": 978690,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and I can pick that up"
    } ]
  }, {
    "tStartMs": 980580,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "because I'm tuned to the\nright frequency here."
    } ]
  }, {
    "tStartMs": 983010,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "So I got a fairly strong signal."
    } ]
  }, {
    "tStartMs": 984963,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "Woo, it's very strong."
    } ]
  }, {
    "tStartMs": 987150,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But if I rotate the loop like that,"
    } ]
  }, {
    "tStartMs": 989400,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "well, now the magnetic field\nis oscillating back and forth"
    } ]
  }, {
    "tStartMs": 992460,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but not changing through the loop itself"
    } ]
  }, {
    "tStartMs": 994920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "because it's parallel to the loop."
    } ]
  }, {
    "tStartMs": 996780,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "And so, in this orientation,\nI'm gonna get a null reading."
    } ]
  }, {
    "tStartMs": 1000830,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "If I turn it this way, there's a null."
    } ]
  }, {
    "tStartMs": 1004490,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "But if you turn it 90 degrees,"
    } ]
  }, {
    "tStartMs": 1007520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "now all the magnetic field\nis passing through this loop"
    } ]
  }, {
    "tStartMs": 1010130,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and so I can hear a maximum here."
    } ]
  }, {
    "tStartMs": 1013040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So this is what Earhart wanted to measure"
    } ]
  }, {
    "tStartMs": 1015200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "using her loop antenna"
    } ]
  }, {
    "tStartMs": 1016700,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "to detect the repeated N\nMorse code from the Ontario."
    } ]
  }, {
    "tStartMs": 1020390,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "She would turn it until she found the null"
    } ]
  }, {
    "tStartMs": 1023210,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and then she would know\nthe direction to the ship."
    } ]
  }, {
    "tStartMs": 1026840,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Something that's interesting\nis, if I turn it away,"
    } ]
  }, {
    "tStartMs": 1030050,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "we get another null because again"
    } ]
  }, {
    "tStartMs": 1032330,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "there's no magnetic flux\npassing through this loop."
    } ]
  }, {
    "tStartMs": 1036650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Now, the first time she\npicked up the signal,"
    } ]
  }, {
    "tStartMs": 1038840,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "she would probably be heading\nstraight towards the ship"
    } ]
  }, {
    "tStartMs": 1042320,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "or close enough,"
    } ]
  }, {
    "tStartMs": 1043370,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "so she would know that\nit's roughly that way."
    } ]
  }, {
    "tStartMs": 1047150,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But there's a chance\nthat she's gone past it."
    } ]
  }, {
    "tStartMs": 1050750,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And if you go past it, well,\nthen you also get a null,"
    } ]
  }, {
    "tStartMs": 1053960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but the ship is behind\nyou, not in front of you."
    } ]
  }, {
    "tStartMs": 1056480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So that's where the\nsense antenna comes in."
    } ]
  }, {
    "tStartMs": 1058640,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The sense antenna gives you\na cardioid pickup pattern"
    } ]
  }, {
    "tStartMs": 1061850,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "so it has a single null\ninstead of two nulls,"
    } ]
  }, {
    "tStartMs": 1064760,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and so that allows you to determine"
    } ]
  }, {
    "tStartMs": 1066530,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "whether it is in front or behind you."
    } ]
  }, {
    "tStartMs": 1069821,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "- [Clifford] If you walk a bit,"
    } ]
  }, {
    "tStartMs": 1070854,
    "dDurationMs": 2216,
    "segs": [ {
      "utf8": "you'll know if it's\ngetting weaker or stronger."
    } ]
  }, {
    "tStartMs": 1073070,
    "dDurationMs": 4114,
    "segs": [ {
      "utf8": "- Alright, I feel like I've\npicked the wrong direction."
    } ]
  }, {
    "tStartMs": 1077184,
    "dDurationMs": 4496,
    "segs": [ {
      "utf8": "I'll try the sense antenna to\nsee if I can figure it out."
    } ]
  }, {
    "tStartMs": 1081680,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "With the sense antenna,"
    } ]
  }, {
    "tStartMs": 1083030,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "the only null points directly\naway from the transmitter,"
    } ]
  }, {
    "tStartMs": 1086810,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so it's easy to use the sense antenna"
    } ]
  }, {
    "tStartMs": 1089060,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to check which null is correct"
    } ]
  }, {
    "tStartMs": 1091010,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but then only use the loop when navigating"
    } ]
  }, {
    "tStartMs": 1093470,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "because it gives a sharper null."
    } ]
  }, {
    "tStartMs": 1095660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I think using the sense antenna"
    } ]
  }, {
    "tStartMs": 1097280,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "that the transmitter's\nright in front of me now."
    } ]
  }, {
    "tStartMs": 1102140,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "I'm looking for another null here."
    } ]
  }, {
    "tStartMs": 1105633,
    "dDurationMs": 1894,
    "segs": [ {
      "utf8": "Oh, there's a null."
    } ]
  }, {
    "tStartMs": 1109302,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Clifford] Give it a go."
    } ]
  }, {
    "tStartMs": 1112991,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- There, there. Definitely louder, louder."
    } ]
  }, {
    "tStartMs": 1119633,
    "dDurationMs": 3417,
    "segs": [ {
      "utf8": "Oh, it's funny 'cause\nyou move a little bit"
    } ]
  }, {
    "tStartMs": 1123050,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and then you start hearing signal again."
    } ]
  }, {
    "tStartMs": 1126140,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "This does not feel like I'm\nwalking in the right direction."
    } ]
  }, {
    "tStartMs": 1128870,
    "dDurationMs": 893,
    "segs": [ {
      "utf8": "- [Clifford] Well, that's\neither the right way to go"
    } ]
  }, {
    "tStartMs": 1129763,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "or it's the wrong way to go."
    } ]
  }, {
    "tStartMs": 1131240,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Oh no.\n(Clifford laughs)"
    } ]
  }, {
    "tStartMs": 1132890,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "- Trying to fly a plane and\ndo this would be very hard,"
    } ]
  }, {
    "tStartMs": 1136820,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "especially with the sound of that engine"
    } ]
  }, {
    "tStartMs": 1139670,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "would have been roaring."
    } ]
  }, {
    "tStartMs": 1143219,
    "dDurationMs": 2871,
    "segs": [ {
      "utf8": "Oh, I feel like it's getting loud."
    } ]
  }, {
    "tStartMs": 1147050,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "It's really loud here."
    } ]
  }, {
    "tStartMs": 1149450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It drops out right there."
    } ]
  }, {
    "tStartMs": 1151340,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I mean, there's a null here."
    } ]
  }, {
    "tStartMs": 1153320,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And I was convinced\nthis was the right way."
    } ]
  }, {
    "tStartMs": 1156050,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "Yeah, this is a clear null right here."
    } ]
  }, {
    "tStartMs": 1161030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Whoa. Loud, loud, loud."
    } ]
  }, {
    "tStartMs": 1164060,
    "dDurationMs": 2411,
    "segs": [ {
      "utf8": "I feel like I've gotta be close."
    } ]
  }, {
    "tStartMs": 1166471,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(antenna humming)"
    } ]
  }, {
    "tStartMs": 1170870,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "It's gotta be like right here."
    } ]
  }, {
    "tStartMs": 1173100,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "Whoa! Ah! (laughs)"
    } ]
  }, {
    "tStartMs": 1177560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This worked amazingly well."
    } ]
  }, {
    "tStartMs": 1179930,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "I had no idea I was that\nclose, that's impressive."
    } ]
  }, {
    "tStartMs": 1183560,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- On the nail.\n- That's awesome."
    } ]
  }, {
    "tStartMs": 1186020,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Now, aviators could have used\nwhere the signal is loudest"
    } ]
  }, {
    "tStartMs": 1189890,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and try to go in that direction,"
    } ]
  }, {
    "tStartMs": 1192200,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but it's actually easier\nto get a precise null,"
    } ]
  }, {
    "tStartMs": 1195680,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "a point where the signal drops out."
    } ]
  }, {
    "tStartMs": 1197810,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "The loud section could\nrange for quite a distance"
    } ]
  }, {
    "tStartMs": 1201440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and so you wouldn't\nreally know where it is,"
    } ]
  }, {
    "tStartMs": 1203000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but the null is more precise"
    } ]
  }, {
    "tStartMs": 1204680,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "so that's why they\nwould look for the point"
    } ]
  }, {
    "tStartMs": 1206000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "where the signal drops out."
    } ]
  }, {
    "tStartMs": 1208100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "If Earhart could hone in on the Ontario"
    } ]
  }, {
    "tStartMs": 1210350,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "using her radio direction finding loop,"
    } ]
  }, {
    "tStartMs": 1212690,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that would ensure she was on course"
    } ]
  }, {
    "tStartMs": 1214970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and eliminate any navigation errors"
    } ]
  }, {
    "tStartMs": 1216890,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that may have occurred to that point."
    } ]
  }, {
    "tStartMs": 1219080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But her telegram asking the Ontario"
    } ]
  }, {
    "tStartMs": 1221480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to transmit 10 minutes after each hour"
    } ]
  }, {
    "tStartMs": 1224180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "didn't make it to the ship in time."
    } ]
  }, {
    "tStartMs": 1226940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And since Earhart couldn't\ntalk to the Ontario,"
    } ]
  }, {
    "tStartMs": 1229880,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "they never sent out any signals."
    } ]
  }, {
    "tStartMs": 1232160,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "So they passed like ships in the night."
    } ]
  }, {
    "tStartMs": 1237620,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "By this point, Earhart was\naround halfway to Howland."
    } ]
  }, {
    "tStartMs": 1240800,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "With no other landing strips\nwithin 1,000 kilometers,"
    } ]
  }, {
    "tStartMs": 1244100,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "she would have to find the tiny\nisland or return to Lae now."
    } ]
  }, {
    "tStartMs": 1248960,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "But multiple delays had\nalready plagued her journey."
    } ]
  }, {
    "tStartMs": 1253220,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "In fact, this was not\nEarhart's first attempt"
    } ]
  }, {
    "tStartMs": 1255830,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to fly around the world."
    } ]
  }, {
    "tStartMs": 1257600,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Earlier that year, in March of 1937,"
    } ]
  }, {
    "tStartMs": 1260570,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "she had taken off from\nCalifornia for Hawaii,"
    } ]
  }, {
    "tStartMs": 1263270,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "heading west instead of east."
    } ]
  }, {
    "tStartMs": 1266030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "On board were Fred Noonan"
    } ]
  }, {
    "tStartMs": 1267680,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "and another crew member, Harry Manning."
    } ]
  }, {
    "tStartMs": 1271130,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "As a Merchant Marine captain,"
    } ]
  }, {
    "tStartMs": 1272870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "he was an expert in radio, Morse code,"
    } ]
  }, {
    "tStartMs": 1275720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and traditional navigation."
    } ]
  }, {
    "tStartMs": 1277640,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "He was also a pilot."
    } ]
  }, {
    "tStartMs": 1280340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The flight to Hawaii was successful"
    } ]
  }, {
    "tStartMs": 1282680,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "thanks in part to Manning\nusing the loop antenna"
    } ]
  }, {
    "tStartMs": 1285830,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "to hone in on a radio beacon\non the destination island."
    } ]
  }, {
    "tStartMs": 1291470,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Three days later, the trio\nset off for Howland Island."
    } ]
  }, {
    "tStartMs": 1295160,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "But just as they were taking off,"
    } ]
  }, {
    "tStartMs": 1296750,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the plane drifted to the right."
    } ]
  }, {
    "tStartMs": 1298910,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Earhart corrected by\nthrottling back the left motor,"
    } ]
  }, {
    "tStartMs": 1301880,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "but it was too much."
    } ]
  }, {
    "tStartMs": 1303140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "The plane turned to the left"
    } ]
  }, {
    "tStartMs": 1304550,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and the right wing dipped down."
    } ]
  }, {
    "tStartMs": 1306080,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Going up on one wheel, the\nright landing gear collapsed,"
    } ]
  }, {
    "tStartMs": 1309860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "then the left."
    } ]
  }, {
    "tStartMs": 1311450,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The plane skidded out on its belly,"
    } ]
  }, {
    "tStartMs": 1313250,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "spinning around to face\nthe way it had come."
    } ]
  }, {
    "tStartMs": 1321110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Thankfully, no one was hurt,"
    } ]
  }, {
    "tStartMs": 1323480,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but the Electra took months to repair."
    } ]
  }, {
    "tStartMs": 1326270,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And during that time, the\nseasonal winds shifted."
    } ]
  }, {
    "tStartMs": 1329210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So, on her next attempt,"
    } ]
  }, {
    "tStartMs": 1330770,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Earhart would have to\nfly east instead of west."
    } ]
  }, {
    "tStartMs": 1333980,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "And most importantly, Captain\nManning left the crew."
    } ]
  }, {
    "tStartMs": 1338150,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Officially, the press reported"
    } ]
  }, {
    "tStartMs": 1339680,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that he needed to return\nto the Merchant Marines,"
    } ]
  }, {
    "tStartMs": 1342230,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "but rumors spread that he had\nlost confidence in Earhart,"
    } ]
  }, {
    "tStartMs": 1345650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "or that Earhart believed"
    } ]
  }, {
    "tStartMs": 1347300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Noonan was a better navigator than Manning"
    } ]
  }, {
    "tStartMs": 1349460,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and she could operate\nthe radio on her own."
    } ]
  }, {
    "tStartMs": 1352400,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Whatever the case,"
    } ]
  }, {
    "tStartMs": 1353300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "when Earhart took off\nagain three months later,"
    } ]
  }, {
    "tStartMs": 1355880,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "she was accompanied only by Noonan."
    } ]
  }, {
    "tStartMs": 1360080,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "And now they had made it 80%\nof the way around the world."
    } ]
  }, {
    "tStartMs": 1364550,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And in the dark of night,"
    } ]
  }, {
    "tStartMs": 1366260,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Earhart had to make the critical decision"
    } ]
  }, {
    "tStartMs": 1368570,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "whether to keep going or turn back."
    } ]
  }, {
    "tStartMs": 1371570,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The lack of signal from the Ontario"
    } ]
  }, {
    "tStartMs": 1373220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "must have been concerning,"
    } ]
  }, {
    "tStartMs": 1374750,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "but maybe they never got her telegram."
    } ]
  }, {
    "tStartMs": 1377810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And she knew that at Howland,"
    } ]
  }, {
    "tStartMs": 1379610,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the Itasca would be\ntransmitting the letter A"
    } ]
  }, {
    "tStartMs": 1382280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "over Morse code every half hour,"
    } ]
  }, {
    "tStartMs": 1384650,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "even if they didn't hear from her."
    } ]
  }, {
    "tStartMs": 1386750,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And they could send and\nreceive voice signals."
    } ]
  }, {
    "tStartMs": 1389840,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "They promised to be ready"
    } ]
  }, {
    "tStartMs": 1391100,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "on a range of different frequencies."
    } ]
  }, {
    "tStartMs": 1393860,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "So she flew on."
    } ]
  }, {
    "tStartMs": 1397490,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Around 6:15 a.m. local time,"
    } ]
  }, {
    "tStartMs": 1399680,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "radiomen aboard the Itasca\nheard Earhart clearly."
    } ]
  }, {
    "tStartMs": 1403347,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "\"Please take a bearing on 3105."
    } ]
  }, {
    "tStartMs": 1405530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "We'll whistle into the mic."
    } ]
  }, {
    "tStartMs": 1407330,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "We are about 200 miles out.\""
    } ]
  }, {
    "tStartMs": 1409790,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "She then began to whistle."
    } ]
  }, {
    "tStartMs": 1413480,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But the men were confused."
    } ]
  }, {
    "tStartMs": 1415520,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "They expected Earhart to\ntake a bearing on them,"
    } ]
  }, {
    "tStartMs": 1418430,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "not the other way around."
    } ]
  }, {
    "tStartMs": 1420200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And while they had told her"
    } ]
  }, {
    "tStartMs": 1421640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that they had radio\ndirection finding equipment,"
    } ]
  }, {
    "tStartMs": 1424010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the signal needed to be lower frequency,"
    } ]
  }, {
    "tStartMs": 1426410,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "between 270 and 550 kilohertz."
    } ]
  }, {
    "tStartMs": 1430340,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Her voice frequency would\nskip off the ionosphere"
    } ]
  }, {
    "tStartMs": 1433610,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and reflect off the ocean,"
    } ]
  }, {
    "tStartMs": 1435110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "scattering in all directions."
    } ]
  }, {
    "tStartMs": 1437450,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So there would be no way to find a null"
    } ]
  }, {
    "tStartMs": 1439460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "because the signal would be coming"
    } ]
  }, {
    "tStartMs": 1441350,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "literally from everywhere."
    } ]
  }, {
    "tStartMs": 1444890,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "In the Electra, Earhart heard only static."
    } ]
  }, {
    "tStartMs": 1449540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "By now, she must have been worried"
    } ]
  }, {
    "tStartMs": 1451040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that they hadn't heard\nanything from either ship."
    } ]
  }, {
    "tStartMs": 1453980,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Almost blind from the rising sun"
    } ]
  }, {
    "tStartMs": 1456050,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and deaf from the roar of the engines,"
    } ]
  }, {
    "tStartMs": 1458510,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Earhart twisted the radio dial,"
    } ]
  }, {
    "tStartMs": 1460760,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "listening for Itasca's response. Nothing."
    } ]
  }, {
    "tStartMs": 1467750,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "She may have expected Howland"
    } ]
  }, {
    "tStartMs": 1469130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to have a high frequency\nradio direction finder"
    } ]
  }, {
    "tStartMs": 1471470,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "called an Adcock antenna array."
    } ]
  }, {
    "tStartMs": 1474020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "These systems solve the skipping problem"
    } ]
  }, {
    "tStartMs": 1476180,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with five vertical antennas"
    } ]
  }, {
    "tStartMs": 1477860,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at the corners and center of a square."
    } ]
  }, {
    "tStartMs": 1480830,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "The direction of the radio wave"
    } ]
  }, {
    "tStartMs": 1482240,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "can be calculated from the\nslightly different arrival times"
    } ]
  }, {
    "tStartMs": 1485210,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and signal strengths at each antenna."
    } ]
  }, {
    "tStartMs": 1488030,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But these antennas were massive,"
    } ]
  }, {
    "tStartMs": 1490550,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "so they were really only\ninstalled at larger airports."
    } ]
  }, {
    "tStartMs": 1495260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Now, as it happens,"
    } ]
  }, {
    "tStartMs": 1496340,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "there was a portable high\nfrequency radio direction finder"
    } ]
  }, {
    "tStartMs": 1499580,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "on Howland Island,"
    } ]
  }, {
    "tStartMs": 1501200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but the operator reported\nthat Earhart's transmissions"
    } ]
  }, {
    "tStartMs": 1503840,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "didn't last long enough\nfor him to take a bearing."
    } ]
  }, {
    "tStartMs": 1506930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And trying to conserve his low battery,"
    } ]
  }, {
    "tStartMs": 1509570,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "he missed parts of the\nlater transmissions."
    } ]
  }, {
    "tStartMs": 1513170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Around 6:45, Earhart again asked them"
    } ]
  }, {
    "tStartMs": 1515930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to take a bearing on 3105 kilohertz"
    } ]
  }, {
    "tStartMs": 1518000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and report back in a half hour."
    } ]
  }, {
    "tStartMs": 1520550,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But a bearing taken now and\nreported back in a half hour"
    } ]
  }, {
    "tStartMs": 1523820,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "would be at best outdated\nand at worst misleading."
    } ]
  }, {
    "tStartMs": 1528650,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "This confusion likely had\nto do with time zones."
    } ]
  }, {
    "tStartMs": 1532670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Earhart was using Greenwich Civil Time,"
    } ]
  }, {
    "tStartMs": 1535220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "but the Itasca set their clocks\nto their current position"
    } ]
  }, {
    "tStartMs": 1538640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which was GCT -11.5 hours."
    } ]
  }, {
    "tStartMs": 1541760,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And to make matters worse,"
    } ]
  }, {
    "tStartMs": 1543170,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Howland Island used Hawaii Time,"
    } ]
  }, {
    "tStartMs": 1545750,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "which back in those days\nwas GCT -10.5 hours."
    } ]
  }, {
    "tStartMs": 1550010,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So the three parties\nattempting a rendezvous"
    } ]
  }, {
    "tStartMs": 1552710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "on a tiny island in the\nmiddle of the Pacific"
    } ]
  }, {
    "tStartMs": 1555500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "were on three different time zones."
    } ]
  }, {
    "tStartMs": 1557900,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And crucially, Earhart's\nhours didn't even line up"
    } ]
  }, {
    "tStartMs": 1561140,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "with the others."
    } ]
  }, {
    "tStartMs": 1562670,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Earhart told the Itasca\nshe would be using GCT,"
    } ]
  }, {
    "tStartMs": 1565880,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "but somehow it never\nmade it to the radiomen."
    } ]
  }, {
    "tStartMs": 1570050,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, when the Itasca\nheard Earhart's request,"
    } ]
  }, {
    "tStartMs": 1572480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "it was 6:45 a.m."
    } ]
  }, {
    "tStartMs": 1574310,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But in the cockpit, it was 6:15 p.m."
    } ]
  }, {
    "tStartMs": 1577910,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So Earhart likely didn't\nsay \"in a half hour\""
    } ]
  }, {
    "tStartMs": 1580850,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but \"on the half hour,\""
    } ]
  }, {
    "tStartMs": 1582560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which for her was only 15 minutes away."
    } ]
  }, {
    "tStartMs": 1585080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And also it was a prearranged time"
    } ]
  }, {
    "tStartMs": 1587030,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "that Earhart would be listening for them."
    } ]
  }, {
    "tStartMs": 1590420,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Earhart was careful to set\ntimes she would transmit"
    } ]
  }, {
    "tStartMs": 1593390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and times she would listen for the ship"
    } ]
  }, {
    "tStartMs": 1595610,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "because she could only\npower one antenna at a time."
    } ]
  }, {
    "tStartMs": 1599330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And the ships used the same antenna"
    } ]
  }, {
    "tStartMs": 1602000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "for receiving and transmitting,"
    } ]
  }, {
    "tStartMs": 1603620,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "so if they both broadcasted\nat the same time,"
    } ]
  }, {
    "tStartMs": 1606410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "they would miss each other's messages."
    } ]
  }, {
    "tStartMs": 1608900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "If Earhart sent another message"
    } ]
  }, {
    "tStartMs": 1610550,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "at a quarter after the hour,"
    } ]
  }, {
    "tStartMs": 1612020,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "the Itasca blocked it\nwith their own message."
    } ]
  }, {
    "tStartMs": 1614877,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "\"Cannot take a bearing on 3105 very good."
    } ]
  }, {
    "tStartMs": 1618110,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Please send on 500, or do you\nwish to take a bearing on us?"
    } ]
  }, {
    "tStartMs": 1621650,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Go ahead please.\""
    } ]
  }, {
    "tStartMs": 1623360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "There was no response."
    } ]
  }, {
    "tStartMs": 1625310,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But she couldn't transmit\non 500 kilohertz anyway"
    } ]
  }, {
    "tStartMs": 1628520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because she had removed\nthe long trailing antenna"
    } ]
  }, {
    "tStartMs": 1631400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that could transmit lower frequencies."
    } ]
  }, {
    "tStartMs": 1633800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Since it could only be\nused for Morse code,"
    } ]
  }, {
    "tStartMs": 1636260,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "something neither she nor Noonan"
    } ]
  }, {
    "tStartMs": 1637820,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "were particularly well versed in,"
    } ]
  }, {
    "tStartMs": 1639470,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "she saw it as dead weight\nafter Manning left."
    } ]
  }, {
    "tStartMs": 1642770,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So, after the Hawaii crash,\nit was removed during repairs."
    } ]
  }, {
    "tStartMs": 1646400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So she had no way of sending radio waves"
    } ]
  }, {
    "tStartMs": 1649220,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "that would allow the Itasca\nto take a bearing on her."
    } ]
  }, {
    "tStartMs": 1653840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But she could take a bearing on the Itasca"
    } ]
  }, {
    "tStartMs": 1656450,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "using her loop antenna,"
    } ]
  }, {
    "tStartMs": 1658160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "if they sent her the right frequency."
    } ]
  }, {
    "tStartMs": 1661340,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Before the trip, the\nItasca had asked Earhart"
    } ]
  }, {
    "tStartMs": 1663290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to specify the frequency\nthey should broadcast."
    } ]
  }, {
    "tStartMs": 1666320,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Earhart was unsure,"
    } ]
  }, {
    "tStartMs": 1667790,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so she consulted a radio expert in Lae"
    } ]
  }, {
    "tStartMs": 1670790,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and they recommended the\nItasca send Morse code A,"
    } ]
  }, {
    "tStartMs": 1673820,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "just repeated dot dashes,"
    } ]
  }, {
    "tStartMs": 1675590,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "on the half hour at 750."
    } ]
  }, {
    "tStartMs": 1678170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But at that time it was typical\nto talk about radio waves"
    } ]
  }, {
    "tStartMs": 1681170,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "using their wavelength,"
    } ]
  }, {
    "tStartMs": 1682610,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "so the expert had meant 750\nmeters or 400 kilohertz."
    } ]
  }, {
    "tStartMs": 1687620,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But Earhart made a terrible mistake"
    } ]
  }, {
    "tStartMs": 1690020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "relaying this plan to the Itasca."
    } ]
  }, {
    "tStartMs": 1692300,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "She requested the signal\nbe sent on 7,500 kilohertz"
    } ]
  }, {
    "tStartMs": 1696590,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "instead of 750 meters or 400 kilohertz."
    } ]
  }, {
    "tStartMs": 1700850,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "But she did explicitly say,"
    } ]
  }, {
    "tStartMs": 1703047,
    "dDurationMs": 4253,
    "segs": [ {
      "utf8": "\"If frequencies mentioned\nunsuitable, inform me.\""
    } ]
  }, {
    "tStartMs": 1707300,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "But no one ever corrected her."
    } ]
  }, {
    "tStartMs": 1711890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "At 7:42 a.m.,"
    } ]
  }, {
    "tStartMs": 1713780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Earhart's voice came through so loud"
    } ]
  }, {
    "tStartMs": 1716270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "men even went above deck to\nsee if they could hear a motor"
    } ]
  }, {
    "tStartMs": 1719510,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or spot the plane."
    } ]
  }, {
    "tStartMs": 1721250,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "She said, \"We must be on\nyou but cannot see you."
    } ]
  }, {
    "tStartMs": 1725030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But gas is running low."
    } ]
  }, {
    "tStartMs": 1726740,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Been unable to reach you by radio."
    } ]
  }, {
    "tStartMs": 1729020,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "We are flying at 1,000 feet.\""
    } ]
  }, {
    "tStartMs": 1731510,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "On Howland, the high frequency\nradio direction finder"
    } ]
  }, {
    "tStartMs": 1734330,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "was so low on battery"
    } ]
  }, {
    "tStartMs": 1736040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the radiomen didn't even\nhear Earhart's message,"
    } ]
  }, {
    "tStartMs": 1738650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "much less take a bearing on it."
    } ]
  }, {
    "tStartMs": 1741200,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "10 minutes later, Earhart said,"
    } ]
  }, {
    "tStartMs": 1743247,
    "dDurationMs": 2393,
    "segs": [ {
      "utf8": "\"We are circling but cannot hear you."
    } ]
  }, {
    "tStartMs": 1745640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Go ahead on 7,500.\""
    } ]
  }, {
    "tStartMs": 1748100,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The Itasca immediately\nsent As on 7,500 kilohertz."
    } ]
  }, {
    "tStartMs": 1752900,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "In the Electra, Earhart\nheard the stutter stop of As"
    } ]
  }, {
    "tStartMs": 1756440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "filling the cabin."
    } ]
  }, {
    "tStartMs": 1757790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The relief of finally hearing something"
    } ]
  }, {
    "tStartMs": 1760040,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "must have been overwhelming."
    } ]
  }, {
    "tStartMs": 1762080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "She quickly turned her\nradio direction finding loop"
    } ]
  }, {
    "tStartMs": 1764660,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to locate the null,"
    } ]
  }, {
    "tStartMs": 1766490,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "but the signal never dropped out."
    } ]
  }, {
    "tStartMs": 1769550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The frequency was too high,"
    } ]
  }, {
    "tStartMs": 1771200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "so the radio waves from\nthe Itasca were reflecting"
    } ]
  }, {
    "tStartMs": 1773810,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and arriving from different directions."
    } ]
  }, {
    "tStartMs": 1776360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Joseph Gurr, a radio mechanic\nwho worked on Earhart's plane,"
    } ]
  }, {
    "tStartMs": 1779900,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "later said that they knew\nthere were limitations"
    } ]
  }, {
    "tStartMs": 1781760,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to high frequencies"
    } ]
  }, {
    "tStartMs": 1782720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which had a tendency to skip and bend,"
    } ]
  }, {
    "tStartMs": 1785210,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "creating a false radio direction bearing."
    } ]
  }, {
    "tStartMs": 1788780,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "Without a minimum, she was still lost."
    } ]
  }, {
    "tStartMs": 1793970,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "Earhart frantically called Itasca."
    } ]
  }, {
    "tStartMs": 1796227,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "\"We received your signals\nbut unable to get a minimum."
    } ]
  }, {
    "tStartMs": 1799310,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Please take a bearing on\nus and answer with voice.\""
    } ]
  }, {
    "tStartMs": 1802940,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "Itasca attempted to explain the problem."
    } ]
  }, {
    "tStartMs": 1805497,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "\"Your signals received okay."
    } ]
  }, {
    "tStartMs": 1807260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It is impractical to take\na bearing on your voice.\""
    } ]
  }, {
    "tStartMs": 1810050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "No response. Without the belly antenna,"
    } ]
  }, {
    "tStartMs": 1812660,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "she probably never heard\nany of their communications."
    } ]
  }, {
    "tStartMs": 1816350,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And it wouldn't have mattered"
    } ]
  }, {
    "tStartMs": 1817490,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "if the Itasca had sent\nlow frequency signals"
    } ]
  }, {
    "tStartMs": 1820160,
    "dDurationMs": 4623,
    "segs": [ {
      "utf8": "because Earhart's loop was tuned\nto pick up 7,500 kilohertz."
    } ]
  }, {
    "tStartMs": 1827990,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, why didn't the Itasca"
    } ]
  }, {
    "tStartMs": 1829760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "correct the frequency she suggested?"
    } ]
  }, {
    "tStartMs": 1832160,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Commander Thompson of the Itasca"
    } ]
  }, {
    "tStartMs": 1833810,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "was aware of her radio\ndirection finding limits."
    } ]
  }, {
    "tStartMs": 1836690,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "He had received messages"
    } ]
  }, {
    "tStartMs": 1837950,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "both from Earhart's\nhusband, George Putnam,"
    } ]
  }, {
    "tStartMs": 1840650,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and the Coast Guard's\nSan Francisco division"
    } ]
  }, {
    "tStartMs": 1843020,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "stating Earhart could only take bearings"
    } ]
  }, {
    "tStartMs": 1844970,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "on frequencies between\n200 and 1,500 kilohertz."
    } ]
  }, {
    "tStartMs": 1849230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But he either thought Earhart knew more"
    } ]
  }, {
    "tStartMs": 1851210,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "about her radio equipment,"
    } ]
  }, {
    "tStartMs": 1852980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or that it wasn't his\nplace to make suggestions"
    } ]
  }, {
    "tStartMs": 1855650,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and take more responsibility\nfor her flight."
    } ]
  }, {
    "tStartMs": 1859160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "When she asked the Itasca"
    } ]
  }, {
    "tStartMs": 1860480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to tell her if these\nfrequencies weren't suitable,"
    } ]
  }, {
    "tStartMs": 1862640,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "she could have been referring\nto the ship's capabilities"
    } ]
  }, {
    "tStartMs": 1865070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "rather than her own."
    } ]
  }, {
    "tStartMs": 1866690,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The Itasca said they'd be ready"
    } ]
  }, {
    "tStartMs": 1867980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "on the frequencies she wanted and more"
    } ]
  }, {
    "tStartMs": 1870200,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "instead of giving specific suggestions."
    } ]
  }, {
    "tStartMs": 1874520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "San Francisco's Coast Guard division"
    } ]
  }, {
    "tStartMs": 1876200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "tried to get Commander Thompson\nto take more responsibility"
    } ]
  }, {
    "tStartMs": 1879080,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for Earhart's radio communications"
    } ]
  }, {
    "tStartMs": 1881330,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "by suggesting they directly tell Earhart"
    } ]
  }, {
    "tStartMs": 1883820,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "which frequencies to use."
    } ]
  }, {
    "tStartMs": 1885950,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But Thompson essentially\ntold them to butt out."
    } ]
  }, {
    "tStartMs": 1888890,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "The Itasca communicated directly\nwith Earhart from then on."
    } ]
  }, {
    "tStartMs": 1894316,
    "dDurationMs": 3004,
    "segs": [ {
      "utf8": "The radiomen continued\nto try to reach Earhart,"
    } ]
  }, {
    "tStartMs": 1897320,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and just before 9:00 a.m.,"
    } ]
  }, {
    "tStartMs": 1898970,
    "dDurationMs": 2797,
    "segs": [ {
      "utf8": "Earhart's voice suddenly\nburst through again."
    } ]
  }, {
    "tStartMs": 1901767,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "\"We are on the line 157-337."
    } ]
  }, {
    "tStartMs": 1904970,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "We will repeat this on 6,210 kilohertz."
    } ]
  }, {
    "tStartMs": 1908030,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "We are running on line north and south.\""
    } ]
  }, {
    "tStartMs": 1911360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Her voice was desperate."
    } ]
  }, {
    "tStartMs": 1913070,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "It sounded as if she was"
    } ]
  }, {
    "tStartMs": 1914240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "about to burst into tears or scream."
    } ]
  }, {
    "tStartMs": 1917240,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "This was the last\nmessage the Itasca heard."
    } ]
  }, {
    "tStartMs": 1922220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "There are a number of conspiracy theories"
    } ]
  }, {
    "tStartMs": 1924560,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "about what happened to Earhart after that,"
    } ]
  }, {
    "tStartMs": 1926930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but the evidence seems clear."
    } ]
  }, {
    "tStartMs": 1929240,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "She ran out of fuel\nsomewhere over the Pacific"
    } ]
  }, {
    "tStartMs": 1931790,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "and crashed into the sea."
    } ]
  }, {
    "tStartMs": 1934550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Two hours after her last message,"
    } ]
  }, {
    "tStartMs": 1936440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "the Itasca left Howland"
    } ]
  }, {
    "tStartMs": 1937820,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "to search north and west for the Electra."
    } ]
  }, {
    "tStartMs": 1941180,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Other Navy and Coast\nGuard ships and planes"
    } ]
  }, {
    "tStartMs": 1943370,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "joined the search for over two weeks."
    } ]
  }, {
    "tStartMs": 1946550,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "To that point in US history,"
    } ]
  }, {
    "tStartMs": 1948500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "it was the most intensive and expensive"
    } ]
  }, {
    "tStartMs": 1951320,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "search and rescue operation,"
    } ]
  }, {
    "tStartMs": 1953180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "costing around $4 million,"
    } ]
  }, {
    "tStartMs": 1955700,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "which is almost 100\nmillion in today's money."
    } ]
  }, {
    "tStartMs": 1960140,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "No one has ever found a\ntrace of Noonan, Earhart,"
    } ]
  }, {
    "tStartMs": 1964190,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "or her Electra."
    } ]
  }, {
    "tStartMs": 1966980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "All of these mistakes\ncould have been resolved"
    } ]
  }, {
    "tStartMs": 1969200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "if Earhart had two-way communication,"
    } ]
  }, {
    "tStartMs": 1971420,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but her belly antenna\nsomehow malfunctioned."
    } ]
  }, {
    "tStartMs": 1974180,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Some theories suggest"
    } ]
  }, {
    "tStartMs": 1975470,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "it fell off during takeoff in New Guinea,"
    } ]
  }, {
    "tStartMs": 1977750,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but without physical evidence,"
    } ]
  }, {
    "tStartMs": 1979160,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "it's impossible to say."
    } ]
  }, {
    "tStartMs": 1981950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But Earhart did confirm receiving signals"
    } ]
  }, {
    "tStartMs": 1984470,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "on her loop antenna."
    } ]
  }, {
    "tStartMs": 1986030,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Her loop could only direction\nfind with lower frequencies,"
    } ]
  }, {
    "tStartMs": 1989030,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "but it could receive\nsignals on a wide range."
    } ]
  }, {
    "tStartMs": 1992240,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "If she had switched to using the loop"
    } ]
  }, {
    "tStartMs": 1994970,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "for all communications,"
    } ]
  }, {
    "tStartMs": 1997070,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "she could have received\nItasca's voice messages"
    } ]
  }, {
    "tStartMs": 2000220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and then the Itasca could have requested"
    } ]
  }, {
    "tStartMs": 2002350,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "she take a bearing on a lower frequency,"
    } ]
  }, {
    "tStartMs": 2005080,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "which would have guided her\nsafely to Howland Island."
    } ]
  }, {
    "tStartMs": 2011260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "When I began researching this video,"
    } ]
  }, {
    "tStartMs": 2013510,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I expected to find"
    } ]
  }, {
    "tStartMs": 2014620,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that Amelia Earhart's\ndemise was inevitable."
    } ]
  }, {
    "tStartMs": 2017650,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "That what she was trying\nto do was just so difficult"
    } ]
  }, {
    "tStartMs": 2021070,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that nothing could have saved her."
    } ]
  }, {
    "tStartMs": 2023500,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But instead, I found the opposite."
    } ]
  }, {
    "tStartMs": 2025990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "There were at least a half dozen things"
    } ]
  }, {
    "tStartMs": 2027910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that if they went differently"
    } ]
  }, {
    "tStartMs": 2029560,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "would have allowed her to land safely."
    } ]
  }, {
    "tStartMs": 2032320,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So to me, this story\ncomes down to two things."
    } ]
  }, {
    "tStartMs": 2035590,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Knowledge and responsibility."
    } ]
  }, {
    "tStartMs": 2038260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Earhart lacked knowledge of radio systems,"
    } ]
  }, {
    "tStartMs": 2040660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "which would've allowed her to specify"
    } ]
  }, {
    "tStartMs": 2042640,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the right direction finding frequency."
    } ]
  }, {
    "tStartMs": 2045130,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But Commander Thompson of the\nItasca had that knowledge."
    } ]
  }, {
    "tStartMs": 2048580,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "He knew her direction finding limits,"
    } ]
  }, {
    "tStartMs": 2050920,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "but he didn't take on the\nresponsibility to correct her."
    } ]
  }, {
    "tStartMs": 2054940,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "When attempting any challenging endeavor,"
    } ]
  }, {
    "tStartMs": 2057580,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you need someone with the right knowledge"
    } ]
  }, {
    "tStartMs": 2059830,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "who will also take responsibility\nfor getting things right."
    } ]
  }, {
    "tStartMs": 2063490,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "That's what you need"
    } ]
  }, {
    "tStartMs": 2064630,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "to battle the inherent chaos\nand disorder of the universe."
    } ]
  }, {
    "tStartMs": 2069130,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "Otherwise, what you get is disaster."
    } ]
  }, {
    "tStartMs": 2078430,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This video was sponsored by KiwiCo,"
    } ]
  }, {
    "tStartMs": 2080770,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so I thought it would be appropriate"
    } ]
  }, {
    "tStartMs": 2082570,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to build their\nradio-controlled delivery bot."
    } ]
  }, {
    "tStartMs": 2086050,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But my oldest kid was\nout for the afternoon,"
    } ]
  }, {
    "tStartMs": 2088540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "so I sat down to make it by myself,"
    } ]
  }, {
    "tStartMs": 2090580,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "but very quickly I was joined"
    } ]
  }, {
    "tStartMs": 2092350,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "by my 4-year-old and 6-year-old"
    } ]
  }, {
    "tStartMs": 2094120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "who were really excited to help."
    } ]
  }, {
    "tStartMs": 2096160,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "You know, we have been getting\nKiwiCo delivered to our door"
    } ]
  }, {
    "tStartMs": 2098830,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "for years now"
    } ]
  }, {
    "tStartMs": 2099850,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and it's one of my kids'\nfavorite things to do with me."
    } ]
  }, {
    "tStartMs": 2103150,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "They have a lot of fun"
    } ]
  }, {
    "tStartMs": 2104380,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "while we're also spending\nquality time together."
    } ]
  }, {
    "tStartMs": 2107470,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And somewhat secretly,\nthey're also learning,"
    } ]
  }, {
    "tStartMs": 2110410,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "not only technical knowledge,"
    } ]
  }, {
    "tStartMs": 2111670,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "but also knowledge of how\nsimple and understandable"
    } ]
  }, {
    "tStartMs": 2114850,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "machines that at first\nappear complex can be."
    } ]
  }, {
    "tStartMs": 2118840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I think it's great that\nthey're getting hands-on"
    } ]
  }, {
    "tStartMs": 2121360,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "with wheels and motors\nand radio transmitters."
    } ]
  }, {
    "tStartMs": 2124570,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I think it enables them to\nbuild up this resilience"
    } ]
  }, {
    "tStartMs": 2127660,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and an attitude that, well,\nI can understand that,"
    } ]
  }, {
    "tStartMs": 2131200,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I could probably build that."
    } ]
  }, {
    "tStartMs": 2133540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And KiwiCo takes responsibility"
    } ]
  }, {
    "tStartMs": 2135220,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "for ensuring everything you\nneed is right in the box,"
    } ]
  }, {
    "tStartMs": 2138130,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which means no extra trips to the store."
    } ]
  }, {
    "tStartMs": 2140980,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "When a crate turns up,"
    } ]
  }, {
    "tStartMs": 2142240,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "you can sit down right\naway and get into it."
    } ]
  }, {
    "tStartMs": 2145390,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "They have something for kids of all ages"
    } ]
  }, {
    "tStartMs": 2148420,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and each crate is designed by experts"
    } ]
  }, {
    "tStartMs": 2150430,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and rigorously tested by kids"
    } ]
  }, {
    "tStartMs": 2152020,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to make sure it promotes\nlearning and engagement"
    } ]
  }, {
    "tStartMs": 2154780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and is just generally really fun to do."
    } ]
  }, {
    "tStartMs": 2157270,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I noticed that their\ninstructions keep getting better"
    } ]
  }, {
    "tStartMs": 2159220,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "with helpful hints to ensure"
    } ]
  }, {
    "tStartMs": 2160540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you've done everything correctly."
    } ]
  }, {
    "tStartMs": 2162280,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And with KiwiCo Labs for ages six and up,"
    } ]
  }, {
    "tStartMs": 2165220,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "kids use the problem-solving\nskills they've developed"
    } ]
  }, {
    "tStartMs": 2168070,
    "dDurationMs": 3992,
    "segs": [ {
      "utf8": "to engineer cool games,\nrobots, or everyday products."
    } ]
  }, {
    "tStartMs": 2172062,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "(child laughing)"
    } ]
  }, {
    "tStartMs": 2173530,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So if you wanna try out KiwiCo,"
    } ]
  }, {
    "tStartMs": 2175000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "use my code, Veritasium,"
    } ]
  }, {
    "tStartMs": 2176620,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to get 50% off your first\ncrate of a monthly club."
    } ]
  }, {
    "tStartMs": 2179650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And with the holidays around the corner,"
    } ]
  }, {
    "tStartMs": 2181300,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "KiwiCo makes a great gift for families."
    } ]
  }, {
    "tStartMs": 2183970,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Head to kiwico.com/veritasium"
    } ]
  }, {
    "tStartMs": 2186580,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to check out their great\nclub options today."
    } ]
  }, {
    "tStartMs": 2189400,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So I wanna thank KiwiCo\nfor sponsoring this video"
    } ]
  }, {
    "tStartMs": 2192070,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
