    "tStartMs": 740440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "including your dream PC setup -"
    } ]
  }, {
    "tStartMs": 742440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "if you can answer my Techie Test question."
    } ]
  }, {
    "tStartMs": 745060,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Now, Fasthosts provides of a wide range of web hosting products."
    } ]
  }, {
    "tStartMs": 749320,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "If you’re in the UK and looking to start a podcast, blog, or business,"
    } ]
  }, {
    "tStartMs": 754020,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "you’re going to need a website."
    } ]
  }, {
    "tStartMs": 755740,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "And Fasthosts have got you covered."
    } ]
  }, {
    "tStartMs": 757920,
    "dDurationMs": 6420,
    "segs": [ {
      "utf8": "They offer easy registration for a huge range of domain names with powerful management features included."
    } ]
  }, {
    "tStartMs": 764340,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Plus a website builder with drag and drop templates."
    } ]
  }, {
    "tStartMs": 768180,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "You can create a custom, mobile-optimized website with no coding required."
    } ]
  }, {
    "tStartMs": 772920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Get up to three months free "
    } ]
  }, {
    "tStartMs": 774280,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "and if you’re not satisfied in the first 30 days you can cancel without paying a penny."
    } ]
  }, {
    "tStartMs": 779520,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Now on to my techie test question:"
    } ]
  }, {
    "tStartMs": 782280,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Which famous scientist criticized Newtonian gravity saying:"
    } ]
  }, {
    "tStartMs": 787160,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "\"That Gravity should be innate, inherent and essential to Matter,"
    } ]
  }, {
    "tStartMs": 791440,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "so that one body may act upon another at a distance through a vacuum, "
    } ]
  }, {
    "tStartMs": 795420,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "without the mediation of anything else..."
    } ]
  }, {
    "tStartMs": 798400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is to me so great an absurdity that "
    } ]
  }, {
    "tStartMs": 801520,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "I believe no Man who has in philosophical Matters a competent Faculty of thinking can ever fall into it.\""
    } ]
  }, {
    "tStartMs": 808760,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "If you know the answer and you live in the UK, "
    } ]
  }, {
    "tStartMs": 812480,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "click the link below for your chance to win the ultimate tech bundle."
    } ]
  }, {
    "tStartMs": 816060,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "I want to thank Fasthosts for sponsoring the video and I want to thank you for watching."
    } ]
  } ]
}
