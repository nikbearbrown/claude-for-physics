{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 240,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- [Derek] There are\nrobots the size of bees,"
    } ]
  }, {
    "tStartMs": 3510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "others that can jump on water,"
    } ]
  }, {
    "tStartMs": 5790,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and some that are powered"
    } ]
  }, {
    "tStartMs": 7200,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "by tiny combustion engines\nthe size of a penny."
    } ]
  }, {
    "tStartMs": 11370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "One day they could work in swarms,"
    } ]
  }, {
    "tStartMs": 13860,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "they could save your\nlife, or even spy on you."
    } ]
  }, {
    "tStartMs": 18540,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "We got access to the best micro\nrobotics labs in the world."
    } ]
  }, {
    "tStartMs": 21533,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- Whoo, that flipped."
    } ]
  }, {
    "tStartMs": 22950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Derek] To learn\nhow these robots work"
    } ]
  }, {
    "tStartMs": 25200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and what are they for."
    } ]
  }, {
    "tStartMs": 27810,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This video is sponsored by Onshape."
    } ]
  }, {
    "tStartMs": 30660,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This is a tiny yellow submarine."
    } ]
  }, {
    "tStartMs": 33720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Under water, it can move around"
    } ]
  }, {
    "tStartMs": 35160,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "by flapping these miniature\nwings nine times per second,"
    } ]
  }, {
    "tStartMs": 39900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but you can use those same wings"
    } ]
  }, {
    "tStartMs": 41580,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "when the submarine is out of the water,"
    } ]
  }, {
    "tStartMs": 43710,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "only now you have to flap\nthem 250 times a second"
    } ]
  }, {
    "tStartMs": 47430,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to make it fly."
    } ]
  }, {
    "tStartMs": 48930,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So, this robot can do both."
    } ]
  }, {
    "tStartMs": 50760,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It can fly and swim,"
    } ]
  }, {
    "tStartMs": 53070,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but since it weighs only 175 milligrams,"
    } ]
  }, {
    "tStartMs": 55710,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "about the mass of two Cheerios,"
    } ]
  }, {
    "tStartMs": 57510,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "surface tension is a problem."
    } ]
  }, {
    "tStartMs": 60330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- That's a consequence of\nphysics at a smaller scale."
    } ]
  }, {
    "tStartMs": 63330,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The surface tension is like a wall"
    } ]
  }, {
    "tStartMs": 64770,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that blocks the transition process."
    } ]
  }, {
    "tStartMs": 67440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- This happens because water molecules"
    } ]
  }, {
    "tStartMs": 69120,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "are slightly polar."
    } ]
  }, {
    "tStartMs": 70290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Groups of these molecules\npull in all directions,"
    } ]
  }, {
    "tStartMs": 73320,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but at the surface there's no water above,"
    } ]
  }, {
    "tStartMs": 75750,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "so the pull is only\nsideways and downwards."
    } ]
  }, {
    "tStartMs": 78840,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "This imbalance creates\nstrong, cohesive forces"
    } ]
  }, {
    "tStartMs": 81330,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "that compress the surface\ninto a tightly packed layer,"
    } ]
  }, {
    "tStartMs": 84600,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "making it difficult to break."
    } ]
  }, {
    "tStartMs": 87180,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "This is the same effect"
    } ]
  }, {
    "tStartMs": 88350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that lets water striders walk"
    } ]
  }, {
    "tStartMs": 89940,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "on the surfaces of ponds and lakes."
    } ]
  }, {
    "tStartMs": 93030,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This other robot weighs only 68 milligrams"
    } ]
  }, {
    "tStartMs": 96270,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and by using a spring mechanism\nthat mimics a flea's leg,"
    } ]
  }, {
    "tStartMs": 99600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it can jump without breaking\nthe water's surface,"
    } ]
  }, {
    "tStartMs": 102660,
    "dDurationMs": 1622,
    "segs": [ {
      "utf8": "just like a water strider."
    } ]
  }, {
    "tStartMs": 104282,
    "dDurationMs": 2188,
    "segs": [ {
      "utf8": "(upbeat music)\n(water bubbles)"
    } ]
  }, {
    "tStartMs": 106470,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "It's like there's solid ground below."
    } ]
  }, {
    "tStartMs": 109315,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "(water bubbles)"
    } ]
  }, {
    "tStartMs": 111450,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now that's great if you wanna\nstay on top of the water,"
    } ]
  }, {
    "tStartMs": 114360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "but this barrier can also be a problem"
    } ]
  }, {
    "tStartMs": 116400,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "if you want to go underwater."
    } ]
  }, {
    "tStartMs": 120030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "To escape this trap,"
    } ]
  }, {
    "tStartMs": 121470,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "the submarine splits water\ninto hydrogen and oxygen"
    } ]
  }, {
    "tStartMs": 125220,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and then stores these gases\nin a buoyancy chamber."
    } ]
  }, {
    "tStartMs": 128580,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "It does this because the\nwings are super fragile."
    } ]
  }, {
    "tStartMs": 131730,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "If they started flapping while the robot"
    } ]
  }, {
    "tStartMs": 133800,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "was still trapped under water,\nthey would break right off."
    } ]
  }, {
    "tStartMs": 137730,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So, the buoyancy from the gas\nhelps bring the fragile parts"
    } ]
  }, {
    "tStartMs": 141150,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "of the robot out of the water,"
    } ]
  }, {
    "tStartMs": 144210,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "but the robot is still stuck"
    } ]
  }, {
    "tStartMs": 145680,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "in that top layer of surface tension."
    } ]
  }, {
    "tStartMs": 148470,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "So, a sparker inside the\nchamber ignites the gas,"
    } ]
  }, {
    "tStartMs": 152520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and the explosion breaks\nthe surface tension"
    } ]
  }, {
    "tStartMs": 154740,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "and shoots the robot 30\ncentimeters into the air."
    } ]
  }, {
    "tStartMs": 159150,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "And once it's free, this robot can fly."
    } ]
  }, {
    "tStartMs": 164220,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "This robot found a different way"
    } ]
  }, {
    "tStartMs": 165810,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to break through the surface tension."
    } ]
  }, {
    "tStartMs": 167430,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It uses these large water\nrepellent copper pads on its feet"
    } ]
  }, {
    "tStartMs": 170700,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "to walk on the water,"
    } ]
  }, {
    "tStartMs": 173070,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but when it needs to dive beneath,"
    } ]
  }, {
    "tStartMs": 175140,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it applies 600 volts to those pads,"
    } ]
  }, {
    "tStartMs": 177750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "which creates a positive charge"
    } ]
  }, {
    "tStartMs": 179340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that attracts water molecules to it"
    } ]
  }, {
    "tStartMs": 181020,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and breaks the hydrophobic barrier,"
    } ]
  }, {
    "tStartMs": 183240,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "and that allows it to sink on command."
    } ]
  }, {
    "tStartMs": 185674,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "(gentle music)\n(water gurgling)"
    } ]
  }, {
    "tStartMs": 188490,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "Then, once submerged,\nit can walk underwater."
    } ]
  }, {
    "tStartMs": 193260,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Both of these robots were\nmade by Dr. Kevin Chen at MIT."
    } ]
  }, {
    "tStartMs": 197160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- We're looking at the flight room,"
    } ]
  }, {
    "tStartMs": 198570,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and this is where we do all\nof our flight experiment."
    } ]
  }, {
    "tStartMs": 201450,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "As you can see, it has\nmotion capture cameras."
    } ]
  }, {
    "tStartMs": 205350,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] This lab"
    } ]
  }, {
    "tStartMs": 206183,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "is one of the only places in the world"
    } ]
  }, {
    "tStartMs": 207420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "where robots this small attempt flight."
    } ]
  }, {
    "tStartMs": 209520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Henry] Okay, so because\nthis robot's so small,"
    } ]
  }, {
    "tStartMs": 211680,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it is such low inertia, right?"
    } ]
  }, {
    "tStartMs": 213000,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So, you're saying that\nit could flip faster"
    } ]
  }, {
    "tStartMs": 214650,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "than any other drone in the world?"
    } ]
  }, {
    "tStartMs": 216120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Beyond 7,000 degrees per second."
    } ]
  }, {
    "tStartMs": 218820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I mean, you can actually hit the button."
    } ]
  }, {
    "tStartMs": 220800,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- You'd let me hit the button?"
    } ]
  }, {
    "tStartMs": 222060,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Yeah, I'd love to."
    } ]
  }, {
    "tStartMs": 223020,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Ready?\n- Yep."
    } ]
  }, {
    "tStartMs": 224100,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "- Okay.\n- Three, two, one."
    } ]
  }, {
    "tStartMs": 226349,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "(robot buzzing)\n(triumphant music)"
    } ]
  }, {
    "tStartMs": 228188,
    "dDurationMs": 2071,
    "segs": [ {
      "utf8": "(group cheering)"
    } ]
  }, {
    "tStartMs": 230259,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "(defeated music)\n(robot buzzing)"
    } ]
  }, {
    "tStartMs": 232293,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "- We know who's fault it is."
    } ]
  }, {
    "tStartMs": 233280,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "(group laughing)"
    } ]
  }, {
    "tStartMs": 235770,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Derek] Getting these\nrobots flying is tough."
    } ]
  }, {
    "tStartMs": 238020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I mean, they're the size of bees,"
    } ]
  }, {
    "tStartMs": 240060,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so the internal mechanisms\nhave to be even smaller,"
    } ]
  }, {
    "tStartMs": 243360,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "like the parts of a watch."
    } ]
  }, {
    "tStartMs": 245190,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- Yep.\n(wing buzzes)"
    } ]
  }, {
    "tStartMs": 246480,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- You got that?"
    } ]
  }, {
    "tStartMs": 247313,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "- [Derek] Components\nhave to be precise"
    } ]
  }, {
    "tStartMs": 248340,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to within five microns."
    } ]
  }, {
    "tStartMs": 250080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "That's a 10th the width of a human hair."
    } ]
  }, {
    "tStartMs": 253260,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- In the summer,"
    } ]
  }, {
    "tStartMs": 254093,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "we have those very big\nflies zipping by in the lab,"
    } ]
  }, {
    "tStartMs": 257010,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "and I was making the statement of,"
    } ]
  }, {
    "tStartMs": 258637,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "\"Oh, they're just showing off.\""
    } ]
  }, {
    "tStartMs": 260047,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "(group laughing)"
    } ]
  }, {
    "tStartMs": 261780,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Henry] Take two."
    } ]
  }, {
    "tStartMs": 263310,
    "dDurationMs": 1528,
    "segs": [ {
      "utf8": "- Three, two, one."
    } ]
  }, {
    "tStartMs": 264838,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "(robot buzzes)"
    } ]
  }, {
    "tStartMs": 267057,
    "dDurationMs": 1393,
    "segs": [ {
      "utf8": "- Whoo!"
    } ]
  }, {
    "tStartMs": 268450,
    "dDurationMs": 3109,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 271559,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "- That flipped.\n- There we go."
    } ]
  }, {
    "tStartMs": 273644,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(group clapping)"
    } ]
  }, {
    "tStartMs": 280730,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- So these bots fly but not like birds."
    } ]
  }, {
    "tStartMs": 283410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I mean, they don't soar."
    } ]
  }, {
    "tStartMs": 285270,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Instead, they have to use\na whole lot more energy,"
    } ]
  }, {
    "tStartMs": 287970,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "flapping their wings\nhundreds of times per second."
    } ]
  }, {
    "tStartMs": 291600,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So why do they do that?"
    } ]
  }, {
    "tStartMs": 293730,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Well, it comes down to\nthis scale phenomenon."
    } ]
  }, {
    "tStartMs": 297750,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Larger objects typically\nhave less surface area"
    } ]
  }, {
    "tStartMs": 300630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "relative to their volume,"
    } ]
  }, {
    "tStartMs": 302610,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "and that's important."
    } ]
  }, {
    "tStartMs": 304590,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Let's just approximate a flyer by a cube."
    } ]
  }, {
    "tStartMs": 307470,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Let's say it's 10 centimeters on a side."
    } ]
  }, {
    "tStartMs": 310650,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Well then that would have\na volume of 10 by 10 by 10,"
    } ]
  }, {
    "tStartMs": 314070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "or a thousand cubic centimeters,"
    } ]
  }, {
    "tStartMs": 316080,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and it would have an area\nof 10 by 10 by six sides,"
    } ]
  }, {
    "tStartMs": 319740,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "600 square centimeters."
    } ]
  }, {
    "tStartMs": 321990,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "So the surface area to volume\nratio would be 0.6 to one."
    } ]
  }, {
    "tStartMs": 326220,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But now imagine we have\na much smaller flyer"
    } ]
  }, {
    "tStartMs": 328470,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that is just one cubic\ncentimeter in volume."
    } ]
  }, {
    "tStartMs": 331920,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "Well, its surface area is going\nto be one by one times six."
    } ]
  }, {
    "tStartMs": 336390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "That is six square centimeters."
    } ]
  }, {
    "tStartMs": 338610,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So that's gonna be 10\ntimes the surface area"
    } ]
  }, {
    "tStartMs": 341880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to volume ratio."
    } ]
  }, {
    "tStartMs": 342713,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "It's gonna have a surface\narea to volume ratio"
    } ]
  }, {
    "tStartMs": 344310,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of six to one."
    } ]
  }, {
    "tStartMs": 346140,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Now why is that so important?"
    } ]
  }, {
    "tStartMs": 348090,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Well, it's because drag\ndepends on surface area."
    } ]
  }, {
    "tStartMs": 351150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So if you have more surface area to volume,"
    } ]
  }, {
    "tStartMs": 353820,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "well you're gonna have a lot more drag,"
    } ]
  }, {
    "tStartMs": 356130,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and also, at that small scale,"
    } ]
  }, {
    "tStartMs": 358740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "you'll be much lighter\nrelative to that drag."
    } ]
  }, {
    "tStartMs": 361560,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So you're not gonna have as much inertia,"
    } ]
  }, {
    "tStartMs": 363300,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so you'll get pushed\naround more by the air,"
    } ]
  }, {
    "tStartMs": 366600,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "so you can't just soar\nthrough it like a bird."
    } ]
  }, {
    "tStartMs": 369510,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And that's why bees"
    } ]
  }, {
    "tStartMs": 370590,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "and other insects flap their wings a lot."
    } ]
  }, {
    "tStartMs": 374520,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "What they're doing is\ngenerating swirls of air"
    } ]
  }, {
    "tStartMs": 377190,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "above the top of the wing,"
    } ]
  }, {
    "tStartMs": 378810,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and those vortices create\nlow-pressure zones."
    } ]
  }, {
    "tStartMs": 382290,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "When combined with the high\npressure below the wing,"
    } ]
  }, {
    "tStartMs": 384510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that is what generates lift."
    } ]
  }, {
    "tStartMs": 386670,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So they're pushed up into\nthat low pressure region"
    } ]
  }, {
    "tStartMs": 389910,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "by flapping their wings back and forth."
    } ]
  }, {
    "tStartMs": 395550,
    "dDurationMs": 3398,
    "segs": [ {
      "utf8": "This robot was inspired by\nseeds from a maple tree."
    } ]
  }, {
    "tStartMs": 398948,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 400710,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Their unique shape creates\nthe same swirling vortices"
    } ]
  }, {
    "tStartMs": 403590,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "above the seed's leading edge,"
    } ]
  }, {
    "tStartMs": 407130,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "and as they fall,"
    } ]
  }, {
    "tStartMs": 408060,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "they spin and generate\nsurprisingly high lift."
    } ]
  }, {
    "tStartMs": 412440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "These seeds are still just falling,"
    } ]
  }, {
    "tStartMs": 415320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but if you add miniature electric rotors"
    } ]
  }, {
    "tStartMs": 418140,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "to the ends of each wingtip on this robot,"
    } ]
  }, {
    "tStartMs": 420690,
    "dDurationMs": 2785,
    "segs": [ {
      "utf8": "then it can generate enough lift to fly."
    } ]
  }, {
    "tStartMs": 423475,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(gentle music)\n(robot whirring)"
    } ]
  }, {
    "tStartMs": 428850,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But this robot isn't quite insect scale."
    } ]
  }, {
    "tStartMs": 432450,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It actually weighs about 50\ntimes more than the RoboBees"
    } ]
  }, {
    "tStartMs": 435720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in Kevin's lab."
    } ]
  }, {
    "tStartMs": 437220,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So to power something that small,"
    } ]
  }, {
    "tStartMs": 439350,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you can't just use electric motors."
    } ]
  }, {
    "tStartMs": 441810,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I mean, the magnets and coils\ndon't scale down effectively"
    } ]
  }, {
    "tStartMs": 444870,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "to such a small size."
    } ]
  }, {
    "tStartMs": 447801,
    "dDurationMs": 1389,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 449190,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So to power the first RoboBees,"
    } ]
  }, {
    "tStartMs": 451230,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "they had wings driven by special crystals"
    } ]
  }, {
    "tStartMs": 453720,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "called piezoelectric crystals."
    } ]
  }, {
    "tStartMs": 456630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "By applying a voltage across the crystal,"
    } ]
  }, {
    "tStartMs": 458790,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they contract slightly,"
    } ]
  }, {
    "tStartMs": 460500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but only around 0.1%,"
    } ]
  }, {
    "tStartMs": 462690,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "not nearly enough of a\ndeflection to make a robot fly."
    } ]
  }, {
    "tStartMs": 466650,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So roboticists designed a chassis"
    } ]
  }, {
    "tStartMs": 468780,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "that mechanically amplifies\nthe motion 30 times."
    } ]
  }, {
    "tStartMs": 472500,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "If you then turn the voltage on"
    } ]
  }, {
    "tStartMs": 473970,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and off 120 times per second,"
    } ]
  }, {
    "tStartMs": 476250,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "the RoboBee flaps its wings and flies."
    } ]
  }, {
    "tStartMs": 481860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But there is a downside\nto piezoelectric crystals,"
    } ]
  }, {
    "tStartMs": 484890,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "which is, they're fragile."
    } ]
  }, {
    "tStartMs": 486840,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Even a small impact to the\nwings and the crystal cracks,"
    } ]
  }, {
    "tStartMs": 490650,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and the RoboBee stops working."
    } ]
  }, {
    "tStartMs": 492960,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "So at MIT, they are building\ntheir RoboBees differently."
    } ]
  }, {
    "tStartMs": 497190,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- They're so confident that\nit will survive being dropped"
    } ]
  }, {
    "tStartMs": 500280,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that they're gonna let me\nthrow it off of a building."
    } ]
  }, {
    "tStartMs": 502590,
    "dDurationMs": 2515,
    "segs": [ {
      "utf8": "So, I mean, here we go."
    } ]
  }, {
    "tStartMs": 505105,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "(robot dings)"
    } ]
  }, {
    "tStartMs": 507458,
    "dDurationMs": 2126,
    "segs": [ {
      "utf8": "(laughing)\nOkay, we gotta go see it. Come on."
    } ]
  }, {
    "tStartMs": 509584,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(gentle music)\n(henry laughs)"
    } ]
  }, {
    "tStartMs": 514650,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I mean, it looks pretty good."
    } ]
  }, {
    "tStartMs": 515850,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This is amazing."
    } ]
  }, {
    "tStartMs": 517350,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Like how does this thing\nsurvive? I have no idea."
    } ]
  }, {
    "tStartMs": 520950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- [Derek] Well, these\nrobots have a secret ingredient."
    } ]
  }, {
    "tStartMs": 523470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- So put into scale.\n- Okay."
    } ]
  }, {
    "tStartMs": 525150,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Zero it."
    } ]
  }, {
    "tStartMs": 526320,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Derek] Instead of using\npiezos to drive the wings,"
    } ]
  }, {
    "tStartMs": 528570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "these bees use soft polymers."
    } ]
  }, {
    "tStartMs": 530940,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They effectively work like tiny muscles."
    } ]
  }, {
    "tStartMs": 533190,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Just drop it here."
    } ]
  }, {
    "tStartMs": 535050,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] They take a polymer"
    } ]
  }, {
    "tStartMs": 536250,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and they coat each side\nwith carbon nanotubes"
    } ]
  }, {
    "tStartMs": 539310,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that creates two effective\nconducting plates."
    } ]
  }, {
    "tStartMs": 542670,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So if you apply opposite\ncharges to these plates,"
    } ]
  }, {
    "tStartMs": 545250,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "that pulls them together,\nstretching out the polymer."
    } ]
  }, {
    "tStartMs": 548940,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "But if like charges are applied\nto both plates, they repel,"
    } ]
  }, {
    "tStartMs": 552690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and so the polymer shrinks"
    } ]
  }, {
    "tStartMs": 555270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and if we roll up layers\nlike this into a tube,"
    } ]
  }, {
    "tStartMs": 557850,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we can amplify the force they generate."
    } ]
  }, {
    "tStartMs": 560370,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "It stretches up to 25% of its length."
    } ]
  }, {
    "tStartMs": 564450,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "By cycling the voltage\nhundreds of times per second,"
    } ]
  }, {
    "tStartMs": 567300,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "these muscles drive the RoboBees wings."
    } ]
  }, {
    "tStartMs": 572850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- When you shrink down to smaller scale,"
    } ]
  }, {
    "tStartMs": 575280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "your fly wing frequency goes up higher."
    } ]
  }, {
    "tStartMs": 577440,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So we are at the 400 hertz range."
    } ]
  }, {
    "tStartMs": 579390,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Which is right in between\na honeybee and a mosquito."
    } ]
  }, {
    "tStartMs": 581790,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Yes.\n(group laughs)"
    } ]
  }, {
    "tStartMs": 584490,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Derek] This flexible\nmuscle can take bumps"
    } ]
  }, {
    "tStartMs": 586320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and scrapes and keep working,"
    } ]
  }, {
    "tStartMs": 588240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but if it's pierced by a needle,"
    } ]
  }, {
    "tStartMs": 590430,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the carbon nanotubes get pulled in"
    } ]
  }, {
    "tStartMs": 593250,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and then the plates touch,"
    } ]
  }, {
    "tStartMs": 594750,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "causing a short circuit that\nrenders the muscle useless."
    } ]
  }, {
    "tStartMs": 597990,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But the scientists have even\nfound a way around this."
    } ]
  }, {
    "tStartMs": 600870,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "When high current is cycled,"
    } ]
  }, {
    "tStartMs": 602850,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the carbon nanotubes that\nare touching burn off"
    } ]
  }, {
    "tStartMs": 605730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and so the muscle self-heals."
    } ]
  }, {
    "tStartMs": 608370,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Kevin and his team even invented a process"
    } ]
  }, {
    "tStartMs": 610350,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to perform laser surgery on the robot."
    } ]
  }, {
    "tStartMs": 613350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- You're creating smaller defect"
    } ]
  }, {
    "tStartMs": 615240,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "around a very, very big defect"
    } ]
  }, {
    "tStartMs": 617070,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and then by isolating the small defect,"
    } ]
  }, {
    "tStartMs": 619020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you're using the small defect\nto isolate the big defect."
    } ]
  }, {
    "tStartMs": 621480,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "So that was what we call"
    } ]
  }, {
    "tStartMs": 622560,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "the laser-assisted clearing process."
    } ]
  }, {
    "tStartMs": 625770,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- One robot was really\ntested to its limits."
    } ]
  }, {
    "tStartMs": 628590,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Its artificial muscle was\npierced by cactus needles"
    } ]
  }, {
    "tStartMs": 631470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and hit by a laser beam\n(laser sizzling)"
    } ]
  }, {
    "tStartMs": 633270,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "and it could still fly,"
    } ]
  }, {
    "tStartMs": 636630,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but these muscles are energy intensive"
    } ]
  }, {
    "tStartMs": 639060,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and for robots at this scale\nthat have to be so light,"
    } ]
  }, {
    "tStartMs": 641910,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "there's no room for extra batteries."
    } ]
  }, {
    "tStartMs": 644700,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Luckily, there is another\nway to get around."
    } ]
  }, {
    "tStartMs": 648240,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Henry] That's a jumping, flying robot."
    } ]
  }, {
    "tStartMs": 649620,
    "dDurationMs": 908,
    "segs": [ {
      "utf8": "- [Kevin] Yeah."
    } ]
  }, {
    "tStartMs": 650528,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 651570,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- [Derek] This RoboBee\nconserves energy by hopping."
    } ]
  }, {
    "tStartMs": 654810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "This tech was used on another drone"
    } ]
  }, {
    "tStartMs": 656580,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "at the City University of Hong Kong."
    } ]
  }, {
    "tStartMs": 659010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Normally this drone can\nonly fly continuously"
    } ]
  }, {
    "tStartMs": 661650,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "for 6.3 minutes,"
    } ]
  }, {
    "tStartMs": 663540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but with the hopping attachment,"
    } ]
  }, {
    "tStartMs": 665400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "it can keep moving for 50 minutes,"
    } ]
  }, {
    "tStartMs": 667860,
    "dDurationMs": 1331,
    "segs": [ {
      "utf8": "nearly 10 times longer."
    } ]
  }, {
    "tStartMs": 669191,
    "dDurationMs": 2209,
    "segs": [ {
      "utf8": "(RoboBee buzzing)"
    } ]
  }, {
    "tStartMs": 671400,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Scientists believe this\ncould be even more effective"
    } ]
  }, {
    "tStartMs": 673650,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "in low-gravity, low-air\nresistance environments like Mars."
    } ]
  }, {
    "tStartMs": 677190,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "So it would be perfect for\nan ingenuity version 2.0."
    } ]
  }, {
    "tStartMs": 681990,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "But microrobots are\nalready being used today."
    } ]
  }, {
    "tStartMs": 684838,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "(gentle music)\n(airplane whooshing)"
    } ]
  }, {
    "tStartMs": 687180,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Every day planes complete\nhundreds of thousands of flights"
    } ]
  }, {
    "tStartMs": 690480,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and most of them have\nmultiple turbine engines."
    } ]
  }, {
    "tStartMs": 693510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now a crack in a turbine\ncan be catastrophic,"
    } ]
  }, {
    "tStartMs": 696060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "so manufacturers inspect\nthem every 3000 flight cycles"
    } ]
  }, {
    "tStartMs": 699300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "or 180 days,"
    } ]
  }, {
    "tStartMs": 701340,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but inspections cost tens\nof thousands of dollars"
    } ]
  }, {
    "tStartMs": 704130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and can take a whole day."
    } ]
  }, {
    "tStartMs": 706500,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "That's where this cockroach-inspired\nrobot from earlier,"
    } ]
  }, {
    "tStartMs": 709380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "HAMR, comes in."
    } ]
  }, {
    "tStartMs": 710880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's incredibly fast,"
    } ]
  }, {
    "tStartMs": 712470,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it can run 10.5 body lengths per second."
    } ]
  }, {
    "tStartMs": 715530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Speaking in relative terms,"
    } ]
  }, {
    "tStartMs": 717120,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that's faster than a\nhorse, and it's versatile."
    } ]
  }, {
    "tStartMs": 720450,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Its special foot pads can apply a voltage"
    } ]
  }, {
    "tStartMs": 723300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to polarized metal surfaces,"
    } ]
  }, {
    "tStartMs": 725370,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "creating an opposite\ncharge underneath its feet"
    } ]
  }, {
    "tStartMs": 728310,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and that's how it's able\nto stick to metal surfaces,"
    } ]
  }, {
    "tStartMs": 731010,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "similar to a balloon sticking to a wall"
    } ]
  }, {
    "tStartMs": 733560,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "after you rub it on your hair."
    } ]
  }, {
    "tStartMs": 735660,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Rolls-Royce and Harvard\nare working to put HAMR"
    } ]
  }, {
    "tStartMs": 737880,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "inside of engines to\ninspect for turbine cracks"
    } ]
  }, {
    "tStartMs": 741030,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "even upside down."
    } ]
  }, {
    "tStartMs": 742650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And since its mass is so small,"
    } ]
  }, {
    "tStartMs": 744660,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "adhesion forces are much\nstronger relative to its weight."
    } ]
  }, {
    "tStartMs": 748320,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So HAMR can get into some tight spaces"
    } ]
  }, {
    "tStartMs": 751740,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "and that can be pretty useful."
    } ]
  }, {
    "tStartMs": 754577,
    "dDurationMs": 1303,
    "segs": [ {
      "utf8": "(sirens wailing)\nOne of the first times"
    } ]
  }, {
    "tStartMs": 755880,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that robots were deployed\nin an emergency situation"
    } ]
  }, {
    "tStartMs": 758610,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "was during the 9/11 search\nfor survivors at Ground Zero."
    } ]
  }, {
    "tStartMs": 762570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Unfortunately, they didn't\nturn out to be that helpful."
    } ]
  }, {
    "tStartMs": 765600,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "They were big and expensive\nand they'd get stuck."
    } ]
  }, {
    "tStartMs": 769560,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Three different types inspected\neight sections of rubble,"
    } ]
  }, {
    "tStartMs": 772950,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but none found survivors."
    } ]
  }, {
    "tStartMs": 775350,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So an ideal rescue robot"
    } ]
  }, {
    "tStartMs": 777060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "should be able to navigate tight spaces,"
    } ]
  }, {
    "tStartMs": 778980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "withstand damage and debris,"
    } ]
  }, {
    "tStartMs": 780990,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "operate across varied environments,"
    } ]
  }, {
    "tStartMs": 782880,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and be inexpensive enough\nto be replaced if destroyed."
    } ]
  }, {
    "tStartMs": 786540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- The material cost is actually quite low"
    } ]
  }, {
    "tStartMs": 788460,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "for making the robot."
    } ]
  }, {
    "tStartMs": 790237,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "The human labor is high,"
    } ]
  }, {
    "tStartMs": 792240,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but in terms of the material, right,"
    } ]
  }, {
    "tStartMs": 793950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "couple of dollars per robot,"
    } ]
  }, {
    "tStartMs": 795330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but it's really not that much."
    } ]
  }, {
    "tStartMs": 796163,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "- Really?\n- Yes."
    } ]
  }, {
    "tStartMs": 797760,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- So the idea is to deploy swarms"
    } ]
  }, {
    "tStartMs": 800280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of insect-sized microrobots"
    } ]
  }, {
    "tStartMs": 802080,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "to search for survivors in disaster zones."
    } ]
  }, {
    "tStartMs": 804702,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(dramatic music)\n(siren wailing)"
    } ]
  }, {
    "tStartMs": 809790,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But I understand when I say swarm,"
    } ]
  }, {
    "tStartMs": 811740,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "you might get a little worried."
    } ]
  }, {
    "tStartMs": 813630,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I mean, swarms of miniature killer robots"
    } ]
  }, {
    "tStartMs": 815970,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "are straight out of dystopian sci-fi."
    } ]
  }, {
    "tStartMs": 819480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Think the hunter-seeker from \"Dune\""
    } ]
  }, {
    "tStartMs": 821100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "or the killer robot bees\nfrom \"Black Mirror.\""
    } ]
  }, {
    "tStartMs": 823800,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- You might be familiar"
    } ]
  }, {
    "tStartMs": 824633,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "with that like famous\n\"Black Mirror\" TV episode"
    } ]
  }, {
    "tStartMs": 826890,
    "dDurationMs": 971,
    "segs": [ {
      "utf8": "where all like the bees."
    } ]
  }, {
    "tStartMs": 827861,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 828694,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "When that came out,"
    } ]
  }, {
    "tStartMs": 829527,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "everybody that I had ever\nmet in my entire life"
    } ]
  }, {
    "tStartMs": 831480,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "sent me a text message and was like,"
    } ]
  }, {
    "tStartMs": 833197,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "\"Hey bro, you seen this?\""
    } ]
  }, {
    "tStartMs": 836160,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Derek] But this\nidea isn't so farfetched."
    } ]
  }, {
    "tStartMs": 838620,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "In the early 2000s, bees were dying off."
    } ]
  }, {
    "tStartMs": 841650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- It's called\ncolony collapse disorder."
    } ]
  }, {
    "tStartMs": 843840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Congress is holding hearings,"
    } ]
  }, {
    "tStartMs": 845190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "even the Vice President has been briefed."
    } ]
  }, {
    "tStartMs": 846870,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- In fact, the whole\nRoboBee project started"
    } ]
  }, {
    "tStartMs": 848520,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "with the goal of replacing the bees."
    } ]
  }, {
    "tStartMs": 851100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Thankfully that idea didn't last long."
    } ]
  }, {
    "tStartMs": 854160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Bees can do much better jobs"
    } ]
  }, {
    "tStartMs": 856440,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "in terms of pollination than\nthose robots much more cheaply."
    } ]
  }, {
    "tStartMs": 861090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "To pollinate,"
    } ]
  }, {
    "tStartMs": 861923,
    "dDurationMs": 4387,
    "segs": [ {
      "utf8": "you need a huge colony of\nbees to do those effectively."
    } ]
  }, {
    "tStartMs": 866310,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Also, from an environmental\nprotection perspective,"
    } ]
  }, {
    "tStartMs": 868680,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "I think it doesn't make sense"
    } ]
  }, {
    "tStartMs": 869910,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to replace bees with robotics bees"
    } ]
  }, {
    "tStartMs": 873030,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "from a cost-effective perspective"
    } ]
  }, {
    "tStartMs": 875580,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "and also from the\nperspective of, you know,"
    } ]
  }, {
    "tStartMs": 877607,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "if you have so much money,"
    } ]
  }, {
    "tStartMs": 879480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "why you making those bees\nthan protecting the real bees."
    } ]
  }, {
    "tStartMs": 882240,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Okay, so they won't replace the bees,"
    } ]
  }, {
    "tStartMs": 884130,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but I can still easily imagine a world"
    } ]
  }, {
    "tStartMs": 886200,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "where these same robots"
    } ]
  }, {
    "tStartMs": 887430,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that are supposed to help in a disaster"
    } ]
  }, {
    "tStartMs": 889950,
    "dDurationMs": 2339,
    "segs": [ {
      "utf8": "are secretly being used to spy on me."
    } ]
  }, {
    "tStartMs": 892289,
    "dDurationMs": 2491,
    "segs": [ {
      "utf8": "(tense music)\n(robot buzzing)"
    } ]
  }, {
    "tStartMs": 894780,
    "dDurationMs": 4286,
    "segs": [ {
      "utf8": "I mean, it's a bug that would\nliterally look like a bug."
    } ]
  }, {
    "tStartMs": 899066,
    "dDurationMs": 1924,
    "segs": [ {
      "utf8": "(shower water dripping)\nThat's terrifying."
    } ]
  }, {
    "tStartMs": 900990,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Is there any fear from you"
    } ]
  }, {
    "tStartMs": 902160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "about what they could be\nused for, like ethically?"
    } ]
  }, {
    "tStartMs": 905280,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- We really focus on\nthe fundamental science"
    } ]
  }, {
    "tStartMs": 907470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and solving the fun technical problems."
    } ]
  }, {
    "tStartMs": 909480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And as a society in general,"
    } ]
  }, {
    "tStartMs": 911880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "we all should think about collectively"
    } ]
  }, {
    "tStartMs": 914280,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "how to prevent those new\ntechnology from doing harm."
    } ]
  }, {
    "tStartMs": 917760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- But we're getting a\nbit ahead of ourselves."
    } ]
  }, {
    "tStartMs": 920130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I mean, most of the robots we've seen"
    } ]
  }, {
    "tStartMs": 921990,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "aren't able to spy on us."
    } ]
  }, {
    "tStartMs": 923760,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "In fact, they're not\neven fully autonomous."
    } ]
  }, {
    "tStartMs": 926790,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "- We have offboard sensing\nfrom those cameras,"
    } ]
  }, {
    "tStartMs": 930600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "you have offboard power from those,"
    } ]
  }, {
    "tStartMs": 932640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and offboard computation."
    } ]
  }, {
    "tStartMs": 934140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "What you see today is\neverything is offboard."
    } ]
  }, {
    "tStartMs": 936900,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But hopefully in five years,"
    } ]
  }, {
    "tStartMs": 938070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "then we can combine both sensing autonomy"
    } ]
  }, {
    "tStartMs": 939960,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "and power autonomy,"
    } ]
  }, {
    "tStartMs": 940830,
    "dDurationMs": 872,
    "segs": [ {
      "utf8": "and that's the longer-term goal."
    } ]
  }, {
    "tStartMs": 941702,
    "dDurationMs": 898,
    "segs": [ {
      "utf8": "- That's awesome."
    } ]
  }, {
    "tStartMs": 942600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- Harvard's RoboBee has\nmanaged short bursts"
    } ]
  }, {
    "tStartMs": 945660,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "of untethered autonomous flight."
    } ]
  }, {
    "tStartMs": 947910,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So it's fair to say we aren't that far off"
    } ]
  }, {
    "tStartMs": 950640,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "from robot insects\noperating freely around us."
    } ]
  }, {
    "tStartMs": 954300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Still, there is a limit"
    } ]
  }, {
    "tStartMs": 955650,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "to how far these robots\ncan go on just batteries."
    } ]
  }, {
    "tStartMs": 960750,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Batteries need shielding\nto prevent damage,"
    } ]
  }, {
    "tStartMs": 962790,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "short circuits, and leaks."
    } ]
  }, {
    "tStartMs": 964440,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And the thing is, as\nbatteries are scaled down,"
    } ]
  }, {
    "tStartMs": 966660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "this shielding has to stay\nabout the same thickness."
    } ]
  }, {
    "tStartMs": 969390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So that means smaller batteries"
    } ]
  }, {
    "tStartMs": 971250,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "become increasingly inefficient."
    } ]
  }, {
    "tStartMs": 974190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And that's ignoring that\nthe energy-to-weight ratio"
    } ]
  }, {
    "tStartMs": 976380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of batteries is just fundamentally lower"
    } ]
  }, {
    "tStartMs": 978390,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "than that of chemical fuels."
    } ]
  }, {
    "tStartMs": 981540,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "At the insect scale,\nevery milligram matters."
    } ]
  }, {
    "tStartMs": 985170,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- We just said, like let's\njust sail past all of that"
    } ]
  }, {
    "tStartMs": 987660,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and just use a video game cheat code"
    } ]
  }, {
    "tStartMs": 990990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and just power our robot"
    } ]
  }, {
    "tStartMs": 992250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "with the smallest explosions possible"
    } ]
  }, {
    "tStartMs": 994800,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and put two tiny internal\ncombustion engines on board it,"
    } ]
  }, {
    "tStartMs": 998340,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "and it works."
    } ]
  }, {
    "tStartMs": 1000213,
    "dDurationMs": 1277,
    "segs": [ {
      "utf8": "(upbeat music)\n(robot tapping)"
    } ]
  }, {
    "tStartMs": 1001490,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And it sounds like a combustion engine,"
    } ]
  }, {
    "tStartMs": 1002930,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "which is probably my favorite part of it."
    } ]
  }, {
    "tStartMs": 1004851,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "(robot tapping)"
    } ]
  }, {
    "tStartMs": 1007670,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Derek] Cameron's\npenny-sized engine runs"
    } ]
  }, {
    "tStartMs": 1009380,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "on a constant stream\nof methane and oxygen."
    } ]
  }, {
    "tStartMs": 1012500,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "This is fed into a chamber\nwhere it's ignited by a spark"
    } ]
  }, {
    "tStartMs": 1016370,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and so it combusts,\nreleasing a burst of energy."
    } ]
  }, {
    "tStartMs": 1019730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The hot gases rapidly expand,"
    } ]
  }, {
    "tStartMs": 1021500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "pushing against a\nflexible polymer membrane"
    } ]
  }, {
    "tStartMs": 1023630,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "that acts like a piston."
    } ]
  }, {
    "tStartMs": 1025970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- So the membrane moves as the piston"
    } ]
  }, {
    "tStartMs": 1027860,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and then instead of having\nto, like, have any sort"
    } ]
  }, {
    "tStartMs": 1030380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "of elaborate system\nthat brings it back down"
    } ]
  }, {
    "tStartMs": 1032150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because it just naturally is elastic,"
    } ]
  }, {
    "tStartMs": 1034520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "it sort of has its own restoring force."
    } ]
  }, {
    "tStartMs": 1036530,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "That was our clever little innovation."
    } ]
  }, {
    "tStartMs": 1039500,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- As the membrane shrinks back,"
    } ]
  }, {
    "tStartMs": 1041150,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "it vents the exhaust gases,\nallowing the cycle to repeat."
    } ]
  }, {
    "tStartMs": 1044832,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(mechanism tapping)"
    } ]
  }, {
    "tStartMs": 1045665,
    "dDurationMs": 2715,
    "segs": [ {
      "utf8": "Despite the continuous\nflow of methane and oxygen,"
    } ]
  }, {
    "tStartMs": 1048380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "the fuel line never catches fire."
    } ]
  }, {
    "tStartMs": 1051080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "That's because as explosions get smaller,"
    } ]
  }, {
    "tStartMs": 1053090,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "their volume shrinks much\nfaster than their surface area."
    } ]
  }, {
    "tStartMs": 1056540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "This causes them to lose heat more quickly"
    } ]
  }, {
    "tStartMs": 1058820,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to their surroundings."
    } ]
  }, {
    "tStartMs": 1060230,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "In Cameron's robot,"
    } ]
  }, {
    "tStartMs": 1061520,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "only a small amount of\ngas burns at a time,"
    } ]
  }, {
    "tStartMs": 1064250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "so heat quickly escapes\ninto the fuel line,"
    } ]
  }, {
    "tStartMs": 1066980,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "cooling the gas"
    } ]
  }, {
    "tStartMs": 1068000,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "and stopping the flame from\ntraveling back up the line."
    } ]
  }, {
    "tStartMs": 1072170,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "With just two of these combustion chambers"
    } ]
  }, {
    "tStartMs": 1074360,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "on a little robot,"
    } ]
  }, {
    "tStartMs": 1075410,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "one for the front legs\nand one for the back,"
    } ]
  }, {
    "tStartMs": 1077390,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Cameron can control its heading."
    } ]
  }, {
    "tStartMs": 1079850,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- You can actuate just\none of the two sides"
    } ]
  }, {
    "tStartMs": 1082070,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "at a given time if you want"
    } ]
  }, {
    "tStartMs": 1083720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "because both sides are operational."
    } ]
  }, {
    "tStartMs": 1085400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So if we spark in both\nsides, it'll move straight."
    } ]
  }, {
    "tStartMs": 1087410,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But if we just do one or\nthe other, it'll pivot."
    } ]
  }, {
    "tStartMs": 1089990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] And this robot"
    } ]
  }, {
    "tStartMs": 1090823,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "is super powerful for its size."
    } ]
  }, {
    "tStartMs": 1093080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- It weighs 1.6 grams,"
    } ]
  }, {
    "tStartMs": 1095480,
    "dDurationMs": 2654,
    "segs": [ {
      "utf8": "which is about as much\nas a gummy bear weighs."
    } ]
  }, {
    "tStartMs": 1098134,
    "dDurationMs": 1336,
    "segs": [ {
      "utf8": "(robot tapping)"
    } ]
  }, {
    "tStartMs": 1099470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It can jump like two feet\nin the air approximately."
    } ]
  }, {
    "tStartMs": 1101480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It can carry 22 times its body weight,"
    } ]
  }, {
    "tStartMs": 1103400,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "which is about what a cockroach\nor a lot of beetles can do."
    } ]
  }, {
    "tStartMs": 1106730,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "We'll be able to put\na fuel tank, you know,"
    } ]
  }, {
    "tStartMs": 1109490,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "microelectronics sensors,\na camera battery,"
    } ]
  }, {
    "tStartMs": 1112610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and still have weight left over to go,"
    } ]
  }, {
    "tStartMs": 1114350,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and this thing will still chug along."
    } ]
  }, {
    "tStartMs": 1117920,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "That's the future. That's the goal."
    } ]
  }, {
    "tStartMs": 1121730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Scientists have created robots"
    } ]
  }, {
    "tStartMs": 1123410,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that can do what some insects do"
    } ]
  }, {
    "tStartMs": 1125990,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and there are clear\napplications for this work."
    } ]
  }, {
    "tStartMs": 1129080,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "But for these roboticists,\nthese self-labeled misfits,"
    } ]
  }, {
    "tStartMs": 1132980,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that's not what it's all about."
    } ]
  }, {
    "tStartMs": 1135110,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- If it's about application,"
    } ]
  }, {
    "tStartMs": 1136430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "we should all like make a startup"
    } ]
  }, {
    "tStartMs": 1137840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and try to like think about what we can do"
    } ]
  }, {
    "tStartMs": 1139730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to make money, right?"
    } ]
  }, {
    "tStartMs": 1141380,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "We think there are nice applications,"
    } ]
  }, {
    "tStartMs": 1143660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "like inspection and search and rescue,"
    } ]
  }, {
    "tStartMs": 1146120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but I would say as a research lab,"
    } ]
  }, {
    "tStartMs": 1148040,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "we are mostly driven by curiosity."
    } ]
  }, {
    "tStartMs": 1150410,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "I think that's a very\nhonest answer. (laughs)"
    } ]
  }, {
    "tStartMs": 1153983,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "(quirky electronic music)"
    } ]
  }, {
    "tStartMs": 1156950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So cool."
    } ]
  }, {
    "tStartMs": 1159380,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "If you are someone"
    } ]
  }, {
    "tStartMs": 1160670,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "who designs hardware like\nthese robots, mini or mighty,"
    } ]
  }, {
    "tStartMs": 1164660,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "you know that you need to\ncreate a CAD model first"
    } ]
  }, {
    "tStartMs": 1167570,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "so you can prototype and\nbring your ideas to life."
    } ]
  }, {
    "tStartMs": 1170540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But the problem with most\nmainstream CAD software"
    } ]
  }, {
    "tStartMs": 1173210,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "is you need a very powerful\ncomputer and a mighty budget."
    } ]
  }, {
    "tStartMs": 1176960,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "That's why we reached out\nto today's sponsor, Onshape."
    } ]
  }, {
    "tStartMs": 1179900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Onshape is a modern CAD"
    } ]
  }, {
    "tStartMs": 1181670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and PDM system designed for businesses."
    } ]
  }, {
    "tStartMs": 1184070,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And unlike any other\nprofessional CAD system,"
    } ]
  }, {
    "tStartMs": 1187490,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Onshape is built entirely in the cloud,"
    } ]
  }, {
    "tStartMs": 1189680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "powered by Amazon Web Services."
    } ]
  }, {
    "tStartMs": 1191930,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "That means you don't need\nexpensive computer hardware,"
    } ]
  }, {
    "tStartMs": 1194960,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "it never crashes, and\nyou never lose your work."
    } ]
  }, {
    "tStartMs": 1198740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It just runs in your\nbrowser on any system,"
    } ]
  }, {
    "tStartMs": 1201500,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "be it Windows, Mac, Linux,\nor even on your phone."
    } ]
  }, {
    "tStartMs": 1205520,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I can actually pull up that\nmini robot model right now"
    } ]
  }, {
    "tStartMs": 1208580,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and start moving some\nof these things around."
    } ]
  }, {
    "tStartMs": 1211730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It's also built to be collaborative"
    } ]
  }, {
    "tStartMs": 1213380,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "so you can work alongside friends"
    } ]
  }, {
    "tStartMs": 1214970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "or colleagues like never before"
    } ]
  }, {
    "tStartMs": 1216620,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "on the same design in real time."
    } ]
  }, {
    "tStartMs": 1219500,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "For businesses, you can\ntrial Onshape for six months"
    } ]
  }, {
    "tStartMs": 1222530,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and for students' hobbyists,\nit's completely free to use."
    } ]
  }, {
    "tStartMs": 1225410,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Just head over to onshape.pro/veritasium"
    } ]
  }, {
    "tStartMs": 1228080,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and sign up to get started today."
    } ]
  }, {
    "tStartMs": 1230120,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Onshape also uses tried"
    } ]
  }, {
    "tStartMs": 1231530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and tested Git-style\nversion control methods"
    } ]
  }, {
    "tStartMs": 1233720,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "from software design so\nyou don't have to worry"
    } ]
  }, {
    "tStartMs": 1236180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "about sending multiple large files around"
    } ]
  }, {
    "tStartMs": 1238160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and keeping track of all\nthe different iterations."
    } ]
  }, {
    "tStartMs": 1240440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It is all done for you."
    } ]
  }, {
    "tStartMs": 1242240,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "None of this emailing V2 final final"
    } ]
  }, {
    "tStartMs": 1244790,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "for real this time one nonsense."
    } ]
  }, {
    "tStartMs": 1247580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you work for a government agency"
    } ]
  }, {
    "tStartMs": 1249410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "or have contracts with the\ngovernment, I have good news."
    } ]
  }, {
    "tStartMs": 1252500,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Onshape now has a plan that enables teams"
    } ]
  }, {
    "tStartMs": 1254930,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "to comply with federal\nregulations like ITAR and EAR,"
    } ]
  }, {
    "tStartMs": 1258680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "so nothing is holding you back."
    } ]
  }, {
    "tStartMs": 1260510,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Go sign up for free at\nonshape.pro/veritasium"
    } ]
  }, {
    "tStartMs": 1263630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to get started engineering\nfor the future today."
    } ]
  }, {
    "tStartMs": 1266240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I wanna thank Onshape for\nsponsoring this video,"
    } ]
  }, {
    "tStartMs": 1268580,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  }, {
    "tStartMs": 1274400,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "It's so cool."
    } ]
  } ]
}
