{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 41,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "- Let me show you something unbelievable."
    } ]
  }, {
    "tStartMs": 2502,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Name a random number between 1 and 100."
    } ]
  }, {
    "tStartMs": 5255,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "- 61."
    } ]
  }, {
    "tStartMs": 6214,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "- Okay, that's pretty random."
    } ]
  }, {
    "tStartMs": 7507,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "- [Emily] Just name a random\nnumber from 1 to 100, random."
    } ]
  }, {
    "tStartMs": 9718,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- 43.\n- 43, thank you so much."
    } ]
  }, {
    "tStartMs": 11678,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "- 56.\n- 7."
    } ]
  }, {
    "tStartMs": 13179,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "- I want the most random\nnumber between 1 and 100,"
    } ]
  }, {
    "tStartMs": 16057,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "like totally random."
    } ]
  }, {
    "tStartMs": 17475,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "- 11."
    } ]
  }, {
    "tStartMs": 18351,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- 37."
    } ]
  }, {
    "tStartMs": 19519,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "- [Interviewee] 79.\n- 79, thank you so much."
    } ]
  }, {
    "tStartMs": 21521,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "- 91.\n- 7."
    } ]
  }, {
    "tStartMs": 23064,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "- 3.\n- 37."
    } ]
  }, {
    "tStartMs": 24482,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "- [Derek] 37.\n- 37, yeah."
    } ]
  }, {
    "tStartMs": 25358,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "- [Derek] Why 37?"
    } ]
  }, {
    "tStartMs": 26401,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "- I dunno, it's the first number\nthat came to my mind."
    } ]
  }, {
    "tStartMs": 29612,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "- 44.\n- 27."
    } ]
  }, {
    "tStartMs": 30530,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- 37.\n- 72."
    } ]
  }, {
    "tStartMs": 32490,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "- 4.\n- 13."
    } ]
  }, {
    "tStartMs": 33575,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "- 7.\n- 37."
    } ]
  }, {
    "tStartMs": 34868,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "- [Emily] Really?"
    } ]
  }, {
    "tStartMs": 35744,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "(Derek speaking in foreign language)"
    } ]
  }, {
    "tStartMs": 39164,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "- 13.\n- 7."
    } ]
  }, {
    "tStartMs": 40206,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "- 37.\n- 37?"
    } ]
  }, {
    "tStartMs": 41875,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "- 73.\n- 37."
    } ]
  }, {
    "tStartMs": 43543,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "- 35.\n- 37."
    } ]
  }, {
    "tStartMs": 44878,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "- [Emily] 37, no way!"
    } ]
  }, {
    "tStartMs": 46671,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "- 43.\n- 2."
    } ]
  }, {
    "tStartMs": 47756,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "- 37."
    } ]
  }, {
    "tStartMs": 48590,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "(Derek gasping)"
    } ]
  }, {
    "tStartMs": 49799,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "- I knew you were gonna do it."
    } ]
  }, {
    "tStartMs": 51718,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "He just \"37-ed\" and walked away."
    } ]
  }, {
    "tStartMs": 53386,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- Between 1 and 100."
    } ]
  }, {
    "tStartMs": 54554,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "- Ah, no thanks.\n- [Emily] Okay."
    } ]
  }, {
    "tStartMs": 56097,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "- 37."
    } ]
  }, {
    "tStartMs": 57182,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "- [Emily] Oh, perfect. Thank you so much."
    } ]
  }, {
    "tStartMs": 58850,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "- 83.\n- 37."
    } ]
  }, {
    "tStartMs": 60643,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "- 37."
    } ]
  }, {
    "tStartMs": 61644,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "- 87.\n- 55."
    } ]
  }, {
    "tStartMs": 63146,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "- 37.\n- 37."
    } ]
  }, {
    "tStartMs": 64397,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "(Emily gasping)"
    } ]
  }, {
    "tStartMs": 65231,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "Can I shake your hand?"
    } ]
  }, {
    "tStartMs": 67067,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "- [Derek] I love the thought\nyou're putting into this."
    } ]
  }, {
    "tStartMs": 68526,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "- 37?\n- No, you are kidding me!"
    } ]
  }, {
    "tStartMs": 71362,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "Are you real?\n- Yeah why?"
    } ]
  }, {
    "tStartMs": 73156,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "- Did we ask you this already?\n- No."
    } ]
  }, {
    "tStartMs": 75283,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "- Random number between 1 to 100."
    } ]
  }, {
    "tStartMs": 77660,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "- 37.\n- 37. Oh, my gosh, yes."
    } ]
  }, {
    "tStartMs": 80413,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "- [Derek] Name a random\nnumber between 1 and 100."
    } ]
  }, {
    "tStartMs": 82791,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "- 37.\n- Are you kidding me?"
    } ]
  }, {
    "tStartMs": 86461,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 88213,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "- It's a good number, I guess, any number."
    } ]
  }, {
    "tStartMs": 91174,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "- [Derek] Where did that come from?"
    } ]
  }, {
    "tStartMs": 92801,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "- Imagination, I suppose."
    } ]
  }, {
    "tStartMs": 95428,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "- So, what's going on?"
    } ]
  }, {
    "tStartMs": 97180,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "Well, people are actually really bad"
    } ]
  }, {
    "tStartMs": 99265,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "at selecting things randomly."
    } ]
  }, {
    "tStartMs": 101101,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "In fact, when asked to\npick a color and a number,"
    } ]
  }, {
    "tStartMs": 103686,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "people reliably select blue and 7 the most"
    } ]
  }, {
    "tStartMs": 107232,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "across dozens of different cultures."
    } ]
  }, {
    "tStartMs": 109692,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "Psychologists have a\nname for this pattern."
    } ]
  }, {
    "tStartMs": 111945,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "The blue-seven phenomenon."
    } ]
  }, {
    "tStartMs": 114322,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "And when picking a random\nnumber between 1 and 100,"
    } ]
  }, {
    "tStartMs": 117075,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "it has long been suggested"
    } ]
  }, {
    "tStartMs": 118451,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "that the equivalent of\nthe blue-seven phenomenon"
    } ]
  }, {
    "tStartMs": 121037,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "is the number 37."
    } ]
  }, {
    "tStartMs": 123206,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "My producer, Emily, and I\nspoke to hundreds of people"
    } ]
  }, {
    "tStartMs": 125834,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "to test this theory."
    } ]
  }, {
    "tStartMs": 127418,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "The most common answer was 7,"
    } ]
  }, {
    "tStartMs": 129504,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "but maybe that's because\npeople just expected"
    } ]
  }, {
    "tStartMs": 131589,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "that we'd ask them for\nnumbers between 1 and 10."
    } ]
  }, {
    "tStartMs": 134217,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "The most common two-digit\nnumber really was 37,"
    } ]
  }, {
    "tStartMs": 138346,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "much to our surprise."
    } ]
  }, {
    "tStartMs": 139722,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "(Derek and Emily gasping)"
    } ]
  }, {
    "tStartMs": 145436,
    "dDurationMs": 3713,
    "segs": [ {
      "utf8": "So we decided to embark on\nthe biggest investigation ever"
    } ]
  }, {
    "tStartMs": 149149,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "on the number 37."
    } ]
  }, {
    "tStartMs": 151359,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And it took us to some unexpected places."
    } ]
  }, {
    "tStartMs": 154362,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "- I think 37 is a fascinating number."
    } ]
  }, {
    "tStartMs": 156197,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "It's just really interesting\nbecause it turns up so much."
    } ]
  }, {
    "tStartMs": 159075,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "How many objects are there\nhere in the room with us"
    } ]
  }, {
    "tStartMs": 162245,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "that have a 37 on them?"
    } ]
  }, {
    "tStartMs": 163830,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "I'm sure there's more than 1,000 here."
    } ]
  }, {
    "tStartMs": 166166,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "I built the 37 Website in 1994."
    } ]
  }, {
    "tStartMs": 169169,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "I started getting email from\nstrangers, it's everywhere."
    } ]
  }, {
    "tStartMs": 171838,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "I'm trying to collect them all."
    } ]
  }, {
    "tStartMs": 173298,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "We're tireless."
    } ]
  }, {
    "tStartMs": 174924,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The tireless cabal of 37 people, yeah."
    } ]
  }, {
    "tStartMs": 178344,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "- Apparently, people choose 37 so reliably"
    } ]
  }, {
    "tStartMs": 181723,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "that there's even a widespread\nprofessional magic trick"
    } ]
  }, {
    "tStartMs": 184142,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "that relies entirely on\ngetting an audience member"
    } ]
  }, {
    "tStartMs": 186895,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "to just pick 37 out of thin air."
    } ]
  }, {
    "tStartMs": 189814,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "It's called The 37 Force."
    } ]
  }, {
    "tStartMs": 192567,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "- I'm gonna ask you to think\nof a number in a moment, okay?"
    } ]
  }, {
    "tStartMs": 195028,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "It's a two-digit number, less than 50."
    } ]
  }, {
    "tStartMs": 198072,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "Both numbers are odd, but different."
    } ]
  }, {
    "tStartMs": 200200,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "You could have 19, 17, or 15, but not 11."
    } ]
  }, {
    "tStartMs": 202911,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Because you see both numbers are the same,\n1 and 1 next to one another."
    } ]
  }, {
    "tStartMs": 206206,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "You ready?"
    } ]
  }, {
    "tStartMs": 207665,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "One, two, and three."
    } ]
  }, {
    "tStartMs": 209667,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "What number did you think of?"
    } ]
  }, {
    "tStartMs": 211002,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "- [Audience] 37.\n- 37."
    } ]
  }, {
    "tStartMs": 212754,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Fascinating."
    } ]
  }, {
    "tStartMs": 215840,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "In the famous Stanford MIT Jargon File,"
    } ]
  }, {
    "tStartMs": 218509,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "the origin of hacker slang,"
    } ]
  }, {
    "tStartMs": 220303,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "37 is given as the random number of choice"
    } ]
  }, {
    "tStartMs": 223056,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "for computer programmers."
    } ]
  }, {
    "tStartMs": 224474,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "“When groups of people are polled"
    } ]
  }, {
    "tStartMs": 226059,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to pick a random number between 1 and 100,"
    } ]
  }, {
    "tStartMs": 228519,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "the most commonly chosen number is 37.\""
    } ]
  }, {
    "tStartMs": 232315,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "(graphic buzzing)"
    } ]
  }, {
    "tStartMs": 232941,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "The thing is, no formal\npolls on this actually exist."
    } ]
  }, {
    "tStartMs": 236778,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "The best we found was a\nReddit poll of 1,380 people"
    } ]
  }, {
    "tStartMs": 240865,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "from four years ago,"
    } ]
  }, {
    "tStartMs": 242408,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "and the most popular number was..."
    } ]
  }, {
    "tStartMs": 244994,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "69."
    } ]
  }, {
    "tStartMs": 246162,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "But after that, the winning number was 37."
    } ]
  }, {
    "tStartMs": 250041,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "But we can do better than a sample size"
    } ]
  }, {
    "tStartMs": 251709,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "of just 1,000 people."
    } ]
  }, {
    "tStartMs": 253419,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "So we conducted the largest\nrandom number survey ever."
    } ]
  }, {
    "tStartMs": 257173,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "In a community post 3 weeks ago,"
    } ]
  }, {
    "tStartMs": 258967,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "we asked people to pick a\nrandom number between 1 and 100."
    } ]
  }, {
    "tStartMs": 262762,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "We received 200,000 responses."
    } ]
  }, {
    "tStartMs": 266808,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "Here are the results as they came in."
    } ]
  }, {
    "tStartMs": 270144,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "It's fascinating to watch"
    } ]
  }, {
    "tStartMs": 271938,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "how consistent these\nsupposedly random numbers are,"
    } ]
  }, {
    "tStartMs": 275900,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "from 10,000, to 100,000,"
    } ]
  }, {
    "tStartMs": 279612,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "all the way up to 200,000 respondents."
    } ]
  }, {
    "tStartMs": 283283,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "The distribution barely changes,"
    } ]
  }, {
    "tStartMs": 285827,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "suggesting that people\nfrom all around the world"
    } ]
  }, {
    "tStartMs": 289038,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "think about random numbers\nin a particular way,"
    } ]
  }, {
    "tStartMs": 292709,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "and it is decidedly not random."
    } ]
  }, {
    "tStartMs": 296546,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Ignoring the extremes of the scale"
    } ]
  }, {
    "tStartMs": 298715,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "because people were primed"
    } ]
  }, {
    "tStartMs": 300008,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "by the numbers 1 and 100\nin the question itself,"
    } ]
  }, {
    "tStartMs": 302760,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "and ignoring 42 and 69\nbecause they're not random,"
    } ]
  }, {
    "tStartMs": 306306,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "there are a few numbers that stand out,"
    } ]
  }, {
    "tStartMs": 309017,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "which we seem to regard as\nmore random than the rest."
    } ]
  }, {
    "tStartMs": 313146,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "7,"
    } ]
  }, {
    "tStartMs": 313980,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "73,"
    } ]
  }, {
    "tStartMs": 315189,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "77,"
    } ]
  }, {
    "tStartMs": 316691,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "and 37."
    } ]
  }, {
    "tStartMs": 317984,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 320153,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Then we asked people to pick the number"
    } ]
  }, {
    "tStartMs": 321654,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "they thought the fewest others would pick."
    } ]
  }, {
    "tStartMs": 324240,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "The goal was to get rid of\nfavorite or lucky numbers"
    } ]
  }, {
    "tStartMs": 326909,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "and give truly random selections."
    } ]
  }, {
    "tStartMs": 329370,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "And here, the results were even clearer."
    } ]
  }, {
    "tStartMs": 332332,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "Again, ignoring the very\nextremes and 50 in the middle,"
    } ]
  }, {
    "tStartMs": 335501,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "the most selected numbers\nwere, far and away, 73 and 37,"
    } ]
  }, {
    "tStartMs": 340465,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "which were nearly tied."
    } ]
  }, {
    "tStartMs": 343301,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "The actual least-picked number\nin the first question was 90,"
    } ]
  }, {
    "tStartMs": 347138,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "followed by 30, 40, 70, 80, and 60."
    } ]
  }, {
    "tStartMs": 350933,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Multiples of 10 apparently\ndon't seem that random."
    } ]
  }, {
    "tStartMs": 354103,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The most picked overall\nnumbers ignoring the outliers"
    } ]
  }, {
    "tStartMs": 357106,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "were 73 and 37."
    } ]
  }, {
    "tStartMs": 359108,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 361277,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Ironically, all this evidence points to 37"
    } ]
  }, {
    "tStartMs": 364030,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "and its inversion, 73,\nas not being random at all."
    } ]
  }, {
    "tStartMs": 368242,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "So why does everyone pick them?"
    } ]
  }, {
    "tStartMs": 370328,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "Well, one argument"
    } ]
  }, {
    "tStartMs": 371287,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "is that this is just how\npeople perceive randomness."
    } ]
  }, {
    "tStartMs": 374874,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "37, does that feel random to you?"
    } ]
  }, {
    "tStartMs": 377168,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "- Yeah. Yeah, it does."
    } ]
  }, {
    "tStartMs": 379462,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "- [Derek] Yeah, 50 wouldn't be random?"
    } ]
  }, {
    "tStartMs": 381130,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "- No.\n- [Derek] No."
    } ]
  }, {
    "tStartMs": 381964,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "- It would be too contrived."
    } ]
  }, {
    "tStartMs": 383549,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "- [Derek] Yeah.\n- Yeah, it's too central"
    } ]
  }, {
    "tStartMs": 386052,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "- I think people think that even numbers"
    } ]
  }, {
    "tStartMs": 388471,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "are less random than odd numbers."
    } ]
  }, {
    "tStartMs": 390515,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "- 5 feels not random, 9\nand 1 feel too extreme,"
    } ]
  }, {
    "tStartMs": 393643,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "so people tend towards 3 and 7."
    } ]
  }, {
    "tStartMs": 395770,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "- This is backed up by the fact"
    } ]
  }, {
    "tStartMs": 396979,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "that every one of the\ntop numbers in our survey"
    } ]
  }, {
    "tStartMs": 399065,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "consisted of 3s and 7s."
    } ]
  }, {
    "tStartMs": 402527,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "In fact, 3 and 7 were\nthe most selected digits"
    } ]
  }, {
    "tStartMs": 405863,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "on both questions."
    } ]
  }, {
    "tStartMs": 409242,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "But there's also a mathematical case"
    } ]
  }, {
    "tStartMs": 411035,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "for humanity's number of choice"
    } ]
  }, {
    "tStartMs": 413079,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "because it's not just odd numbers,"
    } ]
  }, {
    "tStartMs": 414914,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "but specifically primes,"
    } ]
  }, {
    "tStartMs": 416499,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "which feel like the most random numbers."
    } ]
  }, {
    "tStartMs": 419419,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Notice how we ignore odds ending in 5s"
    } ]
  }, {
    "tStartMs": 422171,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "or how something like 39"
    } ]
  }, {
    "tStartMs": 423965,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "still feels a little less random than 37?"
    } ]
  }, {
    "tStartMs": 428177,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "Primes feel random for\nat least two reasons."
    } ]
  }, {
    "tStartMs": 431848,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "First, they don't appear\nas much in our lives."
    } ]
  }, {
    "tStartMs": 434434,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "I mean, pixel counts, fruit\nboxes, square footage."
    } ]
  }, {
    "tStartMs": 437687,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "We live in a composite world\nwith multiple dimensions"
    } ]
  }, {
    "tStartMs": 440815,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "that multiply together,"
    } ]
  }, {
    "tStartMs": 442275,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "so we just don't see primes\nmuch past the single digits."
    } ]
  }, {
    "tStartMs": 446320,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Second, we don't have\na formula for primes."
    } ]
  }, {
    "tStartMs": 449323,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "If you have a prime number"
    } ]
  }, {
    "tStartMs": 450408,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "and you want to find the next one,"
    } ]
  }, {
    "tStartMs": 451909,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "you have no choice but\nto check every number"
    } ]
  }, {
    "tStartMs": 454120,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "until you find a prime."
    } ]
  }, {
    "tStartMs": 455788,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "The closest thing we have to a formula"
    } ]
  }, {
    "tStartMs": 457707,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "is the prime number theorem,"
    } ]
  }, {
    "tStartMs": 459375,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "which gives the approximation"
    } ]
  }, {
    "tStartMs": 460668,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "that the nth prime number occurs around n"
    } ]
  }, {
    "tStartMs": 463629,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "times natural log of n."
    } ]
  }, {
    "tStartMs": 465631,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "For example, the 1,000th prime number"
    } ]
  }, {
    "tStartMs": 467717,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "should be around 6,908."
    } ]
  }, {
    "tStartMs": 470720,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "And it's close, but certainly not exact."
    } ]
  }, {
    "tStartMs": 474390,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "So primes essentially occur at random,"
    } ]
  }, {
    "tStartMs": 479145,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "but of all the primes, 37\nhas reason to stand out."
    } ]
  }, {
    "tStartMs": 482982,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 484942,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "If we were to find the prime\nfactors of every number,"
    } ]
  }, {
    "tStartMs": 488112,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "we would see that 2 is\nthe smallest prime factor"
    } ]
  }, {
    "tStartMs": 491449,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "for exactly 1/2 of them,"
    } ]
  }, {
    "tStartMs": 493034,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "all of the even numbers."
    } ]
  }, {
    "tStartMs": 494952,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "And 3 is the smallest prime factor"
    } ]
  }, {
    "tStartMs": 497079,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "for 1/6 of all numbers,"
    } ]
  }, {
    "tStartMs": 498915,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "anything that's divisible\nby 3 but not by 2 and so on."
    } ]
  }, {
    "tStartMs": 502752,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "As we pick larger and larger primes,"
    } ]
  }, {
    "tStartMs": 505046,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "they form the smallest prime factor"
    } ]
  }, {
    "tStartMs": 506839,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "for fewer and fewer integers."
    } ]
  }, {
    "tStartMs": 509509,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "But, what if we track the\nsecond smallest prime factor"
    } ]
  }, {
    "tStartMs": 512887,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "of each number?"
    } ]
  }, {
    "tStartMs": 514138,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Well, first, we have 3,"
    } ]
  }, {
    "tStartMs": 515306,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "which is the second\nprime factor of a number."
    } ]
  }, {
    "tStartMs": 517433,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Only when the number is\ndivisible by both 2 and 3"
    } ]
  }, {
    "tStartMs": 521020,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "or divisible by 6."
    } ]
  }, {
    "tStartMs": 522772,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "So 1/6 of all numbers have\na second prime factor of 3."
    } ]
  }, {
    "tStartMs": 527276,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "And as we keep going,"
    } ]
  }, {
    "tStartMs": 528611,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "which number will end up\nat the balancing point?"
    } ]
  }, {
    "tStartMs": 531614,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "This is the median second\nprime factor of all numbers,"
    } ]
  }, {
    "tStartMs": 535576,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "all numbers from 1 all\nthe way up to a googol"
    } ]
  }, {
    "tStartMs": 538579,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and off to infinity."
    } ]
  }, {
    "tStartMs": 540706,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Would you believe that that number is 37?"
    } ]
  }, {
    "tStartMs": 543793,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 545419,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "Let's take a look at 5."
    } ]
  }, {
    "tStartMs": 546921,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "5 is the second prime factor"
    } ]
  }, {
    "tStartMs": 548965,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "only when a number is\ndivisible by 5 and 3,"
    } ]
  }, {
    "tStartMs": 551467,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "but not 2."
    } ]
  }, {
    "tStartMs": 552552,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Or 5 and 2, but not 3."
    } ]
  }, {
    "tStartMs": 555346,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "In the first case, a\nnumber divisible by 5 and 3"
    } ]
  }, {
    "tStartMs": 558015,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "means it's divisible by 15,"
    } ]
  }, {
    "tStartMs": 559767,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "so that's 1/15 of all numbers."
    } ]
  }, {
    "tStartMs": 561894,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "But it also can't be divisible by 2."
    } ]
  }, {
    "tStartMs": 564313,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "So 1/2 of 1/15 is 1/30 of all numbers."
    } ]
  }, {
    "tStartMs": 568150,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "In the second case,"
    } ]
  }, {
    "tStartMs": 569110,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "a number divisible by 5 and 2"
    } ]
  }, {
    "tStartMs": 570611,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "means it's divisible by 10,"
    } ]
  }, {
    "tStartMs": 572655,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "but it cannot be divisible by 3."
    } ]
  }, {
    "tStartMs": 575157,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "So we're left with 1/10 times 2/3"
    } ]
  }, {
    "tStartMs": 577577,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "equals 1/15 of all numbers."
    } ]
  }, {
    "tStartMs": 580246,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Adding up these two cases,"
    } ]
  }, {
    "tStartMs": 581497,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "we get that 1/10 of all numbers"
    } ]
  }, {
    "tStartMs": 583666,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "have 5 as their second prime factor."
    } ]
  }, {
    "tStartMs": 586836,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And we can repeat this\nfor the next prime, 7."
    } ]
  }, {
    "tStartMs": 589839,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Just take each of these cases"
    } ]
  }, {
    "tStartMs": 591757,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and add them up to get\nthat 1/15 of all integers"
    } ]
  }, {
    "tStartMs": 594760,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "have a second prime factor of 7."
    } ]
  }, {
    "tStartMs": 598097,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "And so on."
    } ]
  }, {
    "tStartMs": 599265,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Keeping a running total,"
    } ]
  }, {
    "tStartMs": 600266,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "we quickly approach a balancing point"
    } ]
  }, {
    "tStartMs": 602268,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "for the second prime\nfactor across all integers."
    } ]
  }, {
    "tStartMs": 605771,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "And then we reach it."
    } ]
  }, {
    "tStartMs": 608149,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "So the median second prime\nfactor of all numbers is 37."
    } ]
  }, {
    "tStartMs": 613154,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "Half of numbers have a second\nprime factor of 37 or less."
    } ]
  }, {
    "tStartMs": 620119,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "There are other remarkable\nqualities about 37 as a prime."
    } ]
  }, {
    "tStartMs": 623706,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "It's an irregular prime, a\nCuban prime, a lucky prime,"
    } ]
  }, {
    "tStartMs": 627168,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "a sexy prime, a permutable\nprime, a Padovan prime."
    } ]
  }, {
    "tStartMs": 630713,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "And at this point,"
    } ]
  }, {
    "tStartMs": 631547,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "mathematicians might just be\nmaking up types of primes."
    } ]
  }, {
    "tStartMs": 634842,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "- 37's identity as a\nprime number is so strong"
    } ]
  }, {
    "tStartMs": 637928,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "that the same day I first\nlearned the number 37,"
    } ]
  }, {
    "tStartMs": 640348,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "I learned it was prime."
    } ]
  }, {
    "tStartMs": 642099,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "This was one of my first\nbooks as a toddler."
    } ]
  }, {
    "tStartMs": 644560,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "It teaches you every number from 1 to 100"
    } ]
  }, {
    "tStartMs": 646937,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "with a short story or fun fact for each."
    } ]
  }, {
    "tStartMs": 649273,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "So for 26, that's how many\nletters in the alphabet."
    } ]
  }, {
    "tStartMs": 651942,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Or for 30, they give\nthe days of September."
    } ]
  }, {
    "tStartMs": 654403,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Or for 52, that's how\nmany cards are in a deck."
    } ]
  }, {
    "tStartMs": 657281,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Except 37."
    } ]
  }, {
    "tStartMs": 658908,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "(pages rustling)\n(jaunty music)"
    } ]
  }, {
    "tStartMs": 660910,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "It's a prime number."
    } ]
  }, {
    "tStartMs": 662244,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Nothing goes into it."
    } ]
  }, {
    "tStartMs": 663537,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Someday, you'll understand."
    } ]
  }, {
    "tStartMs": 666874,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "I did not like that."
    } ]
  }, {
    "tStartMs": 668042,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "I understood every other number,"
    } ]
  }, {
    "tStartMs": 669293,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "so I also wanted to understand 37."
    } ]
  }, {
    "tStartMs": 671837,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "So, that number has nagged me ever since,"
    } ]
  }, {
    "tStartMs": 673964,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "and now this video is being\nmade some 20 years later."
    } ]
  }, {
    "tStartMs": 677885,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "- [Derek] Not convinced yet?"
    } ]
  }, {
    "tStartMs": 680096,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "- If you take a number that\nis a multiple of 37 already,"
    } ]
  }, {
    "tStartMs": 683724,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "like 1, 3, 6, 9, that's 37 squared,"
    } ]
  }, {
    "tStartMs": 686769,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "and then you reverse it,"
    } ]
  }, {
    "tStartMs": 688396,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "and then you stick a 0\nin between every digit,"
    } ]
  }, {
    "tStartMs": 692149,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "then that number is a multiple of 37."
    } ]
  }, {
    "tStartMs": 694944,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "And I literally spent\nthe next month on the bus"
    } ]
  }, {
    "tStartMs": 698239,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "trying to prove that\nfact, which I finally did."
    } ]
  }, {
    "tStartMs": 700700,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Just rattle off a six-digit number."
    } ]
  }, {
    "tStartMs": 702410,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Tell me any six-digit number."
    } ]
  }, {
    "tStartMs": 704662,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "- 413,625."
    } ]
  }, {
    "tStartMs": 708874,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "- And it's not divisible by 37."
    } ]
  }, {
    "tStartMs": 710918,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "So how did I figure that out?"
    } ]
  }, {
    "tStartMs": 712795,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "There's a trick for that."
    } ]
  }, {
    "tStartMs": 714588,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "- Is this your like party\ntrick that you can bring out?"
    } ]
  }, {
    "tStartMs": 717007,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "- Surprisingly,"
    } ]
  }, {
    "tStartMs": 717842,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "it doesn't impress as many\npeople as you would think."
    } ]
  }, {
    "tStartMs": 720052,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "I think it should impress everybody."
    } ]
  }, {
    "tStartMs": 723055,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "- But there's also a practical reason"
    } ]
  }, {
    "tStartMs": 724682,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "37 is an important number for humanity."
    } ]
  }, {
    "tStartMs": 727601,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "Say you are faced with a choice"
    } ]
  }, {
    "tStartMs": 729437,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "that is both immediate and final,"
    } ]
  }, {
    "tStartMs": 732064,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "like whether to rent the\napartment you've just toured"
    } ]
  }, {
    "tStartMs": 734358,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "or whether to accept a\njob offer you received."
    } ]
  }, {
    "tStartMs": 737027,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "Or it can be as small"
    } ]
  }, {
    "tStartMs": 738154,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "as whether to stop the next\ngas station on a road trip."
    } ]
  }, {
    "tStartMs": 741282,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "These are all problems"
    } ]
  }, {
    "tStartMs": 742616,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "where you can't assess\nall the options at once"
    } ]
  }, {
    "tStartMs": 744744,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "and then decide."
    } ]
  }, {
    "tStartMs": 746537,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "With each option you encounter,"
    } ]
  }, {
    "tStartMs": 748122,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "you need to decide whether to\naccept it or reject it forever"
    } ]
  }, {
    "tStartMs": 751459,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "and see what comes next."
    } ]
  }, {
    "tStartMs": 753627,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "In these scenarios,"
    } ]
  }, {
    "tStartMs": 754670,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "it feels impossible to\nmake the best choice."
    } ]
  }, {
    "tStartMs": 757673,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "If you select too early,"
    } ]
  }, {
    "tStartMs": 759049,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "you'll probably never\neven see the best option."
    } ]
  }, {
    "tStartMs": 761510,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But if you select too late,"
    } ]
  }, {
    "tStartMs": 762970,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "well, then you've probably\nrejected the best option already."
    } ]
  }, {
    "tStartMs": 766390,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "So your best bet is\nsomewhere in the middle."
    } ]
  }, {
    "tStartMs": 769310,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "There, you know at least some information"
    } ]
  }, {
    "tStartMs": 771562,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "from the options you've seen,"
    } ]
  }, {
    "tStartMs": 773147,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and you have some choice,\nto select or pass."
    } ]
  }, {
    "tStartMs": 776442,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "But how do you know\nexactly when to decide?"
    } ]
  }, {
    "tStartMs": 779945,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "The optimal strategy looks like this."
    } ]
  }, {
    "tStartMs": 782406,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "First, you need to see some options"
    } ]
  }, {
    "tStartMs": 784200,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "and reject them automatically"
    } ]
  }, {
    "tStartMs": 786076,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "just to learn what's out there."
    } ]
  }, {
    "tStartMs": 788037,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "And then at a certain stopping point, S,"
    } ]
  }, {
    "tStartMs": 790581,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "you need to stop rejecting them"
    } ]
  }, {
    "tStartMs": 792458,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "and start evaluating whether an option"
    } ]
  }, {
    "tStartMs": 794668,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "is the best you've seen so far."
    } ]
  }, {
    "tStartMs": 797004,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "If it is, then select it."
    } ]
  }, {
    "tStartMs": 799673,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But when should that stopping point be?"
    } ]
  }, {
    "tStartMs": 802343,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "We need to work out which stopping point"
    } ]
  }, {
    "tStartMs": 804094,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "maximizes our chances of\npicking the best option."
    } ]
  }, {
    "tStartMs": 808390,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "We can calculate these chances."
    } ]
  }, {
    "tStartMs": 810392,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "For each spot, find the probability"
    } ]
  }, {
    "tStartMs": 812520,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "that the best option is located there"
    } ]
  }, {
    "tStartMs": 815022,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "times the probability we get\nthere from stopping point S."
    } ]
  }, {
    "tStartMs": 819235,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Then, add these probabilities\nup across every spot."
    } ]
  }, {
    "tStartMs": 823906,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Now, the chance of the best\noption being in any spot"
    } ]
  }, {
    "tStartMs": 827076,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "is just random."
    } ]
  }, {
    "tStartMs": 828327,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "If there are N options in total, it's 1/N,"
    } ]
  }, {
    "tStartMs": 832373,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "but it's a little harder"
    } ]
  }, {
    "tStartMs": 833582,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "to find the chances of\ngetting to each spot."
    } ]
  }, {
    "tStartMs": 836794,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "Say the best option is in\nthe next spot after S, S + 1."
    } ]
  }, {
    "tStartMs": 840923,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "What are the chances we get there?"
    } ]
  }, {
    "tStartMs": 842883,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "Well, since this is the next spot over"
    } ]
  }, {
    "tStartMs": 844969,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "from the stopping point,"
    } ]
  }, {
    "tStartMs": 846178,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "we have 100% chance of getting there."
    } ]
  }, {
    "tStartMs": 848514,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "So we are guaranteed to\nvisit it and select it."
    } ]
  }, {
    "tStartMs": 852059,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "But if the true best\noption is in spot S + 2,"
    } ]
  }, {
    "tStartMs": 855771,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "well, there's a small\nchance we'll miss it."
    } ]
  }, {
    "tStartMs": 857940,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "If the best of all the previous options"
    } ]
  }, {
    "tStartMs": 859775,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "is sitting in spot S + 1,"
    } ]
  }, {
    "tStartMs": 861735,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "we would just pick that and stop looking"
    } ]
  }, {
    "tStartMs": 863863,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "before reaching S + 2."
    } ]
  }, {
    "tStartMs": 866240,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "There's a one in S + 1\nchance of this happening."
    } ]
  }, {
    "tStartMs": 869535,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "So the chances we do get to spot S + 2"
    } ]
  }, {
    "tStartMs": 872162,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "to pick the true best\noption is 1 minus that,"
    } ]
  }, {
    "tStartMs": 874707,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "or S over S + 1."
    } ]
  }, {
    "tStartMs": 878377,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "This same calculation continues\nup until the last spot N."
    } ]
  }, {
    "tStartMs": 882965,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "We only get here"
    } ]
  }, {
    "tStartMs": 883924,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "if we've been passing\non every option so far,"
    } ]
  }, {
    "tStartMs": 886594,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "which means that one\nof the first S options"
    } ]
  }, {
    "tStartMs": 888679,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "must have been the best"
    } ]
  }, {
    "tStartMs": 889722,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "of the total N - 1 options we've seen."
    } ]
  }, {
    "tStartMs": 893309,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "In total, this gives us the expression 1/N"
    } ]
  }, {
    "tStartMs": 896478,
    "dDurationMs": 5589,
    "segs": [ {
      "utf8": "times 1, + S over S + 1, plus\nS over S + 2, and so on,"
    } ]
  }, {
    "tStartMs": 902067,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "all the way up to S over N - 1."
    } ]
  }, {
    "tStartMs": 905070,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Factoring out the S,"
    } ]
  }, {
    "tStartMs": 906238,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "the sum inside the parentheses"
    } ]
  }, {
    "tStartMs": 908073,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "approximates the function\n1/x going from S to N."
    } ]
  }, {
    "tStartMs": 912077,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 912995,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "Taking that integral, we get\nthe natural log of N over S."
    } ]
  }, {
    "tStartMs": 917583,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "So the probability we\nselect the best option"
    } ]
  }, {
    "tStartMs": 920169,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "is S over N times the\nnatural log of N over S."
    } ]
  }, {
    "tStartMs": 924840,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "To maximize this probability,"
    } ]
  }, {
    "tStartMs": 926675,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "we can find the peak of this function"
    } ]
  }, {
    "tStartMs": 928302,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "by setting its derivative to 0,"
    } ]
  }, {
    "tStartMs": 931221,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and this gives the natural\nlog of S over N equals -1."
    } ]
  }, {
    "tStartMs": 935225,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "So S over N equals 1 over e,"
    } ]
  }, {
    "tStartMs": 938312,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "or about 37%."
    } ]
  }, {
    "tStartMs": 941982,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "So explore"
    } ]
  }, {
    "tStartMs": 943067,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "and reject 37% of options"
    } ]
  }, {
    "tStartMs": 945486,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "just to get a sense of what's out there,"
    } ]
  }, {
    "tStartMs": 947446,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "and then pick the first\noption to come along"
    } ]
  }, {
    "tStartMs": 950240,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "that's better than all of\nthe ones you've seen so far."
    } ]
  }, {
    "tStartMs": 953786,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "And your chances of success\nusing this method"
    } ]
  }, {
    "tStartMs": 956664,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "are also 37%."
    } ]
  }, {
    "tStartMs": 959291,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 962795,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "This math question is known\nas the secretary problem"
    } ]
  }, {
    "tStartMs": 965214,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "or the marriage problem,"
    } ]
  }, {
    "tStartMs": 966590,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "as it also applies to\nhiring the best employees"
    } ]
  }, {
    "tStartMs": 969093,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "or even deciding on the best life partner."
    } ]
  }, {
    "tStartMs": 971845,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Now, it can be impractical\nto check 37% of the options"
    } ]
  }, {
    "tStartMs": 975015,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "because you don't always know"
    } ]
  }, {
    "tStartMs": 976225,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "how many candidates are out there,"
    } ]
  }, {
    "tStartMs": 978060,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "but the 37% rule also works for time."
    } ]
  }, {
    "tStartMs": 981271,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "So if you want to get\nmarried, say, in 10 years,"
    } ]
  }, {
    "tStartMs": 984358,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "then spend the first 3.7\nyears seeing what's out there"
    } ]
  }, {
    "tStartMs": 987361,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "and then select the next person"
    } ]
  }, {
    "tStartMs": 989279,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "who's better than anyone you've seen."
    } ]
  }, {
    "tStartMs": 991156,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 992366,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "So 37 is actually important to our lives,"
    } ]
  }, {
    "tStartMs": 995619,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and people seem to\nsubconsciously recognize this."
    } ]
  }, {
    "tStartMs": 998539,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "We gravitate towards\nthe number everywhere."
    } ]
  }, {
    "tStartMs": 1000958,
    "dDurationMs": 8592,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1009550,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "(film clicking)"
    } ]
  }, {
    "tStartMs": 1013429,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "- 37 seconds."
    } ]
  }, {
    "tStartMs": 1014930,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "- 37 years."
    } ]
  }, {
    "tStartMs": 1015764,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "- 37 patties?"
    } ]
  }, {
    "tStartMs": 1017558,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "- [Speaker 1] I was 37."
    } ]
  }, {
    "tStartMs": 1018976,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "- [Speaker 2] 37 cubic feet.\n- [Speaker 3] Take 37."
    } ]
  }, {
    "tStartMs": 1021395,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "- [Speaker 4] 37."
    } ]
  }, {
    "tStartMs": 1022229,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- How many enemies do you have?"
    } ]
  }, {
    "tStartMs": 1023397,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "- 37.\n- 37!"
    } ]
  }, {
    "tStartMs": 1024314,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "- Yes!\n- [Speaker 5] 37%."
    } ]
  }, {
    "tStartMs": 1025566,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Speaker 6] 37.\n- [Speaker 7] 37."
    } ]
  }, {
    "tStartMs": 1027276,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- 37 hours."
    } ]
  }, {
    "tStartMs": 1028444,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "- Destroyed 37 restaurants."
    } ]
  }, {
    "tStartMs": 1030362,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "- 37.\n- I'm 37."
    } ]
  }, {
    "tStartMs": 1032156,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "- 37 interlocking bronze gears."
    } ]
  }, {
    "tStartMs": 1034700,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Page 37."
    } ]
  }, {
    "tStartMs": 1035743,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "37 years old."
    } ]
  }, {
    "tStartMs": 1036994,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "37 prototypes."
    } ]
  }, {
    "tStartMs": 1038162,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "37%."
    } ]
  }, {
    "tStartMs": 1039872,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "(uplifting music)"
    } ]
  }, {
    "tStartMs": 1041749,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "This collection of images, everything you're seeing on\nscreen has been collected"
    } ]
  }, {
    "tStartMs": 1045294,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "by one man over the course of his life."
    } ]
  }, {
    "tStartMs": 1048672,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "And you already know who it is."
    } ]
  }, {
    "tStartMs": 1051383,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "- It's just fun, right?"
    } ]
  }, {
    "tStartMs": 1052968,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "The whole thing is just fun."
    } ]
  }, {
    "tStartMs": 1054344,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "How many objects are there\nhere in the room with us"
    } ]
  }, {
    "tStartMs": 1057514,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "that have a 37 on them?"
    } ]
  }, {
    "tStartMs": 1059975,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "This is probably on the order\nof four digits, I'd say."
    } ]
  }, {
    "tStartMs": 1064605,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "There's probably not 10,000,"
    } ]
  }, {
    "tStartMs": 1066315,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "but I'm sure there's more than 1,000 here."
    } ]
  }, {
    "tStartMs": 1068567,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Nutri-Grain granola bars, 37 grams."
    } ]
  }, {
    "tStartMs": 1071445,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "It's a 37-inch yardstick."
    } ]
  }, {
    "tStartMs": 1073614,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "It's just some political\ncartoon about sports,"
    } ]
  }, {
    "tStartMs": 1075532,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "but there's no reason"
    } ]
  }, {
    "tStartMs": 1076700,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "that guy had to have Jersey number 37."
    } ]
  }, {
    "tStartMs": 1078577,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "A nail that I found somewhere\nthat has 37 on the head."
    } ]
  }, {
    "tStartMs": 1081330,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "I don't even know what that means."
    } ]
  }, {
    "tStartMs": 1082873,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "One time, my mom gave\nme $37 for my birthday."
    } ]
  }, {
    "tStartMs": 1086960,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "They all have 37 in the serial number."
    } ]
  }, {
    "tStartMs": 1089463,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "- Was your 37th birthday like\nthe greatest birthday ever?"
    } ]
  }, {
    "tStartMs": 1092841,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "- I had a big party and I\ninvited everybody I knew."
    } ]
  }, {
    "tStartMs": 1095177,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "The Texas state lottery was $37 million."
    } ]
  }, {
    "tStartMs": 1098222,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "So I had two different friends"
    } ]
  }, {
    "tStartMs": 1099598,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "who both gave me 37 lottery tickets."
    } ]
  }, {
    "tStartMs": 1102810,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "I didn't win, I won 5 bucks."
    } ]
  }, {
    "tStartMs": 1104353,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "This is an article"
    } ]
  }, {
    "tStartMs": 1105521,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "from when they found\nthe 37th Mersenne prime."
    } ]
  }, {
    "tStartMs": 1108357,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "It's just clipping after clipping."
    } ]
  }, {
    "tStartMs": 1109733,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "How many hundreds of these\ndo you want me to go through?"
    } ]
  }, {
    "tStartMs": 1112361,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "I must have gotten that in\nGermany, but I don't know..."
    } ]
  }, {
    "tStartMs": 1114113,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "But I don't remember what it was."
    } ]
  }, {
    "tStartMs": 1115030,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Was it like a locker number?"
    } ]
  }, {
    "tStartMs": 1116031,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "I wouldn't steal a locker number."
    } ]
  }, {
    "tStartMs": 1117366,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "I've never stolen for 37."
    } ]
  }, {
    "tStartMs": 1119118,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "(speaker 1 laughing)"
    } ]
  }, {
    "tStartMs": 1120369,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "- Look at that."
    } ]
  }, {
    "tStartMs": 1121286,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Stolen from the highway\nwhen I was on a road trip,"
    } ]
  }, {
    "tStartMs": 1123956,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "- [Speaker 1] I heard you say,\nyou never stole anything."
    } ]
  }, {
    "tStartMs": 1125582,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "- I have committed a crime.\n- [Speaker 1] Yes."
    } ]
  }, {
    "tStartMs": 1128001,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "- There was a bookstore on campus"
    } ]
  }, {
    "tStartMs": 1129586,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "when I was an undergrad at KU,"
    } ]
  }, {
    "tStartMs": 1131672,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "and there were 37 steps in that staircase."
    } ]
  }, {
    "tStartMs": 1134591,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Useful facts, these are useful facts."
    } ]
  }, {
    "tStartMs": 1137052,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "- Do you feel like everyone\ngets 37 this much in their lives"
    } ]
  }, {
    "tStartMs": 1140764,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "or do you feel like\nyou're just attracting it?"
    } ]
  }, {
    "tStartMs": 1143892,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "- That's a good question."
    } ]
  }, {
    "tStartMs": 1145144,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "You know, the reason I started"
    } ]
  }, {
    "tStartMs": 1146603,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "was because it seemed\nlike it turned up a lot."
    } ]
  }, {
    "tStartMs": 1148605,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "I started back in the '80s."
    } ]
  }, {
    "tStartMs": 1150440,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "There was a comedy routine\nby Charles Fleischer,"
    } ]
  }, {
    "tStartMs": 1152651,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "and he went through this sort\nof litany of coincidences"
    } ]
  }, {
    "tStartMs": 1156405,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "about the number 37,"
    } ]
  }, {
    "tStartMs": 1157489,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "like there are 37 holes in the\nspeaker part of a telephone."
    } ]
  }, {
    "tStartMs": 1160075,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 1161910,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Shakespeare wrote 37 plays."
    } ]
  }, {
    "tStartMs": 1163620,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "There's 37 movements in\nBeethoven's Nine Symphonies."
    } ]
  }, {
    "tStartMs": 1166290,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "There are all these amazing coincidences"
    } ]
  }, {
    "tStartMs": 1167875,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "that he rattled off."
    } ]
  }, {
    "tStartMs": 1168917,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "I was amazed and I've been\ncollecting them since like 1981."
    } ]
  }, {
    "tStartMs": 1173505,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "Yeah, so 43?"
    } ]
  }, {
    "tStartMs": 1175299,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "43 years, probably."
    } ]
  }, {
    "tStartMs": 1178051,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "(jaunty music)"
    } ]
  }, {
    "tStartMs": 1179386,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "I built the 37 Website for\nthe first time in 1994."
    } ]
  }, {
    "tStartMs": 1183724,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "I don't know how the\nwebsite got out there,"
    } ]
  }, {
    "tStartMs": 1185392,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "but somehow it got out there."
    } ]
  }, {
    "tStartMs": 1187686,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "I started getting email from strangers."
    } ]
  }, {
    "tStartMs": 1189479,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "I've got..."
    } ]
  }, {
    "tStartMs": 1190689,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Oh, maybe a half a dozen\npeople from around the world,"
    } ]
  }, {
    "tStartMs": 1193984,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "who, every week or month,"
    } ]
  }, {
    "tStartMs": 1195611,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "will post their latest batch of 37s"
    } ]
  }, {
    "tStartMs": 1198530,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "that they've seen out and about."
    } ]
  }, {
    "tStartMs": 1199740,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "- And they've been\ndoing this for how long?"
    } ]
  }, {
    "tStartMs": 1202159,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- 18 years."
    } ]
  }, {
    "tStartMs": 1203327,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Wow.\n- We're tireless."
    } ]
  }, {
    "tStartMs": 1205787,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "The tireless cabal of 37 people, yeah."
    } ]
  }, {
    "tStartMs": 1208540,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "- Do you have anything to say\nto anyone who might be like,"
    } ]
  }, {
    "tStartMs": 1211627,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "\"37, that's just a base-10\nrepresentation of that number.\""
    } ]
  }, {
    "tStartMs": 1215297,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "- I am also interested the number 37"
    } ]
  }, {
    "tStartMs": 1218383,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "in all of its various other forms:"
    } ]
  }, {
    "tStartMs": 1220636,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Roman numerals;"
    } ]
  }, {
    "tStartMs": 1221845,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "binary numbers 100101, by the way;"
    } ]
  }, {
    "tStartMs": 1225766,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "numbers in any other base."
    } ]
  }, {
    "tStartMs": 1227392,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Yeah, 25 in hexadecimal."
    } ]
  }, {
    "tStartMs": 1230354,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "45 in octal."
    } ]
  }, {
    "tStartMs": 1232356,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "- And do you think you're\ngonna keep looking for a 37"
    } ]
  }, {
    "tStartMs": 1234608,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "and collecting 37 for your whole life?"
    } ]
  }, {
    "tStartMs": 1236944,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "- Yeah, yeah, I can't\nsee any reason to stop."
    } ]
  }, {
    "tStartMs": 1239780,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Yeah, for sure."
    } ]
  }, {
    "tStartMs": 1242282,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "- So maybe there's even something innately"
    } ]
  }, {
    "tStartMs": 1244743,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "universally special about this number."
    } ]
  }, {
    "tStartMs": 1247579,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1261593,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "We can argue special\ncoincidences for many numbers,"
    } ]
  }, {
    "tStartMs": 1264846,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "but we need to finally address\nthe elephant in the room."
    } ]
  }, {
    "tStartMs": 1268058,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "The sheer amount of brain power"
    } ]
  }, {
    "tStartMs": 1270102,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "37 secretly takes up in\nour collective minds."
    } ]
  }, {
    "tStartMs": 1273188,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "It's humanity's go-to random number,"
    } ]
  }, {
    "tStartMs": 1275899,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "one of our most prominent prime numbers,"
    } ]
  }, {
    "tStartMs": 1277943,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "and most of all, our ideal\nnumber for making decisions."
    } ]
  }, {
    "tStartMs": 1281822,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Maybe that's why we're\ninclined to it naturally."
    } ]
  }, {
    "tStartMs": 1284616,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "It feels right to us as where\nto settle and what to pick."
    } ]
  }, {
    "tStartMs": 1287828,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Though with this video,"
    } ]
  }, {
    "tStartMs": 1288829,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "we may have ruined\nrandomness even further."
    } ]
  }, {
    "tStartMs": 1291248,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "I mean, the next time anyone asks people"
    } ]
  }, {
    "tStartMs": 1292874,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "to pick a random number between 1 and 100,"
    } ]
  }, {
    "tStartMs": 1295002,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "more people than ever\nmight be saying, \"37.\""
    } ]
  }, {
    "tStartMs": 1297754,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "(pensive music)"
    } ]
  }, {
    "tStartMs": 1299256,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "- It's been the story of my life"
    } ]
  }, {
    "tStartMs": 1300674,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "that I intend to take\neverything that I have here"
    } ]
  }, {
    "tStartMs": 1304469,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "and turn them all into\nindividual facts on that website."
    } ]
  }, {
    "tStartMs": 1307973,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "But the website's been\nthere untouched for 27 years"
    } ]
  }, {
    "tStartMs": 1310392,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "and it hasn't happened."
    } ]
  }, {
    "tStartMs": 1311226,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "It doesn't look like\nit's ever gonna happen."
    } ]
  }, {
    "tStartMs": 1313020,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "- Maybe on the 37th anniversary,\nwe can get it all done."
    } ]
  }, {
    "tStartMs": 1317232,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "- That's a good idea."
    } ]
  }, {
    "tStartMs": 1318775,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "That's a good idea."
    } ]
  }, {
    "tStartMs": 1319735,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Because I have time to do\nit between now and then,"
    } ]
  }, {
    "tStartMs": 1322154,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and that would be..."
    } ]
  }, {
    "tStartMs": 1323864,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "That's a great idea."
    } ]
  }, {
    "tStartMs": 1324990,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "- Once our video comes out,"
    } ]
  }, {
    "tStartMs": 1326033,
    "dDurationMs": 1751,
    "segs": [ {
