{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 60,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "There is a riddle that\nis so counterintuitive,"
    } ]
  }, {
    "tStartMs": 3420,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "it still seems wrong even\nif you know the answer."
    } ]
  }, {
    "tStartMs": 6210,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- You'd think it's an\nalmost impossible number."
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- I feel like you probably\nhit me with some truth bomb."
    } ]
  }, {
    "tStartMs": 11010,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- I mean, if you're trying\nto create controversy"
    } ]
  }, {
    "tStartMs": 13080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and you're trying to confuse people,"
    } ]
  }, {
    "tStartMs": 14640,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "you're gonna succeed."
    } ]
  }, {
    "tStartMs": 15801,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "(both laughs)"
    } ]
  }, {
    "tStartMs": 17370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- There are a bunch of\nYouTube videos about it,"
    } ]
  }, {
    "tStartMs": 19410,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "but I find all of them either\nincorrect or incomplete."
    } ]
  }, {
    "tStartMs": 23310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So in this video, I'm going to dive deeper"
    } ]
  }, {
    "tStartMs": 25890,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and explain it fully."
    } ]
  }, {
    "tStartMs": 27600,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "Here is the setup."
    } ]
  }, {
    "tStartMs": 33357,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 35520,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Say there are 100 prisoners\nnumbered 1 to 100."
    } ]
  }, {
    "tStartMs": 39390,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Slips of paper containing\neach of their numbers"
    } ]
  }, {
    "tStartMs": 41670,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "are randomly placed in 100\nboxes in a sealed room."
    } ]
  }, {
    "tStartMs": 46290,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "One at a time, each prisoner\nis allowed to enter the room"
    } ]
  }, {
    "tStartMs": 49290,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and open any 50 of the 100 boxes,"
    } ]
  }, {
    "tStartMs": 52260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "searching for their number."
    } ]
  }, {
    "tStartMs": 54000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And afterwards, they must leave the room"
    } ]
  }, {
    "tStartMs": 56190,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "exactly as they found it,"
    } ]
  }, {
    "tStartMs": 57810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and they can't communicate in any way"
    } ]
  }, {
    "tStartMs": 59820,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "with the other prisoners."
    } ]
  }, {
    "tStartMs": 61770,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "If all 100 prisoners find their own number"
    } ]
  }, {
    "tStartMs": 64710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "during their turn in the room,"
    } ]
  }, {
    "tStartMs": 66180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "they will all be freed."
    } ]
  }, {
    "tStartMs": 68400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "But if even one of them\nfails to find their number,"
    } ]
  }, {
    "tStartMs": 71220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "they will all be executed."
    } ]
  }, {
    "tStartMs": 73770,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The prisoners are allowed to strategize"
    } ]
  }, {
    "tStartMs": 76470,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "before any of them goes into the room."
    } ]
  }, {
    "tStartMs": 79020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So what is their best strategy?"
    } ]
  }, {
    "tStartMs": 82020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If they each search for\ntheir own number randomly,"
    } ]
  }, {
    "tStartMs": 84660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "then each prisoner has a\n50% chance of finding it."
    } ]
  }, {
    "tStartMs": 87960,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So the probability that all 100\nprisoners find their numbers"
    } ]
  }, {
    "tStartMs": 91470,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "is 1/2 times 1/2 times 1/2 a hundred times"
    } ]
  }, {
    "tStartMs": 95670,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or 1/2 to the power of 100."
    } ]
  }, {
    "tStartMs": 98250,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "This is equal to 0.00000000 30 zeros,"
    } ]
  }, {
    "tStartMs": 104310,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and then an eight."
    } ]
  }, {
    "tStartMs": 106290,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "To put this probability into perspective,"
    } ]
  }, {
    "tStartMs": 108930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "two people have a better\nchance of picking out"
    } ]
  }, {
    "tStartMs": 111450,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the same grain of sand from all"
    } ]
  }, {
    "tStartMs": 114180,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the beaches and deserts on earth"
    } ]
  }, {
    "tStartMs": 116910,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "than by escaping this way."
    } ]
  }, {
    "tStartMs": 119940,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "But what have I told you\nthat with the right strategy,"
    } ]
  }, {
    "tStartMs": 122910,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "there's a way to raise their\nchances to nearly one in three."
    } ]
  }, {
    "tStartMs": 126840,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It improves their odds of a random chance"
    } ]
  }, {
    "tStartMs": 128910,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "by nearly 30 orders of magnitude."
    } ]
  }, {
    "tStartMs": 132000,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "That's like taking a\nmillimeter and scaling it up"
    } ]
  }, {
    "tStartMs": 134490,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "to the diameter of the\nobservable universe."
    } ]
  }, {
    "tStartMs": 139830,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- But they can only coordinate\nthis strategy beforehand."
    } ]
  }, {
    "tStartMs": 143010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Correct?"
    } ]
  }, {
    "tStartMs": 143843,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "- Is this true?"
    } ]
  }, {
    "tStartMs": 145050,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 147720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Teach me."
    } ]
  }, {
    "tStartMs": 149700,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- This is not a trick question."
    } ]
  }, {
    "tStartMs": 152070,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "The solution just involves an\nincredible feature of math."
    } ]
  }, {
    "tStartMs": 155700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So what is this mathematical strategy?"
    } ]
  }, {
    "tStartMs": 158460,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Well, if you don't\nalready know the answer,"
    } ]
  }, {
    "tStartMs": 160230,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "feel free to pause the video\nhere and try it for yourself."
    } ]
  }, {
    "tStartMs": 166020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And if you don't come\nup with it, don't worry,"
    } ]
  }, {
    "tStartMs": 168360,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "you're in good company."
    } ]
  }, {
    "tStartMs": 169320,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Even the person who came\nup with this riddle,"
    } ]
  }, {
    "tStartMs": 171330,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "computer scientist Peter Bro Miltersen,"
    } ]
  }, {
    "tStartMs": 173280,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "he didn't even think of this strategy"
    } ]
  }, {
    "tStartMs": 174870,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "until a colleague pointed it out."
    } ]
  }, {
    "tStartMs": 177330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Miltersen, ultimately published\nthis problem in a paper"
    } ]
  }, {
    "tStartMs": 180060,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "where he generously left the solution"
    } ]
  }, {
    "tStartMs": 182370,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "as an exercise for the reader."
    } ]
  }, {
    "tStartMs": 185790,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So here is the solution."
    } ]
  }, {
    "tStartMs": 188880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Pretend you are one of the prisoners,"
    } ]
  }, {
    "tStartMs": 191520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "when you go into the room,"
    } ]
  }, {
    "tStartMs": 193170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "open the box with your number on it,"
    } ]
  }, {
    "tStartMs": 196170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the number on the slip inside\nprobably won't be yours,"
    } ]
  }, {
    "tStartMs": 199170,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but that's okay."
    } ]
  }, {
    "tStartMs": 200580,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Go to the box with that number on it."
    } ]
  }, {
    "tStartMs": 203070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "look at the number inside,"
    } ]
  }, {
    "tStartMs": 204360,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "then go to the box with that\nnumber on it, and so on."
    } ]
  }, {
    "tStartMs": 207810,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Keep doing this until you find\nthe slip with your number."
    } ]
  }, {
    "tStartMs": 211440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "If you find your number,"
    } ]
  }, {
    "tStartMs": 212790,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that essentially tells you"
    } ]
  }, {
    "tStartMs": 214140,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to go back to the box where you started."
    } ]
  }, {
    "tStartMs": 216390,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It closes the loop of numbers\nyou've been following."
    } ]
  }, {
    "tStartMs": 219990,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But if you've found your\nnumber, then you're done."
    } ]
  }, {
    "tStartMs": 222630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "You can stop and leave the room."
    } ]
  }, {
    "tStartMs": 225120,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "This simple strategy\ngives over a 30% chance"
    } ]
  }, {
    "tStartMs": 228690,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "that all the prisoners\nwill find their number."
    } ]
  }, {
    "tStartMs": 231660,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- The entire pool has a 30..."
    } ]
  }, {
    "tStartMs": 233730,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "- Everyone can find their\nnumber 31% of the time."
    } ]
  }, {
    "tStartMs": 238200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What?"
    } ]
  }, {
    "tStartMs": 240630,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "- But how does it work?"
    } ]
  }, {
    "tStartMs": 243300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The first thing to\nnotice is that all boxes"
    } ]
  }, {
    "tStartMs": 245760,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "become part of a closed loop."
    } ]
  }, {
    "tStartMs": 248880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The simplest loop would be"
    } ]
  }, {
    "tStartMs": 250200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "a box that contains its own number."
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "If you're prisoner number\none and you go to box one,"
    } ]
  }, {
    "tStartMs": 254730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "it contains slip one, then you're done."
    } ]
  }, {
    "tStartMs": 257370,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Your number was part of a loop of one,"
    } ]
  }, {
    "tStartMs": 260580,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but you could also have a loop of two."
    } ]
  }, {
    "tStartMs": 262770,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Say box one points to box seven"
    } ]
  }, {
    "tStartMs": 264810,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and box seven points back to box one."
    } ]
  }, {
    "tStartMs": 267870,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Or you could have a loop\nof three, or four, or five,"
    } ]
  }, {
    "tStartMs": 272670,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "or any length all the way up to 100."
    } ]
  }, {
    "tStartMs": 276000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The longest loop you\ncould have would connect"
    } ]
  }, {
    "tStartMs": 277800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "all the numbers in a single loop."
    } ]
  }, {
    "tStartMs": 280440,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But more generally, any random arrangement"
    } ]
  }, {
    "tStartMs": 283110,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of the slips in these boxes"
    } ]
  }, {
    "tStartMs": 284520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "will result in a mixture of some shorter"
    } ]
  }, {
    "tStartMs": 287310,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "and some longer loops."
    } ]
  }, {
    "tStartMs": 290220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "When you start with a box\nlabeled with your number,"
    } ]
  }, {
    "tStartMs": 292740,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you are guaranteed to be on the loop"
    } ]
  }, {
    "tStartMs": 294930,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that includes your slip."
    } ]
  }, {
    "tStartMs": 296670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So the thing that\ndetermines whether or not"
    } ]
  }, {
    "tStartMs": 298590,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "you find your slip is\nthe length of the loop."
    } ]
  }, {
    "tStartMs": 301890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If your number is part of a\nloop that is shorter than 50,"
    } ]
  }, {
    "tStartMs": 304440,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "then you will definitely find your slip."
    } ]
  }, {
    "tStartMs": 307020,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But if your number is part of\na loop that is 51 or longer,"
    } ]
  }, {
    "tStartMs": 310050,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "you are in trouble."
    } ]
  }, {
    "tStartMs": 311520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "You won't find it before you've exhausted"
    } ]
  }, {
    "tStartMs": 313740,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "the 50 boxes you're allowed to search."
    } ]
  }, {
    "tStartMs": 317280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "When you open the box\nlabeled with your number,"
    } ]
  }, {
    "tStartMs": 319710,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "you are in fact starting"
    } ]
  }, {
    "tStartMs": 321120,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "at the farthest point on\nthe loop from your slip."
    } ]
  }, {
    "tStartMs": 323970,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "You wanna know where is the\nslip that points to this box,"
    } ]
  }, {
    "tStartMs": 327990,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but to find it, you have to\nfollow the loop of numbers"
    } ]
  }, {
    "tStartMs": 330450,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "all the way around to the end."
    } ]
  }, {
    "tStartMs": 332820,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "That means if the prisoners\nfollow this strategy"
    } ]
  }, {
    "tStartMs": 335520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the longest loop is 51,"
    } ]
  }, {
    "tStartMs": 337440,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "not just one or two prisoners"
    } ]
  }, {
    "tStartMs": 339390,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "will fail to find their number,"
    } ]
  }, {
    "tStartMs": 340890,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but all 51 on this loop won't make it."
    } ]
  }, {
    "tStartMs": 344370,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "They make it to the box just\nbefore the box with their slip,"
    } ]
  }, {
    "tStartMs": 347580,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "but they have to stop searching there."
    } ]
  }, {
    "tStartMs": 353225,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(both laughs)"
    } ]
  }, {
    "tStartMs": 357180,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So the probability that all\nof the prisoners succeed"
    } ]
  }, {
    "tStartMs": 360390,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "is just the probability\nthat a random arrangement"
    } ]
  }, {
    "tStartMs": 362640,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "of a hundred numbers contains\nno loops longer than 50."
    } ]
  }, {
    "tStartMs": 366960,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Now I promised that this\nprobability would come out"
    } ]
  }, {
    "tStartMs": 369180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to around one in three,"
    } ]
  }, {
    "tStartMs": 370710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but how do we calculate it?"
    } ]
  }, {
    "tStartMs": 373080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Well, imagine writing down\nall the different ways"
    } ]
  }, {
    "tStartMs": 376080,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "that you could connect\n100 boxes to form a loop"
    } ]
  }, {
    "tStartMs": 379920,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "of length 100."
    } ]
  }, {
    "tStartMs": 381000,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So you could have box\none points to box two,"
    } ]
  }, {
    "tStartMs": 384180,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "box two points to box three\nto box four, and so on,"
    } ]
  }, {
    "tStartMs": 388110,
    "dDurationMs": 1707,
    "segs": [ {
      "utf8": "all the way to 100,"
    } ]
  }, {
    "tStartMs": 389817,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "and then box 100 would\npoint back to box one,"
    } ]
  }, {
    "tStartMs": 393570,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or you could have something random."
    } ]
  }, {
    "tStartMs": 396150,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "Box five points to box\n99 to box 17 and so on,"
    } ]
  }, {
    "tStartMs": 400620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and let's pick the last one,"
    } ]
  }, {
    "tStartMs": 402720,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "is 63."
    } ]
  }, {
    "tStartMs": 405060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And box 63 points back to box five."
    } ]
  }, {
    "tStartMs": 407700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So how many different arrangements\nof these a hundred boxes"
    } ]
  }, {
    "tStartMs": 411600,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "or permutations could you have?"
    } ]
  }, {
    "tStartMs": 414390,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Well, for the first box,"
    } ]
  }, {
    "tStartMs": 416010,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "I have 100 different boxes\nthat I could choose from."
    } ]
  }, {
    "tStartMs": 419430,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The second box, because\nI've already used one,"
    } ]
  }, {
    "tStartMs": 422610,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "I can only pick from 99 boxes,"
    } ]
  }, {
    "tStartMs": 425100,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and the next one, I can pick\nfrom 98 boxes, and so on,"
    } ]
  }, {
    "tStartMs": 428910,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "down to the very last box."
    } ]
  }, {
    "tStartMs": 430800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "I don't really have a choice."
    } ]
  }, {
    "tStartMs": 431970,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "There's only one box left I\ncould put in the last position."
    } ]
  }, {
    "tStartMs": 436200,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So the total number of\ndifferent permutations"
    } ]
  }, {
    "tStartMs": 438270,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "would be 100 times 99, times 98, times 97,"
    } ]
  }, {
    "tStartMs": 442770,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "all the way down to one."
    } ]
  }, {
    "tStartMs": 443970,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "That is just 100 factorial."
    } ]
  }, {
    "tStartMs": 447690,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "There are 100 factorial different ways"
    } ]
  }, {
    "tStartMs": 451440,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "that you could create a\nloop of a hundred boxes."
    } ]
  }, {
    "tStartMs": 455400,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But what we can't forget"
    } ]
  }, {
    "tStartMs": 457980,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "is that these are not\njust lines of numbers."
    } ]
  }, {
    "tStartMs": 460890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They are loops."
    } ]
  }, {
    "tStartMs": 462870,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So some of these lines that look different"
    } ]
  }, {
    "tStartMs": 466590,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "are actually the same loop."
    } ]
  }, {
    "tStartMs": 470820,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "For example, two, three,\nfour, five, and so on"
    } ]
  }, {
    "tStartMs": 473850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "up to 100 and then 1"
    } ]
  }, {
    "tStartMs": 475500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "is the same thing as 1, 2, 3, 4, 5 to 100."
    } ]
  }, {
    "tStartMs": 479100,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "You can rearrange the way\nyou write these numbers"
    } ]
  }, {
    "tStartMs": 482370,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "a hundred different ways,"
    } ]
  }, {
    "tStartMs": 485250,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "but they all represent the same loop."
    } ]
  }, {
    "tStartMs": 488640,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "So the total number of\nunique loops of length 100"
    } ]
  }, {
    "tStartMs": 492840,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "is 100 factorial divided by 100."
    } ]
  }, {
    "tStartMs": 496530,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So what is the probability that any"
    } ]
  }, {
    "tStartMs": 500190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "random arrangement of 100 boxes"
    } ]
  }, {
    "tStartMs": 502680,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "will contain a loop of length 100?"
    } ]
  }, {
    "tStartMs": 504990,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Well, it's just equal to the\nnumber of unique such loops"
    } ]
  }, {
    "tStartMs": 508110,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that we just calculated,"
    } ]
  }, {
    "tStartMs": 509460,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "100 factorial over 100,"
    } ]
  }, {
    "tStartMs": 511200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "divided by the total number of ways"
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that you could put a\nhundred slips in 100 boxes,"
    } ]
  }, {
    "tStartMs": 516330,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "which is 100 factorial."
    } ]
  }, {
    "tStartMs": 519840,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So the answer is 1 over 100."
    } ]
  }, {
    "tStartMs": 523290,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So there is a 1% chance that\na random arrangement of slips"
    } ]
  }, {
    "tStartMs": 526920,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "results in a loop of length 100,"
    } ]
  }, {
    "tStartMs": 529350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and this is a general result."
    } ]
  }, {
    "tStartMs": 531600,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The probability that you\nget a loop of length 99"
    } ]
  }, {
    "tStartMs": 534570,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "is 1 over 99."
    } ]
  }, {
    "tStartMs": 537315,
    "dDurationMs": 2568,
    "segs": [ {
      "utf8": "The probability that you\nget a loop of length 98"
    } ]
  }, {
    "tStartMs": 539883,
    "dDurationMs": 2217,
    "segs": [ {
      "utf8": "is 1 over 98."
    } ]
  }, {
    "tStartMs": 542100,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "So the probability that there\nis a loop longer than 50"
    } ]
  }, {
    "tStartMs": 546270,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "is 1 over 51 plus 1 over 52"
    } ]
  }, {
    "tStartMs": 549125,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "plus one over 53, et cetera."
    } ]
  }, {
    "tStartMs": 552210,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Add all these up, and it equals .69."
    } ]
  }, {
    "tStartMs": 555690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "There is a 69% chance of\nfailure for the prisoners,"
    } ]
  }, {
    "tStartMs": 559050,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "meaning a 31% chance of success"
    } ]
  }, {
    "tStartMs": 561780,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "where the longest loop is 50 or shorter."
    } ]
  }, {
    "tStartMs": 567810,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- I still find it difficult to believe."
    } ]
  }, {
    "tStartMs": 569970,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] This feels a bit like magic."
    } ]
  }, {
    "tStartMs": 572100,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Using the loop strategy,"
    } ]
  }, {
    "tStartMs": 573750,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "all the prisoners are more\nlikely to find their numbers"
    } ]
  }, {
    "tStartMs": 576330,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "than even just two prisoners\nchoosing at random."
    } ]
  }, {
    "tStartMs": 579810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So using the loop strategy,"
    } ]
  }, {
    "tStartMs": 581880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "what is the probability\nthat each prisoner alone"
    } ]
  }, {
    "tStartMs": 584640,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "finds their number?"
    } ]
  }, {
    "tStartMs": 586500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It is still 50%."
    } ]
  }, {
    "tStartMs": 589350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Each prisoner can still\nonly open half the boxes,"
    } ]
  }, {
    "tStartMs": 592110,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "so their individual chance is still 1/2,"
    } ]
  }, {
    "tStartMs": 595950,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "but these probabilities"
    } ]
  }, {
    "tStartMs": 597300,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "are no longer independent of each other."
    } ]
  }, {
    "tStartMs": 600450,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Imagine running this experiment\na thousand times over."
    } ]
  }, {
    "tStartMs": 603960,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "If everyone is guessing randomly,"
    } ]
  }, {
    "tStartMs": 605910,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "you'd expect that on most\nruns around 50 prisoners"
    } ]
  }, {
    "tStartMs": 608670,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "would find their number."
    } ]
  }, {
    "tStartMs": 610170,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "On lucky runs, the number\nwould be a bit higher,"
    } ]
  }, {
    "tStartMs": 612630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "on unlucky runs, a bit lower."
    } ]
  }, {
    "tStartMs": 614880,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But using the loop strategy,"
    } ]
  }, {
    "tStartMs": 617070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "all of the prisoners\nwould find their numbers"
    } ]
  }, {
    "tStartMs": 619380,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "31% of the time."
    } ]
  }, {
    "tStartMs": 621570,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And 69% of the time, fewer\nthan 50 find their number."
    } ]
  }, {
    "tStartMs": 626610,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The prisoners all win together"
    } ]
  }, {
    "tStartMs": 628680,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "or the majority loses together."
    } ]
  }, {
    "tStartMs": 631500,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "That's how this strategy works."
    } ]
  }, {
    "tStartMs": 635340,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Why are you assuming that\nyour number will always be"
    } ]
  }, {
    "tStartMs": 638070,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "on the loop that you're on?"
    } ]
  }, {
    "tStartMs": 639390,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- I feel like-\n- I don't understand that."
    } ]
  }, {
    "tStartMs": 640830,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- This is a key question, right?"
    } ]
  }, {
    "tStartMs": 642360,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- 'Cause I feel like\nit's possible to start"
    } ]
  }, {
    "tStartMs": 645780,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and go on a complete loop"
    } ]
  }, {
    "tStartMs": 647610,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and not come back to your own number"
    } ]
  }, {
    "tStartMs": 650400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because you got on the wrong loop"
    } ]
  }, {
    "tStartMs": 652680,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and then you'd have to\nget on another loop,"
    } ]
  }, {
    "tStartMs": 654330,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "so I don't know that I'd buy this."
    } ]
  }, {
    "tStartMs": 656569,
    "dDurationMs": 1931,
    "segs": [ {
      "utf8": "- Right, right, right,\nright, right, right."
    } ]
  }, {
    "tStartMs": 658500,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Now, the big question everyone asks is"
    } ]
  }, {
    "tStartMs": 661170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "how do you know that if you start"
    } ]
  }, {
    "tStartMs": 662970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "with a box with your number on it"
    } ]
  }, {
    "tStartMs": 664860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you are guaranteed to be on the loop"
    } ]
  }, {
    "tStartMs": 667500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that contains your slip?"
    } ]
  }, {
    "tStartMs": 669690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Well, if you think about it,"
    } ]
  }, {
    "tStartMs": 671340,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "the slip that says 73,\nif anyone sees that,"
    } ]
  }, {
    "tStartMs": 675660,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "they will definitely go to\nthe box with the number 73."
    } ]
  }, {
    "tStartMs": 679800,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So the slip and box with the same number"
    } ]
  }, {
    "tStartMs": 683070,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "essentially form a unit."
    } ]
  }, {
    "tStartMs": 685020,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "They're like a little Lego brick."
    } ]
  }, {
    "tStartMs": 687690,
    "dDurationMs": 4927,
    "segs": [ {
      "utf8": "And then every slip is\nhidden inside another box."
    } ]
  }, {
    "tStartMs": 693480,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "So as I start laying out\nslips and boxes randomly,"
    } ]
  }, {
    "tStartMs": 697620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you can see that there's no way"
    } ]
  }, {
    "tStartMs": 699960,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that we can end up with a dead end."
    } ]
  }, {
    "tStartMs": 702090,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It's not like you can just\nget to a box and then stop"
    } ]
  }, {
    "tStartMs": 704400,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because every box contains a slip"
    } ]
  }, {
    "tStartMs": 706770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and that points at another box."
    } ]
  }, {
    "tStartMs": 709410,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So the only way for you to see only boxes"
    } ]
  }, {
    "tStartMs": 712830,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "when you walk into the room"
    } ]
  }, {
    "tStartMs": 714450,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "is for every slip to be\ncontained within a box,"
    } ]
  }, {
    "tStartMs": 720000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and that necessarily will mean"
    } ]
  }, {
    "tStartMs": 722220,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that we are forming loops."
    } ]
  }, {
    "tStartMs": 724950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So when I start with box 73,"
    } ]
  }, {
    "tStartMs": 727470,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I must eventually find slip 73,"
    } ]
  }, {
    "tStartMs": 730230,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because then and only then"
    } ]
  }, {
    "tStartMs": 732510,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "will I be directed to go back to box 73"
    } ]
  }, {
    "tStartMs": 735420,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "which closes the loop."
    } ]
  }, {
    "tStartMs": 739440,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Who is the warden to this prison?"
    } ]
  }, {
    "tStartMs": 741900,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And what kind of sadistic\nmathematical warden"
    } ]
  }, {
    "tStartMs": 745050,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "are you dealing with here?"
    } ]
  }, {
    "tStartMs": 746070,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "This is awful."
    } ]
  }, {
    "tStartMs": 747090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- Now, what if there is a\nsympathetic prison guard"
    } ]
  }, {
    "tStartMs": 749880,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "who sneaks into the room before\nany of the prisoners go in?"
    } ]
  }, {
    "tStartMs": 753660,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Well, then they can guarantee\nsuccess for the prisoners"
    } ]
  }, {
    "tStartMs": 756900,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "by swapping the contents\nof just two boxes."
    } ]
  }, {
    "tStartMs": 760620,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "That's because there\ncan be at most one loop"
    } ]
  }, {
    "tStartMs": 763410,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that is longer than 50,"
    } ]
  }, {
    "tStartMs": 765570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and you can break it in half"
    } ]
  }, {
    "tStartMs": 767940,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "just by swapping the\ncontents of two boxes."
    } ]
  }, {
    "tStartMs": 771600,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And now I have two separate loops"
    } ]
  }, {
    "tStartMs": 773010,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "that are each shorter than 50."
    } ]
  }, {
    "tStartMs": 776880,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But what if there was a malicious guard"
    } ]
  }, {
    "tStartMs": 779190,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "who figured out that the prisoners"
    } ]
  }, {
    "tStartMs": 780570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "were going to use this loop strategy?"
    } ]
  }, {
    "tStartMs": 782970,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Well, then they could\nput the numbers in boxes"
    } ]
  }, {
    "tStartMs": 784830,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to ensure they formed\na loop longer than 50."
    } ]
  }, {
    "tStartMs": 788370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "In this case, are the prisoners doomed?"
    } ]
  }, {
    "tStartMs": 790860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Surprisingly, no."
    } ]
  }, {
    "tStartMs": 793290,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "They can counter by arbitrarily\nrenumbering the boxes."
    } ]
  }, {
    "tStartMs": 797610,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "They could, for example,\nadd five to each box number."
    } ]
  }, {
    "tStartMs": 801780,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "The loops are set both by\nthe locations of the slips"
    } ]
  }, {
    "tStartMs": 805590,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "and by the box numbers."
    } ]
  }, {
    "tStartMs": 808350,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Renumbering the boxes\nis essentially the same"
    } ]
  }, {
    "tStartMs": 810690,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "as redistributing the slips."
    } ]
  }, {
    "tStartMs": 812940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So the problem is back to a\nrandom arrangement of loops,"
    } ]
  }, {
    "tStartMs": 815850,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "meaning the prisoners are back to their"
    } ]
  }, {
    "tStartMs": 817410,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "31% chance of survival."
    } ]
  }, {
    "tStartMs": 821280,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Now, what happens if you\nincrease the number of prisoners?"
    } ]
  }, {
    "tStartMs": 825150,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Fun fact, nobody knows if"
    } ]
  }, {
    "tStartMs": 827880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "as you have more and more prisoners"
    } ]
  }, {
    "tStartMs": 829500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it's going towards a limit,"
    } ]
  }, {
    "tStartMs": 830940,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "or if it'll eventually\ngo down to zero, or what?"
    } ]
  }, {
    "tStartMs": 833550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- That is my friend Matt Parker,"
    } ]
  }, {
    "tStartMs": 835770,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and I think what he meant to say"
    } ]
  }, {
    "tStartMs": 837540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is we know exactly what happens"
    } ]
  }, {
    "tStartMs": 839550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "as you increase the number of prisoners."
    } ]
  }, {
    "tStartMs": 841920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "With a thousand prisoners each\nallowed to check 500 boxes,"
    } ]
  }, {
    "tStartMs": 845760,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "you might expect their chance of success"
    } ]
  }, {
    "tStartMs": 847530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to drop dramatically,"
    } ]
  }, {
    "tStartMs": 849180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but you can calculate\nit like we did before,"
    } ]
  }, {
    "tStartMs": 851700,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and it comes out to 30.74%,"
    } ]
  }, {
    "tStartMs": 855030,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "only half a percentage point\nlower than for 100 prisoners."
    } ]
  }, {
    "tStartMs": 858870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "For 1 million prisoners,"
    } ]
  }, {
    "tStartMs": 860550,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "the probability of success is 30.685%,"
    } ]
  }, {
    "tStartMs": 864660,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "which is only a little\nhigher than for 1 billion."
    } ]
  }, {
    "tStartMs": 867570,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Of course, their bigger problem would be"
    } ]
  }, {
    "tStartMs": 869040,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the time it takes to open all the boxes."
    } ]
  }, {
    "tStartMs": 871590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So your probability of winning this game"
    } ]
  }, {
    "tStartMs": 873990,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "does indeed approach a limit."
    } ]
  }, {
    "tStartMs": 876510,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "So what is that limit?"
    } ]
  }, {
    "tStartMs": 879480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The formula we've been using"
    } ]
  }, {
    "tStartMs": 881190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is one minus the chance of failure,"
    } ]
  }, {
    "tStartMs": 883530,
    "dDurationMs": 3777,
    "segs": [ {
      "utf8": "which is the series 1\nover 51 plus 1 over 52,"
    } ]
  }, {
    "tStartMs": 887307,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "and so on, up to 1 over 100."
    } ]
  }, {
    "tStartMs": 890400,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "We can depict this series as\nthe sum of areas of rectangles,"
    } ]
  }, {
    "tStartMs": 895350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and there is a curve that follows"
    } ]
  }, {
    "tStartMs": 897480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the heights of these blocks."
    } ]
  }, {
    "tStartMs": 899100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That curve is one over X."
    } ]
  }, {
    "tStartMs": 901500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The area under that curve from 50 to 100"
    } ]
  }, {
    "tStartMs": 905100,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "approximates the area\nof all the rectangles."
    } ]
  }, {
    "tStartMs": 908370,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And as the number of\nprisoners goes to infinity,"
    } ]
  }, {
    "tStartMs": 911370,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "it becomes a better and\nbetter approximation."
    } ]
  }, {
    "tStartMs": 914550,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So to find the probability of failure,"
    } ]
  }, {
    "tStartMs": 916800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "we can just take the\nintegral of one over X"
    } ]
  }, {
    "tStartMs": 919560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "from n to 2n."
    } ]
  }, {
    "tStartMs": 921240,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "And we find that it's equal to\nthe natural logarithm of two."
    } ]
  }, {
    "tStartMs": 925620,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This gives a probability of success"
    } ]
  }, {
    "tStartMs": 927600,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of one minus the natural log of two,"
    } ]
  }, {
    "tStartMs": 929970,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "which is about 30.7%."
    } ]
  }, {
    "tStartMs": 933780,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "The bottom line is"
    } ]
  }, {
    "tStartMs": 934800,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that no matter how many\nprisoners you have,"
    } ]
  }, {
    "tStartMs": 937110,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you'll always end up\nwith above a 30% chance"
    } ]
  }, {
    "tStartMs": 939810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of escaping using this strategy."
    } ]
  }, {
    "tStartMs": 941610,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And that feels really wrong."
    } ]
  }, {
    "tStartMs": 943470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I mean, at first it seemed\nessentially impossible"
    } ]
  }, {
    "tStartMs": 945270,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for all 100 prisoners\nto find their numbers."
    } ]
  }, {
    "tStartMs": 947670,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "But now we're seeing that you could have"
    } ]
  }, {
    "tStartMs": 949020,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a hundred, a million,"
    } ]
  }, {
    "tStartMs": 950220,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "or any arbitrarily large\nnumber of prisoners"
    } ]
  }, {
    "tStartMs": 953190,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "with at least a 30% chance that\nthey all find their numbers."
    } ]
  }, {
    "tStartMs": 956880,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The beauty of the loop strategy"
    } ]
  }, {
    "tStartMs": 958530,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "is linking everyone's outcomes together,"
    } ]
  }, {
    "tStartMs": 961440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "instead of each prisoner walking in"
    } ]
  }, {
    "tStartMs": 963090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with their own 50-50 shot."
    } ]
  }, {
    "tStartMs": 965010,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Following the same loops\nmeans that they have"
    } ]
  }, {
    "tStartMs": 967230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "the exact same chance\nof finding their number"
    } ]
  }, {
    "tStartMs": 969480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "as everyone else in their loop."
    } ]
  }, {
    "tStartMs": 971280,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And once the boxes and slips are arranged,"
    } ]
  }, {
    "tStartMs": 973590,
    "dDurationMs": 4371,
    "segs": [ {
      "utf8": "that chance is set at either 100% or 0%."
    } ]
  }, {
    "tStartMs": 977961,
    "dDurationMs": 2709,
    "segs": [ {
      "utf8": "With this strategy, you can't\never get close to winning"
    } ]
  }, {
    "tStartMs": 980670,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "with only a few people\nmissing their numbers."
    } ]
  }, {
    "tStartMs": 982770,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "You can only fail hard\nor succeed completely."
    } ]
  }, {
    "tStartMs": 993990,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Now, if you like solving puzzles"
    } ]
  }, {
    "tStartMs": 995640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "even outside of life-threatening\nprison situations,"
    } ]
  }, {
    "tStartMs": 998490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "well, you'll love Brilliant,\nthese sponsor of this video."
    } ]
  }, {
    "tStartMs": 1001370,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Brilliant is a website and app"
    } ]
  }, {
    "tStartMs": 1002930,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that builds problem-solving skills"
    } ]
  }, {
    "tStartMs": 1004790,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and guides you through\nengaging interactive lessons"
    } ]
  }, {
    "tStartMs": 1007310,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "in math and science."
    } ]
  }, {
    "tStartMs": 1008750,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They have great courses on tons of topics,"
    } ]
  }, {
    "tStartMs": 1010730,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "from statistics to astrophysics to logic."
    } ]
  }, {
    "tStartMs": 1013730,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Now, if you liked this riddle"
    } ]
  }, {
    "tStartMs": 1015080,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and you want more just like it,"
    } ]
  }, {
    "tStartMs": 1016400,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I'd recommend their\nperplexing probability course,"
    } ]
  }, {
    "tStartMs": 1019370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "featuring other seemingly impossible odds"
    } ]
  }, {
    "tStartMs": 1022040,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and even another mathematically\ninclined prison warden."
    } ]
  }, {
    "tStartMs": 1025580,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "They've also got a joy\nof problem solving course"
    } ]
  }, {
    "tStartMs": 1028070,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to take you through some of their"
    } ]
  }, {
    "tStartMs": 1029390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "most delightful math puzzles."
    } ]
  }, {
    "tStartMs": 1031760,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Every lesson builds on\nwhat you learned previously"
    } ]
  }, {
    "tStartMs": 1034070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to give you an in-depth understanding"
    } ]
  }, {
    "tStartMs": 1035930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "with any course you take."
    } ]
  }, {
    "tStartMs": 1037640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Your knowledge is constantly developed"
    } ]
  }, {
    "tStartMs": 1039200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and tested through interactive\nexperiments and quizzes."
    } ]
  }, {
    "tStartMs": 1042080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And if you get stuck, there's\nalways a helpful hint."
    } ]
  }, {
    "tStartMs": 1045200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Head over to brilliant.org/veritasium"
    } ]
  }, {
    "tStartMs": 1048080,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to check out all these courses"
    } ]
  }, {
    "tStartMs": 1049700,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and test your instincts\nafter learning about"
    } ]
  }, {
    "tStartMs": 1051440,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the 100 prisoners riddle."
    } ]
  }, {
    "tStartMs": 1053720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "If you click through right\nnow, Brilliant are offering"
    } ]
  }, {
    "tStartMs": 1056300,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "20% off an annual premium subscription"
    } ]
  }, {
    "tStartMs": 1058490,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to the first 200 people to sign up."
    } ]
  }, {
    "tStartMs": 1060350,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So I wanna thank brilliant\nfor supporting Veritasium,"
    } ]
  }, {
    "tStartMs": 1062870,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
