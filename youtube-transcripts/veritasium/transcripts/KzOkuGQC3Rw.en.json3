  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 940,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Want to spoil your girlfriend with diamonds\nwhile impressing her with your scientific"
    } ]
  }, {
    "tStartMs": 4520,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "knowledge."
    } ]
  }, {
    "tStartMs": 5520,
    "dDurationMs": 5109,
    "segs": [ {
      "utf8": "Here's how:\nBaby, we've been together a long time"
    } ]
  }, {
    "tStartMs": 10629,
    "dDurationMs": 6121,
    "segs": [ {
      "utf8": "and I've picked up on your hints -- I know\nthat you want a diamond,"
    } ]
  }, {
    "tStartMs": 16750,
    "dDurationMs": 5150,
    "segs": [ {
      "utf8": "but I was thinking\nyou're too special to me for just one diamond."
    } ]
  }, {
    "tStartMs": 21900,
    "dDurationMs": 6620,
    "segs": [ {
      "utf8": "I want to give you one and a half million\ndiamonds..."
    } ]
  }, {
    "tStartMs": 28520,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "per second."
    } ]
  }, {
    "tStartMs": 29930,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "And not only that, they're nanodiamonds."
    } ]
  }, {
    "tStartMs": 33710,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "really?"
    } ]
  }, {
    "tStartMs": 34710,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Yeah, isn't that great?"
    } ]
  }, {
    "tStartMs": 37070,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Nanodiamonds."
    } ]
  }, {
    "tStartMs": 38070,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "You are a fu-\nNow is the perfect time to tell her scientists"
    } ]
  }, {
    "tStartMs": 45510,
    "dDurationMs": 4919,
    "segs": [ {
      "utf8": "have recently discovered nanodiamonds in the\nflames of ordinary candles -- millions of"
    } ]
  }, {
    "tStartMs": 50429,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "them!"
    } ]
  }, {
    "tStartMs": 51449,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "As the hydrocarbon wax is burned tiny diamonds\nform in the middle of the flame."
    } ]
  }, {
    "tStartMs": 55969,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 56969,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "They're the exact same as regular diamonds,\njust really, really small."
    } ]
  }, {
    "tStartMs": 60499,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "You always told me size doesn't matter."
    } ]
  }, {
    "tStartMs": 62229,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Are you packing?"
    } ]
  }, {
    "tStartMs": 63809,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "I should have listened to my mother."
    } ]
  }, {
    "tStartMs": 67120,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "Actually, as it turns out, the nanodiamonds\nare burnt up in the flame and released into"
    } ]
  }, {
    "tStartMs": 70970,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "the atmosphere as carbon dioxide."
    } ]
  }, {
    "tStartMs": 73140,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So you're better off getting a big diamond."
    } ]
  }, {
    "tStartMs": 76110,
    "dDurationMs": 7640,
    "segs": [ {
      "utf8": "Otherwise your relationship, like the nanodiamonds,\nwill go up in smoke."
    } ]
  } ]
}
