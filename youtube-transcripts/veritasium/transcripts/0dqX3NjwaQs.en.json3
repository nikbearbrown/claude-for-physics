  "events": [ {
    "tStartMs": 5140,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "As of today, I have been making Youtube videos full-time for 10 years"
    } ]
  }, {
    "tStartMs": 10680,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "So to celebrate, I am answering your questions"
    } ]
  }, {
    "tStartMs": 13310,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "plus I'm giving away items like this beautiful spinning top from vorso and other items from my videos"
    } ]
  }, {
    "tStartMs": 20540,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "so if you want to win one of those"
    } ]
  }, {
    "tStartMs": 21970,
    "dDurationMs": 5650,
    "segs": [ {
      "utf8": "then write down the characters that will appear randomly in the top right corner of this video"
    } ]
  }, {
    "tStartMs": 27620,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Those will be your password to the form in the description"
    } ]
  }, {
    "tStartMs": 31680,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "so let's get into it"
    } ]
  }, {
    "tStartMs": 37600,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Why did you start doing youtube?"
    } ]
  }, {
    "tStartMs": 40620,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "because I always wanted to be a filmmaker"
    } ]
  }, {
    "tStartMs": 43570,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "As a kid, I loved doing plays and musicals"
    } ]
  }, {
    "tStartMs": 47370,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "I had the most fun of my life when I was working with creative other people"
    } ]
  }, {
    "tStartMs": 51970,
    "dDurationMs": 6710,
    "segs": [ {
      "utf8": "but I always thought that a career in the traditional film or tv industry was a terrible idea"
    } ]
  }, {
    "tStartMs": 58680,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "and like your life was out of your control"
    } ]
  }, {
    "tStartMs": 61310,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "It seemed to rely on a big break; I don't think those industries were meritocracies"
    } ]
  }, {
    "tStartMs": 66420,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "so for basically my whole life until I was 28, I did the safe thing"
    } ]
  }, {
    "tStartMs": 71860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And I studied engineering and physics"
    } ]
  }, {
    "tStartMs": 73690,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "and did a PhD in physics and then I taught people physics"
    } ]
  }, {
    "tStartMs": 76940,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "and I love science"
    } ]
  }, {
    "tStartMs": 79000,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "but I also love just the craft of putting together a film or a video and sending it out into the world"
    } ]
  }, {
    "tStartMs": 87400,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "and I think this makes a lot of sense"
    } ]
  }, {
    "tStartMs": 88970,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "because I liked learning about science, and I liked performing"
    } ]
  }, {
    "tStartMs": 92560,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "and that is exactly what making Youtube videos allows me to do"
    } ]
  }, {
    "tStartMs": 96300,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "You know the process of doing science is very different from the process of learning science"
    } ]
  }, {
    "tStartMs": 101310,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "uh and so I think it's not surprising that this is the thing that I love more than being a scientist"
    } ]
  }, {
    "tStartMs": 109470,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "I have been on Youtube for 10 years and it was starting to show. There was so much gray in my beard"
    } ]
  }, {
    "tStartMs": 116700,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "that uh i'm shaving it off to wind back the clock"
    } ]
  }, {
    "tStartMs": 120650,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "I am giving away this fully specked 2017 macbook pro"
    } ]
  }, {
    "tStartMs": 126430,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I used this to make a lot of my videos"
    } ]
  }, {
    "tStartMs": 128670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but those are all wiped off here now"
    } ]
  }, {
    "tStartMs": 130590,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "so it's just a nicely specced laptop"
    } ]
  }, {
    "tStartMs": 133050,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that you could use to make more videos if you wanted"
    } ]
  }, {
    "tStartMs": 137370,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "Any advice you have for people coming out of high school or college and unsure how to take their first steps?"
    } ]
  }, {
    "tStartMs": 143450,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "the key is just start doing it"
    } ]
  }, {
    "tStartMs": 147690,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "after making my Youtube channel for a few months"
    } ]
  }, {
    "tStartMs": 150800,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "I sort of snuck into a science awards in sydney and australia"
    } ]
  }, {
    "tStartMs": 156720,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "And there I found sort of the executive producer of the only science show on Australian television"
    } ]
  }, {
    "tStartMs": 163200,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "and I got his business card"
    } ]
  }, {
    "tStartMs": 165020,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "And the very next day, I emailed him"
    } ]
  }, {
    "tStartMs": 167160,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "And I sent him links to all of the videos, or you know, the videos I was most proud of anyway"
    } ]
  }, {
    "tStartMs": 172880,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "And uh I didn't really expect to hear anything"
    } ]
  }, {
    "tStartMs": 175150,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "but three weeks later I got an email back from him"
    } ]
  }, {
    "tStartMs": 177530,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "and he was like, these are really good why don't you come in and we'll have a chat"
    } ]
  }, {
    "tStartMs": 181240,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and I think the key to that interaction was"
    } ]
  }, {
    "tStartMs": 183440,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "I had stuff to show him"
    } ]
  }, {
    "tStartMs": 186010,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "I didn't go to him and say, \"Hey I'd love to be involved in your TV program.\""
    } ]
  }, {
    "tStartMs": 190200,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "you know what can I do for you? What do you need done? You know?"
    } ]
  }, {
    "tStartMs": 192990,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "I came to him and I said that's what I'm capable of"
    } ]
  }, {
    "tStartMs": 196010,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "and if if that's of interest to you, then great"
    } ]
  }, {
    "tStartMs": 200300,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I have literally thousands of penrose tiles"
    } ]
  }, {
    "tStartMs": 203870,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "that I will be sending out, if you want them, I'm giving these away."
    } ]
  }, {
    "tStartMs": 207790,
    "dDurationMs": 7070,
    "segs": [ {
      "utf8": "I will send you 21 kites and then 13 darts of another color"
    } ]
  }, {
    "tStartMs": 220720,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "What has been the hardest part of your Youtube journey?"
    } ]
  }, {
    "tStartMs": 224160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I would say the beginning"
    } ]
  }, {
    "tStartMs": 225900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "You know, everything's like a snowball"
    } ]
  }, {
    "tStartMs": 228600,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It's always hardest to make the snowball when it's small"
    } ]
  }, {
    "tStartMs": 232480,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "and I know that there were a number of times when I thought that I would just quit doing youtube"
    } ]
  }, {
    "tStartMs": 238280,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "because it seemed like I was getting no traction"
    } ]
  }, {
    "tStartMs": 241120,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "I think the other problem with the beginning was, I wasn't very good at Youtube"
    } ]
  }, {
    "tStartMs": 245960,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "I wasn't very good at presenting to a camera"
    } ]
  }, {
    "tStartMs": 248730,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "I wasn't very good at picking topics"
    } ]
  }, {
    "tStartMs": 250780,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Most people know how to tell apart a"
    } ]
  }, {
    "tStartMs": 253200,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "。。。"
    } ]
  }, {
    "tStartMs": 253960,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "a hard-boiled egg from a raw egg"
    } ]
  }, {
    "tStartMs": 256580,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "。。。"
    } ]
  }, {
    "tStartMs": 257460,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "Well you're gonna find out pretty quick if you uh if you break the shell"
    } ]
  }, {
    "tStartMs": 262230,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "I've said it before and I'll say it again"
    } ]
  }, {
    "tStartMs": 264650,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "I think I was lucky not to know how bad I was"
    } ]
  }, {
    "tStartMs": 267390,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "because otherwise I really would have stopped in the early days"
    } ]
  }, {
    "tStartMs": 272820,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "I am giving away these Ames windows"
    } ]
  }, {
    "tStartMs": 275680,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "All lovingly handcrafted by me"
    } ]
  }, {
    "tStartMs": 278460,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "painstakingly over hours and hours colored in beautiful"
    } ]
  }, {
    "tStartMs": 282050,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "gopro hero4"
    } ]
  }, {
    "tStartMs": 283960,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "still works a little old"
    } ]
  }, {
    "tStartMs": 290460,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Do your kids watch your videos?"
    } ]
  }, {
    "tStartMs": 292690,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "Some of them"
    } ]
  }, {
    "tStartMs": 293820,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "uh their favorites are the one where"
    } ]
  }, {
    "tStartMs": 295360,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "daddy quote \"blasts off into space\""
    } ]
  }, {
    "tStartMs": 297850,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and also the one where the meteor hits the earth"
    } ]
  }, {
    "tStartMs": 302360,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "I actually feel like the kids are a good barometer of what's gonna be successful"
    } ]
  }, {
    "tStartMs": 307320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It's like if it appeals to their two and four-year-old brains"
    } ]
  }, {
    "tStartMs": 310170,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "then it will appeal to all of us in some way"
    } ]
  }, {
    "tStartMs": 313620,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "I'm giving away these astronaut shoes which are size 8 US or 41 in Europe"
    } ]
  }, {
    "tStartMs": 319720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the salt lamp from negative ions"
    } ]
  }, {
    "tStartMs": 322210,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "these platonic solids there should be five of them"
    } ]
  }, {
    "tStartMs": 324770,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "What was the most humbling response you got from the audience and for which video?"
    } ]
  }, {
    "tStartMs": 331130,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "uh depends on what you mean by humbling"
    } ]
  }, {
    "tStartMs": 333240,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "In like Brady Haran has ruined this word for me"
    } ]
  }, {
    "tStartMs": 336760,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "but if you mean like the most overwhelming positive response that I've gotten"
    } ]
  }, {
    "tStartMs": 342240,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "You know, I would say I did this video on the bullet block years ago"
    } ]
  }, {
    "tStartMs": 345960,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and there were over a hundred video responses"
    } ]
  }, {
    "tStartMs": 349800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which just totally blew me away"
    } ]
  }, {
    "tStartMs": 352290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the one-way speed of light video"
    } ]
  }, {
    "tStartMs": 354450,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "got a huge response from people"
    } ]
  }, {
    "tStartMs": 356640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "there's over 50,000 comments on that video"
    } ]
  }, {
    "tStartMs": 359920,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "not to mention the hundreds of emails I received and the tweets"
    } ]
  }, {
    "tStartMs": 364560,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "and it's incredible to have hundreds and thousands of people thinking about science"
    } ]
  }, {
    "tStartMs": 371120,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "and the fundamental way that the universe works"
    } ]
  }, {
    "tStartMs": 375570,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "I am delighted that you guys are with me"
    } ]
  }, {
    "tStartMs": 381260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "What do you do apart from Youtube?"
    } ]
  }, {
    "tStartMs": 384200,
    "dDurationMs": 9440,
    "segs": [ {
      "utf8": "Well, I have three kids and they take up most of the time outside of when I'm doing Youtube videos"
    } ]
  }, {
    "tStartMs": 393640,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "so that's it I'm a Youtuber and a dad"
    } ]
  }, {
    "tStartMs": 397180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Which is pretty great"
    } ]
  }, {
    "tStartMs": 399250,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "I love going to the beach"
    } ]
  }, {
    "tStartMs": 400500,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "I love hiking up the hill, I love riding our bikes"
    } ]
  }, {
    "tStartMs": 403210,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "I'm a pretty simple guy"
    } ]
  }, {
    "tStartMs": 404460,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and 2020 has made things even simpler"
    } ]
  }, {
    "tStartMs": 407580,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "because there was really nothing we could do"
    } ]
  }, {
    "tStartMs": 409360,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "the last shade balls"
    } ]
  }, {
    "tStartMs": 413320,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "All right. What would you say was the hardest part of your PhD?"
    } ]
  }, {
    "tStartMs": 417440,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Okay so the hardest part of a PhD is that it's this research degree, right?"
    } ]
  }, {
    "tStartMs": 422360,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Which maybe is stating the obvious"
    } ]
  }, {
    "tStartMs": 423890,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "when I got into it I remember"
    } ]
  }, {
    "tStartMs": 425680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "talking to someone who had recently finished their PhD and she told me"
    } ]
  }, {
    "tStartMs": 428880,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "a PhD is a dark time in most people's lives"
    } ]
  }, {
    "tStartMs": 432840,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and I was like,"
    } ]
  }, {
    "tStartMs": 434370,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "what did I get myself into"
    } ]
  }, {
    "tStartMs": 436890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but I realized what she meant"
    } ]
  }, {
    "tStartMs": 438300,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "because for three or four years I was kind of on this roller coaster"
    } ]
  }, {
    "tStartMs": 444060,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "the problem with research is you never quite know what you're doing"
    } ]
  }, {
    "tStartMs": 447160,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "that's the point of research and you never quite know what you're gonna find"
    } ]
  }, {
    "tStartMs": 450780,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "so there's a big risk that it's all gonna be worthless"
    } ]
  }, {
    "tStartMs": 455200,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "that you're gonna spend six months or a year or many years depending on your field"
    } ]
  }, {
    "tStartMs": 459640,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "working on something and only to find out that it didn't work"
    } ]
  }, {
    "tStartMs": 463280,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "or it's not gonna happen"
    } ]
  }, {
    "tStartMs": 465010,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and for me that is a very hard thing to do"
    } ]
  }, {
    "tStartMs": 469330,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I feel like my personality is not built for that kind of research"
    } ]
  }, {
    "tStartMs": 472900,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "because I need sort of to regularly achieve things"
    } ]
  }, {
    "tStartMs": 476240,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "and to feel like i'm doing practical things"
    } ]
  }, {
    "tStartMs": 478210,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and having a practical impact on the world"
    } ]
  }, {
    "tStartMs": 480690,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "what was the best part of it?"
    } ]
  }, {
    "tStartMs": 482160,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "getting to meet lots of academics and talk to different people"
    } ]
  }, {
    "tStartMs": 486120,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "My thesis supervisor Manjula Sharma was fantastic"
    } ]
  }, {
    "tStartMs": 489620,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "and I learned a ton about academia, and about research, and about writing"
    } ]
  }, {
    "tStartMs": 495580,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "it was a real nice shift for me to go into a PhD"
    } ]
  }, {
    "tStartMs": 499250,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "that was not solely focused on math you know coming out of engineering physics"
    } ]
  }, {
    "tStartMs": 503000,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "it was nice to be focused on something that involved words and writing and reading"
    } ]
  }, {
    "tStartMs": 507420,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "and I realized, oh that whole area of life has been kind of shut off to me"
    } ]
  }, {
    "tStartMs": 511880,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "as an engineering student, so that was a nice transition"
    } ]
  }, {
    "tStartMs": 515040,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "What was the most unexpected part of it?"
    } ]
  }, {
    "tStartMs": 518410,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "well I gotta say that was having more people than just my thesis reviewers"
    } ]
  }, {
    "tStartMs": 522530,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "which are three people read my thesis"
    } ]
  }, {
    "tStartMs": 524800,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and the reason for it was, I went out and made videos"
    } ]
  }, {
    "tStartMs": 528800,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "You know, about my PhD research"
    } ]
  }, {
    "tStartMs": 531660,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and uh it's funny that a Youtube video"
    } ]
  }, {
    "tStartMs": 534340,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "is the thing that these days can get your thesis or your papers more citations and better read"
    } ]
  }, {
    "tStartMs": 540300,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "In 2010 I made this short video for tedx in Sydney"
    } ]
  }, {
    "tStartMs": 545560,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "and I initially shot it like talking to camera"
    } ]
  }, {
    "tStartMs": 549330,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "and when I got home all the footage was corrupted and I couldn't use it"
    } ]
  }, {
    "tStartMs": 552260,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "it was the night before the submission deadline"
    } ]
  }, {
    "tStartMs": 554690,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "and so I drew stick figures in paint"
    } ]
  }, {
    "tStartMs": 558100,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "ask almost anyone about physics"
    } ]
  }, {
    "tStartMs": 560010,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and chances are they will tell you they don't like it, don't get it, or it's just not their thing"
    } ]
  }, {
    "tStartMs": 564810,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "and I feel like that's still one of my the best things that I've done"
    } ]
  }, {
    "tStartMs": 569400,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Which is like, there are tons of times when it seems like you should be discouraged and throw in the towel"
    } ]
  }, {
    "tStartMs": 574180,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "but I did not"
    } ]
  }, {
    "tStartMs": 575060,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "I just made do with the crappy tools that I had"
    } ]
  }, {
    "tStartMs": 578820,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "and frankly I think the video was better with the stupid stick figures than it would have been with a talking head"
    } ]
  }, {
    "tStartMs": 587410,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Okay the garage gets full of.. stuff"
    } ]
  }, {
    "tStartMs": 591930,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "these are boxes of the Snatoms expansion kit"
    } ]
  }, {
    "tStartMs": 596690,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and I want to sign them and send them out to teachers"
    } ]
  }, {
    "tStartMs": 600090,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "so teachers use your school emails uh in the form"
    } ]
  }, {
    "tStartMs": 604540,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and  will send you one of these if you're lucky"
    } ]
  }, {
    "tStartMs": 608290,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "okay lightning round why does Veritasium have 42 mass number"
    } ]
  }, {
    "tStartMs": 612240,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "because that's the answer to the ultimate question of life the universe and everything from the hitchhiker's guide to the galaxy"
    } ]
  }, {
    "tStartMs": 617610,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "How are you doing?"
    } ]
  }, {
    "tStartMs": 618680,
    "dDurationMs": 490,
    "segs": [ {
      "utf8": "well"
    } ]
  }, {
    "tStartMs": 619170,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "What's your favorite ice cream flavor?"
    } ]
  }, {
    "tStartMs": 620770,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "pistachio or rocky road"
    } ]
  }, {
    "tStartMs": 622610,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Do you truly love turbulent flow or do you just fake it for the internet?"
    } ]
  }, {
    "tStartMs": 626120,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "。。。"
    } ]
  }, {
    "tStartMs": 627280,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Merch?"
    } ]
  }, {
    "tStartMs": 628000,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "I don't have any"
    } ]
  }, {
    "tStartMs": 628940,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Would you like some?"
    } ]
  }, {
    "tStartMs": 629740,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "some did you learn any Portuguese with your wife?"
    } ]
  }, {
    "tStartMs": 631890,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "um bocadinho"
    } ]
  }, {
    "tStartMs": 633220,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "She hates the way I say \"bacalhau\""
    } ]
  }, {
    "tStartMs": 635130,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I find it impossible"
    } ]
  }, {
    "tStartMs": 636530,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Science or maths?"
    } ]
  }, {
    "tStartMs": 638250,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "science"
    } ]
  }, {
    "tStartMs": 638840,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Do you miss Canada?"
    } ]
  }, {
    "tStartMs": 640130,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Yes. Today especially"
    } ]
  }, {
    "tStartMs": 642460,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Favorite shrek character?"
    } ]
  }, {
    "tStartMs": 643980,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "Shrek"
    } ]
  }, {
    "tStartMs": 644490,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Is a hot dog a sandwich?"
    } ]
  }, {
    "tStartMs": 645690,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "。。。"
    } ]
  }, {
    "tStartMs": 646780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "How much do you love science?"
    } ]
  }, {
    "tStartMs": 648460,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "to the moon and back"
    } ]
  }, {
    "tStartMs": 649440,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "How many hours of sleep do you get"
    } ]
  }, {
    "tStartMs": 651340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Not enough. Not.. Enough"
    } ]
  }, {
    "tStartMs": 653530,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If not youtube, what would you be today?"
    } ]
  }, {
    "tStartMs": 655930,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "I think probably a teacher of some sort, maybe a professor"
    } ]
  }, {
    "tStartMs": 660980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "How big is your team?"
    } ]
  }, {
    "tStartMs": 662700,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "because the production value of your videos has been so awesome these days"
    } ]
  }, {
    "tStartMs": 666900,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "well thank you for noticing"
    } ]
  }, {
    "tStartMs": 668370,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and yes there has been a team being built"
    } ]
  }, {
    "tStartMs": 670690,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "Johnny Hyman who can animate edit write music, write programs"
    } ]
  }, {
    "tStartMs": 676820,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "He's also working on a channel of his own called verse you should check it out"
    } ]
  }, {
    "tStartMs": 680290,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "My wife Raquel is frequently behind the camera"
    } ]
  }, {
    "tStartMs": 683260,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I'm so incredibly appreciative of that"
    } ]
  }, {
    "tStartMs": 686300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "thank you thank you thank you"
    } ]
  }, {
    "tStartMs": 687600,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "Yvonne Tello is my animator"
    } ]
  }, {
    "tStartMs": 690050,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "He's been doing lots of great work in all sorts of different styles"
    } ]
  }, {
    "tStartMs": 693240,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Peter Lebedev who's been helping me with research and writing"
    } ]
  }, {
    "tStartMs": 696320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and doing everything that possibly needs doing"
    } ]
  }, {
    "tStartMs": 699140,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "My former professor of general relativity at the university of Sydney"
    } ]
  }, {
    "tStartMs": 702570,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "Grant Lewis has been an advisor on many of these videos"
    } ]
  }, {
    "tStartMs": 706040,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "a huge thank you to Alice"
    } ]
  }, {
    "tStartMs": 707540,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "for managing everything that's happening in Chinese Veritasium"
    } ]
  }, {
    "tStartMs": 711250,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "There's Veritasium dubbed in spanish"
    } ]
  }, {
    "tStartMs": 713920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "in arabic, in russian,"
    } ]
  }, {
    "tStartMs": 715920,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "We're working on a Veritasium hindi"
    } ]
  }, {
    "tStartMs": 718120,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "and I gotta say paying people would not really be possible without the sponsors"
    } ]
  }, {
    "tStartMs": 722580,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "so I gotta say thank you for being okay with it,"
    } ]
  }, {
    "tStartMs": 724970,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "because that's what allowed me to have a rocket built"
    } ]
  }, {
    "tStartMs": 727570,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or build an eight foot tall optical illusion"
    } ]
  }, {
    "tStartMs": 730930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "those are things I just never would have dreamed of doing in the past"
    } ]
  }, {
    "tStartMs": 733450,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "because my investment in every video was essentially only my time"
    } ]
  }, {
    "tStartMs": 738080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "and now I feel like I can try lots of different things"
    } ]
  }, {
    "tStartMs": 741600,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "so this is a q\u0026a video but the final q is for you"
    } ]
  }, {
    "tStartMs": 746010,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "Which is, what do you want to see more of on this channel in 2021 and in the future?"
    } ]
  }, {
    "tStartMs": 752090,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "What have you enjoyed the most in the past?"
    } ]
  }, {
    "tStartMs": 754520,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "I just want to know what I can do for you"
    } ]
  }, {
    "tStartMs": 757170,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "what is the thing that really adds the most value to your life"
    } ]
  }, {
    "tStartMs": 760380,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "uh that's it for me"
    } ]
  }, {
    "tStartMs": 762930,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "I guess, thank you seriously thank you"
    } ]
  } ]
}
