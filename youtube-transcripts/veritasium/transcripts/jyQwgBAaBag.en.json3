  }, {
    "tStartMs": 682221,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "It starts to roll forwards a little bit."
    } ]
  }, {
    "tStartMs": 685280,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Now that causes the wheels to turn\nand they're geared to the propeller"
    } ]
  }, {
    "tStartMs": 690201,
    "dDurationMs": 4439,
    "segs": [ {
      "utf8": "in such a way that they turn it opposite\nthe direction the wind is pushing it."
    } ]
  }, {
    "tStartMs": 694850,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So rather than this propeller\noperating like a windmill,"
    } ]
  }, {
    "tStartMs": 698600,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "it spins like a fan pushing air backwards."
    } ]
  }, {
    "tStartMs": 702440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And that's what drives the craft forwards."
    } ]
  }, {
    "tStartMs": 709071,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "So like one of those crazy things\nyou never think you're going to do,"
    } ]
  }, {
    "tStartMs": 711800,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "be out in a dry bed with some crazy\npropeller vehicle that some physics"
