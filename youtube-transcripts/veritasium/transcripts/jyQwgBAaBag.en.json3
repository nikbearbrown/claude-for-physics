  }, {
    "tStartMs": 894530,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "but you just got to manage your limit."
    } ]
  }, {
    "tStartMs": 896330,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "How much faster than the wind do you\nthink you need to go? Yeah. -You doing it?"
    } ]
  }, {
    "tStartMs": 901550,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Man, It feels like just the\nstakes keep getting higher."
    } ]
  }, {
    "tStartMs": 906110,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Like they didn't want me to run\nit before 'cause it was too windy."
    } ]
  }, {
    "tStartMs": 909800,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "But like now it's windier, but they're\ncomfortable with me piloting it. So"
