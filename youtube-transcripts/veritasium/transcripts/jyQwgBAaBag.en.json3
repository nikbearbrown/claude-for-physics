  }, {
    "tStartMs": 834840,
    "dDurationMs": 241,
    "segs": [ {
      "utf8": "Uh,"
    } ]
  }, {
    "tStartMs": 835081,
    "dDurationMs": 4169,
    "segs": [ {
      "utf8": "what's happening is they're getting\npretty uncomfortable with what they saw in"
