  }, {
    "tStartMs": 716501,
    "dDurationMs": 3059,
    "segs": [ {
      "utf8": "professors believe break the laws\nof science. Yeah. That's cool."
    } ]
  }, {
    "tStartMs": 726870,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Derek, ready to rock.? If you\nthink so, I'm ready. All right."
