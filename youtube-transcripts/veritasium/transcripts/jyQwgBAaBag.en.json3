    "segs": [ {
      "utf8": "now."
    } ]
  }, {
    "tStartMs": 876900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "In Rick's run, it didn't\nseem to shake very much."
    } ]
  }, {
    "tStartMs": 878911,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "So they think it's safe\nfor me to jump in. You"
