{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "In 2014, the qualifying\nexam for the US Physics Team"
    } ]
  }, {
    "tStartMs": 4050,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "had this as question 19:"
    } ]
  }, {
    "tStartMs": 6800,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "A helicopter is flying\nhorizontally at constant speed."
    } ]
  }, {
    "tStartMs": 10440,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "A perfectly flexible\nuniform cable is suspended"
    } ]
  }, {
    "tStartMs": 12990,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "beneath the helicopter."
    } ]
  }, {
    "tStartMs": 14630,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Air friction on the\ncable is not negligible."
    } ]
  }, {
    "tStartMs": 17950,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "So, which of the following diagrams"
    } ]
  }, {
    "tStartMs": 19380,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "best shows the shape of the cable"
    } ]
  }, {
    "tStartMs": 21310,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "as the helicopter flies\nthrough the air to the right?"
    } ]
  }, {
    "tStartMs": 24360,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "Is it A. hanging straight down."
    } ]
  }, {
    "tStartMs": 26721,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "B, hanging diagonally to the left?"
    } ]
  }, {
    "tStartMs": 29480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "C, this hook shape."
    } ]
  }, {
    "tStartMs": 31800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "D, the inverted hook shape,"
    } ]
  }, {
    "tStartMs": 34300,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "or E, a kind of S bend."
    } ]
  }, {
    "tStartMs": 37640,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Now, apparently there's been a\ncertain amount of controversy"
    } ]
  }, {
    "tStartMs": 39810,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "about the correct answer to this question."
    } ]
  }, {
    "tStartMs": 41620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, today we're gonna go\nup in this helicopter,"
    } ]
  }, {
    "tStartMs": 44620,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "and put this question to\nrest once and for all."
    } ]
  }, {
    "tStartMs": 49260,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "Let's go."
    } ]
  }, {
    "tStartMs": 50313,
    "dDurationMs": 4217,
    "segs": [ {
      "utf8": "(intense music)\n(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 54530,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "A portion of this video was\nsponsored by SimpliSafe,"
    } ]
  }, {
    "tStartMs": 56900,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which allowed us to rent this helicopter."
    } ]
  }, {
    "tStartMs": 59120,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 62100,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "I've got several thousand\nhours of carrying sling loads,"
    } ]
  }, {
    "tStartMs": 65150,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "fire buckets, concrete buckets,"
    } ]
  }, {
    "tStartMs": 66990,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "doing power line construction,\nactual power poles."
    } ]
  }, {
    "tStartMs": 70130,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "You name it, anything\nthat needs to be moved"
    } ]
  }, {
    "tStartMs": 72020,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "around the mountains, I've done."
    } ]
  }, {
    "tStartMs": 73410,
    "dDurationMs": 1007,
    "segs": [ {
      "utf8": "Biggest concern that I have is"
    } ]
  }, {
    "tStartMs": 74417,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "that the rope's gonna\ninteract with the rotor wash"
    } ]
  }, {
    "tStartMs": 78200,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "as its interaction with the\nambient air around the aircraft."
    } ]
  }, {
    "tStartMs": 81570,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "And we'll get a whipping\naction that falls down the rope"
    } ]
  }, {
    "tStartMs": 85270,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and flips around on the end."
    } ]
  }, {
    "tStartMs": 86970,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "To a point that we worry\nif it will have a tendency"
    } ]
  }, {
    "tStartMs": 90070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to work its way back up\ntowards the aircraft."
    } ]
  }, {
    "tStartMs": 92440,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Obviously, we don't want\nit getting in the rotors"
    } ]
  }, {
    "tStartMs": 94820,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "or the tail rotor."
    } ]
  }, {
    "tStartMs": 96000,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 98540,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "- [Derek] Alright, we're all set."
    } ]
  }, {
    "tStartMs": 101216,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Movin' up."
    } ]
  }, {
    "tStartMs": 102940,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 110096,
    "dDurationMs": 1484,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 111580,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Here I'm deploying a battle rope,"
    } ]
  }, {
    "tStartMs": 113890,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "like you'd see at the gym."
    } ]
  }, {
    "tStartMs": 115660,
    "dDurationMs": 4292,
    "segs": [ {
      "utf8": "This one is about 15 meters\nlong and it weighs 20 kilograms."
    } ]
  }, {
    "tStartMs": 119952,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "- [Craig] See, the\nwhipping action's begun."
    } ]
  }, {
    "tStartMs": 121494,
    "dDurationMs": 1583,
    "segs": [ {
      "utf8": "- [Derek] I see it."
    } ]
  }, {
    "tStartMs": 124231,
    "dDurationMs": 1989,
    "segs": [ {
      "utf8": "So, if we go really\nslow, will we avoid that?"
    } ]
  }, {
    "tStartMs": 126220,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "- We'll see."
    } ]
  }, {
    "tStartMs": 127290,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "We'll see where the rotor wash"
    } ]
  }, {
    "tStartMs": 128900,
    "dDurationMs": 1787,
    "segs": [ {
      "utf8": "stops interacting with the rope"
    } ]
  }, {
    "tStartMs": 130687,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "and the ambient wind."
    } ]
  }, {
    "tStartMs": 134133,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Now the setup looks pretty simple,"
    } ]
  }, {
    "tStartMs": 135400,
    "dDurationMs": 3595,
    "segs": [ {
      "utf8": "but few people agree on what\nthe right answer should be."
    } ]
  }, {
    "tStartMs": 138995,
    "dDurationMs": 1295,
    "segs": [ {
      "utf8": "(peaceful music)"
    } ]
  }, {
    "tStartMs": 140290,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "When I polled YouTube, the\nmost common answer was C."
    } ]
  }, {
    "tStartMs": 146840,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "Well done on making that\nbeautiful bell curve by the way."
    } ]
  }, {
    "tStartMs": 149850,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We got in touch with\nthe question's author,"
    } ]
  }, {
    "tStartMs": 152250,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "professor Paul Stanley."
    } ]
  }, {
    "tStartMs": 153880,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "There was some creative students\nwho actually constructed"
    } ]
  }, {
    "tStartMs": 157580,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "their own homemade scenarios."
    } ]
  }, {
    "tStartMs": 160200,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "One had a fan to the side and\nanother fan blowing downward"
    } ]
  }, {
    "tStartMs": 166720,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "so that they could mimic\nthe motion of the helicopter"
    } ]
  }, {
    "tStartMs": 169170,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "and suspended a string and\nsaid, \"Oh, it's this design.\""
    } ]
  }, {
    "tStartMs": 172520,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "And the faculty members\nlooked at it and said,"
    } ]
  }, {
    "tStartMs": 174507,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "\"Oh, obviously I can prove that\nthe answer is this answer.\""
    } ]
  }, {
    "tStartMs": 180970,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "They just didn't agree with each other."
    } ]
  }, {
    "tStartMs": 182840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- If we approximated as\na chain of rigid links"
    } ]
  }, {
    "tStartMs": 185160,
    "dDurationMs": 1352,
    "segs": [ {
      "utf8": "- I don't think you can just do that."
    } ]
  }, {
    "tStartMs": 186512,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What do you think?"
    } ]
  }, {
    "tStartMs": 187345,
    "dDurationMs": 2075,
    "segs": [ {
      "utf8": "- I think you're more likely to be C."
    } ]
  }, {
    "tStartMs": 189420,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "- I think it is D."
    } ]
  }, {
    "tStartMs": 192550,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- D."
    } ]
  }, {
    "tStartMs": 193383,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- My guess is B."
    } ]
  }, {
    "tStartMs": 194216,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What do you think?\n- B."
    } ]
  }, {
    "tStartMs": 195049,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- B?"
    } ]
  }, {
    "tStartMs": 195882,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Imma go with A."
    } ]
  }, {
    "tStartMs": 196715,
    "dDurationMs": 2408,
    "segs": [ {
      "utf8": "- Interestingly, no one chose E."
    } ]
  }, {
    "tStartMs": 200980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Have you locked in your prediction?"
    } ]
  }, {
    "tStartMs": 203230,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 206130,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "To make sure the rope doesn't come up"
    } ]
  }, {
    "tStartMs": 207720,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "into the rotors of the helicopter,"
    } ]
  }, {
    "tStartMs": 209370,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "pilot Craig wanted to keep\nthe rope on our right side"
    } ]
  }, {
    "tStartMs": 212940,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "so he could keep an eye on it."
    } ]
  }, {
    "tStartMs": 216390,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Looks pretty good."
    } ]
  }, {
    "tStartMs": 217650,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "- I'm trying to make it look good."
    } ]
  }, {
    "tStartMs": 218853,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "I mean I'm really working on it."
    } ]
  }, {
    "tStartMs": 220892,
    "dDurationMs": 1518,
    "segs": [ {
      "utf8": "- You're working hard."
    } ]
  }, {
    "tStartMs": 222410,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "So, we're not going straight forward."
    } ]
  }, {
    "tStartMs": 224910,
    "dDurationMs": 4601,
    "segs": [ {
      "utf8": "We're actually going diagonally\nforward and to the left."
    } ]
  }, {
    "tStartMs": 229511,
    "dDurationMs": 4172,
    "segs": [ {
      "utf8": "(upbeat music)\n(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 233683,
    "dDurationMs": 3027,
    "segs": [ {
      "utf8": "But you can clearly see the\nrope is hanging straight,"
    } ]
  }, {
    "tStartMs": 236710,
    "dDurationMs": 1603,
    "segs": [ {
      "utf8": "diagonally to the left."
    } ]
  }, {
    "tStartMs": 239240,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "That's a pretty good diagonal, man."
    } ]
  }, {
    "tStartMs": 242920,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "So, the correct answer\nto the question is B."
    } ]
  }, {
    "tStartMs": 249017,
    "dDurationMs": 962,
    "segs": [ {
      "utf8": "You wanna pull it in?"
    } ]
  }, {
    "tStartMs": 249979,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "- Up it comes."
    } ]
  }, {
    "tStartMs": 252350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] We're going to\ntry a few more experiments,"
    } ]
  }, {
    "tStartMs": 254480,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "adding a weight to the end of\nthe rope and then a parachute."
    } ]
  }, {
    "tStartMs": 257750,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "But first I want to discuss\nwhy the answer is B."
    } ]
  }, {
    "tStartMs": 261770,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "There are two external\nforces acting on the rope,"
    } ]
  }, {
    "tStartMs": 264750,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "gravity pulling it down and\nair resistance to the left."
    } ]
  }, {
    "tStartMs": 268680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "When flying along at constant speed,"
    } ]
  }, {
    "tStartMs": 270720,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "these forces must be perfectly balanced"
    } ]
  }, {
    "tStartMs": 272970,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "by the tension in the rope."
    } ]
  }, {
    "tStartMs": 275060,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Now, when I set out to do this experiment,"
    } ]
  }, {
    "tStartMs": 277400,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "I wondered if the rope would be affected"
    } ]
  }, {
    "tStartMs": 278970,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "by the air pushed down\nby the helicopters rotor,"
    } ]
  }, {
    "tStartMs": 281960,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "but judging by our results."
    } ]
  }, {
    "tStartMs": 283840,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "This was not the case."
    } ]
  }, {
    "tStartMs": 285350,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "- The rotor wash doesn't extend\ndown below the helicopter,"
    } ]
  }, {
    "tStartMs": 289470,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "all that far. It\ndissipates pretty quickly."
    } ]
  }, {
    "tStartMs": 293700,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "- So, you can consider the\nair resistance on the rope"
    } ]
  }, {
    "tStartMs": 296030,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "as entirely due to its\nmotion through still air."
    } ]
  }, {
    "tStartMs": 300100,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "Imagine dividing the rope\nup into many short sections."
    } ]
  }, {
    "tStartMs": 303810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Each section has the same weight"
    } ]
  }, {
    "tStartMs": 306090,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "and experiences the same\namount of air resistance"
    } ]
  }, {
    "tStartMs": 309110,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "because it has the same\ncross-sectional area."
    } ]
  }, {
    "tStartMs": 310980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And it's moving at the same speed."
    } ]
  }, {
    "tStartMs": 313230,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Now, the tension in\nany section of the rope"
    } ]
  }, {
    "tStartMs": 315640,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "must balance the sum of the air resistance"
    } ]
  }, {
    "tStartMs": 318320,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and weight of all the sections beneath it."
    } ]
  }, {
    "tStartMs": 321480,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So, the tension is zero\nat the bottom of the rope,"
    } ]
  }, {
    "tStartMs": 324720,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "and it increases linearly\nup to a maximum at the top."
    } ]
  }, {
    "tStartMs": 329160,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "You can see the tension is\nsmall at the bottom of the rope,"
    } ]
  }, {
    "tStartMs": 331600,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "and that's why it wiggles around"
    } ]
  }, {
    "tStartMs": 333090,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "while the top is much steadier."
    } ]
  }, {
    "tStartMs": 335360,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Now, although the magnitude\nof tension changes"
    } ]
  }, {
    "tStartMs": 337710,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "throughout the rope,\nit's direction doesn't."
    } ]
  }, {
    "tStartMs": 340650,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And that's because the\nratio of air resistance"
    } ]
  }, {
    "tStartMs": 343380,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "to weight is the same at\nevery point along the rope."
    } ]
  }, {
    "tStartMs": 347680,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "That is why a uniform flexible cable hangs"
    } ]
  }, {
    "tStartMs": 350870,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "in a straight diagonal line\nwhen pulled at constant speed"
    } ]
  }, {
    "tStartMs": 354540,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "by a helicopter."
    } ]
  }, {
    "tStartMs": 356060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "If the helicopter flies faster,"
    } ]
  }, {
    "tStartMs": 357860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the angle of the rope changes,"
    } ]
  }, {
    "tStartMs": 360290,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but it still makes a\ndiagonal straight line"
    } ]
  }, {
    "tStartMs": 362660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "because the ratio of\nair resistance to weight"
    } ]
  }, {
    "tStartMs": 365740,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "is still constant along the\nentire length of the rope."
    } ]
  }, {
    "tStartMs": 370420,
    "dDurationMs": 1757,
    "segs": [ {
      "utf8": "But this got me wondering,"
    } ]
  }, {
    "tStartMs": 372177,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "\"What would happen if we added a weight"
    } ]
  }, {
    "tStartMs": 374970,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "to the end of the rope?\""
    } ]
  }, {
    "tStartMs": 376260,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Here, I have a 20 pound,"
    } ]
  }, {
    "tStartMs": 378450,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "that's an eight or nine kilos kettlebell."
    } ]
  }, {
    "tStartMs": 380470,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "And I want to ask you\nto make a prediction."
    } ]
  }, {
    "tStartMs": 382320,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "What shape do you think\nthe rope will make now?"
    } ]
  }, {
    "tStartMs": 385320,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Will it still be that diagonal,"
    } ]
  }, {
    "tStartMs": 387490,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "or will it be one of\nthe other five options?"
    } ]
  }, {
    "tStartMs": 391330,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "One more question for you."
    } ]
  }, {
    "tStartMs": 392400,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "If we chucked a weight at the bottom,"
    } ]
  }, {
    "tStartMs": 395180,
    "dDurationMs": 1344,
    "segs": [ {
      "utf8": "which shape would it be?"
    } ]
  }, {
    "tStartMs": 396524,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "- Oh.\n- Probably D."
    } ]
  }, {
    "tStartMs": 399140,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- B, or possibly C."
    } ]
  }, {
    "tStartMs": 402350,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "- [Derek] Does that change it?"
    } ]
  }, {
    "tStartMs": 403290,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "- Then I think it would be B."
    } ]
  }, {
    "tStartMs": 404823,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(whimsical music)"
    } ]
  }, {
    "tStartMs": 408600,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "- Easy to do on the ground."
    } ]
  }, {
    "tStartMs": 411822,
    "dDurationMs": 1522,
    "segs": [ {
      "utf8": "(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 413344,
    "dDurationMs": 3056,
    "segs": [ {
      "utf8": "Alright, we're dropping\nthe rope over the side."
    } ]
  }, {
    "tStartMs": 416400,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "This one has 20 pound\nkettlebell off the end of it."
    } ]
  }, {
    "tStartMs": 422860,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "How's that feel when it's dangling?"
    } ]
  }, {
    "tStartMs": 425250,
    "dDurationMs": 2215,
    "segs": [ {
      "utf8": "- No lateral displacement at all."
    } ]
  }, {
    "tStartMs": 427465,
    "dDurationMs": 945,
    "segs": [ {
      "utf8": "- Alright."
    } ]
  }, {
    "tStartMs": 428410,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "- How's your forearms doing?"
    } ]
  }, {
    "tStartMs": 429920,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- I'm feeling good, you know."
    } ]
  }, {
    "tStartMs": 431140,
    "dDurationMs": 3218,
    "segs": [ {
      "utf8": "I feel like this is the\neasy way, obviously."
    } ]
  }, {
    "tStartMs": 434358,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Gonna feel different\nwhen I gotta pull it up."
    } ]
  }, {
    "tStartMs": 437477,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "- Okay, is it down?\n- Yup."
    } ]
  }, {
    "tStartMs": 439100,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Okay, let's give it a shot."
    } ]
  }, {
    "tStartMs": 441180,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "(whimsical music)\n(helicopter blades whirring)"
    } ]
  }, {
    "tStartMs": 443170,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Here the helicopter is flying"
    } ]
  }, {
    "tStartMs": 444570,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "at nearly a hundred kilometers per hour,"
    } ]
  }, {
    "tStartMs": 449160,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "and the rope makes a different shape."
    } ]
  }, {
    "tStartMs": 455370,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "You can clearly see,"
    } ]
  }, {
    "tStartMs": 456480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "it looks like an inverted J."
    } ]
  }, {
    "tStartMs": 459200,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "This is option D."
    } ]
  }, {
    "tStartMs": 461590,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "In fact, this is how the question"
    } ]
  }, {
    "tStartMs": 463350,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "on the qualifying exam originated."
    } ]
  }, {
    "tStartMs": 465641,
    "dDurationMs": 3149,
    "segs": [ {
      "utf8": "- So, I taught for a\nsemester in Hong Kong,"
    } ]
  }, {
    "tStartMs": 468790,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and we'd go hiking in the new territories."
    } ]
  }, {
    "tStartMs": 471610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "One of the times I was hiking,"
    } ]
  }, {
    "tStartMs": 473440,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "I saw a helicopter fly\nwith a cable beneath it."
    } ]
  }, {
    "tStartMs": 476760,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "It was carrying something\nto one of the remote parts"
    } ]
  }, {
    "tStartMs": 479770,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "of the Hong Kong new territories."
    } ]
  }, {
    "tStartMs": 481830,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "And I saw the shape of the\ncable and thought to myself,"
    } ]
  }, {
    "tStartMs": 484667,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "\"That looks a little counter\nintuitive and very neat."
    } ]
  }, {
    "tStartMs": 487820,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "This might make a good\nmultiple choice question"
    } ]
  }, {
    "tStartMs": 490720,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "for the selection exam for the students.\""
    } ]
  }, {
    "tStartMs": 493940,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "The cable that I saw had a\nweight hanging on the end,"
    } ]
  }, {
    "tStartMs": 497290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which gave it a certain curved shape."
    } ]
  }, {
    "tStartMs": 499780,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "When I shared this with the\nother coaches, another coach,"
    } ]
  }, {
    "tStartMs": 502740,
    "dDurationMs": 3017,
    "segs": [ {
      "utf8": "Andrew Linn, looked at it and said,"
    } ]
  }, {
    "tStartMs": 505757,
    "dDurationMs": 3023,
    "segs": [ {
      "utf8": "\"I think the question\nmight even be more fun"
    } ]
  }, {
    "tStartMs": 508780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "if there is no weight on the cable"
    } ]
  }, {
    "tStartMs": 511180,
    "dDurationMs": 3077,
    "segs": [ {
      "utf8": "because that is even harder to imagine.\""
    } ]
  }, {
    "tStartMs": 515240,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Derek] To understand why\nthe rope makes this shape,"
    } ]
  }, {
    "tStartMs": 517550,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "we can use the same analysis as before."
    } ]
  }, {
    "tStartMs": 520440,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "But now we need to add a large weight"
    } ]
  }, {
    "tStartMs": 522890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to the end of the rope."
    } ]
  }, {
    "tStartMs": 524330,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "And this means at the bottom,"
    } ]
  }, {
    "tStartMs": 525810,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "the tension needs to be almost vertical"
    } ]
  }, {
    "tStartMs": 528230,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "to support the weight of the kettlebell,"
    } ]
  }, {
    "tStartMs": 530440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "which has a lot of weight\nbut not much air resistance."
    } ]
  }, {
    "tStartMs": 533880,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "As you go up the rope, the\nratio of total air resistance"
    } ]
  }, {
    "tStartMs": 537830,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to weight for everything\nbeneath increases."
    } ]
  }, {
    "tStartMs": 541750,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "So, the rope turns more horizontal\nin order for the tension"
    } ]
  }, {
    "tStartMs": 545000,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "to balance out that\nincreasing air resistance."
    } ]
  }, {
    "tStartMs": 551163,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- You're more than halfway. You got it."
    } ]
  }, {
    "tStartMs": 554123,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "(woman laughing)"
    } ]
  }, {
    "tStartMs": 555110,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- [Derek] For the final test,"
    } ]
  }, {
    "tStartMs": 556040,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I wanted to add something\nto the bottom of the rope"
    } ]
  }, {
    "tStartMs": 557810,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "that added almost no weight,\nbut significant air resistance."
    } ]
  }, {
    "tStartMs": 561830,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So, I picked a Veritasium flag, of course."
    } ]
  }, {
    "tStartMs": 565400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So, what do you think about hanging this"
    } ]
  }, {
    "tStartMs": 567080,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "at the end of the rope?"
    } ]
  }, {
    "tStartMs": 568260,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Well, it's all science experiment for me"
    } ]
  }, {
    "tStartMs": 570390,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "'cause these are all the\nthings you'd never do"
    } ]
  }, {
    "tStartMs": 572350,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "with a helicopter in a row."
    } ]
  }, {
    "tStartMs": 573650,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "- What would it be the real risks,"
    } ]
  }, {
    "tStartMs": 574720,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "like tail rotor or this rotor, or both?"
    } ]
  }, {
    "tStartMs": 577340,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- Either."
    } ]
  }, {
    "tStartMs": 578260,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Any kind of this getting\ninto the inner tail rotor"
    } ]
  }, {
    "tStartMs": 580850,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "would be destruction to the aircraft."
    } ]
  }, {
    "tStartMs": 583383,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(helicopter blades whirring)\n(intense music)"
    } ]
  }, {
    "tStartMs": 602364,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "And we'll start, here we go."
    } ]
  }, {
    "tStartMs": 611320,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- [Derek] Now the rope still\nseems to be pretty straight."
    } ]
  }, {
    "tStartMs": 613990,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "I think it's because the flag"
    } ]
  }, {
    "tStartMs": 615680,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "isn't actually adding much drag."
    } ]
  }, {
    "tStartMs": 619350,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Still looks pretty crazy, interestingly."
    } ]
  }, {
    "tStartMs": 622350,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "So, we decided to add a small parachute"
    } ]
  }, {
    "tStartMs": 625120,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "to the end of the rope."
    } ]
  }, {
    "tStartMs": 626630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "All right, let's try it."
    } ]
  }, {
    "tStartMs": 628610,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "The concern here was that the parachute"
    } ]
  }, {
    "tStartMs": 630460,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "could get flipped up into\nthe rotors during deployment."
    } ]
  }, {
    "tStartMs": 633210,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "So, we bundled the shoot\nup into a backpack."
    } ]
  }, {
    "tStartMs": 638038,
    "dDurationMs": 3345,
    "segs": [ {
      "utf8": "- [Craig] Very nicely done."
    } ]
  }, {
    "tStartMs": 641383,
    "dDurationMs": 1695,
    "segs": [ {
      "utf8": "- [Derek] Does it deploy more than that?"
    } ]
  }, {
    "tStartMs": 643078,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Craig] No, but once we start moving,"
    } ]
  }, {
    "tStartMs": 644878,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "its gonna grab a lot of air."
    } ]
  }, {
    "tStartMs": 650400,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "- [Derek] Now, with the\nparachute at the end of the rope,"
    } ]
  }, {
    "tStartMs": 652610,
    "dDurationMs": 3283,
    "segs": [ {
      "utf8": "it makes a J shape, which is answer C."
    } ]
  }, {
    "tStartMs": 656940,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "With extra air resistance\nat the end of the rope,"
    } ]
  }, {
    "tStartMs": 659530,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "but not much weight,"
    } ]
  }, {
    "tStartMs": 660730,
    "dDurationMs": 2897,
    "segs": [ {
      "utf8": "the tension has to be\nvirtually horizontal."
    } ]
  }, {
    "tStartMs": 663627,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "And then as you go up the rope,"
    } ]
  }, {
    "tStartMs": 665820,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "the ratio of total air\nresistance to weight"
    } ]
  }, {
    "tStartMs": 668510,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for everything beneath decreases."
    } ]
  }, {
    "tStartMs": 670760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So, the rope becomes more vertical"
    } ]
  }, {
    "tStartMs": 672890,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to balance out the increasing weight."
    } ]
  }, {
    "tStartMs": 675860,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "So, depending on what's\non the end of the rope,"
    } ]
  }, {
    "tStartMs": 677670,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "you could get answers B, C or D."
    } ]
  }, {
    "tStartMs": 681550,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Now, if you enjoyed this video,"
    } ]
  }, {
    "tStartMs": 683000,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "I bet you would also like my\nbullet block experiment series."
    } ]
  }, {
    "tStartMs": 686420,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "So, check it out."
    } ]
  }, {
    "tStartMs": 690350,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "(retro beeping sound effect)"
    } ]
  }, {
    "tStartMs": 694930,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "Now, hanging out the side of a helicopter"
    } ]
  }, {
    "tStartMs": 696620,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "was not my safest moment,"
    } ]
  }, {
    "tStartMs": 698870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but I do always feel safe here at home."
    } ]
  }, {
    "tStartMs": 701060,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Thanks to SimpliSafe, the\nsponsor of this portion"
    } ]
  }, {
    "tStartMs": 703420,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of the video."
    } ]
  }, {
    "tStartMs": 704253,
    "dDurationMs": 1707,
    "segs": [ {
      "utf8": "SimpliSafe is an easy to use,"
    } ]
  }, {
    "tStartMs": 705960,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "totally customizable home security system."
    } ]
  }, {
    "tStartMs": 708650,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "They allow you to design a\nset up to fit your space,"
    } ]
  }, {
    "tStartMs": 711210,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and they ship it directly\nto your doorstep."
    } ]
  }, {
    "tStartMs": 713410,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Then their interactive\nmonitoring service ensures"
    } ]
  }, {
    "tStartMs": 715890,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "that your home is\nprofessionally monitored 24/7."
    } ]
  }, {
    "tStartMs": 718970,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "You know, I started thinking\nseriously about home security"
    } ]
  }, {
    "tStartMs": 721430,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "when there was a police\nhelicopter circling overhead"
    } ]
  }, {
    "tStartMs": 724000,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "one day, and it was\nnot dangling any ropes."
    } ]
  }, {
    "tStartMs": 726780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It turned out the house across the street"
    } ]
  }, {
    "tStartMs": 728820,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "had been broken into."
    } ]
  }, {
    "tStartMs": 730090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Luckily, SimpliSafe makes it\neasy to protect your home."
    } ]
  }, {
    "tStartMs": 732880,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "They sent me a kit that took\nonly about an hour to set up."
    } ]
  }, {
    "tStartMs": 736120,
    "dDurationMs": 2110,
    "segs": [ {
