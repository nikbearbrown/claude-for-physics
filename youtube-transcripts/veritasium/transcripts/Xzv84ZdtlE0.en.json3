{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 240,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "J. Robert Oppenheimer"
    } ]
  }, {
    "tStartMs": 1560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "might be the most important physicist"
    } ]
  }, {
    "tStartMs": 3840,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to have ever lived."
    } ]
  }, {
    "tStartMs": 5400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "He never won a Nobel Prize,"
    } ]
  }, {
    "tStartMs": 7260,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "but he changed the world more\nthan most Nobel Prize winners."
    } ]
  }, {
    "tStartMs": 11460,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Under his leadership,"
    } ]
  }, {
    "tStartMs": 12630,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the best physicists of the 20th century"
    } ]
  }, {
    "tStartMs": 15360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "built the atomic bomb"
    } ]
  }, {
    "tStartMs": 17400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "forever changing the course of history."
    } ]
  }, {
    "tStartMs": 20220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- If there is another world war,"
    } ]
  }, {
    "tStartMs": 22860,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "this civilization may go under."
    } ]
  }, {
    "tStartMs": 26430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] He has affected every war waged"
    } ]
  }, {
    "tStartMs": 28860,
    "dDurationMs": 3307,
    "segs": [ {
      "utf8": "and every peace settled since\nthe end of World War ii."
    } ]
  }, {
    "tStartMs": 32167,
    "dDurationMs": 4913,
    "segs": [ {
      "utf8": "He also created a way for\nhumanity to destroy itself."
    } ]
  }, {
    "tStartMs": 37080,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "- Now I am become death,"
    } ]
  }, {
    "tStartMs": 39510,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "the destroyer of worlds."
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- [Derek] This video is about\nhow to build an atomic bomb,"
    } ]
  }, {
    "tStartMs": 45060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the life of Oppenheimer,"
    } ]
  }, {
    "tStartMs": 46800,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and why serious scientists were\nworried about the explosion"
    } ]
  }, {
    "tStartMs": 50400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "setting fire to the atmosphere,"
    } ]
  }, {
    "tStartMs": 52800,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "ending all life on earth."
    } ]
  }, {
    "tStartMs": 56520,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "Part of this video is\nbrought to you by Wren."
    } ]
  }, {
    "tStartMs": 61650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "When J. Robert Oppenheimer was 21,"
    } ]
  }, {
    "tStartMs": 64260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "he placed an apple laced\nwith toxic chemicals"
    } ]
  }, {
    "tStartMs": 67320,
    "dDurationMs": 1859,
    "segs": [ {
      "utf8": "on the desk of his physics tutor."
    } ]
  }, {
    "tStartMs": 69179,
    "dDurationMs": 2071,
    "segs": [ {
      "utf8": "The tutor, Patrick Blackett,"
    } ]
  }, {
    "tStartMs": 71250,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "was an experimentalist\nand he had hounded Robert"
    } ]
  }, {
    "tStartMs": 74070,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to do more of what he thought"
    } ]
  }, {
    "tStartMs": 75540,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "Robert wasn't very good\nat, experimental work."
    } ]
  }, {
    "tStartMs": 78584,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "Oppenheimer had already been\nspending his days in a corner"
    } ]
  }, {
    "tStartMs": 81810,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "of JJ Thompson's basement laboratory,"
    } ]
  }, {
    "tStartMs": 84060,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "attempting to make thin\nfilms of beryllium,"
    } ]
  }, {
    "tStartMs": 86460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which were used to study electrons."
    } ]
  }, {
    "tStartMs": 88950,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "But Oppenheimer was clumsy\nand not good at this work."
    } ]
  }, {
    "tStartMs": 93870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "He was soon avoiding\nhis duties in the lab,"
    } ]
  }, {
    "tStartMs": 96240,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "spending his time listening to lectures"
    } ]
  }, {
    "tStartMs": 98100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and reading physics journals."
    } ]
  }, {
    "tStartMs": 99900,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "It was 1925 and the 21 year\nold Oppenheimer was becoming"
    } ]
  }, {
    "tStartMs": 103680,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "fascinated by the new\nfield of quantum mechanics."
    } ]
  }, {
    "tStartMs": 107520,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Despite being surrounded\nby brilliant physicists"
    } ]
  }, {
    "tStartMs": 110550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "like Rutherford and Chadwick,"
    } ]
  }, {
    "tStartMs": 112740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Oppenheimer was deeply unhappy."
    } ]
  }, {
    "tStartMs": 115380,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "He wrote, \"I'm having a pretty bad time."
    } ]
  }, {
    "tStartMs": 118110,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The lab work is a terrible bore,"
    } ]
  }, {
    "tStartMs": 120060,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and I'm so bad at it that\nit's impossible to feel"
    } ]
  }, {
    "tStartMs": 123090,
    "dDurationMs": 1428,
    "segs": [ {
      "utf8": "that I'm learning anything.\""
    } ]
  }, {
    "tStartMs": 124518,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "A friend walked in on him,"
    } ]
  }, {
    "tStartMs": 126060,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "lying on the floor of his room,"
    } ]
  }, {
    "tStartMs": 127500,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which he called \"A miserable hole\","
    } ]
  }, {
    "tStartMs": 130080,
    "dDurationMs": 3845,
    "segs": [ {
      "utf8": "groaning and rolling from side\nto side in emotional anguish."
    } ]
  }, {
    "tStartMs": 133925,
    "dDurationMs": 2695,
    "segs": [ {
      "utf8": "It was in this state that Robert"
    } ]
  }, {
    "tStartMs": 136620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "attempted to poison Blackett."
    } ]
  }, {
    "tStartMs": 139080,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The specifics are lost to history."
    } ]
  }, {
    "tStartMs": 141150,
    "dDurationMs": 2807,
    "segs": [ {
      "utf8": "There are conflicting reports\nif Oppenheimer used cyanide"
    } ]
  }, {
    "tStartMs": 143957,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "or something he found in the lab,"
    } ]
  }, {
    "tStartMs": 146010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which would've just made Blackett sick."
    } ]
  }, {
    "tStartMs": 148590,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "This story sounds unbelievable,"
    } ]
  }, {
    "tStartMs": 150525,
    "dDurationMs": 3072,
    "segs": [ {
      "utf8": "but Oppenheimer himself confirmed it."
    } ]
  }, {
    "tStartMs": 153597,
    "dDurationMs": 2927,
    "segs": [ {
      "utf8": "Luckily, Blackett did not eat the apple,"
    } ]
  }, {
    "tStartMs": 156524,
    "dDurationMs": 2476,
    "segs": [ {
      "utf8": "but the attempted poisoning became known"
    } ]
  }, {
    "tStartMs": 159000,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to the Cambridge University authorities."
    } ]
  }, {
    "tStartMs": 161790,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Robert's parents were visiting their son"
    } ]
  }, {
    "tStartMs": 163440,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "from the US at the time,"
    } ]
  }, {
    "tStartMs": 164610,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and Julius Oppenheimer\nsuccessfully lobbied Cambridge"
    } ]
  }, {
    "tStartMs": 168030,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "not to press criminal charges.\nDue to his family's wealth,"
    } ]
  }, {
    "tStartMs": 171630,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Robert wasn't even expelled from Cambridge"
    } ]
  }, {
    "tStartMs": 173970,
    "dDurationMs": 2529,
    "segs": [ {
      "utf8": "on the condition that he had\nperiodic counseling sessions"
    } ]
  }, {
    "tStartMs": 176499,
    "dDurationMs": 2708,
    "segs": [ {
      "utf8": "with a psychiatrist in London."
    } ]
  }, {
    "tStartMs": 179207,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "(train horn blaring)"
    } ]
  }, {
    "tStartMs": 181260,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "In the summer of 1926,"
    } ]
  }, {
    "tStartMs": 182640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Robert traveled to the\nUniversity of Göttingen."
    } ]
  }, {
    "tStartMs": 185700,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The chairman of the\ndepartment was Max Born,"
    } ]
  }, {
    "tStartMs": 188130,
    "dDurationMs": 3139,
    "segs": [ {
      "utf8": "who just two years earlier\nhad coined the term,"
    } ]
  }, {
    "tStartMs": 191269,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "\"Quantum Mechanics\"."
    } ]
  }, {
    "tStartMs": 193260,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Born was reportedly a\nthoughtful and gentle teacher"
    } ]
  }, {
    "tStartMs": 196440,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and had nurtured the work\nof Werner Heisenberg,"
    } ]
  }, {
    "tStartMs": 198930,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Wolfgang Pauli, Enrico Fermi,"
    } ]
  }, {
    "tStartMs": 201030,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and Eugene Wigner,"
    } ]
  }, {
    "tStartMs": 202290,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "basically the who's who\nof quantum mechanics."
    } ]
  }, {
    "tStartMs": 204678,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "The class that Oppenheimer\nwas in was also extraordinary,"
    } ]
  }, {
    "tStartMs": 208140,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "including luminaries like Paul\nDirac and John Von Neumann,"
    } ]
  }, {
    "tStartMs": 212220,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "where the academic culture\nat Cambridge focused on"
    } ]
  }, {
    "tStartMs": 214130,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "experimental physics."
    } ]
  }, {
    "tStartMs": 216090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Göttingen was all about\ntheoretical physics,"
    } ]
  }, {
    "tStartMs": 218700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and under Max Born's mentorship,"
    } ]
  }, {
    "tStartMs": 221040,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Oppenheimer thrived."
    } ]
  }, {
    "tStartMs": 222660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "His mental health improved,"
    } ]
  }, {
    "tStartMs": 224280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and he found a community\nof people who were"
    } ]
  }, {
    "tStartMs": 226320,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "as obsessed with physics as he was."
    } ]
  }, {
    "tStartMs": 229980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "On November 14th, 1926,"
    } ]
  }, {
    "tStartMs": 232200,
    "dDurationMs": 2396,
    "segs": [ {
      "utf8": "Robert wrote to Frank,\nhis younger brother,"
    } ]
  }, {
    "tStartMs": 234596,
    "dDurationMs": 1924,
    "segs": [ {
      "utf8": "\"You would like Göttingen."
    } ]
  }, {
    "tStartMs": 236520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I find the work hard, thank God,"
    } ]
  }, {
    "tStartMs": 238620,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and almost pleasant.\""
    } ]
  }, {
    "tStartMs": 240690,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Robert was thriving and his\ntalent was being recognized."
    } ]
  }, {
    "tStartMs": 244290,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Born later wrote,"
    } ]
  }, {
    "tStartMs": 245257,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "\"He was a man of great\ntalent and he was conscious"
    } ]
  }, {
    "tStartMs": 248250,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "of his superiority in a\nway which was embarrassing"
    } ]
  }, {
    "tStartMs": 251190,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "and led to trouble.\""
    } ]
  }, {
    "tStartMs": 253200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "When Oppenheimer was 23,"
    } ]
  }, {
    "tStartMs": 254880,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "he graduated with his PhD in physics."
    } ]
  }, {
    "tStartMs": 257430,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "He wrote his thesis in\nGerman on the quantum theory"
    } ]
  }, {
    "tStartMs": 260550,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "of continuous spectra."
    } ]
  }, {
    "tStartMs": 262171,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "All in all,"
    } ]
  }, {
    "tStartMs": 263070,
    "dDurationMs": 1515,
    "segs": [ {
      "utf8": "he published more than a dozen papers"
    } ]
  }, {
    "tStartMs": 264585,
    "dDurationMs": 2298,
    "segs": [ {
      "utf8": "in the two years he was at Göttingen."
    } ]
  }, {
    "tStartMs": 266883,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "Many of them expanded upon\nthe work of Werner Heisenberg,"
    } ]
  }, {
    "tStartMs": 270570,
    "dDurationMs": 2431,
    "segs": [ {
      "utf8": "who was just three years\nolder than Oppenheimer."
    } ]
  }, {
    "tStartMs": 273001,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "The two eventually met in 1927,"
    } ]
  }, {
    "tStartMs": 276240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "the same year Heisenberg\npublished his groundbreaking paper"
    } ]
  }, {
    "tStartMs": 279480,
    "dDurationMs": 2006,
    "segs": [ {
      "utf8": "on the Quantum uncertainty principle."
    } ]
  }, {
    "tStartMs": 281486,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "By all accounts,"
    } ]
  }, {
    "tStartMs": 282840,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "the pair got along well."
    } ]
  }, {
    "tStartMs": 284830,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "There was no way to know\nthat just 15 years later,"
    } ]
  }, {
    "tStartMs": 287730,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "they would be deadly\nrivals attempting to build"
    } ]
  }, {
    "tStartMs": 290850,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "the first nuclear bomb."
    } ]
  }, {
    "tStartMs": 292350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Oppenheimer for the USA"
    } ]
  }, {
    "tStartMs": 294240,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "and Heisenberg for Nazi Germany."
    } ]
  }, {
    "tStartMs": 297226,
    "dDurationMs": 1124,
    "segs": [ {
      "utf8": "At the time,"
    } ]
  }, {
    "tStartMs": 298350,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "it was thought that getting\nsignificant amounts of energy"
    } ]
  }, {
    "tStartMs": 301350,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "out of radioactive atoms was impossible."
    } ]
  }, {
    "tStartMs": 304950,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Ever since the discovery of radioactivity"
    } ]
  }, {
    "tStartMs": 307230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "by Henri Becquerel, Marie Curie,"
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and Pierre Curie in the late 1890s,"
    } ]
  }, {
    "tStartMs": 311550,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "it was known that radioactivity\nwas a passive process."
    } ]
  }, {
    "tStartMs": 315210,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Unstable atoms would just decay at random,"
    } ]
  }, {
    "tStartMs": 317460,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "unpredictable times,"
    } ]
  }, {
    "tStartMs": 319650,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "and surely there was\nno way to control that."
    } ]
  }, {
    "tStartMs": 323200,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "In 1933, Ernest Rutherford,"
    } ]
  }, {
    "tStartMs": 326070,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "Oppenheimer's old boss\nfrom Cambridge wrote that,"
    } ]
  }, {
    "tStartMs": 328927,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "\"Anyone who expects a source of power"
    } ]
  }, {
    "tStartMs": 330750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "from the transformations of these atoms"
    } ]
  }, {
    "tStartMs": 332580,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "is talking moonshine.\""
    } ]
  }, {
    "tStartMs": 334290,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "That same year,"
    } ]
  }, {
    "tStartMs": 335250,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "Albert Einstein said,"
    } ]
  }, {
    "tStartMs": 336277,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "\"That there is not the\nslightest indication"
    } ]
  }, {
    "tStartMs": 338195,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "that nuclear energy\nwill ever be obtainable."
    } ]
  }, {
    "tStartMs": 340729,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "It would mean that the atom"
    } ]
  }, {
    "tStartMs": 342480,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "would have to be shattered at will.\""
    } ]
  }, {
    "tStartMs": 346260,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "So how would you break an atomic nucleus?"
    } ]
  }, {
    "tStartMs": 349183,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "Well, you could take a proton"
    } ]
  }, {
    "tStartMs": 351240,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and accelerate it through\na large electric field"
    } ]
  }, {
    "tStartMs": 353730,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and then smash it into a nucleus."
    } ]
  }, {
    "tStartMs": 356580,
    "dDurationMs": 2037,
    "segs": [ {
      "utf8": "This is exactly what John Cockcroft"
    } ]
  }, {
    "tStartMs": 358617,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "and Ernest Walton did in 1932."
    } ]
  }, {
    "tStartMs": 360930,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "They accelerated protons\ninto lithium nuclei,"
    } ]
  }, {
    "tStartMs": 364560,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "breaking them apart."
    } ]
  }, {
    "tStartMs": 365526,
    "dDurationMs": 3456,
    "segs": [ {
      "utf8": "The pair would later win a\nNobel Prize for this work,"
    } ]
  }, {
    "tStartMs": 368982,
    "dDurationMs": 2808,
    "segs": [ {
      "utf8": "but a proton is positively charged,"
    } ]
  }, {
    "tStartMs": 371790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so it's repelled by all nuclei,"
    } ]
  }, {
    "tStartMs": 374220,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "which are also positively charged."
    } ]
  }, {
    "tStartMs": 376650,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So to give them a hope of\novercoming this barrier,"
    } ]
  }, {
    "tStartMs": 379350,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Cockcroft and Walton\nhad to use 250,000 volts"
    } ]
  }, {
    "tStartMs": 383610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to accelerate the protons."
    } ]
  }, {
    "tStartMs": 385440,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Even then, only about\none in a billion protons"
    } ]
  }, {
    "tStartMs": 388710,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "actually hit and split a lithium nucleus,"
    } ]
  }, {
    "tStartMs": 391920,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "so this would not be an\neffective way to get energy."
    } ]
  }, {
    "tStartMs": 396240,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "But there is another way."
    } ]
  }, {
    "tStartMs": 399660,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "In 1932, the neutron was discovered"
    } ]
  }, {
    "tStartMs": 402720,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "this subatomic particle that's about 0.1%"
    } ]
  }, {
    "tStartMs": 406110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "heavier than a proton,"
    } ]
  }, {
    "tStartMs": 407640,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "and it has no electric charge,"
    } ]
  }, {
    "tStartMs": 409468,
    "dDurationMs": 4292,
    "segs": [ {
      "utf8": "so a neutron would not be\nrepelled from a nucleus."
    } ]
  }, {
    "tStartMs": 413760,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And in 1933,"
    } ]
  }, {
    "tStartMs": 415410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Leo Szilard was thinking about\nhow you could use neutrons"
    } ]
  }, {
    "tStartMs": 418950,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "to split nuclei."
    } ]
  }, {
    "tStartMs": 420757,
    "dDurationMs": 3053,
    "segs": [ {
      "utf8": "\"It suddenly occurred to me\nthat if we could find an element"
    } ]
  }, {
    "tStartMs": 423810,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "which is split by neutrons and\nwhich would emit two neutrons"
    } ]
  }, {
    "tStartMs": 427350,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "when it absorbed one neutron,"
    } ]
  }, {
    "tStartMs": 429120,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "such an element if assembled\nsufficiently large mass,"
    } ]
  }, {
    "tStartMs": 432307,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "could sustain a nuclear chain reaction.\""
    } ]
  }, {
    "tStartMs": 436110,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "But the thing is,"
    } ]
  }, {
    "tStartMs": 437190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "nobody knew if there was an element"
    } ]
  }, {
    "tStartMs": 439380,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "that had a kind of nucleus\nthat would do that."
    } ]
  }, {
    "tStartMs": 444060,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "On the 29th of January, 1939,"
    } ]
  }, {
    "tStartMs": 446550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Louise Alvarez, a\npromising young physicist,"
    } ]
  }, {
    "tStartMs": 448950,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "was getting a haircut while reading"
    } ]
  }, {
    "tStartMs": 450547,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "\"The San Francisco Chronicle\","
    } ]
  }, {
    "tStartMs": 452123,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "and suddenly he got outta the chair"
    } ]
  }, {
    "tStartMs": 454530,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "halfway through the haircut and\nran to Oppenheimer's office."
    } ]
  }, {
    "tStartMs": 458430,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Alvarez read an article about\nhow two German chemists,"
    } ]
  }, {
    "tStartMs": 461430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Otto Hahn and Fritz Strassmann"
    } ]
  }, {
    "tStartMs": 463440,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "had successfully split an atom of uranium"
    } ]
  }, {
    "tStartMs": 466020,
    "dDurationMs": 2306,
    "segs": [ {
      "utf8": "by bombarding it with neutrons."
    } ]
  }, {
    "tStartMs": 468326,
    "dDurationMs": 2651,
    "segs": [ {
      "utf8": "Oppenheimer was not impressed."
    } ]
  }, {
    "tStartMs": 470977,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "\"That's impossible.\""
    } ]
  }, {
    "tStartMs": 472110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "He reportedly told the Young Alvarez"
    } ]
  }, {
    "tStartMs": 474270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "proceeding to mathematically\nprove on his blackboard"
    } ]
  }, {
    "tStartMs": 476820,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "why fission could never be achieved."
    } ]
  }, {
    "tStartMs": 480840,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "But the next day,"
    } ]
  }, {
    "tStartMs": 482100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Alvarez had repeated the experiment"
    } ]
  }, {
    "tStartMs": 484470,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "and invited Oppenheimer to see it."
    } ]
  }, {
    "tStartMs": 486704,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Alvarez later recalled that,"
    } ]
  }, {
    "tStartMs": 488437,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "\"In less than 15 minutes,"
    } ]
  }, {
    "tStartMs": 489887,
    "dDurationMs": 3073,
    "segs": [ {
      "utf8": "he not only agreed that\nthe reaction was authentic,"
    } ]
  }, {
    "tStartMs": 492960,
    "dDurationMs": 2018,
    "segs": [ {
      "utf8": "but also speculated that in the process,"
    } ]
  }, {
    "tStartMs": 494978,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "extra neutrons would boil off."
    } ]
  }, {
    "tStartMs": 497280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "That could be used to\nsplit more uranium atoms"
    } ]
  }, {
    "tStartMs": 499710,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "and thereby generate power or make bombs.\""
    } ]
  }, {
    "tStartMs": 503292,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "When a single atom of\nuranium-235 splits apart,"
    } ]
  }, {
    "tStartMs": 507180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "it loses a little bit of mass,"
    } ]
  }, {
    "tStartMs": 509130,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "which is released as energy."
    } ]
  }, {
    "tStartMs": 511020,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Following Einstein's\nmass energy equivalence."
    } ]
  }, {
    "tStartMs": 513990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "That is a tiny amount of energy,"
    } ]
  }, {
    "tStartMs": 516480,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "about 20 times less\nthan the amount required"
    } ]
  }, {
    "tStartMs": 519330,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to raise a grain of sand,"
    } ]
  }, {
    "tStartMs": 520920,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the thickness of a piece of paper."
    } ]
  }, {
    "tStartMs": 523530,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But atoms are also tiny."
    } ]
  }, {
    "tStartMs": 525510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "In a one kilogram lump of uranium,"
    } ]
  }, {
    "tStartMs": 527550,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "there are about a\ntrillion, trillion atoms,"
    } ]
  }, {
    "tStartMs": 530730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "so the energy quickly adds up."
    } ]
  }, {
    "tStartMs": 533610,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Soon, almost everyone was\nconvinced in August of 1939,"
    } ]
  }, {
    "tStartMs": 537930,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Einstein, who just six years earlier"
    } ]
  }, {
    "tStartMs": 540030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "believed that nuclear\nbombs were impossible,"
    } ]
  }, {
    "tStartMs": 542220,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "signed his name to a letter"
    } ]
  }, {
    "tStartMs": 543780,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "addressed to President Franklin Roosevelt."
    } ]
  }, {
    "tStartMs": 545843,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "The letter actually written\nby Szilard warned Roosevelt"
    } ]
  }, {
    "tStartMs": 549510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of the possibility of nuclear weapons."
    } ]
  }, {
    "tStartMs": 551790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "It also pointed out that\nGermany had access to uranium"
    } ]
  }, {
    "tStartMs": 554400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "from the mines in Czechoslovakia,"
    } ]
  }, {
    "tStartMs": 556470,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which was recently\ntaken over by the Nazis."
    } ]
  }, {
    "tStartMs": 559530,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Roosevelt began an\ninformal uranium committee"
    } ]
  }, {
    "tStartMs": 562650,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to discuss this topic,"
    } ]
  }, {
    "tStartMs": 564390,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "but then for two years, nothing happened."
    } ]
  }, {
    "tStartMs": 568680,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "In 1941, Roosevelt upgraded the informal"
    } ]
  }, {
    "tStartMs": 571860,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "uranium committee to the S-1 committee,"
    } ]
  }, {
    "tStartMs": 574410,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "which would report directly\nto the White House."
    } ]
  }, {
    "tStartMs": 577050,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "The explicit goal was to\ndevelop an atomic bomb,"
    } ]
  }, {
    "tStartMs": 580592,
    "dDurationMs": 1915,
    "segs": [ {
      "utf8": "and in May, 1942,"
    } ]
  }, {
    "tStartMs": 582507,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "Oppenheimer was hired onto the committee"
    } ]
  }, {
    "tStartMs": 585150,
    "dDurationMs": 3574,
    "segs": [ {
      "utf8": "to be the coordinator of rapid rupture."
    } ]
  }, {
    "tStartMs": 588724,
    "dDurationMs": 2958,
    "segs": [ {
      "utf8": "So why was he selected?"
    } ]
  }, {
    "tStartMs": 591682,
    "dDurationMs": 3038,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 594720,
    "dDurationMs": 1514,
    "segs": [ {
      "utf8": "Well, after completing his PhD,"
    } ]
  }, {
    "tStartMs": 596234,
    "dDurationMs": 2656,
    "segs": [ {
      "utf8": "Oppenheimer became a physics professor,"
    } ]
  }, {
    "tStartMs": 598890,
    "dDurationMs": 2386,
    "segs": [ {
      "utf8": "first at UC Berkeley, and then at Caltech,"
    } ]
  }, {
    "tStartMs": 601276,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "the brilliance he had shown"
    } ]
  }, {
    "tStartMs": 603060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "under Max Born's tutelage didn't fade."
    } ]
  }, {
    "tStartMs": 605640,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Indeed, it blossomed into a remarkable"
    } ]
  }, {
    "tStartMs": 607559,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "but strange physics career."
    } ]
  }, {
    "tStartMs": 610740,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "In the 15 years after finishing his PhD,"
    } ]
  }, {
    "tStartMs": 613530,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Oppenheimer made important\ncontributions to everything from"
    } ]
  }, {
    "tStartMs": 616230,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "nuclear physics to quantum field theory,"
    } ]
  }, {
    "tStartMs": 618750,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and even astrophysics."
    } ]
  }, {
    "tStartMs": 620520,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "He had a number of Nobel\nPrize winning ideas."
    } ]
  }, {
    "tStartMs": 622720,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "One of his students, Willis Lamb,"
    } ]
  }, {
    "tStartMs": 624540,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "became a Nobel laureate,"
    } ]
  }, {
    "tStartMs": 626430,
    "dDurationMs": 2573,
    "segs": [ {
      "utf8": "but Oppenheimer himself\nwas nominated three times,"
    } ]
  }, {
    "tStartMs": 629003,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "but never actually won the Nobel Prize."
    } ]
  }, {
    "tStartMs": 633420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "When asked why he thought that Oppenheimer"
    } ]
  }, {
    "tStartMs": 635400,
    "dDurationMs": 1506,
    "segs": [ {
      "utf8": "never won the Nobel Prize,"
    } ]
  }, {
    "tStartMs": 636906,
    "dDurationMs": 2011,
    "segs": [ {
      "utf8": "Murray Gell-Mann said that,"
    } ]
  }, {
    "tStartMs": 638917,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "\"He didn't have Sitzfleisch\""
    } ]
  }, {
    "tStartMs": 641160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "A German word that\ntranslates to sitting flesh."
    } ]
  }, {
    "tStartMs": 644340,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The ability to sit down\nin a chair for a long time"
    } ]
  }, {
    "tStartMs": 647400,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "and do the hard work."
    } ]
  }, {
    "tStartMs": 648727,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "\"He never wrote a long paper\nor did a long calculation."
    } ]
  }, {
    "tStartMs": 652590,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "He didn't have the patience for that.\""
    } ]
  }, {
    "tStartMs": 654713,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "Wolfgang Pauli also said,"
    } ]
  }, {
    "tStartMs": 656416,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "\"His ideas are very good,"
    } ]
  }, {
    "tStartMs": 658470,
    "dDurationMs": 2457,
    "segs": [ {
      "utf8": "but his calculations are always wrong.\""
    } ]
  }, {
    "tStartMs": 663600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But Oppenheimer was amazing with people."
    } ]
  }, {
    "tStartMs": 666660,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "He was a natural and charismatic leader,"
    } ]
  }, {
    "tStartMs": 669030,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and this combination,"
    } ]
  }, {
    "tStartMs": 670320,
    "dDurationMs": 2894,
    "segs": [ {
      "utf8": "his charisma and his ability\nto generate great ideas"
    } ]
  }, {
    "tStartMs": 673214,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "would serve him well in\nthe next phase of his life."
    } ]
  }, {
    "tStartMs": 676297,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 681510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "On the 18th of September, 1942,"
    } ]
  }, {
    "tStartMs": 683730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "general Leslie Groves was put in charge"
    } ]
  }, {
    "tStartMs": 686070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of the Manhattan Project."
    } ]
  }, {
    "tStartMs": 687690,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "- I was responsible for the\ndevelopment of the atomic bomb."
    } ]
  }, {
    "tStartMs": 691920,
    "dDurationMs": 4091,
    "segs": [ {
      "utf8": "- [Derek] On day one, he ordered\n1200 tons of uranium ore."
    } ]
  }, {
    "tStartMs": 696011,
    "dDurationMs": 1219,
    "segs": [ {
      "utf8": "The next day,"
    } ]
  }, {
    "tStartMs": 697230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "he ordered to buy the Oak Ridge site"
    } ]
  }, {
    "tStartMs": 699270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where the ore would be refined."
    } ]
  }, {
    "tStartMs": 701430,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The next month in a surprising move,"
    } ]
  }, {
    "tStartMs": 703170,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "he chose Oppenheimer to\nbe the science director"
    } ]
  }, {
    "tStartMs": 705750,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "of the soon to be established\nLos Alamos laboratory."
    } ]
  }, {
    "tStartMs": 709470,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Oppenheimer had just been\nselected to be the chief architect"
    } ]
  }, {
    "tStartMs": 712350,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "of the atomic bomb."
    } ]
  }, {
    "tStartMs": 715830,
    "dDurationMs": 2555,
    "segs": [ {
      "utf8": "The military establishment had concerns."
    } ]
  }, {
    "tStartMs": 718385,
    "dDurationMs": 2695,
    "segs": [ {
      "utf8": "Oppenheimer did not have a Nobel Prize,"
    } ]
  }, {
    "tStartMs": 721080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "so would the scientists\nhired for the project,"
    } ]
  }, {
    "tStartMs": 723180,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "respect his opinion,"
    } ]
  }, {
    "tStartMs": 724290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and follow his leadership?"
    } ]
  }, {
    "tStartMs": 726120,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Oppenheimer also had no prior\nadministrative experience"
    } ]
  }, {
    "tStartMs": 729090,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "over a large project like this."
    } ]
  }, {
    "tStartMs": 731550,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Furthermore, he was a\ntheoretical physicist,"
    } ]
  }, {
    "tStartMs": 734190,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "who according to Isidor Rabi,"
    } ]
  }, {
    "tStartMs": 736237,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "\"Was a very impractical fellow."
    } ]
  }, {
    "tStartMs": 738660,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "He didn't know anything about equipment.\""
    } ]
  }, {
    "tStartMs": 741450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And then there was the problem"
    } ]
  }, {
    "tStartMs": 742800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of Oppenheimer's political stance."
    } ]
  }, {
    "tStartMs": 744720,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "He had links to the Communist Party,"
    } ]
  }, {
    "tStartMs": 746970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "including his wife, Catherine,"
    } ]
  }, {
    "tStartMs": 748770,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "who was a member of that party."
    } ]
  }, {
    "tStartMs": 751560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But Groves was impressed by Oppenheimer."
    } ]
  }, {
    "tStartMs": 754170,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "He valued his overwhelming ambition."
    } ]
  }, {
    "tStartMs": 756750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "He also knew that Oppenheimer's\nability to understand"
    } ]
  }, {
    "tStartMs": 759000,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "problems not just in physics,"
    } ]
  }, {
    "tStartMs": 760530,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but chemistry, engineering,"
    } ]
  }, {
    "tStartMs": 761970,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and metallurgy would be invaluable."
    } ]
  }, {
    "tStartMs": 764580,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Groves thought that Oppenheimer\nwas a \"Real genius.\""
    } ]
  }, {
    "tStartMs": 768270,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "Saying that why Oppenheimer\nknows about everything."
    } ]
  }, {
    "tStartMs": 771877,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "\"He can talk to you about\nanything you bring up."
    } ]
  }, {
    "tStartMs": 774000,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Well, not exactly."
    } ]
  }, {
    "tStartMs": 775050,
    "dDurationMs": 2007,
    "segs": [ {
      "utf8": "He doesn't know anything about sports.\""
    } ]
  }, {
    "tStartMs": 777900,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The two men couldn't\nhave been more different."
    } ]
  }, {
    "tStartMs": 780270,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Oppenheimer weighed half as much as Groves"
    } ]
  }, {
    "tStartMs": 782880,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "despite both of them being\nnearly six feet tall."
    } ]
  }, {
    "tStartMs": 785647,
    "dDurationMs": 3173,
    "segs": [ {
      "utf8": "Ideologically, Oppenheimer\nwas a communist."
    } ]
  }, {
    "tStartMs": 788820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Groves, a staunch conservative,"
    } ]
  }, {
    "tStartMs": 791160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but Groves was convinced that Oppenheimer"
    } ]
  }, {
    "tStartMs": 793260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "would be the person that\nwould build the atomic bomb"
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "before the Nazis,"
    } ]
  }, {
    "tStartMs": 796860,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "and that was all that mattered."
    } ]
  }, {
    "tStartMs": 799263,
    "dDurationMs": 1857,
    "segs": [ {
      "utf8": "Isador Rabi later commented that,"
    } ]
  }, {
    "tStartMs": 801120,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "hiring Oppenheimer for this role was"
    } ]
  }, {
    "tStartMs": 804402,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "\"A real stroke of genius"
    } ]
  }, {
    "tStartMs": 805235,
    "dDurationMs": 955,
    "segs": [ {
      "utf8": "on the part of General Groves,"
    } ]
  }, {
    "tStartMs": 806190,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "who was not generally\nconsidered to be a genius.\""
    } ]
  }, {
    "tStartMs": 809700,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The Manhattan Project needed a location."
    } ]
  }, {
    "tStartMs": 812610,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "Somewhere isolated to\nkeep the project secret"
    } ]
  }, {
    "tStartMs": 814927,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "safe from enemy attack."
    } ]
  }, {
    "tStartMs": 816845,
    "dDurationMs": 2065,
    "segs": [ {
      "utf8": "And while no one wanted to admit it,"
    } ]
  }, {
    "tStartMs": 818910,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "somewhere that was sparsely populated,"
    } ]
  }, {
    "tStartMs": 820830,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "just in case there was an accident,"
    } ]
  }, {
    "tStartMs": 824310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Oppenheimer proposed\nLos Alamos, New Mexico."
    } ]
  }, {
    "tStartMs": 827310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "He had fallen in love with the\nharsh desert in the mountains"
    } ]
  }, {
    "tStartMs": 829890,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "of New Mexico when he was in his twenties."
    } ]
  }, {
    "tStartMs": 831758,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "In 1929, Oppenheimer wrote to a friend."
    } ]
  }, {
    "tStartMs": 834420,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "\"My two great loves are\nphysics and New Mexico."
    } ]
  }, {
    "tStartMs": 837900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It's a pity they can't be combined.\""
    } ]
  }, {
    "tStartMs": 840600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But Oppenheimer had severely\nunderestimated the logistical"
    } ]
  }, {
    "tStartMs": 843480,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "challenge ahead."
    } ]
  }, {
    "tStartMs": 844648,
    "dDurationMs": 3131,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 847779,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "In 1943, Oppenheimer estimated"
    } ]
  }, {
    "tStartMs": 850440,
    "dDurationMs": 2678,
    "segs": [ {
      "utf8": "that he'd need about six scientists"
    } ]
  }, {
    "tStartMs": 853118,
    "dDurationMs": 2182,
    "segs": [ {
      "utf8": "supported by a handful of engineers"
    } ]
  }, {
    "tStartMs": 855300,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "and technicians to make a bomb."
    } ]
  }, {
    "tStartMs": 860220,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "He was off by two orders of magnitude."
    } ]
  }, {
    "tStartMs": 864060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "764 scientists would end up"
    } ]
  }, {
    "tStartMs": 866160,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "working for the Manhattan Project."
    } ]
  }, {
    "tStartMs": 867810,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "302 of which would work\nat the Los Alamos site."
    } ]
  }, {
    "tStartMs": 873270,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Over 600,000 people in total were involved"
    } ]
  }, {
    "tStartMs": 876870,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "with the making of the atomic bomb."
    } ]
  }, {
    "tStartMs": 880110,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "By this point, making the atom\nbomb didn't seem impossible."
    } ]
  }, {
    "tStartMs": 883440,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "It seemed likely."
    } ]
  }, {
    "tStartMs": 887760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "On the 2nd of December, 1942,"
    } ]
  }, {
    "tStartMs": 889890,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "a team of physicists at\nthe University of Chicago"
    } ]
  }, {
    "tStartMs": 892350,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "led by Enrico Fermi created the world's"
    } ]
  }, {
    "tStartMs": 895230,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "first artificial nuclear reactor Pile-1."
    } ]
  }, {
    "tStartMs": 898680,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "It consisted of 45 tons of\nuranium and uranium oxide"
    } ]
  }, {
    "tStartMs": 902580,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "and 330 tons of graphite blocks."
    } ]
  }, {
    "tStartMs": 905425,
    "dDurationMs": 1445,
    "segs": [ {
      "utf8": "Horrifyingly enough."
    } ]
  }, {
    "tStartMs": 906870,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "It was located under the\nstands of the football field."
    } ]
  }, {
    "tStartMs": 910740,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "It generated about half a watt of power,"
    } ]
  }, {
    "tStartMs": 914820,
    "dDurationMs": 1965,
    "segs": [ {
      "utf8": "and if you can make a nuclear power plant,"
    } ]
  }, {
    "tStartMs": 916785,
    "dDurationMs": 1845,
    "segs": [ {
      "utf8": "you can make a bomb."
    } ]
  }, {
    "tStartMs": 918630,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The only real difference between the two"
    } ]
  }, {
    "tStartMs": 920460,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is how many neutrons hit the next atom,"
    } ]
  }, {
    "tStartMs": 922500,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "causing it to split and\nrelease more neutrons."
    } ]
  }, {
    "tStartMs": 925590,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If on average that number is one,"
    } ]
  }, {
    "tStartMs": 927690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "there will be a stable\nself-sustaining chain reaction,"
    } ]
  }, {
    "tStartMs": 930570,
    "dDurationMs": 1078,
    "segs": [ {
      "utf8": "but it won't grow."
    } ]
  }, {
    "tStartMs": 931648,
    "dDurationMs": 1742,
    "segs": [ {
      "utf8": "If it's less than one,"
    } ]
  }, {
    "tStartMs": 933390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the reaction will die down,"
    } ]
  }, {
    "tStartMs": 935340,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "and if it's more than one,"
    } ]
  }, {
    "tStartMs": 936450,
    "dDurationMs": 1547,
    "segs": [ {
      "utf8": "the reaction will grow."
    } ]
  }, {
    "tStartMs": 937997,
    "dDurationMs": 4093,
    "segs": [ {
      "utf8": "This is known as the\nmultiplication factor, K."
    } ]
  }, {
    "tStartMs": 942090,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "Nuclear reactions are similar\nto pandemics in this way."
    } ]
  }, {
    "tStartMs": 948210,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The simplest way to make a nuclear bomb"
    } ]
  }, {
    "tStartMs": 950250,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "is to get enough fissile\nmaterial close together"
    } ]
  }, {
    "tStartMs": 953310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that it creates a runaway chain reaction."
    } ]
  }, {
    "tStartMs": 955980,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "That amount is known as the critical mass."
    } ]
  }, {
    "tStartMs": 958770,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "With uranium-235,"
    } ]
  }, {
    "tStartMs": 960120,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "you need about 52 kilograms."
    } ]
  }, {
    "tStartMs": 962700,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "Forming a sphere with a\ndiameter of 17 centimeters."
    } ]
  }, {
    "tStartMs": 966230,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "If you use plutonium-239,"
    } ]
  }, {
    "tStartMs": 968700,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the critical mass is much smaller,"
    } ]
  }, {
    "tStartMs": 970260,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "only around 10 kilograms,"
    } ]
  }, {
    "tStartMs": 972120,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "which would create a sphere\nonly 10 centimeters wide."
    } ]
  }, {
    "tStartMs": 976170,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "For the first few years,"
    } ]
  }, {
    "tStartMs": 977370,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the scientists worked on a\nbomb with a gun type design."
    } ]
  }, {
    "tStartMs": 980790,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Inside a gun type bomb,"
    } ]
  }, {
    "tStartMs": 982590,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "you have two slabs of uranium-235,"
    } ]
  }, {
    "tStartMs": 984800,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "both of which are below the critical mass."
    } ]
  }, {
    "tStartMs": 987720,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Then using a conventional\nexplosive like cordite,"
    } ]
  }, {
    "tStartMs": 991320,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "you rapidly fire one towards the other."
    } ]
  }, {
    "tStartMs": 994620,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So the combined mass is\nhigher than the critical mass."
    } ]
  }, {
    "tStartMs": 998430,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "When the uranium bullet is\nabout 25 centimeters away,"
    } ]
  }, {
    "tStartMs": 1001850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the nuclear chain reaction begins"
    } ]
  }, {
    "tStartMs": 1004280,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "resulting in an atomic explosion."
    } ]
  }, {
    "tStartMs": 1007610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Despite the simple design,"
    } ]
  }, {
    "tStartMs": 1009290,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "it is not very efficient."
    } ]
  }, {
    "tStartMs": 1011180,
    "dDurationMs": 2638,
    "segs": [ {
      "utf8": "Only a small percentage of\nthe uranium undergoes fission,"
    } ]
  }, {
    "tStartMs": 1013818,
    "dDurationMs": 3392,
    "segs": [ {
      "utf8": "so the total yield of\nthe bomb is much smaller."
    } ]
  }, {
    "tStartMs": 1017210,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You also run into some\nunexpected problems,"
    } ]
  }, {
    "tStartMs": 1020090,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "like how do you make sure the uranium"
    } ]
  }, {
    "tStartMs": 1021920,
    "dDurationMs": 2265,
    "segs": [ {
      "utf8": "slides smoothly through the barrel?"
    } ]
  }, {
    "tStartMs": 1024185,
    "dDurationMs": 4005,
    "segs": [ {
      "utf8": "Well, you use oil to lubricate the barrel,"
    } ]
  }, {
    "tStartMs": 1028190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but all the synthetic\noils the scientists tried"
    } ]
  }, {
    "tStartMs": 1030650,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "would dry up."
    } ]
  }, {
    "tStartMs": 1032120,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "In the end,"
    } ]
  }, {
    "tStartMs": 1032960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the only oil they could\nfind that would work"
    } ]
  }, {
    "tStartMs": 1035720,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "was the oil from sperm whales."
    } ]
  }, {
    "tStartMs": 1040400,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Only about 0.7% of naturally\noccurring uranium is U235,"
    } ]
  }, {
    "tStartMs": 1045620,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the fissile fuel for nuclear bombs."
    } ]
  }, {
    "tStartMs": 1048440,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "When U235 absorbs a neutron,"
    } ]
  }, {
    "tStartMs": 1051050,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "it briefly becomes U236,"
    } ]
  }, {
    "tStartMs": 1053540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and then it rips itself roughly in half"
    } ]
  }, {
    "tStartMs": 1056300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and releases on average\n2.4 neutrons per fission."
    } ]
  }, {
    "tStartMs": 1060560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But when you get uranium outta the ground,"
    } ]
  }, {
    "tStartMs": 1062480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "most of it is U238,"
    } ]
  }, {
    "tStartMs": 1064490,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which doesn't undergo fission."
    } ]
  }, {
    "tStartMs": 1066830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So to make a nuclear bomb,"
    } ]
  }, {
    "tStartMs": 1068060,
    "dDurationMs": 2968,
    "segs": [ {
      "utf8": "the scientists use\ngigantic mass spectrometers"
    } ]
  }, {
    "tStartMs": 1071028,
    "dDurationMs": 4172,
    "segs": [ {
      "utf8": "to separate out and concentrate the U235,"
    } ]
  }, {
    "tStartMs": 1075200,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and the resulting substance was uranium"
    } ]
  }, {
    "tStartMs": 1077960,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "with a much higher concentration of U235."
    } ]
  }, {
    "tStartMs": 1081290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "In other words, it was enriched."
    } ]
  }, {
    "tStartMs": 1084320,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "There was another option though."
    } ]
  }, {
    "tStartMs": 1086810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "In early 1941,"
    } ]
  }, {
    "tStartMs": 1088490,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "a new element was discovered\nor rather synthesized."
    } ]
  }, {
    "tStartMs": 1092180,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "When a neutron is absorbed\nby a nucleus of uranium-238,"
    } ]
  }, {
    "tStartMs": 1095570,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "it turns into uranium-239."
    } ]
  }, {
    "tStartMs": 1098257,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "U239 is unstable,"
    } ]
  }, {
    "tStartMs": 1100580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "so it decays into Neptunium,"
    } ]
  }, {
    "tStartMs": 1102620,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "which then becomes plutonium."
    } ]
  }, {
    "tStartMs": 1105710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "There are three things\nthat matter for this story."
    } ]
  }, {
    "tStartMs": 1108230,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "First is that plutonium-239"
    } ]
  }, {
    "tStartMs": 1110022,
    "dDurationMs": 2408,
    "segs": [ {
      "utf8": "is a great fuel for a nuclear bomb."
    } ]
  }, {
    "tStartMs": 1112430,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It has a critical mass of\nonly about 10 kilograms."
    } ]
  }, {
    "tStartMs": 1115490,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "Second, it is cheaper to make\nthan to separate uranium-235"
    } ]
  }, {
    "tStartMs": 1119492,
    "dDurationMs": 2568,
    "segs": [ {
      "utf8": "and third, it reacts too quickly"
    } ]
  }, {
    "tStartMs": 1122060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to be used in a gun type device."
    } ]
  }, {
    "tStartMs": 1124040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It would fizzle,"
    } ]
  }, {
    "tStartMs": 1124873,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "meaning only a tiny fraction of the fuel"
    } ]
  }, {
    "tStartMs": 1126950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "would undergo fission."
    } ]
  }, {
    "tStartMs": 1129050,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "But there is a way to make\na bomb using plutonium."
    } ]
  }, {
    "tStartMs": 1131831,
    "dDurationMs": 2949,
    "segs": [ {
      "utf8": "Critical mass changes\ndepending on the density"
    } ]
  }, {
    "tStartMs": 1134780,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "of the material."
    } ]
  }, {
    "tStartMs": 1136100,
    "dDurationMs": 1645,
    "segs": [ {
      "utf8": "Under normal pressure conditions,"
    } ]
  }, {
    "tStartMs": 1137745,
    "dDurationMs": 4265,
    "segs": [ {
      "utf8": "six kilograms of\nplutonium-239 won't explode."
    } ]
  }, {
    "tStartMs": 1142010,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But if you compress it,"
    } ]
  }, {
    "tStartMs": 1143990,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "the atoms get closer together\nand the chance of a stay"
    } ]
  }, {
    "tStartMs": 1147200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "neutron hitting the nucleus increases."
    } ]
  }, {
    "tStartMs": 1149840,
    "dDurationMs": 3822,
    "segs": [ {
      "utf8": "So the higher the density,\nthe lower the critical mass."
    } ]
  }, {
    "tStartMs": 1153662,
    "dDurationMs": 3138,
    "segs": [ {
      "utf8": "So if you set off conventional explosives"
    } ]
  }, {
    "tStartMs": 1156800,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "around a ball of plutonium,"
    } ]
  }, {
    "tStartMs": 1158810,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "you can get it compressed enough"
    } ]
  }, {
    "tStartMs": 1160340,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "to start a nuclear chain reaction."
    } ]
  }, {
    "tStartMs": 1162763,
    "dDurationMs": 2284,
    "segs": [ {
      "utf8": "And this was the whole idea behind"
    } ]
  }, {
    "tStartMs": 1165047,
    "dDurationMs": 2106,
    "segs": [ {
      "utf8": "the implosion bomb design."
    } ]
  }, {
    "tStartMs": 1169730,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "There are a couple ways to cheat\nlowering the critical mass."
    } ]
  }, {
    "tStartMs": 1173180,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "For one thing,"
    } ]
  }, {
    "tStartMs": 1174050,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you surround the sphere with\na material that reflects"
    } ]
  }, {
    "tStartMs": 1176390,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "neutrons decreasing the\namount of nuclear fuel"
    } ]
  }, {
    "tStartMs": 1178850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you need to start a chain reaction."
    } ]
  }, {
    "tStartMs": 1181040,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "You can also have a neutron source,"
    } ]
  }, {
    "tStartMs": 1183260,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "something that kick\nstarts the chain reaction."
    } ]
  }, {
    "tStartMs": 1185601,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "For the first implosion bomb,"
    } ]
  }, {
    "tStartMs": 1188240,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "scientists created a\ndevice called the urchin,"
    } ]
  }, {
    "tStartMs": 1190970,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "which was a tiny pellet\nweighing just seven grams,"
    } ]
  }, {
    "tStartMs": 1194660,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and it would sit at the heart of the bomb."
    } ]
  }, {
    "tStartMs": 1197240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It was made of beryllium and polonium"
    } ]
  }, {
    "tStartMs": 1199940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "separated by a layer of nickel and gold."
    } ]
  }, {
    "tStartMs": 1202850,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The idea was that when\nthe explosives detonated,"
    } ]
  }, {
    "tStartMs": 1205760,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the shockwave would mix the\nberyllium and polonium together,"
    } ]
  }, {
    "tStartMs": 1209330,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and then the alpha particles from polonium"
    } ]
  }, {
    "tStartMs": 1211550,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "would cause the beryllium to\nrelease a flood of neutrons,"
    } ]
  }, {
    "tStartMs": 1215330,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "which would set off the\nnuclear chain reaction."
    } ]
  }, {
    "tStartMs": 1219380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "At least that was the hope."
    } ]
  }, {
    "tStartMs": 1221150,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "An atomic bomb had never been made before."
    } ]
  }, {
    "tStartMs": 1223213,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "Oppenheimer and the rest of\nthe scientists at Los Alamos"
    } ]
  }, {
    "tStartMs": 1226460,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "needed to act quickly."
    } ]
  }, {
    "tStartMs": 1227990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It was already 1945,"
    } ]
  }, {
    "tStartMs": 1229910,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and Truman wanted to test the weapon"
    } ]
  }, {
    "tStartMs": 1232130,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "before the start of\nthe Potsdam conference."
    } ]
  }, {
    "tStartMs": 1234800,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "That's where Truman, Churchill,"
    } ]
  }, {
    "tStartMs": 1236510,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and Stalin would come together\nto plan the post-war piece."
    } ]
  }, {
    "tStartMs": 1240170,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "The conference began on the 17th of July."
    } ]
  }, {
    "tStartMs": 1243740,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The earliest date that\neverything could be ready"
    } ]
  }, {
    "tStartMs": 1246140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "for the bomb was just one day earlier."
    } ]
  }, {
    "tStartMs": 1249200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So that is when the test was scheduled."
    } ]
  }, {
    "tStartMs": 1252560,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "It was Codenamed Trinity."
    } ]
  }, {
    "tStartMs": 1257780,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The night before Oppenheimer was nervous."
    } ]
  }, {
    "tStartMs": 1260870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "There were so many things\nthat could go wrong."
    } ]
  }, {
    "tStartMs": 1263630,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The last test firing of the explosives"
    } ]
  }, {
    "tStartMs": 1266210,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "without the actual plutonium\ncore was a failure."
    } ]
  }, {
    "tStartMs": 1270650,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "To calm himself,"
    } ]
  }, {
    "tStartMs": 1271850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "he recited a stanza\nfrom the Bhagavad Gita,"
    } ]
  }, {
    "tStartMs": 1274790,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the sacred Hindu poem."
    } ]
  }, {
    "tStartMs": 1276830,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "He had actually translated\nthe Gita from the original"
    } ]
  }, {
    "tStartMs": 1279440,
    "dDurationMs": 1898,
    "segs": [ {
      "utf8": "Sanskrit in himself."
    } ]
  }, {
    "tStartMs": 1281338,
    "dDurationMs": 2332,
    "segs": [ {
      "utf8": "In battle, in forest,"
    } ]
  }, {
    "tStartMs": 1283670,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "at the precipice in the mountains,"
    } ]
  }, {
    "tStartMs": 1285409,
    "dDurationMs": 3031,
    "segs": [ {
      "utf8": "on the dark great sea,"
    } ]
  }, {
    "tStartMs": 1288440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in the midst of javelins"
    } ]
  }, {
    "tStartMs": 1289940,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and arrows in sleep,"
    } ]
  }, {
    "tStartMs": 1291950,
    "dDurationMs": 2952,
    "segs": [ {
      "utf8": "in confusion, in the depths of shame,"
    } ]
  }, {
    "tStartMs": 1294902,
    "dDurationMs": 4491,
    "segs": [ {
      "utf8": "the good deeds a man has\ndone before defend him."
    } ]
  }, {
    "tStartMs": 1301220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Perhaps more terrifying\nthan the idea of the bomb"
    } ]
  }, {
    "tStartMs": 1303770,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "not working was that\nit would work too well."
    } ]
  }, {
    "tStartMs": 1310340,
    "dDurationMs": 3973,
    "segs": [ {
      "utf8": "Around 1942, Oppenheimer\ndiscussed with Arthur Compton"
    } ]
  }, {
    "tStartMs": 1314313,
    "dDurationMs": 3917,
    "segs": [ {
      "utf8": "a terrible possibility that a nuclear test"
    } ]
  }, {
    "tStartMs": 1318230,
    "dDurationMs": 1536,
    "segs": [ {
      "utf8": "could end the world."
    } ]
  }, {
    "tStartMs": 1319766,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "The worry was that the nuclear bomb"
    } ]
  }, {
    "tStartMs": 1322010,
    "dDurationMs": 4413,
    "segs": [ {
      "utf8": "would create temperatures so\nhot that fusion would occur."
    } ]
  }, {
    "tStartMs": 1328310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "A tiny fraction of the atmosphere,"
    } ]
  }, {
    "tStartMs": 1330260,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "just one part in 2\nmillion is hydrogen gas."
    } ]
  }, {
    "tStartMs": 1334520,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But the worry was that at\nhigh enough temperatures"
    } ]
  }, {
    "tStartMs": 1336650,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and pressures that hydrogen\ncould fuse to together"
    } ]
  }, {
    "tStartMs": 1340040,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "releasing energy,"
    } ]
  }, {
    "tStartMs": 1341660,
    "dDurationMs": 2292,
    "segs": [ {
      "utf8": "this energy would fuse more hydrogen."
    } ]
  }, {
    "tStartMs": 1343952,
    "dDurationMs": 2538,
    "segs": [ {
      "utf8": "It could also break apart the hydrogen"
    } ]
  }, {
    "tStartMs": 1346490,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "from water vapor causing\nthat to fuse as well."
    } ]
  }, {
    "tStartMs": 1350120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "That would release even more energy"
    } ]
  }, {
    "tStartMs": 1351890,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "causing yet more fusion until the entirety"
    } ]
  }, {
    "tStartMs": 1355250,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "of the Earth's atmosphere would\nbecome a giant fusion bomb."
    } ]
  }, {
    "tStartMs": 1360140,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Recalling his conversations\nwith Oppenheimer in 1959,"
    } ]
  }, {
    "tStartMs": 1363680,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "Compton said, \"Nor was this\nall that Oppenheimer feared."
    } ]
  }, {
    "tStartMs": 1367146,
    "dDurationMs": 3374,
    "segs": [ {
      "utf8": "The nitrogen in the air is also unstable,"
    } ]
  }, {
    "tStartMs": 1370520,
    "dDurationMs": 1455,
    "segs": [ {
      "utf8": "though in less degree."
    } ]
  }, {
    "tStartMs": 1371975,
    "dDurationMs": 2955,
    "segs": [ {
      "utf8": "Might not it, too, be set off by an"
    } ]
  }, {
    "tStartMs": 1374930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "atomic explosion in the atmosphere.\""
    } ]
  }, {
    "tStartMs": 1377690,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Most of the scientists quickly realized"
    } ]
  }, {
    "tStartMs": 1379640,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "how unlikely this scenario was,"
    } ]
  }, {
    "tStartMs": 1381530,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and they continued on with the project,"
    } ]
  }, {
    "tStartMs": 1383630,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "so no one took the idea too seriously."
    } ]
  }, {
    "tStartMs": 1386390,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But the thought of starting a\nfusion reaction with a fission"
    } ]
  }, {
    "tStartMs": 1389810,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "weapon would become very\nimportant after the war."
    } ]
  }, {
    "tStartMs": 1393391,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1397130,
    "dDurationMs": 2978,
    "segs": [ {
      "utf8": "The Trinity test was scheduled for 4:00 AM"
    } ]
  }, {
    "tStartMs": 1400108,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "but it was delayed due to a storm."
    } ]
  }, {
    "tStartMs": 1403070,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "So at 5:29 and 21 seconds, the gadget,"
    } ]
  }, {
    "tStartMs": 1407060,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the world's first nuclear bomb detonated,"
    } ]
  }, {
    "tStartMs": 1410630,
    "dDurationMs": 3874,
    "segs": [ {
      "utf8": "the high explosive squeezed\nthe core of plutonium inwards."
    } ]
  }, {
    "tStartMs": 1414504,
    "dDurationMs": 2726,
    "segs": [ {
      "utf8": "The shockwave mixed the\nberyllium and polonium"
    } ]
  }, {
    "tStartMs": 1417230,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "releasing a flood of neutrons."
    } ]
  }, {
    "tStartMs": 1420080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The urchin worked."
    } ]
  }, {
    "tStartMs": 1421760,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It jump started the nuclear reaction,"
    } ]
  }, {
    "tStartMs": 1424100,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "and now there was no way to stop it."
    } ]
  }, {
    "tStartMs": 1427580,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Just six kilograms of\nplutonium created an explosion"
    } ]
  }, {
    "tStartMs": 1431090,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "that was equivalent to\nnearly 25,000 tons of TNT."
    } ]
  }, {
    "tStartMs": 1435860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The New Mexico mountains were illuminated"
    } ]
  }, {
    "tStartMs": 1437750,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "brighter than in daytime."
    } ]
  }, {
    "tStartMs": 1439373,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The shockwave was felt from\nover 160 kilometers away."
    } ]
  }, {
    "tStartMs": 1444830,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The mushroom cloud rose to\n12 kilometers into the sky."
    } ]
  }, {
    "tStartMs": 1449270,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It was so hot that the desert sand melted"
    } ]
  }, {
    "tStartMs": 1452360,
    "dDurationMs": 3507,
    "segs": [ {
      "utf8": "into a glassy mineral,\nnow known as trinitite."
    } ]
  }, {
    "tStartMs": 1455867,
    "dDurationMs": 4146,
    "segs": [ {
      "utf8": "Fortunately, the blast did not\nset fire to the atmosphere."
    } ]
  }, {
    "tStartMs": 1464210,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "On August 6th, 1945,"
    } ]
  }, {
    "tStartMs": 1465890,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "the Boeing B29 Flying\nFortress dropped little boy,"
    } ]
  }, {
    "tStartMs": 1469970,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "a gun type nuclear bomb with 64 kilograms"
    } ]
  }, {
    "tStartMs": 1473150,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "of enriched uranium."
    } ]
  }, {
    "tStartMs": 1474771,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "The nitro cellulose\nignited pushing the slugs"
    } ]
  }, {
    "tStartMs": 1477650,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of uranium-235 together,"
    } ]
  }, {
    "tStartMs": 1479720,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "tipping it over its critical mass."
    } ]
  }, {
    "tStartMs": 1481824,
    "dDurationMs": 2573,
    "segs": [ {
      "utf8": "The blast from the explosion equivalent"
    } ]
  }, {
    "tStartMs": 1484397,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "to 15,000 tons of TNT,"
    } ]
  }, {
    "tStartMs": 1488060,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "killed nearly 70,000 people."
    } ]
  }, {
    "tStartMs": 1491660,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "Another 70,000 would die from\nburns and radiation poisoning"
    } ]
  }, {
    "tStartMs": 1495890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "in the following months."
    } ]
  }, {
    "tStartMs": 1497870,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Three days later,"
    } ]
  }, {
    "tStartMs": 1498800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "an implosion type bomb, like the gadget,"
    } ]
  }, {
    "tStartMs": 1501290,
    "dDurationMs": 976,
    "segs": [ {
      "utf8": "was dropped on Nagasaki"
    } ]
  }, {
    "tStartMs": 1502266,
    "dDurationMs": 3497,
    "segs": [ {
      "utf8": "killing an estimated 80,000 more people."
    } ]
  }, {
    "tStartMs": 1507230,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "More than 95% of the 225,000 people killed"
    } ]
  }, {
    "tStartMs": 1512210,
    "dDurationMs": 3571,
    "segs": [ {
      "utf8": "in the bombings of Hiroshima\nand Nagasaki were civilians."
    } ]
  }, {
    "tStartMs": 1515781,
    "dDurationMs": 2732,
    "segs": [ {
      "utf8": "Most were women and children."
    } ]
  }, {
    "tStartMs": 1521090,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "In 1965, recalling the moments\nafter the Trinity test,"
    } ]
  }, {
    "tStartMs": 1525500,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Oppenheimer said that he\nthought of another verse"
    } ]
  }, {
    "tStartMs": 1528050,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "from the Ghita."
    } ]
  }, {
    "tStartMs": 1529520,
    "dDurationMs": 2357,
    "segs": [ {
      "utf8": "- He knew the world would not be the same."
    } ]
  }, {
    "tStartMs": 1534557,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "Few people laughed,"
    } ]
  }, {
    "tStartMs": 1538820,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "few people cried."
    } ]
  }, {
    "tStartMs": 1541010,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "Most people were silent."
    } ]
  }, {
    "tStartMs": 1545900,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "I remembered the line\nfrom the Hindu scripture,"
    } ]
  }, {
    "tStartMs": 1549800,
    "dDurationMs": 887,
    "segs": [ {
      "utf8": "the (speaking foreign language)."
    } ]
  }, {
    "tStartMs": 1554513,
    "dDurationMs": 3387,
    "segs": [ {
      "utf8": "The Vishnu is trying\nto persuade the prince"
    } ]
  }, {
    "tStartMs": 1560210,
    "dDurationMs": 3707,
    "segs": [ {
      "utf8": "that he should do his duty"
    } ]
  }, {
    "tStartMs": 1563917,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and to impress him takes on\nhis multi-armed form and says,"
    } ]
  }, {
    "tStartMs": 1572453,
    "dDurationMs": 3954,
    "segs": [ {
      "utf8": "'Now I am become death\nthe destroyer of worlds.'"
    } ]
  }, {
    "tStartMs": 1579260,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "I suppose we all thought\nthat one way or another."
    } ]
  }, {
    "tStartMs": 1583370,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] After the war,"
    } ]
  }, {
    "tStartMs": 1584510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Oppenheimer was a national hero."
    } ]
  }, {
    "tStartMs": 1586940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "His portrait was on the\ncover of Time Magazine,"
    } ]
  }, {
    "tStartMs": 1589460,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "and he became a household name."
    } ]
  }, {
    "tStartMs": 1592670,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "In 1947, he became the director"
    } ]
  }, {
    "tStartMs": 1594770,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of the Institute of\nAdvanced Study at Princeton."
    } ]
  }, {
    "tStartMs": 1597530,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "He also became the chairman"
    } ]
  }, {
    "tStartMs": 1599060,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of the General Advisory Committee,"
    } ]
  }, {
    "tStartMs": 1601130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "where he became an\nadvisor on nuclear weapons"
    } ]
  }, {
    "tStartMs": 1603470,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "related issues."
    } ]
  }, {
    "tStartMs": 1605030,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "He used his position to\nargue for arms control."
    } ]
  }, {
    "tStartMs": 1610100,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1611060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "In August, 1949,"
    } ]
  }, {
    "tStartMs": 1612770,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the Soviet Union tested\ntheir first atomic weapon,"
    } ]
  }, {
    "tStartMs": 1620160,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "and the US military quickly decided"
    } ]
  }, {
    "tStartMs": 1622430,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that the best course of action"
    } ]
  }, {
    "tStartMs": 1624110,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "was to develop a more powerful bomb."
    } ]
  }, {
    "tStartMs": 1626870,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The hydrogen bomb,"
    } ]
  }, {
    "tStartMs": 1628430,
    "dDurationMs": 1917,
    "segs": [ {
      "utf8": "known as \"The Super\","
    } ]
  }, {
    "tStartMs": 1630347,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Oppenheimer was against the development"
    } ]
  }, {
    "tStartMs": 1633380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of The Super on ethical grounds"
    } ]
  }, {
    "tStartMs": 1635540,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and the worry that it\nwould start an arms race."
    } ]
  }, {
    "tStartMs": 1638840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But Truman's administration\npushed through,"
    } ]
  }, {
    "tStartMs": 1641480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and three years later, Ivy Mike,"
    } ]
  }, {
    "tStartMs": 1643640,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "the first hydrogen bomb was\ntested in the Marshall Islands."
    } ]
  }, {
    "tStartMs": 1647570,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "It had a yield of 10.4 megatons of TNT."
    } ]
  }, {
    "tStartMs": 1651800,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "That's 400 times more powerful\nthan the Trinity test."
    } ]
  }, {
    "tStartMs": 1660740,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "A hydrogen bomb is actually\nthree bombs in one,"
    } ]
  }, {
    "tStartMs": 1664250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "a conventional bomb, a fission bomb,"
    } ]
  }, {
    "tStartMs": 1666380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and a fusion bomb."
    } ]
  }, {
    "tStartMs": 1668120,
    "dDurationMs": 2849,
    "segs": [ {
      "utf8": "The conventional explosives\ntrigger a fission reaction,"
    } ]
  }, {
    "tStartMs": 1670969,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "which increases the\ntemperature and pressure"
    } ]
  }, {
    "tStartMs": 1673430,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "enough to fuse deuterium\nand tritium together,"
    } ]
  }, {
    "tStartMs": 1676850,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "releasing a huge amount of energy."
    } ]
  }, {
    "tStartMs": 1680300,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "In 1961, the Soviet Union\ntested the Tsar Bomba,"
    } ]
  }, {
    "tStartMs": 1684350,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "the most powerful\nexplosion ever detonated."
    } ]
  }, {
    "tStartMs": 1687650,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It was another five times\nmore powerful than Ivy Mike"
    } ]
  }, {
    "tStartMs": 1691250,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "around 2000 times more\npowerful than Trinity."
    } ]
  }, {
    "tStartMs": 1697040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "This kind of arms race"
    } ]
  }, {
    "tStartMs": 1697873,
    "dDurationMs": 3547,
    "segs": [ {
      "utf8": "was exactly what Oppenheimer had feared,"
    } ]
  }, {
    "tStartMs": 1701420,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "in part, due to his opposition\nto the hydrogen bomb."
    } ]
  }, {
    "tStartMs": 1703760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And due to his calls to\navert a nuclear arms race,"
    } ]
  }, {
    "tStartMs": 1706640,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Oppenheimer was essentially put on trial"
    } ]
  }, {
    "tStartMs": 1708740,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to revoke his security clearance."
    } ]
  }, {
    "tStartMs": 1710810,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "He had been surveilled\nwhile he was working"
    } ]
  }, {
    "tStartMs": 1712670,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "for the Manhattan Project,"
    } ]
  }, {
    "tStartMs": 1713990,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but that surveillance\ndidn't stop after he left."
    } ]
  }, {
    "tStartMs": 1716870,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Many of the wiretaps were\nillegal and warrantless."
    } ]
  }, {
    "tStartMs": 1720320,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Oppenheimer was questioned about his ties"
    } ]
  }, {
    "tStartMs": 1722150,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "to the Communist Party,"
    } ]
  }, {
    "tStartMs": 1723140,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "including his affair with Gene Tatlock,"
    } ]
  }, {
    "tStartMs": 1725360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "a Communist party member"
    } ]
  }, {
    "tStartMs": 1727040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "while he was leading the Los Alamos lab."
    } ]
  }, {
    "tStartMs": 1729920,
    "dDurationMs": 4112,
    "segs": [ {
      "utf8": "He was essentially accused\nof treason and espionage."
    } ]
  }, {
    "tStartMs": 1734032,
    "dDurationMs": 2008,
    "segs": [ {
      "utf8": "In December, 1953,"
    } ]
  }, {
    "tStartMs": 1736040,
    "dDurationMs": 3094,
    "segs": [ {
      "utf8": "Oppenheimer had his security\nclearance suspended."
    } ]
  }, {
    "tStartMs": 1739134,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "His face now grim and in black and white"
    } ]
  }, {
    "tStartMs": 1742009,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "was once again on the cover of time."
    } ]
  }, {
    "tStartMs": 1745070,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "His security hearings\nwere international news."
    } ]
  }, {
    "tStartMs": 1749750,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "In 1964, German playwright\nHeinar Kipphardt"
    } ]
  }, {
    "tStartMs": 1753290,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "wrote a play about Oppenheimer's life."
    } ]
  }, {
    "tStartMs": 1756470,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Oppenheimer was sent\na copy of this script,"
    } ]
  }, {
    "tStartMs": 1759200,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and he hated it so much\nthat he threatened to sue."
    } ]
  }, {
    "tStartMs": 1762770,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "He especially despised the\nfinal scene where the character"
    } ]
  }, {
    "tStartMs": 1765540,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "of Oppenheimer realizes\nthe evil of his work."
    } ]
  }, {
    "tStartMs": 1769340,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "And I quote,"
    } ]
  }, {
    "tStartMs": 1770487,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "\"We have been doing\nthe work of the devil.\""
    } ]
  }, {
    "tStartMs": 1773570,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "To Oppenheimer, it was always\nmore complicated than that."
    } ]
  }, {
    "tStartMs": 1777320,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- I think that it probably was assumed,"
    } ]
  }, {
    "tStartMs": 1780260,
    "dDurationMs": 2659,
    "segs": [ {
      "utf8": "it certainly was always\nassumed at Los Alamos"
    } ]
  }, {
    "tStartMs": 1782919,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "that if the war were\nnot over and not clearly"
    } ]
  }, {
    "tStartMs": 1792470,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to be brought to a conclusion\nby the diplomatic means"
    } ]
  }, {
    "tStartMs": 1798940,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "this weapon would play a part."
    } ]
  }, {
    "tStartMs": 1801230,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "At the time, the alternative,"
    } ]
  }, {
    "tStartMs": 1806300,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "the campaign of invasion was\ncertainly much more terrible"
    } ]
  }, {
    "tStartMs": 1810230,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "for everyone concerned."
    } ]
  }, {
    "tStartMs": 1813440,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I think that Hiroshima was\nfar more costly in life"
    } ]
  }, {
    "tStartMs": 1821180,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and suffering inhumane than\nit needed to have been,"
    } ]
  }, {
    "tStartMs": 1827210,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to have been an effective\nargument for ending the war."
    } ]
  }, {
    "tStartMs": 1833510,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This is easy to say after the fact."
    } ]
  }, {
    "tStartMs": 1836540,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- In 1965, he was asked about\nthe recent proposal of talks"
    } ]
  }, {
    "tStartMs": 1839870,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "with the Soviet Union to\nhalt the proliferation"
    } ]
  }, {
    "tStartMs": 1842450,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "of nuclear weapons,"
    } ]
  }, {
    "tStartMs": 1843380,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "and his response was,"
    } ]
  }, {
    "tStartMs": 1844857,
    "dDurationMs": 3323,
    "segs": [ {
      "utf8": "\"It should have been done\nthe day after Trinity."
    } ]
  }, {
    "tStartMs": 1848180,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Later that same year, he was\ndiagnosed with throat cancer."
    } ]
  }, {
    "tStartMs": 1851570,
    "dDurationMs": 1725,
    "segs": [ {
      "utf8": "He was a lifelong smoker,"
    } ]
  }, {
    "tStartMs": 1853295,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and he died on the 18th\nof February, 1967 aged 62."
    } ]
  }, {
    "tStartMs": 1865190,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "Advances in science and\ntechnology have given humans"
    } ]
  }, {
    "tStartMs": 1867951,
    "dDurationMs": 4289,
    "segs": [ {
      "utf8": "tremendous power to make\nthe world better or worse,"
    } ]
  }, {
    "tStartMs": 1872240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and nuclear war isn't the only\nthing we have to worry about."
    } ]
  }, {
    "tStartMs": 1875480,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Human caused climate change\nposes a serious threat to"
    } ]
  }, {
    "tStartMs": 1878630,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "ecosystems and the most vulnerable\npeople around the world."
    } ]
  }, {
    "tStartMs": 1882380,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "As I record this, we are in\nthe midst of a heat wave,"
    } ]
  }, {
    "tStartMs": 1885290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and my folks up in Canada are suffering"
    } ]
  }, {
    "tStartMs": 1887120,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "in the smoke from wildfires."
    } ]
  }, {
    "tStartMs": 1889070,
    "dDurationMs": 2653,
    "segs": [ {
      "utf8": "This is where this video\nsponsor Wren comes in."
    } ]
  }, {
    "tStartMs": 1891723,
    "dDurationMs": 2989,
    "segs": [ {
      "utf8": "Their mission is to take\naction on climate change."
    } ]
  }, {
    "tStartMs": 1894712,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "On their website, you can\ncalculate your carbon footprint,"
    } ]
  }, {
    "tStartMs": 1897590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "which can help you identify\nways to reduce your impact."
    } ]
  }, {
    "tStartMs": 1900530,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "And if you like,"
    } ]
  }, {
    "tStartMs": 1901640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "you can offset your carbon footprint"
    } ]
  }, {
    "tStartMs": 1903590,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "with a simple monthly subscription."
    } ]
  }, {
    "tStartMs": 1905780,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "While individual action is important,"
    } ]
  }, {
    "tStartMs": 1907880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Wren understands that\nthis alone is not enough,"
    } ]
  }, {
    "tStartMs": 1911000,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "which is why your subscription funds"
    } ]
  }, {
    "tStartMs": 1912560,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "not only carbon removal and offsets,"
    } ]
  }, {
    "tStartMs": 1914870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but also lobbying to enact climate policy"
    } ]
  }, {
    "tStartMs": 1917660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and land conservation projects."
    } ]
  }, {
    "tStartMs": 1919970,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "I am particularly fond"
    } ]
  }, {
    "tStartMs": 1921230,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of their new refrigerant\ndestruction project."
    } ]
  }, {
    "tStartMs": 1924110,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We actually made a video\nabout Thomas Midgley"
    } ]
  }, {
    "tStartMs": 1926840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "who invented Freon,"
    } ]
  }, {
    "tStartMs": 1928460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which is a refrigerant\nthat is both destructive"
    } ]
  }, {
    "tStartMs": 1930770,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "to the ozone layer and a\nvery potent greenhouse gas."
    } ]
  }, {
    "tStartMs": 1934730,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Well this project permanently destroys"
    } ]
  }, {
    "tStartMs": 1936680,
    "dDurationMs": 2727,
    "segs": [ {
      "utf8": "harmful refrigerants like CFCs, HCFCs,"
    } ]
  }, {
    "tStartMs": 1939407,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "and HFCs to stop them from\ngetting into the atmosphere."
    } ]
  }, {
    "tStartMs": 1942860,
    "dDurationMs": 2582,
    "segs": [ {
      "utf8": "And this will reduce global\nwarming and prevent the further"
    } ]
  }, {
    "tStartMs": 1945442,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "destruction of the ozone layer."
    } ]
  }, {
    "tStartMs": 1947210,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It's a win-win."
    } ]
  }, {
    "tStartMs": 1948043,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "I personally offset my\nemissions with Wren,"
    } ]
  }, {
    "tStartMs": 1950600,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and for the first a\nhundred people to sign up"
    } ]
  }, {
    "tStartMs": 1952220,
    "dDurationMs": 1174,
    "segs": [ {
      "utf8": "using the link in the description,"
    } ]
  }, {
    "tStartMs": 1953394,
    "dDurationMs": 2396,
    "segs": [ {
      "utf8": "I will personally pay for the first month"
    } ]
  }, {
    "tStartMs": 1955790,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "of your subscription."
    } ]
  }, {
    "tStartMs": 1956840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This is an idea I came up with myself"
    } ]
  }, {
    "tStartMs": 1959030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "because I think it's so\nimportant that for those of us"
    } ]
  }, {
    "tStartMs": 1961430,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "who can help,"
    } ]
  }, {
    "tStartMs": 1962270,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that we pool our resources together"
    } ]
  }, {
    "tStartMs": 1963740,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to have a greater impact."
    } ]
  }, {
    "tStartMs": 1965180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So I hope you take the\ntime to check out Wren."
    } ]
  }, {
    "tStartMs": 1967460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I wanna thank them for sponsoring\nthis part of the video,"
    } ]
  }, {
    "tStartMs": 1969740,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
