    "segs": [ {
      "utf8": "and incredibly easy to understand."
    } ]
  }, {
    "tStartMs": 2088330,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It's more than just a learning platform.,"
    } ]
  }, {
    "tStartMs": 2090610,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "it's your path to understanding the world"
    } ]
  }, {
    "tStartMs": 2092710,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of math, data and computer science."
    } ]
  }, {
    "tStartMs": 2095350,
