    "segs": [ {
      "utf8": "compare distributions and\nmaster fundamental concepts"
    } ]
  }, {
    "tStartMs": 2060700,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "like Bayes' theorem,"
    } ]
  }, {
    "tStartMs": 2061810,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "all while working with\nreal air traffic data."
    } ]
  }, {
    "tStartMs": 2064990,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "You'll learn to answer questions"
    } ]
  }, {
    "tStartMs": 2066040,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "like which airlines have the\nleast delays due to weather"
    } ]
  }, {
    "tStartMs": 2069580,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and how much more unruly"
    } ]
  }, {
    "tStartMs": 2071050,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "passengers have gotten since the pandemic."
    } ]
  }, {
    "tStartMs": 2073780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Data skills are absolutely necessary"
    } ]
  }, {
    "tStartMs": 2075940,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to navigate our world today."
    } ]
  }, {
    "tStartMs": 2077470,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And Brilliant is the\nbest place to get them."
    } ]
  }, {
    "tStartMs": 2080020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Beyond their data courses,"
    } ]
  }, {
    "tStartMs": 2081280,
    "dDurationMs": 2490,
