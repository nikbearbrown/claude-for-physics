{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 150,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "- In November 2024,\nProfessor Todd Humphreys,"
    } ]
  }, {
    "tStartMs": 2480,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "a GPS expert at the\nUniversity of Texas at Austin,"
    } ]
  }, {
    "tStartMs": 5910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "got a mysterious tip-off."
    } ]
  }, {
    "tStartMs": 8250,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Look at two specific days,"
    } ]
  }, {
    "tStartMs": 10770,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "at exact times in a data\nset collected years earlier"
    } ]
  }, {
    "tStartMs": 14910,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "by a network of GPS monitoring stations."
    } ]
  }, {
    "tStartMs": 18330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "These stations continuously record signals"
    } ]
  }, {
    "tStartMs": 20670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "from satellite navigation systems,"
    } ]
  }, {
    "tStartMs": 22530,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "measuring how strong they are\nrelative to background noise."
    } ]
  }, {
    "tStartMs": 25650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "It didn't seem promising."
    } ]
  }, {
    "tStartMs": 27420,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The data was from 2021,"
    } ]
  }, {
    "tStartMs": 29430,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and it was publicly available online."
    } ]
  }, {
    "tStartMs": 31830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So surely if something\nunusual was in there,"
    } ]
  }, {
    "tStartMs": 34500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "someone would have already found it."
    } ]
  }, {
    "tStartMs": 36780,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But Professor Humphreys and his\nstudent Zach Clements looked"
    } ]
  }, {
    "tStartMs": 39630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "into the data at the two\nspecific times suggested,"
    } ]
  }, {
    "tStartMs": 42240,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and they discovered something surprising."
    } ]
  }, {
    "tStartMs": 44910,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "At one precise moment,"
    } ]
  }, {
    "tStartMs": 46200,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "receivers across the network\nall reported the same thing,"
    } ]
  }, {
    "tStartMs": 49650,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "a sudden drop in signal-to-noise ratio."
    } ]
  }, {
    "tStartMs": 52650,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "In effect, the navigation\nsignals had been overwhelmed."
    } ]
  }, {
    "tStartMs": 55830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The measured signal-to-noise dropped"
    } ]
  }, {
    "tStartMs": 57780,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "by roughly a factor of 10."
    } ]
  }, {
    "tStartMs": 60480,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But when they started looking\nback through the data,"
    } ]
  }, {
    "tStartMs": 62520,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "they found 75 days since 2019"
    } ]
  }, {
    "tStartMs": 65730,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "where these strong\ndisruptions had taken place."
    } ]
  }, {
    "tStartMs": 68910,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And again, and again,\nthe pattern was the same."
    } ]
  }, {
    "tStartMs": 71700,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "All these receivers recorded\nthe same drop at the same time."
    } ]
  }, {
    "tStartMs": 75810,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- This effect was being felt\nall the way across Europe,"
    } ]
  }, {
    "tStartMs": 79590,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "all the way to the north,\nto Svalbard, to the south,"
    } ]
  }, {
    "tStartMs": 82140,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to Spain, all the way\nto Canada in the west,"
    } ]
  }, {
    "tStartMs": 85290,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "as far east as eastern Poland."
    } ]
  }, {
    "tStartMs": 87660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And in fact,"
    } ]
  }, {
    "tStartMs": 89430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "it had a distinct pattern\nacross Europe to where it looked"
    } ]
  }, {
    "tStartMs": 91440,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "like the blast center was in Poland"
    } ]
  }, {
    "tStartMs": 95700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "or Kaliningrad in that area."
    } ]
  }, {
    "tStartMs": 98460,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- So, they wondered what could cause this."
    } ]
  }, {
    "tStartMs": 101730,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "At first, they thought\nperhaps it's interference,"
    } ]
  }, {
    "tStartMs": 103770,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "something on the ground\nbroadcasting a much stronger signal,"
    } ]
  }, {
    "tStartMs": 107070,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "drowning out the ones\ncoming from the satellites,"
    } ]
  }, {
    "tStartMs": 109320,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which made Kaliningrad\nan interesting candidate."
    } ]
  }, {
    "tStartMs": 112110,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It's a heavily militarized Russian exclave"
    } ]
  }, {
    "tStartMs": 114390,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "on the Baltic Sea wedged\nbetween Poland and Lithuania."
    } ]
  }, {
    "tStartMs": 117420,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And in recent years, it's become a hotspot"
    } ]
  }, {
    "tStartMs": 119790,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "for this kind of electronic warfare."
    } ]
  }, {
    "tStartMs": 123030,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So maybe that was it,"
    } ]
  }, {
    "tStartMs": 124500,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "a side effect of the\nconflict in the region."
    } ]
  }, {
    "tStartMs": 127230,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But they realized that\nexplanation didn't work."
    } ]
  }, {
    "tStartMs": 130350,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Even the highest tower in Kaliningrad"
    } ]
  }, {
    "tStartMs": 132570,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "only affects aviation\nas far as, say, Denmark."
    } ]
  }, {
    "tStartMs": 137820,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, we had ourselves a\nmystery on our hands."
    } ]
  }, {
    "tStartMs": 140760,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "We were experienced with interference"
    } ]
  }, {
    "tStartMs": 144330,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that you could call local,\nsomething on a tower,"
    } ]
  }, {
    "tStartMs": 147150,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "something on a plane"
    } ]
  }, {
    "tStartMs": 148950,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that might cover hundreds of kilometers."
    } ]
  }, {
    "tStartMs": 152310,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "But this was different."
    } ]
  }, {
    "tStartMs": 154210,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "This was continental scale."
    } ]
  }, {
    "tStartMs": 155640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- The researchers mapped\nout all the stations"
    } ]
  }, {
    "tStartMs": 157680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that were affected and\nasked a simple question."
    } ]
  }, {
    "tStartMs": 160560,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "What kind of source could have\naffected all of them at once?"
    } ]
  }, {
    "tStartMs": 164340,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The source on the ground\njust wouldn't work."
    } ]
  }, {
    "tStartMs": 166770,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The curvature of the earth\nwould block the signal"
    } ]
  }, {
    "tStartMs": 168810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "over these distances."
    } ]
  }, {
    "tStartMs": 170820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The only way to affect such\na wide area simultaneously is"
    } ]
  }, {
    "tStartMs": 174360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "from high above the earth."
    } ]
  }, {
    "tStartMs": 176880,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And even using the most\nconservative assumptions,"
    } ]
  }, {
    "tStartMs": 179340,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that the source only has\nto just clear the horizon"
    } ]
  }, {
    "tStartMs": 182040,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "from the perspective of every station,"
    } ]
  }, {
    "tStartMs": 183900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the geometry shows it had to be"
    } ]
  }, {
    "tStartMs": 185910,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "at least 1,200 kilometers up."
    } ]
  }, {
    "tStartMs": 189420,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "That's way higher than the\nInternational Space Station."
    } ]
  }, {
    "tStartMs": 192810,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, what was causing this?"
    } ]
  }, {
    "tStartMs": 195750,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Well, there is one known\nsource of radio interference"
    } ]
  }, {
    "tStartMs": 199140,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "from space, which is the sun."
    } ]
  }, {
    "tStartMs": 203400,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "In November 2025,"
    } ]
  }, {
    "tStartMs": 205699,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "a major solar storm disrupted\nGPS positioning globally"
    } ]
  }, {
    "tStartMs": 207600,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "for several hours."
    } ]
  }, {
    "tStartMs": 210480,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So, could these interference\nevents be caused by the sun?"
    } ]
  }, {
    "tStartMs": 213810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "There were certainly question marks."
    } ]
  }, {
    "tStartMs": 217020,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Solar interference typically builds up"
    } ]
  }, {
    "tStartMs": 218730,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and fades over tens to\nhundreds of seconds."
    } ]
  }, {
    "tStartMs": 221760,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But these events were abrupt,"
    } ]
  }, {
    "tStartMs": 223410,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "short bursts of only\nthree to five seconds."
    } ]
  }, {
    "tStartMs": 226440,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Another important clue was the frequencies"
    } ]
  }, {
    "tStartMs": 228450,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that were disrupted."
    } ]
  }, {
    "tStartMs": 230250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Solar interference\ntypically spans a wide range"
    } ]
  }, {
    "tStartMs": 232620,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "of radio frequencies,"
    } ]
  }, {
    "tStartMs": 234770,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "whereas this interference was confined"
    } ]
  }, {
    "tStartMs": 235830,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to a very narrow slice,\njust five megahertz wide,"
    } ]
  }, {
    "tStartMs": 238920,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "centered at 1,577.5 megahertz."
    } ]
  }, {
    "tStartMs": 242370,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "That's right in the part of\nthe spectrum used by GPS."
    } ]
  }, {
    "tStartMs": 246060,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And the final nail in the coffin\nis that solar radio bursts"
    } ]
  }, {
    "tStartMs": 249270,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "affect the entire sunlit\nside of the earth."
    } ]
  }, {
    "tStartMs": 251910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But what the researchers were seeing here"
    } ]
  }, {
    "tStartMs": 253770,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "was much more concentrated,"
    } ]
  }, {
    "tStartMs": 255360,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "consistently centered over Europe."
    } ]
  }, {
    "tStartMs": 258450,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So, Todd and Zach realized the only thing"
    } ]
  }, {
    "tStartMs": 261030,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that could be causing\nthis was a satellite,"
    } ]
  }, {
    "tStartMs": 263490,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which left them with just one question."
    } ]
  }, {
    "tStartMs": 266340,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "- Is it intentional or is it accidental?"
    } ]
  }, {
    "tStartMs": 270270,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Both my student and I looked at this"
    } ]
  }, {
    "tStartMs": 271680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and said, unprecedented."
    } ]
  }, {
    "tStartMs": 273720,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "We've never seen this before."
    } ]
  }, {
    "tStartMs": 275340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The world has never seen this before."
    } ]
  }, {
    "tStartMs": 277680,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "- [Host] This satellite\nseemed to be targeting GPS."
    } ]
  }, {
    "tStartMs": 283320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Or rather what most of us call GPS."
    } ]
  }, {
    "tStartMs": 286200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That is just the shorthand."
    } ]
  }, {
    "tStartMs": 287400,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "GPS is the American system,\nbut there are others,"
    } ]
  }, {
    "tStartMs": 290190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "including the Russian\none, the European one,"
    } ]
  }, {
    "tStartMs": 292080,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "and the Chinese one."
    } ]
  }, {
    "tStartMs": 293010,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And your phone is actually"
    } ]
  }, {
    "tStartMs": 294750,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of these satellites to try\nand tell you where you are."
    } ]
  }, {
    "tStartMs": 297210,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "These systems are known"
    } ]
  }, {
    "tStartMs": 298290,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "as Global Navigation\nSatellite Systems or GNSS."
    } ]
  }, {
    "tStartMs": 302700,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "And when the U.S. military\nfirst developed the system"
    } ]
  }, {
    "tStartMs": 304910,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "in the 1970s,"
    } ]
  }, {
    "tStartMs": 306630,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "they wanted to prove how\nwell it really worked."
    } ]
  }, {
    "tStartMs": 309360,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "So, the GPS program office\nset itself an ambitious goal"
    } ]
  }, {
    "tStartMs": 313230,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to use GPS to drop five bombs in a row"
    } ]
  }, {
    "tStartMs": 316500,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "into the same hole from a moving plane."
    } ]
  }, {
    "tStartMs": 320280,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- They set up a chair next to the site"
    } ]
  }, {
    "tStartMs": 323580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that the bombs are going to be going into."
    } ]
  }, {
    "tStartMs": 325410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Wait, what?"
    } ]
  }, {
    "tStartMs": 327639,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "If anyone doubts that\nwe can drop the bombs"
    } ]
  }, {
    "tStartMs": 328472,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in the same hole,"
    } ]
  }, {
    "tStartMs": 330669,
    "dDurationMs": 1124,
    "segs": [ {
      "utf8": "you're welcome to go and stand\nright there and watch out."
    } ]
  }, {
    "tStartMs": 333090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "(bombs blasting)"
    } ]
  }, {
    "tStartMs": 335700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- So how does GPS work?"
    } ]
  }, {
    "tStartMs": 338100,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Well, think about what your\nphone is actually trying to do"
    } ]
  }, {
    "tStartMs": 340620,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "to tell you where you are."
    } ]
  }, {
    "tStartMs": 342910,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "It's listening to signals from satellites."
    } ]
  }, {
    "tStartMs": 343770,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And those signals can tell it two things."
    } ]
  }, {
    "tStartMs": 345690,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "First, the position of\nthe satellite in space."
    } ]
  }, {
    "tStartMs": 348090,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And second, the exact\ntime the signal was sent."
    } ]
  }, {
    "tStartMs": 351060,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "And then the receiver can compare"
    } ]
  }, {
    "tStartMs": 352170,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that to when the signal arrives."
    } ]
  }, {
    "tStartMs": 353730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And you can use that time difference,"
    } ]
  }, {
    "tStartMs": 355350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "multiply it by the speed of\nlight, and you get the distance."
    } ]
  }, {
    "tStartMs": 358110,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So, if it took the signal 0.07 seconds,"
    } ]
  }, {
    "tStartMs": 361140,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that must mean you're around\n21,000 kilometers away"
    } ]
  }, {
    "tStartMs": 363630,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "from the satellite."
    } ]
  }, {
    "tStartMs": 365250,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If you're only using a single satellite,"
    } ]
  }, {
    "tStartMs": 367350,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "that puts you somewhere on\na huge sphere around it."
    } ]
  }, {
    "tStartMs": 370770,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Now you can add a second one,"
    } ]
  }, {
    "tStartMs": 372300,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and that will narrow your position down"
    } ]
  }, {
    "tStartMs": 374190,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to this circle where the\ntwo spheres intersect."
    } ]
  }, {
    "tStartMs": 377490,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "If you add a third,\nyou will narrow it down"
    } ]
  }, {
    "tStartMs": 379560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to only two possible points."
    } ]
  }, {
    "tStartMs": 381450,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And only one of these is\nactually on Earth's surface."
    } ]
  }, {
    "tStartMs": 384720,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "So, you might think three\nsatellites is all you need."
    } ]
  }, {
    "tStartMs": 389160,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "We have three equations,\none for each satellite,"
    } ]
  }, {
    "tStartMs": 391920,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and three unknowns that are\nmy position, x, y, and z."
    } ]
  }, {
    "tStartMs": 396960,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So, on the left side, I\nhave the geometric distance"
    } ]
  }, {
    "tStartMs": 399330,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "between me and each of\nthe three satellites."
    } ]
  }, {
    "tStartMs": 401640,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And on the right side, I have\nthe measured signal time,"
    } ]
  }, {
    "tStartMs": 404130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "all multiplied by the speed of light."
    } ]
  }, {
    "tStartMs": 406230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Now, satellites have atomic clocks,"
    } ]
  }, {
    "tStartMs": 408480,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "so their timing drifts"
    } ]
  }, {
    "tStartMs": 409950,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "by only three seconds every million years."
    } ]
  }, {
    "tStartMs": 412980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But my phone does not\ncontain an atomic clock,"
    } ]
  }, {
    "tStartMs": 415920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "so its clock can drift"
    } ]
  }, {
    "tStartMs": 417360,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "by that much in just a couple of days."
    } ]
  }, {
    "tStartMs": 420180,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And a timing error of just\n100 nanoseconds throws off"
    } ]
  }, {
    "tStartMs": 423750,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "your position by 30 meters."
    } ]
  }, {
    "tStartMs": 426120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So, in reality, each\ndistance is slightly wrong,"
    } ]
  }, {
    "tStartMs": 429360,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "which means the position you\ncalculate is slightly off too."
    } ]
  }, {
    "tStartMs": 433170,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So now, instead of just\nsolving for position,"
    } ]
  }, {
    "tStartMs": 435330,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I also have to solve for the clock error."
    } ]
  }, {
    "tStartMs": 437430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So, let's call that b."
    } ]
  }, {
    "tStartMs": 439620,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But now I have three\nequations and four unknowns,"
    } ]
  }, {
    "tStartMs": 442290,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "which is unsolvable."
    } ]
  }, {
    "tStartMs": 443400,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, I can fix that by\nadding a fourth equation"
    } ]
  }, {
    "tStartMs": 446250,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "or a fourth satellite."
    } ]
  }, {
    "tStartMs": 448350,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Four equations, four unknowns,"
    } ]
  }, {
    "tStartMs": 450030,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that makes the system solvable."
    } ]
  }, {
    "tStartMs": 451710,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Okay, but we've made one key assumption,"
    } ]
  }, {
    "tStartMs": 453810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that when I'm calculating my position,"
    } ]
  }, {
    "tStartMs": 455820,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I know where the satellite is."
    } ]
  }, {
    "tStartMs": 457440,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And sure, it can tell me where it is,"
    } ]
  }, {
    "tStartMs": 459060,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but its position around the Earth"
    } ]
  }, {
    "tStartMs": 460470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and its speed are constantly changing."
    } ]
  }, {
    "tStartMs": 462480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So how does the satellite actually know"
    } ]
  }, {
    "tStartMs": 464190,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where it is in the first place?"
    } ]
  }, {
    "tStartMs": 466350,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- The GPS satellites need\nto be told where they are,"
    } ]
  }, {
    "tStartMs": 469290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and they're told where they\nare with ground stations"
    } ]
  }, {
    "tStartMs": 471270,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "that monitor them."
    } ]
  }, {
    "tStartMs": 473660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And the ground stations have to know"
    } ]
  }, {
    "tStartMs": 474493,
    "dDurationMs": 1277,
    "segs": [ {
      "utf8": "where they are to tell the\nsatellites where they are."
    } ]
  }, {
    "tStartMs": 475770,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- [Gregor] But the Earth\nitself is constantly shifting"
    } ]
  }, {
    "tStartMs": 478650,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "as the continents move."
    } ]
  }, {
    "tStartMs": 480600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- So, how do we work out\nwhere the ground stations are?"
    } ]
  }, {
    "tStartMs": 482880,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "You work out using quasars\nwhere the ground stations are."
    } ]
  }, {
    "tStartMs": 486030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- [Gregor] Because they're\nbillions of light years away,"
    } ]
  }, {
    "tStartMs": 488130,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "quasars appear almost perfectly\nfixed in the night sky,"
    } ]
  }, {
    "tStartMs": 491820,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "which means we can use\nthem as reference points,"
    } ]
  }, {
    "tStartMs": 494550,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "much like early explorers\nnavigating by the stars."
    } ]
  }, {
    "tStartMs": 497970,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "A small fraction"
    } ]
  }, {
    "tStartMs": 499000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "of quasars are extremely\nbright radio sources."
    } ]
  }, {
    "tStartMs": 502350,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "When those radio waves reach Earth,"
    } ]
  }, {
    "tStartMs": 504720,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "telescopes around the world detect them"
    } ]
  }, {
    "tStartMs": 506670,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "at slightly different times."
    } ]
  }, {
    "tStartMs": 508740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "From those tiny differences\nin arrival time,"
    } ]
  }, {
    "tStartMs": 511080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you can precisely determine\nthe relative position"
    } ]
  }, {
    "tStartMs": 513540,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of the telescopes."
    } ]
  }, {
    "tStartMs": 514950,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And by making lots of those\nmeasurements over time,"
    } ]
  }, {
    "tStartMs": 517680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "you can build a precise map"
    } ]
  }, {
    "tStartMs": 519450,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "of how the Earth itself\nmoves, continents included."
    } ]
  }, {
    "tStartMs": 523950,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "GPS ground stations are\ntied into that same map."
    } ]
  }, {
    "tStartMs": 528450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Ramsey] The ground\nstations tell the satellites"
    } ]
  }, {
    "tStartMs": 529980,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "where they are,"
    } ]
  }, {
    "tStartMs": 531117,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "and then that's how you\nwork out where you are."
    } ]
  }, {
    "tStartMs": 533378,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "(Gregor chuckles)"
    } ]
  }, {
    "tStartMs": 535080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- You just blew my mind."
    } ]
  }, {
    "tStartMs": 536640,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- So, we're always navigating\nby the stars, just via GPS."
    } ]
  }, {
    "tStartMs": 541830,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- And in reality, your\nphone isn't connected"
    } ]
  }, {
    "tStartMs": 543630,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to just four satellites."
    } ]
  }, {
    "tStartMs": 544830,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It's usually far more than that."
    } ]
  }, {
    "tStartMs": 546720,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Mine right now is using,\nit's like over 20 satellites."
    } ]
  }, {
    "tStartMs": 550380,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "That's because the\nsystem is doing much more"
    } ]
  }, {
    "tStartMs": 552930,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "than just solving for four equations."
    } ]
  }, {
    "tStartMs": 555660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Say you're on this little street in Paris"
    } ]
  }, {
    "tStartMs": 557550,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and you open maps and you try\nto figure out where you are."
    } ]
  }, {
    "tStartMs": 560190,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Turns out there are a lot of\nthings that can throw this off."
    } ]
  }, {
    "tStartMs": 562800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "There's the relatively simple ones,"
    } ]
  }, {
    "tStartMs": 564330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "like taking into account\nspecial and general relativity."
    } ]
  }, {
    "tStartMs": 567330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "If you didn't correct for that,"
    } ]
  }, {
    "tStartMs": 568800,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "your position would drift\nabout 11 kilometers per day,"
    } ]
  }, {
    "tStartMs": 572130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and you can be anywhere\nwithin this entire area."
    } ]
  }, {
    "tStartMs": 575070,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So, the satellites are\nconstantly being monitored"
    } ]
  }, {
    "tStartMs": 577530,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and updated, and they send\ndown timing corrections"
    } ]
  }, {
    "tStartMs": 579900,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that your phone applies in real time."
    } ]
  }, {
    "tStartMs": 581850,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Now, on top of that, in the fraction"
    } ]
  }, {
    "tStartMs": 583740,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of a second that it takes\nfor the signal to reach you,"
    } ]
  }, {
    "tStartMs": 586230,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the Earth has actually rotated slightly."
    } ]
  }, {
    "tStartMs": 588360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So, when your phone\nfigures out where you are,"
    } ]
  }, {
    "tStartMs": 590430,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "it also has to account for\nthe fact where Paris was"
    } ]
  }, {
    "tStartMs": 592980,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "when the signal was sent,\nnot where it is now."
    } ]
  }, {
    "tStartMs": 595800,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "If you don't correct for that,\nthat adds about 20 meters"
    } ]
  }, {
    "tStartMs": 598740,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "of error, enough that you're\nnot even on the same block."
    } ]
  }, {
    "tStartMs": 601650,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And of course, the signal"
    } ]
  }, {
    "tStartMs": 602790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "has to pass through Earth's atmosphere."
    } ]
  }, {
    "tStartMs": 605160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Now, the ionosphere will add"
    } ]
  }, {
    "tStartMs": 606570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "between 5 and 15 meters\nof error to your position,"
    } ]
  }, {
    "tStartMs": 609600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and the lower levels of the\natmosphere, with weather"
    } ]
  }, {
    "tStartMs": 612600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and pressure and humidity,\nwill add another meter or two."
    } ]
  }, {
    "tStartMs": 616200,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "So, if you don't account for that,"
    } ]
  }, {
    "tStartMs": 617340,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you'll still be on the\nwrong side of the street."
    } ]
  }, {
    "tStartMs": 619440,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And that's where the extra\nsatellites come in handy."
    } ]
  }, {
    "tStartMs": 621870,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They give your phone extra\nmeasurements to separate out"
    } ]
  }, {
    "tStartMs": 624390,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the errors and give you a\nbetter fix of your position."
    } ]
  }, {
    "tStartMs": 626790,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "So ultimately, it can be\naccurate down to 3 to 5 meters,"
    } ]
  }, {
    "tStartMs": 630540,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "which is pretty incredible if you think"
    } ]
  }, {
    "tStartMs": 631770,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "about what it takes to solve this."
    } ]
  }, {
    "tStartMs": 634620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And with the most advanced GNSS tech,"
    } ]
  }, {
    "tStartMs": 637200,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "you can push this even\nfurther to a few centimeters."
    } ]
  }, {
    "tStartMs": 640260,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But at this point, you actually\nhave to start accounting"
    } ]
  }, {
    "tStartMs": 642240,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for stuff like how\ngravity bends space-time"
    } ]
  }, {
    "tStartMs": 644490,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and delays the signal."
    } ]
  }, {
    "tStartMs": 646080,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But all of this only works"
    } ]
  }, {
    "tStartMs": 648600,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "if you're actually able\nto hear those signals."
    } ]
  }, {
    "tStartMs": 650970,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- [Ramsey] When the\nsignal arrives from space,"
    } ]
  }, {
    "tStartMs": 653340,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it's traveled 20,000\nkilometers to get here,"
    } ]
  }, {
    "tStartMs": 656100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and it was only transmitted\nwith about 50 watts of power."
    } ]
  }, {
    "tStartMs": 659100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, it's like an old school light bulb"
    } ]
  }, {
    "tStartMs": 661350,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "two Earth diameters away."
    } ]
  }, {
    "tStartMs": 664410,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Gregor] And because\nthat power spreads out"
    } ]
  }, {
    "tStartMs": 666060,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "over such a vast distance,"
    } ]
  }, {
    "tStartMs": 667710,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the received GPS signal at your\nphone is only about a tenth"
    } ]
  }, {
    "tStartMs": 671550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of a quadrillionth of a watt,"
    } ]
  }, {
    "tStartMs": 673440,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "or 10 to the negative 16 watts."
    } ]
  }, {
    "tStartMs": 675990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- It's insanely quiet."
    } ]
  }, {
    "tStartMs": 678060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- Which means it doesn't\ntake much to drown it out."
    } ]
  }, {
    "tStartMs": 680880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "If you broadcast enough\nnoise at the same frequency,"
    } ]
  }, {
    "tStartMs": 683640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you can overwhelm the signal until"
    } ]
  }, {
    "tStartMs": 685080,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it becomes indistinguishable\nfrom the background."
    } ]
  }, {
    "tStartMs": 687690,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "This is called jamming."
    } ]
  }, {
    "tStartMs": 690660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And a lot of these navigation systems use"
    } ]
  }, {
    "tStartMs": 692460,
    "dDurationMs": 3993,
    "segs": [ {
      "utf8": "the radio spectrum, roughly\nbetween 1.1 and 1.6 gigahertz."
    } ]
  }, {
    "tStartMs": 699270,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Lower frequencies travel\nwell through the atmosphere,"
    } ]
  }, {
    "tStartMs": 701760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but they require much larger antennas."
    } ]
  }, {
    "tStartMs": 704340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Higher frequencies allow\nfor smaller antennas,"
    } ]
  }, {
    "tStartMs": 706860,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but the signals are much\nmore easily absorbed"
    } ]
  }, {
    "tStartMs": 708930,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and scattered, especially in bad weather."
    } ]
  }, {
    "tStartMs": 712140,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So, this band is a kind of sweet spot"
    } ]
  }, {
    "tStartMs": 714330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that navigation systems rely on."
    } ]
  }, {
    "tStartMs": 716670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Which means if something\ninterferes with it,"
    } ]
  }, {
    "tStartMs": 718890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it can affect multiple systems at once."
    } ]
  }, {
    "tStartMs": 721590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "That's why this part of a\nspectrum is tightly protected."
    } ]
  }, {
    "tStartMs": 724800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Nothing else is supposed\nto be transmitting here."
    } ]
  }, {
    "tStartMs": 727560,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And deliberately interfering"
    } ]
  }, {
    "tStartMs": 729030,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "with these signals is\nillegal in most countries,"
    } ]
  }, {
    "tStartMs": 732300,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "but something was."
    } ]
  }, {
    "tStartMs": 733530,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Something powerful enough"
    } ]
  }, {
    "tStartMs": 734730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to overwhelm satellite navigation across"
    } ]
  }, {
    "tStartMs": 737070,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "an entire continent."
    } ]
  }, {
    "tStartMs": 738510,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Which brings us back to the question"
    } ]
  }, {
    "tStartMs": 739860,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "facing Professor Todd Humphreys."
    } ]
  }, {
    "tStartMs": 741720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Was this accidental?"
    } ]
  }, {
    "tStartMs": 743040,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Or was someone flooding\nthis band on purpose?"
    } ]
  }, {
    "tStartMs": 746760,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- It's, you know, a mystery novel here"
    } ]
  }, {
    "tStartMs": 749310,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "where you're trying to figure\nout whether it was the butler"
    } ]
  }, {
    "tStartMs": 752190,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "in the kitchen with the crowbar, right?"
    } ]
  }, {
    "tStartMs": 755370,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And we have to put all\nof the clues together."
    } ]
  }, {
    "tStartMs": 758430,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If it had been random,"
    } ]
  }, {
    "tStartMs": 760020,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "occurring because of some\nfailure in a satellite,"
    } ]
  }, {
    "tStartMs": 762690,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "maybe some amplifier gets\ntoo hot and misbehaves,"
    } ]
  }, {
    "tStartMs": 767520,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "then you'd expect it to happen\nequally likely on a Monday"
    } ]
  }, {
    "tStartMs": 772110,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "and a Friday, right?"
    } ]
  }, {
    "tStartMs": 774780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Host] But when they\nwent back through the data,"
    } ]
  }, {
    "tStartMs": 776430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "something strange emerged."
    } ]
  }, {
    "tStartMs": 777990,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The interference events were\nhappening mostly on Tuesdays,"
    } ]
  }, {
    "tStartMs": 781110,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "Wednesdays and Thursdays during\nbusiness hours in Europe."
    } ]
  }, {
    "tStartMs": 785670,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- So, tell me, tell me\nwhat amplifier tends"
    } ]
  }, {
    "tStartMs": 789450,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "to fail during business hours\nin Europe on Wednesdays."
    } ]
  }, {
    "tStartMs": 794640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- So now we know this\nprobably isn't random."
    } ]
  }, {
    "tStartMs": 797700,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "There's likely human input."
    } ]
  }, {
    "tStartMs": 799740,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But that doesn't necessarily mean"
    } ]
  }, {
    "tStartMs": 801600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "it's intentional or malicious."
    } ]
  }, {
    "tStartMs": 803760,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So, the hunt was on to track\ndown the actual source."
    } ]
  }, {
    "tStartMs": 807330,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "But that turned out to be\nharder than you might think."
    } ]
  }, {
    "tStartMs": 810510,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Because there were still so many unknowns."
    } ]
  }, {
    "tStartMs": 813750,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "In situations like this,"
    } ]
  }, {
    "tStartMs": 815190,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "uncertainty can quickly turn\ninto competing narratives."
    } ]
  }, {
    "tStartMs": 818670,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We've seen it before."
    } ]
  }, {
    "tStartMs": 820020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "When the EU chief's\nplane was allegedly hit"
    } ]
  }, {
    "tStartMs": 822660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "by GPS interference last year,"
    } ]
  }, {
    "tStartMs": 824370,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "over 150 news outlets reported on it."
    } ]
  }, {
    "tStartMs": 827160,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But depending on where you saw the story,"
    } ]
  }, {
    "tStartMs": 828930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "your perception could\nbe completely different."
    } ]
  }, {
    "tStartMs": 831480,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "If you saw Le Monde first,"
    } ]
  }, {
    "tStartMs": 833160,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "you might have come away thinking"
    } ]
  }, {
    "tStartMs": 834630,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "it might be Russia's fault."
    } ]
  }, {
    "tStartMs": 836370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If you saw Newsweek first,"
    } ]
  }, {
    "tStartMs": 837960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "you would definitely think it was Russia."
    } ]
  }, {
    "tStartMs": 840480,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And if you saw this headline, well,"
    } ]
  }, {
    "tStartMs": 842670,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "you might question the veracity\nof the story altogether."
    } ]
  }, {
    "tStartMs": 845520,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Three headlines, three\nentirely different conclusions."
    } ]
  }, {
    "tStartMs": 849090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "That's why we use today's\nsponsor Ground News."
    } ]
  }, {
    "tStartMs": 851700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "They're a website and app designed"
    } ]
  }, {
    "tStartMs": 853230,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to make reading the news\neasier and more data-driven."
    } ]
  }, {
    "tStartMs": 856260,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Every day they pull in\nthousands of stories"
    } ]
  }, {
    "tStartMs": 858330,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "from around the world."
    } ]
  }, {
    "tStartMs": 859473,
    "dDurationMs": 2097,
    "segs": [ {
      "utf8": "And each story comes\nwith visual breakdowns"
    } ]
  }, {
    "tStartMs": 861570,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "of political leaning,\nfactuality rating and ownership."
    } ]
  }, {
    "tStartMs": 864990,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "This is all backed by ratings"
    } ]
  }, {
    "tStartMs": 866700,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "from three independent media\nmonitoring organizations."
    } ]
  }, {
    "tStartMs": 869910,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Let's go back to that\nstory to see it in action."
    } ]
  }, {
    "tStartMs": 872520,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Right away, you can see"
    } ]
  }, {
    "tStartMs": 873540,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that over 150 news outlets\nreported on the story."
    } ]
  }, {
    "tStartMs": 876660,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Below that, you can see that coverage was"
    } ]
  }, {
    "tStartMs": 878730,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "split relatively evenly\nacross the political spectrum."
    } ]
  }, {
    "tStartMs": 881670,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And below that, you can check"
    } ]
  }, {
    "tStartMs": 882990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the overall factuality and ownership."
    } ]
  }, {
    "tStartMs": 885390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Even see who broke the news."
    } ]
  }, {
    "tStartMs": 887430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They even have a bias comparison feature"
    } ]
  }, {
    "tStartMs": 889470,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that highlights specific\ndifferences in the contents"
    } ]
  }, {
    "tStartMs": 892080,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "of the articles."
    } ]
  }, {
    "tStartMs": 893013,
    "dDurationMs": 2487,
    "segs": [ {
      "utf8": "One of my favorite things\nis their blind spot feed,"
    } ]
  }, {
    "tStartMs": 895500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which shows you stories\nthat are underreported"
    } ]
  }, {
    "tStartMs": 897600,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "by one side of the political\nspectrum or the other."
    } ]
  }, {
    "tStartMs": 900630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Staying informed with accurate information"
    } ]
  }, {
    "tStartMs": 902880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "has become a full-time job."
    } ]
  }, {
    "tStartMs": 904890,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But that's what makes\nGround News so valuable."
    } ]
  }, {
    "tStartMs": 907380,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Their data-driven approach helps\nmake information accessible"
    } ]
  }, {
    "tStartMs": 910380,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "and digestible for everyone\nin minutes rather than hours."
    } ]
  }, {
    "tStartMs": 914850,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, if you, like us, care\nabout getting to the truth,"
    } ]
  }, {
    "tStartMs": 917700,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "go to ground.news/VE\nor scan this QR code."
    } ]
  }, {
    "tStartMs": 922020,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Our link gets you 40%\noff their vantage plan."
    } ]
  }, {
    "tStartMs": 924930,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "So, I wanna thank Ground News"
    } ]
  }, {
    "tStartMs": 925980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "for sponsoring this part of the video."
    } ]
  }, {
    "tStartMs": 928020,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "And now, back to the hunt for the source."
    } ]
  }, {
    "tStartMs": 931059,
    "dDurationMs": 2091,
    "segs": [ {
      "utf8": "- To do this, we have to set up a kind"
    } ]
  }, {
    "tStartMs": 933150,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of elaborate estimation problem,"
    } ]
  }, {
    "tStartMs": 935340,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but there are many unknowns."
    } ]
  }, {
    "tStartMs": 938250,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- A jammer works by\nbroadcasting a stronger signal"
    } ]
  }, {
    "tStartMs": 940470,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "in the same frequency band."
    } ]
  }, {
    "tStartMs": 942840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's kind of like yelling\nover someone whispering."
    } ]
  }, {
    "tStartMs": 945720,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So, if this were a jammer on the ground,"
    } ]
  }, {
    "tStartMs": 947910,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "you could track it down by\nlooking at signal strength."
    } ]
  }, {
    "tStartMs": 950580,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "The closer you are, the\nstronger the signal will get."
    } ]
  }, {
    "tStartMs": 953910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But once you're dealing\nwith something in space,"
    } ]
  }, {
    "tStartMs": 956370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that intuition breaks down."
    } ]
  }, {
    "tStartMs": 958410,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "To work backwards from signal strength,"
    } ]
  }, {
    "tStartMs": 960210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "you'd need to know how much power"
    } ]
  }, {
    "tStartMs": 961740,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the satellite was transmitting,"
    } ]
  }, {
    "tStartMs": 963330,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and the exact shape and\ndirection of its beam."
    } ]
  }, {
    "tStartMs": 966840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Even how each receiver's antenna responds"
    } ]
  }, {
    "tStartMs": 969240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to signals arriving from different angles."
    } ]
  }, {
    "tStartMs": 972120,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And at 1,200 kilometers above the Earth,"
    } ]
  }, {
    "tStartMs": 974130,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "very different satellite\npositions can produce"
    } ]
  }, {
    "tStartMs": 976080,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "almost identical patterns on the ground."
    } ]
  }, {
    "tStartMs": 978930,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So instead of trying to pinpoint\nthe transmitter directly,"
    } ]
  }, {
    "tStartMs": 982170,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the researchers used a simpler filter."
    } ]
  }, {
    "tStartMs": 984750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "If a satellite caused\ninterference at all these stations"
    } ]
  }, {
    "tStartMs": 987420,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "at the same time, then it had to be"
    } ]
  }, {
    "tStartMs": 989310,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "above the horizon for all of them at once."
    } ]
  }, {
    "tStartMs": 992430,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Right now, there are over 15,000\nactive satellites in orbit."
    } ]
  }, {
    "tStartMs": 996120,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "But that one constraint lets\nyou eliminate over 98% of them."
    } ]
  }, {
    "tStartMs": 1000380,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "That still leaves around\n200 possibilities."
    } ]
  }, {
    "tStartMs": 1003290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "What's left are satellites\nin very high orbits,"
    } ]
  }, {
    "tStartMs": 1006050,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "many of them in or near\nthe geostationary belt,"
    } ]
  }, {
    "tStartMs": 1009440,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "where they move at the same\nrate as the Earth rotates,"
    } ]
  }, {
    "tStartMs": 1012230,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "so they stay fixed over one point."
    } ]
  }, {
    "tStartMs": 1014690,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "From about 36,000 kilometers up,"
    } ]
  }, {
    "tStartMs": 1017180,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "a single one can see a huge\nportion of the Earth at once."
    } ]
  }, {
    "tStartMs": 1021140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "However, if the same satellite"
    } ]
  }, {
    "tStartMs": 1022940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "caused multiple events on different days,"
    } ]
  }, {
    "tStartMs": 1025070,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "then it has to satisfy that\ncondition every single time,"
    } ]
  }, {
    "tStartMs": 1028130,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "which narrows it down to\njust 14 possible suspects."
    } ]
  }, {
    "tStartMs": 1032600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- So, what kind of satellites"
    } ]
  }, {
    "tStartMs": 1034160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and countries were in these 14?"
    } ]
  }, {
    "tStartMs": 1035960,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- Well, there were several\ninteresting candidates."
    } ]
  }, {
    "tStartMs": 1039110,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "One was a satellite operated by Algeria,"
    } ]
  }, {
    "tStartMs": 1042830,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and it even had, on public documentation,"
    } ]
  }, {
    "tStartMs": 1045980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a transmitter in the same frequency band"
    } ]
  }, {
    "tStartMs": 1048380,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "we were seeing interference on."
    } ]
  }, {
    "tStartMs": 1049790,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "- So, they took a closer\nlook, and on paper it fit."
    } ]
  }, {
    "tStartMs": 1053450,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It was visible to all of\nthe reference stations,"
    } ]
  }, {
    "tStartMs": 1056300,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and it could transmit in exactly\nthe band they were seeing."
    } ]
  }, {
    "tStartMs": 1060140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "This looked like it could be the answer."
    } ]
  }, {
    "tStartMs": 1062720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But they had a nagging doubt that some"
    } ]
  }, {
    "tStartMs": 1065420,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of the most distant stations in Svalbard"
    } ]
  }, {
    "tStartMs": 1067970,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and western Greenland,"
    } ]
  }, {
    "tStartMs": 1069350,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "this satellite was\nbarely above the horizon,"
    } ]
  }, {
    "tStartMs": 1072170,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which meant if it was the source,"
    } ]
  }, {
    "tStartMs": 1074210,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the signal would have to be\nskimming across the Earth"
    } ]
  }, {
    "tStartMs": 1077150,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and just barely glancing into the antenna"
    } ]
  }, {
    "tStartMs": 1079580,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "of these receivers."
    } ]
  }, {
    "tStartMs": 1080693,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Now, that's not impossible."
    } ]
  }, {
    "tStartMs": 1082862,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": "Low angle signals can be picked up,"
    } ]
  }, {
    "tStartMs": 1084470,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but the more researchers looked,"
    } ]
  }, {
    "tStartMs": 1086780,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the less certain they\nbecame that this satellite"
    } ]
  }, {
    "tStartMs": 1089150,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "was actually the source."
    } ]
  }, {
    "tStartMs": 1090590,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So, they examined data from GNSS receivers"
    } ]
  }, {
    "tStartMs": 1093320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that were tracking this satellite"
    } ]
  }, {
    "tStartMs": 1094880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "during the interference events."
    } ]
  }, {
    "tStartMs": 1096950,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "- It looked just like all of\nthe other ordinary GPS signals"
    } ]
  }, {
    "tStartMs": 1101810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that were getting hammered\nby this interference."
    } ]
  }, {
    "tStartMs": 1104090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So, the ratio of the signal power"
    } ]
  }, {
    "tStartMs": 1106880,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to the background noise also dropped"
    } ]
  }, {
    "tStartMs": 1108860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and dropped in the same proportion that"
    } ]
  }, {
    "tStartMs": 1111560,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "the other GPS signals were\ndropping at the same time."
    } ]
  }, {
    "tStartMs": 1115370,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "This was not the attacker."
    } ]
  }, {
    "tStartMs": 1116510,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "This was just another\nlegitimate signal in the L band"
    } ]
  }, {
    "tStartMs": 1121250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that had been interfered with."
    } ]
  }, {
    "tStartMs": 1122930,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The Algerian satellite\nwasn't the source."
    } ]
  }, {
    "tStartMs": 1125390,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "It was another victim."
    } ]
  }, {
    "tStartMs": 1127820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But what about the other 13?"
    } ]
  }, {
    "tStartMs": 1129560,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Any one of them could have been visible"
    } ]
  }, {
    "tStartMs": 1131060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to all the stations at once."
    } ]
  }, {
    "tStartMs": 1133220,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So geometrically, they\ncould all be the culprit."
    } ]
  }, {
    "tStartMs": 1136670,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But that's where the\ntrail started to go cold."
    } ]
  }, {
    "tStartMs": 1139160,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I mean, none of them had clear\npublic documentation showing"
    } ]
  }, {
    "tStartMs": 1142130,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "they could transmit and\njam the right frequencies."
    } ]
  }, {
    "tStartMs": 1145130,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "And some of them had barely\nany public information at all."
    } ]
  }, {
    "tStartMs": 1149180,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- We couldn't narrow it down further"
    } ]
  }, {
    "tStartMs": 1150560,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "because of all of these things"
    } ]
  }, {
    "tStartMs": 1152510,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "we didn't know about the\nsignals they were broadcasting,"
    } ]
  }, {
    "tStartMs": 1156620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "how intense they were,\nwhat their pattern was."
    } ]
  }, {
    "tStartMs": 1159680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, there we were stuck\nfor about four months."
    } ]
  }, {
    "tStartMs": 1162560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- And there was an even\nmore fundamental problem."
    } ]
  }, {
    "tStartMs": 1165170,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Everything they'd done so\nfar relied on one idea,"
    } ]
  }, {
    "tStartMs": 1168110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that all of these interference\nevents were coming"
    } ]
  }, {
    "tStartMs": 1170360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "from a single satellite."
    } ]
  }, {
    "tStartMs": 1172040,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- It was under a really\ncontroversial assumption."
    } ]
  }, {
    "tStartMs": 1175100,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Controversial in that my student"
    } ]
  }, {
    "tStartMs": 1176540,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and I just couldn't come to\nfully embrace this assumption."
    } ]
  }, {
    "tStartMs": 1179900,
    "dDurationMs": 1699,
    "segs": [ {
      "utf8": "If we broke our assumption,"
    } ]
  }, {
    "tStartMs": 1181599,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "then that would relieve"
    } ]
  }, {
    "tStartMs": 1184310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the focus on geostationary satellites."
    } ]
  }, {
    "tStartMs": 1187310,
    "dDurationMs": 2505,
    "segs": [ {
      "utf8": "Then we could open up the\nfocus on many other satellites."
    } ]
  }, {
    "tStartMs": 1189815,
    "dDurationMs": 2685,
    "segs": [ {
      "utf8": "But now instead of 13\nremaining on our list,"
    } ]
  }, {
    "tStartMs": 1192500,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "it would expand to, you know,\nmaybe 100 or more satellites."
    } ]
  }, {
    "tStartMs": 1197030,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- And suddenly, instead of\nclosing in on an answer,"
    } ]
  }, {
    "tStartMs": 1200210,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "it felt like they were back at square one."
    } ]
  }, {
    "tStartMs": 1202580,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So, they needed a completely\ndifferent approach."
    } ]
  }, {
    "tStartMs": 1205820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "All the data they had\nwas from GNSS receivers"
    } ]
  }, {
    "tStartMs": 1208340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that process everything internally."
    } ]
  }, {
    "tStartMs": 1210500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They lock onto satellites,\ntrack signal strength,"
    } ]
  }, {
    "tStartMs": 1212750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and then output a clean\nsimplified measurement,"
    } ]
  }, {
    "tStartMs": 1215000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "how strong that signal is\ncompared to the background noise."
    } ]
  }, {
    "tStartMs": 1217640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And they do that just once per second."
    } ]
  }, {
    "tStartMs": 1220010,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "But these interference"
    } ]
  }, {
    "tStartMs": 1221030,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "bursts only lasted three to five seconds,"
    } ]
  }, {
    "tStartMs": 1223100,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "which means each event is captured"
    } ]
  }, {
    "tStartMs": 1224870,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "in just a handful of samples."
    } ]
  }, {
    "tStartMs": 1226910,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "You can see that the signal dropped,"
    } ]
  }, {
    "tStartMs": 1228620,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but not precisely when it dropped."
    } ]
  }, {
    "tStartMs": 1230690,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Not with enough timing resolution\nto compare one receiver"
    } ]
  }, {
    "tStartMs": 1233300,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to another, to see\nwhich one was hit first,"
    } ]
  }, {
    "tStartMs": 1235490,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "or how the interference\nmoved across the network."
    } ]
  }, {
    "tStartMs": 1238820,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "What they needed was the\nraw radio signal itself."
    } ]
  }, {
    "tStartMs": 1242450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So, they started designing\nspecialized receivers"
    } ]
  }, {
    "tStartMs": 1245000,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "that could capture the data"
    } ]
  }, {
    "tStartMs": 1246110,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "in much higher temporal resolution."
    } ]
  }, {
    "tStartMs": 1248600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The plan was to deploy\nthem all across Europe."
    } ]
  }, {
    "tStartMs": 1251660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But building them, installing them,"
    } ]
  }, {
    "tStartMs": 1253280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and waiting for new events\nto happen would take months,"
    } ]
  }, {
    "tStartMs": 1255950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "maybe years."
    } ]
  }, {
    "tStartMs": 1257330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So, in September 2025,"
    } ]
  }, {
    "tStartMs": 1258950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "they took their investigation public"
    } ]
  }, {
    "tStartMs": 1260450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "at the Institute of Navigation\nConference in Baltimore."
    } ]
  }, {
    "tStartMs": 1263240,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And the response was immediate."
    } ]
  }, {
    "tStartMs": 1265310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "The room was packed."
    } ]
  }, {
    "tStartMs": 1266660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Everyone wanted to know the same thing."
    } ]
  }, {
    "tStartMs": 1268550,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "What was this satellite\nand who was responsible?"
    } ]
  }, {
    "tStartMs": 1271790,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- Honestly, it was one\nof the most fun meetings"
    } ]
  }, {
    "tStartMs": 1274430,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "I've been part of."
    } ]
  }, {
    "tStartMs": 1276310,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It was almost like we\nhad been brought together"
    } ]
  }, {
    "tStartMs": 1277143,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "for a big brainstorming session to see"
    } ]
  }, {
    "tStartMs": 1279020,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "if we could crack this\nproblem as a community"
    } ]
  }, {
    "tStartMs": 1281840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that my student and I had\nnot been able to crack"
    } ]
  }, {
    "tStartMs": 1284240,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "by ourselves."
    } ]
  }, {
    "tStartMs": 1285590,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "- [Host] The question of a\nmystery satellite propagated"
    } ]
  }, {
    "tStartMs": 1287659,
    "dDurationMs": 1831,
    "segs": [ {
      "utf8": "throughout the research community."
    } ]
  }, {
    "tStartMs": 1289490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The German Aerospace Center came up"
    } ]
  }, {
    "tStartMs": 1291170,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "with an ambitious plan to\ntake a large tracking dish,"
    } ]
  }, {
    "tStartMs": 1293960,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "point it at candidate satellites,"
    } ]
  }, {
    "tStartMs": 1295580,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and try to catch the\ninterference in real time."
    } ]
  }, {
    "tStartMs": 1298490,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- But remember, we're trying\nto catch a needle in a haystack"
    } ]
  }, {
    "tStartMs": 1301550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that only shows up over a short interval"
    } ]
  }, {
    "tStartMs": 1303950,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "and only happens once,\nmaybe once or twice a month."
    } ]
  }, {
    "tStartMs": 1308060,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "- [Host] They tracked satellite\nafter satellite and nothing."
    } ]
  }, {
    "tStartMs": 1311960,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "No signal, no anomaly, no breakthrough."
    } ]
  }, {
    "tStartMs": 1315050,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Yet again, the trail went cold."
    } ]
  }, {
    "tStartMs": 1317780,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "Weeks passed, then months,"
    } ]
  }, {
    "tStartMs": 1321320,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "until an email arrived."
    } ]
  }, {
    "tStartMs": 1324950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- I looked at the email\nand then I had to reread it"
    } ]
  }, {
    "tStartMs": 1327470,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "because it was almost\nlike it had come right out"
    } ]
  }, {
    "tStartMs": 1329180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of my dreams."
    } ]
  }, {
    "tStartMs": 1330889,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "You know, this can't possibly be true."
    } ]
  }, {
    "tStartMs": 1332600,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "He had beautiful raw data\nfrom two different stations."
    } ]
  }, {
    "tStartMs": 1335990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- At last, they had what\nthey'd been missing,"
    } ]
  }, {
    "tStartMs": 1338480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the raw radio signal itself."
    } ]
  }, {
    "tStartMs": 1340850,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Samples of the raw voltage\noff the antenna capturing"
    } ]
  }, {
    "tStartMs": 1343550,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the actual digitized radio waves millions"
    } ]
  }, {
    "tStartMs": 1346520,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of times per second from two stations,"
    } ]
  }, {
    "tStartMs": 1348980,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "one in Amsterdam in the Netherlands"
    } ]
  }, {
    "tStartMs": 1350690,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and one in Trondheim in Northern Norway."
    } ]
  }, {
    "tStartMs": 1353180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They captured these interference events"
    } ]
  }, {
    "tStartMs": 1354980,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "on February 11th, 2026."
    } ]
  }, {
    "tStartMs": 1358070,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And now, rather than asking\nhow strong is the signal,"
    } ]
  }, {
    "tStartMs": 1360740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "they could ask, when did it arrive?"
    } ]
  }, {
    "tStartMs": 1363290,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "With this raw data,"
    } ]
  }, {
    "tStartMs": 1364520,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "they isolated a 2.3 second window where"
    } ]
  }, {
    "tStartMs": 1367670,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "both stations recorded the same event."
    } ]
  }, {
    "tStartMs": 1370520,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And because they were\nsampling at tens of megahertz,"
    } ]
  }, {
    "tStartMs": 1373370,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "they could align the two\ndata sets to pinpoint"
    } ]
  }, {
    "tStartMs": 1375920,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the exact moment the\njamming signal arrived"
    } ]
  }, {
    "tStartMs": 1378650,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "at both stations."
    } ]
  }, {
    "tStartMs": 1379880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "This meant they could\nmeasure the tiny difference"
    } ]
  }, {
    "tStartMs": 1381950,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "in when the signal reached each station."
    } ]
  }, {
    "tStartMs": 1384740,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Imagine the signal\nreaches Trondheim roughly"
    } ]
  }, {
    "tStartMs": 1387170,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "139 microseconds before\nit reaches Amsterdam."
    } ]
  }, {
    "tStartMs": 1390590,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Well, that tells you that the\nsource must be slightly closer"
    } ]
  }, {
    "tStartMs": 1393050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to Trondheim than it is to Amsterdam."
    } ]
  }, {
    "tStartMs": 1395090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And that constraint gives you a shape,"
    } ]
  }, {
    "tStartMs": 1397190,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "a curve in space of all\nthe possible locations"
    } ]
  }, {
    "tStartMs": 1400310,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of the source where that\nexact timing difference"
    } ]
  }, {
    "tStartMs": 1402860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "would be observed."
    } ]
  }, {
    "tStartMs": 1404060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "In three dimensions, that\nbecomes a kind of warped surface,"
    } ]
  }, {
    "tStartMs": 1407300,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "a hyperboloid."
    } ]
  }, {
    "tStartMs": 1408710,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Whatever transmitted the\nsignal had to lie somewhere"
    } ]
  }, {
    "tStartMs": 1411350,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "on that surface."
    } ]
  }, {
    "tStartMs": 1412583,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "And because the raw data was\nso incredibly high resolution,"
    } ]
  }, {
    "tStartMs": 1415550,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the margin of error, the\nthickness of that shape,"
    } ]
  }, {
    "tStartMs": 1418490,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "stretching tens of thousands\nof kilometers into space,"
    } ]
  }, {
    "tStartMs": 1421130,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "was only about five meters."
    } ]
  }, {
    "tStartMs": 1424430,
    "dDurationMs": 4457,
    "segs": [ {
      "utf8": "- And because we were so\ninterested in avoiding errors,"
    } ]
  }, {
    "tStartMs": 1429800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "we just determined that\nwe were not going to talk"
    } ]
  }, {
    "tStartMs": 1432020,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "to each other for a week."
    } ]
  }, {
    "tStartMs": 1433190,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "We would do our separate thing for a week."
    } ]
  }, {
    "tStartMs": 1435500,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And then we would come back\ntogether, compare notes,"
    } ]
  }, {
    "tStartMs": 1438410,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and we would hopefully have\nnot made the same mistakes."
    } ]
  }, {
    "tStartMs": 1442160,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And I presented my findings to Zach"
    } ]
  }, {
    "tStartMs": 1443780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and he presented his to me\nand they were not the same."
    } ]
  }, {
    "tStartMs": 1446360,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And I have to admit that\nbecause I'm the professor,"
    } ]
  }, {
    "tStartMs": 1448910,
    "dDurationMs": 3873,
    "segs": [ {
      "utf8": "I was pretty much insistent\nthat my finding was correct."
    } ]
  }, {
    "tStartMs": 1453740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But then he pointed out\na couple of other things,"
    } ]
  }, {
    "tStartMs": 1455240,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "other checks that he'd run."
    } ]
  }, {
    "tStartMs": 1457190,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "And then I realized that\nI had an error in my code."
    } ]
  }, {
    "tStartMs": 1461750,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And once I fixed that error,"
    } ]
  }, {
    "tStartMs": 1463760,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I ended up getting exactly\nthe same time difference"
    } ]
  }, {
    "tStartMs": 1466730,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "of arrival that he did."
    } ]
  }, {
    "tStartMs": 1469280,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- And now they had a way to\ntest every possible satellite,"
    } ]
  }, {
    "tStartMs": 1472220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "not just the 14 from\ntheir earlier predictions."
    } ]
  }, {
    "tStartMs": 1474620,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "For each satellite, they\ntook its known orbit"
    } ]
  }, {
    "tStartMs": 1476840,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and asked if the signal came from here,"
    } ]
  }, {
    "tStartMs": 1478790,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "what timing difference would we expect"
    } ]
  }, {
    "tStartMs": 1480350,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "between Amsterdam and Trondheim?"
    } ]
  }, {
    "tStartMs": 1482270,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Then they compared that\nprediction to the real data."
    } ]
  }, {
    "tStartMs": 1484730,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "If it didn't match, the\nsatellite was ruled out."
    } ]
  }, {
    "tStartMs": 1487550,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And since they had a continuous two"
    } ]
  }, {
    "tStartMs": 1489470,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and a half second recording,"
    } ]
  }, {
    "tStartMs": 1491000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "they could take this a step further."
    } ]
  }, {
    "tStartMs": 1493190,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "As the satellite moved,"
    } ]
  }, {
    "tStartMs": 1494600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that hyperboloid would shift\nslightly through space."
    } ]
  }, {
    "tStartMs": 1498200,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So, the real source had to stay aligned"
    } ]
  }, {
    "tStartMs": 1500390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "with it the entire time,"
    } ]
  }, {
    "tStartMs": 1501950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "which made this test incredibly strict."
    } ]
  }, {
    "tStartMs": 1504710,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- And only one satellite was anywhere near"
    } ]
  }, {
    "tStartMs": 1508130,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "this time difference\nof arrival measurement."
    } ]
  }, {
    "tStartMs": 1511820,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "And in fact, it wasn't\njust near, it was dead on."
    } ]
  }, {
    "tStartMs": 1515360,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- The only possible culprit"
    } ]
  }, {
    "tStartMs": 1516920,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "was a Russian satellite, Cosmos 2546."
    } ]
  }, {
    "tStartMs": 1522950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It remained perfectly on the hyperboloid,"
    } ]
  }, {
    "tStartMs": 1525110,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "aligning with their data\nto within 200 meters,"
    } ]
  }, {
    "tStartMs": 1527870,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "which is well within the uncertainty"
    } ]
  }, {
    "tStartMs": 1529340,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "of the satellite's publicly\navailable orbital data."
    } ]
  }, {
    "tStartMs": 1532250,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Now it's worth saying here,\nthis work is still new"
    } ]
  }, {
    "tStartMs": 1534710,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and it hasn't undergone peer\nreview, but independent teams"
    } ]
  }, {
    "tStartMs": 1538160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "in Europe have verified\naspects of these findings."
    } ]
  }, {
    "tStartMs": 1541340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "There was only one slight issue."
    } ]
  }, {
    "tStartMs": 1543260,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Cosmos 2546 was launched\non the 22nd of May, 2020."
    } ]
  }, {
    "tStartMs": 1548360,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "So, it couldn't explain\nevents going back to 2019."
    } ]
  }, {
    "tStartMs": 1552500,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But then they discovered\nthat Cosmos 2546 is part"
    } ]
  }, {
    "tStartMs": 1555290,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "of a constellation of six satellites."
    } ]
  }, {
    "tStartMs": 1558080,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "This constellation is part"
    } ]
  }, {
    "tStartMs": 1559430,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "of Russia's early missile warning system."
    } ]
  }, {
    "tStartMs": 1562610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- It's basically part\nof their Golden Dome."
    } ]
  }, {
    "tStartMs": 1565010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "If you've heard of the U.S. Golden Dome,"
    } ]
  }, {
    "tStartMs": 1567800,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "this is part of the sensory apparatus"
    } ]
  }, {
    "tStartMs": 1571400,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "for the Russian missile detection system."
    } ]
  }, {
    "tStartMs": 1575150,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- They sit in what's\ncalled a Molniya orbit."
    } ]
  }, {
    "tStartMs": 1577670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "A highly elliptical path\nthat carries them high"
    } ]
  }, {
    "tStartMs": 1579860,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "over the Northern hemisphere,"
    } ]
  }, {
    "tStartMs": 1581240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "where they can slow down and linger."
    } ]
  }, {
    "tStartMs": 1583520,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's the way that high\nlatitude countries like Russia"
    } ]
  }, {
    "tStartMs": 1585860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "can get the benefits of something\nlike geostationary orbit"
    } ]
  }, {
    "tStartMs": 1588500,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "across multiple satellites."
    } ]
  }, {
    "tStartMs": 1590330,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But this also means this\nconstellation covers large parts"
    } ]
  }, {
    "tStartMs": 1593450,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "of the globe."
    } ]
  }, {
    "tStartMs": 1595309,
    "dDurationMs": 2671,
    "segs": [ {
      "utf8": "So, they have the capability\nto jam GNSS across a far"
    } ]
  }, {
    "tStartMs": 1597980,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "wider region than we've seen,"
    } ]
  }, {
    "tStartMs": 1599480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "including over the United States."
    } ]
  }, {
    "tStartMs": 1602060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The pattern already told\nus this wasn't random."
    } ]
  }, {
    "tStartMs": 1604880,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The frequency told us it wasn't natural."
    } ]
  }, {
    "tStartMs": 1607610,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "And now we know it's coming\nfrom a military system in orbit."
    } ]
  }, {
    "tStartMs": 1611510,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But intention, well,\nthat's harder to prove."
    } ]
  }, {
    "tStartMs": 1615290,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "- What is already being\nbroadcast is enormously powerful."
    } ]
  }, {
    "tStartMs": 1618430,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "It's like hundreds of\ntimes more powerful than"
    } ]
  }, {
    "tStartMs": 1621620,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the GPS signals themselves."
    } ]
  }, {
    "tStartMs": 1623390,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- But it's slightly offset\nfrom the GPS frequency,"
    } ]
  }, {
    "tStartMs": 1626660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "which seems odd."
    } ]
  }, {
    "tStartMs": 1628370,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Because surely if you\nwant to jam GPS properly,"
    } ]
  }, {
    "tStartMs": 1631460,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "you would put your jamming\nsignal directly on top of it."
    } ]
  }, {
    "tStartMs": 1635150,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Well, Todd actually has\na theory about this."
    } ]
  }, {
    "tStartMs": 1638300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- If you're going to test this capability,"
    } ]
  }, {
    "tStartMs": 1640340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "then you test it in the neighborhood"
    } ]
  }, {
    "tStartMs": 1642920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of the signal you intend to jam,"
    } ]
  }, {
    "tStartMs": 1645200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but not right on that signal."
    } ]
  }, {
    "tStartMs": 1646700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And you test it only briefly just"
    } ]
  }, {
    "tStartMs": 1648500,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to make sure everything's still working."
    } ]
  }, {
    "tStartMs": 1650870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And then in the eventual future,"
    } ]
  }, {
    "tStartMs": 1652970,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "where there is a hot\nconflict, they go ahead"
    } ]
  }, {
    "tStartMs": 1656180,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and tune their transmitter\ndown to the GPS band."
    } ]
  }, {
    "tStartMs": 1659360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But it's much more damaging\nnow that it lies right"
    } ]
  }, {
    "tStartMs": 1662480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "on that band."
    } ]
  }, {
    "tStartMs": 1663830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Derek] So, one possibility is this."
    } ]
  }, {
    "tStartMs": 1665900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "What we've been seeing are tests,"
    } ]
  }, {
    "tStartMs": 1667820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "a system being exercised"
    } ]
  }, {
    "tStartMs": 1669260,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "without fully revealing what it can do."
    } ]
  }, {
    "tStartMs": 1672170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And while just a theory at this point,"
    } ]
  }, {
    "tStartMs": 1674090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "there is another hint\nthis might be the case."
    } ]
  }, {
    "tStartMs": 1676640,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "The raw data also revealed a\nsecond interference burst aimed"
    } ]
  }, {
    "tStartMs": 1680330,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "at a lower frequency, 1,558.5 megahertz,"
    } ]
  }, {
    "tStartMs": 1684230,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "which overlaps with signals"
    } ]
  }, {
    "tStartMs": 1685490,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "from the Chinese BeiDou navigation system."
    } ]
  }, {
    "tStartMs": 1688650,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "- I'll say it in the most\nconservative way possible."
    } ]
  }, {
    "tStartMs": 1691760,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "I can no longer say this is\naccidental with confidence."
    } ]
  }, {
    "tStartMs": 1696470,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I'm leaning toward this\nbeing a periodic test"
    } ]
  }, {
    "tStartMs": 1699950,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of a capability that\nwould be very damaging"
    } ]
  }, {
    "tStartMs": 1702440,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "if it was deployed in anger."
    } ]
  }, {
    "tStartMs": 1704930,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Derek] But when we spoke to a team"
    } ]
  }, {
    "tStartMs": 1706010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that had independently traced\nthe signals back to satellites"
    } ]
  }, {
    "tStartMs": 1708530,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "in Russia's missile warning\nsystem, they had another idea."
    } ]
  }, {
    "tStartMs": 1711980,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "- So that'd be very odd behavior"
    } ]
  }, {
    "tStartMs": 1714650,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "to be continually testing something."
    } ]
  }, {
    "tStartMs": 1718040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, our alternative theory\nis that those might actually"
    } ]
  }, {
    "tStartMs": 1720980,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "be very short, very brief,"
    } ]
  }, {
    "tStartMs": 1724460,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "very specific comms messages\ncoming from those satellites."
    } ]
  }, {
    "tStartMs": 1728510,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Derek] And if that were\ntrue, transmitting messages"
    } ]
  }, {
    "tStartMs": 1730520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "on these frequencies would provide a layer"
    } ]
  }, {
    "tStartMs": 1732620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "of protection because the\nenemy wouldn't want to jam"
    } ]
  }, {
    "tStartMs": 1735620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "them and risk disrupting\ntheir own navigation systems."
    } ]
  }, {
    "tStartMs": 1738980,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "- I'm not saying it's not the jamming."
    } ]
  }, {
    "tStartMs": 1740470,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "That's still a very strong possibility."
    } ]
  }, {
    "tStartMs": 1742730,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I think the point is\nthere are some odd things"
    } ]
  }, {
    "tStartMs": 1744980,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "about that and there is clearly here"
    } ]
  }, {
    "tStartMs": 1748010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "an alternative explanation."
    } ]
  }, {
    "tStartMs": 1750800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- But whether these signals\nwere covert messages"
    } ]
  }, {
    "tStartMs": 1752900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "or tests of a space-based jamming system,"
    } ]
  }, {
    "tStartMs": 1755300,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "the events themselves\nwere incredibly brief."
    } ]
  }, {
    "tStartMs": 1759230,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And that might explain something else."
    } ]
  }, {
    "tStartMs": 1761450,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Why this went unnoticed for years."
    } ]
  }, {
    "tStartMs": 1763910,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But if this system were\never fully switched on,"
    } ]
  }, {
    "tStartMs": 1766610,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the impact could be enormous."
    } ]
  }, {
    "tStartMs": 1769250,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "When we see maps of massive\nGPS interference today,"
    } ]
  }, {
    "tStartMs": 1772010,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you are almost entirely looking at reports"
    } ]
  }, {
    "tStartMs": 1774200,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "from commercial aircraft\naffected by ground-based jammers."
    } ]
  }, {
    "tStartMs": 1777530,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "Typical airliners cruise\nat altitudes between 30,000"
    } ]
  }, {
    "tStartMs": 1781320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and 42,000 feet, which is high enough"
    } ]
  }, {
    "tStartMs": 1782840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to remain in direct line of sight"
    } ]
  }, {
    "tStartMs": 1784760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of jamming signals across vast distances."
    } ]
  }, {
    "tStartMs": 1787520,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "But at ground level, buildings\nand terrain shield much"
    } ]
  }, {
    "tStartMs": 1790430,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "of our infrastructure\nfrom that interference."
    } ]
  }, {
    "tStartMs": 1793820,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "- But everything is line\nof sight from space, yeah."
    } ]
  }, {
    "tStartMs": 1796949,
    "dDurationMs": 2811,
    "segs": [ {
      "utf8": "It's an invisible utility"
    } ]
  }, {
    "tStartMs": 1799760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that supports virtually every technology."
    } ]
  }, {
    "tStartMs": 1802520,
    "dDurationMs": 6450,
    "segs": [ {
      "utf8": "And it's essential to the\nway we live every day."
    } ]
  }, {
    "tStartMs": 1808970,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The United States made\nGPS its gift to the world."
    } ]
  }, {
    "tStartMs": 1812030,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And clever engineers took this free thing"
    } ]
  }, {
    "tStartMs": 1814910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that works really well and very precisely"
    } ]
  }, {
    "tStartMs": 1817070,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and incorporated it into\nall kinds of systems."
    } ]
  }, {
    "tStartMs": 1819950,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "It's one of those wicked problems."
    } ]
  }, {
    "tStartMs": 1821480,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "You really don't know what\nall the dependencies are"
    } ]
  }, {
    "tStartMs": 1824090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and where all the interconnections are"
    } ]
  }, {
    "tStartMs": 1825470,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "because it's just proliferated\nthroughout the world."
    } ]
  }, {
    "tStartMs": 1830240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Derek] Global satellite\nnavigation systems"
    } ]
  }, {
    "tStartMs": 1831770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "underpin aviation and global shipping."
    } ]
  }, {
    "tStartMs": 1834110,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It synchronizes financial systems,"
    } ]
  }, {
    "tStartMs": 1836030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "keeps cell towers on time."
    } ]
  }, {
    "tStartMs": 1837860,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It is crucial for logistics networks,"
    } ]
  }, {
    "tStartMs": 1839870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "ride hailing apps, delivery\nsystems, even dating apps."
    } ]
  }, {
    "tStartMs": 1842720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "A disruption of these systems\nacross an area as large"
    } ]
  }, {
    "tStartMs": 1845300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "as what these satellites are capable"
    } ]
  }, {
    "tStartMs": 1846620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of could affect hundreds\nof millions of people."
    } ]
  }, {
    "tStartMs": 1849680,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- It would send shockwaves\nof fear through the world,"
    } ]
  }, {
    "tStartMs": 1853760,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "not just through Europe,\nbecause an entirely new weapon"
    } ]
  }, {
    "tStartMs": 1857720,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "from space would have been revealed."
    } ]
  }, {
    "tStartMs": 1860180,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "And people would know that at\nany time of their choosing,"
    } ]
  }, {
    "tStartMs": 1864530,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "Russia could deploy\nthis over their country"
    } ]
  }, {
    "tStartMs": 1868760,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "or over their continent."
    } ]
  }, {
    "tStartMs": 1870290,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "I do think that this\nis a massive escalation"
    } ]
  }, {
    "tStartMs": 1874490,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "in the electronic warfare\nbackground conflict"
    } ]
  }, {
    "tStartMs": 1879770,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that's going on right now."
    } ]
  }, {
    "tStartMs": 1881510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Derek] Now, this sounds\nscary, but the truth"
    } ]
  }, {
    "tStartMs": 1883670,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "is we should have been worried"
    } ]
  }, {
    "tStartMs": 1885170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "about this fragile system already."
    } ]
  }, {
    "tStartMs": 1887900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- The threat has always been there."
    } ]
  }, {
    "tStartMs": 1890300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Severe solar events could\nionize the atmosphere"
    } ]
  }, {
    "tStartMs": 1893240,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and keep all kinds of signals\nfrom space from coming in,"
    } ]
  }, {
    "tStartMs": 1895370,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "or it could destroy satellites."
    } ]
  }, {
    "tStartMs": 1897860,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "We could have a version\nof the Kessler effect"
    } ]
  }, {
    "tStartMs": 1901580,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "in medium Earth orbit,"
    } ]
  }, {
    "tStartMs": 1902810,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and satellites be destroyed by debris."
    } ]
  }, {
    "tStartMs": 1905510,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "So, everybody should have\nalready been concerned."
    } ]
  }, {
    "tStartMs": 1909980,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "They should continue to be concerned."
    } ]
  }, {
    "tStartMs": 1911510,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "And this is just another example of why."
    } ]
  }, {
    "tStartMs": 1916490,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Derek] But the good news is,"
    } ]
  }, {
    "tStartMs": 1917450,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "we already know exactly\nhow to fix the problem."
    } ]
  }, {
    "tStartMs": 1920210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It involves building a future system"
    } ]
  }, {
    "tStartMs": 1922010,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "that doesn't rely entirely\non weak satellite signals."
    } ]
  }, {
    "tStartMs": 1926090,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "- We suggest that a resilient"
    } ]
  }, {
    "tStartMs": 1931070,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "national PNT architecture"
    } ]
  }, {
    "tStartMs": 1933680,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "would be signals from space,\nterrestrial broadcast,"
    } ]
  }, {
    "tStartMs": 1936620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and fiber, because those are\nthree completely different"
    } ]
  }, {
    "tStartMs": 1940520,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "phenomenologies in a vector\nthat would impact one,"
    } ]
  }, {
    "tStartMs": 1943670,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "would not impact the other two."
    } ]
  }, {
    "tStartMs": 1946010,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- Some countries are already doing this."
    } ]
  }, {
    "tStartMs": 1948020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Places like South Korea, China,"
    } ]
  }, {
    "tStartMs": 1949610,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and the UK are building\nout backup networks"
    } ]
  }, {
    "tStartMs": 1951890,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that don't rely on signals from space."
    } ]
  }, {
    "tStartMs": 1954080,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "They're using fiber optic\ncables to securely share time"
    } ]
  }, {
    "tStartMs": 1957170,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "from atomic clocks here on Earth."
    } ]
  }, {
    "tStartMs": 1959420,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And for navigation, they're\nturning to systems like eLoran,"
    } ]
  }, {
    "tStartMs": 1962660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "huge high-powered radio towers"
    } ]
  }, {
    "tStartMs": 1964520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that are much harder to overwhelm."
    } ]
  }, {
    "tStartMs": 1966770,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Other solutions are even\nbeing developed using magnetic"
    } ]
  }, {
    "tStartMs": 1969380,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and quantum systems that\nuse subtle variations"
    } ]
  }, {
    "tStartMs": 1971630,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "in the Earth's magnetic\nfield to work out position."
    } ]
  }, {
    "tStartMs": 1974540,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So, you don't need any external signals."
    } ]
  }, {
    "tStartMs": 1977510,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But despite all of this, most countries,"
    } ]
  }, {
    "tStartMs": 1979430,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "including the United States,"
    } ]
  }, {
    "tStartMs": 1980810,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "still remain highly dependent on GPS"
    } ]
  }, {
    "tStartMs": 1983300,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "and other satellite navigation systems."
    } ]
  }, {
    "tStartMs": 1986360,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "In this video, we've been\ntalking about jamming,"
    } ]
  }, {
    "tStartMs": 1988700,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but there's another kind\nof GNSS interference,"
    } ]
  }, {
    "tStartMs": 1991700,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "one that swaps your real\nsignal for a fake one,"
    } ]
  }, {
    "tStartMs": 1994760,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "quietly feeding you a location\nthat looks completely real."
    } ]
  }, {
    "tStartMs": 1998150,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "So, if you trust it,"
    } ]
  }, {
    "tStartMs": 1999323,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "it can guide you somewhere else entirely."
    } ]
  }, {
    "tStartMs": 2002290,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This is known as GPS spoofing."
    } ]
  }, {
    "tStartMs": 2005200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's affecting over 1,500 flights per day."
    } ]
  }, {
    "tStartMs": 2008320,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And at sea, we're seeing the same thing."
    } ]
  }, {
    "tStartMs": 2010600,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Ships are jumping implausible distances,"
    } ]
  }, {
    "tStartMs": 2013180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "briefly disappearing or reappearing"
    } ]
  }, {
    "tStartMs": 2015130,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "in impossible locations, even on land."
    } ]
  }, {
    "tStartMs": 2018460,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It's a systematic, geographically\nclustered distortion"
    } ]
  }, {
    "tStartMs": 2021220,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "of reality, both in the air and at sea."
    } ]
  }, {
    "tStartMs": 2024970,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "If you wanna know more about that,"
    } ]
  }, {
    "tStartMs": 2026530,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "let us know in the comments."
    } ]
  }, {
    "tStartMs": 2028570,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "This story was based on research"
    } ]
  }, {
    "tStartMs": 2030340,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "by Professor Todd\nHumphreys and his student,"
    } ]
  }, {
    "tStartMs": 2032410,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Zach Clements, at the\nUniversity of Texas at Austin."
    } ]
  }, {
    "tStartMs": 2035290,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "There's a link to their work\ndown in the description."
    } ]
  }, {
    "tStartMs": 2037960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I wanna thank them for all their help"
    } ]
  }, {
    "tStartMs": 2040000,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and for sharing their findings with us."
    } ]
  }, {
    "tStartMs": 2041860,
    "dDurationMs": 3058,
    "segs": [ {
      "utf8": "And of course, I wanna\nthank you for watching."
    } ]
  }, {
    "tStartMs": 2044918,
    "dDurationMs": 4917,
    "segs": [ {
      "utf8": "(upbeat music fades)"
    } ]
  } ]
}
