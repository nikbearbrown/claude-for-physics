{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- You can never see\nanything enter a black hole."
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "(bell dings)"
    } ]
  }, {
    "tStartMs": 4740,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Imagine you trap your\nnemesis in a rocket ship"
    } ]
  }, {
    "tStartMs": 7440,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and blast him off towards a black hole."
    } ]
  }, {
    "tStartMs": 10170,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "He looks back at you shaking\nhis fist at a constant rate."
    } ]
  }, {
    "tStartMs": 14310,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "As he zooms in, gravity gets stronger,"
    } ]
  }, {
    "tStartMs": 17250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "so you would expect him to speed up,"
    } ]
  }, {
    "tStartMs": 19410,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but that is not what you see."
    } ]
  }, {
    "tStartMs": 21660,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Instead, the rocket ship\nappears to be slowing down."
    } ]
  }, {
    "tStartMs": 25290,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Not only that, he also appears"
    } ]
  }, {
    "tStartMs": 27330,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to be shaking his fist slower and slower."
    } ]
  }, {
    "tStartMs": 30450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "That's because from your perspective,"
    } ]
  }, {
    "tStartMs": 32730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "his time is slowing down"
    } ]
  }, {
    "tStartMs": 35370,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "at the very instant when he\nshould cross the event horizon,"
    } ]
  }, {
    "tStartMs": 38730,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the point beyond which\nnot even light can escape,"
    } ]
  }, {
    "tStartMs": 41520,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "he and his rocket ship do not disappear,"
    } ]
  }, {
    "tStartMs": 45210,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "instead, they seem to stop frozen in time."
    } ]
  }, {
    "tStartMs": 51420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The light from the spaceship\ngets dimmer and redder"
    } ]
  }, {
    "tStartMs": 54120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "until it completely fades from view."
    } ]
  }, {
    "tStartMs": 57600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is how any object would look"
    } ]
  }, {
    "tStartMs": 59640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "crossing the event horizon."
    } ]
  }, {
    "tStartMs": 61680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Light is still coming from\nthe point where he crossed,"
    } ]
  }, {
    "tStartMs": 64260,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "it's just too redshifted to see,"
    } ]
  }, {
    "tStartMs": 68250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but if you could see that light,"
    } ]
  }, {
    "tStartMs": 70170,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "then in theory you would see everything"
    } ]
  }, {
    "tStartMs": 72210,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that has ever fallen into the black hole"
    } ]
  }, {
    "tStartMs": 74610,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "frozen on its horizon, including\nthe star that formed it,"
    } ]
  }, {
    "tStartMs": 79500,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "but in practice, photons are\nemitted at discreet intervals,"
    } ]
  }, {
    "tStartMs": 82710,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "so there will be a last photon\nemitted outside the horizon,"
    } ]
  }, {
    "tStartMs": 86040,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and therefore these images\nwill fade after some time."
    } ]
  }, {
    "tStartMs": 89940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- This is just one of the strange results"
    } ]
  }, {
    "tStartMs": 92040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that comes outta the general\ntheory of relativity,"
    } ]
  }, {
    "tStartMs": 94140,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "our current best theory of gravity."
    } ]
  }, {
    "tStartMs": 96510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The first solution of Einstein's equations"
    } ]
  }, {
    "tStartMs": 98970,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "predicted not only black holes,"
    } ]
  }, {
    "tStartMs": 100980,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but also their opposite, white holes."
    } ]
  }, {
    "tStartMs": 103620,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It also implied the existence\nof parallel universes"
    } ]
  }, {
    "tStartMs": 106830,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and even possibly a way\nto travel between them."
    } ]
  }, {
    "tStartMs": 110070,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "This is a video about the\nreal science of black holes,"
    } ]
  }, {
    "tStartMs": 113370,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "white holes, and wormholes."
    } ]
  }, {
    "tStartMs": 116940,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- The general theory of relativity"
    } ]
  }, {
    "tStartMs": 118230,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "arose at least in part\ndue to a fundamental flaw"
    } ]
  }, {
    "tStartMs": 120840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "in Newtonian gravity."
    } ]
  }, {
    "tStartMs": 122520,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "In the 1600s Isaac Newton"
    } ]
  }, {
    "tStartMs": 124110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "contemplated how an apple\nfalls to the ground,"
    } ]
  }, {
    "tStartMs": 126450,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "how the moon orbits the earth\nand earth orbits the sun"
    } ]
  }, {
    "tStartMs": 129480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and he concluded that\nevery object with mass"
    } ]
  }, {
    "tStartMs": 132180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "must attract every other,"
    } ]
  }, {
    "tStartMs": 134250,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but Newton was troubled by his own theory."
    } ]
  }, {
    "tStartMs": 137730,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "How could masses separated\nby such vast distances"
    } ]
  }, {
    "tStartMs": 140460,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "apply a force on each other?"
    } ]
  }, {
    "tStartMs": 142590,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "He wrote, \"That one body may\nact upon another at a distance"
    } ]
  }, {
    "tStartMs": 146070,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "through a vacuum without the\nmediation of anything else"
    } ]
  }, {
    "tStartMs": 149040,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "is to me, so great and\nabsurdity that I believe no man"
    } ]
  }, {
    "tStartMs": 153030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "who has a competent faculty of thinking"
    } ]
  }, {
    "tStartMs": 154860,
    "dDurationMs": 1527,
    "segs": [ {
      "utf8": "could ever fall into it.\""
    } ]
  }, {
    "tStartMs": 158910,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "One man who definitely had a\ncompetent faculty of thinking,"
    } ]
  }, {
    "tStartMs": 162060,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "was Albert Einstein and\nover 200 years later,"
    } ]
  }, {
    "tStartMs": 165480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "he figured out how gravity is mediated."
    } ]
  }, {
    "tStartMs": 168840,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Bodies do not exert forces\non each other directly."
    } ]
  }, {
    "tStartMs": 172230,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Instead, a mass like the\nsun curves the spacetime"
    } ]
  }, {
    "tStartMs": 175950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "in its immediate vicinity."
    } ]
  }, {
    "tStartMs": 178020,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "This, then curves the spacetime around it"
    } ]
  }, {
    "tStartMs": 180750,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and so on all the way to the earth."
    } ]
  }, {
    "tStartMs": 183300,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So the earth orbits the\nsun, because the spacetime"
    } ]
  }, {
    "tStartMs": 186630,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "earth is passing through is curved."
    } ]
  }, {
    "tStartMs": 189840,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Masses are affected by the local curvature"
    } ]
  }, {
    "tStartMs": 192270,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "of spacetime, so no action\nat a distance is required."
    } ]
  }, {
    "tStartMs": 196680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Mathematically, this is described"
    } ]
  }, {
    "tStartMs": 198480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "by Einstein's field equations."
    } ]
  }, {
    "tStartMs": 200850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Can you write down the\nEinstein field equation?"
    } ]
  }, {
    "tStartMs": 203040,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- This was the the result of\nEinstein's decade of hard work"
    } ]
  }, {
    "tStartMs": 206610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "after special relativity"
    } ]
  }, {
    "tStartMs": 208020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and essentially what we've\ngot in the field equations"
    } ]
  }, {
    "tStartMs": 210150,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "on one side it says,"
    } ]
  }, {
    "tStartMs": 212010,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "tell me about the distribution\nof matter and energy."
    } ]
  }, {
    "tStartMs": 214710,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The other side tells you\nwhat the resultant curvature"
    } ]
  }, {
    "tStartMs": 217440,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of spacetime is from that distribution"
    } ]
  }, {
    "tStartMs": 220500,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "of matter and energy\nand it's a single line."
    } ]
  }, {
    "tStartMs": 223680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "It looks like, oh, this is\na simple equation, right?"
    } ]
  }, {
    "tStartMs": 226350,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "But it's not really one equation."
    } ]
  }, {
    "tStartMs": 227880,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "It's a family of equations and\nto make life more difficult,"
    } ]
  }, {
    "tStartMs": 231690,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "they're coupled equations, so\nthey depend upon each other"
    } ]
  }, {
    "tStartMs": 234510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and they are differential equations,"
    } ]
  }, {
    "tStartMs": 236610,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so it means that there are integrals"
    } ]
  }, {
    "tStartMs": 238950,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that have to be done, da, da da."
    } ]
  }, {
    "tStartMs": 240150,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So there's a whole bunch of\nsteps that you need to do"
    } ]
  }, {
    "tStartMs": 242160,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to solve the field equations."
    } ]
  }, {
    "tStartMs": 244350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "To see what a solution to these\nequations would look like,"
    } ]
  }, {
    "tStartMs": 247110,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "we need a tool to understand spacetime."
    } ]
  }, {
    "tStartMs": 251340,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So imagine your floating\naround in empty space."
    } ]
  }, {
    "tStartMs": 254730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "A flash of light goes off above your head"
    } ]
  }, {
    "tStartMs": 256740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and spreads out in all directions."
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Now your entire future, anything that can"
    } ]
  }, {
    "tStartMs": 262560,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "and will ever happen to you\nwill occur within this bubble"
    } ]
  }, {
    "tStartMs": 267150,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "because the only way to get out of it"
    } ]
  }, {
    "tStartMs": 269160,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "would be to travel faster than light."
    } ]
  }, {
    "tStartMs": 271590,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In two dimensions, this bubble\nis just a growing circle."
    } ]
  }, {
    "tStartMs": 275010,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "If we allow time to run up the screen"
    } ]
  }, {
    "tStartMs": 277020,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and take snapshots at regular intervals,"
    } ]
  }, {
    "tStartMs": 279210,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "then this light bubble traces out a cone,"
    } ]
  }, {
    "tStartMs": 281520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "your future light cone."
    } ]
  }, {
    "tStartMs": 283530,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "By convention, the axes are\nscaled so that light rays"
    } ]
  }, {
    "tStartMs": 286230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "always travel at 45 degrees."
    } ]
  }, {
    "tStartMs": 288780,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This cone reveals the\nonly region of spacetime"
    } ]
  }, {
    "tStartMs": 291690,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "that you can ever hope\nto explore and influence."
    } ]
  }, {
    "tStartMs": 295200,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now imagine that instead\nof a flash of light"
    } ]
  }, {
    "tStartMs": 297270,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "above your head, those photons\nwere actually traveling in"
    } ]
  }, {
    "tStartMs": 300750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "from all corners of the universe"
    } ]
  }, {
    "tStartMs": 302400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and they met at that instant"
    } ]
  }, {
    "tStartMs": 303990,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and then continued traveling on"
    } ]
  }, {
    "tStartMs": 305460,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "in their separate directions."
    } ]
  }, {
    "tStartMs": 308070,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Well, in that case then into the past,"
    } ]
  }, {
    "tStartMs": 310620,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "these photons also reveal a light cone,"
    } ]
  }, {
    "tStartMs": 313350,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "your past light cone."
    } ]
  }, {
    "tStartMs": 315510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Only events that happened inside this cone"
    } ]
  }, {
    "tStartMs": 317970,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "could have affected you\nup to the present moment."
    } ]
  }, {
    "tStartMs": 321030,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "We can simplify this diagram even further"
    } ]
  }, {
    "tStartMs": 323040,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "by plotting just one spatial\nand one time dimension."
    } ]
  }, {
    "tStartMs": 326460,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This is the spacetime\ndiagram of empty space."
    } ]
  }, {
    "tStartMs": 329700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you want to measure how far apart"
    } ]
  }, {
    "tStartMs": 331530,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "two events are in spacetime,\nyou use something called"
    } ]
  }, {
    "tStartMs": 334680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the spacetime interval."
    } ]
  }, {
    "tStartMs": 336480,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The interval squared is\nequal to minus dt squared,"
    } ]
  }, {
    "tStartMs": 339870,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "plus dx squared, since spacetime is flat,"
    } ]
  }, {
    "tStartMs": 343230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the geometry is the same everywhere"
    } ]
  }, {
    "tStartMs": 345000,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and so this formula holds\nthroughout the entire diagram,"
    } ]
  }, {
    "tStartMs": 348630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "which makes it really easy\nto measure the separation"
    } ]
  }, {
    "tStartMs": 350880,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "between any two events, but around a mass,"
    } ]
  }, {
    "tStartMs": 354510,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "spacetime is curved and\ntherefore you need to modify"
    } ]
  }, {
    "tStartMs": 357420,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "the equation to take into\naccount the geometry."
    } ]
  }, {
    "tStartMs": 360900,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "This is what solutions to\nEinstein's equations are like."
    } ]
  }, {
    "tStartMs": 364290,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They tell you how spacetime curves"
    } ]
  }, {
    "tStartMs": 366690,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and how to measure the\nseparation between two events"
    } ]
  }, {
    "tStartMs": 369510,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "in that curved geometry."
    } ]
  }, {
    "tStartMs": 372840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Einstein published his equations in 1915"
    } ]
  }, {
    "tStartMs": 375360,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "during the First World War,"
    } ]
  }, {
    "tStartMs": 376980,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but he couldn't find an exact solution."
    } ]
  }, {
    "tStartMs": 379950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Luckily, a copy of his paper made its way"
    } ]
  }, {
    "tStartMs": 382050,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to the eastern front where\nGermany was fighting Russia,"
    } ]
  }, {
    "tStartMs": 385590,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "stationed there was one of\nthe best astrophysicists"
    } ]
  }, {
    "tStartMs": 387870,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of the time, Karl Schwarzschild."
    } ]
  }, {
    "tStartMs": 390450,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Despite being 41 years\nold, he had volunteered"
    } ]
  }, {
    "tStartMs": 393120,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "to calculate artillery\ntrajectories for the German army."
    } ]
  }, {
    "tStartMs": 396870,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "At least until a greater\nchallenge caught his attention,"
    } ]
  }, {
    "tStartMs": 400890,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "how to solve Einstein's field equations."
    } ]
  }, {
    "tStartMs": 405060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Schwarzschild did the\nstandard physicist thing"
    } ]
  }, {
    "tStartMs": 407040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and imagined the simplest\npossible scenario,"
    } ]
  }, {
    "tStartMs": 409620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "an eternal static universe\nwith nothing in it"
    } ]
  }, {
    "tStartMs": 412380,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "except a single spherically\nsymmetric point mass."
    } ]
  }, {
    "tStartMs": 415500,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "This mass was electrically\nneutral and not rotating."
    } ]
  }, {
    "tStartMs": 419130,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Since this was the only\nfeature of his universe,"
    } ]
  }, {
    "tStartMs": 421920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "he measured everything\nusing spherical coordinates"
    } ]
  }, {
    "tStartMs": 424590,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "relative to this center of this mass."
    } ]
  }, {
    "tStartMs": 426840,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "So r is the radius and theta\nand phi give the angles."
    } ]
  }, {
    "tStartMs": 430830,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "For his time coordinate, he\nchose time as being measured"
    } ]
  }, {
    "tStartMs": 433530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "by someone far away from the mass,"
    } ]
  }, {
    "tStartMs": 435330,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "where spacetime is essentially flat."
    } ]
  }, {
    "tStartMs": 438150,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Using this approach,\nSchwarzschild found the first"
    } ]
  }, {
    "tStartMs": 440910,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "non-trivial solution to\nEinstein's equations,"
    } ]
  }, {
    "tStartMs": 443760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "which nowadays we write like this."
    } ]
  }, {
    "tStartMs": 446490,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "This Schwarzschild metric\ndescribes how spacetime curves"
    } ]
  }, {
    "tStartMs": 450120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "outside of the mass."
    } ]
  }, {
    "tStartMs": 452160,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "It's pretty simple and\nmakes intuitive sense,"
    } ]
  }, {
    "tStartMs": 454530,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "far away from the mass\nspacetime is nearly flat,"
    } ]
  }, {
    "tStartMs": 457320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but as you get closer and closer to it,"
    } ]
  }, {
    "tStartMs": 459540,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "spacetime becomes more and more curved,"
    } ]
  }, {
    "tStartMs": 461730,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "it attracts objects in\nand time runs slower."
    } ]
  }, {
    "tStartMs": 465647,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "(gunshots firing)"
    } ]
  }, {
    "tStartMs": 467310,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Schwarzschild sent his\nsolution to Einstein,"
    } ]
  }, {
    "tStartMs": 469680,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "concluding with, \"The war\ntreated me kindly enough"
    } ]
  }, {
    "tStartMs": 472710,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "in spite of the heavy gunfire"
    } ]
  }, {
    "tStartMs": 474090,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to allow me to get away from it all"
    } ]
  }, {
    "tStartMs": 475860,
    "dDurationMs": 3117,
    "segs": [ {
      "utf8": "and take this walk in\nthe land of your ideas.\""
    } ]
  }, {
    "tStartMs": 480120,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Einstein replied, \"I have read your paper"
    } ]
  }, {
    "tStartMs": 482340,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "with the utmost interest,\nI had not expected"
    } ]
  }, {
    "tStartMs": 484620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that one could formulate the\nexact solution to the problem"
    } ]
  }, {
    "tStartMs": 486960,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "in such a simple way.\""
    } ]
  }, {
    "tStartMs": 492420,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But what seemed at first quite simple,"
    } ]
  }, {
    "tStartMs": 495000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "soon became more complicated."
    } ]
  }, {
    "tStartMs": 497220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Shortly after Schwarzschild\nsolution was published,"
    } ]
  }, {
    "tStartMs": 499770,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "people noticed two problem spots."
    } ]
  }, {
    "tStartMs": 502950,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "At the center of the\nmass, at r equals zero,"
    } ]
  }, {
    "tStartMs": 505800,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "this term is divided by zero,\nso it blows up to infinity"
    } ]
  }, {
    "tStartMs": 510570,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and therefore this equation breaks down"
    } ]
  }, {
    "tStartMs": 512100,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it can no longer describe\nwhat's physically happening."
    } ]
  }, {
    "tStartMs": 515520,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "This is what's called a singularity."
    } ]
  }, {
    "tStartMs": 518520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Maybe that point could be excused,"
    } ]
  }, {
    "tStartMs": 520530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "because it's in the middle of the mass,"
    } ]
  }, {
    "tStartMs": 522360,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "but there's another\nproblem spot outside of it"
    } ]
  }, {
    "tStartMs": 525690,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "at a special distance from the center"
    } ]
  }, {
    "tStartMs": 527520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "known as the Schwarzschild\nradius, this term blows up."
    } ]
  }, {
    "tStartMs": 530880,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "So there is a second singularity.\nWhat is going on here?"
    } ]
  }, {
    "tStartMs": 537990,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Well, at the Schwarzschild radius,"
    } ]
  }, {
    "tStartMs": 540150,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the spacetime curvature becomes so steep"
    } ]
  }, {
    "tStartMs": 542730,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "that the escape velocity, the\nspeed that anything would need"
    } ]
  }, {
    "tStartMs": 546360,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "to leave there is the speed of light"
    } ]
  }, {
    "tStartMs": 550650,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and that would mean that inside\nthe Schwarzschild radius,"
    } ]
  }, {
    "tStartMs": 553560,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "nothing, not even light\nwould be able to escape."
    } ]
  }, {
    "tStartMs": 557340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So you'd have this dark object"
    } ]
  }, {
    "tStartMs": 558900,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "that swallows up matter and light,"
    } ]
  }, {
    "tStartMs": 562650,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "a black hole, if you will,"
    } ]
  }, {
    "tStartMs": 566370,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but most scientists doubted\nthat such an object could exist,"
    } ]
  }, {
    "tStartMs": 569340,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "because it would require a lot of mass"
    } ]
  }, {
    "tStartMs": 571890,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "to collapse down into a tiny space."
    } ]
  }, {
    "tStartMs": 575640,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "How could that possibly ever happen?"
    } ]
  }, {
    "tStartMs": 579562,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "(thrilling music)"
    } ]
  }, {
    "tStartMs": 580830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Astronomers at the time were studying"
    } ]
  }, {
    "tStartMs": 582510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "what happens at the end of a star's life."
    } ]
  }, {
    "tStartMs": 584940,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "During its lifetime the inward\nforce of gravity is balanced"
    } ]
  }, {
    "tStartMs": 587820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "by the outward radiation pressure"
    } ]
  }, {
    "tStartMs": 589620,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "created by the energy released\nthrough nuclear fusion,"
    } ]
  }, {
    "tStartMs": 592770,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but when the fuel runs out,\nthe radiation pressure drops."
    } ]
  }, {
    "tStartMs": 595830,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So gravity pulls all the star\nmaterial inwards, but how far?"
    } ]
  }, {
    "tStartMs": 601290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Most astronomers believed\nsome physical process"
    } ]
  }, {
    "tStartMs": 604170,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "would hold it up and in 1926,"
    } ]
  }, {
    "tStartMs": 607290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Ralph Fowler came up with\na possible mechanism."
    } ]
  }, {
    "tStartMs": 610050,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "Pauli's exclusion principles states that,"
    } ]
  }, {
    "tStartMs": 611707,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "\"Fermions like electrons\ncannot occupy the same state,"
    } ]
  }, {
    "tStartMs": 615540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "so as matter gets pushed\ncloser and closer together,"
    } ]
  }, {
    "tStartMs": 618210,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the electrons each occupy\ntheir own tiny volumes,\""
    } ]
  }, {
    "tStartMs": 621810,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "but Heisenberg's uncertainty\nprinciple says that,"
    } ]
  }, {
    "tStartMs": 623587,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "\"You can't know the position\nand momentum of a particle"
    } ]
  }, {
    "tStartMs": 626430,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "with absolute certainty,\nso as the particles become"
    } ]
  }, {
    "tStartMs": 629730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "more and more constrained in space,"
    } ]
  }, {
    "tStartMs": 632070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the uncertainty in their momentum,"
    } ]
  }, {
    "tStartMs": 634080,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and hence their velocity must go up.\""
    } ]
  }, {
    "tStartMs": 637140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So the more a star is compressed,"
    } ]
  }, {
    "tStartMs": 639120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the faster electrons will wiggle around"
    } ]
  }, {
    "tStartMs": 641250,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and that creates an outward pressure."
    } ]
  }, {
    "tStartMs": 644490,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "This electron degeneracy\npressure would prevent the star"
    } ]
  }, {
    "tStartMs": 647460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "from collapsing completely."
    } ]
  }, {
    "tStartMs": 649350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Instead, it would form a white dwarf"
    } ]
  }, {
    "tStartMs": 651450,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "with the density much\nhigher than a normal star"
    } ]
  }, {
    "tStartMs": 654360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and remarkably enough\nastronomers had observed stars"
    } ]
  }, {
    "tStartMs": 657360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that fit this description."
    } ]
  }, {
    "tStartMs": 658950,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "One of them was Sirius B."
    } ]
  }, {
    "tStartMs": 664080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But the relief from this\ndiscovery was short-lived."
    } ]
  }, {
    "tStartMs": 666660,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Four years later, 19-year-old\nSubrahmanyan Chandrasekhar"
    } ]
  }, {
    "tStartMs": 669930,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "traveled by boat to England\nto study with Fowler"
    } ]
  }, {
    "tStartMs": 672720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and Arthur Eddington, one of\nthe most revered scientists"
    } ]
  }, {
    "tStartMs": 675360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of the time."
    } ]
  }, {
    "tStartMs": 677130,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "During his voyage, Chandrasekhar realized"
    } ]
  }, {
    "tStartMs": 679320,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that electron degeneracy\npressure has its limits."
    } ]
  }, {
    "tStartMs": 682350,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Electrons can wiggle faster and faster,"
    } ]
  }, {
    "tStartMs": 684750,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "but only up to the speed of light."
    } ]
  }, {
    "tStartMs": 687450,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "That means this effect\ncan only support stars"
    } ]
  }, {
    "tStartMs": 690180,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "up to a certain mass,\nthe Chandrasekhar limit."
    } ]
  }, {
    "tStartMs": 693510,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Beyond this, Chandrasekhar believed,"
    } ]
  }, {
    "tStartMs": 695310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "not even electron de degeneracy pressure"
    } ]
  }, {
    "tStartMs": 697260,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "could prevent a star from collapsing,"
    } ]
  }, {
    "tStartMs": 700530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but Eddington was not impressed."
    } ]
  }, {
    "tStartMs": 702840,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "He publicly blasted Chandrasekhar saying,"
    } ]
  }, {
    "tStartMs": 705577,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "\"There should be a law of nature"
    } ]
  }, {
    "tStartMs": 707190,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "to prevent a star from\nbehaving in this absurd way\""
    } ]
  }, {
    "tStartMs": 711180,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and indeed scientists did discover a way"
    } ]
  }, {
    "tStartMs": 713730,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that stars heavier than\nthe Chandrasekhar limit"
    } ]
  }, {
    "tStartMs": 715950,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "could support themselves."
    } ]
  }, {
    "tStartMs": 718170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "When a star collapses\nbeyond a white dwarf,"
    } ]
  }, {
    "tStartMs": 720540,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "electrons and protons fuse together"
    } ]
  }, {
    "tStartMs": 722520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "to form neutrinos and neutrons."
    } ]
  }, {
    "tStartMs": 725310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "These neutrons are also fermions,"
    } ]
  }, {
    "tStartMs": 727260,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but with nearly 2000 times\nthe mass an electron,"
    } ]
  }, {
    "tStartMs": 730380,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "their degeneracy pressure\nis even stronger."
    } ]
  }, {
    "tStartMs": 733290,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So this is what holds up neutron stars."
    } ]
  }, {
    "tStartMs": 736920,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "There was this conviction among scientists"
    } ]
  }, {
    "tStartMs": 739020,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that even if we didn't know the mechanism,"
    } ]
  }, {
    "tStartMs": 741210,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "something would prevent\na star from collapsing"
    } ]
  }, {
    "tStartMs": 743850,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "into a single point and\nforming a black hole,"
    } ]
  }, {
    "tStartMs": 748620,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "because black holes were just\ntoo preposterous to be real."
    } ]
  }, {
    "tStartMs": 754800,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The big blow to this belief\ncame in the late 1930s"
    } ]
  }, {
    "tStartMs": 758070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "when Jay Robert Oppenheimer\nand George Volkoff"
    } ]
  }, {
    "tStartMs": 760860,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "found that neutron stars\nalso have a maximum mass."
    } ]
  }, {
    "tStartMs": 764940,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Shortly after Oppenheimer\nand Hartland Snyder"
    } ]
  }, {
    "tStartMs": 767640,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "showed that for the heaviest stars,"
    } ]
  }, {
    "tStartMs": 769530,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "there is nothing left to save\nthem when their fuel runs out,"
    } ]
  }, {
    "tStartMs": 773370,
    "dDurationMs": 3927,
    "segs": [ {
      "utf8": "they wrote, \"This contraction\nwill continue indefinitely,\""
    } ]
  }, {
    "tStartMs": 778320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but Einstein still couldn't believe it."
    } ]
  }, {
    "tStartMs": 780510,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Oppenheimer was saying that\nstars can collapse indefinitely,"
    } ]
  }, {
    "tStartMs": 783600,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but when Einstein looked at the math,"
    } ]
  }, {
    "tStartMs": 785310,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "he found that time freezes on the horizon."
    } ]
  }, {
    "tStartMs": 788220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So it seemed like\nnothing could ever enter,"
    } ]
  }, {
    "tStartMs": 791250,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which suggested that either"
    } ]
  }, {
    "tStartMs": 792780,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "there's something we don't understand"
    } ]
  }, {
    "tStartMs": 794690,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "or that black holes can't exist,"
    } ]
  }, {
    "tStartMs": 797232,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(star explodes)"
    } ]
  }, {
    "tStartMs": 801030,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but Oppenheimer offered a\nsolution to the problem."
    } ]
  }, {
    "tStartMs": 803850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "He said to an outside observer,"
    } ]
  }, {
    "tStartMs": 806040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you could never see anything go in,"
    } ]
  }, {
    "tStartMs": 807780,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "but if you were traveling\nacross the event horizon,"
    } ]
  }, {
    "tStartMs": 811110,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you wouldn't notice anything unusual"
    } ]
  }, {
    "tStartMs": 813420,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and you'd go right past it\nwithout even knowing it."
    } ]
  }, {
    "tStartMs": 817230,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So how is this possible?"
    } ]
  }, {
    "tStartMs": 819810,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We need a spacetime\ndiagram of a black hole."
    } ]
  }, {
    "tStartMs": 823170,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "On the left is the\nsingularity at r equals zero."
    } ]
  }, {
    "tStartMs": 826290,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "The dotted line at r equals\n2M is the event horizon."
    } ]
  }, {
    "tStartMs": 829920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Since the black hole doesn't move,"
    } ]
  }, {
    "tStartMs": 831960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "these lines go straight up in time."
    } ]
  }, {
    "tStartMs": 835170,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Now let's see how ingoing\nand outgoing light ray travel"
    } ]
  }, {
    "tStartMs": 838500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in this curved geometry."
    } ]
  }, {
    "tStartMs": 841020,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "When you're really far away,"
    } ]
  }, {
    "tStartMs": 842190,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the future light cones are\nat the usual 45 degrees,"
    } ]
  }, {
    "tStartMs": 846030,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but as you get closer to the horizon,"
    } ]
  }, {
    "tStartMs": 847950,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the light cones get narrower and narrower,"
    } ]
  }, {
    "tStartMs": 851070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "until right at the event horizon,"
    } ]
  }, {
    "tStartMs": 853440,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "they're so narrow that\nthey point straight up"
    } ]
  }, {
    "tStartMs": 856770,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "and inside the horizon, the\nlight cones tip to the left,"
    } ]
  }, {
    "tStartMs": 862050,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "but something strange happens\nwith ingoing light rays."
    } ]
  }, {
    "tStartMs": 866220,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- They fall in, but they\ndon't get to r equals 2M,"
    } ]
  }, {
    "tStartMs": 869040,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "they actually asymptote to that value"
    } ]
  }, {
    "tStartMs": 872130,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "as time goes to infinity,"
    } ]
  }, {
    "tStartMs": 874350,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "but they don't end at infinity, right?"
    } ]
  }, {
    "tStartMs": 876960,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "Mathematically they are\nconnected and come back in"
    } ]
  }, {
    "tStartMs": 881400,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and they're traveling in this direction"
    } ]
  }, {
    "tStartMs": 884940,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and this bothered a lot of people,"
    } ]
  }, {
    "tStartMs": 886680,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "this bothered people like Einstein,"
    } ]
  }, {
    "tStartMs": 888030,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "because he looked at\nthese equations and went,"
    } ]
  }, {
    "tStartMs": 890497,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "\"well, if nothing can cross\nthis sort of boundary,"
    } ]
  }, {
    "tStartMs": 895860,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "then how could there be black holes?"
    } ]
  }, {
    "tStartMs": 897570,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "How could black holes even form?\""
    } ]
  }, {
    "tStartMs": 900060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- So what is going on here?"
    } ]
  }, {
    "tStartMs": 902580,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Well, what's important to recognize"
    } ]
  }, {
    "tStartMs": 904710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is that this diagram is a projection."
    } ]
  }, {
    "tStartMs": 906990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It's basically a 2D map"
    } ]
  }, {
    "tStartMs": 908820,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "of four dimensional curved spacetime."
    } ]
  }, {
    "tStartMs": 912120,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "It's just like projecting\nthe 3D Earth onto a 2D map."
    } ]
  }, {
    "tStartMs": 915630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "When you do that, you\nalways get distortions."
    } ]
  }, {
    "tStartMs": 918120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "There is no perfectly accurate way"
    } ]
  }, {
    "tStartMs": 920430,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to map the earth onto a 2D surface,"
    } ]
  }, {
    "tStartMs": 922920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but different maps can be\nuseful for different purposes."
    } ]
  }, {
    "tStartMs": 925920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "For example, if you wanna keep\nangles and shapes the same,"
    } ]
  }, {
    "tStartMs": 928590,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "like if you're sailing across the ocean"
    } ]
  }, {
    "tStartMs": 930180,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and you need to find your bearings,"
    } ]
  }, {
    "tStartMs": 931590,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you can use the Mercator projection,"
    } ]
  }, {
    "tStartMs": 933690,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that's the one Google Maps uses."
    } ]
  }, {
    "tStartMs": 935820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "A downside is that it misrepresent sizes."
    } ]
  }, {
    "tStartMs": 939000,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Africa and Greenland\nlook about the same size,"
    } ]
  }, {
    "tStartMs": 942210,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "but Africa is actually\naround 14 times larger."
    } ]
  }, {
    "tStartMs": 946320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The Gall-Peters projection\nkeeps relative sizes accurate,"
    } ]
  }, {
    "tStartMs": 949440,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "but as a result, angles\nand shapes are distorted."
    } ]
  }, {
    "tStartMs": 953460,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "In a similar way, we can\nmake different projections"
    } ]
  }, {
    "tStartMs": 956190,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "of 4D spacetime to study\ndifferent properties of it."
    } ]
  }, {
    "tStartMs": 960150,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Physical reality doesn't change,"
    } ]
  }, {
    "tStartMs": 961830,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but the way the map describes it does."
    } ]
  }, {
    "tStartMs": 965190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- He had chosen to put a\nparticular coordinate system"
    } ]
  }, {
    "tStartMs": 967980,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "of a space and have a time\ncoordinate, and off you go."
    } ]
  }, {
    "tStartMs": 971730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's the most sensible thing to do, right?"
    } ]
  }, {
    "tStartMs": 974070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] People realize\nthat if you choose"
    } ]
  }, {
    "tStartMs": 975690,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "a different coordinate system"
    } ]
  }, {
    "tStartMs": 977280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "by doing a coordinate\nsubstitution, then the singularity"
    } ]
  }, {
    "tStartMs": 980280,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "at the event horizon disappears."
    } ]
  }, {
    "tStartMs": 983340,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- It goes away."
    } ]
  }, {
    "tStartMs": 984330,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That problem goes away and\nthings can actually cross"
    } ]
  }, {
    "tStartMs": 987570,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "into the black hole."
    } ]
  }, {
    "tStartMs": 990780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- What this tells us is that there is"
    } ]
  }, {
    "tStartMs": 992910,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "no real physical singularity\nat the event horizon."
    } ]
  }, {
    "tStartMs": 996300,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "It just resulted from a poor\nchoice of coordinate system."
    } ]
  }, {
    "tStartMs": 1001820,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Another way to visualize what's going on"
    } ]
  }, {
    "tStartMs": 1004070,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "is by describing space as flowing\nin towards the black hole,"
    } ]
  }, {
    "tStartMs": 1008210,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "like a waterfall."
    } ]
  }, {
    "tStartMs": 1009920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "As you get closer, space starts flowing in"
    } ]
  }, {
    "tStartMs": 1012380,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "faster and faster."
    } ]
  }, {
    "tStartMs": 1014330,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Photons emitted by the\nspaceship have to swim"
    } ]
  }, {
    "tStartMs": 1016940,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "against this flow, and this\nbecomes harder and harder"
    } ]
  }, {
    "tStartMs": 1020420,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "the closer you get."
    } ]
  }, {
    "tStartMs": 1022490,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Photons emitted just outside the horizon"
    } ]
  }, {
    "tStartMs": 1024800,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "can barely make it out, but\nit takes longer and longer."
    } ]
  }, {
    "tStartMs": 1029330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "At the horizon, space falls in"
    } ]
  }, {
    "tStartMs": 1031370,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "as fast as the photons are swimming."
    } ]
  }, {
    "tStartMs": 1033470,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So if the horizon had a finite width,"
    } ]
  }, {
    "tStartMs": 1036380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "then photons would get stuck here,"
    } ]
  }, {
    "tStartMs": 1038300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "photons from everything that ever fell in,"
    } ]
  }, {
    "tStartMs": 1041300,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but the horizon is infinitely thin."
    } ]
  }, {
    "tStartMs": 1043940,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So in reality, photons either\neventually escape or fall in."
    } ]
  }, {
    "tStartMs": 1049550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Inside the horizon, space falls faster"
    } ]
  }, {
    "tStartMs": 1051980,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "than the speed of light,"
    } ]
  }, {
    "tStartMs": 1053120,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "and so everything falls\ninto the singularity."
    } ]
  }, {
    "tStartMs": 1056930,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So Oppenheimer was right."
    } ]
  }, {
    "tStartMs": 1058760,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Someone outside a black hole\ncan never see anything enter"
    } ]
  }, {
    "tStartMs": 1062270,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "because the last photons they can see"
    } ]
  }, {
    "tStartMs": 1064610,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "will always be from just\noutside the horizon,"
    } ]
  }, {
    "tStartMs": 1068150,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but if you yourself go,"
    } ]
  }, {
    "tStartMs": 1070070,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you will fall right\nacross the event horizon"
    } ]
  }, {
    "tStartMs": 1072470,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and into the singularity."
    } ]
  }, {
    "tStartMs": 1075350,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Now you can extend the waterfall model"
    } ]
  }, {
    "tStartMs": 1077210,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to cover all three spatial dimensions,"
    } ]
  }, {
    "tStartMs": 1079520,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and that gives you this, a real simulation"
    } ]
  }, {
    "tStartMs": 1082850,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "of space flowing into a static black hole"
    } ]
  }, {
    "tStartMs": 1085550,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "made by my friend\nAlessandro from ScienceClic."
    } ]
  }, {
    "tStartMs": 1088370,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Later we'll use this model\nto see what it's like"
    } ]
  }, {
    "tStartMs": 1090950,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "falling into a rotating black hole."
    } ]
  }, {
    "tStartMs": 1096230,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, I've never been\nsucked into a black hole,"
    } ]
  }, {
    "tStartMs": 1098360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but sometimes it feels like\nit when I'm stuck on the phone"
    } ]
  }, {
    "tStartMs": 1100940,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "with a spam collar."
    } ]
  }, {
    "tStartMs": 1102470,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Fortunately, today's\nsponsor Incogni can help."
    } ]
  }, {
    "tStartMs": 1105890,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You know, I used to get\nseveral spam calls a day,"
    } ]
  }, {
    "tStartMs": 1108290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and they frustrated me so\nmuch that I wrote a letter"
    } ]
  }, {
    "tStartMs": 1111050,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to the Do Not Call registry\nto get my number removed,"
    } ]
  }, {
    "tStartMs": 1113960,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but that didn't work"
    } ]
  }, {
    "tStartMs": 1115580,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and so I wanted to go on the offensive."
    } ]
  }, {
    "tStartMs": 1117740,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I even contemplated making a video"
    } ]
  }, {
    "tStartMs": 1120410,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "where I just mess with spam\ncallers to get some revenge"
    } ]
  }, {
    "tStartMs": 1123080,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for all the frustration and lost time,"
    } ]
  }, {
    "tStartMs": 1125330,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but I no longer have to\ndo that thanks to Incogni."
    } ]
  }, {
    "tStartMs": 1128780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "There are a lot of data brokers out there"
    } ]
  }, {
    "tStartMs": 1130790,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "that suck up information about\nyou, a bit like a black hole."
    } ]
  }, {
    "tStartMs": 1134210,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They collect things like\nyour name, phone number,"
    } ]
  }, {
    "tStartMs": 1136850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "email address, and even\nyour social security number"
    } ]
  }, {
    "tStartMs": 1139790,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and then they sell this\ninformation on the open market,"
    } ]
  }, {
    "tStartMs": 1143120,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "which is why we often\nget calls from people"
    } ]
  }, {
    "tStartMs": 1145940,
    "dDurationMs": 2476,
    "segs": [ {
      "utf8": "that we've never even given our number to."
    } ]
  }, {
    "tStartMs": 1148416,
    "dDurationMs": 2684,
    "segs": [ {
      "utf8": "Incogni battles these data brokers,"
    } ]
  }, {
    "tStartMs": 1151100,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you simply give them\npermission and they figure out"
    } ]
  }, {
    "tStartMs": 1153560,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "who out there has your\ndata, which laws apply,"
    } ]
  }, {
    "tStartMs": 1156230,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and then they send them the right letter,"
    } ]
  }, {
    "tStartMs": 1158180,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "with the correct legal\nterms to each data broker"
    } ]
  }, {
    "tStartMs": 1161060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "with the request to\nremove your information."
    } ]
  }, {
    "tStartMs": 1163310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, you could do this yourself,"
    } ]
  }, {
    "tStartMs": 1165440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but it's a super tedious\nprocess that would take days,"
    } ]
  }, {
    "tStartMs": 1167810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "weeks, even months,"
    } ]
  }, {
    "tStartMs": 1169580,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and then you'd have to\nkeep doing it forever."
    } ]
  }, {
    "tStartMs": 1172400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So that's something I\ndefinitely don't have the time"
    } ]
  }, {
    "tStartMs": 1175130,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "and energy for, but Incogni\nmakes this really easy."
    } ]
  }, {
    "tStartMs": 1179120,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Just sign up and they'll\ngive you a list of companies"
    } ]
  }, {
    "tStartMs": 1181880,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that have your data, the\nseverity of each claim,"
    } ]
  }, {
    "tStartMs": 1184370,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and the status of each request."
    } ]
  }, {
    "tStartMs": 1186260,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So far, they have filed\n126 requests for me,"
    } ]
  }, {
    "tStartMs": 1189770,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "83 of which have been\ncompleted saving me over"
    } ]
  }, {
    "tStartMs": 1192350,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "62 hours of work, but the best\npart is since I signed up,"
    } ]
  }, {
    "tStartMs": 1196310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I've hardly gotten any more spam calls."
    } ]
  }, {
    "tStartMs": 1198890,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So to try Incogni and fight\nagainst the data brokers,"
    } ]
  }, {
    "tStartMs": 1201380,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "visit incog.com/veritasium."
    } ]
  }, {
    "tStartMs": 1204230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You can click that link\ndown in the description"
    } ]
  }, {
    "tStartMs": 1206210,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "or scan the QR code right here"
    } ]
  }, {
    "tStartMs": 1208310,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "and make sure to use the code\nveritasium to get 60% off."
    } ]
  }, {
    "tStartMs": 1212690,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So head over to\nincog.com/veritasium to get started."
    } ]
  }, {
    "tStartMs": 1216410,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I wanna thank Incogni for\nsponsoring this part of the video"
    } ]
  }, {
    "tStartMs": 1219200,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and now back to spacetime maps."
    } ]
  }, {
    "tStartMs": 1222590,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If you take this map and transform it"
    } ]
  }, {
    "tStartMs": 1225020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "so that incoming and outgoing light ray"
    } ]
  }, {
    "tStartMs": 1227150,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "all travel at 45 degrees\nlike we're used to,"
    } ]
  }, {
    "tStartMs": 1230510,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "then something fascinating happens."
    } ]
  }, {
    "tStartMs": 1233330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The black hole singularity on the left"
    } ]
  }, {
    "tStartMs": 1235880,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "transforms into a curved line at the top"
    } ]
  }, {
    "tStartMs": 1240020,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "and since the future always\npoints up in this map,"
    } ]
  }, {
    "tStartMs": 1244130,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "it tells us that the\nsingularity is not actually"
    } ]
  }, {
    "tStartMs": 1247460,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "a place in space, instead,\nit's a moment in time,"
    } ]
  }, {
    "tStartMs": 1252530,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the very last moment in time for anything"
    } ]
  }, {
    "tStartMs": 1255710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that enters a black hole."
    } ]
  }, {
    "tStartMs": 1258290,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "The map we've just created\nis a Kruskal-Szekers diagram,"
    } ]
  }, {
    "tStartMs": 1262100,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but this only represents\na portion of the universe,"
    } ]
  }, {
    "tStartMs": 1264950,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the part inside the\nblack holes event horizon"
    } ]
  }, {
    "tStartMs": 1267500,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and the part of the\nuniverse closest to it,"
    } ]
  }, {
    "tStartMs": 1270440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but what we can do is\ncontract the whole universe,"
    } ]
  }, {
    "tStartMs": 1273800,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "the infinite past, infinite\ndistance, and infinite future,"
    } ]
  }, {
    "tStartMs": 1277310,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and morph it into a single map."
    } ]
  }, {
    "tStartMs": 1280070,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "It's like using the\nuniverse's best fish eye lens."
    } ]
  }, {
    "tStartMs": 1284570,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "That gives us this penrose diagram."
    } ]
  }, {
    "tStartMs": 1288290,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Again, light rays still\nalways go at 45 degrees."
    } ]
  }, {
    "tStartMs": 1291530,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So the future always points up."
    } ]
  }, {
    "tStartMs": 1293930,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The infinite past is in\nthe bottom of the diagram."
    } ]
  }, {
    "tStartMs": 1296840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "The infinite future at the top"
    } ]
  }, {
    "tStartMs": 1299030,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and the sides on the right\nare infinitely far away."
    } ]
  }, {
    "tStartMs": 1302180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The black hole singularity\nis now a straight line"
    } ]
  }, {
    "tStartMs": 1304460,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "at the top, a final moment in time."
    } ]
  }, {
    "tStartMs": 1309200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "These lines are all at the same distance"
    } ]
  }, {
    "tStartMs": 1311450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "from the black hole."
    } ]
  }, {
    "tStartMs": 1312530,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So the singularity is at r equals zero,"
    } ]
  }, {
    "tStartMs": 1315110,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the horizon is at r equals 2M,"
    } ]
  }, {
    "tStartMs": 1317660,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "this line is at r equals 4M,"
    } ]
  }, {
    "tStartMs": 1319910,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and this is infinitely far away."
    } ]
  }, {
    "tStartMs": 1322880,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "All of these lines are at the same time."
    } ]
  }, {
    "tStartMs": 1325970,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "What's great about this map\nis that it's very easy to see"
    } ]
  }, {
    "tStartMs": 1329120,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "where you can still go and\nwhat could have affected you."
    } ]
  }, {
    "tStartMs": 1332660,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "For example, when you're here,\nyou've got a lot of freedom."
    } ]
  }, {
    "tStartMs": 1335480,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "You can enter the black\nhole or fly off to infinity,"
    } ]
  }, {
    "tStartMs": 1339050,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "and you can see and receive\ninformation from this area,"
    } ]
  }, {
    "tStartMs": 1343640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but if you go beyond the horizon,"
    } ]
  }, {
    "tStartMs": 1345950,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "your only possible future\nis to meet the singularity."
    } ]
  }, {
    "tStartMs": 1349820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You can still, however,\nsee and receive information"
    } ]
  }, {
    "tStartMs": 1352370,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "from the universe."
    } ]
  }, {
    "tStartMs": 1353510,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "You just can't send any back out."
    } ]
  }, {
    "tStartMs": 1356720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now think about being at\nthis point in the map."
    } ]
  }, {
    "tStartMs": 1359840,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is at the event horizon,"
    } ]
  }, {
    "tStartMs": 1361820,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "and now your entire future\nis within the black hole,"
    } ]
  }, {
    "tStartMs": 1365540,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but what is the past of this moment?"
    } ]
  }, {
    "tStartMs": 1368690,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Well, you can draw the past light cone"
    } ]
  }, {
    "tStartMs": 1371330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and it reveals this new region."
    } ]
  }, {
    "tStartMs": 1374330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you're inside this region,"
    } ]
  }, {
    "tStartMs": 1376160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you can send signals to the universe,"
    } ]
  }, {
    "tStartMs": 1378080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but no matter where you\nare in the universe,"
    } ]
  }, {
    "tStartMs": 1380390,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "nothing can ever enter this region"
    } ]
  }, {
    "tStartMs": 1382880,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "because it will never be\ninside your light comb."
    } ]
  }, {
    "tStartMs": 1386210,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So things can come out, but never go in."
    } ]
  }, {
    "tStartMs": 1389870,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "This is the opposite of a\nblack hole, a white hole."
    } ]
  }, {
    "tStartMs": 1395660,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "What color is a white hole?"
    } ]
  }, {
    "tStartMs": 1398602,
    "dDurationMs": 1124,
    "segs": [ {
      "utf8": "(Geraint exhales)"
    } ]
  }, {
    "tStartMs": 1399726,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 1400559,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "- I mean, it's gonna be the,"
    } ]
  }, {
    "tStartMs": 1402380,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "it's not gonna have a color, right?"
    } ]
  }, {
    "tStartMs": 1404049,
    "dDurationMs": 3251,
    "segs": [ {
      "utf8": "It's gonna be whatever's\nbeing spat out of it."
    } ]
  }, {
    "tStartMs": 1407300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "It depends what's in\nthere and gets thrown out,"
    } ]
  }, {
    "tStartMs": 1411560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that's what you are going to see."
    } ]
  }, {
    "tStartMs": 1413180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So if it's got light in\nthere, it's got mass in there,"
    } ]
  }, {
    "tStartMs": 1415400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "it's all gonna be ejected."
    } ]
  }, {
    "tStartMs": 1416660,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So the white hole kind of picture"
    } ]
  }, {
    "tStartMs": 1419330,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is the time reverse\npicture of a black hole,"
    } ]
  }, {
    "tStartMs": 1422450,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "instead of things falling in,\nthings get expelled outwards"
    } ]
  }, {
    "tStartMs": 1426920,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and so whilst a black hole has a membrane,"
    } ]
  }, {
    "tStartMs": 1431120,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the Schwarzschild horizon,\nwhich once you cross,"
    } ]
  }, {
    "tStartMs": 1433490,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you can't get back out, the\nwhite hole has the opposite."
    } ]
  }, {
    "tStartMs": 1436190,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "If you're inside the event\nhorizon, you have to be ejected,"
    } ]
  }, {
    "tStartMs": 1439610,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so it kicks you out kind of thing, right?"
    } ]
  }, {
    "tStartMs": 1441680,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Relativity doesn't tell\nyou which way time flows."
    } ]
  }, {
    "tStartMs": 1444710,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "There's nothing in there that\nsays that, that is the future"
    } ]
  }, {
    "tStartMs": 1448670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and that is the past."
    } ]
  }, {
    "tStartMs": 1450860,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "When you are doing your mathematics"
    } ]
  }, {
    "tStartMs": 1452390,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and you're working out\nthe behavior of objects,"
    } ]
  }, {
    "tStartMs": 1455360,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "you make a choice about which\ndirection is the future,"
    } ]
  }, {
    "tStartMs": 1459350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but mathematically, you could have chosen"
    } ]
  }, {
    "tStartMs": 1461450,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "the other way, right?"
    } ]
  }, {
    "tStartMs": 1462740,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "You could have had time point\nin the opposite direction."
    } ]
  }, {
    "tStartMs": 1465770,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Any solution that you find in relativity,"
    } ]
  }, {
    "tStartMs": 1468890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "mathematically, you can just flip it"
    } ]
  }, {
    "tStartMs": 1470990,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and get a time reverse solution"
    } ]
  }, {
    "tStartMs": 1472520,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "and that's also a\nsolution to the equations."
    } ]
  }, {
    "tStartMs": 1476270,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] Now, we've been showing things"
    } ]
  }, {
    "tStartMs": 1477890,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "being ejected to the right,\nbut they could just as well"
    } ]
  }, {
    "tStartMs": 1480980,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "be ejected to the left."
    } ]
  }, {
    "tStartMs": 1482690,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So what's over there?"
    } ]
  }, {
    "tStartMs": 1484670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This line is not at infinity,"
    } ]
  }, {
    "tStartMs": 1486590,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so there should be something beyond it."
    } ]
  }, {
    "tStartMs": 1489020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "If we eject things in this direction,"
    } ]
  }, {
    "tStartMs": 1491270,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "you find that they enter\na whole new universe,"
    } ]
  }, {
    "tStartMs": 1495620,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "one parallel to our own."
    } ]
  }, {
    "tStartMs": 1501560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Geraint] We can fall\ninto this black hole,"
    } ]
  }, {
    "tStartMs": 1503960,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and somebody in this universe here"
    } ]
  }, {
    "tStartMs": 1505370,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "could fall into this black\nhole in their universe,"
    } ]
  }, {
    "tStartMs": 1508250,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "and we would find ourselves\nin the same black hole."
    } ]
  }, {
    "tStartMs": 1511013,
    "dDurationMs": 1437,
    "segs": [ {
      "utf8": "(Derek chuckles)"
    } ]
  }, {
    "tStartMs": 1512450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- The only downside is that"
    } ]
  }, {
    "tStartMs": 1514580,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "we'd both soon end up in the singularity."
    } ]
  }, {
    "tStartMs": 1518600,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I guess I'm just trying to understand"
    } ]
  }, {
    "tStartMs": 1520190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "where that universe appears"
    } ]
  }, {
    "tStartMs": 1522380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in the mathematical part of the solution."
    } ]
  }, {
    "tStartMs": 1524900,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Like, can you point to the part\nof the equation and be like,"
    } ]
  }, {
    "tStartMs": 1527480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so that's our universe,\nand then these terms here,"
    } ]
  }, {
    "tStartMs": 1530780,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that's the other universe,\nor do you know what I mean?"
    } ]
  }, {
    "tStartMs": 1532970,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Like-\n- Yeah,"
    } ]
  }, {
    "tStartMs": 1533803,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "well, it's coordinates, right?"
    } ]
  }, {
    "tStartMs": 1535370,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Imagine somebody, right, came\nup with a coordinate system"
    } ]
  }, {
    "tStartMs": 1540800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "for the earth, but only\nthe northern hemisphere"
    } ]
  }, {
    "tStartMs": 1543680,
    "dDurationMs": 1977,
    "segs": [ {
      "utf8": "and you looked at that\ncoordinate system, right?"
    } ]
  }, {
    "tStartMs": 1545657,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "And you looked at it and you said,"
    } ]
  }, {
    "tStartMs": 1547467,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "\"Ah, I can see the coordinate\nsystem, it looks fine,"
    } ]
  }, {
    "tStartMs": 1550610,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "but mathematically latitudes\ncan be negative, right?"
    } ]
  }, {
    "tStartMs": 1555740,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "You've only got positive\nlatitudes in your solution."
    } ]
  }, {
    "tStartMs": 1558650,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "What about the negative ones?\""
    } ]
  }, {
    "tStartMs": 1559940,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And they said to you,\n(scoffs) \"Negative ones?"
    } ]
  }, {
    "tStartMs": 1562730,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "No southern hemisphere, right?\""
    } ]
  }, {
    "tStartMs": 1565310,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And you've gotta go, \"Well,\nthe mathematics says that"
    } ]
  }, {
    "tStartMs": 1568490,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you can have negative latitudes."
    } ]
  }, {
    "tStartMs": 1569930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Maybe we should go and\nlook over the equator"
    } ]
  }, {
    "tStartMs": 1572000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to see if there is something down there\""
    } ]
  }, {
    "tStartMs": 1573830,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and I know that's a\nkind of extreme example,"
    } ]
  }, {
    "tStartMs": 1576230,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "because we know we live on a globe,"
    } ]
  }, {
    "tStartMs": 1577790,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but we don't know the full geometry"
    } ]
  }, {
    "tStartMs": 1580070,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "of what's going on here in the sense that"
    } ]
  }, {
    "tStartMs": 1582920,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Schwarzschild laid down coordinates"
    } ]
  }, {
    "tStartMs": 1584810,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "over part of the solution."
    } ]
  }, {
    "tStartMs": 1586730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It was like him only\nlaying down coordinates"
    } ]
  }, {
    "tStartMs": 1588740,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "on the northern hemisphere"
    } ]
  }, {
    "tStartMs": 1590480,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "and other people have come along and said,"
    } ]
  }, {
    "tStartMs": 1592197,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "\"Hey, there's a southern hemisphere\""
    } ]
  }, {
    "tStartMs": 1594230,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and more than that, there's two earths."
    } ]
  }, {
    "tStartMs": 1596180,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "That's why it's called maximal extension."
    } ]
  }, {
    "tStartMs": 1599270,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "It's like, if I have this\nmathematical structure,"
    } ]
  }, {
    "tStartMs": 1603530,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "then what is the extent of the coordinates"
    } ]
  }, {
    "tStartMs": 1607730,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that I can consider?"
    } ]
  }, {
    "tStartMs": 1609710,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And with the Schwarzschild black hole,"
    } ]
  }, {
    "tStartMs": 1611480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "you get a second universe"
    } ]
  }, {
    "tStartMs": 1612680,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "that has its own independent\nset of coordinates"
    } ]
  }, {
    "tStartMs": 1616430,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "from our universe."
    } ]
  }, {
    "tStartMs": 1617690,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I want to emphasize right,\nthis is the simplest solution"
    } ]
  }, {
    "tStartMs": 1620750,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "to the Einstein field equations,"
    } ]
  }, {
    "tStartMs": 1622160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and it already contains a black hole,"
    } ]
  }, {
    "tStartMs": 1623660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "white hole and two universes."
    } ]
  }, {
    "tStartMs": 1625970,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Derek] That's what you get"
    } ]
  }, {
    "tStartMs": 1627140,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "when you push this map to its limits"
    } ]
  }, {
    "tStartMs": 1629600,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "so that every edge ends at\na singularity or infinity."
    } ]
  }, {
    "tStartMs": 1633830,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- And in fact, there's another\nlittle feature in here,"
    } ]
  }, {
    "tStartMs": 1636230,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "which is that, that little\npoint there where they cross,"
    } ]
  }, {
    "tStartMs": 1639470,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "that is an Einstein Rosen Bridge."
    } ]
  }, {
    "tStartMs": 1644120,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- To see it, we need\nto change coordinates."
    } ]
  }, {
    "tStartMs": 1647090,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Now this line is at constant crustal time"
    } ]
  }, {
    "tStartMs": 1650180,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and it connects the\nspace of both universes."
    } ]
  }, {
    "tStartMs": 1653720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "You can see what the spacetime is like"
    } ]
  }, {
    "tStartMs": 1655640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "by following this line from right to left."
    } ]
  }, {
    "tStartMs": 1658220,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Far away from the event horizon,"
    } ]
  }, {
    "tStartMs": 1659600,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "spacetime is basically flat,"
    } ]
  }, {
    "tStartMs": 1661430,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but as you get closer\nto the event horizon,"
    } ]
  }, {
    "tStartMs": 1663500,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "spacetime starts to curve more and more."
    } ]
  }, {
    "tStartMs": 1666230,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "At this cross, you are\nat the event horizon,"
    } ]
  }, {
    "tStartMs": 1669380,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and if you go beyond it, you\nend up in the parallel universe"
    } ]
  }, {
    "tStartMs": 1673460,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "that gives you a wormhole\nthat looks like this."
    } ]
  }, {
    "tStartMs": 1679730,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "- So that is hypothetically\nhow we could use a black hole"
    } ]
  }, {
    "tStartMs": 1684170,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to travel from one universe to another."
    } ]
  }, {
    "tStartMs": 1686840,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Hypothetically, because these wormholes"
    } ]
  }, {
    "tStartMs": 1688970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "aren't actually stable in time."
    } ]
  }, {
    "tStartMs": 1691760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- It's a bit like a bridge,\nbut it's a bridge that is long"
    } ]
  }, {
    "tStartMs": 1694340,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and then becomes shorter\nand then becomes long again"
    } ]
  }, {
    "tStartMs": 1697130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and if you try to traverse this bridge,"
    } ]
  }, {
    "tStartMs": 1699470,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "at some point, the bridge\nis only very short, right?"
    } ]
  }, {
    "tStartMs": 1701747,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "And you say, \"Oh, well, let\nme just cross this bridge.\""
    } ]
  }, {
    "tStartMs": 1703790,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "But as you start crossing\nthe bridge and start running,"
    } ]
  }, {
    "tStartMs": 1705851,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "your speed is finite, right?"
    } ]
  }, {
    "tStartMs": 1707450,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The speed of light roughly\nand then the bridge starts,"
    } ]
  }, {
    "tStartMs": 1710690,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "becoming stretching and you\nnever come out the other side."
    } ]
  }, {
    "tStartMs": 1715160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- [Derek] This pinching\noff always happens too fast"
    } ]
  }, {
    "tStartMs": 1718040,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "for anything to travel through."
    } ]
  }, {
    "tStartMs": 1720350,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "You can also see this if you\nlook at the Penrose diagram,"
    } ]
  }, {
    "tStartMs": 1723440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because when you're inside one universe,"
    } ]
  }, {
    "tStartMs": 1725360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "there isn't a light cone that can take you"
    } ]
  }, {
    "tStartMs": 1727610,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to the other universe."
    } ]
  }, {
    "tStartMs": 1729320,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "The only way to do that"
    } ]
  }, {
    "tStartMs": 1730430,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "would be to travel faster than light,"
    } ]
  }, {
    "tStartMs": 1734600,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but there might be another way."
    } ]
  }, {
    "tStartMs": 1737270,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Schwarzschild solution\ndescribes a black hole"
    } ]
  }, {
    "tStartMs": 1739340,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "that doesn't rotate."
    } ]
  }, {
    "tStartMs": 1740720,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Yet, every star does rotate"
    } ]
  }, {
    "tStartMs": 1742370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and since angular momentum\nmust be conserved,"
    } ]
  }, {
    "tStartMs": 1744710,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "every black hole must also be rotating."
    } ]
  }, {
    "tStartMs": 1748130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "While Schwarzschild found\nhis solution within weeks"
    } ]
  }, {
    "tStartMs": 1750380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "after Einstein published his equations,"
    } ]
  }, {
    "tStartMs": 1752300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "solving them for a spinning mass"
    } ]
  }, {
    "tStartMs": 1754040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "turned out to be much harder."
    } ]
  }, {
    "tStartMs": 1755960,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Physicists tried, but 10 years\nafter Schwarzschild solution,"
    } ]
  }, {
    "tStartMs": 1759260,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "they still hadn't solved it."
    } ]
  }, {
    "tStartMs": 1761060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "10 years turned into\n20, which turned into 40"
    } ]
  }, {
    "tStartMs": 1764300,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "and then in 1963, Roy\nKerr found the solution"
    } ]
  }, {
    "tStartMs": 1768290,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "to Einstein's equations\nfor a spinning black hole,"
    } ]
  }, {
    "tStartMs": 1772040,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "which is far more complicated\nthan Schwarzschild solution"
    } ]
  }, {
    "tStartMs": 1775940,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and this comes with a\nfew dramatic changes."
    } ]
  }, {
    "tStartMs": 1780170,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The first is that the structure\nis completely different."
    } ]
  }, {
    "tStartMs": 1783830,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The black hole now\nconsists of several layers."
    } ]
  }, {
    "tStartMs": 1787340,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's also not spherically\nsymmetric anymore."
    } ]
  }, {
    "tStartMs": 1790460,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "This happens because the rotation"
    } ]
  }, {
    "tStartMs": 1792170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "causes it to bulge around the equator."
    } ]
  }, {
    "tStartMs": 1794690,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "So it's only symmetric\nabout its axis of spin."
    } ]
  }, {
    "tStartMs": 1799910,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Alessandro from science\nclick simulated what happens"
    } ]
  }, {
    "tStartMs": 1802880,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "around this spinning black hole."
    } ]
  }, {
    "tStartMs": 1807470,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Space gets dragged around\nwith the black hole"
    } ]
  }, {
    "tStartMs": 1810320,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "taking you and the\nparticles along with it."
    } ]
  }, {
    "tStartMs": 1813110,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "When you get closer,\nspace gets dragged around"
    } ]
  }, {
    "tStartMs": 1815630,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "faster and faster until\nit goes around faster"
    } ]
  }, {
    "tStartMs": 1819020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "than the speed of light,"
    } ]
  }, {
    "tStartMs": 1820760,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "you've now entered into\nthe first new region,"
    } ]
  }, {
    "tStartMs": 1824330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the ergosphere."
    } ]
  }, {
    "tStartMs": 1826460,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "No matter how hard you\nfire your rockets here,"
    } ]
  }, {
    "tStartMs": 1829250,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "it's impossible to stay still\nrelative to distance stars,"
    } ]
  }, {
    "tStartMs": 1833570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but because space doesn't\nflow directly inward,"
    } ]
  }, {
    "tStartMs": 1836300,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "you can still escape the black hole."
    } ]
  }, {
    "tStartMs": 1839360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "When you travel in further,\nyou go through the next layer,"
    } ]
  }, {
    "tStartMs": 1842900,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "the outer horizon, the point of no return."
    } ]
  }, {
    "tStartMs": 1846650,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Here you can only go inwards,"
    } ]
  }, {
    "tStartMs": 1849620,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but as you get dragged\nin deeper and deeper,"
    } ]
  }, {
    "tStartMs": 1852710,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "something crazy happens,\nyou enter another region,"
    } ]
  }, {
    "tStartMs": 1857030,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "one where you can move\naround freely again,"
    } ]
  }, {
    "tStartMs": 1860660,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "so you're not doomed to the singularity."
    } ]
  }, {
    "tStartMs": 1863840,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "You're now inside the inner event horizon."
    } ]
  }, {
    "tStartMs": 1867500,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Here you can actually see the singularity"
    } ]
  }, {
    "tStartMs": 1872028,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "- In a normal black hole, it's a point,"
    } ]
  }, {
    "tStartMs": 1873350,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but it in a rotating black hole,"
    } ]
  }, {
    "tStartMs": 1874640,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "it actually expands out to be a ring"
    } ]
  }, {
    "tStartMs": 1877910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and there are weird things happened"
    } ]
  }, {
    "tStartMs": 1879560,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "with spacetime inside the\ncenter of a black hole,"
    } ]
  }, {
    "tStartMs": 1882650,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "a rotating black hole,"
    } ]
  }, {
    "tStartMs": 1883910,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "but it's thought that you can actually"
    } ]
  }, {
    "tStartMs": 1884990,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "fly through the singularity."
    } ]
  }, {
    "tStartMs": 1889850,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] We need a Penrose diagram"
    } ]
  }, {
    "tStartMs": 1891290,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "of a spinning black hole,\nwhere before the singularity"
    } ]
  }, {
    "tStartMs": 1895010,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "was a horizontal line at the top"
    } ]
  }, {
    "tStartMs": 1897170,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "here, the singularity lifts\nup and moves to the sides,"
    } ]
  }, {
    "tStartMs": 1900500,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "revealing this new region\ninside the inner horizon."
    } ]
  }, {
    "tStartMs": 1905240,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "Here we can move around freely\nand avoid the singularity,"
    } ]
  }, {
    "tStartMs": 1909740,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but these edges aren't at\ninfinity or a singularity,"
    } ]
  }, {
    "tStartMs": 1913190,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "so there must be something beyond them."
    } ]
  }, {
    "tStartMs": 1915920,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Well, when you venture further,"
    } ]
  }, {
    "tStartMs": 1917720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you could find yourself in a white hole,"
    } ]
  }, {
    "tStartMs": 1920720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "which would push you out\ninto a whole nother universe."
    } ]
  }, {
    "tStartMs": 1925640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- You can have these pictures whereby"
    } ]
  }, {
    "tStartMs": 1928520,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "you're in one universe, you\nfall into a rotating black hole,"
    } ]
  }, {
    "tStartMs": 1932690,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you fly through the singularity,"
    } ]
  }, {
    "tStartMs": 1934940,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and you pop out into a new\nuniverse from a white hole,"
    } ]
  }, {
    "tStartMs": 1938960,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and then you can just\ncontinue playing this game."
    } ]
  }, {
    "tStartMs": 1941870,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "- Extending this diagram infinitely far."
    } ]
  }, {
    "tStartMs": 1945860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but there is still one\nthing we haven't done,"
    } ]
  }, {
    "tStartMs": 1947750,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "brave the singularity."
    } ]
  }, {
    "tStartMs": 1950240,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So you aim straight towards\nthe center of the ring"
    } ]
  }, {
    "tStartMs": 1953390,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and head off towards it,\nbut rather than time ending,"
    } ]
  }, {
    "tStartMs": 1957140,
    "dDurationMs": 3426,
    "segs": [ {
      "utf8": "you now find yourself in\nuniverse, a strange universe,"
    } ]
  }, {
    "tStartMs": 1960566,
    "dDurationMs": 4284,
    "segs": [ {
      "utf8": "one where gravity pushes instead of pulls."
    } ]
  }, {
    "tStartMs": 1964850,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "This is known as an anti-verse."
    } ]
  }, {
    "tStartMs": 1968330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "If that's too weird,\nyou can always jump back"
    } ]
  }, {
    "tStartMs": 1970580,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "across the singularity\nand return to a universe"
    } ]
  }, {
    "tStartMs": 1973160,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "with normal gravity."
    } ]
  }, {
    "tStartMs": 1975470,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- And I know this is basically\nscience fiction, right?"
    } ]
  }, {
    "tStartMs": 1977720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "But if you take the\nsolutions of relativity at,"
    } ]
  }, {
    "tStartMs": 1982640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "you know, essentially at face\nvalue and add on a little bit,"
    } ]
  }, {
    "tStartMs": 1985520,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "which is what Penrose\ndoes here, he says this,"
    } ]
  }, {
    "tStartMs": 1987867,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "\"oh look, these shapes are very similar,"
    } ]
  }, {
    "tStartMs": 1990560,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I can just stick these together.\""
    } ]
  }, {
    "tStartMs": 1992150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Then this is the conclusion that you get."
    } ]
  }, {
    "tStartMs": 1994490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now we have effectively an infinite number"
    } ]
  }, {
    "tStartMs": 1997040,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "of universes all connected\nwith black hole, white holes"
    } ]
  }, {
    "tStartMs": 2000370,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "all the way through and\nyou, of you go to explore,"
    } ]
  }, {
    "tStartMs": 2005380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but it'll be a very brave\nperson who's the first one"
    } ]
  }, {
    "tStartMs": 2008410,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "who's gonna leap into\na rotating black hole"
    } ]
  }, {
    "tStartMs": 2010330,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "to find out if this is correct?"
    } ]
  }, {
    "tStartMs": 2011691,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "(Derek chuckles)"
    } ]
  }, {
    "tStartMs": 2013090,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Yeah, I would not sign up for that."
    } ]
  }, {
    "tStartMs": 2015820,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So could these maximally\nextended Schwarzschild"
    } ]
  }, {
    "tStartMs": 2018550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and Kerr solutions\nactually exist in nature?"
    } ]
  }, {
    "tStartMs": 2021670,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Well, there are some issues."
    } ]
  }, {
    "tStartMs": 2023770,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Both the extended Schwarzschild\nand Kerr solutions"
    } ]
  }, {
    "tStartMs": 2026590,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "are solutions of eternal black\nholes in an empty universe."
    } ]
  }, {
    "tStartMs": 2030850,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- As you say, it's an eternal solution."
    } ]
  }, {
    "tStartMs": 2032890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So it stretches infinitely\nfar into the past"
    } ]
  }, {
    "tStartMs": 2035590,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and infinitely far into the future"
    } ]
  }, {
    "tStartMs": 2037900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and so there's no formation\nmechanism in there,"
    } ]
  }, {
    "tStartMs": 2039940,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "it's just a static solution"
    } ]
  }, {
    "tStartMs": 2042640,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "and I think that is part of the,"
    } ]
  }, {
    "tStartMs": 2047380,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "part of the reason why black holes"
    } ]
  }, {
    "tStartMs": 2050860,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "are realized in our universe\nand white holes aren't-"
    } ]
  }, {
    "tStartMs": 2055150,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Or might not be."
    } ]
  }, {
    "tStartMs": 2056080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Or might not be,"
    } ]
  }, {
    "tStartMs": 2056913,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "or I'm reasonably I,"
    } ]
  }, {
    "tStartMs": 2058990,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "personally, I'm reasonably confident"
    } ]
  }, {
    "tStartMs": 2060580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that they don't exist, right?"
    } ]
  }, {
    "tStartMs": 2062500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- [Derek] For the maximally\nextended Kerr solution,"
    } ]
  }, {
    "tStartMs": 2064600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "there's also another problem."
    } ]
  }, {
    "tStartMs": 2066460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If you're an immortal\nastronaut inside the universe,"
    } ]
  }, {
    "tStartMs": 2068980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you can send light into the black hole,"
    } ]
  }, {
    "tStartMs": 2071320,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "but because there's\ninfinite time compressed"
    } ]
  }, {
    "tStartMs": 2074020,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "in this top corner, you can\npile up light along this edge,"
    } ]
  }, {
    "tStartMs": 2077890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which creates an infinite flux of energy"
    } ]
  }, {
    "tStartMs": 2080470,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "along the inner horizon."
    } ]
  }, {
    "tStartMs": 2082420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "This concentration of energy"
    } ]
  }, {
    "tStartMs": 2083860,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "then creates its own singularity,"
    } ]
  }, {
    "tStartMs": 2086650,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "sealing off the ring\nsingularity and beyond."
    } ]
  }, {
    "tStartMs": 2090040,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- My suspicion and the suspicion"
    } ]
  }, {
    "tStartMs": 2091750,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "of some other people in the field is that"
    } ]
  }, {
    "tStartMs": 2095200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "this inner horizon will become singular"
    } ]
  }, {
    "tStartMs": 2096880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and you will not be able to go\nthrough these second copies."
    } ]
  }, {
    "tStartMs": 2099760,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- So all the white holes,\nwormholes, other universes"
    } ]
  }, {
    "tStartMs": 2103000,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and anti universes disappear."
    } ]
  }, {
    "tStartMs": 2106360,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Does that mean that real\nwormholes are impossible?"
    } ]
  }, {
    "tStartMs": 2110050,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "In 1987, Michael Morris and\nKip Thorne looked at wormholes"
    } ]
  }, {
    "tStartMs": 2113170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that an advanced civilization could use"
    } ]
  }, {
    "tStartMs": 2115120,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "for interstellar travel,\nones that have no horizons,"
    } ]
  }, {
    "tStartMs": 2118090,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "so you can travel back and\nforth, are stable in time,"
    } ]
  }, {
    "tStartMs": 2120820,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and have some other properties like"
    } ]
  }, {
    "tStartMs": 2122740,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "being able to construct them."
    } ]
  }, {
    "tStartMs": 2124150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "They found several\ngeometries that are allowed"
    } ]
  }, {
    "tStartMs": 2126520,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "by Einstein's general relativity."
    } ]
  }, {
    "tStartMs": 2128950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "In theory, these could\nconnect different parts"
    } ]
  }, {
    "tStartMs": 2131110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "of the universe, making a\nsort of interstellar highway."
    } ]
  }, {
    "tStartMs": 2134200,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "They might even be able to\nconnect to different universes."
    } ]
  }, {
    "tStartMs": 2139690,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The only problem is that\nall these geometries"
    } ]
  }, {
    "tStartMs": 2142540,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "require an exotic kind of matter"
    } ]
  }, {
    "tStartMs": 2144340,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "with a negative energy density"
    } ]
  }, {
    "tStartMs": 2145750,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "to prevent the wormhole from collapsing."
    } ]
  }, {
    "tStartMs": 2148810,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- This exotic kind of matter,"
    } ]
  }, {
    "tStartMs": 2150550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is really against the\nloss of physics, so it's,"
    } ]
  }, {
    "tStartMs": 2154215,
    "dDurationMs": 2455,
    "segs": [ {
      "utf8": "I have the prejudice\nthat it will not exist."
    } ]
  }, {
    "tStartMs": 2156670,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I'm bothered by the fact that we say that"
    } ]
  }, {
    "tStartMs": 2158620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the science fiction wormholes\nare mathematically possible."
    } ]
  }, {
    "tStartMs": 2161980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's true, it's mathematically possible"
    } ]
  }, {
    "tStartMs": 2163570,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "in the sense that there's\nsome geometry that can exist,"
    } ]
  }, {
    "tStartMs": 2165850,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "but Einstein's theory\nis not just geometries,"
    } ]
  }, {
    "tStartMs": 2169600,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it's geometries plus field equations."
    } ]
  }, {
    "tStartMs": 2172210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If you use the kinds\nof properties of matter"
    } ]
  }, {
    "tStartMs": 2174490,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "that matter actually has,\nthen they're not possible."
    } ]
  }, {
    "tStartMs": 2177670,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "So I feel that the reason\nthey're not possible"
    } ]
  }, {
    "tStartMs": 2180990,
    "dDurationMs": 943,
    "segs": [ {
      "utf8": "is very strong."
    } ]
  }, {
    "tStartMs": 2182950,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- So according to our\ncurrent best understanding,"
    } ]
  }, {
    "tStartMs": 2185500,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "it seems likely that white\nholes, traversable wormholes,"
    } ]
  }, {
    "tStartMs": 2188680,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and these parallel universes don't exist,"
    } ]
  }, {
    "tStartMs": 2192190,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but we also used to think\nthat black holes didn't exist."
    } ]
  }, {
    "tStartMs": 2195490,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So maybe we'll be surprised again."
    } ]
  }, {
    "tStartMs": 2198610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- I mean, we have one universe, right?"
    } ]
  }, {
    "tStartMs": 2201460,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "Good, why can't we have two."
    } ]
  }, {
    "tStartMs": 2206040,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(whimsical music)"
    } ]
  } ]
}
