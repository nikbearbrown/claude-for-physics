{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 2232,
    "dDurationMs": 1002,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 3235,
    "dDurationMs": 1965,
    "segs": [ {
      "utf8": "- A man has been found lying dead"
    } ]
  }, {
    "tStartMs": 5200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "at the side of the road with oozing,"
    } ]
  }, {
    "tStartMs": 7360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "elongated wounds to his back."
    } ]
  }, {
    "tStartMs": 9440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "To solve the murder,"
    } ]
  }, {
    "tStartMs": 10480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "a local official calls all\nthe farmers in the village"
    } ]
  }, {
    "tStartMs": 13120,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and demands they all bring\ntheir tools to the main square."
    } ]
  }, {
    "tStartMs": 16560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "In the square, each man is\nset to lay down his sickle."
    } ]
  }, {
    "tStartMs": 19840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And then something\ncurious starts to happen."
    } ]
  }, {
    "tStartMs": 23040,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "In the rising heat of the\nmorning, flies begin to descend,"
    } ]
  }, {
    "tStartMs": 26800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "all landing on a single sickle."
    } ]
  }, {
    "tStartMs": 29200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Its owner buckles,"
    } ]
  }, {
    "tStartMs": 30800,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "falling to his knees and admits to murder."
    } ]
  }, {
    "tStartMs": 36320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This is from a 1247 book,"
    } ]
  }, {
    "tStartMs": 38400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "\"The Washing Away of Wrongs\" by Song Ci."
    } ]
  }, {
    "tStartMs": 40880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And it's the first writing we have"
    } ]
  }, {
    "tStartMs": 42480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "of an empirical approach to forensics."
    } ]
  }, {
    "tStartMs": 44960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But okay, big deal."
    } ]
  }, {
    "tStartMs": 46160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Anyone could have just swapped the sickles"
    } ]
  }, {
    "tStartMs": 47840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "or used their neighbor's."
    } ]
  }, {
    "tStartMs": 50080,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "But forensics today are\nmuch more accurate, right?"
    } ]
  }, {
    "tStartMs": 54320,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Fingerprints support investigations\nin over 70% of murders"
    } ]
  }, {
    "tStartMs": 58000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and DNA evidence in more than 90%."
    } ]
  }, {
    "tStartMs": 60800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But then you also read an article like"
    } ]
  }, {
    "tStartMs": 62640,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "\"Hair sample that put men\ninto prison for 28 years,"
    } ]
  }, {
    "tStartMs": 66400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "turned out to be dog hair.\""
    } ]
  }, {
    "tStartMs": 67600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- That is not science."
    } ]
  }, {
    "tStartMs": 69280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That is not justice."
    } ]
  }, {
    "tStartMs": 70480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- See, in 2009, the\nNational Academy of Sciences"
    } ]
  }, {
    "tStartMs": 73680,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "published this 350 page\nreport stating that,"
    } ]
  }, {
    "tStartMs": 77280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with the exception of\nnuclear DNA analysis,"
    } ]
  }, {
    "tStartMs": 79920,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "no forensic method has\nbeen rigorously shown"
    } ]
  }, {
    "tStartMs": 82400,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to consistently demonstrate a connection"
    } ]
  }, {
    "tStartMs": 84240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "between evidence and\na specific individual."
    } ]
  }, {
    "tStartMs": 86880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And they also said that some tests"
    } ]
  }, {
    "tStartMs": 88480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "do not meet the fundamental\nrequirements of science."
    } ]
  }, {
    "tStartMs": 91280,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "So we ask people to rank five\nfamous forensic techniques,"
    } ]
  }, {
    "tStartMs": 95040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "all of which are still\nbeing used in court."
    } ]
  }, {
    "tStartMs": 98080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Okay, five forensic techniques here."
    } ]
  }, {
    "tStartMs": 99760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And I just need you to rank them in order"
    } ]
  }, {
    "tStartMs": 101440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of accuracy from the\nleast accurate down here"
    } ]
  }, {
    "tStartMs": 103600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to the most accurate."
    } ]
  }, {
    "tStartMs": 104560,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "So what do you think?"
    } ]
  }, {
    "tStartMs": 105480,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- I don't know if I'm gonna nail these."
    } ]
  }, {
    "tStartMs": 107440,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "- Whoa. I dunno."
    } ]
  }, {
    "tStartMs": 108540,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- I don't know what\nforensic to put first here."
    } ]
  }, {
    "tStartMs": 110880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- Okay, hair. What are you thinking?"
    } ]
  }, {
    "tStartMs": 112400,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "- I think hair is last, eh?"
    } ]
  }, {
    "tStartMs": 114158,
    "dDurationMs": 3362,
    "segs": [ {
      "utf8": "- I would probably put\nthe hair on the top two."
    } ]
  }, {
    "tStartMs": 117520,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- I feel like hair would\nprobably be the easiest to,"
    } ]
  }, {
    "tStartMs": 119960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- To fake?\n- To fake, if you like."
    } ]
  }, {
    "tStartMs": 121880,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- I think hair at the bottom,"
    } ]
  }, {
    "tStartMs": 124000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because if it's not got\nthe follicle intact,"
    } ]
  }, {
    "tStartMs": 125920,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "just hair in general."
    } ]
  }, {
    "tStartMs": 126920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- Mm.\n- Do you think?"
    } ]
  }, {
    "tStartMs": 128440,
    "dDurationMs": 3222,
    "segs": [ {
      "utf8": "- Yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 131662,
    "dDurationMs": 16,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 131678,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "- Hair has always been\nan object of interest"
    } ]
  }, {
    "tStartMs": 133760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "for crime scene investigators."
    } ]
  }, {
    "tStartMs": 135440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And before DNA, they would look"
    } ]
  }, {
    "tStartMs": 137280,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "for the microscopic\nsimilarities in the surface"
    } ]
  }, {
    "tStartMs": 139840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and the cross section of\nhairs to try and get a match."
    } ]
  }, {
    "tStartMs": 142800,
    "dDurationMs": 2871,
    "segs": [ {
      "utf8": "For example, analyzing\nhow rough the fish scale"
    } ]
  }, {
    "tStartMs": 145671,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "like structure of the\nsurface of the hair is,"
    } ]
  }, {
    "tStartMs": 147680,
    "dDurationMs": 2946,
    "segs": [ {
      "utf8": "or how the pigment is distributed\nthrough the hair shaft."
    } ]
  }, {
    "tStartMs": 150626,
    "dDurationMs": 1374,
    "segs": [ {
      "utf8": "- [Announcer] The examiner's trained eye"
    } ]
  }, {
    "tStartMs": 152000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "can learn many things."
    } ]
  }, {
    "tStartMs": 153840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Is it human hair? Of what race?"
    } ]
  }, {
    "tStartMs": 156000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Animal hair? What family?"
    } ]
  }, {
    "tStartMs": 157680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This vital information may help"
    } ]
  }, {
    "tStartMs": 159360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to establish guilt or innocence"
    } ]
  }, {
    "tStartMs": 161400,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- Between the 1970s and 1999,"
    } ]
  }, {
    "tStartMs": 164400,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "the FBI used this against\ndefendants in 268 cases."
    } ]
  }, {
    "tStartMs": 169360,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But when they later reexamined\nthis using DNA as evidence,"
    } ]
  }, {
    "tStartMs": 172720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it completely flipped\nthe field on its head,"
    } ]
  }, {
    "tStartMs": 175120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and it turned out that even\nthe most experienced FBI"
    } ]
  }, {
    "tStartMs": 178240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "examiners would routinely\nclaim they had a match"
    } ]
  }, {
    "tStartMs": 180560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "between hairs that were\nfrom two different people."
    } ]
  }, {
    "tStartMs": 182720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And they sometimes couldn't\neven tell the difference"
    } ]
  }, {
    "tStartMs": 184480,
    "dDurationMs": 3827,
    "segs": [ {
      "utf8": "between a human hair and a dog hair."
    } ]
  }, {
    "tStartMs": 188307,
    "dDurationMs": 13,
    "segs": [ {
      "utf8": "(dog barking)"
    } ]
  }, {
    "tStartMs": 188320,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Out of those 268 cases that\nused microscopic hair analysis,"
    } ]
  }, {
    "tStartMs": 192400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "96% were declared false."
    } ]
  }, {
    "tStartMs": 195200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "33 people were already sentenced to death,"
    } ]
  }, {
    "tStartMs": 197520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and nine were already executed"
    } ]
  }, {
    "tStartMs": 199600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "by the time the errors were found."
    } ]
  }, {
    "tStartMs": 201680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Today, the FBI only uses hair as evidence"
    } ]
  }, {
    "tStartMs": 204160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "if it can be supported by DNA testing,"
    } ]
  }, {
    "tStartMs": 206480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "which is why microscopic hair analysis"
    } ]
  }, {
    "tStartMs": 208240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "goes to the bottom of this list."
    } ]
  }, {
    "tStartMs": 210160,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "What do you think of bite marks?"
    } ]
  }, {
    "tStartMs": 211120,
    "dDurationMs": 1505,
    "segs": [ {
      "utf8": "- On a crime scene?\n- On a crime scene?"
    } ]
  }, {
    "tStartMs": 212625,
    "dDurationMs": 495,
    "segs": [ {
      "utf8": "- Yeah, yeah.\n- It's been..."
    } ]
  }, {
    "tStartMs": 213120,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Dracula, is Dracula there?"
    } ]
  }, {
    "tStartMs": 214440,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- Least accurate is gonna be"
    } ]
  }, {
    "tStartMs": 216400,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "pretty close to bite marks, I think."
    } ]
  }, {
    "tStartMs": 218520,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "- Midway."
    } ]
  }, {
    "tStartMs": 219240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- Midway?\n- Last."
    } ]
  }, {
    "tStartMs": 220240,
    "dDurationMs": 4553,
    "segs": [ {
      "utf8": "That's last."
    } ]
  }, {
    "tStartMs": 224793,
    "dDurationMs": 70,
    "segs": [ {
      "utf8": "That's not realistic, innit?\n- Okay. Okay."
    } ]
  }, {
    "tStartMs": 224863,
    "dDurationMs": 3,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 224866,
    "dDurationMs": 654,
    "segs": [ {
      "utf8": "Bite marks at the top."
    } ]
  }, {
    "tStartMs": 225520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The idea behind bite marks is simple."
    } ]
  }, {
    "tStartMs": 227600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "If you can use dental records\nto identify a deceased person,"
    } ]
  }, {
    "tStartMs": 230720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "surely you can identify a perpetrator"
    } ]
  }, {
    "tStartMs": 232480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "by the bite marks left on a victim."
    } ]
  }, {
    "tStartMs": 234720,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Since the 1950s,"
    } ]
  }, {
    "tStartMs": 235840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "bite mark analysis has been\nused in thousands of cases."
    } ]
  }, {
    "tStartMs": 239520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But then some experts, like\nforensic dentist Mary Bush,"
    } ]
  }, {
    "tStartMs": 243120,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "started looking into\nthe method more deeply."
    } ]
  }, {
    "tStartMs": 245240,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "- There was no scientific exploration"
    } ]
  }, {
    "tStartMs": 248320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "into bite marks before they\nwere used in the court of law"
    } ]
  }, {
    "tStartMs": 251280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to say that this was even a feasible"
    } ]
  }, {
    "tStartMs": 253280,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "technique that you could do."
    } ]
  }, {
    "tStartMs": 254800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- One study from the university at Buffalo"
    } ]
  }, {
    "tStartMs": 257040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "used a set of model teeth to create"
    } ]
  }, {
    "tStartMs": 259360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "89 bite marks in cadavers,"
    } ]
  }, {
    "tStartMs": 261440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "alongside controlled\nbite marks made in wax."
    } ]
  }, {
    "tStartMs": 264240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And out of those 89\nbite marks made in skin,"
    } ]
  }, {
    "tStartMs": 267040,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "none of them matched the measurements"
    } ]
  }, {
    "tStartMs": 268400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of the ones made in wax or\nthe original model teeth."
    } ]
  }, {
    "tStartMs": 271840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "In fact, when they compared\nthe bite marks in skin"
    } ]
  }, {
    "tStartMs": 274400,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "to a wider collection of 411 model teeth,"
    } ]
  }, {
    "tStartMs": 277680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it wasn't even the original\nmodel that made the bite mark"
    } ]
  }, {
    "tStartMs": 280560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that was the closest match."
    } ]
  }, {
    "tStartMs": 282160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "After 12 studies, their conclusion,"
    } ]
  }, {
    "tStartMs": 285120,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "bite mark transfer to\nskin is not reliable."
    } ]
  }, {
    "tStartMs": 288400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Skin isn't a good medium"
    } ]
  }, {
    "tStartMs": 289680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to leave an imprint of\nsomeone's bite mark."
    } ]
  }, {
    "tStartMs": 291840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It's soft, it's squishy, and\nit distorts under pressure."
    } ]
  }, {
    "tStartMs": 294880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But despite all this,\nthere's still been no ban"
    } ]
  }, {
    "tStartMs": 297680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and bite mark evidence is still\nallowed in courts worldwide."
    } ]
  }, {
    "tStartMs": 301040,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "We asked Dr. Bush for a comment"
    } ]
  }, {
    "tStartMs": 302600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and she said that while\nthe scientific method"
    } ]
  }, {
    "tStartMs": 304800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "is happy to discard an\nold and disproven theory,"
    } ]
  }, {
    "tStartMs": 308000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the justice system prefers consistency"
    } ]
  }, {
    "tStartMs": 310240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "in a historical precedent."
    } ]
  }, {
    "tStartMs": 311680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So even the new flurry\nof evidence wasn't enough"
    } ]
  }, {
    "tStartMs": 313680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to get bite marks out of court."
    } ]
  }, {
    "tStartMs": 315600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "In fact, bite marks have\nbeen used as evidence"
    } ]
  }, {
    "tStartMs": 317840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "as recently as 2025,"
    } ]
  }, {
    "tStartMs": 319680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "which is why it gets the\nsecond worst spot on our list."
    } ]
  }, {
    "tStartMs": 323200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Blood, if you don't have DNA"
    } ]
  }, {
    "tStartMs": 324640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and you're just using\nlike kind of the patterns"
    } ]
  }, {
    "tStartMs": 326160,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "that it leaves along the ground."
    } ]
  }, {
    "tStartMs": 327440,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "How they splat.\n- Right?"
    } ]
  }, {
    "tStartMs": 328709,
    "dDurationMs": 811,
    "segs": [ {
      "utf8": "- [Gregor] Like the picture,"
    } ]
  }, {
    "tStartMs": 329520,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "that blood on a crime\nscene could give you."
    } ]
  }, {
    "tStartMs": 331400,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- Okay.\n- I'm looking,"
    } ]
  }, {
    "tStartMs": 332400,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "thinking of putting blood at the end,"
    } ]
  }, {
    "tStartMs": 333360,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "but like, I don't know.\n- Okay."
    } ]
  }, {
    "tStartMs": 334160,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "Put blood at the end.\n- Okay."
    } ]
  }, {
    "tStartMs": 334900,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "- I would go blood then"
    } ]
  }, {
    "tStartMs": 336080,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "- Second.\n- Second place."
    } ]
  }, {
    "tStartMs": 338613,
    "dDurationMs": 25,
    "segs": [ {
      "utf8": "- Yeah, yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 338638,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "- So bloodstain pattern analysis."
    } ]
  }, {
    "tStartMs": 340560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "When someone is injured,\nthe way their blood pools"
    } ]
  }, {
    "tStartMs": 343120,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and drips into the environment\nis in a distinct pattern."
    } ]
  }, {
    "tStartMs": 346080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And in 2020, \"Wired\"\nactually did an episode"
    } ]
  }, {
    "tStartMs": 348320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "with a crime scene analyst"
    } ]
  }, {
    "tStartMs": 349920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "on how these different\nstains can be interpreted."
    } ]
  }, {
    "tStartMs": 352560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You can use physics and\nbiology to rewind the clock"
    } ]
  }, {
    "tStartMs": 355360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and extrapolate where in space"
    } ]
  }, {
    "tStartMs": 357040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the blood must have come from."
    } ]
  }, {
    "tStartMs": 359280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This all started in 1971 when chemist,"
    } ]
  }, {
    "tStartMs": 361680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Herbert Leon MacDonell, published"
    } ]
  }, {
    "tStartMs": 363840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "\"Flight Characteristics and\nStain Patterns of Human Blood.\""
    } ]
  }, {
    "tStartMs": 366960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "In this book, MacDonell\ndescribed how you can use"
    } ]
  }, {
    "tStartMs": 369040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the width and length of a stain"
    } ]
  }, {
    "tStartMs": 370720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to calculate the angle of impact,"
    } ]
  }, {
    "tStartMs": 372640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and then using trigonometry,"
    } ]
  }, {
    "tStartMs": 374480,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "trace that back to the point\nof origin of the spatter."
    } ]
  }, {
    "tStartMs": 378160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The book quickly became the foundation"
    } ]
  }, {
    "tStartMs": 380000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of bloodstain pattern analysis,"
    } ]
  }, {
    "tStartMs": 381680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and everyone was using it."
    } ]
  }, {
    "tStartMs": 383440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "In fact, MacDonell even\nestablished a Bloodstain Institute"
    } ]
  }, {
    "tStartMs": 387040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "where thousands of US police\nofficers would enroll."
    } ]
  }, {
    "tStartMs": 389760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The Supreme Court of Iowa\nactually referred to the practice"
    } ]
  }, {
    "tStartMs": 392400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "as relatively uncomplicated."
    } ]
  }, {
    "tStartMs": 394640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So they didn't require\nproof of its reliability."
    } ]
  }, {
    "tStartMs": 397280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They were happy to go\nahead with MacDonell's tests"
    } ]
  }, {
    "tStartMs": 399680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that he did alone in his basement."
    } ]
  }, {
    "tStartMs": 402720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And soon enough,\nbloodstain pattern analysis"
    } ]
  }, {
    "tStartMs": 404960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "was used in courts all over the states."
    } ]
  }, {
    "tStartMs": 408560,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "But here's the problem."
    } ]
  }, {
    "tStartMs": 409600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Plotting the flight\npath of each bloodstain"
    } ]
  }, {
    "tStartMs": 411600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "using trigonometry\nassumes the trajectories"
    } ]
  }, {
    "tStartMs": 414000,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "were straight lines and gives\nthis common origin point,"
    } ]
  }, {
    "tStartMs": 417040,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "which suggests the victim was standing up."
    } ]
  }, {
    "tStartMs": 420320,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "The issue is,"
    } ]
  }, {
    "tStartMs": 421200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "MacDonell and then many forensic\ninvestigators after him"
    } ]
  }, {
    "tStartMs": 424000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and even \"Wired,\" failed to account"
    } ]
  }, {
    "tStartMs": 425840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for the effects of gravity and drag"
    } ]
  }, {
    "tStartMs": 428000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "as obvious as this sounds."
    } ]
  }, {
    "tStartMs": 429520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "When you include these\nin your calculations,"
    } ]
  }, {
    "tStartMs": 431440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "the common origin point lowers,"
    } ]
  }, {
    "tStartMs": 433200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and you can see that in this example."
    } ]
  }, {
    "tStartMs": 434880,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It's more likely that the victim\nwas actually sitting down."
    } ]
  }, {
    "tStartMs": 439120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The first study to measure\nthe baseline reliability"
    } ]
  }, {
    "tStartMs": 441760,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "of bloodstain pattern analysis\nwas only done in 2014."
    } ]
  }, {
    "tStartMs": 445760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "That's over 50 years"
    } ]
  }, {
    "tStartMs": 447040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "after it started being admitted in court."
    } ]
  }, {
    "tStartMs": 449360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And a large scale study from\n2021 found that analysts"
    } ]
  }, {
    "tStartMs": 452400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "come to different conclusions\nabout a way a stain was made,"
    } ]
  }, {
    "tStartMs": 455280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "about 8% of the time."
    } ]
  }, {
    "tStartMs": 456720,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And that's because the same stain"
    } ]
  }, {
    "tStartMs": 458000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "can come from many different mechanisms."
    } ]
  }, {
    "tStartMs": 459760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And the fact that blood\ndiffers from person to person,"
    } ]
  }, {
    "tStartMs": 462320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "depending on how many red blood cells"
    } ]
  }, {
    "tStartMs": 464240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "versus the plasma you have."
    } ]
  }, {
    "tStartMs": 465920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Men actually tend to have\na 15% higher concentration"
    } ]
  }, {
    "tStartMs": 469280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "of blood cells than women,"
    } ]
  }, {
    "tStartMs": 470560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "which makes their blood more viscous."
    } ]
  }, {
    "tStartMs": 472640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nowadays, investigators have new software"
    } ]
  }, {
    "tStartMs": 474640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "which uses fluid dynamics"
    } ]
  }, {
    "tStartMs": 476000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to help them map these complex 3D seams."
    } ]
  }, {
    "tStartMs": 478720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So bloodstain pattern analysis\nis improving in accuracy,"
    } ]
  }, {
    "tStartMs": 482080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "which is why it gets this\nmiddle spot in our list."
    } ]
  }, {
    "tStartMs": 484880,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 485600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But surely fingerprints"
    } ]
  }, {
    "tStartMs": 487440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "must have a lot of\nvalue in identification."
    } ]
  }, {
    "tStartMs": 489520,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "How unique do you think fingerprints are?"
    } ]
  }, {
    "tStartMs": 491160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- I think they're pretty accurate."
    } ]
  }, {
    "tStartMs": 493000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- They're fingerprints.\n- Fingerprints."
    } ]
  }, {
    "tStartMs": 494400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- That's probably one.\n- That's number one."
    } ]
  }, {
    "tStartMs": 496000,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "- Yeah.\n- Okay. Okay."
    } ]
  }, {
    "tStartMs": 496880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I mean, yeah, you use\nfingerprints on your phone,"
    } ]
  }, {
    "tStartMs": 498480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "you unlock it, you pay stuff, right?"
    } ]
  }, {
    "tStartMs": 499840,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- 'Cause fingerprints are unique."
    } ]
  }, {
    "tStartMs": 501200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Even when you have a passport,"
    } ]
  }, {
    "tStartMs": 502480,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "like they scan you when\nyou enter a country."
    } ]
  }, {
    "tStartMs": 504600,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- On March 11th, 2004,"
    } ]
  }, {
    "tStartMs": 507280,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "a terrorist organization\noperating in Madrid"
    } ]
  }, {
    "tStartMs": 509760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "set off explosions on\nfour commuter trains."
    } ]
  }, {
    "tStartMs": 512320,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "The attack killed 193 people\nand injured thousands more."
    } ]
  }, {
    "tStartMs": 517040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Quickly after, the police\nfound a finger mark"
    } ]
  }, {
    "tStartMs": 519360,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "on a detonator bag left behind,"
    } ]
  }, {
    "tStartMs": 521280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and they matched it to Brandon Mayfield,"
    } ]
  }, {
    "tStartMs": 523440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a lawyer in Oregon."
    } ]
  }, {
    "tStartMs": 525600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "There's only one problem,"
    } ]
  }, {
    "tStartMs": 527440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "there are no records of\nMayfield even leaving the US."
    } ]
  }, {
    "tStartMs": 530800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "He doesn't even own a passport."
    } ]
  }, {
    "tStartMs": 532640,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "So how could he have pulled this off?"
    } ]
  }, {
    "tStartMs": 534520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- I honestly felt like I was being framed"
    } ]
  }, {
    "tStartMs": 537280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "because I hadn't been outta\nthe country for over 10 years,"
    } ]
  }, {
    "tStartMs": 540080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- But despite that, the\nfingerprint evidence against him"
    } ]
  }, {
    "tStartMs": 542800,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "was considered so damning that\nMayfield was incarcerated."
    } ]
  }, {
    "tStartMs": 546720,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "But this wasn't a glitch."
    } ]
  }, {
    "tStartMs": 548000,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "It was built into the\nmethod from the start."
    } ]
  }, {
    "tStartMs": 551920,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "(groovy music)"
    } ]
  }, {
    "tStartMs": 552080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "In 1890s Kolkata,"
    } ]
  }, {
    "tStartMs": 553600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the city's rich career\ncriminals were avoiding jail"
    } ]
  }, {
    "tStartMs": 555920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "by paying people to\nserve sentences for them."
    } ]
  }, {
    "tStartMs": 558560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It was a good tactic since, at the time,"
    } ]
  }, {
    "tStartMs": 560640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "there was no practical\nway to identify a person."
    } ]
  }, {
    "tStartMs": 563120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So the criminals were\ngetting away with it."
    } ]
  }, {
    "tStartMs": 565200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Three officers, Edward Henry, Azizul Haque"
    } ]
  }, {
    "tStartMs": 567920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and Hem Chandra Bose"
    } ]
  }, {
    "tStartMs": 569120,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "started taking the prints"
    } ]
  }, {
    "tStartMs": 570080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "of everyone who came through the station,"
    } ]
  }, {
    "tStartMs": 572320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but they quickly ran into a problem."
    } ]
  }, {
    "tStartMs": 574880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "When they got a suspect in,"
    } ]
  }, {
    "tStartMs": 577120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "how could they crosscheck their prints"
    } ]
  }, {
    "tStartMs": 579120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "against their own database"
    } ]
  }, {
    "tStartMs": 580480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "when there were 10 prints per person"
    } ]
  }, {
    "tStartMs": 582320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and thousands of people coming through?"
    } ]
  }, {
    "tStartMs": 584960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "They needed a classification system."
    } ]
  }, {
    "tStartMs": 587760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Haque proposed that they should look at"
    } ]
  }, {
    "tStartMs": 589360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "whether a fingerprint has a whorl."
    } ]
  }, {
    "tStartMs": 591760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's the spiral pattern"
    } ]
  }, {
    "tStartMs": 592960,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that a person might have on their fingers."
    } ]
  }, {
    "tStartMs": 595040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And because each of your 10 digits"
    } ]
  }, {
    "tStartMs": 596960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "can either have a whorl or not,"
    } ]
  }, {
    "tStartMs": 599200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "there are a total of\ntwo to the power of 10"
    } ]
  }, {
    "tStartMs": 601520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "or 1024 ways your whorls can be arranged."
    } ]
  }, {
    "tStartMs": 605120,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So the officers just built\n1024 wooden pigeon holes"
    } ]
  }, {
    "tStartMs": 609440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "to organize these fingerprints."
    } ]
  }, {
    "tStartMs": 613280,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 613680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But what if like me,\nyou don't have a whorl?"
    } ]
  }, {
    "tStartMs": 615760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Well, two thirds of the\npopulation actually don't."
    } ]
  }, {
    "tStartMs": 618640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So the system had to go further."
    } ]
  }, {
    "tStartMs": 620480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Once you have a pigeonhole number,"
    } ]
  }, {
    "tStartMs": 621920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you go for additional\nlayers of identification."
    } ]
  }, {
    "tStartMs": 624320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Some of the additional categories"
    } ]
  }, {
    "tStartMs": 625600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that you could assign included\nwhether you had a plain arch,"
    } ]
  }, {
    "tStartMs": 628640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "which was denoted with the letter A,"
    } ]
  }, {
    "tStartMs": 630720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "or whether you had a tented arch,"
    } ]
  }, {
    "tStartMs": 632640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which was denoted with a T."
    } ]
  }, {
    "tStartMs": 634640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Similarly, you could look at which side"
    } ]
  }, {
    "tStartMs": 636560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of the finger this loop structure is on."
    } ]
  }, {
    "tStartMs": 638960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And with a few more\nidentifiers like these,"
    } ]
  }, {
    "tStartMs": 641280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "we get a much more\nin-depth classification,"
    } ]
  }, {
    "tStartMs": 644640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "one that would go on to be\nused for the next 100 years."
    } ]
  }, {
    "tStartMs": 648720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Famously, the world's\nfirst fingerprint bureau,"
    } ]
  }, {
    "tStartMs": 651200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which was established in London\nin the New Scotland Yard,"
    } ]
  }, {
    "tStartMs": 654320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "used this fingerprinting system."
    } ]
  }, {
    "tStartMs": 655920,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "- I started in 1988\nwith Metropolitan Police"
    } ]
  }, {
    "tStartMs": 660320,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "in forensic services."
    } ]
  }, {
    "tStartMs": 661400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Could you paint a\npicture of what the room"
    } ]
  }, {
    "tStartMs": 664160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "would've looked like with\nall these pigeonholes?"
    } ]
  }, {
    "tStartMs": 666320,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "How big was this space?"
    } ]
  }, {
    "tStartMs": 667400,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- So we're looking at a space of about"
    } ]
  }, {
    "tStartMs": 670240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "30 to 40 meters in length"
    } ]
  }, {
    "tStartMs": 672560,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and about 10 to 20 meters in width."
    } ]
  }, {
    "tStartMs": 675920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The collection at the time was about"
    } ]
  }, {
    "tStartMs": 678160,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "3 to 4 million I think."
    } ]
  }, {
    "tStartMs": 679560,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- That is intense."
    } ]
  }, {
    "tStartMs": 680480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Yeah, that's wow."
    } ]
  }, {
    "tStartMs": 681920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- It's a lot of fingerprints."
    } ]
  }, {
    "tStartMs": 683760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "- Now, today's system takes into account"
    } ]
  }, {
    "tStartMs": 687280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "these little details along the ridges."
    } ]
  }, {
    "tStartMs": 689520,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It's called friction ridge analysis."
    } ]
  }, {
    "tStartMs": 691600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And well, it's no surprise that"
    } ]
  }, {
    "tStartMs": 692800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "combing through pigeon holes\nfor these would've taken weeks,"
    } ]
  }, {
    "tStartMs": 695520,
    "dDurationMs": 5825,
    "segs": [ {
      "utf8": "but online databases today can\nbasically do it in minutes."
    } ]
  }, {
    "tStartMs": 701345,
    "dDurationMs": 15,
    "segs": [ {
      "utf8": "(phone ringing)"
    } ]
  }, {
    "tStartMs": 701360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "No way this phone works."
    } ]
  }, {
    "tStartMs": 704800,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Hello?\n- Howdy, Gregor."
    } ]
  }, {
    "tStartMs": 706560,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Just trying to get a hold of you."
    } ]
  }, {
    "tStartMs": 708040,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "- Why are you calling\nme through this thing?"
    } ]
  }, {
    "tStartMs": 710617,
    "dDurationMs": 23,
    "segs": [ {
      "utf8": "(caller speaks faintly)"
    } ]
  }, {
    "tStartMs": 710640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "You have no data?"
    } ]
  }, {
    "tStartMs": 712000,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Just get Saily."
    } ]
  }, {
    "tStartMs": 712880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- You know, I travel a lot for filming."
    } ]
  }, {
    "tStartMs": 714720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "I actually just got to London."
    } ]
  }, {
    "tStartMs": 718400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I always wanna be able to\nconnect to the internet"
    } ]
  }, {
    "tStartMs": 720320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "as soon as I land,"
    } ]
  }, {
    "tStartMs": 722000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and with the help of\ntoday's sponsor, Saily,"
    } ]
  }, {
    "tStartMs": 724960,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "it couldn't be easier."
    } ]
  }, {
    "tStartMs": 726320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "First, you just scan the QR\ncode and download the Saily app,"
    } ]
  }, {
    "tStartMs": 729360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "then you search your\ndestination, the UK, for example."
    } ]
  }, {
    "tStartMs": 732400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And next you just pick a data plan."
    } ]
  }, {
    "tStartMs": 734320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And finally, during checkout,"
    } ]
  }, {
    "tStartMs": 735600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "apply the coupon code Veritasium"
    } ]
  }, {
    "tStartMs": 737360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to get your exclusive 15% discount."
    } ]
  }, {
    "tStartMs": 740000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "No more dodgy cafe wifi or\nunexpected roaming charges."
    } ]
  }, {
    "tStartMs": 744000,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "All you need to do is just"
    } ]
  }, {
    "tStartMs": 745120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "switch on your mobile data when you land,"
    } ]
  }, {
    "tStartMs": 747200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "and that's it."
    } ]
  }, {
    "tStartMs": 748320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Saily works with all\niPhone and Android devices."
    } ]
  }, {
    "tStartMs": 751200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And once an eSIM is installed,"
    } ]
  }, {
    "tStartMs": 753120,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "you can keep adding plans in\nthe app for each new trip."
    } ]
  }, {
    "tStartMs": 756400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And in the rare case that your phone"
    } ]
  }, {
    "tStartMs": 757840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "isn't compatible with Saily,"
    } ]
  }, {
    "tStartMs": 759280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "you can get a full refund\nat no questions asked."
    } ]
  }, {
    "tStartMs": 762080,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "I've gone with the Saily Ultra Plan,"
    } ]
  }, {
    "tStartMs": 763840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "which gets you unlimited data globally"
    } ]
  }, {
    "tStartMs": 765680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with access to airport\nlounges, fast track services,"
    } ]
  }, {
    "tStartMs": 768320,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and NordVPN, NordPass,\nNordLocker and Incogni on top."
    } ]
  }, {
    "tStartMs": 772080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So to stay connected on the\ngo for an affordable price,"
    } ]
  }, {
    "tStartMs": 774960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "you can scan this QR code, download Saily,"
    } ]
  }, {
    "tStartMs": 777200,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and get 15% off your plan with\nthe coupon code Veritasium."
    } ]
  }, {
    "tStartMs": 780960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So I wanna thank Saily for sponsoring"
    } ]
  }, {
    "tStartMs": 782720,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "this part of the video,"
    } ]
  }, {
    "tStartMs": 783680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and now back to our case."
    } ]
  }, {
    "tStartMs": 786000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So if all the details\nare painstakingly placed"
    } ]
  }, {
    "tStartMs": 789200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "into these databases,\nthen where's the problem?"
    } ]
  }, {
    "tStartMs": 792400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "How is Brandon Mayfield falsely accused?"
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Well, say you have a mark from a scene"
    } ]
  }, {
    "tStartMs": 797440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and you wanna run it through\nthe US fingerprint database,"
    } ]
  }, {
    "tStartMs": 800640,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "you can't actually search the\ndatabase using the whole mark"
    } ]
  }, {
    "tStartMs": 804160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "because you first need to identify"
    } ]
  }, {
    "tStartMs": 806000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "a number of features on the print."
    } ]
  }, {
    "tStartMs": 808640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "These are called minutiae."
    } ]
  }, {
    "tStartMs": 810320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's where the ridge line split or end."
    } ]
  }, {
    "tStartMs": 813440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- To even search the database,"
    } ]
  }, {
    "tStartMs": 816640,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "you need a minimum number\nof minutiae points."
    } ]
  }, {
    "tStartMs": 820160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It's very efficiently sorted,"
    } ]
  }, {
    "tStartMs": 822240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "hundreds of million prints,"
    } ]
  }, {
    "tStartMs": 823920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "but it cannot make an ID."
    } ]
  }, {
    "tStartMs": 825760,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So what it does, it pulls\nout the most similar ones,"
    } ]
  }, {
    "tStartMs": 829760,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "at least 10, 20 up to\n40 in some jurisdiction."
    } ]
  }, {
    "tStartMs": 834800,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And then the human\nexaminer has to compare."
    } ]
  }, {
    "tStartMs": 838320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- [Gregor] This works in\ntheory, but the problem is"
    } ]
  }, {
    "tStartMs": 841040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "how these minutiae are\nidentified in the first place."
    } ]
  }, {
    "tStartMs": 844000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- What is interesting in my research"
    } ]
  }, {
    "tStartMs": 846720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "published scientific reviewed research,"
    } ]
  }, {
    "tStartMs": 849600,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "the same thing one examiner\nsee only three minutiae"
    } ]
  }, {
    "tStartMs": 854720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and one sees 10 minutiae."
    } ]
  }, {
    "tStartMs": 856800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So 10 minutiae is enough\nto run the database."
    } ]
  }, {
    "tStartMs": 859840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "However, if the other are\nonly the three minutiae,"
    } ]
  }, {
    "tStartMs": 863200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "they couldn't run it."
    } ]
  }, {
    "tStartMs": 864400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So whether you find a criminal or not"
    } ]
  }, {
    "tStartMs": 867520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "depends on the luck of the draw."
    } ]
  }, {
    "tStartMs": 869280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Even if you give the same pair of prints"
    } ]
  }, {
    "tStartMs": 871680,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "to the same examiner\ntwice, 10% of the time,"
    } ]
  }, {
    "tStartMs": 875920,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "they will reach a different decision."
    } ]
  }, {
    "tStartMs": 878120,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- And these disagreements\nare from controlled studies"
    } ]
  }, {
    "tStartMs": 881440,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "where the examiners had no\ncontext about the crime,"
    } ]
  }, {
    "tStartMs": 884400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "but in reality, they often do."
    } ]
  }, {
    "tStartMs": 886480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "As many as 42% of the requests"
    } ]
  }, {
    "tStartMs": 888640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that fingerprint experts process"
    } ]
  }, {
    "tStartMs": 890480,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "state whether a suspect\nhas a criminal record."
    } ]
  }, {
    "tStartMs": 893680,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "- In a recent case that I was involved"
    } ]
  }, {
    "tStartMs": 897840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "where a firearm was involved"
    } ]
  }, {
    "tStartMs": 899760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and a forensic firearm expert"
    } ]
  }, {
    "tStartMs": 902400,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "had to decide whether a\nbullet was actually fired"
    } ]
  }, {
    "tStartMs": 906640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "on the firearm, on the suspect."
    } ]
  }, {
    "tStartMs": 908960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "On the former submission form"
    } ]
  }, {
    "tStartMs": 911360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that was given to the forensic scientist,"
    } ]
  }, {
    "tStartMs": 914240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it said that it's homicide,"
    } ]
  }, {
    "tStartMs": 917120,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "it said the age of the\nsuspect and the victim,"
    } ]
  }, {
    "tStartMs": 920800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and it even said the race."
    } ]
  }, {
    "tStartMs": 922320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It said the suspect is black,"
    } ]
  }, {
    "tStartMs": 924480,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and the person who died\nthe victim was white."
    } ]
  }, {
    "tStartMs": 927760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- For over a century,"
    } ]
  }, {
    "tStartMs": 929680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "experts have held so much\ntrust in fingerprints"
    } ]
  }, {
    "tStartMs": 932480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that in the FBI case for Mayfield,"
    } ]
  }, {
    "tStartMs": 934560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "the examiners claimed with 100% certainty"
    } ]
  }, {
    "tStartMs": 937280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that that was his mark."
    } ]
  }, {
    "tStartMs": 939120,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This likely happened because\nwhen another fingerprint expert"
    } ]
  }, {
    "tStartMs": 941920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "was brought in to verify the match,"
    } ]
  }, {
    "tStartMs": 943840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they probably already knew the verdict"
    } ]
  }, {
    "tStartMs": 945760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of the original analyst,"
    } ]
  }, {
    "tStartMs": 947680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and they probably also knew the stakes"
    } ]
  }, {
    "tStartMs": 950080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of what a match could mean for the case,"
    } ]
  }, {
    "tStartMs": 952240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which made it all the easier to agree"
    } ]
  }, {
    "tStartMs": 954240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "with the initial verdict."
    } ]
  }, {
    "tStartMs": 955680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Even the fingerprint expert\nworking for the defense"
    } ]
  }, {
    "tStartMs": 958400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "agreed that the mark matched\nMayfield's fingerprint"
    } ]
  }, {
    "tStartMs": 961360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "when in reality, it belonged to a man"
    } ]
  }, {
    "tStartMs": 963440,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "who had links to terrorist\norganizations in Spain."
    } ]
  }, {
    "tStartMs": 967120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is the impact of conformity bias."
    } ]
  }, {
    "tStartMs": 969160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- So all of this pressure,"
    } ]
  }, {
    "tStartMs": 970880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "all of this context and intervention"
    } ]
  }, {
    "tStartMs": 973440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "in the forensic science,"
    } ]
  }, {
    "tStartMs": 975280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I say to the police and the prosecutor,"
    } ]
  }, {
    "tStartMs": 978080,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "leave the forensic examiners alone."
    } ]
  }, {
    "tStartMs": 981280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Give them independence of mind"
    } ]
  }, {
    "tStartMs": 983360,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "to make decision based on the\nrelevant scientific evidence"
    } ]
  }, {
    "tStartMs": 988000,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "and do the work rather than\ntelling them about the case."
    } ]
  }, {
    "tStartMs": 992440,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- Well, if there were issues"
    } ]
  }, {
    "tStartMs": 995360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with all these other techniques,"
    } ]
  }, {
    "tStartMs": 997520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "why don't we just use,"
    } ]
  }, {
    "tStartMs": 999040,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- DNA?\n- DNA first?"
    } ]
  }, {
    "tStartMs": 1000360,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1000880,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- DNA has got to be surely,\n- DNA should be top."
    } ]
  }, {
    "tStartMs": 1004200,
    "dDurationMs": 2038,
    "segs": [ {
      "utf8": "- It has to be DNA because,\n- Okay, okay."
    } ]
  }, {
    "tStartMs": 1006238,
    "dDurationMs": 2162,
    "segs": [ {
      "utf8": "- You already know everyone\nhave their own DNA."
    } ]
  }, {
    "tStartMs": 1008400,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "- But even DNA analysis can\nfall prey to the same problems."
    } ]
  }, {
    "tStartMs": 1012560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Back in the 80s,"
    } ]
  }, {
    "tStartMs": 1013760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "you had to do this with a sample the size"
    } ]
  }, {
    "tStartMs": 1016000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of a dime of blood or saliva."
    } ]
  }, {
    "tStartMs": 1018160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But today you can do it with\nless than a pin hair's worth."
    } ]
  }, {
    "tStartMs": 1020960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "In fact, just this year\na 61-year-old cold case"
    } ]
  }, {
    "tStartMs": 1023920,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "was solved with just 0.4 nanograms of DNA."
    } ]
  }, {
    "tStartMs": 1028320,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But the paradox is, the\nincreasing sensitivity"
    } ]
  }, {
    "tStartMs": 1031680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "of DNA analysis could\nalso be its downfall."
    } ]
  }, {
    "tStartMs": 1035760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In 2012, paramedics in\nCalifornia responded to a call"
    } ]
  }, {
    "tStartMs": 1039120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "about a severely intoxicated homeless man."
    } ]
  }, {
    "tStartMs": 1041760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They treated him and\ntook him to the hospital,"
    } ]
  }, {
    "tStartMs": 1044160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but along the way, they\nalso picked up traces"
    } ]
  }, {
    "tStartMs": 1046320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of his DNA on their equipment and gloves."
    } ]
  }, {
    "tStartMs": 1049280,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Then later that night,\nthey responded to a murder"
    } ]
  }, {
    "tStartMs": 1051840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of a businessman and they\naccidentally transferred"
    } ]
  }, {
    "tStartMs": 1054480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the homeless man's DNA to\nthe victim's fingernails."
    } ]
  }, {
    "tStartMs": 1058080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Because of that, the\nhomeless man, Lucas Anderson,"
    } ]
  }, {
    "tStartMs": 1060480,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "was charged with murder and\nhe faced the death penalty"
    } ]
  }, {
    "tStartMs": 1063520,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "despite being hospitalized at\nthe time the crime occurred."
    } ]
  }, {
    "tStartMs": 1067040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "He spent five months in jail"
    } ]
  }, {
    "tStartMs": 1068720,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "before charges were finally dropped."
    } ]
  }, {
    "tStartMs": 1070840,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "- So this is trace DNA and touch DNA,"
    } ]
  }, {
    "tStartMs": 1074160,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "where you can get this kind\nof DNA transfer that happens."
    } ]
  }, {
    "tStartMs": 1077240,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- I see how that could be abused easily."
    } ]
  }, {
    "tStartMs": 1079120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So my DNA could be in a\nplace I've never been before."
    } ]
  }, {
    "tStartMs": 1081680,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1082560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- And if DNA is deposited\nunder the right conditions,"
    } ]
  }, {
    "tStartMs": 1085760,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "say a dark dry place, it can\npersist for hundreds of years."
    } ]
  }, {
    "tStartMs": 1089960,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "- And if, for example,\nsomebody touches a door handle,"
    } ]
  }, {
    "tStartMs": 1094160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "well, loads of people are gonna\nbe touching a door handle,"
    } ]
  }, {
    "tStartMs": 1097040,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "so you're definitely going to get"
    } ]
  }, {
    "tStartMs": 1098400,
    "dDurationMs": 2629,
    "segs": [ {
      "utf8": "more than one profile off of there."
    } ]
  }, {
    "tStartMs": 1101029,
    "dDurationMs": 2251,
    "segs": [ {
      "utf8": "- [Gregor] These samples\nwith multiple DNA profiles"
    } ]
  }, {
    "tStartMs": 1103280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "are called DNA mixtures,"
    } ]
  }, {
    "tStartMs": 1105120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and they have been found to be"
    } ]
  }, {
    "tStartMs": 1106320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the most common source of\nerror in DNA interpretation."
    } ]
  }, {
    "tStartMs": 1109360,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- Some people shed more cells than others,"
    } ]
  }, {
    "tStartMs": 1113200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "so the majority of the\nDNA that you're getting"
    } ]
  }, {
    "tStartMs": 1115360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "off of that door handle may not be"
    } ]
  }, {
    "tStartMs": 1116880,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "from the last person who touched it."
    } ]
  }, {
    "tStartMs": 1118520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- The problem in interpreting a mixture"
    } ]
  }, {
    "tStartMs": 1120560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "comes down to how a sample gets analyzed."
    } ]
  }, {
    "tStartMs": 1123360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "The most common way to do it"
    } ]
  }, {
    "tStartMs": 1124720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "uses short tandem repeats or STRs."
    } ]
  }, {
    "tStartMs": 1128160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "DNA is made up of four nucleotides,"
    } ]
  }, {
    "tStartMs": 1130720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "G, A, T and C."
    } ]
  }, {
    "tStartMs": 1132560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And the SDR method looks\nat how chunks of DNA,"
    } ]
  }, {
    "tStartMs": 1135360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "usually three to five nucleotides long"
    } ]
  }, {
    "tStartMs": 1137760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "repeat in your genome."
    } ]
  }, {
    "tStartMs": 1139200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "For example, G-A-T-A, G-A-T-A and so on."
    } ]
  }, {
    "tStartMs": 1142560,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "For one person, they might\nhave G-A-T-A repeat six times,"
    } ]
  }, {
    "tStartMs": 1146320,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "whereas another individual\nmight have nine repetitions."
    } ]
  }, {
    "tStartMs": 1150640,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "A standard SDR test will look at around"
    } ]
  }, {
    "tStartMs": 1153360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "20 locations on your genome"
    } ]
  }, {
    "tStartMs": 1154960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for where these repeats can occur,"
    } ]
  }, {
    "tStartMs": 1156880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and it will count how many repeats"
    } ]
  }, {
    "tStartMs": 1158880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you have in each location."
    } ]
  }, {
    "tStartMs": 1160320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- So if you are looking\nat 20 of these markers"
    } ]
  }, {
    "tStartMs": 1163280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and you've got one from\nmom and one from dad,"
    } ]
  }, {
    "tStartMs": 1165120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you're actually getting 40 different"
    } ]
  }, {
    "tStartMs": 1167520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "genetic markers coming back."
    } ]
  }, {
    "tStartMs": 1169680,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "So the chances of somebody\nhaving the same combination"
    } ]
  }, {
    "tStartMs": 1174160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of genetic markers as you\nis around one in a billion."
    } ]
  }, {
    "tStartMs": 1177600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- Here's what a crime\nscene sample containing"
    } ]
  }, {
    "tStartMs": 1179920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "just one contributor\nlooks like on an STR test."
    } ]
  }, {
    "tStartMs": 1183040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "You can see how it's easy to compare this"
    } ]
  }, {
    "tStartMs": 1184880,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to a sample from a suspect."
    } ]
  }, {
    "tStartMs": 1187120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But if the crime scene sample contains DNA"
    } ]
  }, {
    "tStartMs": 1189680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "from multiple individuals,"
    } ]
  }, {
    "tStartMs": 1191360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "then their profiles will begin to overlap,"
    } ]
  }, {
    "tStartMs": 1193840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "all with varying signal strengths."
    } ]
  }, {
    "tStartMs": 1196000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And the more individuals in the mixture,"
    } ]
  }, {
    "tStartMs": 1198000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the more difficult these\nresults are to interpret."
    } ]
  }, {
    "tStartMs": 1200320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "With four or more individuals,"
    } ]
  }, {
    "tStartMs": 1202000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "it becomes increasingly hard to compare"
    } ]
  }, {
    "tStartMs": 1203920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "a clean DNA profile from\na suspect to the mixture."
    } ]
  }, {
    "tStartMs": 1207600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And now it's hard to\nsay whether the suspect"
    } ]
  }, {
    "tStartMs": 1209600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "was actually in the sample."
    } ]
  }, {
    "tStartMs": 1211040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You just can't tell which\npeak belongs to who."
    } ]
  }, {
    "tStartMs": 1213680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It's kind of like having\nfive people talk to you"
    } ]
  }, {
    "tStartMs": 1216160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "at the same time."
    } ]
  }, {
    "tStartMs": 1217680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "You can hear all the noise,"
    } ]
  }, {
    "tStartMs": 1218880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but it's really hard to single one out."
    } ]
  }, {
    "tStartMs": 1221040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Now, some labs claim they\ncan reliably separate samples"
    } ]
  }, {
    "tStartMs": 1224400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "of up to five individuals."
    } ]
  }, {
    "tStartMs": 1226640,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "And to test this,"
    } ]
  }, {
    "tStartMs": 1227680,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the National Institute of\nStandards and Technology"
    } ]
  }, {
    "tStartMs": 1230480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "ran a controlled study in 2013."
    } ]
  }, {
    "tStartMs": 1233120,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "They've sent out a DNA mixture\nfrom a fictional crime scene"
    } ]
  }, {
    "tStartMs": 1236080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to labs all across the US."
    } ]
  }, {
    "tStartMs": 1238080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Their aim to see how different facilities"
    } ]
  }, {
    "tStartMs": 1240400,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "interpret the same mixture of\nfour people's DNA profiles."
    } ]
  }, {
    "tStartMs": 1244480,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "69% of the labs got the analysis wrong."
    } ]
  }, {
    "tStartMs": 1247760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And despite the sample\nbeing deliberately complex,"
    } ]
  }, {
    "tStartMs": 1251120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "only 21% of the labs\ndeemed the mix inconclusive"
    } ]
  }, {
    "tStartMs": 1254720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and not possible to give a comparison on."
    } ]
  }, {
    "tStartMs": 1257040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "After NIST published the study,"
    } ]
  }, {
    "tStartMs": 1258720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "new checks have been imposed\nto address some of the issues,"
    } ]
  }, {
    "tStartMs": 1262080,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "but there's still no lower limit"
    } ]
  }, {
    "tStartMs": 1263680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "on the quality or the\nquantity of a DNA sample"
    } ]
  }, {
    "tStartMs": 1266240,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that labs are permitted to analyze."
    } ]
  }, {
    "tStartMs": 1268320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And labs themselves still decide"
    } ]
  }, {
    "tStartMs": 1270320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "if something is too mixed or too partial."
    } ]
  }, {
    "tStartMs": 1273200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Now, you might think that"
    } ]
  }, {
    "tStartMs": 1274320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "using the entire sequence\ngenome would be better,"
    } ]
  }, {
    "tStartMs": 1277280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but that can actually introduce\ndifferent kinds of problems."
    } ]
  }, {
    "tStartMs": 1280160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now, your analyst has\naccess to hair color,"
    } ]
  }, {
    "tStartMs": 1282800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "eye color, ethnicity,"
    } ]
  }, {
    "tStartMs": 1284160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and that could introduce discrimination"
    } ]
  }, {
    "tStartMs": 1285840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "in the way the sample is being analyzed."
    } ]
  }, {
    "tStartMs": 1288080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- This is where the guidelines"
    } ]
  }, {
    "tStartMs": 1289920,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and the guardrails have to come in here."
    } ]
  }, {
    "tStartMs": 1292960,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "What are the genetic markers\nthat are being used for this?"
    } ]
  }, {
    "tStartMs": 1296400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "This is where the really interesting"
    } ]
  }, {
    "tStartMs": 1297840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "ethical questions come into it."
    } ]
  }, {
    "tStartMs": 1299600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "People think that DNA is\nlike the silver bullet"
    } ]
  }, {
    "tStartMs": 1301840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that will answer everything."
    } ]
  }, {
    "tStartMs": 1304400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And it is true."
    } ]
  }, {
    "tStartMs": 1305840,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "DNA evidence is incredibly powerful,"
    } ]
  }, {
    "tStartMs": 1308640,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "it's amazing for identifying individuals,"
    } ]
  }, {
    "tStartMs": 1312320,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "but DNA can never be taken out of context."
    } ]
  }, {
    "tStartMs": 1317520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- Now, the point of this\nvideo isn't to bash forensics."
    } ]
  }, {
    "tStartMs": 1320160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I think it's still better\nfor us to live in a world"
    } ]
  }, {
    "tStartMs": 1322080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "where forensics exist rather\nthan one where they don't."
    } ]
  }, {
    "tStartMs": 1325600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But if we want to keep\ncalling forensics a science,"
    } ]
  }, {
    "tStartMs": 1328800,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "we need to continue the work of the people"
    } ]
  }, {
    "tStartMs": 1330560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "who actually made this video possible,"
    } ]
  }, {
    "tStartMs": 1332160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "who've dedicated their lives"
    } ]
  }, {
    "tStartMs": 1333360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to already reassessing the field"
    } ]
  }, {
    "tStartMs": 1335360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and making it as accurate as it is today."
    } ]
  }, {
    "tStartMs": 1337600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Do you think it's fair calling\nthis a forensic science?"
    } ]
  }, {
    "tStartMs": 1339640,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- I still think there's science in it"
    } ]
  }, {
    "tStartMs": 1341600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "because you're trying to do the best"
    } ]
  }, {
    "tStartMs": 1343280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "with the information you have,"
    } ]
  }, {
    "tStartMs": 1344640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "which is often times what\nscience is trying to do is,"
    } ]
  }, {
    "tStartMs": 1347680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "with the information you have,"
    } ]
  }, {
    "tStartMs": 1349040,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "this is the conclusions you make"
    } ]
  }, {
    "tStartMs": 1350560,
    "dDurationMs": 14224,
    "segs": [ {
      "utf8": "until you know something better."
    } ]
  }, {
    "tStartMs": 1364784,
    "dDurationMs": 14,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 1364798,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "- Hey, one last thing."
    } ]
  }, {
    "tStartMs": 1366240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Last year we launched the\nofficial Veritasium game,"
    } ]
  }, {
    "tStartMs": 1369360,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Elements of Truth."
    } ]
  }, {
    "tStartMs": 1370400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It's a trivia game with 800 questions"
    } ]
  }, {
    "tStartMs": 1372640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "covering science and technology,"
    } ]
  }, {
    "tStartMs": 1374720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and we on the team get quite competitive."
    } ]
  }, {
    "tStartMs": 1377040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So every time we play\nthings get very saucy."
    } ]
  }, {
    "tStartMs": 1379840,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "See, there's this mechanic"
    } ]
  }, {
    "tStartMs": 1380800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "where you can't only guess an answer,"
    } ]
  }, {
    "tStartMs": 1382640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "you have to put down a\nnumber between one and 10"
    } ]
  }, {
    "tStartMs": 1384800,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "to gauge how confident you\nare that your answer is right."
    } ]
  }, {
    "tStartMs": 1388320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So it gets very fun very quickly."
    } ]
  }, {
    "tStartMs": 1390000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The game is coming out later this year,"
    } ]
  }, {
    "tStartMs": 1391600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "so if you're interested in pre-ordering,"
    } ]
  }, {
    "tStartMs": 1393200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "you can click the link in the description,"
    } ]
  }, {
    "tStartMs": 1394800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "which will take you to the\nElements of Truth website."
    } ]
  }, {
    "tStartMs": 1397600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Thank you so much for your\nsupport in this project."
    } ]
  }, {
    "tStartMs": 1399760,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And as always, thanks for watching."
    } ]
  } ]
}
