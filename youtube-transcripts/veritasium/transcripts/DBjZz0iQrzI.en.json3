  "events": [ {
    "tStartMs": 14000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Well an atom's made of protons, neutrons, and electrons"
    } ]
  }, {
    "tStartMs": 17500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the first two in the nucleus, the third around it"
    } ]
  }, {
    "tStartMs": 20500,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "it's mostly empty space, but it feels solid in any case"
    } ]
  }, {
    "tStartMs": 26500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The elements are all the different types of atoms"
    } ]
  }, {
    "tStartMs": 29500,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "they differ by the number of protons in the middle."
    } ]
  }, {
    "tStartMs": 32600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Hydrogen has only one,"
    } ]
  }, {
    "tStartMs": 36000,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "but Uranium has a ton"
    } ]
  }, {
    "tStartMs": 40000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It's just chemistry "
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "that you and me"
    } ]
  }, {
    "tStartMs": 48000,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "are made of these atoms"
    } ]
  }, {
    "tStartMs": 66000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Well atoms bond together to form molecules"
    } ]
  }, {
    "tStartMs": 68700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Most of what's surrounding me and you"
    } ]
  }, {
    "tStartMs": 72600,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Water, sugar, things yet undreamed of of of of"
    } ]
  }, {
    "tStartMs": 77600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Look around you, see the combinations in a eucalypt tree"
    } ]
  }, {
    "tStartMs": 81500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Mendeleev's periodicity"
    } ]
  }, {
    "tStartMs": 85500,
    "dDurationMs": 7900,
    "segs": [ {
      "utf8": "gives us sand and water and the air above ove ove ove ove"
    } ]
  }, {
    "tStartMs": 93400,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "It's just chemistry"
    } ]
  }, {
    "tStartMs": 97600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "that you and me"
    } ]
  }, {
    "tStartMs": 101600,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "are made of these atoms:"
    } ]
  }, {
    "tStartMs": 106500,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "Hydrogen, Ox-y-gen, Carbon, Nitrogen,"
    } ]
  }, {
    "tStartMs": 114600,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "make up the world's life forms"
    } ]
  }, {
    "tStartMs": 119600,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Do do do you, do do do do"
    } ]
  }, {
    "tStartMs": 123800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "but do you wonder how"
    } ]
  }, {
    "tStartMs": 125000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "matter forms something strange"
    } ]
  }, {
    "tStartMs": 128500,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "when there's a chemical change?"
    } ]
  }, {
    "tStartMs": 146000,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Where did these atoms come from? They were fused in stars"
    } ]
  }, {
    "tStartMs": 148500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Light elements combine releasing light from afar"
    } ]
  }, {
    "tStartMs": 152000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Fusion in the sun,"
    } ]
  }, {
    "tStartMs": 155000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "creates Helium"
    } ]
  }, {
    "tStartMs": 158600,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I guess what I be saying is you gotta use your reason"
    } ]
  }, {
    "tStartMs": 161500,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "To open up your mind and see the cause of the seasons"
    } ]
  }, {
    "tStartMs": 164600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "How do we know what's true?"
    } ]
  }, {
    "tStartMs": 168500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The scientific method shows you"
    } ]
  }, {
    "tStartMs": 172000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "It's just chemistry"
    } ]
  }, {
    "tStartMs": 175500,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "that you and me"
    } ]
  }, {
    "tStartMs": 179800,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "are made of these atoms"
    } ]
  }, {
    "tStartMs": 184500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Atoms bond together to form molecules"
    } ]
  }, {
    "tStartMs": 187500,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Most of what's surrounding me and you"
    } ]
  }, {
    "tStartMs": 190600,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Water, sugar, sand and you'll find things undreamed of"
    } ]
  }, {
    "tStartMs": 196600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Argon, Neon, Xenon"
    } ]
  }, {
    "tStartMs": 199600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "There's no need to overstate"
    } ]
  }, {
    "tStartMs": 202800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "'Cause we are of course"
    } ]
  }, {
    "tStartMs": 204600,
    "dDurationMs": 7400,
    "segs": [ {
      "utf8": "This, of this, of this, we're made: atoms"
