{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] What happens if I heat up"
    } ]
  }, {
    "tStartMs": 2340,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "this rubber band?"
    } ]
  }, {
    "tStartMs": 3660,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "When you heat materials\nlike glass or plastic,"
    } ]
  }, {
    "tStartMs": 6540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the atoms vibrate faster."
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "They get slightly farther apart"
    } ]
  }, {
    "tStartMs": 10350,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and this reduces intermolecular forces."
    } ]
  }, {
    "tStartMs": 13080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So the material gets weaker."
    } ]
  }, {
    "tStartMs": 15240,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Under tension, it stretches."
    } ]
  }, {
    "tStartMs": 17820,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "But when I heat up this rubber\nband, the opposite happens."
    } ]
  }, {
    "tStartMs": 22230,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It actually pulls more strongly."
    } ]
  }, {
    "tStartMs": 24540,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The rubber band contracts\nand the weight goes up."
    } ]
  }, {
    "tStartMs": 28200,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So why does this happen?"
    } ]
  }, {
    "tStartMs": 30780,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Well, rubber is unlike any other material."
    } ]
  }, {
    "tStartMs": 33540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "It's waterproof."
    } ]
  }, {
    "tStartMs": 35070,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "As it's breaking, it\nactually becomes tougher"
    } ]
  }, {
    "tStartMs": 37740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and it can stretch up\nto 10 times its length"
    } ]
  }, {
    "tStartMs": 40290,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and bounce back no worse for wear."
    } ]
  }, {
    "tStartMs": 42750,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "These properties have made\nit essential for modern life."
    } ]
  }, {
    "tStartMs": 45930,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "It forms the tubes and seals\nthat carry our gas and water,"
    } ]
  }, {
    "tStartMs": 49740,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the belts that drive our motors"
    } ]
  }, {
    "tStartMs": 51690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and the tires on our\ncars, trucks and planes."
    } ]
  }, {
    "tStartMs": 55140,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "Even trains use rubber in\ntheir suspension systems."
    } ]
  }, {
    "tStartMs": 59370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It's a perfectly engineered material"
    } ]
  }, {
    "tStartMs": 62190,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but we didn't invent it."
    } ]
  }, {
    "tStartMs": 64290,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "All of our most durable rubber"
    } ]
  }, {
    "tStartMs": 65670,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "still comes from a single natural source."
    } ]
  }, {
    "tStartMs": 68850,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "This tree, it's a source\nat risk of being wiped out."
    } ]
  }, {
    "tStartMs": 72750,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And if that happens, the\nresults could be devastating."
    } ]
  }, {
    "tStartMs": 76020,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "- You're talking about a complete\nglobal societal meltdown."
    } ]
  }, {
    "tStartMs": 80610,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "- This could be considered\na national security issue."
    } ]
  }, {
    "tStartMs": 84420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- You wouldn't think that we're\nso dependent on this thing?"
    } ]
  }, {
    "tStartMs": 86940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- Well, we are, and most\npeople don't know that."
    } ]
  }, {
    "tStartMs": 89850,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "They're waiting for a disaster to happen."
    } ]
  }, {
    "tStartMs": 93390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- [Derek] Rubber comes from\nthe Brazilian rubber tree."
    } ]
  }, {
    "tStartMs": 95760,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "As early as 1600 BC,\nMesoamericans cut the bark"
    } ]
  }, {
    "tStartMs": 99600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to release this milky white liquid,"
    } ]
  }, {
    "tStartMs": 102000,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "now known as latex."
    } ]
  }, {
    "tStartMs": 103889,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "They noticed that if they let it dry,"
    } ]
  }, {
    "tStartMs": 106350,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "it turned into this stretchy,\nwaterproof solid lump."
    } ]
  }, {
    "tStartMs": 110280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "To see this in person,"
    } ]
  }, {
    "tStartMs": 111480,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "we sent Veritasium producer"
    } ]
  }, {
    "tStartMs": 112710,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and mechanical engineer, Henry van Dyck"
    } ]
  }, {
    "tStartMs": 114600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to the Akron Research and\nDevelopment Laboratory,"
    } ]
  }, {
    "tStartMs": 116790,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "where they specialize\nin all things rubber."
    } ]
  }, {
    "tStartMs": 119580,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- In just all these racks,\neven though they look solid,"
    } ]
  }, {
    "tStartMs": 123420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "they're all flowing right now."
    } ]
  }, {
    "tStartMs": 125280,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Really?\n- If you look"
    } ]
  }, {
    "tStartMs": 126180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "behind one of these racks,"
    } ]
  }, {
    "tStartMs": 128340,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you can see these are actually dripping."
    } ]
  }, {
    "tStartMs": 130650,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Oh, wow."
    } ]
  }, {
    "tStartMs": 131730,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "- They're flowing slower\nthan we can perceive."
    } ]
  }, {
    "tStartMs": 135450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] Unprocessed\nrubber is not the rubber"
    } ]
  }, {
    "tStartMs": 137400,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "we're used to."
    } ]
  }, {
    "tStartMs": 138330,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "It slowly flows and\ncan't maintain its shape."
    } ]
  }, {
    "tStartMs": 142080,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So how do you get this weird\nmaterial in the first place?"
    } ]
  }, {
    "tStartMs": 145710,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Well, just underneath the bark\nare special tube-like cells"
    } ]
  }, {
    "tStartMs": 148890,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that carry the latex."
    } ]
  }, {
    "tStartMs": 150420,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Floating around inside are lots"
    } ]
  }, {
    "tStartMs": 152070,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "of isopentenyl pyrophosphate or IPP."
    } ]
  }, {
    "tStartMs": 155640,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "This is the building block\nor monomer of rubber."
    } ]
  }, {
    "tStartMs": 158790,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "In fact, IPP is found\neverywhere in nature,"
    } ]
  }, {
    "tStartMs": 161640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "including inside you."
    } ]
  }, {
    "tStartMs": 163560,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Huge amounts of us"
    } ]
  }, {
    "tStartMs": 165840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "are dependent upon that little molecule."
    } ]
  }, {
    "tStartMs": 167460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "We make short chain rubber in our livers."
    } ]
  }, {
    "tStartMs": 169980,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It's called Dolichol."
    } ]
  }, {
    "tStartMs": 171060,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "You're busily making rubber,"
    } ]
  }, {
    "tStartMs": 172159,
    "dDurationMs": 1691,
    "segs": [ {
      "utf8": "you are a rubber factory."
    } ]
  }, {
    "tStartMs": 173850,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- How? What do you mean?"
    } ]
  }, {
    "tStartMs": 174960,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Why am I making rubber?"
    } ]
  }, {
    "tStartMs": 176220,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- It's essential for cell membranes."
    } ]
  }, {
    "tStartMs": 179520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- [Henry] Special builder\nenzymes grab these monomers"
    } ]
  }, {
    "tStartMs": 182160,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "to build this long chain\nwith over 10,000 monomers,"
    } ]
  }, {
    "tStartMs": 186030,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they build a polymer."
    } ]
  }, {
    "tStartMs": 187950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "This is rubber."
    } ]
  }, {
    "tStartMs": 189690,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- So I get students to think\nabout if this is a carbon atom"
    } ]
  }, {
    "tStartMs": 193770,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and then I've got my next carbon atom"
    } ]
  }, {
    "tStartMs": 195360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "along the chain next to it, yeah?"
    } ]
  }, {
    "tStartMs": 197460,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And then, I've got my next carbon atom."
    } ]
  }, {
    "tStartMs": 199530,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "How many do we have"
    } ]
  }, {
    "tStartMs": 201390,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to make up the whole length of the chain?"
    } ]
  }, {
    "tStartMs": 203370,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Well, we've got tens of\nthousands, hundreds of thousands"
    } ]
  }, {
    "tStartMs": 206370,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of carbons along the back burn."
    } ]
  }, {
    "tStartMs": 207990,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "You start going kilometers in distance"
    } ]
  }, {
    "tStartMs": 210120,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "from end to end if each atom is the size"
    } ]
  }, {
    "tStartMs": 212070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of this tennis ball."
    } ]
  }, {
    "tStartMs": 213960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] But the polymers\naren't stretched out"
    } ]
  }, {
    "tStartMs": 215550,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "from end to end like that."
    } ]
  }, {
    "tStartMs": 217230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Instead, they're all coiled up."
    } ]
  }, {
    "tStartMs": 219780,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "- If you imagine the room\nthat I'm in right now"
    } ]
  }, {
    "tStartMs": 221647,
    "dDurationMs": 2723,
    "segs": [ {
      "utf8": "and I had the first\nball here in the middle,"
    } ]
  }, {
    "tStartMs": 224370,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the chances of the end of\nthe chain leaving this room"
    } ]
  }, {
    "tStartMs": 226680,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "is quite small."
    } ]
  }, {
    "tStartMs": 227820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Derek] So after you've\ndried out the latex,"
    } ]
  }, {
    "tStartMs": 229680,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "you're left with raw rubber, a\njumble of all these polymers."
    } ]
  }, {
    "tStartMs": 232950,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And this is why it's flowing."
    } ]
  }, {
    "tStartMs": 234480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Because over time,"
    } ]
  }, {
    "tStartMs": 235680,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "all those polymers slowly\nslide past each other."
    } ]
  }, {
    "tStartMs": 238980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Now, when you pull on\nthe rubber and let go,"
    } ]
  }, {
    "tStartMs": 240870,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it bounces back."
    } ]
  }, {
    "tStartMs": 242190,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So why is this?"
    } ]
  }, {
    "tStartMs": 244800,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- At room temperature,\nrubber's polymer chains"
    } ]
  }, {
    "tStartMs": 247110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "are constantly vibrating\nand bumping into each other."
    } ]
  }, {
    "tStartMs": 250200,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And other smaller molecules\nlike air molecules"
    } ]
  }, {
    "tStartMs": 253140,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or trapped water molecules\nalso jostle around"
    } ]
  }, {
    "tStartMs": 255810,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and bump into the chains."
    } ]
  }, {
    "tStartMs": 257730,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Now, when you stretch rubber,\nthese chains straighten out."
    } ]
  }, {
    "tStartMs": 261840,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "But as you're doing this,"
    } ]
  }, {
    "tStartMs": 263430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "those chains are still being bombarded"
    } ]
  }, {
    "tStartMs": 265350,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "by these smaller molecules."
    } ]
  }, {
    "tStartMs": 266850,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So when you release that stress,"
    } ]
  }, {
    "tStartMs": 268740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "there's nothing holding\nthose chains aligned anymore."
    } ]
  }, {
    "tStartMs": 271710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And the constant bombardment\nfrom the smaller molecules"
    } ]
  }, {
    "tStartMs": 274200,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "and the other chains"
    } ]
  }, {
    "tStartMs": 275250,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "kinks those chains back up."
    } ]
  }, {
    "tStartMs": 277230,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So the rubber snaps back\nto its original size."
    } ]
  }, {
    "tStartMs": 281130,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And if you heat the rubber up,"
    } ]
  }, {
    "tStartMs": 282870,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "well then, everything is vibrating faster"
    } ]
  }, {
    "tStartMs": 284940,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and so the chains are gonna\nget kinked up even more"
    } ]
  }, {
    "tStartMs": 287760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "so the rubber pulls back stronger."
    } ]
  }, {
    "tStartMs": 290640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] This is why\nwhen you heat up rubber,"
    } ]
  }, {
    "tStartMs": 292590,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "it shrinks."
    } ]
  }, {
    "tStartMs": 294120,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Rubber band's fascinating."
    } ]
  }, {
    "tStartMs": 295920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "To think that when they're sitting"
    } ]
  }, {
    "tStartMs": 298470,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "on an old package of\npapers for a long time"
    } ]
  }, {
    "tStartMs": 301710,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "holding those papers together,"
    } ]
  }, {
    "tStartMs": 303510,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "it's done by a perpetual\npounding, pounding, pounding"
    } ]
  }, {
    "tStartMs": 306660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of the atoms against\nthese chains to hold it,"
    } ]
  }, {
    "tStartMs": 308820,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "trying to kink them and\ntrying to kink them."
    } ]
  }, {
    "tStartMs": 311550,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] But there's also another reason"
    } ]
  }, {
    "tStartMs": 313140,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "why rubber is so stretchy."
    } ]
  }, {
    "tStartMs": 315510,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "If you zoom in on a chain,"
    } ]
  }, {
    "tStartMs": 317190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you'll see that the monomers\nare attached to each other"
    } ]
  }, {
    "tStartMs": 319440,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "on the same side of the double bond."
    } ]
  }, {
    "tStartMs": 321630,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "This is called cis-attachment."
    } ]
  }, {
    "tStartMs": 323190,
    "dDurationMs": 1842,
    "segs": [ {
      "utf8": "And it affects how the chain folds."
    } ]
  }, {
    "tStartMs": 325032,
    "dDurationMs": 2568,
    "segs": [ {
      "utf8": "On each monomer, there\nare three single bonds"
    } ]
  }, {
    "tStartMs": 327600,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "that can rotate to be\nat an angle or in line"
    } ]
  }, {
    "tStartMs": 330990,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "but these carbons with two\nhydrogens take up a lot of space."
    } ]
  }, {
    "tStartMs": 334230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So it's favorable for at\nleast one of these bonds"
    } ]
  }, {
    "tStartMs": 336570,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "to be at an angle."
    } ]
  }, {
    "tStartMs": 338340,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "That makes the polymer wiggle in and out"
    } ]
  }, {
    "tStartMs": 340560,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "like a folded ribbon."
    } ]
  }, {
    "tStartMs": 342270,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So when you pull on a piece of rubber,"
    } ]
  }, {
    "tStartMs": 344250,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "first, all the polymers line up"
    } ]
  }, {
    "tStartMs": 346320,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but then, each chain also unfolds."
    } ]
  }, {
    "tStartMs": 349350,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The wiggle makes rubber extra stretchy."
    } ]
  }, {
    "tStartMs": 352260,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But this state is very rare."
    } ]
  }, {
    "tStartMs": 354330,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "All three bonds lined up is\nonly one possible arrangement"
    } ]
  }, {
    "tStartMs": 357450,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "for any monomer."
    } ]
  }, {
    "tStartMs": 358680,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And one polymer usually\nhas thousands of monomers."
    } ]
  }, {
    "tStartMs": 362130,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So after you release the stress,"
    } ]
  }, {
    "tStartMs": 363690,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the chain goes from an improbable state,"
    } ]
  }, {
    "tStartMs": 365790,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "completely aligned to a more\nprobable one, with wiggles."
    } ]
  }, {
    "tStartMs": 369540,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The chain itself bounces back."
    } ]
  }, {
    "tStartMs": 372480,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This is where rubber\ngets its elasticity from."
    } ]
  }, {
    "tStartMs": 375030,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So natural rubbers straight from the tree"
    } ]
  }, {
    "tStartMs": 376860,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "is already stretchy."
    } ]
  }, {
    "tStartMs": 378390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It's also waterproof\nsince all those chains"
    } ]
  }, {
    "tStartMs": 380430,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "are just a bunch of\ncarbon and hydrogen atoms"
    } ]
  }, {
    "tStartMs": 382440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which are hydrophobic."
    } ]
  }, {
    "tStartMs": 384240,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But as we've seen, it\neventually loses its shape."
    } ]
  }, {
    "tStartMs": 387030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Plus, if you stretch it too much,"
    } ]
  }, {
    "tStartMs": 388470,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "it breaks quite easily."
    } ]
  }, {
    "tStartMs": 390030,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "So we need to do more to get\nthe rubber we're used to today."
    } ]
  }, {
    "tStartMs": 393780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Early Mesoamericans\nimproved the rubber slightly"
    } ]
  }, {
    "tStartMs": 396210,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "by mixing the latex"
    } ]
  }, {
    "tStartMs": 397290,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "with juice from the tropical\nmorning-glory, a local flower."
    } ]
  }, {
    "tStartMs": 400860,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "And they used this to form\nsandals, bottles and balls."
    } ]
  }, {
    "tStartMs": 405510,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- But for the next 3,000 years\nto the rest of the world,"
    } ]
  }, {
    "tStartMs": 408450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "rubber was little more than a curiosity."
    } ]
  }, {
    "tStartMs": 411330,
    "dDurationMs": 2897,
    "segs": [ {
      "utf8": "Then in 1770, a piece of natural latex"
    } ]
  }, {
    "tStartMs": 414227,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "made its way to English\nchemist, Joseph Priestley."
    } ]
  }, {
    "tStartMs": 417750,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "And he took this piece"
    } ]
  }, {
    "tStartMs": 418740,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and used it to try to erase pencil marks."
    } ]
  }, {
    "tStartMs": 421980,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "He noticed that it easily,\nquote, \"rubbed them away.\""
    } ]
  }, {
    "tStartMs": 426090,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] In the following decades,"
    } ]
  }, {
    "tStartMs": 427230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "people started exploring\nother applications."
    } ]
  }, {
    "tStartMs": 430140,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Up until then, people\nused to waterproof fabric"
    } ]
  }, {
    "tStartMs": 432630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "with oil, wax, or tar."
    } ]
  }, {
    "tStartMs": 435120,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But some oils were extremely flammable"
    } ]
  }, {
    "tStartMs": 437460,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and prone to spontaneous combustion."
    } ]
  }, {
    "tStartMs": 439680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And wax or tar would\neventually crack with movement."
    } ]
  }, {
    "tStartMs": 443520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Similarly, there were no\nreal good flexible materials"
    } ]
  }, {
    "tStartMs": 446400,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "at the time."
    } ]
  }, {
    "tStartMs": 447330,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Leather was the best option\nbut it had little give."
    } ]
  }, {
    "tStartMs": 451170,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Rubber had the potential\nto fix all those problems."
    } ]
  }, {
    "tStartMs": 454200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So for the next 50 years,\nthe use of rubber exploded."
    } ]
  }, {
    "tStartMs": 457800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "In England, people made\nwaterproof clothing."
    } ]
  }, {
    "tStartMs": 460200,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And by the late 1820s,"
    } ]
  }, {
    "tStartMs": 461820,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the rubber craze hit the US"
    } ]
  }, {
    "tStartMs": 463530,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "when everyone wanted their own pair"
    } ]
  }, {
    "tStartMs": 465240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of Brazilian waterproof boots."
    } ]
  }, {
    "tStartMs": 467160,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Factories sprung up all across the country"
    } ]
  }, {
    "tStartMs": 468930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to make new rubber products,"
    } ]
  }, {
    "tStartMs": 470580,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "including one New England factory"
    } ]
  }, {
    "tStartMs": 472170,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "called the Roxbury India Rubber Company."
    } ]
  }, {
    "tStartMs": 475290,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "- In the spring of 1834,"
    } ]
  }, {
    "tStartMs": 476665,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "things were looking great for the company."
    } ]
  }, {
    "tStartMs": 479190,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "The previous fall,"
    } ]
  }, {
    "tStartMs": 480210,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "they had sold over $20,000 worth of goods,"
    } ]
  }, {
    "tStartMs": 483660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "rubber coats, shoes and the like."
    } ]
  }, {
    "tStartMs": 485580,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But as the summer came round,"
    } ]
  }, {
    "tStartMs": 487290,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "problems started to emerge."
    } ]
  }, {
    "tStartMs": 489960,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- They used to rubberize the fabric"
    } ]
  }, {
    "tStartMs": 491640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to make it water-resistant"
    } ]
  }, {
    "tStartMs": 493200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "which was fine until you sat down"
    } ]
  }, {
    "tStartMs": 494700,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "on a wooden bench on a hot\nday and you stuck to it."
    } ]
  }, {
    "tStartMs": 499680,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Derek] See, all natural rubber"
    } ]
  }, {
    "tStartMs": 500940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "has a critical weakness."
    } ]
  }, {
    "tStartMs": 502530,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "It's extremely sensitive\nto temperature changes."
    } ]
  }, {
    "tStartMs": 505200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It melts when it gets too hot"
    } ]
  }, {
    "tStartMs": 506910,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and it freezes and becomes\nbrittle when it gets too cold."
    } ]
  }, {
    "tStartMs": 510840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "- This made the coats and\nshoes practically useless"
    } ]
  }, {
    "tStartMs": 513500,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "during the hot summer."
    } ]
  }, {
    "tStartMs": 515280,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So customers returned their items on mass."
    } ]
  }, {
    "tStartMs": 518670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Then, things went from bad to worse."
    } ]
  }, {
    "tStartMs": 520890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "One day, the Roxbury manager\nvisited the warehouse."
    } ]
  }, {
    "tStartMs": 523830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "When he opened the door,"
    } ]
  }, {
    "tStartMs": 525060,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "he didn't see their newest products."
    } ]
  }, {
    "tStartMs": 527010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Instead, he was met with a foul smell"
    } ]
  }, {
    "tStartMs": 529650,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "and a molten, gooey mess that\ncovered the entire warehouse."
    } ]
  }, {
    "tStartMs": 534270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- In fact, when we\nordered some raw rubber,"
    } ]
  }, {
    "tStartMs": 536100,
    "dDurationMs": 2015,
    "segs": [ {
      "utf8": "we were in for a similar nasty surprise."
    } ]
  }, {
    "tStartMs": 538115,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "Oh, that is disgusting."
    } ]
  }, {
    "tStartMs": 542160,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The summer heat melted\ntheir rubber products"
    } ]
  }, {
    "tStartMs": 544410,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and they started rotting."
    } ]
  }, {
    "tStartMs": 546000,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The sludge stank so badly,"
    } ]
  }, {
    "tStartMs": 547650,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "the manager had the employees\nsecretly bury it at night."
    } ]
  }, {
    "tStartMs": 552120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] But later\nin that horrible summer,"
    } ]
  }, {
    "tStartMs": 554250,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the manager got a visit\nfrom a man named Charles."
    } ]
  }, {
    "tStartMs": 557280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Charles' previous\nbusiness had gone bankrupt"
    } ]
  }, {
    "tStartMs": 559560,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and he was deeply in debt."
    } ]
  }, {
    "tStartMs": 561870,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "- He stumbled upon a rubber life preserver"
    } ]
  }, {
    "tStartMs": 563890,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and he thought he could\nmake a better valve."
    } ]
  }, {
    "tStartMs": 566980,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "He pitched the Roxbury\nmanager on his new design,"
    } ]
  }, {
    "tStartMs": 569820,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "hoping to pay back his lenders."
    } ]
  }, {
    "tStartMs": 571860,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The manager was impressed but\ncouldn't buy Charles' work."
    } ]
  }, {
    "tStartMs": 575400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "He showed Charles the warehouse\nfull of rotten rubber."
    } ]
  }, {
    "tStartMs": 578220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Rubber had potential\nbut in its current form,"
    } ]
  }, {
    "tStartMs": 581100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "it was just too problematic."
    } ]
  }, {
    "tStartMs": 583200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "However, he said if\nanyone could figure out"
    } ]
  }, {
    "tStartMs": 584910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "how to make rubber stable\nin a wider temperature range"
    } ]
  }, {
    "tStartMs": 587370,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and non-sticky, well, then\nthat person would stand"
    } ]
  }, {
    "tStartMs": 590790,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to make a ton of money."
    } ]
  }, {
    "tStartMs": 592920,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "So Charles was determined\nto become that person."
    } ]
  }, {
    "tStartMs": 597450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But when he returned home\nto start his experiments,"
    } ]
  }, {
    "tStartMs": 599760,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "he was met by an angry creditor"
    } ]
  }, {
    "tStartMs": 601500,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "who threw Charles into debtor's\nprison for unpaid loans."
    } ]
  }, {
    "tStartMs": 605130,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Charles asked his wife\nto bring him raw rubber"
    } ]
  }, {
    "tStartMs": 607590,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and her rolling pin."
    } ]
  }, {
    "tStartMs": 609090,
    "dDurationMs": 1139,
    "segs": [ {
      "utf8": "There in his jail cell,"
    } ]
  }, {
    "tStartMs": 610229,
    "dDurationMs": 3751,
    "segs": [ {
      "utf8": "he started adding different\ncompounds into raw rubber."
    } ]
  }, {
    "tStartMs": 613980,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- If rubber was naturally sticky,"
    } ]
  }, {
    "tStartMs": 615810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "then why couldn't you add dry powders"
    } ]
  }, {
    "tStartMs": 617850,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to absorb that stickiness?"
    } ]
  }, {
    "tStartMs": 619980,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So he tried adding magnesia"
    } ]
  }, {
    "tStartMs": 621750,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and he got a smooth non-sticky rubber."
    } ]
  }, {
    "tStartMs": 624840,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But over time, the stickiness returned."
    } ]
  }, {
    "tStartMs": 628050,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "After his release,"
    } ]
  }, {
    "tStartMs": 628980,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "he tested the wear and tear\nof his rubber compounds"
    } ]
  }, {
    "tStartMs": 631620,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "by walking around in all rubber outfits."
    } ]
  }, {
    "tStartMs": 635190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Henry] His hands were always covered"
    } ]
  }, {
    "tStartMs": 636840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "with gum elastic."
    } ]
  }, {
    "tStartMs": 638190,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "He playfully said that the\nonly way to rub rubber off"
    } ]
  }, {
    "tStartMs": 640350,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "was by rubbing more on."
    } ]
  }, {
    "tStartMs": 642810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Some mixtures showed promise,"
    } ]
  }, {
    "tStartMs": 644400,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but eventually, they'd all\nrot into a sticky mess."
    } ]
  }, {
    "tStartMs": 647880,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So he kept borrowing money\nto fund his experiments"
    } ]
  }, {
    "tStartMs": 651060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but because his mixtures\nall eventually failed,"
    } ]
  }, {
    "tStartMs": 653310,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "he ended up in debtor's\nprison so many times"
    } ]
  }, {
    "tStartMs": 656100,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "that he jokingly called it his hotel."
    } ]
  }, {
    "tStartMs": 659580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But Charles refused to give up."
    } ]
  }, {
    "tStartMs": 661620,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "When a friend told him rubber is dead,"
    } ]
  }, {
    "tStartMs": 663690,
    "dDurationMs": 2787,
    "segs": [ {
      "utf8": "Charles replied, \"I am\nthe man to bring it back.\""
    } ]
  }, {
    "tStartMs": 667650,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "In the summer of 1838,\nhe met Nathaniel Hayward,"
    } ]
  }, {
    "tStartMs": 670530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "a businessman and inventor."
    } ]
  }, {
    "tStartMs": 672720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Hayward had done his own\nexperiments with rubber."
    } ]
  }, {
    "tStartMs": 675120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "At one point, he laid\nout a sheet of rubber"
    } ]
  }, {
    "tStartMs": 677370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and sprinkled on sulfur powder."
    } ]
  }, {
    "tStartMs": 679650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And when he let this sheet set in the sun,"
    } ]
  }, {
    "tStartMs": 681840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "he noticed that it hardened"
    } ]
  }, {
    "tStartMs": 683340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and had a smooth and non-sticky surface."
    } ]
  }, {
    "tStartMs": 686370,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- But eventually, it would\nstill melt in the heat"
    } ]
  }, {
    "tStartMs": 688740,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "and freeze in the cold. He offered his\nprocess to his previous company"
    } ]
  }, {
    "tStartMs": 693300,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but it was so horribly\nsmelly that they rejected it."
    } ]
  }, {
    "tStartMs": 696750,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But Charles saw the possibilities."
    } ]
  }, {
    "tStartMs": 698970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So he helped Hayward get a patent"
    } ]
  }, {
    "tStartMs": 700890,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "and then he bought it"
    } ]
  }, {
    "tStartMs": 701730,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "so that he could use it\nin his own experiments."
    } ]
  }, {
    "tStartMs": 705420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Then one day in the winter of 1839,"
    } ]
  }, {
    "tStartMs": 707880,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Charles accidentally\ndropped a piece of rubber"
    } ]
  }, {
    "tStartMs": 710130,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "mixed with sulfur on a hot stove."
    } ]
  }, {
    "tStartMs": 712620,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "When he went to scrape it off,"
    } ]
  }, {
    "tStartMs": 713970,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "he found that instead of melting,"
    } ]
  }, {
    "tStartMs": 715650,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "it had charred and hardened."
    } ]
  }, {
    "tStartMs": 718350,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "His daughter later said,"
    } ]
  }, {
    "tStartMs": 719407,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "\"As I was passing in and out of the room,"
    } ]
  }, {
    "tStartMs": 721440,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I casually observed the\nlittle piece of gum,\""
    } ]
  }, {
    "tStartMs": 723660,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "which he was holding near the fire."
    } ]
  }, {
    "tStartMs": 725430,
    "dDurationMs": 2464,
    "segs": [ {
      "utf8": "And he was unusually\nanimated by some discovery"
    } ]
  }, {
    "tStartMs": 727894,
    "dDurationMs": 1586,
    "segs": [ {
      "utf8": "which he had made."
    } ]
  }, {
    "tStartMs": 729480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "He nailed the piece of gum"
    } ]
  }, {
    "tStartMs": 730830,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "outside the kitchen door\nin the intense cold."
    } ]
  }, {
    "tStartMs": 733650,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "In the morning, he brought it\nin, holding it up exultingly."
    } ]
  }, {
    "tStartMs": 736670,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "He had found it perfectly flexible"
    } ]
  }, {
    "tStartMs": 738720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "as it was when he put it out."
    } ]
  }, {
    "tStartMs": 740610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- So he had made a new rubber"
    } ]
  }, {
    "tStartMs": 742350,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "with completely different properties,"
    } ]
  }, {
    "tStartMs": 744390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "one that seemed to be\ntemperature-resistant"
    } ]
  }, {
    "tStartMs": 746610,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and much stronger."
    } ]
  }, {
    "tStartMs": 748320,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "In fact, we're going to\ntest out unprocessed rubber"
    } ]
  }, {
    "tStartMs": 750990,
    "dDurationMs": 3054,
    "segs": [ {
      "utf8": "against rubber processed in this way."
    } ]
  }, {
    "tStartMs": 754044,
    "dDurationMs": 1506,
    "segs": [ {
      "utf8": "- Okay, so this is uncured rubber"
    } ]
  }, {
    "tStartMs": 755550,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and I'm gonna see how far I can pull it."
    } ]
  }, {
    "tStartMs": 758250,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Uncured rubber is very soft"
    } ]
  }, {
    "tStartMs": 759840,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and stretches really far\nbefore easily breaking."
    } ]
  }, {
    "tStartMs": 762633,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Oh, oh, it's gonna hurt, ah!"
    } ]
  }, {
    "tStartMs": 766440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "We need to cure it."
    } ]
  }, {
    "tStartMs": 768240,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- What does it smell like to you?"
    } ]
  }, {
    "tStartMs": 770760,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Smells like a barbecue."
    } ]
  }, {
    "tStartMs": 771900,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "- This smells like a barbecue."
    } ]
  }, {
    "tStartMs": 774870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- The smell of rubber does\nnot seem to be natural."
    } ]
  }, {
    "tStartMs": 777720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Mm."
    } ]
  }, {
    "tStartMs": 778553,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "- Like it smells very chemically"
    } ]
  }, {
    "tStartMs": 780210,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "like it was made in the factory."
    } ]
  }, {
    "tStartMs": 781680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Yeah, so when I was in the factory"
    } ]
  }, {
    "tStartMs": 783450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and I saw the natural rubber,"
    } ]
  }, {
    "tStartMs": 784530,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "it smelled just like a barbecue."
    } ]
  }, {
    "tStartMs": 786807,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "And the reason is they take\nthe sap from the rubber tree"
    } ]
  }, {
    "tStartMs": 789930,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "which is latex and then they smoke it."
    } ]
  }, {
    "tStartMs": 793110,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Derek] They're smoking it?"
    } ]
  }, {
    "tStartMs": 794160,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Henry] Yeah."
    } ]
  }, {
    "tStartMs": 795270,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Like you'd smoke some salmon?"
    } ]
  }, {
    "tStartMs": 796680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 797880,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- They smoke the rubber sheets"
    } ]
  }, {
    "tStartMs": 799020,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to get rid of excess moisture"
    } ]
  }, {
    "tStartMs": 800490,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and to preserve it by\ngetting rid of the bacteria."
    } ]
  }, {
    "tStartMs": 803160,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "This gives most natural rubber\na sort of brownish color."
    } ]
  }, {
    "tStartMs": 807279,
    "dDurationMs": 2094,
    "segs": [ {
      "utf8": "So step one, add the rub."
    } ]
  }, {
    "tStartMs": 810210,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "- [Barry] One at a time."
    } ]
  }, {
    "tStartMs": 811060,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- [Henry] Next, you add several\npowders including sulfur."
    } ]
  }, {
    "tStartMs": 815670,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Everything is mixed and heated"
    } ]
  }, {
    "tStartMs": 817080,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "to get a much stronger rubber."
    } ]
  }, {
    "tStartMs": 820500,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "- Just pull it, straight off."
    } ]
  }, {
    "tStartMs": 823454,
    "dDurationMs": 3079,
    "segs": [ {
      "utf8": "- Yeah, that's wild."
    } ]
  }, {
    "tStartMs": 827637,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah, no."
    } ]
  }, {
    "tStartMs": 829556,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Pretty tough."
    } ]
  }, {
    "tStartMs": 830389,
    "dDurationMs": 954,
    "segs": [ {
      "utf8": "- It is tough, eh?"
    } ]
  }, {
    "tStartMs": 831343,
    "dDurationMs": 3317,
    "segs": [ {
      "utf8": "Now, yeah, now it's\nlike wicked hard, yeah."
    } ]
  }, {
    "tStartMs": 834660,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Now at 393 kilopascals,"
    } ]
  }, {
    "tStartMs": 836330,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "the uncured rubber broke after\nextending just under 900%"
    } ]
  }, {
    "tStartMs": 839910,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "of its original length."
    } ]
  }, {
    "tStartMs": 841380,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "At the same stress,"
    } ]
  }, {
    "tStartMs": 842400,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the cured rubber had\nonly stretched around 5%."
    } ]
  }, {
    "tStartMs": 845400,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "It eventually broke at 14.1 megapascals"
    } ]
  }, {
    "tStartMs": 848850,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "after stretching nearly\n600% of its original length."
    } ]
  }, {
    "tStartMs": 852660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So what was it about sulfur and heat"
    } ]
  }, {
    "tStartMs": 854550,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "that changed the\nproperties so dramatically?"
    } ]
  }, {
    "tStartMs": 857880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Well, chemically, sulfur powder"
    } ]
  }, {
    "tStartMs": 859500,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "is just rings of eight sulfur atoms."
    } ]
  }, {
    "tStartMs": 861960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "On the hot stove, the\nsulfur ring broke apart"
    } ]
  }, {
    "tStartMs": 864210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "into smaller pieces."
    } ]
  }, {
    "tStartMs": 865770,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And now, those sulfur\natoms or sulfur chains"
    } ]
  }, {
    "tStartMs": 868560,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "have free bonding sites"
    } ]
  }, {
    "tStartMs": 870330,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so they look for places to attach."
    } ]
  }, {
    "tStartMs": 872760,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "What likely happened is they\ngrabbed onto a carbon atom"
    } ]
  }, {
    "tStartMs": 875430,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "from a rubber chain,"
    } ]
  }, {
    "tStartMs": 876540,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "breaking its double bond\nand attached itself."
    } ]
  }, {
    "tStartMs": 879450,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Then with another free bonding site,"
    } ]
  }, {
    "tStartMs": 881160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "it grabbed onto a carbon atom\nfrom a different rubber chain,"
    } ]
  }, {
    "tStartMs": 883950,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "breaking its double bond"
    } ]
  }, {
    "tStartMs": 885180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and linking the two\nrubber chains together."
    } ]
  }, {
    "tStartMs": 888180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This cross-linking forms flexible bridges"
    } ]
  }, {
    "tStartMs": 890550,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "of one, two or even more\nsulfur atoms in a row."
    } ]
  }, {
    "tStartMs": 894630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now, think about what\nthis does to the rubber."
    } ]
  }, {
    "tStartMs": 896700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Instead of each chain being loose"
    } ]
  }, {
    "tStartMs": 898560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and slippery like spaghetti,"
    } ]
  }, {
    "tStartMs": 900180,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "they're tied together in a\nflexible but connected network."
    } ]
  }, {
    "tStartMs": 903990,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So now, if rubber sits out in\nthe sun on a hot summer's day,"
    } ]
  }, {
    "tStartMs": 907590,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "the tight bonds prevent it from melting."
    } ]
  }, {
    "tStartMs": 909911,
    "dDurationMs": 2749,
    "segs": [ {
      "utf8": "And in the cold, the\ncross-links make it harder"
    } ]
  }, {
    "tStartMs": 912660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "for the rubber to fully freeze"
    } ]
  }, {
    "tStartMs": 914370,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "so it's less brittle and harder to break."
    } ]
  }, {
    "tStartMs": 917100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And when you pull on the rubber,"
    } ]
  }, {
    "tStartMs": 918690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the chains stretch just as before."
    } ]
  }, {
    "tStartMs": 921000,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "But as you release it,"
    } ]
  }, {
    "tStartMs": 922140,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "everything returns to\nits original position"
    } ]
  }, {
    "tStartMs": 924390,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because it's all connected."
    } ]
  }, {
    "tStartMs": 926310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So the cross-links make\nthe rubber stronger,"
    } ]
  }, {
    "tStartMs": 928410,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "more resistant to temperature\nchanges and more elastic."
    } ]
  }, {
    "tStartMs": 932490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "In fact, by tweaking the\nnumber and properties"
    } ]
  }, {
    "tStartMs": 934860,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "of these cross-links,"
    } ]
  }, {
    "tStartMs": 935940,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "you can change the properties of rubber."
    } ]
  }, {
    "tStartMs": 938490,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "If you have a lot of cross-links,"
    } ]
  }, {
    "tStartMs": 940020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "all the rubber chains are\nbound tightly together"
    } ]
  }, {
    "tStartMs": 942360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "so the rubber becomes harder and stiffer."
    } ]
  }, {
    "tStartMs": 944730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Great for things like shoe soles and tires"
    } ]
  }, {
    "tStartMs": 947070,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that need to be durable but\nstill a little flexible."
    } ]
  }, {
    "tStartMs": 950400,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "If you have shorter cross-links,"
    } ]
  }, {
    "tStartMs": 952020,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "each link is harder to break."
    } ]
  }, {
    "tStartMs": 953670,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So the rubber is more resistant\nto heat and weathering."
    } ]
  }, {
    "tStartMs": 956670,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This is useful for seals and insulators."
    } ]
  }, {
    "tStartMs": 959580,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And if you have longer cross-links,"
    } ]
  }, {
    "tStartMs": 961200,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the rubber chains can move more freely,"
    } ]
  }, {
    "tStartMs": 963210,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "so you can stretch it\nmore before it breaks."
    } ]
  }, {
    "tStartMs": 965520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's perfect in the medical field"
    } ]
  }, {
    "tStartMs": 967020,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "for soft and flexible applications."
    } ]
  }, {
    "tStartMs": 971070,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "So the cross-links are\nessential to stabilizing rubber."
    } ]
  }, {
    "tStartMs": 975510,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "When Hayward sprinkled sulfur powder"
    } ]
  }, {
    "tStartMs": 977160,
    "dDurationMs": 1227,
    "segs": [ {
      "utf8": "on rubber sheets,"
    } ]
  }, {
    "tStartMs": 978387,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "the heat from the sun did\ncause some cross-linking"
    } ]
  }, {
    "tStartMs": 980430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but only on the surface."
    } ]
  }, {
    "tStartMs": 982800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "When Charles kneaded in sulfur"
    } ]
  }, {
    "tStartMs": 984480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and then heated the entire mixture,"
    } ]
  }, {
    "tStartMs": 985980,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the cross-links grew\nthroughout the entire sample."
    } ]
  }, {
    "tStartMs": 988740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So now, the results were much better."
    } ]
  }, {
    "tStartMs": 991290,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Eventually, this process\nwas called vulcanisation"
    } ]
  }, {
    "tStartMs": 994290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "after the Roman God, Vulcan,"
    } ]
  }, {
    "tStartMs": 996390,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "who was associated with heat\nand sulfur in volcanoes."
    } ]
  }, {
    "tStartMs": 1000260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Over the next five years,"
    } ]
  }, {
    "tStartMs": 1001460,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Charles perfected his\nmethod of vulcanisation."
    } ]
  }, {
    "tStartMs": 1003920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And then he patented it in 1844."
    } ]
  }, {
    "tStartMs": 1007040,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "With this, he transformed\nrubber from a curiosity"
    } ]
  }, {
    "tStartMs": 1010040,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "into a material of endless possibilities."
    } ]
  }, {
    "tStartMs": 1013130,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Little did he know"
    } ]
  }, {
    "tStartMs": 1014060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that he actually wasn't\nthe first to discover it."
    } ]
  }, {
    "tStartMs": 1016670,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The Mayans or the Aztecs\nused, like, created rubber"
    } ]
  }, {
    "tStartMs": 1019910,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where they also vulcanising\nrubber, or was this the-?"
    } ]
  }, {
    "tStartMs": 1022610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- They actually were."
    } ]
  }, {
    "tStartMs": 1024350,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- In fact, Charles' discovery"
    } ]
  }, {
    "tStartMs": 1025700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "was very similar to what the Mesoamericans"
    } ]
  }, {
    "tStartMs": 1027380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "had been doing for thousands of years."
    } ]
  }, {
    "tStartMs": 1029390,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They'd taken the juice\nfrom the morning-glory"
    } ]
  }, {
    "tStartMs": 1031190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which contained sulfur,\nmixed it with natural latex,"
    } ]
  }, {
    "tStartMs": 1033530,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and then by laying it out\nin the sun, it would heat up"
    } ]
  }, {
    "tStartMs": 1035930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and actually naturally\ncreate the cross-links"
    } ]
  }, {
    "tStartMs": 1037640,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that he'd discovered in his kitchen."
    } ]
  }, {
    "tStartMs": 1039710,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Why did the Europeans, like,"
    } ]
  }, {
    "tStartMs": 1041090,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "why did they have to\nreinvent the whole thing?"
    } ]
  }, {
    "tStartMs": 1042380,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Why didn't they just ask them?\n- Well,"
    } ]
  }, {
    "tStartMs": 1043213,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "they hadn't even noticed, I don't think."
    } ]
  }, {
    "tStartMs": 1044510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 1047180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "In the decades after Charles's invention,"
    } ]
  }, {
    "tStartMs": 1049160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "tons and tons of products were invented"
    } ]
  }, {
    "tStartMs": 1051080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "or improved with rubber."
    } ]
  }, {
    "tStartMs": 1052670,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Announcer] Richards makes bold claim"
    } ]
  }, {
    "tStartMs": 1054140,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "he could cross Pacific in this outfit."
    } ]
  }, {
    "tStartMs": 1056810,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- [Derek] The inflatable\nbicycle tire arrived in 1888,"
    } ]
  }, {
    "tStartMs": 1060170,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "the first rubber gloves for\nmedical purposes in 1890,"
    } ]
  }, {
    "tStartMs": 1063650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and the first car tire in 1895,"
    } ]
  }, {
    "tStartMs": 1065870,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "and all of this was thanks\nto Charles' invention."
    } ]
  }, {
    "tStartMs": 1070100,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- But despite almost single-handedly"
    } ]
  }, {
    "tStartMs": 1072230,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "transforming the rubber industry,"
    } ]
  }, {
    "tStartMs": 1074240,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "he never made much money."
    } ]
  }, {
    "tStartMs": 1075890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I mean he spent thousands of dollars"
    } ]
  }, {
    "tStartMs": 1077870,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "defending his inventions\nin patent disputes."
    } ]
  }, {
    "tStartMs": 1080810,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "And when he passed away\nin 1860 at the age of 59,"
    } ]
  }, {
    "tStartMs": 1084140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "he was over $200,000 in debt."
    } ]
  }, {
    "tStartMs": 1087080,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "That would be around 7.7 million today."
    } ]
  }, {
    "tStartMs": 1090830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "38 years later,\nAmerican entrepreneur,"
    } ]
  }, {
    "tStartMs": 1092900,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Frank Seiberling, founded a tire company"
    } ]
  }, {
    "tStartMs": 1094880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and decided to name it in honor"
    } ]
  }, {
    "tStartMs": 1096380,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "of rubber's inventor, Charles Goodyear."
    } ]
  }, {
    "tStartMs": 1099530,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Today, the Goodyear company"
    } ]
  }, {
    "tStartMs": 1100850,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "makes $18.9 billion a year in revenue"
    } ]
  }, {
    "tStartMs": 1103910,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "and it's the third largest\ntire manufacturer in the world."
    } ]
  }, {
    "tStartMs": 1109190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "For the past hundred years,"
    } ]
  }, {
    "tStartMs": 1110840,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "tires have consumed\nthe most natural rubber"
    } ]
  }, {
    "tStartMs": 1112860,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "out of any application."
    } ]
  }, {
    "tStartMs": 1115340,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But vulcanised rubber\nalone isn't strong enough"
    } ]
  }, {
    "tStartMs": 1118040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and would wear down quickly,"
    } ]
  }, {
    "tStartMs": 1119390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "lasting only around 8,000 kilometers."
    } ]
  }, {
    "tStartMs": 1122630,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So in the early 1900s,"
    } ]
  }, {
    "tStartMs": 1124160,
    "dDurationMs": 3386,
    "segs": [ {
      "utf8": "car and tire companies started\nexperimenting with additives,"
    } ]
  }, {
    "tStartMs": 1127546,
    "dDurationMs": 2854,
    "segs": [ {
      "utf8": "including something called carbon black."
    } ]
  }, {
    "tStartMs": 1130400,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- So with natural rubber, we got"
    } ]
  }, {
    "tStartMs": 1132230,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "carbon black.\n- Reinforcement."
    } ]
  }, {
    "tStartMs": 1133760,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Which is gonna add the cross-linking."
    } ]
  }, {
    "tStartMs": 1135470,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- This doesn't do the cross-linking."
    } ]
  }, {
    "tStartMs": 1136790,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No, it doesn't?"
    } ]
  }, {
    "tStartMs": 1137623,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "- So this is the reinforcement in filler."
    } ]
  }, {
    "tStartMs": 1139430,
    "dDurationMs": 1073,
    "segs": [ {
      "utf8": "- Ah, okay.\n- This makes it"
    } ]
  }, {
    "tStartMs": 1140503,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "durable and resilient."
    } ]
  }, {
    "tStartMs": 1142550,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Derek] Nowadays, passenger car tires"
    } ]
  }, {
    "tStartMs": 1144260,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "last about 100,000 kilometers."
    } ]
  }, {
    "tStartMs": 1146810,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "Carbon black is what gives them\ntheir color and durability."
    } ]
  }, {
    "tStartMs": 1150950,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- But carbon black has another benefit."
    } ]
  }, {
    "tStartMs": 1153170,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It conducts electricity."
    } ]
  }, {
    "tStartMs": 1155660,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- That's hugely important"
    } ]
  }, {
    "tStartMs": 1157160,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "because as you're driving down the road,"
    } ]
  }, {
    "tStartMs": 1158630,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "you are charging up the vehicle."
    } ]
  }, {
    "tStartMs": 1160280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If you didn't dissipate\nthat static charge,"
    } ]
  }, {
    "tStartMs": 1162800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "then you would get a shock\nwhen you earth the car,"
    } ]
  }, {
    "tStartMs": 1165200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "when you touch the car."
    } ]
  }, {
    "tStartMs": 1166880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- But later, some companies wondered"
    } ]
  }, {
    "tStartMs": 1168830,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "if they could reduce rolling friction"
    } ]
  }, {
    "tStartMs": 1170630,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "by using a different additive."
    } ]
  }, {
    "tStartMs": 1172340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So they tried silica instead,"
    } ]
  }, {
    "tStartMs": 1174380,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "making a whitish-looking tire."
    } ]
  }, {
    "tStartMs": 1176930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But silica is a poor conductor"
    } ]
  }, {
    "tStartMs": 1179000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and rubber itself is an insulator."
    } ]
  }, {
    "tStartMs": 1181130,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So now, as the car moved, it\nwould slowly build up charge."
    } ]
  }, {
    "tStartMs": 1186200,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- As you go to refuel the car,\nyou have a highly charged,"
    } ]
  }, {
    "tStartMs": 1189410,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "static electricity-charged vehicle,"
    } ]
  }, {
    "tStartMs": 1191390,
    "dDurationMs": 2295,
    "segs": [ {
      "utf8": "you put an earth conductor,"
    } ]
  }, {
    "tStartMs": 1193685,
    "dDurationMs": 2196,
    "segs": [ {
      "utf8": "the fuel hose into the tank,"
    } ]
  }, {
    "tStartMs": 1195881,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "you create a spark in\nthe tank, car explodes."
    } ]
  }, {
    "tStartMs": 1200282,
    "dDurationMs": 2978,
    "segs": [ {
      "utf8": "There's a very vital\ncharacteristic of tires"
    } ]
  }, {
    "tStartMs": 1203260,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "is that they should be conductive."
    } ]
  }, {
    "tStartMs": 1204740,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The other benefit is if\nyou're in a thunderstorm"
    } ]
  }, {
    "tStartMs": 1207890,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and you are struck by lightning,"
    } ]
  }, {
    "tStartMs": 1209510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the lightning will hit the car."
    } ]
  }, {
    "tStartMs": 1211130,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It will act as a fire enclosure,"
    } ]
  }, {
    "tStartMs": 1212570,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "it'll completely protect you"
    } ]
  }, {
    "tStartMs": 1213560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and it'll dissipate down to the ground."
    } ]
  }, {
    "tStartMs": 1215990,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Derek] So people have\nstuck to using carbon black"
    } ]
  }, {
    "tStartMs": 1218180,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "for most of the tire and only\na little silica in the treads."
    } ]
  }, {
    "tStartMs": 1223610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- And since Goodyear's invention,"
    } ]
  }, {
    "tStartMs": 1225170,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "we've made over 70 billion tires."
    } ]
  }, {
    "tStartMs": 1228410,
    "dDurationMs": 1852,
    "segs": [ {
      "utf8": "If they were stacked on top of each other,"
    } ]
  }, {
    "tStartMs": 1230262,
    "dDurationMs": 4778,
    "segs": [ {
      "utf8": "they could go to the\nmoon and back 21 times."
    } ]
  }, {
    "tStartMs": 1235040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Derek] And almost all of these tires"
    } ]
  }, {
    "tStartMs": 1236870,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "needed natural rubber."
    } ]
  }, {
    "tStartMs": 1238730,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But fueling the rubber\nboom came at a price,"
    } ]
  }, {
    "tStartMs": 1241100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "especially early on."
    } ]
  }, {
    "tStartMs": 1242780,
    "dDurationMs": 1064,
    "segs": [ {
      "utf8": "In the late 19th century,"
    } ]
  }, {
    "tStartMs": 1243844,
    "dDurationMs": 4096,
    "segs": [ {
      "utf8": "the Amazon region supplied\nover 90% of the world's rubber"
    } ]
  }, {
    "tStartMs": 1247940,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but wild rubber trees were often separated"
    } ]
  }, {
    "tStartMs": 1250010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "by hundreds of meters."
    } ]
  }, {
    "tStartMs": 1251600,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So to keep up with growing demand,"
    } ]
  }, {
    "tStartMs": 1253310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "rubber barons began to exploit natives"
    } ]
  }, {
    "tStartMs": 1255980,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "killing roughly 40,000 people\nin the Putumayo region alone,"
    } ]
  }, {
    "tStartMs": 1259910,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and likely over 100,000\nacross the wider Amazon region"
    } ]
  }, {
    "tStartMs": 1263420,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "between 1879 and 1911."
    } ]
  }, {
    "tStartMs": 1266390,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The humanitarian activist Roger Casement"
    } ]
  }, {
    "tStartMs": 1268280,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "said that, \"It was first\ncalled 'India Rubber,'"
    } ]
  }, {
    "tStartMs": 1270500,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "because it came from the Indies,"
    } ]
  }, {
    "tStartMs": 1272390,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and the earliest European use\nof it was to rub out or erase."
    } ]
  }, {
    "tStartMs": 1276020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It is now called India\nrubber because it rubs out"
    } ]
  }, {
    "tStartMs": 1278360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or erases the Indians.\""
    } ]
  }, {
    "tStartMs": 1280940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- [Katrina] It is one of\nthe most appalling instances"
    } ]
  }, {
    "tStartMs": 1283460,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "of genocide and sickening\nill-treatment of native peoples."
    } ]
  }, {
    "tStartMs": 1288800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Derek] But other countries like England"
    } ]
  }, {
    "tStartMs": 1290330,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "weren't happy with Brazil's monopoly."
    } ]
  }, {
    "tStartMs": 1292280,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "So in 1876, the bio-pirate Henry Wickham"
    } ]
  }, {
    "tStartMs": 1295083,
    "dDurationMs": 4397,
    "segs": [ {
      "utf8": "managed to smuggle 70,000\nrubber seeds back to England."
    } ]
  }, {
    "tStartMs": 1299480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The British Empire planted these seeds"
    } ]
  }, {
    "tStartMs": 1301280,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "all over Southeast Asia\nwhich had a similar climate."
    } ]
  }, {
    "tStartMs": 1304700,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Only now, instead of having\njust a few rubber trees"
    } ]
  }, {
    "tStartMs": 1307190,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "here and there, they made farms"
    } ]
  }, {
    "tStartMs": 1309140,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "of acres and acres of\nnothing but rubber trees."
    } ]
  }, {
    "tStartMs": 1312590,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "These plantations produced\nfar more than the Amazon."
    } ]
  }, {
    "tStartMs": 1315890,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Brazil's share of the rubber supply"
    } ]
  }, {
    "tStartMs": 1317360,
    "dDurationMs": 2339,
    "segs": [ {
      "utf8": "dropped from over 80% in 1907"
    } ]
  }, {
    "tStartMs": 1319699,
    "dDurationMs": 3631,
    "segs": [ {
      "utf8": "to 1.6% just over three decades later."
    } ]
  }, {
    "tStartMs": 1323330,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "By the mid 1930s, over 90% of all rubber"
    } ]
  }, {
    "tStartMs": 1326330,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "came from the British\ncolonies in Southeast Asia."
    } ]
  }, {
    "tStartMs": 1331220,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "And two-thirds of that rubber\nwent into making car tires."
    } ]
  }, {
    "tStartMs": 1334550,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "One of the largest car\nmanufacturers at the time was Ford"
    } ]
  }, {
    "tStartMs": 1337550,
    "dDurationMs": 4144,
    "segs": [ {
      "utf8": "which made an average of\n1.5 million cars every year."
    } ]
  }, {
    "tStartMs": 1341694,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "And Henry Ford wasn't comfortable\nwith England's monopoly."
    } ]
  }, {
    "tStartMs": 1345740,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So in 1928, he bought 10,000\nsquare kilometers of land"
    } ]
  }, {
    "tStartMs": 1349760,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "from the Brazilian government\nto build a utopian town."
    } ]
  }, {
    "tStartMs": 1353600,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "He called it Fordlandia."
    } ]
  }, {
    "tStartMs": 1355430,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It had Cape Cod cottages,\na hospital, swimming pools,"
    } ]
  }, {
    "tStartMs": 1358640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "a golf course and little\nred fire hydrants."
    } ]
  }, {
    "tStartMs": 1361640,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "It was an American city in\nthe middle of the Amazon."
    } ]
  }, {
    "tStartMs": 1365060,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It could house 10,000 people,"
    } ]
  }, {
    "tStartMs": 1367370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "all working to plant\nmillions of rubber trees."
    } ]
  }, {
    "tStartMs": 1370040,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- [Newscaster] Ford Plantation\nis a successful enterprise,"
    } ]
  }, {
    "tStartMs": 1372950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "a tribute to skill and science."
    } ]
  }, {
    "tStartMs": 1375830,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] But in the early 1930s,"
    } ]
  }, {
    "tStartMs": 1377600,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "things started to go wrong."
    } ]
  }, {
    "tStartMs": 1379730,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Every morning, the workers would wake up,"
    } ]
  }, {
    "tStartMs": 1381590,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "walk to the line of rubber trees"
    } ]
  }, {
    "tStartMs": 1383300,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and they'd notice black spots."
    } ]
  }, {
    "tStartMs": 1386660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Just a few at first,"
    } ]
  }, {
    "tStartMs": 1388400,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "little specks on the\nundersides of the leaves,"
    } ]
  }, {
    "tStartMs": 1390770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "like flakes of soot."
    } ]
  }, {
    "tStartMs": 1392330,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But by the afternoon,"
    } ]
  }, {
    "tStartMs": 1393650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "they'd spread to cover\nthe leaves entirely."
    } ]
  }, {
    "tStartMs": 1396260,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And the next morning, the\nleaves were falling off."
    } ]
  }, {
    "tStartMs": 1399230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Shortly after that, the tree died."
    } ]
  }, {
    "tStartMs": 1401780,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Every day, another row of\ntrees was infected and dying."
    } ]
  }, {
    "tStartMs": 1406340,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- People who've seen it say\nit looks like a fire front."
    } ]
  }, {
    "tStartMs": 1408830,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "You have the infected trees\nand it's green on one side"
    } ]
  }, {
    "tStartMs": 1411680,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and black on the other."
    } ]
  }, {
    "tStartMs": 1412970,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And you see that black\nline move day by day,"
    } ]
  }, {
    "tStartMs": 1415880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you could virtually watch it move"
    } ]
  }, {
    "tStartMs": 1417980,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and leaving dead trees behind it."
    } ]
  }, {
    "tStartMs": 1421070,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] The trees were infected"
    } ]
  }, {
    "tStartMs": 1422510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "by the South American leaf blight,"
    } ]
  }, {
    "tStartMs": 1424610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a fungus native to South America."
    } ]
  }, {
    "tStartMs": 1427010,
    "dDurationMs": 2928,
    "segs": [ {
      "utf8": "This blight ruined the\n3.6 million rubber trees"
    } ]
  }, {
    "tStartMs": 1429938,
    "dDurationMs": 3192,
    "segs": [ {
      "utf8": "from Ford's plantations\nby the early 1940s,"
    } ]
  }, {
    "tStartMs": 1433130,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "turning it into a disaster."
    } ]
  }, {
    "tStartMs": 1436520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "When planting his rubber trees,"
    } ]
  }, {
    "tStartMs": 1438020,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "instead of separating\nthem by hundreds of meters"
    } ]
  }, {
    "tStartMs": 1440450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "like they were in the wild,"
    } ]
  }, {
    "tStartMs": 1441980,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "he planted them several meters apart."
    } ]
  }, {
    "tStartMs": 1444287,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "200,000 of them."
    } ]
  }, {
    "tStartMs": 1446390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Katrina] They're all touching,"
    } ]
  }, {
    "tStartMs": 1447223,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "their roots are touching,\ntheir leaves are touching,"
    } ]
  }, {
    "tStartMs": 1448580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "their branches are touching."
    } ]
  }, {
    "tStartMs": 1449780,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And so it's just like a plague,"
    } ]
  }, {
    "tStartMs": 1452420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "one straight through the plantation."
    } ]
  }, {
    "tStartMs": 1454520,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Ford tried relocating the project"
    } ]
  }, {
    "tStartMs": 1456410,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to a town downstream, Belterra,"
    } ]
  }, {
    "tStartMs": 1458750,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "planting another 16,000\nacres with rubber trees"
    } ]
  }, {
    "tStartMs": 1462290,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "but these too all died."
    } ]
  }, {
    "tStartMs": 1465350,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Derek] Ford's son eventually abandoned"
    } ]
  }, {
    "tStartMs": 1467150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the project in 1945."
    } ]
  }, {
    "tStartMs": 1469490,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "The Fordlandia buildings still\nstand in Brazil abandoned."
    } ]
  }, {
    "tStartMs": 1473720,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "- And to this day, there is\nno cure for the leaf blight."
    } ]
  }, {
    "tStartMs": 1477770,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The blight is so fatal to rubber trees,"
    } ]
  }, {
    "tStartMs": 1479690,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "they can't grow in plantations\nin their native country."
    } ]
  }, {
    "tStartMs": 1482870,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "That's why South America\nmakes up less than 2%"
    } ]
  }, {
    "tStartMs": 1485900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of the rubber supply."
    } ]
  }, {
    "tStartMs": 1487100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Over 90% comes from Asia"
    } ]
  }, {
    "tStartMs": 1489770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "which is why it is so essential"
    } ]
  }, {
    "tStartMs": 1491870,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "to prevent the spread of the\nleaf blight to Southeast Asia."
    } ]
  }, {
    "tStartMs": 1496580,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Derek] Virtually,\nall of the rubber trees"
    } ]
  }, {
    "tStartMs": 1498050,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "in Southeast Asia came from\nthose seeds Henry Wickham stole."
    } ]
  }, {
    "tStartMs": 1502010,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And newer trees are just\nclones of the old ones."
    } ]
  }, {
    "tStartMs": 1505160,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "so the farms are essentially\njust one big monoculture."
    } ]
  }, {
    "tStartMs": 1509390,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- As a consequence of that,"
    } ]
  }, {
    "tStartMs": 1510920,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "we are particularly prone\nto the potential outbreaks"
    } ]
  }, {
    "tStartMs": 1514222,
    "dDurationMs": 2338,
    "segs": [ {
      "utf8": "of fungus and things like that."
    } ]
  }, {
    "tStartMs": 1516560,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "If you get a fungal infection in Malaysia,"
    } ]
  }, {
    "tStartMs": 1519590,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "then you would end up\ndramatically reducing"
    } ]
  }, {
    "tStartMs": 1521480,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "global production of rubber."
    } ]
  }, {
    "tStartMs": 1524990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- So what's the outcome if\nwe were cut off from rubber?"
    } ]
  }, {
    "tStartMs": 1527330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- If SALB gets established\nin Southeast Asia"
    } ]
  }, {
    "tStartMs": 1530000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and you lose natural rubber,"
    } ]
  }, {
    "tStartMs": 1531830,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "then you're talking about a complete"
    } ]
  }, {
    "tStartMs": 1534320,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "global societal meltdown."
    } ]
  }, {
    "tStartMs": 1536780,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "You're left now with making"
    } ]
  }, {
    "tStartMs": 1537860,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "synthetic rubber tires at the most."
    } ]
  }, {
    "tStartMs": 1539540,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Worst case, they can't make them."
    } ]
  }, {
    "tStartMs": 1541490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You can't make a truck tire,\nyou won't have any airplanes."
    } ]
  }, {
    "tStartMs": 1544040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "But the real potential is urban famine,"
    } ]
  }, {
    "tStartMs": 1547880,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "for over 50% of the world's\npopulation is in cities."
    } ]
  }, {
    "tStartMs": 1551360,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "How will you move food into\nthe cities to feed them?"
    } ]
  }, {
    "tStartMs": 1555710,
    "dDurationMs": 1916,
    "segs": [ {
      "utf8": "- But something like this did wipe out"
    } ]
  }, {
    "tStartMs": 1557626,
    "dDurationMs": 3544,
    "segs": [ {
      "utf8": "a large part of the rubber\nsupply just six years ago."
    } ]
  }, {
    "tStartMs": 1561170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "In 2019, two different diseases"
    } ]
  }, {
    "tStartMs": 1563150,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "jumped from palm trees to\nrubber trees in Thailand."
    } ]
  }, {
    "tStartMs": 1566270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- In six months,"
    } ]
  }, {
    "tStartMs": 1567103,
    "dDurationMs": 2932,
    "segs": [ {
      "utf8": "these diseases had spread\nacross seven countries"
    } ]
  }, {
    "tStartMs": 1570035,
    "dDurationMs": 3015,
    "segs": [ {
      "utf8": "and a million acres of trees."
    } ]
  }, {
    "tStartMs": 1573050,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "And the next year saw a\n10% drop in production."
    } ]
  }, {
    "tStartMs": 1576980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- And the only reason it\ndidn't destroy more trees"
    } ]
  }, {
    "tStartMs": 1579320,
    "dDurationMs": 3046,
    "segs": [ {
      "utf8": "was because of a different\noutbreak that we all remember."
    } ]
  }, {
    "tStartMs": 1582366,
    "dDurationMs": 4064,
    "segs": [ {
      "utf8": "- COVID comes in early 2020."
    } ]
  }, {
    "tStartMs": 1586430,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It stopped the spread of these diseases"
    } ]
  }, {
    "tStartMs": 1589370,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "as a byproduct of trying to\nstop the spread of COVID."
    } ]
  }, {
    "tStartMs": 1592550,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "If COVID hadn't hit there,\nhow far would that have gone?"
    } ]
  }, {
    "tStartMs": 1597020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "How many more millions of acres"
    } ]
  }, {
    "tStartMs": 1598820,
    "dDurationMs": 3065,
    "segs": [ {
      "utf8": "would've, in effect, been\nkilled or seriously compromised"
    } ]
  }, {
    "tStartMs": 1601885,
    "dDurationMs": 2395,
    "segs": [ {
      "utf8": "by these two leaf blights?"
    } ]
  }, {
    "tStartMs": 1604280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- Granted, it's hard to\npredict what would happen"
    } ]
  }, {
    "tStartMs": 1606290,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "if we ran out of natural rubber."
    } ]
  }, {
    "tStartMs": 1607970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Some say the impact could be catastrophic."
    } ]
  }, {
    "tStartMs": 1610130,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Grounded planes, failed\nrailways, even famine"
    } ]
  }, {
    "tStartMs": 1613220,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and any disruption to the oil supply chain"
    } ]
  }, {
    "tStartMs": 1615110,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "would send shockwaves through\nsynthetic rubber products."
    } ]
  }, {
    "tStartMs": 1618170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But oil is such a polarizing"
    } ]
  }, {
    "tStartMs": 1620150,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and politically-charged topic,"
    } ]
  }, {
    "tStartMs": 1621650,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "deeply tied to global power struggles"
    } ]
  }, {
    "tStartMs": 1623450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and hidden incentives,"
    } ]
  }, {
    "tStartMs": 1624800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that it's hard to know\nwhat's truly at stake."
    } ]
  }, {
    "tStartMs": 1627800,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "That's why we specifically ask Ground News"
    } ]
  }, {
    "tStartMs": 1630170,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to sponsor this video."
    } ]
  }, {
    "tStartMs": 1631610,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They gather news sources from\naround the world in one spot."
    } ]
  }, {
    "tStartMs": 1634130,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So you can read about the same issue"
    } ]
  }, {
    "tStartMs": 1635480,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "from different perspectives,"
    } ]
  }, {
    "tStartMs": 1636590,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "put the context needed to\nseparate facts from politics."
    } ]
  }, {
    "tStartMs": 1640040,
    "dDurationMs": 1982,
    "segs": [ {
      "utf8": "For example, Iran controls a single strait"
    } ]
  }, {
    "tStartMs": 1642022,
    "dDurationMs": 2968,
    "segs": [ {
      "utf8": "that handles roughly\n20% of the world's oil."
    } ]
  }, {
    "tStartMs": 1644990,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "What happens when they\nthreaten to close it"
    } ]
  }, {
    "tStartMs": 1646670,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "amid US strikes on their nuclear sites?"
    } ]
  }, {
    "tStartMs": 1649010,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Well, on the topic, USA today\nran oil hits five-month high"
    } ]
  }, {
    "tStartMs": 1652820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "after US strikes key\nIranian nuclear sites."
    } ]
  }, {
    "tStartMs": 1655610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But the New York Post\nled with US stocks surge"
    } ]
  }, {
    "tStartMs": 1658460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "after restrained around attack on US base."
    } ]
  }, {
    "tStartMs": 1661040,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "One headline warned to\na looming energy crisis,"
    } ]
  }, {
    "tStartMs": 1663530,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "the other stock market rally\nand strategic restraint."
    } ]
  }, {
    "tStartMs": 1667280,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "It's the same event but\ncompletely different conclusions."
    } ]
  }, {
    "tStartMs": 1671390,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "In times of uncertainty,"
    } ]
  }, {
    "tStartMs": 1672590,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "knowing who is telling\nyou the story and why"
    } ]
  }, {
    "tStartMs": 1674510,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "is just as important as\nknowing what actually happened."
    } ]
  }, {
    "tStartMs": 1677360,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Ground News helps you do that"
    } ]
  }, {
    "tStartMs": 1678500,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "by showing you the split headlines"
    } ]
  }, {
    "tStartMs": 1679880,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and surfacing stories hidden\nfrom your usual news feeds"
    } ]
  }, {
    "tStartMs": 1682190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "due to bias through their blind spot feed."
    } ]
  }, {
    "tStartMs": 1684440,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "In fact, the Nobel Peace\nCenter called Ground News"
    } ]
  }, {
    "tStartMs": 1686457,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "\"an excellent way to stay informed,"
    } ]
  }, {
    "tStartMs": 1688160,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "avoid echo chambers"
    } ]
  }, {
    "tStartMs": 1689150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and to expand your worldview.\""
    } ]
  }, {
    "tStartMs": 1691250,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "And I agree."
    } ]
  }, {
    "tStartMs": 1692120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "If we want to properly\nunderstand the crises"
    } ]
  }, {
    "tStartMs": 1693890,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "affecting us here at home\nand around the world,"
    } ]
  }, {
    "tStartMs": 1695870,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "we need better tools."
    } ]
  }, {
    "tStartMs": 1697190,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "And I can't recommend Ground\nNews as that tool enough."
    } ]
  }, {
    "tStartMs": 1699890,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So visit ground.news/VE"
    } ]
  }, {
    "tStartMs": 1702170,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "or scan the QR code here to\nsubscribe for a 40% discount"
    } ]
  }, {
    "tStartMs": 1705350,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "off their Vantage Plan"
    } ]
  }, {
    "tStartMs": 1706430,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "but only with our link, ground.news/VE."
    } ]
  }, {
    "tStartMs": 1709389,
    "dDurationMs": 2411,
    "segs": [ {
      "utf8": "I'd like to thank Ground News\nfor sponsoring this video"
    } ]
  }, {
    "tStartMs": 1711800,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "and now, back to rubber."
    } ]
  }, {
    "tStartMs": 1714380,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- We take natural rubber for granted"
    } ]
  }, {
    "tStartMs": 1715910,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in a huge number of different products."
    } ]
  }, {
    "tStartMs": 1717500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So if you take a typical car,"
    } ]
  }, {
    "tStartMs": 1719690,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "there's something close to\n250-300 rubber components"
    } ]
  }, {
    "tStartMs": 1722320,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "within the car."
    } ]
  }, {
    "tStartMs": 1723740,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "You would have a nightmare\ntrying to re-engineer"
    } ]
  }, {
    "tStartMs": 1725870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "all of those out of synthetic materials."
    } ]
  }, {
    "tStartMs": 1728420,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "- If we were to lose natural rubber"
    } ]
  }, {
    "tStartMs": 1730787,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "and just rely on synthetic rubber,"
    } ]
  }, {
    "tStartMs": 1732413,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "would it still be possible\nto do those applications?"
    } ]
  }, {
    "tStartMs": 1735860,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- So this has happened in the past."
    } ]
  }, {
    "tStartMs": 1738710,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "If you think about it,"
    } ]
  }, {
    "tStartMs": 1740030,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "all of these synthetic polymers"
    } ]
  }, {
    "tStartMs": 1742280,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "come from that initial thought process"
    } ]
  }, {
    "tStartMs": 1746210,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that we can't get natural rubber,"
    } ]
  }, {
    "tStartMs": 1749210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "we have to create other stuff."
    } ]
  }, {
    "tStartMs": 1751160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It's a national security issue."
    } ]
  }, {
    "tStartMs": 1752960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's wild."
    } ]
  }, {
    "tStartMs": 1753793,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "- You're just like, oh, it's a tire."
    } ]
  }, {
    "tStartMs": 1755060,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "But think about it, if\nyou don't have tires,"
    } ]
  }, {
    "tStartMs": 1756320,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "you can't move a military."
    } ]
  }, {
    "tStartMs": 1757640,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Yeah, yeah."
    } ]
  }, {
    "tStartMs": 1758630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The obvious question is, if\nnatural rubber is so great,"
    } ]
  }, {
    "tStartMs": 1760910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "why can't we just replicate it in the lab?"
    } ]
  }, {
    "tStartMs": 1763490,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And that's the exact\nthing that the US tried"
    } ]
  }, {
    "tStartMs": 1765740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "when during the Second World War,"
    } ]
  }, {
    "tStartMs": 1767060,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Japan cut it off from roughly 97%"
    } ]
  }, {
    "tStartMs": 1769490,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of the world's natural rubber supply."
    } ]
  }, {
    "tStartMs": 1772070,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "- Modern war cannot be won without rubber."
    } ]
  }, {
    "tStartMs": 1776450,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "- What then happened was an\nenormous investment by the US,"
    } ]
  }, {
    "tStartMs": 1780290,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "equivalent to $11.1\nbillion in today's terms,"
    } ]
  }, {
    "tStartMs": 1783593,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "into synthetic rubber"
    } ]
  }, {
    "tStartMs": 1785240,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and growing alternative\nnatural rubber crops."
    } ]
  }, {
    "tStartMs": 1788900,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- That's roughly a third"
    } ]
  }, {
    "tStartMs": 1790070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "of the Manhattan project."
    } ]
  }, {
    "tStartMs": 1792110,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It was a complete gamble"
    } ]
  }, {
    "tStartMs": 1793310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but the four big US tire companies"
    } ]
  }, {
    "tStartMs": 1794930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "were able to improve and manufacture"
    } ]
  }, {
    "tStartMs": 1796610,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "a synthetic rubber\ncalled styrene-butadiene"
    } ]
  }, {
    "tStartMs": 1799130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "in less than three years."
    } ]
  }, {
    "tStartMs": 1801140,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Unlike natural rubbers, styrene-butadiene"
    } ]
  }, {
    "tStartMs": 1803140,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "is made from two monomers."
    } ]
  }, {
    "tStartMs": 1804500,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Roughly 25% styrene and 75% butadiene,"
    } ]
  }, {
    "tStartMs": 1808310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "both usually come from crude oil refining."
    } ]
  }, {
    "tStartMs": 1811310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The monomers are dispersed in water"
    } ]
  }, {
    "tStartMs": 1812840,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and combined into long chains\nin a random arrangement."
    } ]
  }, {
    "tStartMs": 1815870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Then, the rubber is vulcanised."
    } ]
  }, {
    "tStartMs": 1817820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Now, compared to natural rubber,"
    } ]
  }, {
    "tStartMs": 1819170,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it doesn't wear down as\nquickly under friction"
    } ]
  }, {
    "tStartMs": 1821240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but it has a much lower tensile strength."
    } ]
  }, {
    "tStartMs": 1823700,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "In 1942, the US used 99.6% natural rubber"
    } ]
  }, {
    "tStartMs": 1827660,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and 0.4% synthetic."
    } ]
  }, {
    "tStartMs": 1830090,
    "dDurationMs": 2448,
    "segs": [ {
      "utf8": "But in 1945, it was practically reversed"
    } ]
  }, {
    "tStartMs": 1832538,
    "dDurationMs": 3615,
    "segs": [ {
      "utf8": "at 14% natural and 86% synthetic."
    } ]
  }, {
    "tStartMs": 1837320,
    "dDurationMs": 3117,
    "segs": [ {
      "utf8": "Now, almost 70% of all\nrubber consumed is synthetic"
    } ]
  }, {
    "tStartMs": 1840437,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "and the most common one is\nstill styrene-butadiene."
    } ]
  }, {
    "tStartMs": 1844220,
    "dDurationMs": 1215,
    "segs": [ {
      "utf8": "But there are some things"
    } ]
  }, {
    "tStartMs": 1845435,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "that natural rubber is just better at."
    } ]
  }, {
    "tStartMs": 1848480,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- If you think about airplane tires,"
    } ]
  }, {
    "tStartMs": 1850580,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "it's absolutely incredible\nthat they're up there"
    } ]
  }, {
    "tStartMs": 1853730,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "umpteen degrees below zero"
    } ]
  }, {
    "tStartMs": 1855830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "before they start to come into land."
    } ]
  }, {
    "tStartMs": 1857750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And then you've got this\nhuge weight of the airplane"
    } ]
  }, {
    "tStartMs": 1859700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "on these dinky little tires"
    } ]
  }, {
    "tStartMs": 1861560,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "that increase in temperature enormously"
    } ]
  }, {
    "tStartMs": 1864722,
    "dDurationMs": 2418,
    "segs": [ {
      "utf8": "over an incredibly small space of time"
    } ]
  }, {
    "tStartMs": 1867140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and only natural rubber can do it."
    } ]
  }, {
    "tStartMs": 1869480,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So airplane tires are\nessentially 100% natural rubber"
    } ]
  }, {
    "tStartMs": 1872450,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "and you can't land if you've\ngot synthetic in the tire."
    } ]
  }, {
    "tStartMs": 1877010,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- So what can natural rubber do"
    } ]
  }, {
    "tStartMs": 1878420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that we just can't replicate?"
    } ]
  }, {
    "tStartMs": 1880400,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "- Okay, what I want you to think about."
    } ]
  }, {
    "tStartMs": 1882427,
    "dDurationMs": 1273,
    "segs": [ {
      "utf8": "- Yeah.\n- Is you start to stretch it,"
    } ]
  }, {
    "tStartMs": 1883700,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "this first movement."
    } ]
  }, {
    "tStartMs": 1885140,
    "dDurationMs": 1098,
    "segs": [ {
      "utf8": "- Yeah.\n- Hardly, it's very easy"
    } ]
  }, {
    "tStartMs": 1886238,
    "dDurationMs": 1932,
    "segs": [ {
      "utf8": "to stretch that bit."
    } ]
  }, {
    "tStartMs": 1888170,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Yeah.\n- That first bit, I assume."
    } ]
  }, {
    "tStartMs": 1889550,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Now, think about how\nmuch force you're using"
    } ]
  }, {
    "tStartMs": 1892820,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to continue to stretch it."
    } ]
  }, {
    "tStartMs": 1895310,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "- Yeah, it gets harder.\n- Now,"
    } ]
  }, {
    "tStartMs": 1896432,
    "dDurationMs": 1686,
    "segs": [ {
      "utf8": "it gets harder and harder"
    } ]
  }, {
    "tStartMs": 1898118,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "and harder and harder.\n- It feels like,"
    } ]
  }, {
    "tStartMs": 1900020,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "yeah, it could snap.\n- And then eventually,"
    } ]
  }, {
    "tStartMs": 1901190,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "you'll get to a break point."
    } ]
  }, {
    "tStartMs": 1902430,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- Yeah, yeah.\n- But what's happening,"
    } ]
  }, {
    "tStartMs": 1904040,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "why it's getting harder"
    } ]
  }, {
    "tStartMs": 1905270,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "is that the rubber is getting\nstronger as you stretch it."
    } ]
  }, {
    "tStartMs": 1909110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] As you stretch the polymers,"
    } ]
  }, {
    "tStartMs": 1910610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "they start to align and stick together"
    } ]
  }, {
    "tStartMs": 1912440,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "through weak intermolecular forces"
    } ]
  }, {
    "tStartMs": 1914300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "called Van der Waal's forces."
    } ]
  }, {
    "tStartMs": 1916100,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "When they're packed tightly enough,"
    } ]
  }, {
    "tStartMs": 1917810,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the polymers freeze together\nin thin sheetlike crystals"
    } ]
  }, {
    "tStartMs": 1920900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "aligned in the direction you stretch."
    } ]
  }, {
    "tStartMs": 1922820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And as you keep pulling,"
    } ]
  }, {
    "tStartMs": 1924260,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "more and more polymers\njoin the crystal structure."
    } ]
  }, {
    "tStartMs": 1926960,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Each crystal acts as a new cross-link,"
    } ]
  }, {
    "tStartMs": 1929030,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "making the rubber harder and stronger."
    } ]
  }, {
    "tStartMs": 1931670,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "- That ability to form\ncrystalite prevents tear."
    } ]
  }, {
    "tStartMs": 1935374,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "So if you have crack propagation,"
    } ]
  }, {
    "tStartMs": 1936942,
    "dDurationMs": 2888,
    "segs": [ {
      "utf8": "it hits a crystal and\ncan't go any further."
    } ]
  }, {
    "tStartMs": 1939830,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] In a sample without a crack,"
    } ]
  }, {
    "tStartMs": 1941240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the stress is evenly distributed."
    } ]
  }, {
    "tStartMs": 1943280,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But if there is a crack, more\nload flows right to the edge"
    } ]
  }, {
    "tStartMs": 1946610,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so the rubber stretches more."
    } ]
  }, {
    "tStartMs": 1948530,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "That area forms more crystals"
    } ]
  }, {
    "tStartMs": 1949949,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "so it becomes harder to break."
    } ]
  }, {
    "tStartMs": 1952190,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The crystals stop the crack growth"
    } ]
  }, {
    "tStartMs": 1953960,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "until a threshold is reached."
    } ]
  }, {
    "tStartMs": 1955970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And then, it breaks."
    } ]
  }, {
    "tStartMs": 1958370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "This is what makes\nnatural rubber so durable."
    } ]
  }, {
    "tStartMs": 1960860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "It's self-reinforcing under stress,"
    } ]
  }, {
    "tStartMs": 1963290,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "stopping cracks in their tracks."
    } ]
  }, {
    "tStartMs": 1967040,
    "dDurationMs": 2891,
    "segs": [ {
      "utf8": "- Crystallization is what\nmakes natural rubber so good"
    } ]
  }, {
    "tStartMs": 1969931,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "for tough applications."
    } ]
  }, {
    "tStartMs": 1972290,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- The plane can weigh 5, 600 tons."
    } ]
  }, {
    "tStartMs": 1975200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So if you think about that,\nyou've gotta, you know,"
    } ]
  }, {
    "tStartMs": 1977870,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "each tire is taking 20 tons."
    } ]
  }, {
    "tStartMs": 1979910,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And it's coming from a very\ncold temperature up there, yeah?"
    } ]
  }, {
    "tStartMs": 1983090,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "It's -50, -60,"
    } ]
  }, {
    "tStartMs": 1986120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "depending exactly how\nhigh you've been flying."
    } ]
  }, {
    "tStartMs": 1987980,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And you go from zero rotational\nspeed quite fast, very fast"
    } ]
  }, {
    "tStartMs": 1991010,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and you get generate a\nlot of frictional heat"
    } ]
  }, {
    "tStartMs": 1992570,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "really quickly as well."
    } ]
  }, {
    "tStartMs": 1995090,
    "dDurationMs": 2432,
    "segs": [ {
      "utf8": "There's a reason why they\nmake tires for planes"
    } ]
  }, {
    "tStartMs": 1997522,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "out of natural rubber"
    } ]
  }, {
    "tStartMs": 1999170,
    "dDurationMs": 3076,
    "segs": [ {
      "utf8": "and that's because it's\nreally demanding application."
    } ]
  }, {
    "tStartMs": 2002246,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "And the crystallization\nhelps a huge amount"
    } ]
  }, {
    "tStartMs": 2005680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "preserve those tires and help them last."
    } ]
  }, {
    "tStartMs": 2008680,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Derek] One study notes\nthat, \"Experiment has shown"
    } ]
  }, {
    "tStartMs": 2010990,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that no detectable\ncrack propagation occurs"
    } ]
  }, {
    "tStartMs": 2013420,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "in rubber undergoing crystallization"
    } ]
  }, {
    "tStartMs": 2015610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "until the stress is so high"
    } ]
  }, {
    "tStartMs": 2017290,
    "dDurationMs": 3207,
    "segs": [ {
      "utf8": "as to generate abrupt\ncatastrophic fracture.\""
    } ]
  }, {
    "tStartMs": 2022999,
    "dDurationMs": 2931,
    "segs": [ {
      "utf8": "- Oh, that was fast.\n- That was fast."
    } ]
  }, {
    "tStartMs": 2025930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- And then eventually,\nyou'll get to a break point."
    } ]
  }, {
    "tStartMs": 2029500,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And yet you finally overcame it."
    } ]
  }, {
    "tStartMs": 2031750,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Derek] When you pull\non a rubber sample,"
    } ]
  }, {
    "tStartMs": 2033220,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "you're applying a stress."
    } ]
  }, {
    "tStartMs": 2034780,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The polymers realign\nand the wiggle unfolds."
    } ]
  }, {
    "tStartMs": 2037450,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So the piece deforms and gets longer."
    } ]
  }, {
    "tStartMs": 2039880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The per unit change in\nlength is known as strain,"
    } ]
  }, {
    "tStartMs": 2042700,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and we can plot this on\na stress-strain curve."
    } ]
  }, {
    "tStartMs": 2045490,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Lots of materials are\nelastic around low stresses."
    } ]
  }, {
    "tStartMs": 2048490,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "You stretch it a little"
    } ]
  }, {
    "tStartMs": 2049570,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and the spacing between atoms changes."
    } ]
  }, {
    "tStartMs": 2051790,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "But when you remove the force,"
    } ]
  }, {
    "tStartMs": 2053050,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it goes back to its original shape."
    } ]
  }, {
    "tStartMs": 2055450,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But eventually, you hit a stress"
    } ]
  }, {
    "tStartMs": 2057220,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where there is permanent deformation."
    } ]
  }, {
    "tStartMs": 2059380,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "That's called the yield point."
    } ]
  }, {
    "tStartMs": 2061030,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The material can't go back\nto the same shape after."
    } ]
  }, {
    "tStartMs": 2064090,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And if you keep going, it will fracture."
    } ]
  }, {
    "tStartMs": 2067390,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But the stress-strain curve\nfor rubber is a little weird."
    } ]
  }, {
    "tStartMs": 2070720,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "It starts out stretching very\nfar with very little force."
    } ]
  }, {
    "tStartMs": 2074140,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "That's the easy part."
    } ]
  }, {
    "tStartMs": 2075520,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "But then as you keep pulling,"
    } ]
  }, {
    "tStartMs": 2076870,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "the stress shoots up really fast."
    } ]
  }, {
    "tStartMs": 2080080,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "- So stretch it fast."
    } ]
  }, {
    "tStartMs": 2083050,
    "dDurationMs": 1578,
    "segs": [ {
      "utf8": "What do you notice?"
    } ]
  }, {
    "tStartMs": 2084628,
    "dDurationMs": 1455,
    "segs": [ {
      "utf8": "- It's a little warm, maybe?"
    } ]
  }, {
    "tStartMs": 2086083,
    "dDurationMs": 1255,
    "segs": [ {
      "utf8": "- It's hot, it's gone up in temperature"
    } ]
  }, {
    "tStartMs": 2087338,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "by 10 degrees.\n- Yeah, yeah."
    } ]
  }, {
    "tStartMs": 2088897,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "That section where it gets really hard"
    } ]
  }, {
    "tStartMs": 2091150,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to pull it any further and it gets hotter,"
    } ]
  }, {
    "tStartMs": 2093190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that's right where rubber\nstarts to crystallize."
    } ]
  }, {
    "tStartMs": 2095980,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The rubber warms up because\nas those new bonds form,"
    } ]
  }, {
    "tStartMs": 2098950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "they release a bit of energy as heat."
    } ]
  }, {
    "tStartMs": 2101470,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Then if you keep stretching\nit, you get to the point"
    } ]
  }, {
    "tStartMs": 2103720,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "where the crystal can no\nlonger hold it when it breaks."
    } ]
  }, {
    "tStartMs": 2107140,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But something strange happens"
    } ]
  }, {
    "tStartMs": 2108460,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "if you stop right before\nthat fracture point."
    } ]
  }, {
    "tStartMs": 2111130,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "Then the rubber bounces\nback but on a lower curve."
    } ]
  }, {
    "tStartMs": 2116530,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Keep it stretched, keep it stretched"
    } ]
  }, {
    "tStartMs": 2117790,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and wiggle it around."
    } ]
  }, {
    "tStartMs": 2119410,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now, relax it."
    } ]
  }, {
    "tStartMs": 2121480,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Touch your lips, what do you got?"
    } ]
  }, {
    "tStartMs": 2124270,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Now it's a much cooler."
    } ]
  }, {
    "tStartMs": 2125590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 2126423,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah.\n- So you went"
    } ]
  }, {
    "tStartMs": 2127256,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "for crystallization formula."
    } ]
  }, {
    "tStartMs": 2128089,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "You stretched it, you crystallized it,"
    } ]
  }, {
    "tStartMs": 2128988,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "that's an exothermic reaction."
    } ]
  }, {
    "tStartMs": 2130990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Wow, okay."
    } ]
  }, {
    "tStartMs": 2131823,
    "dDurationMs": 1815,
    "segs": [ {
      "utf8": "- You then allowed it to\ncool down to room temperature"
    } ]
  }, {
    "tStartMs": 2133638,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "and the stretch state"
    } ]
  }, {
    "tStartMs": 2135190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and you relaxed it"
    } ]
  }, {
    "tStartMs": 2136870,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "and you dissolved the crystals."
    } ]
  }, {
    "tStartMs": 2140020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's weird."
    } ]
  }, {
    "tStartMs": 2140853,
    "dDurationMs": 1087,
    "segs": [ {
      "utf8": "- How'd you dissolve the crystals?"
    } ]
  }, {
    "tStartMs": 2141940,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "You've gotta take energy from somewhere"
    } ]
  }, {
    "tStartMs": 2143410,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "to dissolve crystals."
    } ]
  }, {
    "tStartMs": 2144520,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "You cool the rubber band out."
    } ]
  }, {
    "tStartMs": 2147280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Derek] The reason the\ntwo curves are different"
    } ]
  }, {
    "tStartMs": 2149080,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "is because it takes more\nenergy to align the polymers"
    } ]
  }, {
    "tStartMs": 2152110,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "than it does for the\npolymers to curl back up."
    } ]
  }, {
    "tStartMs": 2154540,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "And this energy difference\nis exactly the heat"
    } ]
  }, {
    "tStartMs": 2157150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that's released over a full cycle."
    } ]
  }, {
    "tStartMs": 2159820,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "We've seen that natural rubber is built"
    } ]
  }, {
    "tStartMs": 2161710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "using these building blocks"
    } ]
  }, {
    "tStartMs": 2163180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but the technical monomer\nis actually isoprene"
    } ]
  }, {
    "tStartMs": 2165550,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which looks like this."
    } ]
  }, {
    "tStartMs": 2167170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "It's the same atoms but with some groups"
    } ]
  }, {
    "tStartMs": 2169120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and bonds moved around."
    } ]
  }, {
    "tStartMs": 2170560,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "So the technical term for\nrubber is cis-1,4-polyisoprene."
    } ]
  }, {
    "tStartMs": 2175330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- And we've actually been able to make"
    } ]
  }, {
    "tStartMs": 2177370,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "synthetic cis-1,4-polyisoprene."
    } ]
  }, {
    "tStartMs": 2179680,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "You can take isoprene and polymerize it."
    } ]
  }, {
    "tStartMs": 2182830,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "So it should behave exactly\nlike natural rubber, right?"
    } ]
  }, {
    "tStartMs": 2187360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- And that one is the closest"
    } ]
  }, {
    "tStartMs": 2190000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but it doesn't perform nearly as well"
    } ]
  }, {
    "tStartMs": 2191920,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "because it's not structurally as perfect"
    } ]
  }, {
    "tStartMs": 2196060,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "as natural rubber."
    } ]
  }, {
    "tStartMs": 2197830,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] See, there are two ways"
    } ]
  }, {
    "tStartMs": 2198970,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "for the monomers to attach."
    } ]
  }, {
    "tStartMs": 2200290,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "In natural rubber,"
    } ]
  }, {
    "tStartMs": 2201160,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "they attach on the same\nside, the cis-attachment."
    } ]
  }, {
    "tStartMs": 2204310,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- The percentage of cis\nin the molecular chain"
    } ]
  }, {
    "tStartMs": 2207190,
    "dDurationMs": 2779,
    "segs": [ {
      "utf8": "that nature can provide\nis really accurate."
    } ]
  }, {
    "tStartMs": 2209969,
    "dDurationMs": 4781,
    "segs": [ {
      "utf8": "It's 99.99%, something\nof that sort of scale."
    } ]
  }, {
    "tStartMs": 2214750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] But with synthetic rubber,"
    } ]
  }, {
    "tStartMs": 2215950,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "it's easy for monomers"
    } ]
  }, {
    "tStartMs": 2217120,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to attach on the opposite\nside of the double bond."
    } ]
  }, {
    "tStartMs": 2219790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That's the trans-attachment."
    } ]
  }, {
    "tStartMs": 2221950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But now there's more room\nfor them to lay flat."
    } ]
  }, {
    "tStartMs": 2224710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They don't have that extra wiggle"
    } ]
  }, {
    "tStartMs": 2226330,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "so they stretch less and\ndon't crystallize very well."
    } ]
  }, {
    "tStartMs": 2229780,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- And when you make the\nsynthetic equivalent,"
    } ]
  }, {
    "tStartMs": 2232060,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "it's pretty good but it's\n98% cis polyisoprene."
    } ]
  }, {
    "tStartMs": 2236950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "There is, you know, 1% or 2%"
    } ]
  }, {
    "tStartMs": 2239020,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "it's gonna be trans-polyisoprene."
    } ]
  }, {
    "tStartMs": 2240310,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And therefore, isn't\nsusceptible for crystallization"
    } ]
  }, {
    "tStartMs": 2243520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and it's not as good"
    } ]
  }, {
    "tStartMs": 2244780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and hasn't not the same\nstrengths properties"
    } ]
  }, {
    "tStartMs": 2246460,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that natural rubber would have."
    } ]
  }, {
    "tStartMs": 2248440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] In a tensile\ntest, a synthetic rubber"
    } ]
  }, {
    "tStartMs": 2250360,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "also stretched to around\n600% before breaking."
    } ]
  }, {
    "tStartMs": 2253660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "But it only took around 9.1 megapascals"
    } ]
  }, {
    "tStartMs": 2256390,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "compared to over 14.1\nmegapascals for natural rubber."
    } ]
  }, {
    "tStartMs": 2260740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "But there are a few areas"
    } ]
  }, {
    "tStartMs": 2262060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "where a synthetic rubber is\nactually better than natural."
    } ]
  }, {
    "tStartMs": 2264700,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Under low stress, where\ncrystallization doesn't happen,"
    } ]
  }, {
    "tStartMs": 2267610,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "natural rubber loses the advantage."
    } ]
  }, {
    "tStartMs": 2269830,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So synthetic is preferred for the tread"
    } ]
  }, {
    "tStartMs": 2271840,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "of passenger car tires for\nbetter abrasion resistance."
    } ]
  }, {
    "tStartMs": 2275830,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Nitrile rubber, a synthetic\nrubber used for gloves,"
    } ]
  }, {
    "tStartMs": 2278620,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "also blocks harsher chemicals\nfrom passing through."
    } ]
  }, {
    "tStartMs": 2282190,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "- So in polyisoprene, we used to see,"
    } ]
  }, {
    "tStartMs": 2285640,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "let's say in chemotherapy agents,"
    } ]
  }, {
    "tStartMs": 2288730,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "maybe 80%-90% permeation."
    } ]
  }, {
    "tStartMs": 2292720,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "In nitrile, we see maybe 10 - 20."
    } ]
  }, {
    "tStartMs": 2295033,
    "dDurationMs": 1284,
    "segs": [ {
      "utf8": "- Wow.\n- So it's much better."
    } ]
  }, {
    "tStartMs": 2296317,
    "dDurationMs": 839,
    "segs": [ {
      "utf8": "- That's huge."
    } ]
  }, {
    "tStartMs": 2297156,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "- Mm, that's huge."
    } ]
  }, {
    "tStartMs": 2298690,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "For a cancer center worker, that's huge."
    } ]
  }, {
    "tStartMs": 2302020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Nitrile gloves were\ndeveloped in the late 1980s"
    } ]
  }, {
    "tStartMs": 2304360,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "during the global AIDS pandemic"
    } ]
  }, {
    "tStartMs": 2305740,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "in response to the growing latex allergy."
    } ]
  }, {
    "tStartMs": 2308410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Surprisingly, gloves weren't required"
    } ]
  }, {
    "tStartMs": 2310510,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "for every single procedure until\nthe CDC published a mandate"
    } ]
  }, {
    "tStartMs": 2313570,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to prevent HIV transmission in 1987."
    } ]
  }, {
    "tStartMs": 2316810,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "After the demand for gloves\nwent from 300 million"
    } ]
  }, {
    "tStartMs": 2319780,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "to over 36 billion by\nthe end of the 1980s."
    } ]
  }, {
    "tStartMs": 2323170,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Well, dozens of new latex glove factories"
    } ]
  }, {
    "tStartMs": 2325240,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "sprang up to meet the demands."
    } ]
  }, {
    "tStartMs": 2326980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Typically, after a mold\nis dipped in latex,"
    } ]
  }, {
    "tStartMs": 2329320,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "the glove is leached"
    } ]
  }, {
    "tStartMs": 2330250,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and lots of proteins from the\ntree are just washed away."
    } ]
  }, {
    "tStartMs": 2333550,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But then, they got rid of that step."
    } ]
  }, {
    "tStartMs": 2336820,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- This meant that all of\nthose soluble proteins"
    } ]
  }, {
    "tStartMs": 2339310,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "were left in the glove."
    } ]
  }, {
    "tStartMs": 2340900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- So when nurses or doctors\nwere putting on or taking off"
    } ]
  }, {
    "tStartMs": 2343600,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "these unleached powdered gloves,"
    } ]
  }, {
    "tStartMs": 2345070,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "they would disperse all of\nthose proteins into the air."
    } ]
  }, {
    "tStartMs": 2347980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- This nursing staff were\nbreathing those particles in,"
    } ]
  }, {
    "tStartMs": 2350440,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "breathing that dust in,\nthrough their entire shifts"
    } ]
  }, {
    "tStartMs": 2353830,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and into their lungs."
    } ]
  }, {
    "tStartMs": 2355120,
    "dDurationMs": 2646,
    "segs": [ {
      "utf8": "Now the patients, you've got these gloves"
    } ]
  }, {
    "tStartMs": 2357766,
    "dDurationMs": 1504,
    "segs": [ {
      "utf8": "with loads of proteins,"
    } ]
  }, {
    "tStartMs": 2359270,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "washing that around in your innards."
    } ]
  }, {
    "tStartMs": 2362380,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- Thousands of people were exposed enough"
    } ]
  }, {
    "tStartMs": 2364000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to become allergic to latex."
    } ]
  }, {
    "tStartMs": 2365830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- In the early 90s,"
    } ]
  }, {
    "tStartMs": 2367090,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "you said if you had four\nsurgical procedures,"
    } ]
  }, {
    "tStartMs": 2370000,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "you almost certainly have\nType I latex allergy."
    } ]
  }, {
    "tStartMs": 2372183,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "If you've had 10, you do."
    } ]
  }, {
    "tStartMs": 2374470,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- So eventually, manufacturers\nreceived enough complaints"
    } ]
  }, {
    "tStartMs": 2376750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that they started leaching again,"
    } ]
  }, {
    "tStartMs": 2377950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but by then it was too late."
    } ]
  }, {
    "tStartMs": 2379810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Even if something's been properly leached,"
    } ]
  }, {
    "tStartMs": 2381400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "if someone has that Type I latex allergy,"
    } ]
  }, {
    "tStartMs": 2383380,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "they're still gonna react to it."
    } ]
  }, {
    "tStartMs": 2385450,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Nitrile gloves helped combat that allergy."
    } ]
  }, {
    "tStartMs": 2388210,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But for long surgeries, some\ndoctors still prefer the softer"
    } ]
  }, {
    "tStartMs": 2391690,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and more comfortable glove\nthat comes from natural latex."
    } ]
  }, {
    "tStartMs": 2394990,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So Dr. Cornish has been working"
    } ]
  }, {
    "tStartMs": 2396610,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "on alternative natural\nrubber from the Guayule plant"
    } ]
  }, {
    "tStartMs": 2399910,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "which doesn't have the proteins\nthat people are allergic to."
    } ]
  }, {
    "tStartMs": 2403240,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This plant can grow in desert climates"
    } ]
  }, {
    "tStartMs": 2405550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and it makes a stronger, softer rubber"
    } ]
  }, {
    "tStartMs": 2407770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "than even the Brazilian rubber tree."
    } ]
  }, {
    "tStartMs": 2410290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Not only does scaling up Guayule"
    } ]
  }, {
    "tStartMs": 2412270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "help with the latex allergy,"
    } ]
  }, {
    "tStartMs": 2413950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it's also a safeguard in case\nthe blight ever makes its way"
    } ]
  }, {
    "tStartMs": 2416710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "across to Southeast Asia."
    } ]
  }, {
    "tStartMs": 2418330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Transportation, healthcare, construction,"
    } ]
  }, {
    "tStartMs": 2420580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "there are so many industries"
    } ]
  }, {
    "tStartMs": 2421930,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that are dependent on natural rubber."
    } ]
  }, {
    "tStartMs": 2424210,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Derek] There are regulations"
    } ]
  }, {
    "tStartMs": 2425380,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "around South American leaf blight control"
    } ]
  }, {
    "tStartMs": 2427930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and it's difficult to get a direct flight"
    } ]
  }, {
    "tStartMs": 2429640,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "from Brazil to Southeast Asia"
    } ]
  }, {
    "tStartMs": 2431410,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but not impossible."
    } ]
  }, {
    "tStartMs": 2433390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- It seems shortsighted to\nleave the industry vulnerable"
    } ]
  }, {
    "tStartMs": 2436630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to like one bad flight."
    } ]
  }, {
    "tStartMs": 2438790,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "For a material that only became\nuseful around 200 years ago,"
    } ]
  }, {
    "tStartMs": 2442240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it's now hard to imagine life without it."
    } ]
  }, {
    "tStartMs": 2445360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "When Henry Ford developed Fordlandia,"
    } ]
  }, {
    "tStartMs": 2447400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "he didn't consult a\nsingle rubber tree expert"
    } ]
  }, {
    "tStartMs": 2450220,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "who could have told him about the blight."
    } ]
  }, {
    "tStartMs": 2452470,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "So let's not make that same mistake again."
    } ]
  }, {
    "tStartMs": 2455097,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(bright music fades)"
    } ]
  } ]
}
