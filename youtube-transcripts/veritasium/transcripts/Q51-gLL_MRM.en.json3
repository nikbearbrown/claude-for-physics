{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- This is the world's\nlargest earthquake simulator."
    } ]
  }, {
    "tStartMs": 2940,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's called E-Defense."
    } ]
  }, {
    "tStartMs": 5280,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Its huge shake table can\nsupport a 10-story building"
    } ]
  }, {
    "tStartMs": 9540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and then move it in all directions"
    } ]
  }, {
    "tStartMs": 11670,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "with the force of the world's\nmost destructive earthquakes."
    } ]
  }, {
    "tStartMs": 16590,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "E-Defense has conducted\nmore than a hundred tests,"
    } ]
  }, {
    "tStartMs": 19290,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "subjecting all kinds of buildings"
    } ]
  }, {
    "tStartMs": 21630,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to different simulated earthquakes,"
    } ]
  }, {
    "tStartMs": 24360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "all to learn how to make buildings"
    } ]
  }, {
    "tStartMs": 26220,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "more earthquake-resistant."
    } ]
  }, {
    "tStartMs": 34020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Part of this video was\nbrought to you by Shopify,"
    } ]
  }, {
    "tStartMs": 36270,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "more about them later in the video."
    } ]
  }, {
    "tStartMs": 39900,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "On the 17th of January, 1995"
    } ]
  }, {
    "tStartMs": 42182,
    "dDurationMs": 2968,
    "segs": [ {
      "utf8": "at 5:46 in the morning,\nan earthquake struck"
    } ]
  }, {
    "tStartMs": 45150,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the city of Kobe Japan."
    } ]
  }, {
    "tStartMs": 47430,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "It took everyone by surprise."
    } ]
  }, {
    "tStartMs": 55260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Japan is one of the most\nseismically active countries"
    } ]
  }, {
    "tStartMs": 58050,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in the world."
    } ]
  }, {
    "tStartMs": 58883,
    "dDurationMs": 2587,
    "segs": [ {
      "utf8": "It sits on the boundary\nof four tectonic plates"
    } ]
  }, {
    "tStartMs": 61470,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and 90% of all earthquakes,"
    } ]
  }, {
    "tStartMs": 63750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and almost all of the powerful ones"
    } ]
  }, {
    "tStartMs": 65700,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "happen at tectonic plate boundaries."
    } ]
  }, {
    "tStartMs": 69060,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "But Kobe isn't near one."
    } ]
  }, {
    "tStartMs": 72150,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This earthquake was caused\nby an interplate fault,"
    } ]
  }, {
    "tStartMs": 75000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "essentially a crack in the Earth's surface"
    } ]
  }, {
    "tStartMs": 77610,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that isn't at the boundary\nof a tectonic plate."
    } ]
  }, {
    "tStartMs": 80640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This fault hadn't produced any earthquakes"
    } ]
  }, {
    "tStartMs": 82680,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "for around a thousand years,"
    } ]
  }, {
    "tStartMs": 85500,
    "dDurationMs": 3313,
    "segs": [ {
      "utf8": "so the city was completely unprepared."
    } ]
  }, {
    "tStartMs": 88813,
    "dDurationMs": 4487,
    "segs": [ {
      "utf8": "(woman speaking in Japanese)"
    } ]
  }, {
    "tStartMs": 93300,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The quake measured a magnitude 6.9"
    } ]
  }, {
    "tStartMs": 96390,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "just under the definition\nof a major earthquake."
    } ]
  }, {
    "tStartMs": 99660,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Despite this, the earthquake\nkilled more than 6,000 people"
    } ]
  }, {
    "tStartMs": 103350,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and left another 300,000 homeless."
    } ]
  }, {
    "tStartMs": 106680,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "More than 80% of the\nfatalities were caused"
    } ]
  }, {
    "tStartMs": 109650,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "by the collapse of buildings."
    } ]
  }, {
    "tStartMs": 111780,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The total economic cost was estimated"
    } ]
  }, {
    "tStartMs": 113880,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at 80 billion US dollars."
    } ]
  }, {
    "tStartMs": 116850,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "In response, the government\ngathered scientists"
    } ]
  }, {
    "tStartMs": 118980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "for a conference on earthquake\ndisaster prevention,"
    } ]
  }, {
    "tStartMs": 121920,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "and there they agreed"
    } ]
  }, {
    "tStartMs": 123030,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "to build the largest earthquake simulator"
    } ]
  }, {
    "tStartMs": 125460,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the world had ever seen."
    } ]
  }, {
    "tStartMs": 127680,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So I sent Petr to Japan\nfor an exclusive look"
    } ]
  }, {
    "tStartMs": 130860,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "inside this facility."
    } ]
  }, {
    "tStartMs": 133140,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- So we're entering the world's\nbiggest earthquake simulator"
    } ]
  }, {
    "tStartMs": 136470,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "as they're about to do an experiment."
    } ]
  }, {
    "tStartMs": 139170,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "So let's go."
    } ]
  }, {
    "tStartMs": 141090,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Right now there's eight concrete walls"
    } ]
  }, {
    "tStartMs": 143760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that they're gonna feed seismic signals"
    } ]
  }, {
    "tStartMs": 146040,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "into the shake table,"
    } ]
  }, {
    "tStartMs": 147360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and they're gonna see which\nones are the most sturdy."
    } ]
  }, {
    "tStartMs": 149400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So the seismic data that\nthey're gonna feed in"
    } ]
  }, {
    "tStartMs": 151410,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is from the El Centro earthquake,"
    } ]
  }, {
    "tStartMs": 153420,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "which was an earthquake"
    } ]
  }, {
    "tStartMs": 154590,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that happened on the 18th of May, 1940."
    } ]
  }, {
    "tStartMs": 156810,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It was a 6.9 magnitude earthquake,"
    } ]
  }, {
    "tStartMs": 158790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and it's one of the first ones"
    } ]
  }, {
    "tStartMs": 160170,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "that we actually have seismic data from."
    } ]
  }, {
    "tStartMs": 164186,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 166770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Okay, things are wow, wow,\nwow, wow, wow, wow, wow."
    } ]
  }, {
    "tStartMs": 172710,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "Oh, oh."
    } ]
  }, {
    "tStartMs": 175521,
    "dDurationMs": 958,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 176479,
    "dDurationMs": 4091,
    "segs": [ {
      "utf8": "It is just really cool to\nsee such a big structure"
    } ]
  }, {
    "tStartMs": 180570,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "kind of moving that far and that fast."
    } ]
  }, {
    "tStartMs": 183360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 184950,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "The first test that I actually saw,"
    } ]
  }, {
    "tStartMs": 189030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "it was on the schedule\nand it said white noise."
    } ]
  }, {
    "tStartMs": 191700,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- So the white noise is just\nall different frequencies,"
    } ]
  }, {
    "tStartMs": 194880,
    "dDurationMs": 2864,
    "segs": [ {
      "utf8": "low frequencies, high frequencies,\neverything in between."
    } ]
  }, {
    "tStartMs": 197744,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 198577,
    "dDurationMs": 953,
    "segs": [ {
      "utf8": "They make this big deal."
    } ]
  }, {
    "tStartMs": 199530,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They're like, oh, one minute,"
    } ]
  }, {
    "tStartMs": 200970,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "like, and then they do like\nthe 10 second countdown."
    } ]
  }, {
    "tStartMs": 205655,
    "dDurationMs": 1588,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 209910,
    "dDurationMs": 3873,
    "segs": [ {
      "utf8": "And then it's just like\nfunctionally nothing."
    } ]
  }, {
    "tStartMs": 216300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "We flew all the way to\nJapan to to see this,"
    } ]
  }, {
    "tStartMs": 218880,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "so let's hope at least one wall falls down"
    } ]
  }, {
    "tStartMs": 223320,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "and I couldn't figure\nout why for a long time."
    } ]
  }, {
    "tStartMs": 227130,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- All the structure has natural frequency."
    } ]
  }, {
    "tStartMs": 230460,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "When the structure is damaged,"
    } ]
  }, {
    "tStartMs": 232860,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "natural frequency becomes shorter."
    } ]
  }, {
    "tStartMs": 235920,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So by inputting white noise\nwith components of wide range"
    } ]
  }, {
    "tStartMs": 240240,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "of frequency, so we can\nfind natural frequency"
    } ]
  }, {
    "tStartMs": 243810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "of building."
    } ]
  }, {
    "tStartMs": 246600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So first, input white noise fast,"
    } ]
  }, {
    "tStartMs": 248520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and after that input as quick motion,"
    } ]
  }, {
    "tStartMs": 251310,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and then we we usually\ninput another white noise"
    } ]
  }, {
    "tStartMs": 255030,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "so we can find a change\nof natural frequency."
    } ]
  }, {
    "tStartMs": 259650,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] At the center of E-Defense"
    } ]
  }, {
    "tStartMs": 261150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "is a 20 meter by 15 meter shake table,"
    } ]
  }, {
    "tStartMs": 263820,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "which weighs 800 tons."
    } ]
  }, {
    "tStartMs": 266430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "On each side there are\nfive hydraulic actuators,"
    } ]
  }, {
    "tStartMs": 268860,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which push the table side to side,"
    } ]
  }, {
    "tStartMs": 271020,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and the whole thing is supported"
    } ]
  }, {
    "tStartMs": 272370,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "by another 14 actuators at the bottom,"
    } ]
  }, {
    "tStartMs": 275070,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which moved the table up and down."
    } ]
  }, {
    "tStartMs": 277620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The whole facility is massive."
    } ]
  }, {
    "tStartMs": 280260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "There is one warehouse where\nthe shake table is housed,"
    } ]
  }, {
    "tStartMs": 283080,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but it's in such high demand"
    } ]
  }, {
    "tStartMs": 284790,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that all the buildings are constructed"
    } ]
  }, {
    "tStartMs": 286560,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "in a separate warehouse and\nthen transferred across."
    } ]
  }, {
    "tStartMs": 290070,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Then there is a whole\narea full of giant engines"
    } ]
  }, {
    "tStartMs": 293160,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and nitrogen storage tanks\njust to power the shake table."
    } ]
  }, {
    "tStartMs": 296580,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Petr] Oh my God."
    } ]
  }, {
    "tStartMs": 297413,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "This is a huge engine."
    } ]
  }, {
    "tStartMs": 299070,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- [Derek] Using this setup,"
    } ]
  }, {
    "tStartMs": 300000,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the scientists can perfectly simulate"
    } ]
  }, {
    "tStartMs": 301740,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "past earthquakes and determine"
    } ]
  }, {
    "tStartMs": 303120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "their effects on different buildings."
    } ]
  }, {
    "tStartMs": 305370,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "The shake table can hold\nmasses up to 1200 tons"
    } ]
  }, {
    "tStartMs": 309300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and jolt them with accelerations"
    } ]
  }, {
    "tStartMs": 310890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "up to 15 meters per second squared."
    } ]
  }, {
    "tStartMs": 313590,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "That's over one 1.5 gs."
    } ]
  }, {
    "tStartMs": 317730,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Now, I know jet fighters can\npull like 10 gs as they turn,"
    } ]
  }, {
    "tStartMs": 321480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but it's another story"
    } ]
  }, {
    "tStartMs": 322980,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "if you're in your house and\nthe floor starts accelerating"
    } ]
  }, {
    "tStartMs": 325620,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "faster than a falling object."
    } ]
  }, {
    "tStartMs": 329850,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The goal of the shake table"
    } ]
  }, {
    "tStartMs": 331170,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is to realistically simulate earthquakes."
    } ]
  }, {
    "tStartMs": 333810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "To do this, you need two things."
    } ]
  }, {
    "tStartMs": 336090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "A way of being able to apply enough force"
    } ]
  }, {
    "tStartMs": 338190,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "in a precise and controlled\nway, and the signal data"
    } ]
  }, {
    "tStartMs": 341580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "from real earthquakes."
    } ]
  }, {
    "tStartMs": 343680,
    "dDurationMs": 2113,
    "segs": [ {
      "utf8": "This is how they do it."
    } ]
  }, {
    "tStartMs": 345793,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "- Are you okay at high elevation place?"
    } ]
  }, {
    "tStartMs": 349380,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Let's see.\n(both laughing)"
    } ]
  }, {
    "tStartMs": 352230,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- This one is actuator."
    } ]
  }, {
    "tStartMs": 353640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- The actuators themselves are hydraulic."
    } ]
  }, {
    "tStartMs": 356280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Inside each one, there's a 30 ton piston"
    } ]
  }, {
    "tStartMs": 359130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "driven by high pressure oil."
    } ]
  }, {
    "tStartMs": 361380,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- This is massive."
    } ]
  }, {
    "tStartMs": 362940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is, I don't know, a meter,"
    } ]
  }, {
    "tStartMs": 364920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "meter and a half in diameter."
    } ]
  }, {
    "tStartMs": 367110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] But to generate\nthe pressure needed"
    } ]
  }, {
    "tStartMs": 368610,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to operate the shake table"
    } ]
  }, {
    "tStartMs": 370050,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and sustain it for minutes at a time,"
    } ]
  }, {
    "tStartMs": 372180,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "E-Defense needs huge\nreserves of pressure storage."
    } ]
  }, {
    "tStartMs": 375870,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "That's why there's a whole\nsection of the warehouse"
    } ]
  }, {
    "tStartMs": 377880,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "with massive high pressure\nstorage tanks full of nitrogen."
    } ]
  }, {
    "tStartMs": 381390,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- We have 20 of these lead\nspherical shaped accumulators,"
    } ]
  }, {
    "tStartMs": 388550,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "so we accumulate the pressure."
    } ]
  }, {
    "tStartMs": 391410,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- To pressurize these\ntanks liquid nitrogen"
    } ]
  }, {
    "tStartMs": 393750,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is pumped in from a large\nstorage tank outside,"
    } ]
  }, {
    "tStartMs": 396900,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and as that liquid warms\nup, it turns into a gas"
    } ]
  }, {
    "tStartMs": 399750,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and expands 694 times its original volume."
    } ]
  }, {
    "tStartMs": 404040,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's relatively easy"
    } ]
  }, {
    "tStartMs": 405300,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to obtain very high\npressures with nitrogen."
    } ]
  }, {
    "tStartMs": 408150,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Then when the pressure is needed,"
    } ]
  }, {
    "tStartMs": 409620,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "it's transferred to the oil\nusing a bunch of pistons."
    } ]
  }, {
    "tStartMs": 413250,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "As the test runs, the oil\nis pumped to the actuators"
    } ]
  }, {
    "tStartMs": 416250,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "by these giant engines,"
    } ]
  }, {
    "tStartMs": 418080,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but even they can't\nsustain the pressure needed"
    } ]
  }, {
    "tStartMs": 420150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to operate the shake table for very long."
    } ]
  }, {
    "tStartMs": 422490,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And so the nitrogen pressure reserves mean"
    } ]
  }, {
    "tStartMs": 424710,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "that the shake table can deliver"
    } ]
  }, {
    "tStartMs": 425880,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "a consistent amount of force"
    } ]
  }, {
    "tStartMs": 427530,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "from the start of the\ntest right to the end."
    } ]
  }, {
    "tStartMs": 431640,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "While a test is run, the\npressurized oil needs to be pumped"
    } ]
  }, {
    "tStartMs": 434970,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to the actuators by the engines."
    } ]
  }, {
    "tStartMs": 436950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "The flow to each actuator is controlled"
    } ]
  }, {
    "tStartMs": 439140,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "by electronic servo valves,\nmeaning precisely timed"
    } ]
  }, {
    "tStartMs": 442500,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and measured forces can be applied"
    } ]
  }, {
    "tStartMs": 444330,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to the table to match any earthquake."
    } ]
  }, {
    "tStartMs": 447210,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Now, because the actuators can\nonly move in one dimension,"
    } ]
  }, {
    "tStartMs": 450480,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "if they were fixed directly to the table,"
    } ]
  }, {
    "tStartMs": 452700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "there would be no flexibility\nand they would break."
    } ]
  }, {
    "tStartMs": 455460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And so the engineers at\nE-Defense designed bespoke"
    } ]
  }, {
    "tStartMs": 458280,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "seven meter long universal joints"
    } ]
  }, {
    "tStartMs": 460230,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to transfer the force from the\nactuators to the shake table."
    } ]
  }, {
    "tStartMs": 464430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "To simulate real earthquakes."
    } ]
  }, {
    "tStartMs": 466680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The shaking can't be random."
    } ]
  }, {
    "tStartMs": 468720,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I mean, each earthquake has its own"
    } ]
  }, {
    "tStartMs": 470370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "characteristic pattern of movement,"
    } ]
  }, {
    "tStartMs": 472320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "which can be recorded using a seismometer."
    } ]
  }, {
    "tStartMs": 475080,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Early seismometers were\nbasically just a pen attached"
    } ]
  }, {
    "tStartMs": 478140,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "to some springs, drawing a line\nover a moving roll of paper."
    } ]
  }, {
    "tStartMs": 482250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And when there was an\nearthquake, the pen would shake"
    } ]
  }, {
    "tStartMs": 484200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and draw out the pattern of\nacceleration of that earthquake."
    } ]
  }, {
    "tStartMs": 487560,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The trace that was seen on the paper"
    } ]
  }, {
    "tStartMs": 489390,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "is known as a seismograph."
    } ]
  }, {
    "tStartMs": 491940,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Nowadays we use geophones."
    } ]
  }, {
    "tStartMs": 494250,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "A geophone is made from\na coil of wire suspended"
    } ]
  }, {
    "tStartMs": 496740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "around a magnet all\nheld together by springs"
    } ]
  }, {
    "tStartMs": 499560,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "when the ground shakes, the springs shake,"
    } ]
  }, {
    "tStartMs": 501690,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "causing the wire to move up\nand down over the magnet,"
    } ]
  }, {
    "tStartMs": 504300,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "which generates a current."
    } ]
  }, {
    "tStartMs": 506040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This current is recorded\nto produce a seismograph"
    } ]
  }, {
    "tStartMs": 509160,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "to get the full picture"
    } ]
  }, {
    "tStartMs": 510090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of how the earth's surface\nmoves in all three dimensions,"
    } ]
  }, {
    "tStartMs": 512640,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "three geophones are needed,"
    } ]
  }, {
    "tStartMs": 514350,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "one oriented in each orthogonal direction."
    } ]
  }, {
    "tStartMs": 518580,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The strength of an earthquake is measured"
    } ]
  }, {
    "tStartMs": 520290,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "on the magnitude scale."
    } ]
  }, {
    "tStartMs": 521820,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "The smallest earthquake"
    } ]
  }, {
    "tStartMs": 522930,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that humans can feel is about\na billion times less powerful"
    } ]
  }, {
    "tStartMs": 526530,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "than the biggest earthquake ever recorded."
    } ]
  }, {
    "tStartMs": 529170,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Because of this, the magnitude\nscale is logarithmic."
    } ]
  }, {
    "tStartMs": 532260,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "An increase of one on the\nmagnitude scale represents"
    } ]
  }, {
    "tStartMs": 534840,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "a tenfold increase in the\nforce of the earthquake."
    } ]
  }, {
    "tStartMs": 539040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "An earthquake under 2.5\non the magnitude scale"
    } ]
  }, {
    "tStartMs": 541440,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is imperceptible to humans."
    } ]
  }, {
    "tStartMs": 543450,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "These happen millions of times every year,"
    } ]
  }, {
    "tStartMs": 545910,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but can only be detected by geophones."
    } ]
  }, {
    "tStartMs": 548640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Earthquakes higher than\nsix on the magnitude scale"
    } ]
  }, {
    "tStartMs": 551100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "can damage buildings, but\noccur far less frequently,"
    } ]
  }, {
    "tStartMs": 554280,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "only a few hundred times a year globally."
    } ]
  }, {
    "tStartMs": 558120,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The most powerful earthquake ever recorded"
    } ]
  }, {
    "tStartMs": 560100,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "was the great Chilean earthquake of 1960,"
    } ]
  }, {
    "tStartMs": 562650,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "which measured 9.5 on the magnitude scale."
    } ]
  }, {
    "tStartMs": 565980,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It killed somewhere\nbetween 1 and 6,000 people"
    } ]
  }, {
    "tStartMs": 568980,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "and caused more than 400 million\nUS dollars worth of damage."
    } ]
  }, {
    "tStartMs": 573450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But how destructive an earthquake is"
    } ]
  }, {
    "tStartMs": 575340,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "isn't just determined by the magnitude."
    } ]
  }, {
    "tStartMs": 577470,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "It also matters how\nclose the epicenter is."
    } ]
  }, {
    "tStartMs": 582390,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Behind me is what was until 2022"
    } ]
  }, {
    "tStartMs": 584580,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the world's longest suspension bridge."
    } ]
  }, {
    "tStartMs": 587070,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The Akashi Kaikyo Bridge connects Honshu,"
    } ]
  }, {
    "tStartMs": 589800,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the main island of Japan to Awaji Island"
    } ]
  }, {
    "tStartMs": 592830,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "nearly four kilometers away."
    } ]
  }, {
    "tStartMs": 595290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The center span the distance"
    } ]
  }, {
    "tStartMs": 597390,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "between the two towers is 1,990\nmeters and 80 centimeters."
    } ]
  }, {
    "tStartMs": 603540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I'm here because a few\nkilometers that way,"
    } ]
  }, {
    "tStartMs": 605670,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and 16 kilometers\nunderground was the epicenter"
    } ]
  }, {
    "tStartMs": 609330,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "for the Great Hanshin earthquake of 1995."
    } ]
  }, {
    "tStartMs": 613770,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "As the earthquake struck,"
    } ]
  }, {
    "tStartMs": 615030,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the bridge was still under construction."
    } ]
  }, {
    "tStartMs": 617820,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And despite being right\nabove the epicenter,"
    } ]
  }, {
    "tStartMs": 620310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "there was no major\ndamage to the structure."
    } ]
  }, {
    "tStartMs": 623310,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But the earth underneath\nthe bridge had moved,"
    } ]
  }, {
    "tStartMs": 626520,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and the original plans\nwould no longer work."
    } ]
  }, {
    "tStartMs": 629670,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The plans would need to be modified."
    } ]
  }, {
    "tStartMs": 632190,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So that's how the world's\nlongest suspension bridge"
    } ]
  }, {
    "tStartMs": 635520,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "became 80 centimeters longer."
    } ]
  }, {
    "tStartMs": 642420,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] After E-Defense opened in 2005,"
    } ]
  }, {
    "tStartMs": 644850,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "one of their first tests was a comparison"
    } ]
  }, {
    "tStartMs": 646830,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "between two traditional\nJapanese wooden houses."
    } ]
  }, {
    "tStartMs": 650070,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The houses were transported\nfrom the nearby city of Akashi."
    } ]
  }, {
    "tStartMs": 653850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "They were rebuilt on the table"
    } ]
  }, {
    "tStartMs": 655500,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "and shaken at the magnitude\nof the Kobe earthquake."
    } ]
  }, {
    "tStartMs": 665670,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "The house that stayed up"
    } ]
  }, {
    "tStartMs": 666780,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "had been retrofitted with wooden braces,"
    } ]
  }, {
    "tStartMs": 669030,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "beams, and metal joints making\nit more earthquake resistant."
    } ]
  }, {
    "tStartMs": 673050,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The other was unmodified."
    } ]
  }, {
    "tStartMs": 675780,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This test demonstrated\nthat older Japanese houses"
    } ]
  }, {
    "tStartMs": 678540,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "are not able to withstand\npowerful earthquakes."
    } ]
  }, {
    "tStartMs": 682260,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "It also presented a solution."
    } ]
  }, {
    "tStartMs": 685560,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Some relatively simple"
    } ]
  }, {
    "tStartMs": 686970,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and inexpensive structural reinforcement"
    } ]
  }, {
    "tStartMs": 688950,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "can significantly increase\nearthquake resistance."
    } ]
  }, {
    "tStartMs": 694560,
    "dDurationMs": 2247,
    "segs": [ {
      "utf8": "- In 1981, the Japanese\ngovernment introduces"
    } ]
  }, {
    "tStartMs": 696807,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "like all these new building\ncodes for new houses, right?"
    } ]
  }, {
    "tStartMs": 700560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And they're like, you need\nthis kind of seismic dampening,"
    } ]
  }, {
    "tStartMs": 702810,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "you need these isolation things."
    } ]
  }, {
    "tStartMs": 704100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You need these like wooden beams."
    } ]
  }, {
    "tStartMs": 705900,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "All of the buildings that\nwere built post 1981 in Kobe"
    } ]
  }, {
    "tStartMs": 712007,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "0.3% of them collapsed\nduring this earthquake."
    } ]
  }, {
    "tStartMs": 717030,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Of the ones that didn't, 8.4%,"
    } ]
  }, {
    "tStartMs": 720840,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "like about a 30 time difference"
    } ]
  }, {
    "tStartMs": 722310,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "between new houses and old houses, right?"
    } ]
  }, {
    "tStartMs": 732000,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "This is kind of like weird thing,"
    } ]
  }, {
    "tStartMs": 733290,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "like I was there on day one, you know,"
    } ]
  }, {
    "tStartMs": 736560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "watching like the shake table work,"
    } ]
  }, {
    "tStartMs": 738810,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and I'm just kind of like looking around"
    } ]
  }, {
    "tStartMs": 740880,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "this entire, like this giant warehouse,"
    } ]
  }, {
    "tStartMs": 742410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and I see this section\nwhere it's just like,"
    } ]
  }, {
    "tStartMs": 744870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "what looks like IKEA furniture?"
    } ]
  }, {
    "tStartMs": 747240,
    "dDurationMs": 2247,
    "segs": [ {
      "utf8": "Can you tell me what this is for?"
    } ]
  }, {
    "tStartMs": 749487,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "- To see the, you know, in room safety,"
    } ]
  }, {
    "tStartMs": 752490,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "yeah, we place lots of furniture\nin the structured specimen."
    } ]
  }, {
    "tStartMs": 757030,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- A lot of the injuries, right,"
    } ]
  }, {
    "tStartMs": 759630,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that happen in earthquakes\nis from stuff falling"
    } ]
  }, {
    "tStartMs": 762390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "on top of you."
    } ]
  }, {
    "tStartMs": 767460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "A cabinet falling over\nand hitting your head,"
    } ]
  }, {
    "tStartMs": 770040,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "or, you know, you being crushed"
    } ]
  }, {
    "tStartMs": 771390,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "by a fridge or something like that."
    } ]
  }, {
    "tStartMs": 774240,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Half of the injuries that were sustained"
    } ]
  }, {
    "tStartMs": 777510,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "indoors in Kobe were from,"
    } ]
  }, {
    "tStartMs": 779070,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you know, furniture\nfalling on top of people."
    } ]
  }, {
    "tStartMs": 781410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So one of the things that\nE-Defenses does is like,"
    } ]
  }, {
    "tStartMs": 783870,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "how do you make sure\nbuildings don't collapse,"
    } ]
  }, {
    "tStartMs": 785190,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "but it's also how do you make sure"
    } ]
  }, {
    "tStartMs": 786240,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "that the insides of the\nbuildings are also safe?"
    } ]
  }, {
    "tStartMs": 794460,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- This part of the video was\nbrought to you by Shopify."
    } ]
  }, {
    "tStartMs": 796770,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "You know, back in 2015,\nI came up with Snatoms,"
    } ]
  }, {
    "tStartMs": 799980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "a better way of modeling molecules,"
    } ]
  }, {
    "tStartMs": 801870,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and I've been using Shopify\nto sell Snatoms ever since."
    } ]
  }, {
    "tStartMs": 805230,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And over those last eight years,"
    } ]
  }, {
    "tStartMs": 806910,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I found Shopify really easy to work with."
    } ]
  }, {
    "tStartMs": 809610,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They offer an all-in-one commerce platform"
    } ]
  }, {
    "tStartMs": 811860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that anyone can use to sell\nproducts, manage inventory,"
    } ]
  }, {
    "tStartMs": 814800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "or grow their business."
    } ]
  }, {
    "tStartMs": 816300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "One of my favorite things about Shopify"
    } ]
  }, {
    "tStartMs": 817920,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "is the depth of data that they provide."
    } ]
  }, {
    "tStartMs": 820170,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "You can see real-time data"
    } ]
  }, {
    "tStartMs": 822180,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "on how many people are on\nyour site at any given time"
    } ]
  }, {
    "tStartMs": 825360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and how many are checking out."
    } ]
  }, {
    "tStartMs": 827550,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Plus, from the analytics,"
    } ]
  }, {
    "tStartMs": 828660,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I can learn which products\nare selling and when."
    } ]
  }, {
    "tStartMs": 831540,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "There are more than\n8,000 easy-to-use apps,"
    } ]
  }, {
    "tStartMs": 834330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "which help with ad tracking,"
    } ]
  }, {
    "tStartMs": 835830,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "integrating your shop\nwith TikTok or Pinterest,"
    } ]
  }, {
    "tStartMs": 838740,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "or automatically recommending\nfrequently bought products."
    } ]
  }, {
    "tStartMs": 841890,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Despite it being so powerful,"
    } ]
  }, {
    "tStartMs": 844020,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Shopify is incredibly easy to use."
    } ]
  }, {
    "tStartMs": 846960,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So if you are just\nstarting out your business"
    } ]
  }, {
    "tStartMs": 849060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "or side hustle, or if you\nwanna make the sales process"
    } ]
  }, {
    "tStartMs": 851790,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "more efficient, you really\nshould be using Shopify."
    } ]
  }, {
    "tStartMs": 854640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "They power more entrepreneurs\nthan any other platform"
    } ]
  }, {
    "tStartMs": 857640,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "with millions of businesses\nin 175 countries."
    } ]
  }, {
    "tStartMs": 861240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Seriously, Shopify is great,"
    } ]
  }, {
    "tStartMs": 863430,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "and for a free trial, you can\ngo to shopify.com/veritasium"
    } ]
  }, {
    "tStartMs": 867570,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "or just scan this QR code."
    } ]
  }, {
    "tStartMs": 870330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And if you wanna buy a Snatoms kit,"
    } ]
  }, {
    "tStartMs": 872070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "there is a link for that\nin the description too."
    } ]
  }, {
    "tStartMs": 874830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So I wanna thank Shopify"
    } ]
  }, {
    "tStartMs": 876060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "for sponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 877440,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "and now back to earthquakes."
    } ]
  }, {
    "tStartMs": 880950,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- So for this next test,"
    } ]
  }, {
    "tStartMs": 882960,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "they're gonna feed in the seismic signals"
    } ]
  }, {
    "tStartMs": 885570,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "from the Great Hanshin earthquake"
    } ]
  }, {
    "tStartMs": 887790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which is also known as\nthe Kobe earthquake."
    } ]
  }, {
    "tStartMs": 889950,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It only lasted for about 20 seconds,"
    } ]
  }, {
    "tStartMs": 892770,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but it had a magnitude of 6.9,"
    } ]
  }, {
    "tStartMs": 894720,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and the maximum acceleration\nwas about 0.9 g,"
    } ]
  }, {
    "tStartMs": 898560,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "which is, you know, kind\nof crazy to think about"
    } ]
  }, {
    "tStartMs": 900510,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "for an earthquake."
    } ]
  }, {
    "tStartMs": 912510,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 915090,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "Like, that rumble."
    } ]
  }, {
    "tStartMs": 918750,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh man."
    } ]
  }, {
    "tStartMs": 921600,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Oh, the whole building is,"
    } ]
  }, {
    "tStartMs": 924030,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "oh my God."
    } ]
  }, {
    "tStartMs": 941100,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "How short that was and\nhow powerful that was."
    } ]
  }, {
    "tStartMs": 944430,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Boy, earthquakes are no joke."
    } ]
  }, {
    "tStartMs": 947490,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- That's a nice way to\nobserve an earthquake."
    } ]
  }, {
    "tStartMs": 949770,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Like how else can you\nobserve an earthquake"
    } ]
  }, {
    "tStartMs": 951570,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "without being subject\nto that shaking, right?"
    } ]
  }, {
    "tStartMs": 954090,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "No one has got to experience\nthe Kobe earthquake"
    } ]
  }, {
    "tStartMs": 956310,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "from like just right\nbeside it, but not shaking."
    } ]
  }, {
    "tStartMs": 960180,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- In Kobe earthquake, we\nrecorded very, very large motion,"
    } ]
  }, {
    "tStartMs": 965619,
    "dDurationMs": 1044,
    "segs": [ {
      "utf8": "but it's very short."
    } ]
  }, {
    "tStartMs": 966663,
    "dDurationMs": 2337,
    "segs": [ {
      "utf8": "But in 2011 in Japan earthquake,"
    } ]
  }, {
    "tStartMs": 969000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "we recorded very, very\nlong duration motion,"
    } ]
  }, {
    "tStartMs": 972120,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "like five minutes."
    } ]
  }, {
    "tStartMs": 973500,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And the bottom one,\nit's expected earthquake"
    } ]
  }, {
    "tStartMs": 978180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "in future Tokai Tonankai earthquake."
    } ]
  }, {
    "tStartMs": 980700,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "So we are expecting very,\nvery long duration motion."
    } ]
  }, {
    "tStartMs": 984450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Petr] How do you predict"
    } ]
  }, {
    "tStartMs": 985650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "what kind of earthquake\nyou're going to get"
    } ]
  }, {
    "tStartMs": 987930,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Ask seismologists."
    } ]
  }, {
    "tStartMs": 989190,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Petr] I'll ask seismologists."
    } ]
  }, {
    "tStartMs": 990300,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- I'm sorry about that.\n- No, that's good."
    } ]
  }, {
    "tStartMs": 991950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "That's good."
    } ]
  }, {
    "tStartMs": 993330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Seismologists give a 70% chance"
    } ]
  }, {
    "tStartMs": 995580,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that a magnitude eight\nearthquake will occur"
    } ]
  }, {
    "tStartMs": 997800,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "somewhere near the Tokai region,"
    } ]
  }, {
    "tStartMs": 999690,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "home to more than 15 million people"
    } ]
  }, {
    "tStartMs": 1002090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "within the next 30 years."
    } ]
  }, {
    "tStartMs": 1003890,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The Nankai trough located off\nthe southeast coast of Japan"
    } ]
  }, {
    "tStartMs": 1007400,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is where the Eurasian plate pushes"
    } ]
  }, {
    "tStartMs": 1009140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "against the Philippine plate and produces"
    } ]
  }, {
    "tStartMs": 1011120,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "a massive earthquake\nevery 100 years or so."
    } ]
  }, {
    "tStartMs": 1014270,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But the Tokai region hasn't experienced"
    } ]
  }, {
    "tStartMs": 1016220,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "such an earthquake in over 160 years."
    } ]
  }, {
    "tStartMs": 1019850,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "The government estimates"
    } ]
  }, {
    "tStartMs": 1020870,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "that more than 320,000 people\ncould lose their lives."
    } ]
  }, {
    "tStartMs": 1024890,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Most fatalities will likely be caused"
    } ]
  }, {
    "tStartMs": 1026660,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "by the 30 meter tsunami,"
    } ]
  }, {
    "tStartMs": 1028400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but a quarter, around 82,000,"
    } ]
  }, {
    "tStartMs": 1030680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "could result from building collapse."
    } ]
  }, {
    "tStartMs": 1033260,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "This is why earthquake\npreparedness is such a big deal."
    } ]
  }, {
    "tStartMs": 1040340,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "- Newly built buildings\nare very, very safe."
    } ]
  }, {
    "tStartMs": 1043969,
    "dDurationMs": 4501,
    "segs": [ {
      "utf8": "You know, they, they have\nvery high seismic performance."
    } ]
  }, {
    "tStartMs": 1048470,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "So even in a very, very large earthquake,"
    } ]
  }, {
    "tStartMs": 1053210,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you know, these buildings can survive."
    } ]
  }, {
    "tStartMs": 1055610,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] Except in extreme cases,"
    } ]
  }, {
    "tStartMs": 1057110,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "most new buildings in Japan can survive"
    } ]
  }, {
    "tStartMs": 1059210,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "most large earthquakes."
    } ]
  }, {
    "tStartMs": 1060710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So the next challenge is\nto keep them functional."
    } ]
  }, {
    "tStartMs": 1063320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Currently, even when\nbuildings don't collapse,"
    } ]
  }, {
    "tStartMs": 1065510,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "water pipes often burst leaving people"
    } ]
  }, {
    "tStartMs": 1067580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "without water and electricity,"
    } ]
  }, {
    "tStartMs": 1069380,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and so they still have\nto leave their homes."
    } ]
  }, {
    "tStartMs": 1071780,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "This is the next challenge"
    } ]
  }, {
    "tStartMs": 1073130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "they're trying to solve at E-Defense."
    } ]
  }, {
    "tStartMs": 1075470,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- So now we can prevent a fatal collapse,"
    } ]
  }, {
    "tStartMs": 1078440,
    "dDurationMs": 2988,
    "segs": [ {
      "utf8": "but now we have to think how to prevent"
    } ]
  }, {
    "tStartMs": 1081428,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "this kind of functional loss."
    } ]
  }, {
    "tStartMs": 1083990,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Petr] You guys are now at the step"
    } ]
  }, {
    "tStartMs": 1085400,
    "dDurationMs": 1747,
    "segs": [ {
      "utf8": "that's beyond what I was thinking, right?"
    } ]
  }, {
    "tStartMs": 1087147,
    "dDurationMs": 2393,
    "segs": [ {
      "utf8": "My step was like, how do we make sure"
    } ]
  }, {
    "tStartMs": 1089540,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that houses don't fall down"
    } ]
  }, {
    "tStartMs": 1090980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and you guys are like, yeah,\nno, we figured that out."
    } ]
  }, {
    "tStartMs": 1092990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We can make sure that\nhouses don't fall down"
    } ]
  }, {
    "tStartMs": 1095030,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "more or less."
    } ]
  }, {
    "tStartMs": 1096410,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Doing this very important work"
    } ]
  }, {
    "tStartMs": 1097730,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "like you guys are making\nthe world a safer place."
    } ]
  }, {
    "tStartMs": 1100580,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "You guys are making Japan a safer place."
    } ]
  }, {
    "tStartMs": 1102170,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "You're updating building codes to make it,"
    } ]
  }, {
    "tStartMs": 1104390,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you know, so fewer people die."
    } ]
  }, {
    "tStartMs": 1106130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- What I love about the story of E-Defense"
    } ]
  }, {
    "tStartMs": 1108500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "is that Japan didn't simply\nwait for more earthquakes"
    } ]
  }, {
    "tStartMs": 1111200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to happen and just hope for the best."
    } ]
  }, {
    "tStartMs": 1113330,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They spent billions in research"
    } ]
  }, {
    "tStartMs": 1115310,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to prevent people suffering\nfrom these disasters."
    } ]
  }, {
    "tStartMs": 1118430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "They realize that while they can't predict"
    } ]
  }, {
    "tStartMs": 1120620,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the next big earthquake,\nthey can make sure"
    } ]
  }, {
    "tStartMs": 1123170,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "that they are prepared\nwhen it does happen."
    } ]
  } ]
}
