  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "How long does it take for the Earth to go around the sun?"
    } ]
  }, {
    "tStartMs": 5040,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Well, a day."
    } ]
  }, {
    "tStartMs": 8180,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "\"Well--\" Yeah? \"Twenty-four hours.\" Twenty four hours?"
    } ]
  }, {
    "tStartMs": 11820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What do you reckon, cuz?"
    } ]
  }, {
    "tStartMs": 14140,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Isn't it twenty four hours?"
    } ]
  }, {
    "tStartMs": 15680,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Obviously a day, yes."
    } ]
  }, {
    "tStartMs": 17260,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "A day, I hope."
    } ]
  }, {
    "tStartMs": 19440,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "I know it takes, uh, ninety minutes for the space station to go around the earth"
    } ]
  }, {
    "tStartMs": 25060,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Three-hundred and sixty days."
    } ]
  }, {
    "tStartMs": 26740,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "No, one day. Is it one day?"
    } ]
  }, {
    "tStartMs": 30280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I don't know. What is it?"
    } ]
  }, {
    "tStartMs": 36100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I say one year."
    } ]
  }, {
    "tStartMs": 37500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "I dunno, like a year."
    } ]
  }, {
    "tStartMs": 38400,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "Uh, a year."
    } ]
  }, {
    "tStartMs": 39180,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "One year."
    } ]
  }, {
    "tStartMs": 40180,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Twelve months."
    } ]
  }, {
    "tStartMs": 41480,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Twelve months?"
    } ]
  }, {
    "tStartMs": 42160,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "Three-hundred and sixty five"
    } ]
  }, {
    "tStartMs": 43400,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Three-hundred and sixty-five"
    } ]
  }, {
    "tStartMs": 44540,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Three-hundred and sixty-five"
    } ]
  }, {
    "tStartMs": 45180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Three-hundred and sixty-five"
    } ]
  }, {
    "tStartMs": 46380,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Three-hundred and sixty five days?"
    } ]
  }, {
    "tStartMs": 49840,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yeah, I'd agree with that"
    } ]
  }, {
    "tStartMs": 50340,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Three-sixty five."
    } ]
  }, {
    "tStartMs": 50940,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It's somewhere between that, it's not quite precise, is it?"
