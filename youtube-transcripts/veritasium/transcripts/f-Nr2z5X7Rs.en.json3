{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Finding scorpions in the desert at night"
    } ]
  }, {
    "tStartMs": 2250,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "is surprisingly easy."
    } ]
  }, {
    "tStartMs": 4040,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "All you need is an ultraviolet torch"
    } ]
  }, {
    "tStartMs": 6670,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "because scorpions are\nincredibly fluorescent."
    } ]
  }, {
    "tStartMs": 10190,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "Fluorescence means their\nbodies absorb ultraviolet light"
    } ]
  }, {
    "tStartMs": 13260,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "and reradiate it in the\nvisible part of the spectrum."
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "They glow this bright neon green color."
    } ]
  }, {
    "tStartMs": 19210,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "But scorpions aren't the\nonly animals that fluoresce."
    } ]
  }, {
    "tStartMs": 22290,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "Jellyfish, amphibians,\nowls, and even platypus'"
    } ]
  }, {
    "tStartMs": 25940,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "glow under ultraviolet light."
    } ]
  }, {
    "tStartMs": 28390,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Part of this video is sponsored\nby Capital One Shopping."
    } ]
  }, {
    "tStartMs": 30950,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "More about them at the end of the show."
    } ]
  }, {
    "tStartMs": 34640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I'm out here in the desert\nnear Bakersfield, California,"
    } ]
  }, {
    "tStartMs": 37520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "looking for scorpions with Carl Kloock,"
    } ]
  }, {
    "tStartMs": 39760,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "a professor of biology\nat Cal State Bakersfield."
    } ]
  }, {
    "tStartMs": 43080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "He's been researching\nscorpion fluorescence"
    } ]
  }, {
    "tStartMs": 45180,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "for over a decade."
    } ]
  }, {
    "tStartMs": 47010,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- If you have a black light\nit's really pretty easy."
    } ]
  }, {
    "tStartMs": 48710,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If they're there, you're\ngoing to spot them."
    } ]
  }, {
    "tStartMs": 50450,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "- [Derek] Does he look\nlike he's in a posture"
    } ]
  }, {
    "tStartMs": 52360,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "to like defend himself?"
    } ]
  }, {
    "tStartMs": 54210,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- [Carl] Yeah, he's not real happy."
    } ]
  }, {
    "tStartMs": 55660,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "- [Derek] Okay."
    } ]
  }, {
    "tStartMs": 56600,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "(man chuckling)"
    } ]
  }, {
    "tStartMs": 57470,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "- [Carl] I'm going to grab my high-tech"
    } ]
  }, {
    "tStartMs": 58440,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "scorpion catching equipment here."
    } ]
  }, {
    "tStartMs": 60530,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It's a tongue depressor with\na yellow highlighter on it."
    } ]
  }, {
    "tStartMs": 62810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So it fluoresces in black light.\nSo you can see where it is."
    } ]
  }, {
    "tStartMs": 65420,
    "dDurationMs": 895,
    "segs": [ {
      "utf8": "- [Derek] Got it."
    } ]
  }, {
    "tStartMs": 66315,
    "dDurationMs": 1405,
    "segs": [ {
      "utf8": "(man chuckling)"
    } ]
  }, {
    "tStartMs": 67720,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "- [Carl] This technique is usually to put"
    } ]
  }, {
    "tStartMs": 69170,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "the vial behind him,"
    } ]
  }, {
    "tStartMs": 72804,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "then in front of him."
    } ]
  }, {
    "tStartMs": 74913,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "- [Derek] That was impressive."
    } ]
  }, {
    "tStartMs": 76810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "All right. Should we give it a shot?"
    } ]
  }, {
    "tStartMs": 84000,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "- [Carl] Just gently pokes him back in."
    } ]
  }, {
    "tStartMs": 86420,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "And they usually just kind of do a little"
    } ]
  }, {
    "tStartMs": 87410,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "side crab walk back."
    } ]
  }, {
    "tStartMs": 89680,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "There you go, and just tilt it up."
    } ]
  }, {
    "tStartMs": 92750,
    "dDurationMs": 1487,
    "segs": [ {
      "utf8": "- [Derek] Unbelievable."
    } ]
  }, {
    "tStartMs": 94237,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(man chuckles)"
    } ]
  }, {
    "tStartMs": 95070,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Unbelievable."
    } ]
  }, {
    "tStartMs": 96270,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "All right. I'm going to get him."
    } ]
  }, {
    "tStartMs": 98300,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "But why are scorpions fluorescent?"
    } ]
  }, {
    "tStartMs": 100770,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "- I've got about 12 hypotheses."
    } ]
  }, {
    "tStartMs": 102310,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "So you test them one at a time."
    } ]
  }, {
    "tStartMs": 104360,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "- [Derek] You've got\n12 Hypotheses about why"
    } ]
  }, {
    "tStartMs": 105930,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "the scorpions fluoresce?"
    } ]
  }, {
    "tStartMs": 107180,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "- More like six actually,\nI was being a little bit..."
    } ]
  }, {
    "tStartMs": 109570,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Almost all scorpions fluoresce."
    } ]
  }, {
    "tStartMs": 111880,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I haven't seen it myself,"
    } ]
  }, {
    "tStartMs": 112990,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "but some that live at living\ncaves they don't fluoresce"
    } ]
  }, {
    "tStartMs": 116400,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "but it's only like one very small group."
    } ]
  }, {
    "tStartMs": 118150,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "All the other scorpions fluoresce."
    } ]
  }, {
    "tStartMs": 120480,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "One possibility is just,\nthis is a Relic Trait."
    } ]
  }, {
    "tStartMs": 123230,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "It's something they developed way back"
    } ]
  }, {
    "tStartMs": 124680,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "when they first came out on\nland and just haven't lost."
    } ]
  }, {
    "tStartMs": 128160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "A chemical that has another function"
    } ]
  }, {
    "tStartMs": 130240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that just happens to fluoresce."
    } ]
  }, {
    "tStartMs": 132000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "There are plenty of\nchemicals that fluoresce."
    } ]
  }, {
    "tStartMs": 133920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I mean, we have internal\nbodily fluids that fluoresce."
    } ]
  }, {
    "tStartMs": 137400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And clearly those are\nnever exposed to UV light."
    } ]
  }, {
    "tStartMs": 139320,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "So the idea of having a function"
    } ]
  }, {
    "tStartMs": 140630,
    "dDurationMs": 2225,
    "segs": [ {
      "utf8": "for that fluorescence is kind of silly."
    } ]
  }, {
    "tStartMs": 142855,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "This fluoresce is about the\nsame color as a scorpion,"
    } ]
  }, {
    "tStartMs": 144610,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "but clearly isn't a scorpion."
    } ]
  }, {
    "tStartMs": 146060,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "It's actually a rock."
    } ]
  }, {
    "tStartMs": 147280,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "The color is a little off."
    } ]
  }, {
    "tStartMs": 150080,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "- [Derek] But that is like, what is that?"
    } ]
  }, {
    "tStartMs": 152260,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- It's plastic from Walpole."
    } ]
  }, {
    "tStartMs": 154390,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "- [Derek] Huh."
    } ]
  }, {
    "tStartMs": 155250,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "You anted to know if the\nscorpions were fluorescing"
    } ]
  }, {
    "tStartMs": 157810,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "in order to attract insects."
    } ]
  }, {
    "tStartMs": 160020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 160853,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] So how did you test that?"
    } ]
  }, {
    "tStartMs": 161686,
    "dDurationMs": 2714,
    "segs": [ {
      "utf8": "- What I did was I used preserved\nscorpions like these ones"
    } ]
  }, {
    "tStartMs": 164400,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "and I took half of them and dip them in"
    } ]
  }, {
    "tStartMs": 167510,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "UV blocking marine varnish\nso they didn't fluoresce."
    } ]
  }, {
    "tStartMs": 170370,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "And then I just used basically flypaper"
    } ]
  }, {
    "tStartMs": 173070,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "and took those things outside\nand set them side by side"
    } ]
  }, {
    "tStartMs": 175730,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and then found the\nnumber of flying insects"
    } ]
  }, {
    "tStartMs": 178910,
    "dDurationMs": 1944,
    "segs": [ {
      "utf8": "that were caught in each."
    } ]
  }, {
    "tStartMs": 180854,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Okay."
    } ]
  }, {
    "tStartMs": 181687,
    "dDurationMs": 1643,
    "segs": [ {
      "utf8": "- [Carl] So we were outside in moonlight"
    } ]
  }, {
    "tStartMs": 183330,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and I did the same experiment,"
    } ]
  }, {
    "tStartMs": 184870,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "both under the new moon and the full moon."
    } ]
  }, {
    "tStartMs": 186860,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "And so what I found from that was"
    } ]
  }, {
    "tStartMs": 188400,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "when there was a new moon,"
    } ]
  }, {
    "tStartMs": 189730,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "there was no difference in the number"
    } ]
  }, {
    "tStartMs": 191000,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of insects caught by the fluorescent"
    } ]
  }, {
    "tStartMs": 192590,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "and non-fluorescent scorpions."
    } ]
  }, {
    "tStartMs": 193860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "But under the full moon,\nthere's nice, bright UV light"
    } ]
  }, {
    "tStartMs": 196400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "available there was a difference"
    } ]
  }, {
    "tStartMs": 197840,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "and the ones that fluoresce\nactually caught fewer insects."
    } ]
  }, {
    "tStartMs": 200970,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "- It seems kind of counterintuitive."
    } ]
  }, {
    "tStartMs": 202480,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- So that tells me that\nmy hypothesis was wrong."
    } ]
  }, {
    "tStartMs": 204910,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Which happens a lot."
    } ]
  }, {
    "tStartMs": 206290,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Basically yeah, they're not using"
    } ]
  }, {
    "tStartMs": 207950,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "their fluorescence to lure insects."
    } ]
  }, {
    "tStartMs": 209550,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "In fact, the fluorescence is\na bad thing for them in terms"
    } ]
  }, {
    "tStartMs": 211880,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "of their ability to catch\nflying insects, at least."
    } ]
  }, {
    "tStartMs": 215130,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Let me ask you this."
    } ]
  }, {
    "tStartMs": 216300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "If you find that fluorescence\nis counterproductive"
    } ]
  }, {
    "tStartMs": 219240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "for the scorpion in some way,"
    } ]
  }, {
    "tStartMs": 221080,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "doesn't that indicate that there"
    } ]
  }, {
    "tStartMs": 222250,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "has to be something useful?"
    } ]
  }, {
    "tStartMs": 224210,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- Exactly. There must be\nsomething that counteracts that."
    } ]
  }, {
    "tStartMs": 227000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Sort of negative."
    } ]
  }, {
    "tStartMs": 227833,
    "dDurationMs": 1017,
    "segs": [ {
      "utf8": "- That negative, yeah."
    } ]
  }, {
    "tStartMs": 228850,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Scorpions are really well\nadapted for what they do."
    } ]
  }, {
    "tStartMs": 231390,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "One of the cool things\nhere is it scorpions"
    } ]
  }, {
    "tStartMs": 234130,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "are actually able to\nmetabolize iron and nickel."
    } ]
  }, {
    "tStartMs": 239030,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "And in their pincer here"
    } ]
  }, {
    "tStartMs": 242610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and on the tips of their claws,"
    } ]
  }, {
    "tStartMs": 244020,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "they actually have basically\niron to strengthen that."
    } ]
  }, {
    "tStartMs": 247323,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "- [Derek] Iron and nickel\nat the end of their tail?"
    } ]
  }, {
    "tStartMs": 250410,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- [Carl] Yeah. Yeah."
    } ]
  }, {
    "tStartMs": 251690,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "You can see like the color\nhere's a little bit different"
    } ]
  }, {
    "tStartMs": 253980,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "and that's because of the iron."
    } ]
  }, {
    "tStartMs": 256210,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "- [Derek] That seems\nvery aggressive to me."
    } ]
  }, {
    "tStartMs": 259140,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "One of the main things\nwe're interested in here"
    } ]
  }, {
    "tStartMs": 260820,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "is how they see."
    } ]
  }, {
    "tStartMs": 261940,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So I've seen two of their eyes."
    } ]
  }, {
    "tStartMs": 264010,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- [Carl] So, those are the\nmedian eyes right there."
    } ]
  }, {
    "tStartMs": 266970,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "- [Derek] Those two dark spots."
    } ]
  }, {
    "tStartMs": 268220,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "- [Carl] Yeah. There's a cluster\nof three eyes right there."
    } ]
  }, {
    "tStartMs": 270070,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "And of course on the other\nside, so they're symmetrical."
    } ]
  }, {
    "tStartMs": 272210,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "So they have a total of eight eyes."
    } ]
  }, {
    "tStartMs": 273940,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "- Can they detect the light\nwith parts of their body"
    } ]
  }, {
    "tStartMs": 276990,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that are not eyes?"
    } ]
  }, {
    "tStartMs": 278400,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- Yeah. Actually they can."
    } ]
  }, {
    "tStartMs": 280330,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- [Derek] In a 1968 experiment,"
    } ]
  }, {
    "tStartMs": 282170,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "researchers put scorpions in\nhalf covered Petri dishes."
    } ]
  }, {
    "tStartMs": 285780,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Then they exposed them to bright\nlight and all the scorpions"
    } ]
  }, {
    "tStartMs": 289180,
    "dDurationMs": 2835,
    "segs": [ {
      "utf8": "quickly hid under the covered\npart of the Petri dish."
    } ]
  }, {
    "tStartMs": 292015,
    "dDurationMs": 3975,
    "segs": [ {
      "utf8": "Then the researchers painted\nover the eyes of the scorpions."
    } ]
  }, {
    "tStartMs": 295990,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "So they couldn't see and\nrepeated the experiment."
    } ]
  }, {
    "tStartMs": 299490,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But when they turned on\nthe light, 93% of the time,"
    } ]
  }, {
    "tStartMs": 302940,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "the blinded scorpions still scuttled over"
    } ]
  }, {
    "tStartMs": 305630,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "to the covered side."
    } ]
  }, {
    "tStartMs": 307260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The finding was remarkable."
    } ]
  }, {
    "tStartMs": 309510,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "Scorpions don't need their\neyes to detect light."
    } ]
  }, {
    "tStartMs": 312220,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "They can sense it with their bodies."
    } ]
  }, {
    "tStartMs": 314420,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- That showed that they have what's called"
    } ]
  }, {
    "tStartMs": 315640,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "an extra ocular light sense in their tail."
    } ]
  }, {
    "tStartMs": 318430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So they can detect light with their tail."
    } ]
  }, {
    "tStartMs": 320620,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "They can't form images, they can't,"
    } ]
  }, {
    "tStartMs": 321960,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "but they can detect light."
    } ]
  }, {
    "tStartMs": 323680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "- The tail of a scorpion can detect light?"
    } ]
  }, {
    "tStartMs": 326720,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "- One hypothesis is that they use it"
    } ]
  }, {
    "tStartMs": 328500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "to communicate with one another."
    } ]
  }, {
    "tStartMs": 331555,
    "dDurationMs": 2065,
    "segs": [ {
      "utf8": "The idea being that\nthey use it to determine"
    } ]
  }, {
    "tStartMs": 333620,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "primarily whether or not"
    } ]
  }, {
    "tStartMs": 335350,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "another scorpion out there"
    } ]
  }, {
    "tStartMs": 336870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "is of the same species for mating."
    } ]
  }, {
    "tStartMs": 339240,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "One fairly low probability hypothesis"
    } ]
  }, {
    "tStartMs": 341930,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "is that they can use it as camouflage"
    } ]
  }, {
    "tStartMs": 344380,
    "dDurationMs": 2617,
    "segs": [ {
      "utf8": "because they absorb UV light."
    } ]
  }, {
    "tStartMs": 346997,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "If they're sitting on another\nsurface that absorbs UV light"
    } ]
  }, {
    "tStartMs": 349800,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "and you have an organism\nthat sees in the UV light"
    } ]
  }, {
    "tStartMs": 351610,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "like some owls and\nthings like that can do,"
    } ]
  }, {
    "tStartMs": 353960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "they would tend to blend\nin very nicely with that."
    } ]
  }, {
    "tStartMs": 356390,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "So it's a possibility,"
    } ]
  }, {
    "tStartMs": 358140,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "but not that many organisms see in UV"
    } ]
  }, {
    "tStartMs": 361070,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "and not that many that\neat scorpion, see in UV"
    } ]
  }, {
    "tStartMs": 363810,
    "dDurationMs": 1643,
    "segs": [ {
      "utf8": "so it doesn't seem very likely."
    } ]
  }, {
    "tStartMs": 369170,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Derek] You go for it."
    } ]
  }, {
    "tStartMs": 370400,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Carl] You want me to do it upclose?"
    } ]
  }, {
    "tStartMs": 371233,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] You do it."
    } ]
  }, {
    "tStartMs": 372066,
    "dDurationMs": 1024,
    "segs": [ {
      "utf8": "- [Carl] Close."
    } ]
  }, {
    "tStartMs": 373090,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Here you go. See?"
    } ]
  }, {
    "tStartMs": 374800,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "There you go, wow."
    } ]
  }, {
    "tStartMs": 376910,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- One of the ideas is\nscorpions came out of the water"
    } ]
  }, {
    "tStartMs": 379590,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "from Silurian period long time ago."
    } ]
  }, {
    "tStartMs": 382160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And there was a lot\nmore UV just in sunlight"
    } ]
  }, {
    "tStartMs": 385360,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "and things like that then,\nbecause we didn't have"
    } ]
  }, {
    "tStartMs": 386790,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "an ozone layer, we didn't have, you know,"
    } ]
  }, {
    "tStartMs": 388010,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "all these things that are\nblocking UV in our atmosphere now."
    } ]
  }, {
    "tStartMs": 390190,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "And so the one of the idea is that"
    } ]
  }, {
    "tStartMs": 391740,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "it actually acts as a sunscreen."
    } ]
  }, {
    "tStartMs": 393460,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "It's way to absorb those\ndamaging ultraviolet photons"
    } ]
  }, {
    "tStartMs": 398132,
    "dDurationMs": 2728,
    "segs": [ {
      "utf8": "and convert them away into something"
    } ]
  }, {
    "tStartMs": 400860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and basically keep them from\npenetrating into the body"
    } ]
  }, {
    "tStartMs": 403140,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and causing damage."
    } ]
  }, {
    "tStartMs": 405220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "- [Derek] Go in your hole."
    } ]
  }, {
    "tStartMs": 407732,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "There you go."
    } ]
  }, {
    "tStartMs": 410140,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You got him."
    } ]
  }, {
    "tStartMs": 410973,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "- And then there have been some other ones"
    } ]
  }, {
    "tStartMs": 412840,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that are a little bit more out there."
    } ]
  }, {
    "tStartMs": 414400,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "One of which being the one that I actually"
    } ]
  }, {
    "tStartMs": 416877,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "settled on at the end is that they use it"
    } ]
  }, {
    "tStartMs": 419120,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "as part of their sensory\nsystem to detect the presence"
    } ]
  }, {
    "tStartMs": 421350,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "of light in the environment."
    } ]
  }, {
    "tStartMs": 423250,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "So this was the later\nexperiment after I gave up"
    } ]
  }, {
    "tStartMs": 424980,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "on the initial idea that\nsaid that didn't work."
    } ]
  }, {
    "tStartMs": 428010,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "So, all I really did in\nthat one, very simple,"
    } ]
  }, {
    "tStartMs": 430520,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "put a scorpion in each\none of these things here"
    } ]
  }, {
    "tStartMs": 434110,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "and then put this under ultraviolet light"
    } ]
  }, {
    "tStartMs": 437060,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and exposed it to ultraviolet light."
    } ]
  }, {
    "tStartMs": 438600,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "And so I measured how\nlong they spent exposed"
    } ]
  }, {
    "tStartMs": 441410,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "versus unexposed and how many times"
    } ]
  }, {
    "tStartMs": 443110,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "they went back and forth."
    } ]
  }, {
    "tStartMs": 444690,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] And you were testing scorpions"
    } ]
  }, {
    "tStartMs": 446040,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "that were fluorescent and not fluorescent."
    } ]
  }, {
    "tStartMs": 448100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Carl] Right."
    } ]
  }, {
    "tStartMs": 448933,
    "dDurationMs": 1587,
    "segs": [ {
      "utf8": "So what I did with that was I developed"
    } ]
  }, {
    "tStartMs": 450520,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "a technique to remove, or at least reduce"
    } ]
  }, {
    "tStartMs": 453377,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "the ability of scorpions to fluoresce"
    } ]
  }, {
    "tStartMs": 455550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "simply by exposing them for long periods"
    } ]
  }, {
    "tStartMs": 457440,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "of time to ultraviolet light."
    } ]
  }, {
    "tStartMs": 458950,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So basically, you're just\nkind of taking the chemical"
    } ]
  }, {
    "tStartMs": 461390,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "that is causing fluorescence\nin their exoskeleton"
    } ]
  }, {
    "tStartMs": 464070,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "and your photo bleaching."
    } ]
  }, {
    "tStartMs": 466060,
    "dDurationMs": 1244,
    "segs": [ {
      "utf8": "- [Derek] So you're kind\nof breaking it down?"
    } ]
  }, {
    "tStartMs": 467304,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Carl] So basically,\nyou're making the chemical"
    } ]
  }, {
    "tStartMs": 468137,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "not be able to function properly anymore."
    } ]
  }, {
    "tStartMs": 469680,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "What we found is the activity\nlevels changed significantly."
    } ]
  }, {
    "tStartMs": 473560,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So when you exposed to UV light,"
    } ]
  }, {
    "tStartMs": 475390,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "the non-fluorescence scorpions acted like"
    } ]
  }, {
    "tStartMs": 477270,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "they were in the dark."
    } ]
  }, {
    "tStartMs": 478880,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "There was no difference\nbetween their behavior"
    } ]
  }, {
    "tStartMs": 480460,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and the dark and in UV light."
    } ]
  }, {
    "tStartMs": 481920,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Whereas when UV light\nwas present for the ones"
    } ]
  }, {
    "tStartMs": 483580,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "that can fluoresce, they\nreduced their activity levels."
    } ]
  }, {
    "tStartMs": 486510,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "- [Derek] What's the conclusion from that?"
    } ]
  }, {
    "tStartMs": 488450,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Carl] The conclusion from that"
    } ]
  }, {
    "tStartMs": 489350,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "is that the fluorescents\nitself is acting as a way to,"
    } ]
  }, {
    "tStartMs": 492870,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "for them to detect the\npresence of ultraviolet light."
    } ]
  }, {
    "tStartMs": 496240,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "Another researcher by the\nname of Douglas Gaffin,"
    } ]
  }, {
    "tStartMs": 500390,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "came up with a great phrase for it."
    } ]
  }, {
    "tStartMs": 501610,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I wish I'd come up with the\nphrase, but I gotta give credit."
    } ]
  }, {
    "tStartMs": 504170,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "He calls it, a whole-body photon detector."
    } ]
  }, {
    "tStartMs": 506840,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "So it's part of their sensory system."
    } ]
  }, {
    "tStartMs": 509490,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "What we don't know is why they want"
    } ]
  }, {
    "tStartMs": 511670,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "to detect ultraviolet light so badly"
    } ]
  }, {
    "tStartMs": 513210,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "that they've turned their whole\nbody into a photon detector."
    } ]
  }, {
    "tStartMs": 515710,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "The suspicion is that it\nhas to do with determining"
    } ]
  }, {
    "tStartMs": 519940,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "whether or not they\nshould come out at night."
    } ]
  }, {
    "tStartMs": 521960,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "- [Derek] The idea is when UV light hits"
    } ]
  }, {
    "tStartMs": 524140,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "a scorpion's body, it\nfluoresces and the tail detects"
    } ]
  }, {
    "tStartMs": 528100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "this emitted green light\nalerting the scorpion"
    } ]
  }, {
    "tStartMs": 531100,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "that it is exposed so\nit searches for cover."
    } ]
  }, {
    "tStartMs": 534360,
    "dDurationMs": 988,
    "segs": [ {
      "utf8": "- [Carl] Scorpions are good at starving"
    } ]
  }, {
    "tStartMs": 535348,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "for long periods of time."
    } ]
  }, {
    "tStartMs": 536670,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "They don't need to eat that often."
    } ]
  }, {
    "tStartMs": 538640,
    "dDurationMs": 2868,
    "segs": [ {
      "utf8": "And coming out and foraging\nis dangerous for them."
    } ]
  }, {
    "tStartMs": 541508,
    "dDurationMs": 1712,
    "segs": [ {
      "utf8": "And so they don't like to come out"
    } ]
  }, {
    "tStartMs": 543220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "when it's a moonlit night."
    } ]
  }, {
    "tStartMs": 544520,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Typically the only ones you'll\nfind out in the full moon"
    } ]
  }, {
    "tStartMs": 546420,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "are the ones that are really\nhungry, really need food."
    } ]
  }, {
    "tStartMs": 548620,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "If they're well fed, they'll stay down."
    } ]
  }, {
    "tStartMs": 550280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So they're using that\nas basically their cue"
    } ]
  }, {
    "tStartMs": 552360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "in the environment and saying, you know,"
    } ]
  }, {
    "tStartMs": 553720,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "okay, this is how bright it is."
    } ]
  }, {
    "tStartMs": 554980,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So that's a cue as to how\nlikely I'm being preyed upon."
    } ]
  }, {
    "tStartMs": 557800,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "And then here's how hungry I am."
    } ]
  }, {
    "tStartMs": 559460,
    "dDurationMs": 2743,
    "segs": [ {
      "utf8": "That's a cue how badly I need\nto get out and get some food."
    } ]
  }, {
    "tStartMs": 562203,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Right."
    } ]
  }, {
    "tStartMs": 563036,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Dr. Carl] And then the\ntrade off between those two"
    } ]
  }, {
    "tStartMs": 563869,
    "dDurationMs": 1591,
    "segs": [ {
      "utf8": "is basically should I go out tonight"
    } ]
  }, {
    "tStartMs": 565460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "or should I stay in my hole."
    } ]
  }, {
    "tStartMs": 566840,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "- [Derek] Yeah."
    } ]
  }, {
    "tStartMs": 567910,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(techno sound)"
    } ]
  } ]
}
