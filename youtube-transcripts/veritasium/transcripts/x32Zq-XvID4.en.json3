  }, {
    "tStartMs": 2512410,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "That means that the blade\nis perfectly supported,"
    } ]
  }, {
    "tStartMs": 2515560,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "so it maintains its precise\n30 degree cutting angle,"
