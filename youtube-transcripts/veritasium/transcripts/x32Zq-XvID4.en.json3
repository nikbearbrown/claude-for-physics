  }, {
    "tStartMs": 2486250,
    "dDurationMs": 3177,
    "segs": [ {
      "utf8": "and now I don't go anywhere without it."
    } ]
  }, {
    "tStartMs": 2489427,
    "dDurationMs": 1365,
    "segs": [ {
      "utf8": "And it's not just me."
    } ]
  }, {
    "tStartMs": 2490792,
    "dDurationMs": 1308,
    "segs": [ {
      "utf8": "(clicker clicking)\nMany of you have shared"
    } ]
  }, {
    "tStartMs": 2492100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "your experiences too."
    } ]
  }, {
    "tStartMs": 2493990,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The experts from Henson come\nfrom the aerospace world"
