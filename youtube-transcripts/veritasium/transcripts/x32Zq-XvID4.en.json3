  }, {
    "tStartMs": 2500080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to create a better shaving experience."
    } ]
  }, {
    "tStartMs": 2502450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Their razor is made using CNC machines,"
    } ]
  }, {
    "tStartMs": 2504730,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "which are capable of achieving\nincredibly tight tolerances."
