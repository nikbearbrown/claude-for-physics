  }, {
    "tStartMs": 2479590,
    "dDurationMs": 2597,
    "segs": [ {
      "utf8": "and I can honestly say\nit was a game changer."
    } ]
  }, {
    "tStartMs": 2482187,
    "dDurationMs": 883,
    "segs": [ {
      "utf8": "(upbeat joyful music)\nI've been using it"
    } ]
  }, {
    "tStartMs": 2483070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "ever since we first started\nworking together two years ago,"
