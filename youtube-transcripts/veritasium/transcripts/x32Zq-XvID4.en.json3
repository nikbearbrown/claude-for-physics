{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 300,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Derek] In Xiamen, China,"
    } ]
  }, {
    "tStartMs": 1410,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "in the winter of 1954,\n(fire crackling)"
    } ]
  }, {
    "tStartMs": 3960,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "air raid sirens\n(explosions thudding)"
    } ]
  }, {
    "tStartMs": 4890,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "are sounded all over the city."
    } ]
  }, {
    "tStartMs": 6843,
    "dDurationMs": 1257,
    "segs": [ {
      "utf8": "(siren blaring)"
    } ]
  }, {
    "tStartMs": 8100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "People scramble for cover\n(people screaming)"
    } ]
  }, {
    "tStartMs": 9480,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "as artillery shells\n(artillery shells blasting)"
    } ]
  }, {
    "tStartMs": 10590,
    "dDurationMs": 1586,
    "segs": [ {
      "utf8": "are being fired in the distance."
    } ]
  }, {
    "tStartMs": 12176,
    "dDurationMs": 1264,
    "segs": [ {
      "utf8": "(artillery shells blasting)"
    } ]
  }, {
    "tStartMs": 13440,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The people's Republic\nof China is bombarding"
    } ]
  }, {
    "tStartMs": 15300,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "the nearby Kinmen Islands"
    } ]
  }, {
    "tStartMs": 16830,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "in an attempt to take over control"
    } ]
  }, {
    "tStartMs": 18390,
    "dDurationMs": 1498,
    "segs": [ {
      "utf8": "from the anti-communist Chinese."
    } ]
  }, {
    "tStartMs": 19888,
    "dDurationMs": 1682,
    "segs": [ {
      "utf8": "(tank rattling)\n(boots thudding)"
    } ]
  }, {
    "tStartMs": 21570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "But troops on the islands"
    } ]
  }, {
    "tStartMs": 23160,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "fire back.\n(artillery shells blasting)"
    } ]
  }, {
    "tStartMs": 24120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Soon, artillery shells are raining down"
    } ]
  }, {
    "tStartMs": 26370,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "on both sides.\n(explosion thudding)"
    } ]
  }, {
    "tStartMs": 27604,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(siren blaring)\n(tense music continuing)"
    } ]
  }, {
    "tStartMs": 28437,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Back in Xiamen,\n(siren blaring)"
    } ]
  }, {
    "tStartMs": 29670,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Inside one of these shelters\nis 21-year-old Chen Jingrun."
    } ]
  }, {
    "tStartMs": 33840,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "As others are fidgeting impatiently,"
    } ]
  }, {
    "tStartMs": 35850,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "waiting for the explosions to stop,"
    } ]
  }, {
    "tStartMs": 38490,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Chen is reading pages\n(explosion blasting)"
    } ]
  }, {
    "tStartMs": 40020,
    "dDurationMs": 1427,
    "segs": [ {
      "utf8": "from a math book,"
    } ]
  }, {
    "tStartMs": 41447,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "(pages rustling)"
    } ]
  }, {
    "tStartMs": 42630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "because he's on a mission"
    } ]
  }, {
    "tStartMs": 44580,
    "dDurationMs": 3438,
    "segs": [ {
      "utf8": "to solve one of the\noldest problems in math."
    } ]
  }, {
    "tStartMs": 48018,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "(dramatic tense music)\n- A child can understand"
    } ]
  }, {
    "tStartMs": 49320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "the statement,"
    } ]
  }, {
    "tStartMs": 50153,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "but the greatest geniuses\nin mathematical history"
    } ]
  }, {
    "tStartMs": 52890,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "have not been able to solve it."
    } ]
  }, {
    "tStartMs": 54570,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- In the year 2000,"
    } ]
  }, {
    "tStartMs": 55620,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "a publishing house even offered"
    } ]
  }, {
    "tStartMs": 57179,
    "dDurationMs": 1591,
    "segs": [ {
      "utf8": " \na $1 million prize"
    } ]
  }, {
    "tStartMs": 58770,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to anyone who could solve the problem."
    } ]
  }, {
    "tStartMs": 61050,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But for nearly 300 years,"
    } ]
  }, {
    "tStartMs": 62910,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "everyone who has tried\n(dramatic music building)"
    } ]
  }, {
    "tStartMs": 65190,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "has failed."
    } ]
  }, {
    "tStartMs": 67140,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So the problem is this,"
    } ]
  }, {
    "tStartMs": 69540,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "can every even number greater than 2"
    } ]
  }, {
    "tStartMs": 71940,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "be written as the sum of two primes?"
    } ]
  }, {
    "tStartMs": 75390,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- So that's the problem."
    } ]
  }, {
    "tStartMs": 76650,
    "dDurationMs": 1279,
    "segs": [ {
      "utf8": "So we can do some examples."
    } ]
  }, {
    "tStartMs": 77929,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "(pen cap clicking)\nWe can say, for example, 6."
    } ]
  }, {
    "tStartMs": 80700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "You know that's an even integer."
    } ]
  }, {
    "tStartMs": 82530,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So can we write it as\nthe sum of two primes?"
    } ]
  }, {
    "tStartMs": 84630,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So those are numbers that\nonly divide by themselves"
    } ]
  }, {
    "tStartMs": 87420,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and by 1."
    } ]
  }, {
    "tStartMs": 88253,
    "dDurationMs": 3577,
    "segs": [ {
      "utf8": "So for 6, it's just 3 plus 3,"
    } ]
  }, {
    "tStartMs": 91830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and we can do more and more numbers."
    } ]
  }, {
    "tStartMs": 93090,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "So 10, for example, would be,"
    } ]
  }, {
    "tStartMs": 94737,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "you know, 5 plus 5,"
    } ]
  }, {
    "tStartMs": 97560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but also 7 plus 3."
    } ]
  }, {
    "tStartMs": 99720,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "There's one I want to do, one extra,"
    } ]
  }, {
    "tStartMs": 101700,
    "dDurationMs": 2637,
    "segs": [ {
      "utf8": "which is your favorite number."
    } ]
  }, {
    "tStartMs": 104337,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "- 42.\n- 42."
    } ]
  }, {
    "tStartMs": 106170,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "What makes it up?"
    } ]
  }, {
    "tStartMs": 107190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- 37 and 5.\n- 37."
    } ]
  }, {
    "tStartMs": 108840,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 111300,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But there's also a, sort of, nicer,"
    } ]
  }, {
    "tStartMs": 113940,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "more methodical, way of writing this out,"
    } ]
  }, {
    "tStartMs": 116130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and it will help us\n(paper rustling)"
    } ]
  }, {
    "tStartMs": 116963,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "build some intuition."
    } ]
  }, {
    "tStartMs": 118650,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "- [Casper] We'll start by\ndrawing two diagonal lines."
    } ]
  }, {
    "tStartMs": 121177,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "(soft inquisitive music)\n- I'm building like a pyramid."
    } ]
  }, {
    "tStartMs": 123150,
    "dDurationMs": 1554,
    "segs": [ {
      "utf8": "A pyramid of prime numbers."
    } ]
  }, {
    "tStartMs": 124704,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(pen cap clicking)\n- [Derek] All right."
    } ]
  }, {
    "tStartMs": 125537,
    "dDurationMs": 973,
    "segs": [ {
      "utf8": "- [Casper] So, we're\ngonna start at the top."
    } ]
  }, {
    "tStartMs": 126510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We're gonna write down 2."
    } ]
  }, {
    "tStartMs": 128550,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Then we'll write down 3."
    } ]
  }, {
    "tStartMs": 130470,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "5."
    } ]
  }, {
    "tStartMs": 131303,
    "dDurationMs": 847,
    "segs": [ {
      "utf8": "And this is gonna be a good test"
    } ]
  }, {
    "tStartMs": 132150,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of how well I know my primes."
    } ]
  }, {
    "tStartMs": 134100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Then we'll do the same on the other sides."
    } ]
  }, {
    "tStartMs": 136290,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Okay, and now, what we're gonna do is,"
    } ]
  }, {
    "tStartMs": 137790,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "we're gonna draw a line from each prime."
    } ]
  }, {
    "tStartMs": 141120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Can you see where this is going?"
    } ]
  }, {
    "tStartMs": 143430,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Derek] And where\nthey cross is every sum?"
    } ]
  }, {
    "tStartMs": 145770,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Casper] Yeah."
    } ]
  }, {
    "tStartMs": 146730,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Now I can start adding them."
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So we get 2 plus 2.\n- 4."
    } ]
  }, {
    "tStartMs": 150060,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Casper] 4."
    } ]
  }, {
    "tStartMs": 151020,
    "dDurationMs": 1279,
    "segs": [ {
      "utf8": "3 plus 3.\n- 6."
    } ]
  }, {
    "tStartMs": 152299,
    "dDurationMs": 1061,
    "segs": [ {
      "utf8": "- 6."
    } ]
  }, {
    "tStartMs": 153360,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "You can see, we're starting\nto get all these numbers."
    } ]
  }, {
    "tStartMs": 155670,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The main point here is\njust, as you go down,"
    } ]
  }, {
    "tStartMs": 158310,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "not only do you see all\nthe even numbers appear,"
    } ]
  }, {
    "tStartMs": 160680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but they also seem to\nappear more frequently."
    } ]
  }, {
    "tStartMs": 163080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And it seems like it should always happen."
    } ]
  }, {
    "tStartMs": 164880,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And, of course, the conjecture is"
    } ]
  }, {
    "tStartMs": 166410,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that it does always happen,"
    } ]
  }, {
    "tStartMs": 168240,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "and that's known as the\ngold Goldbach's conjecture."
    } ]
  }, {
    "tStartMs": 171660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Chen's obsession\n(mysterious gentle music)"
    } ]
  }, {
    "tStartMs": 172493,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "with the conjecture"
    } ]
  }, {
    "tStartMs": 173326,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "goes back to his high school years,"
    } ]
  }, {
    "tStartMs": 175110,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "when his teacher stood\nin front of the class"
    } ]
  }, {
    "tStartMs": 177090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "telling the students\nall about the sciences,"
    } ]
  }, {
    "tStartMs": 179070,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and said, \"Mathematics is\nthe queen of the sciences."
    } ]
  }, {
    "tStartMs": 182850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Number theory is the queen's crown."
    } ]
  }, {
    "tStartMs": 185640,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And the Goldbach's conjecture\nis the pearl on the crown.\""
    } ]
  }, {
    "tStartMs": 189300,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "(soft music continuing)\n- Shortly after,"
    } ]
  }, {
    "tStartMs": 191310,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "the teacher said, \"Well, perhaps, one day,"
    } ]
  }, {
    "tStartMs": 193560,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "one of you kids will solve it.\""
    } ]
  }, {
    "tStartMs": 195420,
    "dDurationMs": 1658,
    "segs": [ {
      "utf8": "And then the whole class\nburst out laughing."
    } ]
  }, {
    "tStartMs": 197078,
    "dDurationMs": 1132,
    "segs": [ {
      "utf8": "(people laughing)"
    } ]
  }, {
    "tStartMs": 198210,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "Everyone except for Chen Jingrun."
    } ]
  }, {
    "tStartMs": 201920,
    "dDurationMs": 857,
    "segs": [ {
      "utf8": "(inspiring classical music)\nHe later said,"
    } ]
  }, {
    "tStartMs": 202777,
    "dDurationMs": 953,
    "segs": [ {
      "utf8": "\"I did not laugh."
    } ]
  }, {
    "tStartMs": 203730,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I did not dare to laugh."
    } ]
  }, {
    "tStartMs": 205080,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I was worried my classmates\nwould know my vision,"
    } ]
  }, {
    "tStartMs": 207930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "but I never forgot this lesson"
    } ]
  }, {
    "tStartMs": 209730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to always remember the pearl on the crown,"
    } ]
  }, {
    "tStartMs": 212370,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "and to never forget my\naspirations or ideals.\""
    } ]
  }, {
    "tStartMs": 216540,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] And now,\n(alarm blaring)"
    } ]
  }, {
    "tStartMs": 217373,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "as air raid alarms are ringing,"
    } ]
  }, {
    "tStartMs": 219210,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "he's maintained his vision.\n(alarm blaring)"
    } ]
  }, {
    "tStartMs": 221370,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "He's working on his math,"
    } ]
  }, {
    "tStartMs": 222540,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "trying to solve Goldbach's conjecture."
    } ]
  }, {
    "tStartMs": 226470,
    "dDurationMs": 2188,
    "segs": [ {
      "utf8": "- And then it's like, well,\nwho the hell is Goldbach?"
    } ]
  }, {
    "tStartMs": 228658,
    "dDurationMs": 1472,
    "segs": [ {
      "utf8": "(playful classical music)\nDo you know a Goldbach?"
    } ]
  }, {
    "tStartMs": 230130,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- I know nothing about Goldbach."
    } ]
  }, {
    "tStartMs": 232110,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Christian Goldbach"
    } ]
  }, {
    "tStartMs": 232943,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "is a little known Prussian mathematician"
    } ]
  }, {
    "tStartMs": 234780,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "who grew up in the early 1700s."
    } ]
  }, {
    "tStartMs": 237600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "At first,\n(paper rustling)"
    } ]
  }, {
    "tStartMs": 238433,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "he mostly studied medicine and law,"
    } ]
  }, {
    "tStartMs": 240090,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "only occasionally dabbling in mathematics."
    } ]
  }, {
    "tStartMs": 243030,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "But then in 1710, at the age of 20,"
    } ]
  }, {
    "tStartMs": 246420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "he set off on a 14 year,"
    } ]
  }, {
    "tStartMs": 248280,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and over 4,000 kilometer long, journey"
    } ]
  }, {
    "tStartMs": 250740,
    "dDurationMs": 2346,
    "segs": [ {
      "utf8": "to meet some of the greatest\nmathematicians alive."
    } ]
  }, {
    "tStartMs": 253086,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(playful classical music playing)"
    } ]
  }, {
    "tStartMs": 253919,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "In Leipzig, he met with Gottfried Leibniz,"
    } ]
  }, {
    "tStartMs": 256110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the co-inventor of calculus."
    } ]
  }, {
    "tStartMs": 258480,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And, in London, he met with\nboth Nicolaus Bernoulli,"
    } ]
  }, {
    "tStartMs": 261150,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and, perhaps the greatest\nmathematician of all time,"
    } ]
  }, {
    "tStartMs": 263970,
    "dDurationMs": 1355,
    "segs": [ {
      "utf8": "Sir Isaac Newton."
    } ]
  }, {
    "tStartMs": 265325,
    "dDurationMs": 1315,
    "segs": [ {
      "utf8": "(classical music continuing)"
    } ]
  }, {
    "tStartMs": 266640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "He then finished this trip around Europe"
    } ]
  }, {
    "tStartMs": 268260,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "before ultimately settling down in Russia"
    } ]
  }, {
    "tStartMs": 271290,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "at the newly formed St.\nPetersburg Academy of Sciences."
    } ]
  }, {
    "tStartMs": 274256,
    "dDurationMs": 904,
    "segs": [ {
      "utf8": "(waves crashing)\n(seagulls cawing)"
    } ]
  }, {
    "tStartMs": 275160,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Where, in 1727, he met his\nmost important connection,"
    } ]
  }, {
    "tStartMs": 279330,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "a 20-year-old math prodigy."
    } ]
  }, {
    "tStartMs": 281760,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Can you guess who?"
    } ]
  }, {
    "tStartMs": 283260,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "- Leonard Euler?\n- Leonard Euler."
    } ]
  }, {
    "tStartMs": 285126,
    "dDurationMs": 1224,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 286350,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- The two quickly became friends,"
    } ]
  }, {
    "tStartMs": 288000,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "bonding over a shared\nobsession with number theory."
    } ]
  }, {
    "tStartMs": 290970,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Then, in 1729, Goldbach moved to Moscow,"
    } ]
  }, {
    "tStartMs": 294750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "but the two stayed in touch,"
    } ]
  }, {
    "tStartMs": 296100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "writing letters to each\nother for the next 35 years,"
    } ]
  }, {
    "tStartMs": 298800,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "literally until Goldbach died."
    } ]
  }, {
    "tStartMs": 300877,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(tense fast music playing)\n(wind whooshing)"
    } ]
  }, {
    "tStartMs": 301710,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "It was in one of these letters,"
    } ]
  }, {
    "tStartMs": 303273,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "(paper rustling)\non the 7th of June, 1742,"
    } ]
  }, {
    "tStartMs": 305430,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "where Goldbach scribbled\na line in the margin."
    } ]
  }, {
    "tStartMs": 309030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It was not the exact form"
    } ]
  }, {
    "tStartMs": 310620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "of the conjecture which\nnow bears his name,"
    } ]
  }, {
    "tStartMs": 312660,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "but something related."
    } ]
  }, {
    "tStartMs": 314150,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "(wind whooshing)"
    } ]
  }, {
    "tStartMs": 315217,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "\"It seems that every\ninteger greater than 2"
    } ]
  }, {
    "tStartMs": 317700,
    "dDurationMs": 3027,
    "segs": [ {
      "utf8": "can be written as the\nsum of three primes.\""
    } ]
  }, {
    "tStartMs": 321758,
    "dDurationMs": 1672,
    "segs": [ {
      "utf8": "(slow classical music)\nEuler was intrigued"
    } ]
  }, {
    "tStartMs": 323430,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "by the proposition,"
    } ]
  }, {
    "tStartMs": 324600,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "but he thought the idea\ncould be refined further."
    } ]
  }, {
    "tStartMs": 328260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It made sense to him"
    } ]
  }, {
    "tStartMs": 329340,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that odd numbers might need three numbers"
    } ]
  }, {
    "tStartMs": 331410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to add together to make them,"
    } ]
  }, {
    "tStartMs": 333720,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but then he turned his\nattention to even numbers,"
    } ]
  }, {
    "tStartMs": 336480,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and he thought, \"Well, with even numbers,"
    } ]
  }, {
    "tStartMs": 338550,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "perhaps just two prime\nnumbers would be enough"
    } ]
  }, {
    "tStartMs": 341040,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to sum to give you every even number.\""
    } ]
  }, {
    "tStartMs": 344490,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "In fact, as Euler wrote in his letter,"
    } ]
  }, {
    "tStartMs": 346560,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "this is how Goldbach\noriginally framed the problem"
    } ]
  }, {
    "tStartMs": 349320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in person."
    } ]
  }, {
    "tStartMs": 350910,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "So, Euler reformulated Goldbach's idea"
    } ]
  }, {
    "tStartMs": 353371,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "(wind whooshing)\ninto two separate conjectures."
    } ]
  }, {
    "tStartMs": 355690,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(wind whooshing)\nThe first"
    } ]
  }, {
    "tStartMs": 356523,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "dealt with odd numbers,"
    } ]
  }, {
    "tStartMs": 357510,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and said, \"Every odd number\ngreater than 5 can be written"
    } ]
  }, {
    "tStartMs": 361170,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "as the sum of three primes.\""
    } ]
  }, {
    "tStartMs": 363450,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "This became known as the\nweak Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 366810,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "And the second"
    } ]
  }, {
    "tStartMs": 367678,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "(wind whooshing)\ndealt with even numbers."
    } ]
  }, {
    "tStartMs": 369120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It said, \"Every even number\ngreater than 2 can be written"
    } ]
  }, {
    "tStartMs": 372600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "as the sum of two primes.\""
    } ]
  }, {
    "tStartMs": 375090,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "This became known as the\nstrong Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 378594,
    "dDurationMs": 1026,
    "segs": [ {
      "utf8": "(wind whooshing)\n(playful gentle music)"
    } ]
  }, {
    "tStartMs": 379620,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "They get their names\nstrong and weak conjecture,"
    } ]
  }, {
    "tStartMs": 381750,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "because\n(wind whooshing)"
    } ]
  }, {
    "tStartMs": 382583,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "if you have the strong conjecture,"
    } ]
  }, {
    "tStartMs": 383790,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "then you've shown that every\neven number greater than 2"
    } ]
  }, {
    "tStartMs": 387030,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "can be written as the\nsum of just two primes."
    } ]
  }, {
    "tStartMs": 389910,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And then you can add three\n(wind whooshing)"
    } ]
  }, {
    "tStartMs": 391110,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to each of those sums"
    } ]
  }, {
    "tStartMs": 392490,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to get all of the odd numbers."
    } ]
  }, {
    "tStartMs": 394320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So if you can prove the strong conjecture,"
    } ]
  }, {
    "tStartMs": 396360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you get the weak one for free."
    } ]
  }, {
    "tStartMs": 398460,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But the reverse is not true."
    } ]
  }, {
    "tStartMs": 400170,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "If you can prove the weak conjecture,"
    } ]
  }, {
    "tStartMs": 401880,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "you still don't get the strong one."
    } ]
  }, {
    "tStartMs": 404550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Now, after Euler reformulated\nthese conjectures,"
    } ]
  }, {
    "tStartMs": 406980,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "he was so confident they were true,"
    } ]
  }, {
    "tStartMs": 408810,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that he wrote, \"I regard this"
    } ]
  }, {
    "tStartMs": 410820,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "as a completely certain theorem,"
    } ]
  }, {
    "tStartMs": 412710,
    "dDurationMs": 1677,
    "segs": [ {
      "utf8": "although I cannot prove it.\""
    } ]
  }, {
    "tStartMs": 415500,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- And he couldn't, you know?"
    } ]
  }, {
    "tStartMs": 417030,
    "dDurationMs": 3853,
    "segs": [ {
      "utf8": "And for the next 150 years,\nalmost no progress is made."
    } ]
  }, {
    "tStartMs": 420883,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(cymbals crashing)"
    } ]
  }, {
    "tStartMs": 421716,
    "dDurationMs": 2304,
    "segs": [ {
      "utf8": "- [Derek] That is until, in 1900,"
    } ]
  }, {
    "tStartMs": 424020,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "German mathematician David Hilbert"
    } ]
  }, {
    "tStartMs": 425730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "addressed the International\nCongress of Mathematicians,"
    } ]
  }, {
    "tStartMs": 428070,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "in Paris."
    } ]
  }, {
    "tStartMs": 429190,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "(paper rustling)\nAnd there, he listed 23"
    } ]
  }, {
    "tStartMs": 431100,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "of the most important\nproblems for the 20th century."
    } ]
  }, {
    "tStartMs": 433852,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(pages rustling)\nNumber eight"
    } ]
  }, {
    "tStartMs": 434685,
    "dDurationMs": 2565,
    "segs": [ {
      "utf8": "on that list was all about prime numbers,"
    } ]
  }, {
    "tStartMs": 437250,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "including Goldbach's conjecture."
    } ]
  }, {
    "tStartMs": 439408,
    "dDurationMs": 902,
    "segs": [ {
      "utf8": "(pen scratching)"
    } ]
  }, {
    "tStartMs": 440310,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Goldbach's conjecture\nwas back on the radar."
    } ]
  }, {
    "tStartMs": 443160,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Only now,"
    } ]
  }, {
    "tStartMs": 444090,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "mathematicians started to look\nat the problem differently."
    } ]
  }, {
    "tStartMs": 447173,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "(gentle inquisitive music)\n- [Derek] Let's take a look"
    } ]
  }, {
    "tStartMs": 448800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "at our pyramid again."
    } ]
  }, {
    "tStartMs": 450330,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "One thing to notice is that\nthis pyramid is symmetrical."
    } ]
  }, {
    "tStartMs": 453480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "When two primes add to make an even number"
    } ]
  }, {
    "tStartMs": 455400,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "on the right side,"
    } ]
  }, {
    "tStartMs": 456450,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "those same two primes make an\neven number on the left side."
    } ]
  }, {
    "tStartMs": 459720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, to avoid double counting,"
    } ]
  }, {
    "tStartMs": 461580,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "we can look only at the right\nside of this center line."
    } ]
  }, {
    "tStartMs": 465360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And what we find is that"
    } ]
  }, {
    "tStartMs": 466800,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "for very small even\nnumbers, like 4, 6, or 8,"
    } ]
  }, {
    "tStartMs": 470280,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "well, there's only one way to write them"
    } ]
  }, {
    "tStartMs": 472590,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "as the sum of two primes."
    } ]
  }, {
    "tStartMs": 474360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But for larger numbers, like 20,"
    } ]
  }, {
    "tStartMs": 476940,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "well, now there are\nmultiple different ways"
    } ]
  }, {
    "tStartMs": 478830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to write it as the sum of two primes,"
    } ]
  }, {
    "tStartMs": 480900,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and the further down you go,"
    } ]
  }, {
    "tStartMs": 482460,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the more combinations you find."
    } ]
  }, {
    "tStartMs": 485430,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So, mathematicians started\nasking a new question,"
    } ]
  }, {
    "tStartMs": 488160,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "not just whether every\neven number can be written"
    } ]
  }, {
    "tStartMs": 490710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "as the sum of two primes,"
    } ]
  }, {
    "tStartMs": 492240,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but in how many different\nways it can be done."
    } ]
  }, {
    "tStartMs": 495330,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- [Derek] Let's call that number H of N."
    } ]
  }, {
    "tStartMs": 497430,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "For example, H of 4 is 1,"
    } ]
  }, {
    "tStartMs": 499650,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "because you can only write 4"
    } ]
  }, {
    "tStartMs": 501120,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "as the sum of primes 2 plus 2."
    } ]
  }, {
    "tStartMs": 503850,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "H of 20 is 2,"
    } ]
  }, {
    "tStartMs": 505470,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "because that is 3 plus 17, and 7 plus 13."
    } ]
  }, {
    "tStartMs": 509220,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "H of 42 is 4, and so on.\n(bubble popping)"
    } ]
  }, {
    "tStartMs": 512310,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Now, so far,"
    } ]
  }, {
    "tStartMs": 513143,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "we're just counting up what\nthe value of H should be."
    } ]
  }, {
    "tStartMs": 517140,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "But in 1923, two English mathematicians,"
    } ]
  }, {
    "tStartMs": 519750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "G. H. Hardy and John Littlewood,"
    } ]
  }, {
    "tStartMs": 521640,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "tried to come up with a function"
    } ]
  }, {
    "tStartMs": 522870,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that would estimate H of N."
    } ]
  }, {
    "tStartMs": 524910,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "To do it, they relied on one\nof the most important results"
    } ]
  }, {
    "tStartMs": 527310,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "from number theory,"
    } ]
  }, {
    "tStartMs": 528330,
    "dDurationMs": 1778,
    "segs": [ {
      "utf8": "the prime number theorem.\n(harp chiming)"
    } ]
  }, {
    "tStartMs": 530108,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "(bright classical music)"
    } ]
  }, {
    "tStartMs": 531090,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "This tells you that, on average,"
    } ]
  }, {
    "tStartMs": 532830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a large number in the neighborhood of N,"
    } ]
  }, {
    "tStartMs": 534750,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "has 1 over the natural logarithm\nof N chance of being prime."
    } ]
  }, {
    "tStartMs": 539730,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So here's a crude version of\nwhat Hardy and Littlewood did."
    } ]
  }, {
    "tStartMs": 543390,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "They imagined this large even number,"
    } ]
  }, {
    "tStartMs": 545940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and they said it equal to 2N."
    } ]
  }, {
    "tStartMs": 548040,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So you could split it\nright down the middle at N."
    } ]
  }, {
    "tStartMs": 551070,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Now they considered a\npair of numbers, A and B,"
    } ]
  }, {
    "tStartMs": 553680,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that together add up to 2N."
    } ]
  }, {
    "tStartMs": 555570,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Where A is smaller than\nN, and B is larger."
    } ]
  }, {
    "tStartMs": 559380,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "They both must differ\nfrom N by the same amount."
    } ]
  }, {
    "tStartMs": 561870,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "Let's call it C."
    } ]
  }, {
    "tStartMs": 564030,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Now, according to the\nprime number theorem,"
    } ]
  }, {
    "tStartMs": 565650,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the chance that A is prime is\n1 over the natural algorithm"
    } ]
  }, {
    "tStartMs": 569220,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of N - C."
    } ]
  }, {
    "tStartMs": 570660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And the chance that B is prime is"
    } ]
  }, {
    "tStartMs": 572370,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "1 over the natural algorithm of N plus C."
    } ]
  }, {
    "tStartMs": 575700,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "But here's the trick."
    } ]
  }, {
    "tStartMs": 578340,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Most of the times we're talking about Ns"
    } ]
  }, {
    "tStartMs": 580470,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "that are ginormous, that\nare super, super large."
    } ]
  }, {
    "tStartMs": 584340,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And if you look at 1 over L and N,"
    } ]
  }, {
    "tStartMs": 586710,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "that function would be something like"
    } ]
  }, {
    "tStartMs": 589590,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "this."
    } ]
  }, {
    "tStartMs": 590423,
    "dDurationMs": 3427,
    "segs": [ {
      "utf8": "Where, basically, it drops\nvery quickly at the start."
    } ]
  }, {
    "tStartMs": 593850,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And, for large numbers,\nit's almost constant."
    } ]
  }, {
    "tStartMs": 597000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So that this C really doesn't\naffect it a whole lot."
    } ]
  }, {
    "tStartMs": 600600,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So, for most of the numbers,"
    } ]
  }, {
    "tStartMs": 603270,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "we can, sort of, ignore\nthe C, in both cases,"
    } ]
  }, {
    "tStartMs": 606090,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and it becomes much simpler,"
    } ]
  }, {
    "tStartMs": 607170,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which is just the chance of A being prime"
    } ]
  }, {
    "tStartMs": 609480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "is about 1 over L and N,"
    } ]
  }, {
    "tStartMs": 611730,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "and the chance of B being\nprime is about 1 over L and N."
    } ]
  }, {
    "tStartMs": 616320,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now, what's the chance\nthat both are prime?"
    } ]
  }, {
    "tStartMs": 619230,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] You're gonna\nmultiply 'em together,"
    } ]
  }, {
    "tStartMs": 620430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- We're gonna multiply them together"
    } ]
  }, {
    "tStartMs": 622620,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Derek] Still, so far we've\njust looked at one pair,"
    } ]
  }, {
    "tStartMs": 625230,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "while, in total, there are\nabout N possible pairs,"
    } ]
  }, {
    "tStartMs": 628290,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "N ways to add up two numbers to get to 2N."
    } ]
  }, {
    "tStartMs": 631380,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So we can just multiply the\nchance of one pair being prime"
    } ]
  }, {
    "tStartMs": 634470,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "with the total number of pairs,"
    } ]
  }, {
    "tStartMs": 636480,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to find the total expected\nnumber of prime pairs,"
    } ]
  }, {
    "tStartMs": 639510,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "which comes out to about\nN over ln N squared."
    } ]
  }, {
    "tStartMs": 643410,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And if we plot this,"
    } ]
  }, {
    "tStartMs": 644490,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "we find that the expected number of ways"
    } ]
  }, {
    "tStartMs": 646440,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to write any number as\nthe sum of two primes"
    } ]
  }, {
    "tStartMs": 648960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "increases for larger and larger numbers."
    } ]
  }, {
    "tStartMs": 651660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Hardy and Littlewood, they\nrefined this a bit more,"
    } ]
  }, {
    "tStartMs": 653640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but essentially what they find,"
    } ]
  }, {
    "tStartMs": 655260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you know, is the exact same thing."
    } ]
  }, {
    "tStartMs": 657000,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "They just have like a\ncorrection factor in front,"
    } ]
  }, {
    "tStartMs": 659670,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but then this term is still the same."
    } ]
  }, {
    "tStartMs": 662310,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] The only problem is"
    } ]
  }, {
    "tStartMs": 663450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that this is just an\nestimate, not a proof."
    } ]
  }, {
    "tStartMs": 665730,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "And as they point out\nin their own conclusion,"
    } ]
  }, {
    "tStartMs": 667777,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "\"It is only proof that counts.\""
    } ]
  }, {
    "tStartMs": 671130,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- And that's about as far as they get"
    } ]
  }, {
    "tStartMs": 672570,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "for the strong Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 674190,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "But on the weak one,\nthey have more success."
    } ]
  }, {
    "tStartMs": 676851,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "(inquisitive pulsing music)\n- [Derek] It all comes back"
    } ]
  }, {
    "tStartMs": 678210,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "to a curious incident 10\nyears earlier, in 1913."
    } ]
  }, {
    "tStartMs": 681840,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "We've invited Elmer, from\nthe YouTube channel, Fern,"
    } ]
  }, {
    "tStartMs": 682773,
    "dDurationMs": 3627,
    "segs": [ {
      "utf8": "to tell you about it.\n(tense inquisitive music)"
    } ]
  }, {
    "tStartMs": 686400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Elmer] Hardy sits\nat his breakfast table,"
    } ]
  }, {
    "tStartMs": 688080,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "when a strange letter arrives.\n(inquisitive music continuing)"
    } ]
  }, {
    "tStartMs": 690510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's sent by a completely\nunknown mathematician"
    } ]
  }, {
    "tStartMs": 692670,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "from India,\n(camera clicking)"
    } ]
  }, {
    "tStartMs": 693780,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "Srinivasa Ramanujan."
    } ]
  }, {
    "tStartMs": 696570,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The letter reads, \"I'm\nnow about 23 years of age."
    } ]
  }, {
    "tStartMs": 699810,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I have no university education,"
    } ]
  }, {
    "tStartMs": 701760,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but I have undergone the\nordinary school course."
    } ]
  }, {
    "tStartMs": 704580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "After leaving school,"
    } ]
  }, {
    "tStartMs": 705780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I've been employing the\nspare time at my disposal"
    } ]
  }, {
    "tStartMs": 707820,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "to work at mathematics.\""
    } ]
  }, {
    "tStartMs": 710250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Ramanujan writes that he's a poor clerk,"
    } ]
  }, {
    "tStartMs": 712530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "earning only about 20 pounds a year."
    } ]
  }, {
    "tStartMs": 714600,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "He's attached some formulas"
    } ]
  }, {
    "tStartMs": 715950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and is asking for Hardy's opinion."
    } ]
  }, {
    "tStartMs": 718140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The letter is over 10 pages long"
    } ]
  }, {
    "tStartMs": 720030,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and is packed with over 100 theorems,"
    } ]
  }, {
    "tStartMs": 722370,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "many of them highly advanced,\n(clicker clicking)"
    } ]
  }, {
    "tStartMs": 724230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "yet Ramanujan provides no proofs"
    } ]
  }, {
    "tStartMs": 726210,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and very little explanation."
    } ]
  }, {
    "tStartMs": 728700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Hardy is astounded."
    } ]
  }, {
    "tStartMs": 730200,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "He has never seen anything like it."
    } ]
  }, {
    "tStartMs": 733140,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Some are already known,\n(clock ticking)"
    } ]
  }, {
    "tStartMs": 734730,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "others are completely new,\n(clock ticking)"
    } ]
  }, {
    "tStartMs": 736320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "unknown to the world.\n(clock ticking)"
    } ]
  }, {
    "tStartMs": 737730,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And then there are results\n(clock ticking)"
    } ]
  }, {
    "tStartMs": 738690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that seem impossible.\n(clock ticking)"
    } ]
  }, {
    "tStartMs": 740220,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Like that the sum of all\npositive integers up to infinity"
    } ]
  }, {
    "tStartMs": 743010,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "is negative 1 12th."
    } ]
  }, {
    "tStartMs": 745140,
    "dDurationMs": 1508,
    "segs": [ {
      "utf8": "How did he come up with this?"
    } ]
  }, {
    "tStartMs": 746648,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "(shutter clicking)\n(inquisitive music continuing)"
    } ]
  }, {
    "tStartMs": 747630,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Hardy shows a letter to Littlewood."
    } ]
  }, {
    "tStartMs": 749490,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The two stay up until midnight\ngoing through the manuscript,"
    } ]
  }, {
    "tStartMs": 752310,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "debating whether the\nmysterious author is a genius"
    } ]
  }, {
    "tStartMs": 754950,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "or a fraud."
    } ]
  }, {
    "tStartMs": 756630,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- But it sounded like Hardy felt"
    } ]
  }, {
    "tStartMs": 758460,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "these couldn't be crank results"
    } ]
  }, {
    "tStartMs": 760800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "because you couldn't imagine\nthem if you were just a crank."
    } ]
  }, {
    "tStartMs": 763620,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They're too fantastical"
    } ]
  }, {
    "tStartMs": 766140,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to be the the work of that\nkind of second rate mind."
    } ]
  }, {
    "tStartMs": 769110,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Only a really phenomenal,\noff-the-chart, genius"
    } ]
  }, {
    "tStartMs": 772290,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "could have come up with them."
    } ]
  }, {
    "tStartMs": 773790,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Elmer] So Hardy writes back."
    } ]
  }, {
    "tStartMs": 775560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The rigorous and strict\nmathematician he is,"
    } ]
  }, {
    "tStartMs": 777630,
    "dDurationMs": 1865,
    "segs": [ {
      "utf8": "he asks for proof."
    } ]
  }, {
    "tStartMs": 779495,
    "dDurationMs": 1345,
    "segs": [ {
      "utf8": "(birds tweeting)\nRamanujan, however,"
    } ]
  }, {
    "tStartMs": 780840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is nothing like Hardy."
    } ]
  }, {
    "tStartMs": 782460,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "He works on intuition,"
    } ]
  }, {
    "tStartMs": 783810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "often guided by dreams."
    } ]
  }, {
    "tStartMs": 785580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- He would just see the result,"
    } ]
  }, {
    "tStartMs": 787680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or in some mystical\nversions of his own telling,"
    } ]
  }, {
    "tStartMs": 791040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "he would say that his\npersonal goddess, Namagiri,"
    } ]
  }, {
    "tStartMs": 793650,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "would come to him in his dreams,"
    } ]
  }, {
    "tStartMs": 795660,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and write the formulas on his tongue."
    } ]
  }, {
    "tStartMs": 798330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Wait on his tongue?"
    } ]
  }, {
    "tStartMs": 799830,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- On his tongue is the\nversion I've sometimes heard."
    } ]
  }, {
    "tStartMs": 802380,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "But in any case, she\nplanted it in his mind."
    } ]
  }, {
    "tStartMs": 805147,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "- [Elmer] \"An equation\nfor me has no meaning"
    } ]
  }, {
    "tStartMs": 807150,
    "dDurationMs": 2247,
    "segs": [ {
      "utf8": "unless it expresses a thought of God.\""
    } ]
  }, {
    "tStartMs": 810330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Ramanujan never really learned"
    } ]
  }, {
    "tStartMs": 811740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "how to provide proof to his theorems."
    } ]
  }, {
    "tStartMs": 813570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So Hardy urges him to come to Cambridge"
    } ]
  }, {
    "tStartMs": 815550,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "to explain them in more detail."
    } ]
  }, {
    "tStartMs": 818100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "But there's a problem."
    } ]
  }, {
    "tStartMs": 820469,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "(bird tweeting)\nRamanujan is a devout Hindu."
    } ]
  }, {
    "tStartMs": 822660,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "His faith forbids him\nfrom crossing the sea."
    } ]
  }, {
    "tStartMs": 826080,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Then one night his mother has a dream,"
    } ]
  }, {
    "tStartMs": 828570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "(harp trilling)\na goddess appears,"
    } ]
  }, {
    "tStartMs": 830160,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and tells her to let\nRamanujan fulfill his destiny."
    } ]
  }, {
    "tStartMs": 833460,
    "dDurationMs": 2273,
    "segs": [ {
      "utf8": "Convinced by the vision\nshe gives her blessing."
    } ]
  }, {
    "tStartMs": 835733,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(camera clicking)\nAnd so,"
    } ]
  }, {
    "tStartMs": 836566,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Ramanujan finally sets out for England."
    } ]
  }, {
    "tStartMs": 838686,
    "dDurationMs": 1044,
    "segs": [ {
      "utf8": "(inspiring music playing)"
    } ]
  }, {
    "tStartMs": 839730,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In Cambridge, Hardy and\nRamanujan start working together."
    } ]
  }, {
    "tStartMs": 843090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- I mean, I'm gonna get\nchoked up thinking about it."
    } ]
  }, {
    "tStartMs": 845010,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "It's such a beautiful sentiment."
    } ]
  }, {
    "tStartMs": 848550,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Trying to remember how Hardy put it."
    } ]
  }, {
    "tStartMs": 850110,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "It's something like he thought,"
    } ]
  }, {
    "tStartMs": 852694,
    "dDurationMs": 1436,
    "segs": [ {
      "utf8": "(gentle music continuing)"
    } ]
  }, {
    "tStartMs": 854130,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "you know, on a scale from 0 to 100,"
    } ]
  }, {
    "tStartMs": 857280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you know, maybe he's a 10."
    } ]
  }, {
    "tStartMs": 858960,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Littlewood is a 30."
    } ]
  }, {
    "tStartMs": 861090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Like Ramanujan is an 80,"
    } ]
  }, {
    "tStartMs": 863190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "some kind of crazy thing like that."
    } ]
  }, {
    "tStartMs": 864870,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "So he knew that Ramanujan was special."
    } ]
  }, {
    "tStartMs": 869400,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Hmm, didn't expect to\nget emotional for you,"
    } ]
  }, {
    "tStartMs": 871530,
    "dDurationMs": 2506,
    "segs": [ {
      "utf8": "but this is what I do when\nI think about Ramanujan."
    } ]
  }, {
    "tStartMs": 874036,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "(Professor Strogatz laughing)"
    } ]
  }, {
    "tStartMs": 876120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Elmer] But his new\nlife in England is harsh."
    } ]
  }, {
    "tStartMs": 878430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "He's not used to the climate,\n(emotional string music)"
    } ]
  }, {
    "tStartMs": 879840,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "he's not used to the\nfood, and war is ravaging."
    } ]
  }, {
    "tStartMs": 883140,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "It will become one of the\ndarkest chapters of his life."
    } ]
  }, {
    "tStartMs": 887250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If you wanna know more\nabout Ramanujan's struggles,"
    } ]
  }, {
    "tStartMs": 889800,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and what made him such a genius,"
    } ]
  }, {
    "tStartMs": 891390,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "there's an upcoming video\non our channel, Fern."
    } ]
  }, {
    "tStartMs": 895950,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] While Ramanujan struggled,"
    } ]
  }, {
    "tStartMs": 897540,
    "dDurationMs": 1832,
    "segs": [ {
      "utf8": "Hardy and he did make a breakthrough."
    } ]
  }, {
    "tStartMs": 899372,
    "dDurationMs": 1228,
    "segs": [ {
      "utf8": "(hopeful classical music playing)"
    } ]
  }, {
    "tStartMs": 900600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Around 1917,"
    } ]
  }, {
    "tStartMs": 901800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "they invented what's known\nas the circle method,"
    } ]
  }, {
    "tStartMs": 904020,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and used it to tackle different\nproblems in number theory."
    } ]
  }, {
    "tStartMs": 907620,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Hardy and Littlewood later\ndeveloped this idea further,"
    } ]
  }, {
    "tStartMs": 910110,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and for the next a hundred years,"
    } ]
  }, {
    "tStartMs": 912030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "this would be the main method"
    } ]
  }, {
    "tStartMs": 913470,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "to tackle the weak Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 916770,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- But let's remind\nourselves of the problem."
    } ]
  }, {
    "tStartMs": 919260,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "We're trying to prove"
    } ]
  }, {
    "tStartMs": 921480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that we can always write an odd number,"
    } ]
  }, {
    "tStartMs": 924780,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "large odd number,"
    } ]
  }, {
    "tStartMs": 926040,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "as the sum of three primes."
    } ]
  }, {
    "tStartMs": 928950,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "Call it P1, P2, and P3."
    } ]
  }, {
    "tStartMs": 932028,
    "dDurationMs": 882,
    "segs": [ {
      "utf8": "(gentle inquisitive music)"
    } ]
  }, {
    "tStartMs": 932910,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- But just like before,"
    } ]
  }, {
    "tStartMs": 933750,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "we don't only want to know\nwhether it's possible,"
    } ]
  }, {
    "tStartMs": 936300,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but in how many different\nways it can be done."
    } ]
  }, {
    "tStartMs": 939090,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So, Hardy and Littlewood\nimagined a counting machine"
    } ]
  }, {
    "tStartMs": 942180,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "of sorts."
    } ]
  }, {
    "tStartMs": 943200,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "As input, it would take\nall possible combinations"
    } ]
  }, {
    "tStartMs": 946110,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "of three prime numbers smaller than N."
    } ]
  }, {
    "tStartMs": 948377,
    "dDurationMs": 1753,
    "segs": [ {
      "utf8": "(machine ticking)\nFor each combination"
    } ]
  }, {
    "tStartMs": 950130,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "it would add them up"
    } ]
  }, {
    "tStartMs": 951300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and check if that sum is equal to N."
    } ]
  }, {
    "tStartMs": 953820,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And, if it is, the machine\nincrements a counter"
    } ]
  }, {
    "tStartMs": 956700,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "by 1.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 957750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But if not, the machine"
    } ]
  }, {
    "tStartMs": 958950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "does nothing.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 959783,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It goes on\n(machine whirring)"
    } ]
  }, {
    "tStartMs": 960616,
    "dDurationMs": 1162,
    "segs": [ {
      "utf8": "to the next combination."
    } ]
  }, {
    "tStartMs": 961778,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(machine whirring)"
    } ]
  }, {
    "tStartMs": 962611,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "Let's do an example.\n(machine whirring)"
    } ]
  }, {
    "tStartMs": 963900,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Say N is 11."
    } ]
  }, {
    "tStartMs": 965730,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Well, the machine first\nchecks the primes 2, 2, and 2,"
    } ]
  }, {
    "tStartMs": 969270,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "adds them up to get 6,\n(machine whirring)"
    } ]
  }, {
    "tStartMs": 970530,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "which is not equal to 11."
    } ]
  }, {
    "tStartMs": 971970,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So the counter stays at 0.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 974280,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Next it tries 2, 2, 3, which is 7."
    } ]
  }, {
    "tStartMs": 976470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So again, it does nothing.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 978270,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And it keeps cycling through"
    } ]
  }, {
    "tStartMs": 979710,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "until it hits 2, 2, 7,\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 981510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "which is equal to 11.\n(machine whirring)"
    } ]
  }, {
    "tStartMs": 983460,
    "dDurationMs": 2038,
    "segs": [ {
      "utf8": "So now the machine increments the counter"
    } ]
  }, {
    "tStartMs": 985498,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "(bell dinging)\nby 1."
    } ]
  }, {
    "tStartMs": 987000,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "As it keeps running through primes,"
    } ]
  }, {
    "tStartMs": 988860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the counter increments only one more time"
    } ]
  }, {
    "tStartMs": 990960,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "for 3, 3, 5.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 992920,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "(machine whirring)\nSo in total,"
    } ]
  }, {
    "tStartMs": 993900,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "there are two ways"
    } ]
  }, {
    "tStartMs": 994920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to write 11\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 995753,
    "dDurationMs": 2617,
    "segs": [ {
      "utf8": "as the sum of three primes."
    } ]
  }, {
    "tStartMs": 998370,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But how would you go about\nbuilding this machine"
    } ]
  }, {
    "tStartMs": 1001160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "out of mathematics?\n(pen scratching)"
    } ]
  }, {
    "tStartMs": 1003140,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Because that is exactly what\nHardy and Littlewood did."
    } ]
  }, {
    "tStartMs": 1006920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Their technique is so ingenious,"
    } ]
  }, {
    "tStartMs": 1008780,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I want to take you\nthrough it step by step."
    } ]
  }, {
    "tStartMs": 1012080,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It starts with the\nfunction E to the I theta."
    } ]
  }, {
    "tStartMs": 1015140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This function just\ntraces out a unit circle"
    } ]
  }, {
    "tStartMs": 1017450,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "in the complex plane."
    } ]
  }, {
    "tStartMs": 1019010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "The angle theta determines"
    } ]
  }, {
    "tStartMs": 1020480,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "how far around the circle you are."
    } ]
  }, {
    "tStartMs": 1023300,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Now imagine that theta is restricted"
    } ]
  }, {
    "tStartMs": 1025250,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to be some multiple M of 2 pi."
    } ]
  }, {
    "tStartMs": 1028340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And since 2 pi is one complete revolution,"
    } ]
  }, {
    "tStartMs": 1031220,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "it doesn't matter if M is\n0, 1, 2, 3, or any integer,"
    } ]
  }, {
    "tStartMs": 1035930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "a vector from the origin\nwould always point"
    } ]
  }, {
    "tStartMs": 1038240,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "in the same direction,"
    } ]
  }, {
    "tStartMs": 1039410,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "to the right."
    } ]
  }, {
    "tStartMs": 1040640,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "But now Hardy and Littlewood\nmultiply the angle by alpha,"
    } ]
  }, {
    "tStartMs": 1044330,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "where alpha is just some\nnumber between 0 and 1."
    } ]
  }, {
    "tStartMs": 1048110,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "You can think of it as a slider."
    } ]
  }, {
    "tStartMs": 1050450,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So if M equals 1,"
    } ]
  }, {
    "tStartMs": 1052190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and you increase alpha from 0,"
    } ]
  }, {
    "tStartMs": 1054650,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "well, the vector slowly\nmakes one full rotation."
    } ]
  }, {
    "tStartMs": 1058100,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "If M equals 2,"
    } ]
  }, {
    "tStartMs": 1059450,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the vector will move around faster"
    } ]
  }, {
    "tStartMs": 1061220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and make two full rotations."
    } ]
  }, {
    "tStartMs": 1063140,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And this keeps going\nfor higher values of M."
    } ]
  }, {
    "tStartMs": 1066650,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Now imagine taking all possible values"
    } ]
  }, {
    "tStartMs": 1068900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of alpha simultaneously,"
    } ]
  }, {
    "tStartMs": 1070820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and then averaging out\nall of those vectors."
    } ]
  }, {
    "tStartMs": 1074180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Mathematically, we can\nwrite this as the integral"
    } ]
  }, {
    "tStartMs": 1076430,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "from 0, to 1 of E of the\nI 2 pi alpha, D alpha."
    } ]
  }, {
    "tStartMs": 1081710,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "So what happens?"
    } ]
  }, {
    "tStartMs": 1084080,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Well, this vector cancels"
    } ]
  }, {
    "tStartMs": 1085730,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with this one on the opposite side,"
    } ]
  }, {
    "tStartMs": 1087800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and this one with that one."
    } ]
  }, {
    "tStartMs": 1090290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And the same thing happens\nwith all the vectors."
    } ]
  }, {
    "tStartMs": 1093170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So, averaging them, we get 0."
    } ]
  }, {
    "tStartMs": 1095900,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "The same thing happens if\nM equals 2, or 3, or 4."
    } ]
  }, {
    "tStartMs": 1100460,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This integral will give\n0 for all values of M."
    } ]
  }, {
    "tStartMs": 1104300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Except a single case."
    } ]
  }, {
    "tStartMs": 1106820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "If M equals 0,"
    } ]
  }, {
    "tStartMs": 1108110,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "then we have E to the 0 which equals 1."
    } ]
  }, {
    "tStartMs": 1111500,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So no matter what alpha is,"
    } ]
  }, {
    "tStartMs": 1113120,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "the vector always points to the right,"
    } ]
  }, {
    "tStartMs": 1115190,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and averaging that will always give 1."
    } ]
  }, {
    "tStartMs": 1118970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So this equation is very close"
    } ]
  }, {
    "tStartMs": 1120770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to the machine we were trying to create."
    } ]
  }, {
    "tStartMs": 1122870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If M equals 0, it returns 1,\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 1125420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but if M is not equal to 0,"
    } ]
  }, {
    "tStartMs": 1127490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "it returns 0.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 1129110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So all that's left to do is replace M"
    } ]
  }, {
    "tStartMs": 1131480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "with what we're interested in."
    } ]
  }, {
    "tStartMs": 1133010,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Specifically, is the sum of\nP1 plus P2 plus P3 equal to N?"
    } ]
  }, {
    "tStartMs": 1138710,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "We can rearrange that"
    } ]
  }, {
    "tStartMs": 1139640,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "to get P1 plus P2 plus P3 minus equals 0."
    } ]
  }, {
    "tStartMs": 1144530,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So, if we sub in this expression for M,"
    } ]
  }, {
    "tStartMs": 1147260,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "then every time the\nthree primes add up to N,"
    } ]
  }, {
    "tStartMs": 1150290,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "this value will be 0,"
    } ]
  }, {
    "tStartMs": 1151730,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "and the integral\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 1152660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "will be equal to one."
    } ]
  }, {
    "tStartMs": 1154370,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And every time the\nprimes don't add up to N,"
    } ]
  }, {
    "tStartMs": 1156590,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "this value will be non-zero."
    } ]
  }, {
    "tStartMs": 1158420,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And so the integral will"
    } ]
  }, {
    "tStartMs": 1159710,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "return 0.\n(bell dinging)"
    } ]
  }, {
    "tStartMs": 1161540,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "But, right now,"
    } ]
  }, {
    "tStartMs": 1162373,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "this equation only checks\none triplet of primes."
    } ]
  }, {
    "tStartMs": 1165290,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "To check all possible combinations\nof primes smaller than N,"
    } ]
  }, {
    "tStartMs": 1168440,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "we need to add a sum."
    } ]
  }, {
    "tStartMs": 1170990,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Since this will count up"
    } ]
  }, {
    "tStartMs": 1171980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "all the ways three\nprimes can add to make N,"
    } ]
  }, {
    "tStartMs": 1174380,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "we can call it H of N."
    } ]
  }, {
    "tStartMs": 1176510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So in fact, let's try it out."
    } ]
  }, {
    "tStartMs": 1178730,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Put in N equals 11, compute this function,"
    } ]
  }, {
    "tStartMs": 1181160,
    "dDurationMs": 1925,
    "segs": [ {
      "utf8": "and it gives 6.\n(wind whooshing)"
    } ]
  }, {
    "tStartMs": 1183085,
    "dDurationMs": 985,
    "segs": [ {
      "utf8": "(paper rustling)\nWhich is not the 2"
    } ]
  }, {
    "tStartMs": 1184070,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "we found before."
    } ]
  }, {
    "tStartMs": 1185180,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So what happened?"
    } ]
  }, {
    "tStartMs": 1186740,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Well, we've simplified\nthe logic a little bit,"
    } ]
  }, {
    "tStartMs": 1188750,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "so we actually get some\nduplicates this time."
    } ]
  }, {
    "tStartMs": 1191120,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "For example, the machine finds 2, 2, 7,"
    } ]
  }, {
    "tStartMs": 1193370,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but also 7, 2, 2, and 2, 7, 2."
    } ]
  }, {
    "tStartMs": 1196280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Mathematicians correct for this"
    } ]
  }, {
    "tStartMs": 1197720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "when doing the real calculation,"
    } ]
  }, {
    "tStartMs": 1198920,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but for our purposes, this\nmachine is good enough."
    } ]
  }, {
    "tStartMs": 1202010,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So we've got our H of N,"
    } ]
  }, {
    "tStartMs": 1204050,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and if we can show that\nH of N is at least 1"
    } ]
  }, {
    "tStartMs": 1206870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "for every odd number greater than 5,"
    } ]
  }, {
    "tStartMs": 1209060,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "then we've proven the\nweak Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 1212870,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But there are two issues\nwith this approach."
    } ]
  }, {
    "tStartMs": 1216110,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The first is that we assumed"
    } ]
  }, {
    "tStartMs": 1217940,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that we know all of the\nprime numbers smaller than N,"
    } ]
  }, {
    "tStartMs": 1221060,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "which is true when N is small."
    } ]
  }, {
    "tStartMs": 1222920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But as N goes to infinity,"
    } ]
  }, {
    "tStartMs": 1224870,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "we just don't know all of the primes."
    } ]
  }, {
    "tStartMs": 1227480,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The second problem is that,"
    } ]
  }, {
    "tStartMs": 1228770,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as the number of primes increases,"
    } ]
  }, {
    "tStartMs": 1230690,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the number of possible\ncombinations explodes."
    } ]
  }, {
    "tStartMs": 1233660,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "If N is 10,001,"
    } ]
  }, {
    "tStartMs": 1235670,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "there are 1,229 smaller prime numbers,"
    } ]
  }, {
    "tStartMs": 1238880,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "which means a total"
    } ]
  }, {
    "tStartMs": 1240140,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "of 310 million, 144 thousand,\n296 possible prime triplets."
    } ]
  }, {
    "tStartMs": 1245480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Increase N to a billion,"
    } ]
  }, {
    "tStartMs": 1246980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and the possible combinations jumps up"
    } ]
  }, {
    "tStartMs": 1248870,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "to nearly 22 sextillion."
    } ]
  }, {
    "tStartMs": 1251622,
    "dDurationMs": 1988,
    "segs": [ {
      "utf8": "(soft piano music playing)\nAnd this trend continues."
    } ]
  }, {
    "tStartMs": 1253610,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "So, using this approach in\na simple way won't work."
    } ]
  }, {
    "tStartMs": 1258590,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "So Hardy and Littlewood\ncame up with a smarter way."
    } ]
  }, {
    "tStartMs": 1262940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "They fundamentally reframed the problem"
    } ]
  }, {
    "tStartMs": 1265040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "by taking the sum inside the integral."
    } ]
  }, {
    "tStartMs": 1267680,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Rather than checking all\npossible combinations"
    } ]
  }, {
    "tStartMs": 1269750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of prime numbers by brute force,"
    } ]
  }, {
    "tStartMs": 1271610,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "they now analyze the collective behavior"
    } ]
  }, {
    "tStartMs": 1274280,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of all the primes at once."
    } ]
  }, {
    "tStartMs": 1276740,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "To see how this works, take\na look at the equation."
    } ]
  }, {
    "tStartMs": 1280130,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "In the exponent is the sum\nof three primes minus N,"
    } ]
  }, {
    "tStartMs": 1284090,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "but adding in the exponent is the same"
    } ]
  }, {
    "tStartMs": 1286370,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "as multiplying exponentials together."
    } ]
  }, {
    "tStartMs": 1288770,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "So we can rewrite this as the\nproduct of four exponentials."
    } ]
  }, {
    "tStartMs": 1293120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The first three of these\nare actually identical"
    } ]
  }, {
    "tStartMs": 1296000,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "because there's nothing to distinguish"
    } ]
  }, {
    "tStartMs": 1297860,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "what we call P1, P2, P3."
    } ]
  }, {
    "tStartMs": 1300200,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "They're all prime numbers\ndrawn from the same set."
    } ]
  }, {
    "tStartMs": 1303320,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "So we could just call this\nfunction S of alpha and N,"
    } ]
  }, {
    "tStartMs": 1307370,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and we could multiply it\nby itself three times,"
    } ]
  }, {
    "tStartMs": 1309830,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "or just cube it."
    } ]
  }, {
    "tStartMs": 1311630,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "By doing this, H of N is now\na function of just two things,"
    } ]
  }, {
    "tStartMs": 1315560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "E to the minus I two pi N alpha,"
    } ]
  }, {
    "tStartMs": 1318260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "which is just a complex\nnumber that you could compute,"
    } ]
  }, {
    "tStartMs": 1321080,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and this new function, S of alpha and N."
    } ]
  }, {
    "tStartMs": 1325100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But what is this function?"
    } ]
  }, {
    "tStartMs": 1327500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Well, let's do an example."
    } ]
  }, {
    "tStartMs": 1329780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Again, say N equals 11."
    } ]
  }, {
    "tStartMs": 1332120,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Then S of alpha and 11 equals"
    } ]
  }, {
    "tStartMs": 1334790,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "just a sum of four exponentials,"
    } ]
  }, {
    "tStartMs": 1337310,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "each governed by its own prime number."
    } ]
  }, {
    "tStartMs": 1340010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "You can think of each of\nthese exponentials as a clock,"
    } ]
  }, {
    "tStartMs": 1342800,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "each with its own prime number"
    } ]
  }, {
    "tStartMs": 1344210,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that determines how fast the clock spins."
    } ]
  }, {
    "tStartMs": 1347030,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So 2 turns the slowest, 3 turns faster,"
    } ]
  }, {
    "tStartMs": 1349880,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "5 turns faster still, and so on."
    } ]
  }, {
    "tStartMs": 1352670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But remember, this is a sum."
    } ]
  }, {
    "tStartMs": 1354590,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So we actually need to add up\nall the clocks tip to tail."
    } ]
  }, {
    "tStartMs": 1357980,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Now watch what happens\nas we increase alpha."
    } ]
  }, {
    "tStartMs": 1360740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "All the clocks wind\naround at their own rates."
    } ]
  }, {
    "tStartMs": 1363620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "What we're interested\nin is not the behavior"
    } ]
  }, {
    "tStartMs": 1365660,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of any individual clock,"
    } ]
  }, {
    "tStartMs": 1367250,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "but instead all of them together."
    } ]
  }, {
    "tStartMs": 1369740,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Since we've chosen a\npretty small value for N,"
    } ]
  }, {
    "tStartMs": 1372440,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "nothing too exciting happens,"
    } ]
  }, {
    "tStartMs": 1374450,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "but watch what happens"
    } ]
  }, {
    "tStartMs": 1375320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "if we pick a larger value for N, like 99."
    } ]
  }, {
    "tStartMs": 1378800,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Now there are 25 prime numbers\nthat are smaller than 99,"
    } ]
  }, {
    "tStartMs": 1382610,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and hence 25 clocks in our sum."
    } ]
  }, {
    "tStartMs": 1385970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Now as we increase alpha,"
    } ]
  }, {
    "tStartMs": 1387770,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "all the clocks, again, wind\naround at their different rates."
    } ]
  }, {
    "tStartMs": 1391160,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It almost looks like a dragon's tail."
    } ]
  }, {
    "tStartMs": 1393650,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And for a while everything\nseems kind of chaotic,"
    } ]
  }, {
    "tStartMs": 1396590,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "circling around the origin,"
    } ]
  }, {
    "tStartMs": 1398300,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "but then, when alpha hits\n1 over 6, the tail unwinds,"
    } ]
  }, {
    "tStartMs": 1403130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and suddenly almost all the clocks point"
    } ]
  }, {
    "tStartMs": 1405350,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "in a similar direction,"
    } ]
  }, {
    "tStartMs": 1406760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and we get a large resultant value."
    } ]
  }, {
    "tStartMs": 1409400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If we increase alpha further,"
    } ]
  }, {
    "tStartMs": 1410990,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the clocks cancel out again"
    } ]
  }, {
    "tStartMs": 1412790,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "until we hit the next\nmagic point, 1 over 3."
    } ]
  }, {
    "tStartMs": 1416630,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Here again, many clocks line up."
    } ]
  }, {
    "tStartMs": 1418550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And this curious pattern keeps repeating."
    } ]
  }, {
    "tStartMs": 1421670,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "For the majority of values of alpha,"
    } ]
  }, {
    "tStartMs": 1423350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the clocks cancel each other out."
    } ]
  }, {
    "tStartMs": 1425480,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But at a few special points, like a half,"
    } ]
  }, {
    "tStartMs": 1428630,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "the tail unwinds, the clocks\ninterfere constructively,"
    } ]
  }, {
    "tStartMs": 1432260,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "and we get a large resultant value."
    } ]
  }, {
    "tStartMs": 1435470,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- If the angle is, you know,"
    } ]
  }, {
    "tStartMs": 1436430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "360 degrees divided by a whole number,"
    } ]
  }, {
    "tStartMs": 1438740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "you get some very particular behavior"
    } ]
  }, {
    "tStartMs": 1440720,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "that's very predictable."
    } ]
  }, {
    "tStartMs": 1441860,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Those are the angles\nat which this function,"
    } ]
  }, {
    "tStartMs": 1444500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "when you sum the primes,"
    } ]
  }, {
    "tStartMs": 1445940,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they actually go far from from 0."
    } ]
  }, {
    "tStartMs": 1448250,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And what happens at a random angle,"
    } ]
  }, {
    "tStartMs": 1450350,
    "dDurationMs": 1886,
    "segs": [ {
      "utf8": "and you just start adding the primes up,"
    } ]
  }, {
    "tStartMs": 1452236,
    "dDurationMs": 2524,
    "segs": [ {
      "utf8": "it keeps changing which way it's pointing,"
    } ]
  }, {
    "tStartMs": 1454760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and the thing just bounces around."
    } ]
  }, {
    "tStartMs": 1457340,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- So why is this happening?"
    } ]
  }, {
    "tStartMs": 1459560,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Well, let's look at when\nalpha equals a half."
    } ]
  }, {
    "tStartMs": 1462890,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Here what we're doing is multiplying"
    } ]
  }, {
    "tStartMs": 1464720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "each prime number in\nthe exponent by a half."
    } ]
  }, {
    "tStartMs": 1467300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "In other words, dividing\neach prime number by 2."
    } ]
  }, {
    "tStartMs": 1470240,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "So let's do this for each of the primes."
    } ]
  }, {
    "tStartMs": 1472930,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "In the first column,"
    } ]
  }, {
    "tStartMs": 1474020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "we'll write down how many\ntimes it can be divided by 2."
    } ]
  }, {
    "tStartMs": 1477020,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And in the second column we'll\nwrite down the remainder."
    } ]
  }, {
    "tStartMs": 1480380,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So 2 divided by 2 equals 1,"
    } ]
  }, {
    "tStartMs": 1482840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "leaving a remainder of 0."
    } ]
  }, {
    "tStartMs": 1484340,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So we've just made one full rotation."
    } ]
  }, {
    "tStartMs": 1486710,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "3 divided by two is 1,"
    } ]
  }, {
    "tStartMs": 1488540,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but that leaves a remainder of 1,"
    } ]
  }, {
    "tStartMs": 1490370,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "so it makes one full rotation\nand then a half rotation."
    } ]
  }, {
    "tStartMs": 1494210,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "5 divided by 2 is 2 with a remainder of 1."
    } ]
  }, {
    "tStartMs": 1497180,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So it makes two full rotations"
    } ]
  }, {
    "tStartMs": 1498920,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and then a half rotation more."
    } ]
  }, {
    "tStartMs": 1501680,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, we don't really care\nabout the first column"
    } ]
  }, {
    "tStartMs": 1503810,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "because it doesn't matter"
    } ]
  }, {
    "tStartMs": 1504830,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "how many full rotations a clock makes,"
    } ]
  }, {
    "tStartMs": 1506810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "we only care about\nwhere the arrow ends up."
    } ]
  }, {
    "tStartMs": 1509420,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And that's fully determined\nby the remainder."
    } ]
  }, {
    "tStartMs": 1511790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's just the remainder times alpha."
    } ]
  }, {
    "tStartMs": 1514130,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So from now on we'll just\nkeep track of the remainders."
    } ]
  }, {
    "tStartMs": 1516950,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "And what we find is"
    } ]
  }, {
    "tStartMs": 1517880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that all of the other\nremainders are equal to 1."
    } ]
  }, {
    "tStartMs": 1520640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "So all clocks, except the\nfirst one, point the same way."
    } ]
  }, {
    "tStartMs": 1524720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This is because when we're\ndividing whole numbers by 2,"
    } ]
  }, {
    "tStartMs": 1527120,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "there are only two possible\nremainders, 0 or 1."
    } ]
  }, {
    "tStartMs": 1530540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And since we're working\nwith prime numbers,"
    } ]
  }, {
    "tStartMs": 1532280,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "only 2 can have the remainder 0,"
    } ]
  }, {
    "tStartMs": 1534230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "because no other prime number is even,"
    } ]
  }, {
    "tStartMs": 1537140,
    "dDurationMs": 3371,
    "segs": [ {
      "utf8": "therefore, all other primes\nmust share the remainder 1."
    } ]
  }, {
    "tStartMs": 1540511,
    "dDurationMs": 1249,
    "segs": [ {
      "utf8": "(wind whooshing)\nMeaning all those clocks"
    } ]
  }, {
    "tStartMs": 1541760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "end up making another half rotation,"
    } ]
  }, {
    "tStartMs": 1543590,
    "dDurationMs": 3259,
    "segs": [ {
      "utf8": "so they all point left and\nconstructively interfere."
    } ]
  }, {
    "tStartMs": 1546849,
    "dDurationMs": 1295,
    "segs": [ {
      "utf8": "(wind whooshing)\nA similar thing happens"
    } ]
  }, {
    "tStartMs": 1548144,
    "dDurationMs": 2226,
    "segs": [ {
      "utf8": "when alpha equals a third."
    } ]
  }, {
    "tStartMs": 1550370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Now each prime is divided by 3."
    } ]
  }, {
    "tStartMs": 1552410,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So the possible remainders are 0, 1, or 2."
    } ]
  }, {
    "tStartMs": 1555920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Again, 3 is the only clock\nthat has remainder 0,"
    } ]
  }, {
    "tStartMs": 1558920,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "so that points right."
    } ]
  }, {
    "tStartMs": 1560300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But all the other primes\nfollow a special pattern,"
    } ]
  }, {
    "tStartMs": 1562820,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "a pattern that makes the\nentire circle method possible."
    } ]
  }, {
    "tStartMs": 1565970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The remaining primes distribute\nthemselves roughly equally"
    } ]
  }, {
    "tStartMs": 1568850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "between remainders 1 and 2,"
    } ]
  }, {
    "tStartMs": 1570950,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "which means all the\nremaining clocks are rotated"
    } ]
  }, {
    "tStartMs": 1573380,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "one third or two thirds of\nthe way around the circle."
    } ]
  }, {
    "tStartMs": 1576980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Since these clocks are\npointing to the left,"
    } ]
  }, {
    "tStartMs": 1579260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "again, we get constructive interference."
    } ]
  }, {
    "tStartMs": 1582080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And this pattern of constructive\ninterference also occurs"
    } ]
  }, {
    "tStartMs": 1584810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "for other small rational fractions."
    } ]
  }, {
    "tStartMs": 1587420,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But for non-rational numbers,"
    } ]
  }, {
    "tStartMs": 1589250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "you don't get these nicely\nrestricted remainders."
    } ]
  }, {
    "tStartMs": 1591800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So the clocks are roughly\ndistributed equally"
    } ]
  }, {
    "tStartMs": 1594140,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "all over the circle,"
    } ]
  }, {
    "tStartMs": 1595190,
    "dDurationMs": 2156,
    "segs": [ {
      "utf8": "and you get destructive interference."
    } ]
  }, {
    "tStartMs": 1597346,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "(upbeat tense music playing)"
    } ]
  }, {
    "tStartMs": 1598580,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Hardy and Littlewood\nrealized they could use this."
    } ]
  }, {
    "tStartMs": 1601670,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Imagine taking this plot"
    } ]
  }, {
    "tStartMs": 1603170,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of the magnitude of the resultant arrow"
    } ]
  }, {
    "tStartMs": 1605240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and wrapping it around a circle."
    } ]
  }, {
    "tStartMs": 1607670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "What they found is that the\nmajority of the contributions"
    } ]
  }, {
    "tStartMs": 1610460,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "come from very small\nregions of the circle,"
    } ]
  }, {
    "tStartMs": 1613190,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "what they called the major arcs."
    } ]
  }, {
    "tStartMs": 1615560,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "The rest of the circle only\nadds minor contributions."
    } ]
  }, {
    "tStartMs": 1618860,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So they called these the minor arcs."
    } ]
  }, {
    "tStartMs": 1621530,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "This allowed them to\nsplit up their calculation"
    } ]
  }, {
    "tStartMs": 1623630,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "into two parts."
    } ]
  }, {
    "tStartMs": 1625130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The major arc part gives you the main term"
    } ]
  }, {
    "tStartMs": 1627890,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for how many ways you can write a number N"
    } ]
  }, {
    "tStartMs": 1630140,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "as the sum of three primes."
    } ]
  }, {
    "tStartMs": 1631970,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "And the minor arcs just\ngives you an error term."
    } ]
  }, {
    "tStartMs": 1634792,
    "dDurationMs": 1078,
    "segs": [ {
      "utf8": "(upbeat classical music playing)"
    } ]
  }, {
    "tStartMs": 1635870,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "They then showed that,"
    } ]
  }, {
    "tStartMs": 1636740,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "if the generalized Riemann\nhypothesis is true,"
    } ]
  }, {
    "tStartMs": 1639350,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "then the main term grows\nfaster than the error term."
    } ]
  }, {
    "tStartMs": 1642500,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So eventually, for some large\nenough number, call it K,"
    } ]
  }, {
    "tStartMs": 1645680,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "this value will always be larger than 1,"
    } ]
  }, {
    "tStartMs": 1648110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and the weak Goldbach conjecture holds."
    } ]
  }, {
    "tStartMs": 1651200,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But there are two problems\nwith this approach."
    } ]
  }, {
    "tStartMs": 1654290,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The first is that they assumed"
    } ]
  }, {
    "tStartMs": 1655790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that a generalization of the\nRiemann's hypothesis is true,"
    } ]
  }, {
    "tStartMs": 1658340,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which we don't know."
    } ]
  }, {
    "tStartMs": 1660140,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "And the second is"
    } ]
  }, {
    "tStartMs": 1661250,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "that they didn't actually\nspecify that number, K."
    } ]
  }, {
    "tStartMs": 1664460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I mean, how big of a number\ndo you need to get to"
    } ]
  }, {
    "tStartMs": 1667160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "before you can guarantee that\nall numbers larger than that"
    } ]
  }, {
    "tStartMs": 1670280,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "adhere to Goldbach conjecture?"
    } ]
  }, {
    "tStartMs": 1673040,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Then we've got to wait until 1937"
    } ]
  }, {
    "tStartMs": 1675710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "when Russian mathematician,\nIvan Vinogradov,"
    } ]
  }, {
    "tStartMs": 1678230,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "proves the same as Hardy and Littlewood."
    } ]
  }, {
    "tStartMs": 1680750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But he did it without the\ngeneralized Riemann hypothesis."
    } ]
  }, {
    "tStartMs": 1683510,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, you know, assumption free."
    } ]
  }, {
    "tStartMs": 1686330,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- It's one thing to just\nassume the Riemann hypothesis,"
    } ]
  }, {
    "tStartMs": 1688580,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and say, \"Oh yeah, you\ncan make some progress.\""
    } ]
  }, {
    "tStartMs": 1691400,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "But Vinogradov's like, \"No guys,"
    } ]
  }, {
    "tStartMs": 1692750,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "you don't need the Riemann hypothesis."
    } ]
  }, {
    "tStartMs": 1693800,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "You can really prove this stuff.\""
    } ]
  }, {
    "tStartMs": 1695120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- But again, he gives\nsome large enough number"
    } ]
  }, {
    "tStartMs": 1697160,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "for which the weak Goldbach\nconjecture will hold"
    } ]
  }, {
    "tStartMs": 1699710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "without specifying that number."
    } ]
  }, {
    "tStartMs": 1701330,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "And so it's very unsatisfying."
    } ]
  }, {
    "tStartMs": 1703880,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "(bright classical music)\nOver the next 19 years,"
    } ]
  }, {
    "tStartMs": 1705050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "one of his students did\nget that satisfaction"
    } ]
  }, {
    "tStartMs": 1707090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "when he could specify that number."
    } ]
  }, {
    "tStartMs": 1709880,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Do you want to have any guess"
    } ]
  }, {
    "tStartMs": 1711140,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "as to what the number is?"
    } ]
  }, {
    "tStartMs": 1712861,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "- 10 to the 50?"
    } ]
  }, {
    "tStartMs": 1714318,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "10 to the 80?"
    } ]
  }, {
    "tStartMs": 1715151,
    "dDurationMs": 1012,
    "segs": [ {
      "utf8": "10 of the 3000?"
    } ]
  }, {
    "tStartMs": 1716163,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I don't know."
    } ]
  }, {
    "tStartMs": 1716996,
    "dDurationMs": 1324,
    "segs": [ {
      "utf8": "I was guessing things that\nare far too low, probably."
    } ]
  }, {
    "tStartMs": 1718320,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "- Yeah, yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 1720500,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "It's about 10 to the 6.8 million."
    } ]
  }, {
    "tStartMs": 1725150,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Wow, okay.\n- It's huge."
    } ]
  }, {
    "tStartMs": 1727070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But then you know, from here on,"
    } ]
  }, {
    "tStartMs": 1728870,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "people start working on this method more,"
    } ]
  }, {
    "tStartMs": 1731120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and they all use the same techniques."
    } ]
  }, {
    "tStartMs": 1732980,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "In 1989, the number was brought\ndown to 10 to the 43,000."
    } ]
  }, {
    "tStartMs": 1737390,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "Next it dropped to 10 to the 7,194."
    } ]
  }, {
    "tStartMs": 1741980,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "And by 2002 it had\ndropped all the way down"
    } ]
  }, {
    "tStartMs": 1744850,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "to 10 to the 1,346."
    } ]
  }, {
    "tStartMs": 1748550,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Now that seems so much smaller\nthan what we had before,"
    } ]
  }, {
    "tStartMs": 1751550,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but if you compare it\nto how many, you know,"
    } ]
  }, {
    "tStartMs": 1754280,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "protons there are in the universe,"
    } ]
  }, {
    "tStartMs": 1755690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "which is 10 to the power 80,"
    } ]
  }, {
    "tStartMs": 1757190,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that's not something you\ncan check by computer."
    } ]
  }, {
    "tStartMs": 1759290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's absolutely, absolutely hopeless."
    } ]
  }, {
    "tStartMs": 1761450,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Even if you turned the whole\nuniverse into a computer,"
    } ]
  }, {
    "tStartMs": 1764150,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "you would still have no\nchance of solving this."
    } ]
  }, {
    "tStartMs": 1766640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So it really needed to get dragged down."
    } ]
  }, {
    "tStartMs": 1769760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- [Derek] This is roughly where\nthe problem stood in 2005,"
    } ]
  }, {
    "tStartMs": 1772490,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "when, Peruvian mathematician,"
    } ]
  }, {
    "tStartMs": 1773900,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "Harald Helfgott became interested in it."
    } ]
  }, {
    "tStartMs": 1776097,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "(upbeat classical music playing)"
    } ]
  }, {
    "tStartMs": 1777380,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- He was reading papers about\nthe weak Goldbach conjecture,"
    } ]
  }, {
    "tStartMs": 1780950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and new techniques that\nwere being developed."
    } ]
  }, {
    "tStartMs": 1782660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So these were the cutting\nedge techniques at the time."
    } ]
  }, {
    "tStartMs": 1785510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "He was reading it and he thought."
    } ]
  }, {
    "tStartMs": 1787550,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I can do better."
    } ]
  }, {
    "tStartMs": 1788383,
    "dDurationMs": 1577,
    "segs": [ {
      "utf8": "I'm having some ideas how to do better."
    } ]
  }, {
    "tStartMs": 1789960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And, you know, it took\nme a couple of weeks"
    } ]
  }, {
    "tStartMs": 1792440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to get better estimates."
    } ]
  }, {
    "tStartMs": 1794090,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Not still, you know, strong enough"
    } ]
  }, {
    "tStartMs": 1796160,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to revolutionize everything,"
    } ]
  }, {
    "tStartMs": 1797990,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but to make real progress."
    } ]
  }, {
    "tStartMs": 1799880,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- So he gets to work"
    } ]
  }, {
    "tStartMs": 1801110,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and within a couple of weeks"
    } ]
  }, {
    "tStartMs": 1802340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "he's got better estimates\nthan that in the paper."
    } ]
  }, {
    "tStartMs": 1805310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So now he's getting more confident,"
    } ]
  }, {
    "tStartMs": 1806990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "like, \"Okay, I got this.\""
    } ]
  }, {
    "tStartMs": 1809270,
    "dDurationMs": 1115,
    "segs": [ {
      "utf8": "- Of course, I was a bit naive."
    } ]
  }, {
    "tStartMs": 1810385,
    "dDurationMs": 3445,
    "segs": [ {
      "utf8": "I underestimate some\ndifficulties elsewhere."
    } ]
  }, {
    "tStartMs": 1813830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "(upbeat bright string music)\n- To solve the problem,"
    } ]
  }, {
    "tStartMs": 1815510,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "he realized he needed to do two things."
    } ]
  }, {
    "tStartMs": 1818480,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "One, get the computational\nnumber as high as possible,"
    } ]
  }, {
    "tStartMs": 1822290,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and two, get the constant\ndown as much as he could,"
    } ]
  }, {
    "tStartMs": 1826100,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which is where the\ndifficult math comes in."
    } ]
  }, {
    "tStartMs": 1828590,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "So, over the next eight years,"
    } ]
  }, {
    "tStartMs": 1830000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "he attacked the problem from both sides."
    } ]
  }, {
    "tStartMs": 1832640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Together with David Platt,"
    } ]
  }, {
    "tStartMs": 1833840,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "he checked all numbers up\nto 8.8 times 10 to the 30"
    } ]
  }, {
    "tStartMs": 1837110,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "by computer."
    } ]
  }, {
    "tStartMs": 1838700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And by refining his math,"
    } ]
  }, {
    "tStartMs": 1840080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "he slowly brought down\nthe constant number,"
    } ]
  }, {
    "tStartMs": 1842450,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "K.\n(numbers ticking)"
    } ]
  }, {
    "tStartMs": 1845360,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "By 2013, he gets the\nnumber all the way down"
    } ]
  }, {
    "tStartMs": 1848420,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to 10 to the 27,"
    } ]
  }, {
    "tStartMs": 1850430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "which is below the number"
    } ]
  }, {
    "tStartMs": 1851990,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that his computers had already checked."
    } ]
  }, {
    "tStartMs": 1855140,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "- So he solved it."
    } ]
  }, {
    "tStartMs": 1857210,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "He wrote up his results"
    } ]
  }, {
    "tStartMs": 1858290,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "in a paper called \"The Ternary\nGoldbach Conjecture is True,\""
    } ]
  }, {
    "tStartMs": 1861440,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which is quite the mike-drop title."
    } ]
  }, {
    "tStartMs": 1863720,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So, nearly 300 years after\nGoldbach's original letter,"
    } ]
  }, {
    "tStartMs": 1867320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Helfgott proved that every\nodd number greater than five"
    } ]
  }, {
    "tStartMs": 1870080,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "can be written as the sum of three primes."
    } ]
  }, {
    "tStartMs": 1873110,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And as a result, he also proved"
    } ]
  }, {
    "tStartMs": 1875090,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that every even number greater than 2,"
    } ]
  }, {
    "tStartMs": 1877250,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "can be written as the sum\nof at most four primes."
    } ]
  }, {
    "tStartMs": 1880520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is because you can always just add 3"
    } ]
  }, {
    "tStartMs": 1882560,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "to all the odd numbers"
    } ]
  }, {
    "tStartMs": 1883940,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "to get all the even numbers."
    } ]
  }, {
    "tStartMs": 1886370,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- So was it a big deal?"
    } ]
  }, {
    "tStartMs": 1887330,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "Were people excited?"
    } ]
  }, {
    "tStartMs": 1889236,
    "dDurationMs": 884,
    "segs": [ {
      "utf8": "(playful gentle music playing)\n- Yeah, it's a good question."
    } ]
  }, {
    "tStartMs": 1890120,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I feel like it is mostly\nan obscure problem."
    } ]
  }, {
    "tStartMs": 1892970,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I think the strong one,"
    } ]
  }, {
    "tStartMs": 1894320,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and this with both of these problems,"
    } ]
  }, {
    "tStartMs": 1896030,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "like they don't have\nany direct application"
    } ]
  }, {
    "tStartMs": 1899000,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "to the real world.\n(inquisitive music continuing)"
    } ]
  }, {
    "tStartMs": 1899870,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Because it's so simple, it\nhas this massive wide appeal,"
    } ]
  }, {
    "tStartMs": 1902840,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and everyone will kind of know about it."
    } ]
  }, {
    "tStartMs": 1904250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It's also one of the\noldest unsolved problems."
    } ]
  }, {
    "tStartMs": 1906830,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "What did you do when you proved it?"
    } ]
  }, {
    "tStartMs": 1909470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Well, I put it on the archive."
    } ]
  }, {
    "tStartMs": 1911150,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Like any normal person."
    } ]
  }, {
    "tStartMs": 1913100,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It was a big relief."
    } ]
  }, {
    "tStartMs": 1914750,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- You know, given your success\n(playful piano music playing)"
    } ]
  }, {
    "tStartMs": 1915860,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "with the weak form of\nthe Goldbach conjecture,"
    } ]
  }, {
    "tStartMs": 1919190,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "how do you feel about the strong form?"
    } ]
  }, {
    "tStartMs": 1921200,
    "dDurationMs": 1925,
    "segs": [ {
      "utf8": "- Oh, I think that's\nhopeless for the moment."
    } ]
  }, {
    "tStartMs": 1923125,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "(Casper laughing)\nAnd if it yields."
    } ]
  }, {
    "tStartMs": 1924860,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "If it were to yield during our lifetimes,"
    } ]
  }, {
    "tStartMs": 1927230,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I wouldn't bet on it,"
    } ]
  }, {
    "tStartMs": 1928063,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "in fact, I would bet against it."
    } ]
  }, {
    "tStartMs": 1931130,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- See, the reason the circle method works"
    } ]
  }, {
    "tStartMs": 1933050,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for the weak Goldbach conjecture is"
    } ]
  }, {
    "tStartMs": 1934700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "because this main term grows\nfaster than this error term."
    } ]
  }, {
    "tStartMs": 1938600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But that's not the case for\nthe strong Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 1941660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- The major arcs are no longer major."
    } ]
  }, {
    "tStartMs": 1944000,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The main contribution\ncomes from the minor arc."
    } ]
  }, {
    "tStartMs": 1947270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So at least as much of the contribution"
    } ]
  }, {
    "tStartMs": 1949100,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "comes from the minor arcs."
    } ]
  }, {
    "tStartMs": 1950840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- So, to solve the strong conjecture,"
    } ]
  }, {
    "tStartMs": 1952730,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "we need some fundamentally\nnew technique, or approach,"
    } ]
  }, {
    "tStartMs": 1956180,
    "dDurationMs": 1774,
    "segs": [ {
      "utf8": "but we haven't found it yet."
    } ]
  }, {
    "tStartMs": 1957954,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(tense classical music playing)"
    } ]
  }, {
    "tStartMs": 1958787,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "- The person who arguably got the closest"
    } ]
  }, {
    "tStartMs": 1961310,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "was Chen Jingrun."
    } ]
  }, {
    "tStartMs": 1962560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(pen scratching)"
    } ]
  }, {
    "tStartMs": 1963393,
    "dDurationMs": 4217,
    "segs": [ {
      "utf8": "In 1956, Chen was recognized\nfor his mathematical prowess,"
    } ]
  }, {
    "tStartMs": 1967610,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and, a year later, he became an assistant"
    } ]
  }, {
    "tStartMs": 1969950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "at the Chinese Academy of Sciences,"
    } ]
  }, {
    "tStartMs": 1972110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "where he spent the next 10\nyears working on problems"
    } ]
  }, {
    "tStartMs": 1974510,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "in number theory,"
    } ]
  }, {
    "tStartMs": 1975530,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "including Goldbach's conjecture."
    } ]
  }, {
    "tStartMs": 1978290,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "By 1966, he hit a major breakthrough."
    } ]
  }, {
    "tStartMs": 1981500,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "By using another approach,\nknown as sieve methods,"
    } ]
  }, {
    "tStartMs": 1984590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "he proved that every\nsufficiently large even number"
    } ]
  }, {
    "tStartMs": 1987800,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "is the sum of a prime and a\nnumber that's either a prime,"
    } ]
  }, {
    "tStartMs": 1991190,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or the product of exactly two primes,"
    } ]
  }, {
    "tStartMs": 1993770,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "what we call a semi prime."
    } ]
  }, {
    "tStartMs": 1995990,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- It's a very learned and brilliant proof."
    } ]
  }, {
    "tStartMs": 1998810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I think Andre Weil compared\nfollowing his proof,"
    } ]
  }, {
    "tStartMs": 2001450,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "is like climbing along"
    } ]
  }, {
    "tStartMs": 2002530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the top of the Himalayas.\n(wind whooshing)"
    } ]
  }, {
    "tStartMs": 2004690,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "You know, that you're way up high"
    } ]
  }, {
    "tStartMs": 2006310,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "in (laughing) practically\nthe stratosphere."
    } ]
  }, {
    "tStartMs": 2009250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It's such a sophisticated argument."
    } ]
  }, {
    "tStartMs": 2011560,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- This was the closest anyone had gotten"
    } ]
  }, {
    "tStartMs": 2013780,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to solving the problem.\n(playful music continuing)"
    } ]
  }, {
    "tStartMs": 2015220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Elated, Chen showed the\nproof to a colleague,"
    } ]
  }, {
    "tStartMs": 2017770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "who suggested he should\nannounce the result,"
    } ]
  }, {
    "tStartMs": 2020140,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "and then tidy it up before publishing."
    } ]
  }, {
    "tStartMs": 2023110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- But just as Chen announced his result,"
    } ]
  }, {
    "tStartMs": 2026020,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "the country plunged into chaos."
    } ]
  }, {
    "tStartMs": 2028565,
    "dDurationMs": 1145,
    "segs": [ {
      "utf8": "(dramatic music)\n(crowd shouting)"
    } ]
  }, {
    "tStartMs": 2029710,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] In May, 1966,"
    } ]
  }, {
    "tStartMs": 2031360,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "chairman of the Communist\nParty, Mao Zedong, declared"
    } ]
  }, {
    "tStartMs": 2034030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that bourgeois elements had\ninfiltrated the government"
    } ]
  }, {
    "tStartMs": 2036520,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "and society,"
    } ]
  }, {
    "tStartMs": 2037360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and they must be purged."
    } ]
  }, {
    "tStartMs": 2039310,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This marked the start of\nthe Cultural Revolution,"
    } ]
  }, {
    "tStartMs": 2042070,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "a radical campaign to defeat\nperceived enemies of the Party."
    } ]
  }, {
    "tStartMs": 2045820,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "With support from Mao,"
    } ]
  }, {
    "tStartMs": 2047350,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "militant student revolutionaries,"
    } ]
  }, {
    "tStartMs": 2048880,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "known as the Red Guard,\n(soldiers marching)"
    } ]
  }, {
    "tStartMs": 2049990,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "stormed institutions.\n(soldiers marching)"
    } ]
  }, {
    "tStartMs": 2051520,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "They burned books and\nturned on intellectuals."
    } ]
  }, {
    "tStartMs": 2055240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Teachers, scientists, and\nprofessors were subjected"
    } ]
  }, {
    "tStartMs": 2057520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to brutal public spectacles,"
    } ]
  }, {
    "tStartMs": 2059200,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "known as struggle sessions."
    } ]
  }, {
    "tStartMs": 2060970,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They were beaten, humiliated,"
    } ]
  }, {
    "tStartMs": 2062590,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and forced to wear towering caps,"
    } ]
  }, {
    "tStartMs": 2064750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and placards listing\ntheir supposed crimes,"
    } ]
  }, {
    "tStartMs": 2067060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "like capitalist sympathizer"
    } ]
  }, {
    "tStartMs": 2069040,
    "dDurationMs": 1854,
    "segs": [ {
      "utf8": "or enemy of the revolution."
    } ]
  }, {
    "tStartMs": 2070894,
    "dDurationMs": 1896,
    "segs": [ {
      "utf8": "(emotional soft music)\nAcross China,"
    } ]
  }, {
    "tStartMs": 2072790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the pursuit of knowledge\nwas replaced by fear"
    } ]
  }, {
    "tStartMs": 2075130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and political conflict."
    } ]
  }, {
    "tStartMs": 2077230,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "By 1968, 131 of the 171 senior members"
    } ]
  }, {
    "tStartMs": 2081640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "of the Chinese Academy\nof Sciences in Beijing"
    } ]
  }, {
    "tStartMs": 2084100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "faced persecution."
    } ]
  }, {
    "tStartMs": 2085480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And many others lost their lives."
    } ]
  }, {
    "tStartMs": 2088240,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "- Chen was one of the targets."
    } ]
  }, {
    "tStartMs": 2090397,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(shove rattling)\nHe was forced"
    } ]
  }, {
    "tStartMs": 2091230,
    "dDurationMs": 894,
    "segs": [ {
      "utf8": "into manual labor,"
    } ]
  }, {
    "tStartMs": 2092124,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(fire crackling)\nand made to live"
    } ]
  }, {
    "tStartMs": 2092957,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "in a converted boiler\nroom with no electricity."
    } ]
  }, {
    "tStartMs": 2095835,
    "dDurationMs": 1615,
    "segs": [ {
      "utf8": "(shove rattling)\nThe Red Guard insulted him,"
    } ]
  }, {
    "tStartMs": 2097450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "spat on him,"
    } ]
  }, {
    "tStartMs": 2098283,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "and beat him so badly that\nChen often lost consciousness."
    } ]
  }, {
    "tStartMs": 2102940,
    "dDurationMs": 1379,
    "segs": [ {
      "utf8": "- In one report, it was so bad"
    } ]
  }, {
    "tStartMs": 2104319,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "that he may have tried to commit suicide."
    } ]
  }, {
    "tStartMs": 2108040,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "He jumped off of a third story building"
    } ]
  }, {
    "tStartMs": 2111850,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and, fortunately, didn't hit the ground."
    } ]
  }, {
    "tStartMs": 2115420,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "He landed on the second\nfloor, and got injured,"
    } ]
  }, {
    "tStartMs": 2118990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but didn't die."
    } ]
  }, {
    "tStartMs": 2121060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Derek] Despite all of this,\n(tense music playing)"
    } ]
  }, {
    "tStartMs": 2122800,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Chen kept secretly working on his math"
    } ]
  }, {
    "tStartMs": 2125890,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "under the dim light of a kerosene lamp."
    } ]
  }, {
    "tStartMs": 2129220,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "Then on the 13th of September,"
    } ]
  }, {
    "tStartMs": 2130779,
    "dDurationMs": 1171,
    "segs": [ {
      "utf8": "(plane whirring)\n1971,"
    } ]
  }, {
    "tStartMs": 2131950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Mao's right-hand man died\n(camera clicking)"
    } ]
  }, {
    "tStartMs": 2133810,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "in a mysterious plane crash.\n(camera clicking)"
    } ]
  }, {
    "tStartMs": 2135700,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "After supposedly trying organize a coup."
    } ]
  }, {
    "tStartMs": 2139060,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "His death shattered the\nillusion of unity in the Party,"
    } ]
  }, {
    "tStartMs": 2142001,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "(clicker clicking)\nand the cultural revolution"
    } ]
  }, {
    "tStartMs": 2143740,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "began to lose steam.\n(clicker clicking)"
    } ]
  }, {
    "tStartMs": 2146657,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "(bright dramatic music)\n- But Chen faced a dilemma."
    } ]
  }, {
    "tStartMs": 2148420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "On the one hand, he wanted\nto publish his proof,"
    } ]
  }, {
    "tStartMs": 2150910,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but on the other he was\nterrified of being criticized,"
    } ]
  }, {
    "tStartMs": 2154210,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Unsure what to do, he\nturned to Luo Shengxiong,"
    } ]
  }, {
    "tStartMs": 2156730,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the head of the mathematical institute,"
    } ]
  }, {
    "tStartMs": 2159070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "who told him, \"The result is sound."
    } ]
  }, {
    "tStartMs": 2162250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "You must publish.\"\n(dramatic music continuing)"
    } ]
  }, {
    "tStartMs": 2164830,
    "dDurationMs": 4173,
    "segs": [ {
      "utf8": "- [Derek] And so in April, 1973,\nChen published his theorem."
    } ]
  }, {
    "tStartMs": 2170050,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Three years later, Mao Zedong died"
    } ]
  }, {
    "tStartMs": 2172390,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "and the Cultural Revolution ended."
    } ]
  }, {
    "tStartMs": 2176200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Famous journalist, Xu Chi\ntook note of Chen's story,"
    } ]
  }, {
    "tStartMs": 2179560,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "and wrote an article about\nhis achievements and hardship."
    } ]
  }, {
    "tStartMs": 2182394,
    "dDurationMs": 1636,
    "segs": [ {
      "utf8": "(uplifting music)\nThe article was reprinted"
    } ]
  }, {
    "tStartMs": 2184030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "in China's most popular newspaper,"
    } ]
  }, {
    "tStartMs": 2185770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and read by millions."
    } ]
  }, {
    "tStartMs": 2187330,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The State that, just 10\nyears earlier, silenced Chen"
    } ]
  }, {
    "tStartMs": 2190390,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "now celebrated him as a national hero."
    } ]
  }, {
    "tStartMs": 2193450,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "His story was retold in\nschools, books, and films."
    } ]
  }, {
    "tStartMs": 2197800,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "He even got an asteroid\nnamed after him in 1996."
    } ]
  }, {
    "tStartMs": 2202600,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- And imagine if he\nhadn't done it, you know,"
    } ]
  }, {
    "tStartMs": 2204670,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "if he hadn't published it."
    } ]
  }, {
    "tStartMs": 2205990,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Like all his work, his whole mission,"
    } ]
  }, {
    "tStartMs": 2207580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "his whole ideals, his whole vision,"
    } ]
  }, {
    "tStartMs": 2209560,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "maybe no one would've known about it."
    } ]
  }, {
    "tStartMs": 2210660,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "It would've just been a\nlittle line somewhere,"
    } ]
  }, {
    "tStartMs": 2213550,
    "dDurationMs": 1545,
    "segs": [ {
      "utf8": "like, \"Oh, I've got this proof, but, yeah,"
    } ]
  }, {
    "tStartMs": 2215095,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "I'm not gonna show it to you.\""
    } ]
  }, {
    "tStartMs": 2216850,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You know?"
    } ]
  }, {
    "tStartMs": 2217683,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "But so often we like shoot ourselves down,"
    } ]
  }, {
    "tStartMs": 2219640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "whereas really do your best"
    } ]
  }, {
    "tStartMs": 2221590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and then put it out into the world,"
    } ]
  }, {
    "tStartMs": 2222970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and then let the world,\nsort of, like evaluate it."
    } ]
  }, {
    "tStartMs": 2225850,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And while Chen got incredibly close,"
    } ]
  }, {
    "tStartMs": 2228610,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "he was never able to\nfulfill his ultimate dream,"
    } ]
  }, {
    "tStartMs": 2231250,
    "dDurationMs": 2876,
    "segs": [ {
      "utf8": "to solve the strong Goldbach conjecture."
    } ]
  }, {
    "tStartMs": 2234126,
    "dDurationMs": 1204,
    "segs": [ {
      "utf8": "(dramatic music playing)\nPerhaps one reason"
    } ]
  }, {
    "tStartMs": 2235330,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "why it's so hard to prove true is"
    } ]
  }, {
    "tStartMs": 2237250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "because maybe it's not."
    } ]
  }, {
    "tStartMs": 2238900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Maybe it's false."
    } ]
  }, {
    "tStartMs": 2240430,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "But if it is false,"
    } ]
  }, {
    "tStartMs": 2241690,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "then there's a very easy way to show that,"
    } ]
  }, {
    "tStartMs": 2243940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "by finding a counter example."
    } ]
  }, {
    "tStartMs": 2245800,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "A single even number"
    } ]
  }, {
    "tStartMs": 2247210,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that can't be written as\nthe sum of two primes."
    } ]
  }, {
    "tStartMs": 2250090,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- If Goldbach is false,"
    } ]
  }, {
    "tStartMs": 2251380,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "it would be very easy\nfor you to convince me"
    } ]
  }, {
    "tStartMs": 2252973,
    "dDurationMs": 1737,
    "segs": [ {
      "utf8": "that Goldbach is false."
    } ]
  }, {
    "tStartMs": 2254710,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Just find a counter example."
    } ]
  }, {
    "tStartMs": 2256300,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- That is the only way"
    } ]
  }, {
    "tStartMs": 2257530,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that you can convince me\nthat Goldbach is false."
    } ]
  }, {
    "tStartMs": 2259510,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "If Goldbach is false,"
    } ]
  }, {
    "tStartMs": 2260560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "then it's false because\nthere's a counter example."
    } ]
  }, {
    "tStartMs": 2262600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And if there's a counter example,"
    } ]
  }, {
    "tStartMs": 2263433,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "then you can give me the counter example,"
    } ]
  }, {
    "tStartMs": 2264760,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "and I can check for myself,"
    } ]
  }, {
    "tStartMs": 2265750,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "then, yes, that's a counter example."
    } ]
  }, {
    "tStartMs": 2267550,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Casper] In this pursuit, in 1938,"
    } ]
  }, {
    "tStartMs": 2269530,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "a mathematician, named Nils Pipping,"
    } ]
  }, {
    "tStartMs": 2271480,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "checked all numbers up to a\nhundred thousand, by hand,"
    } ]
  }, {
    "tStartMs": 2274990,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but he didn't find a\nsingle counterexample."
    } ]
  }, {
    "tStartMs": 2278140,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Since then, modern computers\nhave brought this number up"
    } ]
  }, {
    "tStartMs": 2280840,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to four quintillion,"
    } ]
  }, {
    "tStartMs": 2282880,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "and the conjecture holds for\nevery single one of them."
    } ]
  }, {
    "tStartMs": 2287140,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] In fact,"
    } ]
  }, {
    "tStartMs": 2287973,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "we can also use computers to check"
    } ]
  }, {
    "tStartMs": 2289570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in just how many ways a\ndifferent number can be written"
    } ]
  }, {
    "tStartMs": 2292210,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "as the sum of two primes,"
    } ]
  }, {
    "tStartMs": 2293684,
    "dDurationMs": 2306,
    "segs": [ {
      "utf8": "(bright music)\nwhich gives us this pattern."
    } ]
  }, {
    "tStartMs": 2295990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It looks like a curve with tails,"
    } ]
  }, {
    "tStartMs": 2298480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "it strongly resembles a comet,"
    } ]
  }, {
    "tStartMs": 2301060,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "which is why this is\nknown as Goldbach's comet."
    } ]
  }, {
    "tStartMs": 2304360,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "It shows that as the number gets larger,"
    } ]
  }, {
    "tStartMs": 2306490,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "there are more and more ways\nto write every even number"
    } ]
  }, {
    "tStartMs": 2309610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "as the sum of two primes."
    } ]
  }, {
    "tStartMs": 2311290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And if we overlay our\nheuristic argument from before,"
    } ]
  }, {
    "tStartMs": 2314170,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "we find that it matches\nup remarkably well."
    } ]
  }, {
    "tStartMs": 2318340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- The one way the conjecture\ncould be false is if,"
    } ]
  }, {
    "tStartMs": 2320860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "for whatever reason, at\nsome very large number,"
    } ]
  }, {
    "tStartMs": 2323980,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "there's a conspiracy where\nthis completely breaks down,"
    } ]
  }, {
    "tStartMs": 2327070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and it suddenly drops below that line."
    } ]
  }, {
    "tStartMs": 2329080,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Are there any examples"
    } ]
  }, {
    "tStartMs": 2330070,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "where you suddenly have a big drop"
    } ]
  }, {
    "tStartMs": 2331900,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "in the number of ways you can compose"
    } ]
  }, {
    "tStartMs": 2334150,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "a number?\n- No, no,"
    } ]
  }, {
    "tStartMs": 2335020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "those asymptotics seem\nto hold very nicely."
    } ]
  }, {
    "tStartMs": 2337480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "There are no big drops."
    } ]
  }, {
    "tStartMs": 2339460,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- [Derek] So it seems like\nthe conjecture should be true."
    } ]
  }, {
    "tStartMs": 2343330,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- We've tested, by brute force,"
    } ]
  }, {
    "tStartMs": 2344590,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "all the numbers up to four quintillion,"
    } ]
  }, {
    "tStartMs": 2346270,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and they all obey Goldbach's conjecture."
    } ]
  }, {
    "tStartMs": 2348730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So you might think"
    } ]
  }, {
    "tStartMs": 2350020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that we should have found\na counterexample by now,"
    } ]
  }, {
    "tStartMs": 2352150,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "or, at least, a number"
    } ]
  }, {
    "tStartMs": 2353740,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that doesn't follow this\ngeneral trend we've seen."
    } ]
  }, {
    "tStartMs": 2356440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But, on the scale of all numbers,"
    } ]
  }, {
    "tStartMs": 2358540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "four quintillion is nothing."
    } ]
  }, {
    "tStartMs": 2360580,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So we'll have to come up\nwith some smart approach,"
    } ]
  }, {
    "tStartMs": 2363160,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "or fundamentally new way,\nof solving this problem."
    } ]
  }, {
    "tStartMs": 2366790,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Now, as far as we know,"
    } ]
  }, {
    "tStartMs": 2368140,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "solving Goldbach's conjecture\ndoesn't really affect"
    } ]
  }, {
    "tStartMs": 2370330,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "any other areas of math."
    } ]
  }, {
    "tStartMs": 2372130,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And it also doesn't seem to\nhave any direct applications"
    } ]
  }, {
    "tStartMs": 2374770,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "to the real world."
    } ]
  }, {
    "tStartMs": 2375940,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So you might think, why\nbother solving this problem?"
    } ]
  }, {
    "tStartMs": 2379240,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Why not work on some big problem\nthat we know is important?"
    } ]
  }, {
    "tStartMs": 2383140,
    "dDurationMs": 1587,
    "segs": [ {
      "utf8": "But I think that misses the point."
    } ]
  }, {
    "tStartMs": 2384727,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(gentle inquisitive music)"
    } ]
  }, {
    "tStartMs": 2385560,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- What if the Goldbach\nconjectures turns out"
    } ]
  }, {
    "tStartMs": 2387760,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "it is opening up a whole\nnew part of the multiverse"
    } ]
  }, {
    "tStartMs": 2391390,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "of mathematical ideas."
    } ]
  }, {
    "tStartMs": 2392710,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "We don't really know"
    } ]
  }, {
    "tStartMs": 2393580,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "'cause we don't have the bird's eye view,"
    } ]
  }, {
    "tStartMs": 2395770,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or the God's eye view, of math."
    } ]
  }, {
    "tStartMs": 2397510,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It's what it looks like to us\nright now on the web of math."
    } ]
  }, {
    "tStartMs": 2400690,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So, I tend to dislike this picture"
    } ]
  }, {
    "tStartMs": 2403600,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "of certain things are central\n(inquisitive music continuing)"
    } ]
  }, {
    "tStartMs": 2405340,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and other things are peripheral."
    } ]
  }, {
    "tStartMs": 2406960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "People should do what fires them up."
    } ]
  }, {
    "tStartMs": 2409390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Because if you do that,\nyou'll be passionate,"
    } ]
  }, {
    "tStartMs": 2411970,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you'll think about it all the time."
    } ]
  }, {
    "tStartMs": 2413650,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "You'll do it when you're in the shower."
    } ]
  }, {
    "tStartMs": 2415600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "You'll think about it when you're driving."
    } ]
  }, {
    "tStartMs": 2417820,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And you might do something remarkable"
    } ]
  }, {
    "tStartMs": 2419890,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "because of that passion."
    } ]
  }, {
    "tStartMs": 2421720,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And if you're just doing something"
    } ]
  }, {
    "tStartMs": 2423010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "'cause you think it's important,"
    } ]
  }, {
    "tStartMs": 2425110,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "I think you'll tend to be second\nrate, honestly. (laughing)"
    } ]
  }, {
    "tStartMs": 2428770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "I like the modest view"
    } ]
  }, {
    "tStartMs": 2430660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that we don't know what's\nnecessarily important,"
    } ]
  }, {
    "tStartMs": 2432850,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but we do know what we love."
    } ]
  }, {
    "tStartMs": 2434920,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "So work on that."
    } ]
  }, {
    "tStartMs": 2436505,
    "dDurationMs": 4625,
    "segs": [ {
      "utf8": "(electronics whirring)\n(inquisitive music continuing)"
    } ]
  }, {
    "tStartMs": 2441130,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Goldbach's conjecture\nfrustrated mathematicians"
    } ]
  }, {
    "tStartMs": 2443620,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "for centuries."
    } ]
  }, {
    "tStartMs": 2444730,
    "dDurationMs": 837,
    "segs": [ {
      "utf8": "And, for a long time,"
    } ]
  }, {
    "tStartMs": 2445567,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "(wind whooshing)\nit seemed like"
    } ]
  }, {
    "tStartMs": 2446680,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "an unsolvable problem."
    } ]
  }, {
    "tStartMs": 2448990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Many gave up,"
    } ]
  }, {
    "tStartMs": 2449823,
    "dDurationMs": 2587,
    "segs": [ {
      "utf8": "thinking it was just too big to tackle."
    } ]
  }, {
    "tStartMs": 2452410,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "But as we've seen,"
    } ]
  }, {
    "tStartMs": 2453280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it only takes a few incredibly\ndetermined individuals"
