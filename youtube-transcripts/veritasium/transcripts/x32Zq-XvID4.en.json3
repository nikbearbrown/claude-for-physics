  }, {
    "tStartMs": 2456160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "who reject the status quo"
    } ]
  }, {
    "tStartMs": 2457570,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "to keep pushing towards a solution."
    } ]
  }, {
    "tStartMs": 2460120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And it's not just big math problems."
    } ]
  }, {
    "tStartMs": 2461890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Life is full of inconveniences\n(bright happy music)"
