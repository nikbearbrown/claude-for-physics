  }, {
    "tStartMs": 2522220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that can cause skin irritation."
    } ]
  }, {
    "tStartMs": 2524500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "If you want a better shaving experience,"
