{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 2404,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "- [Zac] Are you all\nright to grab the back end?"
    } ]
  }, {
    "tStartMs": 3713,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "- [Derek] Uh, well, not at the moment."
    } ]
  }, {
    "tStartMs": 5147,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Not yet."
    } ]
  }, {
    "tStartMs": 6677,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Get him up."
    } ]
  }, {
    "tStartMs": 7510,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "You gotta lock him in."
    } ]
  }, {
    "tStartMs": 11010,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "A scratch from this\nspecies will knock you."
    } ]
  }, {
    "tStartMs": 13830,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Knock you down..."
    } ]
  }, {
    "tStartMs": 15000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Could kill you? Or..."
    } ]
  }, {
    "tStartMs": 15833,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "- Oh definitely, yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 17193,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 18980,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "So I am back in Australia,"
    } ]
  }, {
    "tStartMs": 20640,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "and, of course, I'm a reminded"
    } ]
  }, {
    "tStartMs": 21740,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that everything in this\ncountry is trying to kill you,"
    } ]
  }, {
    "tStartMs": 24170,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "particularly snakes and spiders,"
    } ]
  }, {
    "tStartMs": 26020,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "and here at the Australian Reptile Park"
    } ]
  }, {
    "tStartMs": 28230,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "they actually milk snakes and spiders"
    } ]
  }, {
    "tStartMs": 30440,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "so they can use their\nvenom to make antivenom"
    } ]
  }, {
    "tStartMs": 33260,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and save lives."
    } ]
  }, {
    "tStartMs": 34490,
    "dDurationMs": 1907,
    "segs": [ {
      "utf8": "Let's go see how they do it."
    } ]
  }, {
    "tStartMs": 36397,
    "dDurationMs": 1063,
    "segs": [ {
      "utf8": "- All right, so come on in, man."
    } ]
  }, {
    "tStartMs": 37460,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "This is without a doubt"
    } ]
  }, {
    "tStartMs": 38540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "the most dangerous room in the country."
    } ]
  }, {
    "tStartMs": 40560,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "You're currently\nsurrounded floor to ceiling"
    } ]
  }, {
    "tStartMs": 42130,
    "dDurationMs": 1063,
    "segs": [ {
      "utf8": "with venomous snakes."
    } ]
  }, {
    "tStartMs": 48800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- And the only thing\nthat keeps the snakes in"
    } ]
  }, {
    "tStartMs": 50400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "is those little locks?"
    } ]
  }, {
    "tStartMs": 52320,
    "dDurationMs": 2315,
    "segs": [ {
      "utf8": "- Yeah, just the little\nlocks and the thin glass."
    } ]
  }, {
    "tStartMs": 54635,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 58904,
    "dDurationMs": 1196,
    "segs": [ {
      "utf8": "- [Derek] Did a snake actually do that?"
    } ]
  }, {
    "tStartMs": 60100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 60933,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So a kid was tapping on the glass."
    } ]
  }, {
    "tStartMs": 61766,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I told him not to,"
    } ]
  }, {
    "tStartMs": 62599,
    "dDurationMs": 1011,
    "segs": [ {
      "utf8": "his parents are like nah, it's all good."
    } ]
  }, {
    "tStartMs": 63610,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "And I'm like, don't tap on the glass, man."
    } ]
  }, {
    "tStartMs": 64710,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "The snake goes, (thumps fist)"
    } ]
  }, {
    "tStartMs": 65740,
    "dDurationMs": 3595,
    "segs": [ {
      "utf8": "The kid ran out with the\nsmelling of a crap, so yeah."
    } ]
  }, {
    "tStartMs": 69335,
    "dDurationMs": 1105,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 70440,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- For real?\n- Yeah, oh yeah."
    } ]
  }, {
    "tStartMs": 71550,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "He went (mimics a kid screaming)"
    } ]
  }, {
    "tStartMs": 72952,
    "dDurationMs": 1715,
    "segs": [ {
      "utf8": "He went screaming out the room."
    } ]
  }, {
    "tStartMs": 75950,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "In Australia we lose one\nto three people per annum"
    } ]
  }, {
    "tStartMs": 78460,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "to snake bite."
    } ]
  }, {
    "tStartMs": 79630,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Internationally estimates by\nthe World Health Organization"
    } ]
  }, {
    "tStartMs": 82040,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "is 120,000."
    } ]
  }, {
    "tStartMs": 84090,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "So not only do we have some of the best"
    } ]
  }, {
    "tStartMs": 85550,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "antivenom products\nanywhere on the planet,"
    } ]
  }, {
    "tStartMs": 87480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but we have a federally\nfunded antivenom program,"
    } ]
  }, {
    "tStartMs": 89610,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "which means no matter who you are,"
    } ]
  }, {
    "tStartMs": 91160,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "you get antivenom for free."
    } ]
  }, {
    "tStartMs": 93610,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "So we'll probably play\nwith a big coastal taipan"
    } ]
  }, {
    "tStartMs": 96030,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to start with."
    } ]
  }, {
    "tStartMs": 96863,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 97696,
    "dDurationMs": 2004,
    "segs": [ {
      "utf8": "So why are we starting big?"
    } ]
  }, {
    "tStartMs": 99700,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Oh we may as well.\n(Derek laughs)"
    } ]
  }, {
    "tStartMs": 100780,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "- You tell me what I need to do."
    } ]
  }, {
    "tStartMs": 101820,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Righty-O"
    } ]
  }, {
    "tStartMs": 102653,
    "dDurationMs": 1277,
    "segs": [ {
      "utf8": "I'm just gonna grab a vial from behind you"
    } ]
  }, {
    "tStartMs": 103930,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "'cause obviously we use"
    } ]
  }, {
    "tStartMs": 104763,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "only the most highly scientific\npieces of equipment here"
    } ]
  }, {
    "tStartMs": 106660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "at the Reptile Park."
    } ]
  }, {
    "tStartMs": 107493,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Got it."
    } ]
  }, {
    "tStartMs": 108326,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It's our shot glass.\n- Beautiful."
    } ]
  }, {
    "tStartMs": 109159,
    "dDurationMs": 1391,
    "segs": [ {
      "utf8": "- And I might even get\nyou to hold that for me"
    } ]
  }, {
    "tStartMs": 110550,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Great.\n- For a second."
    } ]
  }, {
    "tStartMs": 111383,
    "dDurationMs": 1577,
    "segs": [ {
      "utf8": "This is one of our big boys."
    } ]
  }, {
    "tStartMs": 112960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Hopefully he's in a good mood."
    } ]
  }, {
    "tStartMs": 116530,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "As you can see, quite a large individual."
    } ]
  }, {
    "tStartMs": 119100,
    "dDurationMs": 923,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 120930,
    "dDurationMs": 1693,
    "segs": [ {
      "utf8": "- Now what we're gonna do."
    } ]
  }, {
    "tStartMs": 123540,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 124373,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Is pin him."
    } ]
  }, {
    "tStartMs": 126700,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "Now, wait, wait, wait."
    } ]
  }, {
    "tStartMs": 128275,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Get him up."
    } ]
  }, {
    "tStartMs": 129108,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Righty-O"
    } ]
  }, {
    "tStartMs": 129941,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There you go, you hold that,"
    } ]
  }, {
    "tStartMs": 130774,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I'll take that vial off you."
    } ]
  }, {
    "tStartMs": 131607,
    "dDurationMs": 1362,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 132969,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "(Nervous laughter)"
    } ]
  }, {
    "tStartMs": 135160,
    "dDurationMs": 1728,
    "segs": [ {
      "utf8": "This feels absurd."
    } ]
  }, {
    "tStartMs": 136888,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- There we go."
    } ]
  }, {
    "tStartMs": 137721,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "As you can see, he's keen on the killing."
    } ]
  }, {
    "tStartMs": 138880,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Now snakes aren't stupid."
    } ]
  }, {
    "tStartMs": 140040,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "He doesn't wanna bite the jar,"
    } ]
  }, {
    "tStartMs": 140950,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "he wants to bite me."
    } ]
  }, {
    "tStartMs": 141830,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "Finger is the target."
    } ]
  }, {
    "tStartMs": 145488,
    "dDurationMs": 2012,
    "segs": [ {
      "utf8": "(Laughs hysterically)"
    } ]
  }, {
    "tStartMs": 147500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There we go."
    } ]
  }, {
    "tStartMs": 148333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "- Oh my goodness."
    } ]
  }, {
    "tStartMs": 150500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "That was a lot of venom\ndelivered very quickly."
    } ]
  }, {
    "tStartMs": 153020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- Yeah, they're not mucking around."
    } ]
  }, {
    "tStartMs": 155180,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 156740,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- Now what we'll do is we'll\nactually give his venom glands"
    } ]
  }, {
    "tStartMs": 158710,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "a little bit of a massage."
    } ]
  }, {
    "tStartMs": 159543,
    "dDurationMs": 1927,
    "segs": [ {
      "utf8": "So what you would consider his cheeks,"
    } ]
  }, {
    "tStartMs": 161470,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "give them a little bit of a roll,"
    } ]
  }, {
    "tStartMs": 163190,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "see if we can get an extra drop or two"
    } ]
  }, {
    "tStartMs": 164560,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "'cause every drop matters."
    } ]
  }, {
    "tStartMs": 165740,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "- [Derek] Uh-huh."
    } ]
  }, {
    "tStartMs": 167130,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "- Now, because my hand's\nstarting to cramp up,"
    } ]
  }, {
    "tStartMs": 169460,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I'm gonna put him away."
    } ]
  }, {
    "tStartMs": 170293,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "So I'll get you guys to jump back for me."
    } ]
  }, {
    "tStartMs": 172170,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And this is the sketchy bit."
    } ]
  }, {
    "tStartMs": 173530,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 174363,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "- When you get him out, you got the hook,"
    } ]
  }, {
    "tStartMs": 175600,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "when you're putting him back,"
    } ]
  }, {
    "tStartMs": 177530,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "it's just who's quicker."
    } ]
  }, {
    "tStartMs": 180440,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Ready?"
    } ]
  }, {
    "tStartMs": 184439,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Two."
    } ]
  }, {
    "tStartMs": 185519,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "(cage door shuts)"
    } ]
  }, {
    "tStartMs": 187820,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "- Are your hands trembling a little bit?"
    } ]
  }, {
    "tStartMs": 188760,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "- Yeah, every time.\n- Look at that"
    } ]
  }, {
    "tStartMs": 191950,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "So how much venom do you actually need"
    } ]
  }, {
    "tStartMs": 193680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to make antivenom?"
    } ]
  }, {
    "tStartMs": 195180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Zac] About 15."
    } ]
  }, {
    "tStartMs": 196380,
    "dDurationMs": 2129,
    "segs": [ {
      "utf8": "- [Derek] 15 snakes to make\none vial of antivenom?"
    } ]
  }, {
    "tStartMs": 198509,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 200090,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- [Derek] Venom evolved from saliva"
    } ]
  }, {
    "tStartMs": 202050,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "and it's used primarily for\ncatching and digesting prey."
    } ]
  }, {
    "tStartMs": 205690,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Each species of snake\nhas a different venom"
    } ]
  }, {
    "tStartMs": 208370,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "tailored to the specific\nanimals they hunt."
    } ]
  }, {
    "tStartMs": 211780,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "The venom was originally squirted"
    } ]
  }, {
    "tStartMs": 213750,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "into a snake's mouth by the back teeth,"
    } ]
  }, {
    "tStartMs": 216370,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "and to this day,"
    } ]
  }, {
    "tStartMs": 217310,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "almost 2/3 of all snakes are rear fanged."
    } ]
  }, {
    "tStartMs": 220800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- Now why the rear tooth, you might ask?"
    } ]
  }, {
    "tStartMs": 222960,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "Well, it's because the venom gland itself"
    } ]
  }, {
    "tStartMs": 225430,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "is actually behind the snake's eye."
    } ]
  }, {
    "tStartMs": 227720,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So the shortest distance for a duct"
    } ]
  }, {
    "tStartMs": 230320,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "is directly downwards to\nthe back end of the top jaw."
    } ]
  }, {
    "tStartMs": 235120,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "- [Derek] In some species,"
    } ]
  }, {
    "tStartMs": 236300,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "evolutionary pressures caused\nthe fangs to move closer"
    } ]
  }, {
    "tStartMs": 239230,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and closer to the front of the jaw,"
    } ]
  }, {
    "tStartMs": 241280,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "improving the snake's ability\nto catch and kill prey."
    } ]
  }, {
    "tStartMs": 245040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "While the location of\nthe fangs was evolving,"
    } ]
  }, {
    "tStartMs": 247600,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so were the fangs themselves."
    } ]
  }, {
    "tStartMs": 249670,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "They started off as smooth ordinary teeth"
    } ]
  }, {
    "tStartMs": 252320,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "with venom flowing down the outside,"
    } ]
  }, {
    "tStartMs": 255030,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "but over time,"
    } ]
  }, {
    "tStartMs": 256210,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "some snake lineages evolved\na groove in each fang"
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "to channel the flow of venom."
    } ]
  }, {
    "tStartMs": 261710,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "In some species, the groove\nbecame deeper and deeper"
    } ]
  }, {
    "tStartMs": 264940,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "eventually closing in\nto form a hollow tube,"
    } ]
  }, {
    "tStartMs": 268130,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and now the teeth literally\ninject venom into prey."
    } ]
  }, {
    "tStartMs": 272370,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "But this is not the norm."
    } ]
  }, {
    "tStartMs": 273920,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "Only 1/7 of the world's\nsnakes have hollow fangs,"
    } ]
  }, {
    "tStartMs": 277650,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "but, of course, almost all the\nvenomous snakes in Australia"
    } ]
  }, {
    "tStartMs": 280660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "do have hollow fangs,"
    } ]
  }, {
    "tStartMs": 282340,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "so we set up this macro\nshot to take a closer look."
    } ]
  }, {
    "tStartMs": 285420,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "- This one's rolling."
    } ]
  }, {
    "tStartMs": 286720,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "That one's rolling."
    } ]
  }, {
    "tStartMs": 287680,
    "dDurationMs": 977,
    "segs": [ {
      "utf8": "We're ready when you're."
    } ]
  }, {
    "tStartMs": 288657,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "- We're ready."
    } ]
  }, {
    "tStartMs": 289724,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Perfect."
    } ]
  }, {
    "tStartMs": 290557,
    "dDurationMs": 3917,
    "segs": [ {
      "utf8": "- All right, everyone's ready?\n- Yep."
    } ]
  }, {
    "tStartMs": 299500,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 300920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's got like jets"
    } ]
  }, {
    "tStartMs": 303080,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Jets of venom coming out."
    } ]
  }, {
    "tStartMs": 304980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Has this guy not been\nmilked in a while or?"
    } ]
  }, {
    "tStartMs": 306700,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "- Yeah, it's been a little while."
    } ]
  }, {
    "tStartMs": 310541,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 311910,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Not only do we have"
    } ]
  }, {
    "tStartMs": 312743,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "some of the most toxic\nsnakes on the planet here,"
    } ]
  }, {
    "tStartMs": 314940,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "we also selectively breed them"
    } ]
  }, {
    "tStartMs": 316350,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "for the production of antivenom."
    } ]
  }, {
    "tStartMs": 318470,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "They're bred to produce more venom"
    } ]
  }, {
    "tStartMs": 319790,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "than their wild counterparts."
    } ]
  }, {
    "tStartMs": 320980,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "So some of our coastal taipans\nare producing five, six"
    } ]
  }, {
    "tStartMs": 323880,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "nearly seven times what\ntheir wild counterpart would,"
    } ]
  }, {
    "tStartMs": 326380,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "and that's just from selective breeding."
    } ]
  }, {
    "tStartMs": 327650,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "You find your two most psychotic ones,"
    } ]
  }, {
    "tStartMs": 329020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "you put them together,"
    } ]
  }, {
    "tStartMs": 329853,
    "dDurationMs": 1998,
    "segs": [ {
      "utf8": "you hope for the best and\nthe absolute worst comes out."
    } ]
  }, {
    "tStartMs": 331851,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Laughs)"
    } ]
  }, {
    "tStartMs": 332684,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "So keeps you on your toes."
    } ]
  }, {
    "tStartMs": 334430,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- That sounds horrendous."
    } ]
  }, {
    "tStartMs": 335450,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "So you're saying that"
    } ]
  }, {
    "tStartMs": 336610,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "these are the most venomous\nsnakes in the world,"
    } ]
  }, {
    "tStartMs": 338840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and then you have bred\nthem to be more venomous?"
    } ]
  }, {
    "tStartMs": 341880,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "- Yeah, they're super snakes."
    } ]
  }, {
    "tStartMs": 344890,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "A scratch from any of these\nanimals could kill you."
    } ]
  }, {
    "tStartMs": 347120,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "And some of these snakes are giving 4.5,"
    } ]
  }, {
    "tStartMs": 349630,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "4.9 grams of venom per bite,"
    } ]
  }, {
    "tStartMs": 351630,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "which is just stupid amounts."
    } ]
  }, {
    "tStartMs": 353660,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- We spoke to venom\nexpert, Timothy Jackson"
    } ]
  }, {
    "tStartMs": 355910,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "who argued these snakes produce more venom"
    } ]
  }, {
    "tStartMs": 358300,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "because they are regularly\nmilked, unlike wild snakes."
    } ]
  }, {
    "tStartMs": 361910,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Either way, the snakes in\nthis room contain more venom"
    } ]
  }, {
    "tStartMs": 365370,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "than virtually any others on earth."
    } ]
  }, {
    "tStartMs": 368150,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- We house the second, the\nthird, the fourth, the fifth,"
    } ]
  }, {
    "tStartMs": 370750,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "and about the 12th or 13th most toxic,"
    } ]
  }, {
    "tStartMs": 372440,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "depending on who you talk to."
    } ]
  }, {
    "tStartMs": 374690,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "- [Derek] One bite from a King Cobra"
    } ]
  }, {
    "tStartMs": 376410,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "contains enough venom to kill 13,000 mice,"
    } ]
  }, {
    "tStartMs": 379940,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "and we know this because\nof a study from 1979"
    } ]
  }, {
    "tStartMs": 383040,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "that tested the venoms of 25\ndifferent species of snake"
    } ]
  }, {
    "tStartMs": 386180,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "on lab mice."
    } ]
  }, {
    "tStartMs": 387790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "From this, we can estimate"
    } ]
  }, {
    "tStartMs": 389170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that the venom from one King Cobra bite"
    } ]
  }, {
    "tStartMs": 391090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "could kill around four humans,"
    } ]
  }, {
    "tStartMs": 393700,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "though to be precise,"
    } ]
  }, {
    "tStartMs": 394980,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "we'd have to say four human-sized rodents"
    } ]
  }, {
    "tStartMs": 397830,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "because thankfully, no one's\ntested these venoms on humans."
    } ]
  }, {
    "tStartMs": 401650,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And by this measure,"
    } ]
  }, {
    "tStartMs": 402930,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "the most venomous snake in the\nworld is the inland taipan,"
    } ]
  }, {
    "tStartMs": 406750,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "which conveniently lives\nin the middle of Australia."
    } ]
  }, {
    "tStartMs": 410620,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "A bite from the inland taipan"
    } ]
  }, {
    "tStartMs": 412160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "has enough venom to kill\nhalf a million mice,"
    } ]
  }, {
    "tStartMs": 415520,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "or more than 100 humans."
    } ]
  }, {
    "tStartMs": 417910,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So yeah, why not milk that one next?"
    } ]
  }, {
    "tStartMs": 421330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- So the next one, we're gonna\nstep it up another notch."
    } ]
  }, {
    "tStartMs": 423340,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "So this is the inland taipan,"
    } ]
  }, {
    "tStartMs": 425130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "also known as the fierce snake,"
    } ]
  }, {
    "tStartMs": 426510,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "the most toxic land snake on the planet."
    } ]
  }, {
    "tStartMs": 428890,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "These guys have the ability\nwith one drop of venom"
    } ]
  }, {
    "tStartMs": 431320,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "to knock over 100 adult humans."
    } ]
  }, {
    "tStartMs": 433350,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "So stupidly toxic."
    } ]
  }, {
    "tStartMs": 435490,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So quite a lot smaller"
    } ]
  }, {
    "tStartMs": 436720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "than the last couple\nof animals we've used,"
    } ]
  }, {
    "tStartMs": 438240,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "but makes up for it in toxicity."
    } ]
  }, {
    "tStartMs": 440130,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Very, very quick and very\nnaughty when he wants to be,"
    } ]
  }, {
    "tStartMs": 443090,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "but an absolutely gorgeous pattern."
    } ]
  }, {
    "tStartMs": 446080,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "You can grab that bit for me, mate."
    } ]
  }, {
    "tStartMs": 447180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 448013,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "- I'm gonna grab this\nvial from behind you."
    } ]
  }, {
    "tStartMs": 450690,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And as you can see,"
    } ]
  }, {
    "tStartMs": 451523,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "he's very keen on the killing."
    } ]
  }, {
    "tStartMs": 456090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There we go."
    } ]
  }, {
    "tStartMs": 456923,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "- [Derek] That is extraordinary."
    } ]
  }, {
    "tStartMs": 458770,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "The most venomous snake in the world."
    } ]
  }, {
    "tStartMs": 463810,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "- Just incredible animals, aren't they?"
    } ]
  }, {
    "tStartMs": 466311,
    "dDurationMs": 2611,
    "segs": [ {
      "utf8": "(cage door shuts)"
    } ]
  }, {
    "tStartMs": 468922,
    "dDurationMs": 1025,
    "segs": [ {
      "utf8": "(laughs)"
    } ]
  }, {
    "tStartMs": 469947,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] That was quick."
    } ]
  }, {
    "tStartMs": 470780,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Yeah, those ones make me proper nervous."
    } ]
  }, {
    "tStartMs": 472130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I don't know about you guys,"
    } ]
  }, {
    "tStartMs": 472963,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but I'm sweating."
    } ]
  }, {
    "tStartMs": 473796,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "- [Derek] Can you see the hands?"
    } ]
  }, {
    "tStartMs": 475400,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "- The moment I stop doing\nthat after a milking"
    } ]
  }, {
    "tStartMs": 477390,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "is the day I quit."
    } ]
  }, {
    "tStartMs": 480240,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Derek] The concept of\nthe most venomous snake"
    } ]
  }, {
    "tStartMs": 482250,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "is complicated"
    } ]
  }, {
    "tStartMs": 483520,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "because snakes evolved\ntheir venom specifically"
    } ]
  }, {
    "tStartMs": 486120,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "for potency against their usual prey,"
    } ]
  }, {
    "tStartMs": 488570,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "in turn, their prey evolved\nresistance to their venom."
    } ]
  }, {
    "tStartMs": 491890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The honey badger, for example,"
    } ]
  }, {
    "tStartMs": 493780,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "is almost completely\nimmune to Cobra venom."
    } ]
  }, {
    "tStartMs": 496850,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "So the lethality of a\nbite depends on the snake,"
    } ]
  }, {
    "tStartMs": 500260,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "the animal that got bitten,"
    } ]
  }, {
    "tStartMs": 502130,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and the amount of venom injected."
    } ]
  }, {
    "tStartMs": 504590,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "The reason scientists test\ndifferent venoms on lab mice"
    } ]
  }, {
    "tStartMs": 507820,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "is to get an estimate of\nthe amount of antivenom"
    } ]
  }, {
    "tStartMs": 510630,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that would be required\nto neutralize a bite."
    } ]
  }, {
    "tStartMs": 513350,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Snake venom is lethal to us"
    } ]
  }, {
    "tStartMs": 515370,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "because we are closely\nrelated to snakes' main prey,"
    } ]
  }, {
    "tStartMs": 518560,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "rodents."
    } ]
  }, {
    "tStartMs": 519590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Rodents and primates split\non the evolutionary tree"
    } ]
  }, {
    "tStartMs": 522590,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "only 75 million years ago,"
    } ]
  }, {
    "tStartMs": 525000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so we share a lot of the same biology,"
    } ]
  }, {
    "tStartMs": 527430,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "from the structure of our cells\nto the way our blood clots,"
    } ]
  }, {
    "tStartMs": 530710,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "to how our nerves send signals."
    } ]
  }, {
    "tStartMs": 533240,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "- Venoms typically target very\nconserved molecular pathways"
    } ]
  }, {
    "tStartMs": 538100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that exist across maybe all vertebrates"
    } ]
  }, {
    "tStartMs": 540740,
    "dDurationMs": 4373,
    "segs": [ {
      "utf8": "or maybe even the entire\ntree of life in some cases."
    } ]
  }, {
    "tStartMs": 547240,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- [Derek] There are four ways"
    } ]
  }, {
    "tStartMs": 548460,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "that snake venom can kill you."
    } ]
  }, {
    "tStartMs": 550130,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It can be neurotoxic,"
    } ]
  }, {
    "tStartMs": 551840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "damaging to your nervous system and brain"
    } ]
  }, {
    "tStartMs": 554180,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "by interfering with neurotransmitters,"
    } ]
  }, {
    "tStartMs": 556380,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "the signaling chemicals\nthat go between neurons."
    } ]
  }, {
    "tStartMs": 559250,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "It can be hemotoxic,"
    } ]
  }, {
    "tStartMs": 561098,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "thinning out your blood,"
    } ]
  }, {
    "tStartMs": 561931,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "preventing wounds from healing"
    } ]
  }, {
    "tStartMs": 563770,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "and causing internal bleeding."
    } ]
  }, {
    "tStartMs": 565830,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "It does this by disturbing\nthe delicate machinery"
    } ]
  }, {
    "tStartMs": 568280,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "of the blood coagulation system."
    } ]
  }, {
    "tStartMs": 570480,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Venom can also be cytotoxic,"
    } ]
  }, {
    "tStartMs": 572710,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "attacking cells, leading\nto severe blisters,"
    } ]
  }, {
    "tStartMs": 575300,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "necrosis and cell death."
    } ]
  }, {
    "tStartMs": 577730,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "It can also be myotoxic,"
    } ]
  }, {
    "tStartMs": 579760,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "destroying muscles and causing paralysis."
    } ]
  }, {
    "tStartMs": 583080,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "The worst part is that snake venoms"
    } ]
  }, {
    "tStartMs": 585050,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "can contain up to 200 compounds."
    } ]
  }, {
    "tStartMs": 587680,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Most venoms contain a\ncombination of neurotoxic,"
    } ]
  }, {
    "tStartMs": 590450,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "hemotoxic, cytotoxic\nand myotoxic proteins."
    } ]
  }, {
    "tStartMs": 594640,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "This is what makes snake\nbites so difficult to treat."
    } ]
  }, {
    "tStartMs": 597890,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "It's not just one toxin\nyou're trying to neutralize,"
    } ]
  }, {
    "tStartMs": 600960,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "but dozens all working\ntogether to try to kill you."
    } ]
  }, {
    "tStartMs": 605817,
    "dDurationMs": 1374,
    "segs": [ {
      "utf8": "- Come on."
    } ]
  }, {
    "tStartMs": 607191,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Good boy."
    } ]
  }, {
    "tStartMs": 608024,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "There we go."
    } ]
  }, {
    "tStartMs": 611470,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "I've been at the park\nfor 10 years this year."
    } ]
  }, {
    "tStartMs": 614220,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "I've been running this\nfacility for 7 1/2, eight."
    } ]
  }, {
    "tStartMs": 618160,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- Have you ever been bitten?"
    } ]
  }, {
    "tStartMs": 621940,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "- Yeah, so about 3 1/2\nyears ago, I got a scratch."
    } ]
  }, {
    "tStartMs": 627620,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "One finger got nicked."
    } ]
  }, {
    "tStartMs": 629000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That was 36 hours in ICU"
    } ]
  }, {
    "tStartMs": 631040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and eight of those were on a resus bay."
    } ]
  }, {
    "tStartMs": 633280,
    "dDurationMs": 1505,
    "segs": [ {
      "utf8": "So very, very serious."
    } ]
  }, {
    "tStartMs": 634785,
    "dDurationMs": 1538,
    "segs": [ {
      "utf8": "- [Derek] And what was\nthat experience like?"
    } ]
  }, {
    "tStartMs": 636323,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "- That was crappy."
    } ]
  }, {
    "tStartMs": 637200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "As it turns out,"
    } ]
  }, {
    "tStartMs": 638033,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "I'm highly allergic to\nantivenom, which is not ideal."
    } ]
  }, {
    "tStartMs": 640060,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I started swelling up looking\nlike the Elephant Man."
    } ]
  }, {
    "tStartMs": 642380,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So then they whack you with adrenaline"
    } ]
  }, {
    "tStartMs": 644060,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "to cancel out the anaphylaxis"
    } ]
  }, {
    "tStartMs": 645420,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "and then they have to\ngive you more anti-venom,"
    } ]
  }, {
    "tStartMs": 647210,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "more adrenaline, more\nanti-venom, more adrenaline,"
    } ]
  }, {
    "tStartMs": 648970,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "more anti-venom, more adrenaline."
    } ]
  }, {
    "tStartMs": 650300,
    "dDurationMs": 1795,
    "segs": [ {
      "utf8": "And thankfully, I only needed the one,"
    } ]
  }, {
    "tStartMs": 652095,
    "dDurationMs": 1275,
    "segs": [ {
      "utf8": "but it was like the best case scenario,"
    } ]
  }, {
    "tStartMs": 653370,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "he didn't chew, he didn't bite,"
    } ]
  }, {
    "tStartMs": 654610,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "but literally just a scratch."
    } ]
  }, {
    "tStartMs": 656540,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Derek] So what is antivenom exactly?"
    } ]
  }, {
    "tStartMs": 658610,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "and how was it invented?"
    } ]
  }, {
    "tStartMs": 661390,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "In 1870, a British military\ndoctor, Edward Nicholson"
    } ]
  }, {
    "tStartMs": 664840,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "was stationed in Burma,"
    } ]
  }, {
    "tStartMs": 666780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and as he watched the\nlocal snake handlers,"
    } ]
  }, {
    "tStartMs": 669360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "he noticed something strange."
    } ]
  }, {
    "tStartMs": 671520,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "They would from time to time"
    } ]
  }, {
    "tStartMs": 673660,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "deliberately get Cobras to bite them"
    } ]
  }, {
    "tStartMs": 676360,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "in what he considered a form of tattooing."
    } ]
  }, {
    "tStartMs": 679200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Nicholson reasoned that\nthey were intentionally"
    } ]
  }, {
    "tStartMs": 681480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "exposing their bodies to the venom"
    } ]
  }, {
    "tStartMs": 683400,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "to develop an immune response."
    } ]
  }, {
    "tStartMs": 685990,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "He observed that the older snake handlers"
    } ]
  }, {
    "tStartMs": 688520,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "were less affected by accidental bites"
    } ]
  }, {
    "tStartMs": 690420,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "than the younger ones."
    } ]
  }, {
    "tStartMs": 691670,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "So this dangerous practice\nseemed to be paying off."
    } ]
  }, {
    "tStartMs": 697320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "20 years later in Saigon,"
    } ]
  }, {
    "tStartMs": 699060,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "a French medical researcher\nnamed Albert Calmette"
    } ]
  }, {
    "tStartMs": 702070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "was vaccinating local\nresidents against smallpox."
    } ]
  }, {
    "tStartMs": 705250,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "When he became aware of\nthe threat posed by Cobras,"
    } ]
  }, {
    "tStartMs": 708470,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "he wondered if it was possible"
    } ]
  }, {
    "tStartMs": 709930,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "to make a vaccine for snake bites."
    } ]
  }, {
    "tStartMs": 712670,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Back in Paris, he tried injecting rabbits"
    } ]
  }, {
    "tStartMs": 715160,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "with a tiny amount of Cobra venom"
    } ]
  }, {
    "tStartMs": 717660,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "starting with just .03 milligrams,"
    } ]
  }, {
    "tStartMs": 721130,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "but each week, he\ninjected the rabbits again"
    } ]
  }, {
    "tStartMs": 723850,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "slowly increasing the dose."
    } ]
  }, {
    "tStartMs": 726310,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "And after eight months of this,"
    } ]
  }, {
    "tStartMs": 727860,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "the rabbits were receiving"
    } ]
  }, {
    "tStartMs": 729050,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "35 milligrams of Cobra venom at a time,"
    } ]
  }, {
    "tStartMs": 732090,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "that is 15 times the normal\nlethal dose in rabbits,"
    } ]
  }, {
    "tStartMs": 736280,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but they were still perfectly healthy."
    } ]
  }, {
    "tStartMs": 739010,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "The rabbits' immune systems\nhad developed antibodies"
    } ]
  }, {
    "tStartMs": 741760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to neutralize the venom."
    } ]
  }, {
    "tStartMs": 743680,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "So you can be vaccinated\nagainst snake bites"
    } ]
  }, {
    "tStartMs": 746300,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "just as you can against disease,"
    } ]
  }, {
    "tStartMs": 748570,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "but who wants to be vaccinated"
    } ]
  }, {
    "tStartMs": 749960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "against all different types of snakes"
    } ]
  }, {
    "tStartMs": 752280,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "just in case one bites you?"
    } ]
  }, {
    "tStartMs": 754070,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It would be better, Calmette reasoned,"
    } ]
  }, {
    "tStartMs": 755810,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "if you could administer\nantibodies after a bite."
    } ]
  }, {
    "tStartMs": 759650,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "So he drew blood from a\nvenom resistant rabbit"
    } ]
  }, {
    "tStartMs": 762510,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "and isolated the serum which\ncontains the antibodies,"
    } ]
  }, {
    "tStartMs": 765920,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "and then he injected\nit into another rabbit"
    } ]
  }, {
    "tStartMs": 768430,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "that had never been exposed to venom."
    } ]
  }, {
    "tStartMs": 771110,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "When he subsequently injected it"
    } ]
  }, {
    "tStartMs": 773010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "with twice the lethal dose of Cobra venom,"
    } ]
  }, {
    "tStartMs": 775530,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "the rabbit was just fine."
    } ]
  }, {
    "tStartMs": 777860,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Immunity had been transferred\nfrom one rabbit to another."
    } ]
  }, {
    "tStartMs": 781680,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This was the first antivenom,"
    } ]
  }, {
    "tStartMs": 784050,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "or as the Frenchman, Calmette\ncalled it, antivenin,"
    } ]
  }, {
    "tStartMs": 787710,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "which is why my phone always\nmakes that auto-correction."
    } ]
  }, {
    "tStartMs": 791260,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "To this day, antivenoms are\nmade in much the same way."
    } ]
  }, {
    "tStartMs": 794960,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "At the Reptile Park,"
    } ]
  }, {
    "tStartMs": 796150,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "they collect and freeze the venom."
    } ]
  }, {
    "tStartMs": 798230,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "It's sent off to be diluted"
    } ]
  }, {
    "tStartMs": 799710,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and injected into a donor\nanimal, usually a horse."
    } ]
  }, {
    "tStartMs": 804000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Horses are used because of their size."
    } ]
  }, {
    "tStartMs": 806610,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "After increasing the dose\nover a period of months,"
    } ]
  }, {
    "tStartMs": 809390,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "the horse builds up immunity to the venom,"
    } ]
  }, {
    "tStartMs": 811860,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and then it's blood is drawn"
    } ]
  }, {
    "tStartMs": 813580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and the antibodies are isolated."
    } ]
  }, {
    "tStartMs": 815620,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "Only the plasma is taken,"
    } ]
  }, {
    "tStartMs": 816990,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "the red blood cells are\nreturned to the horse."
    } ]
  }, {
    "tStartMs": 819860,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "Those horse antibodies are\nthe life saving antivenom."
    } ]
  }, {
    "tStartMs": 824670,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Antivenom works for the\nsame reason venom works,"
    } ]
  }, {
    "tStartMs": 827700,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because of our shared evolutionary history"
    } ]
  }, {
    "tStartMs": 829830,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "with other mammals."
    } ]
  }, {
    "tStartMs": 831350,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The antibodies produced by horses"
    } ]
  }, {
    "tStartMs": 833300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "are very similar to the\nones produced by humans,"
    } ]
  }, {
    "tStartMs": 836080,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "so they bind to toxic\ncompounds and neutralize them"
    } ]
  }, {
    "tStartMs": 838910,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "even in our bodies."
    } ]
  }, {
    "tStartMs": 840960,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But this way of making\nantivenom has downsides."
    } ]
  }, {
    "tStartMs": 844200,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "Collecting the venom is dangerous,"
    } ]
  }, {
    "tStartMs": 846310,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "many donor animals are involved,"
    } ]
  }, {
    "tStartMs": 848430,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "and some people are allergic to antivenom."
    } ]
  }, {
    "tStartMs": 852070,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Scientists are now\nexploring the possibility"
    } ]
  }, {
    "tStartMs": 854190,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "of producing antivenom using\ngenetically modified bacteria."
    } ]
  }, {
    "tStartMs": 857960,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "They would produce the specific antibodies"
    } ]
  }, {
    "tStartMs": 860410,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "needed to neutralize\neach toxin in a venom,"
    } ]
  }, {
    "tStartMs": 863670,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but for now, this is the\nway antivenom is made."
    } ]
  }, {
    "tStartMs": 867670,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "How's your arm?"
    } ]
  }, {
    "tStartMs": 868503,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, it's a bit sore."
    } ]
  }, {
    "tStartMs": 869336,
    "dDurationMs": 1014,
    "segs": [ {
      "utf8": "The shoulder is a bit tender."
    } ]
  }, {
    "tStartMs": 871460,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "- [Derek] The work Zac\nand others like him do"
    } ]
  }, {
    "tStartMs": 874050,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "saves countless lives\nall around the world."
    } ]
  }, {
    "tStartMs": 877140,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- If you're up here for fame and fortune,"
    } ]
  }, {
    "tStartMs": 878750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and oh, look how tough\nI am milking snakes,"
    } ]
  }, {
    "tStartMs": 881180,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "you don't last long."
    } ]
  }, {
    "tStartMs": 882013,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "You get chewed on and you\ngo, oh, this is not for me."
    } ]
  }, {
    "tStartMs": 884060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "If you're up here because\nyou love the animals"
    } ]
  }, {
    "tStartMs": 885560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and this is an opportunity"
    } ]
  }, {
    "tStartMs": 886393,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "to not only work with\nthe animals you love,"
    } ]
  }, {
    "tStartMs": 888290,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but to actively be a part of saving lives."
    } ]
  }, {
    "tStartMs": 890850,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Like I'm not smart enough to be a doctor,"
    } ]
  }, {
    "tStartMs": 892710,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "I'll put that out there straight away,"
    } ]
  }, {
    "tStartMs": 893890,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "but I can swing a snake pretty good."
    } ]
  }, {
    "tStartMs": 901470,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "- Hey, milking snakes is\na very hands-on activity,"
    } ]
  }, {
    "tStartMs": 905200,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "and so is learning with this\nvideo's sponsor, Brilliant."
    } ]
  }, {
    "tStartMs": 908670,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Brilliant is a website and app designed"
    } ]
  }, {
    "tStartMs": 910340,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "to get you thinking deeply\nabout science, mathematics"
    } ]
  }, {
    "tStartMs": 912700,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "and computer science."
    } ]
  }, {
    "tStartMs": 914030,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "They do this using highly\ncurated problem sets"
    } ]
  }, {
    "tStartMs": 916680,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and interactive puzzles."
    } ]
  }, {
    "tStartMs": 918090,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "For example, their course\non probability fundamentals"
    } ]
  }, {
    "tStartMs": 920390,
    "dDurationMs": 1240,
    "segs": [ {
