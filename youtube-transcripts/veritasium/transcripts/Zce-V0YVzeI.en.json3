{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 210,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- This is a video about\navalanches, what they are,"
    } ]
  }, {
    "tStartMs": 3810,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "what causes them, how destructive\nones can be prevented,"
    } ]
  }, {
    "tStartMs": 7470,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and what to do if you're\never caught in one."
    } ]
  }, {
    "tStartMs": 10740,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "- To actually feel the force\nof the avalanche on your body."
    } ]
  }, {
    "tStartMs": 14880,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "There's kind of nothing that\ncan prepare you for that."
    } ]
  }, {
    "tStartMs": 19740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Derek] For this video, we followed"
    } ]
  }, {
    "tStartMs": 21300,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "around the ski patrollers"
    } ]
  }, {
    "tStartMs": 22410,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at North America's biggest\nski resort, Whistler-Blackcomb"
    } ]
  }, {
    "tStartMs": 25380,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "to trigger avalanches\nand film them up close."
    } ]
  }, {
    "tStartMs": 29100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "If you've ever driven through\nthe mountains in winter"
    } ]
  }, {
    "tStartMs": 31350,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or have gone skiing at a\nresort, you were kept safe"
    } ]
  }, {
    "tStartMs": 34710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "by the knowledge gained\nby snow scientists,"
    } ]
  }, {
    "tStartMs": 37410,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "avalanche forecasters, and ski patrollers."
    } ]
  }, {
    "tStartMs": 44250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "If you Google the deadliest avalanche,"
    } ]
  }, {
    "tStartMs": 46980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the first result will be from May, 1970,"
    } ]
  }, {
    "tStartMs": 49920,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "when the town of Yungguy"
    } ]
  }, {
    "tStartMs": 51830,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and 10 nearby villages were destroyed."
    } ]
  }, {
    "tStartMs": 53880,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "An estimated 30,000 people were killed,"
    } ]
  }, {
    "tStartMs": 57270,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "but the avalanche was triggered"
    } ]
  }, {
    "tStartMs": 58800,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "by a 7.9 magnitude earthquake,"
    } ]
  }, {
    "tStartMs": 62010,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and the avalanche caused a\nlandslide which buried the town."
    } ]
  }, {
    "tStartMs": 66270,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So it wasn't really avalanche destruction."
    } ]
  }, {
    "tStartMs": 69870,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "The deadliest snow avalanches\nhappened in December of 1916"
    } ]
  }, {
    "tStartMs": 74730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "during World War I."
    } ]
  }, {
    "tStartMs": 76410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Some of the fighting took\nplace in the Dolomites,"
    } ]
  }, {
    "tStartMs": 78870,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "mountain range in northern Italy."
    } ]
  }, {
    "tStartMs": 81330,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "There thousands"
    } ]
  }, {
    "tStartMs": 82530,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "of Italian troops were battling\nAustro-Hungarian soldiers,"
    } ]
  }, {
    "tStartMs": 86550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and it had been a\nparticularly snowy winter."
    } ]
  }, {
    "tStartMs": 89670,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Over 12 meters"
    } ]
  }, {
    "tStartMs": 91470,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "of snow had fallen on the mountain range"
    } ]
  }, {
    "tStartMs": 93570,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "in the first week of December."
    } ]
  }, {
    "tStartMs": 96630,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "On the 13th of December,"
    } ]
  }, {
    "tStartMs": 97980,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "a single avalanche wiped out\nthe Austrian barracks near"
    } ]
  }, {
    "tStartMs": 101010,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Mount Marmolada killing\nat least 275 people."
    } ]
  }, {
    "tStartMs": 106140,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But its flow on effects\nwere far more devastating."
    } ]
  }, {
    "tStartMs": 109560,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Both sets of troops\nrealized they could use snow"
    } ]
  }, {
    "tStartMs": 113100,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "as a weapon, so soldiers on\nboth sides fired artillery"
    } ]
  }, {
    "tStartMs": 117690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "shells into the mountain\nabove their enemy's camps,"
    } ]
  }, {
    "tStartMs": 121050,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "deliberately triggering avalanches."
    } ]
  }, {
    "tStartMs": 123870,
    "dDurationMs": 2207,
    "segs": [ {
      "utf8": "Over the next few days, between 2000"
    } ]
  }, {
    "tStartMs": 126077,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "and 10,000 soldiers died\nburied underneath the snow."
    } ]
  }, {
    "tStartMs": 132540,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But most deadly avalanches\naren't triggered by earthquakes"
    } ]
  }, {
    "tStartMs": 135990,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "or artillery shells."
    } ]
  }, {
    "tStartMs": 137730,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "They're triggered by skiers, snowboarders,"
    } ]
  }, {
    "tStartMs": 140040,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and snowmobilers recreating\nin the backcountry."
    } ]
  }, {
    "tStartMs": 143130,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "93% of fatal avalanches in the US"
    } ]
  }, {
    "tStartMs": 146250,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "were triggered by the weight"
    } ]
  }, {
    "tStartMs": 147540,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "of the victim or someone\nin the victim's party."
    } ]
  }, {
    "tStartMs": 150450,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So how could something so massive"
    } ]
  }, {
    "tStartMs": 153060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and destructive be triggered by the weight"
    } ]
  }, {
    "tStartMs": 155580,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "of just a single human?"
    } ]
  }, {
    "tStartMs": 158751,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "This is Bruce Tremper."
    } ]
  }, {
    "tStartMs": 159584,
    "dDurationMs": 2956,
    "segs": [ {
      "utf8": "He literally wrote the book\non avalanches, the book,"
    } ]
  }, {
    "tStartMs": 162540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "which inspired us to make this video."
    } ]
  }, {
    "tStartMs": 164790,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- I was a a hardcore ski racer,"
    } ]
  }, {
    "tStartMs": 167640,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "but when I was done racing,\nthen I started building lifts"
    } ]
  }, {
    "tStartMs": 170970,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for the Bridger Bowl Ski Patrol,"
    } ]
  }, {
    "tStartMs": 172710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and I got caught in my first avalanche."
    } ]
  }, {
    "tStartMs": 174990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "My job for that day was tightening"
    } ]
  }, {
    "tStartMs": 177030,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "all the bolts at the base\nof each chairlift tower."
    } ]
  }, {
    "tStartMs": 180090,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "'Cause we were doing\nour load test that day."
    } ]
  }, {
    "tStartMs": 183000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So then they'd warn me,\nokay, once you get done"
    } ]
  }, {
    "tStartMs": 185640,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with this tower, whatever\nyou do, don't cross"
    } ]
  }, {
    "tStartMs": 187710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that big avalanche path below it."
    } ]
  }, {
    "tStartMs": 190020,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "And I made some snide remark like,"
    } ]
  }, {
    "tStartMs": 192247,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "\"Yeah, yeah, yeah, I know\nabout all that stuff."
    } ]
  }, {
    "tStartMs": 195180,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Don't worry about me.\""
    } ]
  }, {
    "tStartMs": 196950,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "When I got done tightening those bolts,"
    } ]
  }, {
    "tStartMs": 198960,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "then I realized I made\na really serious error"
    } ]
  }, {
    "tStartMs": 202200,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "because I was just\nwallowing up to my chest"
    } ]
  }, {
    "tStartMs": 204267,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "and I almost needed to take out a shovel"
    } ]
  }, {
    "tStartMs": 206460,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and dig like a tunnel through\nthe snow to get back up"
    } ]
  }, {
    "tStartMs": 209580,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "to the ridge and it was\njust exhausting work."
    } ]
  }, {
    "tStartMs": 213300,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And then I got cocky."
    } ]
  }, {
    "tStartMs": 215160,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I thought, \"Well, I've\nheard about these ski cuts."
    } ]
  }, {
    "tStartMs": 218010,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "I can just build up my speed\nand get to the other side"
    } ]
  }, {
    "tStartMs": 221340,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "'cause that's where I want to be anyway.\""
    } ]
  }, {
    "tStartMs": 223590,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "Like an idiot, that's what I did."
    } ]
  }, {
    "tStartMs": 228180,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "The first thing that happens\nwhen an avalanche brakes"
    } ]
  }, {
    "tStartMs": 231210,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "is it just starts moving"
    } ]
  }, {
    "tStartMs": 233400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and the first thing you do is\nkind of flop over on the snow."
    } ]
  }, {
    "tStartMs": 235860,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "'Cause you lose your balance."
    } ]
  }, {
    "tStartMs": 236970,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Like somebody pulls the\nrug out from underneath you"
    } ]
  }, {
    "tStartMs": 238703,
    "dDurationMs": 1672,
    "segs": [ {
      "utf8": "and you fall uphill."
    } ]
  }, {
    "tStartMs": 240375,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "And there I was just\nkinda laying in the snow,"
    } ]
  }, {
    "tStartMs": 242838,
    "dDurationMs": 3822,
    "segs": [ {
      "utf8": "getting dragged down the\nmountain, you know, I was caught."
    } ]
  }, {
    "tStartMs": 246660,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I couldn't get out of it"
    } ]
  }, {
    "tStartMs": 248790,
    "dDurationMs": 1929,
    "segs": [ {
      "utf8": "and luckily I was able\nto grab a small tree,"
    } ]
  }, {
    "tStartMs": 250719,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "but the snow was just beating me to death,"
    } ]
  }, {
    "tStartMs": 253430,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "and just about snapping\noff my neck as it's going"
    } ]
  }, {
    "tStartMs": 256560,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "by me on this tree."
    } ]
  }, {
    "tStartMs": 258518,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Luckily a lot of that snow went by"
    } ]
  }, {
    "tStartMs": 260812,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "and that's why I didn't die that day."
    } ]
  }, {
    "tStartMs": 263440,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "But then it finally, the\ntree finally snapped off"
    } ]
  }, {
    "tStartMs": 266280,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "or something happened"
    } ]
  }, {
    "tStartMs": 267450,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "and I was tumbling down\nthe avalanche path."
    } ]
  }, {
    "tStartMs": 272220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Luckily when I got to the bottom,"
    } ]
  }, {
    "tStartMs": 273870,
    "dDurationMs": 1704,
    "segs": [ {
      "utf8": "I was only buried up to my chest."
    } ]
  }, {
    "tStartMs": 275574,
    "dDurationMs": 2429,
    "segs": [ {
      "utf8": "I was in the tail of the avalanche"
    } ]
  }, {
    "tStartMs": 278003,
    "dDurationMs": 2707,
    "segs": [ {
      "utf8": "and the avalanche dies\nfrom the tail first."
    } ]
  }, {
    "tStartMs": 280710,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "So that slows down while\nthe front part keeps moving."
    } ]
  }, {
    "tStartMs": 284377,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "You know, I had a lot\nof time to think about"
    } ]
  }, {
    "tStartMs": 286920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that for the rest of the day."
    } ]
  }, {
    "tStartMs": 288120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Tightening the rest of those bolts"
    } ]
  }, {
    "tStartMs": 289680,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "and thinking, holy smokes,\nI should, I could have died."
    } ]
  }, {
    "tStartMs": 294150,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I should have died and I didn't."
    } ]
  }, {
    "tStartMs": 296160,
    "dDurationMs": 2273,
    "segs": [ {
      "utf8": "- You were tightening bolts,\nyou were caught in avalanche"
    } ]
  }, {
    "tStartMs": 298433,
    "dDurationMs": 3487,
    "segs": [ {
      "utf8": "and then you went back to\ntightening bolts that day."
    } ]
  }, {
    "tStartMs": 301920,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "You like, you went back to work."
    } ]
  }, {
    "tStartMs": 303390,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Oh yeah, yeah."
    } ]
  }, {
    "tStartMs": 304590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Good job.\n- Well, somebody had to do it."
    } ]
  }, {
    "tStartMs": 306540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I was the guy, that was my job."
    } ]
  }, {
    "tStartMs": 309210,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "You know, that's how I\nwas raised by my father."
    } ]
  }, {
    "tStartMs": 312611,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "You get the job done."
    } ]
  }, {
    "tStartMs": 315600,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- At the most basic level,"
    } ]
  }, {
    "tStartMs": 316980,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "an avalanche happens when\nthe crystalline bonds"
    } ]
  }, {
    "tStartMs": 319260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "between the snow crystals break"
    } ]
  }, {
    "tStartMs": 321540,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and the force of friction\nholding the snow on the mountain"
    } ]
  }, {
    "tStartMs": 324330,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "isn't enough to counteract\nthe pull of gravity."
    } ]
  }, {
    "tStartMs": 328110,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Avalanches are categorized"
    } ]
  }, {
    "tStartMs": 329550,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "by size on a scale of one to five."
    } ]
  }, {
    "tStartMs": 331590,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "One would not be large\nenough to bury a person,"
    } ]
  }, {
    "tStartMs": 334890,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "but size five would involve\na 100,000 cubic meters"
    } ]
  }, {
    "tStartMs": 338760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of snow traveling,"
    } ]
  }, {
    "tStartMs": 340050,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "many kilometers causing\ndestruction on a massive scale."
    } ]
  }, {
    "tStartMs": 343853,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "The first thing to note is\nthat snow isn't uniform."
    } ]
  }, {
    "tStartMs": 347563,
    "dDurationMs": 3797,
    "segs": [ {
      "utf8": "The snow pack is built\nup one storm at a time,"
    } ]
  }, {
    "tStartMs": 351360,
    "dDurationMs": 4005,
    "segs": [ {
      "utf8": "so it's layered and these\nlayers aren't all the same"
    } ]
  }, {
    "tStartMs": 355365,
    "dDurationMs": 2685,
    "segs": [ {
      "utf8": "and they change over time,"
    } ]
  }, {
    "tStartMs": 358050,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "due to the conditions they're exposed to,"
    } ]
  }, {
    "tStartMs": 359617,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "the air temperature, humidity, sun, wind,"
    } ]
  }, {
    "tStartMs": 363180,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and rain all affect the\nstructure of the snow."
    } ]
  }, {
    "tStartMs": 366990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "For example, after fresh snow has fallen,"
    } ]
  }, {
    "tStartMs": 369270,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "if there's a warm sunny\nday, the snow will melt"
    } ]
  }, {
    "tStartMs": 372900,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and then refreeze overnight\ncreating a sheet of ice."
    } ]
  }, {
    "tStartMs": 376980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The most important condition\nis the temperature gradient"
    } ]
  }, {
    "tStartMs": 379860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "in the snowpack, but we'll come to that."
    } ]
  }, {
    "tStartMs": 382620,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The snowpack preserves\na record of everything"
    } ]
  }, {
    "tStartMs": 385320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that has happened to it."
    } ]
  }, {
    "tStartMs": 386520,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "If you dig a pit into the snow,"
    } ]
  }, {
    "tStartMs": 388487,
    "dDurationMs": 4186,
    "segs": [ {
      "utf8": "you can read the different\nlayers to understand its past."
    } ]
  }, {
    "tStartMs": 395310,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Nine different avalanche\nproblems are recognized,"
    } ]
  }, {
    "tStartMs": 398820,
    "dDurationMs": 3679,
    "segs": [ {
      "utf8": "but there are two main\ntypes, slab and loose."
    } ]
  }, {
    "tStartMs": 402499,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "There are two types of\nloose avalanches, dry loose,"
    } ]
  }, {
    "tStartMs": 406200,
    "dDurationMs": 1258,
    "segs": [ {
      "utf8": "and wet loose."
    } ]
  }, {
    "tStartMs": 407458,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "The snow in dry loose\navalanches is well, loose."
    } ]
  }, {
    "tStartMs": 412200,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "The snow isn't all stuck together."
    } ]
  }, {
    "tStartMs": 414390,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So after it's triggered, it fans out."
    } ]
  }, {
    "tStartMs": 417060,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Sometimes loose avalanches are also known"
    } ]
  }, {
    "tStartMs": 419490,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "as point release avalanches."
    } ]
  }, {
    "tStartMs": 422190,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Dry loose avalanches are commonly\nknown by skiers as sluff,"
    } ]
  }, {
    "tStartMs": 425970,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and they usually aren't a serious hazard,"
    } ]
  }, {
    "tStartMs": 428670,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "though they can drag a skier off a cliff."
    } ]
  }, {
    "tStartMs": 431610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- It's funny because like\nin the skiing community,"
    } ]
  }, {
    "tStartMs": 433380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "we've just said like this one kind"
    } ]
  }, {
    "tStartMs": 435300,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of avalanche isn't an avalanche,"
    } ]
  }, {
    "tStartMs": 437370,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "we just call it something else."
    } ]
  }, {
    "tStartMs": 438630,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I had a run in with sluff\nyesterday, a Helbronner,"
    } ]
  }, {
    "tStartMs": 441570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and you just feel like this wall"
    } ]
  }, {
    "tStartMs": 443160,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of snow pushing you from the back."
    } ]
  }, {
    "tStartMs": 445650,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Honestly, it's kind of fun, it's fun."
    } ]
  }, {
    "tStartMs": 447330,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's like, it's kind of like\nsurfing where it's dynamic"
    } ]
  }, {
    "tStartMs": 450210,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and it's moving and you have\nto keep moving with the terrain"
    } ]
  }, {
    "tStartMs": 453840,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "because you know that yeah,\nthe sluff his behind you"
    } ]
  }, {
    "tStartMs": 457170,
    "dDurationMs": 2715,
    "segs": [ {
      "utf8": "and if you're not moving fast\nenough, it's gonna get you."
    } ]
  }, {
    "tStartMs": 459885,
    "dDurationMs": 3405,
    "segs": [ {
      "utf8": "- [Derek] Another type of\navalanche is wet loose."
    } ]
  }, {
    "tStartMs": 463290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- It typically happens around spring"
    } ]
  }, {
    "tStartMs": 465780,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "on like south facing aspects."
    } ]
  }, {
    "tStartMs": 467880,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The sun heats up the snow\nand makes it more dense"
    } ]
  }, {
    "tStartMs": 471270,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and slushy and runny."
    } ]
  }, {
    "tStartMs": 473310,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "The sun's starting to come out."
    } ]
  }, {
    "tStartMs": 474330,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I'm not currently too worried\nabout wet loose right now,"
    } ]
  }, {
    "tStartMs": 477270,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "but I will be in about an hour."
    } ]
  }, {
    "tStartMs": 480510,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] But the more deadly avalanches"
    } ]
  }, {
    "tStartMs": 482010,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "are slab avalanches"
    } ]
  }, {
    "tStartMs": 483630,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "where the top layer of\nsnow becomes stuck together"
    } ]
  }, {
    "tStartMs": 486079,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "like a cohesive slab."
    } ]
  }, {
    "tStartMs": 488790,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "When the avalanche is triggered,"
    } ]
  }, {
    "tStartMs": 490350,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "the snow releases together in big chunks."
    } ]
  }, {
    "tStartMs": 493670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The prevalence of slab avalanches depends"
    } ]
  }, {
    "tStartMs": 496130,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "on the angle of the ski slope."
    } ]
  }, {
    "tStartMs": 498660,
    "dDurationMs": 3184,
    "segs": [ {
      "utf8": "Under 25 degrees, there isn't\nlikely to be a slab avalanche"
    } ]
  }, {
    "tStartMs": 501844,
    "dDurationMs": 2606,
    "segs": [ {
      "utf8": "because gravity just isn't strong enough"
    } ]
  }, {
    "tStartMs": 504450,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to pull the snow down the mountain."
    } ]
  }, {
    "tStartMs": 506700,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Any slope steeper than 50\ndegrees is also unlikely"
    } ]
  }, {
    "tStartMs": 510210,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to have dangerous avalanches."
    } ]
  }, {
    "tStartMs": 512220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The slope is so steep that it's hard"
    } ]
  }, {
    "tStartMs": 514230,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "for much snow to accumulate."
    } ]
  }, {
    "tStartMs": 516450,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Regular small sluffs"
    } ]
  }, {
    "tStartMs": 517710,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and slab avalanches prevent\nthe buildup of larger,"
    } ]
  }, {
    "tStartMs": 520980,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "more dangerous slabs."
    } ]
  }, {
    "tStartMs": 523050,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "75% of dangerous slab avalanches occur"
    } ]
  }, {
    "tStartMs": 526140,
    "dDurationMs": 3189,
    "segs": [ {
      "utf8": "between 34 and 45 degrees."
    } ]
  }, {
    "tStartMs": 529329,
    "dDurationMs": 3981,
    "segs": [ {
      "utf8": "For comparison, a black\ndiamond ski run is typically"
    } ]
  }, {
    "tStartMs": 533310,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "around 30 degrees and a double\ndiamond is around 40 degrees."
    } ]
  }, {
    "tStartMs": 537213,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "In other words."
    } ]
  }, {
    "tStartMs": 539340,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- The best conditions for\nskiing are also the best"
    } ]
  }, {
    "tStartMs": 542260,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "conditions for avalanches."
    } ]
  }, {
    "tStartMs": 543660,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- [Derek] What's really\nterrifying about slab avalanches"
    } ]
  }, {
    "tStartMs": 546510,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "is you can trigger them remotely."
    } ]
  }, {
    "tStartMs": 548351,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "You could be skiing"
    } ]
  }, {
    "tStartMs": 549810,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "or walking on a slope that\nis far less than 30 degrees"
    } ]
  }, {
    "tStartMs": 553105,
    "dDurationMs": 4145,
    "segs": [ {
      "utf8": "and trigger an avalanche on\na steeper slope above you."
    } ]
  }, {
    "tStartMs": 557250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And slab avalanches are fast."
    } ]
  }, {
    "tStartMs": 559800,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "They can reach speeds up\nto 120 kilometers per hour."
    } ]
  }, {
    "tStartMs": 564270,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Friends of mine have\nbeen killed that way."
    } ]
  }, {
    "tStartMs": 566520,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "You just don't realize"
    } ]
  }, {
    "tStartMs": 567600,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "how far these cracks can\npropagate through the snow."
    } ]
  }, {
    "tStartMs": 571021,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "- [Derek] Slab avalanches\nhave three parts to them,"
    } ]
  }, {
    "tStartMs": 574650,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "bed surface, which is the\nlower part of the snow."
    } ]
  }, {
    "tStartMs": 577290,
    "dDurationMs": 4468,
    "segs": [ {
      "utf8": "Then there is a weak layer\nand the overlying slab"
    } ]
  }, {
    "tStartMs": 581758,
    "dDurationMs": 3422,
    "segs": [ {
      "utf8": "The bed surface and the\nslab are strong layers."
    } ]
  }, {
    "tStartMs": 585180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "That is they're made out of\nsnow that sticks to itself."
    } ]
  }, {
    "tStartMs": 587760,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The kind of snow that you\ncan make into a snowball."
    } ]
  }, {
    "tStartMs": 590460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "The shape of the snow crystals"
    } ]
  }, {
    "tStartMs": 591840,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "in strong layers tends to be rounded."
    } ]
  }, {
    "tStartMs": 594600,
    "dDurationMs": 2672,
    "segs": [ {
      "utf8": "In contrast, the weak layer\nconsists of snow crystals"
    } ]
  }, {
    "tStartMs": 597272,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "that don't readily cohere to one another."
    } ]
  }, {
    "tStartMs": 599692,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "These tend to be more\nangular or faceted crystals."
    } ]
  }, {
    "tStartMs": 603153,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "But there are a few\ndifferent weak layer types."
    } ]
  }, {
    "tStartMs": 607033,
    "dDurationMs": 4226,
    "segs": [ {
      "utf8": "One of the most worrying\nis known as surface hoar."
    } ]
  }, {
    "tStartMs": 611259,
    "dDurationMs": 3111,
    "segs": [ {
      "utf8": "It's not made outta snow\nthat falls from the sky."
    } ]
  }, {
    "tStartMs": 614370,
    "dDurationMs": 2868,
    "segs": [ {
      "utf8": "It grows on the surface of the snow."
    } ]
  }, {
    "tStartMs": 617238,
    "dDurationMs": 3222,
    "segs": [ {
      "utf8": "On cold clear nights,\nthe surface snow radiates"
    } ]
  }, {
    "tStartMs": 620460,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "a lot of its heat away becoming\neven colder than the air."
    } ]
  }, {
    "tStartMs": 623550,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Since warm air holds more\nmoisture than cold air,"
    } ]
  }, {
    "tStartMs": 626595,
    "dDurationMs": 2895,
    "segs": [ {
      "utf8": "that moisture will crystallize at the top"
    } ]
  }, {
    "tStartMs": 629490,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "of the snow creating surface hoar."
    } ]
  }, {
    "tStartMs": 631825,
    "dDurationMs": 3125,
    "segs": [ {
      "utf8": "Surface is formed by condensation."
    } ]
  }, {
    "tStartMs": 634950,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It's the snow equivalent of dew."
    } ]
  }, {
    "tStartMs": 637770,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It's really angular and it\ndoesn't want to stick to itself."
    } ]
  }, {
    "tStartMs": 642330,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "- Usually surface hoar is\nthen broken down by wind"
    } ]
  }, {
    "tStartMs": 645072,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "or sun melting it."
    } ]
  }, {
    "tStartMs": 647040,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] But if a snowstorm occurs,"
    } ]
  }, {
    "tStartMs": 648630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "just after these crystals have formed,"
    } ]
  }, {
    "tStartMs": 650700,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "they can become buried."
    } ]
  }, {
    "tStartMs": 652080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And in that case, they create\na very nasty, weak layer,"
    } ]
  }, {
    "tStartMs": 655260,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "which is just perfect for avalanches."
    } ]
  }, {
    "tStartMs": 659310,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Another weak layer to worry\nabout are facets, snow crystals"
    } ]
  }, {
    "tStartMs": 662520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "that used to be round,"
    } ]
  }, {
    "tStartMs": 663780,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but that became angular in the snowpack."
    } ]
  }, {
    "tStartMs": 666690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Facets develop when there's\na strong temperature"
    } ]
  }, {
    "tStartMs": 669000,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "gradient in the snow."
    } ]
  }, {
    "tStartMs": 670650,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "A thermal gradient of less than one degree"
    } ]
  }, {
    "tStartMs": 672510,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "per 10 centimeters does\nnot produce facets."
    } ]
  }, {
    "tStartMs": 675930,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Anything more than that can,\nwhich is why the temperature"
    } ]
  }, {
    "tStartMs": 679170,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "inside a snow pit is measured."
    } ]
  }, {
    "tStartMs": 681180,
    "dDurationMs": 1511,
    "segs": [ {
      "utf8": "If there's a large thermal gradient,"
    } ]
  }, {
    "tStartMs": 682691,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "there could also be a weak layer"
    } ]
  }, {
    "tStartMs": 685194,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "- Right above and right below crust,"
    } ]
  }, {
    "tStartMs": 686940,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "there can be really wild\ntemperature gradients."
    } ]
  }, {
    "tStartMs": 689073,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "So we had it down 10\ncentimeters, it was minus 5.5"
    } ]
  }, {
    "tStartMs": 692158,
    "dDurationMs": 3968,
    "segs": [ {
      "utf8": "and down 20 it was minus 3.7."
    } ]
  }, {
    "tStartMs": 696126,
    "dDurationMs": 1875,
    "segs": [ {
      "utf8": "So that's two degree difference."
    } ]
  }, {
    "tStartMs": 698001,
    "dDurationMs": 1809,
    "segs": [ {
      "utf8": "- [Derek] The bottom of the snow"
    } ]
  }, {
    "tStartMs": 699810,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "is warmer than the top of the snow."
    } ]
  }, {
    "tStartMs": 701580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So the warmer snow near the ground,"
    } ]
  }, {
    "tStartMs": 703500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "sublimates turning\nstraight from solid water"
    } ]
  }, {
    "tStartMs": 706140,
    "dDurationMs": 1071,
    "segs": [ {
      "utf8": "into water vapor."
    } ]
  }, {
    "tStartMs": 707211,
    "dDurationMs": 3279,
    "segs": [ {
      "utf8": "This water vapor rises\nup through the snow pack"
    } ]
  }, {
    "tStartMs": 710490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and then encounters the\ncolder snow crystals."
    } ]
  }, {
    "tStartMs": 713370,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "At this point, it refreezes\nand forms faceted crystals,"
    } ]
  }, {
    "tStartMs": 717360,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "which like surface hoar,\ndon't stick together"
    } ]
  }, {
    "tStartMs": 720180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "creating a weak layer."
    } ]
  }, {
    "tStartMs": 722100,
    "dDurationMs": 1715,
    "segs": [ {
      "utf8": "- The bigger the change in temperature,"
    } ]
  }, {
    "tStartMs": 723815,
    "dDurationMs": 3788,
    "segs": [ {
      "utf8": "the faster the snow crystals change"
    } ]
  }, {
    "tStartMs": 727603,
    "dDurationMs": 1556,
    "segs": [ {
      "utf8": "and the faster they change,"
    } ]
  }, {
    "tStartMs": 729159,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "if they change quickly,\nit can promote faceting"
    } ]
  }, {
    "tStartMs": 732360,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which promotes instability."
    } ]
  }, {
    "tStartMs": 734670,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] The other important\nfactor in slab avalanches"
    } ]
  }, {
    "tStartMs": 737100,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is the stiffness of the slab."
    } ]
  }, {
    "tStartMs": 739170,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Since the snow is cohesive,\nwhen a force is applied"
    } ]
  }, {
    "tStartMs": 742440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the interface between the slab"
    } ]
  }, {
    "tStartMs": 743940,
    "dDurationMs": 2023,
    "segs": [ {
      "utf8": "and the weak layer starts\nto slip, that force,"
    } ]
  }, {
    "tStartMs": 745963,
    "dDurationMs": 3137,
    "segs": [ {
      "utf8": "and hence the slippage propagates."
    } ]
  }, {
    "tStartMs": 749100,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "While stiffer slabs might\nresist initial triggers better,"
    } ]
  }, {
    "tStartMs": 751593,
    "dDurationMs": 3027,
    "segs": [ {
      "utf8": "their failure leads to more propagation,"
    } ]
  }, {
    "tStartMs": 754620,
    "dDurationMs": 2145,
    "segs": [ {
      "utf8": "leading to larger avalanches."
    } ]
  }, {
    "tStartMs": 756765,
    "dDurationMs": 3318,
    "segs": [ {
      "utf8": "This also results in more remote triggers."
    } ]
  }, {
    "tStartMs": 761520,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Avalanches are common after storms."
    } ]
  }, {
    "tStartMs": 763800,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "The extra weight"
    } ]
  }, {
    "tStartMs": 764910,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of the snow exerts an additional\nload onto the snow pack,"
    } ]
  }, {
    "tStartMs": 768270,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which can trigger the weak layers deeper"
    } ]
  }, {
    "tStartMs": 770310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "in the snowpack to slide."
    } ]
  }, {
    "tStartMs": 772320,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The vast majority of\navalanches occur during"
    } ]
  }, {
    "tStartMs": 774780,
    "dDurationMs": 2714,
    "segs": [ {
      "utf8": "or right after a storm, in other words-"
    } ]
  }, {
    "tStartMs": 777494,
    "dDurationMs": 1396,
    "segs": [ {
      "utf8": "- The best conditions"
    } ]
  }, {
    "tStartMs": 778890,
    "dDurationMs": 2486,
    "segs": [ {
      "utf8": "for skiing are also the best\nconditions for avalanches."
    } ]
  }, {
    "tStartMs": 781376,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "- Strong winds also increase\nthe risk of avalanches."
    } ]
  }, {
    "tStartMs": 784710,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "The wind can pick up"
    } ]
  }, {
    "tStartMs": 786360,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "and transport the snow from\nopen to more sheltered areas."
    } ]
  }, {
    "tStartMs": 790800,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "As the snow accumulates,"
    } ]
  }, {
    "tStartMs": 792090,
    "dDurationMs": 2675,
    "segs": [ {
      "utf8": "the wind pressure compacts\nthese snow particles"
    } ]
  }, {
    "tStartMs": 794765,
    "dDurationMs": 4315,
    "segs": [ {
      "utf8": "as they're deposited, which\ncreates a dense, cohesive layer."
    } ]
  }, {
    "tStartMs": 799080,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "These newly deposited layers\nof snow are called wind slabs."
    } ]
  }, {
    "tStartMs": 803021,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "Wind slabs can be quite\nunstable, especially shortly"
    } ]
  }, {
    "tStartMs": 806220,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "after formation, if they've\nformed over a weak layer."
    } ]
  }, {
    "tStartMs": 809402,
    "dDurationMs": 1888,
    "segs": [ {
      "utf8": "Since they're more cohesive,"
    } ]
  }, {
    "tStartMs": 811290,
    "dDurationMs": 2285,
    "segs": [ {
      "utf8": "these slabs can break free as large chunks"
    } ]
  }, {
    "tStartMs": 813575,
    "dDurationMs": 3376,
    "segs": [ {
      "utf8": "during an avalanche making\nthem particularly hazardous."
    } ]
  }, {
    "tStartMs": 816951,
    "dDurationMs": 3609,
    "segs": [ {
      "utf8": "Another concern are cornices."
    } ]
  }, {
    "tStartMs": 820560,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Cornices form"
    } ]
  }, {
    "tStartMs": 821670,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "when the wind blows snow\nover the top of a ridge"
    } ]
  }, {
    "tStartMs": 824400,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "and it piles up on the other\nside hanging over the edge."
    } ]
  }, {
    "tStartMs": 828750,
    "dDurationMs": 2006,
    "segs": [ {
      "utf8": "Cornices can weigh many tons"
    } ]
  }, {
    "tStartMs": 830756,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "and when they fall onto a slope,"
    } ]
  }, {
    "tStartMs": 832860,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "they can trigger massive slab avalanches."
    } ]
  }, {
    "tStartMs": 836130,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "One of the ways that backcountry\nskiers test the stability"
    } ]
  }, {
    "tStartMs": 838710,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "of the slope they're about to ride"
    } ]
  }, {
    "tStartMs": 839962,
    "dDurationMs": 2978,
    "segs": [ {
      "utf8": "is by dropping a cornice onto it."
    } ]
  }, {
    "tStartMs": 842940,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "If the slope didn't slide\nunder the weight of a cornice,"
    } ]
  }, {
    "tStartMs": 845400,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "it's unlikely to slide\nunder the weight of a skier."
    } ]
  }, {
    "tStartMs": 849420,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So how are avalanches\nprevented in ski resorts?"
    } ]
  }, {
    "tStartMs": 852480,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "For this video, Veritasium\nproducer Peter, went out"
    } ]
  }, {
    "tStartMs": 854673,
    "dDurationMs": 2547,
    "segs": [ {
      "utf8": "with the ski patrol team\nat Whistler-Blackcomb,"
    } ]
  }, {
    "tStartMs": 857220,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "which is North America's\nlargest ski resort."
    } ]
  }, {
    "tStartMs": 859590,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- Dude, I'm pumped, really\npumped, really anxious,"
    } ]
  }, {
    "tStartMs": 862980,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "really stoked, should be a good day."
    } ]
  }, {
    "tStartMs": 865440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "There are sections in ski resorts"
    } ]
  }, {
    "tStartMs": 867000,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "that are avalanche terrain,\nslopes that are greater than 30"
    } ]
  }, {
    "tStartMs": 870060,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "or so degrees or under avalanche terrain."
    } ]
  }, {
    "tStartMs": 873450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "To keep skiers safe,\nbefore ski areas open,"
    } ]
  }, {
    "tStartMs": 876330,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the ski patrols do avalanche control work."
    } ]
  }, {
    "tStartMs": 878940,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "Fundamentally, it boils down"
    } ]
  }, {
    "tStartMs": 881052,
    "dDurationMs": 2028,
    "segs": [ {
      "utf8": "to them triggering\navalanches in a safe way"
    } ]
  }, {
    "tStartMs": 883080,
    "dDurationMs": 3939,
    "segs": [ {
      "utf8": "before there are any skiers\non or under those slopes."
    } ]
  }, {
    "tStartMs": 887019,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "This is done often enough"
    } ]
  }, {
    "tStartMs": 888579,
    "dDurationMs": 3471,
    "segs": [ {
      "utf8": "so that the snow doesn't get\na chance to build up too much."
    } ]
  }, {
    "tStartMs": 892050,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So the avalanches that\nare triggered are smaller."
    } ]
  }, {
    "tStartMs": 894650,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "There are a few ways that this is done,"
    } ]
  }, {
    "tStartMs": 897780,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but the most common is\nby using explosives."
    } ]
  }, {
    "tStartMs": 900870,
    "dDurationMs": 2712,
    "segs": [ {
      "utf8": "Explosive charges with a\ntwo minute fuse are lit"
    } ]
  }, {
    "tStartMs": 903582,
    "dDurationMs": 3228,
    "segs": [ {
      "utf8": "and then detonated on the\nslopes where they are likely"
    } ]
  }, {
    "tStartMs": 906810,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "to produce avalanches."
    } ]
  }, {
    "tStartMs": 910965,
    "dDurationMs": 4815,
    "segs": [ {
      "utf8": "- Oh boy, really glad\nI put on those goggles."
    } ]
  }, {
    "tStartMs": 915780,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Sometimes this is done"
    } ]
  }, {
    "tStartMs": 916860,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "by throwing the chargers\nout of a helicopter,"
    } ]
  }, {
    "tStartMs": 919230,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "but a lot of the time\nthis is done on skis."
    } ]
  }, {
    "tStartMs": 926220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "There are even special trams\nwhere the chargers are attached"
    } ]
  }, {
    "tStartMs": 929640,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to a carabiner and then shuttled across"
    } ]
  }, {
    "tStartMs": 931890,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to a hard to access slope."
    } ]
  }, {
    "tStartMs": 934620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "As the charge detonates,"
    } ]
  }, {
    "tStartMs": 935820,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "the shockwave breaks the weak\nlayer leading to an avalanche."
    } ]
  }, {
    "tStartMs": 944580,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Yes, we got a slide, that wasn't too bad."
    } ]
  }, {
    "tStartMs": 951360,
    "dDurationMs": 1348,
    "segs": [ {
      "utf8": "It wasn't great."
    } ]
  }, {
    "tStartMs": 952708,
    "dDurationMs": 1652,
    "segs": [ {
      "utf8": "- It was something.\n- It was something."
    } ]
  }, {
    "tStartMs": 954360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Peter] Despite doing\nthe shoot the day after one"
    } ]
  }, {
    "tStartMs": 956430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "of the biggest storms of the season,"
    } ]
  }, {
    "tStartMs": 958410,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "we weren't particularly lucky\nwith getting large avalanches."
    } ]
  }, {
    "tStartMs": 962310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "We shot all morning"
    } ]
  }, {
    "tStartMs": 963840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and only got this relatively small slide."
    } ]
  }, {
    "tStartMs": 966840,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So I was getting worried"
    } ]
  }, {
    "tStartMs": 969150,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "and then we were able to get this shot."
    } ]
  }, {
    "tStartMs": 972968,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 991110,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "Oh my god, look at that, oh."
    } ]
  }, {
    "tStartMs": 1003029,
    "dDurationMs": 2751,
    "segs": [ {
      "utf8": "Avalanche control work\nis also done on roads"
    } ]
  }, {
    "tStartMs": 1005780,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "with basically the same\nidea, trigger avalanches"
    } ]
  }, {
    "tStartMs": 1008841,
    "dDurationMs": 4112,
    "segs": [ {
      "utf8": "before they get a chance to\nbecome big and destructive."
    } ]
  }, {
    "tStartMs": 1014257,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "For example, the Trans Canada\nhighway connecting the east"
    } ]
  }, {
    "tStartMs": 1016310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and west coast of Canada goes"
    } ]
  }, {
    "tStartMs": 1018410,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "through Rogers Pass, a mountain pass"
    } ]
  }, {
    "tStartMs": 1020840,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "with 3000 meter toll peaks\non either side of it."
    } ]
  }, {
    "tStartMs": 1024590,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The road is right next to a mountain"
    } ]
  }, {
    "tStartMs": 1026330,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that's actually called Avalanche Mountain."
    } ]
  }, {
    "tStartMs": 1029780,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Here Parks Canada"
    } ]
  }, {
    "tStartMs": 1031010,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and the Canadian Army\nconduct avalanche control"
    } ]
  }, {
    "tStartMs": 1034475,
    "dDurationMs": 1665,
    "segs": [ {
      "utf8": "by firing artillery shells at one"
    } ]
  }, {
    "tStartMs": 1036140,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "of the 270 preset targets\non the nearby mountains,"
    } ]
  }, {
    "tStartMs": 1040130,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "releasing small avalanches"
    } ]
  }, {
    "tStartMs": 1041599,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "before they get a chance to become big"
    } ]
  }, {
    "tStartMs": 1044480,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "and destructive and damage the highway."
    } ]
  }, {
    "tStartMs": 1047870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Derek] Deaths from\navalanches do occasionally occur"
    } ]
  }, {
    "tStartMs": 1050420,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "in bounds at resorts,\nbut they are very rare."
    } ]
  }, {
    "tStartMs": 1053540,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "Due to the diligent\nwork of ski patrollers,"
    } ]
  }, {
    "tStartMs": 1055847,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "most avalanche injuries"
    } ]
  }, {
    "tStartMs": 1057470,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "and deaths occur in the back country."
    } ]
  }, {
    "tStartMs": 1062600,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- It's kind of crazy 'cause as a skier,"
    } ]
  }, {
    "tStartMs": 1064570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you hear so much about avalanches."
    } ]
  }, {
    "tStartMs": 1067210,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "(speaker speaking in a foreign language)"
    } ]
  }, {
    "tStartMs": 1068270,
    "dDurationMs": 3398,
    "segs": [ {
      "utf8": "- You realize it's deadly\nand people die every year."
    } ]
  }, {
    "tStartMs": 1071668,
    "dDurationMs": 1852,
    "segs": [ {
      "utf8": "(speaker speaking in a foreign language)"
    } ]
  }, {
    "tStartMs": 1073520,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- But to actually like feel the force"
    } ]
  }, {
    "tStartMs": 1076430,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "of the avalanche on your body,"
    } ]
  }, {
    "tStartMs": 1083240,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "like there's kind of nothing\nthat can prepare you for that."
    } ]
  }, {
    "tStartMs": 1088808,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(snow thudding)"
    } ]
  }, {
    "tStartMs": 1096860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Every time I hit the ground I\nwould just like dig my hands"
    } ]
  }, {
    "tStartMs": 1099260,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "in my feet in like try"
    } ]
  }, {
    "tStartMs": 1100520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to like claw myself down onto the ground"
    } ]
  }, {
    "tStartMs": 1102500,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "while also like trying to protect my head."
    } ]
  }, {
    "tStartMs": 1114020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I knew also like the\nmoment the snow stopped,"
    } ]
  }, {
    "tStartMs": 1116900,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "if I was still in the\nsnow, I would be buried."
    } ]
  }, {
    "tStartMs": 1119810,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "I wouldn't be able to move,"
    } ]
  }, {
    "tStartMs": 1120680,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "I would be counting on my buddy to find me"
    } ]
  }, {
    "tStartMs": 1124490,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "and dig me out and save me."
    } ]
  }, {
    "tStartMs": 1126824,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "(exhales heavily)"
    } ]
  }, {
    "tStartMs": 1135348,
    "dDurationMs": 3902,
    "segs": [ {
      "utf8": "(speaker speaking in a foreign language)"
    } ]
  }, {
    "tStartMs": 1139250,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- This wasn't a huge\navalanche, this was a size two,"
    } ]
  }, {
    "tStartMs": 1141920,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "so like big enough to bury\na car but not like a house."
    } ]
  }, {
    "tStartMs": 1146120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So I was actually able\nto stop on the slope"
    } ]
  }, {
    "tStartMs": 1149778,
    "dDurationMs": 936,
    "segs": [ {
      "utf8": "before it flattened out"
    } ]
  }, {
    "tStartMs": 1150714,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "where the snow would accumulate\nand I would be buried."
    } ]
  }, {
    "tStartMs": 1152781,
    "dDurationMs": 3569,
    "segs": [ {
      "utf8": "(speaker speaking in a foreign language)"
    } ]
  }, {
    "tStartMs": 1156350,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Yeah, it was intense, really intense"
    } ]
  }, {
    "tStartMs": 1158900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and I felt really stupid"
    } ]
  }, {
    "tStartMs": 1161060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "because it was the first\nmountain I ever skied"
    } ]
  }, {
    "tStartMs": 1163670,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "on as a kid was this\nmountain, like this very slope"
    } ]
  }, {
    "tStartMs": 1167750,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and so I was just so comfortable with it"
    } ]
  }, {
    "tStartMs": 1169490,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and like didn't think twice about the fact"
    } ]
  }, {
    "tStartMs": 1171350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that it was avalanche terrain and the snow"
    } ]
  }, {
    "tStartMs": 1173600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "or, I mean we did check the snow up top,"
    } ]
  }, {
    "tStartMs": 1175400,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "but I don't know, I\nwasn't like fully tuned"
    } ]
  }, {
    "tStartMs": 1177819,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "into to the dangers that are present."
    } ]
  }, {
    "tStartMs": 1181220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Like the moment you step\ninto avalanche terrain,"
    } ]
  }, {
    "tStartMs": 1183620,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "something like that can happen."
    } ]
  }, {
    "tStartMs": 1188630,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- So the three things that you need"
    } ]
  }, {
    "tStartMs": 1190220,
    "dDurationMs": 3355,
    "segs": [ {
      "utf8": "to bring when you go back\ncountry skiing is a beacon,"
    } ]
  }, {
    "tStartMs": 1193575,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "which is this thing, a probe,"
    } ]
  }, {
    "tStartMs": 1196955,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "which is this big, long stick\nthat ends up collapsing."
    } ]
  }, {
    "tStartMs": 1202460,
    "dDurationMs": 4271,
    "segs": [ {
      "utf8": "So it does fit in your\nbackpack and shovel."
    } ]
  }, {
    "tStartMs": 1206731,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "- [Derek] If you're buried\nin a slab avalanche,"
    } ]
  }, {
    "tStartMs": 1209330,
    "dDurationMs": 2575,
    "segs": [ {
      "utf8": "it's almost impossible\nto dig yourself out."
    } ]
  }, {
    "tStartMs": 1211905,
    "dDurationMs": 3125,
    "segs": [ {
      "utf8": "During an avalanche, the\nsnow gets mixed around"
    } ]
  }, {
    "tStartMs": 1215030,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "and friction heats it up\nso it melts a little bit"
    } ]
  }, {
    "tStartMs": 1218132,
    "dDurationMs": 1872,
    "segs": [ {
      "utf8": "and then when the avalanche stops,"
    } ]
  }, {
    "tStartMs": 1220004,
    "dDurationMs": 4056,
    "segs": [ {
      "utf8": "it refreezes, setting like concrete."
    } ]
  }, {
    "tStartMs": 1224060,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And that's why if you're fully\nburied, you need someone else"
    } ]
  }, {
    "tStartMs": 1226970,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to find you and dig you out."
    } ]
  }, {
    "tStartMs": 1229430,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "This is why in 1968 the\navalanche beacon was invented."
    } ]
  }, {
    "tStartMs": 1234380,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- The beacon is a transceiver,\nso it is both a transmitter"
    } ]
  }, {
    "tStartMs": 1240350,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and a receiver of electromagnetic waves"
    } ]
  }, {
    "tStartMs": 1242990,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "at 457 kilohertz."
    } ]
  }, {
    "tStartMs": 1246020,
    "dDurationMs": 2429,
    "segs": [ {
      "utf8": "So right now it is send mode."
    } ]
  }, {
    "tStartMs": 1248449,
    "dDurationMs": 2131,
    "segs": [ {
      "utf8": "So this is the mode it would be on"
    } ]
  }, {
    "tStartMs": 1250580,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "if I'm skiing in the backcountry"
    } ]
  }, {
    "tStartMs": 1252260,
    "dDurationMs": 1181,
    "segs": [ {
      "utf8": "and if there's an avalanche,"
    } ]
  }, {
    "tStartMs": 1253441,
    "dDurationMs": 2629,
    "segs": [ {
      "utf8": "what would happen is\nit'll keep sending out"
    } ]
  }, {
    "tStartMs": 1256070,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "those electromagnetic waves\nin all of these directions."
    } ]
  }, {
    "tStartMs": 1259250,
    "dDurationMs": 4174,
    "segs": [ {
      "utf8": "Then my buddies would change\nfrom send mode to search mode"
    } ]
  }, {
    "tStartMs": 1263424,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "and start looking for that signal."
    } ]
  }, {
    "tStartMs": 1266090,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And what that looks like"
    } ]
  }, {
    "tStartMs": 1268670,
    "dDurationMs": 2048,
    "segs": [ {
      "utf8": "is that Aaron is two meters away from me"
    } ]
  }, {
    "tStartMs": 1270718,
    "dDurationMs": 3472,
    "segs": [ {
      "utf8": "and her beacon is on\nand it's saying, cool,"
    } ]
  }, {
    "tStartMs": 1274190,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "there's a person two\nmeters away from me, so."
    } ]
  }, {
    "tStartMs": 1278360,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "- Around 25% of avalanche fatalities"
    } ]
  }, {
    "tStartMs": 1280856,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "are from trauma hitting a tree"
    } ]
  }, {
    "tStartMs": 1283040,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "or a rock or being pushed off a cliff."
    } ]
  }, {
    "tStartMs": 1285144,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "The rest are from asphyxiation."
    } ]
  }, {
    "tStartMs": 1288325,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "If you're buried in an avalanche"
    } ]
  }, {
    "tStartMs": 1290450,
    "dDurationMs": 1684,
    "segs": [ {
      "utf8": "and your face is under the snow,"
    } ]
  }, {
    "tStartMs": 1292134,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "there's a small air\npocket for you to breathe."
    } ]
  }, {
    "tStartMs": 1295370,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The snow is initially porous,\nbut the heat from your body"
    } ]
  }, {
    "tStartMs": 1298550,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and breath melts the snow,"
    } ]
  }, {
    "tStartMs": 1300350,
    "dDurationMs": 3208,
    "segs": [ {
      "utf8": "which refreezes forming\nan impermeable bubble."
    } ]
  }, {
    "tStartMs": 1303558,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "As you breathe, the concentration of CO2"
    } ]
  }, {
    "tStartMs": 1306398,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "in that bubble increases"
    } ]
  }, {
    "tStartMs": 1308025,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "and the amount of oxygen decreases"
    } ]
  }, {
    "tStartMs": 1310212,
    "dDurationMs": 3608,
    "segs": [ {
      "utf8": "until you die from asphyxiation."
    } ]
  }, {
    "tStartMs": 1313820,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "If your friends find"
    } ]
  }, {
    "tStartMs": 1314930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and dig you out in the first 10 minutes,"
    } ]
  }, {
    "tStartMs": 1316880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "you have an 80% chance of survival."
    } ]
  }, {
    "tStartMs": 1319700,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "15 minutes in, that chance drops to 40%,"
    } ]
  }, {
    "tStartMs": 1322570,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "30 minutes in, you have just\na 22% chance of survival."
    } ]
  }, {
    "tStartMs": 1327620,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "So time is key."
    } ]
  }, {
    "tStartMs": 1331820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "There is another invention\nthat could save your life,"
    } ]
  }, {
    "tStartMs": 1334460,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which is an avalanche airbag."
    } ]
  }, {
    "tStartMs": 1336920,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "If a skier triggers an avalanche,\nthey can pull on a cord,"
    } ]
  }, {
    "tStartMs": 1340310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which activates the airbag."
    } ]
  }, {
    "tStartMs": 1342320,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The airbag rapidly inflates."
    } ]
  }, {
    "tStartMs": 1344630,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Historically this was\ndone with compressed air,"
    } ]
  }, {
    "tStartMs": 1346970,
    "dDurationMs": 3206,
    "segs": [ {
      "utf8": "but newer versions use\nbattery powered fans."
    } ]
  }, {
    "tStartMs": 1350176,
    "dDurationMs": 3064,
    "segs": [ {
      "utf8": "The airbag increases the skier's buoyancy,"
    } ]
  }, {
    "tStartMs": 1353240,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "making it less likely for them"
    } ]
  }, {
    "tStartMs": 1354620,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to be buried deeply in an avalanche."
    } ]
  }, {
    "tStartMs": 1357140,
    "dDurationMs": 2389,
    "segs": [ {
      "utf8": "An added benefit is that\nif the skier is buried"
    } ]
  }, {
    "tStartMs": 1359529,
    "dDurationMs": 1646,
    "segs": [ {
      "utf8": "as the airbag deflates,"
    } ]
  }, {
    "tStartMs": 1361175,
    "dDurationMs": 3405,
    "segs": [ {
      "utf8": "it leaves a larger air\npocket providing more time"
    } ]
  }, {
    "tStartMs": 1364580,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "to be rescued."
    } ]
  }, {
    "tStartMs": 1365793,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "Avalanche airbags decrease\nthe chances of death"
    } ]
  }, {
    "tStartMs": 1368627,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "by nearly half."
    } ]
  }, {
    "tStartMs": 1373730,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Around 30 people in the US\ndie in avalanches each year,"
    } ]
  }, {
    "tStartMs": 1377930,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "plus an additional hundred in Europe."
    } ]
  }, {
    "tStartMs": 1380660,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Most of them are backcountry\nskiers, snowboarders"
    } ]
  }, {
    "tStartMs": 1383600,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "or snowmobilers,"
    } ]
  }, {
    "tStartMs": 1385070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and they very likely triggered"
    } ]
  }, {
    "tStartMs": 1386870,
    "dDurationMs": 1776,
    "segs": [ {
      "utf8": "the avalanche that killed them."
    } ]
  }, {
    "tStartMs": 1388646,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "Avalanches are beautiful, majestic,"
    } ]
  }, {
    "tStartMs": 1391523,
    "dDurationMs": 2847,
    "segs": [ {
      "utf8": "and completely terrifying."
    } ]
  }, {
    "tStartMs": 1394370,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "If you go into the backcountry in winter,"
    } ]
  }, {
    "tStartMs": 1396500,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "please carry a shovel,\na probe, and a beacon,"
    } ]
  }, {
    "tStartMs": 1399240,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "but also check the avalanche forecast"
    } ]
  }, {
    "tStartMs": 1401750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and make good decisions when heading out"
    } ]
  }, {
    "tStartMs": 1403700,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to avalanche terrain."
    } ]
  }, {
    "tStartMs": 1405230,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "Because the best way\nto survive an avalanche"
    } ]
  }, {
    "tStartMs": 1407497,
    "dDurationMs": 2896,
    "segs": [ {
      "utf8": "is not to be caught in one."
    } ]
  }, {
    "tStartMs": 1418310,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We know so much about avalanches today,"
    } ]
  }, {
    "tStartMs": 1420560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "thanks to people like Bruce,"
    } ]
  }, {
    "tStartMs": 1422450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "people who followed their curiosity"
    } ]
  }, {
    "tStartMs": 1424400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and learned through discovery."
    } ]
  }, {
    "tStartMs": 1426560,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But thankfully, you don't have\nto go into avalanche terrain"
    } ]
  }, {
    "tStartMs": 1429650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to experience this kind of learning."
    } ]
  }, {
    "tStartMs": 1432110,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "You can get started right now for free"
    } ]
  }, {
    "tStartMs": 1434180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with today's sponsor, Brilliant."
    } ]
  }, {
    "tStartMs": 1436340,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "On Brilliant, you'll learn\nby doing with thousands"
    } ]
  }, {
    "tStartMs": 1439430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of interactive lessons\nin everything from math"
    } ]
  }, {
    "tStartMs": 1441740,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and data science to programming,\ntechnology, you name it."
    } ]
  }, {
    "tStartMs": 1445790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "You'll not only gain\nknowledge of key concepts,"
    } ]
  }, {
    "tStartMs": 1448220,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but learn to apply them\nto real world situations."
    } ]
  }, {
    "tStartMs": 1451160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And with every lesson,"
    } ]
  }, {
    "tStartMs": 1452360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "you'll also be honing your\ncritical thinking skills,"
    } ]
  }, {
    "tStartMs": 1454820,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "giving you the tools"
    } ]
  }, {
    "tStartMs": 1455930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "to solve whatever problems come your way."
    } ]
  }, {
    "tStartMs": 1458360,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "On Brilliant, you can explore just about"
    } ]
  }, {
    "tStartMs": 1460250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "anything you're curious about."
    } ]
  }, {
    "tStartMs": 1461930,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "I mean really explore it by\ndragging and dropping shapes"
    } ]
  }, {
    "tStartMs": 1465470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and snippets of code,\nplaying with variables"
    } ]
  }, {
    "tStartMs": 1467900,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and data, even running\nyour own simulations"
    } ]
  }, {
    "tStartMs": 1470360,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "until concepts just click."
    } ]
  }, {
    "tStartMs": 1472580,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And my favorite part is\neach lesson is bite-sized."
    } ]
  }, {
    "tStartMs": 1475520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So you can do it in minutes\nright from your phone,"
    } ]
  }, {
    "tStartMs": 1478640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "just commit to five\nminutes of daily learning"
    } ]
  }, {
    "tStartMs": 1481490,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and watch your knowledge\ncompound over time."
    } ]
  }, {
    "tStartMs": 1484130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Now, for viewers of this video,"
    } ]
  }, {
    "tStartMs": 1485510,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Brilliant is offering 20%"
    } ]
  }, {
    "tStartMs": 1487010,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "off their annual premium subscription."
    } ]
  }, {
    "tStartMs": 1489962,
    "dDurationMs": 1938,
    "segs": [ {
      "utf8": "Just go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1491900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I will put that link\ndown in the description"
    } ]
  }, {
    "tStartMs": 1493910,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or you can scan the QR code."
    } ]
  }, {
    "tStartMs": 1496100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So once again, I want to thank Brilliant"
    } ]
  }, {
    "tStartMs": 1497930,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "for sponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 1499400,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
