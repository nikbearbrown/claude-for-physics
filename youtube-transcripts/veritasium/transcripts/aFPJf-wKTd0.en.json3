{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "A portion of this video\nwas sponsored by Salesforce."
    } ]
  }, {
    "tStartMs": 3710,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "This is the biggest, most\nin-depth video about bowling ever."
    } ]
  }, {
    "tStartMs": 8250,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "How bowling balls are made,\nthe best way to throw them,"
    } ]
  }, {
    "tStartMs": 10690,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "maximize strikes, how the lanes are oiled,"
    } ]
  }, {
    "tStartMs": 13400,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "what it takes to be a pro"
    } ]
  }, {
    "tStartMs": 15190,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "and how this sport has\ncontinually been reinvented"
    } ]
  }, {
    "tStartMs": 17970,
    "dDurationMs": 4038,
    "segs": [ {
      "utf8": "for literally thousands of\nyears, up to the present day."
    } ]
  }, {
    "tStartMs": 22008,
    "dDurationMs": 932,
    "segs": [ {
      "utf8": "(bowling strikes)"
    } ]
  }, {
    "tStartMs": 22940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "This is the science of bowling,"
    } ]
  }, {
    "tStartMs": 24560,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "the most popular participatory\nsport in the United States."
    } ]
  }, {
    "tStartMs": 29630,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "I'm super impressed with how that went."
    } ]
  }, {
    "tStartMs": 31300,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "- I'm even more impressed than you are."
    } ]
  }, {
    "tStartMs": 34160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "- What is inside a bowling ball?"
    } ]
  }, {
    "tStartMs": 36640,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "I sent this ball to Creative Electron"
    } ]
  }, {
    "tStartMs": 38430,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "to get a 3D x-ray scan"
    } ]
  }, {
    "tStartMs": 41050,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "and this is the result."
    } ]
  }, {
    "tStartMs": 44150,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "What is that?"
    } ]
  }, {
    "tStartMs": 44990,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "I always expected bowling\nballs to be, you know,"
    } ]
  }, {
    "tStartMs": 47170,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "perfect solid spheres, but\nthere's something inside here"
    } ]
  }, {
    "tStartMs": 51120,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "and it's not symmetric"
    } ]
  }, {
    "tStartMs": 53450,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "and it's not even centered in the ball."
    } ]
  }, {
    "tStartMs": 56290,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "So I went to Storm Bowling,"
    } ]
  }, {
    "tStartMs": 57950,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "one of only 11 bowling ball\nmanufacturers in the world"
    } ]
  }, {
    "tStartMs": 60420,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "to find out how bowling balls are made."
    } ]
  }, {
    "tStartMs": 63580,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- Yeah. Basically when\nwe make bowling balls,"
    } ]
  }, {
    "tStartMs": 65550,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "we always start in the center"
    } ]
  }, {
    "tStartMs": 67040,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and the center part of the\nbowling ball is the weight block."
    } ]
  }, {
    "tStartMs": 69800,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "And as you can see this is an example"
    } ]
  }, {
    "tStartMs": 71370,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "of an asymmetrical shaped weight block,"
    } ]
  }, {
    "tStartMs": 73360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "so it's actually a different shape"
    } ]
  }, {
    "tStartMs": 75040,
    "dDurationMs": 3098,
    "segs": [ {
      "utf8": "about the X, the Y and the Z axis."
    } ]
  }, {
    "tStartMs": 78138,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(serene music)"
    } ]
  }, {
    "tStartMs": 83000,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- The weight blocks are embedded"
    } ]
  }, {
    "tStartMs": 84470,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "in a core of lightweight glass beads."
    } ]
  }, {
    "tStartMs": 90100,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "- That is so silky-soft."
    } ]
  }, {
    "tStartMs": 92600,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "I feel like I have not\nfelt anything this soft."
    } ]
  }, {
    "tStartMs": 95920,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "What's the difference in density between"
    } ]
  }, {
    "tStartMs": 97990,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "this sort of filling\nmaterial and this core?"
    } ]
  }, {
    "tStartMs": 100470,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- It's quite a bit."
    } ]
  }, {
    "tStartMs": 101310,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "About two and a half to\nthree times more dense"
    } ]
  }, {
    "tStartMs": 103910,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "in the inner weight block"
    } ]
  }, {
    "tStartMs": 105430,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "than it is in the core material."
    } ]
  }, {
    "tStartMs": 111280,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- If you were to look for\nexample at this actual core."
    } ]
  }, {
    "tStartMs": 114440,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "Number one, it says 9 6 0"
    } ]
  }, {
    "tStartMs": 116130,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "which means that it weighs 9.60 pounds."
    } ]
  }, {
    "tStartMs": 118360,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And then the description here underneath,"
    } ]
  }, {
    "tStartMs": 120010,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "which is a 0 3,"
    } ]
  }, {
    "tStartMs": 121050,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "this indicates what type of a\nweight block is inside of it."
    } ]
  }, {
    "tStartMs": 125140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- What happens over here?"
    } ]
  }, {
    "tStartMs": 126550,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- So this area right here\nis our urethane area."
    } ]
  }, {
    "tStartMs": 129730,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "So basically what we have"
    } ]
  }, {
    "tStartMs": 131400,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "are a number of different\ntanks that are set up."
    } ]
  }, {
    "tStartMs": 133900,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So there's a chemical reaction that occurs"
    } ]
  }, {
    "tStartMs": 136150,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "once it actually fills the mold"
    } ]
  }, {
    "tStartMs": 137750,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "and we pour that cover stock\nmaterial around the pour."
    } ]
  }, {
    "tStartMs": 140740,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "It gets extremely hot in\njust a matter of minutes."
    } ]
  }, {
    "tStartMs": 146170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "You go right down here,"
    } ]
  }, {
    "tStartMs": 147640,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "she's actually pouring the pin material"
    } ]
  }, {
    "tStartMs": 149500,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "inside the tops of those cores."
    } ]
  }, {
    "tStartMs": 151490,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So you can see for this\nparticular bowling ball,"
    } ]
  }, {
    "tStartMs": 153680,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "it's a bright orange type of a material,"
    } ]
  }, {
    "tStartMs": 155640,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "and she's actually filling that hole"
    } ]
  }, {
    "tStartMs": 157550,
    "dDurationMs": 1363,
    "segs": [ {
      "utf8": "with that plug material."
    } ]
  }, {
    "tStartMs": 161100,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "We've got the lane at the right here"
    } ]
  }, {
    "tStartMs": 162330,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "which is where we take the\nballs that come out of the mold."
    } ]
  }, {
    "tStartMs": 165110,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "And then they actually\nspin almost 2000 RPM."
    } ]
  }, {
    "tStartMs": 168270,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "On top of there there's\nthe blades that come around"
    } ]
  }, {
    "tStartMs": 170780,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and it actually makes the\nballs perfectly round."
    } ]
  }, {
    "tStartMs": 173480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So they'll actually trim those up."
    } ]
  }, {
    "tStartMs": 175480,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- [Derek] Since the\nballs are not symmetric,"
    } ]
  }, {
    "tStartMs": 177230,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "they are heavier on one\nside than the other."
    } ]
  }, {
    "tStartMs": 179640,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "- And you can see there the\nlast four or five pumps of air,"
    } ]
  }, {
    "tStartMs": 182170,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "where it actually floats the\nair then it stops and pauses,"
    } ]
  }, {
    "tStartMs": 184860,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "that the ball has completely settled."
    } ]
  }, {
    "tStartMs": 186440,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "And then basically a needle will come out"
    } ]
  }, {
    "tStartMs": 188100,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "from the bottom part"
    } ]
  }, {
    "tStartMs": 189380,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and all of a sudden it'll shoot it up."
    } ]
  }, {
    "tStartMs": 191140,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And then it'll be where\nthe center of gravity is"
    } ]
  }, {
    "tStartMs": 193150,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "on the surface of the ball."
    } ]
  }, {
    "tStartMs": 196600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "- When it comes right\noff the lane, right here,"
    } ]
  }, {
    "tStartMs": 199400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it is extremely porous\nand very, very dull,"
    } ]
  }, {
    "tStartMs": 202160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and there is a ton of friction"
    } ]
  }, {
    "tStartMs": 203900,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "between the ball and\nthe lane at this point."
    } ]
  }, {
    "tStartMs": 205810,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "So every ball from right\nhere will be smoothed up,"
    } ]
  }, {
    "tStartMs": 208520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it's just a matter of how\nmuch it's gonna be smoothed up"
    } ]
  }, {
    "tStartMs": 211280,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "in order to get what\nis the desired finish."
    } ]
  }, {
    "tStartMs": 216680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- [Derek] But before\nthey can use these balls,"
    } ]
  }, {
    "tStartMs": 218520,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "they have to be drilled."
    } ]
  }, {
    "tStartMs": 219890,
    "dDurationMs": 2023,
    "segs": [ {
      "utf8": "But that is specific to each bowler."
    } ]
  }, {
    "tStartMs": 222880,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "How many balls are you making a day?"
    } ]
  }, {
    "tStartMs": 224750,
    "dDurationMs": 2783,
    "segs": [ {
      "utf8": "- [Steve] We're making over\n3000 balls in a day now."
    } ]
  }, {
    "tStartMs": 227533,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "they come out of this plant right here."
    } ]
  }, {
    "tStartMs": 230597,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(smooth calm music)"
    } ]
  }, {
    "tStartMs": 238060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Wild."
    } ]
  }, {
    "tStartMs": 239830,
    "dDurationMs": 2697,
    "segs": [ {
      "utf8": "I found the bowling ball\nequivalent of clickbait."
    } ]
  }, {
    "tStartMs": 242527,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "\"You won't believe your eyes\","
    } ]
  }, {
    "tStartMs": 244317,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "\"The mind bending hook\"."
    } ]
  }, {
    "tStartMs": 247430,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Right?\n- Yeah."
    } ]
  }, {
    "tStartMs": 248630,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "It's how you have to sell your stuff."
    } ]
  }, {
    "tStartMs": 249810,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "I get it.\n- Exactly. Yeah."
    } ]
  }, {
    "tStartMs": 251720,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "- [Derek] But how did\nit come to be this way?"
    } ]
  }, {
    "tStartMs": 254730,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Well, bowling seems to be an ancient game."
    } ]
  }, {
    "tStartMs": 257730,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Archeologists have found\nwall drawings of a sport"
    } ]
  }, {
    "tStartMs": 260120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that looks like bowling in\nan ancient Egyptian tomb"
    } ]
  }, {
    "tStartMs": 263240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "dating back 7,000 years."
    } ]
  }, {
    "tStartMs": 266200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "In Germany, bowling was\nused as a religious ritual."
    } ]
  }, {
    "tStartMs": 269440,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Pins represented your sins,"
    } ]
  }, {
    "tStartMs": 271510,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "so you're a good Christian if\nyou could knock them all down."
    } ]
  }, {
    "tStartMs": 274620,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Martin Luther himself was\napparently a bowling fanatic"
    } ]
  }, {
    "tStartMs": 277360,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "and fixed the number of pins at nine."
    } ]
  }, {
    "tStartMs": 280130,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "When the game made its\nway over to America,"
    } ]
  }, {
    "tStartMs": 282330,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "nine-pin bowling was banned\nbecause it promoted gambling."
    } ]
  }, {
    "tStartMs": 285860,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "The legend goes that people\ncleverly came up with"
    } ]
  }, {
    "tStartMs": 288000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "10-pin bowling to get around the law."
    } ]
  }, {
    "tStartMs": 290220,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Whoa, totally different game."
    } ]
  }, {
    "tStartMs": 292720,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Today in the US, nine-pin\nbowling is only played in Texas"
    } ]
  }, {
    "tStartMs": 296200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "because it was the one\nstate that didn't ban it,"
    } ]
  }, {
    "tStartMs": 298450,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "instead, charging it tax."
    } ]
  }, {
    "tStartMs": 301820,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Bowling lanes are about\nthree-and-a-half-feet wide"
    } ]
  }, {
    "tStartMs": 304300,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "and 60 feet long down to the headpin."
    } ]
  }, {
    "tStartMs": 307130,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I'm using Imperial units here"
    } ]
  }, {
    "tStartMs": 308530,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "because that's actually\nhow they're defined."
    } ]
  }, {
    "tStartMs": 311310,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The lane is made of 39 narrow boards"
    } ]
  }, {
    "tStartMs": 313870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that bowlers number for reference."
    } ]
  }, {
    "tStartMs": 315820,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "They used to be made\nof maple and pinewood,"
    } ]
  }, {
    "tStartMs": 317700,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "but these days, most lanes are synthetic"
    } ]
  }, {
    "tStartMs": 320360,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "and made of fine particles\ncoated with melamine resin."
    } ]
  }, {
    "tStartMs": 323770,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "One game of bowling gives you 10 frames"
    } ]
  }, {
    "tStartMs": 326360,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "with two throws per frame"
    } ]
  }, {
    "tStartMs": 328150,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to try to knock down all 10 pins."
    } ]
  }, {
    "tStartMs": 330490,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The highest score you can get\nin a game without a strike"
    } ]
  }, {
    "tStartMs": 333070,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "is only 190,"
    } ]
  }, {
    "tStartMs": 335100,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "but strikes allow you to double\ncount your next two throws,"
    } ]
  }, {
    "tStartMs": 338130,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so a perfect game with all strikes"
    } ]
  }, {
    "tStartMs": 340320,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "gives you a score of 300."
    } ]
  }, {
    "tStartMs": 343220,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "If you're anything like me,"
    } ]
  }, {
    "tStartMs": 344390,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the whole game is just"
    } ]
  }, {
    "tStartMs": 345590,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "trying to throw the ball\nas straight as you can"
    } ]
  }, {
    "tStartMs": 347730,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "down the middle of the\nlane, hit the headpin"
    } ]
  }, {
    "tStartMs": 349970,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "and try to take as many other\npins down with it as possible."
    } ]
  }, {
    "tStartMs": 353550,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "Do you wanna give me any tips or-"
    } ]
  }, {
    "tStartMs": 354640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "- I've watched LeBron bowling,\nyou won't be worse than him."
    } ]
  }, {
    "tStartMs": 356960,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "- You say that now you."
    } ]
  }, {
    "tStartMs": 358321,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(Chris laughs)"
    } ]
  }, {
    "tStartMs": 362300,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- See, that's what I would normally do."
    } ]
  }, {
    "tStartMs": 363440,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And I would normally be like"
    } ]
  }, {
    "tStartMs": 364520,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "reasonably happy with a shot like that."
    } ]
  }, {
    "tStartMs": 366370,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "But for pro-bowlers like\nPete Weber or Chris Barnes,"
    } ]
  }, {
    "tStartMs": 369080,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "- [Narrator] For a perfect game,"
    } ]
  }, {
    "tStartMs": 370617,
    "dDurationMs": 1103,
    "segs": [ {
      "utf8": "- Yes!"
    } ]
  }, {
    "tStartMs": 371720,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "- [Derek] The game is different."
    } ]
  }, {
    "tStartMs": 373540,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "And not just because they\nare way better than me."
    } ]
  }, {
    "tStartMs": 375742,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "- [Narrator] And he get it!"
    } ]
  }, {
    "tStartMs": 376808,
    "dDurationMs": 1146,
    "segs": [ {
      "utf8": "(crowd cheering)"
    } ]
  }, {
    "tStartMs": 377954,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Who you think that you are? I am."
    } ]
  }, {
    "tStartMs": 380144,
    "dDurationMs": 3826,
    "segs": [ {
      "utf8": "(crowd continues cheering)"
    } ]
  }, {
    "tStartMs": 383970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Hitting the headpins square on"
    } ]
  }, {
    "tStartMs": 385740,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "is not the perfect strategy."
    } ]
  }, {
    "tStartMs": 389290,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "If you hit the headpin\nsquare on going straight,"
    } ]
  }, {
    "tStartMs": 391990,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you're unlikely to\nknock down all the pins."
    } ]
  }, {
    "tStartMs": 394690,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You could end up with a split"
    } ]
  }, {
    "tStartMs": 395810,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "where the ball goes through the middle,"
    } ]
  }, {
    "tStartMs": 397260,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or with the ball\ndeflecting off to one side"
    } ]
  }, {
    "tStartMs": 399420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "after hitting the headpin."
    } ]
  }, {
    "tStartMs": 401100,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Chances for a strike are much higher"
    } ]
  }, {
    "tStartMs": 403120,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "if the center of the ball hits the pins"
    } ]
  }, {
    "tStartMs": 405140,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "just to one side of the headpin."
    } ]
  }, {
    "tStartMs": 407360,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Board 17 and a half."
    } ]
  }, {
    "tStartMs": 409590,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "In which case the ball takes\nout the 1, 3, 5, and 9 pins,"
    } ]
  }, {
    "tStartMs": 413910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "which take out the others."
    } ]
  }, {
    "tStartMs": 415890,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "- So we want the ball\nto hit the 1 pin, the 3,"
    } ]
  }, {
    "tStartMs": 418840,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "the pin behind the 1, which is the 5 pin."
    } ]
  }, {
    "tStartMs": 421230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And then the 9 or the 8 and the 9."
    } ]
  }, {
    "tStartMs": 423000,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "- [Derek] You want the ball\nto hit all of those pins?"
    } ]
  }, {
    "tStartMs": 424552,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Chris] Yeah."
    } ]
  }, {
    "tStartMs": 425385,
    "dDurationMs": 2225,
    "segs": [ {
      "utf8": "- Now the pins don't always fall this way,"
    } ]
  }, {
    "tStartMs": 427610,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but the pin shape helps."
    } ]
  }, {
    "tStartMs": 429610,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Pins roll in circles like eggs,"
    } ]
  }, {
    "tStartMs": 431950,
    "dDurationMs": 1963,
    "segs": [ {
      "utf8": "which help knock down the others."
    } ]
  }, {
    "tStartMs": 437824,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "- That's right baby!"
    } ]
  }, {
    "tStartMs": 439400,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "Come on, don't miss."
    } ]
  }, {
    "tStartMs": 440250,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "You wanted it, you got it."
    } ]
  }, {
    "tStartMs": 442140,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- [Derek] But to have an over 90% chance"
    } ]
  }, {
    "tStartMs": 444110,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "of getting a strike,"
    } ]
  }, {
    "tStartMs": 445230,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "the center of the ball has to hit"
    } ]
  }, {
    "tStartMs": 447000,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "with an error smaller than half a board."
    } ]
  }, {
    "tStartMs": 449680,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Needless to say, throwing a ball 60 feet"
    } ]
  }, {
    "tStartMs": 451780,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "straight at a target smaller\nthan a dime is a tough task."
    } ]
  }, {
    "tStartMs": 455540,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "Especially to do it consistently."
    } ]
  }, {
    "tStartMs": 458350,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Luckily there is a better way."
    } ]
  }, {
    "tStartMs": 461380,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "- Now, if we look at the pins"
    } ]
  }, {
    "tStartMs": 462570,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and as you look at them\nfrom here, from straight on,"
    } ]
  }, {
    "tStartMs": 465490,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "the spot between the headpin,"
    } ]
  }, {
    "tStartMs": 467660,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "the one that's in the center,"
    } ]
  }, {
    "tStartMs": 468580,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "and the 3 pin which is just right at that,"
    } ]
  }, {
    "tStartMs": 470370,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "that gap's pretty narrow."
    } ]
  }, {
    "tStartMs": 472150,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But as the ball hooks more,"
    } ]
  }, {
    "tStartMs": 474010,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "now we basically shift over,"
    } ]
  }, {
    "tStartMs": 475910,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "and now that space is considerably wider."
    } ]
  }, {
    "tStartMs": 479040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- [Derek] If you can hit\nthe pins not head-on,"
    } ]
  }, {
    "tStartMs": 481040,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "but at an angle of six degrees,"
    } ]
  }, {
    "tStartMs": 483660,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "you dramatically increase your chances"
    } ]
  }, {
    "tStartMs": 485840,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "of knocking them all down."
    } ]
  }, {
    "tStartMs": 487530,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Now the margin for error is greater."
    } ]
  }, {
    "tStartMs": 490430,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "The ball can be coming in"
    } ]
  }, {
    "tStartMs": 491440,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "anywhere from board 17 to 18 and a half,"
    } ]
  }, {
    "tStartMs": 495200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that is a board and a half of room."
    } ]
  }, {
    "tStartMs": 497360,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "And that still gives you"
    } ]
  }, {
    "tStartMs": 498520,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "greater than a 90% chance of a strike."
    } ]
  }, {
    "tStartMs": 501660,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Now, six degrees may not sound like a lot,"
    } ]
  }, {
    "tStartMs": 503650,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "but it's actually\nextremely difficult to hit."
    } ]
  }, {
    "tStartMs": 506490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The problem is, if you\nwanted to throw the ball"
    } ]
  }, {
    "tStartMs": 508530,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "straight at the pins and\nhit them at six degrees,"
    } ]
  }, {
    "tStartMs": 511250,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "you would have to be bowling\nfrom 3/4 over on the next lane."
    } ]
  }, {
    "tStartMs": 515700,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And that is impossible."
    } ]
  }, {
    "tStartMs": 517350,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "Well, with the two gutters\nin between and all."
    } ]
  }, {
    "tStartMs": 520060,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "So the solution is"
    } ]
  }, {
    "tStartMs": 521490,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "you've got to curve the ball on one lane."
    } ]
  }, {
    "tStartMs": 524460,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I feel like I have never spun a ball."
    } ]
  }, {
    "tStartMs": 526830,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Is that, (Derek laughs)"
    } ]
  }, {
    "tStartMs": 528360,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Is that hard?"
    } ]
  }, {
    "tStartMs": 529330,
    "dDurationMs": 927,
    "segs": [ {
      "utf8": "- So if you've got it under your hand"
    } ]
  }, {
    "tStartMs": 530257,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "and the ball's underneath,"
    } ]
  }, {
    "tStartMs": 531750,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and you're trying to spin it,"
    } ]
  }, {
    "tStartMs": 533450,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that's especially the motion\nthat players use these days."
    } ]
  }, {
    "tStartMs": 536410,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "- [Derek] This really became"
    } ]
  }, {
    "tStartMs": 537540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "a big part of the sport by accident."
    } ]
  }, {
    "tStartMs": 539820,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "- The wood gets beat up"
    } ]
  }, {
    "tStartMs": 541210,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "with the damage from all\nthe balls going into it."
    } ]
  }, {
    "tStartMs": 543650,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "And so they basically created slip agents,"
    } ]
  }, {
    "tStartMs": 545680,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "lubricants much like oil on a car"
    } ]
  }, {
    "tStartMs": 548310,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "so that the lanes didn't\nget damaged so quickly."
    } ]
  }, {
    "tStartMs": 550950,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "- [Derek] So the original\nidea was to protect the wood."
    } ]
  }, {
    "tStartMs": 553060,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "- The original idea was"
    } ]
  }, {
    "tStartMs": 554270,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "just to protect the surface of the lane."
    } ]
  }, {
    "tStartMs": 555810,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "It was not to manufacture anything"
    } ]
  }, {
    "tStartMs": 557990,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "for my competitive-scoring\ntype environment."
    } ]
  }, {
    "tStartMs": 560940,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "- But applying oil to protect the wood"
    } ]
  }, {
    "tStartMs": 563300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "meant that balls no longer grip the lane"
    } ]
  }, {
    "tStartMs": 565520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and roll without slipping\ndown to the pins."
    } ]
  }, {
    "tStartMs": 567680,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Instead they could skid,"
    } ]
  }, {
    "tStartMs": 569630,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "rotating not in their direction of travel."
    } ]
  }, {
    "tStartMs": 575260,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Now, I've been to a lot of bowling alleys"
    } ]
  }, {
    "tStartMs": 577460,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "before making this video"
    } ]
  }, {
    "tStartMs": 578610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and I noticed it was a bit greasy,"
    } ]
  }, {
    "tStartMs": 580380,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "but I always thought that was just"
    } ]
  }, {
    "tStartMs": 581840,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "the nature of bowling alleys."
    } ]
  }, {
    "tStartMs": 583490,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Like the stinky rental shoes."
    } ]
  }, {
    "tStartMs": 585500,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "I didn't know they intentionally\nput oil on the lanes."
    } ]
  }, {
    "tStartMs": 588850,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Vox has a great video\nspecifically about oil patterns."
    } ]
  }, {
    "tStartMs": 592810,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "These days, there are machines"
    } ]
  }, {
    "tStartMs": 594300,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "specifically for applying\noil to the lanes."
    } ]
  }, {
    "tStartMs": 598660,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "- [Chris] And then as proprietors went,"
    } ]
  }, {
    "tStartMs": 599927,
    "dDurationMs": 2413,
    "segs": [ {
      "utf8": "\"Huh, well yeah, it\ndoes make the ball skid."
    } ]
  }, {
    "tStartMs": 602340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Well, if I put more in the\nmiddle than the outside"
    } ]
  }, {
    "tStartMs": 604500,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "my baller's bowl a little bit\nbetter and they're happier.\""
    } ]
  }, {
    "tStartMs": 607330,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "And then as technology\nadvances like everything does"
    } ]
  }, {
    "tStartMs": 609600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "now we have $30,000 lane machines"
    } ]
  }, {
    "tStartMs": 611820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that can put a specific\namount of oil on each board."
    } ]
  }, {
    "tStartMs": 614610,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "- [Derek] They work kind of\nlike dot matrix printers."
    } ]
  }, {
    "tStartMs": 617020,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "They can lay the oil on"
    } ]
  }, {
    "tStartMs": 618600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "with varying degrees of\nthickness across the lane"
    } ]
  }, {
    "tStartMs": 621090,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "and extend the oil pattern\ndifferent distances."
    } ]
  }, {
    "tStartMs": 623780,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "There are hundreds of different\npatterns that can be used."
    } ]
  }, {
    "tStartMs": 627210,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Usually the oil extends about\n2/3 the way down the lane,"
    } ]
  }, {
    "tStartMs": 630670,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "so to around 40 or 45 feet."
    } ]
  }, {
    "tStartMs": 633210,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But there's always a dry\npatch of wood before the pins"
    } ]
  }, {
    "tStartMs": 636150,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "that increases the friction with the ball,"
    } ]
  }, {
    "tStartMs": 638380,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "getting it to start\nrolling without slipping."
    } ]
  }, {
    "tStartMs": 641350,
    "dDurationMs": 3443,
    "segs": [ {
      "utf8": "And this leads to the three\nparts of any pro bowler's throw."
    } ]
  }, {
    "tStartMs": 646000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "The skid,"
    } ]
  }, {
    "tStartMs": 647800,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "the hook"
    } ]
  }, {
    "tStartMs": 649100,
    "dDurationMs": 1273,
    "segs": [ {
      "utf8": "and the roll."
    } ]
  }, {
    "tStartMs": 651650,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "When a bowler releases the ball,"
    } ]
  }, {
    "tStartMs": 653190,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "it can be going 20 miles an hour"
    } ]
  }, {
    "tStartMs": 655420,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "and spinning at 500 RPM."
    } ]
  }, {
    "tStartMs": 657810,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "That's nearly 10 full\nrevolutions per second."
    } ]
  }, {
    "tStartMs": 660690,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Right-handers typically\nthrow the ball to the right"
    } ]
  }, {
    "tStartMs": 662700,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "on the lane while spinning it to the left."
    } ]
  }, {
    "tStartMs": 665260,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "During the skid phase, the\nball slides down the lane"
    } ]
  }, {
    "tStartMs": 668100,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "spinning but not rolling."
    } ]
  }, {
    "tStartMs": 670160,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "As it comes to the end of the oil,"
    } ]
  }, {
    "tStartMs": 671620,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "the friction increases and the\nball accelerates to the left."
    } ]
  }, {
    "tStartMs": 675770,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It hooks because of its spin,"
    } ]
  }, {
    "tStartMs": 677970,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "and the spin starts lining up\nwith the direction of travel,"
    } ]
  }, {
    "tStartMs": 680710,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "leading to stage three, roll."
    } ]
  }, {
    "tStartMs": 683260,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "The ball is rolling without slipping"
    } ]
  }, {
    "tStartMs": 685050,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "as it barrels into the pins."
    } ]
  }, {
    "tStartMs": 686850,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "Ideally, as close to that\nsix degree angle as possible."
    } ]
  }, {
    "tStartMs": 692960,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Like the ball starts on\nthe left side of the lane,"
    } ]
  }, {
    "tStartMs": 696200,
    "dDurationMs": 3331,
    "segs": [ {
      "utf8": "goes straight across almost rightmost."
    } ]
  }, {
    "tStartMs": 699531,
    "dDurationMs": 3489,
    "segs": [ {
      "utf8": "Then hooks like at the last\nminute, rolls in there."
    } ]
  }, {
    "tStartMs": 703020,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "So that's almost like\na perfect shot, right?"
    } ]
  }, {
    "tStartMs": 705560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "straight in the pocket there.\n- Close."
    } ]
  }, {
    "tStartMs": 707320,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "- Yeah. That's where you\nwant to hit the pins."
    } ]
  }, {
    "tStartMs": 709220,
    "dDurationMs": 1643,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 710863,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(ball hits the floor)"
    } ]
  }, {
    "tStartMs": 715460,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- My very first game,"
    } ]
  }, {
    "tStartMs": 717020,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "it was ABC back then,\nAmerican Bowling Congress."
    } ]
  }, {
    "tStartMs": 720000,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I filled out the application\nto bowl in men's league."
    } ]
  }, {
    "tStartMs": 722460,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Dad gave them the letter\nsaying that I could,"
    } ]
  }, {
    "tStartMs": 725540,
    "dDurationMs": 2087,
    "segs": [ {
      "utf8": "and the first game of bowl was 300"
    } ]
  }, {
    "tStartMs": 727627,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "and they handed me a hundred dollars too,"
    } ]
  }, {
    "tStartMs": 729690,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "and it was like, yeah, making money now."
    } ]
  }, {
    "tStartMs": 732140,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "And actually, my first,\nmy sixth, my ninth,"
    } ]
  }, {
    "tStartMs": 736330,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "my 13th, 17th, 20th"
    } ]
  }, {
    "tStartMs": 739720,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "were all 300 games."
    } ]
  }, {
    "tStartMs": 741350,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I like, seven or eight 300"
    } ]
  }, {
    "tStartMs": 743964,
    "dDurationMs": 1646,
    "segs": [ {
      "utf8": "in my first year of men's league."
    } ]
  }, {
    "tStartMs": 745610,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "- [Derek] How do you explain that?"
    } ]
  }, {
    "tStartMs": 746700,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- To shoot 300"
    } ]
  }, {
    "tStartMs": 748180,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "you have to get lucky\nsomewhere along the line."
    } ]
  }, {
    "tStartMs": 755245,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Like that.\n(Derek laughs)"
    } ]
  }, {
    "tStartMs": 756655,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "Like that."
    } ]
  }, {
    "tStartMs": 757790,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "It came in to hit the 1 3, 5, 9."
    } ]
  }, {
    "tStartMs": 761170,
    "dDurationMs": 2593,
    "segs": [ {
      "utf8": "And that that's what we\ncall the perfect shot."
    } ]
  }, {
    "tStartMs": 769970,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- I mean, you just keep hitting them."
    } ]
  }, {
    "tStartMs": 771940,
    "dDurationMs": 2411,
    "segs": [ {
      "utf8": "That's almost the identical shot."
    } ]
  }, {
    "tStartMs": 774351,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "Look at that, that yellow and the purple,"
    } ]
  }, {
    "tStartMs": 775870,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "they're almost exactly\non top of each other."
    } ]
  }, {
    "tStartMs": 778470,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- Oh, it just goes a little bit straight."
    } ]
  }, {
    "tStartMs": 779870,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- That one, the purple one"
    } ]
  }, {
    "tStartMs": 781340,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "was just a little bit\nhigher on the head pin,"
    } ]
  }, {
    "tStartMs": 784030,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "but it still hit the 1,\n3 and the 5 and the 9."
    } ]
  }, {
    "tStartMs": 788800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Can't get much better."
    } ]
  }, {
    "tStartMs": 791420,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] This type of\nthrow is only possible"
    } ]
  }, {
    "tStartMs": 793640,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "because of the oil."
    } ]
  }, {
    "tStartMs": 795230,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "If you try to throw a ball the\nsame way on an unoiled lane."
    } ]
  }, {
    "tStartMs": 798410,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Oh no."
    } ]
  }, {
    "tStartMs": 799700,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "It just doesn't work."
    } ]
  }, {
    "tStartMs": 801660,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "Can I actually ask you to\nbowl like you normally would,"
    } ]
  }, {
    "tStartMs": 805310,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "but on the dry lane?"
    } ]
  }, {
    "tStartMs": 807640,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "I know it's crazy."
    } ]
  }, {
    "tStartMs": 808860,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "I just want to see what like\na normal shot would look like"
    } ]
  }, {
    "tStartMs": 811030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "If there was no oil.\n- No oil."
    } ]
  }, {
    "tStartMs": 812680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It's gonna hit the lane\nand go in the left gutter."
    } ]
  }, {
    "tStartMs": 814660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's what I want to see."
    } ]
  }, {
    "tStartMs": 815493,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- All right."
    } ]
  }, {
    "tStartMs": 816326,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "You're gonna throw it just\nlike it's a regular lane."
    } ]
  }, {
    "tStartMs": 818120,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "- Yeah.\n- All right."
    } ]
  }, {
    "tStartMs": 827301,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "- Oh yeah, there's no oil on the lane"
    } ]
  }, {
    "tStartMs": 828730,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "so the ball can't get down."
    } ]
  }, {
    "tStartMs": 830790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "As soon as it hits the lane,"
    } ]
  }, {
    "tStartMs": 832170,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "it's going to start hooking, you know?"
    } ]
  }, {
    "tStartMs": 833740,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "'Cause if you do this, who's\nskidding a ball on this."
    } ]
  }, {
    "tStartMs": 837380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- So they want the oil."
    } ]
  }, {
    "tStartMs": 838820,
    "dDurationMs": 1243,
    "segs": [ {
      "utf8": "- Yeah. We need the oil."
    } ]
  }, {
    "tStartMs": 840900,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "If we didn't have oil,\nthis is what it would be."
    } ]
  }, {
    "tStartMs": 843020,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "And nobody would have fun."
    } ]
  }, {
    "tStartMs": 845900,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "This is not fun.\n- The bowling sucks,"
    } ]
  }, {
    "tStartMs": 847620,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "We don't want to do this."
    } ]
  }, {
    "tStartMs": 849062,
    "dDurationMs": 928,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 849990,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "- For pro bowlers, the oil on the lane"
    } ]
  }, {
    "tStartMs": 852100,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "is a key part of the game."
    } ]
  }, {
    "tStartMs": 854960,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh whoa."
    } ]
  }, {
    "tStartMs": 856880,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "- Wow. Hey."
    } ]
  }, {
    "tStartMs": 858070,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "- Do you look at the oil?"
    } ]
  }, {
    "tStartMs": 860160,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "Are you trying to scope it out"
    } ]
  }, {
    "tStartMs": 861970,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "or are you just kind of guessing?"
    } ]
  }, {
    "tStartMs": 862910,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "- I usually don't look at the oil."
    } ]
  }, {
    "tStartMs": 864700,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "I let my ball be the guide."
    } ]
  }, {
    "tStartMs": 866790,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "You know, I know some guys that are,"
    } ]
  }, {
    "tStartMs": 868780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "you know, they get down\nlike this and they look in"
    } ]
  }, {
    "tStartMs": 871210,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "and it's like, oh, you know,"
    } ]
  }, {
    "tStartMs": 873270,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "they're seeing the same thing I do"
    } ]
  }, {
    "tStartMs": 874600,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "when I sit down, I go like that."
    } ]
  }, {
    "tStartMs": 877040,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Nothing."
    } ]
  }, {
    "tStartMs": 878220,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I see absolutely nothing."
    } ]
  }, {
    "tStartMs": 879900,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- Whether you can see it or not,"
    } ]
  }, {
    "tStartMs": 881420,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "figuring out the condition\nof oil on the lane"
    } ]
  }, {
    "tStartMs": 883180,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "can make the difference\nbetween a strike and a miss."
    } ]
  }, {
    "tStartMs": 888960,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "As the game wears on the bowling\nballs move the oil around,"
    } ]
  }, {
    "tStartMs": 892530,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "pushing it further down the lane"
    } ]
  }, {
    "tStartMs": 893930,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "and stripping it off\nthe most common paths."
    } ]
  }, {
    "tStartMs": 898410,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "So players have to adjust\nto the changing conditions."
    } ]
  }, {
    "tStartMs": 901550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Some people say left-handers\nhave an advantage"
    } ]
  }, {
    "tStartMs": 903740,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "because right-handers aren't playing"
    } ]
  }, {
    "tStartMs": 905930,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "on their side of the lane."
    } ]
  }, {
    "tStartMs": 907960,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "At most bowling alleys,"
    } ]
  }, {
    "tStartMs": 909030,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "they use a pattern of oil\nthat is thicker in the middle"
    } ]
  }, {
    "tStartMs": 911640,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "and thinner out toward the edges."
    } ]
  }, {
    "tStartMs": 913930,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "This is a forgiving layout"
    } ]
  }, {
    "tStartMs": 915710,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "because balls that drift too\nfar out start to hook earlier,"
    } ]
  }, {
    "tStartMs": 919550,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "while balls going straighter"
    } ]
  }, {
    "tStartMs": 920710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "can continue down the lane for longer"
    } ]
  }, {
    "tStartMs": 922720,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "before making their turn into the pins."
    } ]
  }, {
    "tStartMs": 925540,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "But for pro bowlers,\nthe oil conditions vary"
    } ]
  }, {
    "tStartMs": 928200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and players have to adjust\ntheir games to the conditions."
    } ]
  }, {
    "tStartMs": 931000,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Some people seem to think\nthat like league bowlers"
    } ]
  }, {
    "tStartMs": 933090,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "are better than they are, maybe,"
    } ]
  }, {
    "tStartMs": 934380,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "'cause they say like,\n\"Oh, this league bowler"
    } ]
  }, {
    "tStartMs": 935730,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "can shoot two 10, and I\njust saw pro shoot two 10.\""
    } ]
  }, {
    "tStartMs": 938690,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "- That's why they call it league"
    } ]
  }, {
    "tStartMs": 939960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "because you bowl on the\nsame shot every week."
    } ]
  }, {
    "tStartMs": 942200,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "Because each week on tour,"
    } ]
  }, {
    "tStartMs": 943570,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I'm bowling on a different condition."
    } ]
  }, {
    "tStartMs": 945340,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "Not the same condition every week."
    } ]
  }, {
    "tStartMs": 947190,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "We have Cheetah,\nChameleon, Scorpion, shark,"
    } ]
  }, {
    "tStartMs": 951240,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "one more.\n- Bear?"
    } ]
  }, {
    "tStartMs": 952750,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "- Bear. Yeah."
    } ]
  }, {
    "tStartMs": 953900,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "- [Derek] But it's not\njust the oil on the lanes"
    } ]
  }, {
    "tStartMs": 955890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that is transformed bowling."
    } ]
  }, {
    "tStartMs": 957990,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "It's also the balls themselves."
    } ]
  }, {
    "tStartMs": 960260,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "- Hard rubber bowling balls\nwas what I started with."
    } ]
  }, {
    "tStartMs": 963420,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Maybe mid 70's and then the Yellow Dot,"
    } ]
  }, {
    "tStartMs": 965740,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "the Columbia Yellow Dot,\nwhich is a plastic ball."
    } ]
  }, {
    "tStartMs": 968490,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "And then they came out with\nurethane bowling balls."
    } ]
  }, {
    "tStartMs": 971140,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "I won a lot of titles\nwith the urethane stuff."
    } ]
  }, {
    "tStartMs": 973550,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "And then they come out with the"
    } ]
  }, {
    "tStartMs": 975000,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "reactive resin bowling balls."
    } ]
  }, {
    "tStartMs": 976730,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- [Derek] Reactive resin is\njust a modified polyurethane"
    } ]
  }, {
    "tStartMs": 980030,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "with a more porous surface,"
    } ]
  }, {
    "tStartMs": 981700,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "which gives it more grip in the oil."
    } ]
  }, {
    "tStartMs": 983840,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It's the most popular\nsurface or cover stock"
    } ]
  }, {
    "tStartMs": 986750,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "for bowling balls today."
    } ]
  }, {
    "tStartMs": 988590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Balls started out as perfect\nsymmetrically-weighted spheres."
    } ]
  }, {
    "tStartMs": 991920,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "And when you go to a bowling alley,"
    } ]
  }, {
    "tStartMs": 993470,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "the house balls there are still just that."
    } ]
  }, {
    "tStartMs": 996250,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "But when you drill holes in the ball,"
    } ]
  }, {
    "tStartMs": 998150,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "you take some weight out of one side."
    } ]
  }, {
    "tStartMs": 1000300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So to rebalance it, ball manufacturers"
    } ]
  }, {
    "tStartMs": 1002610,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "added a small pancake weight\non the same side as the holes."
    } ]
  }, {
    "tStartMs": 1006030,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "But then ball manufacturers got the idea,"
    } ]
  }, {
    "tStartMs": 1008060,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "they could add different\nweights inside the ball"
    } ]
  }, {
    "tStartMs": 1010240,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to improve their performance."
    } ]
  }, {
    "tStartMs": 1012460,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "You can have two balls that\nlook identical from the outside,"
    } ]
  }, {
    "tStartMs": 1015290,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "weigh exactly the same amount,"
    } ]
  }, {
    "tStartMs": 1017310,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and yet roll differently."
    } ]
  }, {
    "tStartMs": 1019890,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "If the mass is more concentrated"
    } ]
  }, {
    "tStartMs": 1021830,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "around the axis of rotation,"
    } ]
  }, {
    "tStartMs": 1023410,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "say you have a dense\ncylinder inside the ball."
    } ]
  }, {
    "tStartMs": 1026380,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Well then it has a\nlower moment of inertia."
    } ]
  }, {
    "tStartMs": 1028920,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "And this means for the same\namount of energy input,"
    } ]
  }, {
    "tStartMs": 1031570,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "it will spin faster."
    } ]
  }, {
    "tStartMs": 1033410,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "In bowling, they prefer to talk\nabout an analogous concept."
    } ]
  }, {
    "tStartMs": 1036610,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Radius of gyration or RG."
    } ]
  }, {
    "tStartMs": 1039290,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "If you were to concentrate\nthe entire mass of the ball"
    } ]
  }, {
    "tStartMs": 1042330,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "onto a hoop with the\nsame moment of inertia,"
    } ]
  }, {
    "tStartMs": 1044940,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "it's radius would be\nthe radius of gyration."
    } ]
  }, {
    "tStartMs": 1048300,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "So smaller radius of gyration"
    } ]
  }, {
    "tStartMs": 1050200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "just means lower moment of inertia,"
    } ]
  }, {
    "tStartMs": 1052600,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "which translates into more rotation"
    } ]
  }, {
    "tStartMs": 1054450,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "that a bowler can get on the ball."
    } ]
  }, {
    "tStartMs": 1056680,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "- Some people are lower leverage"
    } ]
  }, {
    "tStartMs": 1058110,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "it just spins faster, like,"
    } ]
  }, {
    "tStartMs": 1060090,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "eh, it's of crazy, and then"
    } ]
  }, {
    "tStartMs": 1062220,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "somebody finally did a study on that."
    } ]
  }, {
    "tStartMs": 1063320,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "Yeah, it turns out,"
    } ]
  }, {
    "tStartMs": 1064750,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "yeah, it's like 8%, you\nknow, for every 0.05."
    } ]
  }, {
    "tStartMs": 1069480,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "And so it depends on\nwhat your leverage is."
    } ]
  }, {
    "tStartMs": 1071330,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Can be fairly significant."
    } ]
  }, {
    "tStartMs": 1073430,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "- [Derek] An ability to\nspin the balls faster,"
    } ]
  }, {
    "tStartMs": 1075480,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "gives a bowler the\nability to hook the ball"
    } ]
  }, {
    "tStartMs": 1077890,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "more sharply further down the lane,"
    } ]
  }, {
    "tStartMs": 1080160,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "giving them a better chance of achieving"
    } ]
  }, {
    "tStartMs": 1082060,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "that six degree entry angle."
    } ]
  }, {
    "tStartMs": 1084270,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "What was amazing for me to learn"
    } ]
  }, {
    "tStartMs": 1085770,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "is that the weight blocks in these balls"
    } ]
  }, {
    "tStartMs": 1087520,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "aren't even centered."
    } ]
  }, {
    "tStartMs": 1089270,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "There's a heavy side and\na lighter side on purpose,"
    } ]
  }, {
    "tStartMs": 1092770,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and you can find and mark this side"
    } ]
  }, {
    "tStartMs": 1094930,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "by letting the ball spin\nfreely on a cushion of air,"
    } ]
  }, {
    "tStartMs": 1097760,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "until it comes to rest, heavy side down."
    } ]
  }, {
    "tStartMs": 1100780,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They showed me a great demonstration"
    } ]
  }, {
    "tStartMs": 1102400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of how the position of\nthe center of gravity"
    } ]
  }, {
    "tStartMs": 1104320,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "can affect the movement of the ball."
    } ]
  }, {
    "tStartMs": 1107420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "When the center of mass is\non the left side of the ball,"
    } ]
  }, {
    "tStartMs": 1109670,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "it pulls in the same\ndirection as the spin,"
    } ]
  }, {
    "tStartMs": 1112420,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "helping the ball hook to\nthe left, into the pins,"
    } ]
  }, {
    "tStartMs": 1115130,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- Same exact ball, same numbers,"
    } ]
  }, {
    "tStartMs": 1117740,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "just different static\nand balance basically."
    } ]
  }, {
    "tStartMs": 1121750,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "- [Derek] But here is\na flipped bowling ball"
    } ]
  }, {
    "tStartMs": 1123830,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "where the center of mass is on the right."
    } ]
  }, {
    "tStartMs": 1126770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now the ball starts to hook into the left,"
    } ]
  }, {
    "tStartMs": 1129410,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "but at the end, something weird happens."
    } ]
  }, {
    "tStartMs": 1132300,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The center of mass pulls\nit over to the right."
    } ]
  }, {
    "tStartMs": 1135690,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "This effect is only really noticeable"
    } ]
  }, {
    "tStartMs": 1137680,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "when the ball is thrown slowly."
    } ]
  }, {
    "tStartMs": 1141660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "These days, there are tons\nof different weight blocks"
    } ]
  }, {
    "tStartMs": 1143980,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "that go inside bowling balls"
    } ]
  }, {
    "tStartMs": 1145620,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "and they can be grouped\ninto two categories,"
    } ]
  }, {
    "tStartMs": 1147850,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "symmetric and asymmetric."
    } ]
  }, {
    "tStartMs": 1150210,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "For all these weight blocks,"
    } ]
  }, {
    "tStartMs": 1151840,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "the minimum moment of inertia"
    } ]
  }, {
    "tStartMs": 1153390,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "or in bowling terms, the smallest RG axis"
    } ]
  }, {
    "tStartMs": 1156520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is identified by a pin,"
    } ]
  }, {
    "tStartMs": 1158520,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "which is visible on the\noutside of the ball."
    } ]
  }, {
    "tStartMs": 1160930,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "It will spin most easily about this axis."
    } ]
  }, {
    "tStartMs": 1163940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "For the symmetric weight blocks."
    } ]
  }, {
    "tStartMs": 1165530,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The ball doesn't change as\nyou rotate it about this axis."
    } ]
  }, {
    "tStartMs": 1168790,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So the maximum moment of inertia"
    } ]
  }, {
    "tStartMs": 1171030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "is rotating about any axis that passes"
    } ]
  }, {
    "tStartMs": 1173220,
    "dDurationMs": 2113,
    "segs": [ {
      "utf8": "through the equator of the ball."
    } ]
  }, {
    "tStartMs": 1176230,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "I certainly didn't expect bowling balls"
    } ]
  }, {
    "tStartMs": 1177950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to have asymmetric cores,"
    } ]
  }, {
    "tStartMs": 1179690,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "but it turns out what\nlooked like perfect spheres,"
    } ]
  }, {
    "tStartMs": 1182830,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "actually have three different\nprincipal axes of rotation."
    } ]
  }, {
    "tStartMs": 1186420,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Minimum moment of inertia,"
    } ]
  }, {
    "tStartMs": 1187740,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "maximum moment of inertia"
    } ]
  }, {
    "tStartMs": 1189040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and intermediate moment of inertia."
    } ]
  }, {
    "tStartMs": 1191650,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- So this right here is our Dark Code."
    } ]
  }, {
    "tStartMs": 1193150,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "This is one of our asymmetric ball"
    } ]
  }, {
    "tStartMs": 1194763,
    "dDurationMs": 2177,
    "segs": [ {
      "utf8": "that has the Rad 4 core in it."
    } ]
  }, {
    "tStartMs": 1196940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So this has a preferred spin axis."
    } ]
  }, {
    "tStartMs": 1199040,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "And what we're going to do now"
    } ]
  }, {
    "tStartMs": 1199916,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "is we're going to put\nit onto the determinator"
    } ]
  }, {
    "tStartMs": 1201650,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and show how it actually\nwill spin it and find it"
    } ]
  }, {
    "tStartMs": 1203750,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "no matter how we position it on there."
    } ]
  }, {
    "tStartMs": 1206700,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "- [Derek] So you spin\nthem up on this machine"
    } ]
  }, {
    "tStartMs": 1208430,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "until they settle into\nthe way they like to spin"
    } ]
  }, {
    "tStartMs": 1211560,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "where the bowlers call their\npreferred spin axis or PSA."
    } ]
  }, {
    "tStartMs": 1215800,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "But why would you want a\nball to be an asymmetric top?"
    } ]
  }, {
    "tStartMs": 1219330,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Well, professional\nbowlers drill their balls"
    } ]
  }, {
    "tStartMs": 1221610,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "so that at lunch the axis of\nrotation is somewhere between"
    } ]
  }, {
    "tStartMs": 1225750,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "the minimum and maximum moment of inertia."
    } ]
  }, {
    "tStartMs": 1228410,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "And as a result, as the ball\ngoes down the lane spinning,"
    } ]
  }, {
    "tStartMs": 1231630,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "it precesses like a gyroscope."
    } ]
  }, {
    "tStartMs": 1234400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The axis of rotation rotates around"
    } ]
  }, {
    "tStartMs": 1236640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "causing the point of contact"
    } ]
  }, {
    "tStartMs": 1238140,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "between the ball and the lane to change."
    } ]
  }, {
    "tStartMs": 1240980,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This precession means that"
    } ]
  }, {
    "tStartMs": 1242900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "different parts of the\nball contact the lane."
    } ]
  }, {
    "tStartMs": 1245600,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "And you can see this when the ball back"
    } ]
  }, {
    "tStartMs": 1247870,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "by the spread-out lines of\noil on the ball surface."
    } ]
  }, {
    "tStartMs": 1250980,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Bowlers call this track flare,"
    } ]
  }, {
    "tStartMs": 1252660,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and it's desirable because it means"
    } ]
  }, {
    "tStartMs": 1254200,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "once the ball hits the\nunoiled part of the lane,"
    } ]
  }, {
    "tStartMs": 1257010,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "it gets traction faster"
    } ]
  }, {
    "tStartMs": 1258430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and hooks more dramatically\nback to the pins."
    } ]
  }, {
    "tStartMs": 1261610,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "This is what asymmetric\ncores are used for."
    } ]
  }, {
    "tStartMs": 1264200,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "They have larger differences"
    } ]
  }, {
    "tStartMs": 1265380,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "between their moments of\ninertia in different axes"
    } ]
  }, {
    "tStartMs": 1268180,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "or what bowlers call RG differential,"
    } ]
  }, {
    "tStartMs": 1270480,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "which makes the ball precess."
    } ]
  }, {
    "tStartMs": 1272830,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "If you spin a ball around it's minimum"
    } ]
  }, {
    "tStartMs": 1274820,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "or maximum moment of\ninertia, it processes less"
    } ]
  }, {
    "tStartMs": 1277950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and there's much less flair,"
    } ]
  }, {
    "tStartMs": 1279690,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "meaning oil builds up\non one part of the ball."
    } ]
  }, {
    "tStartMs": 1283290,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "This reduces the friction\nover the dry part of the lane"
    } ]
  }, {
    "tStartMs": 1286330,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so the ball hooks less."
    } ]
  }, {
    "tStartMs": 1288520,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- See the oil there, very faintly,"
    } ]
  }, {
    "tStartMs": 1290220,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "but it's pretty much next to the finger,"
    } ]
  }, {
    "tStartMs": 1292940,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "right next to the thumb,"
    } ]
  }, {
    "tStartMs": 1294200,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "and it just continues to be right that way"
    } ]
  }, {
    "tStartMs": 1297280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "all the way around the ball."
    } ]
  }, {
    "tStartMs": 1299120,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- [Derek] But how important are"
    } ]
  }, {
    "tStartMs": 1300760,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "each of these factors in\nactually getting the best shot?"
    } ]
  }, {
    "tStartMs": 1303920,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Well, the US Bowling Congress,"
    } ]
  }, {
    "tStartMs": 1305370,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "or USBC, the governing\nbody that sets all rules"
    } ]
  }, {
    "tStartMs": 1308630,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and regulations for US bowling."
    } ]
  }, {
    "tStartMs": 1310590,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "They did a landmark study in 2008,"
    } ]
  }, {
    "tStartMs": 1312930,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "trying to tease out the\nmost significant factors"
    } ]
  }, {
    "tStartMs": 1315460,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "that affect ball motion."
    } ]
  }, {
    "tStartMs": 1317250,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In order to determine the\nimpact of each factor,"
    } ]
  }, {
    "tStartMs": 1319890,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "they had to make sure that\nthrows were identical."
    } ]
  }, {
    "tStartMs": 1322780,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So they turned to Harry,"
    } ]
  }, {
    "tStartMs": 1324540,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "at the time, the most\nconsistent bowler in the world."
    } ]
  }, {
    "tStartMs": 1327850,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "He is a robot."
    } ]
  }, {
    "tStartMs": 1330350,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Bowling robots are designed\nto be able to throw"
    } ]
  }, {
    "tStartMs": 1332590,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "hundreds of identical shots."
    } ]
  }, {
    "tStartMs": 1334720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "In fact, the robot Earl,"
    } ]
  }, {
    "tStartMs": 1336160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Harry's successor in 2011,"
    } ]
  }, {
    "tStartMs": 1338320,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "actually lost to Chris\nBarnes when he debuted"
    } ]
  }, {
    "tStartMs": 1341090,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in part because his\nthrows were so consistent."
    } ]
  }, {
    "tStartMs": 1343970,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "He wore away the oil in a\nsingle part of the lane."
    } ]
  }, {
    "tStartMs": 1347240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So his shots hooked too much."
    } ]
  }, {
    "tStartMs": 1349960,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "The people managing him"
    } ]
  }, {
    "tStartMs": 1351130,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "did their best to adjust\nto the oil conditions,"
    } ]
  }, {
    "tStartMs": 1354110,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but few people are Chris Barnes."
    } ]
  }, {
    "tStartMs": 1357170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The USBC ball motion study"
    } ]
  }, {
    "tStartMs": 1359090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "used Harry to throw thousands of shots"
    } ]
  }, {
    "tStartMs": 1361190,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "with different bowling balls."
    } ]
  }, {
    "tStartMs": 1362590,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "And they found that the center of gravity"
    } ]
  }, {
    "tStartMs": 1364400,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "affected the ball motion\nrelatively little."
    } ]
  }, {
    "tStartMs": 1366760,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "Around the same level\nas environmental factors"
    } ]
  }, {
    "tStartMs": 1369750,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "like room temperature or humidity."
    } ]
  }, {
    "tStartMs": 1372430,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "RG, and RG differential,"
    } ]
  }, {
    "tStartMs": 1374370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "essentially the moment of inertia"
    } ]
  }, {
    "tStartMs": 1375960,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and difference between maximum"
    } ]
  }, {
    "tStartMs": 1377420,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "and minimum moments of inertia."
    } ]
  }, {
    "tStartMs": 1379150,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "That affected the ball\nmotion significantly more."
    } ]
  }, {
    "tStartMs": 1382090,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "But the factor that affected\nball motion the most"
    } ]
  }, {
    "tStartMs": 1385260,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "was the surface of the ball."
    } ]
  }, {
    "tStartMs": 1387550,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "The top five individual factors were"
    } ]
  }, {
    "tStartMs": 1390120,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "the amplitude of surface roughness,"
    } ]
  }, {
    "tStartMs": 1392260,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "meaning the height of\nmicroscopic spikes on the ball,"
    } ]
  }, {
    "tStartMs": 1395360,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "the coefficient of friction\nwith an oiled lane,"
    } ]
  }, {
    "tStartMs": 1398600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the surface roughness by spacing."
    } ]
  }, {
    "tStartMs": 1400700,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "That is the distance\nbetween microscopic spikes,"
    } ]
  }, {
    "tStartMs": 1403560,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "the coefficient of\nfriction with the dry lane,"
    } ]
  }, {
    "tStartMs": 1406250,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "and how quickly the ball\nsurface absorbs oil."
    } ]
  }, {
    "tStartMs": 1409660,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now, bowlers recognize just how important"
    } ]
  }, {
    "tStartMs": 1411730,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "the surface of their ball is."
    } ]
  }, {
    "tStartMs": 1413420,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "They pay close attention\nto what it's made of"
    } ]
  }, {
    "tStartMs": 1415630,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "and how it's finished."
    } ]
  }, {
    "tStartMs": 1417240,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Rougher finishes,"
    } ]
  }, {
    "tStartMs": 1418140,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "give the ball more traction in the oil"
    } ]
  }, {
    "tStartMs": 1419950,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and get it to start hooking earlier."
    } ]
  }, {
    "tStartMs": 1422150,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "This is useful for long oil patterns"
    } ]
  }, {
    "tStartMs": 1424510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and slower axis rotation."
    } ]
  }, {
    "tStartMs": 1426340,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "- Sometimes maybe I'll go\nto a little more sanded ball"
    } ]
  }, {
    "tStartMs": 1430310,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "or a little more ball surface"
    } ]
  }, {
    "tStartMs": 1432530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to get it into a roll quicker for me,"
    } ]
  }, {
    "tStartMs": 1434750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "because they use a lot of oil."
    } ]
  }, {
    "tStartMs": 1436610,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "- These two shots are thrown identically."
    } ]
  }, {
    "tStartMs": 1438840,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "The only difference is\nthe ball on the left"
    } ]
  }, {
    "tStartMs": 1441280,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "has a rougher surface."
    } ]
  }, {
    "tStartMs": 1446160,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Rough surfaces act like winter tires,"
    } ]
  }, {
    "tStartMs": 1448490,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "helping to dig into the oil\nand give the ball traction."
    } ]
  }, {
    "tStartMs": 1452230,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "They also act as badly as\nwinter tires on a clean road"
    } ]
  }, {
    "tStartMs": 1455900,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "on a totally dry lane."
    } ]
  }, {
    "tStartMs": 1457440,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "They actually have less friction"
    } ]
  }, {
    "tStartMs": 1459010,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "because their rougher exteriors"
    } ]
  }, {
    "tStartMs": 1460760,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "mean that less surface\narea is touching the lane."
    } ]
  }, {
    "tStartMs": 1464350,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "You can get many different\nlevels of smoothness"
    } ]
  }, {
    "tStartMs": 1466940,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "up to a near mirror shine."
    } ]
  }, {
    "tStartMs": 1469330,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This is better for short oil patterns"
    } ]
  }, {
    "tStartMs": 1471410,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "to prevent the ball hooking\ntoo much, too early."
    } ]
  }, {
    "tStartMs": 1474400,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Ultimately, pro bowlers\ncarry many different balls"
    } ]
  }, {
    "tStartMs": 1477010,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "to each competition."
    } ]
  }, {
    "tStartMs": 1478120,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "- I'm not afraid to change\nballs in the middle of the game."
    } ]
  }, {
    "tStartMs": 1480660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "I go to the game and I've got like"
    } ]
  }, {
    "tStartMs": 1483270,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "a spare, a spare, a spare."
    } ]
  }, {
    "tStartMs": 1485410,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "All right. It's time to change balls."
    } ]
  }, {
    "tStartMs": 1487060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Yeah."
    } ]
  }, {
    "tStartMs": 1487893,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "- So now I gotta find the right ball to"
    } ]
  }, {
    "tStartMs": 1489880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "get down the lane again\nand find the proper,"
    } ]
  }, {
    "tStartMs": 1492360,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "which usually I have a pretty good idea."
    } ]
  }, {
    "tStartMs": 1494350,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "- [Derek] So they select their ball"
    } ]
  }, {
    "tStartMs": 1495720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "a little like a golfer selects their club,"
    } ]
  }, {
    "tStartMs": 1498120,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "to suit the conditions."
    } ]
  }, {
    "tStartMs": 1500830,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But does all this tech actually\nmake people better bowlers?"
    } ]
  }, {
    "tStartMs": 1504100,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Well, over the last 20 years,"
    } ]
  }, {
    "tStartMs": 1505680,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "average scores have increased\nby more than five points."
    } ]
  }, {
    "tStartMs": 1509010,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Plus the number of perfect 300 games"
    } ]
  }, {
    "tStartMs": 1511190,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "bowled per year per thousand bowlers"
    } ]
  }, {
    "tStartMs": 1513300,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "has increased dramatically\nsince the 1980s."
    } ]
  }, {
    "tStartMs": 1516560,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "This graph shows the percent\nchange year over year."
    } ]
  }, {
    "tStartMs": 1520410,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "In 1976, soaker balls,"
    } ]
  }, {
    "tStartMs": 1522590,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "balls chemically softened\nto absorb oil and hook more,"
    } ]
  }, {
    "tStartMs": 1525770,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "were banned, and there was\na dip in perfect games."
    } ]
  }, {
    "tStartMs": 1529290,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But the same year a new\nrubber ball was introduced,"
    } ]
  }, {
    "tStartMs": 1531840,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "the Brunswick LT-48"
    } ]
  }, {
    "tStartMs": 1533860,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "and more 300 were hit in\nthe years that followed."
    } ]
  }, {
    "tStartMs": 1537330,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "In 1991, reactive resin\nballs were introduced"
    } ]
  }, {
    "tStartMs": 1540200,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and there was another significant jump."
    } ]
  }, {
    "tStartMs": 1542660,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now, obviously there were\nother improvements in equipment"
    } ]
  }, {
    "tStartMs": 1545460,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and natural variability,"
    } ]
  }, {
    "tStartMs": 1547340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but some of the big changes do correlate"
    } ]
  }, {
    "tStartMs": 1549530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "with the introduction\nof new ball technology."
    } ]
  }, {
    "tStartMs": 1552350,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "So yes, the wild bowling\nball technologies out there,"
    } ]
  }, {
    "tStartMs": 1555370,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "especially anything to do with surface,"
    } ]
  }, {
    "tStartMs": 1557580,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "significantly affect ball\nmotion and your bowling game."
    } ]
  }, {
    "tStartMs": 1561840,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But ball motion is\nlikely minutely affected"
    } ]
  }, {
    "tStartMs": 1564060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "by hundreds of other factors."
    } ]
  }, {
    "tStartMs": 1565770,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Even the color of the ball\ncan have a small impact."
    } ]
  }, {
    "tStartMs": 1568510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "A USBC study in 2016"
    } ]
  }, {
    "tStartMs": 1570790,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "found that different pigments\nabsorb oil at different rates."
    } ]
  }, {
    "tStartMs": 1575430,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Bowling is the sport of re-invention."
    } ]
  }, {
    "tStartMs": 1578050,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "That goes back to ancient Egypt,"
    } ]
  }, {
    "tStartMs": 1579740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but has transformed many times."
    } ]
  }, {
    "tStartMs": 1582380,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Now, when you get up\nto throw a single shot,"
    } ]
  }, {
    "tStartMs": 1584460,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you have to think about the\noil pattern on the lane,"
    } ]
  }, {
    "tStartMs": 1587500,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "the stage of the game and\nhow the pattern has shifted,"
    } ]
  }, {
    "tStartMs": 1590160,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "the weight block in your ball,"
    } ]
  }, {
    "tStartMs": 1591590,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "whether you want symmetric or asymmetric,"
    } ]
  }, {
    "tStartMs": 1593810,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "which axis you'll spin it\nabout to affect precession,"
    } ]
  }, {
    "tStartMs": 1597290,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "where the center of mass is"
    } ]
  }, {
    "tStartMs": 1598430,
    "dDurationMs": 1373,
    "segs": [ {
      "utf8": "to pull the ball to\nthe left, to the right,"
    } ]
  }, {
    "tStartMs": 1599803,
    "dDurationMs": 1817,
    "segs": [ {
      "utf8": "what the cover stock is made of"
    } ]
  }, {
    "tStartMs": 1601620,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and whether it's rough or smooth,"
    } ]
  }, {
    "tStartMs": 1603670,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "all to make a shot that\nskids, hooks, and rolls"
    } ]
  }, {
    "tStartMs": 1607080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "to the pins between boards\n17 and 18 and a half"
    } ]
  }, {
    "tStartMs": 1610240,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "at as close to a six degree\nangle as you can master."
    } ]
  }, {
    "tStartMs": 1615720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Now do that again 12 times in a row"
    } ]
  }, {
    "tStartMs": 1617960,
    "dDurationMs": 2514,
    "segs": [ {
      "utf8": "and you have a perfect game."
    } ]
  }, {
    "tStartMs": 1620474,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(techno sound effect)"
    } ]
  }, {
    "tStartMs": 1625660,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Hey, this portion of the video\nwas sponsored by Salesforce."
    } ]
  }, {
    "tStartMs": 1629020,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Bowling may be complicated,"
    } ]
  }, {
    "tStartMs": 1630230,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "but managing relationships\nwith your customers"
    } ]
  }, {
    "tStartMs": 1632520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "doesn't have to be."
    } ]
  }, {
    "tStartMs": 1633780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "In our modern work-from-anywhere world,"
    } ]
  }, {
    "tStartMs": 1636360,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Salesforce makes it\neasier for your business"
    } ]
  }, {
    "tStartMs": 1638150,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to meet the needs of your customers."
    } ]
  }, {
    "tStartMs": 1640010,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "You can help them find\nanswers about your business"
    } ]
  }, {
    "tStartMs": 1641950,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "by creating a help center page."
    } ]
  }, {
