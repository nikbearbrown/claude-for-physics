{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- This is a video about\nthe most famous problem"
    } ]
  }, {
    "tStartMs": 2580,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "in game theory."
    } ]
  }, {
    "tStartMs": 3720,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Problems of this sort pop up\neverywhere, from nations locked"
    } ]
  }, {
    "tStartMs": 7320,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "in conflict to roommates doing the dishes."
    } ]
  }, {
    "tStartMs": 10410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Even game shows have been\nbased around this concept."
    } ]
  }, {
    "tStartMs": 13950,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Figuring out the best strategy\ncan mean the difference"
    } ]
  }, {
    "tStartMs": 16230,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "between life and death, war and peace,"
    } ]
  }, {
    "tStartMs": 19350,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "flourishing and the\ndestruction of the planet."
    } ]
  }, {
    "tStartMs": 22440,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And in the mechanics of this game,"
    } ]
  }, {
    "tStartMs": 24060,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "we may find the very source of one"
    } ]
  }, {
    "tStartMs": 26000,
    "dDurationMs": 4398,
    "segs": [ {
      "utf8": "of the most unexpected phenomena\nin nature: cooperation."
    } ]
  }, {
    "tStartMs": 30398,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 34560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "On the 3rd of September, 1949,"
    } ]
  }, {
    "tStartMs": 36810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "an American weather monitoring plane"
    } ]
  }, {
    "tStartMs": 38610,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "collected air samples over Japan."
    } ]
  }, {
    "tStartMs": 41100,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "In those samples, they found\ntraces of radioactive material."
    } ]
  }, {
    "tStartMs": 46110,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "The Navy quickly collected"
    } ]
  }, {
    "tStartMs": 47520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and tested rainwater\nsamples from their ships"
    } ]
  }, {
    "tStartMs": 49890,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and bases all over the world."
    } ]
  }, {
    "tStartMs": 52350,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "They also detected small amounts"
    } ]
  }, {
    "tStartMs": 53947,
    "dDurationMs": 3896,
    "segs": [ {
      "utf8": "of Cerium-141 and Yttrium-91."
    } ]
  }, {
    "tStartMs": 58740,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But these isotopes have half\nlives of one or two months,"
    } ]
  }, {
    "tStartMs": 62040,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so they must have been produced recently"
    } ]
  }, {
    "tStartMs": 64560,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and the only place they\ncould have come from"
    } ]
  }, {
    "tStartMs": 66330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "was a nuclear explosion."
    } ]
  }, {
    "tStartMs": 69180,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "But the US hadn't performed\nany tests that year,"
    } ]
  }, {
    "tStartMs": 72750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so the only possible conclusion"
    } ]
  }, {
    "tStartMs": 75000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "was that the Soviet Union had figured out"
    } ]
  }, {
    "tStartMs": 77220,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "how to make a nuclear bomb."
    } ]
  }, {
    "tStartMs": 80280,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This was the news the\nAmericans had been dreading."
    } ]
  }, {
    "tStartMs": 83340,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Their military supremacy achieved"
    } ]
  }, {
    "tStartMs": 85590,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "through the Manhattan\nProject was quickly fading."
    } ]
  }, {
    "tStartMs": 89010,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- This makes the problem of Western Europe"
    } ]
  }, {
    "tStartMs": 91380,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and the United States far more\nserious than it was before"
    } ]
  }, {
    "tStartMs": 95040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and perhaps makes the\nimminence of war greater."
    } ]
  }, {
    "tStartMs": 97980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Some thought their\nbest course of action was"
    } ]
  }, {
    "tStartMs": 99870,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to launch an unprovoked nuclear\nstrike against the Soviets"
    } ]
  }, {
    "tStartMs": 103320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "while they were still ahead."
    } ]
  }, {
    "tStartMs": 105510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "In the words of Navy Secretary Matthews"
    } ]
  }, {
    "tStartMs": 107730,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "to become \"aggressors for peace\"."
    } ]
  }, {
    "tStartMs": 111420,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "John von Neuman, the\nfounder of game theory,"
    } ]
  }, {
    "tStartMs": 113970,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "said, \"If you say why\nnot bomb them tomorrow,"
    } ]
  }, {
    "tStartMs": 117420,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I say, why not bomb them today?"
    } ]
  }, {
    "tStartMs": 119730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "If you say today at five o'clock,"
    } ]
  }, {
    "tStartMs": 121500,
    "dDurationMs": 1917,
    "segs": [ {
      "utf8": "I say why not at one o'clock?\""
    } ]
  }, {
    "tStartMs": 126960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Something needed to be done\nabout nuclear weapons and fast."
    } ]
  }, {
    "tStartMs": 130560,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "But what?"
    } ]
  }, {
    "tStartMs": 131790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "In 1950, the RAND Corporation,"
    } ]
  }, {
    "tStartMs": 134130,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "a US-based think tank was\nstudying this question."
    } ]
  }, {
    "tStartMs": 137490,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "And as part of this research,\nthey turned to game theory."
    } ]
  }, {
    "tStartMs": 141420,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That same year, two mathematicians\nat RAND had invented"
    } ]
  }, {
    "tStartMs": 144540,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "a new game, one which\nunbeknownst to them at the time,"
    } ]
  }, {
    "tStartMs": 147990,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "closely resembled the US-Soviet conflict."
    } ]
  }, {
    "tStartMs": 151110,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This game is now known as\nthe prisoner's dilemma."
    } ]
  }, {
    "tStartMs": 154230,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "So let's play a game."
    } ]
  }, {
    "tStartMs": 156900,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "A banker with a chest full\nof gold coins invites you"
    } ]
  }, {
    "tStartMs": 159930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and another player to\nplay against each other."
    } ]
  }, {
    "tStartMs": 162000,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "You each get two choices."
    } ]
  }, {
    "tStartMs": 163890,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "You can cooperate or you can defect."
    } ]
  }, {
    "tStartMs": 166800,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "If you both cooperate,\nyou each get three coins."
    } ]
  }, {
    "tStartMs": 170310,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "If one of you cooperates,"
    } ]
  }, {
    "tStartMs": 171690,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "but the other defects,"
    } ]
  }, {
    "tStartMs": 173040,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "then the one who defected gets five coins"
    } ]
  }, {
    "tStartMs": 175410,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and the other gets nothing."
    } ]
  }, {
    "tStartMs": 177780,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And if you both defect,\nthen you each get a coin."
    } ]
  }, {
    "tStartMs": 181380,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The goal of the game is simple:"
    } ]
  }, {
    "tStartMs": 182970,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "to get as many coins as you can."
    } ]
  }, {
    "tStartMs": 186960,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So what would you do?"
    } ]
  }, {
    "tStartMs": 189420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Suppose your opponent cooperates,"
    } ]
  }, {
    "tStartMs": 191670,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "then you could also\ncooperate and get three coins"
    } ]
  }, {
    "tStartMs": 195270,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "or you could defect and\nget five coins, instead."
    } ]
  }, {
    "tStartMs": 198810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So you are better off defecting,"
    } ]
  }, {
    "tStartMs": 201450,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but what if your opponent\ndefects, instead?"
    } ]
  }, {
    "tStartMs": 204750,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Well, you could cooperate and get no coins"
    } ]
  }, {
    "tStartMs": 207840,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "or you could defect and\nat least get one coin."
    } ]
  }, {
    "tStartMs": 211770,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So no matter what your opponent does,"
    } ]
  }, {
    "tStartMs": 214530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "your best option is always to defect."
    } ]
  }, {
    "tStartMs": 217920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Now, if your opponent is also rational,"
    } ]
  }, {
    "tStartMs": 220230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "they will reach the same conclusion"
    } ]
  }, {
    "tStartMs": 222120,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and therefore also defect."
    } ]
  }, {
    "tStartMs": 224130,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "As a result, when you both act rationally,"
    } ]
  }, {
    "tStartMs": 226770,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "you both end up in the\nsuboptimal situation"
    } ]
  }, {
    "tStartMs": 229650,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "getting one coin each"
    } ]
  }, {
    "tStartMs": 231240,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "when you could have gotten three, instead."
    } ]
  }, {
    "tStartMs": 234330,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "In the case of the US and Soviet Union,"
    } ]
  }, {
    "tStartMs": 236760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "this led both countries to\ndevelop huge nuclear arsenals"
    } ]
  }, {
    "tStartMs": 240120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of tens of thousands of\nnuclear weapons each,"
    } ]
  }, {
    "tStartMs": 243360,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "more than enough to destroy\neach other many times over."
    } ]
  }, {
    "tStartMs": 247260,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "But since both countries had\nnukes, neither could use them."
    } ]
  }, {
    "tStartMs": 251280,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And both countries spent"
    } ]
  }, {
    "tStartMs": 252690,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "around $10 trillion\ndeveloping these weapons."
    } ]
  }, {
    "tStartMs": 256530,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Both would've been better\noff if they had cooperated"
    } ]
  }, {
    "tStartMs": 259860,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and agreed not to develop\nthis technology further."
    } ]
  }, {
    "tStartMs": 262860,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But since they both acted\nin their own best interest,"
    } ]
  }, {
    "tStartMs": 265920,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "they ended up in a situation\nwhere everyone was worse off."
    } ]
  }, {
    "tStartMs": 270960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The prisoner's dilemma is one"
    } ]
  }, {
    "tStartMs": 272550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of the most famous games in game theory."
    } ]
  }, {
    "tStartMs": 274920,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Thousands and thousands of\npapers have been published"
    } ]
  }, {
    "tStartMs": 277500,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "on versions of this game."
    } ]
  }, {
    "tStartMs": 279390,
    "dDurationMs": 3152,
    "segs": [ {
      "utf8": "In part, that's because\nit pops up everywhere."
    } ]
  }, {
    "tStartMs": 282542,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 284370,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Impalas living in\nbetween African woodlands"
    } ]
  }, {
    "tStartMs": 286950,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and Savannahs are prone to\ncatching ticks, which can lead"
    } ]
  }, {
    "tStartMs": 290370,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to infectious diseases,\nparalysis, even death."
    } ]
  }, {
    "tStartMs": 293670,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So it's important for\nimpalas to remove ticks"
    } ]
  }, {
    "tStartMs": 296730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and they do this by grooming,"
    } ]
  }, {
    "tStartMs": 298560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "but they can't reach all\nthe spots on their bodies"
    } ]
  }, {
    "tStartMs": 301170,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "and therefore they need\nanother impala to groom them."
    } ]
  }, {
    "tStartMs": 305190,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Now, grooming someone\nelse comes at a cost."
    } ]
  }, {
    "tStartMs": 308010,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "It costs saliva, electrolytes,\ntime and attention,"
    } ]
  }, {
    "tStartMs": 311550,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "all vital resources\nunder the hot African sun"
    } ]
  }, {
    "tStartMs": 314520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where a predator could\nstrike at any moment."
    } ]
  }, {
    "tStartMs": 317220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So for the other impala,\nit would be best not"
    } ]
  }, {
    "tStartMs": 320250,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to pay this cost, but then again,"
    } ]
  }, {
    "tStartMs": 322650,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it too will need help grooming."
    } ]
  }, {
    "tStartMs": 325050,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So all impalas face a choice:"
    } ]
  }, {
    "tStartMs": 327180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "should they groom each other or not?"
    } ]
  }, {
    "tStartMs": 329400,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "In other words, should\nthey cooperate or defect?"
    } ]
  }, {
    "tStartMs": 334050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Well, if they only interact once,"
    } ]
  }, {
    "tStartMs": 336270,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "then the rational solution\nis always to defect."
    } ]
  }, {
    "tStartMs": 339540,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "That other impala is never\ngonna help you, so why bother?"
    } ]
  }, {
    "tStartMs": 343590,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But the thing about a lot of problems is"
    } ]
  }, {
    "tStartMs": 345240,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that they're not a single\nprisoner's dilemma."
    } ]
  }, {
    "tStartMs": 348030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Impalas see each other day after day"
    } ]
  }, {
    "tStartMs": 350400,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and the same situation keeps\nhappening over and over again."
    } ]
  }, {
    "tStartMs": 354120,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So that changes the problem"
    } ]
  }, {
    "tStartMs": 356670,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "because instead of playing the\nprisoner's dilemma just once,"
    } ]
  }, {
    "tStartMs": 359880,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "you're now playing it many, many times."
    } ]
  }, {
    "tStartMs": 362910,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And if I defect now, then\nmy opponent will know"
    } ]
  }, {
    "tStartMs": 365580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that I'd defected and they can use"
    } ]
  }, {
    "tStartMs": 367620,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "that against me in the future."
    } ]
  }, {
    "tStartMs": 370470,
    "dDurationMs": 4173,
    "segs": [ {
      "utf8": "So what is the best strategy\nin this repeated game?"
    } ]
  }, {
    "tStartMs": 378300,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That is what Robert Axelrod,"
    } ]
  }, {
    "tStartMs": 380220,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "a political scientist wanted to find out."
    } ]
  }, {
    "tStartMs": 382710,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So in 1980 he decided to\nhold a computer tournament."
    } ]
  }, {
    "tStartMs": 386430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- He invited some of the\nworld's leading game theorists"
    } ]
  }, {
    "tStartMs": 388740,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "for many different subjects\nto submit computer programs"
    } ]
  }, {
    "tStartMs": 392880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that would play each other."
    } ]
  }, {
    "tStartMs": 394830,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- Axelrod called these\nprograms strategies."
    } ]
  }, {
    "tStartMs": 398040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Each strategy would face off\nagainst every other strategy"
    } ]
  }, {
    "tStartMs": 401160,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and against a copy of itself"
    } ]
  }, {
    "tStartMs": 403860,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and each matchup would go for 200 rounds."
    } ]
  }, {
    "tStartMs": 407070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "That's important and\nwe'll come back to it."
    } ]
  }, {
    "tStartMs": 409440,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Now, Axelrod used points instead of coins,"
    } ]
  }, {
    "tStartMs": 412140,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but the payoffs were the same."
    } ]
  }, {
    "tStartMs": 413970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The goal of the tournament\nwas to win as many points"
    } ]
  }, {
    "tStartMs": 416760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "as possible and in the end,"
    } ]
  }, {
    "tStartMs": 418890,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the whole tournament was\nrepeated five times over"
    } ]
  }, {
    "tStartMs": 421740,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "to ensure the success was\nrobust and not just a fluke."
    } ]
  }, {
    "tStartMs": 426150,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Axelrod gave an example\nof a simple strategy."
    } ]
  }, {
    "tStartMs": 429330,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It would start each game by\ncooperating and only defect"
    } ]
  }, {
    "tStartMs": 432810,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "after its opponent had\ndefected twice in a row."
    } ]
  }, {
    "tStartMs": 436200,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "In total Axelrod received 14 strategies"
    } ]
  }, {
    "tStartMs": 439230,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and he added a 15th called random,"
    } ]
  }, {
    "tStartMs": 441720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which just randomly cooperates or defects"
    } ]
  }, {
    "tStartMs": 443940,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "50% of the time."
    } ]
  }, {
    "tStartMs": 447060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "All strategies were loaded\nonto a single computer"
    } ]
  }, {
    "tStartMs": 449820,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "where they faced off against each other."
    } ]
  }, {
    "tStartMs": 452280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "One of the strategies was called Friedman."
    } ]
  }, {
    "tStartMs": 454890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It starts off by cooperating,"
    } ]
  }, {
    "tStartMs": 456900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but if its opponent defects just once,"
    } ]
  }, {
    "tStartMs": 459300,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "it will keep defecting for\nthe remainder of the game."
    } ]
  }, {
    "tStartMs": 462660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Another strategy was called Joss."
    } ]
  }, {
    "tStartMs": 465000,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It also starts by cooperating,"
    } ]
  }, {
    "tStartMs": 467010,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "but then it just copies"
    } ]
  }, {
    "tStartMs": 468240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "what the other player\ndid on the last move."
    } ]
  }, {
    "tStartMs": 470850,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Then around 10% of the time,\nJoss gets sneaky and defects."
    } ]
  }, {
    "tStartMs": 475410,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "There was also a rather elaborate strategy"
    } ]
  }, {
    "tStartMs": 477600,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "called Graaskamp."
    } ]
  }, {
    "tStartMs": 478770,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "This strategy works the same as Joss,"
    } ]
  }, {
    "tStartMs": 480720,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but instead of defecting\nprobabilistically,"
    } ]
  }, {
    "tStartMs": 482850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Graaskamp defects in the 50th round"
    } ]
  }, {
    "tStartMs": 485280,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to try and probe the\nstrategy of its opponent"
    } ]
  }, {
    "tStartMs": 487860,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and see if it can take\nadvantage of any weaknesses."
    } ]
  }, {
    "tStartMs": 490740,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The most elaborate\nstrategy was Name Withheld"
    } ]
  }, {
    "tStartMs": 493860,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "with 77 lines of code."
    } ]
  }, {
    "tStartMs": 497160,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "After all the games were played,\nthe results were tallied up"
    } ]
  }, {
    "tStartMs": 499890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and the leaderboard established."
    } ]
  }, {
    "tStartMs": 501780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- The crazy thing was"
    } ]
  }, {
    "tStartMs": 503160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that the simplest\nprogram ended up winning,"
    } ]
  }, {
    "tStartMs": 505680,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "a program that came to\nbe called Tit for Tat."
    } ]
  }, {
    "tStartMs": 508770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Derek] Tit for Tat\nstarts by cooperating"
    } ]
  }, {
    "tStartMs": 511170,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and then it copies exactly"
    } ]
  }, {
    "tStartMs": 512670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "what its opponent did in the last move."
    } ]
  }, {
    "tStartMs": 515130,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So it would follow\ncooperation with cooperation"
    } ]
  }, {
    "tStartMs": 517950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and defection with defection,"
    } ]
  }, {
    "tStartMs": 520110,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but only once if it's opponent\ngoes back to cooperating."
    } ]
  }, {
    "tStartMs": 523110,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "So does Tit for Tat."
    } ]
  }, {
    "tStartMs": 525570,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "When Tit for Tat played against Friedman,"
    } ]
  }, {
    "tStartMs": 527670,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "both started by cooperating\nand they kept cooperating"
    } ]
  }, {
    "tStartMs": 530910,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "both ending up with perfect\nscores for complete cooperation."
    } ]
  }, {
    "tStartMs": 534540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "When Tit for Tat played against Joss,"
    } ]
  }, {
    "tStartMs": 536400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "they too started by cooperating"
    } ]
  }, {
    "tStartMs": 538560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but then on the sixth move, Joss defected."
    } ]
  }, {
    "tStartMs": 541200,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "This sparked a series of\nback and forth defections,"
    } ]
  }, {
    "tStartMs": 543930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "a sort of echo effect."
    } ]
  }, {
    "tStartMs": 545700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Okay, so now you've got\nthis alternating thing"
    } ]
  }, {
    "tStartMs": 548250,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "which will remind you\nof some of the politics"
    } ]
  }, {
    "tStartMs": 550230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of the world today where we\nhave to do something to you"
    } ]
  }, {
    "tStartMs": 552570,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "because of what you did to us."
    } ]
  }, {
    "tStartMs": 554130,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And then when this weird program throws"
    } ]
  }, {
    "tStartMs": 556530,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "in a second unprovoked\ndefection, now it's really bad"
    } ]
  }, {
    "tStartMs": 560640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "because now both programs are\ngonna defect on each other"
    } ]
  }, {
    "tStartMs": 563760,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "for the rest of the game."
    } ]
  }, {
    "tStartMs": 565500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And that's also like some of the things"
    } ]
  }, {
    "tStartMs": 567360,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that we're seeing in politics today"
    } ]
  }, {
    "tStartMs": 569010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and in international relations."
    } ]
  }, {
    "tStartMs": 571110,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- As a result of these\nmutual retaliations,"
    } ]
  }, {
    "tStartMs": 573660,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "both Tit for Tat and Joss did poorly."
    } ]
  }, {
    "tStartMs": 576750,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But because Tit for Tat\nmanaged to cooperate"
    } ]
  }, {
    "tStartMs": 579390,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "with enough other strategies,"
    } ]
  }, {
    "tStartMs": 581010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "it still won the tournament."
    } ]
  }, {
    "tStartMs": 583043,
    "dDurationMs": 1325,
    "segs": [ {
      "utf8": "- As we are being joined..."
    } ]
  }, {
    "tStartMs": 584368,
    "dDurationMs": 1892,
    "segs": [ {
      "utf8": "- Hey my God, there's Professor Axelrod."
    } ]
  }, {
    "tStartMs": 586260,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "- Hey, there's Steven Strogatz."
    } ]
  }, {
    "tStartMs": 590280,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Whoa, what a treat this is."
    } ]
  }, {
    "tStartMs": 592740,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- And I imagine initially it'd be sort"
    } ]
  }, {
    "tStartMs": 595050,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "of like computer chess"
    } ]
  }, {
    "tStartMs": 595980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "where you need a pretty\ncomplicated program"
    } ]
  }, {
    "tStartMs": 597780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to play a sophisticated game."
    } ]
  }, {
    "tStartMs": 599760,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But in fact it was not like that at all."
    } ]
  }, {
    "tStartMs": 601830,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It was the simplest\nstrategy that did the best."
    } ]
  }, {
    "tStartMs": 604830,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So I analyzed how that happened."
    } ]
  }, {
    "tStartMs": 608190,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- Axelrod found that all the\nbest performing strategies,"
    } ]
  }, {
    "tStartMs": 610920,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "including Tit for Tat,\nshared four qualities."
    } ]
  }, {
    "tStartMs": 615210,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "First, they were all nice,"
    } ]
  }, {
    "tStartMs": 617400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "which just means they are\nnot the first to defect."
    } ]
  }, {
    "tStartMs": 620220,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So Tit for Tat is a nice strategy,"
    } ]
  }, {
    "tStartMs": 622290,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "it can defect but only in retaliation."
    } ]
  }, {
    "tStartMs": 625860,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The opposite of nice is nasty."
    } ]
  }, {
    "tStartMs": 628230,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "That's a strategy that defects first."
    } ]
  }, {
    "tStartMs": 630330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So Joss is nasty."
    } ]
  }, {
    "tStartMs": 632670,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Outta the 15 strategies in the tournament,"
    } ]
  }, {
    "tStartMs": 634680,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "eight were nice and seven nasty."
    } ]
  }, {
    "tStartMs": 637470,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The top eight strategies were all nice"
    } ]
  }, {
    "tStartMs": 640710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and even the worst\nperforming nice strategy"
    } ]
  }, {
    "tStartMs": 642900,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "still far outscored the\nbest performing nasty one."
    } ]
  }, {
    "tStartMs": 646890,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The second important\nquality was being forgiving."
    } ]
  }, {
    "tStartMs": 650250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "A forgiving strategy is\none that can retaliate"
    } ]
  }, {
    "tStartMs": 652980,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "but it doesn't hold a grudge."
    } ]
  }, {
    "tStartMs": 654750,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So Tit for Tat is a forgiving strategy."
    } ]
  }, {
    "tStartMs": 657360,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "It retaliates when its opponent defects"
    } ]
  }, {
    "tStartMs": 659790,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "but it doesn't let affections"
    } ]
  }, {
    "tStartMs": 661080,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "from before the last round\ninfluence its current decisions."
    } ]
  }, {
    "tStartMs": 665010,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Friedman on the other hand,\nis maximally unforgiving"
    } ]
  }, {
    "tStartMs": 668760,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- After the first defection\njust from the opponent"
    } ]
  }, {
    "tStartMs": 672180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "would defect for the rest of the game."
    } ]
  }, {
    "tStartMs": 674250,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Okay, that's it."
    } ]
  }, {
    "tStartMs": 675570,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "No mercy and that might feel good to do"
    } ]
  }, {
    "tStartMs": 679410,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "but it doesn't end up working\nout well in the long run."
    } ]
  }, {
    "tStartMs": 683280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- This conclusion that it pays to be nice"
    } ]
  }, {
    "tStartMs": 685620,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and forgiving came as\na shock to the experts."
    } ]
  }, {
    "tStartMs": 688860,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Many had tried to be tricky"
    } ]
  }, {
    "tStartMs": 690150,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and create subtle nasty\nstrategies to beat their opponent"
    } ]
  }, {
    "tStartMs": 692970,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and eke out an advantage,"
    } ]
  }, {
    "tStartMs": 695160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "but they all failed."
    } ]
  }, {
    "tStartMs": 696480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Instead, in this tournament,"
    } ]
  }, {
    "tStartMs": 698010,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "nice guys finished first."
    } ]
  }, {
    "tStartMs": 700170,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Now Tit for Tat is quite forgiving"
    } ]
  }, {
    "tStartMs": 701940,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but it's possible to\nbe even more forgiving."
    } ]
  }, {
    "tStartMs": 704790,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Axelrod's sample strategy only defects"
    } ]
  }, {
    "tStartMs": 707160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "after its opponent\ndefected twice in a row."
    } ]
  }, {
    "tStartMs": 709770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It was Tit for Two Tats."
    } ]
  }, {
    "tStartMs": 711660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Now that might sound overly generous,"
    } ]
  }, {
    "tStartMs": 714270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but when Axelrod ran the numbers,"
    } ]
  }, {
    "tStartMs": 716100,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "he found that if anyone had\nsubmitted the Sample strategy,"
    } ]
  }, {
    "tStartMs": 719490,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "they would've won the tournament."
    } ]
  }, {
    "tStartMs": 725250,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- I mean it's so clever,"
    } ]
  }, {
    "tStartMs": 726090,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "there's so many layers to this story."
    } ]
  }, {
    "tStartMs": 729000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "After Axelrod published his analysis"
    } ]
  }, {
    "tStartMs": 731340,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of what happened or circulated it"
    } ]
  }, {
    "tStartMs": 733140,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "among these game theorists, he said,"
    } ]
  }, {
    "tStartMs": 735180,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "now that we all know what\nworked well, let's try again."
    } ]
  }, {
    "tStartMs": 740550,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- So he announced a second tournament"
    } ]
  }, {
    "tStartMs": 742590,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "where everything would be the same except"
    } ]
  }, {
    "tStartMs": 744660,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "for one change the number\nof rounds per game."
    } ]
  }, {
    "tStartMs": 748350,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "See in the first tournament,"
    } ]
  }, {
    "tStartMs": 749670,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "each game lasted precisely 200 rounds."
    } ]
  }, {
    "tStartMs": 752820,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And that is important because if you know"
    } ]
  }, {
    "tStartMs": 754860,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "when the last round is,"
    } ]
  }, {
    "tStartMs": 756210,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "then there's no reason to\ncooperate in that round."
    } ]
  }, {
    "tStartMs": 759360,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So you're better off defecting."
    } ]
  }, {
    "tStartMs": 761190,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Of course your opponent\nshould reason the same"
    } ]
  }, {
    "tStartMs": 763290,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and so they should also\ndefect in the last round."
    } ]
  }, {
    "tStartMs": 766200,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "But if you both anticipate\ndefection in the last round,"
    } ]
  }, {
    "tStartMs": 769710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "then there's no reason for\nyou to cooperate in the second"
    } ]
  }, {
    "tStartMs": 771990,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "to last round or the round\nbefore that, or before that"
    } ]
  }, {
    "tStartMs": 774900,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and so on all the way\nto the very first round."
    } ]
  }, {
    "tStartMs": 777780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- And so in Axelrod's tournament,"
    } ]
  }, {
    "tStartMs": 780000,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "it was a very important thing"
    } ]
  }, {
    "tStartMs": 781290,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that the players didn't know exactly"
    } ]
  }, {
    "tStartMs": 783060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "how long they were gonna be playing."
    } ]
  }, {
    "tStartMs": 784980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "They knew on average\nit would be 200 rounds,"
    } ]
  }, {
    "tStartMs": 787860,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but there was a random number generator"
    } ]
  }, {
    "tStartMs": 790320,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that prevented them from\nknowing with certainty."
    } ]
  }, {
    "tStartMs": 793260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Yeah, if you're not sure when it ends,"
    } ]
  }, {
    "tStartMs": 795510,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "then you have to kind of keep cooperating"
    } ]
  }, {
    "tStartMs": 797040,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "'cause it might keep going\nand you need might need them"
    } ]
  }, {
    "tStartMs": 798792,
    "dDurationMs": 2748,
    "segs": [ {
      "utf8": "on your side.\n- That's right."
    } ]
  }, {
    "tStartMs": 801540,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- For this second tournament,\nAxelrod received 62 entries"
    } ]
  }, {
    "tStartMs": 805320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and again, added random."
    } ]
  }, {
    "tStartMs": 807480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The contestants had gotten the results"
    } ]
  }, {
    "tStartMs": 809190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and analysis from the first tournament"
    } ]
  }, {
    "tStartMs": 810870,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and could use this information\nto their advantage."
    } ]
  }, {
    "tStartMs": 813690,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This created two camps."
    } ]
  }, {
    "tStartMs": 815880,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Some thought that clearly being nice"
    } ]
  }, {
    "tStartMs": 818010,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and forgiving were winning qualities."
    } ]
  }, {
    "tStartMs": 819900,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So they submitted nice\nand forgiving strategies."
    } ]
  }, {
    "tStartMs": 822870,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "One even submitted Tit for Two Tats."
    } ]
  }, {
    "tStartMs": 825360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The second camp anticipated\nthat others would be nice"
    } ]
  }, {
    "tStartMs": 828450,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and extra forgiving"
    } ]
  }, {
    "tStartMs": 830070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and therefore they\nsubmitted nasty strategies"
    } ]
  }, {
    "tStartMs": 832260,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "to try to take advantage of\nthose that were extra forgiving."
    } ]
  }, {
    "tStartMs": 836220,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "One such strategy was called Tester."
    } ]
  }, {
    "tStartMs": 838650,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "It would defect on the first move"
    } ]
  }, {
    "tStartMs": 840150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to see how its opponent reacted."
    } ]
  }, {
    "tStartMs": 842250,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "If it retaliated, tester would apologize"
    } ]
  }, {
    "tStartMs": 844860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and play Tit for Tat for\nthe remainder of the game."
    } ]
  }, {
    "tStartMs": 847140,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "If it didn't retaliate,"
    } ]
  }, {
    "tStartMs": 848490,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "tester would defect every\nother move after that."
    } ]
  }, {
    "tStartMs": 853770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But again, being nasty didn't pay."
    } ]
  }, {
    "tStartMs": 856800,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "- And once again, Tit for\nTat was the most effective."
    } ]
  }, {
    "tStartMs": 861330,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- Nice strategies again did much better."
    } ]
  }, {
    "tStartMs": 864120,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "In the top 15, only one was not nice."
    } ]
  }, {
    "tStartMs": 867450,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "Similarly, in the bottom\n15, only one was not nasty."
    } ]
  }, {
    "tStartMs": 872940,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "After the second tournament,"
    } ]
  }, {
    "tStartMs": 874290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Axelrod identified the other qualities"
    } ]
  }, {
    "tStartMs": 876390,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that distinguished the\nbetter performing strategies."
    } ]
  }, {
    "tStartMs": 878880,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "The third is being retaliatory,"
    } ]
  }, {
    "tStartMs": 881340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which means if your opponent defects,"
    } ]
  }, {
    "tStartMs": 883500,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "strike back immediately,\ndon't be a pushover."
    } ]
  }, {
    "tStartMs": 887430,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Always cooperate is a total pushover."
    } ]
  }, {
    "tStartMs": 890070,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And so it's very easy\nto take advantage of."
    } ]
  }, {
    "tStartMs": 892560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Tit for Tat, on the other hand,"
    } ]
  }, {
    "tStartMs": 894000,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "is very hard to take advantage of."
    } ]
  }, {
    "tStartMs": 897120,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The last quality that Axelrod\nidentified is being clear."
    } ]
  }, {
    "tStartMs": 901020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Programs that were too opaque,"
    } ]
  }, {
    "tStartMs": 903360,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that were too similar to a random program,"
    } ]
  }, {
    "tStartMs": 906660,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "you couldn't figure them out"
    } ]
  }, {
    "tStartMs": 907680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because they were so complicated,"
    } ]
  }, {
    "tStartMs": 909600,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "tt was very hard to establish\nany pattern of trust"
    } ]
  }, {
    "tStartMs": 912030,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "with a program like that"
    } ]
  }, {
    "tStartMs": 913170,
    "dDurationMs": 3068,
    "segs": [ {
      "utf8": "because you couldn't figure\nout what it was doing."
    } ]
  }, {
    "tStartMs": 916238,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Not you."
    } ]
  }, {
    "tStartMs": 917071,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "I mean the other programs it was playing"
    } ]
  }, {
    "tStartMs": 918960,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "couldn't figure them out and\nso they would end up more"
    } ]
  }, {
    "tStartMs": 921510,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "or less defaulting to thinking\nevery turn is like the"
    } ]
  }, {
    "tStartMs": 924510,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "last time I'm gonna see you."
    } ]
  }, {
    "tStartMs": 925860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So I might as well defect."
    } ]
  }, {
    "tStartMs": 927900,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "What to me is mind blowing about this"
    } ]
  }, {
    "tStartMs": 931590,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "is that these four principles\nbeing nice, forgiving,"
    } ]
  }, {
    "tStartMs": 936330,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "provokable and clear is\na lot like the morality"
    } ]
  }, {
    "tStartMs": 940200,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "that has evolved around the\nworld that is often summarized"
    } ]
  }, {
    "tStartMs": 944040,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "as an eye for an eye."
    } ]
  }, {
    "tStartMs": 946230,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's not Christianity, by the way."
    } ]
  }, {
    "tStartMs": 948630,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's not to not turn the\nother cheek philosophy,"
    } ]
  }, {
    "tStartMs": 951510,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "it's some older philosophy."
    } ]
  }, {
    "tStartMs": 957150,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- What's interesting is that"
    } ]
  }, {
    "tStartMs": 958200,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "while Tit for Two Tats would've\nwon the first tournament,"
    } ]
  }, {
    "tStartMs": 960690,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "it only came 24th in\nthe second tournament."
    } ]
  }, {
    "tStartMs": 963900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This highlights an important fact:"
    } ]
  }, {
    "tStartMs": 966060,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "in the repeated prisoner's dilemma,"
    } ]
  }, {
    "tStartMs": 967920,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "there is no single best strategy."
    } ]
  }, {
    "tStartMs": 970650,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The strategy that performs\nbest always depends"
    } ]
  }, {
    "tStartMs": 973320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "on the other strategies\nit's interacting with."
    } ]
  }, {
    "tStartMs": 975960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "For example, if you put Tit\nfor Tat in an environment"
    } ]
  }, {
    "tStartMs": 978390,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "with only the ultimate\nbullies of always defect,"
    } ]
  }, {
    "tStartMs": 981720,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "then Tit for Tat comes in last."
    } ]
  }, {
    "tStartMs": 984870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- I wanted to see whether, for example,"
    } ]
  }, {
    "tStartMs": 987060,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the Tit for Tat did well"
    } ]
  }, {
    "tStartMs": 988680,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "because it did well\nwith really stupid rules"
    } ]
  }, {
    "tStartMs": 991470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that didn't do well with it all themselves"
    } ]
  }, {
    "tStartMs": 993060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that basically it took\nadvantage of people."
    } ]
  }, {
    "tStartMs": 995160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- So he ran a simulation"
    } ]
  }, {
    "tStartMs": 996480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "where successful strategies\nin one generation"
    } ]
  }, {
    "tStartMs": 998940,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "would see their numbers\ngrow and unsuccessful ones"
    } ]
  }, {
    "tStartMs": 1001790,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "would see their numbers drop."
    } ]
  }, {
    "tStartMs": 1003680,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "In this simulation,"
    } ]
  }, {
    "tStartMs": 1004790,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the worst performing\nstrategies quickly shrink"
    } ]
  }, {
    "tStartMs": 1007070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and go extinct, while the\ntop performing strategies"
    } ]
  }, {
    "tStartMs": 1009830,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "become more common."
    } ]
  }, {
    "tStartMs": 1011450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Harrington, the only nasty\nstrategy in the top 15,"
    } ]
  }, {
    "tStartMs": 1014930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "first grew quickly,"
    } ]
  }, {
    "tStartMs": 1016700,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but then as the strategies it\nwas preying on went extinct,"
    } ]
  }, {
    "tStartMs": 1019820,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Harrington's numbers also quickly dropped."
    } ]
  }, {
    "tStartMs": 1023930,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "This shows a main benefit\nof this simulation"
    } ]
  }, {
    "tStartMs": 1026510,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "because it tests how well a strategy does"
    } ]
  }, {
    "tStartMs": 1029150,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "with other successful strategies."
    } ]
  }, {
    "tStartMs": 1031790,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "After a thousand generations,"
    } ]
  }, {
    "tStartMs": 1033200,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the proportions are mostly stable"
    } ]
  }, {
    "tStartMs": 1035720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and only nice strategies survive."
    } ]
  }, {
    "tStartMs": 1038390,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Again, Tit for Tat comes out on top,"
    } ]
  }, {
    "tStartMs": 1041180,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "representing 14.5% of\nthe total population."
    } ]
  }, {
    "tStartMs": 1045380,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now this process may sound\nsimilar to evolution,"
    } ]
  }, {
    "tStartMs": 1048290,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but there is a subtle difference,"
    } ]
  }, {
    "tStartMs": 1049970,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which is that in this case\nthere are no mutations."
    } ]
  }, {
    "tStartMs": 1052520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So it's actually an ecological simulation."
    } ]
  }, {
    "tStartMs": 1055880,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But what if the world you\nstarted in was different?"
    } ]
  }, {
    "tStartMs": 1059330,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- Imagine a world that is a\nreally nasty place to live,"
    } ]
  }, {
    "tStartMs": 1062240,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "more or less populated with\nplayers that always defect,"
    } ]
  }, {
    "tStartMs": 1065060,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "except there's a little\ncluster of tit-for-tat players"
    } ]
  }, {
    "tStartMs": 1068150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that live in some kind of nucleus"
    } ]
  }, {
    "tStartMs": 1070250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and they get to play with each other a lot"
    } ]
  }, {
    "tStartMs": 1071870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "because they're\ngeographically sequestered."
    } ]
  }, {
    "tStartMs": 1074720,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "They will start building\nup a lot of points,"
    } ]
  }, {
    "tStartMs": 1077000,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and also because that\ntranslates into offspring,"
    } ]
  }, {
    "tStartMs": 1079850,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "they'll start to take over the population."
    } ]
  }, {
    "tStartMs": 1082130,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So in fact, Axelrod showed\nthat a little island"
    } ]
  }, {
    "tStartMs": 1085190,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "of cooperation can emerge and spread"
    } ]
  }, {
    "tStartMs": 1089480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and eventually will take over the world,"
    } ]
  }, {
    "tStartMs": 1091850,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "which is fantastic."
    } ]
  }, {
    "tStartMs": 1094682,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "How can cooperation emerge in a population"
    } ]
  }, {
    "tStartMs": 1099682,
    "dDurationMs": 2308,
    "segs": [ {
      "utf8": "of players who are self-interested?"
    } ]
  }, {
    "tStartMs": 1101990,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Who are not trying to be good\nbecause they're good-hearted."
    } ]
  }, {
    "tStartMs": 1105320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "You don't have to be altruistic."
    } ]
  }, {
    "tStartMs": 1108140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "You could be looking out\nfor number one for yourself"
    } ]
  }, {
    "tStartMs": 1110720,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and your own interests."
    } ]
  }, {
    "tStartMs": 1111860,
    "dDurationMs": 2886,
    "segs": [ {
      "utf8": "And yet cooperation can still emerge."
    } ]
  }, {
    "tStartMs": 1114746,
    "dDurationMs": 3294,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 1118040,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Some argue that this\ncould explain how we went"
    } ]
  }, {
    "tStartMs": 1119960,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "from a world full of\ncompletely selfish organisms"
    } ]
  }, {
    "tStartMs": 1125060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "where every organism only\ncared about themselves"
    } ]
  }, {
    "tStartMs": 1127730,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "to one where cooperation\nemerged and flourished."
    } ]
  }, {
    "tStartMs": 1131660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "From impalas grooming each other"
    } ]
  }, {
    "tStartMs": 1133460,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "to fish cleaning sharks."
    } ]
  }, {
    "tStartMs": 1136520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Many life forms experience\nconflicts similar"
    } ]
  }, {
    "tStartMs": 1139280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to the prisoner's dilemma,"
    } ]
  }, {
    "tStartMs": 1141080,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "but because they don't interact just once,"
    } ]
  }, {
    "tStartMs": 1144320,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "both can be better off by cooperating."
    } ]
  }, {
    "tStartMs": 1148130,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "And this doesn't require trust\nor conscious thought either"
    } ]
  }, {
    "tStartMs": 1151520,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "because the strategy\ncould be encoded in DNA,"
    } ]
  }, {
    "tStartMs": 1155690,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "as long as it performs better\nthan the other strategies,"
    } ]
  }, {
    "tStartMs": 1158450,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "it can take over a population."
    } ]
  }, {
    "tStartMs": 1167030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Axelrod's insights were applied"
    } ]
  }, {
    "tStartMs": 1168620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to areas like evolutionary biology"
    } ]
  }, {
    "tStartMs": 1170720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and international conflicts,"
    } ]
  }, {
    "tStartMs": 1172640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but there was one aspect"
    } ]
  }, {
    "tStartMs": 1174320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that his original\ntournaments didn't cover."
    } ]
  }, {
    "tStartMs": 1176480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "What happens if there is a little bit"
    } ]
  }, {
    "tStartMs": 1178400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of random error in the game?"
    } ]
  }, {
    "tStartMs": 1180710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Some noise in the system."
    } ]
  }, {
    "tStartMs": 1182630,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "For example, one player\ntries to cooperate,"
    } ]
  }, {
    "tStartMs": 1184850,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but it comes across as a defection."
    } ]
  }, {
    "tStartMs": 1187010,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Little errors like this happen"
    } ]
  }, {
    "tStartMs": 1188450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "in the real world all the time."
    } ]
  }, {
    "tStartMs": 1190490,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Like in 1983,"
    } ]
  }, {
    "tStartMs": 1192080,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the Soviet satellite-based\nearly warning system"
    } ]
  }, {
    "tStartMs": 1194210,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "detected the launch of an\nintercontinental ballistic missile"
    } ]
  }, {
    "tStartMs": 1196970,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "from the US but the US\nhadn't launched anything."
    } ]
  }, {
    "tStartMs": 1200960,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The Soviet system had confused\nsunlight reflecting off"
    } ]
  }, {
    "tStartMs": 1203960,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "high altitude clouds\nwith a ballistic missile."
    } ]
  }, {
    "tStartMs": 1207440,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Thankfully, Stanislav Petrov,"
    } ]
  }, {
    "tStartMs": 1209180,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "the Soviet officer on\nduty, dismissed the alarm."
    } ]
  }, {
    "tStartMs": 1212390,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But this example shows the\npotential costs of a signal error"
    } ]
  }, {
    "tStartMs": 1215930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and the importance of\nstudying the effects of noise"
    } ]
  }, {
    "tStartMs": 1218450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "on those strategies."
    } ]
  }, {
    "tStartMs": 1220340,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- The word game sounds\nlike it's a children's game"
    } ]
  }, {
    "tStartMs": 1222890,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "or, you know, there's some something,"
    } ]
  }, {
    "tStartMs": 1224480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "a misnomer maybe in calling it game theory"
    } ]
  }, {
    "tStartMs": 1227360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "because this is,"
    } ]
  }, {
    "tStartMs": 1228620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "these are life and\ndeath matters obviously."
    } ]
  }, {
    "tStartMs": 1231620,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And as you mentioned that\nthis came up in the Cold War."
    } ]
  }, {
    "tStartMs": 1233900,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I mean it could actually be life and death"
    } ]
  }, {
    "tStartMs": 1236180,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "of the whole planet,"
    } ]
  }, {
    "tStartMs": 1237110,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the whole we could annihilate\nhuman civilization."
    } ]
  }, {
    "tStartMs": 1239720,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So these are not games in\nany kind of trivial sense,"
    } ]
  }, {
    "tStartMs": 1243440,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "it's just the term that is used"
    } ]
  }, {
    "tStartMs": 1244910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "by mathematicians and theorists."
    } ]
  }, {
    "tStartMs": 1247070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- When Tit for Tat plays against itself"
    } ]
  }, {
    "tStartMs": 1249110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in a noisy environment,"
    } ]
  }, {
    "tStartMs": 1250610,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "both start off by cooperating,"
    } ]
  }, {
    "tStartMs": 1253100,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "but if a single cooperation\nis perceived as a defection,"
    } ]
  }, {
    "tStartMs": 1256730,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "then the other Tit for Tat retaliates"
    } ]
  }, {
    "tStartMs": 1258590,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and it sets off a chain of\nalternating retaliations."
    } ]
  }, {
    "tStartMs": 1262340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And if another cooperation\nis perceived as a defection,"
    } ]
  }, {
    "tStartMs": 1265010,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "then the rest of the game is\nconstant mutual defection."
    } ]
  }, {
    "tStartMs": 1268730,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Therefore, in the long run,\nboth would only get a third"
    } ]
  }, {
    "tStartMs": 1271370,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of the points they would get\nin a perfect environment."
    } ]
  }, {
    "tStartMs": 1274490,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Tit for Tat goes from performing very well"
    } ]
  }, {
    "tStartMs": 1276980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to performing poorly."
    } ]
  }, {
    "tStartMs": 1279080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So how do you solve this?"
    } ]
  }, {
    "tStartMs": 1281540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Well, you need a reliable way"
    } ]
  }, {
    "tStartMs": 1283040,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to break out of these echo effects."
    } ]
  }, {
    "tStartMs": 1285230,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And one way to do this is\nby playing Tit for Tat,"
    } ]
  }, {
    "tStartMs": 1288080,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but with around 10% more forgiveness."
    } ]
  }, {
    "tStartMs": 1291560,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So instead of retaliating\nafter every defection,"
    } ]
  }, {
    "tStartMs": 1294590,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "you only retaliate around\nnine out of every 10 times."
    } ]
  }, {
    "tStartMs": 1298220,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "This helps you break out of those echoes"
    } ]
  }, {
    "tStartMs": 1300110,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "while still being retaliatory enough"
    } ]
  }, {
    "tStartMs": 1301940,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to not be taken advantage of."
    } ]
  }, {
    "tStartMs": 1304520,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- And so we also ran the tournament"
    } ]
  }, {
    "tStartMs": 1306290,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "with noise and generosity\nand that did quite well."
    } ]
  }, {
    "tStartMs": 1317540,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "My favorite example is Tit\nfor Tat does really well,"
    } ]
  }, {
    "tStartMs": 1321380,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "but it could never do better"
    } ]
  }, {
    "tStartMs": 1322490,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "than the player it's playing with."
    } ]
  }, {
    "tStartMs": 1325220,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- I mean, think about it, by design,"
    } ]
  }, {
    "tStartMs": 1327320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "all they can do is lose or draw."
    } ]
  }, {
    "tStartMs": 1330200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And yet when the results of all\ninteractions are tallied up,"
    } ]
  }, {
    "tStartMs": 1333560,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "they come out ahead of\nall other strategies."
    } ]
  }, {
    "tStartMs": 1337010,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Similarly, always defect\ncan never lose a game."
    } ]
  }, {
    "tStartMs": 1340640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "It can only draw or win,"
    } ]
  }, {
    "tStartMs": 1343010,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "but overall, it performs extremely poorly."
    } ]
  }, {
    "tStartMs": 1347120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "This highlights a common misconception"
    } ]
  }, {
    "tStartMs": 1349580,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "because for many people when\nthey think about winning,"
    } ]
  }, {
    "tStartMs": 1351800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they think they need to\nbeat the other person."
    } ]
  }, {
    "tStartMs": 1354560,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "In games like chess or poker, this is true"
    } ]
  }, {
    "tStartMs": 1357620,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "since one person's gain"
    } ]
  }, {
    "tStartMs": 1358850,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "is necessarily another person's loss,"
    } ]
  }, {
    "tStartMs": 1361340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so these games are zero sum."
    } ]
  }, {
    "tStartMs": 1363680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But most of life is not zero sum."
    } ]
  }, {
    "tStartMs": 1366350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "To win, you don't need to get your reward"
    } ]
  }, {
    "tStartMs": 1368360,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "from the other player."
    } ]
  }, {
    "tStartMs": 1369530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Instead, you can get it from the banker."
    } ]
  }, {
    "tStartMs": 1371720,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Only in real life, the\nbanker is the world."
    } ]
  }, {
    "tStartMs": 1374540,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "It is literally everything around you."
    } ]
  }, {
    "tStartMs": 1377510,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It is just up to us to find\nthose win-win situations,"
    } ]
  }, {
    "tStartMs": 1380600,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "and then work together\nto unlock those rewards."
    } ]
  }, {
    "tStartMs": 1384650,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Cooperation pays even among rivals."
    } ]
  }, {
    "tStartMs": 1388100,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "From 1950 to 1986,"
    } ]
  }, {
    "tStartMs": 1390020,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the US and Soviet Union\nhad trouble cooperating"
    } ]
  }, {
    "tStartMs": 1392900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and both kept developing nukes."
    } ]
  }, {
    "tStartMs": 1395330,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But then from the late '80s onwards,"
    } ]
  }, {
    "tStartMs": 1397910,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "they started reducing\ntheir nuclear stockpiles."
    } ]
  }, {
    "tStartMs": 1401240,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "They too had learned\nhow to resolve conflict."
    } ]
  }, {
    "tStartMs": 1404060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Rather than making an agreement"
    } ]
  }, {
    "tStartMs": 1405410,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to abolish all nuclear arms at once"
    } ]
  }, {
    "tStartMs": 1407540,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and essentially turning it into\na single prisoner's dilemma,"
    } ]
  }, {
    "tStartMs": 1411440,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "they would disarm slowly, a\nsmall number of nukes each year"
    } ]
  }, {
    "tStartMs": 1415400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and then they'd check each other"
    } ]
  }, {
    "tStartMs": 1416840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to see that they had both cooperated"
    } ]
  }, {
    "tStartMs": 1419450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and then repeat the year after,"
    } ]
  }, {
    "tStartMs": 1421400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the year after that."
    } ]
  }, {
    "tStartMs": 1423320,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "All along, checking to\nensure mutual cooperation."
    } ]
  }, {
    "tStartMs": 1427190,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "In the more than 40 years\nsince Axelrod's tournaments,"
    } ]
  }, {
    "tStartMs": 1430010,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "researchers have continued"
    } ]
  }, {
    "tStartMs": 1431270,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to study which strategies perform best"
    } ]
  }, {
    "tStartMs": 1433460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "in a variety of environments."
    } ]
  }, {
    "tStartMs": 1435410,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "In doing so, they varied\neverything from payoff structures"
    } ]
  }, {
    "tStartMs": 1438650,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "to strategies to errors and more."
    } ]
  }, {
    "tStartMs": 1441680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Some even allowed the strategies to mutate"
    } ]
  }, {
    "tStartMs": 1445040,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "while Tit for Tat or generous Tit for Tat"
    } ]
  }, {
    "tStartMs": 1447110,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "doesn't always come out on top,"
    } ]
  }, {
    "tStartMs": 1449270,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "Axelrod's main takeaways still\nhold: be nice, forgiving,"
    } ]
  }, {
    "tStartMs": 1453980,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but don't be a pushover."
    } ]
  }, {
    "tStartMs": 1456350,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- Can I ask you, why did Anatol Rapoport"
    } ]
  }, {
    "tStartMs": 1459710,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "submit Tit for Tat?"
    } ]
  }, {
    "tStartMs": 1463640,
    "dDurationMs": 3089,
    "segs": [ {
      "utf8": "- Well, the reason was\nbecause I asked him to."
    } ]
  }, {
    "tStartMs": 1466729,
    "dDurationMs": 2131,
    "segs": [ {
      "utf8": "(both laugh)"
    } ]
  }, {
    "tStartMs": 1468860,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And he wrote saying, yeah,\nthat I'm willing to do that,"
    } ]
  }, {
    "tStartMs": 1472520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but I just wanna be\nclear that I'm not sure"
    } ]
  }, {
    "tStartMs": 1475280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that this is really such a good idea."
    } ]
  }, {
    "tStartMs": 1476960,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "I don't, he was a peace researcher"
    } ]
  }, {
    "tStartMs": 1479450,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and I think his own inclinations were"
    } ]
  }, {
    "tStartMs": 1482870,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to be much more forgiving and\nmaybe not be so provokable."
    } ]
  }, {
    "tStartMs": 1489230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- What I find fascinating is\nthat one of the main things"
    } ]
  }, {
    "tStartMs": 1492140,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that sets life apart\nfrom non-living things"
    } ]
  }, {
    "tStartMs": 1494420,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that life gets to make decisions."
    } ]
  }, {
    "tStartMs": 1496490,
    "dDurationMs": 1312,
    "segs": [ {
      "utf8": "We get to make choices."
    } ]
  }, {
    "tStartMs": 1497802,
    "dDurationMs": 2288,
    "segs": [ {
      "utf8": "Choices that don't only change our future,"
    } ]
  }, {
    "tStartMs": 1500090,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but also the future of\nthose we interact with."
    } ]
  }, {
    "tStartMs": 1502310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You see, in the short term,\nit is often the environment"
    } ]
  }, {
    "tStartMs": 1505310,
    "dDurationMs": 2907,
    "segs": [ {
      "utf8": "that shapes the player that\ndetermines who does well."
    } ]
  }, {
    "tStartMs": 1508217,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "But in the long run, it is the players"
    } ]
  }, {
    "tStartMs": 1511010,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "that shape the environment."
    } ]
  }, {
    "tStartMs": 1514130,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So let's play a game, the game of life,"
    } ]
  }, {
    "tStartMs": 1517670,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and make your choices wisely"
    } ]
  }, {
    "tStartMs": 1519380,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "because their impact may\nreach further than you think."
    } ]
  }, {
    "tStartMs": 1527870,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Using the right strategy matters,"
    } ]
  }, {
    "tStartMs": 1530270,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but figuring out the\nbest strategy isn't easy."
    } ]
  }, {
    "tStartMs": 1533120,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It requires critical thinking"
    } ]
  }, {
    "tStartMs": 1534500,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and innovative solutions\nlike Axelrod's tournaments."
    } ]
  }, {
