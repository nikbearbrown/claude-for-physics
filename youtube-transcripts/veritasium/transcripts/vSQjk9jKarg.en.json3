{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- This video is about one of\nthe most important questions:"
    } ]
  }, {
    "tStartMs": 3180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "what leads to a happy life?"
    } ]
  }, {
    "tStartMs": 5340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Realistically, money."
    } ]
  }, {
    "tStartMs": 6870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Being wealthy is definitely\na big aspect of it."
    } ]
  }, {
    "tStartMs": 9420,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- To save a lot of money."
    } ]
  }, {
    "tStartMs": 10530,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Money.\n- Money."
    } ]
  }, {
    "tStartMs": 11363,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Earning money."
    } ]
  }, {
    "tStartMs": 12196,
    "dDurationMs": 1424,
    "segs": [ {
      "utf8": "- It's very important to be rich."
    } ]
  }, {
    "tStartMs": 13620,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- It's easy for people"
    } ]
  }, {
    "tStartMs": 14460,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "to say they don't care about having money"
    } ]
  }, {
    "tStartMs": 15930,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and that money can't buy happiness,"
    } ]
  }, {
    "tStartMs": 17940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but that's really not true."
    } ]
  }, {
    "tStartMs": 19920,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- 'Cause I would rather cry on a yacht"
    } ]
  }, {
    "tStartMs": 21570,
    "dDurationMs": 2747,
    "segs": [ {
      "utf8": "than in a like a Subaru."
    } ]
  }, {
    "tStartMs": 24317,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "(both laugh)"
    } ]
  }, {
    "tStartMs": 26490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- [Derek] Clearly, having\na successful career"
    } ]
  }, {
    "tStartMs": 28380,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and financial wealth\nare important to people."
    } ]
  }, {
    "tStartMs": 30630,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Is there a number in mind?\nSomething you wanna get to?"
    } ]
  }, {
    "tStartMs": 33030,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- At least a million."
    } ]
  }, {
    "tStartMs": 34500,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Yeah?\n- Yeah."
    } ]
  }, {
    "tStartMs": 35490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- In a survey from 2018"
    } ]
  }, {
    "tStartMs": 37110,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of around a hundred\nthousand college freshmen,"
    } ]
  }, {
    "tStartMs": 39780,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "about 55% said they wanted to\nbe successful in their career"
    } ]
  }, {
    "tStartMs": 43770,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and 83% reported that they\nwanted to become rich."
    } ]
  }, {
    "tStartMs": 48030,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But do these accomplishments\nreally increase happiness?"
    } ]
  }, {
    "tStartMs": 51150,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Well, that's what I wanna\nfind out in this video."
    } ]
  }, {
    "tStartMs": 53940,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But how do you study\nwhat makes people happy?"
    } ]
  }, {
    "tStartMs": 56580,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Well, you can ask them."
    } ]
  }, {
    "tStartMs": 58020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "What's gonna make you happy?"
    } ]
  }, {
    "tStartMs": 60150,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Um.\n- Uh."
    } ]
  }, {
    "tStartMs": 61080,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Uh.\n- Uh."
    } ]
  }, {
    "tStartMs": 62070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Ooh."
    } ]
  }, {
    "tStartMs": 62903,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "- [Derek] But people aren't really good"
    } ]
  }, {
    "tStartMs": 64500,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "at judging what will make them happy."
    } ]
  }, {
    "tStartMs": 66120,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Winning the lottery seems\nlike it should make you happy."
    } ]
  }, {
    "tStartMs": 68910,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "- What!?\n(sister screams)"
    } ]
  }, {
    "tStartMs": 70224,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "What!? What!?"
    } ]
  }, {
    "tStartMs": 72270,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Derek] But numerous\nstudies on lottery winners"
    } ]
  }, {
    "tStartMs": 74340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "find that after the initial\nsurge of happiness wears off,"
    } ]
  }, {
    "tStartMs": 76980,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "many are no happier than the rest of us."
    } ]
  }, {
    "tStartMs": 79530,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Some are, in fact, more miserable\nthan they were beforehand."
    } ]
  }, {
    "tStartMs": 82560,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- 'Cause you don't see as many\npeople as you used to see."
    } ]
  }, {
    "tStartMs": 84690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Obviously, you become slightly isolated,"
    } ]
  }, {
    "tStartMs": 87270,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I think in some ways."
    } ]
  }, {
    "tStartMs": 88860,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, I agree."
    } ]
  }, {
    "tStartMs": 89693,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "- Another problem is that\npeople's memories aren't reliable."
    } ]
  }, {
    "tStartMs": 92880,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- We only detect, encode\nand store in our brains"
    } ]
  }, {
    "tStartMs": 96570,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "bits and pieces of the entire\nexperience in front of us."
    } ]
  }, {
    "tStartMs": 99750,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It's called reconstructed memories."
    } ]
  }, {
    "tStartMs": 101790,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It happens to us"
    } ]
  }, {
    "tStartMs": 102990,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "in all the aspects of\nour lives all the time."
    } ]
  }, {
    "tStartMs": 106530,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Most studies on\nhappiness find older people"
    } ]
  }, {
    "tStartMs": 109080,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and ask them to recall\nwhat made them happy."
    } ]
  }, {
    "tStartMs": 111690,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "But as we've just seen,\nmemory is unreliable."
    } ]
  }, {
    "tStartMs": 115590,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So a better way to conduct a study"
    } ]
  }, {
    "tStartMs": 117270,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "would be to follow people\nthroughout their entire lives,"
    } ]
  }, {
    "tStartMs": 120240,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "capturing the choices they make"
    } ]
  }, {
    "tStartMs": 121980,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and how those affect their happiness."
    } ]
  }, {
    "tStartMs": 124800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "That is really hard to do."
    } ]
  }, {
    "tStartMs": 126600,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But there is one study like this"
    } ]
  }, {
    "tStartMs": 128250,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that's been running since 1938."
    } ]
  }, {
    "tStartMs": 131160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now, 85 years is a long\ntime to run a study"
    } ]
  }, {
    "tStartMs": 134280,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "so it has been passed down"
    } ]
  }, {
    "tStartMs": 135600,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "from one generation of\nresearchers to the next."
    } ]
  }, {
    "tStartMs": 138300,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "It's currently run by its fourth\ndirector, Robert Waldinger."
    } ]
  }, {
    "tStartMs": 142170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "What is the claim to\nfame then of the study?"
    } ]
  }, {
    "tStartMs": 144900,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "- You know, the claim\nto fame is that it is,"
    } ]
  }, {
    "tStartMs": 148650,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "as far as we know, the longest\nstudy of human development"
    } ]
  }, {
    "tStartMs": 153420,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that's ever been done."
    } ]
  }, {
    "tStartMs": 154440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The longest study of any depth."
    } ]
  }, {
    "tStartMs": 156360,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "These are studies that take\ndeep dives into people's lives"
    } ]
  }, {
    "tStartMs": 160500,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and their mental and physical health."
    } ]
  }, {
    "tStartMs": 163110,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] The study actually\nbegan as two separate studies"
    } ]
  }, {
    "tStartMs": 165540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "by two groups of Harvard researchers"
    } ]
  }, {
    "tStartMs": 167670,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that didn't know about each other."
    } ]
  }, {
    "tStartMs": 170010,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The first group followed\n268 young men from Harvard"
    } ]
  }, {
    "tStartMs": 173010,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "to find out how they would\ndevelop into early adulthood."
    } ]
  }, {
    "tStartMs": 176100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So of course,"
    } ]
  }, {
    "tStartMs": 176933,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "if you wanna study normal\nyoung adult development,"
    } ]
  }, {
    "tStartMs": 179160,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "you study all white guys\nfrom Harvard, right?"
    } ]
  }, {
    "tStartMs": 180953,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Derek laughs)"
    } ]
  }, {
    "tStartMs": 181786,
    "dDurationMs": 2954,
    "segs": [ {
      "utf8": "You know, it's one of those limitations."
    } ]
  }, {
    "tStartMs": 184740,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Derek] The second\ngroup studied 456 boys"
    } ]
  }, {
    "tStartMs": 187200,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "from middle school onwards"
    } ]
  }, {
    "tStartMs": 188520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "from Boston's poorest and\nmost disadvantaged families."
    } ]
  }, {
    "tStartMs": 191640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- So there were these two studies,"
    } ]
  }, {
    "tStartMs": 192960,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "both meant to be studies of\nwhat goes right in development"
    } ]
  }, {
    "tStartMs": 197580,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "and how we predict who\ndoes well as they grow up."
    } ]
  }, {
    "tStartMs": 202080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Eventually, the two\nstudies merged into one:"
    } ]
  }, {
    "tStartMs": 204960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The Harvard Study of Adult Development."
    } ]
  }, {
    "tStartMs": 207540,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "At the start of the study, the\nparticipants were interviewed"
    } ]
  }, {
    "tStartMs": 209970,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and received extensive\nphysical examinations."
    } ]
  }, {
    "tStartMs": 212970,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And as they grew, they\nentered all walks of life."
    } ]
  }, {
    "tStartMs": 216090,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Some of them became\nbricklayers and doctors"
    } ]
  }, {
    "tStartMs": 218640,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and factory workers and lawyers,"
    } ]
  }, {
    "tStartMs": 220650,
    "dDurationMs": 3647,
    "segs": [ {
      "utf8": "and one even became president\nof the United States."
    } ]
  }, {
    "tStartMs": 224297,
    "dDurationMs": 1693,
    "segs": [ {
      "utf8": "(presidential music)"
    } ]
  }, {
    "tStartMs": 225990,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Every two years, researchers\nask them questions"
    } ]
  }, {
    "tStartMs": 228630,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "about their lives."
    } ]
  }, {
    "tStartMs": 229470,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Like, \"If you could stop\nworking without loss of income,"
    } ]
  }, {
    "tStartMs": 232440,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "would you, what would you do instead?"
    } ]
  }, {
    "tStartMs": 235050,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "How often do you feel\nisolated from others?"
    } ]
  }, {
    "tStartMs": 238230,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "True or false, life has\nmore pain than pleasure.\""
    } ]
  }, {
    "tStartMs": 241800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And other questions about their marriage,"
    } ]
  }, {
    "tStartMs": 243600,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "career, friendships, and their\nphysical and mental health."
    } ]
  }, {
    "tStartMs": 247380,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "While the study started\nwith just 724 participants,"
    } ]
  }, {
    "tStartMs": 250620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "over time, their spouses and children"
    } ]
  }, {
    "tStartMs": 252960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "were also included in the study."
    } ]
  }, {
    "tStartMs": 255210,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So how many people are\nwe talking about in total"
    } ]
  }, {
    "tStartMs": 258690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "who have been part of the study?"
    } ]
  }, {
    "tStartMs": 260340,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- Between 2,500 and 3,000\npeople altogether in the study."
    } ]
  }, {
    "tStartMs": 266070,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] And as technology improved,"
    } ]
  }, {
    "tStartMs": 267570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "so did the methods of data collection."
    } ]
  }, {
    "tStartMs": 269700,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- We now draw blood from DNA."
    } ]
  }, {
    "tStartMs": 272370,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "You know, DNA wasn't\neven imagined in 1938."
    } ]
  }, {
    "tStartMs": 275737,
    "dDurationMs": 4943,
    "segs": [ {
      "utf8": "We measure messenger RNA, DNA methylation,"
    } ]
  }, {
    "tStartMs": 280680,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we bring people into our laboratory,"
    } ]
  }, {
    "tStartMs": 283200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "we deliberately stress them out"
    } ]
  }, {
    "tStartMs": 285240,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and then see how quickly\nthey recover from stress."
    } ]
  }, {
    "tStartMs": 288810,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Looking at heart rate\nvariability, for example,"
    } ]
  }, {
    "tStartMs": 292380,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "looking at cortisol deposited in hair,"
    } ]
  }, {
    "tStartMs": 296790,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "because that seems to\nbe a long-term measure"
    } ]
  }, {
    "tStartMs": 299310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "of circulating cortisol."
    } ]
  }, {
    "tStartMs": 300930,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But all of these new\nmethods are in the service"
    } ]
  }, {
    "tStartMs": 304470,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "of studying the same big phenomena"
    } ]
  }, {
    "tStartMs": 308910,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "of human wellbeing."
    } ]
  }, {
    "tStartMs": 312180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- So what do 85 years of research"
    } ]
  }, {
    "tStartMs": 314250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "across entire human lives teach us"
    } ]
  }, {
    "tStartMs": 316380,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "about a healthy and happy life?"
    } ]
  }, {
    "tStartMs": 318750,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- Two huge takeaways really."
    } ]
  }, {
    "tStartMs": 321120,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "One is no surprise."
    } ]
  }, {
    "tStartMs": 322920,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "It's that if you take care\nof your physical health,"
    } ]
  }, {
    "tStartMs": 325950,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "it has huge benefits, not\njust for your longevity,"
    } ]
  }, {
    "tStartMs": 330300,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but for how long you stay healthy."
    } ]
  }, {
    "tStartMs": 332220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Eating well, getting regular exercise,"
    } ]
  }, {
    "tStartMs": 335250,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "not abusing alcohol or drugs, not smoking,"
    } ]
  }, {
    "tStartMs": 338730,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "getting preventive healthcare,"
    } ]
  }, {
    "tStartMs": 340950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "exercise is hugely important."
    } ]
  }, {
    "tStartMs": 343830,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Derek] A Taiwanese study\nlooked at the medical data"
    } ]
  }, {
    "tStartMs": 345870,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "of 416,000 healthy people\nbetween 1996 and 2008."
    } ]
  }, {
    "tStartMs": 350700,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Eight years later, they\nfollowed up with each person"
    } ]
  }, {
    "tStartMs": 352710,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to look at the link between\nexercise and mortality."
    } ]
  }, {
    "tStartMs": 355680,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "They found that people who\nexercised just 15 minutes a day"
    } ]
  }, {
    "tStartMs": 358890,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "had a 14% reduced risk of dying,"
    } ]
  }, {
    "tStartMs": 361470,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and a three year longer life expectancy."
    } ]
  }, {
    "tStartMs": 364410,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Every additional 15 minutes of exercise"
    } ]
  }, {
    "tStartMs": 366480,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "decreased the risk of\ndying by an extra 4%."
    } ]
  }, {
    "tStartMs": 369780,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "A large meta-analysis from 2008 confirms"
    } ]
  }, {
    "tStartMs": 372420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that people who are physically active"
    } ]
  }, {
    "tStartMs": 373980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "have a reduced risk of dying"
    } ]
  }, {
    "tStartMs": 375630,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "during the timeframes\ninvestigated in each study."
    } ]
  }, {
    "tStartMs": 379380,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Exercise also protects\nour cognitive health."
    } ]
  }, {
    "tStartMs": 382290,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "A meta-analysis from 2014 found"
    } ]
  }, {
    "tStartMs": 384360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that participants with higher\nlevels of physical activity"
    } ]
  }, {
    "tStartMs": 386760,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "had a 35% reduced risk\nof cognitive decline"
    } ]
  }, {
    "tStartMs": 389880,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "and a 14% reduced risk of dementia."
    } ]
  }, {
    "tStartMs": 394080,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "- And then the big surprising\nfinding is, relationships,"
    } ]
  }, {
    "tStartMs": 398430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "not just keeping us happier,"
    } ]
  }, {
    "tStartMs": 400530,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "but keeping us healthier\nand helping us live longer."
    } ]
  }, {
    "tStartMs": 404910,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- It's not just the Harvard study."
    } ]
  }, {
    "tStartMs": 406410,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "There's now a whole list of studies"
    } ]
  }, {
    "tStartMs": 408120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that show the importance of relationships"
    } ]
  }, {
    "tStartMs": 409770,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to human happiness and health."
    } ]
  }, {
    "tStartMs": 411720,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "They teach us three main lessons."
    } ]
  }, {
    "tStartMs": 414690,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "The first is that relationships\nare great for our health."
    } ]
  }, {
    "tStartMs": 419010,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "In 2010, researchers\nlooked across 148 studies"
    } ]
  }, {
    "tStartMs": 422250,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "with a total of more than\n300,000 participants."
    } ]
  }, {
    "tStartMs": 425610,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "They found that, on average,"
    } ]
  }, {
    "tStartMs": 426690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "people with stronger social connections"
    } ]
  }, {
    "tStartMs": 428730,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "had a 50% increased likelihood of survival"
    } ]
  }, {
    "tStartMs": 431580,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "for any given year."
    } ]
  }, {
    "tStartMs": 433020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Being married, in particular,"
    } ]
  }, {
    "tStartMs": 434640,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "has a large impact on\nhow long people live."
    } ]
  }, {
    "tStartMs": 437250,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "- There's one study, I think\nit's pretty well respected,"
    } ]
  }, {
    "tStartMs": 441930,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that suggests that married men"
    } ]
  }, {
    "tStartMs": 443790,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "live 12 years longer on\naverage than unmarried men"
    } ]
  }, {
    "tStartMs": 448530,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "and married women live seven\nyears longer on average"
    } ]
  }, {
    "tStartMs": 453390,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "than unmarried women."
    } ]
  }, {
    "tStartMs": 454890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Marriage is always a better\ndeal for men on all parameters"
    } ]
  }, {
    "tStartMs": 458010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "than it is for women.\n(Derek laughs)"
    } ]
  }, {
    "tStartMs": 459480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And it's not because you have\na marriage license, right?"
    } ]
  }, {
    "tStartMs": 461940,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It's because people living together"
    } ]
  }, {
    "tStartMs": 465000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "in an intimate partnership"
    } ]
  }, {
    "tStartMs": 467220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "tend to keep each other healthier."
    } ]
  }, {
    "tStartMs": 469560,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "You have somebody who's kind of watching,"
    } ]
  }, {
    "tStartMs": 472350,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "looking out for you."
    } ]
  }, {
    "tStartMs": 473730,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "It's a very real, concrete effect."
    } ]
  }, {
    "tStartMs": 477210,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- If feeling well-connected to others"
    } ]
  }, {
    "tStartMs": 478920,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "makes us happier, healthier,\nand extends our lives,"
    } ]
  }, {
    "tStartMs": 482340,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "then what happens if we feel disconnected?"
    } ]
  }, {
    "tStartMs": 485190,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- There's a researcher,\nJulianne Holt-Lunstad,"
    } ]
  }, {
    "tStartMs": 487950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "out of the University of Utah,"
    } ]
  }, {
    "tStartMs": 490110,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "who did a meta-analysis\nof a whole slew of studies"
    } ]
  }, {
    "tStartMs": 495240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of the physical effects of loneliness."
    } ]
  }, {
    "tStartMs": 498480,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "And her calculation was that being lonely"
    } ]
  }, {
    "tStartMs": 502770,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "is as dangerous to your health"
    } ]
  }, {
    "tStartMs": 504360,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "as smoking half a pack\nof cigarettes a day,"
    } ]
  }, {
    "tStartMs": 508260,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "or as dangerous as being obese."
    } ]
  }, {
    "tStartMs": 511410,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] Feeling disconnected from others"
    } ]
  }, {
    "tStartMs": 513000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "also makes you more prone to disease."
    } ]
  }, {
    "tStartMs": 515190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "A large meta-analysis from 2016"
    } ]
  }, {
    "tStartMs": 517440,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "found that poor social relationships"
    } ]
  }, {
    "tStartMs": 519630,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "were associated with a 29%\nincrease in risk of heart disease"
    } ]
  }, {
    "tStartMs": 523080,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and a 32% increase in risk of stroke."
    } ]
  }, {
    "tStartMs": 526800,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "- So these have real sort\nof quantifiable consequences"
    } ]
  }, {
    "tStartMs": 531270,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "when we look at studies\nof thousands of people."
    } ]
  }, {
    "tStartMs": 535080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- One caveat is that most studies"
    } ]
  }, {
    "tStartMs": 537060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "on the health effects of loneliness"
    } ]
  }, {
    "tStartMs": 538770,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "focus on people aged 50 and older."
    } ]
  }, {
    "tStartMs": 541360,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "(clock ticking)"
    } ]
  }, {
    "tStartMs": 542760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And loneliness is on the rise."
    } ]
  }, {
    "tStartMs": 544950,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- The U.S. Surgeon General today"
    } ]
  }, {
    "tStartMs": 546570,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "declared a new public\nhealth epidemic in America."
    } ]
  }, {
    "tStartMs": 550080,
    "dDurationMs": 993,
    "segs": [ {
      "utf8": "Loneliness."
    } ]
  }, {
    "tStartMs": 552030,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- We're now finding that one in two adults"
    } ]
  }, {
    "tStartMs": 554460,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "report measurable levels of loneliness"
    } ]
  }, {
    "tStartMs": 556440,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it turns out that young\npeople are most affected."
    } ]
  }, {
    "tStartMs": 559860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And here's why this is so concerning."
    } ]
  }, {
    "tStartMs": 562080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's because we've realized"
    } ]
  }, {
    "tStartMs": 563280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that loneliness is more\nthan just a bad feeling."
    } ]
  }, {
    "tStartMs": 565440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It has real consequences"
    } ]
  }, {
    "tStartMs": 566820,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "for our mental and physical health."
    } ]
  }, {
    "tStartMs": 568770,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "- The UK has appointed a\nminister of loneliness."
    } ]
  }, {
    "tStartMs": 572910,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Many, many countries are concerned"
    } ]
  }, {
    "tStartMs": 575820,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "about this breakdown in social connection."
    } ]
  }, {
    "tStartMs": 579210,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- A question about loneliness,"
    } ]
  }, {
    "tStartMs": 582330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "like, what does that look like?"
    } ]
  }, {
    "tStartMs": 584370,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Because, obviously, everyone experiences"
    } ]
  }, {
    "tStartMs": 585900,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "some periods of loneliness."
    } ]
  }, {
    "tStartMs": 587070,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So you know, when does it become\nsort of really detrimental"
    } ]
  }, {
    "tStartMs": 591390,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and how do we define that?"
    } ]
  }, {
    "tStartMs": 592770,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- Well, loneliness is different\nfrom being alone, right?"
    } ]
  }, {
    "tStartMs": 595710,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So you can be alone and quite content,"
    } ]
  }, {
    "tStartMs": 599520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and many people are, in fact."
    } ]
  }, {
    "tStartMs": 601320,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The ability to be\ncontent when you're alone"
    } ]
  }, {
    "tStartMs": 603600,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "is quite a skill and\nit's a wonderful ability."
    } ]
  }, {
    "tStartMs": 607170,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Loneliness is that subjective experience"
    } ]
  }, {
    "tStartMs": 610470,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "of being less connected to\npeople than you wanna be."
    } ]
  }, {
    "tStartMs": 614520,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And that's why, you know,\nyou can be lonely in a crowd."
    } ]
  }, {
    "tStartMs": 617730,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "We're all on a spectrum\nbetween extroversion,"
    } ]
  }, {
    "tStartMs": 623070,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "you know, wanting lots\nof people in our lives,"
    } ]
  }, {
    "tStartMs": 625290,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and introversion, actually\nneeding a lot of solitude"
    } ]
  }, {
    "tStartMs": 629250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and not wanting a lot of people,"
    } ]
  }, {
    "tStartMs": 631560,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "a lot of people are\nstressful for introverts."
    } ]
  }, {
    "tStartMs": 634410,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And what we know is that\nneither one is healthier, right?"
    } ]
  }, {
    "tStartMs": 638550,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Like introverts are perfectly healthy."
    } ]
  }, {
    "tStartMs": 641160,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "They just may need one or two\nreally solid relationships"
    } ]
  }, {
    "tStartMs": 645150,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and don't want a lot more people."
    } ]
  }, {
    "tStartMs": 647340,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Nothing wrong with that at all."
    } ]
  }, {
    "tStartMs": 649470,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Whereas extroverts may want\nlots of people in their lives."
    } ]
  }, {
    "tStartMs": 652440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Derek] So the second lesson is"
    } ]
  }, {
    "tStartMs": 653820,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that it's not how many\npeople you know or see,"
    } ]
  }, {
    "tStartMs": 656520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "or even whether you're married or not,"
    } ]
  }, {
    "tStartMs": 657960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "because a bad marriage can be worse"
    } ]
  }, {
    "tStartMs": 659400,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "for your health than getting divorced."
    } ]
  }, {
    "tStartMs": 661260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Instead, it's about the quality"
    } ]
  }, {
    "tStartMs": 662880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "of your close relationships that matters."
    } ]
  }, {
    "tStartMs": 665700,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- When we'd followed\nall the original people"
    } ]
  }, {
    "tStartMs": 668850,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "out to their 80s we said,"
    } ]
  }, {
    "tStartMs": 670987,
    "dDurationMs": 4853,
    "segs": [ {
      "utf8": "\"Okay, what data actually\nare the best predictors"
    } ]
  }, {
    "tStartMs": 675840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "at age 50 of who's gonna be happy"
    } ]
  }, {
    "tStartMs": 677670,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "and healthy at age 80 as\nopposed to sick or dead?\""
    } ]
  }, {
    "tStartMs": 681600,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And we thought we were gonna be looking"
    } ]
  }, {
    "tStartMs": 683430,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "at blood pressure and\ncholesterol level at age 50"
    } ]
  }, {
    "tStartMs": 686520,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "as the strongest predictors."
    } ]
  }, {
    "tStartMs": 688470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It was their relationships."
    } ]
  }, {
    "tStartMs": 690270,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "It was particularly their satisfaction"
    } ]
  }, {
    "tStartMs": 694350,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "with their marital relationships"
    } ]
  }, {
    "tStartMs": 696840,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "that was the strongest predictor."
    } ]
  }, {
    "tStartMs": 699540,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- And relationships don't\njust keep us happier"
    } ]
  }, {
    "tStartMs": 701640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and physically healthier,"
    } ]
  }, {
    "tStartMs": 702840,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "they also protect our brains."
    } ]
  }, {
    "tStartMs": 704940,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "People who are in secure\nrelationships in their 80s,"
    } ]
  }, {
    "tStartMs": 707610,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "where they feel that they\ncan rely on the other person,"
    } ]
  }, {
    "tStartMs": 710220,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "find that their memories\nstay sharper for longer."
    } ]
  }, {
    "tStartMs": 713130,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And people who feel lonely,"
    } ]
  }, {
    "tStartMs": 714720,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "well, their memories fade quicker."
    } ]
  }, {
    "tStartMs": 718260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "A study of retired U.S. adults found"
    } ]
  }, {
    "tStartMs": 720300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that the rate of cognitive decline"
    } ]
  }, {
    "tStartMs": 721620,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "was 20% higher over 10 years\nfor those who felt lonely."
    } ]
  }, {
    "tStartMs": 725790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "A meta-analysis from 2018 further confirms"
    } ]
  }, {
    "tStartMs": 728400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the detrimental effects of loneliness,"
    } ]
  }, {
    "tStartMs": 730440,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "finding that it also increased\nthe risk of dementia."
    } ]
  }, {
    "tStartMs": 734250,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "But there's still a big open question:"
    } ]
  }, {
    "tStartMs": 737070,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "what is it about the relationships"
    } ]
  }, {
    "tStartMs": 739050,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "that makes them particularly\nhealthful or helpful?"
    } ]
  }, {
    "tStartMs": 744000,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- The best hypothesis,"
    } ]
  }, {
    "tStartMs": 745740,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "for which there's some\npretty decent research now,"
    } ]
  }, {
    "tStartMs": 749610,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "is that relationships\nare emotion regulators."
    } ]
  }, {
    "tStartMs": 753870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They're stress regulators."
    } ]
  }, {
    "tStartMs": 755790,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "So stressful things happen every day"
    } ]
  }, {
    "tStartMs": 759840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to many of us, right?"
    } ]
  }, {
    "tStartMs": 761520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So then what happens?"
    } ]
  }, {
    "tStartMs": 763440,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Well, the body goes into\nfight-or-flight mode,"
    } ]
  }, {
    "tStartMs": 766050,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "blood pressure goes up,"
    } ]
  }, {
    "tStartMs": 767910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "respirations become more rapid,"
    } ]
  }, {
    "tStartMs": 770070,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "circulating stress hormone levels rise."
    } ]
  }, {
    "tStartMs": 773010,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But then the body is meant\nto go back to equilibrium"
    } ]
  }, {
    "tStartMs": 776040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "after that normal fight-or-flight response"
    } ]
  }, {
    "tStartMs": 778620,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "when we face a challenge."
    } ]
  }, {
    "tStartMs": 780810,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "If I can come home and there's\nsomebody here to talk to,"
    } ]
  }, {
    "tStartMs": 784080,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "I can literally feel my body calm down."
    } ]
  }, {
    "tStartMs": 787950,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "What we are pretty sure happens"
    } ]
  }, {
    "tStartMs": 789870,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "is that people who are isolated,\nthat they're more likely"
    } ]
  }, {
    "tStartMs": 793080,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "to stay in a kind of chronic\nfight-or-flight mode."
    } ]
  }, {
    "tStartMs": 797580,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And that what that means is"
    } ]
  }, {
    "tStartMs": 799140,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "that they have higher levels\nof circulating cortisol,"
    } ]
  }, {
    "tStartMs": 802770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "higher levels of chronic inflammation,"
    } ]
  }, {
    "tStartMs": 805170,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and that those things gradually\nwear away body systems."
    } ]
  }, {
    "tStartMs": 810540,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So that's how, for example,"
    } ]
  }, {
    "tStartMs": 814020,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "chronic stress can predict\ncoronary artery disease,"
    } ]
  }, {
    "tStartMs": 819030,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "but also arthritis and\nalso type-two diabetes"
    } ]
  }, {
    "tStartMs": 823320,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "because of this common mechanism"
    } ]
  }, {
    "tStartMs": 826320,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that breaks down multiple body systems."
    } ]
  }, {
    "tStartMs": 829620,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- The key to preventing\nthis breakdown is simple."
    } ]
  }, {
    "tStartMs": 832410,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Just spend a little more time"
    } ]
  }, {
    "tStartMs": 833940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with the people you care about."
    } ]
  }, {
    "tStartMs": 835860,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Unfortunately, we seem to\nbe doing the exact opposite."
    } ]
  }, {
    "tStartMs": 839370,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Before going into why we're\ndoing the exact opposite,"
    } ]
  }, {
    "tStartMs": 841770,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "this part of the video was\nsponsored by BetterHelp."
    } ]
  }, {
    "tStartMs": 844590,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "There are many things"
    } ]
  }, {
    "tStartMs": 845700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that can negatively impact our happiness."
    } ]
  }, {
    "tStartMs": 847980,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "It could be stress or fear or\na clinical mental health issue"
    } ]
  }, {
    "tStartMs": 851550,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "like depression or anxiety."
    } ]
  }, {
    "tStartMs": 853470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But regardless of which one it is,"
    } ]
  }, {
    "tStartMs": 855150,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "therapy can help you\nby giving you the tools"
    } ]
  }, {
    "tStartMs": 857100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to approach your life\nin a very different way."
    } ]
  }, {
    "tStartMs": 859140,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And that's where BetterHelp comes in."
    } ]
  }, {
    "tStartMs": 861270,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "They connect you with an\nexperienced, licensed therapist"
    } ]
  }, {
    "tStartMs": 864030,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "who is trained to listen"
    } ]
  }, {
    "tStartMs": 865080,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and give you helpful, unbiased advice."
    } ]
  }, {
    "tStartMs": 867750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I know that finding a\ngood therapist is hard,"
    } ]
  }, {
    "tStartMs": 869880,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "especially when you only have\nthe options in your city."
    } ]
  }, {
    "tStartMs": 872580,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But BetterHelp changes the game on this"
    } ]
  }, {
    "tStartMs": 874830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "because it's an online platform."
    } ]
  }, {
    "tStartMs": 876780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And by filling out a few questions,"
    } ]
  }, {
    "tStartMs": 878430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you'll get matched with\na professional therapist."
    } ]
  }, {
    "tStartMs": 880680,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So you can get talking in\nmost cases within 48 hours"
    } ]
  }, {
    "tStartMs": 884130,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and then you can have your\ntherapy session as a phone call,"
    } ]
  }, {
    "tStartMs": 887400,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "as a video chat, or even via\nmessaging if you prefer that."
    } ]
  }, {
    "tStartMs": 890820,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Just whatever's the\nmost comfortable version"
    } ]
  }, {
    "tStartMs": 893070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "of therapy for you."
    } ]
  }, {
    "tStartMs": 894450,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And it's easy to sign up, there's\na link in the description."
    } ]
  }, {
    "tStartMs": 897270,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It is betterhelp.com/veritasium."
    } ]
  }, {
    "tStartMs": 900510,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Clicking on that link both\nhelps support this channel"
    } ]
  }, {
    "tStartMs": 902850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and it also gets you 10% off\nyour first month of BetterHelp."
    } ]
  }, {
    "tStartMs": 905640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So you can try it out\nand see if it helps you."
    } ]
  }, {
    "tStartMs": 908400,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And if you don't really fit\nwith your first therapist,"
    } ]
  }, {
    "tStartMs": 910740,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "which is pretty common,"
    } ]
  }, {
    "tStartMs": 911820,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "you can easily switch\nto a new one for free"
    } ]
  }, {
    "tStartMs": 913740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "without stressing about insurance,"
    } ]
  }, {
    "tStartMs": 915300,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "who's in your network\nor anything like that."
    } ]
  }, {
    "tStartMs": 917880,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If you feel like you could\nbenefit from talking to someone,"
    } ]
  }, {
    "tStartMs": 920160,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "getting feedback, advice,\nand help for anything"
    } ]
  }, {
    "tStartMs": 923310,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that might be affecting your\nhappiness and progress in life,"
    } ]
  }, {
    "tStartMs": 925950,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "then visit betterhelp.com/veritasium"
    } ]
  }, {
    "tStartMs": 928170,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or click that link in\nthe description below."
    } ]
  }, {
    "tStartMs": 930360,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "So I want to thank BetterHelp"
    } ]
  }, {
    "tStartMs": 931380,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "for sponsoring this part of the video."
    } ]
  }, {
    "tStartMs": 933000,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "And now, back to the\nimportance of relationships."
    } ]
  }, {
    "tStartMs": 937110,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "There is an alarming trend in our society."
    } ]
  }, {
    "tStartMs": 940170,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Newsreader] Social engagement\nwith friends decreased"
    } ]
  }, {
    "tStartMs": 942660,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "from 60 minutes a day in 2003"
    } ]
  }, {
    "tStartMs": 944880,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to just 20 minutes a day in 2020."
    } ]
  }, {
    "tStartMs": 948150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- The technology has fundamentally changed"
    } ]
  }, {
    "tStartMs": 950820,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "how we interact with one another"
    } ]
  }, {
    "tStartMs": 952710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and how we communicate with one another"
    } ]
  }, {
    "tStartMs": 954330,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and, unfortunately, has often replaced"
    } ]
  }, {
    "tStartMs": 956190,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "what used to be rich in-person connections"
    } ]
  }, {
    "tStartMs": 959310,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "with online connections, which\noften are of lower quality."
    } ]
  }, {
    "tStartMs": 963210,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- Now, you may say you're an introvert"
    } ]
  }, {
    "tStartMs": 965280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and you don't need to\nspend much time with people"
    } ]
  }, {
    "tStartMs": 967320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to feel good."
    } ]
  }, {
    "tStartMs": 968520,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And while it's true that\nintroverts and extroverts"
    } ]
  }, {
    "tStartMs": 971070,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "need different amounts\nof social stimulation,"
    } ]
  }, {
    "tStartMs": 973680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "both need human connection."
    } ]
  }, {
    "tStartMs": 975930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "In 2015, Holt-Lunstad and her colleagues"
    } ]
  }, {
    "tStartMs": 978450,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "looked at the data of\n70 independent studies"
    } ]
  }, {
    "tStartMs": 980940,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "with more than 3 million\ntotal participants."
    } ]
  }, {
    "tStartMs": 983970,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Similar to other studies,"
    } ]
  }, {
    "tStartMs": 985110,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "they found that the subjective\nfeeling of loneliness"
    } ]
  }, {
    "tStartMs": 987390,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "increased the risk of\npremature death by 26%."
    } ]
  }, {
    "tStartMs": 990990,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "But they also looked at"
    } ]
  }, {
    "tStartMs": 992010,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the objective measure of social isolation,"
    } ]
  }, {
    "tStartMs": 994230,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "how much time you're actually\nspending with other people."
    } ]
  }, {
    "tStartMs": 997170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And they found that social isolation"
    } ]
  }, {
    "tStartMs": 999090,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "increased the risk of\npremature death by 29%."
    } ]
  }, {
    "tStartMs": 1002480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And unfortunately,\nintroverts are more at risk"
    } ]
  }, {
    "tStartMs": 1005480,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "of being socially isolated."
    } ]
  }, {
    "tStartMs": 1009020,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Just like many young people today,"
    } ]
  }, {
    "tStartMs": 1010880,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "many participants from the Harvard study"
    } ]
  }, {
    "tStartMs": 1012620,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "also believed that money and achievement"
    } ]
  }, {
    "tStartMs": 1014570,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "were what they should go\nafter to have a good life."
    } ]
  }, {
    "tStartMs": 1017150,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But what this study and\nplenty of others show"
    } ]
  }, {
    "tStartMs": 1019550,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "is that the people who were the happiest"
    } ]
  }, {
    "tStartMs": 1021260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "were those that leaned\ninto their relationships"
    } ]
  }, {
    "tStartMs": 1023750,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "with their partner, friends,\nfamily, and community."
    } ]
  }, {
    "tStartMs": 1026720,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And when they were in their 80s"
    } ]
  }, {
    "tStartMs": 1028280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the researchers asked them,\nwhat are you most proud of"
    } ]
  }, {
    "tStartMs": 1031280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and what is your biggest regret?"
    } ]
  }, {
    "tStartMs": 1033530,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "- Many people said that they were proudest"
    } ]
  }, {
    "tStartMs": 1037070,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "of something to do with\ntheir relationships."
    } ]
  }, {
    "tStartMs": 1039920,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So it could be, \"I was a good\nboss, I was a good parent,"
    } ]
  }, {
    "tStartMs": 1045050,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I was a good friend, I was a good mentor.\""
    } ]
  }, {
    "tStartMs": 1047330,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Nobody said, \"I made a fortune,\" right?"
    } ]
  }, {
    "tStartMs": 1050960,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Nobody even said, you know,\n\"I won the Nobel Prize,\""
    } ]
  }, {
    "tStartMs": 1053930,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "which a few people did."
    } ]
  }, {
    "tStartMs": 1055400,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "It wasn't about those badges\nof achievement, right,"
    } ]
  }, {
    "tStartMs": 1059060,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that we think of as, \"Oh,\nthat's what we gotta get"
    } ]
  }, {
    "tStartMs": 1061520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to feel like we've had a meaningful life.\""
    } ]
  }, {
    "tStartMs": 1063830,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Everybody looking back\nmentioned their relationships."
    } ]
  }, {
    "tStartMs": 1067850,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "The biggest regret was\nparticularly among the men,"
    } ]
  }, {
    "tStartMs": 1071600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "'cause this was the\nWorld War II generation."
    } ]
  }, {
    "tStartMs": 1074690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "They said, \"I wish I hadn't\nspent so much time at work,"
    } ]
  }, {
    "tStartMs": 1077570,
    "dDurationMs": 4017,
    "segs": [ {
      "utf8": "I wish I had spent more time\nwith the people I care about.\""
    } ]
  }, {
    "tStartMs": 1082640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- So what about our original question?"
    } ]
  }, {
    "tStartMs": 1084950,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Do achievements and money\nreally make us happy?"
    } ]
  }, {
    "tStartMs": 1088010,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Well, according to the Harvard study,"
    } ]
  }, {
    "tStartMs": 1089840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "badges of achievement do not\nnecessarily make us happier,"
    } ]
  }, {
    "tStartMs": 1093200,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but doing meaningful work can."
    } ]
  }, {
    "tStartMs": 1096050,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "And what about money?\nDoes that make us happier?"
    } ]
  }, {
    "tStartMs": 1098640,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Well, there's a famous study from 2010"
    } ]
  }, {
    "tStartMs": 1100610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "by Daniel Kahneman and Angus Deaton"
    } ]
  }, {
    "tStartMs": 1102410,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "that found that above an income\nof around $75,000 a year,"
    } ]
  }, {
    "tStartMs": 1106100,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "there is no improvement whatever"
    } ]
  }, {
    "tStartMs": 1108110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in the measures of emotional wellbeing."
    } ]
  }, {
    "tStartMs": 1110510,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "But 11 years later,"
    } ]
  }, {
    "tStartMs": 1111560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Matthew Killingsworth studied data"
    } ]
  }, {
    "tStartMs": 1113120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "on 33,000 employed U.S. adults"
    } ]
  }, {
    "tStartMs": 1116000,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and he found that higher incomes"
    } ]
  }, {
    "tStartMs": 1117530,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "corresponded to higher\nlevels of wellbeing."
    } ]
  }, {
    "tStartMs": 1120530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So he wrote, \"There was no evidence"
    } ]
  }, {
    "tStartMs": 1122450,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "for an experienced wellbeing\nplateau above $75,000 a year,"
    } ]
  }, {
    "tStartMs": 1126260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "contrary to some\ninfluential past research.\""
    } ]
  }, {
    "tStartMs": 1129080,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In 2022, Kahneman and\nKillingsworth set out"
    } ]
  }, {
    "tStartMs": 1131720,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "to resolve the conflict with\nBarbara Mellers as a mediator."
    } ]
  }, {
    "tStartMs": 1135170,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "When they analyzed Killingsworth's data,"
    } ]
  }, {
    "tStartMs": 1137480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they discovered an interesting pattern,"
    } ]
  }, {
    "tStartMs": 1139730,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "depending on how happy people\nwere relative to others,"
    } ]
  }, {
    "tStartMs": 1142880,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "earning more resulted in\ndifferent increases in happiness."
    } ]
  }, {
    "tStartMs": 1146570,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "For each income level,"
    } ]
  }, {
    "tStartMs": 1147800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "they divided people into groups\nbased on their happiness,"
    } ]
  }, {
    "tStartMs": 1150380,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "low, medium, high, and so on."
    } ]
  }, {
    "tStartMs": 1152690,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And they found that below a threshold"
    } ]
  }, {
    "tStartMs": 1154400,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "of roughly a hundred\nthousand dollars a year,"
    } ]
  }, {
    "tStartMs": 1156590,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "a higher income was associated"
    } ]
  }, {
    "tStartMs": 1158600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "with more happiness for all groups."
    } ]
  }, {
    "tStartMs": 1161060,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But if you go above that threshold,"
    } ]
  }, {
    "tStartMs": 1162740,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "then for the unhappiest group,"
    } ]
  }, {
    "tStartMs": 1164450,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "a further increase is not\nassociated with more happiness."
    } ]
  }, {
    "tStartMs": 1168140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "However, for all the happier groups,"
    } ]
  }, {
    "tStartMs": 1170000,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "higher incomes do seem to\nlead to more happiness."
    } ]
  }, {
    "tStartMs": 1173180,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "And the real twist is"
    } ]
  }, {
    "tStartMs": 1174170,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that those who are the\nhappiest to start with"
    } ]
  }, {
    "tStartMs": 1176330,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "stand to gain the most\nwith increasing income."
    } ]
  }, {
    "tStartMs": 1180830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Relationships, meaningful work,"
    } ]
  }, {
    "tStartMs": 1182540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and money all play a\nrole in our happiness."
    } ]
  }, {
    "tStartMs": 1185210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So why can it be so hard"
    } ]
  }, {
    "tStartMs": 1187070,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to realize just how\nimportant relationships are?"
    } ]
  }, {
    "tStartMs": 1190340,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- You know, if you think about it,"
    } ]
  }, {
    "tStartMs": 1191240,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "relationships have been there"
    } ]
  }, {
    "tStartMs": 1192830,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "since before we have memory, right?"
    } ]
  }, {
    "tStartMs": 1196220,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So they're like the air we breathe,"
    } ]
  }, {
    "tStartMs": 1197900,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "we take 'em for granted."
    } ]
  }, {
    "tStartMs": 1199700,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "So you don't think about that\nas something you cultivate"
    } ]
  }, {
    "tStartMs": 1203390,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "in order to make yourself happy."
    } ]
  }, {
    "tStartMs": 1206840,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "We don't think about that at all."
    } ]
  }, {
    "tStartMs": 1208400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And yet, when we study it scientifically,"
    } ]
  }, {
    "tStartMs": 1211040,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "we find that that turns out\nto be an enormous predictor"
    } ]
  }, {
    "tStartMs": 1215420,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "of happiness as well as physical health."
    } ]
  }, {
    "tStartMs": 1219410,
    "dDurationMs": 2139,
    "segs": [ {
      "utf8": "- What's gonna make you happy?"
    } ]
  }, {
    "tStartMs": 1221549,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Um.\n- Uh."
    } ]
  }, {
    "tStartMs": 1222382,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Uh.\n- Uh."
    } ]
  }, {
    "tStartMs": 1223215,
    "dDurationMs": 905,
    "segs": [ {
      "utf8": "- Um.\n- Uh."
    } ]
  }, {
    "tStartMs": 1224120,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- Being wealthy is definitely\na big aspect of it."
    } ]
  }, {
    "tStartMs": 1227060,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But that loving family is kind\nof like the foundation of it."
    } ]
  }, {
    "tStartMs": 1230840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You know what I mean?\n- Realistically, money."
    } ]
  }, {
    "tStartMs": 1233000,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "But like building deep connections"
    } ]
  }, {
    "tStartMs": 1234560,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "with people are what's going"
    } ]
  }, {
    "tStartMs": 1236570,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to make me happy.\n- [Derek] That's awesome."
    } ]
  }, {
    "tStartMs": 1238130,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- Having like good\nrelationships with other people."
    } ]
  }, {
    "tStartMs": 1240140,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- You raise a family."
    } ]
  }, {
    "tStartMs": 1240973,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "- Have a family and provide."
    } ]
  }, {
    "tStartMs": 1242270,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Friends and family."
    } ]
  }, {
    "tStartMs": 1243530,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Seeing my family happy,\nthat's all I really care about."
    } ]
  }, {
    "tStartMs": 1245750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- Giving back to the community"
    } ]
  }, {
    "tStartMs": 1248180,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "where you came from, the world."
    } ]
  }, {
    "tStartMs": 1249770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- A strong family base just\nto come home to every night."
    } ]
  }, {
    "tStartMs": 1252170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- Yeah. I wanna get\nmarried, have a ton of kids."
    } ]
  }, {
    "tStartMs": 1254690,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I want to-\n- How many is a ton?"
    } ]
  }, {
    "tStartMs": 1256550,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Probably like five-ish, six."
    } ]
  }, {
    "tStartMs": 1257960,
    "dDurationMs": 1871,
    "segs": [ {
      "utf8": "- That's a-\n- As many as I can afford."
    } ]
  }, {
    "tStartMs": 1259831,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "(Derek laughs)\nSo."
    } ]
  }, {
    "tStartMs": 1261200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- In fact, when I interviewed people,"
    } ]
  }, {
    "tStartMs": 1263240,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "I was pleasantly surprised"
    } ]
  }, {
    "tStartMs": 1264530,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "to see how many identified the\nimportance of relationships."
    } ]
  }, {
    "tStartMs": 1268790,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So if you could give people advice"
    } ]
  }, {
    "tStartMs": 1271190,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "on what to start doing today\nto start being happier,"
    } ]
  }, {
    "tStartMs": 1275630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "what suggestions would you make?"
    } ]
  }, {
    "tStartMs": 1277610,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- To think about it as\nanalogous with physical fitness,"
    } ]
  }, {
    "tStartMs": 1280880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "if you go out today, you don't come home"
    } ]
  }, {
    "tStartMs": 1283640,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and say, \"I'm done."
    } ]
  }, {
    "tStartMs": 1285110,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I don't ever have to\ndo that again,\" right?"
    } ]
  }, {
    "tStartMs": 1287630,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "It's like a practice, right?"
    } ]
  }, {
    "tStartMs": 1290000,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "That the people who were\nbest at relationships"
    } ]
  }, {
    "tStartMs": 1293480,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "were the people who made it a practice"
    } ]
  }, {
    "tStartMs": 1296570,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "day after day, week after week,"
    } ]
  }, {
    "tStartMs": 1298520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to stay connected to the\npeople they cared about."
    } ]
  }, {
    "tStartMs": 1301640,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "You know, to talk on the\nphone, to go for walks,"
    } ]
  }, {
    "tStartMs": 1305870,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "to have coffee, to do\nwhatever, to play basketball."
    } ]
  }, {
    "tStartMs": 1309620,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The people who took those\nactions again and again regularly"
    } ]
  }, {
    "tStartMs": 1314930,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "were the people who stayed very connected"
    } ]
  }, {
    "tStartMs": 1317630,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and stayed happy that way."
    } ]
  }, {
    "tStartMs": 1319220,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So what we propose is"
    } ]
  }, {
    "tStartMs": 1322940,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "that this is a practice we can cultivate"
    } ]
  }, {
    "tStartMs": 1326210,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "and that there are tiny\nactions that people can take."
    } ]
  }, {
    "tStartMs": 1330080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "We have many stories of people"
    } ]
  }, {
    "tStartMs": 1333260,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "who thought that they were\nno good at relationships,"
    } ]
  }, {
    "tStartMs": 1337430,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that they were never\ngonna have happy lives."
    } ]
  }, {
    "tStartMs": 1340880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And then it changed."
    } ]
  }, {
    "tStartMs": 1342470,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And many times it changed\nwhen they didn't expect it."
    } ]
  }, {
    "tStartMs": 1346160,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So like, we have a story about one man"
    } ]
  }, {
    "tStartMs": 1349550,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "who really didn't have a good marriage"
    } ]
  }, {
    "tStartMs": 1353150,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and was kind of distant from his kids,"
    } ]
  }, {
    "tStartMs": 1356180,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "didn't have any friends."
    } ]
  }, {
    "tStartMs": 1357560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And then when he retired,"
    } ]
  }, {
    "tStartMs": 1358640,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "he joined a gym and he\nfound this group of friends"
    } ]
  }, {
    "tStartMs": 1361310,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "that became, for the first\ntime, a kind of tribe for him."
    } ]
  }, {
    "tStartMs": 1365840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And that's just one example"
    } ]
  }, {
    "tStartMs": 1367610,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "of how our lives take\nthese twists and turns"
    } ]
  }, {
    "tStartMs": 1372440,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "that we usually can't predict,"
    } ]
  }, {
    "tStartMs": 1376130,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "that we don't expect."
    } ]
  }, {
    "tStartMs": 1377420,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And many of those turns\nare in positive directions."
    } ]
  }, {
    "tStartMs": 1380720,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The message that the science tells us"
    } ]
  }, {
    "tStartMs": 1383990,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "is don't give up on this\naspect of your life."
    } ]
  }, {
    "tStartMs": 1388100,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "'cause many things can change at any age."
    } ]
  }, {
    "tStartMs": 1393639,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "(transition beeps and chimes)"
    } ]
  } ]
}
