{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(text softly clacking)\n(suspenseful music)"
    } ]
  }, {
    "tStartMs": 7430,
    "dDurationMs": 3646,
    "segs": [ {
      "utf8": "(suspenseful music drowns out speaker)"
    } ]
  }, {
    "tStartMs": 11076,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(bushes rustling)\n(videographer breathing)"
    } ]
  }, {
    "tStartMs": 17190,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "- [Gregor] They're just everywhere."
    } ]
  }, {
    "tStartMs": 19840,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "Whoa, this is really blue."
    } ]
  }, {
    "tStartMs": 22141,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "You should come look, this is so blue."
    } ]
  }, {
    "tStartMs": 24240,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- [Researcher] Look at\nhow many you're finding."
    } ]
  }, {
    "tStartMs": 26970,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- [Gregor] I feel\nlike Gollum, my precious!"
    } ]
  }, {
    "tStartMs": 30170,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "if it weren't so dangerous,"
    } ]
  }, {
    "tStartMs": 31650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "it'd be a fun activity to do."
    } ]
  }, {
    "tStartMs": 33420,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Researcher] These are the big chunks,"
    } ]
  }, {
    "tStartMs": 35070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "so what about all the\nparticles you can't see?"
    } ]
  }, {
    "tStartMs": 38190,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- This same kind of material"
    } ]
  }, {
    "tStartMs": 39630,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "was used in the construction"
    } ]
  }, {
    "tStartMs": 40920,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of the World Trade Center buildings."
    } ]
  }, {
    "tStartMs": 42720,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And when the towers fell,"
    } ]
  }, {
    "tStartMs": 44190,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "it was pulverized to microscopic size"
    } ]
  }, {
    "tStartMs": 46170,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "and released into the air."
    } ]
  }, {
    "tStartMs": 48960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The particles remained airborne for days"
    } ]
  }, {
    "tStartMs": 50940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and thousands of people\nunknowingly breathed them in."
    } ]
  }, {
    "tStartMs": 54030,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "They buried themselves\ndeep within people's lungs,"
    } ]
  }, {
    "tStartMs": 56940,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "wreaking havoc and causing\nall sorts of diseases."
    } ]
  }, {
    "tStartMs": 61410,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "We've known for decades"
    } ]
  }, {
    "tStartMs": 62490,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that these particles\nare extremely dangerous,"
    } ]
  }, {
    "tStartMs": 64980,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "but when the towers\nfell, no one was warned."
    } ]
  }, {
    "tStartMs": 69420,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- The concentrations are such"
    } ]
  }, {
    "tStartMs": 71340,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "that they don't pose a health hazard."
    } ]
  }, {
    "tStartMs": 74670,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Gregor] And yet today the\ndiseases linked to that dust"
    } ]
  }, {
    "tStartMs": 77280,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "have killed more than twice as many people"
    } ]
  }, {
    "tStartMs": 79380,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "as the attacks themselves."
    } ]
  }, {
    "tStartMs": 81840,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Once we started looking,"
    } ]
  }, {
    "tStartMs": 84750,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "we kept finding this material\nin places we never expected."
    } ]
  }, {
    "tStartMs": 88620,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "- He was telling the newspapers,"
    } ]
  }, {
    "tStartMs": 89917,
    "dDurationMs": 1193,
    "segs": [ {
      "utf8": "\"People aren't just eating it"
    } ]
  }, {
    "tStartMs": 91110,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and breathing it, they're mainlining it.\""
    } ]
  }, {
    "tStartMs": 92850,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Gregor] In popular\noff-roading spots, in makeup,"
    } ]
  }, {
    "tStartMs": 95400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and even kids toys."
    } ]
  }, {
    "tStartMs": 97380,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Sean] Say It Ain't\nSo Mickey Mouse crayons."
    } ]
  }, {
    "tStartMs": 99630,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- No!"
    } ]
  }, {
    "tStartMs": 100860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's been detected in the dust"
    } ]
  }, {
    "tStartMs": 102450,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "around schools and homes."
    } ]
  }, {
    "tStartMs": 104070,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Five generations of\npeople died up there."
    } ]
  }, {
    "tStartMs": 106290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Gregor] And instead\nof banning it outright,"
    } ]
  }, {
    "tStartMs": 108270,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "we let it spread."
    } ]
  }, {
    "tStartMs": 110107,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "(camera shutter clicking)"
    } ]
  }, {
    "tStartMs": 112800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Some countries are still\nimporting hundreds of thousands"
    } ]
  }, {
    "tStartMs": 115560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of tons each year,"
    } ]
  }, {
    "tStartMs": 116393,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "and it's estimated that by 2035,"
    } ]
  }, {
    "tStartMs": 118440,
    "dDurationMs": 3427,
    "segs": [ {
      "utf8": "nearly 2.8 million people\nmight die because of it."
    } ]
  }, {
    "tStartMs": 121867,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 126360,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This is a video about a\ndeadly miracle material"
    } ]
  }, {
    "tStartMs": 128970,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "we can't stop using."
    } ]
  }, {
    "tStartMs": 131910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "This investigation is based"
    } ]
  }, {
    "tStartMs": 133230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "on publicly available\ndocuments, recordings,"
    } ]
  }, {
    "tStartMs": 135480,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and third party sources."
    } ]
  }, {
    "tStartMs": 136950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "All of our links are in the description."
    } ]
  }, {
    "tStartMs": 138810,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Thank you to Ground News\nfor sponsoring this video."
    } ]
  }, {
    "tStartMs": 141240,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "More about them later."
    } ]
  }, {
    "tStartMs": 144870,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "There is this story\nabout the ancient Greeks"
    } ]
  }, {
    "tStartMs": 146730,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from around the second century AD."
    } ]
  }, {
    "tStartMs": 149130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "They had this golden lantern"
    } ]
  }, {
    "tStartMs": 150990,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "that would burn for a whole\nyear without going out,"
    } ]
  }, {
    "tStartMs": 154050,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "all because of a very special wick"
    } ]
  }, {
    "tStartMs": 155760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that just wouldn't burn down."
    } ]
  }, {
    "tStartMs": 157680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So how did they develop this technology?"
    } ]
  }, {
    "tStartMs": 160800,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "Well, the truth is they\ndidn't, they found it."
    } ]
  }, {
    "tStartMs": 166230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Imagine you're walking\naround 2,000 years ago"
    } ]
  }, {
    "tStartMs": 168570,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and you see this fluffy looking\nstuff poking out the ground."
    } ]
  }, {
    "tStartMs": 171780,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It's got all of these fibers\nthat you can pull apart"
    } ]
  }, {
    "tStartMs": 174630,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "and twist into shapes."
    } ]
  }, {
    "tStartMs": 180180,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [Sean] First off,\nlet's get a nice bundle."
    } ]
  }, {
    "tStartMs": 183150,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "So it looks like cotton."
    } ]
  }, {
    "tStartMs": 184740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Gregor] It looks like\nit would burn really well,"
    } ]
  }, {
    "tStartMs": 186300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "like it would just-\n- Yeah,"
    } ]
  }, {
    "tStartMs": 187650,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you can start a fire\nwith it, right, alright."
    } ]
  }, {
    "tStartMs": 190050,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "- [Gregor] Okay, let's see what happens."
    } ]
  }, {
    "tStartMs": 193050,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Sean] It's not burning."
    } ]
  }, {
    "tStartMs": 194610,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- That's because this is actually a rock."
    } ]
  }, {
    "tStartMs": 197070,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "It's a naturally occurring mineral."
    } ]
  }, {
    "tStartMs": 199890,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The core building block is simple."
    } ]
  }, {
    "tStartMs": 201450,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "It's a silicon atom surrounded\nby four oxygen atoms."
    } ]
  }, {
    "tStartMs": 205110,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Now silicon has four\nelectrons in its outer shell,"
    } ]
  }, {
    "tStartMs": 208350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "but it really wants eight."
    } ]
  }, {
    "tStartMs": 209910,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "So each of the oxygens\nshares one electron with it,"
    } ]
  }, {
    "tStartMs": 213780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but oxygen doesn't share evenly"
    } ]
  }, {
    "tStartMs": 215490,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "since it's more\nelectronegative than silicon,"
    } ]
  }, {
    "tStartMs": 217740,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "it pulls those shared\nelectrons closer to itself."
    } ]
  }, {
    "tStartMs": 221040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This leaves the oxygen\nside slightly negative"
    } ]
  }, {
    "tStartMs": 223680,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and the silicon side slightly positive."
    } ]
  }, {
    "tStartMs": 226410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Now there's an electrostatic\nattraction between these atoms,"
    } ]
  }, {
    "tStartMs": 229500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "which pulls the atoms closer together"
    } ]
  }, {
    "tStartMs": 231360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and strengthens this bond."
    } ]
  }, {
    "tStartMs": 233460,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The result is an incredibly\nstable pyramid shaped unit"
    } ]
  }, {
    "tStartMs": 236430,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "called as silica tetrahedron."
    } ]
  }, {
    "tStartMs": 238620,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "But if you look at the\noxygens in these corner spots,"
    } ]
  }, {
    "tStartMs": 241860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "they've only shared one electron,"
    } ]
  }, {
    "tStartMs": 243690,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "but they actually want two to\ncomplete their outer shells."
    } ]
  }, {
    "tStartMs": 247080,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So the corners link up\nwith other silicon atoms"
    } ]
  }, {
    "tStartMs": 249870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to form more tetrahedra."
    } ]
  }, {
    "tStartMs": 251460,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And in this way, the\nstructure just keeps growing."
    } ]
  }, {
    "tStartMs": 255330,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The bonds inside here are\nincredibly strong and stable,"
    } ]
  }, {
    "tStartMs": 258120,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and because the atoms\nare already tightly bound"
    } ]
  }, {
    "tStartMs": 260490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to the oxygens inside\nthe silicate structure,"
    } ]
  }, {
    "tStartMs": 263010,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the oxygen in the air has\nnothing to react with,"
    } ]
  }, {
    "tStartMs": 265680,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "so the material doesn't burn."
    } ]
  }, {
    "tStartMs": 269280,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "But overall, there's nothing special"
    } ]
  }, {
    "tStartMs": 270990,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "about these building blocks."
    } ]
  }, {
    "tStartMs": 272310,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "More than 90% of the Earth's minerals"
    } ]
  }, {
    "tStartMs": 274200,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "are made from this stuff,"
    } ]
  }, {
    "tStartMs": 275580,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "everything from quartz to clay."
    } ]
  }, {
    "tStartMs": 278580,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "What makes this material special is"
    } ]
  }, {
    "tStartMs": 280530,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "how those units link up."
    } ]
  }, {
    "tStartMs": 283140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Here, the tetrahedra have formed a sheet,"
    } ]
  }, {
    "tStartMs": 285450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and bonded to it there is\nactually a second sheet"
    } ]
  }, {
    "tStartMs": 287850,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "made of magnesium atoms"
    } ]
  }, {
    "tStartMs": 289470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and hydroxyl groups,\nwhich are just an oxygen"
    } ]
  }, {
    "tStartMs": 291990,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and a hydrogen stuck together."
    } ]
  }, {
    "tStartMs": 293700,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Now, the atomic spacings"
    } ]
  }, {
    "tStartMs": 295170,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of these two layers\nare slightly different."
    } ]
  }, {
    "tStartMs": 297660,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So there's a tiny mismatch,\nwhich causes tension"
    } ]
  }, {
    "tStartMs": 300480,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "between these layers\ncausing them to curl up,"
    } ]
  }, {
    "tStartMs": 303420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and you end up with these\ntiny scroll-like tubes."
    } ]
  }, {
    "tStartMs": 306030,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "These tubes don't break\ndown easily under heat."
    } ]
  }, {
    "tStartMs": 308820,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "The structure stays stable up\nto around 600 degrees Celsius."
    } ]
  }, {
    "tStartMs": 312630,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So like all these individual fibers"
    } ]
  }, {
    "tStartMs": 314310,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "that you see running through here,"
    } ]
  }, {
    "tStartMs": 315390,
    "dDurationMs": 1549,
    "segs": [ {
      "utf8": "those are all like these curls?"
    } ]
  }, {
    "tStartMs": 316939,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 317772,
    "dDurationMs": 888,
    "segs": [ {
      "utf8": "- What is that, what was that there?"
    } ]
  }, {
    "tStartMs": 318660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Sean] That's just a place"
    } ]
  }, {
    "tStartMs": 320520,
    "dDurationMs": 2445,
    "segs": [ {
      "utf8": "where I twisted the\nfiber with my tweezers."
    } ]
  }, {
    "tStartMs": 322965,
    "dDurationMs": 1365,
    "segs": [ {
      "utf8": "- Oh, okay."
    } ]
  }, {
    "tStartMs": 324330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And when you twist these fibers,"
    } ]
  }, {
    "tStartMs": 325980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "they actually don't break."
    } ]
  }, {
    "tStartMs": 327360,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "So it's literally a rock you can weave."
    } ]
  }, {
    "tStartMs": 333000,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "And when you do,"
    } ]
  }, {
    "tStartMs": 333900,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the fibers form a tangled,\nlayered structure."
    } ]
  }, {
    "tStartMs": 336450,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So if heat is introduced,\nit has to pass from fiber"
    } ]
  }, {
    "tStartMs": 339150,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to fiber across many contact points"
    } ]
  }, {
    "tStartMs": 341550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with air filling the spaces between them."
    } ]
  }, {
    "tStartMs": 343620,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "This reduces how quickly heat can spread"
    } ]
  }, {
    "tStartMs": 346110,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "through the material."
    } ]
  }, {
    "tStartMs": 347340,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Because of that, people\nstarted weaving it into things"
    } ]
  }, {
    "tStartMs": 349770,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "like theater curtains"
    } ]
  }, {
    "tStartMs": 350880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and insulation blankets for steam engines,"
    } ]
  }, {
    "tStartMs": 353460,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "even fireproof clothing,"
    } ]
  }, {
    "tStartMs": 355020,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "essentially anywhere"
    } ]
  }, {
    "tStartMs": 355890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "they didn't want something to catch fire."
    } ]
  }, {
    "tStartMs": 357990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But by far the most important use"
    } ]
  }, {
    "tStartMs": 359970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "came around in the 1800s."
    } ]
  }, {
    "tStartMs": 362370,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Between 1790 and 1870,"
    } ]
  }, {
    "tStartMs": 364590,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the number of people living\nin urban areas in America"
    } ]
  }, {
    "tStartMs": 367680,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "jumped from 1 in 20 to around 1 in 4."
    } ]
  }, {
    "tStartMs": 371280,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So to accommodate this,\npeople had to tack on"
    } ]
  }, {
    "tStartMs": 373710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "extra floors onto existing buildings"
    } ]
  }, {
    "tStartMs": 375720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and courtyards would then be filled"
    } ]
  }, {
    "tStartMs": 377580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "with makeshift extensions,"
    } ]
  }, {
    "tStartMs": 378930,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "effectively tightly packing all\nof these buildings together."
    } ]
  }, {
    "tStartMs": 382320,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Pretty much all these buildings\nwere made out of wood,"
    } ]
  }, {
    "tStartMs": 385320,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "but the people inside still\ncooked with open flames."
    } ]
  }, {
    "tStartMs": 388890,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They used gas lamps, they lit candles."
    } ]
  }, {
    "tStartMs": 391290,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "So one accident"
    } ]
  }, {
    "tStartMs": 392280,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and an entire neighborhood\ncould go up in flames."
    } ]
  }, {
    "tStartMs": 395430,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "That reality hit New York\nCity in December, 1835,"
    } ]
  }, {
    "tStartMs": 399540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "when within a span of just two days,"
    } ]
  }, {
    "tStartMs": 401670,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "three separate fires erupted in Manhattan."
    } ]
  }, {
    "tStartMs": 405210,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "One bystander described what\nfollowed as \"An ocean of fire"
    } ]
  }, {
    "tStartMs": 408960,
    "dDurationMs": 2817,
    "segs": [ {
      "utf8": "with roaring, rolling, burning waves.\""
    } ]
  }, {
    "tStartMs": 413730,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "By the end, a third of a mile\nof Manhattan was engulfed,"
    } ]
  }, {
    "tStartMs": 417090,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "destroying nearly 700 buildings\nat a cost of $20 million."
    } ]
  }, {
    "tStartMs": 421410,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "That's over $730 million of today's money."
    } ]
  }, {
    "tStartMs": 425130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Similar catastrophes\nwere happening in cities"
    } ]
  }, {
    "tStartMs": 427350,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "all over the world, Chicago,\nLondon, Hamburg, Tokyo."
    } ]
  }, {
    "tStartMs": 432090,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Reporter] When will this appalling rate"
    } ]
  }, {
    "tStartMs": 433620,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "of destruction come to an end?"
    } ]
  }, {
    "tStartMs": 438465,
    "dDurationMs": 1725,
    "segs": [ {
      "utf8": "- [Gregor] The problem was\nthat when a building burned,"
    } ]
  }, {
    "tStartMs": 440190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "it spewed up embers into the air."
    } ]
  }, {
    "tStartMs": 442980,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "These then got carried by the wind"
    } ]
  }, {
    "tStartMs": 444540,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "and landed onto other\nroofs, setting them alight."
    } ]
  }, {
    "tStartMs": 450210,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So 23 years after the\nGreat Fire of New York,"
    } ]
  }, {
    "tStartMs": 452940,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "a 21-year-old named\nHenry Ward Johns set out"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "to break that chain reaction\nby making roofs fireproof."
    } ]
  }, {
    "tStartMs": 460200,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But that's trickier than it sounds."
    } ]
  }, {
    "tStartMs": 461850,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Whatever his solution was,"
    } ]
  }, {
    "tStartMs": 463080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "it had to be usable across an entire city."
    } ]
  }, {
    "tStartMs": 465360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So cheap and easy enough to mass produce,"
    } ]
  }, {
    "tStartMs": 468210,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "durable enough to sit exposed on rooftops"
    } ]
  }, {
    "tStartMs": 470730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "baking in the summer sun,\nfreezing in the winter,"
    } ]
  }, {
    "tStartMs": 473400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and most importantly, it\nwas not allowed to ignite"
    } ]
  }, {
    "tStartMs": 476100,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "even when exposed to burning embers."
    } ]
  }, {
    "tStartMs": 479970,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Now, Johns knew of a mineral"
    } ]
  }, {
    "tStartMs": 481710,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that was already being\nspun into fireproof fabric,"
    } ]
  }, {
    "tStartMs": 484710,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but only the long fibers\nwere useful for thread."
    } ]
  }, {
    "tStartMs": 487530,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The shorter ones were\nactually swept aside as waste."
    } ]
  }, {
    "tStartMs": 490380,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Johns realized those scraps\nwere exactly what he needed,"
    } ]
  }, {
    "tStartMs": 493890,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "fireproof, tough and\nmost importantly, cheap."
    } ]
  }, {
    "tStartMs": 497100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So he set up a makeshift lab\nin his basement apartment"
    } ]
  }, {
    "tStartMs": 499800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and started experimenting."
    } ]
  }, {
    "tStartMs": 501540,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "He heated up tar in his tea\nkettle, smeared that onto cloth,"
    } ]
  }, {
    "tStartMs": 505470,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and then pressed in these tiny fibers."
    } ]
  }, {
    "tStartMs": 507780,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Then he ringed the whole thing"
    } ]
  }, {
    "tStartMs": 509190,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "through his wife's brand\nnew clothes ringer,"
    } ]
  }, {
    "tStartMs": 511710,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "and when he tested it, it\nworked, it didn't burn."
    } ]
  }, {
    "tStartMs": 516510,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In 1868, Henry Ward Johns\npatented his invention,"
    } ]
  }, {
    "tStartMs": 519870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and by 1927,"
    } ]
  }, {
    "tStartMs": 521550,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "the company he built was\ngenerating $45 million"
    } ]
  }, {
    "tStartMs": 525000,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "in annual sales, more than\n800 million in today's money."
    } ]
  }, {
    "tStartMs": 529050,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Soon people were using\nthis fire-resistant stuff"
    } ]
  }, {
    "tStartMs": 531630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "in all kinds of building materials,"
    } ]
  }, {
    "tStartMs": 533700,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "across America, consumption grew"
    } ]
  }, {
    "tStartMs": 535170,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "from around 20,400 tons in 1900"
    } ]
  }, {
    "tStartMs": 538530,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to a peak of 803,000 tons in 1973."
    } ]
  }, {
    "tStartMs": 543585,
    "dDurationMs": 1815,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 545400,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Because of that, pretty much\nevery building in the US,"
    } ]
  }, {
    "tStartMs": 548190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "public or private,\ncommercial or residential,"
    } ]
  }, {
    "tStartMs": 550530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "used some form of this material."
    } ]
  }, {
    "tStartMs": 552780,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "During that same period,\nstronger building codes,"
    } ]
  }, {
    "tStartMs": 555030,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "safer heating systems"
    } ]
  }, {
    "tStartMs": 556230,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and other fire-resistant\nmaterials were also introduced,"
    } ]
  }, {
    "tStartMs": 559410,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "and it showed,"
    } ]
  }, {
    "tStartMs": 560460,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "during that time, fire-related\ndeaths dropped around 80%."
    } ]
  }, {
    "tStartMs": 564420,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So this material"
    } ]
  }, {
    "tStartMs": 565253,
    "dDurationMs": 3318,
    "segs": [ {
      "utf8": "likely helped save millions\nof lives worldwide."
    } ]
  }, {
    "tStartMs": 568571,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(lively music)"
    } ]
  }, {
    "tStartMs": 573390,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Because it couldn't be destroyed by fire,"
    } ]
  }, {
    "tStartMs": 575460,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the name the ancient Greeks\ngave it, it stuck around."
    } ]
  }, {
    "tStartMs": 579300,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "They called it\ninextinguishable,"
    } ]
  }, {
    "tStartMs": 582640,
    "dDurationMs": 1253,
    "segs": [ {
      "utf8": "or asbestos."
    } ]
  }, {
    "tStartMs": 585841,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 588360,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- [Presenter] Asbestos,\nthe remarkable mineral."
    } ]
  }, {
    "tStartMs": 590820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Gregor] By the mid 20th\ncentury, asbestos was everywhere,"
    } ]
  }, {
    "tStartMs": 593370,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "inside brake pads,\ntoasters, ironing boards,"
    } ]
  }, {
    "tStartMs": 596850,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "hair dryers, surgical\ndressings, and blankets."
    } ]
  }, {
    "tStartMs": 600330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "You know, brewers\nfiltered beer through it."
    } ]
  }, {
    "tStartMs": 603060,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "One brand of toothpaste even\nused it for extra polish,"
    } ]
  }, {
    "tStartMs": 607530,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the fake snow in department store windows"
    } ]
  }, {
    "tStartMs": 609540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and in movies like \"The Wizard of Oz,\""
    } ]
  }, {
    "tStartMs": 611760,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "all of that's asbestos too."
    } ]
  }, {
    "tStartMs": 614520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Unusual weather we're having, eh?"
    } ]
  }, {
    "tStartMs": 616770,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Gregor] Sorry, Dorothy."
    } ]
  }, {
    "tStartMs": 618630,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- It was such a big deal,"
    } ]
  }, {
    "tStartMs": 619800,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Marvel even had a villain\ncalled Asbestos Lady."
    } ]
  }, {
    "tStartMs": 623490,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "She'd set a fire to escape the police,"
    } ]
  }, {
    "tStartMs": 625620,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "and she'd easily walk through it,"
    } ]
  }, {
    "tStartMs": 626790,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "safe inside her asbestos bodysuit."
    } ]
  }, {
    "tStartMs": 630960,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "To feed this demand,"
    } ]
  }, {
    "tStartMs": 632130,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "asbestos was pulled out of the\nground on an enormous scale."
    } ]
  }, {
    "tStartMs": 635310,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Major mining operations\nspread across Canada, Russia,"
    } ]
  }, {
    "tStartMs": 638310,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and South Africa"
    } ]
  }, {
    "tStartMs": 639540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with global production peaking"
    } ]
  }, {
    "tStartMs": 641220,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "at approximately 4.8 million\ntons per year in 1977."
    } ]
  }, {
    "tStartMs": 649080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But the reason asbestos ended up"
    } ]
  }, {
    "tStartMs": 650820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "in so many different products is"
    } ]
  }, {
    "tStartMs": 653160,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "because it's actually a\ngroup of different minerals,"
    } ]
  }, {
    "tStartMs": 657510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that white, fluffy stuff\nwe tried to burn earlier,"
    } ]
  }, {
    "tStartMs": 660060,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "it's called chrysotile,"
    } ]
  }, {
    "tStartMs": 661470,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it belongs to a mineral\nfamily known as the serpentines."
    } ]
  }, {
    "tStartMs": 664890,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But other types of asbestos\nlooked completely different."
    } ]
  }, {
    "tStartMs": 668610,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "For instance, there is also\nbrown asbestos known as amosite."
    } ]
  }, {
    "tStartMs": 672840,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "It forms thick fibers that\nalmost look like wood splinters,"
    } ]
  }, {
    "tStartMs": 676530,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "strong, stable, and highly heat resistant."
    } ]
  }, {
    "tStartMs": 679770,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So it was perfect for putting\ninto building materials"
    } ]
  }, {
    "tStartMs": 682620,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "like cement panels."
    } ]
  }, {
    "tStartMs": 684990,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This type belongs to a\ndifferent mineral family,"
    } ]
  }, {
    "tStartMs": 687780,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "the amphiboles, here,\ninstead of forming sheets,"
    } ]
  }, {
    "tStartMs": 692010,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "the silica tetrahedra lock\ninto rigid, ladder-like chains,"
    } ]
  }, {
    "tStartMs": 695940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and amosite, iron and magnesium ions,"
    } ]
  }, {
    "tStartMs": 698160,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "along with hydroxyl groups\nembedded in the structure,"
    } ]
  }, {
    "tStartMs": 700920,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "bind those chains together,"
    } ]
  }, {
    "tStartMs": 702510,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "forming these long, needle-like fibers,"
    } ]
  }, {
    "tStartMs": 706800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but tweak that chemistry just\nslightly so that now iron"
    } ]
  }, {
    "tStartMs": 709620,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and sodium ions bind the chains,"
    } ]
  }, {
    "tStartMs": 711690,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "and you get this, blue\nasbestos or crocidolite."
    } ]
  }, {
    "tStartMs": 716190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "These crystals split\neasily along their length"
    } ]
  }, {
    "tStartMs": 718650,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and they create these fine flexible fibers"
    } ]
  }, {
    "tStartMs": 721320,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that are still extraordinarily strong"
    } ]
  }, {
    "tStartMs": 723150,
    "dDurationMs": 3573,
    "segs": [ {
      "utf8": "with tensile strengths comparable\nto high grade steel wire."
    } ]
  }, {
    "tStartMs": 728280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "This type went into\nchemical-resistant insulation,"
    } ]
  }, {
    "tStartMs": 730950,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "shipyards, and even filters\ninside early gas masks."
    } ]
  }, {
    "tStartMs": 734700,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Oh, and there was another use,"
    } ]
  }, {
    "tStartMs": 735660,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "one that's hard to believe now."
    } ]
  }, {
    "tStartMs": 738210,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- In this magic box I have right here"
    } ]
  }, {
    "tStartMs": 741150,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "is something that was manufactured"
    } ]
  }, {
    "tStartMs": 744360,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "right here in North Carolina."
    } ]
  }, {
    "tStartMs": 746880,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "They're cigarettes, produced in the 1950s,"
    } ]
  }, {
    "tStartMs": 750930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and if you look at the filter,"
    } ]
  }, {
    "tStartMs": 753360,
    "dDurationMs": 5639,
    "segs": [ {
      "utf8": "you see the filters are blue, asbestos."
    } ]
  }, {
    "tStartMs": 759900,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This is Kent with a Micronite\nfilter that was manufactured"
    } ]
  }, {
    "tStartMs": 763500,
    "dDurationMs": 2887,
    "segs": [ {
      "utf8": "with crocidolite asbestos\nin the filter itself."
    } ]
  }, {
    "tStartMs": 766387,
    "dDurationMs": 2363,
    "segs": [ {
      "utf8": "- So you're not only\nsmoking, you were smoking it"
    } ]
  }, {
    "tStartMs": 768750,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "through a blue asbestos filter."
    } ]
  }, {
    "tStartMs": 770370,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yes, what a deal."
    } ]
  }, {
    "tStartMs": 772290,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- Only Kent has the revolutionary\nnew Micronite filter"
    } ]
  }, {
    "tStartMs": 775860,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "you've heard so much about."
    } ]
  }, {
    "tStartMs": 777120,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Kent and only Kent filters best,\nfilters best, filters best."
    } ]
  }, {
    "tStartMs": 782129,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(tobacco crackling)\n(suspenseful music)"
    } ]
  }, {
    "tStartMs": 790961,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "- [Gregor] In the early 1900s,"
    } ]
  }, {
    "tStartMs": 792390,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "a young woman named Nelly\nKershaw worked in a factory"
    } ]
  }, {
    "tStartMs": 796230,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that spun asbestos fibers into threads."
    } ]
  }, {
    "tStartMs": 799110,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Every day she breathed in the dust"
    } ]
  }, {
    "tStartMs": 801210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that those machines threw into the air."
    } ]
  }, {
    "tStartMs": 803880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So by her early thirties,"
    } ]
  }, {
    "tStartMs": 805830,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "she was so sick she could barely breathe."
    } ]
  }, {
    "tStartMs": 809940,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And when she finally decided\nto ask the factory for help,"
    } ]
  }, {
    "tStartMs": 813300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "they refused, they said\nhelping out workers"
    } ]
  }, {
    "tStartMs": 815820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "would set a dangerous precedent."
    } ]
  }, {
    "tStartMs": 818370,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "Nelly died shortly after\nat the age of just 33."
    } ]
  }, {
    "tStartMs": 823440,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Nelly's case caught the attention"
    } ]
  }, {
    "tStartMs": 824970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of pathologist Dr. William Cook."
    } ]
  }, {
    "tStartMs": 827640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "When he opened up her\nchest, her lungs were gray"
    } ]
  }, {
    "tStartMs": 830520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and scarred, almost blue-black,"
    } ]
  }, {
    "tStartMs": 832260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "like they had a huge internal bruise."
    } ]
  }, {
    "tStartMs": 834600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "And when his scalpel passed\nthrough them, they rasped."
    } ]
  }, {
    "tStartMs": 838500,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "It was like scraping against sandpaper."
    } ]
  }, {
    "tStartMs": 842190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The tissue was full of mineral grit,"
    } ]
  }, {
    "tStartMs": 843990,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and under the microscope\nthe cause was unmistakable,"
    } ]
  }, {
    "tStartMs": 846960,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "asbestos fibers lodged\ninto the lung tissue."
    } ]
  }, {
    "tStartMs": 851430,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- If we were to inhale some\ntype of an asbestos fiber,"
    } ]
  }, {
    "tStartMs": 854250,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I kind of won't think of them"
    } ]
  }, {
    "tStartMs": 855390,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "as like little microscopic\nstraight arrows,"
    } ]
  }, {
    "tStartMs": 857640,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "they kind of just shoot down\nthrough the nose or the mouth"
    } ]
  }, {
    "tStartMs": 860940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and move down through the trachea."
    } ]
  }, {
    "tStartMs": 863460,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "If we continue on going\ndown here, we get smaller"
    } ]
  }, {
    "tStartMs": 866340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and smaller as we penetrate\ndeeper into the lung tissue."
    } ]
  }, {
    "tStartMs": 869010,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And then you get into these alveolar sacs,"
    } ]
  }, {
    "tStartMs": 871380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "these asbestos fibers, they\nlodge in the tissue there,"
    } ]
  }, {
    "tStartMs": 874020,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and lung secretions, enzymes,\neven white blood cells,"
    } ]
  }, {
    "tStartMs": 877710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "they have a really hard\ntime breaking those down."
    } ]
  }, {
    "tStartMs": 880500,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "- You end up with scarring\ndeep inside the lungs."
    } ]
  }, {
    "tStartMs": 884417,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "In 1924, Dr. Cook published\nthe first medical description"
    } ]
  }, {
    "tStartMs": 887670,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "of this condition, which\nbecame known as asbestosis."
    } ]
  }, {
    "tStartMs": 892140,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "When these asbestos fibers\nlodge into the lungs,"
    } ]
  }, {
    "tStartMs": 895050,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the body treats them like invaders,"
    } ]
  }, {
    "tStartMs": 897090,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "specialized cells called\nmacrophages move in,"
    } ]
  }, {
    "tStartMs": 900120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "cells whose job it is to engulf"
    } ]
  }, {
    "tStartMs": 901980,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and digest bacteria, dust or debris."
    } ]
  }, {
    "tStartMs": 904830,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "But asbestos fibers are too\nlong and stiff to swallow."
    } ]
  }, {
    "tStartMs": 908460,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It's kind of like trying to\neat a toothpick sideways."
    } ]
  }, {
    "tStartMs": 911250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The macrophages keep trying and failing,"
    } ]
  }, {
    "tStartMs": 913980,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and in the process, they\nrelease inflammatory chemicals"
    } ]
  }, {
    "tStartMs": 916770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that damage the surrounding lung tissue."
    } ]
  }, {
    "tStartMs": 919140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So workers breathing in\nasbestos dust day after day,"
    } ]
  }, {
    "tStartMs": 922080,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "accumulated more and more damage."
    } ]
  }, {
    "tStartMs": 924990,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "When doctors sent"
    } ]
  }, {
    "tStartMs": 926010,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "by the British government\nexamined hundreds"
    } ]
  }, {
    "tStartMs": 928260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of asbestos workers,"
    } ]
  }, {
    "tStartMs": 929670,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they found that more than 25%"
    } ]
  }, {
    "tStartMs": 931920,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "already showed signs of lung disease."
    } ]
  }, {
    "tStartMs": 934650,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And for workers with over\n20 years of exposure,"
    } ]
  }, {
    "tStartMs": 937470,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that number was closer to 80%."
    } ]
  }, {
    "tStartMs": 940050,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So in 1931, the government\nofficially classified asbestos"
    } ]
  }, {
    "tStartMs": 943860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "as a workplace hazard,"
    } ]
  }, {
    "tStartMs": 945480,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "making it one of the\nfirst industrial materials"
    } ]
  }, {
    "tStartMs": 947520,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to be regulated for health risks."
    } ]
  }, {
    "tStartMs": 949650,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But the new rules only covered factories"
    } ]
  }, {
    "tStartMs": 951780,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "where asbestos was manufactured."
    } ]
  }, {
    "tStartMs": 953940,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "They didn't extend to other\nworkers like ship builders,"
    } ]
  }, {
    "tStartMs": 957120,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "miners or construction workers\nwho were regularly exposed"
    } ]
  }, {
    "tStartMs": 960690,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "to asbestos dust."
    } ]
  }, {
    "tStartMs": 964230,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Across the Atlantic,\nthings weren't much better."
    } ]
  }, {
    "tStartMs": 966450,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "There was no binding federal\nasbestos rules in the States,"
    } ]
  }, {
    "tStartMs": 970050,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "only a recommendation."
    } ]
  }, {
    "tStartMs": 971730,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The US Public Health Service"
    } ]
  }, {
    "tStartMs": 973170,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "suggested a temporary exposure limit"
    } ]
  }, {
    "tStartMs": 975210,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of 5 million asbestos particles"
    } ]
  }, {
    "tStartMs": 977100,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "for a single cubic foot of air,"
    } ]
  }, {
    "tStartMs": 979320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which meant that a\nworker breathing normally"
    } ]
  }, {
    "tStartMs": 981240,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "could inhale over 300 million\nasbestos particles an hour"
    } ]
  }, {
    "tStartMs": 985110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and still be considered within guidelines."
    } ]
  }, {
    "tStartMs": 987690,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "This became especially\nproblematic for shipyard workers"
    } ]
  }, {
    "tStartMs": 990390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "when World War II broke out,"
    } ]
  }, {
    "tStartMs": 991950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "ships were packed with\nasbestos insulation."
    } ]
  }, {
    "tStartMs": 994860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So workers spent their days cutting"
    } ]
  }, {
    "tStartMs": 996900,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and fitting asbestos in\nthick clouds of fibers."
    } ]
  }, {
    "tStartMs": 1000170,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And according to the\nguidelines of the day,"
    } ]
  }, {
    "tStartMs": 1002030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "these levels met the official definition"
    } ]
  }, {
    "tStartMs": 1004400,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "of safe working conditions."
    } ]
  }, {
    "tStartMs": 1006530,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "In fact, asbestos was still\nmarketed as a magic material."
    } ]
  }, {
    "tStartMs": 1010190,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "A few years earlier,"
    } ]
  }, {
    "tStartMs": 1011247,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "\"Time\" magazine actually put\nJohns-Manville's president,"
    } ]
  }, {
    "tStartMs": 1014180,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Lewis H. Brown on its\nApril 3rd, 1939 cover."
    } ]
  }, {
    "tStartMs": 1017630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But in the early 1960s,"
    } ]
  }, {
    "tStartMs": 1019580,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "finally one doctor started\nconnecting the dots on asbestos."
    } ]
  }, {
    "tStartMs": 1024770,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Dr. Irving Selikoff was\nrunning a small clinic"
    } ]
  }, {
    "tStartMs": 1027080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in Patterson, New Jersey,"
    } ]
  }, {
    "tStartMs": 1028670,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "when the local asbestos\nworkers Union asked if"
    } ]
  }, {
    "tStartMs": 1031250,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "their members could come and see him."
    } ]
  }, {
    "tStartMs": 1033650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Before long, he'd seen multiple workers"
    } ]
  }, {
    "tStartMs": 1035930,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "with either severe lung scarring"
    } ]
  }, {
    "tStartMs": 1038150,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "or more concerningly,"
    } ]
  }, {
    "tStartMs": 1039350,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "an extremely rare cancer\ncalled mesothelioma."
    } ]
  }, {
    "tStartMs": 1042860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- A mesothelioma is strongly associated"
    } ]
  }, {
    "tStartMs": 1046220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "with asbestos exposure"
    } ]
  }, {
    "tStartMs": 1047750,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and is cancer of those\ncells lining the inside"
    } ]
  }, {
    "tStartMs": 1051530,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "of the chest cavity."
    } ]
  }, {
    "tStartMs": 1052520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And most commonly, it's\nthis pleural cavity."
    } ]
  }, {
    "tStartMs": 1054890,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "These pleural membranes are\naligned with mesothelial cells."
    } ]
  }, {
    "tStartMs": 1059000,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Sometimes what happens is the\nfibers will work their way out"
    } ]
  }, {
    "tStartMs": 1063020,
    "dDurationMs": 3747,
    "segs": [ {
      "utf8": "of the lung tissue and directly\nget into this cavity here,"
    } ]
  }, {
    "tStartMs": 1066767,
    "dDurationMs": 2646,
    "segs": [ {
      "utf8": "and they can literally\npierce out the lungs."
    } ]
  }, {
    "tStartMs": 1070610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- They cause constant irritation."
    } ]
  }, {
    "tStartMs": 1072410,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And over time, that can\ntrigger cancerous changes"
    } ]
  }, {
    "tStartMs": 1075290,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "in the cells that make up those linings."
    } ]
  }, {
    "tStartMs": 1080330,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Selikoff needed more data\nto understand the scale"
    } ]
  }, {
    "tStartMs": 1082640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of the problem, but factory owners refused"
    } ]
  }, {
    "tStartMs": 1085220,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "to share medical records\nfrom their workers with him."
    } ]
  }, {
    "tStartMs": 1088430,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So Selikoff had to get creative."
    } ]
  }, {
    "tStartMs": 1091070,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "See, during World War II,\nmany shipyard workers employed"
    } ]
  }, {
    "tStartMs": 1094460,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "by the Navy underwent\nfederal background checks."
    } ]
  }, {
    "tStartMs": 1097610,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Thousands of these men had\nbeen working with asbestos"
    } ]
  }, {
    "tStartMs": 1100280,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to insulate ships."
    } ]
  }, {
    "tStartMs": 1101780,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So using surviving FBI\nwartime personnel records,"
    } ]
  }, {
    "tStartMs": 1105680,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Selikoff began tracking them down"
    } ]
  }, {
    "tStartMs": 1108230,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and one by one painstakingly\npieced together"
    } ]
  }, {
    "tStartMs": 1111260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "their medical histories."
    } ]
  }, {
    "tStartMs": 1113000,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "What emerged wasn't a handful\nof isolated tragedies,"
    } ]
  }, {
    "tStartMs": 1117110,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it was a pattern,"
    } ]
  }, {
    "tStartMs": 1118970,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "that exposure proved\ndeadlier than combat itself."
    } ]
  }, {
    "tStartMs": 1123230,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "8.6 out of every 1,000\nservicemen were killed in action,"
    } ]
  }, {
    "tStartMs": 1127610,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "whereas 14 out of every\n1,000 shipyard workers"
    } ]
  }, {
    "tStartMs": 1130910,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "later died from asbestos-related cancers."
    } ]
  }, {
    "tStartMs": 1135410,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Selikoff launched a formal investigation"
    } ]
  }, {
    "tStartMs": 1137420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "into hundreds of asbestos\ninsulation workers,"
    } ]
  }, {
    "tStartMs": 1140150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and what he found confirmed his fears,"
    } ]
  }, {
    "tStartMs": 1142700,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "widespread disabling asbestosis,"
    } ]
  }, {
    "tStartMs": 1145340,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "dozens of cases of mesothelioma,"
    } ]
  }, {
    "tStartMs": 1147410,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "lung cancer rates roughly\nseven times higher"
    } ]
  }, {
    "tStartMs": 1150080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "than expected"
    } ]
  }, {
    "tStartMs": 1150913,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "and a threefold increase in\ngastrointestinal cancers."
    } ]
  }, {
    "tStartMs": 1154100,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In 1964, he organized a\nconference at the New York Academy"
    } ]
  }, {
    "tStartMs": 1157460,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of Sciences where for the first time,"
    } ]
  }, {
    "tStartMs": 1159800,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "all this evidence was presented\npublicly in one place,"
    } ]
  }, {
    "tStartMs": 1162770,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and on the record, it marked\nthe moment when asbestos"
    } ]
  }, {
    "tStartMs": 1165710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "stopped being seen as a\nmodern miracle material"
    } ]
  }, {
    "tStartMs": 1168500,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and instead started being recognized"
    } ]
  }, {
    "tStartMs": 1170450,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "as a public health crisis."
    } ]
  }, {
    "tStartMs": 1175820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But the asbestos industry fought back"
    } ]
  }, {
    "tStartMs": 1177680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "trying to discredit Selikoff."
    } ]
  }, {
    "tStartMs": 1179450,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Industry-funded research groups came out"
    } ]
  }, {
    "tStartMs": 1181280,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "with papers minimizing\nthe risk of exposure"
    } ]
  }, {
    "tStartMs": 1183590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and framing Selikoff's\nfindings as overblown."
    } ]
  }, {
    "tStartMs": 1186800,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "They started a coordinated\nPR effort to discredit him,"
    } ]
  }, {
    "tStartMs": 1190250,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "trying to call him alarmist,"
    } ]
  }, {
    "tStartMs": 1192230,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and starting a rumor that\nhe wasn't even a real doctor"
    } ]
  }, {
    "tStartMs": 1195020,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "just because he got his\nmedical degree out in Scotland."
    } ]
  }, {
    "tStartMs": 1198650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But Selikoff kept going."
    } ]
  }, {
    "tStartMs": 1200870,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "He kept publishing data on\nthe devastating health effects"
    } ]
  }, {
    "tStartMs": 1203840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "of asbestos exposure,"
    } ]
  }, {
    "tStartMs": 1205190,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "he worked 18 hour days\ndocumenting every patient"
    } ]
  }, {
    "tStartMs": 1209030,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "who wrote to him."
    } ]
  }, {
    "tStartMs": 1209930,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "He contacted policymakers,\neven world leaders,"
    } ]
  }, {
    "tStartMs": 1213110,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "urging them to take\naction against asbestos."
    } ]
  }, {
    "tStartMs": 1217340,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- Now Selikoff, the legendary doctor"
    } ]
  }, {
    "tStartMs": 1221300,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "who organized this conference in the 1970s"
    } ]
  }, {
    "tStartMs": 1224690,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "found that intravenous drugs\nwere being contaminated"
    } ]
  }, {
    "tStartMs": 1227900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "by asbestos filtration."
    } ]
  }, {
    "tStartMs": 1229580,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "People aren't just eating it"
    } ]
  }, {
    "tStartMs": 1230660,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "and breathing it, they're mainlining it."
    } ]
  }, {
    "tStartMs": 1234410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- By the 1970s, no one\ncould deny it any longer,"
    } ]
  }, {
    "tStartMs": 1237260,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "miners, factory workers,\nshipyard insulators,"
    } ]
  }, {
    "tStartMs": 1240380,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "people who'd been exposed decades earlier"
    } ]
  }, {
    "tStartMs": 1242570,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "during the asbestos\nboom, were now turning up"
    } ]
  }, {
    "tStartMs": 1245030,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "with multiple cancers in huge numbers."
    } ]
  }, {
    "tStartMs": 1248000,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- Asbestos exposure is linked"
    } ]
  }, {
    "tStartMs": 1250010,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to all sorts of different cancers."
    } ]
  }, {
    "tStartMs": 1251720,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "The lung tissue has\nlymphatic vessels in it,"
    } ]
  }, {
    "tStartMs": 1254233,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "but you have 'em\nthroughout your whole body."
    } ]
  }, {
    "tStartMs": 1256520,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The asbestos fibers sometimes on their own"
    } ]
  }, {
    "tStartMs": 1258890,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "can migrate into the lymphatic vessels."
    } ]
  }, {
    "tStartMs": 1261950,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Sometimes the white\nblood cells will take it"
    } ]
  }, {
    "tStartMs": 1264380,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "into the lymphatic system."
    } ]
  }, {
    "tStartMs": 1265970,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Once you hit the lymphatic\nsystem, you have the potential"
    } ]
  }, {
    "tStartMs": 1269060,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "to go anywhere in the human body."
    } ]
  }, {
    "tStartMs": 1272000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Gregor] Autopsies have found fibers"
    } ]
  }, {
    "tStartMs": 1273500,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "in nearly every organ in the body,"
    } ]
  }, {
    "tStartMs": 1275810,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the brain, bone marrow,\nspleen, intestines, pancreas,"
    } ]
  }, {
    "tStartMs": 1279380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "prostate, ovaries, thyroid, and liver."
    } ]
  }, {
    "tStartMs": 1282410,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And in every tissue those fibers reach,"
    } ]
  }, {
    "tStartMs": 1285200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "they set off the same chain reaction."
    } ]
  }, {
    "tStartMs": 1287570,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- I'm imagining these white\nblood cells with personalities,"
    } ]
  }, {
    "tStartMs": 1290330,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and they get all mad and frustrated"
    } ]
  }, {
    "tStartMs": 1291740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "because they can't engulf\nthis asbestos fiber."
    } ]
  }, {
    "tStartMs": 1294380,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "They've coined this\nterm called essentially,"
    } ]
  }, {
    "tStartMs": 1296600,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "frustrated phagocytosis."
    } ]
  }, {
    "tStartMs": 1298610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "They start releasing these things"
    } ]
  }, {
    "tStartMs": 1300290,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "like reactive oxygen species."
    } ]
  }, {
    "tStartMs": 1302180,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They can cause damage\nto surrounding cells,"
    } ]
  }, {
    "tStartMs": 1304820,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and really important is damage to DNA."
    } ]
  }, {
    "tStartMs": 1308720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Those cells can start\ndividing out of control"
    } ]
  }, {
    "tStartMs": 1310940,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "when they start to clump together,"
    } ]
  }, {
    "tStartMs": 1312050,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "and we start to call those\nclumps of cells cancer."
    } ]
  }, {
    "tStartMs": 1315770,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- US courts were flooded with lawsuits"
    } ]
  }, {
    "tStartMs": 1317630,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "against companies like Johns-Manville."
    } ]
  }, {
    "tStartMs": 1319400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The harm asbestos caused\nwas well documented."
    } ]
  }, {
    "tStartMs": 1322160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The information was out there."
    } ]
  }, {
    "tStartMs": 1323660,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Companies should have known\ntheir products were dangerous."
    } ]
  }, {
    "tStartMs": 1326720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- They should know what's\nreasonably available"
    } ]
  }, {
    "tStartMs": 1329420,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "in the public domain about\nthe dangers of asbestos."
    } ]
  }, {
    "tStartMs": 1332900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If they can read asbestos patents,"
    } ]
  }, {
    "tStartMs": 1335330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "they can read asbestos pathology papers."
    } ]
  }, {
    "tStartMs": 1338180,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- But the companies denied it."
    } ]
  }, {
    "tStartMs": 1339830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "What was needed was definitive evidence"
    } ]
  }, {
    "tStartMs": 1341900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that the companies knew their products"
    } ]
  }, {
    "tStartMs": 1343790,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "were killing their workers."
    } ]
  }, {
    "tStartMs": 1347510,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Then an attorney, Carl Ash,"
    } ]
  }, {
    "tStartMs": 1349520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "noticed something strange\nin the 1974 report"
    } ]
  }, {
    "tStartMs": 1352130,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "by this huge asbestos company\ncalled Raybestos Manhattan."
    } ]
  }, {
    "tStartMs": 1355670,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "See, in this report, the company suggested"
    } ]
  }, {
    "tStartMs": 1357950,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that they had actually been\ninvestigating health hazards"
    } ]
  }, {
    "tStartMs": 1360380,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "of asbestos since the 1930s."
    } ]
  }, {
    "tStartMs": 1362990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So Ash started digging."
    } ]
  }, {
    "tStartMs": 1364850,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "He filed a request for internal documents,"
    } ]
  }, {
    "tStartMs": 1367460,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and at first, the company\nclaimed it couldn't find much."
    } ]
  }, {
    "tStartMs": 1371210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Then unexpectedly,"
    } ]
  }, {
    "tStartMs": 1372770,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Ash was handed a banker's box\nstuffed full of documents,"
    } ]
  }, {
    "tStartMs": 1376520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "meticulously kept by\nRaybestos Manhattan's,"
    } ]
  }, {
    "tStartMs": 1378920,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "former president, Sumner Simpson."
    } ]
  }, {
    "tStartMs": 1383180,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Back in 1935, a journal contacted Simpson"
    } ]
  }, {
    "tStartMs": 1386990,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "because they wanted to write\nan article about asbestosis."
    } ]
  }, {
    "tStartMs": 1389750,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Shortly after, Simpson himself reached out"
    } ]
  }, {
    "tStartMs": 1392270,
    "dDurationMs": 3457,
    "segs": [ {
      "utf8": "to Johns-Manville's lawyer,\nVandiver Brown, saying,"
    } ]
  }, {
    "tStartMs": 1395727,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "\"I think the less said about asbestos,"
    } ]
  }, {
    "tStartMs": 1397610,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "the better off we are.\""
    } ]
  }, {
    "tStartMs": 1398690,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "To which Brown replied,\n\"I quite agree with you"
    } ]
  }, {
    "tStartMs": 1401030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "that our interests are best served"
    } ]
  }, {
    "tStartMs": 1402680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "by having asbestosis receive\nthe minimum of publicity.\""
    } ]
  }, {
    "tStartMs": 1406520,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The same papers also revealed\nthat in the 1930s, Raybestos"
    } ]
  }, {
    "tStartMs": 1409940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and Johns-Manville hired\nan external company,"
    } ]
  }, {
    "tStartMs": 1412880,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Saranac Laboratories, to do\nstudies of asbestos on animals."
    } ]
  }, {
    "tStartMs": 1416210,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But the companies insisted on controlling"
    } ]
  }, {
    "tStartMs": 1418550,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "what from those studies\nwill be made public."
    } ]
  }, {
    "tStartMs": 1421070,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "As a letter from Vandiver points out,"
    } ]
  }, {
    "tStartMs": 1423027,
    "dDurationMs": 1403,
    "segs": [ {
      "utf8": "\"It is our further understanding"
    } ]
  }, {
    "tStartMs": 1424430,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that the results will be\nconsidered the property of those"
    } ]
  }, {
    "tStartMs": 1427160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "who are advancing the required funds,"
    } ]
  }, {
    "tStartMs": 1429110,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "who will determine whether, to what extent"
    } ]
  }, {
    "tStartMs": 1431240,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and in what manner they\nshall be made public.\""
    } ]
  }, {
    "tStartMs": 1433820,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "A clause to which Saranac\nLaboratories said, \"Yes.\""
    } ]
  }, {
    "tStartMs": 1436850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But after their lead researcher"
    } ]
  }, {
    "tStartMs": 1438590,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "who was compiling all this\nevidence died in 1946,"
    } ]
  }, {
    "tStartMs": 1441830,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the companies agreed that\nnothing should be published"
    } ]
  }, {
    "tStartMs": 1444290,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that contained any objectionable material."
    } ]
  }, {
    "tStartMs": 1446600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Objectionable meaning\nany sort of indication"
    } ]
  }, {
    "tStartMs": 1449540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that asbestos causes cancer."
    } ]
  }, {
    "tStartMs": 1451130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So when Saranac Laboratories\nfinished their research,"
    } ]
  }, {
    "tStartMs": 1453230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the companies took the report, edited it,"
    } ]
  }, {
    "tStartMs": 1455780,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and just buried the evidence."
    } ]
  }, {
    "tStartMs": 1457190,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Here's an original copy\nof that manuscript,"
    } ]
  }, {
    "tStartMs": 1459710,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and you can find whole\nsections just crossed out."
    } ]
  }, {
    "tStartMs": 1463070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Other documents were even more damaging."
    } ]
  }, {
    "tStartMs": 1464960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "A Johns-Manville medical\nofficial later testified"
    } ]
  }, {
    "tStartMs": 1467840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that up until 1971, the\ncompany had a policy"
    } ]
  }, {
    "tStartMs": 1470960,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "of not telling their workers\nif their physicals showed signs"
    } ]
  }, {
    "tStartMs": 1474290,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "of asbestosis or\nasbestos-related lung cancers."
    } ]
  }, {
    "tStartMs": 1477920,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "And in sworn testimony,"
    } ]
  }, {
    "tStartMs": 1479090,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "a witness recalled a meeting\nthey had in the early 1940s"
    } ]
  }, {
    "tStartMs": 1482660,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "with the president of Johns-Manville,"
    } ]
  }, {
    "tStartMs": 1484790,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "asking why they weren't\nwarning workers about asbestos."
    } ]
  }, {
    "tStartMs": 1488360,
    "dDurationMs": 2017,
    "segs": [ {
      "utf8": "As the witness recalls it, they asked,"
    } ]
  }, {
    "tStartMs": 1490377,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "\"Do you mean to tell me\nyou would let them work"
    } ]
  }, {
    "tStartMs": 1492500,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "until they dropped dead?\""
    } ]
  }, {
    "tStartMs": 1494090,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "To which the president replied,"
    } ]
  }, {
    "tStartMs": 1495807,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "\"Yes, we save a lot of money that way.\""
    } ]
  }, {
    "tStartMs": 1500540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Once the Sumner Simpson papers got out,"
    } ]
  }, {
    "tStartMs": 1502130,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "they unlocked a new industrial Watergate."
    } ]
  }, {
    "tStartMs": 1504650,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The industry's standard, \"Oh,\nwe didn't know,\" defense,"
    } ]
  }, {
    "tStartMs": 1507650,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it simply fell apart."
    } ]
  }, {
    "tStartMs": 1509090,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Comparisons were made to\nbig tobacco's concealment"
    } ]
  }, {
    "tStartMs": 1511610,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "of smoking risks."
    } ]
  }, {
    "tStartMs": 1513080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And the lawsuits surged,"
    } ]
  }, {
    "tStartMs": 1515090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "each case brought new discovery"
    } ]
  }, {
    "tStartMs": 1517070,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and each round of\ndiscovery exposed a wider,"
    } ]
  }, {
    "tStartMs": 1519770,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "more coordinated coverup."
    } ]
  }, {
    "tStartMs": 1521487,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "(files thunking)\n(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1523730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Ever since the word asbestosis"
    } ]
  }, {
    "tStartMs": 1525500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "started showing up in medical\njournals in the 1920s,"
    } ]
  }, {
    "tStartMs": 1528350,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Johns-Manville went out to\nsecure the market around itself."
    } ]
  }, {
    "tStartMs": 1531710,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "First, they acquired the\nbiggest rock wall company,"
    } ]
  }, {
    "tStartMs": 1534920,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "then they acquired a firm\nholding the key patents"
    } ]
  }, {
    "tStartMs": 1537770,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to calcium silicate insulation,"
    } ]
  }, {
    "tStartMs": 1539480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "insulation that could be\nmade without asbestos."
    } ]
  }, {
    "tStartMs": 1541760,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Now, at the same time,"
    } ]
  }, {
    "tStartMs": 1543290,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "companies that had non asbestos insulation"
    } ]
  }, {
    "tStartMs": 1545540,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "were incentivized into creating\nasbestos product lines."
    } ]
  }, {
    "tStartMs": 1549470,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "With each acquisition or inducement,"
    } ]
  }, {
    "tStartMs": 1551630,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "another potential\ncompetitor lost the ability"
    } ]
  }, {
    "tStartMs": 1553730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "to denounce asbestos"
    } ]
  }, {
    "tStartMs": 1555020,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and say, \"Oh, we have an\nasbestos-free product.\""
    } ]
  }, {
    "tStartMs": 1558200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So each in turn became a member"
    } ]
  }, {
    "tStartMs": 1560450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of this conspiracy of silence."
    } ]
  }, {
    "tStartMs": 1562760,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "That is how the asbestos\nindustry guaranteed its survival,"
    } ]
  }, {
    "tStartMs": 1565940,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "by ensuring no one could\nspeak out against it."
    } ]
  }, {
    "tStartMs": 1568940,
    "dDurationMs": 2847,
    "segs": [ {
      "utf8": "- [Narrator] We suggest\nyou consider asbestos"
    } ]
  }, {
    "tStartMs": 1571787,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "for the walls of your home."
    } ]
  }, {
    "tStartMs": 1574220,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Their business decisions"
    } ]
  }, {
    "tStartMs": 1575960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and the people who make\nthem are businessmen."
    } ]
  }, {
    "tStartMs": 1578210,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "I mean, the word morality"
    } ]
  }, {
    "tStartMs": 1579470,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "or moral obligation is almost non-existent"
    } ]
  }, {
    "tStartMs": 1583190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "in the corporate documents."
    } ]
  }, {
    "tStartMs": 1584990,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- In 1982, Johns-Manville filed\nfor bankruptcy protection."
    } ]
  }, {
    "tStartMs": 1588950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Manville Corporation's board\nof directors has determined"
    } ]
  }, {
    "tStartMs": 1591830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that the corporation should file"
    } ]
  }, {
    "tStartMs": 1593510,
    "dDurationMs": 3843,
    "segs": [ {
      "utf8": "for reorganization under chapter\n11 of the Bankruptcy Act."
    } ]
  }, {
    "tStartMs": 1598190,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Not because they were broke,"
    } ]
  }, {
    "tStartMs": 1599390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but in a move widely seen as a way"
    } ]
  }, {
    "tStartMs": 1601250,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "to shield the company from a\nflood of asbestos lawsuits."
    } ]
  }, {
    "tStartMs": 1605540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Despite all the evidence against them,"
    } ]
  }, {
    "tStartMs": 1607220,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Johns-Manville survived."
    } ]
  }, {
    "tStartMs": 1608930,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "They continue operating to this day,"
    } ]
  }, {
    "tStartMs": 1611120,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "although they no longer produce asbestos."
    } ]
  }, {
    "tStartMs": 1614900,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Between 1940 and 1980,"
    } ]
  }, {
    "tStartMs": 1617360,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the asbestos industry,\nled by Johns-Manville,"
    } ]
  }, {
    "tStartMs": 1620390,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "exposed roughly 21 million\nAmericans to these fibers."
    } ]
  }, {
    "tStartMs": 1624650,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Asbestos related deaths\namounted to at least 8"
    } ]
  }, {
    "tStartMs": 1627230,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to 10,000 people every year,"
    } ]
  }, {
    "tStartMs": 1629540,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "with many more suffering lifelong disease."
    } ]
  }, {
    "tStartMs": 1634190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "In 1989, the EPA issued a rule"
    } ]
  }, {
    "tStartMs": 1636590,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to phase out almost all asbestos\nuse in the United States."
    } ]
  }, {
    "tStartMs": 1640010,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "And that should have been\nthe end of the story."
    } ]
  }, {
    "tStartMs": 1644390,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But the industry sued immediately,"
    } ]
  }, {
    "tStartMs": 1646520,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "not because anyone disputed\nasbestos causes cancer,"
    } ]
  }, {
    "tStartMs": 1650210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that was undeniable by this point,"
    } ]
  }, {
    "tStartMs": 1652160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but because of a legal technicality,"
    } ]
  }, {
    "tStartMs": 1654260,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "see, under the law,"
    } ]
  }, {
    "tStartMs": 1655610,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the EPA had to prove that an outright ban"
    } ]
  }, {
    "tStartMs": 1658220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of asbestos was the only solution."
    } ]
  }, {
    "tStartMs": 1660050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And that anything less than\nthat just wouldn't cut it."
    } ]
  }, {
    "tStartMs": 1663020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This was an almost impossible feat."
    } ]
  }, {
    "tStartMs": 1665420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Now, the industry argued\nthat they hadn't done that,"
    } ]
  }, {
    "tStartMs": 1668030,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and unfortunately the US courts agreed."
    } ]
  }, {
    "tStartMs": 1670100,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So in 1991, they ruled that the EPA"
    } ]
  }, {
    "tStartMs": 1672860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "just hadn't met this\nnarrow legal standard."
    } ]
  }, {
    "tStartMs": 1675140,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "And with that, the asbestos\nban was dead in the water."
    } ]
  }, {
    "tStartMs": 1679490,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But by then, asbestos\nhad become so financially"
    } ]
  }, {
    "tStartMs": 1682550,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and legally risky for the\ncompanies that manufactured it"
    } ]
  }, {
    "tStartMs": 1685460,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "or used it, that its overall\nuse did actually decline."
    } ]
  }, {
    "tStartMs": 1689240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Yet in the end, after\nyears of trying to define"
    } ]
  }, {
    "tStartMs": 1692360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and regulate asbestos,"
    } ]
  }, {
    "tStartMs": 1693860,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the only thing that truly stuck around"
    } ]
  }, {
    "tStartMs": 1695660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "was a definition and a narrow one."
    } ]
  }, {
    "tStartMs": 1698120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Chrysotile and five amphiboles,"
    } ]
  }, {
    "tStartMs": 1700280,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "because these were the only\nones being mined, sold,"
    } ]
  }, {
    "tStartMs": 1702740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and used in factories."
    } ]
  }, {
    "tStartMs": 1704360,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "But those six became the\nofficial asbestos minerals"
    } ]
  }, {
    "tStartMs": 1707570,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and anything else, no\nmatter how fiber-like"
    } ]
  }, {
    "tStartMs": 1710000,
    "dDurationMs": 3316,
    "segs": [ {
      "utf8": "or potentially dangerous,\nwell, that doesn't count."
    } ]
  }, {
    "tStartMs": 1713316,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1719120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- [Reporter] The FDA for\nthe first time in 50 years,"
    } ]
  }, {
    "tStartMs": 1722480,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "considering testing for\nasbestos in cosmetics"
    } ]
  }, {
    "tStartMs": 1725450,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "and talc powder."
    } ]
  }, {
    "tStartMs": 1726440,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- [Reporter] Traces of it"
    } ]
  }, {
    "tStartMs": 1727430,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "have now been detected\nin children's play sand."
    } ]
  }, {
    "tStartMs": 1730670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Thousands of people are claiming"
    } ]
  }, {
    "tStartMs": 1732530,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that they developed\nvarious forms of cancer"
    } ]
  }, {
    "tStartMs": 1734960,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "after years of using Johnson\nand Johnson's baby powder."
    } ]
  }, {
    "tStartMs": 1738770,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Is this all the stuff\nthat you've collected"
    } ]
  }, {
    "tStartMs": 1740270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "over the years?"
    } ]
  }, {
    "tStartMs": 1741103,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "- No, it's not all of it,"
    } ]
  }, {
    "tStartMs": 1742490,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "but this box is full of all\nthe Claire's-labeled products"
    } ]
  }, {
    "tStartMs": 1748310,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "that I found asbestos in."
    } ]
  }, {
    "tStartMs": 1749810,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Everything little girls\ncould possibly want to have"
    } ]
  }, {
    "tStartMs": 1752540,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "their makeup in."
    } ]
  }, {
    "tStartMs": 1754610,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Like, oh, I don't know, how\nabout sparkly boxes, right?"
    } ]
  }, {
    "tStartMs": 1758210,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Yeah.\n- And there's a cell phone."
    } ]
  }, {
    "tStartMs": 1760700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Yes.\n- With eye shadows on it."
    } ]
  }, {
    "tStartMs": 1762980,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Yeah.\n- There's asbestos in there."
    } ]
  }, {
    "tStartMs": 1765290,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "There's asbestos in the unicorn."
    } ]
  }, {
    "tStartMs": 1766850,
    "dDurationMs": 2117,
    "segs": [ {
      "utf8": "- It's in all of that?\n- Yes."
    } ]
  }, {
    "tStartMs": 1768967,
    "dDurationMs": 2206,
    "segs": [ {
      "utf8": "All of these have asbestos in them."
    } ]
  }, {
    "tStartMs": 1773420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I started seeing asbestos\nfibers everywhere."
    } ]
  }, {
    "tStartMs": 1775520,
    "dDurationMs": 1753,
    "segs": [ {
      "utf8": "Everywhere, okay."
    } ]
  }, {
    "tStartMs": 1777273,
    "dDurationMs": 3377,
    "segs": [ {
      "utf8": "The eyeshadows, the blush,\nthey all had asbestos fibers."
    } ]
  }, {
    "tStartMs": 1780650,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "Alright, wow. okay."
    } ]
  }, {
    "tStartMs": 1785840,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- What year was this?\n- 2017."
    } ]
  }, {
    "tStartMs": 1788420,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Gregor] What?"
    } ]
  }, {
    "tStartMs": 1789253,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "- 2017."
    } ]
  }, {
    "tStartMs": 1790250,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "- [Gregor] I thought it was\ngonna be like 1980 or something."
    } ]
  }, {
    "tStartMs": 1793230,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "What, 2017?"
    } ]
  }, {
    "tStartMs": 1794690,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Yes.\n- Whoa."
    } ]
  }, {
    "tStartMs": 1796370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- And the manufacturer came\nback and said, \"There's no way.\""
    } ]
  }, {
    "tStartMs": 1799190,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "And they sponsored another laboratory"
    } ]
  }, {
    "tStartMs": 1801890,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to look at the same samples."
    } ]
  }, {
    "tStartMs": 1804530,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And they said, \"No, none of\nthis counts as asbestos.\""
    } ]
  }, {
    "tStartMs": 1807500,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It's all cleavage fragments,"
    } ]
  }, {
    "tStartMs": 1809390,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "or CPLA, clay or something like that."
    } ]
  }, {
    "tStartMs": 1812300,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And it was balderdash, right?"
    } ]
  }, {
    "tStartMs": 1814010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I called friends all across the States"
    } ]
  }, {
    "tStartMs": 1816110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and said, \"Hey, do you have\na Claire's store near you?\""
    } ]
  }, {
    "tStartMs": 1819200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Can you find the sparkly box? Right."
    } ]
  }, {
    "tStartMs": 1822200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And send it to me, pronto."
    } ]
  }, {
    "tStartMs": 1824600,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "There's Claire's in all,\nin all of the malls,"
    } ]
  }, {
    "tStartMs": 1827090,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "all across America."
    } ]
  }, {
    "tStartMs": 1828020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And then I look further and\nit's all over the world."
    } ]
  }, {
    "tStartMs": 1830300,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I mean, every mall, everywhere."
    } ]
  }, {
    "tStartMs": 1833030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And I end up testing Claire's from Brazil"
    } ]
  }, {
    "tStartMs": 1834980,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "to Japan to London, I found asbestos,"
    } ]
  }, {
    "tStartMs": 1839780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- No way.\n- Right."
    } ]
  }, {
    "tStartMs": 1841820,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So that turned into a huge story, right?"
    } ]
  }, {
    "tStartMs": 1844760,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "And now I don't think\nyou can buy very much"
    } ]
  }, {
    "tStartMs": 1848300,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "talc-based cosmetics at Claire's now,"
    } ]
  }, {
    "tStartMs": 1851750,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "but it was a several-years-long battle."
    } ]
  }, {
    "tStartMs": 1855994,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 1867620,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "These are different products\nthat were sold at toy stores."
    } ]
  }, {
    "tStartMs": 1872540,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Like here's the secret spy kit."
    } ]
  }, {
    "tStartMs": 1875030,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And you see there's a\nfingerprint kit there, right?"
    } ]
  }, {
    "tStartMs": 1877910,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And in that fingerprint kit was a powder"
    } ]
  }, {
    "tStartMs": 1881390,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "in which I found asbestos fibers."
    } ]
  }, {
    "tStartMs": 1884570,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Say It Ain't So Mickey Mouse crayons."
    } ]
  }, {
    "tStartMs": 1886970,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "No!\n- I found asbestos in those."
    } ]
  }, {
    "tStartMs": 1890927,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "- And this keeps happening."
    } ]
  }, {
    "tStartMs": 1892370,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Just a couple of months ago,\naround 70 schools in Australia"
    } ]
  }, {
    "tStartMs": 1895340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and New Zealand had to close down"
    } ]
  }, {
    "tStartMs": 1897020,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "because of the asbestos found\nin children's play sand."
    } ]
  }, {
    "tStartMs": 1900650,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Out of the 60 outlets that\nreported on this story,"
    } ]
  }, {
    "tStartMs": 1903320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "only 24% were from right-leaning sources."
    } ]
  }, {
    "tStartMs": 1906140,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Depending on where you get your news,"
    } ]
  }, {
    "tStartMs": 1907880,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "this might have never crossed\nyour radar, which is a problem"
    } ]
  }, {
    "tStartMs": 1910670,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "because public health\ninformation like this"
    } ]
  }, {
    "tStartMs": 1912830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "shouldn't fall through the cracks."
    } ]
  }, {
    "tStartMs": 1914510,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And this is why we've asked Ground News"
    } ]
  }, {
    "tStartMs": 1916280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to sponsor this video."
    } ]
  }, {
    "tStartMs": 1917720,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "They compile news from\noutlets all over the world"
    } ]
  }, {
    "tStartMs": 1920330,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "into one place so that you can\neasily see the partisan split"
    } ]
  }, {
    "tStartMs": 1923720,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and with their color-coded layout,"
    } ]
  }, {
    "tStartMs": 1925250,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "it's also easy to sort your\nnews by factuality, ownership"
    } ]
  }, {
    "tStartMs": 1928760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and source so that you can see"
    } ]
  }, {
    "tStartMs": 1930440,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "how a story like this is\ngetting covered side by side"
    } ]
  }, {
    "tStartMs": 1933260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "with all the context you need."
    } ]
  }, {
    "tStartMs": 1934880,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Take these two headlines for example,"
    } ]
  }, {
    "tStartMs": 1936680,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "this article from the \"Herald Sun\""
    } ]
  }, {
    "tStartMs": 1938330,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "only talks about the fear of asbestos,"
    } ]
  }, {
    "tStartMs": 1940700,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "while this very high\nfactuality source firmly states"
    } ]
  }, {
    "tStartMs": 1943610,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "that asbestos was found\nin decorative sand,"
    } ]
  }, {
    "tStartMs": 1946730,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "that difference matters,"
    } ]
  }, {
    "tStartMs": 1947870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I would like to know whether the concern"
    } ]
  }, {
    "tStartMs": 1949670,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "is over a mere suspicion or\nactual asbestos contamination,"
    } ]
  }, {
    "tStartMs": 1953600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and that's why I find\nGround News so useful."
    } ]
  }, {
    "tStartMs": 1955760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "You get the full picture,"
    } ]
  }, {
    "tStartMs": 1957200,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "not just one headline\nsensationalizing for clicks."
    } ]
  }, {
    "tStartMs": 1960020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And they also have a\ndedicated blind spot feed"
    } ]
  }, {
    "tStartMs": 1962300,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "for stories like these that are, you know,"
    } ]
  }, {
    "tStartMs": 1964010,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "disproportionately covered by either side"
    } ]
  }, {
    "tStartMs": 1965960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of the political spectrum,"
    } ]
  }, {
    "tStartMs": 1967400,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "all to help people avoid\ntheir echo chambers."
    } ]
  }, {
    "tStartMs": 1970250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, we partnered up with Ground News"
    } ]
  }, {
    "tStartMs": 1972380,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because we share the same\nmission, getting to the truth,"
    } ]
  }, {
    "tStartMs": 1975260,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and that's why we're offering\n40% off their vantage plan"
    } ]
  }, {
    "tStartMs": 1978590,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "at ground.news/ve."
    } ]
  }, {
    "tStartMs": 1981080,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So if you wanna support the channel,"
    } ]
  }, {
    "tStartMs": 1982970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but also want a clearer\nunderstanding of the world,"
    } ]
  }, {
    "tStartMs": 1985760,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "check out that link in the description,"
    } ]
  }, {
    "tStartMs": 1987380,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or you can also scan this QR code."
    } ]
  }, {
    "tStartMs": 1989720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So I wanna thank Ground News"
    } ]
  }, {
    "tStartMs": 1991040,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "for sponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 1992930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and now let's go figure out"
    } ]
  }, {
    "tStartMs": 1994580,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "why asbestos is even getting"
    } ]
  }, {
    "tStartMs": 1996200,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "into all these consumer products."
    } ]
  }, {
    "tStartMs": 1998210,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Now, no one is intentionally\nputting asbestos in makeup"
    } ]
  }, {
    "tStartMs": 2001360,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "or kids' toys,"
    } ]
  }, {
    "tStartMs": 2002710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "so how did something we know is deadly"
    } ]
  }, {
    "tStartMs": 2005380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "just end up everywhere?"
    } ]
  }, {
    "tStartMs": 2007480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Well, it's an unfortunate consequence"
    } ]
  }, {
    "tStartMs": 2009400,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of where asbestos forms"
    } ]
  }, {
    "tStartMs": 2011230,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "and nowhere makes that more\nclear than Libby, Montana."
    } ]
  }, {
    "tStartMs": 2016000,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "- It kind of breaks my\nheart to talk about it."
    } ]
  }, {
    "tStartMs": 2020530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The mine up there is vermiculite mine."
    } ]
  }, {
    "tStartMs": 2022450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It's about five six miles north."
    } ]
  }, {
    "tStartMs": 2024490,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Vermiculite is a mineral"
    } ]
  }, {
    "tStartMs": 2025660,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "that is used in everything"
    } ]
  }, {
    "tStartMs": 2026830,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "from insulation to\nfireproofing to potting soil."
    } ]
  }, {
    "tStartMs": 2030280,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "On its own, it's harmless."
    } ]
  }, {
    "tStartMs": 2032350,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The problem was, Libby's vermiculite"
    } ]
  }, {
    "tStartMs": 2034420,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "formed mixed in with\naffable asbestos fibers."
    } ]
  }, {
    "tStartMs": 2038450,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "And the same thing happens\nwith other minerals we mine,"
    } ]
  }, {
    "tStartMs": 2041320,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "including stuff like talc."
    } ]
  }, {
    "tStartMs": 2043870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That's how asbestos ends up in products"
    } ]
  }, {
    "tStartMs": 2045790,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "like the ones we saw at Sean's lab."
    } ]
  }, {
    "tStartMs": 2049090,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And the worst part, the company that owned"
    } ]
  }, {
    "tStartMs": 2051370,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and operated the mine,\nW.R. Grace, they knew,"
    } ]
  }, {
    "tStartMs": 2054910,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "they knew the ore contained asbestos."
    } ]
  }, {
    "tStartMs": 2056830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "They knew people were getting sick"
    } ]
  }, {
    "tStartMs": 2058420,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and they didn't warn the town."
    } ]
  }, {
    "tStartMs": 2060190,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "In fact, they tried to cover\nit up for almost 30 years."
    } ]
  }, {
    "tStartMs": 2065020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- They had hundreds of workers in there."
    } ]
  }, {
    "tStartMs": 2067270,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And of course, when the\nminers would go home,"
    } ]
  }, {
    "tStartMs": 2069520,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "they had dust all over their clothes,"
    } ]
  }, {
    "tStartMs": 2071290,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and their kids and their\nwives got it and died as well."
    } ]
  }, {
    "tStartMs": 2074620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But the doctors up around Libby,"
    } ]
  }, {
    "tStartMs": 2076360,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "they knew, boy did they know."
    } ]
  }, {
    "tStartMs": 2078910,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Besides the lung disease"
    } ]
  }, {
    "tStartMs": 2080050,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and cancer's long associated\nwith asbestos exposure,"
    } ]
  }, {
    "tStartMs": 2083080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "researchers were also finding rates"
    } ]
  }, {
    "tStartMs": 2085000,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of some autoimmune diseases\nwere nearly six times higher"
    } ]
  }, {
    "tStartMs": 2088060,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "than the national average."
    } ]
  }, {
    "tStartMs": 2089380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And by the time the Libby situation"
    } ]
  }, {
    "tStartMs": 2091240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "hit the headlines in 1999,"
    } ]
  }, {
    "tStartMs": 2093340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "reporters documented nearly 200 deaths"
    } ]
  }, {
    "tStartMs": 2096310,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "in a town of fewer than 3,000."
    } ]
  }, {
    "tStartMs": 2098467,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "- And it could take 20 years for it to go,"
    } ]
  }, {
    "tStartMs": 2100420,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but pretty soon you have no breath at all"
    } ]
  }, {
    "tStartMs": 2103210,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and you die of asphyxiation."
    } ]
  }, {
    "tStartMs": 2105100,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I could tell I'm talking on\nthe phone by somebody's voice,"
    } ]
  }, {
    "tStartMs": 2108670,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "how far along they were toward death,"
    } ]
  }, {
    "tStartMs": 2111490,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "because none of 'em survived."
    } ]
  }, {
    "tStartMs": 2113230,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Finally, in 2009,"
    } ]
  }, {
    "tStartMs": 2114640,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "the EPA declared a public\nhealth emergency in Libby,"
    } ]
  }, {
    "tStartMs": 2117970,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "calling it \"The worst case\nof industrial poisoning"
    } ]
  }, {
    "tStartMs": 2120280,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "of a community in US history.\""
    } ]
  }, {
    "tStartMs": 2123010,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "- But Libby's just the tip of the iceberg,"
    } ]
  }, {
    "tStartMs": 2126550,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- Because for decades, W.R.\nGrace shipped Libby vermiculite"
    } ]
  }, {
    "tStartMs": 2129850,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "around the country,"
    } ]
  }, {
    "tStartMs": 2131020,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and with it, deadly affable asbestos,"
    } ]
  }, {
    "tStartMs": 2133990,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "which ended up in millions\nof homes as attic insulation."
    } ]
  }, {
    "tStartMs": 2138310,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And Grace also made a fireproof spray"
    } ]
  }, {
    "tStartMs": 2140350,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "that was used on the steel\nframes of high-rise buildings."
    } ]
  }, {
    "tStartMs": 2143890,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "By 1970, over half of\nthe multi-story buildings"
    } ]
  }, {
    "tStartMs": 2146860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "erected in the United States\nused this fireproof spray,"
    } ]
  }, {
    "tStartMs": 2150280,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "including the World Trade Center."
    } ]
  }, {
    "tStartMs": 2153400,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "But this spray was actually\nmarketed as asbestos-free."
    } ]
  }, {
    "tStartMs": 2157450,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "According to a later investigation\nby the \"New York Times,\""
    } ]
  }, {
    "tStartMs": 2160600,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Grace lobbied regulators"
    } ]
  }, {
    "tStartMs": 2162310,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "to adopt a threshold under\nwhich products containing less"
    } ]
  }, {
    "tStartMs": 2165370,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "than 1% of asbestos\nwould not be regulated."
    } ]
  }, {
    "tStartMs": 2168610,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Grace argued that the danger"
    } ]
  }, {
    "tStartMs": 2170110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of such small amounts had not been proved."
    } ]
  }, {
    "tStartMs": 2172690,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "This became known as the\n1% rule or the Grace Rule."
    } ]
  }, {
    "tStartMs": 2176500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "That decision didn't\njust affect the products"
    } ]
  }, {
    "tStartMs": 2179020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "from Libby's mine,"
    } ]
  }, {
    "tStartMs": 2180280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "it reshaped how asbestos\nwas detected, regulated,"
    } ]
  }, {
    "tStartMs": 2183970,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "and ignored everywhere."
    } ]
  }, {
    "tStartMs": 2186447,
    "dDurationMs": 3991,
    "segs": [ {
      "utf8": "(building roaring)\n(sirens wailing)"
    } ]
  }, {
    "tStartMs": 2190438,
    "dDurationMs": 2094,
    "segs": [ {
      "utf8": "- [Speaker] Oh my God!\n(people chattering)"
    } ]
  }, {
    "tStartMs": 2192532,
    "dDurationMs": 1189,
    "segs": [ {
      "utf8": "- [Speaker] Look at the shadow of death!"
    } ]
  }, {
    "tStartMs": 2193721,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "- [Speaker] Oh my God!"
    } ]
  }, {
    "tStartMs": 2195430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- Okay, when that went down, I knew it."
    } ]
  }, {
    "tStartMs": 2197590,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "I knew they had asbestos,\nand so I started calling."
    } ]
  }, {
    "tStartMs": 2200200,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I said, \"What do you,"
    } ]
  }, {
    "tStartMs": 2201850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "how are you gonna protect people from that"
    } ]
  }, {
    "tStartMs": 2203950,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "'cause now that stuff's\nall over the place."
    } ]
  }, {
    "tStartMs": 2205540,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You saw the dust clouds, right?\""
    } ]
  }, {
    "tStartMs": 2207520,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- [Gregor] September 11th became\nthe largest real world test"
    } ]
  }, {
    "tStartMs": 2210850,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "of asbestos detection following\na single catastrophic event."
    } ]
  }, {
    "tStartMs": 2214690,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- The dust is so thick you can't see."
    } ]
  }, {
    "tStartMs": 2216790,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- When the EPA began sampling the dust"
    } ]
  }, {
    "tStartMs": 2218740,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and analyzing it, they chose a\nmethod we use back at the lab"
    } ]
  }, {
    "tStartMs": 2221740,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "called polarized light microscopy or PLM."
    } ]
  }, {
    "tStartMs": 2224583,
    "dDurationMs": 2887,
    "segs": [ {
      "utf8": "But the PLM has two major limitations."
    } ]
  }, {
    "tStartMs": 2227470,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "First, it's struggles to detect asbestos"
    } ]
  }, {
    "tStartMs": 2229600,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "if it's less than 1% by\nweight in the sample,"
    } ]
  }, {
    "tStartMs": 2232930,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and second, it can only see the fibers"
    } ]
  }, {
    "tStartMs": 2235420,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that are roughly longer\nthan about five micrometers"
    } ]
  }, {
    "tStartMs": 2238330,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or wider than about a\nquarter of a micrometer."
    } ]
  }, {
    "tStartMs": 2241690,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "As a result, the smallest"
    } ]
  }, {
    "tStartMs": 2243310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and oftentimes the most dangerous fibers,"
    } ]
  }, {
    "tStartMs": 2245440,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "like the ones pulverized during\nthe collapse of the towers,"
    } ]
  }, {
    "tStartMs": 2248380,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "are difficult to detect\nusing just the PLM."
    } ]
  }, {
    "tStartMs": 2252033,
    "dDurationMs": 1087,
    "segs": [ {
      "utf8": "To reliably find these,"
    } ]
  }, {
    "tStartMs": 2253120,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "you need transmission\nelectron microscopy or TEM."
    } ]
  }, {
    "tStartMs": 2257080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Sean] Where we top out\nof about a thousand times"
    } ]
  }, {
    "tStartMs": 2258940,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "with electro, with light microscopy,"
    } ]
  }, {
    "tStartMs": 2260710,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "this tops out at about a million times."
    } ]
  }, {
    "tStartMs": 2264370,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "But what we need to see is\njust what are the finest fibers"
    } ]
  }, {
    "tStartMs": 2268900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that potentially can go into your lung."
    } ]
  }, {
    "tStartMs": 2271330,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Gregor] Without having used a TEM,"
    } ]
  }, {
    "tStartMs": 2273280,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the EPA declared New York's air safe."
    } ]
  }, {
    "tStartMs": 2276220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Everything we've tested for,"
    } ]
  }, {
    "tStartMs": 2277870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which includes asbestos, lead,"
    } ]
  }, {
    "tStartMs": 2279790,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and VOCs have been below\nany level of concern"
    } ]
  }, {
    "tStartMs": 2283120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "for the general public health."
    } ]
  }, {
    "tStartMs": 2286240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Gregor] But some researchers after 911"
    } ]
  }, {
    "tStartMs": 2288280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "actually did do studies with TEM."
    } ]
  }, {
    "tStartMs": 2290890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They found asbestos levels"
    } ]
  }, {
    "tStartMs": 2292330,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "far above the EPA's own safety thresholds"
    } ]
  }, {
    "tStartMs": 2294850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in most of their samples."
    } ]
  }, {
    "tStartMs": 2296440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And the report also warned that"
    } ]
  }, {
    "tStartMs": 2298240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "because many of these fibers"
    } ]
  }, {
    "tStartMs": 2299680,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "were actually smaller than normal,"
    } ]
  }, {
    "tStartMs": 2301540,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "they were especially dangerous."
    } ]
  }, {
    "tStartMs": 2303910,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "They posted the results"
    } ]
  }, {
    "tStartMs": 2305080,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "on the American Industrial\nHygiene Association website,"
    } ]
  }, {
    "tStartMs": 2308110,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but within hours, their post disappeared."
    } ]
  }, {
    "tStartMs": 2311470,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Less than 24 hours later,"
    } ]
  }, {
    "tStartMs": 2313300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the researchers were notified\nthey been taken off the job"
    } ]
  }, {
    "tStartMs": 2316240,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and were no longer\nrequired at Ground Zero."
    } ]
  }, {
    "tStartMs": 2319210,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "One former EPA chief\ninvestigator later went on CBS"
    } ]
  }, {
    "tStartMs": 2322600,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "saying they believe the\nagency had deliberately used"
    } ]
  }, {
    "tStartMs": 2326020,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "the wrong testing methods\nand downplayed the danger."
    } ]
  }, {
    "tStartMs": 2330040,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "- New York City directly\nlied about the test results"
    } ]
  }, {
    "tStartMs": 2334390,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "for asbestos in air."
    } ]
  }, {
    "tStartMs": 2335890,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "When they finally released\nthem, they doctored the result."
    } ]
  }, {
    "tStartMs": 2340360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- We don't know if that's\ntrue, but to be clear,"
    } ]
  }, {
    "tStartMs": 2342550,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "PLM is still widely\nused to detect asbestos"
    } ]
  }, {
    "tStartMs": 2345130,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "because it's faster, it's\ncheaper, it's easier to deploy."
    } ]
  }, {
    "tStartMs": 2348880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But what we do know is two things."
    } ]
  }, {
    "tStartMs": 2350830,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "First, the PLM method\nwas not sensitive enough"
    } ]
  }, {
    "tStartMs": 2353680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to detect whether there\nwere asbestos fibers"
    } ]
  }, {
    "tStartMs": 2355720,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in the dust at Ground Zero."
    } ]
  }, {
    "tStartMs": 2357370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And second, the EPA did have other,"
    } ]
  }, {
    "tStartMs": 2360040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "more sensitive methods available to them."
    } ]
  }, {
    "tStartMs": 2362770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Whatever the motives,\nthe result was the same."
    } ]
  }, {
    "tStartMs": 2365140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "New Yorkers were told"
    } ]
  }, {
    "tStartMs": 2366340,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that the air was safe\nwhen it really wasn't."
    } ]
  }, {
    "tStartMs": 2369010,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "And as of December, 2023,"
    } ]
  }, {
    "tStartMs": 2371213,
    "dDurationMs": 3557,
    "segs": [ {
      "utf8": "6,781 of those who have been registered"
    } ]
  }, {
    "tStartMs": 2374770,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "with the World Trade Center\nHealth Program have died"
    } ]
  }, {
    "tStartMs": 2377770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "either of an illness or a cancer"
    } ]
  }, {
    "tStartMs": 2380170,
    "dDurationMs": 3038,
    "segs": [ {
      "utf8": "linked just to their time\nbeing around Ground Zero."
    } ]
  }, {
    "tStartMs": 2383208,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "(suspenseful music)\n(sirens wailing)"
    } ]
  }, {
    "tStartMs": 2387880,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But even if the EPA had used the TEM,"
    } ]
  }, {
    "tStartMs": 2390070,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "the answer would still not be simple"
    } ]
  }, {
    "tStartMs": 2392050,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "because even then researchers\nrun into a more basic problem."
    } ]
  }, {
    "tStartMs": 2396040,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "What actually counts as asbestos?"
    } ]
  }, {
    "tStartMs": 2399190,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Is there asbestos in the air?"
    } ]
  }, {
    "tStartMs": 2400510,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Is there asbestos in the soil?"
    } ]
  }, {
    "tStartMs": 2401890,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Is there asbestos in the water?"
    } ]
  }, {
    "tStartMs": 2403210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Is there asbestos in the body?"
    } ]
  }, {
    "tStartMs": 2405010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "All of those counting\nrules are based on fibers"
    } ]
  }, {
    "tStartMs": 2407980,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that are not super-long,"
    } ]
  }, {
    "tStartMs": 2410110,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "but they're way longer than\nthe vast majority of say,"
    } ]
  }, {
    "tStartMs": 2414580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Libby amphibole fibers"
    } ]
  }, {
    "tStartMs": 2416380,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and the vast majority of\nfibers that are inhaled."
    } ]
  }, {
    "tStartMs": 2420460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So they're not even counting those,"
    } ]
  }, {
    "tStartMs": 2423100,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "they're not even looking for them."
    } ]
  }, {
    "tStartMs": 2425770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The ways that we are right now"
    } ]
  }, {
    "tStartMs": 2428290,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "telling people whether\nthey're being exposed or not"
    } ]
  }, {
    "tStartMs": 2430960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "is a lie!"
    } ]
  }, {
    "tStartMs": 2432460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- [Gregor] And when longer fibers break"
    } ]
  }, {
    "tStartMs": 2434350,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "forming these so-called\ncleavage fragments,"
    } ]
  }, {
    "tStartMs": 2436731,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "they don't count either."
    } ]
  }, {
    "tStartMs": 2437564,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "- Yeah, there's a whole effort to say,"
    } ]
  }, {
    "tStartMs": 2439637,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "\"Oh yeah, if it's been\nbroken, it's not dangerous.\""
    } ]
  }, {
    "tStartMs": 2443440,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But there are so many\npapers out there that show"
    } ]
  }, {
    "tStartMs": 2445390,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that if you put pure\ncleavage fragments into mice,"
    } ]
  }, {
    "tStartMs": 2448030,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "they get very, very sick."
    } ]
  }, {
    "tStartMs": 2450580,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Gregor] This really matters"
    } ]
  }, {
    "tStartMs": 2451630,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "when you're in a place like this"
    } ]
  }, {
    "tStartMs": 2453070,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and you realize the dust"
    } ]
  }, {
    "tStartMs": 2454150,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "could be considered asbestos-contaminated"
    } ]
  }, {
    "tStartMs": 2456430,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "under one definition,"
    } ]
  }, {
    "tStartMs": 2457780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and perfectly safe under another."
    } ]
  }, {
    "tStartMs": 2460120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- [Researcher] Nobody would've\nexpected to find asbestos here."
    } ]
  }, {
    "tStartMs": 2463720,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Gregor] To be clear,"
    } ]
  }, {
    "tStartMs": 2464770,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "there were no asbestos mines in Nevada,"
    } ]
  }, {
    "tStartMs": 2467530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "no industrial sites,"
    } ]
  }, {
    "tStartMs": 2468820,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "no history of asbestos\ncommercial use at all."
    } ]
  }, {
    "tStartMs": 2471730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But geologists, Brenda Buck"
    } ]
  }, {
    "tStartMs": 2473560,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and Rod Metcalf found asbestos\nspread across approximately"
    } ]
  }, {
    "tStartMs": 2477070,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "1 million acres outside Las Vegas."
    } ]
  }, {
    "tStartMs": 2481570,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- [Rod] Geologic processes\ntransport these materials."
    } ]
  }, {
    "tStartMs": 2484780,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And you know, before the erosion started,"
    } ]
  }, {
    "tStartMs": 2487420,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "they were just in the bedrocks\nalong the mountain front."
    } ]
  }, {
    "tStartMs": 2490870,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Now they're in sediments down\nthey're, in the stream here."
    } ]
  }, {
    "tStartMs": 2494890,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Brenda] And the problem"
    } ]
  }, {
    "tStartMs": 2495723,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "with the naturally\noccurring stuff like this is"
    } ]
  }, {
    "tStartMs": 2497860,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "it may be only a small\npercentage in the rock"
    } ]
  }, {
    "tStartMs": 2500950,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and even a smaller percentage in the soil,"
    } ]
  }, {
    "tStartMs": 2503560,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but this stuff gets in the air."
    } ]
  }, {
    "tStartMs": 2505510,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Gregor] Entire communities\nmight be breathing it in"
    } ]
  }, {
    "tStartMs": 2507910,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and getting sick without knowing."
    } ]
  }, {
    "tStartMs": 2510040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So Brenda and Rod tried to warn people."
    } ]
  }, {
    "tStartMs": 2512770,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Back in late 2012, they\ncompiled all of their findings"
    } ]
  }, {
    "tStartMs": 2515770,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "for a presentation"
    } ]
  }, {
    "tStartMs": 2516670,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "at the Conference of the\nGeological Society of America."
    } ]
  }, {
    "tStartMs": 2519790,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But before the conference even began,"
    } ]
  }, {
    "tStartMs": 2521590,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the abstract caught the\nattention of a journalist"
    } ]
  }, {
    "tStartMs": 2524350,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "who reported on the story,"
    } ]
  }, {
    "tStartMs": 2526360,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and that's when the pushback started."
    } ]
  }, {
    "tStartMs": 2529060,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Soon the state of Nevada sent\na cease and desist letter,"
    } ]
  }, {
    "tStartMs": 2532510,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and officials questioned\nBrenda and Rod's methods."
    } ]
  }, {
    "tStartMs": 2535870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- So if you go to Las Vegas,\nyou're gonna get exposed"
    } ]
  }, {
    "tStartMs": 2538240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to asbestos that they\ndidn't want that out there."
    } ]
  }, {
    "tStartMs": 2540340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- Every time I drove into Boulder City,"
    } ]
  }, {
    "tStartMs": 2542920,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "there was an official\ntailing me within a minute."
    } ]
  }, {
    "tStartMs": 2546607,
    "dDurationMs": 3873,
    "segs": [ {
      "utf8": "- The message was clear,\ndon't look any further."
    } ]
  }, {
    "tStartMs": 2550480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Well, we did decide to look further."
    } ]
  }, {
    "tStartMs": 2552490,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So we drove out into the desert"
    } ]
  }, {
    "tStartMs": 2554500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to a popular off-roading spot"
    } ]
  }, {
    "tStartMs": 2556690,
    "dDurationMs": 2387,
    "segs": [ {
      "utf8": "to test whether there really is asbestos"
    } ]
  }, {
    "tStartMs": 2559077,
    "dDurationMs": 2653,
    "segs": [ {
      "utf8": "in the dust around Las Vegas."
    } ]
  }, {
    "tStartMs": 2561730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Okay, I'm strapped into a dune buggy here."
    } ]
  }, {
    "tStartMs": 2563620,
    "dDurationMs": 1456,
    "segs": [ {
      "utf8": "I'm going to go down in that basin,"
    } ]
  }, {
    "tStartMs": 2565076,
    "dDurationMs": 3194,
    "segs": [ {
      "utf8": "and Sean's strapped up\nsome dust collectors"
    } ]
  }, {
    "tStartMs": 2568270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "with receivers in my breathing zone"
    } ]
  }, {
    "tStartMs": 2570550,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "so we can actually figure out"
    } ]
  }, {
    "tStartMs": 2571630,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "how much asbestos I would be inhaling"
    } ]
  }, {
    "tStartMs": 2573430,
    "dDurationMs": 2174,
    "segs": [ {
      "utf8": "through the dust that I kick up."
    } ]
  }, {
    "tStartMs": 2575604,
    "dDurationMs": 3738,
    "segs": [ {
      "utf8": "(dune buggy engine spluttering)"
    } ]
  }, {
    "tStartMs": 2579342,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(tires roaring)\n(soft rock music)"
    } ]
  }, {
    "tStartMs": 2585817,
    "dDurationMs": 1849,
    "segs": [ {
      "utf8": "(Gregor laughing)"
    } ]
  }, {
    "tStartMs": 2587666,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Woo!"
    } ]
  }, {
    "tStartMs": 2594034,
    "dDurationMs": 856,
    "segs": [ {
      "utf8": "You see those donuts, huh?"
    } ]
  }, {
    "tStartMs": 2594890,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "- [Sean] Yeah, yeah, you were\nripping it up down there."
    } ]
  }, {
    "tStartMs": 2597040,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Gregor] Yeah, from a\ngeological point of view,"
    } ]
  }, {
    "tStartMs": 2599320,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "any notes?"
    } ]
  }, {
    "tStartMs": 2600400,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- It rained today."
    } ]
  }, {
    "tStartMs": 2601300,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I thought about that while I was watching,"
    } ]
  }, {
    "tStartMs": 2602650,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I was like, \"There\nmight not be much dust,\""
    } ]
  }, {
    "tStartMs": 2604390,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but these are the air samples"
    } ]
  }, {
    "tStartMs": 2606070,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "that were hanging in your\nbreathing room, right?"
    } ]
  }, {
    "tStartMs": 2607330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes, yeah, yeah."
    } ]
  }, {
    "tStartMs": 2608163,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- And I looked at them"
    } ]
  }, {
    "tStartMs": 2608996,
    "dDurationMs": 1484,
    "segs": [ {
      "utf8": "and the filters have some tanning on them."
    } ]
  }, {
    "tStartMs": 2610480,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Oh, that's good."
    } ]
  }, {
    "tStartMs": 2611530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Which means we actually\ndid get some dust."
    } ]
  }, {
    "tStartMs": 2613840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "We don't know what's in it yet,"
    } ]
  }, {
    "tStartMs": 2615670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but there's something in there."
    } ]
  }, {
    "tStartMs": 2617530,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- But the original plan was for us"
    } ]
  }, {
    "tStartMs": 2618760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to actually do this at the dry lake bed"
    } ]
  }, {
    "tStartMs": 2620920,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "just outside Boulder City,"
    } ]
  }, {
    "tStartMs": 2622270,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "because this is where\npeople do the majority"
    } ]
  }, {
    "tStartMs": 2624370,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "of their off-roading,"
    } ]
  }, {
    "tStartMs": 2625360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you know, they camp, they do photo shoots,"
    } ]
  }, {
    "tStartMs": 2626950,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "even take their wedding photos,"
    } ]
  }, {
    "tStartMs": 2629170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "except not on the day that we were there."
    } ]
  }, {
    "tStartMs": 2631000,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Okay, we're out here on the\ndry lake bed, supposedly"
    } ]
  }, {
    "tStartMs": 2635410,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "in Las Vegas, where on the\none day that we're here,"
    } ]
  }, {
    "tStartMs": 2639310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the lake has decided not to be dry"
    } ]
  }, {
    "tStartMs": 2641320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in any sort of definition."
    } ]
  }, {
    "tStartMs": 2643240,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh my God."
    } ]
  }, {
    "tStartMs": 2644073,
    "dDurationMs": 2647,
    "segs": [ {
      "utf8": "And so what we're gonna go do is suit up,"
    } ]
  }, {
    "tStartMs": 2646720,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "get some samples,"
    } ]
  }, {
    "tStartMs": 2647650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and figure out how much asbestos"
    } ]
  }, {
    "tStartMs": 2649420,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "there really is in this stuff."
    } ]
  }, {
    "tStartMs": 2652162,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(suspenseful music)\n(people softly chattering)"
    } ]
  }, {
    "tStartMs": 2657706,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "- [Sean] Okay."
    } ]
  }, {
    "tStartMs": 2663160,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "We're gonna do a third."
    } ]
  }, {
    "tStartMs": 2664120,
    "dDurationMs": 2205,
    "segs": [ {
      "utf8": "Let's go out to that island."
    } ]
  }, {
    "tStartMs": 2666325,
    "dDurationMs": 2655,
    "segs": [ {
      "utf8": "(suspenseful music continues)"
    } ]
  }, {
    "tStartMs": 2668980,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 2670480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Okay, got the samples."
    } ]
  }, {
    "tStartMs": 2672610,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "Next step, take 'em to the lab."
    } ]
  }, {
    "tStartMs": 2675980,
    "dDurationMs": 2058,
    "segs": [ {
      "utf8": "(car door thunks)"
    } ]
  }, {
    "tStartMs": 2678038,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 2679840,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "- Great to see you guys again."
    } ]
  }, {
    "tStartMs": 2682106,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, good to see you too."
    } ]
  }, {
    "tStartMs": 2682939,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "Well, we are here for one thing I suppose,"
    } ]
  }, {
    "tStartMs": 2685780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "like what kind of results did we get?"
    } ]
  }, {
    "tStartMs": 2688360,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "- Now the big reveal, drum roll please."
    } ]
  }, {
    "tStartMs": 2693130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I did the dune buggy air samples first."
    } ]
  }, {
    "tStartMs": 2695890,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Those samples that you had on your left"
    } ]
  }, {
    "tStartMs": 2697510,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and right shoulders,"
    } ]
  }, {
    "tStartMs": 2698800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I didn't find any asbestos fibers."
    } ]
  }, {
    "tStartMs": 2701260,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Okay, well, I guess\nthat's a bit of a relief."
    } ]
  }, {
    "tStartMs": 2702940,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "I'm glad we did the demonstration"
    } ]
  }, {
    "tStartMs": 2704590,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and I'm kind of glad\nwe didn't find anything"
    } ]
  }, {
    "tStartMs": 2706570,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "because I'm pretty sure I took\nmy mask off at a few points."
    } ]
  }, {
    "tStartMs": 2709090,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- I've been in those shoes,\nlike, we didn't find anything."
    } ]
  }, {
    "tStartMs": 2712240,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Oh, but wait a minute,"
    } ]
  }, {
    "tStartMs": 2713950,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I was breathing that (beep). (laughing)"
    } ]
  }, {
    "tStartMs": 2717040,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Exactly. (chuckling)"
    } ]
  }, {
    "tStartMs": 2718750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So what about the samples\nin the dry lake bed?"
    } ]
  }, {
    "tStartMs": 2721420,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "- Ah, another drum roll."
    } ]
  }, {
    "tStartMs": 2725680,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- Okay.\n- I found amphibole asbestos."
    } ]
  }, {
    "tStartMs": 2728770,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Wow, okay."
    } ]
  }, {
    "tStartMs": 2730180,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- It's there. It is there."
    } ]
  }, {
    "tStartMs": 2732760,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I counted up a number of fibers,"
    } ]
  }, {
    "tStartMs": 2735220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the area of the filter they analyzed,"
    } ]
  }, {
    "tStartMs": 2737560,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and I figured out that we had between 30"
    } ]
  }, {
    "tStartMs": 2741220,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and 50 million asbestos\nstructures per gram of mud"
    } ]
  }, {
    "tStartMs": 2750430,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "that we were walking through."
    } ]
  }, {
    "tStartMs": 2751480,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Whoa."
    } ]
  }, {
    "tStartMs": 2753333,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "Just to think that we pulled\noff to the side of the road,"
    } ]
  }, {
    "tStartMs": 2756430,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "walked what, 30 meters,\ntook three samples,"
    } ]
  }, {
    "tStartMs": 2759190,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and all of them had these\nincredibly high concentrations"
    } ]
  }, {
    "tStartMs": 2762130,
    "dDurationMs": 1095,
    "segs": [ {
      "utf8": "of asbestos right there,"
    } ]
  }, {
    "tStartMs": 2763225,
    "dDurationMs": 1132,
    "segs": [ {
      "utf8": "it's not like we had to go out and find."
    } ]
  }, {
    "tStartMs": 2764357,
    "dDurationMs": 1193,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 2765550,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Very wet soil was lucky for us"
    } ]
  }, {
    "tStartMs": 2769960,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "because we know there's\nasbestos in that soil."
    } ]
  }, {
    "tStartMs": 2773290,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Now think about the guys"
    } ]
  }, {
    "tStartMs": 2774700,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that go taking their jeep across there"
    } ]
  }, {
    "tStartMs": 2776590,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "when it is a dry lake."
    } ]
  }, {
    "tStartMs": 2778690,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- I mean, that was our initial plan"
    } ]
  }, {
    "tStartMs": 2780310,
    "dDurationMs": 2097,
    "segs": [ {
      "utf8": "to do the dune bugging there."
    } ]
  }, {
    "tStartMs": 2782407,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "And I can't like help"
    } ]
  }, {
    "tStartMs": 2783640,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but think about people drive\ndown that road all the time."
    } ]
  }, {
    "tStartMs": 2786070,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "They must pull over,\nthey must go down there,"
    } ]
  }, {
    "tStartMs": 2788140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "like just kick dust and rocks and-"
    } ]
  }, {
    "tStartMs": 2790480,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Sean] We know they do. We know they do."
    } ]
  }, {
    "tStartMs": 2792970,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- And there's no sign to tell you"
    } ]
  }, {
    "tStartMs": 2795040,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "that there's anything\nwrong with the dry lake."
    } ]
  }, {
    "tStartMs": 2799660,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "It's not like we, you\nknow, discovered this,"
    } ]
  }, {
    "tStartMs": 2801733,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "this has been available data since-"
    } ]
  }, {
    "tStartMs": 2805300,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "- [Sean] October of 2013 is\nthe actual publication date"
    } ]
  }, {
    "tStartMs": 2808930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "of naturally occurring asbestos,"
    } ]
  }, {
    "tStartMs": 2810820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "potential for human exposure"
    } ]
  }, {
    "tStartMs": 2812260,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "in Southern Nevada by Brenda Buck et al."
    } ]
  }, {
    "tStartMs": 2816940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- So 13 years we've had this data."
    } ]
  }, {
    "tStartMs": 2818770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It's not like we'd rediscovered anything."
    } ]
  }, {
    "tStartMs": 2820870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- And that's the other\nthing that's really hard"
    } ]
  }, {
    "tStartMs": 2822250,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "about this science."
    } ]
  }, {
    "tStartMs": 2823630,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "You need the public to be aware,"
    } ]
  }, {
    "tStartMs": 2825520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but you don't want to terrify them."
    } ]
  }, {
    "tStartMs": 2827440,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "And so how do you find the right way?"
    } ]
  }, {
    "tStartMs": 2831190,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Gregor] This will potentially be seen"
    } ]
  }, {
    "tStartMs": 2832390,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "by tens of millions of people."
    } ]
  }, {
    "tStartMs": 2833740,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So is there a message you want to get out?"
    } ]
  }, {
    "tStartMs": 2836350,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- This is a natural hazard,"
    } ]
  }, {
    "tStartMs": 2839740,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "just like a lot of things in your life,"
    } ]
  }, {
    "tStartMs": 2841870,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "it's really good for\npeople to know whether"
    } ]
  }, {
    "tStartMs": 2844150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "or not their house is in\na flooding zone, right?"
    } ]
  }, {
    "tStartMs": 2846610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's really good to know\nabout earthquake risks."
    } ]
  }, {
    "tStartMs": 2849010,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "It's really good to know about\nhurricanes and tornadoes."
    } ]
  }, {
    "tStartMs": 2852340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Well, this is just another natural hazard,"
    } ]
  }, {
    "tStartMs": 2855370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and if you have the information,"
    } ]
  }, {
    "tStartMs": 2857320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "then you can make better decisions\nto live a healthier life."
    } ]
  }, {
    "tStartMs": 2861668,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 2875500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Gregor] One big problem"
    } ]
  }, {
    "tStartMs": 2876333,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "is that asbestos in the real world"
    } ]
  }, {
    "tStartMs": 2878110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "doesn't line up with how it's regulated."
    } ]
  }, {
    "tStartMs": 2880480,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Take this fiber,"
    } ]
  }, {
    "tStartMs": 2881710,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it comes from a sample\nof the same blue asbestos"
    } ]
  }, {
    "tStartMs": 2884470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "from the site outside Las Vegas"
    } ]
  }, {
    "tStartMs": 2886240,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "we visited at the start of the video."
    } ]
  }, {
    "tStartMs": 2888430,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- [Sean] I think we have\ntwo different phases,"
    } ]
  }, {
    "tStartMs": 2891160,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "at least of amphibole here"
    } ]
  }, {
    "tStartMs": 2894190,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "because if it's yellow\nin this orientation,"
    } ]
  }, {
    "tStartMs": 2896920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but also blue in this orientation\nin the same fiber bundle,"
    } ]
  }, {
    "tStartMs": 2900280,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "then we have a change in\nthe phase from here to here."
    } ]
  }, {
    "tStartMs": 2906100,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "- [Gregor] So this one fiber\nis actually two minerals."
    } ]
  }, {
    "tStartMs": 2909910,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And that complexity shows\nup in its structure too,"
    } ]
  }, {
    "tStartMs": 2912880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "under the electron microscope,"
    } ]
  }, {
    "tStartMs": 2914560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "one side could meet the\ndefinition of asbestos,"
    } ]
  }, {
    "tStartMs": 2917170,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the other may not simply\nbecause of its shape."
    } ]
  }, {
    "tStartMs": 2919780,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "So one single fiber could fall\nwithin one of the six named"
    } ]
  }, {
    "tStartMs": 2923860,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and regulated asbestos minerals\nif you look at one side,"
    } ]
  }, {
    "tStartMs": 2927130,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "but the other would be\ncompletely unregulated."
    } ]
  }, {
    "tStartMs": 2930910,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "Your lungs don't care about\nthese categories, though."
    } ]
  }, {
    "tStartMs": 2934450,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- [Narrator] The asbestos fiber,\nyou'll find it everywhere."
    } ]
  }, {
    "tStartMs": 2937690,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "No ordinary rock, no single rock indeed,"
    } ]
  }, {
    "tStartMs": 2941560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but a group of related minerals"
    } ]
  }, {
    "tStartMs": 2943180,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "with characteristics in\ncommon, but in varying degrees,"
    } ]
  }, {
    "tStartMs": 2946570,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- Most experts will say,"
    } ]
  }, {
    "tStartMs": 2947987,
    "dDurationMs": 3473,
    "segs": [ {
      "utf8": "\"Asbestos isn't a mineral\nor a geologic term,"
    } ]
  }, {
    "tStartMs": 2951460,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "it's a commercial one,\"\nbut that's symbolics."
    } ]
  }, {
    "tStartMs": 2956260,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Why do I say that? Because it's\nnot just a commercial term."
    } ]
  }, {
    "tStartMs": 2961390,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "We now know that asbestos can kill you."
    } ]
  }, {
    "tStartMs": 2963850,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So if we're gonna say that,"
    } ]
  }, {
    "tStartMs": 2965080,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "we have to define it based on\nhealth effect, and we don't."
    } ]
  }, {
    "tStartMs": 2968980,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Gregor] So what are we\nactually doing about it?"
    } ]
  }, {
    "tStartMs": 2970960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The system was so complex,\nit was so burdensome"
    } ]
  }, {
    "tStartMs": 2973300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "that our country hasn't even\nbeen able to uphold a ban"
    } ]
  }, {
    "tStartMs": 2977560,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "on asbestos, a known\ncarcinogen that kills as many"
    } ]
  }, {
    "tStartMs": 2981730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "as 10,000 Americans every year."
    } ]
  }, {
    "tStartMs": 2984400,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- [Gregor] Well, in 2016,"
    } ]
  }, {
    "tStartMs": 2985360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Congress did try to\nfix this broken system."
    } ]
  }, {
    "tStartMs": 2987880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "They passed an amendment\ngiving the EPA new power"
    } ]
  }, {
    "tStartMs": 2990460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to evaluate and restrict\ndangerous chemicals,"
    } ]
  }, {
    "tStartMs": 2993040,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "including asbestos."
    } ]
  }, {
    "tStartMs": 2995470,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- I think it's time to\nsign the Frank R. Ladenburg"
    } ]
  }, {
    "tStartMs": 2998590,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Chemical Safety for the\n21st Century Act into law."
    } ]
  }, {
    "tStartMs": 3002070,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "- [Gregor] But then\nprogress stalled, again."
    } ]
  }, {
    "tStartMs": 3006360,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Under the Trump administration,"
    } ]
  }, {
    "tStartMs": 3007950,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "efforts to strengthen asbestos\nrules slowed dramatically."
    } ]
  }, {
    "tStartMs": 3011910,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Trump had publicly praised\nasbestos for years."
    } ]
  }, {
    "tStartMs": 3014050,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "- A lot of people in my\nindustry think asbestos"
    } ]
  }, {
    "tStartMs": 3016350,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "is the greatest fireproofing\nmaterial ever, ever made!"
    } ]
  }, {
    "tStartMs": 3020310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- It wasn't until 2024"
    } ]
  }, {
    "tStartMs": 3022410,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that the US finally banned\nchrysotile asbestos."
    } ]
  }, {
    "tStartMs": 3025560,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But this ban doesn't cover"
    } ]
  }, {
    "tStartMs": 3027180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the other five types of asbestos,"
    } ]
  }, {
    "tStartMs": 3029100,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and it still allows some\nmanufacturers up to 12 years"
    } ]
  }, {
    "tStartMs": 3032070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to phase it out."
    } ]
  }, {
    "tStartMs": 3033870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It doesn't address what\nto do with asbestos"
    } ]
  }, {
    "tStartMs": 3035670,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "already in schools"
    } ]
  }, {
    "tStartMs": 3036780,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and homes and other buildings,"
    } ]
  }, {
    "tStartMs": 3038790,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "nor does it fix any of the numerous"
    } ]
  }, {
    "tStartMs": 3040560,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "classification, identification,"
    } ]
  }, {
    "tStartMs": 3042270,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and detection loopholes,"
    } ]
  }, {
    "tStartMs": 3044040,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "and it doesn't address the\nasbestos in the environment."
    } ]
  }, {
    "tStartMs": 3047790,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "On top of that, the EPA is\nalready getting sued, again."
    } ]
  }, {
    "tStartMs": 3052470,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- There have been tremendous forces"
    } ]
  }, {
    "tStartMs": 3055650,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from commercial industries"
    } ]
  }, {
    "tStartMs": 3058050,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "to make it sound like\nit's not as bad as it is,"
    } ]
  }, {
    "tStartMs": 3061620,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and to find ways to allow them"
    } ]
  }, {
    "tStartMs": 3065460,
    "dDurationMs": 2831,
    "segs": [ {
      "utf8": "to continue to use the material."
    } ]
  }, {
    "tStartMs": 3068291,
    "dDurationMs": 4489,
    "segs": [ {
      "utf8": "This is a sad, sad fact\nof our decision-making"
    } ]
  }, {
    "tStartMs": 3072780,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in our country"
    } ]
  }, {
    "tStartMs": 3073613,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "and other countries, is\nthat it's driven by money."
    } ]
  }, {
    "tStartMs": 3076170,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- But at least the United States are going"
    } ]
  }, {
    "tStartMs": 3077940,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "for some level of moderation."
    } ]
  }, {
    "tStartMs": 3079500,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Other countries are not that lucky."
    } ]
  }, {
    "tStartMs": 3081420,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "In 2019, India imported more\nthan 350,000 tons of asbestos,"
    } ]
  }, {
    "tStartMs": 3086580,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and it's predicted that\nin the upcoming decades,"
    } ]
  }, {
    "tStartMs": 3089310,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "6 million people there"
    } ]
  }, {
    "tStartMs": 3090480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "might develop asbestos-related diseases."
    } ]
  }, {
    "tStartMs": 3092850,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And similar things are happening"
    } ]
  }, {
    "tStartMs": 3094320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "in many of the other countries in Asia."
    } ]
  }, {
    "tStartMs": 3096480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "We've actually found this website"
    } ]
  }, {
    "tStartMs": 3098280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "where it looks like you\ncan just buy asbestos cloth"
    } ]
  }, {
    "tStartMs": 3101400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "made in China, but please don't."
    } ]
  }, {
    "tStartMs": 3104760,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And all of the asbestos\nthat we've already mined,"
    } ]
  }, {
    "tStartMs": 3107280,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "even after we stop using\nit, it's still out there."
    } ]
  }, {
    "tStartMs": 3110700,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Asbestos doesn't naturally\ndecay in the environment."
    } ]
  }, {
    "tStartMs": 3114330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So should you be worried?"
    } ]
  }, {
    "tStartMs": 3116460,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Well, having asbestos in your house"
    } ]
  }, {
    "tStartMs": 3119130,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "doesn't automatically\nmean that it's dangerous."
    } ]
  }, {
    "tStartMs": 3121500,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you have asbestos in your ceiling"
    } ]
  }, {
    "tStartMs": 3123330,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and you don't drill into it,\nyou're probably gonna be fine."
    } ]
  }, {
    "tStartMs": 3126240,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Asbestos is an issue if\nthe particles go airborne,"
    } ]
  }, {
    "tStartMs": 3130530,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "but who knows which house has asbestos,"
    } ]
  }, {
    "tStartMs": 3133890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "where all of that asbestos is,"
    } ]
  }, {
    "tStartMs": 3135630,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "who's gonna take care of it and how?"
    } ]
  }, {
    "tStartMs": 3137550,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So a lot of the answers to these questions"
    } ]
  }, {
    "tStartMs": 3139830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "just don't exist yet."
    } ]
  }, {
    "tStartMs": 3141690,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But if you're worried about\nasbestos exposure for yourself,"
    } ]
  }, {
    "tStartMs": 3144750,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "check out the links that\nwe've put in the description."
    } ]
  }, {
    "tStartMs": 3148980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I think a big part of the problem is"
    } ]
  }, {
    "tStartMs": 3150600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that people assume\nasbestos is a solved issue."
    } ]
  }, {
    "tStartMs": 3153540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "And I'll be the first to admit,"
    } ]
  }, {
    "tStartMs": 3154650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I fell for that line of thinking."
    } ]
  }, {
    "tStartMs": 3156420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Here's the ending I\nwrote for our PFAS video."
    } ]
  }, {
    "tStartMs": 3158820,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- We've been here before\nwith lead gasoline, Freon"
    } ]
  }, {
    "tStartMs": 3162120,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and asbestos, and each\ntime we did the research"
    } ]
  }, {
    "tStartMs": 3165210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and made the right decision\nto phase these chemicals out."
    } ]
  }, {
    "tStartMs": 3168450,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "- Yeah, I was completely oblivious."
    } ]
  }, {
    "tStartMs": 3172830,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- We will look back at our history"
    } ]
  }, {
    "tStartMs": 3174630,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and what do we do with tobacco?"
    } ]
  }, {
    "tStartMs": 3177030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Everybody was smoking, right?"
    } ]
  }, {
    "tStartMs": 3178980,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It would be improper for me"
    } ]
  }, {
    "tStartMs": 3180570,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "to not offer an ashtray"
    } ]
  }, {
    "tStartMs": 3182100,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "even if I wasn't a smoker back in the day."
    } ]
  }, {
    "tStartMs": 3184530,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And all the scientists working"
    } ]
  }, {
    "tStartMs": 3186780,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "for the big cigarette companies said,"
    } ]
  }, {
    "tStartMs": 3188617,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "\"Why, tobacco never hurt anybody.\""
    } ]
  }, {
    "tStartMs": 3190950,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But because of the outcry"
    } ]
  }, {
    "tStartMs": 3194100,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "and the recognition that\nsmoking causes disease,"
    } ]
  }, {
    "tStartMs": 3198840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "everybody knows someone who died"
    } ]
  }, {
    "tStartMs": 3200460,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "because of cigarettes, right?"
    } ]
  }, {
    "tStartMs": 3203580,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Now, you might find out that\nasbestos-related diseases"
    } ]
  }, {
    "tStartMs": 3207450,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "has touched you in some way,\nyou don't even know yet."
    } ]
  }, {
    "tStartMs": 3210690,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "I didn't know my grandfather\ndied because of asbestos,"
    } ]
  }, {
    "tStartMs": 3214740,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "that my father is dying\nmore likely than not"
    } ]
  }, {
    "tStartMs": 3218280,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "because of asbestos."
    } ]
  }, {
    "tStartMs": 3219420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Did I know that when I started"
    } ]
  }, {
    "tStartMs": 3221700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "looking at asbestos\nunder a microscope, no."
    } ]
  }, {
    "tStartMs": 3224220,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Did I know that when I changed\nthe brakes on the Jeeps"
    } ]
  }, {
    "tStartMs": 3227280,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that I ran around in, no."
    } ]
  }, {
    "tStartMs": 3228990,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Did I know that when I ran around"
    } ]
  }, {
    "tStartMs": 3230430,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "through asbestos-containing dust, no."
    } ]
  }, {
    "tStartMs": 3233910,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Now I do."
    } ]
  }, {
    "tStartMs": 3236130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Pretty much every scientist"
    } ]
  }, {
    "tStartMs": 3237510,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and journalist we spoke to for this video"
    } ]
  }, {
    "tStartMs": 3239310,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "said the same thing."
    } ]
  }, {
    "tStartMs": 3240540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This is a hard story to get out there."
    } ]
  }, {
    "tStartMs": 3242760,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "They've faced economic\npressure, political pressure,"
    } ]
  }, {
    "tStartMs": 3245670,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the research got buried,"
    } ]
  }, {
    "tStartMs": 3247140,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and some people even\nreceived death threats"
    } ]
  }, {
    "tStartMs": 3249270,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for reporting on the story."
    } ]
  }, {
    "tStartMs": 3250920,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "It is an uncomfortable topic,"
    } ]
  }, {
    "tStartMs": 3253350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but I think it's these\nuncomfortable topics"
    } ]
  }, {
    "tStartMs": 3255480,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "that matter the most,"
    } ]
  }, {
    "tStartMs": 3256380,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that have the potential\nto do the most good,"
    } ]
  }, {
    "tStartMs": 3258660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "yet they are also the ones"
    } ]
  }, {
    "tStartMs": 3260280,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that are the most uncomfortable to watch."
    } ]
  }, {
    "tStartMs": 3262650,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So I really appreciate you\nfor sticking around to the end"
    } ]
  }, {
    "tStartMs": 3265530,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and facing the truth,\nmaking yourself aware"
    } ]
  }, {
    "tStartMs": 3268200,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and becoming part of the solution."
    } ]
  }, {
    "tStartMs": 3270390,
    "dDurationMs": 3942,
    "segs": [ {
      "utf8": "So perhaps now more than\never, thank you for watching."
    } ]
  }, {
    "tStartMs": 3274332,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(screen chiming)\n(suspenseful music)"
    } ]
  } ]
}
