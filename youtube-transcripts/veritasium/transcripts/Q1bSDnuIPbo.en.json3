{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "This video is sponsored by KiwiCo,"
    } ]
  }, {
    "tStartMs": 1930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "more about them at the end of the show."
    } ]
  }, {
    "tStartMs": 5130,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "This is a picture of the\nsupermassive black hole"
    } ]
  }, {
    "tStartMs": 8170,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "at the center of our Milky Way galaxy"
    } ]
  }, {
    "tStartMs": 10680,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "known as Sagittarius A*."
    } ]
  }, {
    "tStartMs": 13170,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The black hole itself doesn't emit light"
    } ]
  }, {
    "tStartMs": 15350,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "so what we're seeing is the\nhot plasma swirling around it."
    } ]
  }, {
    "tStartMs": 19380,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "This is only the second\npicture of a black hole ever."
    } ]
  }, {
    "tStartMs": 22960,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "It was taken by the Event\nHorizon Telescope collaboration,"
    } ]
  }, {
    "tStartMs": 26300,
    "dDurationMs": 1495,
    "segs": [ {
      "utf8": "the same people who brought you this image"
    } ]
  }, {
    "tStartMs": 27795,
    "dDurationMs": 4805,
    "segs": [ {
      "utf8": "of the supermassive black hole\nat the center of galaxy M87."
    } ]
  }, {
    "tStartMs": 32600,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Now, their original plan was\nto image Sagittarius A* first."
    } ]
  }, {
    "tStartMs": 36860,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Since it's in our own galaxy,"
    } ]
  }, {
    "tStartMs": 38510,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "it is 2,000 times closer than M87*,"
    } ]
  }, {
    "tStartMs": 42610,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "but it's also over 1,000 times smaller"
    } ]
  }, {
    "tStartMs": 45523,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "so from Earth, it appears only\nslightly larger than M87*."
    } ]
  }, {
    "tStartMs": 50820,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And there are a number"
    } ]
  }, {
    "tStartMs": 52140,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "of additional challenges to observing it."
    } ]
  }, {
    "tStartMs": 56670,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "First of all, there is\na lot of dust and gas"
    } ]
  }, {
    "tStartMs": 59130,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "between us and the center of our galaxy"
    } ]
  }, {
    "tStartMs": 61860,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "so you can't even see\nit with visible light."
    } ]
  }, {
    "tStartMs": 64660,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "In this video from the\nEuropean Southern Observatory,"
    } ]
  }, {
    "tStartMs": 68200,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "we zoom in on our Galaxy's core."
    } ]
  }, {
    "tStartMs": 71980,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "As we get closer and closer,"
    } ]
  }, {
    "tStartMs": 74610,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "at some point we have to\nswitch over to infrared light"
    } ]
  }, {
    "tStartMs": 77730,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which can better penetrate the debris,"
    } ]
  }, {
    "tStartMs": 80250,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "allowing us to see it from Earth."
    } ]
  }, {
    "tStartMs": 84020,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Over the past three decades,"
    } ]
  }, {
    "tStartMs": 85750,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "we've been able to peer into\nthe heart of the Milky May"
    } ]
  }, {
    "tStartMs": 89173,
    "dDurationMs": 3227,
    "segs": [ {
      "utf8": "and witness something truly amazing."
    } ]
  }, {
    "tStartMs": 92400,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "A collection of stars zipping around"
    } ]
  }, {
    "tStartMs": 94610,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "on all kinds of eccentric orbits."
    } ]
  }, {
    "tStartMs": 97170,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "They go incredibly fast."
    } ]
  }, {
    "tStartMs": 99480,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "One of the stars was clocked"
    } ]
  }, {
    "tStartMs": 101040,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "going 24 million meters per second."
    } ]
  }, {
    "tStartMs": 104180,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "That's 8% the speed of light."
    } ]
  }, {
    "tStartMs": 107790,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "All these stars appear"
    } ]
  }, {
    "tStartMs": 108850,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "to be orbiting something\nincredibly massive and compact,"
    } ]
  }, {
    "tStartMs": 113000,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "but this object isn't\nglowing brightly like a star."
    } ]
  }, {
    "tStartMs": 116420,
    "dDurationMs": 3031,
    "segs": [ {
      "utf8": "If you watch closely, you can\nsee it flicker now and then."
    } ]
  }, {
    "tStartMs": 119451,
    "dDurationMs": 4649,
    "segs": [ {
      "utf8": "This is what we believe to\nbe a supermassive black hole."
    } ]
  }, {
    "tStartMs": 124100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "From the motion of the stars around it,"
    } ]
  }, {
    "tStartMs": 126080,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "we can infer that the black hole's mass"
    } ]
  }, {
    "tStartMs": 127840,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "is about 4 million times that of our Sun"
    } ]
  }, {
    "tStartMs": 131130,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "but all crammed down into a\ntiny point, the singularity."
    } ]
  }, {
    "tStartMs": 135730,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Anything including light that comes"
    } ]
  }, {
    "tStartMs": 137800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "within a Schwarzschild\nradius of this point"
    } ]
  }, {
    "tStartMs": 140200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "can't escape and ends\nup in the singularity."
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "So for us to see any\nradiation from the black hole,"
    } ]
  }, {
    "tStartMs": 145930,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "it must come from further out than this,"
    } ]
  }, {
    "tStartMs": 148610,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "usually from superheated\nplasma as it falls in."
    } ]
  }, {
    "tStartMs": 152600,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "But for its size,"
    } ]
  }, {
    "tStartMs": 153750,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Sagittarius A* doesn't\nconsume much matter."
    } ]
  }, {
    "tStartMs": 157130,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "It's unusually quiet and dark."
    } ]
  }, {
    "tStartMs": 159810,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "The supermassive black hole at the center"
    } ]
  }, {
    "tStartMs": 161350,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "of M87 in contrast is much more active,"
    } ]
  }, {
    "tStartMs": 164640,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "gobbling up matter from\nits accretion disk."
    } ]
  }, {
    "tStartMs": 167420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Plus, since it's over 1,000 times bigger,"
    } ]
  }, {
    "tStartMs": 170030,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "it takes 1,000 times longer\nfor objects to orbit it."
    } ]
  }, {
    "tStartMs": 173820,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And that means from Earth,\nits appearance over time"
    } ]
  }, {
    "tStartMs": 176500,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "is more consistent in\ncontrast to Sagittarius A*"
    } ]
  }, {
    "tStartMs": 180040,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "where things can change\non the order of minutes."
    } ]
  }, {
    "tStartMs": 183260,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "These visualizations are\nfrom Luciano Rezzolla"
    } ]
  }, {
    "tStartMs": 186140,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and colleagues at Goethe\nUniversity Frankfurt."
    } ]
  }, {
    "tStartMs": 189060,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "But the biggest challenge\nof all in making an image"
    } ]
  }, {
    "tStartMs": 191440,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "of either supermassive black\nhole is that these objects"
    } ]
  }, {
    "tStartMs": 194480,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "are so compact and so far from Earth,"
    } ]
  }, {
    "tStartMs": 197370,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "in the sky, they appear very, very tiny."
    } ]
  }, {
    "tStartMs": 201600,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "To get a sense of just how tiny,"
    } ]
  }, {
    "tStartMs": 203620,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "take the whole sky and\ndivide it into 180 degrees."
    } ]
  }, {
    "tStartMs": 207950,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "The Andromeda galaxy\nspans about three degrees."
    } ]
  }, {
    "tStartMs": 211486,
    "dDurationMs": 4294,
    "segs": [ {
      "utf8": "Then divide one degree into 60 arcminutes"
    } ]
  }, {
    "tStartMs": 216714,
    "dDurationMs": 3829,
    "segs": [ {
      "utf8": "and one arc minute into 60 arcseconds."
    } ]
  }, {
    "tStartMs": 221840,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "Divide an arcsecond into 100,"
    } ]
  }, {
    "tStartMs": 225930,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "into a 100 again and into 100 once more."
    } ]
  }, {
    "tStartMs": 231370,
    "dDurationMs": 3653,
    "segs": [ {
      "utf8": "And this is the size of\nthe black holes on the sky."
    } ]
  }, {
    "tStartMs": 236720,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "It's equivalent to taking a\npicture of a donut on the moon."
    } ]
  }, {
    "tStartMs": 241290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Now, there is no optical\ntelescope on Earth"
    } ]
  }, {
    "tStartMs": 244170,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "that could produce such an image."
    } ]
  }, {
    "tStartMs": 246310,
    "dDurationMs": 2571,
    "segs": [ {
      "utf8": "So in this video, I wanna\nanswer two questions."
    } ]
  }, {
    "tStartMs": 248881,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "How did they do it?"
    } ]
  }, {
    "tStartMs": 250840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "And what are we actually looking at?"
    } ]
  }, {
    "tStartMs": 253500,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "So starting with,"
    } ]
  }, {
    "tStartMs": 254590,
    "dDurationMs": 2524,
    "segs": [ {
      "utf8": "how did they make these\nimages of black holes?"
    } ]
  }, {
    "tStartMs": 257114,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "Well, the first thing to know"
    } ]
  }, {
    "tStartMs": 258490,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is they weren't made with visible light."
    } ]
  }, {
    "tStartMs": 260560,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "They were made using radio waves"
    } ]
  }, {
    "tStartMs": 262070,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "with a wavelength of 1.3 millimeters."
    } ]
  }, {
    "tStartMs": 264820,
    "dDurationMs": 3125,
    "segs": [ {
      "utf8": "So all the observations were\ntaken by radio telescopes"
    } ]
  }, {
    "tStartMs": 267945,
    "dDurationMs": 2788,
    "segs": [ {
      "utf8": "which essentially look\nlike huge satellite dishes."
    } ]
  }, {
    "tStartMs": 272290,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "When a source emits radio\nwaves, they travel out radially"
    } ]
  }, {
    "tStartMs": 276000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "in all directions, but\nEarth is so far away"
    } ]
  }, {
    "tStartMs": 279240,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that by the time they reach our planet,"
    } ]
  }, {
    "tStartMs": 281250,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "the wavefronts are almost\ncompletely flat and parallel."
    } ]
  }, {
    "tStartMs": 285060,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "This is known as a plane wave."
    } ]
  }, {
    "tStartMs": 287800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "A radio telescope works"
    } ]
  }, {
    "tStartMs": 289540,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "by scanning back and forth across the sky."
    } ]
  }, {
    "tStartMs": 292820,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "When it is pointed\ndirectly at a radio source,"
    } ]
  }, {
    "tStartMs": 295500,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "it produces a bright spot."
    } ]
  }, {
    "tStartMs": 297480,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "That's because all the radio\nwaves travel the same distance,"
    } ]
  }, {
    "tStartMs": 300296,
    "dDurationMs": 3914,
    "segs": [ {
      "utf8": "bounce off the dish, and are\nreceived at the same time"
    } ]
  }, {
    "tStartMs": 304210,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "so they are in phase meaning\npeaks line up with peaks"
    } ]
  }, {
    "tStartMs": 307440,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "and troughs with troughs."
    } ]
  }, {
    "tStartMs": 309350,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "They constructively interfere."
    } ]
  }, {
    "tStartMs": 311940,
    "dDurationMs": 2224,
    "segs": [ {
      "utf8": "As the telescope moves past the source,"
    } ]
  }, {
    "tStartMs": 314164,
    "dDurationMs": 3636,
    "segs": [ {
      "utf8": "some of the radio waves now\ntravel farther than others"
    } ]
  }, {
    "tStartMs": 317800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and therefore they meet up out of phase,"
    } ]
  }, {
    "tStartMs": 320100,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "destructively interfere,"
    } ]
  }, {
    "tStartMs": 321560,
    "dDurationMs": 3511,
    "segs": [ {
      "utf8": "and the intensity of the\nsignal drops to zero."
    } ]
  }, {
    "tStartMs": 325071,
    "dDurationMs": 2839,
    "segs": [ {
      "utf8": "To make a sharp image,\nyou want this drop off"
    } ]
  }, {
    "tStartMs": 327910,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to be as steep as possible"
    } ]
  }, {
    "tStartMs": 330010,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "so the telescope produces peak intensity"
    } ]
  }, {
    "tStartMs": 332150,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "only when aimed directly at the source"
    } ]
  }, {
    "tStartMs": 334470,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and then the intensity drops rapidly"
    } ]
  }, {
    "tStartMs": 336210,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "when the dish is moved just\na tiny bit in any direction."
    } ]
  }, {
    "tStartMs": 339796,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "There are two ways of achieving this."
    } ]
  }, {
    "tStartMs": 342230,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "One is to observe higher\nfrequency radio waves."
    } ]
  }, {
    "tStartMs": 345150,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "That way any slight\nmovement of the telescope"
    } ]
  }, {
    "tStartMs": 347400,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "represents a greater\nfraction of a wavelength."
    } ]
  }, {
    "tStartMs": 350010,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "This causes destructive\ninterference to occur sooner."
    } ]
  }, {
    "tStartMs": 353280,
    "dDurationMs": 3637,
    "segs": [ {
      "utf8": "The other way is to increase\nthe diameter of the telescope,"
    } ]
  }, {
    "tStartMs": 356917,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "and this increases the\ndifference in path length"
    } ]
  }, {
    "tStartMs": 359340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "between radio waves on\nopposite sides of the telescope"
    } ]
  }, {
    "tStartMs": 362370,
    "dDurationMs": 1913,
    "segs": [ {
      "utf8": "for a given angular adjustment."
    } ]
  }, {
    "tStartMs": 365320,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "How narrowly a telescope"
    } ]
  }, {
    "tStartMs": 367010,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "can identify the source of radio waves"
    } ]
  }, {
    "tStartMs": 369060,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "is known as its angular resolution."
    } ]
  }, {
    "tStartMs": 372040,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "You can think of it as the\nsize of the spot on the sky"
    } ]
  }, {
    "tStartMs": 374970,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "that the telescope is sensitive to."
    } ]
  }, {
    "tStartMs": 377012,
    "dDurationMs": 2188,
    "segs": [ {
      "utf8": "It is proportional to wavelength,"
    } ]
  }, {
    "tStartMs": 379200,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "and inversely proportional to\nthe diameter of the telescope."
    } ]
  }, {
    "tStartMs": 382807,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "The challenge with making\na picture of a black hole"
    } ]
  }, {
    "tStartMs": 385758,
    "dDurationMs": 1992,
    "segs": [ {
      "utf8": "is that you're trying to see the structure"
    } ]
  }, {
    "tStartMs": 387750,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "in a tiny area of the sky."
    } ]
  }, {
    "tStartMs": 390780,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Imagine scanning a radio telescope"
    } ]
  }, {
    "tStartMs": 392770,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "across the center of a black hole."
    } ]
  }, {
    "tStartMs": 395040,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "You would want to see the bright spot"
    } ]
  }, {
    "tStartMs": 396560,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "as the telescope passes over the left edge"
    } ]
  }, {
    "tStartMs": 398650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and then a dark spot and\nthen another bright spot"
    } ]
  }, {
    "tStartMs": 400870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "as it passes the right edge."
    } ]
  }, {
    "tStartMs": 403060,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "The problem is, for any individual\nradio telescope on Earth,"
    } ]
  }, {
    "tStartMs": 406780,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "the angular resolution is too large."
    } ]
  }, {
    "tStartMs": 409550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So as it passes over the black hole,"
    } ]
  }, {
    "tStartMs": 411770,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "it would still be receiving\nradio waves from the left side"
    } ]
  }, {
    "tStartMs": 414730,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "as it begins receiving radio\nwaves from the right side."
    } ]
  }, {
    "tStartMs": 417770,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "The resolution isn't high enough"
    } ]
  }, {
    "tStartMs": 419320,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "to tell if there's a ring structure there"
    } ]
  }, {
    "tStartMs": 421340,
    "dDurationMs": 3919,
    "segs": [ {
      "utf8": "as we'd expect with a black\nhole, or if it's just a blob."
    } ]
  }, {
    "tStartMs": 425259,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "Observing at shorter wavelengths\nisn't really an option"
    } ]
  }, {
    "tStartMs": 428960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "because that light is blocked\neither by our atmosphere"
    } ]
  }, {
    "tStartMs": 432170,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "or by the matter around the black hole."
    } ]
  }, {
    "tStartMs": 434650,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So if you wanna improve resolution,"
    } ]
  }, {
    "tStartMs": 436630,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "the only way you can do it"
    } ]
  }, {
    "tStartMs": 437700,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "is by increasing the\ndiameter of the telescope."
    } ]
  }, {
    "tStartMs": 440639,
    "dDurationMs": 2351,
    "segs": [ {
      "utf8": "But if you actually do the calculation,"
    } ]
  }, {
    "tStartMs": 442990,
    "dDurationMs": 2215,
    "segs": [ {
      "utf8": "you find that the telescope you'd need"
    } ]
  }, {
    "tStartMs": 445205,
    "dDurationMs": 2725,
    "segs": [ {
      "utf8": "would have to be the size of the Earth"
    } ]
  }, {
    "tStartMs": 447930,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "in order to see the ring of a black hole,"
    } ]
  }, {
    "tStartMs": 450732,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "which is obviously impossible,"
    } ]
  }, {
    "tStartMs": 453485,
    "dDurationMs": 4145,
    "segs": [ {
      "utf8": "but there is a way to do\nsomething that's almost as good."
    } ]
  }, {
    "tStartMs": 457630,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You don't need a complete\ndish the size of the Earth,"
    } ]
  }, {
    "tStartMs": 460630,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "just pieces of it."
    } ]
  }, {
    "tStartMs": 461910,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Individual radio telescopes\nthat are separated by distances"
    } ]
  }, {
    "tStartMs": 465710,
    "dDurationMs": 2172,
    "segs": [ {
      "utf8": "up to the Earth's diameter."
    } ]
  }, {
    "tStartMs": 467882,
    "dDurationMs": 2738,
    "segs": [ {
      "utf8": "As long as you can properly\ncombine the signals"
    } ]
  }, {
    "tStartMs": 470620,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "from all these distant telescopes,\nyou get the constructive"
    } ]
  }, {
    "tStartMs": 473960,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and destructive interference required"
    } ]
  }, {
    "tStartMs": 476090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to achieve the same angular resolution"
    } ]
  }, {
    "tStartMs": 478700,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "as an Earth-sized dish."
    } ]
  }, {
    "tStartMs": 480820,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "This technique is called very\nlong baseline interferometry."
    } ]
  }, {
    "tStartMs": 484680,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "So the event horizon telescope\nis not just one telescope"
    } ]
  }, {
    "tStartMs": 488750,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "but a global network\nof radio observatories."
    } ]
  }, {
    "tStartMs": 492340,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "All these telescopes"
    } ]
  }, {
    "tStartMs": 493320,
    "dDurationMs": 3026,
    "segs": [ {
      "utf8": "observe Sagittarius A* at the same time."
    } ]
  }, {
    "tStartMs": 496346,
    "dDurationMs": 1974,
    "segs": [ {
      "utf8": "Unlike a single telescope,"
    } ]
  }, {
    "tStartMs": 498320,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "you can't bounce all the radio\nwaves to a central receiver"
    } ]
  }, {
    "tStartMs": 501430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and add them up in real time."
    } ]
  }, {
    "tStartMs": 503380,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "So instead each telescope records\nthe signal at its location"
    } ]
  }, {
    "tStartMs": 507090,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "and the exact time down\nto the femtosecond."
    } ]
  }, {
    "tStartMs": 510027,
    "dDurationMs": 2644,
    "segs": [ {
      "utf8": "Petabytes of data are generated."
    } ]
  }, {
    "tStartMs": 512671,
    "dDurationMs": 2979,
    "segs": [ {
      "utf8": "But now that data needs\nto be brought together,"
    } ]
  }, {
    "tStartMs": 515650,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and the fastest way to do it"
    } ]
  }, {
    "tStartMs": 516930,
    "dDurationMs": 2526,
    "segs": [ {
      "utf8": "was actually to carry hard\ndrives as hand luggage"
    } ]
  }, {
    "tStartMs": 519456,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "to centralized locations."
    } ]
  }, {
    "tStartMs": 521952,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "Now, think about the data we've got."
    } ]
  }, {
    "tStartMs": 524421,
    "dDurationMs": 2489,
    "segs": [ {
      "utf8": "Electrical signals and precise timings"
    } ]
  }, {
    "tStartMs": 526910,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "from a number of radio\ntelescopes around the world,"
    } ]
  }, {
    "tStartMs": 530277,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "but none of those radio telescopes"
    } ]
  }, {
    "tStartMs": 532590,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "has enough angular resolution"
    } ]
  }, {
    "tStartMs": 534100,
    "dDurationMs": 2327,
    "segs": [ {
      "utf8": "to see the ring of the black hole."
    } ]
  }, {
    "tStartMs": 536427,
    "dDurationMs": 2464,
    "segs": [ {
      "utf8": "So how do you combine that data"
    } ]
  }, {
    "tStartMs": 538891,
    "dDurationMs": 4869,
    "segs": [ {
      "utf8": "and get finer detail\nthan any of the inputs?"
    } ]
  }, {
    "tStartMs": 543760,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Well, there is additional information"
    } ]
  }, {
    "tStartMs": 546390,
    "dDurationMs": 3144,
    "segs": [ {
      "utf8": "in the relative distances\nbetween these telescopes"
    } ]
  }, {
    "tStartMs": 549534,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "and in the time delays\nbetween when a wavefront"
    } ]
  }, {
    "tStartMs": 552270,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "hits one telescope relative to the others."
    } ]
  }, {
    "tStartMs": 556190,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Imagine combining the signals\nfrom two distant telescopes."
    } ]
  }, {
    "tStartMs": 560300,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Let's say they both received\nthe same wave at the same time"
    } ]
  }, {
    "tStartMs": 564300,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "so those waves were coming in phase."
    } ]
  }, {
    "tStartMs": 566950,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Well, then the source"
    } ]
  }, {
    "tStartMs": 568010,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "must have been located\ndirectly between them."
    } ]
  }, {
    "tStartMs": 570760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The radio waves would've\ntraveled the same distance"
    } ]
  }, {
    "tStartMs": 573040,
    "dDurationMs": 3711,
    "segs": [ {
      "utf8": "to each telescope to\narrive at the same time,"
    } ]
  }, {
    "tStartMs": 576751,
    "dDurationMs": 2396,
    "segs": [ {
      "utf8": "except with just two telescopes,"
    } ]
  }, {
    "tStartMs": 579147,
    "dDurationMs": 3653,
    "segs": [ {
      "utf8": "that only narrows it\ndown to a line in the sky"
    } ]
  }, {
    "tStartMs": 582800,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "that is equidistant from both telescopes."
    } ]
  }, {
    "tStartMs": 585810,
    "dDurationMs": 2989,
    "segs": [ {
      "utf8": "The source could have been\nanywhere on that line."
    } ]
  }, {
    "tStartMs": 588799,
    "dDurationMs": 2209,
    "segs": [ {
      "utf8": "And it's actually worse than that."
    } ]
  }, {
    "tStartMs": 591008,
    "dDurationMs": 2032,
    "segs": [ {
      "utf8": "It's possible that the source"
    } ]
  }, {
    "tStartMs": 593040,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "could be exactly one wavelength closer"
    } ]
  }, {
    "tStartMs": 595320,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "to one of the telescopes\nand that way the radio waves"
    } ]
  }, {
    "tStartMs": 598220,
    "dDurationMs": 2953,
    "segs": [ {
      "utf8": "would still arrive perfectly in phase."
    } ]
  }, {
    "tStartMs": 601173,
    "dDurationMs": 2637,
    "segs": [ {
      "utf8": "Or the difference could be two or three"
    } ]
  }, {
    "tStartMs": 603810,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "or four wavelengths,\nbut you get the point."
    } ]
  }, {
    "tStartMs": 606610,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So from one pair of telescopes,\nthe information we get"
    } ]
  }, {
    "tStartMs": 609970,
    "dDurationMs": 1907,
    "segs": [ {
      "utf8": "about the source is actually a series"
    } ]
  }, {
    "tStartMs": 611877,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "of bright and dark fringes."
    } ]
  }, {
    "tStartMs": 615640,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "Telescopes that are close\ntogether produce wide fringes,"
    } ]
  }, {
    "tStartMs": 619050,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "while those that are far\napart produce narrow fringes."
    } ]
  }, {
    "tStartMs": 622240,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So to make an image, you\nneed pairs of telescopes"
    } ]
  }, {
    "tStartMs": 625450,
    "dDurationMs": 4235,
    "segs": [ {
      "utf8": "at all different orientations\nand different distances apart."
    } ]
  }, {
    "tStartMs": 629685,
    "dDurationMs": 4095,
    "segs": [ {
      "utf8": "Each pair makes a different\ninterference pattern."
    } ]
  }, {
    "tStartMs": 633780,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "And then by combining all these patterns,"
    } ]
  }, {
    "tStartMs": 636416,
    "dDurationMs": 4974,
    "segs": [ {
      "utf8": "we get an image of the black\nhole which created them."
    } ]
  }, {
    "tStartMs": 641390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But now that we have this picture,"
    } ]
  }, {
    "tStartMs": 643250,
    "dDurationMs": 2172,
    "segs": [ {
      "utf8": "what exactly is it showing us?"
    } ]
  }, {
    "tStartMs": 645422,
    "dDurationMs": 2118,
    "segs": [ {
      "utf8": "Well, this is how I explained it"
    } ]
  }, {
    "tStartMs": 647540,
    "dDurationMs": 2668,
    "segs": [ {
      "utf8": "when the first image of a\nblack hole was released."
    } ]
  }, {
    "tStartMs": 650208,
    "dDurationMs": 4389,
    "segs": [ {
      "utf8": "So here is my mock black hole of science."
    } ]
  }, {
    "tStartMs": 654597,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "And this sphere represents\nthe event horizon."
    } ]
  }, {
    "tStartMs": 658430,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Once you're inside here,"
    } ]
  }, {
    "tStartMs": 659770,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "there is no coming back,\nnot even for light."
    } ]
  }, {
    "tStartMs": 662440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "The radius of the event horizon"
    } ]
  }, {
    "tStartMs": 664560,
    "dDurationMs": 2645,
    "segs": [ {
      "utf8": "is known as the Schwarzschild radius."
    } ]
  }, {
    "tStartMs": 667205,
    "dDurationMs": 2715,
    "segs": [ {
      "utf8": "Now, if we were just\nto look at a black hole"
    } ]
  }, {
    "tStartMs": 669920,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "with nothing around it,\nwe would not be able"
    } ]
  }, {
    "tStartMs": 671610,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "to make an image like this because, well,"
    } ]
  }, {
    "tStartMs": 673670,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "it would just absorb all\nelectromagnetic radiation"
    } ]
  }, {
    "tStartMs": 676110,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "that falls on it, but the black\nhole that they're looking at"
    } ]
  }, {
    "tStartMs": 679270,
    "dDurationMs": 3625,
    "segs": [ {
      "utf8": "has matter around it in an accretion disk."
    } ]
  }, {
    "tStartMs": 682895,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In this accretion disk,\nthere is dust and gas"
    } ]
  }, {
    "tStartMs": 686315,
    "dDurationMs": 3215,
    "segs": [ {
      "utf8": "swirling around here very chaotically."
    } ]
  }, {
    "tStartMs": 689530,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "It's incredibly hot. We're\ntalking millions of degrees."
    } ]
  }, {
    "tStartMs": 693060,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And it's going really fast,"
    } ]
  }, {
    "tStartMs": 695140,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "a significant fraction\nof the speed of light."
    } ]
  }, {
    "tStartMs": 697940,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "And it's this matter that\nthe black hole feeds off"
    } ]
  }, {
    "tStartMs": 701040,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and gets bigger and bigger over time,"
    } ]
  }, {
    "tStartMs": 703940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but you'll notice that the accretion disk"
    } ]
  }, {
    "tStartMs": 705770,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "does not extend all the way\nin to the event horizon."
    } ]
  }, {
    "tStartMs": 709580,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Why is that?"
    } ]
  }, {
    "tStartMs": 710550,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Well that's because there is"
    } ]
  }, {
    "tStartMs": 711770,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "an innermost stable circular orbit,"
    } ]
  }, {
    "tStartMs": 714850,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "and for matter around a\nnon-spinning black hole,"
    } ]
  }, {
    "tStartMs": 718790,
    "dDurationMs": 3763,
    "segs": [ {
      "utf8": "that orbit is at three\nSchwarzschild radii."
    } ]
  }, {
    "tStartMs": 723650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Now, in all likelihood, the black hole"
    } ]
  }, {
    "tStartMs": 725930,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "at the center of our\ngalaxy will be spinning."
    } ]
  }, {
    "tStartMs": 728270,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "But for simplicity,"
    } ]
  }, {
    "tStartMs": 729640,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "I'm just considering\nthe non-spinning case."
    } ]
  }, {
    "tStartMs": 731810,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You can see my video\non spinning black holes"
    } ]
  }, {
    "tStartMs": 734210,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "if you wanna find out more about that."
    } ]
  }, {
    "tStartMs": 736280,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "So this is the innermost orbit"
    } ]
  }, {
    "tStartMs": 738580,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "for matter going around a black hole."
    } ]
  }, {
    "tStartMs": 741380,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "If it goes inside this orbit,"
    } ]
  }, {
    "tStartMs": 742840,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "it very quickly goes into\nthe center of the black hole"
    } ]
  }, {
    "tStartMs": 745980,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "and we never hear from it\nagain, but there is something"
    } ]
  }, {
    "tStartMs": 750440,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "that can orbit closer to the\nblack hole, and that is light."
    } ]
  }, {
    "tStartMs": 755883,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Because light has no mass,\nit can actually orbit"
    } ]
  }, {
    "tStartMs": 762016,
    "dDurationMs": 4264,
    "segs": [ {
      "utf8": "at 1.5 Schwarzschild radii."
    } ]
  }, {
    "tStartMs": 766280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Now here, I'm representing it with a ring,"
    } ]
  }, {
    "tStartMs": 768520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but really this could\nbe in any orientation."
    } ]
  }, {
    "tStartMs": 770740,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "So it's a sphere of photon orbits."
    } ]
  }, {
    "tStartMs": 774170,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "And if you were standing there,"
    } ]
  }, {
    "tStartMs": 775630,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "of course you could never go there,"
    } ]
  }, {
    "tStartMs": 777420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but if you could, you could look forward"
    } ]
  }, {
    "tStartMs": 779130,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "and actually see the back of your head"
    } ]
  }, {
    "tStartMs": 781390,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "'cause the photons could go\naround and complete that orbit."
    } ]
  }, {
    "tStartMs": 785930,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Now, the photon sphere\nis an unstable orbit"
    } ]
  }, {
    "tStartMs": 788990,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "meaning eventually either\nthe photons have to spiral"
    } ]
  }, {
    "tStartMs": 792540,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "into the singularity or spiral\nout and head off to infinity."
    } ]
  }, {
    "tStartMs": 797910,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Now, the question I want to answer is,"
    } ]
  }, {
    "tStartMs": 799570,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "what does this black, quote\nunquote, shadow in the image"
    } ]
  }, {
    "tStartMs": 803690,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "correspond to in this picture"
    } ]
  }, {
    "tStartMs": 805850,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "of what's actually going\non around the black hole?"
    } ]
  }, {
    "tStartMs": 808887,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "Is it the event horizon? Are\nwe simply looking at this?"
    } ]
  }, {
    "tStartMs": 812450,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "Or is it the photon sphere"
    } ]
  }, {
    "tStartMs": 813820,
    "dDurationMs": 2889,
    "segs": [ {
      "utf8": "or the innermost stable, circular orbit?"
    } ]
  }, {
    "tStartMs": 816709,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "Well, things are complicated."
    } ]
  }, {
    "tStartMs": 818523,
    "dDurationMs": 3917,
    "segs": [ {
      "utf8": "And the reason is, this\nblack hole warps space-time"
    } ]
  }, {
    "tStartMs": 822440,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "around it which changes\nthe path of light rays"
    } ]
  }, {
    "tStartMs": 825580,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so they don't just go in straight lines"
    } ]
  }, {
    "tStartMs": 827920,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "like we normally imagine that they do."
    } ]
  }, {
    "tStartMs": 829820,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "I mean, they are going in straight lines,"
    } ]
  }, {
    "tStartMs": 831870,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "but space-time's curved so\nyeah, they go in curves."
    } ]
  }, {
    "tStartMs": 835330,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So the best way to think of this"
    } ]
  }, {
    "tStartMs": 836610,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "is maybe to imagine parallel\nlight rays coming in"
    } ]
  }, {
    "tStartMs": 839790,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "from the observer and\nstriking this geometry here."
    } ]
  }, {
    "tStartMs": 843700,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Of course, if the parallel light rays"
    } ]
  }, {
    "tStartMs": 845350,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "cross the event horizon,"
    } ]
  }, {
    "tStartMs": 846440,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "we'll never see them\nagain so they're gone."
    } ]
  }, {
    "tStartMs": 848130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "That will definitely be a dark region,"
    } ]
  }, {
    "tStartMs": 849990,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "but if a light ray comes in\njust above the event horizon,"
    } ]
  }, {
    "tStartMs": 853340,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "it too will get bent and end\nup crossing the event horizon."
    } ]
  }, {
    "tStartMs": 856920,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "It ends up in the black hole."
    } ]
  }, {
    "tStartMs": 859043,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "Even a light ray coming\nin the same distance away"
    } ]
  }, {
    "tStartMs": 862210,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "as the photon sphere will\nend up getting warped"
    } ]
  }, {
    "tStartMs": 865152,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "into the black hole and curving\nacross the event horizon."
    } ]
  }, {
    "tStartMs": 870310,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So in order for you to get a parallel ray"
    } ]
  }, {
    "tStartMs": 874330,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "which does not end up in the black hole,"
    } ]
  }, {
    "tStartMs": 876830,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "you actually have to\ngo out 2.6 radii away."
    } ]
  }, {
    "tStartMs": 882160,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "If a light ray comes in 2.6\nSchwarzschild radii away,"
    } ]
  }, {
    "tStartMs": 886830,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "it will just graze the photon sphere"
    } ]
  }, {
    "tStartMs": 889370,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "at its closest approach and\nthen it will go off to infinity."
    } ]
  }, {
    "tStartMs": 893020,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And so the resulting shadow\nthat we get looks like this."
    } ]
  }, {
    "tStartMs": 899260,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "It is 2.6 times bigger\nthan the event horizon."
    } ]
  }, {
    "tStartMs": 904010,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And you say, what are we\nreally looking at here?"
    } ]
  }, {
    "tStartMs": 906010,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "What is this shadow?"
    } ]
  }, {
    "tStartMs": 907440,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "Well in the center of\nit is the event horizon."
    } ]
  }, {
    "tStartMs": 910790,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "It maps pretty cleanly onto\nthe center of the shadow."
    } ]
  }, {
    "tStartMs": 915200,
    "dDurationMs": 3152,
    "segs": [ {
      "utf8": "But if you think about it,\nlight rays going above or below"
    } ]
  }, {
    "tStartMs": 918352,
    "dDurationMs": 3208,
    "segs": [ {
      "utf8": "also end up crossing the event horizon,"
    } ]
  }, {
    "tStartMs": 921560,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "just on the backside."
    } ]
  }, {
    "tStartMs": 923520,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "So in fact, what we get\nis the whole backside"
    } ]
  }, {
    "tStartMs": 926180,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "of the event horizon mapped\nonto a ring on this shadow."
    } ]
  }, {
    "tStartMs": 932190,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So looking from our one point\nin space at the black hole,"
    } ]
  }, {
    "tStartMs": 935490,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "we actually get to see the entirety"
    } ]
  }, {
    "tStartMs": 938240,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "of the black hole's event horizon."
    } ]
  }, {
    "tStartMs": 940110,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "I mean, maybe it's silly\nto talk about seeing it"
    } ]
  }, {
    "tStartMs": 942220,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "because it's completely black,"
    } ]
  }, {
    "tStartMs": 944480,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "but that really is where the points"
    } ]
  }, {
    "tStartMs": 946219,
    "dDurationMs": 2451,
    "segs": [ {
      "utf8": "would map to on this shadow."
    } ]
  }, {
    "tStartMs": 948670,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "It gets weirder than that\nbecause the light can come in"
    } ]
  }, {
    "tStartMs": 951680,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "and go around the back and,\nsay, get absorbed in the front,"
    } ]
  }, {
    "tStartMs": 954570,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "you get another image of the\nentire horizon next to that"
    } ]
  }, {
    "tStartMs": 958890,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "in another annular ring"
    } ]
  }, {
    "tStartMs": 960500,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "And then another one after that\nand another one after that."
    } ]
  }, {
    "tStartMs": 962790,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And you get basically infinite\nimages of the event horizon"
    } ]
  }, {
    "tStartMs": 965640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "as you approach the edge of this shadow."
    } ]
  }, {
    "tStartMs": 968490,
    "dDurationMs": 1846,
    "segs": [ {
      "utf8": "So what is the first\nlight that we can see?"
    } ]
  }, {
    "tStartMs": 970336,
    "dDurationMs": 3074,
    "segs": [ {
      "utf8": "It is those light rays that\ncome in at just such an angle"
    } ]
  }, {
    "tStartMs": 973410,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "that they graze the photon sphere"
    } ]
  }, {
    "tStartMs": 975130,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "and then end up at our telescopes,\nand they produce a shadow"
    } ]
  }, {
    "tStartMs": 979400,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "which is 2.6 times the\nsize of the event horizon."
    } ]
  }, {
    "tStartMs": 984060,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "So this is roughly what we'd see"
    } ]
  }, {
    "tStartMs": 986470,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "if we happen to be looking perpendicular"
    } ]
  }, {
    "tStartMs": 988550,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "to the accretion disk, but\nmore likely we will be looking"
    } ]
  }, {
    "tStartMs": 992170,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "at some sort of random\nangle to the accretion disk."
    } ]
  }, {
    "tStartMs": 995760,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "We may be even looking edge on."
    } ]
  }, {
    "tStartMs": 998230,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "And in that case, do we see\nthis shadow of the black hole?"
    } ]
  }, {
    "tStartMs": 1002170,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "You might think that we\nwouldn't, but the truth is"
    } ]
  }, {
    "tStartMs": 1004820,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "because of the way the\nblack hole warps space time"
    } ]
  }, {
    "tStartMs": 1007780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and bends light rays,"
    } ]
  }, {
    "tStartMs": 1009760,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "we actually see the back\nof the accretion disk."
    } ]
  }, {
    "tStartMs": 1013000,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "The way it works is light rays\ncoming off the accretion disk"
    } ]
  }, {
    "tStartMs": 1015750,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "bend over the top and end\nup coming to our telescopes."
    } ]
  }, {
    "tStartMs": 1019340,
    "dDurationMs": 4393,
    "segs": [ {
      "utf8": "So what we end up seeing is\nsomething that looks like that."
    } ]
  }, {
    "tStartMs": 1024690,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "Similarly, light from the\nbottom of the accretion disk"
    } ]
  }, {
    "tStartMs": 1027629,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "comes underneath, gets bent\nunderneath the black hole"
    } ]
  }, {
    "tStartMs": 1032090,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "and comes towards us like that."
    } ]
  }, {
    "tStartMs": 1034080,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And this is where we get an\nimage that looks something"
    } ]
  }, {
    "tStartMs": 1036520,
    "dDurationMs": 2756,
    "segs": [ {
      "utf8": "like the interstellar black hole."
    } ]
  }, {
    "tStartMs": 1039276,
    "dDurationMs": 2694,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1041970,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "It gets even crazier than this"
    } ]
  }, {
    "tStartMs": 1043467,
    "dDurationMs": 2563,
    "segs": [ {
      "utf8": "'cause light that comes off the top"
    } ]
  }, {
    "tStartMs": 1046030,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "of the accretion disk here"
    } ]
  }, {
    "tStartMs": 1048020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "can go around the back of the black hole,"
    } ]
  }, {
    "tStartMs": 1050660,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "graze the photon sphere, and\ncome out the bottom right here"
    } ]
  }, {
    "tStartMs": 1054050,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "producing a very thin ring\nunderneath the shadow."
    } ]
  }, {
    "tStartMs": 1056960,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Similarly, light from\nunderneath the accretion disk"
    } ]
  }, {
    "tStartMs": 1059780,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "in the front can go\nunderneath and around the back"
    } ]
  }, {
    "tStartMs": 1063240,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and come out over the top,"
    } ]
  }, {
    "tStartMs": 1064520,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "which is why we see\nthis ring of light here."
    } ]
  }, {
    "tStartMs": 1068830,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "This is what we could see"
    } ]
  }, {
    "tStartMs": 1070070,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "if we were very close to the black hole,"
    } ]
  }, {
    "tStartMs": 1073200,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "something that looks truly spectacular."
    } ]
  }, {
    "tStartMs": 1075620,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "One other really important\neffect to consider"
    } ]
  }, {
    "tStartMs": 1077860,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "is that the matter in this accretion disk"
    } ]
  }, {
    "tStartMs": 1080550,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "is going very fast, close\nto the speed of light."
    } ]
  }, {
    "tStartMs": 1083410,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And so if it's coming towards us,"
    } ]
  }, {
    "tStartMs": 1085370,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "it's gonna look much brighter\nthan if it's going away."
    } ]
  }, {
    "tStartMs": 1088170,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "That's called relativistic\nbeaming or Doppler beaming."
    } ]
  }, {
    "tStartMs": 1091110,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "And so one side of this accretion disk"
    } ]
  }, {
    "tStartMs": 1093140,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "is going to look much\nbrighter than the other,"
    } ]
  }, {
    "tStartMs": 1094810,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and that's why we're gonna see\na bright spot in our image."
    } ]
  }, {
    "tStartMs": 1098500,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "So hopefully this gives you an idea"
    } ]
  }, {
    "tStartMs": 1100440,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "of what we're really looking at"
    } ]
  }, {
    "tStartMs": 1102230,
    "dDurationMs": 2683,
    "segs": [ {
      "utf8": "when we look at an image of a black hole."
    } ]
  }, {
    "tStartMs": 1106109,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "(outro sounds)"
    } ]
  }, {
    "tStartMs": 1109750,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Hey, this video was sponsored by KiwiCo,"
    } ]
  }, {
    "tStartMs": 1112020,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "creator of awesome\nhands-on projects for kids."
    } ]
  }, {
    "tStartMs": 1115010,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "You know, I've used KiwiCo\nwith my own kids for years."
    } ]
  }, {
    "tStartMs": 1118250,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "They have nine different\nsubscription lines"
    } ]
  }, {
    "tStartMs": 1119980,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "targeted at different age groups,"
    } ]
  }, {
    "tStartMs": 1121560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "all the way down to newborns."
    } ]
  }, {
    "tStartMs": 1123400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The way it works is every month\na box shows up at your door"
    } ]
  }, {
    "tStartMs": 1126520,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and inside it is everything you need"
    } ]
  }, {
    "tStartMs": 1128470,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "to complete the project."
    } ]
  }, {
    "tStartMs": 1129780,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "That means no extra trips to the store."
    } ]
  }, {
    "tStartMs": 1132430,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "And when I show my kids the box,"
    } ]
  }, {
    "tStartMs": 1133820,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "they jump at the chance\nto make it with me,"
    } ]
  }, {
    "tStartMs": 1135970,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "and we can spend hours building something,"
    } ]
  }, {
    "tStartMs": 1138600,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "playing with it, and learning\nabout STEAM concepts together."
    } ]
  }, {
    "tStartMs": 1142340,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "There really is no substitute\nfor getting your hands dirty"
    } ]
  }, {
    "tStartMs": 1145160,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "and making something to figure\nout how it actually works."
    } ]
  }, {
    "tStartMs": 1148266,
    "dDurationMs": 1984,
    "segs": [ {
      "utf8": "Plus, it's a ton of fun."
    } ]
  }, {
    "tStartMs": 1150250,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "And to me, that's how learning should be."
    } ]
  }, {
    "tStartMs": 1152100,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "I want my kids to\napproach learning as play."
    } ]
  }, {
