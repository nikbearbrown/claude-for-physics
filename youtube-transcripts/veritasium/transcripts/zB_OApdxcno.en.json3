{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "There is this research paper"
    } ]
  }, {
    "tStartMs": 1680,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that has been on my mind for years."
    } ]
  }, {
    "tStartMs": 4050,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It shows that there is a\nparticular type of problem"
    } ]
  }, {
    "tStartMs": 6960,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "where the smarter you are,"
    } ]
  }, {
    "tStartMs": 8540,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "the more likely you are to get it wrong."
    } ]
  }, {
    "tStartMs": 11400,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So I asked my American friend\nWylie to go out on the street"
    } ]
  }, {
    "tStartMs": 15300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and ask people the\nquestions from the study"
    } ]
  }, {
    "tStartMs": 17130,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "to see if we could replicate its findings."
    } ]
  }, {
    "tStartMs": 21270,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The first question in the paper\nis about a fictitious study"
    } ]
  }, {
    "tStartMs": 24360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "on skin cream."
    } ]
  }, {
    "tStartMs": 25620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So in this made-up study,"
    } ]
  }, {
    "tStartMs": 27540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "people with skin rashes are assigned"
    } ]
  }, {
    "tStartMs": 29700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to either the experimental group"
    } ]
  }, {
    "tStartMs": 31560,
    "dDurationMs": 2572,
    "segs": [ {
      "utf8": "where they use a new cream for two weeks,"
    } ]
  }, {
    "tStartMs": 34132,
    "dDurationMs": 3098,
    "segs": [ {
      "utf8": "or the control group\nwhere they use no cream"
    } ]
  }, {
    "tStartMs": 37230,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "for that same period."
    } ]
  }, {
    "tStartMs": 38760,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And at the end, they count\nup how many rashes improved"
    } ]
  }, {
    "tStartMs": 42180,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and how many got worse\nin each treatment group."
    } ]
  }, {
    "tStartMs": 45000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The results are summarized in this table."
    } ]
  }, {
    "tStartMs": 48240,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So the question study\nparticipants were asked was-"
    } ]
  }, {
    "tStartMs": 51210,
    "dDurationMs": 2079,
    "segs": [ {
      "utf8": "- Did the skin cream make the rash better"
    } ]
  }, {
    "tStartMs": 53289,
    "dDurationMs": 2631,
    "segs": [ {
      "utf8": "or did it make it worse?"
    } ]
  }, {
    "tStartMs": 55920,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] The question is a little tricky"
    } ]
  }, {
    "tStartMs": 57540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "because it requires\nproportional reasoning,"
    } ]
  }, {
    "tStartMs": 60300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I think better."
    } ]
  }, {
    "tStartMs": 61133,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "- Better? So what are you looking at?"
    } ]
  }, {
    "tStartMs": 62670,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Just real quick."
    } ]
  }, {
    "tStartMs": 63510,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- I'm gonna be honest."
    } ]
  }, {
    "tStartMs": 64440,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I'm just looking at how\nbig the numbers are."
    } ]
  }, {
    "tStartMs": 66390,
    "dDurationMs": 1805,
    "segs": [ {
      "utf8": "- [Derek] If you just look\nfor the biggest number,"
    } ]
  }, {
    "tStartMs": 68195,
    "dDurationMs": 3505,
    "segs": [ {
      "utf8": "well that is the group\nwho used the skin cream"
    } ]
  }, {
    "tStartMs": 71700,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and the rash improved."
    } ]
  }, {
    "tStartMs": 73650,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- So this number is\nbigger than this number?"
    } ]
  }, {
    "tStartMs": 76210,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "- Yeah.\n- Yeah."
    } ]
  }, {
    "tStartMs": 77310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- So you might conclude\nthat the cream worked,"
    } ]
  }, {
    "tStartMs": 79710,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "it makes rashes better."
    } ]
  }, {
    "tStartMs": 81450,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "That is the intuitive answer."
    } ]
  }, {
    "tStartMs": 84300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But if you look more carefully at the data"
    } ]
  }, {
    "tStartMs": 86760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and use proportional reasoning,"
    } ]
  }, {
    "tStartMs": 88680,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "you realize that in the\nexperimental cream group,"
    } ]
  }, {
    "tStartMs": 91740,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "about three times as many\npeople got better as got worse."
    } ]
  }, {
    "tStartMs": 95383,
    "dDurationMs": 1637,
    "segs": [ {
      "utf8": "But in the control group,"
    } ]
  }, {
    "tStartMs": 97020,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "around five times as many\npeople got better than worse."
    } ]
  }, {
    "tStartMs": 100543,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "So using no cream,"
    } ]
  }, {
    "tStartMs": 102390,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "your rash was significantly\nmore likely to improve."
    } ]
  }, {
    "tStartMs": 105960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "In fact, it's a fair conclusion to say"
    } ]
  }, {
    "tStartMs": 108120,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "that the cream, on\naverage, made rashes worse."
    } ]
  }, {
    "tStartMs": 112980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The lead author on this\nstudy was Dan Kahan."
    } ]
  }, {
    "tStartMs": 115920,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- I'm Studying the science\nof science communication."
    } ]
  }, {
    "tStartMs": 119100,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "- He and colleagues recruited\na nationally diverse sample"
    } ]
  }, {
    "tStartMs": 121501,
    "dDurationMs": 4214,
    "segs": [ {
      "utf8": "of 1,111 Americans to participate."
    } ]
  }, {
    "tStartMs": 125715,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "But before answering the\nquestion on skin cream,"
    } ]
  }, {
    "tStartMs": 128880,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "each participant was asked\na series of questions"
    } ]
  }, {
    "tStartMs": 131340,
    "dDurationMs": 1887,
    "segs": [ {
      "utf8": "to assess their numeracy."
    } ]
  }, {
    "tStartMs": 133227,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "- And numeracy, it's\nnot so much the capacity"
    } ]
  }, {
    "tStartMs": 137040,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to use complicated mathematics,"
    } ]
  }, {
    "tStartMs": 139650,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "but really to reason well\nabout quantitative information."
    } ]
  }, {
    "tStartMs": 143430,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "- Numeracy scores for the\nentire sample were roughly"
    } ]
  }, {
    "tStartMs": 146133,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "normally distributed."
    } ]
  }, {
    "tStartMs": 147945,
    "dDurationMs": 2685,
    "segs": [ {
      "utf8": "Now if you group together\nall the participants"
    } ]
  }, {
    "tStartMs": 150630,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "with a certain numeracy score,"
    } ]
  }, {
    "tStartMs": 152490,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "say group all the zeros\ntogether, all the ones together,"
    } ]
  }, {
    "tStartMs": 155370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "all the twos and so on."
    } ]
  }, {
    "tStartMs": 156960,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Well, what fraction of each group"
    } ]
  }, {
    "tStartMs": 158820,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "do you think got the skin\ncream question right?"
    } ]
  }, {
    "tStartMs": 162330,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Well, the results are\nexactly what you'd expect."
    } ]
  }, {
    "tStartMs": 165720,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- Oh, this is math."
    } ]
  }, {
    "tStartMs": 166680,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It's math."
    } ]
  }, {
    "tStartMs": 167513,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "- In a fifth of the people,"
    } ]
  }, {
    "tStartMs": 168720,
    "dDurationMs": 1856,
    "segs": [ {
      "utf8": "which is a smaller number-\n- Uh-huh."
    } ]
  }, {
    "tStartMs": 170576,
    "dDurationMs": 3364,
    "segs": [ {
      "utf8": "- The rash worsened, so\nthe skin cream didn't help."
    } ]
  }, {
    "tStartMs": 173940,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- So it didn't make it better?\n- I feel the cream,"
    } ]
  }, {
    "tStartMs": 175860,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "if anything, made it worse."
    } ]
  }, {
    "tStartMs": 176970,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] The higher the numeracy score,"
    } ]
  }, {
    "tStartMs": 178650,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "the greater the fraction"
    } ]
  }, {
    "tStartMs": 179820,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of participants who got the answer right."
    } ]
  }, {
    "tStartMs": 182190,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "- Yeah. I don't think the\nnumbers mean anything to me"
    } ]
  }, {
    "tStartMs": 184856,
    "dDurationMs": 1677,
    "segs": [ {
      "utf8": "'cause I think I need-\n- That's a perfect answer."
    } ]
  }, {
    "tStartMs": 186533,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "- I think I would need\nto know what's the rash"
    } ]
  }, {
    "tStartMs": 188940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and what's the cream you're giving me."
    } ]
  }, {
    "tStartMs": 191160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Derek] Those with\nbetter numeracy skills"
    } ]
  }, {
    "tStartMs": 193110,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "manage to avoid the\nintuitively correct answer."
    } ]
  }, {
    "tStartMs": 196410,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- What are the-\n- Just seems like proportions."
    } ]
  }, {
    "tStartMs": 198060,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- I've had nobody get into\nthe numbers like this."
    } ]
  }, {
    "tStartMs": 200070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "This is great."
    } ]
  }, {
    "tStartMs": 200903,
    "dDurationMs": 1507,
    "segs": [ {
      "utf8": "Excellent. You got that right.\n- Okay."
    } ]
  }, {
    "tStartMs": 202429,
    "dDurationMs": 2005,
    "segs": [ {
      "utf8": "- And correctly determine"
    } ]
  }, {
    "tStartMs": 204434,
    "dDurationMs": 2176,
    "segs": [ {
      "utf8": "that the cream actually made rashes worse,"
    } ]
  }, {
    "tStartMs": 206610,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which is no big surprise."
    } ]
  }, {
    "tStartMs": 208890,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But this version of the skin\ncream question was only shown"
    } ]
  }, {
    "tStartMs": 211530,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to some of the participants."
    } ]
  }, {
    "tStartMs": 213390,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Another subset saw the same exact table"
    } ]
  }, {
    "tStartMs": 216120,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "except the column headings were reversed."
    } ]
  }, {
    "tStartMs": 218790,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "So in this case, the skin cream\ndid make the rashes better."
    } ]
  }, {
    "tStartMs": 223290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So how did the different\nnumeracy groups do"
    } ]
  }, {
    "tStartMs": 225270,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "with this version?"
    } ]
  }, {
    "tStartMs": 226680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Well, again, the highest numeracy groups"
    } ]
  }, {
    "tStartMs": 228690,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "were the most likely to\nget the correct answer."
    } ]
  }, {
    "tStartMs": 231240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But below a numeracy score of five,"
    } ]
  }, {
    "tStartMs": 233400,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the results were pretty flat."
    } ]
  }, {
    "tStartMs": 235410,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "That could be because even\nwithout any numerical reasoning,"
    } ]
  }, {
    "tStartMs": 238890,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "most people might expect a\nskin cream to improve a rash,"
    } ]
  }, {
    "tStartMs": 242370,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "which just happens to be the\nright answer in this case."
    } ]
  }, {
    "tStartMs": 245883,
    "dDurationMs": 3477,
    "segs": [ {
      "utf8": "But the true purpose of the\nstudy was not to find out"
    } ]
  }, {
    "tStartMs": 249360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "how numeracy effects our ability"
    } ]
  }, {
    "tStartMs": 251070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to reason accurately with data."
    } ]
  }, {
    "tStartMs": 253110,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "No, it was to figure out if something else"
    } ]
  }, {
    "tStartMs": 256048,
    "dDurationMs": 1798,
    "segs": [ {
      "utf8": "affects our reasoning ability."
    } ]
  }, {
    "tStartMs": 258000,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "Specifically, politics."
    } ]
  }, {
    "tStartMs": 261141,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "(exciting music)"
    } ]
  }, {
    "tStartMs": 264240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If you look at the skin cream data again,"
    } ]
  }, {
    "tStartMs": 266580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "but separate the participants"
    } ]
  }, {
    "tStartMs": 268320,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "by their self-reported\npolitical affiliations,"
    } ]
  }, {
    "tStartMs": 270810,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "so liberal Democrats versus\nconservative Republicans,"
    } ]
  }, {
    "tStartMs": 274200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "there's basically no\ndifference between the groups."
    } ]
  }, {
    "tStartMs": 276810,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "All follow the same pattern\nirrespective of party,"
    } ]
  }, {
    "tStartMs": 280020,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "which makes sense because a\nstudy on skin cream is about"
    } ]
  }, {
    "tStartMs": 283080,
    "dDurationMs": 2491,
    "segs": [ {
      "utf8": "as apolitical as it gets."
    } ]
  }, {
    "tStartMs": 285978,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "But what the researchers\ndid with the other half"
    } ]
  }, {
    "tStartMs": 288900,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "of the participants was the opposite."
    } ]
  }, {
    "tStartMs": 291420,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Instead of skin cream,"
    } ]
  }, {
    "tStartMs": 293010,
    "dDurationMs": 3781,
    "segs": [ {
      "utf8": "they presented a fictitious\nstudy on gun control."
    } ]
  }, {
    "tStartMs": 296791,
    "dDurationMs": 3389,
    "segs": [ {
      "utf8": "In case you don't know,\nDemocrats generally believe"
    } ]
  }, {
    "tStartMs": 300180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that gun control reduces crime,"
    } ]
  }, {
    "tStartMs": 301800,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "whereas Republicans\nbelieve it increases crime"
    } ]
  }, {
    "tStartMs": 304350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "because it takes guns outta\nthe hands of good guys"
    } ]
  }, {
    "tStartMs": 307050,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "who could prevent or deter crime."
    } ]
  }, {
    "tStartMs": 309840,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So in their made-up study,"
    } ]
  }, {
    "tStartMs": 311910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "the cities were divided into two groups,"
    } ]
  }, {
    "tStartMs": 314250,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "those that had recently\nenacted legislation"
    } ]
  }, {
    "tStartMs": 316290,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "making it illegal to\ncarry a concealed handgun"
    } ]
  }, {
    "tStartMs": 319140,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and similar cities that\nhad no such legislation."
    } ]
  }, {
    "tStartMs": 322680,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Over the following year,\ncrime rates were monitored"
    } ]
  }, {
    "tStartMs": 325170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to see where crime increased\nand where it decreased."
    } ]
  }, {
    "tStartMs": 327930,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "And the results are\nsummarized in the table."
    } ]
  }, {
    "tStartMs": 331983,
    "dDurationMs": 3147,
    "segs": [ {
      "utf8": "Again, no surprise, it's exactly the same"
    } ]
  }, {
    "tStartMs": 335130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "as the skin cream example."
    } ]
  }, {
    "tStartMs": 337440,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Of course, there were two variations,"
    } ]
  }, {
    "tStartMs": 339480,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "one where gun control decreased crime"
    } ]
  }, {
    "tStartMs": 341550,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and one where it increased crime."
    } ]
  }, {
    "tStartMs": 344130,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now if you look at the\nresults by political leaning,"
    } ]
  }, {
    "tStartMs": 346680,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they paint a very different picture."
    } ]
  }, {
    "tStartMs": 348390,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- It's kind of obvious, if\nyou have guns in a city,"
    } ]
  }, {
    "tStartMs": 351060,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "people are gonna start shooting people."
    } ]
  }, {
    "tStartMs": 352650,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And you know, if you don't have guns"
    } ]
  }, {
    "tStartMs": 354360,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and you outlaw them,"
    } ]
  }, {
    "tStartMs": 355830,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "cities are obviously gonna\nhave less crime in 'em."
    } ]
  }, {
    "tStartMs": 358110,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But the thing is, it's like you can't"
    } ]
  }, {
    "tStartMs": 360300,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "just take people's guns away\nand say that they're illegal."
    } ]
  }, {
    "tStartMs": 362790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "You know, like that's just,\nit's kinda like drugs."
    } ]
  }, {
    "tStartMs": 365400,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- So wait, but these numbers though,"
    } ]
  }, {
    "tStartMs": 366930,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "how did you just come to that conclusion?"
    } ]
  }, {
    "tStartMs": 369240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] When Republicans\nare shown the table"
    } ]
  }, {
    "tStartMs": 371160,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "where the correct answer is gun\ncontrol laws increase crime,"
    } ]
  }, {
    "tStartMs": 375120,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "then the accuracy improves"
    } ]
  }, {
    "tStartMs": 376920,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "with increasing numeracy, just as before."
    } ]
  }, {
    "tStartMs": 380370,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But for the Republicans\nwho are shown the table"
    } ]
  }, {
    "tStartMs": 382290,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "where gun control decreases crime,"
    } ]
  }, {
    "tStartMs": 384690,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "well, numeracy skills no\nlonger affect accuracy."
    } ]
  }, {
    "tStartMs": 388620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Those with a numeracy score of seven"
    } ]
  }, {
    "tStartMs": 390360,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or eight are barely more\nlikely to answer correctly"
    } ]
  }, {
    "tStartMs": 393030,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "than those with a score of zero or one."
    } ]
  }, {
    "tStartMs": 396540,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- So where the crime improved,\nlike there can be crimes"
    } ]
  }, {
    "tStartMs": 399570,
    "dDurationMs": 2365,
    "segs": [ {
      "utf8": "that were prevented because\nthe guns were legal."
    } ]
  }, {
    "tStartMs": 401935,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "And the crimes that were worsened,"
    } ]
  }, {
    "tStartMs": 404730,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that could have been other\ncrimes like not related"
    } ]
  }, {
    "tStartMs": 407010,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to guns, you know?\n- Mm-hm."
    } ]
  }, {
    "tStartMs": 408690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "- And the same is true\nin reverse for Democrats."
    } ]
  }, {
    "tStartMs": 412140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The more numerate people in\nthis sample have no problem"
    } ]
  }, {
    "tStartMs": 415080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "recognizing the correct\nanswer when it shows"
    } ]
  }, {
    "tStartMs": 417090,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that gun control reduced crime."
    } ]
  }, {
    "tStartMs": 419520,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But, if the data showed that\ngun control increased crime,"
    } ]
  }, {
    "tStartMs": 422790,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "then all of a sudden numeracy didn't help."
    } ]
  }, {
    "tStartMs": 427373,
    "dDurationMs": 3127,
    "segs": [ {
      "utf8": "Remember, this is the exact same data"
    } ]
  }, {
    "tStartMs": 430500,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and question as the skin cream example."
    } ]
  }, {
    "tStartMs": 432930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The only difference is now"
    } ]
  }, {
    "tStartMs": 434610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that data is presented\nin a political context."
    } ]
  }, {
    "tStartMs": 437490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- And the biggest\ndifference in performance"
    } ]
  }, {
    "tStartMs": 439530,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is among the most numerate people,"
    } ]
  }, {
    "tStartMs": 441270,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "they're scoring a lot worse\nthan they should have."
    } ]
  }, {
    "tStartMs": 443640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The low numeracy people are\nabout 25 percentage points"
    } ]
  }, {
    "tStartMs": 446700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "less likely to get the right answer"
    } ]
  }, {
    "tStartMs": 448770,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "if that answer is threatening\nto their ideology,"
    } ]
  }, {
    "tStartMs": 451500,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "than if it's consistent\nwith their ideology."
    } ]
  }, {
    "tStartMs": 453480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The people who are high in\nnumeracy, on the other hand,"
    } ]
  }, {
    "tStartMs": 455850,
    "dDurationMs": 3413,
    "segs": [ {
      "utf8": "45 percentage points less\nlikely to get the right answer."
    } ]
  }, {
    "tStartMs": 459263,
    "dDurationMs": 2677,
    "segs": [ {
      "utf8": "- Rather than using their\nmathematical ability"
    } ]
  }, {
    "tStartMs": 461940,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to come to the correct conclusion,"
    } ]
  }, {
    "tStartMs": 463830,
    "dDurationMs": 2789,
    "segs": [ {
      "utf8": "they somehow selectively apply it"
    } ]
  }, {
    "tStartMs": 466619,
    "dDurationMs": 2851,
    "segs": [ {
      "utf8": "to justify the conclusion they\nalready believed beforehand."
    } ]
  }, {
    "tStartMs": 469470,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "- Illegal guns, less crime."
    } ]
  }, {
    "tStartMs": 470500,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "- Illegal crime.\n- Yeah, I mean,"
    } ]
  }, {
    "tStartMs": 472710,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I wouldn't have thought that."
    } ]
  }, {
    "tStartMs": 473543,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "- And as numeracy increases,"
    } ]
  }, {
    "tStartMs": 475140,
    "dDurationMs": 2274,
    "segs": [ {
      "utf8": "people are more divided about the efficacy"
    } ]
  }, {
    "tStartMs": 477414,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "or the risks of gun control regulation."
    } ]
  }, {
    "tStartMs": 480270,
    "dDurationMs": 1513,
    "segs": [ {
      "utf8": "The same thing with fracking,"
    } ]
  }, {
    "tStartMs": 481783,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "and same thing with global warming."
    } ]
  }, {
    "tStartMs": 484260,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "We see the polarization\nconditional on numeracy,"
    } ]
  }, {
    "tStartMs": 487600,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "but we also see the same effect"
    } ]
  }, {
    "tStartMs": 489750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "when we measure people's\nreasoning proficiency"
    } ]
  }, {
    "tStartMs": 491610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in other ways."
    } ]
  }, {
    "tStartMs": 492443,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "The people who are high\nin science literacy,"
    } ]
  }, {
    "tStartMs": 494580,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "more polarized than\nthe people who are low."
    } ]
  }, {
    "tStartMs": 496830,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The people who are high and\nactively open-minded thinking,"
    } ]
  }, {
    "tStartMs": 499710,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "you see more polarization, not less,"
    } ]
  }, {
    "tStartMs": 501510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "as they become more proficient\nin this kind of thinking"
    } ]
  }, {
    "tStartMs": 503970,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Based on this data, of\ncourse I'd wanna look into it"
    } ]
  }, {
    "tStartMs": 505920,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and look at all the sources."
    } ]
  }, {
    "tStartMs": 507000,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And of course there are\nsources from sources"
    } ]
  }, {
    "tStartMs": 508650,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because people are always\nciting each other, so yeah."
    } ]
  }, {
    "tStartMs": 511020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- This is, the numbers are\nactually not real whatsoever."
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- It looks, but, if I were to\nlook at this pragmatically,"
    } ]
  }, {
    "tStartMs": 516420,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I would just say"
    } ]
  }, {
    "tStartMs": 517253,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "that the playing field\nseems pretty even here."
    } ]
  }, {
    "tStartMs": 519390,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- It's pretty even?\n- Yeah."
    } ]
  }, {
    "tStartMs": 520290,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay, great."
    } ]
  }, {
    "tStartMs": 522570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- Now, everyone wants to\nbelieve that they are rational,"
    } ]
  }, {
    "tStartMs": 525390,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "that they could change their beliefs"
    } ]
  }, {
    "tStartMs": 527976,
    "dDurationMs": 1014,
    "segs": [ {
      "utf8": "in light of the evidence."
    } ]
  }, {
    "tStartMs": 528990,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- If you encountered\nevidence on a political issue"
    } ]
  }, {
    "tStartMs": 531660,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that you were like,\n\"This is good evidence."
    } ]
  }, {
    "tStartMs": 533700,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I've done my research.\""
    } ]
  }, {
    "tStartMs": 535020,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But it contradicted your\npolitical belief on that issue,"
    } ]
  }, {
    "tStartMs": 538470,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "how would you react to that?"
    } ]
  }, {
    "tStartMs": 540930,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- I'd consider myself to\nbe a little bit open-minded"
    } ]
  }, {
    "tStartMs": 543630,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "in that aspect."
    } ]
  }, {
    "tStartMs": 544500,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- At least be open to learning."
    } ]
  }, {
    "tStartMs": 546060,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "- Yeah.\n- If it's on paper"
    } ]
  }, {
    "tStartMs": 547983,
    "dDurationMs": 2427,
    "segs": [ {
      "utf8": "and that's the way it is, I\nwould have to go with that."
    } ]
  }, {
    "tStartMs": 550410,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- I'm gonna have to deal with it."
    } ]
  }, {
    "tStartMs": 551310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "I can't be like, \"Well, I\nfeel like it's different.\""
    } ]
  }, {
    "tStartMs": 553500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- All I see here are\npeople who will continue"
    } ]
  }, {
    "tStartMs": 555900,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to hold partisan beliefs\nregardless of the evidence,"
    } ]
  }, {
    "tStartMs": 558720,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "all the while deluding themselves\ninto thinking they came"
    } ]
  }, {
    "tStartMs": 561090,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to these beliefs via an independent,"
    } ]
  }, {
    "tStartMs": 563220,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "sober consideration of the facts."
    } ]
  }, {
    "tStartMs": 567720,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "The truth is that mostly\nwe believe what we believe"
    } ]
  }, {
    "tStartMs": 571020,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to fit in with our tribe."
    } ]
  }, {
    "tStartMs": 574140,
    "dDurationMs": 4623,
    "segs": [ {
      "utf8": "And that, in the most important\nway, is highly rational."
    } ]
  }, {
    "tStartMs": 581610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Because humans are very social creatures,"
    } ]
  }, {
    "tStartMs": 584010,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and for most of our evolution,"
    } ]
  }, {
    "tStartMs": 585720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "we've depended on each other for survival."
    } ]
  }, {
    "tStartMs": 588390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Being ostracized from the\ngroup is almost as bad"
    } ]
  }, {
    "tStartMs": 590970,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "as walking off a cliff."
    } ]
  }, {
    "tStartMs": 592920,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "If we question the status quo by rejecting"
    } ]
  }, {
    "tStartMs": 595260,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "what those around us accept as true,"
    } ]
  }, {
    "tStartMs": 597270,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "we jeopardize our place in society."
    } ]
  }, {
    "tStartMs": 600450,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- Man, I've learned that\npeople are not as dissimilar"
    } ]
  }, {
    "tStartMs": 603750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "as we think."
    } ]
  }, {
    "tStartMs": 605340,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "That there is so many\nsimilarities between sides"
    } ]
  }, {
    "tStartMs": 610170,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that we think share nothing in common."
    } ]
  }, {
    "tStartMs": 612360,
    "dDurationMs": 3916,
    "segs": [ {
      "utf8": "- I attended Zoom meetings\nin the opposite party"
    } ]
  }, {
    "tStartMs": 616276,
    "dDurationMs": 2264,
    "segs": [ {
      "utf8": "and it was kind of scary"
    } ]
  }, {
    "tStartMs": 618540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "because they sounded just like my side."
    } ]
  }, {
    "tStartMs": 621780,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "- It makes you think about\nwhat we could get done"
    } ]
  }, {
    "tStartMs": 624036,
    "dDurationMs": 3357,
    "segs": [ {
      "utf8": "if we didn't have that burden,"
    } ]
  }, {
    "tStartMs": 628500,
    "dDurationMs": 2754,
    "segs": [ {
      "utf8": "and I think it would be\na pretty different world"
    } ]
  }, {
    "tStartMs": 631254,
    "dDurationMs": 4569,
    "segs": [ {
      "utf8": "and pretty extraordinary if\nwe managed to figure that out."
    } ]
  }, {
    "tStartMs": 638027,
    "dDurationMs": 1951,
    "segs": [ {
      "utf8": "- So what do we do about this?"
    } ]
  }, {
    "tStartMs": 639978,
    "dDurationMs": 3222,
    "segs": [ {
      "utf8": "Well, I don't think there\nis an easy solution,"
    } ]
  }, {
    "tStartMs": 643200,
    "dDurationMs": 2953,
    "segs": [ {
      "utf8": "but Kahan has identified a\nfew angles that might work."
    } ]
  }, {
    "tStartMs": 646153,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "One is avoiding partisan rhetoric."
    } ]
  }, {
    "tStartMs": 649320,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Rather than talk about gun\ncontrol or climate change,"
    } ]
  }, {
    "tStartMs": 652230,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "avoid the loaded terms"
    } ]
  }, {
    "tStartMs": 653610,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and instead focus on\nspecific local policies."
    } ]
  }, {
    "tStartMs": 656850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "No buzzwords that could trigger\nanyone into tribal thinking."
    } ]
  }, {
    "tStartMs": 659790,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "No villainizing the other side,"
    } ]
  }, {
    "tStartMs": 661830,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "just constructive solutions\nthat make sense given the data."
    } ]
  }, {
    "tStartMs": 665610,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "One example comes from southeast Florida"
    } ]
  }, {
    "tStartMs": 667950,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "where a bipartisan group of\nlawmakers have joined together"
    } ]
  }, {
    "tStartMs": 671100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to take action on sea-level rise."
    } ]
  }, {
    "tStartMs": 673500,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "The plans don't debate"
    } ]
  }, {
    "tStartMs": 674670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "whether climate change is manmade or not."
    } ]
  }, {
    "tStartMs": 676800,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "They just deal with existing\nchallenges faced by residents."
    } ]
  }, {
    "tStartMs": 680700,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The other thing is to\nfoster a curious mindset."
    } ]
  }, {
    "tStartMs": 684360,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- Maybe the science curious people,"
    } ]
  }, {
    "tStartMs": 686670,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "they're more willing to\nexamine all the evidence,"
    } ]
  }, {
    "tStartMs": 688740,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "including information that's inconsistent"
    } ]
  }, {
    "tStartMs": 691200,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "with their political ideology."
    } ]
  }, {
    "tStartMs": 693090,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "- With increasing science comprehension"
    } ]
  }, {
    "tStartMs": 695420,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "usually comes increasing\npolarization on political topics."
    } ]
  }, {
    "tStartMs": 699960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But with increasing science curiosity,"
    } ]
  }, {
    "tStartMs": 702300,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "this same increase in\npolarization is not observed."
    } ]
  }, {
    "tStartMs": 706410,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "That is a start."
    } ]
  }, {
    "tStartMs": 708720,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I am not going to claim\nto have the solution."
    } ]
  }, {
    "tStartMs": 711390,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Problems of this sort are likely as old"
    } ]
  }, {
    "tStartMs": 713580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "as the human species itself."
    } ]
  }, {
    "tStartMs": 715620,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "They are just much more obvious now"
    } ]
  }, {
    "tStartMs": 717810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that everyone can post, tweet, comment"
    } ]
  }, {
    "tStartMs": 719850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and basically shout loudly"
    } ]
  }, {
    "tStartMs": 721500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "into this nearly infinite digital space."
    } ]
  }, {
    "tStartMs": 724350,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The only thing I hope to\ndo is bring some awareness."
    } ]
  }, {
    "tStartMs": 727710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The beliefs of most people are not formed"
    } ]
  }, {
    "tStartMs": 730410,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "by a careful consideration of the data."
    } ]
  }, {
    "tStartMs": 732870,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "That includes me, and it\nprobably includes you."
    } ]
  }, {
    "tStartMs": 736290,
    "dDurationMs": 3789,
    "segs": [ {
      "utf8": "Acknowledging this is\nan important first step."
    } ]
  }, {
    "tStartMs": 740079,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 744210,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "One organization that is\ntrying to tackle polarization"
    } ]
  }, {
    "tStartMs": 747000,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and our information echo\nchambers is Ground News."
    } ]
  }, {
    "tStartMs": 750420,
    "dDurationMs": 3314,
    "segs": [ {
      "utf8": "So we specifically asked\nthem to sponsor this video"
    } ]
  }, {
    "tStartMs": 753734,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "because they gather news sources"
    } ]
  }, {
    "tStartMs": 756270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "from around the world in one spot"
    } ]
  }, {
    "tStartMs": 758100,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and show you any political\nleaning they have."
    } ]
  }, {
    "tStartMs": 760770,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "That way you can read about the same issue"
    } ]
  }, {
    "tStartMs": 762990,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "from different perspectives\nwith the context needed"
    } ]
  }, {
    "tStartMs": 765570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to separate facts from politics."
    } ]
  }, {
    "tStartMs": 768210,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "For instance, the FBI\nrecently released statistics"
    } ]
  }, {
    "tStartMs": 771060,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "about violent crime in the US."
    } ]
  }, {
    "tStartMs": 773550,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "This is a key political issue"
    } ]
  }, {
    "tStartMs": 775350,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that was referenced in\nthe presidential debate."
    } ]
  }, {
    "tStartMs": 778020,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Most left-leaning outlets\nfocused on the 3% drop"
    } ]
  }, {
    "tStartMs": 781410,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "in violent crime."
    } ]
  }, {
    "tStartMs": 782820,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Some use this to counter Trump's claim"
    } ]
  }, {
    "tStartMs": 785040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that crime is on the rise."
    } ]
  }, {
    "tStartMs": 787140,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "However, right-leaning sources\nsuggested crime increased"
    } ]
  }, {
    "tStartMs": 790710,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "under Harris and Biden in\nline with Trump's statements."
    } ]
  }, {
    "tStartMs": 794610,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So how can we have such a disagreement?"
    } ]
  }, {
    "tStartMs": 797670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Well, Ground News lets us dive deeper"
    } ]
  }, {
    "tStartMs": 799860,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "into the reporting to uncover"
    } ]
  }, {
    "tStartMs": 802434,
    "dDurationMs": 1086,
    "segs": [ {
      "utf8": "that right-leaning sources referenced"
    } ]
  }, {
    "tStartMs": 803520,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "a completely different\nreport, a DOJ survey."
    } ]
  }, {
    "tStartMs": 806820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And this survey collected data differently"
    } ]
  }, {
    "tStartMs": 809340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and crucially, couldn't\ninclude fatal crimes,"
    } ]
  }, {
    "tStartMs": 812310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "while the FBI statistics did."
    } ]
  }, {
    "tStartMs": 814590,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Similarly, the FBI statistics"
    } ]
  }, {
    "tStartMs": 816570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "couldn't include unreported crimes"
    } ]
  }, {
    "tStartMs": 818610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "while the DOJ survey specifically does."
    } ]
  }, {
    "tStartMs": 821460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So we're comparing\napples and oranges here,"
    } ]
  }, {
    "tStartMs": 824100,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "which is the source of the disagreement."
    } ]
  }, {
    "tStartMs": 826710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "This kind of critical thinking is crucial"
    } ]
  }, {
    "tStartMs": 828720,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "to keeping our biases in check"
    } ]
  }, {
    "tStartMs": 830610,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and so is personal accountability."
    } ]
  }, {
    "tStartMs": 833070,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "Ground News helps here too"
    } ]
  }, {
    "tStartMs": 835674,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "with data-driven insights"
    } ]
  }, {
    "tStartMs": 837103,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "from your personal News Bias dashboard."
    } ]
  }, {
    "tStartMs": 838950,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This lets you track your\nown potential blind spots"
    } ]
  }, {
    "tStartMs": 841560,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and biases so you can\nidentify and correct them."
    } ]
  }, {
    "tStartMs": 844650,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Check it out at groundnews.com/ve"
    } ]
  }, {
    "tStartMs": 847950,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "or scan this QR code."
    } ]
  }, {
    "tStartMs": 849840,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "By subscribing through our\nlink, you can get a 50% discount"
    } ]
  }, {
    "tStartMs": 852930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "off the Unlimited Access Vantage Plan."
    } ]
  }, {
    "tStartMs": 855360,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "This is their biggest\ndiscount of the year,"
    } ]
  }, {
    "tStartMs": 857100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and it's only available\nfor a limited time."
    } ]
  }, {
    "tStartMs": 859800,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "You know, Ground News\nis subscriber supported,"
    } ]
  }, {
    "tStartMs": 862410,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so by subscribing you're\ndirectly contributing"
    } ]
  }, {
    "tStartMs": 864600,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "to the development of the platform"
    } ]
  }, {
    "tStartMs": 866861,
    "dDurationMs": 2719,
    "segs": [ {
      "utf8": "and a more transparent,\nless tribal political arena."
    } ]
  }, {
    "tStartMs": 869580,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So I want to thank Ground\nNews for sponsoring this video"
    } ]
  }, {
    "tStartMs": 872370,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
