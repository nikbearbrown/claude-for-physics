    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "scan this QR code or go to\nbrilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1513136,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "I will put that link\ndown in the description."
    } ]
  }, {
    "tStartMs": 1515639,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "For viewers of this channel,"
    } ]
  }, {
