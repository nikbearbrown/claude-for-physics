    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "you sign up for a 30-day trial just go\nto audible.com/veritasium or text"
    } ]
  }, {
    "tStartMs": 520670,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "veritasium to 500 500 now the book I'm\nlistening to at the moment is by my"
    } ]
  }, {
    "tStartMs": 525050,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "friend Hank green it's called an\nabsolutely remarkable thing and it's a"
    } ]
  }, {
    "tStartMs": 529070,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "novel about a girl who\nstumbles upon a giant robot in New York"
