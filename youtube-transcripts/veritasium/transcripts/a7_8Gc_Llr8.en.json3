{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "What is a candle flame really made of?"
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I am at the Palace of Discovery in Paris to\ndo an experiment"
    } ]
  }, {
    "tStartMs": 7080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that beautifully demonstrates the answers."
    } ]
  }, {
    "tStartMs": 17060,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Ok so we're turning on an electric field here"
    } ]
  }, {
    "tStartMs": 18500,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and we see that the flame is spreading out."
    } ]
  }, {
    "tStartMs": 35540,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Thats very cute,"
    } ]
  }, {
    "tStartMs": 36380,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "it's like a butterfly."
    } ]
  }, {
    "tStartMs": 42500,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And you can see that the flame"
    } ]
  }, {
    "tStartMs": 44060,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "has two separate pieces to it now."
    } ]
  }, {
    "tStartMs": 47180,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "One is going towards the negative plate."
    } ]
  }, {
    "tStartMs": 49260,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Those would be the positive ions,"
    } ]
  }, {
    "tStartMs": 50720,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "and the negative ions will be going\ntowards a positively charged plate."
    } ]
  }, {
    "tStartMs": 53580,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So we see the flame kinda flattening out."
    } ]
  }, {
    "tStartMs": 55740,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "But if that didn't convince you"
    } ]
  }, {
    "tStartMs": 57100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "that flame contains ions,"
    } ]
  }, {
    "tStartMs": 58700,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "then check part two of our experiment"
    } ]
  }, {
    "tStartMs": 60480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "where we compare the conductivity of a"
    } ]
  }, {
    "tStartMs": 62080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "flame to the connectivity of air,"
    } ]
  }, {
    "tStartMs": 64240,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which is normally a pretty good insulator."
    } ]
  }, {
    "tStartMs": 66380,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "It requires about 10,000 volts"
    } ]
  }, {
    "tStartMs": 67740,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to break down a centimeter of air."
    } ]
  }, {
    "tStartMs": 69740,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "So right now this plate is is about 20,000 V."
    } ]
  }, {
    "tStartMs": 73800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "You see that the spark is only little,"
    } ]
  }, {
    "tStartMs": 78120,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "but if I put it around the flame,"
    } ]
  }, {
    "tStartMs": 79660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "we will see if we can get a bigger spark happen."
    } ]
  }, {
    "tStartMs": 83420,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Look at that, yeaaa!"
    } ]
  }, {
    "tStartMs": 90200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Because the flame has those ions in it,"
    } ]
  }, {
    "tStartMs": 92120,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "that means that we can break down"
    } ]
  }, {
    "tStartMs": 93580,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "a greater distance of air."
    } ]
  }, {
    "tStartMs": 96340,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "This greater conductivity."
    } ]
  }, {
    "tStartMs": 103060,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "It's awesome!\nYou love doing this, right?"
    } ]
  }, {
    "tStartMs": 106520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "A strong enough electric field"
    } ]
  }, {
    "tStartMs": 108260,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "can actually extinguish the flame"
    } ]
  }, {
    "tStartMs": 110280,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "but watch carefully what happens \nwhen the flame goes out."
    } ]
  }, {
    "tStartMs": 123660,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Just like in the flame, \nthe opposite charges in the smoke"
    } ]
  }, {
    "tStartMs": 126580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "are pulled in opposite directions."
    } ]
  }, {
    "tStartMs": 128580,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Now while some may argue that a flame is not"
    } ]
  }, {
    "tStartMs": 131280,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "truly a plasma because it's not hot enough"
    } ]
  }, {
    "tStartMs": 133500,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and it doesn't have a high enough density of ions,"
    } ]
  }, {
    "tStartMs": 136160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "one thing is for sure, it does contain ions"
    } ]
  }, {
    "tStartMs": 138640,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "which have important electrical properties,"
    } ]
  }, {
    "tStartMs": 140700,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "which can be demonstrated if \nyou have a strong enough electric field."
    } ]
  } ]
}
