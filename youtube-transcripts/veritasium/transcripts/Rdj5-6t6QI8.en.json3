{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 150,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Let's torch it!"
    } ]
  }, {
    "tStartMs": 1410,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Previously on Veritasium, we\nlearned how Hans Goldschmidt"
    } ]
  }, {
    "tStartMs": 4350,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "discovered that metal oxide-like rust"
    } ]
  }, {
    "tStartMs": 6540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "can react with aluminum powder"
    } ]
  }, {
    "tStartMs": 8220,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to produce pure liquid metal."
    } ]
  }, {
    "tStartMs": 10380,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Oh!"
    } ]
  }, {
    "tStartMs": 11970,
    "dDurationMs": 3596,
    "segs": [ {
      "utf8": "Reactions of this type are\nknown as thermite reactions."
    } ]
  }, {
    "tStartMs": 15566,
    "dDurationMs": 1009,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 16575,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Whoa! (laughs)"
    } ]
  }, {
    "tStartMs": 17408,
    "dDurationMs": 1915,
    "segs": [ {
      "utf8": "Whoa! Yeah!"
    } ]
  }, {
    "tStartMs": 19323,
    "dDurationMs": 2298,
    "segs": [ {
      "utf8": "(explosions popping)"
    } ]
  }, {
    "tStartMs": 21621,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "That is crazy!"
    } ]
  }, {
    "tStartMs": 22918,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 23768,
    "dDurationMs": 1355,
    "segs": [ {
      "utf8": "(dramatic music continues)"
    } ]
  }, {
    "tStartMs": 25123,
    "dDurationMs": 2897,
    "segs": [ {
      "utf8": "Initially, thermite found\nlimited applications,"
    } ]
  }, {
    "tStartMs": 28020,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "repairing heavy machinery\nin remote locations."
    } ]
  }, {
    "tStartMs": 31440,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's much more common use,"
    } ]
  }, {
    "tStartMs": 33030,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The one where it's widely employed today,"
    } ]
  }, {
    "tStartMs": 35910,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "took a bit more convincing."
    } ]
  }, {
    "tStartMs": 38910,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "There is one sound that everyone\nassociates with railroads."
    } ]
  }, {
    "tStartMs": 42750,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "(soft banjo music)\n(train wheels clacking)"
    } ]
  }, {
    "tStartMs": 45660,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "This is the sound of\ntrain wheels passing over"
    } ]
  }, {
    "tStartMs": 48360,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "the join between one rail and the next."
    } ]
  }, {
    "tStartMs": 52980,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "In the early days of railroads,\nsteel mills produced rails"
    } ]
  }, {
    "tStartMs": 56370,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that were around 12 meters long."
    } ]
  }, {
    "tStartMs": 58740,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Then, out in the field,"
    } ]
  }, {
    "tStartMs": 60090,
    "dDurationMs": 3049,
    "segs": [ {
      "utf8": "these were bolted together\nusing fish plates."
    } ]
  }, {
    "tStartMs": 63139,
    "dDurationMs": 1811,
    "segs": [ {
      "utf8": "(soft banjo music fades)"
    } ]
  }, {
    "tStartMs": 64950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- That would create these little gaps"
    } ]
  }, {
    "tStartMs": 66660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "between the pieces of rail."
    } ]
  }, {
    "tStartMs": 69000,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And cause this kinda like signature sound,"
    } ]
  }, {
    "tStartMs": 72030,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "This ta-tak, ta-tak, right?"
    } ]
  }, {
    "tStartMs": 73500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "And everybody who thinks railroad,"
    } ]
  }, {
    "tStartMs": 75333,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "this this ta-tak, ta-tak, ta-tak, ta-tak,"
    } ]
  }, {
    "tStartMs": 79170,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "even though we don't hear that anymore."
    } ]
  }, {
    "tStartMs": 83820,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But we still imagine it\nbecause it was so signature"
    } ]
  }, {
    "tStartMs": 87270,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "for the sound to ride on the train"
    } ]
  }, {
    "tStartMs": 89957,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "(train wheels clacking)"
    } ]
  }, {
    "tStartMs": 91410,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "- The track would flex, causing\nthe train to rock and roll,"
    } ]
  }, {
    "tStartMs": 95640,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and it would also increase\nthe wear on the wheels"
    } ]
  }, {
    "tStartMs": 98580,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and create vibrations in the tracks,"
    } ]
  }, {
    "tStartMs": 100590,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "so they required frequent maintenance."
    } ]
  }, {
    "tStartMs": 103770,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So you might expect that\nafter thermite was invented,"
    } ]
  }, {
    "tStartMs": 106770,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "railroads would've been excited"
    } ]
  }, {
    "tStartMs": 108540,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "to weld their rails\ntogether with liquid metal,"
    } ]
  }, {
    "tStartMs": 113190,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "but that was not the case."
    } ]
  }, {
    "tStartMs": 115984,
    "dDurationMs": 1256,
    "segs": [ {
      "utf8": "(soft whimsical music)"
    } ]
  }, {
    "tStartMs": 117240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- They would never have\nthe idea to weld them."
    } ]
  }, {
    "tStartMs": 119880,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "If he'd come to a railroad\nmanager and told them,"
    } ]
  }, {
    "tStartMs": 123487,
    "dDurationMs": 1313,
    "segs": [ {
      "utf8": "\"I'm Dr. Hans Goldschmidt,"
    } ]
  }, {
    "tStartMs": 124800,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I have a process by which I\ncan weld your thumbs together.\""
    } ]
  }, {
    "tStartMs": 127860,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "To these railroad managers,"
    } ]
  }, {
    "tStartMs": 129930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that would've sounded more useful"
    } ]
  }, {
    "tStartMs": 131640,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "than what he actually proposed,"
    } ]
  }, {
    "tStartMs": 133230,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "which was welding their rail."
    } ]
  }, {
    "tStartMs": 135810,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- See, the gaps between rails\nwere considered essential,"
    } ]
  }, {
    "tStartMs": 138990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "because railroads are\nexposed to the elements"
    } ]
  }, {
    "tStartMs": 141540,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "all year round."
    } ]
  }, {
    "tStartMs": 142680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, they shrink when\nthey get cold in winter,"
    } ]
  }, {
    "tStartMs": 145020,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and expand in the heat of summer."
    } ]
  }, {
    "tStartMs": 147720,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "An increase of 40 degrees Celsius"
    } ]
  }, {
    "tStartMs": 149790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "would cause a 12 meter length of rail"
    } ]
  }, {
    "tStartMs": 152040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to grow by six millimeters."
    } ]
  }, {
    "tStartMs": 154740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Without gaps in the rail,"
    } ]
  }, {
    "tStartMs": 156060,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "people expected kilometers of railway"
    } ]
  }, {
    "tStartMs": 158340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to expand and buckle,"
    } ]
  }, {
    "tStartMs": 160530,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "leading to the worst possible outcome."
    } ]
  }, {
    "tStartMs": 163800,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Train derailments."
    } ]
  }, {
    "tStartMs": 166170,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "So if someone pitched,"
    } ]
  }, {
    "tStartMs": 167287,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "\"We're just gonna connect\nall the rails together.\""
    } ]
  }, {
    "tStartMs": 169800,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "That would be a terrible idea."
    } ]
  }, {
    "tStartMs": 170970,
    "dDurationMs": 1692,
    "segs": [ {
      "utf8": "- That would be a terrible idea."
    } ]
  }, {
    "tStartMs": 172662,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 173495,
    "dDurationMs": 1825,
    "segs": [ {
      "utf8": "The longer the rail, the bigger the gap,"
    } ]
  }, {
    "tStartMs": 175320,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "the bigger the problem."
    } ]
  }, {
    "tStartMs": 176460,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "And now somebody says, \"Hey,\nI can make an infinite rail.\""
    } ]
  }, {
    "tStartMs": 179703,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "That just causes an infinite problem."
    } ]
  }, {
    "tStartMs": 182344,
    "dDurationMs": 1016,
    "segs": [ {
      "utf8": "(dramatic music continues)"
    } ]
  }, {
    "tStartMs": 183360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- The first ones that were\nactually willing to discuss this"
    } ]
  }, {
    "tStartMs": 186360,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "were the tram rails."
    } ]
  }, {
    "tStartMs": 188610,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Tram rails, they're in cities,"
    } ]
  }, {
    "tStartMs": 190530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "they're embedded into the streets."
    } ]
  }, {
    "tStartMs": 192870,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Tram rail is much, much smaller,"
    } ]
  }, {
    "tStartMs": 195270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so the forces are much less."
    } ]
  }, {
    "tStartMs": 197190,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, the tram rails were the first ones"
    } ]
  }, {
    "tStartMs": 199500,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "that were interested in,"
    } ]
  }, {
    "tStartMs": 200737,
    "dDurationMs": 2873,
    "segs": [ {
      "utf8": "\"How can we kind of get rid\nof this ta-tak, ta-tak?\""
    } ]
  }, {
    "tStartMs": 203610,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Because it's kind of annoying,"
    } ]
  }, {
    "tStartMs": 204930,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you know, in the middle of the street."
    } ]
  }, {
    "tStartMs": 207120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "That was basically the first attempts."
    } ]
  }, {
    "tStartMs": 209010,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "And I think in Essen, and\nthen later on in other cities"
    } ]
  }, {
    "tStartMs": 213493,
    "dDurationMs": 857,
    "segs": [ {
      "utf8": "(mellow guitar music)"
    } ]
  }, {
    "tStartMs": 214350,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- For this video, I got the opportunity"
    } ]
  }, {
    "tStartMs": 216120,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to weld two rails together using thermite."
    } ]
  }, {
    "tStartMs": 218790,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And I'm going to take you through"
    } ]
  }, {
    "tStartMs": 220500,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "the eight steps in the process."
    } ]
  }, {
    "tStartMs": 223500,
    "dDurationMs": 2115,
    "segs": [ {
      "utf8": "First, I'll show you how I did it..."
    } ]
  }, {
    "tStartMs": 225615,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Derek sighs)"
    } ]
  }, {
    "tStartMs": 226448,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "Man, this is difficult."
    } ]
  }, {
    "tStartMs": 227910,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And then we'll compare that\nwith how the pros do it."
    } ]
  }, {
    "tStartMs": 230910,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "All experiments were performed"
    } ]
  }, {
    "tStartMs": 232530,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "under the supervision of professionals,"
    } ]
  }, {
    "tStartMs": 234330,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "with proper safety precautions."
    } ]
  }, {
    "tStartMs": 236460,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Okay. We're out here in\nthe German countryside,"
    } ]
  }, {
    "tStartMs": 239130,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "and tonight they're going\nto be welding this rail."
    } ]
  }, {
    "tStartMs": 243540,
    "dDurationMs": 2152,
    "segs": [ {
      "utf8": "They're gonna do like 150 welds tonight."
    } ]
  }, {
    "tStartMs": 245692,
    "dDurationMs": 2588,
    "segs": [ {
      "utf8": "(mellow guitar music fades)"
    } ]
  }, {
    "tStartMs": 248280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "When you're welding rail for real,"
    } ]
  }, {
    "tStartMs": 250290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "you wanna do it at the neutral\ntemperature of the rail."
    } ]
  }, {
    "tStartMs": 253170,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "That is, a predefined\ntemperature at which the rail"
    } ]
  }, {
    "tStartMs": 255870,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "should have no stress in it."
    } ]
  }, {
    "tStartMs": 257940,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- And is the temperature by\nwhich that piece of track"
    } ]
  }, {
    "tStartMs": 260970,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "that you're welding in,"
    } ]
  }, {
    "tStartMs": 261840,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is supposed to have zero tension."
    } ]
  }, {
    "tStartMs": 263580,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "When it gets colder than this,"
    } ]
  }, {
    "tStartMs": 264720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "there's going to be negative tension,"
    } ]
  }, {
    "tStartMs": 266220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and when it gets warmer,\nthere's positive tension."
    } ]
  }, {
    "tStartMs": 268500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- And since we were filming\nin Germany in the summer,"
    } ]
  }, {
    "tStartMs": 271200,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "they weld at night, after\nthe rail has cooled off."
    } ]
  }, {
    "tStartMs": 274950,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Initially, when the rails are laid out,"
    } ]
  }, {
    "tStartMs": 276750,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "they're placed so they're\ntouching each other."
    } ]
  }, {
    "tStartMs": 279330,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And the first step in welding rail"
    } ]
  }, {
    "tStartMs": 281250,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is therefore to create a gap into which"
    } ]
  }, {
    "tStartMs": 283590,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we'll pour the liquid thermite steel."
    } ]
  }, {
    "tStartMs": 286110,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So, you have to cut about\ntwo and a half centimeters"
    } ]
  }, {
    "tStartMs": 288570,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "off the end of one rail."
    } ]
  }, {
    "tStartMs": 290610,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": "This can be done with a circular saw."
    } ]
  }, {
    "tStartMs": 293047,
    "dDurationMs": 1532,
    "segs": [ {
      "utf8": "Let's do this."
    } ]
  }, {
    "tStartMs": 294579,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "(circular saw revs)\nCutting a rail."
    } ]
  }, {
    "tStartMs": 296700,
    "dDurationMs": 3075,
    "segs": [ {
      "utf8": "Out in the field, they cut\ntheir gap with a torch."
    } ]
  }, {
    "tStartMs": 299775,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "(mellow guitar music)"
    } ]
  }, {
    "tStartMs": 301575,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Looks good.\n(circular saw buzzing)"
    } ]
  }, {
    "tStartMs": 309402,
    "dDurationMs": 1892,
    "segs": [ {
      "utf8": "(mellow guitar music continues)"
    } ]
  }, {
    "tStartMs": 311294,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "Whew!"
    } ]
  }, {
    "tStartMs": 312304,
    "dDurationMs": 986,
    "segs": [ {
      "utf8": "I just need to take a little break."
    } ]
  }, {
    "tStartMs": 313290,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "Ugh."
    } ]
  }, {
    "tStartMs": 314733,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "That is really exhausting."
    } ]
  }, {
    "tStartMs": 316837,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(circular saw buzzing)"
    } ]
  }, {
    "tStartMs": 323430,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The next step is to line up the rail"
    } ]
  }, {
    "tStartMs": 325410,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "so the weld will make\na seamless connection."
    } ]
  }, {
    "tStartMs": 328290,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Both rails have to be angled\nslightly up toward the gap."
    } ]
  }, {
    "tStartMs": 332070,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This is because when the liquid\nthermite steel is poured in,"
    } ]
  }, {
    "tStartMs": 335100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "it will contract as it cools,"
    } ]
  }, {
    "tStartMs": 337350,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which creates an inward pulling force."
    } ]
  }, {
    "tStartMs": 339930,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But that force won't\nbe the same everywhere."
    } ]
  }, {
    "tStartMs": 342360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Since there's more metal at the top,"
    } ]
  }, {
    "tStartMs": 344220,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "there's more force pulling\nthe rail together there."
    } ]
  }, {
    "tStartMs": 346920,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So, that's why the rails\nhave to be angled up,"
    } ]
  }, {
    "tStartMs": 349590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "so that after the liquid steel contracts,"
    } ]
  }, {
    "tStartMs": 351990,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "the rails will be perfectly flat."
    } ]
  }, {
    "tStartMs": 355170,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "- Now you take one of the wrenches,"
    } ]
  }, {
    "tStartMs": 356667,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "and put it a little bit under the rail."
    } ]
  }, {
    "tStartMs": 359430,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Like there? Or like this?"
    } ]
  }, {
    "tStartMs": 361830,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Sideways."
    } ]
  }, {
    "tStartMs": 362663,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "- Sideways would be a little bit better."
    } ]
  }, {
    "tStartMs": 363720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep.\n(metal clangs)"
    } ]
  }, {
    "tStartMs": 364553,
    "dDurationMs": 847,
    "segs": [ {
      "utf8": "- [Christoph] Yep, that's fine."
    } ]
  }, {
    "tStartMs": 365400,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "- [Derek] Okay."
    } ]
  }, {
    "tStartMs": 366568,
    "dDurationMs": 1682,
    "segs": [ {
      "utf8": "- Same goes for the other side."
    } ]
  }, {
    "tStartMs": 368250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "We will check."
    } ]
  }, {
    "tStartMs": 369900,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "There's no gap at the moment."
    } ]
  }, {
    "tStartMs": 371490,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "We need 2.42, 3.6 here."
    } ]
  }, {
    "tStartMs": 375390,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Hit it.\n(hammer clangs)"
    } ]
  }, {
    "tStartMs": 377160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But now this rail is way\nhigher than this one,"
    } ]
  }, {
    "tStartMs": 379560,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and we want to have both on the same high."
    } ]
  }, {
    "tStartMs": 382380,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Means now we have to hit this batch."
    } ]
  }, {
    "tStartMs": 385230,
    "dDurationMs": 3296,
    "segs": [ {
      "utf8": "We do that so long until\nwe have correct height."
    } ]
  }, {
    "tStartMs": 388526,
    "dDurationMs": 1744,
    "segs": [ {
      "utf8": "(hammer clangs)\n(whimsical music)"
    } ]
  }, {
    "tStartMs": 390270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay, stop."
    } ]
  }, {
    "tStartMs": 397132,
    "dDurationMs": 1406,
    "segs": [ {
      "utf8": "Up."
    } ]
  }, {
    "tStartMs": 398538,
    "dDurationMs": 1362,
    "segs": [ {
      "utf8": "(hammer clangs)"
    } ]
  }, {
    "tStartMs": 399900,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- In addition to the vertical alignment,"
    } ]
  }, {
    "tStartMs": 401640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "the rails also have to\nbe horizontally aligned."
    } ]
  }, {
    "tStartMs": 404490,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Christoph] If we take a look here,"
    } ]
  }, {
    "tStartMs": 405930,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "there's a large gap between the\nstraight edge and the rails."
    } ]
  }, {
    "tStartMs": 409200,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- [Derek] There's a gap there."
    } ]
  }, {
    "tStartMs": 410190,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Christoph] And they need to-"
    } ]
  }, {
    "tStartMs": 411023,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "- [Derek] We need more\nof a peak this side."
    } ]
  }, {
    "tStartMs": 412560,
    "dDurationMs": 898,
    "segs": [ {
      "utf8": "- [Christoph] Yeah."
    } ]
  }, {
    "tStartMs": 413458,
    "dDurationMs": 1112,
    "segs": [ {
      "utf8": "- Okay.\n(hammer clangs)"
    } ]
  }, {
    "tStartMs": 414570,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And it's a frustrating process,"
    } ]
  }, {
    "tStartMs": 416100,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "because trying to align them horizontally"
    } ]
  }, {
    "tStartMs": 417870,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "throws out the vertical\nalignment and vice versa."
    } ]
  }, {
    "tStartMs": 420900,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "I'm lucky I had help, or I\nwould've been here for hours."
    } ]
  }, {
    "tStartMs": 425250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "When we were finally done that,"
    } ]
  }, {
    "tStartMs": 426900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "we double checked the alignment"
    } ]
  }, {
    "tStartMs": 428430,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "at the head and foot of the rail,"
    } ]
  }, {
    "tStartMs": 431070,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and we made a terrifying discovery."
    } ]
  }, {
    "tStartMs": 434400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- Our rail is twisted."
    } ]
  }, {
    "tStartMs": 436860,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "- [Derek] Even though both\nrails were aligned at the top,"
    } ]
  }, {
    "tStartMs": 439860,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "One rail was slightly twisted\nrelative to the other,"
    } ]
  }, {
    "tStartMs": 442710,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "which you can see by it\nnot lining up at the foot."
    } ]
  }, {
    "tStartMs": 446100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Christoph] We have a maximum tolerance"
    } ]
  }, {
    "tStartMs": 447480,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that is allowed here of two millimeters."
    } ]
  }, {
    "tStartMs": 449370,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Yep."
    } ]
  }, {
    "tStartMs": 450203,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- Here we have more than two millimeters,"
    } ]
  }, {
    "tStartMs": 451620,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so we have to untwist the rail."
    } ]
  }, {
    "tStartMs": 454920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- This, of course,"
    } ]
  }, {
    "tStartMs": 455753,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "throughout the vertical\nand horizontal alignment,"
    } ]
  }, {
    "tStartMs": 457800,
    "dDurationMs": 2338,
    "segs": [ {
      "utf8": "so we had to do that all over again."
    } ]
  }, {
    "tStartMs": 460138,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "(hammer clangs)"
    } ]
  }, {
    "tStartMs": 461460,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Are we getting closer?"
    } ]
  }, {
    "tStartMs": 462870,
    "dDurationMs": 935,
    "segs": [ {
      "utf8": "- [Christoph] A little bit more."
    } ]
  }, {
    "tStartMs": 463805,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(hammer clangs)"
    } ]
  }, {
    "tStartMs": 464638,
    "dDurationMs": 1082,
    "segs": [ {
      "utf8": "- [Derek] But out in the field,"
    } ]
  }, {
    "tStartMs": 465720,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the guys align the rail\nso quickly and easily,"
    } ]
  }, {
    "tStartMs": 468780,
    "dDurationMs": 1982,
    "segs": [ {
      "utf8": "It really is an art."
    } ]
  }, {
    "tStartMs": 470762,
    "dDurationMs": 2045,
    "segs": [ {
      "utf8": "(hammers clanging)"
    } ]
  }, {
    "tStartMs": 472807,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(objects rattling)"
    } ]
  }, {
    "tStartMs": 477150,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- Now we can adjust the clamping device."
    } ]
  }, {
    "tStartMs": 479760,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] This will hold the mold shoes"
    } ]
  }, {
    "tStartMs": 481530,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and preheating torch in place."
    } ]
  }, {
    "tStartMs": 483420,
    "dDurationMs": 1744,
    "segs": [ {
      "utf8": "- The preheating torch will sit in here."
    } ]
  }, {
    "tStartMs": 485164,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 485997,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "- [Christoph] And we will\nkeep the molds in place"
    } ]
  }, {
    "tStartMs": 487860,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "with that arms here."
    } ]
  }, {
    "tStartMs": 489210,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 490043,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "- [Christoph] The next step,\nwe will align the burner."
    } ]
  }, {
    "tStartMs": 491760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- It's really important to\nalign the torch properly,"
    } ]
  }, {
    "tStartMs": 494520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "so that both sides of the\nrail get heated equally."
    } ]
  }, {
    "tStartMs": 497310,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I mean, I think it looks pretty good,"
    } ]
  }, {
    "tStartMs": 499170,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "but maybe a little bit that way,"
    } ]
  }, {
    "tStartMs": 500430,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "so maybe it could go just a touch."
    } ]
  }, {
    "tStartMs": 503100,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Christoph] There's one\nmold, and the plug for you."
    } ]
  }, {
    "tStartMs": 504960,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- [Derek] Next, we'll put the\nmolds inside the mold shoes,"
    } ]
  }, {
    "tStartMs": 507870,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "attach them to the clamps..."
    } ]
  }, {
    "tStartMs": 509130,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Line 'em up."
    } ]
  }, {
    "tStartMs": 509970,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And align both sides."
    } ]
  }, {
    "tStartMs": 511950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It's essential to make\nthe seal water tight,"
    } ]
  }, {
    "tStartMs": 514710,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "because liquid steel\nis as liquid as water,"
    } ]
  }, {
    "tStartMs": 518010,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "but almost eight times more dense."
    } ]
  }, {
    "tStartMs": 520620,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So if it's not sealed properly,"
    } ]
  }, {
    "tStartMs": 522600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the steel would just pour out."
    } ]
  }, {
    "tStartMs": 524400,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "It looks pretty good."
    } ]
  }, {
    "tStartMs": 525330,
    "dDurationMs": 1028,
    "segs": [ {
      "utf8": "- [Christoph] I hope so."
    } ]
  }, {
    "tStartMs": 526358,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(both laughing)"
    } ]
  }, {
    "tStartMs": 527191,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "- I didn't expect us to get\nit this good on our first go,"
    } ]
  }, {
    "tStartMs": 529830,
    "dDurationMs": 2691,
    "segs": [ {
      "utf8": "after just the trouble aligning the rails."
    } ]
  }, {
    "tStartMs": 532521,
    "dDurationMs": 2949,
    "segs": [ {
      "utf8": "(whimsical music)"
    } ]
  }, {
    "tStartMs": 535470,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- The alining the rails is\none of the hardest parts."
    } ]
  }, {
    "tStartMs": 537780,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Ugh."
    } ]
  }, {
    "tStartMs": 538770,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It's madness."
    } ]
  }, {
    "tStartMs": 540090,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So, this is sand? Like beach sand?"
    } ]
  }, {
    "tStartMs": 542790,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- No, it has larger amount of clay inside."
    } ]
  }, {
    "tStartMs": 546030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It holds in place and seals."
    } ]
  }, {
    "tStartMs": 548520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I will start sealing this side,"
    } ]
  }, {
    "tStartMs": 550830,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "you can start sealing this side."
    } ]
  }, {
    "tStartMs": 553080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I start sealing with hand,"
    } ]
  }, {
    "tStartMs": 554820,
    "dDurationMs": 4121,
    "segs": [ {
      "utf8": "and I will compact it\nwith stamping the walls."
    } ]
  }, {
    "tStartMs": 558941,
    "dDurationMs": 2389,
    "segs": [ {
      "utf8": "(whimsical music)\n(tools clattering)"
    } ]
  }, {
    "tStartMs": 561330,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Derek] And to make sure\nthat none of the liquid metal"
    } ]
  }, {
    "tStartMs": 563640,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "can spill out,"
    } ]
  }, {
    "tStartMs": 564480,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "we pack in additional sand\nall over on the sides,"
    } ]
  }, {
    "tStartMs": 568560,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "so there's absolutely no gaps."
    } ]
  }, {
    "tStartMs": 572283,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 573116,
    "dDurationMs": 2224,
    "segs": [ {
      "utf8": "Then it's time for one of\nthe most crucial steps,"
    } ]
  }, {
    "tStartMs": 575340,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to preheat the rail."
    } ]
  }, {
    "tStartMs": 576930,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "- [Christoph] Put it\nin, tighten the screw,"
    } ]
  }, {
    "tStartMs": 578387,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "and the opening the valve."
    } ]
  }, {
    "tStartMs": 580740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Derek] We also prepared\na demo behind glass,"
    } ]
  }, {
    "tStartMs": 583080,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "so we can see into the welding process,"
    } ]
  }, {
    "tStartMs": 585180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "including preheating."
    } ]
  }, {
    "tStartMs": 587400,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Preheating is essential for a few reasons."
    } ]
  }, {
    "tStartMs": 590070,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "First, it gets rid of any moisture"
    } ]
  }, {
    "tStartMs": 592200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and other volatiles in the mold,"
    } ]
  }, {
    "tStartMs": 593910,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "which would create bubbles"
    } ]
  }, {
    "tStartMs": 595140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "when the molten steel is poured in."
    } ]
  }, {
    "tStartMs": 597570,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Second, it makes both\nrail ends really hot,"
    } ]
  }, {
    "tStartMs": 600990,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "which is crucial because\nthe rate of heat transferred"
    } ]
  }, {
    "tStartMs": 603750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "depends on the difference in temperature"
    } ]
  }, {
    "tStartMs": 605400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "between two materials."
    } ]
  }, {
    "tStartMs": 607110,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If we poured liquid steel in between"
    } ]
  }, {
    "tStartMs": 609630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "two room temperature rails,"
    } ]
  }, {
    "tStartMs": 611580,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "well, the liquid steel would cool rapidly,"
    } ]
  }, {
    "tStartMs": 614310,
    "dDurationMs": 2028,
    "segs": [ {
      "utf8": "and that's a problem."
    } ]
  }, {
    "tStartMs": 616338,
    "dDurationMs": 1722,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 618060,
    "dDurationMs": 2644,
    "segs": [ {
      "utf8": "- We will heat up two pieces of rail..."
    } ]
  }, {
    "tStartMs": 620704,
    "dDurationMs": 2216,
    "segs": [ {
      "utf8": "(torch hisses)"
    } ]
  }, {
    "tStartMs": 622920,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "And we will cool down one\nreally fast in water..."
    } ]
  }, {
    "tStartMs": 625857,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "(torch hisses)"
    } ]
  }, {
    "tStartMs": 628290,
    "dDurationMs": 4017,
    "segs": [ {
      "utf8": "And the other one we will\ncool down in sand, so, slowly."
    } ]
  }, {
    "tStartMs": 632307,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "(tense music continues)"
    } ]
  }, {
    "tStartMs": 633720,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Just to show how the hardness increase"
    } ]
  }, {
    "tStartMs": 636330,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "depending on the cool-down time."
    } ]
  }, {
    "tStartMs": 640500,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "And now you try to break it."
    } ]
  }, {
    "tStartMs": 645390,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- That's hard to bend, actually."
    } ]
  }, {
    "tStartMs": 648813,
    "dDurationMs": 1396,
    "segs": [ {
      "utf8": "(Derek grunts)"
    } ]
  }, {
    "tStartMs": 650209,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "(whimsical music)\n(tool clangs)"
    } ]
  }, {
    "tStartMs": 651448,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(hammer thuds)"
    } ]
  }, {
    "tStartMs": 658200,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Yeah, it's hard to bend."
    } ]
  }, {
    "tStartMs": 659790,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "That's the one that was in the water."
    } ]
  }, {
    "tStartMs": 661500,
    "dDurationMs": 886,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 662386,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And we cooled it down really fast."
    } ]
  }, {
    "tStartMs": 664486,
    "dDurationMs": 1938,
    "segs": [ {
      "utf8": "(whimsical music continues)"
    } ]
  }, {
    "tStartMs": 666424,
    "dDurationMs": 1286,
    "segs": [ {
      "utf8": "(metal clangs)"
    } ]
  }, {
    "tStartMs": 667710,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And that is how to break it."
    } ]
  }, {
    "tStartMs": 670860,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "And now you see how the structure\nof the steel has changed."
    } ]
  }, {
    "tStartMs": 675090,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It breaks very easily."
    } ]
  }, {
    "tStartMs": 677280,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Derek] That's because\nwhen steel cools rapidly,"
    } ]
  }, {
    "tStartMs": 679770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "carbon atoms get trapped in the lattice,"
    } ]
  }, {
    "tStartMs": 682140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "creating this needle-like microstructure."
    } ]
  }, {
    "tStartMs": 684930,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And that forms a kind of\nsteel known as martensite."
    } ]
  }, {
    "tStartMs": 687990,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Martensite is really\nhard, but also brittle,"
    } ]
  }, {
    "tStartMs": 691740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "since the lattice can\nno longer absorb energy"
    } ]
  }, {
    "tStartMs": 694110,
    "dDurationMs": 1047,
    "segs": [ {
      "utf8": "without fracturing."
    } ]
  }, {
    "tStartMs": 695157,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "(whimsical music fades)"
    } ]
  }, {
    "tStartMs": 697291,
    "dDurationMs": 1682,
    "segs": [ {
      "utf8": "(metal clangs)"
    } ]
  }, {
    "tStartMs": 698973,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 699806,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "- Now we can take a look on the clock."
    } ]
  }, {
    "tStartMs": 701272,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 702105,
    "dDurationMs": 4245,
    "segs": [ {
      "utf8": "- We have 1.5 minutes until\nwe have to remove it again."
    } ]
  }, {
    "tStartMs": 706350,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 707250,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The next step is to ignite the thermite."
    } ]
  }, {
    "tStartMs": 710010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And it's important to do this right after"
    } ]
  }, {
    "tStartMs": 711930,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "we turn off the preheating."
    } ]
  }, {
    "tStartMs": 713490,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "- Five, four, three..."
    } ]
  }, {
    "tStartMs": 717975,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Two, one."
    } ]
  }, {
    "tStartMs": 721020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- So, I put the plug in the mold,"
    } ]
  }, {
    "tStartMs": 722640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and then the thermite bucket on top,"
    } ]
  }, {
    "tStartMs": 725370,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "and then I ignited it..."
    } ]
  }, {
    "tStartMs": 727269,
    "dDurationMs": 1311,
    "segs": [ {
      "utf8": "(flame hisses)"
    } ]
  }, {
    "tStartMs": 728580,
    "dDurationMs": 1855,
    "segs": [ {
      "utf8": "Oh my goodness, no!"
    } ]
  }, {
    "tStartMs": 730435,
    "dDurationMs": 2345,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 732780,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "In making these videos,"
    } ]
  }, {
    "tStartMs": 734070,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the team and I often\ntravel around the world"
    } ]
  }, {
    "tStartMs": 736290,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "talking to scientists and\nfilming at research facilities."
    } ]
  }, {
    "tStartMs": 738990,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I mean, guess where I am right now?"
    } ]
  }, {
    "tStartMs": 741210,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "We filmed part one of\nthis video in Germany."
    } ]
  }, {
    "tStartMs": 743280,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Casper's been in the Netherlands\nlearning about strongbase,"
    } ]
  }, {
    "tStartMs": 746040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and Peter has just come\nback from trying and failing"
    } ]
  }, {
    "tStartMs": 748620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to break glass in New York."
    } ]
  }, {
    "tStartMs": 750360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It is a great job perk,"
    } ]
  }, {
    "tStartMs": 752040,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "but there is one really annoying problem,"
    } ]
  }, {
    "tStartMs": 754290,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "which is that it's hard to stay connected"
    } ]
  }, {
    "tStartMs": 756150,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with the rest of the team\nwhile we're out on location."
    } ]
  }, {
    "tStartMs": 758550,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "We either have to pay\nridiculous roaming charges,"
    } ]
  }, {
    "tStartMs": 761190,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "or find a local sim card,"
    } ]
  }, {
    "tStartMs": 762810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "or just search around for public wifi."
    } ]
  }, {
    "tStartMs": 765090,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "And as you can imagine,"
    } ]
  }, {
    "tStartMs": 766020,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "this isn't something we\nreally wanna be dealing with"
    } ]
  }, {
    "tStartMs": 768390,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "while we're making a video."
    } ]
  }, {
    "tStartMs": 769740,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Which is why we use this\nvideo sponsor, Saily."
    } ]
  }, {
    "tStartMs": 773040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Saily makes it incredibly\neasy and affordable"
    } ]
  }, {
    "tStartMs": 776160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to stay connected while you're abroad."
    } ]
  }, {
    "tStartMs": 778770,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "You download it once,"
    } ]
  }, {
    "tStartMs": 780090,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and then you can use it\nin over 180 countries."
    } ]
  }, {
    "tStartMs": 783180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Just choose how much data you want,"
    } ]
  }, {
    "tStartMs": 785550,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "how long you want it for,"
    } ]
  }, {
    "tStartMs": 787110,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and it's super quick to set up."
    } ]
  }, {
    "tStartMs": 789000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "All you have to do is select\nthe country and the plan,"
    } ]
  }, {
    "tStartMs": 791640,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "then activate the eSIM, and you're done."
    } ]
  }, {
    "tStartMs": 794070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It's also much cheaper than roaming."
    } ]
  }, {
    "tStartMs": 796650,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Then when you land, you\ncan automatically connect"
    } ]
  }, {
    "tStartMs": 799380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to a local network with no hidden charges,"
    } ]
  }, {
    "tStartMs": 802080,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and you're able to do the\nimportant things like access maps,"
    } ]
  }, {
    "tStartMs": 805380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "book a car, or make calls."
    } ]
  }, {
    "tStartMs": 807180,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So for your next trip, make\nsure you scan this QR code"
    } ]
  }, {
    "tStartMs": 810510,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "to download the app,"
    } ]
  }, {
    "tStartMs": 811740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "choose a plan in the\ncountry you're traveling to."
    } ]
  }, {
    "tStartMs": 814380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And here's the most important thing,"
    } ]
  }, {
    "tStartMs": 816120,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "use our code \"Veritasium\" at checkout"
    } ]
  }, {
    "tStartMs": 818340,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "to get an exclusive 15%\noff your first purchase."
    } ]
  }, {
    "tStartMs": 822750,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So, scan that code, checkout\nwith code \"Veritasium\","
    } ]
  }, {
    "tStartMs": 825570,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and get ready for traveling."
    } ]
  }, {
    "tStartMs": 827310,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "So I wanna say a big thank you to Saily"
    } ]
  }, {
    "tStartMs": 828900,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "for sponsoring this video,"
    } ]
  }, {
    "tStartMs": 830130,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "and now back to thermite welding."
    } ]
  }, {
    "tStartMs": 832049,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 836430,
    "dDurationMs": 1337,
    "segs": [ {
      "utf8": "Oh my goodness!"
    } ]
  }, {
    "tStartMs": 837767,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "(Derek laughs)\n(intense music)"
    } ]
  }, {
    "tStartMs": 839820,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Woo!"
    } ]
  }, {
    "tStartMs": 843000,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "Wow!"
    } ]
  }, {
    "tStartMs": 845530,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "(intense music continues)"
    } ]
  }, {
    "tStartMs": 848670,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So, the thermite reaction\nis taking place inside."
    } ]
  }, {
    "tStartMs": 851010,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "We're forming molten steel and\nalso molten aluminum oxide."
    } ]
  }, {
    "tStartMs": 856636,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "(intense music continues)"
    } ]
  }, {
    "tStartMs": 868170,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "All these demos are\nincredibly difficult to shoot,"
    } ]
  }, {
    "tStartMs": 871590,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "because they're gonna be many, many"
    } ]
  }, {
    "tStartMs": 873570,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "orders of magnitude brighter\nthan the normal scene."
    } ]
  }, {
    "tStartMs": 876510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So, just getting exposure\nis a huge challenge."
    } ]
  }, {
    "tStartMs": 879390,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Something this reminds me of\nis that the power radiated"
    } ]
  }, {
    "tStartMs": 882390,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "by something thermally"
    } ]
  }, {
    "tStartMs": 884310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "is proportional to temperature\nto the power of four."
    } ]
  }, {
    "tStartMs": 886410,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So, slight increases in temperature"
    } ]
  }, {
    "tStartMs": 888180,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "result in huge increases in power."
    } ]
  }, {
    "tStartMs": 891058,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "(dark tense music)\n(torch hisses)"
    } ]
  }, {
    "tStartMs": 905571,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "(dark tense music continues)"
    } ]
  }, {
    "tStartMs": 912240,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "In the previous video,"
    } ]
  }, {
    "tStartMs": 913073,
    "dDurationMs": 2797,
    "segs": [ {
      "utf8": "we showed what happened in\nthe crucible through glass."
    } ]
  }, {
    "tStartMs": 915870,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "So, you can see the liquid steel"
    } ]
  }, {
    "tStartMs": 916977,
    "dDurationMs": 3513,
    "segs": [ {
      "utf8": "and the liquid aluminum oxide\nforming and separating out,"
    } ]
  }, {
    "tStartMs": 920490,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and then the liquid steel\ndropping out the bottom."
    } ]
  }, {
    "tStartMs": 923250,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Well, here we get to see that liquid steel"
    } ]
  }, {
    "tStartMs": 925770,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "falling into the mold."
    } ]
  }, {
    "tStartMs": 929209,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "(dark tense music continues)"
    } ]
  }, {
    "tStartMs": 932520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So, the liquid steel comes in first,"
    } ]
  }, {
    "tStartMs": 934620,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and it goes all the way to the bottom."
    } ]
  }, {
    "tStartMs": 936750,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Next, the slag starts to come out."
    } ]
  }, {
    "tStartMs": 939360,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But since aluminum oxide has\na lower density than steel,"
    } ]
  }, {
    "tStartMs": 942630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "it's just gonna float on top,"
    } ]
  }, {
    "tStartMs": 944640,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and go out the sides into the slag pans."
    } ]
  }, {
    "tStartMs": 947820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So, that makes sure that\nwe don't get any slag"
    } ]
  }, {
    "tStartMs": 950370,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "mixed in with the liquid steel."
    } ]
  }, {
    "tStartMs": 956130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- That is so awesome."
    } ]
  }, {
    "tStartMs": 957510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Derek] Yeah."
    } ]
  }, {
    "tStartMs": 959130,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- [Axel] That is just spectacular."
    } ]
  }, {
    "tStartMs": 962531,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "Whoa!"
    } ]
  }, {
    "tStartMs": 963412,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "- [Derek] Ah, that is brilliant."
    } ]
  }, {
    "tStartMs": 965646,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 969717,
    "dDurationMs": 1536,
    "segs": [ {
      "utf8": "- And now we wait."
    } ]
  }, {
    "tStartMs": 972600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "We need the steel to cool long\nenough so that it's solid,"
    } ]
  }, {
    "tStartMs": 975540,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "but not too long so that\nthe excess steel and slag"
    } ]
  }, {
    "tStartMs": 978840,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "is difficult to remove."
    } ]
  }, {
    "tStartMs": 980160,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "You have to get the time right."
    } ]
  }, {
    "tStartMs": 981330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What does he think?"
    } ]
  }, {
    "tStartMs": 982163,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "You guys tell me if\nit's not liquid anymore."
    } ]
  }, {
    "tStartMs": 983700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I believe you."
    } ]
  }, {
    "tStartMs": 984533,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "- Oh, two minutes passed."
    } ]
  }, {
    "tStartMs": 986130,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So, let's wait 30 seconds more."
    } ]
  }, {
    "tStartMs": 989340,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] After that time has elapsed,"
    } ]
  }, {
    "tStartMs": 990840,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "then it's time to essentially\nclean up this weld."
    } ]
  }, {
    "tStartMs": 994350,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "So, we can remove the slag\npans and the mold shoes."
    } ]
  }, {
    "tStartMs": 998251,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "(objects clanging)"
    } ]
  }, {
    "tStartMs": 1000770,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "And we break off the top of this mold."
    } ]
  }, {
    "tStartMs": 1004305,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(soft dramatic music)"
    } ]
  }, {
    "tStartMs": 1005138,
    "dDurationMs": 2052,
    "segs": [ {
      "utf8": "These are really single use molds."
    } ]
  }, {
    "tStartMs": 1007190,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "They get destroyed in this process."
    } ]
  }, {
    "tStartMs": 1009054,
    "dDurationMs": 1796,
    "segs": [ {
      "utf8": "(machinery humming)"
    } ]
  }, {
    "tStartMs": 1010850,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "- [Christoph] And now\nwe put it on the side."
    } ]
  }, {
    "tStartMs": 1012700,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "- Put this..."
    } ]
  }, {
    "tStartMs": 1014167,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "By the slag pens?"
    } ]
  }, {
    "tStartMs": 1015500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Christoph] That's fine."
    } ]
  }, {
    "tStartMs": 1016333,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "- Then we used a weld shear"
    } ]
  }, {
    "tStartMs": 1018020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that can create up to 20 tons of force"
    } ]
  }, {
    "tStartMs": 1020480,
    "dDurationMs": 3818,
    "segs": [ {
      "utf8": "to shear off the excess steel\nfrom the top of the weld."
    } ]
  }, {
    "tStartMs": 1024298,
    "dDurationMs": 2748,
    "segs": [ {
      "utf8": "(weld shear buzzes)"
    } ]
  }, {
    "tStartMs": 1027046,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "(soft dramatic music fades)"
    } ]
  }, {
    "tStartMs": 1032934,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 1036440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And after that's done,"
    } ]
  }, {
    "tStartMs": 1037760,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "we hammered off the\nremaining excess parts."
    } ]
  }, {
    "tStartMs": 1040696,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(hammer bangs)"
    } ]
  }, {
    "tStartMs": 1046130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "That's fun, actually. I like that step."
    } ]
  }, {
    "tStartMs": 1048350,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The next step is to grind down the weld,"
    } ]
  }, {
    "tStartMs": 1050420,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "so it's exactly the\nsame level as the rail."
    } ]
  }, {
    "tStartMs": 1053210,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Obviously, you don't want any bumps"
    } ]
  }, {
    "tStartMs": 1054290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "when the train is going over it,"
    } ]
  }, {
    "tStartMs": 1056120,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but also you don't want any indents,"
    } ]
  }, {
    "tStartMs": 1058190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so this grinding step is really important."
    } ]
  }, {
    "tStartMs": 1060440,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So, we put on the grinding machine,"
    } ]
  }, {
    "tStartMs": 1063170,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and grind until maximum one\nmillimeter of materials left."
    } ]
  }, {
    "tStartMs": 1066680,
    "dDurationMs": 2695,
    "segs": [ {
      "utf8": "And we try to only grind\non top of the weld."
    } ]
  }, {
    "tStartMs": 1069375,
    "dDurationMs": 1172,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1070547,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(grinder whirring)"
    } ]
  }, {
    "tStartMs": 1075418,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(intense music)"
    } ]
  }, {
    "tStartMs": 1079236,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(grinders buzzing)"
    } ]
  }, {
    "tStartMs": 1083990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's normally conducted in two phases."
    } ]
  }, {
    "tStartMs": 1086330,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "First there's a rough grind,"
    } ]
  }, {
    "tStartMs": 1088010,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "and then a finer grind is applied later."
    } ]
  }, {
    "tStartMs": 1091850,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- And we only grinded the top surface."
    } ]
  }, {
    "tStartMs": 1094400,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 1095233,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "- We did not grind the running flank."
    } ]
  }, {
    "tStartMs": 1097130,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 1098063,
    "dDurationMs": 927,
    "segs": [ {
      "utf8": "- [Christoph] Then you have to lift down"
    } ]
  }, {
    "tStartMs": 1098990,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "the grinding device,"
    } ]
  }, {
    "tStartMs": 1100220,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and hold everything so it's even heavier"
    } ]
  }, {
    "tStartMs": 1102710,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "than the part we've done before."
    } ]
  }, {
    "tStartMs": 1105290,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "That's rough grinding right there."
    } ]
  }, {
    "tStartMs": 1107960,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- I'm sweating'"
    } ]
  }, {
    "tStartMs": 1109610,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "It's like a serious workout."
    } ]
  }, {
    "tStartMs": 1112944,
    "dDurationMs": 1346,
    "segs": [ {
      "utf8": "(Derek chuckles)"
    } ]
  }, {
    "tStartMs": 1114290,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The guys in the field\nwere obviously much better"
    } ]
  }, {
    "tStartMs": 1116720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "at grinding down the rail than I was."
    } ]
  }, {
    "tStartMs": 1118940,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So, they would move on,"
    } ]
  }, {
    "tStartMs": 1120320,
    "dDurationMs": 4184,
    "segs": [ {
      "utf8": "leaving a still glowing hot\nsection of the rail behind them."
    } ]
  }, {
    "tStartMs": 1124504,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(mellow music fades)"
    } ]
  }, {
    "tStartMs": 1129140,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "There probably will be millions of people"
    } ]
  }, {
    "tStartMs": 1131210,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "watching this video."
    } ]
  }, {
    "tStartMs": 1132290,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "What is the likelihood\nthat they have ridden over"
    } ]
  }, {
    "tStartMs": 1135110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "one of your thermite welds?"
    } ]
  }, {
    "tStartMs": 1137360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- They will."
    } ]
  }, {
    "tStartMs": 1138193,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Hundred percent."
    } ]
  }, {
    "tStartMs": 1139026,
    "dDurationMs": 914,
    "segs": [ {
      "utf8": "- Hundred percent."
    } ]
  }, {
    "tStartMs": 1139940,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- Anywhere in the world?"
    } ]
  }, {
    "tStartMs": 1140810,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Anywhere in the world."
    } ]
  }, {
    "tStartMs": 1141650,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Of course, there is countries-"
    } ]
  }, {
    "tStartMs": 1142880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- North Korea."
    } ]
  }, {
    "tStartMs": 1143713,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "- Where are not the market\nleader or something, but..."
    } ]
  }, {
    "tStartMs": 1148220,
    "dDurationMs": 2539,
    "segs": [ {
      "utf8": "Finally they will ride above our welds."
    } ]
  }, {
    "tStartMs": 1150759,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "(soft tense music)"
    } ]
  }, {
    "tStartMs": 1152720,
    "dDurationMs": 1509,
    "segs": [ {
      "utf8": "- [Axel] We'll just cut it out,"
    } ]
  }, {
    "tStartMs": 1154229,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "and then take it over\nto the methodology lab."
    } ]
  }, {
    "tStartMs": 1157863,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(Derek grunts)"
    } ]
  }, {
    "tStartMs": 1158696,
    "dDurationMs": 897,
    "segs": [ {
      "utf8": "- That is heavy."
    } ]
  }, {
    "tStartMs": 1160490,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Oh!"
    } ]
  }, {
    "tStartMs": 1162020,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "That's my weld."
    } ]
  }, {
    "tStartMs": 1163730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "My first thermite weld."
    } ]
  }, {
    "tStartMs": 1165020,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "Man, that is hot."
    } ]
  }, {
    "tStartMs": 1167373,
    "dDurationMs": 1637,
    "segs": [ {
      "utf8": "(Derek exhales)"
    } ]
  }, {
    "tStartMs": 1169010,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- This is what you have done yesterday."
    } ]
  }, {
    "tStartMs": 1171620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We can now put it in the acid."
    } ]
  }, {
    "tStartMs": 1173720,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- What does the acid do to the surface?"
    } ]
  }, {
    "tStartMs": 1175550,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "- The acid attacks the steel."
    } ]
  }, {
    "tStartMs": 1178940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "But because the orientation\nof the crystals,"
    } ]
  }, {
    "tStartMs": 1182030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "inside the steel is not the same,"
    } ]
  }, {
    "tStartMs": 1183800,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "the acid attacks it not in\nthe same way everywhere."
    } ]
  }, {
    "tStartMs": 1188510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And because this is different,"
    } ]
  }, {
    "tStartMs": 1190490,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "you can see different structures."
    } ]
  }, {
    "tStartMs": 1193730,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "You can see some fine\nstructures in the rail,"
    } ]
  }, {
    "tStartMs": 1197120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in the heat-affected zone,"
    } ]
  }, {
    "tStartMs": 1198770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and in, let's say, the fusion zone."
    } ]
  }, {
    "tStartMs": 1201290,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Mhm."
    } ]
  }, {
    "tStartMs": 1202123,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Can I touch it?"
    } ]
  }, {
    "tStartMs": 1202956,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1204650,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "- [Derek] Yeah, you can't really feel it."
    } ]
  }, {
    "tStartMs": 1205772,
    "dDurationMs": 1948,
    "segs": [ {
      "utf8": "- [Christopher] It's a microscopic basis."
    } ]
  }, {
    "tStartMs": 1207720,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "- Yeah.\n- You cannot feel it."
    } ]
  }, {
    "tStartMs": 1209030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- It's interesting, you\ncan see it, but not-"
    } ]
  }, {
    "tStartMs": 1210680,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1211513,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "- [Derek] And it's a very fine line."
    } ]
  }, {
    "tStartMs": 1212390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- [Christoph] I mean, you can\nsee the different structures"
    } ]
  }, {
    "tStartMs": 1214250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "of the crystals even."
    } ]
  }, {
    "tStartMs": 1215960,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [Derek] In the weld, you\ncan see three different zones."
    } ]
  }, {
    "tStartMs": 1218930,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "The normal rail is on either\nside with a horizontal grain,"
    } ]
  }, {
    "tStartMs": 1222740,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "due to how it was rolled\nin the steel mill."
    } ]
  }, {
    "tStartMs": 1226250,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "In the middle is the thermite steel."
    } ]
  }, {
    "tStartMs": 1228470,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You can still see a bit\nof horizontal grain,"
    } ]
  }, {
    "tStartMs": 1231350,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but here it doesn't come\nfrom the steel being rolled,"
    } ]
  }, {
    "tStartMs": 1234260,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "since this just solidified from liquid."
    } ]
  }, {
    "tStartMs": 1236750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Instead, it formed from\nthe solidification front,"
    } ]
  }, {
    "tStartMs": 1239510,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "moving from the sides to the center."
    } ]
  }, {
    "tStartMs": 1241640,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And when the crystals\nfrom both sides meet,"
    } ]
  }, {
    "tStartMs": 1244220,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it creates tiny microscopic pores,"
    } ]
  }, {
    "tStartMs": 1246920,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "resulting in this darker\nline in the center."
    } ]
  }, {
    "tStartMs": 1250640,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Now, the boundary of the\nthermite steel isn't sharp."
    } ]
  }, {
    "tStartMs": 1253730,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And that's because as the\nliquid steel pours in,"
    } ]
  }, {
    "tStartMs": 1256280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "it actually melts some of the rail."
    } ]
  }, {
    "tStartMs": 1258950,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "This helps it form a strong bond."
    } ]
  }, {
    "tStartMs": 1262610,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- A good weld would be enough"
    } ]
  }, {
    "tStartMs": 1263810,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "with just one atom layer fused."
    } ]
  }, {
    "tStartMs": 1267200,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But we are using the process\non a construction site."
    } ]
  }, {
    "tStartMs": 1271160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And on the construction site,"
    } ]
  }, {
    "tStartMs": 1272300,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "not everything is so good\nhandled like in a laboratory."
    } ]
  }, {
    "tStartMs": 1275960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The gap is not a hundred\npercent, always the same."
    } ]
  }, {
    "tStartMs": 1278360,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So, we need something robust,"
    } ]
  }, {
    "tStartMs": 1279890,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which functions on construction sites."
    } ]
  }, {
    "tStartMs": 1282110,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Derek] In Germany,\nregulations require melting"
    } ]
  }, {
    "tStartMs": 1284330,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "of about three millimeters off each rail."
    } ]
  }, {
    "tStartMs": 1287840,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The final zone is in\nbetween the normal rail"
    } ]
  }, {
    "tStartMs": 1290510,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the thermite steel."
    } ]
  }, {
    "tStartMs": 1292010,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This steel didn't melt,\nbut it received enough heat"
    } ]
  }, {
    "tStartMs": 1294920,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that the crystal structure changed,"
    } ]
  }, {
    "tStartMs": 1296930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "resulting in a smaller grain structure."
    } ]
  }, {
    "tStartMs": 1299690,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "This is known as the Heat Affected Zone."
    } ]
  }, {
    "tStartMs": 1302420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "If you measure the\nhardness across the weld,"
    } ]
  }, {
    "tStartMs": 1305030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "this zone is actually the weakest,"
    } ]
  }, {
    "tStartMs": 1307070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "both in terms of hardness and yield."
    } ]
  }, {
    "tStartMs": 1309830,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "The amount of force it takes"
    } ]
  }, {
    "tStartMs": 1311210,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to permanently deform the steel."
    } ]
  }, {
    "tStartMs": 1313310,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "So if a weld breaks,\nit's almost always here."
    } ]
  }, {
    "tStartMs": 1318200,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Christoph] That's a line you could see"
    } ]
  }, {
    "tStartMs": 1319730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "on that macro etching."
    } ]
  }, {
    "tStartMs": 1321410,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Thermite.\n- [Derek] Yep."
    } ]
  }, {
    "tStartMs": 1323180,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- That's a fusion line."
    } ]
  }, {
    "tStartMs": 1324950,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And here we have now\nrail seal heat affected."
    } ]
  }, {
    "tStartMs": 1328220,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So, the structure is\nchanged by heating up,"
    } ]
  }, {
    "tStartMs": 1331160,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and then re-crystallization of the steel."
    } ]
  }, {
    "tStartMs": 1335450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- [Derek] So then I guess the question is,"
    } ]
  }, {
    "tStartMs": 1336800,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "how strong is rail that's been welded?"
    } ]
  }, {
    "tStartMs": 1340190,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Well, at Goldschmidt, they\nactually take sections of rail"
    } ]
  }, {
    "tStartMs": 1342860,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "that they have welded,"
    } ]
  }, {
    "tStartMs": 1344240,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and they test them until failure."
    } ]
  }, {
    "tStartMs": 1346790,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- Every 200, basically,\nwe create one test weld,"
    } ]
  }, {
    "tStartMs": 1350750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and we analyze it in terms of chemistry,"
    } ]
  }, {
    "tStartMs": 1352880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "we analyze it in terms of hardness,"
    } ]
  }, {
    "tStartMs": 1354950,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and we analyze the bending."
    } ]
  }, {
    "tStartMs": 1357410,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And this is the bending press."
    } ]
  }, {
    "tStartMs": 1359480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They put this in, right?"
    } ]
  }, {
    "tStartMs": 1361100,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And then the force comes\nfrom top and then goes down,"
    } ]
  }, {
    "tStartMs": 1364250,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "and it breaks it."
    } ]
  }, {
    "tStartMs": 1365270,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "And we measure the speed\nand also the force."
    } ]
  }, {
    "tStartMs": 1371180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I'd say, it looks like it's flexing a bit."
    } ]
  }, {
    "tStartMs": 1373460,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "- So we're loading up that\nweld, bending it until it snaps."
    } ]
  }, {
    "tStartMs": 1378500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "See that curve go."
    } ]
  }, {
    "tStartMs": 1379940,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "We wanna see how much\nforce it takes to snap,"
    } ]
  }, {
    "tStartMs": 1382010,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "and exactly where that break occurs."
    } ]
  }, {
    "tStartMs": 1385700,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "140 tons."
    } ]
  }, {
    "tStartMs": 1388100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It's getting really deflected now."
    } ]
  }, {
    "tStartMs": 1390080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1391850,
    "dDurationMs": 1989,
    "segs": [ {
      "utf8": "- 150 tons."
    } ]
  }, {
    "tStartMs": 1393839,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(metal clangs)"
    } ]
  }, {
    "tStartMs": 1394672,
    "dDurationMs": 1678,
    "segs": [ {
      "utf8": "Ooh! That was cool."
    } ]
  }, {
    "tStartMs": 1396350,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "I was just expecting a little crack,"
    } ]
  }, {
    "tStartMs": 1397880,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "like that was catastrophic failure."
    } ]
  }, {
    "tStartMs": 1400336,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "(person laughs)\nJust over 150 tons."
    } ]
  }, {
    "tStartMs": 1402920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So, we think the crack propagated\nfrom the bottom upwards?"
    } ]
  }, {
    "tStartMs": 1405380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "'Cause it's being pushed down like that."
    } ]
  }, {
    "tStartMs": 1406880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So, this is under a lot of tension."
    } ]
  }, {
    "tStartMs": 1408320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Axel] Yes."
    } ]
  }, {
    "tStartMs": 1409153,
    "dDurationMs": 3007,
    "segs": [ {
      "utf8": "- So, it breaks under tension\ndown here, rips up this way."
    } ]
  }, {
    "tStartMs": 1412160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And so it doesn't break\nin the middle of the weld."
    } ]
  }, {
    "tStartMs": 1414500,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You're saying this zone beside it,"
    } ]
  }, {
    "tStartMs": 1416480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "which is a previous rail material"
    } ]
  }, {
    "tStartMs": 1418100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that got heated up in the weld."
    } ]
  }, {
    "tStartMs": 1419930,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Yeah.\n- Is actually weaker."
    } ]
  }, {
    "tStartMs": 1421100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 1421933,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] Whoosh."
    } ]
  }, {
    "tStartMs": 1425163,
    "dDurationMs": 2237,
    "segs": [ {
      "utf8": "(grinder buzzes)"
    } ]
  }, {
    "tStartMs": 1427400,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Every year, around 2 million welds"
    } ]
  }, {
    "tStartMs": 1429770,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "are performed using thermite."
    } ]
  }, {
    "tStartMs": 1431450,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And around half use\nGoldschmidt's thermite."
    } ]
  }, {
    "tStartMs": 1434510,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Now, each weld creates about"
    } ]
  }, {
    "tStartMs": 1436010,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "two and a half centimeters of rail."
    } ]
  }, {
    "tStartMs": 1438080,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "So, in total, that's 50\nkilometers of railroad"
    } ]
  }, {
    "tStartMs": 1441950,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "created every year out of liquid steel."
    } ]
  }, {
    "tStartMs": 1446810,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- You have a very demanding process,"
    } ]
  }, {
    "tStartMs": 1450230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and you have to make sure that\nthere's certain properties"
    } ]
  }, {
    "tStartMs": 1453140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "with respect to bending,\nwith respect to tension,"
    } ]
  }, {
    "tStartMs": 1455720,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "with respect to hardness."
    } ]
  }, {
    "tStartMs": 1457588,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "(soft music)"
    } ]
  }, {
    "tStartMs": 1460190,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "That's a process that needs\nto be kind of replicated"
    } ]
  }, {
    "tStartMs": 1462620,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "every, every, every time,\na million times a year."
    } ]
  }, {
    "tStartMs": 1467120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- So, with all this continuously welded"
    } ]
  }, {
    "tStartMs": 1469310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "rail around the world,"
    } ]
  }, {
    "tStartMs": 1470780,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "why doesn't it buckle in\nsummer when it heats up?"
    } ]
  }, {
    "tStartMs": 1475970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Well, that's because there's another way"
    } ]
  }, {
    "tStartMs": 1477860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to change the length of the rail."
    } ]
  }, {
    "tStartMs": 1480560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Okay, imagine a piece of rail."
    } ]
  }, {
    "tStartMs": 1482990,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "If we use a powerful machine\nto push on it from both sides,"
    } ]
  }, {
    "tStartMs": 1486920,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "it will shorten slightly."
    } ]
  }, {
    "tStartMs": 1488990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And if on the other hand\nwe pull on the rail,"
    } ]
  }, {
    "tStartMs": 1491480,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "it will lengthen."
    } ]
  }, {
    "tStartMs": 1492620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So, you can use mechanical stress"
    } ]
  }, {
    "tStartMs": 1494480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to change the length of the rail."
    } ]
  }, {
    "tStartMs": 1496610,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The fractional change in\nlength is called \"strain\"."
    } ]
  }, {
    "tStartMs": 1499820,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And if you plot the relationship\nbetween stress and strain,"
    } ]
  }, {
    "tStartMs": 1502730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "you find it has a linear relationship,"
    } ]
  }, {
    "tStartMs": 1505610,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "at least with elastic deformation."
    } ]
  }, {
    "tStartMs": 1507980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "As long as the stresses\napplied are not too large,"
    } ]
  }, {
    "tStartMs": 1510230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the rail will spring back\nto its original length"
    } ]
  }, {
    "tStartMs": 1512780,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "when the stress is removed."
    } ]
  }, {
    "tStartMs": 1514670,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And this is key, because\nas long as we do that,"
    } ]
  }, {
    "tStartMs": 1517670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "we have two ways to change the length."
    } ]
  }, {
    "tStartMs": 1520070,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Thermal and mechanical."
    } ]
  }, {
    "tStartMs": 1522170,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And we can use one to\ncompensate for the other."
    } ]
  }, {
    "tStartMs": 1525230,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "When the rail thermally wants to expand,"
    } ]
  }, {
    "tStartMs": 1527750,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "we can use mechanical\nforces to compress it."
    } ]
  }, {
    "tStartMs": 1530600,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "This is what the sleepers\nand the ballast are for."
    } ]
  }, {
    "tStartMs": 1534470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The sleepers pin down the rail,"
    } ]
  }, {
    "tStartMs": 1536360,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "and the ballast locks\nthe sleepers in place."
    } ]
  }, {
    "tStartMs": 1540320,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So as the temperature increases,\nthe rail doesn't lengthen."
    } ]
  }, {
    "tStartMs": 1544130,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Instead, the stress in the rail,"
    } ]
  }, {
    "tStartMs": 1546080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the compressive stress increases."
    } ]
  }, {
    "tStartMs": 1548090,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And the rail just expands\nto the top =and sides,"
    } ]
  }, {
    "tStartMs": 1551390,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which are unconstrained."
    } ]
  }, {
    "tStartMs": 1553430,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It's also interesting to note\nthat railroads typically use"
    } ]
  }, {
    "tStartMs": 1556370,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "as high of a neutral\ntemperature as they can,"
    } ]
  }, {
    "tStartMs": 1559250,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "because a rail that\nshrinks too much in winter"
    } ]
  }, {
    "tStartMs": 1561770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and cracks under tension\nis less problematic"
    } ]
  }, {
    "tStartMs": 1564410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "than one that expands too much in summer,"
    } ]
  }, {
    "tStartMs": 1566720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and therefore buckles."
    } ]
  }, {
    "tStartMs": 1568160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It's also easier to detect a cracked rail"
    } ]
  }, {
    "tStartMs": 1570440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "using conductivity measurements"
    } ]
  }, {
    "tStartMs": 1571940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "than one that has buckled."
    } ]
  }, {
    "tStartMs": 1573560,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So, thermal expansion and contraction"
    } ]
  }, {
    "tStartMs": 1575690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "are counteracted by mechanical stress."
    } ]
  }, {
    "tStartMs": 1578570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "That is the reason why we don't need"
    } ]
  }, {
    "tStartMs": 1580400,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "expansion joints in railways."
    } ]
  }, {
    "tStartMs": 1583370,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It allows trains to go faster"
    } ]
  }, {
    "tStartMs": 1585200,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "with fewer bumps and vibrations,"
    } ]
  }, {
    "tStartMs": 1586940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and much less maintenance."
    } ]
  }, {
    "tStartMs": 1588920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Grady from Practical\nEngineering actually made"
    } ]
  }, {
    "tStartMs": 1590840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "a whole video about\nthis, and it's excellent."
    } ]
  }, {
    "tStartMs": 1593450,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "I'd recommend it."
    } ]
  }, {
    "tStartMs": 1595310,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So far, we've seen thermite\nunder normal conditions."
    } ]
  }, {
    "tStartMs": 1599210,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Wow!"
    } ]
  }, {
    "tStartMs": 1600830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Conditions that are expertly tuned"
    } ]
  }, {
    "tStartMs": 1602900,
    "dDurationMs": 2824,
    "segs": [ {
      "utf8": "to protect thermite from its environment."
    } ]
  }, {
    "tStartMs": 1605724,
    "dDurationMs": 926,
    "segs": [ {
      "utf8": "Oh, oh, oh!"
    } ]
  }, {
    "tStartMs": 1606650,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But in the next thermite episode,"
    } ]
  }, {
    "tStartMs": 1608270,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "we'll find out what happens\nwhen this is not the case."
    } ]
  }, {
    "tStartMs": 1610970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And we'll learn how to work with thermite"
    } ]
  }, {
    "tStartMs": 1612740,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "under these conditions."
    } ]
  }, {
    "tStartMs": 1614591,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(explosions booming)"
    } ]
  }, {
    "tStartMs": 1615424,
    "dDurationMs": 3526,
    "segs": [ {
      "utf8": "So trust me, you don't\nwant to miss part three."
    } ]
  }, {
    "tStartMs": 1618950,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Cameraman] My hands are shaking."
    } ]
  }, {
    "tStartMs": 1620150,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- Right?"
    } ]
  }, {
    "tStartMs": 1621170,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Make sure you're\nsubscribed to get notified"
    } ]
  }, {
    "tStartMs": 1623450,
    "dDurationMs": 1956,
    "segs": [ {
      "utf8": "when that video comes out."
    } ]
  }, {
    "tStartMs": 1625406,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "(electronic beeping)"
    } ]
  } ]
}
