  "events": [ {
    "tStartMs": 1640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "it's another beautiful day in Sydney"
    } ]
  }, {
    "tStartMs": 3240,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "I'm out enjoying the Sun and looking to find out if anyone knows"
    } ]
  }, {
    "tStartMs": 7170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Why the Sun shines?"
    } ]
  }, {
    "tStartMs": 9000,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "So the sun gives us a lot of ... ?\n- Heat? Sunshine?"
    } ]
  }, {
    "tStartMs": 14000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Provides energy (yes) heat energy"
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Where is the sun get that energy from?"
    } ]
  }, {
    "tStartMs": 20000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I have no idea"
    } ]
  }, {
    "tStartMs": 22700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Some kind of chemical reaction..."
    } ]
  }, {
    "tStartMs": 25000,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Mmmmmmmm..."
    } ]
  }, {
    "tStartMs": 27430,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "yeah gas explosions"
    } ]
  }, {
    "tStartMs": 29500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Does it burn gas?"
    } ]
  }, {
    "tStartMs": 30500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "- It burns gases?\n- It's burning air\n- Fire"
    } ]
  }, {
    "tStartMs": 34020,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "The fire that's on the sun"
    } ]
  }, {
    "tStartMs": 41750,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "But is the Sun really a giant ball of\nfire"
    } ]
  }, {
    "tStartMs": 44620,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "I mean wouldn't go out after five\nbillion years?"
    } ]
  }, {
    "tStartMs": 48280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "This is one of the things that you just assume you know, but you don't actually know"
    } ]
  }, {
    "tStartMs": 51970,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So in this bucket I have the components\nof the Sun"
    } ]
  }, {
    "tStartMs": 55000,
    "dDurationMs": 4559,
    "segs": [ {
      "utf8": "Well, I have protons and neutrons"
    } ]
  }, {
    "tStartMs": 59559,
    "dDurationMs": 3311,
    "segs": [ {
      "utf8": "There's some electrons but I didn't\nbring them"
    } ]
  }, {
    "tStartMs": 62870,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Most of the Sun is actually protons\n- OK"
    } ]
  }, {
    "tStartMs": 66190,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So what the protons does in the Sun\n- It's dance together"
    } ]
  }, {
    "tStartMs": 70510,
    "dDurationMs": 3139,
    "segs": [ {
      "utf8": "yeah"
    } ]
  }, {
    "tStartMs": 73649,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "Okay okay\nLike this"
    } ]
  }, {
    "tStartMs": 75420,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "When they come close, you know what they do?"
    } ]
  }, {
    "tStartMs": 78000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "They just ...\n- Colide\nActually they bounce off each other"
    } ]
  }, {
    "tStartMs": 80640,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "I'm coming in...\n- UOOOOOOH"
    } ]
  }, {
    "tStartMs": 84040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Why the protons bounce off each other?\n- Something about the electrons ...."
    } ]
  }, {
    "tStartMs": 87000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Positive and negative eletrons?"
    } ]
  }, {
    "tStartMs": 88800,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Cause they don't like each other\n- They don't like each other"
    } ]
  }, {
    "tStartMs": 92380,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "That's because a proton needs a neutron, right?"
    } ]
  }, {
    "tStartMs": 95340,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "You know why they... they repel like that?"
    } ]
  }, {
    "tStartMs": 98100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "-Magnetic force?"
    } ]
  }, {
    "tStartMs": 100260,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The repelling magnetic type thing?"
    } ]
  }, {
    "tStartMs": 103220,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Magnetic field, uh?"
    } ]
  }, {
    "tStartMs": 104220,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "-Electric field."
    } ]
  }, {
    "tStartMs": 105200,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Positives and negatives."
    } ]
  }, {
    "tStartMs": 106380,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Positive and Negative"
    } ]
  }, {
    "tStartMs": 107540,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "It's to do with the positive negative, right?"
    } ]
  }, {
    "tStartMs": 109420,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "We got protons, protons are?"
    } ]
  }, {
    "tStartMs": 110800,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "*Positive*"
    } ]
  }, {
    "tStartMs": 112360,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "-They're positively charged"
    } ]
  }, {
    "tStartMs": 113600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "-Yeah so the positives repel each other, ok?"
    } ]
  }, {
    "tStartMs": 115960,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "This is why its so important that the sun's hot"
    } ]
  }, {
    "tStartMs": 117860,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Cause if the sun is hot enough it gets these things moving so fast, that sometimes they can't avoid a collision"
    } ]
  }, {
    "tStartMs": 122360,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "-ok"
    } ]
  }, {
    "tStartMs": 122860,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "-And when they get too close they actually go *Pshh*"
    } ]
  }, {
    "tStartMs": 127100,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "*Pshh*"
    } ]
  }, {
    "tStartMs": 128300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "*Pshh*"
    } ]
  }, {
    "tStartMs": 130500,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "*Pshh*"
    } ]
  }, {
    "tStartMs": 142660,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "-Smash the protons\n-Positive?"
    } ]
  }, {
    "tStartMs": 143500,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "-Yeah, yeah, yeah, yeah\nNo, no, no, sma... ahhh"
    } ]
  }, {
    "tStartMs": 146580,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and now they're stuck together and you saw what happened when they smashed together"
    } ]
  }, {
    "tStartMs": 150080,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "What happened?\n-They Leaked\n-They Leaked"
    } ]
  }, {
    "tStartMs": 153240,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "*Pshh*\nis that energy?"
    } ]
  }, {
    "tStartMs": 155550,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "-Yeah\n-Sick"
    } ]
  }, {
    "tStartMs": 156540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Well the water poured out, but"
    } ]
  }, {
    "tStartMs": 158540,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "I guess energy would have poured out then."
    } ]
  }, {
    "tStartMs": 160880,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "-The energy came out\n-The energy came out! what was the energy before it was energy?"
    } ]
  }, {
    "tStartMs": 165250,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "-Kinetic energy?\n-Stored energy."
    } ]
  }, {
    "tStartMs": 167980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So what's happening there?"
    } ]
  }, {
    "tStartMs": 169600,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "-It's releasing some mass... like lighting?\n-Yeah, yeah, and that mass is, uh?"
    } ]
  }, {
    "tStartMs": 173990,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "-It's converted as energy, yeah"
    } ]
  }, {
    "tStartMs": 176230,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "It was the mass of the proton\n-(Ahhh!)"
    } ]
  }, {
    "tStartMs": 180760,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "When the protons smashed together they got lighter!"
    } ]
  }, {
    "tStartMs": 182880,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "-Yeah, yeah, yeah"
    } ]
  }, {
    "tStartMs": 183820,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "And they lost that mass and the mass was converted energy"
    } ]
  }, {
    "tStartMs": 185840,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "-Yeah, yeah\n-You know the famous equation about that?"
    } ]
  }, {
    "tStartMs": 187870,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "-(E = mc^2)\n-Yeah!"
    } ]
  }, {
    "tStartMs": 189890,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "E = mc^2?"
    } ]
  }, {
    "tStartMs": 191870,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "?????\n(French)"
    } ]
  }, {
    "tStartMs": 193030,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "have your the famous\nequation"
    } ]
  }, {
    "tStartMs": 195340,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "-which? process proton makes energy?"
    } ]
  }, {
    "tStartMs": 197780,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Well.."
    } ]
  }, {
    "tStartMs": 198420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Ha ha ha ha"
    } ]
  }, {
    "tStartMs": 200660,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "E = mc^2 squared? Yes?"
    } ]
  }, {
    "tStartMs": 202600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So what's E?"
    } ]
  }, {
    "tStartMs": 204300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The Sun, I don't know, ha ha ha"
    } ]
  }, {
    "tStartMs": 206720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "-E, E is energy, um"
    } ]
  }, {
    "tStartMs": 208640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "m is *mass*"
    } ]
  }, {
    "tStartMs": 210200,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "C is..\n-Cassidy"
    } ]
  }, {
    "tStartMs": 211900,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Kelvin?"
    } ]
  }, {
    "tStartMs": 213220,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "I don't remembers what C means..."
    } ]
  }, {
    "tStartMs": 215360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So c is..."
    } ]
  }, {
    "tStartMs": 217720,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "The speed of light"
    } ]
  }, {
    "tStartMs": 218900,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "-Speed of light?"
    } ]
  }, {
    "tStartMs": 219810,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "no, right? really\n-Yeah"
    } ]
  }, {
    "tStartMs": 222400,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "-Oh, I thought it was something different\n-Isn't that weird?"
    } ]
  }, {
    "tStartMs": 224300,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "The speed of light."
    } ]
  }, {
    "tStartMs": 225320,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "(Right, Ahh)"
    } ]
  }, {
    "tStartMs": 227360,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "(Wow, no wonder we jumped science)"
    } ]
  }, {
    "tStartMs": 229519,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "it seems most people have a tough time\nremembering that C is for the speed of light"
    } ]
  }, {
    "tStartMs": 233099,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "maybe that's because C is a bit of\na strange letter to represent a speed"
    } ]
  }, {
    "tStartMs": 237329,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "in fact in Einstein's original paper he used the letter V"
    } ]
  }, {
    "tStartMs": 240750,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "for velocity of light but nowadays\neveryone uses the letter C"
    } ]
  }, {
    "tStartMs": 244510,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "for constant it's a constant of the\nuniverse the speed of light"
    } ]
  }, {
    "tStartMs": 247639,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "though some people claim the letter C\nstands for celeritas"
    } ]
  }, {
    "tStartMs": 251409,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the Latin word for swiftness"
    } ]
  }, {
    "tStartMs": 253689,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "What is\nthat equation telling us about energy and mass?"
    } ]
  }, {
    "tStartMs": 257460,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Energy equals constant mass?"
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The mass and the energy..."
    } ]
  }, {
    "tStartMs": 263320,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "combine together, create"
    } ]
  }, {
    "tStartMs": 265449,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "the energy"
    } ]
  }, {
    "tStartMs": 267180,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Ha ha ha ha"
    } ]
  }, {
    "tStartMs": 269270,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "it's basically saying like this mass that comes out\n-yeah"
    } ]
  }, {
    "tStartMs": 273380,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "gets converted to a lot of energy"
    } ]
  }, {
    "tStartMs": 275200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And the speed of light is a huge number"
    } ]
  }, {
    "tStartMs": 276960,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "-Yeah\n-If you think about that, a tiny bit of mass is a huge amount of energy"
    } ]
  }, {
    "tStartMs": 281280,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "so every second the Sun is actually\nlosing 4.3 billion kilograms"
    } ]
  }, {
    "tStartMs": 286160,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "every second\n-every second?"
    } ]
  }, {
    "tStartMs": 288060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "-That amount of mass is being converted into"
    } ]
  }, {
    "tStartMs": 290280,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "-energy"
    } ]
  }, {
    "tStartMs": 291080,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "In the Sun hydrogen fuses together to form helium"
    } ]
  }, {
    "tStartMs": 295320,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but, that's a little confusing because"
    } ]
  }, {
    "tStartMs": 297190,
    "dDurationMs": 4449,
    "segs": [ {
      "utf8": "how out of only protons do we create a\nhelium nucleus which has"
    } ]
  }, {
    "tStartMs": 301640,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "two protons and two neutrons well the thing is"
    } ]
  }, {
    "tStartMs": 304320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "when the first two smash together"
    } ]
  }, {
    "tStartMs": 308440,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "one up the protons\nactually emits a positron and a neutrino"
    } ]
  }, {
    "tStartMs": 311970,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and quickly becomes a neutron"
    } ]
  }, {
    "tStartMs": 314870,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "next thing\nthat happens"
    } ]
  }, {
    "tStartMs": 316470,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "is another proton smashes in\n*Pshh*"
    } ]
  }, {
    "tStartMs": 319470,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and again we get more energy released"
    } ]
  }, {
    "tStartMs": 321710,
    "dDurationMs": 3459,
    "segs": [ {
      "utf8": "now if two particles like this collide"
    } ]
  }, {
    "tStartMs": 325169,
    "dDurationMs": 3451,
    "segs": [ {
      "utf8": "*Pshh*\nthey emit two protons"
    } ]
  }, {
    "tStartMs": 328620,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "and what we're left with is a helium 4 nucleus"
    } ]
  }, {
    "tStartMs": 334340,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "there you have hydrogen fused into helium"
    } ]
  }, {
    "tStartMs": 338160,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and a lot of mass lost, a lot of energy hehehe"
    } ]
  }, {
    "tStartMs": 343719,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "if you wanna know more about fusion in\nthe Sun check out this video by minute physics"
    } ]
  }, {
    "tStartMs": 347669,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "it explains how the protons can fuse\neven though they're not really going fast enough"
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "to overcome their repulsion"
    } ]
  }, {
    "tStartMs": 353300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "(...for fusion will fuse together anyway)"
    } ]
  }, {
    "tStartMs": 355479,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "(and the Sun is so big it has so much\nhydrogen that these small chances happen all the time)"
    } ]
  } ]
}
