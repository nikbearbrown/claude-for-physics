{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- This is the world's strongest magnet,"
    } ]
  }, {
    "tStartMs": 2880,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "capable of sucking objects in,"
    } ]
  }, {
    "tStartMs": 5190,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "generating electric current."
    } ]
  }, {
    "tStartMs": 6870,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Can you see that?"
    } ]
  }, {
    "tStartMs": 8160,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And levitating non-magnetic objects."
    } ]
  }, {
    "tStartMs": 11310,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It even wreaks havoc on camera equipment."
    } ]
  }, {
    "tStartMs": 14220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Wire is magnetic!\n- So if it's a CMOS sensor,"
    } ]
  }, {
    "tStartMs": 16770,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the electrons just can't find their way."
    } ]
  }, {
    "tStartMs": 18630,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- Well, they get redirected."
    } ]
  }, {
    "tStartMs": 19650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- So yeah, if you notice\nbad video or audio,"
    } ]
  }, {
    "tStartMs": 22440,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "know that it's incredibly hard"
    } ]
  }, {
    "tStartMs": 23850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to shoot in these magnetic fields."
    } ]
  }, {
    "tStartMs": 26790,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "A portion of this video\nwas sponsored by Google."
    } ]
  }, {
    "tStartMs": 30060,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I came to the National High\nMagnetic Field Laboratory"
    } ]
  }, {
    "tStartMs": 32610,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "in Tallahassee, Florida,\nwhere since the year 2000,"
    } ]
  }, {
    "tStartMs": 35760,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "they have held the Guinness World Record"
    } ]
  }, {
    "tStartMs": 37980,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "for the strongest\ncontinuous magnetic field."
    } ]
  }, {
    "tStartMs": 40740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Somebody left a chair where\nit wasn't supposed to be."
    } ]
  }, {
    "tStartMs": 43500,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It then got accelerated across the cell,"
    } ]
  }, {
    "tStartMs": 46410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "completely pulled the\nguts out of the chair."
    } ]
  }, {
    "tStartMs": 48810,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Now we all have those\nnice, super uncomfortable,"
    } ]
  }, {
    "tStartMs": 52410,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "wooden chairs."
    } ]
  }, {
    "tStartMs": 53340,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "- For reference, the magnetic field"
    } ]
  }, {
    "tStartMs": 55010,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "of the Earth is 0.00005 Tesla."
    } ]
  }, {
    "tStartMs": 59610,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "A fridge magnet is around 0.01 Tesla."
    } ]
  }, {
    "tStartMs": 63330,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "MRI machines can get up to three Tesla."
    } ]
  }, {
    "tStartMs": 66540,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But this electromagnet creates\na magnetic field of 45 Tesla,"
    } ]
  }, {
    "tStartMs": 71820,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "so nearly a million times\nEarth's magnetic field."
    } ]
  }, {
    "tStartMs": 77160,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "To achieve this field, the magnet consists"
    } ]
  }, {
    "tStartMs": 79830,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of an outer superconducting magnet"
    } ]
  }, {
    "tStartMs": 81660,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and an inner resistive magnet."
    } ]
  }, {
    "tStartMs": 83940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "I'll explain why you need\nboth types in a moment."
    } ]
  }, {
    "tStartMs": 86670,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The apparatus is two stories tall,"
    } ]
  }, {
    "tStartMs": 89820,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "but the maximum field,"
    } ]
  }, {
    "tStartMs": 91140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "or field center, only occurs in the center"
    } ]
  }, {
    "tStartMs": 93720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of a narrow cylinder that\nruns through the middle."
    } ]
  }, {
    "tStartMs": 96120,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Right now it's off.\n- Is it?"
    } ]
  }, {
    "tStartMs": 97470,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Tim] There's no magnet."
    } ]
  }, {
    "tStartMs": 98550,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- Can I put my finger in the bore?"
    } ]
  }, {
    "tStartMs": 100650,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Is that a bad idea?"
    } ]
  }, {
    "tStartMs": 101580,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- No, it's fine."
    } ]
  }, {
    "tStartMs": 103050,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "You can totally do that."
    } ]
  }, {
    "tStartMs": 105150,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "- I'm gonna see. Oh."
    } ]
  }, {
    "tStartMs": 107340,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So that's where there's 45 Tesla."
    } ]
  }, {
    "tStartMs": 109230,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Further down."
    } ]
  }, {
    "tStartMs": 110063,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "A meter away from that.\n- A meter down."
    } ]
  }, {
    "tStartMs": 111720,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And so that just drops down"
    } ]
  }, {
    "tStartMs": 113430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "for a couple meters?\n- It's clear all the way"
    } ]
  }, {
    "tStartMs": 115470,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "through to the bottom.\n- Oh wow."
    } ]
  }, {
    "tStartMs": 116970,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- The maximum field is\nbasically a centimeter tall."
    } ]
  }, {
    "tStartMs": 120540,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah.\n- Here we have"
    } ]
  }, {
    "tStartMs": 121373,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "very small samples."
    } ]
  }, {
    "tStartMs": 122206,
    "dDurationMs": 3164,
    "segs": [ {
      "utf8": "Think something like a chip\nin a computer or a cell phone."
    } ]
  }, {
    "tStartMs": 125370,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That's what users will come in with."
    } ]
  }, {
    "tStartMs": 127050,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So that's plenty big\nfor what we want to do"
    } ]
  }, {
    "tStartMs": 130470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with material science or\nkinetic matter research."
    } ]
  }, {
    "tStartMs": 132870,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Since we can't see or film in the center"
    } ]
  }, {
    "tStartMs": 135210,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "of the magnet, we're going to experiment"
    } ]
  }, {
    "tStartMs": 136950,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "with the magnetic field that extends above"
    } ]
  }, {
    "tStartMs": 138930,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and around the magnet on this platform."
    } ]
  }, {
    "tStartMs": 141270,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So the magnet's over there?"
    } ]
  }, {
    "tStartMs": 143010,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- Yes.\n- But the magnetic field"
    } ]
  }, {
    "tStartMs": 144300,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "extends all the way out here."
    } ]
  }, {
    "tStartMs": 145860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Yes.\n- And past."
    } ]
  }, {
    "tStartMs": 147360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This is known as the fringe field,"
    } ]
  }, {
    "tStartMs": 149730,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and although it's much\nweaker than 45 Tesla,"
    } ]
  }, {
    "tStartMs": 152010,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "it is still plenty dangerous."
    } ]
  }, {
    "tStartMs": 154650,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- For a superconducting magnet,"
    } ]
  }, {
    "tStartMs": 156720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it depends on the size of that bore."
    } ]
  }, {
    "tStartMs": 159420,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So the bigger the bore, the\nlarger the fringe field,"
    } ]
  }, {
    "tStartMs": 162120,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "because the magnetic flux does\nnot penetrate the windings."
    } ]
  }, {
    "tStartMs": 166350,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And you have to form a complete loop."
    } ]
  }, {
    "tStartMs": 168090,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So those loops just move further"
    } ]
  }, {
    "tStartMs": 169770,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and further and further\nout to make that field."
    } ]
  }, {
    "tStartMs": 172890,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So this is the 100 Gauss\nline for the fringe field."
    } ]
  }, {
    "tStartMs": 175800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- So what happens to objects"
    } ]
  }, {
    "tStartMs": 177240,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "around the 100 Gauss line?"
    } ]
  }, {
    "tStartMs": 178530,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- Things with shapes will\nstart orienting themselves"
    } ]
  }, {
    "tStartMs": 181770,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to the field."
    } ]
  }, {
    "tStartMs": 182730,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "So if you have it sitting on a tabletop,"
    } ]
  }, {
    "tStartMs": 185730,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "say over here, it will\nstart pivoting on its own."
    } ]
  }, {
    "tStartMs": 190200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And if you get it too much\ncloser, it will just go."
    } ]
  }, {
    "tStartMs": 193080,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And by the time you notice it's moving,"
    } ]
  }, {
    "tStartMs": 194640,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "it's already too late."
    } ]
  }, {
    "tStartMs": 195630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Meaning, no ferromagnetic objects"
    } ]
  }, {
    "tStartMs": 197640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "within the 100 Gauss line."
    } ]
  }, {
    "tStartMs": 198840,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "If you have anything ferromagnetic on you,"
    } ]
  }, {
    "tStartMs": 201660,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "any implants that are metallic."
    } ]
  }, {
    "tStartMs": 204090,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Pacemaker? Anybody?"
    } ]
  }, {
    "tStartMs": 205500,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "Anybody? Anybody? Okay."
    } ]
  }, {
    "tStartMs": 208110,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Ramping up this magnet to full power"
    } ]
  }, {
    "tStartMs": 210060,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "takes around an hour and a half."
    } ]
  }, {
    "tStartMs": 212520,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "That's because they\nhave to put 47,000 amps"
    } ]
  }, {
    "tStartMs": 215610,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "of current into the outer\nsuperconducting electromagnet."
    } ]
  }, {
    "tStartMs": 218700,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "47,000 amps."
    } ]
  }, {
    "tStartMs": 219620,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "- 47,000 amps, 500 volts."
    } ]
  }, {
    "tStartMs": 221760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- It is so insane."
    } ]
  }, {
    "tStartMs": 223950,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Tim] All right, so let's\ntake it all the way up"
    } ]
  }, {
    "tStartMs": 225360,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "to full field."
    } ]
  }, {
    "tStartMs": 228480,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "- One thing that happens"
    } ]
  }, {
    "tStartMs": 229440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "in a strong magnetic field, obviously,"
    } ]
  }, {
    "tStartMs": 231600,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "is that magnetic materials\nare attracted to it."
    } ]
  }, {
    "tStartMs": 234870,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "We cut open a Nerf football"
    } ]
  }, {
    "tStartMs": 236400,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and put in a couple steel\nwashers being careful"
    } ]
  }, {
    "tStartMs": 238950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to tape it up so the\nwashers can't get out."
    } ]
  }, {
    "tStartMs": 241050,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "We also covered the opening to the magnet"
    } ]
  }, {
    "tStartMs": 242940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "so the ball won't get sucked down into it."
    } ]
  }, {
    "tStartMs": 245070,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "I got an unmodified Nerf football."
    } ]
  }, {
    "tStartMs": 248700,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "And sure enough,"
    } ]
  }, {
    "tStartMs": 249870,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "it's easy to tell which\nball contains the washers."
    } ]
  }, {
    "tStartMs": 256320,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I tried to throw the football"
    } ]
  }, {
    "tStartMs": 257670,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and hit the side of the magnet."
    } ]
  }, {
    "tStartMs": 260100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 260933,
    "dDurationMs": 1087,
    "segs": [ {
      "utf8": "After a few misses."
    } ]
  }, {
    "tStartMs": 262020,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "No! Are you kidding me?"
    } ]
  }, {
    "tStartMs": 264624,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "No.\n- No."
    } ]
  }, {
    "tStartMs": 266940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- It bounced around and stuck."
    } ]
  }, {
    "tStartMs": 269220,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "It should have looked more like this."
    } ]
  }, {
    "tStartMs": 272880,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Another thing to do if\nyou have a strong magnet"
    } ]
  }, {
    "tStartMs": 274860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is get ferrofluid fluid."
    } ]
  }, {
    "tStartMs": 276900,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Ferrofluid fluid contains\nnanoscale pieces of magnetite,"
    } ]
  }, {
    "tStartMs": 280020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that's an iron containing mineral,"
    } ]
  }, {
    "tStartMs": 281940,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and they're suspended in solution"
    } ]
  }, {
    "tStartMs": 283890,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "coded in surfactants so they\ndon't all clump together."
    } ]
  }, {
    "tStartMs": 287040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But in an external magnetic field,"
    } ]
  }, {
    "tStartMs": 288870,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "they all line up like iron\nfilings around a bar magnet."
    } ]
  }, {
    "tStartMs": 293400,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This ferrofluid fluid started\nto develop parallel ridges"
    } ]
  }, {
    "tStartMs": 296640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "even meters away from the magnet."
    } ]
  }, {
    "tStartMs": 298950,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And as we got closer, spikes\nformed on the surface,"
    } ]
  }, {
    "tStartMs": 302250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "aligning the magnetite\nparticles with the field."
    } ]
  }, {
    "tStartMs": 304980,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Closer still and the ferrofluid\nfluid climbed up the side"
    } ]
  }, {
    "tStartMs": 308160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of the vessel."
    } ]
  }, {
    "tStartMs": 309360,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "- [Tim] So it's not much,\nbut it's just kind of a."
    } ]
  }, {
    "tStartMs": 311203,
    "dDurationMs": 1247,
    "segs": [ {
      "utf8": "- A little bit of a tug?"
    } ]
  }, {
    "tStartMs": 312450,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Tim] Yep, and then\ntry and tilt it away,"
    } ]
  }, {
    "tStartMs": 314280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and then you'll feel the difference."
    } ]
  }, {
    "tStartMs": 316530,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh yeah."
    } ]
  }, {
    "tStartMs": 317363,
    "dDurationMs": 2947,
    "segs": [ {
      "utf8": "It definitely preferentially\nwants to come this way."
    } ]
  }, {
    "tStartMs": 320310,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Magnetite is actually the\nmineral that led people"
    } ]
  }, {
    "tStartMs": 322530,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to discover the phenomenon of\nmagnetism in the first place."
    } ]
  }, {
    "tStartMs": 325470,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "At least 3000 years ago,"
    } ]
  }, {
    "tStartMs": 327630,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "naturally magnetized pieces\nof magnetite were found"
    } ]
  }, {
    "tStartMs": 330330,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in a part of Greece called Magnesia."
    } ]
  }, {
    "tStartMs": 332970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "That's actually where the\nword magnet comes from."
    } ]
  }, {
    "tStartMs": 335760,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "In Greek, they were called\nstones from magnesia"
    } ]
  }, {
    "tStartMs": 339450,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but they were also\nreferred to as lodestones."
    } ]
  }, {
    "tStartMs": 342600,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "And it was discovered"
    } ]
  }, {
    "tStartMs": 343620,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that lodestones could attract\neach other or pieces of iron."
    } ]
  }, {
    "tStartMs": 347220,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And by the 11th century\nin China, it was realized"
    } ]
  }, {
    "tStartMs": 349890,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "that magnets could be used\nto make a compass needle"
    } ]
  }, {
    "tStartMs": 352320,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that would always point\nin the same direction."
    } ]
  }, {
    "tStartMs": 354690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The side that pointed to the north"
    } ]
  }, {
    "tStartMs": 356220,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "of the earth was referred\nto as a north seeking pole."
    } ]
  }, {
    "tStartMs": 359250,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And the other side,\nthe south seeking pole."
    } ]
  }, {
    "tStartMs": 361680,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Though these days we\noften just say North Pole"
    } ]
  }, {
    "tStartMs": 363750,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and South Pole of the magnet."
    } ]
  }, {
    "tStartMs": 365910,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But why are only some materials magnetic?"
    } ]
  }, {
    "tStartMs": 369510,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Electrons are essentially tiny magnets,"
    } ]
  }, {
    "tStartMs": 372330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but in most atoms, they are paired up,"
    } ]
  }, {
    "tStartMs": 374670,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "one pointing one way"
    } ]
  }, {
    "tStartMs": 375600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and the other pointing the opposite way."
    } ]
  }, {
    "tStartMs": 377040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So their fields cancel out."
    } ]
  }, {
    "tStartMs": 379200,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "In elements with half full\nouter shells of electrons,"
    } ]
  }, {
    "tStartMs": 382830,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "well, then they can't pair up."
    } ]
  }, {
    "tStartMs": 384930,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So atoms have magnetic fields."
    } ]
  }, {
    "tStartMs": 387630,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But if neighboring atoms aren't aligned,"
    } ]
  }, {
    "tStartMs": 390060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "well then, the magnetic fields"
    } ]
  }, {
    "tStartMs": 391560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of all the atoms cancel out"
    } ]
  }, {
    "tStartMs": 393120,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and the bulk material is non-magnetic."
    } ]
  }, {
    "tStartMs": 395790,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "But even if you get all these\natoms aligning in one part"
    } ]
  }, {
    "tStartMs": 399180,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of the material, known as a domain,"
    } ]
  }, {
    "tStartMs": 401190,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "they may be aligned opposite\natoms in other domains"
    } ]
  }, {
    "tStartMs": 404160,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and cancel out."
    } ]
  }, {
    "tStartMs": 405240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So you need all the domains to be aligned."
    } ]
  }, {
    "tStartMs": 407940,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Normally when you see these,\nthey're really strong magnets."
    } ]
  }, {
    "tStartMs": 411660,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "But not here and not yet."
    } ]
  }, {
    "tStartMs": 413670,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And this can be done by applying"
    } ]
  }, {
    "tStartMs": 414810,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "a strong external magnetic field."
    } ]
  }, {
    "tStartMs": 416510,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "So right now, these are not magnetic."
    } ]
  }, {
    "tStartMs": 419640,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "They do not stick to each other."
    } ]
  }, {
    "tStartMs": 422550,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But he is loading them in there,"
    } ]
  }, {
    "tStartMs": 424800,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "into the Helmholtz coil."
    } ]
  }, {
    "tStartMs": 427067,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- See the machine here?\n- Whoa!"
    } ]
  }, {
    "tStartMs": 429270,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And then you get a permanent magnet."
    } ]
  }, {
    "tStartMs": 431940,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Materials that meet these\ncriteria are called ferromagnetic."
    } ]
  }, {
    "tStartMs": 435090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "After iron, the most\ncommon magnetic element."
    } ]
  }, {
    "tStartMs": 437700,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But nickel and cobalt are\nalso ferromagnetic magnetic."
    } ]
  }, {
    "tStartMs": 441240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "In the powerful magnetic field"
    } ]
  }, {
    "tStartMs": 442770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "around the world's strongest magnet,"
    } ]
  }, {
    "tStartMs": 444660,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "what is even more surprising\nto see is the behavior"
    } ]
  }, {
    "tStartMs": 447270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of non-ferromagnetic materials."
    } ]
  }, {
    "tStartMs": 449850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Here we have four sheets\nof different materials."
    } ]
  }, {
    "tStartMs": 452790,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Two different types of\nplastic, copper, and aluminum."
    } ]
  }, {
    "tStartMs": 456090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "When they are stationary in the field,"
    } ]
  }, {
    "tStartMs": 458070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "there's no difference between them."
    } ]
  }, {
    "tStartMs": 460230,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "But when they move."
    } ]
  }, {
    "tStartMs": 461727,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "- Two, one, drop!"
    } ]
  }, {
    "tStartMs": 463920,
    "dDurationMs": 3702,
    "segs": [ {
      "utf8": "- Materials that conduct\nelectricity fall a lot slower."
    } ]
  }, {
    "tStartMs": 467622,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(gentle upbeat music)"
    } ]
  }, {
    "tStartMs": 472740,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I'll get into that."
    } ]
  }, {
    "tStartMs": 473573,
    "dDurationMs": 1987,
    "segs": [ {
      "utf8": "But first, this portion of the video"
    } ]
  }, {
    "tStartMs": 475560,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "was sponsored by Google"
    } ]
  }, {
    "tStartMs": 476880,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and they were interested in this video"
    } ]
  }, {
    "tStartMs": 478950,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "because it's all about magnets,"
    } ]
  }, {
    "tStartMs": 480300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which are core to our future."
    } ]
  }, {
    "tStartMs": 482340,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Electric vehicles, for example,"
    } ]
  }, {
    "tStartMs": 483840,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "use electric motors, which\nneed magnets to work."
    } ]
  }, {
    "tStartMs": 486660,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And US search interest\nfor electric vehicle"
    } ]
  }, {
    "tStartMs": 488970,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "reached an all-time high\nin the last 12 months."
    } ]
  }, {
    "tStartMs": 491910,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That is, according to Google Trends,"
    } ]
  }, {
    "tStartMs": 493830,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "a tool that allows you to see\nwhat people are searching for."
    } ]
  }, {
    "tStartMs": 496890,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The thing that connects\nthese trending searches"
    } ]
  }, {
    "tStartMs": 499020,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and many others, is that\npeople are trying to find ways"
    } ]
  }, {
    "tStartMs": 501930,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "of doing things that are less\ndestructive to the planet."
    } ]
  }, {
    "tStartMs": 504510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And Google is like, \"We\nlive on this planet too."
    } ]
  }, {
    "tStartMs": 507000,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "We also wanna do that.\""
    } ]
  }, {
    "tStartMs": 508530,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "In fact, Google has matched 100%"
    } ]
  }, {
    "tStartMs": 510540,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "of their electricity use with\nrenewable energy since 2017."
    } ]
  }, {
    "tStartMs": 514110,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "They also run Project Sunroof,"
    } ]
  }, {
    "tStartMs": 515580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which helps people\ndecide if solar is right"
    } ]
  }, {
    "tStartMs": 517500,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "for their home by\nproviding Google Maps data"
    } ]
  }, {
    "tStartMs": 519870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "to create a 3D model of your roof"
    } ]
  }, {
    "tStartMs": 521820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and estimate energy\nsavings from rooftop solar."
    } ]
  }, {
    "tStartMs": 525000,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Personally, I'm just happy to learn"
    } ]
  }, {
    "tStartMs": 526650,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that people are searching\nfor things related"
    } ]
  }, {
    "tStartMs": 528480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to sustainability and that\nGoogle has made a real commitment"
    } ]
  }, {
    "tStartMs": 531480,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to sustainability, too."
    } ]
  }, {
    "tStartMs": 533160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "You can learn more about sustainability"
    } ]
  }, {
    "tStartMs": 534660,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and Google's efforts at\nsustainability.google."
    } ]
  }, {
    "tStartMs": 537480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So thanks to Google for\nsponsoring that part of my video."
    } ]
  }, {
    "tStartMs": 540240,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "And now, back to magnets."
    } ]
  }, {
    "tStartMs": 544380,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "What's happening is that,"
    } ]
  }, {
    "tStartMs": 545640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as the metal plate is\nfalling through the field,"
    } ]
  }, {
    "tStartMs": 547560,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the number of magnetic field lines"
    } ]
  }, {
    "tStartMs": 549030,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "passing through it is changing."
    } ]
  }, {
    "tStartMs": 551010,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "This change in magnetic flux\ninduces electric currents,"
    } ]
  }, {
    "tStartMs": 554370,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "called eddy currents in the plate,"
    } ]
  }, {
    "tStartMs": 556170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "which create their own magnetic field"
    } ]
  }, {
    "tStartMs": 558000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that opposes the change in the flux."
    } ]
  }, {
    "tStartMs": 560550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This is known as Lenz's Law."
    } ]
  }, {
    "tStartMs": 562770,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So if the plate is falling\ntowards a north magnetic pole,"
    } ]
  }, {
    "tStartMs": 566040,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "the induced currents create a\nnorth magnetic pole themselves"
    } ]
  }, {
    "tStartMs": 569700,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "so that the plate is repelled\nand so it falls much slower."
    } ]
  }, {
    "tStartMs": 574170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So as that big plate falls,"
    } ]
  }, {
    "tStartMs": 576000,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "there are eddy currents\ngenerated in the metal,"
    } ]
  }, {
    "tStartMs": 579990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which should dissipate\nsome energy as heat."
    } ]
  }, {
    "tStartMs": 582390,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So I wanna see if we can see that."
    } ]
  }, {
    "tStartMs": 584400,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- [Tim] It's actually slowing down now."
    } ]
  }, {
    "tStartMs": 588990,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "'Cause it's in a much higher field"
    } ]
  }, {
    "tStartMs": 590730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Now it is slight,\nbut I think you can see"
    } ]
  }, {
    "tStartMs": 593400,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "that the plate is warming\nup a bit as it falls."
    } ]
  }, {
    "tStartMs": 597420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Previously, I visited an\nelectromagnetic levitator"
    } ]
  }, {
    "tStartMs": 599910,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "at the Palace of Discovery in Paris."
    } ]
  }, {
    "tStartMs": 602550,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Whoa!"
    } ]
  }, {
    "tStartMs": 603540,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It uses an alternating\ncurrent to levitate a plate,"
    } ]
  }, {
    "tStartMs": 606660,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "but the eddy currents in that plate"
    } ]
  }, {
    "tStartMs": 608130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "generate so much heat\nthat water actually boils"
    } ]
  }, {
    "tStartMs": 611070,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "on its surface."
    } ]
  }, {
    "tStartMs": 612150,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Check out how hot this plate is."
    } ]
  }, {
    "tStartMs": 615960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I like to think of Lenz's\nLaw as the \"No You Don't\" Law"
    } ]
  }, {
    "tStartMs": 619080,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "because whatever you try to\ndo, nature acts to oppose you."
    } ]
  }, {
    "tStartMs": 622050,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "- There you go.\n- Ah!"
    } ]
  }, {
    "tStartMs": 627230,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "If the plate is falling,"
    } ]
  }, {
    "tStartMs": 628680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "eddy currents are induced\nto slow its dissent."
    } ]
  }, {
    "tStartMs": 630720,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "Look at it! (laughs)"
    } ]
  }, {
    "tStartMs": 635010,
    "dDurationMs": 1753,
    "segs": [ {
      "utf8": "But if you try to pick up the plate."
    } ]
  }, {
    "tStartMs": 636763,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughs) Come on!"
    } ]
  }, {
    "tStartMs": 639900,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "Nature also says, \"No, you don't.\""
    } ]
  }, {
    "tStartMs": 643290,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "In this case, a south\nmagnetic pole is induced"
    } ]
  }, {
    "tStartMs": 645540,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "under the plate, attracting\nit back to the magnet."
    } ]
  }, {
    "tStartMs": 648150,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They don't know if I'm weak"
    } ]
  }, {
    "tStartMs": 649950,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "or if this is actually insanely difficult."
    } ]
  }, {
    "tStartMs": 653690,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "Ah, ah."
    } ]
  }, {
    "tStartMs": 656880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Oh.\n- There you go."
    } ]
  }, {
    "tStartMs": 659280,
    "dDurationMs": 2904,
    "segs": [ {
      "utf8": "- Oh my goodness.\n- You're strong like bull."
    } ]
  }, {
    "tStartMs": 662184,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "- Whoa."
    } ]
  }, {
    "tStartMs": 663060,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "No matter how hard I tried\nto push the plate down,"
    } ]
  }, {
    "tStartMs": 666300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "it just wouldn't go very fast."
    } ]
  }, {
    "tStartMs": 668340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Because even if I could\nspeed it up a little bit,"
    } ]
  }, {
    "tStartMs": 670500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that would increase the\nrate of change of flux,"
    } ]
  }, {
    "tStartMs": 672540,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and hence the induced currents"
    } ]
  }, {
    "tStartMs": 674310,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "and their associated magnetic field."
    } ]
  }, {
    "tStartMs": 677550,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "That is ridiculous."
    } ]
  }, {
    "tStartMs": 680417,
    "dDurationMs": 1573,
    "segs": [ {
      "utf8": "It's so weird."
    } ]
  }, {
    "tStartMs": 681990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We tried a number of other conductive,"
    } ]
  }, {
    "tStartMs": 684030,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "but non-magnetic objects,\naround the magnet,"
    } ]
  }, {
    "tStartMs": 686340,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "like this thick cylinder of aluminum."
    } ]
  }, {
    "tStartMs": 688710,
    "dDurationMs": 2977,
    "segs": [ {
      "utf8": "Drop it straight on the\nmagnet and nature says,"
    } ]
  }, {
    "tStartMs": 691687,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "\"No you don't.\""
    } ]
  }, {
    "tStartMs": 693420,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Try to roll it across\nthe top. No you don't."
    } ]
  }, {
    "tStartMs": 696390,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "It just refuses to roll."
    } ]
  }, {
    "tStartMs": 700500,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "We wrapped up a volleyball\nin aluminum foil"
    } ]
  }, {
    "tStartMs": 703260,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "and passed it across the magnet."
    } ]
  }, {
    "tStartMs": 709579,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "Or dropped it straight in."
    } ]
  }, {
    "tStartMs": 713460,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Again, the changing magnetic\nflux induces eddy currents"
    } ]
  }, {
    "tStartMs": 716400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that produce their own magnetic field"
    } ]
  }, {
    "tStartMs": 718440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to oppose the original change in flux."
    } ]
  }, {
    "tStartMs": 721800,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "We wanted to see just how much\ndeceleration the fringe field"
    } ]
  }, {
    "tStartMs": 725010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "of the 45 Tesla magnet could achieve."
    } ]
  }, {
    "tStartMs": 727110,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So we decided to fire projectiles"
    } ]
  }, {
    "tStartMs": 729420,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "from a potato cannon across the top."
    } ]
  }, {
    "tStartMs": 732300,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "- You ready?\n- All right, we're ready."
    } ]
  }, {
    "tStartMs": 735123,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- Three, two, one.\n(metal clanks)"
    } ]
  }, {
    "tStartMs": 740972,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "Heads!\n(metal clanks)"
    } ]
  }, {
    "tStartMs": 745560,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- This is what the projectile looked like"
    } ]
  }, {
    "tStartMs": 747210,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with the magnetic field off."
    } ]
  }, {
    "tStartMs": 749610,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "And this is what it looked like\nwith the magnetic field on."
    } ]
  }, {
    "tStartMs": 754680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "If we compare the two shots, you can see"
    } ]
  }, {
    "tStartMs": 756930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that as the projectile\nenters the magnetic field,"
    } ]
  }, {
    "tStartMs": 759690,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "the induced eddy currents\nrotate the projectile."
    } ]
  }, {
    "tStartMs": 762990,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So it remains oriented along\nthe magnetic field lines."
    } ]
  }, {
    "tStartMs": 767010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And this minimizes the change in flux"
    } ]
  }, {
    "tStartMs": 769410,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that's experienced by the projectile."
    } ]
  }, {
    "tStartMs": 770880,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "- [Operator] Three, two, one."
    } ]
  }, {
    "tStartMs": 774720,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- Now, some of the\nprojectiles contained coils"
    } ]
  }, {
    "tStartMs": 776730,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of wire that were connected to LEDs."
    } ]
  }, {
    "tStartMs": 778290,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "- So the LEDs are actually\nbiased opposite polarity."
    } ]
  }, {
    "tStartMs": 782670,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So no matter which direction\nthe field is coming in,"
    } ]
  }, {
    "tStartMs": 784770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "one of them will be lit."
    } ]
  }, {
    "tStartMs": 786330,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And we're hoping that as\nit crosses through a field,"
    } ]
  }, {
    "tStartMs": 788250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "you'll see the change in color of LED"
    } ]
  }, {
    "tStartMs": 790200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of the nose cone."
    } ]
  }, {
    "tStartMs": 791033,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "- Mar And sure enough,\nthese projectiles light up,"
    } ]
  }, {
    "tStartMs": 794070,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "showing how the induced currents\nare changing in the coil."
    } ]
  }, {
    "tStartMs": 797902,
    "dDurationMs": 2918,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 800820,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "You know, in all these cases"
    } ]
  }, {
    "tStartMs": 802080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the induced electric energy is dissipated,"
    } ]
  }, {
    "tStartMs": 804360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "either as light or heat."
    } ]
  }, {
    "tStartMs": 806520,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But what if you had a material\nthat didn't dissipate energy,"
    } ]
  }, {
    "tStartMs": 809670,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "like a superconductor below\nits critical temperature?"
    } ]
  }, {
    "tStartMs": 813240,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "There are two important things to know"
    } ]
  }, {
    "tStartMs": 815250,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "about the high temperature\nsuperconductor we're using here."
    } ]
  }, {
    "tStartMs": 818070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "First, below its critical temperature,"
    } ]
  }, {
    "tStartMs": 820230,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "most of the material has\nzero electrical resistance,"
    } ]
  }, {
    "tStartMs": 823320,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which means, if you bring\na magnet close to it,"
    } ]
  }, {
    "tStartMs": 826020,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "currents will be induced to\noppose the change in flux."
    } ]
  }, {
    "tStartMs": 829440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And since it's a superconductor,"
    } ]
  }, {
    "tStartMs": 830940,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "those currents can persist indefinitely"
    } ]
  }, {
    "tStartMs": 833280,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and expel all of the magnetic field."
    } ]
  }, {
    "tStartMs": 836310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Second, there are some\nfilaments through the material"
    } ]
  }, {
    "tStartMs": 838980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that are not superconducting."
    } ]
  }, {
    "tStartMs": 840870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- There's defects that are engineered"
    } ]
  }, {
    "tStartMs": 843420,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "into the superconductors,"
    } ]
  }, {
    "tStartMs": 844440,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "a second phase that traps\nthose magnetic field lines"
    } ]
  }, {
    "tStartMs": 848160,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and keeps them from moving."
    } ]
  }, {
    "tStartMs": 849750,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "It can no longer rise or fall"
    } ]
  }, {
    "tStartMs": 852720,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "because it's kind of locked in\nthat magnetic configuration."
    } ]
  }, {
    "tStartMs": 857850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- This is the human levitator."
    } ]
  }, {
    "tStartMs": 859590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It consists of a 90 pound,\nor 40 kilogram, magnet,"
    } ]
  }, {
    "tStartMs": 862800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "hovering above a ring of superconductors."
    } ]
  }, {
    "tStartMs": 865680,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "So I'm standing at the magnet,"
    } ]
  }, {
    "tStartMs": 867210,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and underneath is the superconductor?"
    } ]
  }, {
    "tStartMs": 868560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's right."
    } ]
  }, {
    "tStartMs": 869393,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- When I stand on the magnet,"
    } ]
  }, {
    "tStartMs": 870810,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "it is pressed down into\nthe superconductors."
    } ]
  }, {
    "tStartMs": 874050,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But the increase in magnetic\nflux is opposed by currents"
    } ]
  }, {
    "tStartMs": 877650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "in the superconductors\ncreating a magnetic field"
    } ]
  }, {
    "tStartMs": 880200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that repels the magnetic field"
    } ]
  }, {
    "tStartMs": 882330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "from the magnet I'm standing on."
    } ]
  }, {
    "tStartMs": 883980,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Maintain my angular moment."
    } ]
  }, {
    "tStartMs": 885480,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "Oh yeah."
    } ]
  }, {
    "tStartMs": 888600,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "So I remain levitating\nabove the superconductors."
    } ]
  }, {
    "tStartMs": 893910,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Speaker] I also brought a leaf blower,"
    } ]
  }, {
    "tStartMs": 895110,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "if you wanna hold on that, turn it on."
    } ]
  }, {
    "tStartMs": 896988,
    "dDurationMs": 2484,
    "segs": [ {
      "utf8": "- For real?\n(group laughs)"
    } ]
  }, {
    "tStartMs": 899472,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "- It's up to you.\n- Let's get it."
    } ]
  }, {
    "tStartMs": 901132,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(leaf blower whirs)"
    } ]
  }, {
    "tStartMs": 912240,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now, there's another way to\nlevitate in a magnetic field"
    } ]
  }, {
    "tStartMs": 914790,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "that has nothing to do\nwith induced eddy currents."
    } ]
  }, {
    "tStartMs": 918270,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And it's all because"
    } ]
  }, {
    "tStartMs": 919860,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "all materials actually\nhave magnetic properties."
    } ]
  }, {
    "tStartMs": 922830,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "They're just hard to see"
    } ]
  }, {
    "tStartMs": 924180,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "unless a strong magnetic field is present."
    } ]
  }, {
    "tStartMs": 927060,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Some materials are always\nattracted to magnetic fields."
    } ]
  }, {
    "tStartMs": 930720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "They display what's called para magnetism."
    } ]
  }, {
    "tStartMs": 933420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Oxygen is like this."
    } ]
  }, {
    "tStartMs": 934860,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "- We have liquid oxygen\ndripping off the bottom here,"
    } ]
  }, {
    "tStartMs": 938970,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "and it gets attracted to the magnet."
    } ]
  }, {
    "tStartMs": 941150,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "It doesn't matter if it's a north"
    } ]
  }, {
    "tStartMs": 942360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "or south magnetic pole,"
    } ]
  }, {
    "tStartMs": 943800,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "the presence of the external\nfield causes the magnetic field"
    } ]
  }, {
    "tStartMs": 946550,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "of material to strengthen\nthe overall magnetic field."
    } ]
  }, {
    "tStartMs": 949860,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And that causes attraction."
    } ]
  }, {
    "tStartMs": 952860,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Other materials, in fact,\nmost materials are repelled"
    } ]
  }, {
    "tStartMs": 955950,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "by a strong enough magnetic\nfield, either north or south."
    } ]
  }, {
    "tStartMs": 959070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And this is known as diamagnetism."
    } ]
  }, {
    "tStartMs": 961860,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Water is a good example of this."
    } ]
  }, {
    "tStartMs": 963870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "In the presence of the external field,"
    } ]
  }, {
    "tStartMs": 965550,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "the water molecules become\nopposing magnets effectively."
    } ]
  }, {
    "tStartMs": 968850,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And so they are repelled."
    } ]
  }, {
    "tStartMs": 971370,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So here you can see how\nbringing a magnet close"
    } ]
  }, {
    "tStartMs": 973950,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to the surface of water creates an indent."
    } ]
  }, {
    "tStartMs": 976950,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "You can use this repulsion"
    } ]
  }, {
    "tStartMs": 978600,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in a strong enough magnetic field"
    } ]
  }, {
    "tStartMs": 980250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "to levitate objects you\nordinarily wouldn't think"
    } ]
  }, {
    "tStartMs": 982980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "of as magnetic."
    } ]
  }, {
    "tStartMs": 984630,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Here we're using a slightly\nweaker 31 Tesla magnet"
    } ]
  }, {
    "tStartMs": 988350,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so that we can use a periscope setup"
    } ]
  }, {
    "tStartMs": 990570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to actually see into the bore."
    } ]
  }, {
    "tStartMs": 992400,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "And our camera is there.\n- So as soon as you are"
    } ]
  }, {
    "tStartMs": 994136,
    "dDurationMs": 1684,
    "segs": [ {
      "utf8": "on this optical way,"
    } ]
  }, {
    "tStartMs": 995820,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you should be able to put everything down."
    } ]
  }, {
    "tStartMs": 998220,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Wonderful."
    } ]
  }, {
    "tStartMs": 999060,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "This strawberry will be magnetic\nin a strong enough field."
    } ]
  }, {
    "tStartMs": 1003200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Well, it's diamagnetic right now."
    } ]
  }, {
    "tStartMs": 1004910,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "It's just we're not in\na strong enough field."
    } ]
  }, {
    "tStartMs": 1006680,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1007513,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "- For us to see anything.\n- Mm hmm. Correct."
    } ]
  }, {
    "tStartMs": 1009320,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Because of the water.\n- Right."
    } ]
  }, {
    "tStartMs": 1010340,
    "dDurationMs": 897,
    "segs": [ {
      "utf8": "- Water is diamagnetic"
    } ]
  }, {
    "tStartMs": 1011237,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "and there's a lot of\nwater in strawberries."
    } ]
  }, {
    "tStartMs": 1015860,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Oh, that's nice."
    } ]
  }, {
    "tStartMs": 1017660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Oh, that's beautiful."
    } ]
  }, {
    "tStartMs": 1019640,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Yeah, it's beautiful."
    } ]
  }, {
    "tStartMs": 1021470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And the same occurs with a raspberry"
    } ]
  }, {
    "tStartMs": 1023870,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "or a little piece of plastic pizza."
    } ]
  }, {
    "tStartMs": 1027380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Living organisms contain enough water"
    } ]
  }, {
    "tStartMs": 1029390,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that they too can be levitated."
    } ]
  }, {
    "tStartMs": 1031460,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "They wouldn't do it here at the mag lab"
    } ]
  }, {
    "tStartMs": 1033470,
    "dDurationMs": 2448,
    "segs": [ {
      "utf8": "but people have levitated frogs."
    } ]
  }, {
    "tStartMs": 1035918,
    "dDurationMs": 1684,
    "segs": [ {
      "utf8": "- Oh!\n- Yep, this is it!"
    } ]
  }, {
    "tStartMs": 1037602,
    "dDurationMs": 3038,
    "segs": [ {
      "utf8": "Yep, there you go.\n- No way!"
    } ]
  }, {
    "tStartMs": 1040640,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "- And grasshoppers?"
    } ]
  }, {
    "tStartMs": 1044420,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Even mice in experiments meant"
    } ]
  }, {
    "tStartMs": 1046190,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to help understand the\neffects of weightlessness"
    } ]
  }, {
    "tStartMs": 1048020,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "without having to go into space."
    } ]
  }, {
    "tStartMs": 1050240,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So are very strong magnetic\nfields safe for living things?"
    } ]
  }, {
    "tStartMs": 1053510,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- There are no lasting effects,"
    } ]
  }, {
    "tStartMs": 1054800,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "there are no long-term effects."
    } ]
  }, {
    "tStartMs": 1056030,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But we have noticed that\nthere is the possibility"
    } ]
  }, {
    "tStartMs": 1059030,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "of actually polarizing the\nstones that are in the inner ear."
    } ]
  }, {
    "tStartMs": 1062600,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And the effect that that has on the rodent"
    } ]
  }, {
    "tStartMs": 1065330,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "is that the rodent actually spins."
    } ]
  }, {
    "tStartMs": 1068610,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "- Like they go in circles?\n- They go in circles."
    } ]
  }, {
    "tStartMs": 1070940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It doesn't last for very long."
    } ]
  }, {
    "tStartMs": 1072140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It's only a few minutes\nafter the animal comes out"
    } ]
  }, {
    "tStartMs": 1074450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "of the magnet."
    } ]
  }, {
    "tStartMs": 1076370,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- So how do you actually make"
    } ]
  }, {
    "tStartMs": 1078020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the world's strongest magnet?"
    } ]
  }, {
    "tStartMs": 1080300,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Contrary to what I expected,"
    } ]
  }, {
    "tStartMs": 1081860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "you can't do it just with\nsuperconducting magnets alone."
    } ]
  }, {
    "tStartMs": 1085280,
    "dDurationMs": 2285,
    "segs": [ {
      "utf8": "- The highest magnetic\nfield you could generate"
    } ]
  }, {
    "tStartMs": 1087565,
    "dDurationMs": 3655,
    "segs": [ {
      "utf8": "with superconducting wire\nwas nominally 20 Tesla."
    } ]
  }, {
    "tStartMs": 1091220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- That's because\nsuperconductors have a limit"
    } ]
  }, {
    "tStartMs": 1093560,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to the amount of magnetic\nfield they can withstand"
    } ]
  }, {
    "tStartMs": 1096050,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "before they're no longer superconducting."
    } ]
  }, {
    "tStartMs": 1098600,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So the solution is to combine an outer"
    } ]
  }, {
    "tStartMs": 1101120,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "superconducting electromagnet"
    } ]
  }, {
    "tStartMs": 1103010,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "with an inner electromagnet\nmade of ordinary wire."
    } ]
  }, {
    "tStartMs": 1106610,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "- So the blue, green,\nand salmon colored bits,"
    } ]
  }, {
    "tStartMs": 1110210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that's the superconducting outsert."
    } ]
  }, {
    "tStartMs": 1112070,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "That produces 11.5 Tesla."
    } ]
  }, {
    "tStartMs": 1114890,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Inside of that, we put a resistive magnet"
    } ]
  }, {
    "tStartMs": 1117950,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "that produces 33 and a half Tesla."
    } ]
  }, {
    "tStartMs": 1119720,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Maxwell's equations, fields\nadd, we get 45 Tesla."
    } ]
  }, {
    "tStartMs": 1123620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- But making high field magnets"
    } ]
  }, {
    "tStartMs": 1125450,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "with ordinary resistive\nwire is really hard"
    } ]
  }, {
    "tStartMs": 1128870,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- For a wire wound magnet,\nlike a junkyard magnet,"
    } ]
  }, {
    "tStartMs": 1132380,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "a traditional electromagnet,"
    } ]
  }, {
    "tStartMs": 1134210,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "the highest magnetic field you\ncan get is about two Tesla."
    } ]
  }, {
    "tStartMs": 1137810,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And the reason is that\nyou cannot get the heat"
    } ]
  }, {
    "tStartMs": 1141530,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "out of the innermost windings."
    } ]
  }, {
    "tStartMs": 1143000,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So back in the 1950s,\nFrancis Bitter, up at MIT,"
    } ]
  }, {
    "tStartMs": 1146450,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "he realized that physics doesn't care"
    } ]
  }, {
    "tStartMs": 1149540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "what shape the conductor is."
    } ]
  }, {
    "tStartMs": 1151070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "You can take your round wire"
    } ]
  }, {
    "tStartMs": 1152780,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and smash it into a very thin plate."
    } ]
  }, {
    "tStartMs": 1154970,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "If you then stack those plates\nwith alternating insulators,"
    } ]
  }, {
    "tStartMs": 1160370,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "you make a helix, that\nelectrically looks just like that."
    } ]
  }, {
    "tStartMs": 1164660,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "But now I can push cooling water axially"
    } ]
  }, {
    "tStartMs": 1168320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "through the stack of conductor."
    } ]
  }, {
    "tStartMs": 1170060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So that means that innermost part,"
    } ]
  }, {
    "tStartMs": 1172040,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I can now pull all that heat away,"
    } ]
  }, {
    "tStartMs": 1173750,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which means I can go to\nmuch, much, much, much,"
    } ]
  }, {
    "tStartMs": 1175670,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "much higher currents through these coils"
    } ]
  }, {
    "tStartMs": 1179060,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "up to 57,000 amps than what you can do"
    } ]
  }, {
    "tStartMs": 1182360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with a traditional wire\nround electromagnet."
    } ]
  }, {
    "tStartMs": 1184430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- And that gives you 34 Tesla, that?"
    } ]
  }, {
    "tStartMs": 1186590,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- That gives you 33.5,\nbut it's stacked up."
    } ]
  }, {
    "tStartMs": 1189500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So we stack all of these\nup in a stacking jig."
    } ]
  }, {
    "tStartMs": 1192350,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They're aligned up with tie rods."
    } ]
  }, {
    "tStartMs": 1194330,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "We then put about 20 tons of force on it"
    } ]
  }, {
    "tStartMs": 1196610,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and then lock those tie rods down"
    } ]
  }, {
    "tStartMs": 1198440,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and that holds the coil together"
    } ]
  }, {
    "tStartMs": 1200180,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and it gives us our electrical\nconnection between each turn."
    } ]
  }, {
    "tStartMs": 1203630,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And we're pushing, you know,"
    } ]
  }, {
    "tStartMs": 1205250,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "several thousand gallons per minute"
    } ]
  }, {
    "tStartMs": 1206900,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "of deionized water through\nthose coils to keep them cold"
    } ]
  }, {
    "tStartMs": 1210380,
    "dDurationMs": 2848,
    "segs": [ {
      "utf8": "'cause otherwise it melts and you're done."
    } ]
  }, {
    "tStartMs": 1213228,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "Occasionally you get material failure"
    } ]
  }, {
    "tStartMs": 1216170,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "that happens when the material\ngoes past its plastic limit"
    } ]
  }, {
    "tStartMs": 1219920,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and starts flexing either\ninto the coil next to it"
    } ]
  }, {
    "tStartMs": 1223610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "or maybe even shorting to ground."
    } ]
  }, {
    "tStartMs": 1225380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And this is what happened here."
    } ]
  }, {
    "tStartMs": 1227390,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The coil plastically failed,"
    } ]
  }, {
    "tStartMs": 1229160,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "meaning the metal went beyond\nits springy characteristics,"
    } ]
  }, {
    "tStartMs": 1232400,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "where it would come back,"
    } ]
  }, {
    "tStartMs": 1233570,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and it just completely deformed,"
    } ]
  }, {
    "tStartMs": 1235370,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "which drove it into the coil next to it,"
    } ]
  }, {
    "tStartMs": 1239810,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "burned through the insulator,"
    } ]
  }, {
    "tStartMs": 1241910,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and then vaporized all of this metal."
    } ]
  }, {
    "tStartMs": 1245030,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "And you can see more on the inside."
    } ]
  }, {
    "tStartMs": 1248060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "It killed this coil, which is the B coil."
    } ]
  }, {
    "tStartMs": 1250790,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But because it failed on the inner edge,"
    } ]
  }, {
    "tStartMs": 1253100,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "it killed the A coil."
    } ]
  }, {
    "tStartMs": 1254180,
    "dDurationMs": 3172,
    "segs": [ {
      "utf8": "Failed on the outer edge,\nit also killed the C coil."
    } ]
  }, {
    "tStartMs": 1257352,
    "dDurationMs": 2528,
    "segs": [ {
      "utf8": "So that was an expensive failure."
    } ]
  }, {
    "tStartMs": 1259880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- Expensive failure.\n- Yeah. Yeah."
    } ]
  }, {
    "tStartMs": 1262580,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "The record is the highest\ncontinuous magnetic field"
    } ]
  }, {
    "tStartMs": 1264670,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "in the world, period."
    } ]
  }, {
    "tStartMs": 1266390,
    "dDurationMs": 3023,
    "segs": [ {
      "utf8": "China recently commissioned\ntheir 45 Tesla hybrid,"
    } ]
  }, {
    "tStartMs": 1269413,
    "dDurationMs": 2437,
    "segs": [ {
      "utf8": "very similar in concept to ours."
    } ]
  }, {
    "tStartMs": 1271850,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So now there's two of them in the world."
    } ]
  }, {
    "tStartMs": 1273860,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- Running the strongest\nmagnets on the planet"
    } ]
  }, {
    "tStartMs": 1276020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "takes a lot of energy."
    } ]
  }, {
    "tStartMs": 1278180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The Mag Lab uses a significant fraction"
    } ]
  }, {
    "tStartMs": 1280700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of Tallahassee's electricity."
    } ]
  }, {
    "tStartMs": 1282500,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- So we can consume with\nall four power supplies"
    } ]
  }, {
    "tStartMs": 1286070,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "at full blast about 8% of their\ntotal generating capacity."
    } ]
  }, {
    "tStartMs": 1289970,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- What's the electricity\nbudget of this place?"
    } ]
  }, {
    "tStartMs": 1292670,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- So nominal $250 to $300,000 a month."
    } ]
  }, {
    "tStartMs": 1296390,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- Holy, yeah, that's a lot.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1298280,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So we operate in their\nfederally mandated reserve,"
    } ]
  }, {
    "tStartMs": 1301790,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which every utility has to have."
    } ]
  }, {
    "tStartMs": 1303830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "They have to have that available"
    } ]
  }, {
    "tStartMs": 1305090,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to push into the grid\nif there's a problem."
    } ]
  }, {
    "tStartMs": 1307100,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "We have a deal set up with the city"
    } ]
  }, {
    "tStartMs": 1309260,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so that they can actually\nmake money off that power"
    } ]
  }, {
    "tStartMs": 1312560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that they have to produce,\nbut which they can't sell."
    } ]
  }, {
    "tStartMs": 1315080,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The flip side is, when\nthey need it, we ramp down,"
    } ]
  }, {
    "tStartMs": 1317870,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and we can go down much faster"
    } ]
  }, {
    "tStartMs": 1319340,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "than they can spin up a Genny."
    } ]
  }, {
    "tStartMs": 1321110,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Why do you need 45 Tesla?"
    } ]
  }, {
    "tStartMs": 1323090,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- There are a couple things\nthat drive material discovery."
    } ]
  }, {
    "tStartMs": 1325850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "One of them is just\ngrowing a new material."
    } ]
  }, {
    "tStartMs": 1328280,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The other one is putting it\nin an extreme environment,"
    } ]
  }, {
    "tStartMs": 1332060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "like high magnetic field,"
    } ]
  }, {
    "tStartMs": 1333440,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "high electric field, high pressure,"
    } ]
  }, {
    "tStartMs": 1335570,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "ultra low temperature.\n- Low temperature."
    } ]
  }, {
    "tStartMs": 1337310,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "- Another axis is taking\nan existing material"
    } ]
  }, {
    "tStartMs": 1340970,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and improving its cleanliness."
    } ]
  }, {
    "tStartMs": 1343790,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So getting all the impurities out."
    } ]
  }, {
    "tStartMs": 1345890,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So as you drop the\nimpurities in the material,"
    } ]
  }, {
    "tStartMs": 1349190,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "you're reducing where the\nelectrons scatter from in there."
    } ]
  }, {
    "tStartMs": 1353090,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And that improves the properties,"
    } ]
  }, {
    "tStartMs": 1355250,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "enables you to see things\nthat you were never able"
    } ]
  }, {
    "tStartMs": 1357290,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "to see before."
    } ]
  }, {
    "tStartMs": 1358220,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "We've only just barely\nscratched the surface"
    } ]
  }, {
    "tStartMs": 1361610,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "on what can be done with this."
    } ]
  }, {
    "tStartMs": 1363110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "People are gonna look back\nabout 25 years from now"
    } ]
  }, {
    "tStartMs": 1366050,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and this will be the inflection point,"
    } ]
