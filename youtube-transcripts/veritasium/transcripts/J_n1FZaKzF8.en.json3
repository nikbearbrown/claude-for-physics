{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 101,
    "dDurationMs": 3439,
    "segs": [ {
      "utf8": "This is the biggest, most ambitious,"
    } ]
  }, {
    "tStartMs": 3540,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "most expensive video I've ever made."
    } ]
  }, {
    "tStartMs": 5250,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And it's also gonna be terrifying."
    } ]
  }, {
    "tStartMs": 7770,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We are strapping these giant metal weights"
    } ]
  }, {
    "tStartMs": 9810,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to the belly of that helicopter,"
    } ]
  }, {
    "tStartMs": 11970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "flying it up several kilometers in the sky"
    } ]
  }, {
    "tStartMs": 13770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and then dropping these weights,"
    } ]
  }, {
    "tStartMs": 16110,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "on a sandcastle city."
    } ]
  }, {
    "tStartMs": 20430,
    "dDurationMs": 1865,
    "segs": [ {
      "utf8": "I mean, we need luck."
    } ]
  }, {
    "tStartMs": 22295,
    "dDurationMs": 2873,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 25168,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "Here we go."
    } ]
  }, {
    "tStartMs": 26467,
    "dDurationMs": 555,
    "segs": [ {
      "utf8": "- Oh my."
    } ]
  }, {
    "tStartMs": 28523,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "YEAH!"
    } ]
  }, {
    "tStartMs": 32880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And this is all for a very good reason."
    } ]
  }, {
    "tStartMs": 35400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So let's do it. Come on."
    } ]
  }, {
    "tStartMs": 42177,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "In the late 1950s, the\nUnited States had a problem."
    } ]
  }, {
    "tStartMs": 45900,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The Soviet Union launched the\nfirst artificial satellite,"
    } ]
  }, {
    "tStartMs": 49140,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Sputnik, into orbit around the earth"
    } ]
  }, {
    "tStartMs": 51330,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "on the 4th of October, 1957,"
    } ]
  }, {
    "tStartMs": 54390,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "but less well known is that\njust over a month earlier,"
    } ]
  }, {
    "tStartMs": 57510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "they successfully tested the first"
    } ]
  }, {
    "tStartMs": 59460,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "intercontinental\nballistic missile or ICBM."
    } ]
  }, {
    "tStartMs": 63480,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "It could deliver a nuclear\nwarhead from the Soviet Union"
    } ]
  }, {
    "tStartMs": 66330,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "to cities on the US East\nCoast, in around 30 minutes."
    } ]
  }, {
    "tStartMs": 73140,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Facing this threat, a researcher at Boeing"
    } ]
  }, {
    "tStartMs": 75570,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "named Jerry Pournelle came up with an idea"
    } ]
  }, {
    "tStartMs": 77940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "for a space weapon."
    } ]
  }, {
    "tStartMs": 79530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It could hit any location on Earth"
    } ]
  }, {
    "tStartMs": 81600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "in half that time, just 15 minutes."
    } ]
  }, {
    "tStartMs": 84900,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It could destroy targets\nburied 30 meters underground"
    } ]
  }, {
    "tStartMs": 87810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "like the silos where the\nSoviet nukes were kept."
    } ]
  }, {
    "tStartMs": 90420,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "And theoretically it could\nintercept ICBM's mid-flight."
    } ]
  }, {
    "tStartMs": 97890,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "His concept was to put\ntelephone pole sized"
    } ]
  }, {
    "tStartMs": 101610,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "pieces of tungsten in space,"
    } ]
  }, {
    "tStartMs": 105480,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in orbit."
    } ]
  }, {
    "tStartMs": 107790,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So that these pieces of tungsten"
    } ]
  }, {
    "tStartMs": 110460,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "could drop on a target\nbasically at any time."
    } ]
  }, {
    "tStartMs": 113250,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The idea was within a 15 minute window"
    } ]
  }, {
    "tStartMs": 116430,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "you would be able to release\none of these tungsten rods"
    } ]
  }, {
    "tStartMs": 119730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and have it re-enter the atmosphere"
    } ]
  }, {
    "tStartMs": 121620,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and strike a target in minutes."
    } ]
  }, {
    "tStartMs": 124410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And it would come in so fast, you know,"
    } ]
  }, {
    "tStartMs": 126720,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "in orbit things go about\neight kilometers per second,"
    } ]
  }, {
    "tStartMs": 130920,
    "dDurationMs": 2727,
    "segs": [ {
      "utf8": "and as it enters the\natmosphere, it's gonna slow down"
    } ]
  }, {
    "tStartMs": 133647,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "due to the atmospheric drag,"
    } ]
  }, {
    "tStartMs": 135420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but still on impact it's\nstill gonna be going"
    } ]
  }, {
    "tStartMs": 137880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "like 10 times the speed of sound."
    } ]
  }, {
    "tStartMs": 139830,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "Mach 10 or about three\nkilometers per second."
    } ]
  }, {
    "tStartMs": 147780,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "This is MOAB, which stands for\nmassive ordinance air blast"
    } ]
  }, {
    "tStartMs": 152520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but it's more commonly\nreferred to by its nickname"
    } ]
  }, {
    "tStartMs": 155310,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the Mother of All Bombs."
    } ]
  }, {
    "tStartMs": 157800,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It is one of the most powerful"
    } ]
  }, {
    "tStartMs": 159360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "non-nuclear explosives on the planet."
    } ]
  }, {
    "tStartMs": 162240,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "When it detonated, it\nreleased the equivalent"
    } ]
  }, {
    "tStartMs": 164310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of 11 tons of TNT."
    } ]
  }, {
    "tStartMs": 166980,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Now, just one of these\ntungsten rods coming in"
    } ]
  }, {
    "tStartMs": 170070,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "would have the same energy"
    } ]
  }, {
    "tStartMs": 172170,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "as the largest conventional\nexplosive ever detonated."
    } ]
  }, {
    "tStartMs": 176670,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "They are not bombs, they\ncontain no explosives"
    } ]
  }, {
    "tStartMs": 180840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but the amount of energy\nthat they're carrying"
    } ]
  }, {
    "tStartMs": 183240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "in their kinetic energy\nbecause they are so heavy"
    } ]
  }, {
    "tStartMs": 186150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and they're going so fast"
    } ]
  }, {
    "tStartMs": 187710,
    "dDurationMs": 4353,
    "segs": [ {
      "utf8": "it is as big as any conventional\nbomb ever detonated."
    } ]
  }, {
    "tStartMs": 195960,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Pournelle called his weapon Project Thor"
    } ]
  }, {
    "tStartMs": 198510,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "after the Norse God who threw"
    } ]
  }, {
    "tStartMs": 199830,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "lightning bolts from the heavens."
    } ]
  }, {
    "tStartMs": 201840,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "In the 1980s the kinetic\nmissile interceptor idea"
    } ]
  }, {
    "tStartMs": 205380,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "was seriously considered by\nthe Reagan administration."
    } ]
  }, {
    "tStartMs": 208710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "It was codenamed, Brilliant Pebbles"
    } ]
  }, {
    "tStartMs": 211230,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but the project was abandoned."
    } ]
  }, {
    "tStartMs": 213690,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "In 2003 it was resurrected by the"
    } ]
  }, {
    "tStartMs": 215790,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Air Force Transformation Plan"
    } ]
  }, {
    "tStartMs": 217620,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "which referred to this weapon\nas hypervelocity rod bundles."
    } ]
  }, {
    "tStartMs": 222000,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "But colloquially, the weapon\nis known as Rods from God."
    } ]
  }, {
    "tStartMs": 228570,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The kinetic energy of an\nobject is directly proportional"
    } ]
  }, {
    "tStartMs": 231420,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to its mass and its velocity squared."
    } ]
  }, {
    "tStartMs": 234270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So increasing the objects mass 10 times,"
    } ]
  }, {
    "tStartMs": 236790,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "increases its kinetic energy 10 times."
    } ]
  }, {
    "tStartMs": 239730,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But if you increase the\nvelocity by a factor of 10"
    } ]
  }, {
    "tStartMs": 242760,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "the kinetic energy grows\nby a factor of a hundred."
    } ]
  }, {
    "tStartMs": 246090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is why even very light objects"
    } ]
  }, {
    "tStartMs": 248070,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "can carry lots of kinetic energy."
    } ]
  }, {
    "tStartMs": 251100,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "This is what a 15 gram piece of plastic"
    } ]
  }, {
    "tStartMs": 253950,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "does to a block of aluminum"
    } ]
  }, {
    "tStartMs": 255810,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "when traveling at six\nkilometers per second."
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And this is a real problem for satellites"
    } ]
  }, {
    "tStartMs": 262410,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "because of the massive speeds on orbit,"
    } ]
  }, {
    "tStartMs": 265320,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "micro meteorites, small\nbolts, or even flecks of paint"
    } ]
  }, {
    "tStartMs": 268950,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "are serious risks for the astronauts"
    } ]
  }, {
    "tStartMs": 271080,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "living onboard the\nInternational Space Station."
    } ]
  }, {
    "tStartMs": 274290,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This chip in the window of the ISS"
    } ]
  }, {
    "tStartMs": 276660,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "was caused by a tiny speck of dust."
    } ]
  }, {
    "tStartMs": 279780,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And a small piece of space junk"
    } ]
  }, {
    "tStartMs": 281880,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "punctured a hole in the robotic arm."
    } ]
  }, {
    "tStartMs": 285030,
    "dDurationMs": 3813,
    "segs": [ {
      "utf8": "Imagine something that weighs\n10 tons traveling that fast."
    } ]
  }, {
    "tStartMs": 289710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Kinetic energy weapons appear in fiction"
    } ]
  }, {
    "tStartMs": 292080,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "including dozens of movies,\nvideo games and books."
    } ]
  }, {
    "tStartMs": 296100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But how realistic are they?"
    } ]
  }, {
    "tStartMs": 298350,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I mean, could this weapon\never become a reality?"
    } ]
  }, {
    "tStartMs": 301950,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Well, that's why we're here\nin the middle of the desert."
    } ]
  }, {
    "tStartMs": 304740,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "We wanna see how damaging\na Rod from God could be."
    } ]
  }, {
    "tStartMs": 309060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And we really pulled out all the stops,"
    } ]
  }, {
    "tStartMs": 310860,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "even hiring a team of\nprofessional sandcastle builders"
    } ]
  }, {
    "tStartMs": 313770,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "to construct a city onto\nwhich we'll drop the rods."
    } ]
  }, {
    "tStartMs": 321270,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "I have all the respect in the world,"
    } ]
  }, {
    "tStartMs": 323467,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "for these sandcastle builders."
    } ]
  }, {
    "tStartMs": 330090,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "- We are seven time US\nOpen Sand Castle Champions."
    } ]
  }, {
    "tStartMs": 334530,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- That's so cool."
    } ]
  }, {
    "tStartMs": 337830,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It'll endure the test\nof the highest weight"
    } ]
  }, {
    "tStartMs": 340920,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "at the highest drop\nwith very little damage."
    } ]
  }, {
    "tStartMs": 344100,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "I'm really convinced of that."
    } ]
  }, {
    "tStartMs": 348000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- The US Capital was great."
    } ]
  }, {
    "tStartMs": 349230,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Yeah, isn't that great?\n- Yeah."
    } ]
  }, {
    "tStartMs": 350430,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It's one of our favorite."
    } ]
  }, {
    "tStartMs": 351263,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "- I love all the buildings there."
    } ]
  }, {
    "tStartMs": 352290,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Who did the pickle?"
    } ]
  }, {
    "tStartMs": 353160,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "The Gherkin?"
    } ]
  }, {
    "tStartMs": 353993,
    "dDurationMs": 1207,
    "segs": [ {
      "utf8": "- Yeah, the Gherkin right here."
    } ]
  }, {
    "tStartMs": 355200,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Very nice."
    } ]
  }, {
    "tStartMs": 356040,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "This is beautiful."
    } ]
  }, {
    "tStartMs": 356880,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "I mean, I feel bad for trying to hit it."
    } ]
  }, {
    "tStartMs": 365310,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "I am just very concerned about aiming,"
    } ]
  }, {
    "tStartMs": 368460,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "the city is not that big."
    } ]
  }, {
    "tStartMs": 369900,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So before we get to that drop"
    } ]
  }, {
    "tStartMs": 371730,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "we're gonna try to hit this swimming pool"
    } ]
  }, {
    "tStartMs": 375180,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "with a 100 kilogram or a 220 pound mass."
    } ]
  }, {
    "tStartMs": 380010,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Probably go up about 500 meters."
    } ]
  }, {
    "tStartMs": 382560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Try to drop a weight right into this pool."
    } ]
  }, {
    "tStartMs": 385500,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "I don't think it's gonna work."
    } ]
  }, {
    "tStartMs": 386490,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I don't think we're gonna hit it."
    } ]
  }, {
    "tStartMs": 387600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "In fact, my main concern for the whole day"
    } ]
  }, {
    "tStartMs": 389280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "is that we're just not gonna\nbe able to hit anything."
    } ]
  }, {
    "tStartMs": 391890,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "And then what was the point"
    } ]
  }, {
    "tStartMs": 392760,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "in coming out here in the first place?"
    } ]
  }, {
    "tStartMs": 395070,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "These are gonna be the\nquestions that I ask myself."
    } ]
  }, {
    "tStartMs": 398040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So the way we're targeting is with GPS,"
    } ]
  }, {
    "tStartMs": 400980,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "we're gonna take a GPS mark"
    } ]
  }, {
    "tStartMs": 402690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "from like the center of the pool."
    } ]
  }, {
    "tStartMs": 404730,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 405660,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "We've also got GPS in the helicopter."
    } ]
  }, {
    "tStartMs": 409020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We're gonna use that to\ntry to line up square"
    } ]
  }, {
    "tStartMs": 411420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "over the middle of the pool."
    } ]
  }, {
    "tStartMs": 414270,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So if we're able to hit\nthis pool from 500 meters"
    } ]
  }, {
    "tStartMs": 417600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "then I think we've got a shot."
    } ]
  }, {
    "tStartMs": 420886,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 427320,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Where's your GPS?"
    } ]
  }, {
    "tStartMs": 428490,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- My GPS is my phone."
    } ]
  }, {
    "tStartMs": 429900,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And I have the coordinates\nwritten on my arm."
    } ]
  }, {
    "tStartMs": 432360,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "We're ready to go."
    } ]
  }, {
    "tStartMs": 433200,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "We're professionals"
    } ]
  }, {
    "tStartMs": 441750,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "- First drop and it's feeling\nshaky I gotta tell you."
    } ]
  }, {
    "tStartMs": 449370,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "I'm surprised it can\npull a load that heavy!"
    } ]
  }, {
    "tStartMs": 460886,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "- We've got another\n700 feet to be at 1500."
    } ]
  }, {
    "tStartMs": 464073,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 466813,
    "dDurationMs": 3677,
    "segs": [ {
      "utf8": "- I just dunno like why\nthey're circling up that high."
    } ]
  }, {
    "tStartMs": 470490,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Is that 500 meters?"
    } ]
  }, {
    "tStartMs": 471450,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "That seems really high."
    } ]
  }, {
    "tStartMs": 475590,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "- Ryan to Rick, what's your altitude?"
    } ]
  }, {
    "tStartMs": 478576,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- 500 meters."
    } ]
  }, {
    "tStartMs": 481200,
    "dDurationMs": 2507,
    "segs": [ {
      "utf8": "- We're 1500 feet, that\nseems higher than 1500 feet."
    } ]
  }, {
    "tStartMs": 483707,
    "dDurationMs": 1243,
    "segs": [ {
      "utf8": "- They're at 500 meters right now."
    } ]
  }, {
    "tStartMs": 484950,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- That is freaking crazy, okay."
    } ]
  }, {
    "tStartMs": 486780,
    "dDurationMs": 1842,
    "segs": [ {
      "utf8": "- Here we go. This is the one."
    } ]
  }, {
    "tStartMs": 488622,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- This is the one."
    } ]
  }, {
    "tStartMs": 493530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- It's swinging around\nlike crazy up there!"
    } ]
  }, {
    "tStartMs": 495450,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Yeah. Does it have fins on it?"
    } ]
  }, {
    "tStartMs": 496800,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Jesus. No. No fins."
    } ]
  }, {
    "tStartMs": 498570,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Why didn't we have this\nconversation a week ago?"
    } ]
  }, {
    "tStartMs": 501750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Looking good?"
    } ]
  }, {
    "tStartMs": 502950,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- We're good left to right. That's good."
    } ]
  }, {
    "tStartMs": 504480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We just need to go forward."
    } ]
  }, {
    "tStartMs": 508140,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Oh geez."
    } ]
  }, {
    "tStartMs": 509040,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "That does not look like\nthey're in position, right?"
    } ]
  }, {
    "tStartMs": 511290,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Are you kidding me?"
    } ]
  }, {
    "tStartMs": 512123,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- It never will."
    } ]
  }, {
    "tStartMs": 515730,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Its dropped."
    } ]
  }, {
    "tStartMs": 517860,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "- Oh my."
    } ]
  }, {
    "tStartMs": 520050,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "What the? What is that gonna hit?"
    } ]
  }, {
    "tStartMs": 523530,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "Oh, it is going sideways."
    } ]
  }, {
    "tStartMs": 526260,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "What did it hit?"
    } ]
  }, {
    "tStartMs": 528420,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Way past the sandcastle."
    } ]
  }, {
    "tStartMs": 529560,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Oh geez."
    } ]
  }, {
    "tStartMs": 530460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "That was way more off than I thought."
    } ]
  }, {
    "tStartMs": 532320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Oh my God."
    } ]
  }, {
    "tStartMs": 534060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- I was right on."
    } ]
  }, {
    "tStartMs": 535410,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Was yours showing the\nsame thing back there?"
    } ]
  }, {
    "tStartMs": 537000,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- Yeah, we were right on it."
    } ]
  }, {
    "tStartMs": 538230,
    "dDurationMs": 1062,
    "segs": [ {
      "utf8": "- Yeah. Good."
    } ]
  }, {
    "tStartMs": 539292,
    "dDurationMs": 1505,
    "segs": [ {
      "utf8": "Well that's kinda weird."
    } ]
  }, {
    "tStartMs": 540797,
    "dDurationMs": 3647,
    "segs": [ {
      "utf8": "That's just gonna show you\nwhat's gonna happen at altitude."
    } ]
  }, {
    "tStartMs": 544444,
    "dDurationMs": 2789,
    "segs": [ {
      "utf8": "We both said we were right\non it and we weren't."
    } ]
  }, {
    "tStartMs": 550230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- It didn't look like you\nguys were moving, but..."
    } ]
  }, {
    "tStartMs": 552270,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Yeah he's telling me our\nhorizontal velocity was zero."
    } ]
  }, {
    "tStartMs": 554970,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- And you were in the right spot?"
    } ]
  }, {
    "tStartMs": 556200,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- We were exactly in the right spot."
    } ]
  }, {
    "tStartMs": 558780,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "- Oh wow."
    } ]
  }, {
    "tStartMs": 560820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Oh wow!"
    } ]
  }, {
    "tStartMs": 562620,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Look at that."
    } ]
  }, {
    "tStartMs": 564300,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- Oh Wow."
    } ]
  }, {
    "tStartMs": 565530,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Totally, totally buried."
    } ]
  }, {
    "tStartMs": 567930,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Falling from 500 meters,"
    } ]
  }, {
    "tStartMs": 569670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "the rod accelerated for 10 seconds."
    } ]
  }, {
    "tStartMs": 572460,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And even accounting for air resistance"
    } ]
  }, {
    "tStartMs": 574470,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "it hit the ground going about\n350 kilometers per hour."
    } ]
  }, {
    "tStartMs": 578910,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "At that speed, with a mass\nof a hundred kilograms"
    } ]
  }, {
    "tStartMs": 581820,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "it was carrying nearly"
    } ]
  }, {
    "tStartMs": 582990,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "half a million joules of kinetic energy."
    } ]
  }, {
    "tStartMs": 586410,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Our plan for the day is to drop something"
    } ]
  }, {
    "tStartMs": 588360,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "twice as heavy from six times higher."
    } ]
  }, {
    "tStartMs": 591630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Then it's energy on impact will be greater"
    } ]
  }, {
    "tStartMs": 594180,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "than the explosion of a kilogram of TNT."
    } ]
  }, {
    "tStartMs": 598020,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "Kinetic impacts are explosive."
    } ]
  }, {
    "tStartMs": 602040,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "If you look at the craters on the moon"
    } ]
  }, {
    "tStartMs": 603870,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and you look really closely"
    } ]
  }, {
    "tStartMs": 605400,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "you're gonna see that they're\nbasically all circles."
    } ]
  }, {
    "tStartMs": 609030,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I think no one stops to\nask why are they circular?"
    } ]
  }, {
    "tStartMs": 612870,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "If you imagine when the\nmoon gets hit by asteroids"
    } ]
  }, {
    "tStartMs": 616440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "they're gonna come in from\nall different directions."
    } ]
  }, {
    "tStartMs": 618780,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So shouldn't you get these\nsort of oblong shapes"
    } ]
  }, {
    "tStartMs": 622170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "where the asteroid comes in?"
    } ]
  }, {
    "tStartMs": 624930,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Well, the truth is, the asteroids come in"
    } ]
  }, {
    "tStartMs": 626910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "with such incredible speed"
    } ]
  }, {
    "tStartMs": 628710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that it's not like they're\npushing dirt out of the way"
    } ]
  }, {
    "tStartMs": 631200,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and that's what creates the crater."
    } ]
  }, {
    "tStartMs": 632670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "No, they're coming in so fast"
    } ]
  }, {
    "tStartMs": 634530,
    "dDurationMs": 4738,
    "segs": [ {
      "utf8": "that when they collide their\nkinetic energy is explosive."
    } ]
  }, {
    "tStartMs": 639268,
    "dDurationMs": 4022,
    "segs": [ {
      "utf8": "It heats up the ground, turns\nthings into liquid and gas."
    } ]
  }, {
    "tStartMs": 643290,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "They all get super hot"
    } ]
  }, {
    "tStartMs": 644400,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and they spray outwards\nin a giant explosion."
    } ]
  }, {
    "tStartMs": 647970,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And this explosion is symmetric."
    } ]
  }, {
    "tStartMs": 649710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It doesn't matter which angle"
    } ]
  }, {
    "tStartMs": 651390,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "or how shallow the asteroid was coming in,"
    } ]
  }, {
    "tStartMs": 653910,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "it's gonna blow out everything radially"
    } ]
  }, {
    "tStartMs": 656160,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because it is explosive."
    } ]
  }, {
    "tStartMs": 658440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Kinetic energy is explosive."
    } ]
  }, {
    "tStartMs": 660270,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And I think for me, that's just\nthe really surprising thing."
    } ]
  }, {
    "tStartMs": 663330,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It would be the exact same thing"
    } ]
  }, {
    "tStartMs": 664650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "with dropping these rods going Mach 10,"
    } ]
  }, {
    "tStartMs": 667440,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "when they hit a target\nthey're gonna create"
    } ]
  }, {
    "tStartMs": 670530,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "an explosion as though\nthey are the largest"
    } ]
  }, {
    "tStartMs": 672690,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "conventional weapon ever launched."
    } ]
  }, {
    "tStartMs": 675810,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And because it's going so fast,"
    } ]
  }, {
    "tStartMs": 677490,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it can penetrate around 30 meters of soil,"
    } ]
  }, {
    "tStartMs": 680100,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "enough to bust bunkers or silos."
    } ]
  }, {
    "tStartMs": 682220,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And the explosion is\ntherefore more localized."
    } ]
  }, {
    "tStartMs": 685500,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So it can be used for\nprecise surgical strikes."
    } ]
  }, {
    "tStartMs": 689040,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Plus, unlike a nuclear weapon"
    } ]
  }, {
    "tStartMs": 690900,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "there's no radioactive\nfallout to worry about"
    } ]
  }, {
    "tStartMs": 693630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "or international laws."
    } ]
  }, {
    "tStartMs": 696480,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Do these ideas contravene\nany current laws or treaties?"
    } ]
  }, {
    "tStartMs": 701490,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- No. The only international\nagreement there is"
    } ]
  }, {
    "tStartMs": 703890,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "about putting weapons in space\nis about nuclear weapons."
    } ]
  }, {
    "tStartMs": 707250,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The only real prohibition is about"
    } ]
  }, {
    "tStartMs": 709140,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "putting nuclear weapons in space."
    } ]
  }, {
    "tStartMs": 713160,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- Man, like I thought\ntargets would be hard to hit."
    } ]
  }, {
    "tStartMs": 716430,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "Now I'm like super convinced\nthey're impossible to hit."
    } ]
  }, {
    "tStartMs": 720090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What we're gonna do now,"
    } ]
  }, {
    "tStartMs": 720923,
    "dDurationMs": 937,
    "segs": [ {
      "utf8": "we're gonna do a much lower altitude"
    } ]
  }, {
    "tStartMs": 721860,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and we're gonna do it visually."
    } ]
  }, {
    "tStartMs": 723390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah. Great."
    } ]
  }, {
    "tStartMs": 724223,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- So we're gonna do it, you\nknow, 300 feet visually."
    } ]
  }, {
    "tStartMs": 725640,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I love it."
    } ]
  }, {
    "tStartMs": 726473,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "We're gonna do a cube drop."
    } ]
  }, {
    "tStartMs": 727470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Cube drop, is interesting"
    } ]
  }, {
    "tStartMs": 729360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "cause I was like we\nshouldn't do a cube drop."
    } ]
  }, {
    "tStartMs": 731220,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "We're here talking about Rods from God."
    } ]
  }, {
    "tStartMs": 732900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "They're cylinders right?"
    } ]
  }, {
    "tStartMs": 734250,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Now I'm so thankful we have the cubes"
    } ]
  }, {
    "tStartMs": 736320,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "because the cylinders,\nas Adam Savage told me,"
    } ]
  }, {
    "tStartMs": 740910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Cylinders tend to fall on their sides,"
    } ]
  }, {
    "tStartMs": 742890,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "given enough chance."
    } ]
  }, {
    "tStartMs": 744030,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Really?"
    } ]
  }, {
    "tStartMs": 744863,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "Who would've thought I\nwould've thought like,"
    } ]
  }, {
    "tStartMs": 746400,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "you know, a pencil type thing,"
    } ]
  }, {
    "tStartMs": 748110,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "it would tend to aim straight down."
    } ]
  }, {
    "tStartMs": 754440,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "That still looks high."
    } ]
  }, {
    "tStartMs": 756870,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Is that a hundred meters?"
    } ]
  }, {
    "tStartMs": 757860,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Does that?"
    } ]
  }, {
    "tStartMs": 759240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "30 second call,"
    } ]
  }, {
    "tStartMs": 760770,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it doesn't look like\nthey're over the pool."
    } ]
  }, {
    "tStartMs": 763830,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "It's totally blowing around in the wind."
    } ]
  }, {
    "tStartMs": 767370,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "It's totally swinging."
    } ]
  }, {
    "tStartMs": 770460,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "- GPS is spot on and I see it right below."
    } ]
  }, {
    "tStartMs": 774990,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "- Still feels high."
    } ]
  }, {
    "tStartMs": 777510,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "- We're on it. We're on it."
    } ]
  }, {
    "tStartMs": 779594,
    "dDurationMs": 1225,
    "segs": [ {
      "utf8": "- Here we go."
    } ]
  }, {
    "tStartMs": 789630,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- All right."
    } ]
  }, {
    "tStartMs": 790920,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "That wasn't far off."
    } ]
  }, {
    "tStartMs": 793290,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- We're off by 60 feet."
    } ]
  }, {
    "tStartMs": 794910,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Yeah. Oh wow."
    } ]
  }, {
    "tStartMs": 795900,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Did it look like we were right above it?"
    } ]
  }, {
    "tStartMs": 798930,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Looked like it yeah."
    } ]
  }, {
    "tStartMs": 800070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 801450,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "'Cause I still was right on it as well."
    } ]
  }, {
    "tStartMs": 808770,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- That's something, from a hundred meters."
    } ]
  }, {
    "tStartMs": 811320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I'll take it."
    } ]
  }, {
    "tStartMs": 815040,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Okay, we're setting up to drop this mass."
    } ]
  }, {
    "tStartMs": 817770,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "200 kilograms, 440 pounds."
    } ]
  }, {
    "tStartMs": 821190,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "What do you think?"
    } ]
  }, {
    "tStartMs": 822270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, we're gonna get there."
    } ]
  }, {
    "tStartMs": 823103,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- Are we gonna hit it this time?"
    } ]
  }, {
    "tStartMs": 824520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I hope so."
    } ]
  }, {
    "tStartMs": 831450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is the moment of truth."
    } ]
  }, {
    "tStartMs": 833430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "We've had two misses so far."
    } ]
  }, {
    "tStartMs": 835800,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "So we're going 50 meters\nor 150 feet above the pool"
    } ]
  }, {
    "tStartMs": 839310,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "which for me it's pretty disappointing."
    } ]
  }, {
    "tStartMs": 842490,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "But at this point I just\nwant to hit something."
    } ]
  }, {
    "tStartMs": 851734,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "- 30 seconds! 30 seconds!"
    } ]
  }, {
    "tStartMs": 853788,
    "dDurationMs": 1392,
    "segs": [ {
      "utf8": "- Oh boy."
    } ]
  }, {
    "tStartMs": 855180,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "The weight is swinging around on there."
    } ]
  }, {
    "tStartMs": 858540,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "It's getting blown around by the wind."
    } ]
  }, {
    "tStartMs": 861690,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "I mean we need luck."
    } ]
  }, {
    "tStartMs": 875706,
    "dDurationMs": 1644,
    "segs": [ {
      "utf8": "There it goes, there\nit goes, there it goes."
    } ]
  }, {
    "tStartMs": 877350,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "I'm tracking, tracking."
    } ]
  }, {
    "tStartMs": 881576,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "Got a hit of the pool!"
    } ]
  }, {
    "tStartMs": 884269,
    "dDurationMs": 2858,
    "segs": [ {
      "utf8": "- (screaming) Yes!"
    } ]
  }, {
    "tStartMs": 887127,
    "dDurationMs": 1463,
    "segs": [ {
      "utf8": "(crew all cheer)"
    } ]
  }, {
    "tStartMs": 888590,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- It hit something."
    } ]
  }, {
    "tStartMs": 890110,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "- Yes!"
    } ]
  }, {
    "tStartMs": 892200,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- It was like right on the edge."
    } ]
  }, {
    "tStartMs": 893940,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Right on the edge."
    } ]
  }, {
    "tStartMs": 896533,
    "dDurationMs": 1037,
    "segs": [ {
      "utf8": "- WOO!"
    } ]
  }, {
    "tStartMs": 897570,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- This morning I was so worried"
    } ]
  }, {
    "tStartMs": 898890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "that we weren't going to hit anything."
    } ]
  }, {
    "tStartMs": 900300,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And like I think the footage is so shaky"
    } ]
  }, {
    "tStartMs": 902250,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "cause I was so excited."
    } ]
  }, {
    "tStartMs": 903180,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "But like seeing that\nfrom above was amazing."
    } ]
  }, {
    "tStartMs": 908280,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "- Wow. It ripped right through the pool."
    } ]
  }, {
    "tStartMs": 911850,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- That's crazy."
    } ]
  }, {
    "tStartMs": 912900,
    "dDurationMs": 911,
    "segs": [ {
      "utf8": "- Unbelievable."
    } ]
  }, {
    "tStartMs": 913811,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "- Oh, look at the rubber duckies."
    } ]
  }, {
    "tStartMs": 915677,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "- So, is the next target, the sandcastle?"
    } ]
  }, {
    "tStartMs": 917880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And you wanna go for a hundred meters?"
    } ]
  }, {
    "tStartMs": 919560,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- I wanna double it."
    } ]
  }, {
    "tStartMs": 921030,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- This will be amazing"
    } ]
  }, {
    "tStartMs": 922020,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "if we can actually hit the\nsandcastle from a hundred meters."
    } ]
  }, {
    "tStartMs": 925560,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That'll be something"
    } ]
  }, {
    "tStartMs": 927960,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In all the different\nincarnations of Rods from God."
    } ]
  }, {
    "tStartMs": 931320,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The rods are made out of tungsten."
    } ]
  }, {
    "tStartMs": 934380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And there are two reasons for this."
    } ]
  }, {
    "tStartMs": 936120,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The first is that tungsten\nis really, really dense."
    } ]
  }, {
    "tStartMs": 939780,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "A cubic meter of tungsten weighs 19 tons."
    } ]
  }, {
    "tStartMs": 943110,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "That's over twice the density of steel"
    } ]
  }, {
    "tStartMs": 945360,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which is what we're using here"
    } ]
  }, {
    "tStartMs": 946890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "just because it's a lot cheaper."
    } ]
  }, {
    "tStartMs": 948810,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But that means for a given amount of mass"
    } ]
  }, {
    "tStartMs": 951210,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "tungsten rods could be less\nthan half the volume of steel"
    } ]
  }, {
    "tStartMs": 954780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and therefore encounter less resistance"
    } ]
  }, {
    "tStartMs": 956490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "as they pass through the atmosphere."
    } ]
  }, {
    "tStartMs": 958860,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And importantly for re-entry,"
    } ]
  }, {
    "tStartMs": 960630,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "tungsten also has an\nincredibly high melting point."
    } ]
  }, {
    "tStartMs": 963900,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The highest of any metal,"
    } ]
  }, {
    "tStartMs": 965520,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "at almost three and a half\nthousand degrees celsius."
    } ]
  }, {
    "tStartMs": 968790,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This is important because\nas the rod decelerates"
    } ]
  }, {
    "tStartMs": 971550,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "through the atmosphere"
    } ]
  }, {
    "tStartMs": 972630,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "a lot of heat builds up all around it."
    } ]
  }, {
    "tStartMs": 975420,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And tungsten's high melting point"
    } ]
  }, {
    "tStartMs": 977310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "means the rods require much less shielding"
    } ]
  }, {
    "tStartMs": 979500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to prevent them from melting."
    } ]
  }, {
    "tStartMs": 981690,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The shape is also important."
    } ]
  }, {
    "tStartMs": 983610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The goal is to hit the target"
    } ]
  }, {
    "tStartMs": 985170,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with as much speed as possible."
    } ]
  }, {
    "tStartMs": 986850,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So a sleek, aerodynamic shape is best"
    } ]
  }, {
    "tStartMs": 989970,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and rods are a great shape for that."
    } ]
  }, {
    "tStartMs": 992100,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Aerodynamics is why arrows and bullets"
    } ]
  }, {
    "tStartMs": 994380,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and ballistic missiles\nall look the way they do."
    } ]
  }, {
    "tStartMs": 997020,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "It's to minimize drag."
    } ]
  }, {
    "tStartMs": 1000980,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Honestly one of the big mistakes we made"
    } ]
  }, {
    "tStartMs": 1002540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "was not welding fins onto our rods."
    } ]
  }, {
    "tStartMs": 1005210,
    "dDurationMs": 4353,
    "segs": [ {
      "utf8": "We're going up to about a\nhundred meters or 300 feet,"
    } ]
  }, {
    "tStartMs": 1010400,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "before we drop."
    } ]
  }, {
    "tStartMs": 1011750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We're gonna hit the sandcastle city."
    } ]
  }, {
    "tStartMs": 1013100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "That's the goal."
    } ]
  }, {
    "tStartMs": 1014690,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "- Any minute, any second."
    } ]
  }, {
    "tStartMs": 1021950,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- There it goes, there\nit goes, there it goes."
    } ]
  }, {
    "tStartMs": 1023510,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It's going."
    } ]
  }, {
    "tStartMs": 1025070,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "Did it hit in front?"
    } ]
  }, {
    "tStartMs": 1026291,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Just in font."
    } ]
  }, {
    "tStartMs": 1027124,
    "dDurationMs": 1069,
    "segs": [ {
      "utf8": "- Hit just in front."
    } ]
  }, {
    "tStartMs": 1029131,
    "dDurationMs": 3284,
    "segs": [ {
      "utf8": "- We just missed it."
    } ]
  }, {
    "tStartMs": 1032415,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "- We were close."
    } ]
  }, {
    "tStartMs": 1033536,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "We were really close."
    } ]
  }, {
    "tStartMs": 1035206,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "So the tractor's gonna dig\nthe weight out right now."
    } ]
  }, {
    "tStartMs": 1036540,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Yeah.\n- Just pick it up."
    } ]
  }, {
    "tStartMs": 1040340,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- That's how it landed."
    } ]
  }, {
    "tStartMs": 1041810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- So close to taking out the capital."
    } ]
  }, {
    "tStartMs": 1043850,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Yeah. Look at that."
    } ]
  }, {
    "tStartMs": 1047570,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "- 30 seconds to drop."
    } ]
  }, {
    "tStartMs": 1051473,
    "dDurationMs": 1977,
    "segs": [ {
      "utf8": "- Ah, that wind."
    } ]
  }, {
    "tStartMs": 1053450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- 20 seconds."
    } ]
  }, {
    "tStartMs": 1054283,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "- 20 seconds."
    } ]
  }, {
    "tStartMs": 1055670,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "That wind is brutal."
    } ]
  }, {
    "tStartMs": 1058550,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 1059630,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 1060650,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh boy."
    } ]
  }, {
    "tStartMs": 1064490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Hit something on the left?"
    } ]
  }, {
    "tStartMs": 1066380,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "But I don't think it was the city."
    } ]
  }, {
    "tStartMs": 1071630,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Seeing all the challenges\nwe're going through reminds me"
    } ]
  }, {
    "tStartMs": 1074930,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "just how difficult it is to\naim a kinetic projectile."
    } ]
  }, {
    "tStartMs": 1080330,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "10 seconds."
    } ]
  }, {
    "tStartMs": 1083575,
    "dDurationMs": 4265,
    "segs": [ {
      "utf8": "- Three, two, one , and drop."
    } ]
  }, {
    "tStartMs": 1087840,
    "dDurationMs": 1193,
    "segs": [ {
      "utf8": "- There it goes."
    } ]
  }, {
    "tStartMs": 1092720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Did they hit a building?"
    } ]
  }, {
    "tStartMs": 1095990,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Capitol's still here."
    } ]
  }, {
    "tStartMs": 1097670,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 1099050,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "What?\n- What?"
    } ]
  }, {
    "tStartMs": 1101150,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "- I cannot believe it."
    } ]
  }, {
    "tStartMs": 1103490,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Direct hit on the building,"
    } ]
  }, {
    "tStartMs": 1105740,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but it only took down that side."
    } ]
  }, {
    "tStartMs": 1108800,
    "dDurationMs": 1382,
    "segs": [ {
      "utf8": "- I find it unbelievable,"
    } ]
  }, {
    "tStartMs": 1110182,
    "dDurationMs": 898,
    "segs": [ {
      "utf8": "that it hit right there\n- Look at the cracks."
    } ]
  }, {
    "tStartMs": 1111080,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- Look at the cracks in the back"
    } ]
  }, {
    "tStartMs": 1112700,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- and like it created cracks"
    } ]
  }, {
    "tStartMs": 1113990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but it didn't make the whole"
    } ]
  }, {
    "tStartMs": 1114823,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "- didn't destroy the whole building."
    } ]
  }, {
    "tStartMs": 1117590,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "This is not what you would use"
    } ]
  }, {
    "tStartMs": 1118880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "if you wanted to cause mass devastation."
    } ]
  }, {
    "tStartMs": 1120560,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "This is like if you wanted\nto pinpoint a target."
    } ]
  }, {
    "tStartMs": 1125930,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Now if I'm honest,"
    } ]
  }, {
    "tStartMs": 1127100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "we did not manage to make a\nfair test of Rods from God,"
    } ]
  }, {
    "tStartMs": 1129980,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "even on a small scale."
    } ]
  }, {
    "tStartMs": 1131870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You know I wanted to drop 200 kilograms"
    } ]
  }, {
    "tStartMs": 1134420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "from three kilometers."
    } ]
  }, {
    "tStartMs": 1136040,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But aiming was so hard that\nwe got nowhere near that."
    } ]
  }, {
    "tStartMs": 1139190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So we didn't get to\nsee the explosive power"
    } ]
  }, {
    "tStartMs": 1141650,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "of kinetic energy."
    } ]
  }, {
    "tStartMs": 1143210,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "When we made one last ditch attempt"
    } ]
  }, {
    "tStartMs": 1145400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to drop again from 500 meters."
    } ]
  }, {
    "tStartMs": 1147440,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I was just terrified\nthat we were gonna hit"
    } ]
  }, {
    "tStartMs": 1149210,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "something or someone."
    } ]
  }, {
    "tStartMs": 1152990,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Look out, look out, look out,"
    } ]
  }, {
    "tStartMs": 1155300,
    "dDurationMs": 1986,
    "segs": [ {
      "utf8": "look out, look out."
    } ]
  }, {
    "tStartMs": 1157286,
    "dDurationMs": 2124,
    "segs": [ {
      "utf8": "Oh!"
    } ]
  }, {
    "tStartMs": 1159410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh!"
    } ]
  }, {
    "tStartMs": 1161122,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Caw!"
    } ]
  }, {
    "tStartMs": 1165170,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I was just happy to finish\nthe day with everyone safe."
    } ]
  }, {
    "tStartMs": 1168440,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I didn't shoot that\ncause I was so terrified."
    } ]
  }, {
    "tStartMs": 1171020,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "Oh, I see it."
    } ]
  }, {
    "tStartMs": 1172880,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 1175160,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "You're right that it bounced out."
    } ]
  }, {
    "tStartMs": 1178340,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "But given the amount of time"
    } ]
  }, {
    "tStartMs": 1179750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and money we spent on this video"
    } ]
  }, {
    "tStartMs": 1181700,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I would say it is my\nbiggest failure of all time"
    } ]
  }, {
    "tStartMs": 1185540,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "which as it turns out,"
    } ]
  }, {
    "tStartMs": 1186530,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "is also something you could say"
    } ]
  }, {
    "tStartMs": 1187880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "about the actual weapon Rods from God."
    } ]
  }, {
    "tStartMs": 1190490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I mean, just start with aiming."
    } ]
  }, {
    "tStartMs": 1192530,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Steering a Rod from God\nis in theory possible"
    } ]
  }, {
    "tStartMs": 1195290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "you could use thrusters or adjustable fins"
    } ]
  }, {
    "tStartMs": 1198170,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "or change the rod's center of mass."
    } ]
  }, {
    "tStartMs": 1200720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But in practice it's incredibly\ndifficult to aim an object"
    } ]
  }, {
    "tStartMs": 1203840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "traveling at hypersonic speeds."
    } ]
  }, {
    "tStartMs": 1206450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Not only that, communicating with the rod"
    } ]
  }, {
    "tStartMs": 1208580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "from the ground or from space"
    } ]
  }, {
    "tStartMs": 1210320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "would be nearly impossible"
    } ]
  }, {
    "tStartMs": 1211730,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "due to the superheated\nplasma surrounding it."
    } ]
  }, {
    "tStartMs": 1214640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And there are other problems."
    } ]
  }, {
    "tStartMs": 1216560,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "You know, say you want to hit\na target within 15 minutes"
    } ]
  }, {
    "tStartMs": 1219590,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "you'd think the simplest\nthing would be to put a rod"
    } ]
  }, {
    "tStartMs": 1221720,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "right above the target\nin geostationary orbit."
    } ]
  }, {
    "tStartMs": 1225230,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "But geostationary orbit is\nover 35,000 kilometers away. "
    } ]
  }, {
    "tStartMs": 1229640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "That's almost a 10th the\ndistance to the moon."
    } ]
  }, {
    "tStartMs": 1232340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So from there a rod\nwould take several hours"
    } ]
  }, {
    "tStartMs": 1234980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to fall to the earth."
    } ]
  }, {
    "tStartMs": 1237020,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And if you put it in low earth orbit"
    } ]
  }, {
    "tStartMs": 1238910,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "say around 350 kilometers above the earth"
    } ]
  }, {
    "tStartMs": 1241310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the rod will move relative to the ground"
    } ]
  }, {
    "tStartMs": 1243620,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "doing a revolution around\nthe earth every 90 minutes."
    } ]
  }, {
    "tStartMs": 1246830,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So between ordering a strike\nand the rod hitting the target"
    } ]
  }, {
    "tStartMs": 1249770,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that could take anywhere\nup to an hour and a half."
    } ]
  }, {
    "tStartMs": 1252770,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Now you might think that\nyou could get that time"
    } ]
  }, {
    "tStartMs": 1254690,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "down to about 30 minutes"
    } ]
  }, {
    "tStartMs": 1255980,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "by placing say 10\nsatellites in that orbit."
    } ]
  }, {
    "tStartMs": 1259370,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "But remember, the earth\nrotates so orbits drift,"
    } ]
  }, {
    "tStartMs": 1263210,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "you would actually need\nhundreds of satellites"
    } ]
  }, {
    "tStartMs": 1265790,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "to make sure there's always\na rod close by the target."
    } ]
  }, {
    "tStartMs": 1269660,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "So let's say you want to put\na hundred rods into space."
    } ]
  }, {
    "tStartMs": 1272994,
    "dDurationMs": 3571,
    "segs": [ {
      "utf8": "Well, the cost of launching them\nwill be billions of dollars."
    } ]
  }, {
    "tStartMs": 1276565,
    "dDurationMs": 3505,
    "segs": [ {
      "utf8": "And over time the thrusters\nwill break down and malfunction."
    } ]
  }, {
    "tStartMs": 1280070,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So there are going to be\nongoing maintenance costs."
    } ]
  }, {
    "tStartMs": 1283640,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But what if you just want to\nuse it for missile defense?"
    } ]
  }, {
    "tStartMs": 1287180,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Well then you don't need\nsomething that weighs 10 tons,"
    } ]
  }, {
    "tStartMs": 1290060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "a smaller rod would do."
    } ]
  }, {
    "tStartMs": 1292040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But even then it's really, really tricky."
    } ]
  }, {
    "tStartMs": 1294980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And to successfully intercept an ICBM,"
    } ]
  }, {
    "tStartMs": 1297650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "you've gotta hit it\nduring the boost phase,"
    } ]
  }, {
    "tStartMs": 1300440,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "modern ICBMs split into a number\nof payloads after the boost"
    } ]
  }, {
    "tStartMs": 1304400,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "some of which are decoys to overwhelm"
    } ]
  }, {
    "tStartMs": 1307070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "anti ICBM defense missiles."
    } ]
  }, {
    "tStartMs": 1309860,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "To stop North Korean ICBM\nlaunches for example,"
    } ]
  }, {
    "tStartMs": 1312680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the US would need around 400 rods"
    } ]
  }, {
    "tStartMs": 1315350,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "spread among eight orbits"
    } ]
  }, {
    "tStartMs": 1317120,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to be able to intercept missiles in time."
    } ]
  }, {
    "tStartMs": 1319970,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "A global defense system"
    } ]
  }, {
    "tStartMs": 1321170,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "would require at least\na few times that amount."
    } ]
  }, {
    "tStartMs": 1324140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And it's been calculated that\neven a very limited system"
    } ]
  }, {
    "tStartMs": 1326930,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "would cost around 300 billion dollars,"
    } ]
  }, {
    "tStartMs": 1329750,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "which is nearly half of the\nUS military annual budget."
    } ]
  }, {
    "tStartMs": 1333860,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And even that wouldn't work"
    } ]
  }, {
    "tStartMs": 1335570,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "because enemies could evade the defense"
    } ]
  }, {
    "tStartMs": 1337100,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "by launching several\nmissiles at the same time."
    } ]
  }, {
    "tStartMs": 1340220,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Since there's only one rod"
    } ]
  }, {
    "tStartMs": 1341510,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "in the right location at any time,"
    } ]
  }, {
    "tStartMs": 1343400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "a rod could intercept one of the missiles"
    } ]
  }, {
    "tStartMs": 1345500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "but the rest would pass through."
    } ]
  }, {
    "tStartMs": 1348170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So Rods from God turns out to be"
    } ]
  }, {
    "tStartMs": 1350270,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "unfeasible to execute in reality."
    } ]
  }, {
    "tStartMs": 1352820,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "After his stint at Boeing, Jerry Pournelle"
    } ]
  }, {
    "tStartMs": 1355280,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "who came up with the idea,\nbecame a science fiction writer."
    } ]
  }, {
    "tStartMs": 1359030,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And in his 1985 New York Times\nbestselling book, Footfall"
    } ]
  }, {
    "tStartMs": 1362720,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "an alien race uses kinetic\nweapons to invade the earth."
    } ]
  }, {
    "tStartMs": 1366830,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And honestly, I'm pretty\nglad that this weapon"
    } ]
  }, {
    "tStartMs": 1369650,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "is feasible only in science fiction."
    } ]
  }, {
    "tStartMs": 1381140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Engineering is all about trying, failing"
    } ]
  }, {
    "tStartMs": 1384200,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and sometimes blowing stuff up."
    } ]
  }, {
    "tStartMs": 1386210,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And if you can't drop giant\nsteel rods in the desert"
    } ]
  }, {
    "tStartMs": 1389030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "well then the next best\nthing is Brilliant,"
    } ]
  }, {
    "tStartMs": 1390740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the sponsor of this video."
    } ]
  }, {
    "tStartMs": 1392300,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "It's the best tool I know\nfor learning about physics,"
    } ]
  }, {
    "tStartMs": 1394550,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "math, and engineering."
    } ]
  }, {
    "tStartMs": 1396050,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "With Brilliant, you can\nexperiment for yourself"
    } ]
  }, {
    "tStartMs": 1398210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "make predictions and get your hands dirty"
    } ]
  }, {
    "tStartMs": 1400070,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "using their interactive lessons."
    } ]
  }, {
    "tStartMs": 1401810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "For example, this calculus course"
    } ]
  }, {
    "tStartMs": 1403400,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "takes you through calculating the motion"
    } ]
  }, {
    "tStartMs": 1405050,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "of falling objects."
    } ]
  }, {
    "tStartMs": 1406760,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And Brilliant's interactives"
    } ]
  }, {
    "tStartMs": 1408110,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "help you develop a more\nintuitive understanding"
    } ]
  }, {
    "tStartMs": 1410330,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "of how to solve problems."
    } ]
  }, {
    "tStartMs": 1411800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And they really focus on mastery"
    } ]
  }, {
    "tStartMs": 1413600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "encouraging you to develop\na solid understanding"
    } ]
  }, {
    "tStartMs": 1415460,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "of the basics, and then gradually\nincreasing the difficulty."
    } ]
  }, {
    "tStartMs": 1419000,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And in every step of the\nway, they ask you questions"
    } ]
  }, {
    "tStartMs": 1421550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and provide helpful feedback."
    } ]
  }, {
    "tStartMs": 1423890,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Brilliant have been supporting Veritasium"
    } ]
  }, {
    "tStartMs": 1425930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "for a long time,"
    } ]
  }, {
    "tStartMs": 1427610,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and that is one of the\nreasons that we can make"
    } ]
  }, {
    "tStartMs": 1429890,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "ambitious videos like this one."
    } ]
  }, {
    "tStartMs": 1431480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So if you wanna support this channel"
    } ]
  }, {
    "tStartMs": 1433190,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "a great way to do it is\nby trying out Brilliant."
    } ]
  }, {
    "tStartMs": 1436460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They really make a great product,"
    } ]
  }, {
    "tStartMs": 1438080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "a learning tool that I\nenjoy using personally"
    } ]
  }, {
    "tStartMs": 1440240,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and I know you will too."
    } ]
  }, {
    "tStartMs": 1441710,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And you can try it for free right now"
    } ]
  }, {
    "tStartMs": 1443330,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "by going to Brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1446540,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And with the holiday season in full swing,"
    } ]
  }, {
    "tStartMs": 1448490,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "I think a subscription to Brilliant"
    } ]
  }, {
    "tStartMs": 1449780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is a fantastic gift for\nthat friend or family member"
    } ]
  }, {
    "tStartMs": 1452900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "who is into learning."
    } ]
  }, {
    "tStartMs": 1454580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "There are no shipping\ndelays to worry about."
    } ]
  }, {
    "tStartMs": 1456680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So it's the perfect last minute gift."
    } ]
  }, {
    "tStartMs": 1458900,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "There are courses tailored\nfor anyone from beginners"
    } ]
  }, {
    "tStartMs": 1461750,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "through to intermediate or advanced."
    } ]
  }, {
    "tStartMs": 1463760,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And if you sign up right now,"
    } ]
  }, {
    "tStartMs": 1465320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Brilliant are offering 20% off"
    } ]
  }, {
    "tStartMs": 1467000,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "an annual premium subscription"
    } ]
  }, {
    "tStartMs": 1468290,
    "dDurationMs": 2010,
    "segs": [ {
