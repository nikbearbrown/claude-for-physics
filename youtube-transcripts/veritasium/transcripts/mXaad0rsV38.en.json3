      "utf8": "you get closer to the pole the velocity"
    } ]
  }, {
    "tStartMs": 279600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "decreases down to zero."
    } ]
  }, {
    "tStartMs": 281500,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Destin: Think about these velocities relative to the drain in the middle."
    } ]
  }, {
    "tStartMs": 285220,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Derek: Now, imagine we drain the pool"
    } ]
  }, {
    "tStartMs": 287580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Destin: When we pull the plug, all the water"
    } ]
  }, {
    "tStartMs": 289320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "starts moving towards the middle."
    } ]
  }, {
    "tStartMs": 291620,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Derek: Water from the far side is moving too fast"
    } ]
  }, {
    "tStartMs": 293729,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "relative to the drain, and so it gets out"
    } ]
  }, {
    "tStartMs": 296310,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "ahead, whereas water from near the pole"
    } ]
  }, {
    "tStartMs": 298470,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "is going too slow, and so it lags behind."
    } ]
  }, {
    "tStartMs": 301640,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "Destin: The side nearest the equator is going"
    } ]
  }, {
    "tStartMs": 303540,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "faster, so that water outruns the drain,"
    } ]
  }, {
    "tStartMs": 306760,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "but the water nearest the pole is going"
    } ]
  }, {
    "tStartMs": 308460,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "slower, so it falls behind."
    } ]
  }, {
    "tStartMs": 310840,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Both: So when the water approaches the drain it swirls"
    } ]
  }, {
    "tStartMs": 313380,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "(counter)clockwise."
    } ]
  }, {
    "tStartMs": 315780,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "Destin: this is the reason"
    } ]
  }, {
    "tStartMs": 316470,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "hurricanes swirl counterclockwise in"
    } ]
  }, {
    "tStartMs": 318150,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "the northern hemisphere,"
    } ]
  }, {
    "tStartMs": 319660,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "Derek: And this is the"
    } ]
  }, {
    "tStartMs": 320240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "reason cyclones swirl clockwise in the"
    } ]
  }, {
    "tStartMs": 322349,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "southern hemisphere."
    } ]
  }, {
    "tStartMs": 323869,
    "dDurationMs": 911,
    "segs": [ {
      "utf8": "Destin: The center of the"
    } ]
  }, {
    "tStartMs": 324780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "hurricane has lower pressure, just like a"
    } ]
  }, {
    "tStartMs": 326550,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "drain, so the hurricane swirls just like our pool."
    } ]
  }, {
    "tStartMs": 330200,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Derek: The higher pressure air rushes into"
    } ]
  }, {
    "tStartMs": 331900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "the eye of the storm, and just like in"
    } ]
  }, {
    "tStartMs": 333550,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "our pool, swirls in the direction"
    } ]
  }, {
    "tStartMs": 335170,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "dictated by the hemisphere."
    } ]
  }, {
    "tStartMs": 337620,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Both: And that's the truth about toilet swirls."
    } ]
  }, {
