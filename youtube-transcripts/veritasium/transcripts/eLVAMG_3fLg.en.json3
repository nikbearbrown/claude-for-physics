{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- When people think about robots,"
    } ]
  }, {
    "tStartMs": 1890,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "they usually imagine something\nlike a Boston Dynamics robot,"
    } ]
  }, {
    "tStartMs": 5370,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "metallic and humanoid."
    } ]
  }, {
    "tStartMs": 7350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But the robots we'll see in the future"
    } ]
  }, {
    "tStartMs": 9240,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "might not look like that at all."
    } ]
  }, {
    "tStartMs": 11310,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I mean, if humans are\ninteracting with something"
    } ]
  }, {
    "tStartMs": 13140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "on a daily basis, it's\nprobably best not to make it"
    } ]
  }, {
    "tStartMs": 15900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "sharp, delicate, and heavy."
    } ]
  }, {
    "tStartMs": 17820,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- How rude."
    } ]
  }, {
    "tStartMs": 19050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- [Derek] Instead, advanced\nrobots might be made safer"
    } ]
  }, {
    "tStartMs": 21660,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "if they're soft, flexible,"
    } ]
  }, {
    "tStartMs": 23070,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and all kinds of shapes and sizes."
    } ]
  }, {
    "tStartMs": 25170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So instead of Sonny from I, Robot."
    } ]
  }, {
    "tStartMs": 27270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 28103,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "- [Derek] Something like\nBaymax from \"Big Hero 6\""
    } ]
  }, {
    "tStartMs": 30360,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "might be closer to what's in our future."
    } ]
  }, {
    "tStartMs": 32762,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "- Balalala."
    } ]
  }, {
    "tStartMs": 34893,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "- This is a compilation\nvideo of five of my videos"
    } ]
  }, {
    "tStartMs": 37500,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "on the surprisingly different\nways robots can look,"
    } ]
  }, {
    "tStartMs": 40050,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and why we build them that way."
    } ]
  }, {
    "tStartMs": 42510,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "This is my first time trying out a series,"
    } ]
  }, {
    "tStartMs": 44700,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and honestly, it's been a busy\ntime for the Veritasium team."
    } ]
  }, {
    "tStartMs": 48000,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We're working on some exciting\nthings in the background."
    } ]
  }, {
    "tStartMs": 50730,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "But in the meantime,"
    } ]
  }, {
    "tStartMs": 51563,
    "dDurationMs": 2827,
    "segs": [ {
      "utf8": "we wanted to put this\ntogether for all of you."
    } ]
  }, {
    "tStartMs": 54390,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And I also caught up\nwith Dr. Elliot Hawkes,"
    } ]
  }, {
    "tStartMs": 56640,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "the scientist behind two of these robots,"
    } ]
  }, {
    "tStartMs": 58290,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to get an update on\nhow they're progressing"
    } ]
  }, {
    "tStartMs": 60360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and when we can expect\nto see them in our lives."
    } ]
  }, {
    "tStartMs": 63450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Are there more developments happening"
    } ]
  }, {
    "tStartMs": 64980,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with the jumping robots?"
    } ]
  }, {
    "tStartMs": 67050,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "- We have a whole nother\nproject on jumping,"
    } ]
  }, {
    "tStartMs": 69657,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "and it doesn't even use springs."
    } ]
  }, {
    "tStartMs": 70950,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "So I won't give away our our secrets yet."
    } ]
  }, {
    "tStartMs": 74640,
    "dDurationMs": 1944,
    "segs": [ {
      "utf8": "But keep an eye out for that one too,"
    } ]
  }, {
    "tStartMs": 76584,
    "dDurationMs": 926,
    "segs": [ {
      "utf8": "'cause that's gonna be fun."
    } ]
  }, {
    "tStartMs": 77510,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "- So you have another jumping robot"
    } ]
  }, {
    "tStartMs": 79440,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which has a totally novel design?"
    } ]
  }, {
    "tStartMs": 81660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 82493,
    "dDurationMs": 907,
    "segs": [ {
      "utf8": "- And you think it's gonna be better"
    } ]
  }, {
    "tStartMs": 83400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "than the one that you had before?"
    } ]
  }, {
    "tStartMs": 85470,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Correct."
    } ]
  }, {
    "tStartMs": 86303,
    "dDurationMs": 937,
    "segs": [ {
      "utf8": "- And I just wanna shout out"
    } ]
  }, {
    "tStartMs": 87240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "our longtime sponsor, Brilliant."
    } ]
  }, {
    "tStartMs": 88800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They've supported the channel since 2021,"
    } ]
  }, {
    "tStartMs": 91050,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and it's great to get\nto talk about something"
    } ]
  }, {
    "tStartMs": 92910,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that I actually use myself."
    } ]
  }, {
    "tStartMs": 94620,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I've had Brilliant on my phone for years,"
    } ]
  }, {
    "tStartMs": 96780,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and it just allows me to\nlearn something new every day,"
    } ]
  }, {
    "tStartMs": 100110,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "instead of, say, doom scrolling."
    } ]
  }, {
    "tStartMs": 102330,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You should make valuable use of your time."
    } ]
  }, {
    "tStartMs": 104490,
    "dDurationMs": 2873,
    "segs": [ {
      "utf8": "So I will tell you more about\nBrilliant later in the video."
    } ]
  }, {
    "tStartMs": 108720,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Non-humanoid robots aren't just safer"
    } ]
  }, {
    "tStartMs": 111060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "for us to interact with."
    } ]
  }, {
    "tStartMs": 112440,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "One of their biggest advantages\nover traditional robots"
    } ]
  }, {
    "tStartMs": 114870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "is that they don't just do things"
    } ]
  }, {
    "tStartMs": 116820,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "humans already do, but better."
    } ]
  }, {
    "tStartMs": 118860,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Instead, they're specialized"
    } ]
  }, {
    "tStartMs": 120450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to master entirely new abilities,"
    } ]
  }, {
    "tStartMs": 122520,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "often ones that no human can tackle."
    } ]
  }, {
    "tStartMs": 125490,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "This is a robot that can grow\nto hundreds of times its size,"
    } ]
  }, {
    "tStartMs": 130200,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "and it can't be stopped\nby adhesives or spikes."
    } ]
  }, {
    "tStartMs": 134340,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Although it looks kind\nof simple and cheap,"
    } ]
  }, {
    "tStartMs": 136740,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it has dozens of potential applications,"
    } ]
  }, {
    "tStartMs": 139140,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "including one day maybe saving your life."
    } ]
  }, {
    "tStartMs": 143970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "These robots can be made\nout of almost any material,"
    } ]
  }, {
    "tStartMs": 146760,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but they all follow the\nsame basic principle."
    } ]
  }, {
    "tStartMs": 149430,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Powered by compressed air,\nthey grow from the tip."
    } ]
  }, {
    "tStartMs": 153840,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's good."
    } ]
  }, {
    "tStartMs": 156660,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] And this allows the robot"
    } ]
  }, {
    "tStartMs": 158100,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to pass through tight spaces,\nand also over sticky surfaces."
    } ]
  }, {
    "tStartMs": 163590,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "- Something like a car\nwill get stuck to it."
    } ]
  }, {
    "tStartMs": 169644,
    "dDurationMs": 1356,
    "segs": [ {
      "utf8": "It gets stuck in the wheels."
    } ]
  }, {
    "tStartMs": 171000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Now if I do the same\nthing with the vine robot,"
    } ]
  }, {
    "tStartMs": 172920,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "see the robot is able to extend."
    } ]
  }, {
    "tStartMs": 174810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] It can navigate this curvy"
    } ]
  }, {
    "tStartMs": 176400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and twisted passageway effortlessly,"
    } ]
  }, {
    "tStartMs": 179100,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "which suggests some of the applications"
    } ]
  }, {
    "tStartMs": 180870,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "it's well suited for."
    } ]
  }, {
    "tStartMs": 182580,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "Now, you might think spikes\nwould be the downfall"
    } ]
  }, {
    "tStartMs": 185146,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "of an inflatable robot."
    } ]
  }, {
    "tStartMs": 187200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But even if it's punctured,"
    } ]
  }, {
    "tStartMs": 189300,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "as long as you have\nsufficient air pressure,"
    } ]
  }, {
    "tStartMs": 191640,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "the robot keeps going."
    } ]
  }, {
    "tStartMs": 193650,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- And you might be able to hear it."
    } ]
  }, {
    "tStartMs": 194850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's actually leaking now."
    } ]
  }, {
    "tStartMs": 196440,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "So I'll have to turn up the pressure."
    } ]
  }, {
    "tStartMs": 201330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "This by itself is not yet a robot."
    } ]
  }, {
    "tStartMs": 203070,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But once we add steering,\na camera, some sensors,"
    } ]
  }, {
    "tStartMs": 206010,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and maybe some intelligence as\nto where we're directing it,"
    } ]
  }, {
    "tStartMs": 209190,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "then we could say it's a robot."
    } ]
  }, {
    "tStartMs": 210360,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So this is sort of the\nbackbone of a robot."
    } ]
  }, {
    "tStartMs": 212580,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "This is what allows us to\nbuild our type of robots."
    } ]
  }, {
    "tStartMs": 216000,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "- [Derek] So where did the\nidea for this device come from?"
    } ]
  }, {
    "tStartMs": 218820,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "- I had a vine in my\noffice that was on a shelf,"
    } ]
  }, {
    "tStartMs": 223110,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and it was kinda out of the sunlight."
    } ]
  }, {
    "tStartMs": 225210,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And over the course of like a year or so,"
    } ]
  }, {
    "tStartMs": 226950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "it slowly grew out this tendril,"
    } ]
  }, {
    "tStartMs": 228690,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "out and around the edge of the shelf"
    } ]
  }, {
    "tStartMs": 231090,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and towards the sunlight."
    } ]
  }, {
    "tStartMs": 232620,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "I said, that's a pretty cool\nthing it just did, right?"
    } ]
  }, {
    "tStartMs": 235770,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "So you start thinking,"
    } ]
  }, {
    "tStartMs": 237060,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "well, is there a way you\ncould do that robotically?"
    } ]
  }, {
    "tStartMs": 239400,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "- [Derek] The solution is really\nelegant in its simplicity."
    } ]
  }, {
    "tStartMs": 242790,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Just take some airtight tubing\nand fold it in on itself."
    } ]
  }, {
    "tStartMs": 246690,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's kinda like a water wiggly,"
    } ]
  }, {
    "tStartMs": 248610,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "those toys that are really hard to hold."
    } ]
  }, {
    "tStartMs": 251910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "When you inflate it with compressed air,"
    } ]
  }, {
    "tStartMs": 254070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "it starts growing out from the tip."
    } ]
  }, {
    "tStartMs": 256440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And if you want the tube to\nalways bend at a certain spot,"
    } ]
  }, {
    "tStartMs": 259410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "you could just tape the\ntubing on the outside"
    } ]
  }, {
    "tStartMs": 261720,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to shorten one of the sides."
    } ]
  }, {
    "tStartMs": 264060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "For example, you could tape\nit into a helical shape"
    } ]
  }, {
    "tStartMs": 266580,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "to create a deployable antenna."
    } ]
  }, {
    "tStartMs": 269850,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "What about getting them to retract?"
    } ]
  }, {
    "tStartMs": 271800,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Yeah, that's a challenging problem."
    } ]
  }, {
    "tStartMs": 273930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "When you're in a constrained environment,"
    } ]
  }, {
    "tStartMs": 275250,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "all you really have to do is\npull on, we call it the tail,"
    } ]
  }, {
    "tStartMs": 280200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so the material that is passing through"
    } ]
  }, {
    "tStartMs": 282180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the core of the body."
    } ]
  }, {
    "tStartMs": 283380,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "You pull on it and it basically outgrows,"
    } ]
  }, {
    "tStartMs": 285090,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "it just goes back inside itself."
    } ]
  }, {
    "tStartMs": 286710,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Now if you're in a big open area like this"
    } ]
  }, {
    "tStartMs": 288990,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and you try pulling on that,"
    } ]
  }, {
    "tStartMs": 290670,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "instead of inverting, so retracting,"
    } ]
  }, {
    "tStartMs": 293640,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "it tends to kinda coil\nup and make a ugly shape."
    } ]
  }, {
    "tStartMs": 297270,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Derek] And the engineers\nhave come up with ways"
    } ]
  }, {
    "tStartMs": 298680,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to retract the tube to\nprevent it from buckling"
    } ]
  }, {
    "tStartMs": 301830,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "using internal rollers."
    } ]
  }, {
    "tStartMs": 304410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But the tube doesn't have\nto be the same diameter"
    } ]
  }, {
    "tStartMs": 306810,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "the whole way along."
    } ]
  }, {
    "tStartMs": 307920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Here there's actually\na much wider section."
    } ]
  }, {
    "tStartMs": 310110,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Think of it like a pillow"
    } ]
  }, {
    "tStartMs": 311940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "that's packed into the end of the robot."
    } ]
  }, {
    "tStartMs": 314850,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Yeah, if you could\nsit cross-legged on it."
    } ]
  }, {
    "tStartMs": 316440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- Cross-legged on the table?"
    } ]
  }, {
    "tStartMs": 318270,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "This sounds super sketchy."
    } ]
  }, {
    "tStartMs": 320850,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "So it grows underneath\nthe table just as usual,"
    } ]
  }, {
    "tStartMs": 324240,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "and then, as the pillow\npart starts inflating."
    } ]
  }, {
    "tStartMs": 328684,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "Is this not good, or is this okay?"
    } ]
  }, {
    "tStartMs": 331050,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "It can actually lift me up."
    } ]
  }, {
    "tStartMs": 335310,
    "dDurationMs": 3107,
    "segs": [ {
      "utf8": "So my balance is not great, as we can see."
    } ]
  }, {
    "tStartMs": 338417,
    "dDurationMs": 1903,
    "segs": [ {
      "utf8": "- [Elliot] Try standing on it."
    } ]
  }, {
    "tStartMs": 340320,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Stand on it?\n- Yeah."
    } ]
  }, {
    "tStartMs": 341790,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- What's amazing is that\nthis doesn't require"
    } ]
  }, {
    "tStartMs": 343800,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "much pressure above atmospheric."
    } ]
  }, {
    "tStartMs": 346110,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Just a tenth of an atmosphere\napplied over a large area,"
    } ]
  }, {
    "tStartMs": 349530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "like a square meter, can\nlift something as heavy"
    } ]
  }, {
    "tStartMs": 352350,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "as a thousand kilograms, all\nthe while remaining soft."
    } ]
  }, {
    "tStartMs": 357270,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Whoa."
    } ]
  }, {
    "tStartMs": 358770,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Woo. That was great."
    } ]
  }, {
    "tStartMs": 360600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That's the paradoxical\nthing about pressure."
    } ]
  }, {
    "tStartMs": 363000,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "You can get a large overall\nforce with low pressure"
    } ]
  }, {
    "tStartMs": 366210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "as long as the area is large enough."
    } ]
  }, {
    "tStartMs": 368490,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "What sort of area is\nthat, that pillow there?"
    } ]
  }, {
    "tStartMs": 371610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- It's 600 square inches."
    } ]
  }, {
    "tStartMs": 373350,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So with one PSI, 600 pounds."
    } ]
  }, {
    "tStartMs": 376170,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "- Yeah, that's just crazy.\n- Two PSI, 1,200 pounds."
    } ]
  }, {
    "tStartMs": 379380,
    "dDurationMs": 1676,
    "segs": [ {
      "utf8": "- [Derek] And the whole\ntime, it feels really soft."
    } ]
  }, {
    "tStartMs": 381056,
    "dDurationMs": 1654,
    "segs": [ {
      "utf8": "- Yeah, 'cause there's\na couple PSI, right?"
    } ]
  }, {
    "tStartMs": 382710,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- [Derek] It's important\nthat the device is still soft"
    } ]
  }, {
    "tStartMs": 385050,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "so it doesn't hurt anyone."
    } ]
  }, {
    "tStartMs": 386610,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- So you can design these things"
    } ]
  }, {
    "tStartMs": 388110,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "to have cross-section that\nchanges along its length."
    } ]
  }, {
    "tStartMs": 391800,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So it could be a very small body"
    } ]
  }, {
    "tStartMs": 394230,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that could grow into, for\nexample, a collapsed building"
    } ]
  }, {
    "tStartMs": 397110,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and potentially lift a large object"
    } ]
  }, {
    "tStartMs": 400080,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "off someone who's trapped,"
    } ]
  }, {
    "tStartMs": 401340,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "or maybe in a car crash\nor something like that."
    } ]
  }, {
    "tStartMs": 403520,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "It can apply huge forces"
    } ]
  }, {
    "tStartMs": 405576,
    "dDurationMs": 3474,
    "segs": [ {
      "utf8": "with very soft and\nlightweight, cheap materials."
    } ]
  }, {
    "tStartMs": 409050,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] These robots\ncan also be deployed"
    } ]
  }, {
    "tStartMs": 410640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "in search and rescue operations"
    } ]
  }, {
    "tStartMs": 412440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "by attaching sensors like\na camera onto the front."
    } ]
  }, {
    "tStartMs": 416040,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- These robots are actually\nreally hard to stop."
    } ]
  }, {
    "tStartMs": 417930,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So you can take them,\ngrow them into a clutter,"
    } ]
  }, {
    "tStartMs": 421230,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "potentially a collapsed\nbuilding or something like that,"
    } ]
  }, {
    "tStartMs": 423180,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and they will continue to go somewhere."
    } ]
  }, {
    "tStartMs": 426240,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "An alternative is, they're so cheap."
    } ]
  }, {
    "tStartMs": 427980,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "I mean, they're basically free."
    } ]
  }, {
    "tStartMs": 429210,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "You could grow a hundred\nof 'em, let's say,"
    } ]
  }, {
    "tStartMs": 430860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "into a collapsed building\nwith some sensing on them,"
    } ]
  }, {
    "tStartMs": 433620,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and maybe only one of them finds somebody."
    } ]
  }, {
    "tStartMs": 436230,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But I mean, that's a\nhuge success if it does."
    } ]
  }, {
    "tStartMs": 439530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- [Derek] But how do you keep a camera"
    } ]
  }, {
    "tStartMs": 440820,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "connected to the front of the robot"
    } ]
  }, {
    "tStartMs": 442290,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "when it grows out from the tip?"
    } ]
  }, {
    "tStartMs": 444570,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Well, one way is to use an end cap,"
    } ]
  }, {
    "tStartMs": 446820,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "which allows that camera\njust to stay on the front,"
    } ]
  }, {
    "tStartMs": 449520,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "pushed from behind by the robot."
    } ]
  }, {
    "tStartMs": 451410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But there are other\nmechanisms of attachment."
    } ]
  }, {
    "tStartMs": 453810,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "The tiny wireless camera is\nmounted on an external frame,"
    } ]
  }, {
    "tStartMs": 457950,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but this frame interlocks\nwith an internal frame,"
    } ]
  }, {
    "tStartMs": 460860,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which is actually inside\nthe pressurized part"
    } ]
  }, {
    "tStartMs": 463410,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "of the robot body."
    } ]
  }, {
    "tStartMs": 464640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It's similar to how a\nroller coaster's wheels"
    } ]
  }, {
    "tStartMs": 467100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "go around the track."
    } ]
  }, {
    "tStartMs": 469200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So this prevents the\ncamera from falling off"
    } ]
  }, {
    "tStartMs": 471420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "as the robot grows."
    } ]
  }, {
    "tStartMs": 473100,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "What's really interesting\nis how the vine robot"
    } ]
  }, {
    "tStartMs": 475890,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "can be actively steered."
    } ]
  }, {
    "tStartMs": 478230,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "They attach artificial\nmuscles to the robot."
    } ]
  }, {
    "tStartMs": 484002,
    "dDurationMs": 3348,
    "segs": [ {
      "utf8": "So the way this muscle works\nis that if you inflate it,"
    } ]
  }, {
    "tStartMs": 487350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "it expands sideways,"
    } ]
  }, {
    "tStartMs": 489240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "which leads to it contracting in length."
    } ]
  }, {
    "tStartMs": 492150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- We don't actually use these much anymore"
    } ]
  }, {
    "tStartMs": 493770,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "because although it's soft,\nit's still somewhat stiff."
    } ]
  }, {
    "tStartMs": 496770,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So what we use instead"
    } ]
  }, {
    "tStartMs": 498540,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "are simply tubes of this\nripstop nylon fabric,"
    } ]
  }, {
    "tStartMs": 501270,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "with the braid oriented at 45 degrees."
    } ]
  }, {
    "tStartMs": 503610,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So in this sense,"
    } ]
  }, {
    "tStartMs": 504443,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "we just have one single\nlayer of airtight fabric."
    } ]
  }, {
    "tStartMs": 509250,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "This is the main robot body here."
    } ]
  }, {
    "tStartMs": 511140,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Then we have three pneumatic\nmuscles connected to it."
    } ]
  }, {
    "tStartMs": 513990,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Now, these three muscles"
    } ]
  }, {
    "tStartMs": 515250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "are each connected to\ntheir own air supply,"
    } ]
  }, {
    "tStartMs": 516870,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "connected to regulators over here."
    } ]
  }, {
    "tStartMs": 518940,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "As the robot extends from the tip,"
    } ]
  }, {
    "tStartMs": 520650,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "we can steer it by shortening\nand lengthening the sides."
    } ]
  }, {
    "tStartMs": 523110,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So just the way your hand works"
    } ]
  }, {
    "tStartMs": 524790,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "is if I shorten this tendon in my arm,"
    } ]
  }, {
    "tStartMs": 527010,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "my hand will move this way."
    } ]
  }, {
    "tStartMs": 528540,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Or if I shorten the one on this side,"
    } ]
  }, {
    "tStartMs": 529920,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "it'll move the other way."
    } ]
  }, {
    "tStartMs": 530970,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So our vine robot, we have\nthese muscles along its side,"
    } ]
  }, {
    "tStartMs": 533700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so as they inflate,\nthey'll turn it one way."
    } ]
  }, {
    "tStartMs": 536220,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Then if I inflate the\none on the other side,"
    } ]
  }, {
    "tStartMs": 538080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "it'll turn the other way."
    } ]
  }, {
    "tStartMs": 539280,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "- [Derek] So the vine robot\ncan fit through tight spaces,"
    } ]
  }, {
    "tStartMs": 542070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "it doesn't typically\nget stuck on anything,"
    } ]
  }, {
    "tStartMs": 543960,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and isn't bothered by sharp objects."
    } ]
  }, {
    "tStartMs": 546390,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And once you attach that\ncamera on the front,"
    } ]
  }, {
    "tStartMs": 548490,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "it's ideal for things like archeology."
    } ]
  }, {
    "tStartMs": 554100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The robot was actually taken to Peru"
    } ]
  }, {
    "tStartMs": 556350,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to investigate some very narrow shafts."
    } ]
  }, {
    "tStartMs": 559680,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- So we were looking at\nthis archeological site"
    } ]
  }, {
    "tStartMs": 562620,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "that was built somewhere\nbetween 1,500 and 500 BC"
    } ]
  }, {
    "tStartMs": 566850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in the Andes Mountains of Peru,"
    } ]
  }, {
    "tStartMs": 568950,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and it was an ancient temple"
    } ]
  }, {
    "tStartMs": 570540,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that had all these underground spaces."
    } ]
  }, {
    "tStartMs": 572850,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And part of what the\narcheologists were doing"
    } ]
  }, {
    "tStartMs": 575850,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "was trying to understand\nwhat the spaces were for,"
    } ]
  }, {
    "tStartMs": 578730,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and what the people who built them"
    } ]
  }, {
    "tStartMs": 580350,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "were trying to do with them."
    } ]
  }, {
    "tStartMs": 582000,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So part of that was unknown."
    } ]
  }, {
    "tStartMs": 583350,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "But there were these giant rooms\nthat they called galleries,"
    } ]
  }, {
    "tStartMs": 586890,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and then there were these\nsmall ducts, or tunnels"
    } ]
  }, {
    "tStartMs": 589710,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that were offshoots of these rooms,"
    } ]
  }, {
    "tStartMs": 592650,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and they wanted to know\nwhere these ducts led,"
    } ]
  }, {
    "tStartMs": 595740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but they were too small\nfor a person to go in."
    } ]
  }, {
    "tStartMs": 598080,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So we were able to\nsuccessfully use the vine robot"
    } ]
  }, {
    "tStartMs": 600690,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to explore three of the tunnels"
    } ]
  }, {
    "tStartMs": 602550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that couldn't have been\nseen through other means,"
    } ]
  }, {
    "tStartMs": 604890,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "which was super exciting."
    } ]
  }, {
    "tStartMs": 606000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And we got video inside the entire tunnels"
    } ]
  }, {
    "tStartMs": 609240,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "and gave it to the archeology team."
    } ]
  }, {
    "tStartMs": 612439,
    "dDurationMs": 1871,
    "segs": [ {
      "utf8": "- [Derek] There's an\napplication where I feel"
    } ]
  }, {
    "tStartMs": 614310,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "like this solution is just so obvious"
    } ]
  }, {
    "tStartMs": 616380,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I wonder why it didn't exist before."
    } ]
  }, {
    "tStartMs": 618840,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- Intubation is literally the process"
    } ]
  }, {
    "tStartMs": 622020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of putting a tube into a patient."
    } ]
  }, {
    "tStartMs": 624300,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The purpose is to breathe for the patient"
    } ]
  }, {
    "tStartMs": 627390,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "when the patient isn't breathing."
    } ]
  }, {
    "tStartMs": 628530,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And so traditionally, a\nhighly-trained medical professional"
    } ]
  }, {
    "tStartMs": 631890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "would take their laryngoscope,\ncome above the patient."
    } ]
  }, {
    "tStartMs": 634830,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And once they see the trachea,"
    } ]
  }, {
    "tStartMs": 637920,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "you start to pass your tube down inside."
    } ]
  }, {
    "tStartMs": 642180,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I'm almost there. I can see the light."
    } ]
  }, {
    "tStartMs": 645240,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "So if you can see right now,"
    } ]
  }, {
    "tStartMs": 646500,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "I just got it in to the trachea."
    } ]
  }, {
    "tStartMs": 649920,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "- Oh, yeah.\n- Right there."
    } ]
  }, {
    "tStartMs": 652380,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And it took me a couple minutes,"
    } ]
  }, {
    "tStartMs": 655110,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and I was really kinda\nwrenching on this patient here."
    } ]
  }, {
    "tStartMs": 658890,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So if there's somebody\nwho's not breathing,"
    } ]
  }, {
    "tStartMs": 661320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "every second counts."
    } ]
  }, {
    "tStartMs": 662700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Derek] But by using a miniature version"
    } ]
  }, {
    "tStartMs": 664380,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of this vine robot, researchers are hoping"
    } ]
  }, {
    "tStartMs": 666870,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to make intubation faster and safer."
    } ]
  }, {
    "tStartMs": 669570,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- Somebody like me with no training"
    } ]
  }, {
    "tStartMs": 671670,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "could pretty simply insert this device,"
    } ]
  }, {
    "tStartMs": 675600,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "aim towards the nose,"
    } ]
  }, {
    "tStartMs": 677820,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and just like that, if you can\nsee, we've already intubated,"
    } ]
  }, {
    "tStartMs": 685710,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and all it took was a little\nbit of pressurization."
    } ]
  }, {
    "tStartMs": 689970,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Just like that."
    } ]
  }, {
    "tStartMs": 690803,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "- [Derek] It almost looks\nlike a sort of a party favor."
    } ]
  }, {
    "tStartMs": 693000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah, right?"
    } ]
  }, {
    "tStartMs": 693833,
    "dDurationMs": 3727,
    "segs": [ {
      "utf8": "It's like a, this reminds\nme a lot of those inflatable"
    } ]
  }, {
    "tStartMs": 697560,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "kinda like Play-Doh structures\nthat you see at car lots."
    } ]
  }, {
    "tStartMs": 701220,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Derek] How does it know\nto go down the right tube?"
    } ]
  }, {
    "tStartMs": 703710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Yeah, so that's one of\nthe kind of cool things"
    } ]
  }, {
    "tStartMs": 705900,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "about soft robotics, is the\nrobot is quite compliant,"
    } ]
  }, {
    "tStartMs": 708990,
    "dDurationMs": 1691,
    "segs": [ {
      "utf8": "and we see that in a lot of these demos."
    } ]
  }, {
    "tStartMs": 710681,
    "dDurationMs": 2657,
    "segs": [ {
      "utf8": "They can squish, they can bend."
    } ]
  }, {
    "tStartMs": 713338,
    "dDurationMs": 1682,
    "segs": [ {
      "utf8": "And so, how we've designed it is that"
    } ]
  }, {
    "tStartMs": 715020,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the main robot grows\ndown into the esophagus,"
    } ]
  }, {
    "tStartMs": 717750,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "and then we have this side branch"
    } ]
  }, {
    "tStartMs": 719040,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that heads towards the trachea,"
    } ]
  }, {
    "tStartMs": 721080,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and it's quite flexible."
    } ]
  }, {
    "tStartMs": 722580,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And so, it basically finds the opening."
    } ]
  }, {
    "tStartMs": 724590,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So it's a really neat example"
    } ]
  }, {
    "tStartMs": 726330,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of kind of a passive intelligence,"
    } ]
  }, {
    "tStartMs": 728610,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "mechanical intelligence,\nsome people call it,"
    } ]
  }, {
    "tStartMs": 730500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "where it can find its path"
    } ]
  }, {
    "tStartMs": 732300,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "even if we don't know\nexactly the shape beforehand."
    } ]
  }, {
    "tStartMs": 735810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] Have you tried\nthis on a real person yet?"
    } ]
  }, {
    "tStartMs": 738090,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Not on a real person,"
    } ]
  }, {
    "tStartMs": 739350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "but we've actually tried\nthis in a cadaver lab,"
    } ]
  }, {
    "tStartMs": 742140,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and we've shown that we can move from"
    } ]
  }, {
    "tStartMs": 745440,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "this nice idealized version\nto an actual in vivo situation"
    } ]
  }, {
    "tStartMs": 750210,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and successfully intubate a patient."
    } ]
  }, {
    "tStartMs": 752790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Derek] There's another application,"
    } ]
  }, {
    "tStartMs": 754170,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "which is burrowing into sand or soil."
    } ]
  }, {
    "tStartMs": 758400,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "When you blow compressed air\ninto something like sand,"
    } ]
  }, {
    "tStartMs": 761490,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "it fluidizes, it becomes like a liquid,"
    } ]
  }, {
    "tStartMs": 764940,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and that can allow the vine robot"
    } ]
  }, {
    "tStartMs": 766710,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "to grow into granular materials like sand."
    } ]
  }, {
    "tStartMs": 770970,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- If you've ever been to the beach"
    } ]
  }, {
    "tStartMs": 772200,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "and you try to stick your\numbrella pole into the ground,"
    } ]
  }, {
    "tStartMs": 775830,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "it's fairly difficult."
    } ]
  }, {
    "tStartMs": 777120,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- I'll try to push that\nprobe down into the sand,"
    } ]
  }, {
    "tStartMs": 779100,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "no fluidization."
    } ]
  }, {
    "tStartMs": 781200,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Yeah, it feels like it sort\nof gets wedged in there."
    } ]
  }, {
    "tStartMs": 785010,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- So now I'll turn on the air."
    } ]
  }, {
    "tStartMs": 787590,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "- Oh yeah, you can feel it immediately."
    } ]
  }, {
    "tStartMs": 791910,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh, wow."
    } ]
  }, {
    "tStartMs": 794010,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Yeah, that's a lot."
    } ]
  }, {
    "tStartMs": 795480,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- So what we've done here is essentially,"
    } ]
  }, {
    "tStartMs": 797700,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "we just blow a jet of air\nout the front of the robot,"
    } ]
  }, {
    "tStartMs": 800910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and that loosens up the sand enough"
    } ]
  }, {
    "tStartMs": 802560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to reduce the force of the\nsand so that the robot,"
    } ]
  }, {
    "tStartMs": 805500,
    "dDurationMs": 2285,
    "segs": [ {
      "utf8": "just by tip extension,\ncan make its way through."
    } ]
  }, {
    "tStartMs": 807785,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "(air whooshing)"
    } ]
  }, {
    "tStartMs": 811084,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(rousing music)"
    } ]
  }, {
    "tStartMs": 819630,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- This makes vine robots\nan attractive option"
    } ]
  }, {
    "tStartMs": 822060,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "for NASA when they look for ways"
    } ]
  }, {
    "tStartMs": 823650,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "to study the surfaces of other planets."
    } ]
  }, {
    "tStartMs": 832080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Recently on Mars, they tried\nto have a burrowing robot,"
    } ]
  }, {
    "tStartMs": 834810,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "but it got stuck."
    } ]
  }, {
    "tStartMs": 836280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Could you do it better\nbasically with this?"
    } ]
  }, {
    "tStartMs": 838020,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Yeah, that's a good question."
    } ]
  }, {
    "tStartMs": 838860,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So the Mars InSight mission,\nthey have this heat probe."
    } ]
  }, {
    "tStartMs": 842580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The idea there was to be able to sort of"
    } ]
  }, {
    "tStartMs": 844320,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "hammer its way down into the core"
    } ]
  }, {
    "tStartMs": 845940,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and then place a sensor"
    } ]
  }, {
    "tStartMs": 847260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that could detect the temperature of Mars."
    } ]
  }, {
    "tStartMs": 850050,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "However, the problem they ran into there"
    } ]
  }, {
    "tStartMs": 851790,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "is that it turned out the\nmaterial that they put it in"
    } ]
  }, {
    "tStartMs": 854700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "was more cohesive than they expected."
    } ]
  }, {
    "tStartMs": 856620,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Inside the robot, something\nwould wind up and pound it down,"
    } ]
  }, {
    "tStartMs": 859560,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "wind up and pounded down."
    } ]
  }, {
    "tStartMs": 861000,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But it turned out there\nwasn't enough friction"
    } ]
  }, {
    "tStartMs": 863310,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "between the probe and the sand."
    } ]
  }, {
    "tStartMs": 865110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So what was really happening\nwas it would wind up,"
    } ]
  }, {
    "tStartMs": 867690,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "pound down, wind up, pound\ndown, wind up, pound down."
    } ]
  }, {
    "tStartMs": 870330,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So it'd never actually go anywhere."
    } ]
  }, {
    "tStartMs": 871650,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "The advantage of something\nlike this, like tip extension,"
    } ]
  }, {
    "tStartMs": 873480,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "is you'd have your base,\nyou start at the surface,"
    } ]
  }, {
    "tStartMs": 875910,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and you just keep extending your way down."
    } ]
  }, {
    "tStartMs": 878190,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "You're not necessarily\nrelying on the interaction"
    } ]
  }, {
    "tStartMs": 881160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "with what is surrounding\nit to make it work."
    } ]
  }, {
    "tStartMs": 884520,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- [Derek] What amazes me about vine robots"
    } ]
  }, {
    "tStartMs": 886770,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "is how a plant inspired\nthis simple, elegant design."
    } ]
  }, {
    "tStartMs": 891720,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It's so easy in fact that\nyou could build one yourself"
    } ]
  }, {
    "tStartMs": 894180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "in as little as a minute."
    } ]
  }, {
    "tStartMs": 895710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "There are instructions\nonline that I'll link to."
    } ]
  }, {
    "tStartMs": 898320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But from that basic design have come"
    } ]
  }, {
    "tStartMs": 900120,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "a huge variety of robots,"
    } ]
  }, {
    "tStartMs": 902850,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "with different applications\nfrom archeology"
    } ]
  }, {
    "tStartMs": 905760,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to search and rescue, or\nintubation to space exploration."
    } ]
  }, {
    "tStartMs": 910950,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "And what else can you\nthink of to do with it?"
    } ]
  }, {
    "tStartMs": 914970,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- I've actually gotten a\nlot of emails from viewers"
    } ]
  }, {
    "tStartMs": 918840,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "about crazy ideas that\nwe hadn't thought of."
    } ]
  }, {
    "tStartMs": 920790,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So keep 'em coming."
    } ]
  }, {
    "tStartMs": 922440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "We love to hear your ideas."
    } ]
  }, {
    "tStartMs": 923760,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Are there any ideas\nthat you can share with us"
    } ]
  }, {
    "tStartMs": 926610,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that are like, oh, like\nthat's actually really cool?"
    } ]
  }, {
    "tStartMs": 929610,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "- One idea was for\nclearing mines, landmines."
    } ]
  }, {
    "tStartMs": 933420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So the idea was that you'd actually"
    } ]
  }, {
    "tStartMs": 934860,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "run a vine robot through the field"
    } ]
  }, {
    "tStartMs": 937380,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and then detonate the landmines,\nand basically make a path"
    } ]
  }, {
    "tStartMs": 941130,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that civilians could\nwalk through the field."
    } ]
  }, {
    "tStartMs": 943800,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "So I thought that was kind of a cool idea."
    } ]
  }, {
    "tStartMs": 945620,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "- Do you think they'd\ncreate enough pressure"
    } ]
  }, {
    "tStartMs": 947580,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "to trigger these things?"
    } ]
  }, {
    "tStartMs": 948923,
    "dDurationMs": 2227,
    "segs": [ {
      "utf8": "- I think the idea was\nthey were gonna actually"
    } ]
  }, {
    "tStartMs": 951150,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "put explosives in the\nvine to detonate the,"
    } ]
  }, {
    "tStartMs": 954914,
    "dDurationMs": 2206,
    "segs": [ {
      "utf8": "yeah, the land mines themselves."
    } ]
  }, {
    "tStartMs": 957120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- I mean, I'm also thinking,\nnow that you mention that,"
    } ]
  }, {
    "tStartMs": 959280,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "like I'm thinking you could\nput metal detector type sensors"
    } ]
  }, {
    "tStartMs": 962790,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "on the vine robot.\n- Absolutely."
    } ]
  }, {
    "tStartMs": 963623,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "- So spread them across the field"
    } ]
  }, {
    "tStartMs": 965384,
    "dDurationMs": 1914,
    "segs": [ {
      "utf8": "and they'll pick up where the mines are."
    } ]
  }, {
    "tStartMs": 967298,
    "dDurationMs": 1732,
    "segs": [ {
      "utf8": "- I'll give you another crazy example."
    } ]
  }, {
    "tStartMs": 969030,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Another one was for space\napplications of docking,"
    } ]
  }, {
    "tStartMs": 974850,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so two spacecraft docking together,"
    } ]
  }, {
    "tStartMs": 977130,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "you have to make an airtight seal."
    } ]
  }, {
    "tStartMs": 980070,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And so, the idea was, well,"
    } ]
  }, {
    "tStartMs": 981270,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "maybe you could use a\nvine robot to do this."
    } ]
  }, {
    "tStartMs": 984060,
    "dDurationMs": 2892,
    "segs": [ {
      "utf8": "- Some sort of like airlock or\nsomething going out and then."
    } ]
  }, {
    "tStartMs": 986952,
    "dDurationMs": 888,
    "segs": [ {
      "utf8": "- So basically, yeah, you can imagine"
    } ]
  }, {
    "tStartMs": 987840,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the two tubes coming together, not sealed,"
    } ]
  }, {
    "tStartMs": 990570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and then the vine robot growing through"
    } ]
  }, {
    "tStartMs": 992160,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and basically making the seal."
    } ]
  }, {
    "tStartMs": 994020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Are there any updates\nabout the vine robot?"
    } ]
  }, {
    "tStartMs": 995820,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "Like have the medical\ntrials gotten anywhere?"
    } ]
  }, {
    "tStartMs": 1000110,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- So we just did a trial"
    } ]
  }, {
    "tStartMs": 1002720,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "with emergency medical\npractitioners using our device."
    } ]
  }, {
    "tStartMs": 1007340,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "We gave 'em five minutes of training,"
    } ]
  }, {
    "tStartMs": 1008720,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "we gave 'em the device,"
    } ]
  }, {
    "tStartMs": 1009980,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "and they were 90-ish percent\nsuccessful in intubating,"
    } ]
  }, {
    "tStartMs": 1014630,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "in very rapid, something like 20 seconds."
    } ]
  }, {
    "tStartMs": 1017090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh, wow."
    } ]
  }, {
    "tStartMs": 1017923,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "- The nice thing about our our device"
    } ]
  }, {
    "tStartMs": 1019460,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "is that if it fails,\nit fails in 20 seconds."
    } ]
  }, {
    "tStartMs": 1023360,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And so, it doesn't take\nthree minutes to attempt"
    } ]
  }, {
    "tStartMs": 1026030,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and then realize you didn't get it."
    } ]
  }, {
    "tStartMs": 1027560,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "I think something really nice about that"
    } ]
  }, {
    "tStartMs": 1028790,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "is that it is so rapid and easy"
    } ]
  }, {
    "tStartMs": 1030680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that even if it does fail,\nyou get another shot."
    } ]
  }, {
    "tStartMs": 1033350,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Yeah, I mean, that one\nseems like it's so close"
    } ]
  }, {
    "tStartMs": 1035210,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "to actually having a big\nreal world application."
    } ]
  }, {
    "tStartMs": 1039200,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "I mean, how common are intubations?"
    } ]
  }, {
    "tStartMs": 1041210,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- So intubations in the OR,"
    } ]
  }, {
    "tStartMs": 1044270,
    "dDurationMs": 1612,
    "segs": [ {
      "utf8": "so operating room are quite common."
    } ]
  }, {
    "tStartMs": 1045882,
    "dDurationMs": 1688,
    "segs": [ {
      "utf8": "I think like 15 million a year."
    } ]
  }, {
    "tStartMs": 1047570,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's probably not our initial target"
    } ]
  }, {
    "tStartMs": 1049070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "'cause those are very\nreliable, like 99% plus."
    } ]
  }, {
    "tStartMs": 1051860,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "The fundamental problem is\nthat the tools are designed"
    } ]
  }, {
    "tStartMs": 1054710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "for those doctors in those scenarios."
    } ]
  }, {
    "tStartMs": 1057410,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And what happens is those similar tools"
    } ]
  }, {
    "tStartMs": 1059180,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "get put out into the\nfield for an ambulance"
    } ]
  }, {
    "tStartMs": 1063350,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and a paramedic is trying\nto do an intubation,"
    } ]
  }, {
    "tStartMs": 1065450,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but they're doing it maybe in the dark,"
    } ]
  }, {
    "tStartMs": 1067160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "with someone in a poor body position,"
    } ]
  }, {
    "tStartMs": 1069110,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "where there's blood in the mouth."
    } ]
  }, {
    "tStartMs": 1071150,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So our device takes\nthat required skill out"
    } ]
  }, {
    "tStartMs": 1074240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and basically lets the vine robot"
    } ]
  }, {
    "tStartMs": 1075770,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "find the way into the trachea."
    } ]
  }, {
    "tStartMs": 1078050,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And so, pre-hospital,"
    } ]
  }, {
    "tStartMs": 1078883,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "there's around a million\nintubations a year."
    } ]
  }, {
    "tStartMs": 1081350,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "And we think many intubations\nthat aren't even attempted"
    } ]
  }, {
    "tStartMs": 1086090,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "because the tools just aren't there."
    } ]
  }, {
    "tStartMs": 1089900,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And then our kind of\nlong shot is eventually,"
    } ]
  }, {
    "tStartMs": 1093620,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "there's AEDs, the\ndefibrillators everywhere."
    } ]
  }, {
    "tStartMs": 1096950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "One issue there is there's not a way"
    } ]
  }, {
    "tStartMs": 1099020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to help the person breathe."
    } ]
  }, {
    "tStartMs": 1100610,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Possibly if we can make\nthis thing so simple,"
    } ]
  }, {
    "tStartMs": 1102980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "it could basically be packaged with a AED,"
    } ]
  }, {
    "tStartMs": 1105200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "where you could both get the heart going,"
    } ]
  }, {
    "tStartMs": 1107450,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and you could intubate\nand get the oxygen in."
    } ]
  }, {
    "tStartMs": 1110420,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "But I think we're close."
    } ]
  }, {
    "tStartMs": 1111719,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "It's pretty easy."
    } ]
  }, {
    "tStartMs": 1113240,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "You'll have to come back\nand get another video."
    } ]
  }, {
    "tStartMs": 1114830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "We'll let you intubate a cadaver."
    } ]
  }, {
    "tStartMs": 1116780,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "That'll be fun."
    } ]
  }, {
    "tStartMs": 1117620,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- So we've kind of answered this question,"
    } ]
  }, {
    "tStartMs": 1120170,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "but are these robots, vine\nrobots still being worked on?"
    } ]
  }, {
    "tStartMs": 1123500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- We have a project\nright now on anchoring,"
    } ]
  }, {
    "tStartMs": 1126140,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "especially we're interested in."
    } ]
  }, {
    "tStartMs": 1127250,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So if you think of a plant root."
    } ]
  }, {
    "tStartMs": 1129830,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If you ever try to pull out, I don't know,"
    } ]
  }, {
    "tStartMs": 1131420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "like a small shrub or something,"
    } ]
  }, {
    "tStartMs": 1133460,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "it's incredibly hard, right?"
    } ]
  }, {
    "tStartMs": 1134540,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Like you're looking at this,"
    } ]
  }, {
    "tStartMs": 1135373,
    "dDurationMs": 2364,
    "segs": [ {
      "utf8": "it's got like a half an inch stem"
    } ]
  }, {
    "tStartMs": 1137737,
    "dDurationMs": 886,
    "segs": [ {
      "utf8": "and you're pulling on\nit and pulling on it,"
    } ]
  }, {
    "tStartMs": 1138623,
    "dDurationMs": 1719,
    "segs": [ {
      "utf8": "it's like hundreds of pounds of force."
    } ]
  }, {
    "tStartMs": 1140342,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "So you're like how is this possible?"
    } ]
  }, {
    "tStartMs": 1142100,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "And I think one of the coolest things"
    } ]
  }, {
    "tStartMs": 1143270,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is that a hundred pounds\nof anchoring force"
    } ]
  }, {
    "tStartMs": 1146420,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "was created with almost no\nreaction force initially."
    } ]
  }, {
    "tStartMs": 1149270,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "There was like a seed that\nslowly grew down into the ground."
    } ]
  }, {
    "tStartMs": 1152960,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- It's like all these little tendrils,"
    } ]
  }, {
    "tStartMs": 1154850,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and I'm imagining the friction\nsums over all of those."
    } ]
  }, {
    "tStartMs": 1158870,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "- So basically, when you're\ntrying to go into the soil,"
    } ]
  }, {
    "tStartMs": 1162380,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "the thing resisting you is\nthe surface area of the tip."
    } ]
  }, {
    "tStartMs": 1165710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That's what you're pushing in."
    } ]
  }, {
    "tStartMs": 1167390,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And then what's giving\nyou the anchoring force"
    } ]
  }, {
    "tStartMs": 1169790,
    "dDurationMs": 1707,
    "segs": [ {
      "utf8": "is the surface area on the sides."
    } ]
  }, {
    "tStartMs": 1171497,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "And so, you can imagine, if\nyou clump 'em all together,"
    } ]
  }, {
    "tStartMs": 1174020,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "the area in the tips doesn't change,"
    } ]
  }, {
    "tStartMs": 1176387,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "but the surface area\nof the sides went down."
    } ]
  }, {
    "tStartMs": 1178400,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So you basically wanna split 'em up"
    } ]
  }, {
    "tStartMs": 1180530,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "into as many, practically."
    } ]
  }, {
    "tStartMs": 1183410,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So anyway, we're using that concept now"
    } ]
  }, {
    "tStartMs": 1185300,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to make these anchors,"
    } ]
  }, {
    "tStartMs": 1187310,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and we're working with\nNASA now one as well."
    } ]
  }, {
    "tStartMs": 1189050,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And so, it's like this deployable anchor,"
    } ]
  }, {
    "tStartMs": 1191960,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "it's very light."
    } ]
  }, {
    "tStartMs": 1193250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "You could throw it\nsomewhere, or just drop it,"
    } ]
  }, {
    "tStartMs": 1195620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and then the roots grow down,"
    } ]
  }, {
    "tStartMs": 1198380,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "there's four roots that\ngrow down into the ground,"
    } ]
  }, {
    "tStartMs": 1200990,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and it was something like\na hundred Newtons of force"
    } ]
  }, {
    "tStartMs": 1202640,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to pull it out."
    } ]
  }, {
    "tStartMs": 1203473,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "- Yeah, it sounds like a\nvery sci-fi type thing,"
    } ]
  }, {
    "tStartMs": 1206000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "where you could like\nthrow the root pack down"
    } ]
  }, {
    "tStartMs": 1208070,
    "dDurationMs": 2593,
    "segs": [ {
      "utf8": "and it just like phmf, and\nthen the roots roots grow out"
    } ]
  }, {
    "tStartMs": 1210663,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "and you're like, oh yeah,\nthe anchor is locked in."
    } ]
  }, {
    "tStartMs": 1214046,
    "dDurationMs": 2004,
    "segs": [ {
      "utf8": "- Yep, absolutely, absolutely."
    } ]
  }, {
    "tStartMs": 1216050,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "- Yeah, that's amazing."
    } ]
  }, {
    "tStartMs": 1218300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "After seeing the unstoppable robot,"
    } ]
  }, {
    "tStartMs": 1220460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "we returned to Elliot's lab a\nfew years later to see a robot"
    } ]
  }, {
    "tStartMs": 1223100,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that has conquered a\ntotally different specialty,"
    } ]
  }, {
    "tStartMs": 1225890,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the art of jumping."
    } ]
  }, {
    "tStartMs": 1228320,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "This tiny robot weighs\nless than a tennis ball,"
    } ]
  }, {
    "tStartMs": 1231140,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "and can jump higher than\nanything in the world."
    } ]
  }, {
    "tStartMs": 1237440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "In the competitive\nworld of jumping robots,"
    } ]
  }, {
    "tStartMs": 1239600,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the previous record was 3.7 meters,"
    } ]
  }, {
    "tStartMs": 1242510,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "enough to leap a single story building."
    } ]
  }, {
    "tStartMs": 1245120,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This jumper can reach 31 meters,"
    } ]
  }, {
    "tStartMs": 1247730,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "higher than a 10-story building."
    } ]
  }, {
    "tStartMs": 1252080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It could jump all the way from\nthe Statue of Liberty's feet"
    } ]
  }, {
    "tStartMs": 1254960,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "up to eye level."
    } ]
  }, {
    "tStartMs": 1258980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "For something to count as a jump,"
    } ]
  }, {
    "tStartMs": 1261080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "it must satisfy two criteria."
    } ]
  }, {
    "tStartMs": 1263480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "First, motion must be created\nby pushing off the ground."
    } ]
  }, {
    "tStartMs": 1266540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So a quadcopter doesn't count,"
    } ]
  }, {
    "tStartMs": 1268790,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "because it pushes off the air."
    } ]
  }, {
    "tStartMs": 1271490,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "And second, no mass can be lost."
    } ]
  }, {
    "tStartMs": 1274190,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "So rockets constantly ejecting\nburnt fuel are not jumping,"
    } ]
  }, {
    "tStartMs": 1279050,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and neither is an arrow\nlaunched from a bow."
    } ]
  }, {
    "tStartMs": 1281660,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The bow would have to come with the arrow"
    } ]
  }, {
    "tStartMs": 1283670,
    "dDurationMs": 1503,
    "segs": [ {
      "utf8": "for it to count as a jump."
    } ]
  }, {
    "tStartMs": 1286130,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Many animals jump,"
    } ]
  }, {
    "tStartMs": 1287660,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "from sand fleas, to\ngrasshoppers, to kangaroos,"
    } ]
  }, {
    "tStartMs": 1291170,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and they launch their bodies into the air"
    } ]
  }, {
    "tStartMs": 1293420,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "with a single stroke of their muscles."
    } ]
  }, {
    "tStartMs": 1296840,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The amount of energy delivered\nin that single stroke"
    } ]
  }, {
    "tStartMs": 1299630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "determines the jump height."
    } ]
  }, {
    "tStartMs": 1301580,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "So if you wanna jump higher,"
    } ]
  }, {
    "tStartMs": 1302720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "you have to maximize the\nstrength of the muscle."
    } ]
  }, {
    "tStartMs": 1305840,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "The best jumper in the animal kingdom"
    } ]
  }, {
    "tStartMs": 1307910,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "is the galago, or bush baby,"
    } ]
  }, {
    "tStartMs": 1311990,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and that's because 30% of\ntheir entire muscle mass"
    } ]
  }, {
    "tStartMs": 1314690,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is dedicated to jumping."
    } ]
  }, {
    "tStartMs": 1316760,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This allows the squirrel-sized primate"
    } ]
  }, {
    "tStartMs": 1319670,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to jump over two meters from a standstill."
    } ]
  }, {
    "tStartMs": 1322850,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "- It has like very small\narms and upper body,"
    } ]
  }, {
    "tStartMs": 1326000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and has just like huge jumping legs."
    } ]
  }, {
    "tStartMs": 1328190,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "It doesn't have better\nmuscles or anything,"
    } ]
  }, {
    "tStartMs": 1329320,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "it just has more of them."
    } ]
  }, {
    "tStartMs": 1334378,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "- [Derek] There are some\nclever jumping toys."
    } ]
  }, {
    "tStartMs": 1337181,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "- I feel like, there we go. Oh!"
    } ]
  }, {
    "tStartMs": 1339650,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- I used to play with\nthese poppers as a kid."
    } ]
  }, {
    "tStartMs": 1342140,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And when you deform a popper,"
    } ]
  }, {
    "tStartMs": 1343790,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "you store energy in its deformed shape."
    } ]
  }, {
    "tStartMs": 1347060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Effectively it becomes a spring."
    } ]
  }, {
    "tStartMs": 1349190,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And then, just like an animal,"
    } ]
  }, {
    "tStartMs": 1350660,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "in one stroke, it applies a\nlarge force to the ground,"
    } ]
  }, {
    "tStartMs": 1354050,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "launching itself into the air."
    } ]
  }, {
    "tStartMs": 1360650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "All elastic jumpers\nfollow the same principle"
    } ]
  }, {
    "tStartMs": 1363200,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of storing energy in a spring"
    } ]
  }, {
    "tStartMs": 1365210,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "and releasing that energy\nin a single stroke to jump."
    } ]
  }, {
    "tStartMs": 1369620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "But none of the jumping toys we had"
    } ]
  }, {
    "tStartMs": 1371270,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "could compare to this tiny robot."
    } ]
  }, {
    "tStartMs": 1376010,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Of all the things that I\nhave ever tried to film,"
    } ]
  }, {
    "tStartMs": 1378950,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "this is the most challenging."
    } ]
  }, {
    "tStartMs": 1381890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Because it's so small,\nit accelerates rapidly"
    } ]
  }, {
    "tStartMs": 1385010,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "and travels a huge distance on each jump."
    } ]
  }, {
    "tStartMs": 1389120,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "Each takeoff happened faster\nthan we could even register."
    } ]
  }, {
    "tStartMs": 1396500,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Now, jumping might sound\nlike a niche skill,"
    } ]
  }, {
    "tStartMs": 1399170,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but engineered jumpers would be perfect"
    } ]
  }, {
    "tStartMs": 1401360,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for exploring other worlds,"
    } ]
  }, {
    "tStartMs": 1403010,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "particularly where the atmosphere\nis thin or non-existent."
    } ]
  }, {
    "tStartMs": 1406490,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "On the moon, with one\nsixth the gravity of earth,"
    } ]
  }, {
    "tStartMs": 1409100,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "this robot would be able\nto leap 125 meters high"
    } ]
  }, {
    "tStartMs": 1412670,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and half a kilometer forward."
    } ]
  }, {
    "tStartMs": 1415340,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Rovers may struggle with\nsteep cliffs and deep craters,"
    } ]
  }, {
    "tStartMs": 1419180,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but jumpers could hop in and out,"
    } ]
  }, {
    "tStartMs": 1422000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "fetching samples to\nbring back to the rover."
    } ]
  }, {
    "tStartMs": 1424430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And you don't lose much\nenergy when jumping."
    } ]
  }, {
    "tStartMs": 1426800,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So if you could store the kinetic energy"
    } ]
  }, {
    "tStartMs": 1428750,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "back in the spring on landing,"
    } ]
  }, {
    "tStartMs": 1430610,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "the efficiency could be near perfect."
    } ]
  }, {
    "tStartMs": 1434810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The team has already started to build"
    } ]
  }, {
    "tStartMs": 1436370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "an entire fleet of jumping robots."
    } ]
  }, {
    "tStartMs": 1438710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Some of them can right\nthemselves after landing,"
    } ]
  }, {
    "tStartMs": 1441320,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "so they can take off again right away."
    } ]
  }, {
    "tStartMs": 1444920,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Others are steerable."
    } ]
  }, {
    "tStartMs": 1446630,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "They have three adjustable legs"
    } ]
  }, {
    "tStartMs": 1448370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that allow the jumper to\nlaunch in any direction."
    } ]
  }, {
    "tStartMs": 1451190,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- Essentially what we've done"
    } ]
  }, {
    "tStartMs": 1452030,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "is we've added three additional\nlegs that don't store energy"
    } ]
  }, {
    "tStartMs": 1455180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "but rather, allow it to\nform a tripod sort of"
    } ]
  }, {
    "tStartMs": 1457580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that allows it to point a direction"
    } ]
  }, {
    "tStartMs": 1458930,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "and launch in that direction."
    } ]
  }, {
    "tStartMs": 1462380,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- [Derek] But how does this\njumping mechanism work?"
    } ]
  }, {
    "tStartMs": 1465470,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Well, the main structure consists"
    } ]
  }, {
    "tStartMs": 1466820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of four pieces of carbon fiber,"
    } ]
  }, {
    "tStartMs": 1468680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "bound together by elastic bands."
    } ]
  }, {
    "tStartMs": 1471080,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Together, they create a spring"
    } ]
  }, {
    "tStartMs": 1473120,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "that stores all the energy\nneeded for the jump."
    } ]
  }, {
    "tStartMs": 1476330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "At the top of the robot is a small motor."
    } ]
  }, {
    "tStartMs": 1478880,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "A string wrapped around the axle"
    } ]
  }, {
    "tStartMs": 1480590,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "is connected to the bottom of the robot."
    } ]
  }, {
    "tStartMs": 1482960,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So when the motor is turned on,"
    } ]
  }, {
    "tStartMs": 1484820,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "it winds up the string,\ncompressing the robot,"
    } ]
  }, {
    "tStartMs": 1488150,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "and this stores energy in the\ncarbon fiber and rubber bands."
    } ]
  }, {
    "tStartMs": 1492710,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "After about a minute and a half,"
    } ]
  }, {
    "tStartMs": 1494450,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the structure reaches maximum compression."
    } ]
  }, {
    "tStartMs": 1497510,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "How do you know when to put it down?"
    } ]
  }, {
    "tStartMs": 1499310,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Basically once the bottom there"
    } ]
  }, {
    "tStartMs": 1500840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "sticks inward and it can stand up,"
    } ]
  }, {
    "tStartMs": 1502280,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "right now it would roll over,"
    } ]
  }, {
    "tStartMs": 1504170,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "then you can put it down.\n- Got it."
    } ]
  }, {
    "tStartMs": 1505490,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- So as soon as you can."
    } ]
  }, {
    "tStartMs": 1507380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- [Derek] And at this point,\na trigger releases the latch"
    } ]
  }, {
    "tStartMs": 1510410,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that's holding the string on the axle."
    } ]
  }, {
    "tStartMs": 1513200,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So all the string unspools all at once,"
    } ]
  }, {
    "tStartMs": 1515780,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and the energy stored in\nthe spring is released."
    } ]
  }, {
    "tStartMs": 1521570,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1524060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Derek] The jumper\ngoes from a standstill"
    } ]
  }, {
    "tStartMs": 1526040,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "to over a hundred kilometers an hour"
    } ]
  }, {
    "tStartMs": 1528470,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "in only nine milliseconds."
    } ]
  }, {
    "tStartMs": 1540320,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "That gives an acceleration of over 300 Gs."
    } ]
  }, {
    "tStartMs": 1545480,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "That would be enough to kill\nbasically any living creature."
    } ]
  }, {
    "tStartMs": 1550605,
    "dDurationMs": 2315,
    "segs": [ {
      "utf8": "- Watch out, watch out, watch out."
    } ]
  }, {
    "tStartMs": 1552920,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- But how does it jump"
    } ]
  }, {
    "tStartMs": 1554300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so much higher than everything else,"
    } ]
  }, {
    "tStartMs": 1556280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "nearly 10 times higher than\nthe previous record holder?"
    } ]
  }, {
    "tStartMs": 1559970,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Well, this jumper has three\nspecial design features."
    } ]
  }, {
    "tStartMs": 1563480,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "First, the jumper is incredibly\nlight, at just 30 grams."
    } ]
  }, {
    "tStartMs": 1567350,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It achieves this weight by employing"
    } ]
  }, {
    "tStartMs": 1568910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "a tiny motor and battery."
    } ]
  }, {
    "tStartMs": 1570890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Plus, its entire structure,"
    } ]
  }, {
    "tStartMs": 1572990,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "made of lightweight\ncarbon fiber and rubber,"
    } ]
  }, {
    "tStartMs": 1575180,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "doubles as the spring."
    } ]
  }, {
    "tStartMs": 1577070,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Per unit mass, natural latex\nrubber can store more energy"
    } ]
  }, {
    "tStartMs": 1580640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "than nearly any other elastic material,"
    } ]
  }, {
    "tStartMs": 1583160,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "7,000 joules per kilogram."
    } ]
  }, {
    "tStartMs": 1590810,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "And the design of the spring\nmakes it ideal for its purpose."
    } ]
  }, {
    "tStartMs": 1594350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Initially they tried\nusing only rubber bands"
    } ]
  }, {
    "tStartMs": 1596600,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "connected to hinged aluminum rods."
    } ]
  }, {
    "tStartMs": 1599210,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But with this design, when compressing it,"
    } ]
  }, {
    "tStartMs": 1601550,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the force rises to a\npeak and then decreases."
    } ]
  }, {
    "tStartMs": 1604910,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Just feels like it all of a sudden"
    } ]
  }, {
    "tStartMs": 1606320,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "got a lot easier to pull."
    } ]
  }, {
    "tStartMs": 1608840,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Another design with\nonly carbon fiber slats"
    } ]
  }, {
    "tStartMs": 1611390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "requires a lot of force to get started,"
    } ]
  }, {
    "tStartMs": 1613760,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and then it increases linearly after that."
    } ]
  }, {
    "tStartMs": 1616100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "There is more and more\nforce required to do this."
    } ]
  }, {
    "tStartMs": 1619040,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The ultimate design is a\nhybrid of these two approaches."
    } ]
  }, {
    "tStartMs": 1622010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "The benefit being, its\nforce profile is almost flat"
    } ]
  }, {
    "tStartMs": 1624980,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "over the entire range of compression."
    } ]
  }, {
    "tStartMs": 1627507,
    "dDurationMs": 1673,
    "segs": [ {
      "utf8": "It feels like that needs a lot of force."
    } ]
  }, {
    "tStartMs": 1629180,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And now it feels pretty steady"
    } ]
  }, {
    "tStartMs": 1631850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "with the amount of force\nthat I need to apply."
    } ]
  }, {
    "tStartMs": 1634040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Therefore, it provides\ndouble the energy storage"
    } ]
  }, {
    "tStartMs": 1636620,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "of a typical spring,"
    } ]
  }, {
    "tStartMs": 1637790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "where force is proportional\nto displacement."
    } ]
  }, {
    "tStartMs": 1640400,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "The researchers argue"
    } ]
  }, {
    "tStartMs": 1641390,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "this is the most efficient\nspring ever made."
    } ]
  }, {
    "tStartMs": 1646700,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Sometimes a string'll snap."
    } ]
  }, {
    "tStartMs": 1647750,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It's not always consistent"
    } ]
  }, {
    "tStartMs": 1649070,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "that it releases when it's supposed to."
    } ]
  }, {
    "tStartMs": 1652280,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- Oof!"
    } ]
  }, {
    "tStartMs": 1654350,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "- The string cut it. Lemme go restring it."
    } ]
  }, {
    "tStartMs": 1657657,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "I'll be right back."
    } ]
  }, {
    "tStartMs": 1658737,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] All right."
    } ]
  }, {
    "tStartMs": 1659570,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "You'd probably expect that lighter"
    } ]
  }, {
    "tStartMs": 1660800,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "would always be better with a jumper,"
    } ]
  }, {
    "tStartMs": 1662570,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "especially if the added\nweight is simply dead weight"
    } ]
  }, {
    "tStartMs": 1665000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "rather than anything useful,\nlike a spring or a motor."
    } ]
  }, {
    "tStartMs": 1667640,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "- So we're adding basically a\nchunk of steel to our jumper"
    } ]
  }, {
    "tStartMs": 1671540,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and it's gonna jump higher,"
    } ]
  }, {
    "tStartMs": 1673010,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and the key is that we're\nadding it to the top."
    } ]
  }, {
    "tStartMs": 1675710,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "You want your body,\nthe part that's moving,"
    } ]
  }, {
    "tStartMs": 1678320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "to weigh at least as much as the foot."
    } ]
  }, {
    "tStartMs": 1680540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "When your body's lighter,\nit's basically just collision,"
    } ]
  }, {
    "tStartMs": 1682820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "this energy transfer is very inefficient"
    } ]
  }, {
    "tStartMs": 1684620,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "and you don't jump very high."
    } ]
  }, {
    "tStartMs": 1687380,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- But the real secret to how this jumper"
    } ]
  }, {
    "tStartMs": 1688850,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "can achieve such heights\nis through something"
    } ]
  }, {
    "tStartMs": 1690920,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the researchers call work multiplication."
    } ]
  }, {
    "tStartMs": 1693650,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Unlike an animal, which can only jump"
    } ]
  }, {
    "tStartMs": 1695480,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "using a single stroke of its muscle,"
    } ]
  }, {
    "tStartMs": 1697490,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "an engineered jumper\ncan store up the energy"
    } ]
  }, {
    "tStartMs": 1699800,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "from many strokes,"
    } ]
  }, {
    "tStartMs": 1701150,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "or in this case, many\nrevolutions of its motor,"
    } ]
  }, {
    "tStartMs": 1704240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and that's how the motor can be so small."
    } ]
  }, {
    "tStartMs": 1706700,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It doesn't have to deliver\nthe energy all at once."
    } ]
  }, {
    "tStartMs": 1709490,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It builds it up gradually\nover a few minutes."
    } ]
  }, {
    "tStartMs": 1712280,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "So the trade-off is kind\nof like time for energy."
    } ]
  }, {
    "tStartMs": 1716390,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- [Elliot] Exactly."
    } ]
  }, {
    "tStartMs": 1717230,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Derek] And this is possible"
    } ]
  }, {
    "tStartMs": 1718130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "because there is a latch under tension"
    } ]
  }, {
    "tStartMs": 1720380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "preventing the spring from unspooling"
    } ]
  }, {
    "tStartMs": 1722240,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "until the robot is fully compressed."
    } ]
  }, {
    "tStartMs": 1724970,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "Interestingly, biological\norganisms do use latches."
    } ]
  }, {
    "tStartMs": 1729320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "For example, the sand flea,"
    } ]
  }, {
    "tStartMs": 1731000,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "which can jump incredibly\nhigh for its body size."
    } ]
  }, {
    "tStartMs": 1734540,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "- It has a muscle that is\nattached, let's say, right here,"
    } ]
  }, {
    "tStartMs": 1739010,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "is right inside of the pivot point."
    } ]
  }, {
    "tStartMs": 1741860,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So as it contracts that muscle,"
    } ]
  }, {
    "tStartMs": 1743300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "the leg doesn't extend, right?"
    } ]
  }, {
    "tStartMs": 1744920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It's actually closing it more."
    } ]
  }, {
    "tStartMs": 1747470,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "But then it has a second\nmuscle that pulls it out."
    } ]
  }, {
    "tStartMs": 1751130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's going to shift this muscle"
    } ]
  }, {
    "tStartMs": 1753470,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "ever so slightly outside the pivot point."
    } ]
  }, {
    "tStartMs": 1757220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- That's wild."
    } ]
  }, {
    "tStartMs": 1758053,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "So there's these two\nmuscles that are working."
    } ]
  }, {
    "tStartMs": 1760130,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- So here's your big power muscle."
    } ]
  }, {
    "tStartMs": 1761870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Here's your trigger muscle."
    } ]
  }, {
    "tStartMs": 1763250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It's a torque reversal mechanism."
    } ]
  }, {
    "tStartMs": 1764960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And then all of a sudden, it shoots."
    } ]
  }, {
    "tStartMs": 1767360,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- [Derek] But even though the\nbiological world has latches,"
    } ]
  }, {
    "tStartMs": 1770210,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "no organism has developed\nwork multiplication"
    } ]
  }, {
    "tStartMs": 1772760,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "for a jump from standstill,\nat least not internally."
    } ]
  }, {
    "tStartMs": 1777500,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Spider monkeys have been observed"
    } ]
  }, {
    "tStartMs": 1779150,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "pulling back a branch hand over hand"
    } ]
  }, {
    "tStartMs": 1781250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "using multiple muscle strokes"
    } ]
  }, {
    "tStartMs": 1783500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "stored in the bend of the branch"
    } ]
  }, {
    "tStartMs": 1785570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to catapult themselves forward."
    } ]
  }, {
    "tStartMs": 1788390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "There's a spider that\nshoots out a silky string,"
    } ]
  }, {
    "tStartMs": 1791000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "which they pull back multiple times"
    } ]
  }, {
    "tStartMs": 1792680,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "in order to slingshot\nthemselves to another location."
    } ]
  }, {
    "tStartMs": 1796560,
    "dDurationMs": 1258,
    "segs": [ {
      "utf8": "So it's like slingshotting itself?"
    } ]
  }, {
    "tStartMs": 1797818,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "- Yes, they're called\nthe slingshot spider."
    } ]
  }, {
    "tStartMs": 1802302,
    "dDurationMs": 2048,
    "segs": [ {
      "utf8": "- Now, I tried jumping in moon boots"
    } ]
  }, {
    "tStartMs": 1804350,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "to see if they would help me go higher."
    } ]
  }, {
    "tStartMs": 1806239,
    "dDurationMs": 4321,
    "segs": [ {
      "utf8": "(remarks drowned out by background noise)"
    } ]
  }, {
    "tStartMs": 1810560,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "Okay. Oof."
    } ]
  }, {
    "tStartMs": 1814370,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And it certainly felt like they did,"
    } ]
  }, {
    "tStartMs": 1816890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but Elliot pointed out\nthat from a standing start,"
    } ]
  }, {
    "tStartMs": 1819830,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "they don't actually help much."
    } ]
  }, {
    "tStartMs": 1821300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- Kind of build it, build\nit, build it, and then go."
    } ]
  }, {
    "tStartMs": 1823580,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 1824450,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Only if you jump a few times\nbefore can you store up"
    } ]
  }, {
    "tStartMs": 1827510,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "some of the previous jumps\nenergy in the elastic bands,"
    } ]
  }, {
    "tStartMs": 1830780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and then that energy helps launch you"
    } ]
  }, {
    "tStartMs": 1832910,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "higher on the following jump."
    } ]
  }, {
    "tStartMs": 1837530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "For years, engineered\njumping was developed"
    } ]
  }, {
    "tStartMs": 1839840,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to mimic biological jumping."
    } ]
  }, {
    "tStartMs": 1841700,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But with work multiplication,\nit gained an advantage."
    } ]
  }, {
    "tStartMs": 1845060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "If you can generate a\nlarge burst of energy"
    } ]
  }, {
    "tStartMs": 1847220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "simply by running a motor for a long time,"
    } ]
  }, {
    "tStartMs": 1849740,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "the power of the motor is no\nlonger the limiting factor,"
    } ]
  }, {
    "tStartMs": 1852770,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the spring is."
    } ]
  }, {
    "tStartMs": 1853970,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "So you can focus on making"
    } ]
  }, {
    "tStartMs": 1855560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the most powerful spring possible."
    } ]
  }, {
    "tStartMs": 1858080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This jumper has nearly maximized"
    } ]
  }, {
    "tStartMs": 1860240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the achievable height with this spring."
    } ]
  }, {
    "tStartMs": 1862400,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Assuming an infinitely light motor"
    } ]
  }, {
    "tStartMs": 1864140,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "with infinite time to wind up,"
    } ]
  }, {
    "tStartMs": 1866180,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "the highest possible jump\nwith this compression spring"
    } ]
  }, {
    "tStartMs": 1868880,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "is only around 19% higher\nthan what they've achieved."
    } ]
  }, {
    "tStartMs": 1872750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "If you want to incorporate air resistance"
    } ]
  }, {
    "tStartMs": 1874880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and play with aerodynamics,"
    } ]
  }, {
    "tStartMs": 1876320,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "another way to send the jumper higher"
    } ]
  }, {
    "tStartMs": 1878090,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "is to make it 10 times\nisometrically larger,"
    } ]
  }, {
    "tStartMs": 1881060,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "leading to a 15 to 20% higher jump."
    } ]
  }, {
    "tStartMs": 1883970,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- So we're in kind of\nan intermediate scale"
    } ]
  }, {
    "tStartMs": 1885920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "where we still are\ngetting hit by air drag,"
    } ]
  }, {
    "tStartMs": 1887600,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but it's not as bad as the flea."
    } ]
  }, {
    "tStartMs": 1889580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "If we went 10 times bigger,"
    } ]
  }, {
    "tStartMs": 1890930,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "we could actually avoid\nair drag completely."
    } ]
  }, {
    "tStartMs": 1893870,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- This works since if\nthe jumper is scaled up"
    } ]
  }, {
    "tStartMs": 1896000,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "10 times on all sides,"
    } ]
  }, {
    "tStartMs": 1897650,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the cross-sectional area\nincreases by a hundred,"
    } ]
  }, {
    "tStartMs": 1900470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "which increases the drag force,"
    } ]
  }, {
    "tStartMs": 1902540,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but the jumper's mass\nincreases by a thousand."
    } ]
  }, {
    "tStartMs": 1906020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "So it has way more inertia,"
    } ]
  }, {
    "tStartMs": 1908090,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "meaning the drag force affects it less."
    } ]
  }, {
    "tStartMs": 1913370,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "The entire concept of work multiplication"
    } ]
  }, {
    "tStartMs": 1915740,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "could bring robots to the next level."
    } ]
  }, {
    "tStartMs": 1918290,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Currently, motors and robots\nhave to be relatively small"
    } ]
  }, {
    "tStartMs": 1921320,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "so they remain portable."
    } ]
  }, {
    "tStartMs": 1923030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But the simple principle\nof building up the energy"
    } ]
  }, {
    "tStartMs": 1925130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "from multiple turns of a motor over time"
    } ]
  }, {
    "tStartMs": 1927440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "would allow robots to\nstore and then release"
    } ]
  }, {
    "tStartMs": 1930560,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "huge amounts of energy,"
    } ]
  }, {
    "tStartMs": 1932270,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "and set some world records in the process."
    } ]
  }, {
    "tStartMs": 1936860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "When we visited you, we\nwere looking at 110 feet"
    } ]
  }, {
    "tStartMs": 1939980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and it was the record holder."
    } ]
  }, {
    "tStartMs": 1941780,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "My question, is that still\nthe record as far as you know?"
    } ]
  }, {
    "tStartMs": 1945114,
    "dDurationMs": 1646,
    "segs": [ {
      "utf8": "- It is."
    } ]
  }, {
    "tStartMs": 1946760,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I also challenge all\nthe viewers to beat it,"
    } ]
  }, {
    "tStartMs": 1948890,
    "dDurationMs": 1565,
    "segs": [ {
      "utf8": "because it is beatable."
    } ]
  }, {
    "tStartMs": 1950455,
    "dDurationMs": 3325,
    "segs": [ {
      "utf8": "So I hope someone in the\nnext few years will beat it,"
    } ]
  }, {
    "tStartMs": 1953780,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and if not, we'll beat our own record,"
    } ]
  }, {
    "tStartMs": 1955310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because it's beatable."
    } ]
  }, {
    "tStartMs": 1957440,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I will say that much."
    } ]
  }, {
    "tStartMs": 1958400,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "- Are there more happening\nwith the jumping robots?"
    } ]
  }, {
    "tStartMs": 1961483,
    "dDurationMs": 3277,
    "segs": [ {
      "utf8": "- We have a whole nother\nproject on jumping,"
    } ]
  }, {
    "tStartMs": 1964760,
    "dDurationMs": 2368,
    "segs": [ {
      "utf8": "which we also think will beat it,"
    } ]
  }, {
    "tStartMs": 1967128,
    "dDurationMs": 1142,
    "segs": [ {
      "utf8": "and it doesn't even use spring."
    } ]
  }, {
    "tStartMs": 1968270,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "So I won't give away our secrets yet."
    } ]
  }, {
    "tStartMs": 1971960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "But keep an eye out for that one too,"
    } ]
  }, {
    "tStartMs": 1973940,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "'cause that's gonna be fun."
    } ]
  }, {
    "tStartMs": 1974870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- So you have another jumping robot,"
    } ]
  }, {
    "tStartMs": 1976970,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "which has a totally novel design?"
    } ]
  }, {
    "tStartMs": 1979700,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 1980870,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- And you think it's gonna be better"
    } ]
  }, {
    "tStartMs": 1982040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "than the one that you had before?"
    } ]
  }, {
    "tStartMs": 1984140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- Correct.\n- Wow, that's extreme."
    } ]
  }, {
    "tStartMs": 1986720,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And in terms of making\nthese things applicable?"
    } ]
  }, {
    "tStartMs": 1990410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Yeah, so I mean, we do\nhave a project with NASA."
    } ]
  }, {
    "tStartMs": 1992810,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I will say, our stuff with\nNASA moves pretty slow,"
    } ]
  }, {
    "tStartMs": 1995900,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "just in terms of what\nthey really care about"
    } ]
  }, {
    "tStartMs": 1999470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is getting something\nreally, really reliable."
    } ]
  }, {
    "tStartMs": 2001870,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "If they're gonna send it to\nthe moon, it can't mess up."
    } ]
  }, {
    "tStartMs": 2004810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And so, that's a slow going process."
    } ]
  }, {
    "tStartMs": 2007450,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But I just think that's still a goal,"
    } ]
  }, {
    "tStartMs": 2009280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "is to get it to the moon."
    } ]
  }, {
    "tStartMs": 2011530,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- It would be like the next\nMars helicopter or something."
    } ]
  }, {
    "tStartMs": 2014890,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- I think that's a really good analogy."
    } ]
  }, {
    "tStartMs": 2016060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So the Mars helicopter has\njust been doing awesome,"
    } ]
  }, {
    "tStartMs": 2019540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "basically being this little scout"
    } ]
  }, {
    "tStartMs": 2020740,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "that can just go out\nand get some nice views"
    } ]
  }, {
    "tStartMs": 2024070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of where the rover might need to go,"
    } ]
  }, {
    "tStartMs": 2025360,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "or maybe getting some samples."
    } ]
  }, {
    "tStartMs": 2027670,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "You can't have a helicopter\non the moon, but you can jump."
    } ]
  }, {
    "tStartMs": 2030610,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "And we think we can get\npretty similar performance"
    } ]
  }, {
    "tStartMs": 2034990,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "in terms of height and stuff like that"
    } ]
  }, {
    "tStartMs": 2036910,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "with jumping on the moon\ncompared to the helicopter."
    } ]
  }, {
    "tStartMs": 2039220,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So yeah, no, that's a great analogy."
    } ]
  }, {
    "tStartMs": 2040990,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Are there any interesting emails"
    } ]
  }, {
    "tStartMs": 2042520,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that came about from\nthe jumping robot video?"
    } ]
  }, {
    "tStartMs": 2045190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- So a lot of people want to make one,"
    } ]
  }, {
    "tStartMs": 2046990,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and I will say, it's really hard,"
    } ]
  }, {
    "tStartMs": 2049510,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and I keep writing that it's really hard."
    } ]
  }, {
    "tStartMs": 2051100,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Every piece in that robot was..."
    } ]
  }, {
    "tStartMs": 2055090,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They talk about safety\nfactors in engineering"
    } ]
  }, {
    "tStartMs": 2057130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "where you're supposed to\nhave a good safety factor,"
    } ]
  }, {
    "tStartMs": 2058510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and we had no safety factors in anything."
    } ]
  }, {
    "tStartMs": 2060490,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And so, pretty much everything\nwas near its failure limit."
    } ]
  }, {
    "tStartMs": 2063790,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And so, that just made it incredibly hard."
    } ]
  }, {
    "tStartMs": 2065890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But what we're trying\nto do actually right now"
    } ]
  }, {
    "tStartMs": 2068590,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "is put together a tutorial to make like a,"
    } ]
  }, {
    "tStartMs": 2071890,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "you know, it's not gonna\njump a hundred feet,"
    } ]
  }, {
    "tStartMs": 2073150,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but it'll jump maybe 20 or 30 feet."
    } ]
  }, {
    "tStartMs": 2075280,
    "dDurationMs": 857,
    "segs": [ {
      "utf8": "Stay tuned for that,"
    } ]
  }, {
    "tStartMs": 2076137,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "'cause I think that would\nbe a fun way to get people"
    } ]
  }, {
    "tStartMs": 2078190,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to build one themselves and try it out."
    } ]
  }, {
    "tStartMs": 2081610,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I will say though that if\nyou really push the limits,"
    } ]
  }, {
    "tStartMs": 2084430,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "what we're trying to do,"
    } ]
  }, {
    "tStartMs": 2086170,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "wear your safety glasses and\nyour gloves, and all of that."
    } ]
  }, {
    "tStartMs": 2088950,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "Because the number of\nshards of carbon fiber"
    } ]
  }, {
    "tStartMs": 2091600,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "I've gotten into my fingers."
    } ]
  }, {
    "tStartMs": 2092987,
    "dDurationMs": 3473,
    "segs": [ {
      "utf8": "- Oh, no. Brutal."
    } ]
  }, {
    "tStartMs": 2096460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "What is the biggest thing you learned"
    } ]
  }, {
    "tStartMs": 2098740,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "building the jumping robot?"
    } ]
  }, {
    "tStartMs": 2100600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- How many things can go wrong"
    } ]
  }, {
    "tStartMs": 2103060,
    "dDurationMs": 1787,
    "segs": [ {
      "utf8": "when you're trying to build\nsomething really cool."
    } ]
  }, {
    "tStartMs": 2104847,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "'Cause this was years\nand years of failing,"
    } ]
  }, {
    "tStartMs": 2107950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "over and over, and over and over again."
    } ]
  }, {
    "tStartMs": 2109690,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So I think something that sticks out to me"
    } ]
  }, {
    "tStartMs": 2112480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "is that it takes a lot of failure"
    } ]
  }, {
    "tStartMs": 2115480,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "to get a success like that."
    } ]
  }, {
    "tStartMs": 2118360,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Would anyone ever say to you,"
    } ]
  }, {
    "tStartMs": 2120490,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "well, why did it take that many years?"
    } ]
  }, {
    "tStartMs": 2123220,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Could you not have\nmodeled out the springs,"
    } ]
  }, {
    "tStartMs": 2127480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "like done some simulations of it"
    } ]
  }, {
    "tStartMs": 2129730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "before you actually build the thing?"
    } ]
  }, {
    "tStartMs": 2131410,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Well, no, and I should mention too"
    } ]
  }, {
    "tStartMs": 2132670,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that it's not like we didn't\ndo any modeling or simulation."
    } ]
  }, {
    "tStartMs": 2135340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That's all part of our cycle too."
    } ]
  }, {
    "tStartMs": 2137380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But the problem is, I mean, we\ndidn't even know what shape."
    } ]
  }, {
    "tStartMs": 2139960,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "We went through so many different\nconfigurations of robots."
    } ]
  }, {
    "tStartMs": 2142990,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Like some were kind of this ball shape,"
    } ]
  }, {
    "tStartMs": 2144970,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but we had other robots\nthat were more stick like,"
    } ]
  }, {
    "tStartMs": 2147550,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "rubber band based."
    } ]
  }, {
    "tStartMs": 2149020,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "It's like this crazy\nsearch over a huge space,"
    } ]
  }, {
    "tStartMs": 2152440,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "and comparing all kinds\nof different trade offs."
    } ]
  }, {
    "tStartMs": 2156130,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "I think that's a reasonable amount of time"
    } ]
  }, {
    "tStartMs": 2157510,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "to make a world record,\nbut that's just me."
    } ]
  }, {
    "tStartMs": 2161765,
    "dDurationMs": 2015,
    "segs": [ {
      "utf8": "- The jumper robot can jump so high"
    } ]
  }, {
    "tStartMs": 2163780,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "precisely because it's built\nof rubber and carbon fiber,"
    } ]
  }, {
    "tStartMs": 2166840,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "with a tiny body and massive legs."
    } ]
  }, {
    "tStartMs": 2169330,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Its whole body is designed\nfor one physical purpose."
    } ]
  }, {
    "tStartMs": 2172990,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The specialization of robots"
    } ]
  }, {
    "tStartMs": 2174610,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "is also natural in academic research,"
    } ]
  }, {
    "tStartMs": 2176560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "since it's easier for\nscientists to isolate"
    } ]
  }, {
    "tStartMs": 2178480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and understand one ability."
    } ]
  }, {
    "tStartMs": 2180460,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "These may later be included"
    } ]
  }, {
    "tStartMs": 2181720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "into a single more complex robot."
    } ]
  }, {
    "tStartMs": 2184300,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "People expect sort of the Boston Dynamics,"
    } ]
  }, {
    "tStartMs": 2187510,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "humanoid type robots."
    } ]
  }, {
    "tStartMs": 2189670,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Why have you investigated\nthese sort of other"
    } ]
  }, {
    "tStartMs": 2193090,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "very strange looking type robots?"
    } ]
  }, {
    "tStartMs": 2196210,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "- The thing that maybe\nunifies all of them is,"
    } ]
  }, {
    "tStartMs": 2200980,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they're mostly about\nmechanical design, my robots,"
    } ]
  }, {
    "tStartMs": 2203290,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and less so about controls, and vision,"
    } ]
  }, {
    "tStartMs": 2206020,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and AI, and that side."
    } ]
  }, {
    "tStartMs": 2207430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And so, often we think of what we do"
    } ]
  }, {
    "tStartMs": 2209740,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "are kind of adjacent to core robots."
    } ]
  }, {
    "tStartMs": 2212590,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But our lab isn't as focused\non traditional robotics"
    } ]
  }, {
    "tStartMs": 2215290,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "just because I find more joy\nmyself in mechanical design."
    } ]
  }, {
    "tStartMs": 2219400,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "So that's what I like to do."
    } ]
  }, {
    "tStartMs": 2220540,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "- Do you have a personal favorite robot?"
    } ]
  }, {
    "tStartMs": 2225580,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- I can't play favorites with my robots."
    } ]
  }, {
    "tStartMs": 2227110,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- I know, it's like picking\namongst your children."
    } ]
  }, {
    "tStartMs": 2228970,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Like it's just impossible."
    } ]
  }, {
    "tStartMs": 2229930,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- I love all my robots.\nI love all my robots."
    } ]
  }, {
    "tStartMs": 2234263,
    "dDurationMs": 3407,
    "segs": [ {
      "utf8": "I will say though that the\njumper, there was a certain,"
    } ]
  }, {
    "tStartMs": 2237670,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "it took a lot of learning\nfrom our failures"
    } ]
  }, {
    "tStartMs": 2240593,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "and revising it."
    } ]
  }, {
    "tStartMs": 2242260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And so, when we finally\ngot that one working,"
    } ]
  }, {
    "tStartMs": 2245320,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "I think that was really satisfying."
    } ]
  }, {
    "tStartMs": 2247930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- From your perspective,\nhow did our collaboration"
    } ]
  }, {
    "tStartMs": 2250690,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "come to be in the first place?"
    } ]
  }, {
    "tStartMs": 2252910,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Oh, wow."
    } ]
  }, {
    "tStartMs": 2254680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Okay. That's a fun story."
    } ]
  }, {
    "tStartMs": 2256120,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "So you sent me an email, I\ndon't know how many years ago,"
    } ]
  }, {
    "tStartMs": 2260500,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "maybe five years ago, something\nlike this, and I ignored it."
    } ]
  }, {
    "tStartMs": 2263980,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And I went into lab one day, I\njust mentioned to my student,"
    } ]
  }, {
    "tStartMs": 2268120,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "I was like, oh, some guy\nemailed about making a video."
    } ]
  }, {
    "tStartMs": 2271367,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "And he is like, \"Yeah, who was it?"
    } ]
  }, {
    "tStartMs": 2273166,
    "dDurationMs": 2124,
    "segs": [ {
      "utf8": "Maybe I could help out or something.\""
    } ]
  }, {
    "tStartMs": 2275290,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "So I forwarded it to him, he's like,"
    } ]
  }, {
    "tStartMs": 2276257,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "\"Do you know who this is?\""
    } ]
  }, {
    "tStartMs": 2279340,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So then we responded."
    } ]
  }, {
    "tStartMs": 2280780,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And we appreciated the effort you put in"
    } ]
  }, {
    "tStartMs": 2283450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to the details in getting the story right."
    } ]
  }, {
    "tStartMs": 2285760,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I forget how long we had this call."
    } ]
  }, {
    "tStartMs": 2287110,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I had this call with Emily,"
    } ]
  }, {
    "tStartMs": 2288850,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it was maybe four hours or something."
    } ]
  }, {
    "tStartMs": 2290170,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "We went through the\ndetails of jumping theory."
    } ]
  }, {
    "tStartMs": 2292510,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "'Cause she wanna get everything just right"
    } ]
  }, {
    "tStartMs": 2293860,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "for that jumping video."
    } ]
  }, {
    "tStartMs": 2294760,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "As an academic, we care about that stuff"
    } ]
  }, {
    "tStartMs": 2296470,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "and we want it to be right."
    } ]
  }, {
    "tStartMs": 2300610,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- But the most specialized perfected match"
    } ]
  }, {
    "tStartMs": 2302650,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "between a robot's build in its abilities"
    } ]
  }, {
    "tStartMs": 2304690,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "comes from one competition\nthat's been refining this"
    } ]
  }, {
    "tStartMs": 2307510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "for nearly 50 years."
    } ]
  }, {
    "tStartMs": 2309610,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Micromouse is the oldest robotics\ncompetition in the world."
    } ]
  }, {
    "tStartMs": 2312850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "It's like the Formula 1 of robotics,"
    } ]
  }, {
    "tStartMs": 2315640,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "but you have to see their\nspeed to believe it."
    } ]
  }, {
    "tStartMs": 2318370,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This tiny robot mouse can finish this maze"
    } ]
  }, {
    "tStartMs": 2321280,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "in just six seconds."
    } ]
  }, {
    "tStartMs": 2324685,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(rousing music)"
    } ]
  }, {
    "tStartMs": 2330040,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Every year around the world,"
    } ]
  }, {
    "tStartMs": 2331600,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "people compete in the\noldest robotics race."
    } ]
  }, {
    "tStartMs": 2334450,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "The goal is simple:"
    } ]
  }, {
    "tStartMs": 2335860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "get to the end of the\nmaze as fast as possible."
    } ]
  }, {
    "tStartMs": 2338260,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Person who came second"
    } ]
  }, {
    "tStartMs": 2340726,
    "dDurationMs": 1404,
    "segs": [ {
      "utf8": "(spectators cheering)"
    } ]
  }, {
    "tStartMs": 2342130,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "lost by 20 milliseconds."
    } ]
  }, {
    "tStartMs": 2344200,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "- [Derek] But competition\nhas grown fierce."
    } ]
  }, {
    "tStartMs": 2347890,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "- When somebody saw my design,\nthey said, you're crazy."
    } ]
  }, {
    "tStartMs": 2353110,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- [Derek] Why is there so much tension?"
    } ]
  }, {
    "tStartMs": 2354220,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "What's riding on it?"
    } ]
  }, {
    "tStartMs": 2356089,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "Honor?\n- Honor."
    } ]
  }, {
    "tStartMs": 2358431,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 2365380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "- [Derek] In 1952,\nmathematician Claude Shannon"
    } ]
  }, {
    "tStartMs": 2367960,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "constructed an electronic\nmouse named Theseus"
    } ]
  }, {
    "tStartMs": 2370990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "that could solve a maze."
    } ]
  }, {
    "tStartMs": 2373060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "The trick to making the mouse intelligent"
    } ]
  }, {
    "tStartMs": 2375670,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "was hidden in a computer\nbuilt into the maze itself,"
    } ]
  }, {
    "tStartMs": 2379240,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "made of telephone relay switches."
    } ]
  }, {
    "tStartMs": 2381790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The mouse was just a magnet\non wheels essentially,"
    } ]
  }, {
    "tStartMs": 2385000,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "following an electromagnet"
    } ]
  }, {
    "tStartMs": 2386350,
    "dDurationMs": 2504,
    "segs": [ {
      "utf8": "controlled by the position\nof the relay switches."
    } ]
  }, {
    "tStartMs": 2388854,
    "dDurationMs": 1896,
    "segs": [ {
      "utf8": "- [Claude] He is now exploring the maze"
    } ]
  }, {
    "tStartMs": 2390750,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "using a rather involved\nstrategy of trial and error."
    } ]
  }, {
    "tStartMs": 2393800,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "As he finds the correct path,"
    } ]
  }, {
    "tStartMs": 2395590,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "he registers the\ninformation in his memory."
    } ]
  }, {
    "tStartMs": 2398320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Later, I can put him down\nin any part of the maze"
    } ]
  }, {
    "tStartMs": 2400510,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that he's already explored"
    } ]
  }, {
    "tStartMs": 2402190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and he'll be able to\ngo directly to the goal"
    } ]
  }, {
    "tStartMs": 2404080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "without making a single false turn."
    } ]
  }, {
    "tStartMs": 2406390,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Theseus is often referred to"
    } ]
  }, {
    "tStartMs": 2408130,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "as one of the first examples\nof machine learning."
    } ]
  }, {
    "tStartMs": 2410980,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "A director at Google recently said"
    } ]
  }, {
    "tStartMs": 2412750,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "that it inspired the whole field of AI."
    } ]
  }, {
    "tStartMs": 2416890,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "25 years later, editors at\nthe Institute of Electrical"
    } ]
  }, {
    "tStartMs": 2420070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and Electronics Engineers, or IEEE,"
    } ]
  }, {
    "tStartMs": 2422650,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "caught wind of a contest\nfor electronic mice,"
    } ]
  }, {
    "tStartMs": 2425410,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "or le mouse electronique,\nas they had heard."
    } ]
  }, {
    "tStartMs": 2428440,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "They were ecstatic."
    } ]
  }, {
    "tStartMs": 2429850,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Were these the successors Theseus?"
    } ]
  }, {
    "tStartMs": 2432520,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But something had been\nlost in translation."
    } ]
  }, {
    "tStartMs": 2434860,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "These mice were just batteries in cases,"
    } ]
  }, {
    "tStartMs": 2437950,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "not robots capable of\nintelligent behavior."
    } ]
  }, {
    "tStartMs": 2441070,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But the misunderstanding stuck\nwith them, and they wondered,"
    } ]
  }, {
    "tStartMs": 2444100,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "why couldn't we hold that\ncompetition ourselves?"
    } ]
  }, {
    "tStartMs": 2447850,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "In 1977, the announcement for IEEE's"
    } ]
  }, {
    "tStartMs": 2451060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "amazing Micromouse Maze Contest"
    } ]
  }, {
    "tStartMs": 2453160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "attracted over 6,000 entrants."
    } ]
  }, {
    "tStartMs": 2455950,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But the number of successful\ncompetitors dwindled rapidly."
    } ]
  }, {
    "tStartMs": 2459550,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Eventually, just 15 entrants\nreached the finals in 1979."
    } ]
  }, {
    "tStartMs": 2464770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But by this point, the\ncontest had garnered"
    } ]
  }, {
    "tStartMs": 2466870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "enough public interest to be broadcast"
    } ]
  }, {
    "tStartMs": 2468820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "nationwide on the evening news."
    } ]
  }, {
    "tStartMs": 2471460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And just like the rumor that\ninspired the competition,"
    } ]
  }, {
    "tStartMs": 2474280,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "Micromouse began to\nspread across the world."
    } ]
  }, {
    "tStartMs": 2477733,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "♪ Micromouse for the taking ♪"
    } ]
  }, {
    "tStartMs": 2481036,
    "dDurationMs": 3527,
    "segs": [ {
      "utf8": "♪ Micromouse, it's here and now ♪"
    } ]
  }, {
    "tStartMs": 2484563,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "♪ Take a chance and start creating ♪"
    } ]
  }, {
    "tStartMs": 2492789,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "- The Micromouse."
    } ]
  }, {
    "tStartMs": 2495265,
    "dDurationMs": 1907,
    "segs": [ {
      "utf8": "- [All] Micromouse!"
    } ]
  }, {
    "tStartMs": 2497172,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 2528820,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Even people in the top two or three,"
    } ]
  }, {
    "tStartMs": 2531310,
    "dDurationMs": 1977,
    "segs": [ {
      "utf8": "you can see them trying\nto set their mice up,"
    } ]
  }, {
    "tStartMs": 2533287,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "and they can barely find\nthe buttons to press"
    } ]
  }, {
    "tStartMs": 2535570,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "because it's absolutely nerve wracking."
    } ]
  }, {
    "tStartMs": 2539311,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 2544090,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "It doesn't matter what it was."
    } ]
  }, {
    "tStartMs": 2545080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It could be horse racing,\nit could be motor racing,"
    } ]
  }, {
    "tStartMs": 2546940,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "it could be mouse racing."
    } ]
  }, {
    "tStartMs": 2551874,
    "dDurationMs": 1856,
    "segs": [ {
      "utf8": "If you have a shred of\ncompetitiveness in you,"
    } ]
  }, {
    "tStartMs": 2553730,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "you wanna win, right?"
    } ]
  }, {
    "tStartMs": 2559937,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "- [Derek] Just like a real mouse,"
    } ]
  }, {
    "tStartMs": 2561563,
    "dDurationMs": 2447,
    "segs": [ {
      "utf8": "a micromouse has to be fully autonomous,"
    } ]
  }, {
    "tStartMs": 2564010,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "no internet connection,\nno GPS or remote control,"
    } ]
  }, {
    "tStartMs": 2567400,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and no nudging it to help it get unstuck."
    } ]
  }, {
    "tStartMs": 2570250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It has to fit all its computing, motors,"
    } ]
  }, {
    "tStartMs": 2572800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "sensors, and power supply"
    } ]
  }, {
    "tStartMs": 2574180,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "in a frame no longer or\nwider than 25 centimeters."
    } ]
  }, {
    "tStartMs": 2578860,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "There isn't a limit on\nthe height of the mouse,"
    } ]
  }, {
    "tStartMs": 2581230,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but the rules don't\nallow climbing, flight,"
    } ]
  }, {
    "tStartMs": 2583690,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or any forms of combustion."
    } ]
  }, {
    "tStartMs": 2586030,
    "dDurationMs": 3487,
    "segs": [ {
      "utf8": "So rocket propulsion for\nexample, is out of the equation."
    } ]
  }, {
    "tStartMs": 2591714,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(whistle being blown)"
    } ]
  }, {
    "tStartMs": 2598071,
    "dDurationMs": 3559,
    "segs": [ {
      "utf8": "The maze itself is a square\nabout three meters on each side,"
    } ]
  }, {
    "tStartMs": 2601630,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "subdivided by walls"
    } ]
  }, {
    "tStartMs": 2603070,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "into corridors only 18 centimeters across."
    } ]
  }, {
    "tStartMs": 2606370,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And in 2009,"
    } ]
  }, {
    "tStartMs": 2607690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the half-size Micromouse\ncategory was introduced,"
    } ]
  }, {
    "tStartMs": 2610270,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "with mice smaller than 12 and\na half centimeters per side,"
    } ]
  }, {
    "tStartMs": 2613300,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and paths just nine centimeters across."
    } ]
  }, {
    "tStartMs": 2616570,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The final layout of the\nmaze is only revealed"
    } ]
  }, {
    "tStartMs": 2619120,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "at the start of each competition,"
    } ]
  }, {
    "tStartMs": 2621130,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "after which competitors are not allowed"
    } ]
  }, {
    "tStartMs": 2623080,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "to change the code in their mice."
    } ]
  }, {
    "tStartMs": 2634039,
    "dDurationMs": 3597,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 2637636,
    "dDurationMs": 3084,
    "segs": [ {
      "utf8": "The big three competitions,\nall Japan, Taiwan,"
    } ]
  }, {
    "tStartMs": 2640720,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and USA's APEC, usually limit\nthe time mice get in the maze"
    } ]
  }, {
    "tStartMs": 2644980,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to seven or 10 minutes,"
    } ]
  }, {
    "tStartMs": 2646810,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and mice are only allowed five runs"
    } ]
  }, {
    "tStartMs": 2648970,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "from the start to the goal."
    } ]
  }, {
    "tStartMs": 2650260,
    "dDurationMs": 3843,
    "segs": [ {
      "utf8": "- So if you spend a lot of time\nsearching, that's a penalty."
    } ]
  }, {
    "tStartMs": 2655060,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Makes sense."
    } ]
  }, {
    "tStartMs": 2656710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So the strategy for most micromice"
    } ]
  }, {
    "tStartMs": 2658900,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "is to spend their first run\ncarefully learning the maze"
    } ]
  }, {
    "tStartMs": 2661990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and looking for the best path to the goal,"
    } ]
  }, {
    "tStartMs": 2664030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "while not wasting too much time."
    } ]
  }, {
    "tStartMs": 2666220,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Then they use their remaining tries"
    } ]
  }, {
    "tStartMs": 2668110,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "to sprint down that path for\nthe fastest runtime possible."
    } ]
  }, {
    "tStartMs": 2674462,
    "dDurationMs": 2828,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 2677290,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Solving a maze may sound simple enough,"
    } ]
  }, {
    "tStartMs": 2679450,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "though it's important to remember"
    } ]
  }, {
    "tStartMs": 2680710,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that with only a few\ninfrared sensors for eyes,"
    } ]
  }, {
    "tStartMs": 2683590,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "the view from inside the\nmaze is a lot less clear"
    } ]
  }, {
    "tStartMs": 2686140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "than what we see from above."
    } ]
  }, {
    "tStartMs": 2688000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Still, you can solve a\nmaze with your eyes closed."
    } ]
  }, {
    "tStartMs": 2691000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If you just put one hand along one wall,"
    } ]
  }, {
    "tStartMs": 2693280,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "you will eventually reach\nthe end of most common mazes,"
    } ]
  }, {
    "tStartMs": 2696940,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "and that's exactly what some initial"
    } ]
  }, {
    "tStartMs": 2698950,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Micromouse competitors realized too."
    } ]
  }, {
    "tStartMs": 2701320,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And after a simple wall following mouse"
    } ]
  }, {
    "tStartMs": 2703420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "took home gold in the first finals,"
    } ]
  }, {
    "tStartMs": 2705580,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the goal of the maze was\nmoved away from the edges"
    } ]
  }, {
    "tStartMs": 2708160,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and freestanding walls were added,"
    } ]
  }, {
    "tStartMs": 2710530,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which would leave a simple\nwall following mouse"
    } ]
  }, {
    "tStartMs": 2713050,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "searching forever."
    } ]
  }, {
    "tStartMs": 2716830,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Your next instinct might\nbe to run through the maze"
    } ]
  }, {
    "tStartMs": 2718960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "taking note of every fork in the road."
    } ]
  }, {
    "tStartMs": 2721360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Whenever you reach a dead end or a loop,"
    } ]
  }, {
    "tStartMs": 2723400,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "you can go back to the last intersection"
    } ]
  }, {
    "tStartMs": 2725170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and try a different path."
    } ]
  }, {
    "tStartMs": 2726970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "If your last left turn got you nowhere,"
    } ]
  }, {
    "tStartMs": 2728860,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "you'd come back to that\nintersection and go right instead."
    } ]
  }, {
    "tStartMs": 2732310,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "You can think of this strategy"
    } ]
  }, {
    "tStartMs": 2733630,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "as the one a headstrong mouse might use,"
    } ]
  }, {
    "tStartMs": 2736060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "running as deep into the maze as it can"
    } ]
  }, {
    "tStartMs": 2738160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and turning back only when\nit can't go any further."
    } ]
  }, {
    "tStartMs": 2741340,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This search strategy, known\nas depth-first search,"
    } ]
  }, {
    "tStartMs": 2744400,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "will eventually get the mouse to the goal."
    } ]
  }, {
    "tStartMs": 2746950,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "The problem is, it might\nnot be the shortest route,"
    } ]
  }, {
    "tStartMs": 2750100,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "because the mouse only\nturns back when it needs to,"
    } ]
  }, {
    "tStartMs": 2752830,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "so it may have missed a\nshortcut that it never tried."
    } ]
  }, {
    "tStartMs": 2756760,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "The sibling to this search\nalgorithm, breath-first search,"
    } ]
  }, {
    "tStartMs": 2760390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "would find the shortest path."
    } ]
  }, {
    "tStartMs": 2762340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "With this strategy, the\nmouse runs down one branch"
    } ]
  }, {
    "tStartMs": 2764860,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of an intersection until\nit reaches the next one,"
    } ]
  }, {
    "tStartMs": 2767170,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and then it goes back to\ncheck the path it skipped"
    } ]
  }, {
    "tStartMs": 2769660,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "before moving on to the\nnext layer of intersections."
    } ]
  }, {
    "tStartMs": 2772450,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So the mouse checks\nevery option it reaches,"
    } ]
  }, {
    "tStartMs": 2775090,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "but all that backtracking"
    } ]
  }, {
    "tStartMs": 2776530,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "means that it's rerunning\npaths dozens of times."
    } ]
  }, {
    "tStartMs": 2780040,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "At this point, even\nsearching the whole maze"
    } ]
  }, {
    "tStartMs": 2782260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "often takes less time."
    } ]
  }, {
    "tStartMs": 2784300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So why not just do that?"
    } ]
  }, {
    "tStartMs": 2786130,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "A meticulous mouse could search\nall 256 cells of the maze,"
    } ]
  }, {
    "tStartMs": 2790180,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "testing every turn and corner"
    } ]
  }, {
    "tStartMs": 2791800,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "to ensure it has definitely\nfound the shortest path."
    } ]
  }, {
    "tStartMs": 2795610,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "But searching so thoroughly\nisn't necessary either."
    } ]
  }, {
    "tStartMs": 2800470,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Instead, the most popular\nMicromouse strategy"
    } ]
  }, {
    "tStartMs": 2802810,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "is different from all of these techniques."
    } ]
  }, {
    "tStartMs": 2805180,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "It's a search algorithm\nknown as flood-fill."
    } ]
  }, {
    "tStartMs": 2808450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This mouse's plan is to\nmake optimistic journeys"
    } ]
  }, {
    "tStartMs": 2811240,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "through the maze, so optimistic in fact,"
    } ]
  }, {
    "tStartMs": 2813820,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "that on their first journey\ntheir map of the maze"
    } ]
  }, {
    "tStartMs": 2815920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "doesn't have any walls at all."
    } ]
  }, {
    "tStartMs": 2818110,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "They simply draw the shortest\npath to the goal and go."
    } ]
  }, {
    "tStartMs": 2822070,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "When their optimistic plan\ninevitably hits a wall"
    } ]
  }, {
    "tStartMs": 2824560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that wasn't on their map,\nthey simply mark it down"
    } ]
  }, {
    "tStartMs": 2827260,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and update their new\nshortest path to the goal."
    } ]
  }, {
    "tStartMs": 2830470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Running, updating,"
    } ]
  }, {
    "tStartMs": 2832270,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "running, updating,"
    } ]
  }, {
    "tStartMs": 2834100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "always bee lining for the goal."
    } ]
  }, {
    "tStartMs": 2836470,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Under the hood of the algorithm,"
    } ]
  }, {
    "tStartMs": 2837850,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "what the micromouse is\nmarking on their map"
    } ]
  }, {
    "tStartMs": 2839920,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "is the distance from every\nsquare in the maze to the goal."
    } ]
  }, {
    "tStartMs": 2843370,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "To travel optimistically,\nthe mouse follows the trail"
    } ]
  }, {
    "tStartMs": 2846460,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of decreasing numbers down to zero."
    } ]
  }, {
    "tStartMs": 2848830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Whenever they hit a wall,"
    } ]
  }, {
    "tStartMs": 2850060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "they update the numbers on their map"
    } ]
  }, {
    "tStartMs": 2851770,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to reflect the new shortest\ndistance to the goal."
    } ]
  }, {
    "tStartMs": 2855280,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "This strategy of following\nthe numerical path"
    } ]
  }, {
    "tStartMs": 2857830,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "of lease resistance gives the\nflood-fill algorithm its name."
    } ]
  }, {
    "tStartMs": 2861700,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The process resembles\nflooding the maze with water"
    } ]
  }, {
    "tStartMs": 2864130,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and updating values based on the flow."
    } ]
  }, {
    "tStartMs": 2867850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Once the mouse reaches the goal,"
    } ]
  }, {
    "tStartMs": 2869590,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it can smooth out the path it took"
    } ]
  }, {
    "tStartMs": 2871450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and get a solution to the maze."
    } ]
  }, {
    "tStartMs": 2873490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "However, it may look back and imagine"
    } ]
  }, {
    "tStartMs": 2875920,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "an even shorter uncharted\npath it could've taken."
    } ]
  }, {
    "tStartMs": 2879310,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The mouse might not be satisfied"
    } ]
  }, {
    "tStartMs": 2880930,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that it's found the\nshortest path just yet."
    } ]
  }, {
    "tStartMs": 2883510,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "While this algorithm isn't guaranteed"
    } ]
  }, {
    "tStartMs": 2885190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to find the best path on first pass,"
    } ]
  }, {
    "tStartMs": 2887680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "it takes advantage of\nthe fact that micromice"
    } ]
  }, {
    "tStartMs": 2889900,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "need to return to the start\nto begin their next run."
    } ]
  }, {
    "tStartMs": 2892810,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So if the mouse treats its\nreturn as a new journey,"
    } ]
  }, {
    "tStartMs": 2896080,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "it can use the return trip\nto search the maze as well."
    } ]
  }, {
    "tStartMs": 2900310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Between these two attempts, both optimized"
    } ]
  }, {
    "tStartMs": 2902620,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to find the shortest path\nfrom start to finish,"
    } ]
  }, {
    "tStartMs": 2904810,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it's extremely likely that\nthe mouse will discover it,"
    } ]
  }, {
    "tStartMs": 2907780,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and the mouse will have\ndone it efficiently,"
    } ]
  }, {
    "tStartMs": 2909880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "often leaving irrelevant areas of the maze"
    } ]
  }, {
    "tStartMs": 2911920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "entirely untouched."
    } ]
  }, {
    "tStartMs": 2913870,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "Flood-fill offers both an\nintelligent and practical way"
    } ]
  }, {
    "tStartMs": 2917137,
    "dDurationMs": 3993,
    "segs": [ {
      "utf8": "for micromice to find the\nshortest path through the maze."
    } ]
  }, {
    "tStartMs": 2921130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Once there was a clear strategy\nto find the shortest path,"
    } ]
  }, {
    "tStartMs": 2923890,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "and once the microcontrollers"
    } ]
  }, {
    "tStartMs": 2925073,
    "dDurationMs": 3107,
    "segs": [ {
      "utf8": "and sensors required to\nimplement it became common,"
    } ]
  }, {
    "tStartMs": 2928180,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "some people believed\nMicromouse had run its course."
    } ]
  }, {
    "tStartMs": 2931300,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "As a paper published in IEEE put it,"
    } ]
  }, {
    "tStartMs": 2933377,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "\"At the end of the 1980s,"
    } ]
  }, {
    "tStartMs": 2934990,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the Micromouse Contest\nhad outlived itself."
    } ]
  }, {
    "tStartMs": 2937750,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The problem was solved"
    } ]
  }, {
    "tStartMs": 2938950,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "and did not provide any new challenges.\""
    } ]
  }, {
    "tStartMs": 2944830,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "In the 2017 all-Japan\nMicromouse competition,"
    } ]
  }, {
    "tStartMs": 2947980,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "both the bronze and silver placing mice"
    } ]
  }, {
    "tStartMs": 2950350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "found the shortest path to the goal."
    } ]
  }, {
    "tStartMs": 2952240,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And once they did, they\nwere able to zip along it"
    } ]
  }, {
    "tStartMs": 2954310,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "as quick as 7.4 seconds."
    } ]
  }, {
    "tStartMs": 2957400,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 2958690,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But Masakazu Utsunomiya's\nwinning mouse, Red Comet,"
    } ]
  }, {
    "tStartMs": 2961960,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "did something entirely different."
    } ]
  }, {
    "tStartMs": 2964450,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "This is the shortest path to the goal,"
    } ]
  }, {
    "tStartMs": 2966580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the one that everyone took."
    } ]
  }, {
    "tStartMs": 2968380,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "This is the path that Red Comet took."
    } ]
  }, {
    "tStartMs": 2971200,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It's a full five and a half meters longer."
    } ]
  }, {
    "tStartMs": 2974380,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "That's because micromice aren't actually"
    } ]
  }, {
    "tStartMs": 2976210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "searching for the shortest path,"
    } ]
  }, {
    "tStartMs": 2977740,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they're searching for the fastest path,"
    } ]
  }, {
    "tStartMs": 2979990,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and Red Comet's search\nalgorithm figured out"
    } ]
  }, {
    "tStartMs": 2982180,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that this path had fewer\nturns to slow it down."
    } ]
  }, {
    "tStartMs": 2985060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So even though the path was longer,"
    } ]
  }, {
    "tStartMs": 2987310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "it could end up being faster."
    } ]
  }, {
    "tStartMs": 2989590,
    "dDurationMs": 2095,
    "segs": [ {
      "utf8": "So it took that risk."
    } ]
  }, {
    "tStartMs": 2997918,
    "dDurationMs": 2952,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3000870,
    "dDurationMs": 3693,
    "segs": [ {
      "utf8": "It won by 131 milliseconds."
    } ]
  }, {
    "tStartMs": 3006900,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Differing routes at competition"
    } ]
  }, {
    "tStartMs": 3008220,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "are now more common than not,"
    } ]
  }, {
    "tStartMs": 3010050,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and even just getting to\nthe goal remains difficult,"
    } ]
  }, {
    "tStartMs": 3012900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "whether due to a mysterious algorithm"
    } ]
  }, {
    "tStartMs": 3014820,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "or a quirk of the physical maze."
    } ]
  }, {
    "tStartMs": 3017771,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- [Announcer] On the corner,\nit's a little bit like a, whoa."
    } ]
  }, {
    "tStartMs": 3025650,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "- [Derek] Micromice don't\nalways behave as you'd expect."
    } ]
  }, {
    "tStartMs": 3043440,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Micromouse is far from solved,"
    } ]
  }, {
    "tStartMs": 3045300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "because it's not just a software problem"
    } ]
  }, {
    "tStartMs": 3047280,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "or a hardware problem, it's\nboth, it's a robotics problem."
    } ]
  }, {
    "tStartMs": 3051750,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Red Comet didn't win"
    } ]
  }, {
    "tStartMs": 3052890,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "because it had a better search algorithm,"
    } ]
  }, {
    "tStartMs": 3054480,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "or because it had faster motors."
    } ]
  }, {
    "tStartMs": 3056430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's cleverness came from how the brains"
    } ]
  }, {
    "tStartMs": 3058350,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "and body of the mouse interacted together."
    } ]
  }, {
    "tStartMs": 3060980,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "- So it turns out solving\nthe maze is not the problem,"
    } ]
  }, {
    "tStartMs": 3063540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "it never was the problem, right?"
    } ]
  }, {
    "tStartMs": 3065040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But it's actually about navigation,"
    } ]
  }, {
    "tStartMs": 3066780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and it's about going fast."
    } ]
  }, {
    "tStartMs": 3068460,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- Every year, the robots get\nsmaller, faster, lighter."
    } ]
  }, {
    "tStartMs": 3071880,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "There is still plenty of innovation left."
    } ]
  }, {
    "tStartMs": 3074790,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And there's a small group\nof devotees in Japan"
    } ]
  }, {
    "tStartMs": 3078540,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "busy building quarter-sized micromouse,"
    } ]
  }, {
    "tStartMs": 3080880,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "which would sit on a quarter"
    } ]
  }, {
    "tStartMs": 3087660,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Derek] Nearly 50 years on,"
    } ]
  }, {
    "tStartMs": 3089160,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "Micromouse is bigger than ever."
    } ]
  }, {
    "tStartMs": 3097749,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3103440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Competitions have appeared\nsolved at first glance before."
    } ]
  }, {
    "tStartMs": 3106800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The high jump was an\nOlympic sport since 1896,"
    } ]
  }, {
    "tStartMs": 3109680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "with competitors refining their jumps"
    } ]
  }, {
    "tStartMs": 3111480,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "using variations like the\nscissor, the western roll,"
    } ]
  }, {
    "tStartMs": 3114450,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and the straddle over the\ndecades with diminishing returns."
    } ]
  }, {
    "tStartMs": 3117780,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But once foam padding became\nstandard in competition,"
    } ]
  }, {
    "tStartMs": 3121080,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Dick Fosbury rewrote the sport in 1968"
    } ]
  }, {
    "tStartMs": 3123930,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "by becoming the first Olympian"
    } ]
  }, {
    "tStartMs": 3125580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "to jump over the pole backwards."
    } ]
  }, {
    "tStartMs": 3128130,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Now almost every high jumper"
    } ]
  }, {
    "tStartMs": 3129930,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "does what's known as the Fosbury Flop."
    } ]
  }, {
    "tStartMs": 3133320,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "If Micromouse had indeed\nstopped in the 1980s,"
    } ]
  }, {
    "tStartMs": 3136170,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the competition would've\nmissed its own Fosbury flops,"
    } ]
  }, {
    "tStartMs": 3139350,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "two innovations that completely\nchanged how micromice ran."
    } ]
  }, {
    "tStartMs": 3143310,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "After all, a lot can change in a sport"
    } ]
  }, {
    "tStartMs": 3145170,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "where competitors can solder on"
    } ]
  }, {
    "tStartMs": 3146820,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "any upgrade they can imagine."
    } ]
  }, {
    "tStartMs": 3150000,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "The first Fosbury flop"
    } ]
  }, {
    "tStartMs": 3151290,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "was one of the earliest\ninnovations in Micromouse,"
    } ]
  }, {
    "tStartMs": 3153870,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and had nothing to do with technology."
    } ]
  }, {
    "tStartMs": 3156420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "It was simply a way of\nthinking outside the box,"
    } ]
  }, {
    "tStartMs": 3159150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "or rather, cutting through the box."
    } ]
  }, {
    "tStartMs": 3161610,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "Every mouse used to\nturn corners like this."
    } ]
  }, {
    "tStartMs": 3167280,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "But everything changed\nwith the mouse, Mitee 3."
    } ]
  }, {
    "tStartMs": 3170162,
    "dDurationMs": 1258,
    "segs": [ {
      "utf8": "- The Mitee mouse three"
    } ]
  }, {
    "tStartMs": 3171420,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "implemented diagonals for the first time."
    } ]
  }, {
    "tStartMs": 3175863,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(spectators cheering)"
    } ]
  }, {
    "tStartMs": 3180117,
    "dDurationMs": 2223,
    "segs": [ {
      "utf8": "And that turned out to\nbe a much better idea"
    } ]
  }, {
    "tStartMs": 3182340,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "than we really thought."
    } ]
  }, {
    "tStartMs": 3183630,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And because it's cool, maze designers"
    } ]
  }, {
    "tStartMs": 3186720,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "often put diagonals into the maze now."
    } ]
  }, {
    "tStartMs": 3188850,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So, you know, you could end\nup with a maze where it never"
    } ]
  }, {
    "tStartMs": 3192300,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "comes up, but most of the\ntime, it's actually a benefit."
    } ]
  }, {
    "tStartMs": 3195030,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- [Derek] In order to pull off diagonals,"
    } ]
  }, {
    "tStartMs": 3196920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the chassis of the mouse had to be reduced"
    } ]
  }, {
    "tStartMs": 3198870,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to less than 11 centimeters wide,"
    } ]
  }, {
    "tStartMs": 3201150,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "or just five centimeters\nfor half-size Micromouse."
    } ]
  }, {
    "tStartMs": 3203940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The sensors and software of\nthe mouse had to change too."
    } ]
  }, {
    "tStartMs": 3206880,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "When you're running\nbetween parallel walls,"
    } ]
  }, {
    "tStartMs": 3208710,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "all you have to do is\nmaintain an equal distance"
    } ]
  }, {
    "tStartMs": 3210930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "between your left and\nright infrared readings."
    } ]
  }, {
    "tStartMs": 3213570,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But a diagonal requires\nan entirely new algorithm,"
    } ]
  }, {
    "tStartMs": 3217050,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "one that essentially guides the mouse"
    } ]
  }, {
    "tStartMs": 3218880,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "as if it had blinders on."
    } ]
  }, {
    "tStartMs": 3220710,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Normally if you're going\nalong the side of a wall"
    } ]
  }, {
    "tStartMs": 3222960,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "or something like that,"
    } ]
  }, {
    "tStartMs": 3224100,
    "dDurationMs": 2487,
    "segs": [ {
      "utf8": "most of the time, you can\nsee the wall all the time."
    } ]
  }, {
    "tStartMs": 3226587,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "And so, that helps you to guide yourself,"
    } ]
  }, {
    "tStartMs": 3229860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and you know when you're getting off."
    } ]
  }, {
    "tStartMs": 3231480,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But in the diagonal situation,"
    } ]
  }, {
    "tStartMs": 3233430,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "you just see these walls coming at you."
    } ]
  }, {
    "tStartMs": 3235590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- [Derek] And if you veer\neven a tiny bit off course,"
    } ]
  }, {
    "tStartMs": 3238530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "snagging a corner is a lot less forgiving"
    } ]
  }, {
    "tStartMs": 3240600,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "than sliding against a wall."
    } ]
  }, {
    "tStartMs": 3242490,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Diagonals are still one of\nthe biggest sources of crashes"
    } ]
  }, {
    "tStartMs": 3245310,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "in competition today."
    } ]
  }, {
    "tStartMs": 3247950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But in exchange, a jagged path of turns"
    } ]
  }, {
    "tStartMs": 3250470,
    "dDurationMs": 2898,
    "segs": [ {
      "utf8": "transforms into one narrow straightaway."
    } ]
  }, {
    "tStartMs": 3253368,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "- Whoa, whoa!"
    } ]
  }, {
    "tStartMs": 3254558,
    "dDurationMs": 1816,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3256374,
    "dDurationMs": 3091,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3259465,
    "dDurationMs": 1985,
    "segs": [ {
      "utf8": "(spectators cheering)"
    } ]
  }, {
    "tStartMs": 3261450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Derek] These days, nearly\nevery competitive micromouse"
    } ]
  }, {
    "tStartMs": 3264000,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "is designed to take this risk."
    } ]
  }, {
    "tStartMs": 3267510,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Cutting diagonals opened up\nroom for even more ideas."
    } ]
  }, {
    "tStartMs": 3270870,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Around the same time,"
    } ]
  }, {
    "tStartMs": 3271950,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "mice were applying similar\nstrategies to turning."
    } ]
  }, {
    "tStartMs": 3275010,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Instead of stopping and pivoting\nthrough two right turns,"
    } ]
  }, {
    "tStartMs": 3278070,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "a mouse could sweep around\nin a single U-turn motion."
    } ]
  }, {
    "tStartMs": 3281310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And once the possibility\nof diagonals were added,"
    } ]
  }, {
    "tStartMs": 3283710,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "the total number of possible\nturns opened up exponentially."
    } ]
  }, {
    "tStartMs": 3287700,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "The maze was no longer just\na grid of square hallways."
    } ]
  }, {
    "tStartMs": 3291390,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "With so many more options to weigh,"
    } ]
  }, {
    "tStartMs": 3293820,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "figuring out the best path\nbecame more complex than ever."
    } ]
  }, {
    "tStartMs": 3297540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "But the payoff was dramatic."
    } ]
  }, {
    "tStartMs": 3299550,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "What was once a series of stops and starts"
    } ]
  }, {
    "tStartMs": 3301650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "could now be a single\nfluid snaking motion."
    } ]
  }, {
    "tStartMs": 3304440,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "How micromice imagined\nand moved through the maze"
    } ]
  }, {
    "tStartMs": 3307050,
    "dDurationMs": 1688,
    "segs": [ {
      "utf8": "had changed completely."
    } ]
  }, {
    "tStartMs": 3308738,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3313050,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Available technology was getting upgrades"
    } ]
  }, {
    "tStartMs": 3314940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "over the years as well."
    } ]
  }, {
    "tStartMs": 3316560,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Tall and unwieldy arms that\nwere used to find walls"
    } ]
  }, {
    "tStartMs": 3319590,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "were replaced by a smaller array"
    } ]
  }, {
    "tStartMs": 3321450,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of infrared sensors onboard the mouse."
    } ]
  }, {
    "tStartMs": 3324120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Precise stepper motors were traded in"
    } ]
  }, {
    "tStartMs": 3325890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "for continuous DC motors and encoders."
    } ]
  }, {
    "tStartMs": 3328590,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- The DC motors give you more power"
    } ]
  }, {
    "tStartMs": 3330360,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "for less size and weight."
    } ]
  }, {
    "tStartMs": 3331830,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And so, we were interested in doing that."
    } ]
  }, {
    "tStartMs": 3333480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So then you have to have a servo,"
    } ]
  }, {
    "tStartMs": 3335310,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you have to actually have\nfeedback on the motor"
    } ]
  }, {
    "tStartMs": 3337680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to make it do the right thing."
    } ]
  }, {
    "tStartMs": 3339180,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "- [Derek] Gyroscopes added an\nextra sense of orientation."
    } ]
  }, {
    "tStartMs": 3343710,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It's like a compass.\n- Absolutely."
    } ]
  }, {
    "tStartMs": 3345540,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- You had this thing with you."
    } ]
  }, {
    "tStartMs": 3346710,
    "dDurationMs": 2237,
    "segs": [ {
      "utf8": "- They came about 'cause\nof mobile phones, really."
    } ]
  }, {
    "tStartMs": 3348947,
    "dDurationMs": 2113,
    "segs": [ {
      "utf8": "So the technology provides people"
    } ]
  }, {
    "tStartMs": 3351060,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "with things which weren't there before."
    } ]
  }, {
    "tStartMs": 3352710,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "All of the turning is\ndone based off the gyro,"
    } ]
  }, {
    "tStartMs": 3356010,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "rather than counting\npulses off the wheels,"
    } ]
  }, {
    "tStartMs": 3358680,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "'cause it's much more reliable."
    } ]
  }, {
    "tStartMs": 3360240,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- [Derek] But even with all\nthe mechanical upgrades,"
    } ]
  }, {
    "tStartMs": 3362370,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the biggest physical issue for micromice"
    } ]
  }, {
    "tStartMs": 3364230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "went unaddressed for decades."
    } ]
  }, {
    "tStartMs": 3366420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "One thing you'll see almost\nevery competitor holding"
    } ]
  }, {
    "tStartMs": 3368910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "is a roll of tape."
    } ]
  }, {
    "tStartMs": 3370710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Once you know to look for\nit, you'll see it everywhere."
    } ]
  }, {
    "tStartMs": 3373410,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This tape isn't for repairs\nor reattaching fallen parts."
    } ]
  }, {
    "tStartMs": 3377250,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It's to gather specks\nof dust off the wheels"
    } ]
  }, {
    "tStartMs": 3380010,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "in between rounds."
    } ]
  }, {
    "tStartMs": 3381570,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "At the speed and precision\nthese robots are operating,"
    } ]
  }, {
    "tStartMs": 3384270,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "that tiny change in friction\nis enough to ruin a run."
    } ]
  }, {
    "tStartMs": 3390450,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "If you wanna turn while driving fast,"
    } ]
  }, {
    "tStartMs": 3392640,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "you need centripetal force to\naccelerate you into the turn."
    } ]
  }, {
    "tStartMs": 3396390,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And the faster you're moving,"
    } ]
  }, {
    "tStartMs": 3397710,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "the more force you need\nto keep you on the track."
    } ]
  }, {
    "tStartMs": 3400920,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The only centripetal force for\na car turning on flat ground"
    } ]
  }, {
    "tStartMs": 3404190,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "is friction, which is\ndetermined by two things,"
    } ]
  }, {
    "tStartMs": 3407310,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the road pushing up the weight of the car,"
    } ]
  }, {
    "tStartMs": 3409530,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "or the normal force,"
    } ]
  }, {
    "tStartMs": 3410760,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "multiplied by the static\ncoefficient of friction,"
    } ]
  }, {
    "tStartMs": 3413220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "which is the friction of the interface"
    } ]
  }, {
    "tStartMs": 3414870,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "between the tire and road surface."
    } ]
  }, {
    "tStartMs": 3417120,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "This is why racetracks have banked turns."
    } ]
  }, {
    "tStartMs": 3419910,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The steep angles help cars\nturn with less friction,"
    } ]
  }, {
    "tStartMs": 3423120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "because part of the normal\nforce itself now points in"
    } ]
  }, {
    "tStartMs": 3426480,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to contribute to the\ncentripetal force required."
    } ]
  }, {
    "tStartMs": 3429330,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "If the bank turn is steep enough,"
    } ]
  }, {
    "tStartMs": 3430920,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "cars can actually make the turn\nwithout any friction at all."
    } ]
  }, {
    "tStartMs": 3434430,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The inward component of\nthe normal force alone"
    } ]
  }, {
    "tStartMs": 3436650,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "is enough to provide the centripetal force"
    } ]
  }, {
    "tStartMs": 3438480,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "required to stay on track."
    } ]
  }, {
    "tStartMs": 3442020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Micromice are no different,"
    } ]
  }, {
    "tStartMs": 3443640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and they don't have banked turns to help."
    } ]
  }, {
    "tStartMs": 3446340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "As they got faster and\nfaster, by the early 2000s,"
    } ]
  }, {
    "tStartMs": 3449370,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "their limiting factor was no longer speed,"
    } ]
  }, {
    "tStartMs": 3451830,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but control of that speed."
    } ]
  }, {
    "tStartMs": 3453990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "They had to set their\ncenter of gravity low"
    } ]
  }, {
    "tStartMs": 3456480,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and slow down during turns"
    } ]
  }, {
    "tStartMs": 3458070,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to avoid slipping into\na wall or flipping over."
    } ]
  }, {
    "tStartMs": 3461490,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But unlike race cars, there\nwasn't anything in the rules"
    } ]
  }, {
    "tStartMs": 3464040,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "to stop Micromouse competitors\nfrom solving this problem"
    } ]
  }, {
    "tStartMs": 3467010,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "by engineering an entirely new mechanism."
    } ]
  }, {
    "tStartMs": 3472020,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Micromouse's second Fosbury flop"
    } ]
  }, {
    "tStartMs": 3473910,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "was almost considered a gimmick"
    } ]
  }, {
    "tStartMs": 3475470,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "when the mouse Mokomo08\nfirst used it in competition."
    } ]
  }, {
    "tStartMs": 3479310,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You might be staring at\nthe video to try to see it,"
    } ]
  }, {
    "tStartMs": 3481710,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "but you won't."
    } ]
  }, {
    "tStartMs": 3482820,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "Instead, it's something you'll hear."
    } ]
  }, {
    "tStartMs": 3488100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "That isn't the mouse revving its engines."
    } ]
  }, {
    "tStartMs": 3489990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It's spinning up a propeller."
    } ]
  }, {
    "tStartMs": 3492330,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And while flying over the\nwalls is against the rules,"
    } ]
  }, {
    "tStartMs": 3495420,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "there's nothing in the\nrules against a mouse"
    } ]
  }, {
    "tStartMs": 3497070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "vacuuming itself to the\nground to prevent slipping."
    } ]
  }, {
    "tStartMs": 3499860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Dave Otten was the first person"
    } ]
  }, {
    "tStartMs": 3501990,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "I saw put a fan on a mouse,\nbut he used a ducted fan,"
    } ]
  }, {
    "tStartMs": 3505980,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and I think he was really looking\nat kind of reaction force,"
    } ]
  }, {
    "tStartMs": 3509190,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "blowing the thing down."
    } ]
  }, {
    "tStartMs": 3510290,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "He had a skirt around, but it\nwas not terribly effective."
    } ]
  }, {
    "tStartMs": 3515580,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "He'll forgive for saying so."
    } ]
  }, {
    "tStartMs": 3517260,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "The idea is to let as\nlittle air in as possible."
    } ]
  }, {
    "tStartMs": 3521730,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And like your vacuum cleaner,"
    } ]
  }, {
    "tStartMs": 3522960,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "when you block your vacuum cleaner,"
    } ]
  }, {
    "tStartMs": 3524640,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "the motor unloads and speeds\nup, and so the current drops."
    } ]
  }, {
    "tStartMs": 3528510,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "But if you let too much air\nin, the current's very high."
    } ]
  }, {
    "tStartMs": 3531630,
    "dDurationMs": 2348,
    "segs": [ {
      "utf8": "And these are just quadcopter motors,"
    } ]
  }, {
    "tStartMs": 3533978,
    "dDurationMs": 1404,
    "segs": [ {
      "utf8": "and they draw a lot of current."
    } ]
  }, {
    "tStartMs": 3535382,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "- [Derek] At the scale of Micromouse,"
    } ]
  }, {
    "tStartMs": 3537030,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "a vacuum fan, often just built\nfrom handheld drone parts,"
    } ]
  }, {
    "tStartMs": 3541200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "is enough to generate a downward force"
    } ]
  }, {
    "tStartMs": 3543450,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "five times the mouse's weight."
    } ]
  }, {
    "tStartMs": 3546810,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Wow, okay. That's impressive."
    } ]
  }, {
    "tStartMs": 3550080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So how much does the car actually weigh?"
    } ]
  }, {
    "tStartMs": 3552090,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- About 130 grams."
    } ]
  }, {
    "tStartMs": 3553980,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And if you listen,"
    } ]
  }, {
    "tStartMs": 3555120,
    "dDurationMs": 2888,
    "segs": [ {
      "utf8": "I dunno if you'll get it\non your microphone, but."
    } ]
  }, {
    "tStartMs": 3558008,
    "dDurationMs": 2425,
    "segs": [ {
      "utf8": "- Oh, yeah.\n- You hear the motors"
    } ]
  }, {
    "tStartMs": 3560433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "slow down, loads up."
    } ]
  }, {
    "tStartMs": 3562500,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Derek] With that much friction,"
    } ]
  }, {
    "tStartMs": 3564090,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "micromice today can turn corners"
    } ]
  }, {
    "tStartMs": 3565950,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "with a centripetal\nacceleration approaching 6 Gs."
    } ]
  }, {
    "tStartMs": 3569610,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "That's the same as F1 cars."
    } ]
  }, {
    "tStartMs": 3575280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Once nearly everyone equipped fans,"
    } ]
  }, {
    "tStartMs": 3577620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the added control allowed builders"
    } ]
  }, {
    "tStartMs": 3579420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to push the speed limit on micromice."
    } ]
  }, {
    "tStartMs": 3581580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- When it's allowed to,"
    } ]
  }, {
    "tStartMs": 3582780,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it will out accelerate a Tesla Roadster,"
    } ]
  }, {
    "tStartMs": 3585390,
    "dDurationMs": 1053,
    "segs": [ {
      "utf8": "but not for very far."
    } ]
  }, {
    "tStartMs": 3587610,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Derek] And they can zip along"
    } ]
  }, {
    "tStartMs": 3588750,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "at up to seven meters per second,"
    } ]
  }, {
    "tStartMs": 3590820,
    "dDurationMs": 1914,
    "segs": [ {
      "utf8": "faster than most people can run."
    } ]
  }, {
    "tStartMs": 3592734,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3607028,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(spectators cheering)"
    } ]
  }, {
    "tStartMs": 3607861,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3613200,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Every one of the features now standard"
    } ]
  }, {
    "tStartMs": 3614970,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "on the modern micromouse\nwas once an experiment,"
    } ]
  }, {
    "tStartMs": 3617790,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and the next Fosbury flop\nmight not be far off."
    } ]
  }, {
    "tStartMs": 3620940,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The first four-wheeled micromouse"
    } ]
  }, {
    "tStartMs": 3622740,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "to win the all-Japan\ncompetition did so in 1988,"
    } ]
  }, {
    "tStartMs": 3626850,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but it would take another 22 years"
    } ]
  }, {
    "tStartMs": 3628800,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "of the winning mouse growing\nand losing appendages"
    } ]
  }, {
    "tStartMs": 3631470,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "before four wheeled mice became the norm."
    } ]
  }, {
    "tStartMs": 3634560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "With micromice still experimenting"
    } ]
  }, {
    "tStartMs": 3636600,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "in six and eight wheeled designs,\nomnidirectional movement,"
    } ]
  }, {
    "tStartMs": 3639750,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and even computer vision,"
    } ]
  }, {
    "tStartMs": 3641370,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "who knows what the next\nparadigm shift will be."
    } ]
  }, {
    "tStartMs": 3644010,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- [Announcer] Your time on\nthe maze actually begins"
    } ]
  }, {
    "tStartMs": 3646170,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "only when you leave the start square."
    } ]
  }, {
    "tStartMs": 3648960,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "So he's not penalized\nfor any of this time."
    } ]
  }, {
    "tStartMs": 3654810,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- But if you wanna get\nstarted with Micromouse,"
    } ]
  }, {
    "tStartMs": 3656730,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "you don't need to worry about wheel count,"
    } ]
  }, {
    "tStartMs": 3658530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "or vacuum fans, or even diagonals."
    } ]
  }, {
    "tStartMs": 3661350,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- It is to my mind,\nthe perfect combination"
    } ]
  }, {
    "tStartMs": 3663900,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "of all the major disciplines\nthat you need for robotics,"
    } ]
  }, {
    "tStartMs": 3668700,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "and engineering, and\nprogramming, embedded systems,"
    } ]
  }, {
    "tStartMs": 3672810,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "all wrapped up in one accessible bundle"
    } ]
  }, {
    "tStartMs": 3675390,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that you can do in your living room,"
    } ]
  }, {
    "tStartMs": 3677190,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and you don't need a laboratory to run it."
    } ]
  }, {
    "tStartMs": 3682860,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "You come along because you're curious."
    } ]
  }, {
    "tStartMs": 3685293,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "And then you think, I could do that,"
    } ]
  }, {
    "tStartMs": 3687906,
    "dDurationMs": 1194,
    "segs": [ {
      "utf8": "that doesn't look so hard."
    } ]
  }, {
    "tStartMs": 3689100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And then you're doomed, really."
    } ]
  }, {
    "tStartMs": 3691200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "If it sucks you in, it turns\ninto quite the journey."
    } ]
  }, {
    "tStartMs": 3705153,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(spectators cheering)"
    } ]
  }, {
    "tStartMs": 3709633,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "(spectators applauding)"
    } ]
  }, {
    "tStartMs": 3711690,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- At its core, Micromouse\nis just about a mouse"
    } ]
  }, {
    "tStartMs": 3714540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "trying to solve a maze."
    } ]
  }, {
    "tStartMs": 3716700,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Though nearly 50 years later,"
    } ]
  }, {
    "tStartMs": 3718170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "it's a simple problem\nthat's a good reminder,"
    } ]
  }, {
    "tStartMs": 3720930,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "there is no such thing\nas a simple problem."
    } ]
  }, {
    "tStartMs": 3725437,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "♪ Micromouse for the taking ♪"
    } ]
  }, {
    "tStartMs": 3728388,
    "dDurationMs": 3508,
    "segs": [ {
      "utf8": "♪ Micromouse, it's here and now ♪"
    } ]
  }, {
    "tStartMs": 3731896,
    "dDurationMs": 3472,
    "segs": [ {
      "utf8": "♪ Take a chance, start creating ♪"
    } ]
  }, {
    "tStartMs": 3735368,
    "dDurationMs": 3892,
    "segs": [ {
      "utf8": "♪ Micromouse will show you how ♪"
    } ]
  }, {
    "tStartMs": 3739260,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- A humanoid robot"
    } ]
  }, {
    "tStartMs": 3740370,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "built for all the same tasks a human does"
    } ]
  }, {
    "tStartMs": 3742770,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "sacrifices specialization in any one skill"
    } ]
  }, {
    "tStartMs": 3745320,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "in order to be a generalist."
    } ]
  }, {
    "tStartMs": 3746940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But if it does all tasks semi well"
    } ]
  }, {
    "tStartMs": 3749040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and these tasks are what\nhumans are already doing,"
    } ]
  }, {
    "tStartMs": 3751440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "well, then those robots are\njust overlapping with us,"
    } ]
  }, {
    "tStartMs": 3753810,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "copying our capacities\nrather than expanding them."
    } ]
  }, {
    "tStartMs": 3756810,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So robots are perhaps\nlikely to enter our lives"
    } ]
  }, {
    "tStartMs": 3759330,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "not as multipurpose humanoids,"
    } ]
  }, {
    "tStartMs": 3761130,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "but rather as precise tools\nwe can pick and choose."
    } ]
  }, {
    "tStartMs": 3764370,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Instead of one Swiss army knife robot,"
    } ]
  }, {
    "tStartMs": 3766350,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "you'd end up with something\nlike a personalized toolbox"
    } ]
  }, {
    "tStartMs": 3769290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of specialized robots."
    } ]
  }, {
    "tStartMs": 3771120,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Big futuristic questions"
    } ]
  }, {
    "tStartMs": 3772500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "like how to bring robots\ninto our daily lives"
    } ]
  }, {
    "tStartMs": 3774300,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "requires all sorts of\npractical and creative skills."
    } ]
  }, {
    "tStartMs": 3777150,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "But perhaps the most important one"
    } ]
  }, {
    "tStartMs": 3778440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is actually something\nthat anyone can build,"
    } ]
  }, {
    "tStartMs": 3780840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "problem solving."
    } ]
  }, {
    "tStartMs": 3782040,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "If you wanna hone your own\nability to problem solve,"
    } ]
  }, {
    "tStartMs": 3784530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you can get started on\nthat right now, for free,"
    } ]
  }, {
    "tStartMs": 3786720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "with today's sponsor, Brilliant."
    } ]
  }, {
    "tStartMs": 3788490,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Brilliant will make you a\nbetter critical thinker,"
    } ]
  }, {
    "tStartMs": 3790800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "while helping you build real skills"
    } ]
  }, {
    "tStartMs": 3792300,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "in everything from\ntechnology and programming"
    } ]
  }, {
    "tStartMs": 3794310,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to math, data science,"
    } ]
  }, {
    "tStartMs": 3795750,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and whatever you're curious about."
    } ]
  }, {
    "tStartMs": 3797700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "On Brilliant, you'll\nlearn through discovery"
    } ]
  }, {
    "tStartMs": 3799770,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "by trying things yourself."
    } ]
  }, {
    "tStartMs": 3801450,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And you'll not only gain\nknowledge of key concepts,"
    } ]
  }, {
    "tStartMs": 3803790,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but learn to apply them\nto real world situations,"
    } ]
  }, {
    "tStartMs": 3806550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "all while building your intuition."
    } ]
  }, {
    "tStartMs": 3808620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "This gives you the tools"
    } ]
  }, {
    "tStartMs": 3809820,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to solve whatever problems come your way."
    } ]
  }, {
    "tStartMs": 3812580,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You know, we've been partnering\nwith Brilliant for years,"
    } ]
  }, {
    "tStartMs": 3814740,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and I still find new things\nto learn all the time,"
    } ]
  }, {
    "tStartMs": 3817740,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "like this course on how to maximize"
    } ]
  }, {
    "tStartMs": 3819660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the value of an electric car."
    } ]
  }, {
    "tStartMs": 3821820,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Brilliant has thousands\nof interactive lessons,"
    } ]
  }, {
    "tStartMs": 3824400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and because each one is bite-sized,"
    } ]
  }, {
    "tStartMs": 3826380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you can do it in just minutes."
    } ]
  }, {
    "tStartMs": 3828240,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So no matter where you are,"
    } ]
  }, {
    "tStartMs": 3829950,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "you can always be building\na quicker, sharper mind"
    } ]
  }, {
    "tStartMs": 3832800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "right on your phone."
    } ]
  }, {
    "tStartMs": 3834600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "To try everything Brilliant has to offer"
    } ]
  }, {
    "tStartMs": 3836160,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "for free for 30 days, visit\nbrilliant.org/veritasium,"
    } ]
  }, {
    "tStartMs": 3839310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "or you can scan this QR code,"
    } ]
  }, {
    "tStartMs": 3841620,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "or click that link down\nin the description."
    } ]
  }, {
    "tStartMs": 3844170,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "You'll also get 20% off an\nannual premium subscription."
    } ]
  }, {
    "tStartMs": 3847650,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "So I wanna thank Brilliant"
    } ]
  }, {
    "tStartMs": 3848700,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "for sponsoring this part of the video,"
    } ]
  }, {
    "tStartMs": 3850320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and now, dive into a surprising trait"
    } ]
  }, {
    "tStartMs": 3852510,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "we're starting to build into robots."
    } ]
  }, {
    "tStartMs": 3855450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Elliot's vine robot and jumping robot"
    } ]
  }, {
    "tStartMs": 3857340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "are just two cases where the robots"
    } ]
  }, {
    "tStartMs": 3859170,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that might save our lives\nor explore new planets"
    } ]
  }, {
    "tStartMs": 3861660,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "don't look much like\ntraditional robots at all."
    } ]
  }, {
    "tStartMs": 3864210,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But soft robots in particular\nare an entire field of study."
    } ]
  }, {
    "tStartMs": 3868170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So why are so many\nresearchers trying to build"
    } ]
  }, {
    "tStartMs": 3870540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "the robots of the future\nwith soft materials?"
    } ]
  }, {
    "tStartMs": 3873780,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "For one, trading out\nfragmented metal frames"
    } ]
  }, {
    "tStartMs": 3876420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "for single flexible bodies"
    } ]
  }, {
    "tStartMs": 3878670,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "might be how we make robots\nmore reliable and precise."
    } ]
  }, {
    "tStartMs": 3882120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "These bendy gear boards are so predictable"
    } ]
  }, {
    "tStartMs": 3884310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that they were commissioned\nby the US government"
    } ]
  }, {
    "tStartMs": 3886260,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to secure nuclear weapons,"
    } ]
  }, {
    "tStartMs": 3888390,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "ensuring that no random motions"
    } ]
  }, {
    "tStartMs": 3890040,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "could accidentally set them off."
    } ]
  }, {
    "tStartMs": 3891930,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "But predictability is\njust one of eight reasons"
    } ]
  }, {
    "tStartMs": 3894750,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "that machines that bend are better."
    } ]
  }, {
    "tStartMs": 3897930,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "What do this satellite\nthruster, plastic tool,"
    } ]
  }, {
    "tStartMs": 3901170,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and micro mechanical\nswitch have in common?"
    } ]
  }, {
    "tStartMs": 3904440,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Well, they all contain\ncomponents that bend,"
    } ]
  }, {
    "tStartMs": 3906930,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so-called compliant mechanisms."
    } ]
  }, {
    "tStartMs": 3909120,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- So it's always been considered to be bad"
    } ]
  }, {
    "tStartMs": 3911880,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "to have flexibility in your machines."
    } ]
  }, {
    "tStartMs": 3914430,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Well, we've tried to take that\nthing that everybody hates"
    } ]
  }, {
    "tStartMs": 3917760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and is trying to avoid and say,"
    } ]
  }, {
    "tStartMs": 3920040,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "how can we use flexibility\nto our advantage,"
    } ]
  }, {
    "tStartMs": 3923610,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "how can we use that to do cool stuff?"
    } ]
  }, {
    "tStartMs": 3925620,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- [Derek] Now, Professor\nHowell literally wrote the book"
    } ]
  }, {
    "tStartMs": 3927930,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "on compliant mechanisms."
    } ]
  }, {
    "tStartMs": 3929190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- That's the most cited book in--"
    } ]
  }, {
    "tStartMs": 3931440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- [Derek] But he's pretty\nnonchalant about his work."
    } ]
  }, {
    "tStartMs": 3933840,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Just watch how he introduces\nthis mechanism he developed"
    } ]
  }, {
    "tStartMs": 3936570,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "to prevent nuclear weapons\nfrom going off accidentally."
    } ]
  }, {
    "tStartMs": 3939870,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Actually the safing and\narming of nuclear weapons."
    } ]
  }, {
    "tStartMs": 3943350,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] What?"
    } ]
  }, {
    "tStartMs": 3944183,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- And so, yeah, if you want."
    } ]
  }, {
    "tStartMs": 3945016,
    "dDurationMs": 1124,
    "segs": [ {
      "utf8": "- [Derek] Hang on, hang on."
    } ]
  }, {
    "tStartMs": 3946140,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Hang on, hang on."
    } ]
  }, {
    "tStartMs": 3947610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "What in nuclear weapons?"
    } ]
  }, {
    "tStartMs": 3949410,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "- Safing and arming."
    } ]
  }, {
    "tStartMs": 3950593,
    "dDurationMs": 1817,
    "segs": [ {
      "utf8": "- Safing and arming.\n- Yeah."
    } ]
  }, {
    "tStartMs": 3952410,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So if there's anything in the world"
    } ]
  }, {
    "tStartMs": 3955350,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that you want to be safe,"
    } ]
  }, {
    "tStartMs": 3956790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that is not going to accidentally go off."
    } ]
  }, {
    "tStartMs": 3959340,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- I feel like this is, it\ndoesn't even need saying."
    } ]
  }, {
    "tStartMs": 3961800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "But yes, nuclear weapons,"
    } ]
  }, {
    "tStartMs": 3963300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "obviously you don't want them to go off."
    } ]
  }, {
    "tStartMs": 3965400,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Well, I don't understand how this"
    } ]
  }, {
    "tStartMs": 3966960,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "is gonna keep nuclear weapons safe."
    } ]
  }, {
    "tStartMs": 3969030,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Now, I wanna come back to this device"
    } ]
  }, {
    "tStartMs": 3970800,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and explain how it works."
    } ]
  }, {
    "tStartMs": 3972270,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Once we understand why\ncompliant mechanisms"
    } ]
  }, {
    "tStartMs": 3974640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "are best suited to this task."
    } ]
  }, {
    "tStartMs": 3976560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That's cool."
    } ]
  }, {
    "tStartMs": 3977393,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "So let's start with something basic."
    } ]
  }, {
    "tStartMs": 3978810,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "- Probably the first compliant\nmechanism I ever designed"
    } ]
  }, {
    "tStartMs": 3981991,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "was this thing."
    } ]
  }, {
    "tStartMs": 3983910,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "What it is, is a compliant\nmechanism that is a gripper."
    } ]
  }, {
    "tStartMs": 3988770,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So you can put something in there"
    } ]
  }, {
    "tStartMs": 3990420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and it'll get actually\na really high force."
    } ]
  }, {
    "tStartMs": 3992700,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "I can put that in there\nand it breaks the chalk."
    } ]
  }, {
    "tStartMs": 3997680,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "- [Derek] What if you\nput your finger in there"
    } ]
  }, {
    "tStartMs": 3998620,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "and squeeze it?"
    } ]
  }, {
    "tStartMs": 3999687,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "- You would scream in pain."
    } ]
  }, {
    "tStartMs": 4001310,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Would you like to try?"
    } ]
  }, {
    "tStartMs": 4002143,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I would.\n- Okay."
    } ]
  }, {
    "tStartMs": 4002976,
    "dDurationMs": 2023,
    "segs": [ {
      "utf8": "- [Derek] Like I would actually\nlike to feel the force."
    } ]
  }, {
    "tStartMs": 4004999,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 4005832,
    "dDurationMs": 2498,
    "segs": [ {
      "utf8": "You need to squeeze it yourself though."
    } ]
  }, {
    "tStartMs": 4008330,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Really?"
    } ]
  }, {
    "tStartMs": 4009163,
    "dDurationMs": 1415,
    "segs": [ {
      "utf8": "- Well, all right, I'll squeeze\n'til you scream in pain."
    } ]
  }, {
    "tStartMs": 4010578,
    "dDurationMs": 2446,
    "segs": [ {
      "utf8": "- But like don't, don't, don't."
    } ]
  }, {
    "tStartMs": 4013024,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "(Derek screaming in pain)"
    } ]
  }, {
    "tStartMs": 4014690,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "That very quickly got incredibly painful."
    } ]
  }, {
    "tStartMs": 4017420,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "It felt like having my\nfinger like in a vice."
    } ]
  }, {
    "tStartMs": 4022040,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "- That looks suspiciously like vice grips,"
    } ]
  }, {
    "tStartMs": 4026570,
    "dDurationMs": 4258,
    "segs": [ {
      "utf8": "but now with these flexible\ncomponents where the hinges are."
    } ]
  }, {
    "tStartMs": 4030828,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Hmm."
    } ]
  }, {
    "tStartMs": 4031661,
    "dDurationMs": 1779,
    "segs": [ {
      "utf8": "What I learned in my visit\nwith Professor Howell"
    } ]
  }, {
    "tStartMs": 4033440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "is that compliant mechanisms\nhave a number of advantages"
    } ]
  }, {
    "tStartMs": 4036410,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "over traditional mechanisms."
    } ]
  }, {
    "tStartMs": 4038150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But I thought he needed kind of a clever,"
    } ]
  }, {
    "tStartMs": 4040700,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "pithy way to remember\nall of these advantages."
    } ]
  }, {
    "tStartMs": 4043520,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "So I came up with the eight\nP's of compliant mechanisms,"
    } ]
  }, {
    "tStartMs": 4047660,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and the first of those is part count."
    } ]
  }, {
    "tStartMs": 4050570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Compliant mechanisms\nhave reduced part count,"
    } ]
  }, {
    "tStartMs": 4053300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "because they have these bendy parts"
    } ]
  }, {
    "tStartMs": 4055520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "instead of having things like hinges,"
    } ]
  }, {
    "tStartMs": 4057830,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and bearings, and separate springs."
    } ]
  }, {
    "tStartMs": 4060050,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "This gripper is just a\nsingle piece of plastic,"
    } ]
  }, {
    "tStartMs": 4063110,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but achieves a similar result"
    } ]
  }, {
    "tStartMs": 4064820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to the much more complicated vice grips."
    } ]
  }, {
    "tStartMs": 4067160,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Like how much does it amplify the force?"
    } ]
  }, {
    "tStartMs": 4069350,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- This will get about 30 to 1."
    } ]
  }, {
    "tStartMs": 4071420,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "So I could get, for 1 pound\nforce in, get 30 pounds out."
    } ]
  }, {
    "tStartMs": 4075530,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] That's pretty good."
    } ]
  }, {
    "tStartMs": 4076363,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "It seems like that would be super cheap."
    } ]
  }, {
    "tStartMs": 4078830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- And really inexpensive."
    } ]
  }, {
    "tStartMs": 4080060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So this we just made here in our shop,"
    } ]
  }, {
    "tStartMs": 4082640,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but you can imagine also\ninjection molding now."
    } ]
  }, {
    "tStartMs": 4085190,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Derek] That would cost like cents."
    } ]
  }, {
    "tStartMs": 4086510,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- Yep, this would cost cents."
    } ]
  }, {
    "tStartMs": 4087740,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The other thing is, because of its shape,"
    } ]
  }, {
    "tStartMs": 4089780,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "you could extrude it and\nthen just chop 'em off."
    } ]
  }, {
    "tStartMs": 4092870,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "- Hmm.\n- And that would be cool."
    } ]
  }, {
    "tStartMs": 4094180,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- So the simple allows different"
    } ]
  }, {
    "tStartMs": 4096380,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "production processes to be\nused, which lowers the price."
    } ]
  }, {
    "tStartMs": 4100670,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "These switches, for example,"
    } ]
  }, {
    "tStartMs": 4102260,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "achieve in one piece of plastic"
    } ]
  }, {
    "tStartMs": 4103700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "what is normally done\nwith springs, hinges,"
    } ]
  }, {
    "tStartMs": 4105920,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and many rigid plastic pieces."
    } ]
  }, {
    "tStartMs": 4107870,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Also a good fidget device."
    } ]
  }, {
    "tStartMs": 4109820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- How long can these last?"
    } ]
  }, {
    "tStartMs": 4111500,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- We've had these in our\nfatigue testing machine,"
    } ]
  }, {
    "tStartMs": 4114620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and we've been able to go"
    } ]
  }, {
    "tStartMs": 4116540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "over a million cycles without failure."
    } ]
  }, {
    "tStartMs": 4118790,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- What do we got there?"
    } ]
  }, {
    "tStartMs": 4119623,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "- All right, Derek, I've got a quiz."
    } ]
  }, {
    "tStartMs": 4120740,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- Uh-oh.\n- A quiz for you, okay?"
    } ]
  }, {
    "tStartMs": 4124070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Elephant."
    } ]
  }, {
    "tStartMs": 4125660,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Very good."
    } ]
  }, {
    "tStartMs": 4126920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Okay, I'm gonna push on the\nelephant's rump, this direction."
    } ]
  }, {
    "tStartMs": 4130700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I'm gonna hold this."
    } ]
  }, {
    "tStartMs": 4131533,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "So that little dot right there,"
    } ]
  }, {
    "tStartMs": 4133430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "is that dot, when I push on it,"
    } ]
  }, {
    "tStartMs": 4135350,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "is it gonna go left, right, up, or down?"
    } ]
  }, {
    "tStartMs": 4140807,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "(Derek laughing)"
    } ]
  }, {
    "tStartMs": 4141920,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- I just, you know what,"
    } ]
  }, {
    "tStartMs": 4143210,
    "dDurationMs": 2038,
    "segs": [ {
      "utf8": "I wanted to guess without\neven thinking about it."
    } ]
  }, {
    "tStartMs": 4145248,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "- Yeah, please do."
    } ]
  }, {
    "tStartMs": 4146450,
    "dDurationMs": 1539,
    "segs": [ {
      "utf8": "- I'm gonna say like up and in."
    } ]
  }, {
    "tStartMs": 4147989,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay. Up and in."
    } ]
  }, {
    "tStartMs": 4148822,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "- And I kind of feel like that"
    } ]
  }, {
    "tStartMs": 4150290,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "because like that would be a logical way"
    } ]
  }, {
    "tStartMs": 4152300,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "for an elephant to hold its trunk."
    } ]
  }, {
    "tStartMs": 4155240,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "But also because like if\nthis is all going over,"
    } ]
  }, {
    "tStartMs": 4157507,
    "dDurationMs": 2563,
    "segs": [ {
      "utf8": "I feel like this is gonna\nkind of extend there"
    } ]
  }, {
    "tStartMs": 4160070,
    "dDurationMs": 1181,
    "segs": [ {
      "utf8": "and that's gonna get pushed up in there."
    } ]
  }, {
    "tStartMs": 4161251,
    "dDurationMs": 1579,
    "segs": [ {
      "utf8": "- Ah, ah, good thinking."
    } ]
  }, {
    "tStartMs": 4162830,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Well, I don't know,\nis that good thinking?"
    } ]
  }, {
    "tStartMs": 4164870,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Well, it's thinking at least."
    } ]
  }, {
    "tStartMs": 4166370,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So this is designed so\nthat when you push on that,"
    } ]
  }, {
    "tStartMs": 4169520,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "it actually just rotates in\nspace, it doesn't move at all."
    } ]
  }, {
    "tStartMs": 4173210,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- I knew you were gonna pull some sort of"
    } ]
  }, {
    "tStartMs": 4174980,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "trick question on me.\n- It's a trick question."
    } ]
  }, {
    "tStartMs": 4176540,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Derek] Now, since I was fooled by it,"
    } ]
  }, {
    "tStartMs": 4177980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I had to try it out on my\nfriend, The Physics Girl."
    } ]
  }, {
    "tStartMs": 4180560,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "- That's so trippy."
    } ]
  }, {
    "tStartMs": 4183907,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "That is so cool."
    } ]
  }, {
    "tStartMs": 4185242,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "I don't understand, what?"
    } ]
  }, {
    "tStartMs": 4186890,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- It's modeled after the\nmechanisms you use in wind tunnels"
    } ]
  }, {
    "tStartMs": 4190310,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "where you want to have, say,\na model that's attached here,"
    } ]
  }, {
    "tStartMs": 4194930,
    "dDurationMs": 1822,
    "segs": [ {
      "utf8": "but then you move it\nand all you want to do"
    } ]
  }, {
    "tStartMs": 4196752,
    "dDurationMs": 2948,
    "segs": [ {
      "utf8": "is control, its its angle"
    } ]
  }, {
    "tStartMs": 4199700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and not move it around in the wind tunnel."
    } ]
  }, {
    "tStartMs": 4201920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- Don't displace it, but be\nable to change the angle."
    } ]
  }, {
    "tStartMs": 4205700,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Devices like this demonstrate\nthat compliant mechanisms"
    } ]
  }, {
    "tStartMs": 4208640,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "are capable of producing\nvery precise motion,"
    } ]
  }, {
    "tStartMs": 4211880,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "which I personally found\npretty counterintuitive"
    } ]
  }, {
    "tStartMs": 4214430,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "because these objects are\nmade up of flexible parts."
    } ]
  }, {
    "tStartMs": 4217400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But maybe that shouldn't be surprising,"
    } ]
  }, {
    "tStartMs": 4219860,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "because compliant mechanisms"
    } ]
  }, {
    "tStartMs": 4221510,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "don't suffer from backlash, for one thing."
    } ]
  }, {
    "tStartMs": 4223970,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So backlash occurs when you have a hinge,"
    } ]
  }, {
    "tStartMs": 4226190,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which is basically just a pin in a hole,"
    } ]
  }, {
    "tStartMs": 4228470,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and it's moving in one direction."
    } ]
  }, {
    "tStartMs": 4231080,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And now, if at some point\nthe motion reverses,"
    } ]
  }, {
    "tStartMs": 4234050,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it doesn't happen instantaneously"
    } ]
  }, {
    "tStartMs": 4235910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "because there's some give in the hinge."
    } ]
  }, {
    "tStartMs": 4238490,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "This also causes wear,\nand requires lubricant."
    } ]
  }, {
    "tStartMs": 4241580,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And that is why compliant mechanisms"
    } ]
  }, {
    "tStartMs": 4244580,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "have better performance than\ntheir traditional counterparts."
    } ]
  }, {
    "tStartMs": 4248240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- This one though is my favorite."
    } ]
  }, {
    "tStartMs": 4250580,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- That is one of my favorites too."
    } ]
  }, {
    "tStartMs": 4252800,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "It's just so pleasing, right?"
    } ]
  }, {
    "tStartMs": 4256688,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "- Oh, that sound is so satisfying."
    } ]
  }, {
    "tStartMs": 4259430,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- This actually, believe\nit or not, was inspired"
    } ]
  }, {
    "tStartMs": 4262070,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "when we were doing things\nat the microscopic level,"
    } ]
  }, {
    "tStartMs": 4264380,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "where we were building\ncompliant mechanisms on chips."
    } ]
  }, {
    "tStartMs": 4267680,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "We had to be able to make\nthese compliant mechanisms"
    } ]
  }, {
    "tStartMs": 4271670,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "out of silicon, which\nis as brittle as glass."
    } ]
  }, {
    "tStartMs": 4275810,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And if you're trying to\nmake something like this"
    } ]
  }, {
    "tStartMs": 4278300,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "out of glass, it's crazy hard."
    } ]
  }, {
    "tStartMs": 4282020,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But that also means, once\nwe figured out the design,"
    } ]
  }, {
    "tStartMs": 4284270,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "we could make it in a\nmaterial even like PLA,"
    } ]
  }, {
    "tStartMs": 4287390,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "which is also not the ideal\ncompliant mechanism material."
    } ]
  }, {
    "tStartMs": 4291560,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So you can get on our website"
    } ]
  }, {
    "tStartMs": 4294170,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "and get the files to make this yourself."
    } ]
  }, {
    "tStartMs": 4298190,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] I'll put a\nlink in the description."
    } ]
  }, {
    "tStartMs": 4299960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Yeah, that also has a nice\nfeel, and a nice snap to it."
    } ]
  }, {
    "tStartMs": 4302720,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- It has a really nice snap."
    } ]
  }, {
    "tStartMs": 4303980,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I like when it comes out, it's like gunk."
    } ]
  }, {
    "tStartMs": 4307250,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Like there's something\nabout that that's really,"
    } ]
  }, {
    "tStartMs": 4309320,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "it's very pleasing."
    } ]
  }, {
    "tStartMs": 4310460,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So these things actually move?"
    } ]
  }, {
    "tStartMs": 4312170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Oh yeah, yeah, yeah."
    } ]
  }, {
    "tStartMs": 4314120,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- [Derek] I need to see this."
    } ]
  }, {
    "tStartMs": 4314990,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Okay, all right, we'll do it."
    } ]
  }, {
    "tStartMs": 4316580,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Derek] Were those etched on there?"
    } ]
  }, {
    "tStartMs": 4317810,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Yeah, those are etched."
    } ]
  }, {
    "tStartMs": 4319400,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And so, just using the same processes"
    } ]
  }, {
    "tStartMs": 4322580,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "used to make computer chips."
    } ]
  }, {
    "tStartMs": 4324260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- [Derek] So another advantage\nof compliant mechanisms"
    } ]
  }, {
    "tStartMs": 4326540,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "is that they can be made"
    } ]
  }, {
    "tStartMs": 4327470,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "with significantly smaller proportions,"
    } ]
  }, {
    "tStartMs": 4330140,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "because they take advantage"
    } ]
  }, {
    "tStartMs": 4331220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of production processes\nlike photolithography."
    } ]
  }, {
    "tStartMs": 4333860,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "- [Larry] And we have motion that we want"
    } ]
  }, {
    "tStartMs": 4335980,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "at the microscopic level."
    } ]
  }, {
    "tStartMs": 4337430,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- That's brilliant."
    } ]
  }, {
    "tStartMs": 4338300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Plus, since they simplify design,"
    } ]
  }, {
    "tStartMs": 4340820,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "compliant mechanisms\nare much more portable,"
    } ]
  }, {
    "tStartMs": 4343490,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "meaning lightweight,"
    } ]
  }, {
    "tStartMs": 4344600,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which makes them perfect\nfor space applications."
    } ]
  }, {
    "tStartMs": 4347450,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "- This here is something we did with NASA,"
    } ]
  }, {
    "tStartMs": 4350510,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "making a hinge that could replace bearings"
    } ]
  }, {
    "tStartMs": 4353180,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "for, say, deploying solar panels."
    } ]
  }, {
    "tStartMs": 4355310,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "This is titanium, 3D-printed titanium."
    } ]
  }, {
    "tStartMs": 4357980,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "But what's freaky about it is,"
    } ]
  }, {
    "tStartMs": 4359263,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "you get that motion, which people expect,"
    } ]
  }, {
    "tStartMs": 4362360,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "but here's a piece of\ntitanium that can bend"
    } ]
  }, {
    "tStartMs": 4366170,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "plus-minus 90 degrees,\n180 degree deflection."
    } ]
  }, {
    "tStartMs": 4369380,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [Derek] That is solid titanium?"
    } ]
  }, {
    "tStartMs": 4372350,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- That is one piece of\ntitanium that is 3D printed."
    } ]
  }, {
    "tStartMs": 4378530,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- [Derek] There's no alloy,\nnothing to make it flexible?"
    } ]
  }, {
    "tStartMs": 4381290,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- Yep, this is, yep."
    } ]
  }, {
    "tStartMs": 4383390,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And even freakier than this"
    } ]
  }, {
    "tStartMs": 4385910,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "is this guy right there."
    } ]
  }, {
    "tStartMs": 4390710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So that looks like a crazy beast,"
    } ]
  }, {
    "tStartMs": 4392900,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "but every part in there has a purpose."
    } ]
  }, {
    "tStartMs": 4396590,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "All these flexible beams."
    } ]
  }, {
    "tStartMs": 4398900,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Here are the two inputs."
    } ]
  }, {
    "tStartMs": 4400940,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "And again, we did this with\nNASA for a thruster application,"
    } ]
  }, {
    "tStartMs": 4404870,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "where we can put a thruster right there,"
    } ]
  }, {
    "tStartMs": 4407120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and now, with our two motor inputs,"
    } ]
  }, {
    "tStartMs": 4409430,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "we can direct that\nthruster in any direction."
    } ]
  }, {
    "tStartMs": 4412400,
    "dDurationMs": 2427,
    "segs": [ {
      "utf8": "That titanium device moves out,"
    } ]
  }, {
    "tStartMs": 4414827,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "and you notice, it's just all bending."
    } ]
  }, {
    "tStartMs": 4417500,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "And then, there's no pinch\npoints for the fuel lines,"
    } ]
  }, {
    "tStartMs": 4420830,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "or electrical lines coming in."
    } ]
  }, {
    "tStartMs": 4424520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- Here, this single piece of titanium"
    } ]
  }, {
    "tStartMs": 4426560,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "allows you to use one\nthruster in place of two."
    } ]
  }, {
    "tStartMs": 4431330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Okay, that is a clutch.\n- Okay."
    } ]
  }, {
    "tStartMs": 4432950,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- So the idea is, if you\nspin it up really fast,"
    } ]
  }, {
    "tStartMs": 4438110,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "because it's flexible,"
    } ]
  }, {
    "tStartMs": 4439100,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "this outer part will actually\nstart coming outwards."
    } ]
  }, {
    "tStartMs": 4442670,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And then, if there's a drum around it,"
    } ]
  }, {
    "tStartMs": 4444350,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "it'll contact with that\ndrum and spin that thing."
    } ]
  }, {
    "tStartMs": 4447770,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- Oh, so this like kind of,"
    } ]
  }, {
    "tStartMs": 4449210,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "oh, that kind of comes out like so."
    } ]
  }, {
    "tStartMs": 4452333,
    "dDurationMs": 1497,
    "segs": [ {
      "utf8": "- Then it gets spinning really fast,"
    } ]
  }, {
    "tStartMs": 4453830,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and then you essentially\nengage this outer drum."
    } ]
  }, {
    "tStartMs": 4457790,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So this is like the way\nthat a chainsaw would work,"
    } ]
  }, {
    "tStartMs": 4459950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or something like that,"
    } ]
  }, {
    "tStartMs": 4460783,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "because you get it spinning fast enough"
    } ]
  }, {
    "tStartMs": 4462650,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and then it engages the chain,\nand then it turns it over"
    } ]
  }, {
    "tStartMs": 4465200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and then, yeah.\n- The centripetal force."
    } ]
  }, {
    "tStartMs": 4466033,
    "dDurationMs": 1747,
    "segs": [ {
      "utf8": "Yeah. Wow, that's cool."
    } ]
  }, {
    "tStartMs": 4467780,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "- So here, this is made in\nplastic so that you can see it."
    } ]
  }, {
    "tStartMs": 4471980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But in reality, it's\ngotta be a lot stiffer."
    } ]
  }, {
    "tStartMs": 4474560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So here it is made in steel.\n- What?"
    } ]
  }, {
    "tStartMs": 4476810,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So hang on, you're saying that that thing,"
    } ]
  }, {
    "tStartMs": 4479780,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "which is made of steel,\n- Yep."
    } ]
  }, {
    "tStartMs": 4482030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- you spin it up to a certain speed,"
    } ]
  }, {
    "tStartMs": 4484400,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "and then it expands and engages\na drum that's around it?"
    } ]
  }, {
    "tStartMs": 4487613,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- Yep, yep."
    } ]
  }, {
    "tStartMs": 4489530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So it'll idle with no motion,"
    } ]
  }, {
    "tStartMs": 4492350,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "but then at a certain speed,\nwhat we designed it for,"
    } ]
  }, {
    "tStartMs": 4495410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it'll speed up to that RPM."
    } ]
  }, {
    "tStartMs": 4497270,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- You speed it up and it engage?"
    } ]
  }, {
    "tStartMs": 4498620,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 4499790,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- I had no idea."
    } ]
  }, {
    "tStartMs": 4500990,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Like I have learned something today."
    } ]
  }, {
    "tStartMs": 4502940,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So let's come back to the\nsafing and arming device"
    } ]
  }, {
    "tStartMs": 4505340,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "for nuclear weapons."
    } ]
  }, {
    "tStartMs": 4506750,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Its purpose is to ensure\nthat no random vibrations,"
    } ]
  }, {
    "tStartMs": 4509810,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "say, from an earthquake,"
    } ]
  }, {
    "tStartMs": 4511310,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "inadvertently disable safeties\nand arm the nuclear weapon."
    } ]
  }, {
    "tStartMs": 4515480,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Now, one of the requirements\nwas that this device"
    } ]
  }, {
    "tStartMs": 4517730,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "be made as small as possible."
    } ]
  }, {
    "tStartMs": 4519710,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- They made those as small\nas they possibly could"
    } ]
  }, {
    "tStartMs": 4523040,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "using traditional\nmethods, even using things"
    } ]
  }, {
    "tStartMs": 4525830,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "like what the Swiss watch\nmanufacturers were using."
    } ]
  }, {
    "tStartMs": 4529010,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- With compliant mechanisms,"
    } ]
  }, {
    "tStartMs": 4530390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "they produced a device out\nof hardened stainless steel"
    } ]
  }, {
    "tStartMs": 4533630,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "where some components were\nthe size of a human hair."
    } ]
  }, {
    "tStartMs": 4536600,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "This is high speed video."
    } ]
  }, {
    "tStartMs": 4538610,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Here, the device is operating at 72 hertz,"
    } ]
  }, {
    "tStartMs": 4541550,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "meaning this little hole"
    } ]
  }, {
    "tStartMs": 4542690,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "makes two complete\nrevolutions each second."
    } ]
  }, {
    "tStartMs": 4545870,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The way it's meant to\nwork is an arming laser"
    } ]
  }, {
    "tStartMs": 4548000,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "shines on the rotor wheel,"
    } ]
  }, {
    "tStartMs": 4549410,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and when the proper input\nis given to the system,"
    } ]
  }, {
    "tStartMs": 4551780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "the wheel rotates a notch."
    } ]
  }, {
    "tStartMs": 4553760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If all the proper inputs are given,"
    } ]
  }, {
    "tStartMs": 4555860,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "then the hole lines up with a laser beam"
    } ]
  }, {
    "tStartMs": 4558200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and crazy things happen from there."
    } ]
  }, {
    "tStartMs": 4560870,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So it is essential that\nthis device's performance"
    } ]
  }, {
    "tStartMs": 4564350,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is perfectly predictable,"
    } ]
  }, {
    "tStartMs": 4566990,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "even if it sits unused\nin a silo for decades."
    } ]
  }, {
    "tStartMs": 4570620,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "- So are these now being\nused on nuclear weapons?"
    } ]
  }, {
    "tStartMs": 4574040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- You know, it turns\nout they don't tell us"
    } ]
  }, {
    "tStartMs": 4576050,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "what they do with their nuclear weapons."
    } ]
  }, {
    "tStartMs": 4577730,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And so, we designed\nthem, we made prototypes,"
    } ]
  }, {
    "tStartMs": 4579890,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "we tested them,"
    } ]
  }, {
    "tStartMs": 4581000,
    "dDurationMs": 2999,
    "segs": [ {
      "utf8": "and then it goes what\nthey call behind the fence"
    } ]
  }, {
    "tStartMs": 4583999,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "where it's all classified,"
    } ]
  }, {
    "tStartMs": 4586460,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "and you know, we don't\nknow what happens, so."
    } ]
  }, {
    "tStartMs": 4590690,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- But these soft components by themselves"
    } ]
  }, {
    "tStartMs": 4592490,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "aren't truly robots."
    } ]
  }, {
    "tStartMs": 4594110,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It's only once you combine\nthem with computers"
    } ]
  }, {
    "tStartMs": 4596930,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that you get robots which\ncan autonomously form"
    } ]
  }, {
    "tStartMs": 4599300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "crazy shapes or new styles of movement,"
    } ]
  }, {
    "tStartMs": 4601340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "all because they bend."
    } ]
  }, {
    "tStartMs": 4603860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But how do they work,"
    } ]
  }, {
    "tStartMs": 4605690,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "and why would you want a soft\nrobot in the first place?"
    } ]
  }, {
    "tStartMs": 4612680,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So I came up to Stanford\nto meet Zach Hammond"
    } ]
  }, {
    "tStartMs": 4615590,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and his soft robot."
    } ]
  }, {
    "tStartMs": 4617030,
    "dDurationMs": 1617,
    "segs": [ {
      "utf8": "- Hey, Derek.\n- How's it going?"
    } ]
  }, {
    "tStartMs": 4618647,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "- [Derek] All right, you wanna tip it?"
    } ]
  }, {
    "tStartMs": 4623930,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "So is the idea that the\nrobot could walk this way?"
    } ]
  }, {
    "tStartMs": 4627890,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Totally, yeah."
    } ]
  }, {
    "tStartMs": 4628723,
    "dDurationMs": 2977,
    "segs": [ {
      "utf8": "So you can kinda chain\nthese roles together"
    } ]
  }, {
    "tStartMs": 4631700,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "to kind of roll around in any environment."
    } ]
  }, {
    "tStartMs": 4634520,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They call this punctuated\nrolling locomotion,"
    } ]
  }, {
    "tStartMs": 4636980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "wherein it's kind of stuck on a face"
    } ]
  }, {
    "tStartMs": 4639080,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "until it tips over, and\nnow it's on a new face,"
    } ]
  }, {
    "tStartMs": 4641090,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and it can then continue to\nmove its center of gravity."
    } ]
  }, {
    "tStartMs": 4644360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Once that center of gravity\nexits the support polygon"
    } ]
  }, {
    "tStartMs": 4647450,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "or the base, then it tips over\none of the edges of the face."
    } ]
  }, {
    "tStartMs": 4653000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- [Derek] This is a different soft robot"
    } ]
  }, {
    "tStartMs": 4655070,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "made out of flexible tubing."
    } ]
  }, {
    "tStartMs": 4657050,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "It was designed to mimic\nthe way a turtle walks,"
    } ]
  }, {
    "tStartMs": 4660740,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "where diagonally opposite\nlegs move together."
    } ]
  }, {
    "tStartMs": 4664070,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "It's powered entirely by compressed air,"
    } ]
  }, {
    "tStartMs": 4667400,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "and perhaps most impressive,\nit requires no electronics."
    } ]
  }, {
    "tStartMs": 4671990,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "All of the circuitry is pneumatic."
    } ]
  }, {
    "tStartMs": 4674810,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "And this means the robot can\nbe used in places like mines,"
    } ]
  }, {
    "tStartMs": 4678350,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where electronics could spark explosions,"
    } ]
  }, {
    "tStartMs": 4681050,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "or in the strong magnetic\nfields around MRI machines."
    } ]
  }, {
    "tStartMs": 4685460,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But why would you want a soft\nrobot in the first place?"
    } ]
  }, {
    "tStartMs": 4688820,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "- One of the things that I like to do"
    } ]
  }, {
    "tStartMs": 4689740,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "is just to take the robot"
    } ]
  }, {
    "tStartMs": 4691010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and kind of like beat it up a little bit,"
    } ]
  }, {
    "tStartMs": 4693590,
    "dDurationMs": 2971,
    "segs": [ {
      "utf8": "show how it's compliant and compressive."
    } ]
  }, {
    "tStartMs": 4696561,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "- [Derek] Well, because they're safer."
    } ]
  }, {
    "tStartMs": 4698180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- If you'd like to take\na whack at it, feel free."
    } ]
  }, {
    "tStartMs": 4700580,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- But this is your work."
    } ]
  }, {
    "tStartMs": 4702230,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I don't wanna break it obviously."
    } ]
  }, {
    "tStartMs": 4703063,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "- No, feel free. Go for it."
    } ]
  }, {
    "tStartMs": 4704450,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- For operation around humans,"
    } ]
  }, {
    "tStartMs": 4706100,
    "dDurationMs": 2853,
    "segs": [ {
      "utf8": "there's not much damage a\nsoft robot can do to you."
    } ]
  }, {
    "tStartMs": 4711110,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "I can stand on these?"
    } ]
  }, {
    "tStartMs": 4712160,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 4713690,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "- This is a pretty crazy compliant robot."
    } ]
  }, {
    "tStartMs": 4716720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Because the fundamental structure"
    } ]
  }, {
    "tStartMs": 4719120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of this robot is compliant,"
    } ]
  }, {
    "tStartMs": 4720980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "there's only some maximum force"
    } ]
  }, {
    "tStartMs": 4723560,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "that it could ever exert on me."
    } ]
  }, {
    "tStartMs": 4725200,
    "dDurationMs": 3223,
    "segs": [ {
      "utf8": "So it's inherently safe to\nbe operating around people."
    } ]
  }, {
    "tStartMs": 4731240,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "- [Derek] Could we make it\nfall and have me be inside it?"
    } ]
  }, {
    "tStartMs": 4734780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Yeah, yeah, we could do that for sure."
    } ]
  }, {
    "tStartMs": 4737000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Just watch your head."
    } ]
  }, {
    "tStartMs": 4738200,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Yep. If I go over here."
    } ]
  }, {
    "tStartMs": 4739370,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "- If you're there, yeah, we can do that."
    } ]
  }, {
    "tStartMs": 4741260,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "- All right, let's try it."
    } ]
  }, {
    "tStartMs": 4745310,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "Here it comes."
    } ]
  }, {
    "tStartMs": 4748670,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Well, that's not bad at all, is it?"
    } ]
  }, {
    "tStartMs": 4750110,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Zach] I can try another shape"
    } ]
  }, {
    "tStartMs": 4751880,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that's supposed to open\nup one of the faces"
    } ]
  }, {
    "tStartMs": 4753680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "so you can jump out of it quickly."
    } ]
  }, {
    "tStartMs": 4755450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 4756283,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "- [Zach] I haven't tested\nit in a little while,"
    } ]
  }, {
    "tStartMs": 4757160,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "so I dunno how it's gonna\ngo, but let's try this."
    } ]
  }, {
    "tStartMs": 4760550,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There you go, that's it."
    } ]
  }, {
    "tStartMs": 4761383,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "Face right there to your right,"
    } ]
  }, {
    "tStartMs": 4762620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and you can exit the truss from that face."
    } ]
  }, {
    "tStartMs": 4765260,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- Boom, just that easy.\n- Perfect."
    } ]
  }, {
    "tStartMs": 4768230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- [Derek] Did you build this by yourself?"
    } ]
  }, {
    "tStartMs": 4770420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "- Me and one other grad student"
    } ]
  }, {
    "tStartMs": 4772520,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "built this entire thing\nourselves basically."
    } ]
  }, {
    "tStartMs": 4774800,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Derek] And how long did it take?"
    } ]
  }, {
    "tStartMs": 4775880,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Zach] We did it in about\na month, I want to say,"
    } ]
  }, {
    "tStartMs": 4778370,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "like actually constructing everything."
    } ]
  }, {
    "tStartMs": 4780020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Derek] And was it tricky?"
    } ]
  }, {
    "tStartMs": 4780853,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "I mean, were you sewing that stuff?"
    } ]
  }, {
    "tStartMs": 4782210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "- Yep, we sewed this all ourselves."
    } ]
  }, {
    "tStartMs": 4784160,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- [Derek] The main structural\nmembers of this robot"
    } ]
  }, {
    "tStartMs": 4786590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "are fabric tubes inflated with air."
    } ]
  }, {
    "tStartMs": 4789920,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "- Yeah. So these red\ntubes are a nylon fabric,"
    } ]
  }, {
    "tStartMs": 4793910,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and then internally there\nis a polyethylene tube"
    } ]
  }, {
    "tStartMs": 4796820,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that provides the air tightness."
    } ]
  }, {
    "tStartMs": 4799190,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Derek] The tubes are inflated"
    } ]
  }, {
    "tStartMs": 4800090,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to about six PSI above atmospheric."
    } ]
  }, {
    "tStartMs": 4803420,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So it's almost one and a half atmospheres."
    } ]
  }, {
    "tStartMs": 4806720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Each tube passes through pairs of rollers"
    } ]
  }, {
    "tStartMs": 4809300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "connected to a motor."
    } ]
  }, {
    "tStartMs": 4810770,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "The rollers pinch the tube so it bends"
    } ]
  }, {
    "tStartMs": 4813080,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "kinda like a pinched straw."
    } ]
  }, {
    "tStartMs": 4815570,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Have the rods,"
    } ]
  }, {
    "tStartMs": 4816403,
    "dDurationMs": 1747,
    "segs": [ {
      "utf8": "and then we have this like\nhigh friction material"
    } ]
  }, {
    "tStartMs": 4818150,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "wrapped around the rods."
    } ]
  }, {
    "tStartMs": 4819230,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "And then that coupled with the fact"
    } ]
  }, {
    "tStartMs": 4820640,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "that we have this pressurized\ntube that's kinda pushing"
    } ]
  }, {
    "tStartMs": 4823310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "the membrane of the tube into the rollers"
    } ]
  }, {
    "tStartMs": 4825500,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "prevents us from slipping."
    } ]
  }, {
    "tStartMs": 4826820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Derek] By driving the motor,"
    } ]
  }, {
    "tStartMs": 4828020,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "it changes the lengths of the tubes."
    } ]
  }, {
    "tStartMs": 4830840,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- Kind of like when a clown\ncreates a twist in a balloon"
    } ]
  }, {
    "tStartMs": 4834530,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and then folds that balloon\ninto a balloon animal."
    } ]
  }, {
    "tStartMs": 4837800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The difference between what\nthe clown does and what we do"
    } ]
  }, {
    "tStartMs": 4840050,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "is that there's some passage of air"
    } ]
  }, {
    "tStartMs": 4841940,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "between adjacent segments of the tube,"
    } ]
  }, {
    "tStartMs": 4844160,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "so that as the robot drives around,"
    } ]
  }, {
    "tStartMs": 4846350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "we're not pressurizing\nthe segments of the tube."
    } ]
  }, {
    "tStartMs": 4849140,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- [Derek] This robot is\nmade of four inflated tubes,"
    } ]
  }, {
    "tStartMs": 4852050,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "each one connected to a pair of motors,"
    } ]
  }, {
    "tStartMs": 4854150,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "forming triangular sides."
    } ]
  }, {
    "tStartMs": 4856010,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- We also think that they kind\nof look like sausage links"
    } ]
  }, {
    "tStartMs": 4858710,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "when put together, which is\nwhy we've named these robots"
    } ]
  }, {
    "tStartMs": 4861980,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "after different sausages."
    } ]
  }, {
    "tStartMs": 4863150,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So this one's called Polish."
    } ]
  }, {
    "tStartMs": 4864830,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "That one over there is Chorizo."
    } ]
  }, {
    "tStartMs": 4866450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "There's a Linguica, and a\nKielbasa over there somewhere."
    } ]
  }, {
    "tStartMs": 4869930,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Derek] So what shape\nis the overall thing?"
    } ]
  }, {
    "tStartMs": 4871400,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "It's an octahedron?"
    } ]
  }, {
    "tStartMs": 4872510,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- Yeah, we call it an octahedron,"
    } ]
  }, {
    "tStartMs": 4873740,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "because if you drew lines"
    } ]
  }, {
    "tStartMs": 4875420,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "between these kind of\nkinematic joints here,"
    } ]
  }, {
    "tStartMs": 4879140,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "it would create an octahedron shape."
    } ]
  }, {
    "tStartMs": 4881600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- Driving the motors\ntogether allows the robot"
    } ]
  }, {
    "tStartMs": 4883790,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to dramatically change shape."
    } ]
  }, {
    "tStartMs": 4885710,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "It can get very tall, or short and squat."
    } ]
  }, {
    "tStartMs": 4890600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But since the tubes themselves\ndon't change in length,"
    } ]
  }, {
    "tStartMs": 4893480,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "the overall perimeter of the robot,"
    } ]
  }, {
    "tStartMs": 4895370,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "the length of all the edges\ncombined, doesn't change."
    } ]
  }, {
    "tStartMs": 4898760,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "So the robot is considered isoperimetric."
    } ]
  }, {
    "tStartMs": 4904040,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "How do you feel when you watch\nthose Boston Dynamics videos?"
    } ]
  }, {
    "tStartMs": 4907340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Oh, I love those\nvideos. They're so cool."
    } ]
  }, {
    "tStartMs": 4909020,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- The Boston Dynamics robots\nare kind of terrifying."
    } ]
  }, {
    "tStartMs": 4911510,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Like isn't the idea with soft robots"
    } ]
  }, {
    "tStartMs": 4913190,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "to like convince people that\nrobots are good, and soft,"
    } ]
  }, {
    "tStartMs": 4915740,
    "dDurationMs": 857,
    "segs": [ {
      "utf8": "and kind, and friendly, and safe?"
    } ]
  }, {
    "tStartMs": 4916597,
    "dDurationMs": 2143,
    "segs": [ {
      "utf8": "- That's that's definitely true, yeah."
    } ]
  }, {
    "tStartMs": 4918740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "There are some things that\nyou can do to rigid systems"
    } ]
  }, {
    "tStartMs": 4921710,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to make them feel like compliant systems"
    } ]
  }, {
    "tStartMs": 4923870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "based on how you're\ncontrolling the motors."
    } ]
  }, {
    "tStartMs": 4925970,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "But yeah, they're\ndefinitely heavy, expensive,"
    } ]
  }, {
    "tStartMs": 4928880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and can be dangerous if\nthey're not used correctly."
    } ]
  }, {
    "tStartMs": 4932720,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Derek] The hard robots we're used to"
    } ]
  }, {
    "tStartMs": 4934370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "are strong and precise."
    } ]
  }, {
    "tStartMs": 4936710,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Their actions are accurate and repeatable,"
    } ]
  }, {
    "tStartMs": 4939620,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "but they are also heavy,"
    } ]
  }, {
    "tStartMs": 4941540,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and they can't really change\ntheir volume as dramatically."
    } ]
  }, {
    "tStartMs": 4945080,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "But this robot is still capable\nof carrying a heavy load."
    } ]
  }, {
    "tStartMs": 4949220,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- So I have a GUI in MATLAB\n- Oh, nice."
    } ]
  }, {
    "tStartMs": 4951410,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- that enables me to just put in"
    } ]
  }, {
    "tStartMs": 4953540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the positions that I want\nthe robots to move in inches"
    } ]
  }, {
    "tStartMs": 4956540,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "and then send them out."
    } ]
  }, {
    "tStartMs": 4957440,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "There's some other functionality."
    } ]
  }, {
    "tStartMs": 4958580,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I have some stored configurations\nto send to the robots."
    } ]
  }, {
    "tStartMs": 4962060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- [Derek] Soft robots\nalso have the advantage"
    } ]
  }, {
    "tStartMs": 4963980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of shape changing."
    } ]
  }, {
    "tStartMs": 4965780,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "They can become tall to go over obstacles,"
    } ]
  }, {
    "tStartMs": 4968450,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "or short to fit under obstructions."
    } ]
  }, {
    "tStartMs": 4971150,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- So if there's some\nrock that it didn't see,"
    } ]
  }, {
    "tStartMs": 4974060,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "or that it wanted to roll\nover, it could simply do that,"
    } ]
  }, {
    "tStartMs": 4976667,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "and the compliance of the tubes"
    } ]
  }, {
    "tStartMs": 4978710,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "would simply just bend\naround that disturbance."
    } ]
  }, {
    "tStartMs": 4981740,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- Do you imagine robots like\nthis doing work in space?"
    } ]
  }, {
    "tStartMs": 4985460,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Oh yeah, definitely."
    } ]
  }, {
    "tStartMs": 4986600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So one of the nice things\nabout these types of structures"
    } ]
  }, {
    "tStartMs": 4989540,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "is that they can shrink down\ntheir volume very drastically."
    } ]
  }, {
    "tStartMs": 4993050,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "And because volume on rockets\nis such an expensive premium,"
    } ]
  }, {
    "tStartMs": 4997640,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "being able to have a robot"
    } ]
  }, {
    "tStartMs": 4998780,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "that can pack down small for\ntransport is very valuable."
    } ]
  }, {
    "tStartMs": 5001810,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So NASA was at one point\nlooking into trust robots"
    } ]
  }, {
    "tStartMs": 5005170,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "for exactly that reason."
    } ]
  }, {
    "tStartMs": 5006670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And they've contacted us\nsince we've made this robot"
    } ]
  }, {
    "tStartMs": 5008800,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "to explore different ideas for\nspace exploration projects."
    } ]
  }, {
    "tStartMs": 5013060,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So one of the things that\nthey're thinking about doing"
    } ]
  }, {
    "tStartMs": 5014740,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "is deploying robots\nunderneath a sheet of ice."
    } ]
  }, {
    "tStartMs": 5017740,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So they're gonna drill\nthrough this sheet of ice"
    } ]
  }, {
    "tStartMs": 5019780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and then deposit a robot"
    } ]
  }, {
    "tStartMs": 5021640,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "through what is kind of\na small diameter hole."
    } ]
  }, {
    "tStartMs": 5024820,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And so, if you can have a robot"
    } ]
  }, {
    "tStartMs": 5026200,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that can change its\nvolume very drastically,"
    } ]
  }, {
    "tStartMs": 5028330,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "or be disassembled and then reassembled"
    } ]
  }, {
    "tStartMs": 5031240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to form a much larger structure,"
    } ]
  }, {
    "tStartMs": 5033640,
    "dDurationMs": 1923,
    "segs": [ {
      "utf8": "then you can have large robots"
    } ]
  }, {
    "tStartMs": 5035563,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "that are able to fit\nthrough these tight spaces"
    } ]
  }, {
    "tStartMs": 5037930,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and be deployed in\ndifficult to access areas."
    } ]
  }, {
    "tStartMs": 5041140,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "- Is this a little bit like an octopus?"
    } ]
  }, {
    "tStartMs": 5043270,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Is that how you can think of it?"
    } ]
  }, {
    "tStartMs": 5044740,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- There is some connection there,"
    } ]
  }, {
    "tStartMs": 5046060,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "because they use their\nshape changing ability"
    } ]
  }, {
    "tStartMs": 5048250,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and their compliance to squeeze\nthrough tight passageways,"
    } ]
  }, {
    "tStartMs": 5051280,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and then also to wrap\ntheir body around objects."
    } ]
  }, {
    "tStartMs": 5054520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So for example, they can open\njars with their tentacles."
    } ]
  }, {
    "tStartMs": 5057310,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And one of the things that\nwe want to use this robot for"
    } ]
  }, {
    "tStartMs": 5059740,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is grasping and manipulating objects."
    } ]
  }, {
    "tStartMs": 5062020,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- [Derek] This robot is even capable"
    } ]
  }, {
    "tStartMs": 5063790,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "of picking objects up off the ground."
    } ]
  }, {
    "tStartMs": 5069130,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "- We'll try that and\nsee if it can grab it."
    } ]
  }, {
    "tStartMs": 5074650,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Because of the compliance of the tubes,"
    } ]
  }, {
    "tStartMs": 5077230,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it has a natural ability to\ngrasp and manipulate objects,"
    } ]
  }, {
    "tStartMs": 5079930,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "because as it does so, the\ntubes bend ever so slightly,"
    } ]
  }, {
    "tStartMs": 5083200,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "which increases the contact area"
    } ]
  }, {
    "tStartMs": 5085630,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and distributes evenly the forces"
    } ]
  }, {
    "tStartMs": 5087760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that are exerted on that object."
    } ]
  }, {
    "tStartMs": 5089800,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "- [Derek] So I mean, is the\nbiggest risk if it pops?"
    } ]
  }, {
    "tStartMs": 5093790,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Yeah, that's a big risk."
    } ]
  }, {
    "tStartMs": 5095260,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I mean, you obviously\nneed the compressed air"
    } ]
  }, {
    "tStartMs": 5098560,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "for your structure."
    } ]
  }, {
    "tStartMs": 5099460,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "And so, if you have a leak."
    } ]
  }, {
    "tStartMs": 5100783,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "(air whooshing)"
    } ]
  }, {
    "tStartMs": 5102130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 5106900,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Then you don't have a robot, right?"
    } ]
  }, {
    "tStartMs": 5109930,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "- [Derek] It's a pretty big\ndrawback of soft robots."
    } ]
  }, {
    "tStartMs": 5112870,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- Some things that you\ncould do to mitigate that"
    } ]
  }, {
    "tStartMs": 5114550,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "would be to have onboard\na small compressor,"
    } ]
  }, {
    "tStartMs": 5117250,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which isn't there to\nprovide power to the robot,"
    } ]
  }, {
    "tStartMs": 5120370,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "but would help you maintain pressure"
    } ]
  }, {
    "tStartMs": 5122740,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "if there were any small leaks."
    } ]
  }, {
    "tStartMs": 5124330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Derek] When you tell someone\nyou're working on a robot"
    } ]
  }, {
    "tStartMs": 5126070,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and they see this, does\nit defy expectations?"
    } ]
  }, {
    "tStartMs": 5128860,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- Totally."
    } ]
  }, {
    "tStartMs": 5129760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They have no idea what\nit is I'm talking about"
    } ]
  }, {
    "tStartMs": 5131560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "until I show them like\na video or a picture."
    } ]
  }, {
    "tStartMs": 5134200,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "I think most people's\nconception of soft robots"
    } ]
  }, {
    "tStartMs": 5138070,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "was really expanded by\nthe movie \"Big Hero 6.\""
    } ]
  }, {
    "tStartMs": 5140950,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And I think they did a great job"
    } ]
  }, {
    "tStartMs": 5142270,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "in kind of showcasing\nwhat a soft robot can do"
    } ]
  }, {
    "tStartMs": 5145210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and why they're useful,"
    } ]
  }, {
    "tStartMs": 5146440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and kind of just popularizing the notion."
    } ]
  }, {
    "tStartMs": 5148360,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It's really great to have compliance"
    } ]
  }, {
    "tStartMs": 5150430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "built into any mechanical system,"
    } ]
  }, {
    "tStartMs": 5152530,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "especially as we want robots"
    } ]
  }, {
    "tStartMs": 5154090,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to work closer and closer with humans."
    } ]
  }, {
    "tStartMs": 5156070,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "So I think we'll definitely see more"
    } ]
  }, {
    "tStartMs": 5157660,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "soft robots in the future."
    } ]
  }, {
    "tStartMs": 5160180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- So maybe robots will\nenter our daily lives"
    } ]
  }, {
    "tStartMs": 5162520,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "sooner than we think,"
    } ]
  }, {
    "tStartMs": 5163600,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "just not in multipurpose humanoid form."
    } ]
  }, {
    "tStartMs": 5166510,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "In fact, one specialty robot\nis already becoming widespread,"
    } ]
  }, {
    "tStartMs": 5169900,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "the glorious Roomba, built\nfor maximum vacuuming."
    } ]
  }, {
    "tStartMs": 5173890,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Do you think the way that robots"
    } ]
  }, {
    "tStartMs": 5175540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "integrate themselves into our lives"
    } ]
  }, {
    "tStartMs": 5177760,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "will be like a humanoid\nrobot in your house,"
    } ]
  }, {
    "tStartMs": 5181390,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "or will it be specialized little things"
    } ]
  }, {
    "tStartMs": 5186070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that we don't even think of\nas robots but they sort of?"
    } ]
  }, {
    "tStartMs": 5188650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Slowly infiltrate, yeah."
    } ]
  }, {
    "tStartMs": 5190300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I think probably the latter\nis gonna happen first,"
    } ]
  }, {
    "tStartMs": 5193060,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "would be my guess."
    } ]
  }, {
    "tStartMs": 5194110,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I mean, little things like, yeah,"
    } ]
  }, {
    "tStartMs": 5197380,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "like things just start getting smarter,"
    } ]
  }, {
    "tStartMs": 5199090,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "whether it's your shoes,\nyour watch, or your car,"
    } ]
  }, {
    "tStartMs": 5202450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "your thermostat, all those things,"
    } ]
  }, {
    "tStartMs": 5204760,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "and then before like your\nmaid shows up as a robot."
    } ]
  }, {
    "tStartMs": 5209140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- By dropping the human model of a robot,"
    } ]
  }, {
    "tStartMs": 5210940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "instead we can choose\nthe best possible shapes"
    } ]
  }, {
    "tStartMs": 5212980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and materials that maximize\nspecific abilities."
    } ]
  }, {
    "tStartMs": 5215560,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And with this method,\nwe've already built robots"
    } ]
  }, {
    "tStartMs": 5217510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that can save your life,"
    } ]
  }, {
    "tStartMs": 5219130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "leap tall buildings in a single bound,"
    } ]
  }, {
    "tStartMs": 5221380,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "move with super speed,\nprotect your valuables,"
    } ]
  }, {
    "tStartMs": 5224560,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and shapeshift."
    } ]
  }, {
    "tStartMs": 5226690,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "You know, come to think of it,"
    } ]
  }, {
    "tStartMs": 5227770,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "they'd make a pretty good superhero team."
    } ]
  } ]
}
