{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 239,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(shade balls rolling)"
    } ]
  }, {
    "tStartMs": 4290,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "- These are shade balls."
    } ]
  }, {
    "tStartMs": 6880,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They're being dumped\ninto this water reservoir"
    } ]
  }, {
    "tStartMs": 9130,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "in Los Angeles."
    } ]
  }, {
    "tStartMs": 10910,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And contrary to what you may have heard,"
    } ]
  }, {
    "tStartMs": 13010,
    "dDurationMs": 3623,
    "segs": [ {
      "utf8": "their main purpose is not\nto reduce evaporation."
    } ]
  }, {
    "tStartMs": 17730,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So what are they really for?"
    } ]
  }, {
    "tStartMs": 20170,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "To find out, I'm visiting\nthe largest collection"
    } ]
  }, {
    "tStartMs": 23000,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "of these balls anywhere on earth,"
    } ]
  }, {
    "tStartMs": 24821,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 25654,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "at LA Reservoir."
    } ]
  }, {
    "tStartMs": 27490,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(tranquil music)"
    } ]
  }, {
    "tStartMs": 32650,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "96 million shade balls."
    } ]
  }, {
    "tStartMs": 34550,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "- [Man 1] That's correct."
    } ]
  }, {
    "tStartMs": 35483,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 36780,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "- 96 million."
    } ]
  }, {
    "tStartMs": 39120,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "It's very rare to for you to\nsee 96 million of anything."
    } ]
  }, {
    "tStartMs": 41517,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Man 1] Yeah."
    } ]
  }, {
    "tStartMs": 42350,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 43183,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "- This is your life vest which\nyou are required to wear."
    } ]
  }, {
    "tStartMs": 45460,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "- All right."
    } ]
  }, {
    "tStartMs": 46370,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "- Throw a leg over and\nclimb on in any way you can."
    } ]
  }, {
    "tStartMs": 49303,
    "dDurationMs": 2071,
    "segs": [ {
      "utf8": "(tranquil music)"
    } ]
  }, {
    "tStartMs": 51374,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "There you go."
    } ]
  }, {
    "tStartMs": 52207,
    "dDurationMs": 1813,
    "segs": [ {
      "utf8": "- [Narrator] Thank you."
    } ]
  }, {
    "tStartMs": 54020,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Looking at this, I had so many questions."
    } ]
  }, {
    "tStartMs": 57280,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Like, why are they black?"
    } ]
  }, {
    "tStartMs": 59110,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Are they safe to have in drinking water?"
    } ]
  }, {
    "tStartMs": 61740,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "How much do they cost?"
    } ]
  }, {
    "tStartMs": 63400,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "Do they actually reduce evaporation?"
    } ]
  }, {
    "tStartMs": 65735,
    "dDurationMs": 3468,
    "segs": [ {
      "utf8": "And, what is their real purpose?"
    } ]
  }, {
    "tStartMs": 69203,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "(boat engine roaring)"
    } ]
  }, {
    "tStartMs": 72970,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Is that hard to drive in shade balls?"
    } ]
  }, {
    "tStartMs": 74560,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "- It is very hard."
    } ]
  }, {
    "tStartMs": 75570,
    "dDurationMs": 1195,
    "segs": [ {
      "utf8": "- Why is that?"
    } ]
  }, {
    "tStartMs": 76765,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "- 'Cause..."
    } ]
  }, {
    "tStartMs": 78017,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "(boat engine drowns James voice)"
    } ]
  }, {
    "tStartMs": 79850,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "- These are actually\npartially filled with water,"
    } ]
  }, {
    "tStartMs": 82500,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and the reason they are\nfilled with water is that,"
    } ]
  }, {
    "tStartMs": 84810,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "at LA Reservoir we have\nsome really high winds"
    } ]
  }, {
    "tStartMs": 86930,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and so, you know, if we didn't\nput water into these things,"
    } ]
  }, {
    "tStartMs": 89660,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "there would be balls down\nbouncing on the 5 Freeway,"
    } ]
  }, {
    "tStartMs": 91750,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "people drive down, they'd\nbe all over the place."
    } ]
  }, {
    "tStartMs": 93630,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So, these keep the balls in the reservoir"
    } ]
  }, {
    "tStartMs": 96210,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and if they do start to roll,"
    } ]
  }, {
    "tStartMs": 97590,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "they kind of wobble because\nthe water makes them uneven."
    } ]
  }, {
    "tStartMs": 100120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Narrator] But that\nmakes them significantly"
    } ]
  }, {
    "tStartMs": 101770,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "more difficult to push out of the way."
    } ]
  }, {
    "tStartMs": 103740,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Especially, when they form close packed"
    } ]
  }, {
    "tStartMs": 106070,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "crystal-like structures."
    } ]
  }, {
    "tStartMs": 108280,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Behind the boat, the balls\nquickly come together"
    } ]
  }, {
    "tStartMs": 110880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in our wake."
    } ]
  }, {
    "tStartMs": 112470,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "And some close to the motor\nare pulled along with the boat."
    } ]
  }, {
    "tStartMs": 116474,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(boat engine stopping)"
    } ]
  }, {
    "tStartMs": 121950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Wow!"
    } ]
  }, {
    "tStartMs": 124786,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "(wind blowing)"
    } ]
  }, {
    "tStartMs": 127459,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 128540,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "What did you think, the\nfirst time they suggested"
    } ]
  }, {
    "tStartMs": 131550,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "doing this or when it first came in?"
    } ]
  }, {
    "tStartMs": 134670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- Yeah, it was a little out there."
    } ]
  }, {
    "tStartMs": 136890,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Narrator] Did you think they were nuts?"
    } ]
  }, {
    "tStartMs": 138210,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "- No, not nuts."
    } ]
  }, {
    "tStartMs": 140294,
    "dDurationMs": 2416,
    "segs": [ {
      "utf8": "- [Narrator] Well, it\njust, it like looks absurd."
    } ]
  }, {
    "tStartMs": 142710,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "It's like we're in the\nworld's biggest ball pit."
    } ]
  }, {
    "tStartMs": 145000,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Right, yeah, that's what it looks like."
    } ]
  }, {
    "tStartMs": 146170,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Yeah, you can't tell by standing here"
    } ]
  }, {
    "tStartMs": 148110,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that we are actually floating"
    } ]
  }, {
    "tStartMs": 149950,
    "dDurationMs": 2444,
    "segs": [ {
      "utf8": "over, I think it's probably,"
    } ]
  }, {
    "tStartMs": 152394,
    "dDurationMs": 4636,
    "segs": [ {
      "utf8": "40 feet right here, 40,\n50 feet deep below us,"
    } ]
  }, {
    "tStartMs": 157030,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "and you can't even seen any water."
    } ]
  }, {
    "tStartMs": 160380,
    "dDurationMs": 1448,
    "segs": [ {
      "utf8": "You'd think it was a joke, right?"
    } ]
  }, {
    "tStartMs": 161828,
    "dDurationMs": 922,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 162750,
    "dDurationMs": 1337,
    "segs": [ {
      "utf8": "If you didn't know, you'd go like,"
    } ]
  }, {
    "tStartMs": 164087,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "\"No you're not, that's"
    } ]
  }, {
    "tStartMs": 165260,
    "dDurationMs": 1131,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 166391,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "a green screen or something, right?"
    } ]
  }, {
    "tStartMs": 168130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Yeah, its fake.\""
    } ]
  }, {
    "tStartMs": 168963,
    "dDurationMs": 3297,
    "segs": [ {
      "utf8": "- So like, when I switch\non my tap at home,"
    } ]
  }, {
    "tStartMs": 172260,
    "dDurationMs": 865,
    "segs": [ {
      "utf8": "is the water coming from here?"
    } ]
  }, {
    "tStartMs": 173125,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "- [Hellen] Yes."
    } ]
  }, {
    "tStartMs": 175220,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "- Sometimes or always?"
    } ]
  }, {
    "tStartMs": 176779,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Hellen] Yes, most of the time."
    } ]
  }, {
    "tStartMs": 177612,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Most of the time?"
    } ]
  }, {
    "tStartMs": 178445,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Hellen] Yes."
    } ]
  }, {
    "tStartMs": 179278,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Most of the time the\nwater is coming from here."
    } ]
  }, {
    "tStartMs": 180111,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Hellen] Correct, yes."
    } ]
  }, {
    "tStartMs": 180944,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Absolutely nuts."
    } ]
  }, {
    "tStartMs": 181777,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "So why is LA Reservoir\ncovered in shade balls?"
    } ]
  }, {
    "tStartMs": 185600,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Well, the the problem\nall started with Bromide."
    } ]
  }, {
    "tStartMs": 188220,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "- Bromide is a naturally\noccurring substance."
    } ]
  }, {
    "tStartMs": 190840,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It's associated with salt water"
    } ]
  }, {
    "tStartMs": 192820,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and so normally places\nlike California Aqueduct,"
    } ]
  }, {
    "tStartMs": 196870,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "that comes down from the Delta."
    } ]
  }, {
    "tStartMs": 198540,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "You get some some salt water intrusions,"
    } ]
  }, {
    "tStartMs": 199970,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "so you have some Bromide in the water."
    } ]
  }, {
    "tStartMs": 201510,
    "dDurationMs": 3113,
    "segs": [ {
      "utf8": "Bromide's harmless and it's\nalmost impossible to remove."
    } ]
  }, {
    "tStartMs": 204623,
    "dDurationMs": 3297,
    "segs": [ {
      "utf8": "But, when you disinfect\nthe water with Ozone,"
    } ]
  }, {
    "tStartMs": 207920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that Bromide becomes Bromate."
    } ]
  }, {
    "tStartMs": 210440,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "And Bromate is carcinogenic."
    } ]
  }, {
    "tStartMs": 211750,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "And so around the year\n2000 they wrote regulations"
    } ]
  }, {
    "tStartMs": 215010,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "regulating Bromate."
    } ]
  }, {
    "tStartMs": 215960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And the regulation basically said,"
    } ]
  }, {
    "tStartMs": 217760,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "if you have a treatment\nplant that uses Ozone,"
    } ]
  }, {
    "tStartMs": 220110,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "then you have to watch\nyour Bromate formation."
    } ]
  }, {
    "tStartMs": 222870,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Be careful not to form too much."
    } ]
  }, {
    "tStartMs": 224080,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "So, the only places we\never measured Bromate"
    } ]
  }, {
    "tStartMs": 226220,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "was at our filter plant."
    } ]
  }, {
    "tStartMs": 227550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- [Narrator] And the results\nwere always within the"
    } ]
  }, {
    "tStartMs": 229200,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "10 micrograms per liter\nlimit set by regulators."
    } ]
  }, {
    "tStartMs": 232480,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "So they were confused when they got a call"
    } ]
  }, {
    "tStartMs": 234350,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "from one of their customers,\na beverage company in LA."
    } ]
  }, {
    "tStartMs": 237400,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- They said, \"We have\nsome really high levels"
    } ]
  }, {
    "tStartMs": 239230,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of Bromate showing up,\nare you aware of this?\""
    } ]
  }, {
    "tStartMs": 241240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And we said, \"Well, we\ndon't show anything.\""
    } ]
  }, {
    "tStartMs": 243670,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "- [Narrator] But between\nthe filtration plant"
    } ]
  }, {
    "tStartMs": 245180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the customer was the reservoir."
    } ]
  }, {
    "tStartMs": 247580,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "So they did some tests."
    } ]
  }, {
    "tStartMs": 249730,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "- Almost immediately upon coming"
    } ]
  }, {
    "tStartMs": 251130,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "into to this open reservoir,"
    } ]
  }, {
    "tStartMs": 252630,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "the Bromate levels jumped."
    } ]
  }, {
    "tStartMs": 254600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It turned out that Bromide with Chlorine,"
    } ]
  }, {
    "tStartMs": 257540,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "which was supposed to be safe,"
    } ]
  }, {
    "tStartMs": 258960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "in bright sunlight formed Bromate"
    } ]
  }, {
    "tStartMs": 261280,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "even more than Ozone did."
    } ]
  }, {
    "tStartMs": 263050,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "And so we made the unfortunate\nscientific discovery"
    } ]
  }, {
    "tStartMs": 265743,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "that actually was not part\nof any regulatory scheme."
    } ]
  }, {
    "tStartMs": 269010,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "And so, here we are at the reservoir,"
    } ]
  }, {
    "tStartMs": 271400,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "we have a water source that's\ngot Bromide in it, harmless,"
    } ]
  }, {
    "tStartMs": 274520,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "we have chlorine, we have to\nhave to disinfect the water"
    } ]
  }, {
    "tStartMs": 277120,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "and we have sunlight because it's open."
    } ]
  }, {
    "tStartMs": 279110,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The only choice we have\nis to remove sunlight."
    } ]
  }, {
    "tStartMs": 280730,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "So, we looked at all sorts of things."
    } ]
  }, {
    "tStartMs": 282660,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "We looked at floating\ntarps across the water,"
    } ]
  }, {
    "tStartMs": 285760,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and normally, you put a\nfloating cover on the water"
    } ]
  }, {
    "tStartMs": 287350,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but that's a multi-year project."
    } ]
  }, {
    "tStartMs": 289540,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "And so we said, \"Well, can we manufacture"
    } ]
  }, {
    "tStartMs": 290970,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "these kind of trampoline\nwith poly-like PVC pipe?\""
    } ]
  }, {
    "tStartMs": 294000,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "And we said, \"Well, they'll\njust gonna become bird perches"
    } ]
  }, {
    "tStartMs": 295750,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "and we'll have a big\nwater quality problem.\""
    } ]
  }, {
    "tStartMs": 297587,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "Then we knew we had\nhigh-density polyethylene pipe,"
    } ]
  }, {
    "tStartMs": 301410,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "which is used in the water industry,"
    } ]
  }, {
    "tStartMs": 303080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and we know that it floats."
    } ]
  }, {
    "tStartMs": 304920,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "We at one point thought about"
    } ]
  }, {
    "tStartMs": 306110,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "can we get float a pile of\npipe across the surface."
    } ]
  }, {
    "tStartMs": 308140,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Well, that's hard to do and very expensive"
    } ]
  }, {
    "tStartMs": 310710,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "'cause it's a lot of material."
    } ]
  }, {
    "tStartMs": 312150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So maybe we can take some pipe"
    } ]
  }, {
    "tStartMs": 312983,
    "dDurationMs": 1287,
    "segs": [ {
      "utf8": "and we can run it through a chipper"
    } ]
  }, {
    "tStartMs": 314270,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and we can make a debris\nfield across the surface,"
    } ]
  }, {
    "tStartMs": 316510,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "like the back corner of a lake somewhere."
    } ]
  }, {
    "tStartMs": 318890,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "But, then you have all\nthis mushy, warm water"
    } ]
  }, {
    "tStartMs": 321190,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "with plastic floating on the top"
    } ]
  }, {
    "tStartMs": 322570,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "and that however sounds like a Petri dish."
    } ]
  }, {
    "tStartMs": 324440,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And so low and behold, Dr. Bryan White,"
    } ]
  }, {
    "tStartMs": 326630,
    "dDurationMs": 3294,
    "segs": [ {
      "utf8": "did some research and\nhe found the shade ball."
    } ]
  }, {
    "tStartMs": 329924,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "(tranquil music)"
    } ]
  }, {
    "tStartMs": 331690,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- [Narrator] Except they\nweren't called shade balls"
    } ]
  }, {
    "tStartMs": 333660,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "at the time."
    } ]
  }, {
    "tStartMs": 334536,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "(tranquil music)"
    } ]
  }, {
    "tStartMs": 336010,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "- This product existed and\nthey were called bird balls"
    } ]
  }, {
    "tStartMs": 339210,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "and they used it on ponds\nthat had mine tailings,"
    } ]
  }, {
    "tStartMs": 342940,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "where they didn't want waterfowl\nto go in and get poisoned."
    } ]
  }, {
    "tStartMs": 345620,
    "dDurationMs": 2248,
    "segs": [ {
      "utf8": "And also around airports\nwhere there are ponds"
    } ]
  }, {
    "tStartMs": 347868,
    "dDurationMs": 1652,
    "segs": [ {
      "utf8": "and they want to keep the waterfowl off"
    } ]
  }, {
    "tStartMs": 349520,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "so they didn't take off\nand get into jet engines."
    } ]
  }, {
    "tStartMs": 352077,
    "dDurationMs": 2691,
    "segs": [ {
      "utf8": "(airplane engine roaring)"
    } ]
  }, {
    "tStartMs": 354768,
    "dDurationMs": 1642,
    "segs": [ {
      "utf8": "You know they have actually\ndone wind tunnel testing"
    } ]
  }, {
    "tStartMs": 356410,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "and they blew, you know,\n50, 60 mile of winds across"
    } ]
  }, {
    "tStartMs": 359451,
    "dDurationMs": 1549,
    "segs": [ {
      "utf8": "so they could see how they'd behave."
    } ]
  }, {
    "tStartMs": 361000,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "But, they were really made\nto deter birds and wildlife"
    } ]
  }, {
    "tStartMs": 363270,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "from sitting on the water."
    } ]
  }, {
    "tStartMs": 364460,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Narrator] Did there used\nto be birds landing here more?"
    } ]
  }, {
    "tStartMs": 367010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Absolutely, yes."
    } ]
  }, {
    "tStartMs": 367843,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] Yeah?"
    } ]
  }, {
    "tStartMs": 368676,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 369509,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Once we deployed these balls,"
    } ]
  }, {
    "tStartMs": 370342,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "all the birds were gone."
    } ]
  }, {
    "tStartMs": 371710,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "They used to just hangout, right?"
    } ]
  }, {
    "tStartMs": 373770,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Loiter at the curbs."
    } ]
  }, {
    "tStartMs": 374950,
    "dDurationMs": 2392,
    "segs": [ {
      "utf8": "- Yeah, they'd be all\nover the top of the dam."
    } ]
  }, {
    "tStartMs": 377342,
    "dDurationMs": 1278,
    "segs": [ {
      "utf8": "- [Hellen] You could see\nbirds dropping everywhere."
    } ]
  }, {
    "tStartMs": 378620,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "- [James] They'd be down\nat the outlet tower,"
    } ]
  }, {
    "tStartMs": 380640,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "they'd be everywhere."
    } ]
  }, {
    "tStartMs": 381630,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "We don't get 'em anymore like we used to."
    } ]
  }, {
    "tStartMs": 384110,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "- [Narrator] But before\nbeing added to the reservoir,"
    } ]
  }, {
    "tStartMs": 385780,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "the shade balls had to be tested."
    } ]
  }, {
    "tStartMs": 387930,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Would they actually reduce\nthe formation of Bromate?"
    } ]
  }, {
    "tStartMs": 390720,
    "dDurationMs": 1956,
    "segs": [ {
      "utf8": "- And we bought three kiddie pools,"
    } ]
  }, {
    "tStartMs": 392676,
    "dDurationMs": 1884,
    "segs": [ {
      "utf8": "three little inflatable kiddie pools."
    } ]
  }, {
    "tStartMs": 394560,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "And we filled them all\nwith the reservoir water."
    } ]
  }, {
    "tStartMs": 396550,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "One was in the sunlight,\none we put a tarp on"
    } ]
  }, {
    "tStartMs": 397973,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "and one put shade balls on."
    } ]
  }, {
    "tStartMs": 400290,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "And amazingly, the shade balls knocked out"
    } ]
  }, {
    "tStartMs": 402440,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "the problem immediately."
    } ]
  }, {
    "tStartMs": 404230,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- [Narrator] So the reason\nshade balls are black"
    } ]
  }, {
    "tStartMs": 406070,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "is to block all light\nfrom reaching the water"
    } ]
  }, {
    "tStartMs": 408240,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and triggering the Bromate reaction."
    } ]
  }, {
    "tStartMs": 410540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The black pigment is also safe"
    } ]
  }, {
    "tStartMs": 412040,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "for contact with drinking water"
    } ]
  }, {
    "tStartMs": 413380,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and it's stable even exposed\nto the elements for years."
    } ]
  }, {
    "tStartMs": 417140,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "- They're black for a reason so, you know,"
    } ]
  }, {
    "tStartMs": 419200,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "they're made out of a\nhigh-density polyethylene."
    } ]
  }, {
    "tStartMs": 421140,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "It's the same material that"
    } ]
  }, {
    "tStartMs": 422560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "like a gallon milk jug is made out of."
    } ]
  }, {
    "tStartMs": 424560,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's a food grade plastic"
    } ]
  }, {
    "tStartMs": 426150,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and they would be clear\nlike a milk carton,"
    } ]
  }, {
    "tStartMs": 428190,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "except that they wouldn't last in the sun."
    } ]
  }, {
    "tStartMs": 430290,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "And so, they have a material\ncalled carbon black in them"
    } ]
  }, {
    "tStartMs": 432950,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and that's what makes the plastic last"
    } ]
  }, {
    "tStartMs": 435230,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "for at least 10 years out in the sun."
    } ]
  }, {
    "tStartMs": 436810,
    "dDurationMs": 1146,
    "segs": [ {
      "utf8": "We did test to see"
    } ]
  }, {
    "tStartMs": 437956,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "if there is any other colors we could use."
    } ]
  }, {
    "tStartMs": 439890,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So we actually had the company make"
    } ]
  }, {
    "tStartMs": 442090,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "three different shades of blue,"
    } ]
  }, {
    "tStartMs": 443200,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "but the dyes were so unstable they said,"
    } ]
  }, {
    "tStartMs": 445397,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "\"We can't guarantee it's\ngonna last more than a year.\""
    } ]
  }, {
    "tStartMs": 447580,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "And so, it's that carbon black"
    } ]
  }, {
    "tStartMs": 449147,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "that's the magic powder in this"
    } ]
  }, {
    "tStartMs": 451320,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "that really makes this\nproduct last in the sunlight."
    } ]
  }, {
    "tStartMs": 453670,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "One of the concerns\nthat people raised to me"
    } ]
  }, {
    "tStartMs": 455700,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "when we put first these on, it was that,"
    } ]
  }, {
    "tStartMs": 457900,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "are they gonna get hot and\nthen bleach the material out?"
    } ]
  }, {
    "tStartMs": 460370,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And they don't."
    } ]
  }, {
    "tStartMs": 461203,
    "dDurationMs": 947,
    "segs": [ {
      "utf8": "They're totally inert."
    } ]
  }, {
    "tStartMs": 462150,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I mean, theoretically, you could cut off"
    } ]
  }, {
    "tStartMs": 463560,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "a piece of this ball\nand you could chew it,"
    } ]
  }, {
    "tStartMs": 465360,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "no harm comes to you."
    } ]
  }, {
    "tStartMs": 466280,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is totally food grade,"
    } ]
  }, {
    "tStartMs": 468260,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "nothing wrong with it whatsoever."
    } ]
  }, {
    "tStartMs": 469473,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "- [Narrator] What's it like\ndriving through these things?"
    } ]
  }, {
    "tStartMs": 471196,
    "dDurationMs": 1514,
    "segs": [ {
      "utf8": "- It's difficult."
    } ]
  }, {
    "tStartMs": 472710,
    "dDurationMs": 1915,
    "segs": [ {
      "utf8": "As you can see we've\nbeen sitting here for,"
    } ]
  }, {
    "tStartMs": 474625,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "well, I don't know how\nlong, quite a while,"
    } ]
  }, {
    "tStartMs": 476790,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "and there's a breeze and we haven't moved."
    } ]
  }, {
    "tStartMs": 479080,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I mean anybody that knows,"
    } ]
  }, {
    "tStartMs": 480040,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "that's been on a boat in a lake,"
    } ]
  }, {
    "tStartMs": 481250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "if there's a slight breeze\nand you're on a boat,"
    } ]
  }, {
    "tStartMs": 482960,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "you're drifting, right?"
    } ]
  }, {
    "tStartMs": 484410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Not here."
    } ]
  }, {
    "tStartMs": 485243,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "This thing, they're just stable."
    } ]
  }, {
    "tStartMs": 487770,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "They're (indistinct)"
    } ]
  }, {
    "tStartMs": 489270,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It's interesting when\nyou try to pilot the boat"
    } ]
  }, {
    "tStartMs": 491340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "through these things, its difficult."
    } ]
  }, {
    "tStartMs": 492900,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Narrator] It's like\ndriving through peanut butter"
    } ]
  }, {
    "tStartMs": 493950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or something?"
    } ]
  }, {
    "tStartMs": 494783,
    "dDurationMs": 1247,
    "segs": [ {
      "utf8": "- Or something, I guess, yeah."
    } ]
  }, {
    "tStartMs": 496030,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "Not that I've ever done that but..."
    } ]
  }, {
    "tStartMs": 497439,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 498560,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "- [Narrator] Blocking\nsunlight from the reservoir"
    } ]
  }, {
    "tStartMs": 500250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "also provided additional benefits."
    } ]
  }, {
    "tStartMs": 502620,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "- You know, one of the reasons\nwe put so much Chlorine"
    } ]
  }, {
    "tStartMs": 504370,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "was to control the algae growth."
    } ]
  }, {
    "tStartMs": 505670,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But sometimes you still\ncouldn't control it."
    } ]
  }, {
    "tStartMs": 507740,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "There were times years ago, in the summer,"
    } ]
  }, {
    "tStartMs": 510300,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "where if we had an algae outbreak,"
    } ]
  }, {
    "tStartMs": 512230,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "you might actually, if\nyou filled a bath tub up,"
    } ]
  }, {
    "tStartMs": 514240,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "you might have a slight tinge of green."
    } ]
  }, {
    "tStartMs": 515720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I mean, it maybe healthy to drink,"
    } ]
  }, {
    "tStartMs": 517220,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "but it might have a slight\ntinge of green from the algae."
    } ]
  }, {
    "tStartMs": 519060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] You'd see a bit of algae."
    } ]
  }, {
    "tStartMs": 519893,
    "dDurationMs": 1517,
    "segs": [ {
      "utf8": "- Yeah, and it's just\ndiscoloring the water."
    } ]
  }, {
    "tStartMs": 521410,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "That no longer occurs."
    } ]
  }, {
    "tStartMs": 522380,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "So, with the sunlight gone,"
    } ]
  }, {
    "tStartMs": 524710,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "the algae problem is gone."
    } ]
  }, {
    "tStartMs": 526170,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "We put in, basically, no Chlorine."
    } ]
  }, {
    "tStartMs": 527440,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "We've only had a few times\nsince the shade balls"
    } ]
  }, {
    "tStartMs": 529470,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "have been on LA Reservoir,"
    } ]
  }, {
    "tStartMs": 530303,
    "dDurationMs": 1577,
    "segs": [ {
      "utf8": "that we've added any Chlorine at all."
    } ]
  }, {
    "tStartMs": 531880,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "And we used to do half the Chlorine"
    } ]
  }, {
    "tStartMs": 533250,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and the whole water system"
    } ]
  }, {
    "tStartMs": 534510,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "went into that reservoir\njust to control algae growth."
    } ]
  }, {
    "tStartMs": 537140,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- [Narrator] But the big\nconcern I had was evaporation."
    } ]
  }, {
    "tStartMs": 540320,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "When I first heard about\nthese black plastic balls"
    } ]
  }, {
    "tStartMs": 542610,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "reducing evaporation, it\ndidn't seem to make any sense."
    } ]
  }, {
    "tStartMs": 545840,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "I mean, wouldn't they absorb more energy"
    } ]
  }, {
    "tStartMs": 547860,
    "dDurationMs": 3407,
    "segs": [ {
      "utf8": "and so heat up the water,\nleading to faster evaporation?"
    } ]
  }, {
    "tStartMs": 551267,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "It turns out the answer is, no,"
    } ]
  }, {
    "tStartMs": 553200,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "for a number of reasons."
    } ]
  }, {
    "tStartMs": 555070,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "In an open reservoir, there\nis more exposed surface area"
    } ]
  }, {
    "tStartMs": 557820,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "where water molecules\ncan escape into the air."
    } ]
  }, {
    "tStartMs": 560470,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Plus, there is greater air\nflow over the water's surface"
    } ]
  }, {
    "tStartMs": 563130,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "continually removing\nthe layer of moist air"
    } ]
  }, {
    "tStartMs": 565390,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and replacing it with dryer\nair, increasing evaporation."
    } ]
  }, {
    "tStartMs": 569080,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Now the shade balls do absorb more energy"
    } ]
  }, {
    "tStartMs": 571370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and get hotter on top,"
    } ]
  }, {
    "tStartMs": 572960,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "but the bottom of the balls stays cool."
    } ]
  }, {
    "tStartMs": 575320,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Plus the balls mostly contain air,"
    } ]
  }, {
    "tStartMs": 577050,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "which is a good thermal insulator"
    } ]
  }, {
    "tStartMs": 578740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and so not much of the heat is transferred"
    } ]
  }, {
    "tStartMs": 580720,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "through to the water."
    } ]
  }, {
    "tStartMs": 581720,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "- It's almost like a double-paned window,"
    } ]
  }, {
    "tStartMs": 583243,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "you know, you get that air gap in there"
    } ]
  }, {
    "tStartMs": 584610,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and the air acts as an insulator,"
    } ]
  }, {
    "tStartMs": 586200,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "and so the sun never hits the water."
    } ]
  }, {
    "tStartMs": 588140,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Matter of fact, we've actually\ndone some measurements"
    } ]
  }, {
    "tStartMs": 589540,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "and it's actually cooler\nunder the shade balls,"
    } ]
  }, {
    "tStartMs": 591630,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "even though they're black,"
    } ]
  }, {
    "tStartMs": 592760,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "than it is without the balls,"
    } ]
  }, {
    "tStartMs": 593880,
    "dDurationMs": 842,
    "segs": [ {
      "utf8": "just with the sun itself."
    } ]
  }, {
    "tStartMs": 594722,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] Huh?"
    } ]
  }, {
    "tStartMs": 595555,
    "dDurationMs": 965,
    "segs": [ {
      "utf8": "- [Marty] So, the balls\nactually have a slight"
    } ]
  }, {
    "tStartMs": 596520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "cooling effect."
    } ]
  }, {
    "tStartMs": 597353,
    "dDurationMs": 1317,
    "segs": [ {
      "utf8": "- [Narrator] So, for all of these reasons,"
    } ]
  }, {
    "tStartMs": 598670,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "shade balls reduce\nevaporation by 80 to 90%."
    } ]
  }, {
    "tStartMs": 602380,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "That's pretty significant"
    } ]
  }, {
    "tStartMs": 603720,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for a dry climate like Los Angeles."
    } ]
  }, {
    "tStartMs": 606120,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "- [Narrator] How much do they cost?"
    } ]
  }, {
    "tStartMs": 607640,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- These run about, around three for $1."
    } ]
  }, {
    "tStartMs": 610600,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I think we paid 33, 34 cents a piece,"
    } ]
  }, {
    "tStartMs": 612730,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "something in that range."
    } ]
  }, {
    "tStartMs": 613946,
    "dDurationMs": 2214,
    "segs": [ {
      "utf8": "And they actually will\nhave a salvage value,"
    } ]
  }, {
    "tStartMs": 616160,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "not that much, but if\nwe go to remove them,"
    } ]
  }, {
    "tStartMs": 618530,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "they are recyclable material."
    } ]
  }, {
    "tStartMs": 621530,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "But we figured that over\nthe life of the balls,"
    } ]
  }, {
    "tStartMs": 624630,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "between the savings in chlorination,"
    } ]
  }, {
    "tStartMs": 627340,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "is chemical savings,"
    } ]
  }, {
    "tStartMs": 628550,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and the savings in evaporation,"
    } ]
  }, {
    "tStartMs": 630350,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "probably at least half\nthe cost of the balls"
    } ]
  }, {
    "tStartMs": 632170,
    "dDurationMs": 1054,
    "segs": [ {
      "utf8": "will be paid for."
    } ]
  }, {
    "tStartMs": 633224,
    "dDurationMs": 1796,
    "segs": [ {
      "utf8": "I mean, of course, the\nwater quality benefit"
    } ]
  }, {
    "tStartMs": 635020,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "is immeasurable,"
    } ]
  }, {
    "tStartMs": 636040,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "but even the balls\nthemselves will save money"
    } ]
  }, {
    "tStartMs": 638030,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "doing what they do."
    } ]
  }, {
    "tStartMs": 639197,
    "dDurationMs": 2971,
    "segs": [ {
      "utf8": "- [Narrator] Do you ever bring\npeople out here for tours?"
    } ]
  }, {
    "tStartMs": 642168,
    "dDurationMs": 1102,
    "segs": [ {
      "utf8": "- You're the first one."
    } ]
  }, {
    "tStartMs": 643270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 644103,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] Why am I the\nfirst one to get to go"
    } ]
  }, {
    "tStartMs": 644936,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "on a tour here?"
    } ]
  }, {
    "tStartMs": 645769,
    "dDurationMs": 2451,
    "segs": [ {
      "utf8": "- To get this level of\ndetailed of tour, yes."
    } ]
  }, {
    "tStartMs": 648220,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "- [Narrator] This is so cool!"
    } ]
  }, {
    "tStartMs": 649440,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I've heard something\nabout hexagonal balls,"
    } ]
  }, {
    "tStartMs": 652230,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "have you heard anything\nabout hexagonal balls?"
    } ]
  }, {
    "tStartMs": 653850,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh, my gosh!"
    } ]
  }, {
    "tStartMs": 654683,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "So, we have the shade\nballs, and of course,"
    } ]
  }, {
    "tStartMs": 656400,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "everyone in the world came\nup with another product."
    } ]
  }, {
    "tStartMs": 658750,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "I have ones I call se\nravioli, it's a small hex."
    } ]
  }, {
    "tStartMs": 661580,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "We've got large hexes, we\nhave all sorts of pieces."
    } ]
  }, {
    "tStartMs": 664010,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "And people said, \"Well,\nthey lock together.\""
    } ]
  }, {
    "tStartMs": 665440,
    "dDurationMs": 2087,
    "segs": [ {
      "utf8": "But the problem is, they\nneed to not stack up"
    } ]
  }, {
    "tStartMs": 667527,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "and they need to not sit on\nthe bank of the reservoir."
    } ]
  }, {
    "tStartMs": 669410,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The reservoir is gonna go up and down."
    } ]
  }, {
    "tStartMs": 670970,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And so it was really the shape of the ball"
    } ]
  }, {
    "tStartMs": 673160,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "that makes them not perch on the side"
    } ]
  }, {
    "tStartMs": 676870,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "because we need to make sure that these,"
    } ]
  }, {
    "tStartMs": 678520,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "when the water goes up and down,"
    } ]
  }, {
    "tStartMs": 679770,
    "dDurationMs": 1437,
    "segs": [ {
      "utf8": "that they spread up, or they, you know,"
    } ]
  }, {
    "tStartMs": 681207,
    "dDurationMs": 2273,
    "segs": [ {
      "utf8": "either spread out completely\nto cover the water"
    } ]
  }, {
    "tStartMs": 683480,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "as best possible."
    } ]
  }, {
    "tStartMs": 684570,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "- [Narrator] I mean, I just\ncan't get over what I'm seeing,"
    } ]
  }, {
    "tStartMs": 686270,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "it's just so nuts."
    } ]
  }, {
    "tStartMs": 687600,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "- I'm waiting for you to say\nit looks like a pool of boba."
    } ]
  }, {
    "tStartMs": 690083,
    "dDurationMs": 2597,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 692680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- [Narrator] I feel like\nthat's the line that'll go in,"
    } ]
  }, {
    "tStartMs": 694680,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "but you got it."
    } ]
  }, {
    "tStartMs": 695920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Like, that is,"
    } ]
  }, {
    "tStartMs": 697940,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that's awesome."
    } ]
  }, {
    "tStartMs": 700620,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Do you like boba?"
    } ]
  }, {
    "tStartMs": 701900,
    "dDurationMs": 1389,
    "segs": [ {
      "utf8": "- I love boba."
    } ]
  }, {
    "tStartMs": 703289,
    "dDurationMs": 971,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 704260,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "I might get some after this."
    } ]
  }, {
    "tStartMs": 705574,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 706700,
    "dDurationMs": 2508,
    "segs": [ {
      "utf8": "(techno sound)"
    } ]
  }, {
    "tStartMs": 709208,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(boat engine roaring)"
    } ]
  } ]
}
