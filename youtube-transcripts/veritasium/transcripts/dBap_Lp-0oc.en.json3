{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 100,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "I am going to turn myself\ninto an optical illusion"
    } ]
  }, {
    "tStartMs": 3930,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "by going through this window right here."
    } ]
  }, {
    "tStartMs": 6140,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Ah, (grumbles) huh."
    } ]
  }, {
    "tStartMs": 9440,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "Okay, I'm good, oh, not good."
    } ]
  }, {
    "tStartMs": 13890,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "I was gonna say I'm good, I'm not good."
    } ]
  }, {
    "tStartMs": 15800,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Okay, so you're looking at this window"
    } ]
  }, {
    "tStartMs": 18330,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "and it looks like it's turning around,"
    } ]
  }, {
    "tStartMs": 20060,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "except here it stops."
    } ]
  }, {
    "tStartMs": 22260,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Now I keep rotating, but the\nwindow is rotating through me."
    } ]
  }, {
    "tStartMs": 24780,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "What is happening?"
    } ]
  }, {
    "tStartMs": 25910,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "This video is sponsored by NordVPN."
    } ]
  }, {
    "tStartMs": 29450,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "They help you create the illusion"
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "that you could be anywhere in the world."
    } ]
  }, {
    "tStartMs": 34600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Let me backup for a second."
    } ]
  }, {
    "tStartMs": 36370,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "This is the first part\nof a three part illusion."
    } ]
  }, {
    "tStartMs": 40230,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "What do you see?"
    } ]
  }, {
    "tStartMs": 42500,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Well, there's a window"
    } ]
  }, {
    "tStartMs": 43880,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and it's turning, except it\nstops and reverses direction."
    } ]
  }, {
    "tStartMs": 50630,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So the window is\noscillating back and forth."
    } ]
  }, {
    "tStartMs": 54870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That's what most people see\nwhen they look at this illusion"
    } ]
  }, {
    "tStartMs": 57510,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "except that's not what the\nwindow's actually doing."
    } ]
  }, {
    "tStartMs": 60170,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "It's on this turntable and\nit is rotating continuously."
    } ]
  }, {
    "tStartMs": 64800,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "This is known as the Ames window illusion."
    } ]
  }, {
    "tStartMs": 67370,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And I saw it on an old\nAustralian TV program"
    } ]
  }, {
    "tStartMs": 70100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "called the Curiosity Show."
    } ]
  }, {
    "tStartMs": 71800,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "And I was curious."
    } ]
  }, {
    "tStartMs": 74060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So in this video, I'm gonna\ndig deeper into this illusion"
    } ]
  }, {
    "tStartMs": 76790,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "than anyone has before."
    } ]
  }, {
    "tStartMs": 79180,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "You know the window\nitself is not a rectangle,"
    } ]
  }, {
    "tStartMs": 81800,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "but a trapezoid."
    } ]
  }, {
    "tStartMs": 83250,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "You can see this side here is much shorter"
    } ]
  }, {
    "tStartMs": 86710,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "than this side over here."
    } ]
  }, {
    "tStartMs": 89790,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And that is essential to the illusion."
    } ]
  }, {
    "tStartMs": 92110,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Also essential, it is\nshaded to make it look 3-D,"
    } ]
  }, {
    "tStartMs": 95560,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "but it's actually just\na two dimensional card"
    } ]
  }, {
    "tStartMs": 97940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "with the same image on both sides."
    } ]
  }, {
    "tStartMs": 100670,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "So now that you know exactly\nwhat this object looks like"
    } ]
  }, {
    "tStartMs": 103020,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and what it's doing, can\nyou correctly perceive"
    } ]
  }, {
    "tStartMs": 106060,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "the rotation rather than the oscillation?"
    } ]
  }, {
    "tStartMs": 109600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I still can't."
    } ]
  }, {
    "tStartMs": 111040,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It still looks to my brain"
    } ]
  }, {
    "tStartMs": 113240,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "like this window is going back and forth."
    } ]
  }, {
    "tStartMs": 118270,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Okay, here's an idea."
    } ]
  }, {
    "tStartMs": 119690,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "I'm going to attach this Rubik's Cube"
    } ]
  }, {
    "tStartMs": 122560,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "to the short side of the trapezoid"
    } ]
  }, {
    "tStartMs": 125900,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "so we can keep track of\nit as it goes around."
    } ]
  }, {
    "tStartMs": 129590,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "Are you ready?"
    } ]
  }, {
    "tStartMs": 131330,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 132889,
    "dDurationMs": 2511,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 135400,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Okay, the Rubik's Cube is going around."
    } ]
  }, {
    "tStartMs": 138820,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "Everything seems normal."
    } ]
  }, {
    "tStartMs": 142930,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But now what is that?"
    } ]
  }, {
    "tStartMs": 146410,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "It looks like the Rubik's Cube\nis continuing to go around,"
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 2473,
    "segs": [ {
      "utf8": "but the window is\noscillating back and forth."
    } ]
  }, {
    "tStartMs": 155430,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "There it goes, the Rubik's\nCube around the back."
    } ]
  }, {
    "tStartMs": 157480,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "I don't even know what's happening."
    } ]
  }, {
    "tStartMs": 159290,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 163263,
    "dDurationMs": 1617,
    "segs": [ {
      "utf8": "Whoa, look at that."
    } ]
  }, {
    "tStartMs": 164880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It looks like the Rubik's\nCube is out drifting by itself"
    } ]
  }, {
    "tStartMs": 167700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "out in front of the whole illusion."
    } ]
  }, {
    "tStartMs": 170400,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "What is happening?"
    } ]
  }, {
    "tStartMs": 173130,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Okay new plan, I'm going to\ntake off the Rubik's Cube"
    } ]
  }, {
    "tStartMs": 176810,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "and I'm gonna put a ruler"
    } ]
  }, {
    "tStartMs": 178750,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "right through the middle of the window."
    } ]
  }, {
    "tStartMs": 182050,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "And so we can't possibly be\nfooled by the illusion, right?"
    } ]
  }, {
    "tStartMs": 186690,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "Okay, here we go."
    } ]
  }, {
    "tStartMs": 190400,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Okay, the ruler is rotating around,"
    } ]
  }, {
    "tStartMs": 194400,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "but wait now the window is\ngoing backwards whoa, whoa!"
    } ]
  }, {
    "tStartMs": 197960,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "The ruler is going through the window."
    } ]
  }, {
    "tStartMs": 201310,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "It is doing things which I\nknow are physically impossible"
    } ]
  }, {
    "tStartMs": 205450,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "but that is how my brain is seeing it."
    } ]
  }, {
    "tStartMs": 209080,
    "dDurationMs": 1054,
    "segs": [ {
      "utf8": "Look, here we go again."
    } ]
  }, {
    "tStartMs": 210134,
    "dDurationMs": 3276,
    "segs": [ {
      "utf8": "The ruler is turning\naround with the window"
    } ]
  }, {
    "tStartMs": 213410,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "but right about here the\nwindows starts going backwards"
    } ]
  }, {
    "tStartMs": 217210,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but the ruler keeps coming."
    } ]
  }, {
    "tStartMs": 219640,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "What is even like, how is this possible?"
    } ]
  }, {
    "tStartMs": 223270,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "This doesn't make any sense."
    } ]
  }, {
    "tStartMs": 226010,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "But that is the way my\nbrain interprets this."
    } ]
  }, {
    "tStartMs": 228340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It clearly prefers the illusion"
    } ]
  }, {
    "tStartMs": 230500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "over seeing what's really happening,"
    } ]
  }, {
    "tStartMs": 232200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the continuous rotation."
    } ]
  }, {
    "tStartMs": 234600,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "So why is this, how\ndoes the illusion work?"
    } ]
  }, {
    "tStartMs": 238340,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Well, it was created by\nAdelbert Ames back in 1947."
    } ]
  }, {
    "tStartMs": 242680,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "And before becoming a researcher,"
    } ]
  }, {
    "tStartMs": 244670,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "he wanted to be a visual artist."
    } ]
  }, {
    "tStartMs": 246810,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "So he was fascinated"
    } ]
  }, {
    "tStartMs": 248040,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "by how people perceive shapes and shading."
    } ]
  }, {
    "tStartMs": 251580,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And according to him,\nthe key to this illusion"
    } ]
  }, {
    "tStartMs": 254370,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "is that we're all used to living"
    } ]
  }, {
    "tStartMs": 255750,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "in rectangular boxes, essentially."
    } ]
  }, {
    "tStartMs": 258670,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "You know houses and rooms"
    } ]
  }, {
    "tStartMs": 261030,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "where virtually all of the corners we see"
    } ]
  }, {
    "tStartMs": 263320,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "are 90 degree angles."
    } ]
  }, {
    "tStartMs": 265570,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Doors, windows, tables and chairs"
    } ]
  }, {
    "tStartMs": 267830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "are full of 90 degree angles."
    } ]
  }, {
    "tStartMs": 270590,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "This is called the\ncarpentered environment."
    } ]
  }, {
    "tStartMs": 274060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But unless we're looking\nstraight on at something,"
    } ]
  }, {
    "tStartMs": 276640,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "the angles we actually\nsee are not 90 degrees."
    } ]
  }, {
    "tStartMs": 280310,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I mean, the images that\nform on our retinas"
    } ]
  }, {
    "tStartMs": 282550,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "are typically trapezoids of\ndifferent shapes and sizes."
    } ]
  }, {
    "tStartMs": 286200,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Now from extensive experience,"
    } ]
  }, {
    "tStartMs": 287760,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "our brains know they\nreally should be rectangles"
    } ]
  }, {
    "tStartMs": 290760,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "and right angles."
    } ]
  }, {
    "tStartMs": 292010,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So our brains use these strange shapes"
    } ]
  }, {
    "tStartMs": 294320,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to infer depth information,"
    } ]
  }, {
    "tStartMs": 296300,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "which in our rectilinear world\nis almost always correct."
    } ]
  }, {
    "tStartMs": 300070,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "But not in the case of\na trapezoidal window"
    } ]
  }, {
    "tStartMs": 302960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that our brains assume to be rectangular,"
    } ]
  }, {
    "tStartMs": 305200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "hence the illusion."
    } ]
  }, {
    "tStartMs": 307120,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Now, if this carpentered\nworld hypothesis is correct,"
    } ]
  }, {
    "tStartMs": 310400,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "well then you'd expect\npeople with less experience"
    } ]
  }, {
    "tStartMs": 312840,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "of rectangles in their environments"
    } ]
  }, {
    "tStartMs": 314500,
    "dDurationMs": 2497,
    "segs": [ {
      "utf8": "to be less susceptible to the illusion."
    } ]
  }, {
    "tStartMs": 316997,
    "dDurationMs": 4853,
    "segs": [ {
      "utf8": "And to test exactly this, in\n1957 Harvard psychologists"
    } ]
  }, {
    "tStartMs": 321850,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "tried the Ames window\nillusion in South Africa"
    } ]
  }, {
    "tStartMs": 324590,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "with 80 children, aged 10 to 14."
    } ]
  }, {
    "tStartMs": 327630,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "40 of them were living\nin the city of Durban"
    } ]
  }, {
    "tStartMs": 329890,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "full of rectangular\nbuildings, doors and windows."
    } ]
  }, {
    "tStartMs": 333300,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The other 40 were from\nnearby rural communities"
    } ]
  }, {
    "tStartMs": 336780,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "where they lived in round huts"
    } ]
  }, {
    "tStartMs": 338520,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "with few prominent 90 degree angles."
    } ]
  }, {
    "tStartMs": 341930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "When subjects were seated 10 feet away"
    } ]
  }, {
    "tStartMs": 343700,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "from the rotating Ames\nwindow with both eyes open,"
    } ]
  }, {
    "tStartMs": 346750,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "60% of the urban group"
    } ]
  }, {
    "tStartMs": 348590,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "reported seeing the window oscillating."
    } ]
  }, {
    "tStartMs": 351320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But in the rural group, only\n17.5% saw the same thing."
    } ]
  }, {
    "tStartMs": 356750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So the results were consistent"
    } ]
  }, {
    "tStartMs": 358580,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "with the carpentered world hypothesis."
    } ]
  }, {
    "tStartMs": 360410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The kids with less\nexperience of rectangles"
    } ]
  }, {
    "tStartMs": 362810,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "were less likely to fall for the illusion."
    } ]
  }, {
    "tStartMs": 365270,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "But that's not the whole story."
    } ]
  }, {
    "tStartMs": 367480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "When seated 20 feet away\nand with one eye closed,"
    } ]
  }, {
    "tStartMs": 370540,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "the illusion was much more convincing."
    } ]
  }, {
    "tStartMs": 372950,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "Now, 90% of all participants\nsaw the window oscillating"
    } ]
  }, {
    "tStartMs": 376600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and there was no significant difference"
    } ]
  }, {
    "tStartMs": 378160,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "between urban and rural groups."
    } ]
  }, {
    "tStartMs": 380760,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "That means something else must\nbe going on over and above"
    } ]
  }, {
    "tStartMs": 384580,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "our experience with rectangles."
    } ]
  }, {
    "tStartMs": 386510,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "In fact, you can get a similar illusion"
    } ]
  }, {
    "tStartMs": 388680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "without any straight lines at all."
    } ]
  }, {
    "tStartMs": 391260,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "This is the de Heer circle,"
    } ]
  }, {
    "tStartMs": 393320,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "when rotating continuously,"
    } ]
  }, {
    "tStartMs": 395200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "it also appears to\noscillate back and forth."
    } ]
  }, {
    "tStartMs": 397840,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "So what's going on?"
    } ]
  }, {
    "tStartMs": 399810,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "Well, both of these illusions"
    } ]
  }, {
    "tStartMs": 401320,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "make use of a technique\ncalled anamorphosis"
    } ]
  }, {
    "tStartMs": 403590,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "which has been used by artists"
    } ]
  }, {
    "tStartMs": 405380,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "for centuries if not millennia."
    } ]
  }, {
    "tStartMs": 408690,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "This is a painting from 1533"
    } ]
  }, {
    "tStartMs": 412170,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "called The Ambassadors by\nHans Holbein the Younger."
    } ]
  }, {
    "tStartMs": 416270,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "It clearly shows two prominent figures,"
    } ]
  }, {
    "tStartMs": 418700,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "but there's also this\ndistorted shape over the floor."
    } ]
  }, {
    "tStartMs": 422710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Only when viewed from the correct position"
    } ]
  }, {
    "tStartMs": 425020,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "either of the top right or bottom left,"
    } ]
  }, {
    "tStartMs": 427230,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "does it become clear that\nthe image is actually"
    } ]
  }, {
    "tStartMs": 429740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "a detailed depiction of a human skull."
    } ]
  }, {
    "tStartMs": 432710,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "It's suspected that the painting"
    } ]
  }, {
    "tStartMs": 434010,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "was meant to be hung in a stairwell"
    } ]
  }, {
    "tStartMs": 435630,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "where presumably out of\nthe corner of your eye,"
    } ]
  }, {
    "tStartMs": 437830,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "you would spot the\nstriking image of the skull"
    } ]
  }, {
    "tStartMs": 440960,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "reminding you of your own mortality."
    } ]
  }, {
    "tStartMs": 443690,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "But if you were to look\nat the painting head-on"
    } ]
  }, {
    "tStartMs": 446050,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "well, the skull would\nbe pretty hard to see."
    } ]
  }, {
    "tStartMs": 449240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Anamorphosis involves making\na distorted projection"
    } ]
  }, {
    "tStartMs": 452000,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "of an object."
    } ]
  }, {
    "tStartMs": 452960,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "So to see its proper proportions,"
    } ]
  }, {
    "tStartMs": 454650,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "you need to look at the work\nfrom a particular position"
    } ]
  }, {
    "tStartMs": 457570,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "or with a particular\ndevice, often a mirror."
    } ]
  }, {
    "tStartMs": 460760,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "There are earlier examples"
    } ]
  }, {
    "tStartMs": 462370,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "like Leonardo's Eye by Leonardo da Vinci,"
    } ]
  }, {
    "tStartMs": 465210,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "which only takes its proper\nform when viewed from the side."
    } ]
  }, {
    "tStartMs": 468970,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Clearly, Leonardo knew\nhow to give side-eye."
    } ]
  }, {
    "tStartMs": 472470,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "And some might argue\nthat the cave paintings"
    } ]
  }, {
    "tStartMs": 474650,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "at Lascaux France from 17,000 years ago"
    } ]
  }, {
    "tStartMs": 477780,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "provide the first examples\nof anamorphic art."
    } ]
  }, {
    "tStartMs": 480680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Due to the uneven painting surface,"
    } ]
  }, {
    "tStartMs": 483160,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "artists would have had to consider"
    } ]
  }, {
    "tStartMs": 484540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "how their animal figures\nwould be perceived"
    } ]
  }, {
    "tStartMs": 486760,
    "dDurationMs": 2023,
    "segs": [ {
      "utf8": "from different vantage points."
    } ]
  }, {
    "tStartMs": 490197,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 495130,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "Anamorphosis is also central"
    } ]
  }, {
    "tStartMs": 496640,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "to perhaps Ames most famous\nillusion, The Ames Room."
    } ]
  }, {
    "tStartMs": 501030,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Ames designed his first\ndistortive room in 1934."
    } ]
  }, {
    "tStartMs": 505140,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "And with one eye, from\none privilege perspective"
    } ]
  }, {
    "tStartMs": 508610,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "it just looks like an ordinary room."
    } ]
  }, {
    "tStartMs": 511050,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "But when people move around the room,"
    } ]
  }, {
    "tStartMs": 514450,
    "dDurationMs": 3923,
    "segs": [ {
      "utf8": "it becomes obvious that\nsomething is not quite right."
    } ]
  }, {
    "tStartMs": 520740,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "An Ames Room is constructed"
    } ]
  }, {
    "tStartMs": 522250,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "by taking an ordinary rectangular room"
    } ]
  }, {
    "tStartMs": 524490,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "and adding a diagonal wall\nthrough the middle of it."
    } ]
  }, {
    "tStartMs": 527350,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Then draw lines connecting\nall the key parts of the room"
    } ]
  }, {
    "tStartMs": 530690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "like corners, windows, and so on"
    } ]
  }, {
    "tStartMs": 533000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "to the privileged viewpoint."
    } ]
  }, {
    "tStartMs": 535180,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "Mark where those lines\nintersect the diagonal wall."
    } ]
  }, {
    "tStartMs": 538970,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Then add a floor and a ceiling."
    } ]
  }, {
    "tStartMs": 541530,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "If the projection is done properly,"
    } ]
  }, {
    "tStartMs": 543490,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "they will not only be\ntilted but also warped."
    } ]
  }, {
    "tStartMs": 547130,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Then connect the floor and ceiling"
    } ]
  }, {
    "tStartMs": 548630,
    "dDurationMs": 4624,
    "segs": [ {
      "utf8": "with trapezoidal walls and\nvoila, you have an Ames Room."
    } ]
  }, {
    "tStartMs": 553254,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 560680,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "Ames realized there are an infinite number"
    } ]
  }, {
    "tStartMs": 563550,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "of different distorted room geometries"
    } ]
  }, {
    "tStartMs": 566260,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "which when viewed from\nthe privileged position"
    } ]
  }, {
    "tStartMs": 568800,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "create virtually identical\nimages of a normal room."
    } ]
  }, {
    "tStartMs": 573230,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "So our perceptions far from transparently"
    } ]
  }, {
    "tStartMs": 576510,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "representing external reality"
    } ]
  }, {
    "tStartMs": 578560,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "are constantly faced with ambiguity."
    } ]
  }, {
    "tStartMs": 581160,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "And our brains below the\nlevel of consciousness"
    } ]
  }, {
    "tStartMs": 583900,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "have to decide which of\nthe infinite possibilities"
    } ]
  }, {
    "tStartMs": 587170,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "we're actually looking at."
    } ]
  }, {
    "tStartMs": 590600,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "One form of ambiguity\nrelates to depth perception."
    } ]
  }, {
    "tStartMs": 593890,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Which of these masks protrudes\noutwards towards the camera,"
    } ]
  }, {
    "tStartMs": 597160,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "and which is an impression?"
    } ]
  }, {
    "tStartMs": 599330,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Only through motion does it\nbecome obvious, which is which."
    } ]
  }, {
    "tStartMs": 603430,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "We are subconsciously\nattuned to visual cues"
    } ]
  }, {
    "tStartMs": 606100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "that indicate how close\nor far away something is."
    } ]
  }, {
    "tStartMs": 609160,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Closer objects are typically\nbigger and brighter,"
    } ]
  }, {
    "tStartMs": 611930,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "plus they obscure objects behind them."
    } ]
  }, {
    "tStartMs": 614560,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "But we can play with these attributes"
    } ]
  }, {
    "tStartMs": 617070,
    "dDurationMs": 3623,
    "segs": [ {
      "utf8": "in order to create situations\nthat defy our expectations."
    } ]
  }, {
    "tStartMs": 623010,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Now I have been obsessed"
    } ]
  }, {
    "tStartMs": 624970,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "with getting the Ames\nwindow illusion to work."
    } ]
  }, {
    "tStartMs": 628520,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "Look at how many different Ames\nwindows I have been making."
    } ]
  }, {
    "tStartMs": 633050,
    "dDurationMs": 4353,
    "segs": [ {
      "utf8": "And I made them small\ninitially, and then bigger."
    } ]
  }, {
    "tStartMs": 639540,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "There used to be a\ndisco ball in this room,"
    } ]
  }, {
    "tStartMs": 642720,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "I never thought that\nthis would come in handy."
    } ]
  }, {
    "tStartMs": 645910,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Then I thought about the question,"
    } ]
  }, {
    "tStartMs": 647430,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "how could I make myself like the ruler"
    } ]
  }, {
    "tStartMs": 650260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that passes through the Ames window?"
    } ]
  }, {
    "tStartMs": 652660,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "And of course, then I would\nneed a very large Ames window."
    } ]
  }, {
    "tStartMs": 657910,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "So it's been this holiday season,"
    } ]
  }, {
    "tStartMs": 660300,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "like we're living in a weird,"
    } ]
  }, {
    "tStartMs": 662170,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "surreal art museum or something."
    } ]
  }, {
    "tStartMs": 664730,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It needed to be at least eight feet"
    } ]
  }, {
    "tStartMs": 667130,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "on its longest dimension."
    } ]
  }, {
    "tStartMs": 669400,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It's actually made out\nof six pieces of plywood,"
    } ]
  }, {
    "tStartMs": 671960,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "glued, screwed together."
    } ]
  }, {
    "tStartMs": 673561,
    "dDurationMs": 1259,
    "segs": [ {
      "utf8": "(saw cutting)"
    } ]
  }, {
    "tStartMs": 674820,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "One of the challenges is\nto make it really thin"
    } ]
  }, {
    "tStartMs": 677580,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "because ideally it should\njust be two dimensional."
    } ]
  }, {
    "tStartMs": 680540,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "So we had to bevel these edges here."
    } ]
  }, {
    "tStartMs": 682823,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 687590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So then I would twist\nup these metal cables"
    } ]
  }, {
    "tStartMs": 690530,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "that hang it to the ceiling"
    } ]
  }, {
    "tStartMs": 692350,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and then jump in the\nwindow and let them unwind."
    } ]
  }, {
    "tStartMs": 695030,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Ah,(grumbles) huh, okay."
    } ]
  }, {
    "tStartMs": 698870,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "So I'll show you some of the\nbest shots I was able to get"
    } ]
  }, {
    "tStartMs": 701100,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "and you let me know,\ndoes this work for you?"
    } ]
  }, {
    "tStartMs": 703610,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Do you see it oscillating"
    } ]
  }, {
    "tStartMs": 704760,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "or do you just see it\nrotating as it actually is?"
    } ]
  }, {
    "tStartMs": 709350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I found lighting is really important."
    } ]
  }, {
    "tStartMs": 711600,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "The lighting needs to be\nreally even on both sides"
    } ]
  }, {
    "tStartMs": 713930,
    "dDurationMs": 3493,
    "segs": [ {
      "utf8": "to convince you that it\nis really oscillating."
    } ]
  }, {
    "tStartMs": 719490,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "When the large side of the\ntrapezoid is close to us,"
    } ]
  }, {
    "tStartMs": 722430,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "we perceive it rotating exactly as it is."
    } ]
  }, {
    "tStartMs": 725700,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But when the large side\nmoves around to the back,"
    } ]
  }, {
    "tStartMs": 727920,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "it is still larger in our field\nof view than the small side."
    } ]
  }, {
    "tStartMs": 731450,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "So our brain perceives it as closer"
    } ]
  }, {
    "tStartMs": 733740,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "and rotating in the opposite direction."
    } ]
  }, {
    "tStartMs": 736330,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "This is why the window\nappears to oscillate."
    } ]
  }, {
    "tStartMs": 738910,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Half the time we're seeing\nthe window as it is,"
    } ]
  }, {
    "tStartMs": 741340,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "and half the time we're\nseeing the bigger side"
    } ]
  }, {
    "tStartMs": 743150,
    "dDurationMs": 3193,
    "segs": [ {
      "utf8": "as closer to us, even\nthough it's farther away."
    } ]
  }, {
    "tStartMs": 748610,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But how do we develop the ability"
    } ]
  }, {
    "tStartMs": 750610,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "to interpret depth cues\nin the first place?"
    } ]
  }, {
    "tStartMs": 753540,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Well, it seems to be an innate ability"
    } ]
  }, {
    "tStartMs": 756210,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "which forms very early in our development."
    } ]
  }, {
    "tStartMs": 759710,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "They've actually shown babies\nin three different age groups"
    } ]
  }, {
    "tStartMs": 762920,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "five and a half months,\nseven and a half months"
    } ]
  }, {
    "tStartMs": 764910,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and nine months the Ames window illusion."
    } ]
  }, {
    "tStartMs": 768600,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Do they see the window oscillating?"
    } ]
  }, {
    "tStartMs": 770930,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And how would we know if they did?"
    } ]
  }, {
    "tStartMs": 774130,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "Well, babies have a well-known\npreference for novelty."
    } ]
  }, {
    "tStartMs": 777000,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "They look longer at things\nthat are new to them."
    } ]
  }, {
    "tStartMs": 779260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So experimenters first exposed them"
    } ]
  }, {
    "tStartMs": 781540,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "to an ordinary rotating circle."
    } ]
  }, {
    "tStartMs": 783740,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And then they showed them simultaneously"
    } ]
  }, {
    "tStartMs": 785820,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "the Ames window and a\nrotating rectangular window."
    } ]
  }, {
    "tStartMs": 789610,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "The five and a half month old babies"
    } ]
  }, {
    "tStartMs": 791580,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "showed no special preference\nfor the Ames window."
    } ]
  }, {
    "tStartMs": 794620,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But the seven and a\nhalf and nine month olds"
    } ]
  }, {
    "tStartMs": 796860,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "were significantly more\ninterested in the Ames window."
    } ]
  }, {
    "tStartMs": 799930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Suggesting they perceive it"
    } ]
  }, {
    "tStartMs": 801640,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "as doing something different,\npresumably oscillating."
    } ]
  }, {
    "tStartMs": 807100,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "The reason I have been so\nobsessed with this illusion"
    } ]
  }, {
    "tStartMs": 810710,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "is because I think it confronts"
    } ]
  }, {
    "tStartMs": 812100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "one of the big\nmisconceptions about science."
    } ]
  }, {
    "tStartMs": 814500,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Which is this idea that scientists propose"
    } ]
  }, {
    "tStartMs": 817110,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "competing theories, and\nthen all you have to do"
    } ]
  }, {
    "tStartMs": 819500,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "is look at the data to decide\nwhich is the best theory."
    } ]
  }, {
    "tStartMs": 824350,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The truth is there are many circumstances"
    } ]
  }, {
    "tStartMs": 826670,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "in which the same data"
    } ]
  }, {
    "tStartMs": 827980,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "could come from very\ndifferent external realities."
    } ]
  }, {
    "tStartMs": 831340,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "To use a classic example,"
    } ]
  }, {
    "tStartMs": 832950,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "does the sun go around the earth"
    } ]
  }, {
    "tStartMs": 835060,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "or does the earth rotate on its axis?"
    } ]
  }, {
    "tStartMs": 838280,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "The observation of the\nsun moving across the sky"
    } ]
  }, {
    "tStartMs": 841360,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "doesn't in itself resolve that debate."
    } ]
  }, {
    "tStartMs": 845010,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Or to use more modern examples,"
    } ]
  }, {
    "tStartMs": 847040,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "when you make a quantum measurement"
    } ]
  }, {
    "tStartMs": 848470,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "does the wave function collapse"
    } ]
  }, {
    "tStartMs": 850500,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "or does it branch the universe?"
    } ]
  }, {
    "tStartMs": 854790,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Is the speed of light really\nthe same in all directions"
    } ]
  }, {
    "tStartMs": 858120,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "or does it differ and only\nthe roundtrip speed is seen?"
    } ]
  }, {
    "tStartMs": 863200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "As of right now the\ndata do not discriminate"
    } ]
  }, {
    "tStartMs": 865810,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "between those theories."
    } ]
  }, {
    "tStartMs": 867770,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "And I think we can extend\nthis beyond science."
    } ]
  }, {
    "tStartMs": 870700,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "I mean maybe the Ames illusions"
    } ]
  }, {
    "tStartMs": 872670,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "are a good metaphor for life."
    } ]
  }, {
    "tStartMs": 875420,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "We feel as though we can directly\nperceive external reality"
    } ]
  }, {
    "tStartMs": 878810,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "like a person looking into an Ames Room,"
    } ]
  }, {
    "tStartMs": 881500,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "but the truth is there\nare an infinite number"
    } ]
  }, {
    "tStartMs": 883910,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "of different geometries that\nwould all look the same."
    } ]
  }, {
    "tStartMs": 888320,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "You know these days, a lot of people"
    } ]
  }, {
    "tStartMs": 889780,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "are getting the same\nfundamental information"
    } ]
  }, {
    "tStartMs": 892810,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "but coming to very different conclusions"
    } ]
  }, {
    "tStartMs": 895140,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "about the state of reality."
    } ]
  }, {
    "tStartMs": 897600,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "So I think in that context,"
    } ]
  }, {
    "tStartMs": 898990,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it's important to remember\nthat something as simple"
    } ]
  }, {
    "tStartMs": 901690,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "as a little rotating picture"
    } ]
  }, {
    "tStartMs": 904080,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "can fool our brains in\nfairly spectacular ways."
    } ]
  }, {
    "tStartMs": 908490,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "So we should approach the world\nand our conclusions about it"
    } ]
  }, {
    "tStartMs": 911660,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "with a little more humility\nand a little less certainty."
    } ]
  }, {
    "tStartMs": 916330,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 921360,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Hey, this video was sponsored by NordVPN."
    } ]
  }, {
    "tStartMs": 924600,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Get a special deal for the holidays"
    } ]
  }, {
    "tStartMs": 926460,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "when you go to NordVPN.com/veritasium."
    } ]
  }, {
    "tStartMs": 929860,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Now earlier this year,"
    } ]
  }, {
    "tStartMs": 930970,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "I wanted to watch my favorite\nsports team in the playoffs."
    } ]
  }, {
    "tStartMs": 933830,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "So I bought an all access\npass from the league."
    } ]
  }, {
    "tStartMs": 936980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But then when I went to watch a game,"
    } ]
  }, {
    "tStartMs": 938780,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "there was a blackout\nrestriction in my area."
    } ]
  }, {
    "tStartMs": 941340,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So I used NordVPN to set\nmy location to Australia"
    } ]
  }, {
    "tStartMs": 945360,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and watch the game from there."
    } ]
  }, {
    "tStartMs": 947970,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "In the past, I've made documentaries"
    } ]
  }, {
    "tStartMs": 949750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that were free to stream\nin the U.S. or Australia"
    } ]
  }, {
    "tStartMs": 952150,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "but basically impossible to\naccess almost anywhere else."
    } ]
  }, {
    "tStartMs": 955970,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And VPNs offer the solution."
    } ]
  }, {
    "tStartMs": 957930,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "They help you create the illusion"
    } ]
  }, {
    "tStartMs": 960430,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "that you were somewhere else."
    } ]
  }, {
    "tStartMs": 961880,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And with NordVPN, you get\naccess to 5,000 servers"
    } ]
  }, {
    "tStartMs": 965570,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "in nearly 60 countries."
    } ]
  }, {
    "tStartMs": 967430,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Plus using a VPN prevents\nyour internet service provider"
    } ]
  }, {
    "tStartMs": 970520,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "from seeing the sites you visit."
    } ]
  }, {
    "tStartMs": 972400,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "And this is something I\ntake particular advantage of"
    } ]
  }, {
    "tStartMs": 974570,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "when joining public Wi-Fis at\ncafes or when I'm traveling."
    } ]
  }, {
    "tStartMs": 978290,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "In a time when everyone wants to capture"
    } ]
  }, {
    "tStartMs": 981030,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "as much of your data as possible,"
    } ]
  }, {
    "tStartMs": 982630,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "I think it's important to push back"
    } ]
  }, {
    "tStartMs": 984420,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "and minimize the amount of\ninfo you're putting out there."
    } ]
  }, {
    "tStartMs": 987280,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "And best of all, in this\nspecial holiday deal"
    } ]
  }, {
    "tStartMs": 989430,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "NordVPN is offering\n68% off a two-year plan"
    } ]
  }, {
    "tStartMs": 993050,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "plus four months free."
    } ]
  }, {
    "tStartMs": 994470,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Just go to NordVPN.com/veritasium."
    } ]
  }, {
    "tStartMs": 997530,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "I'll put that link down in the description"
    } ]
  }, {
    "tStartMs": 999410,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and use code Veritasium."
    } ]
  }, {
    "tStartMs": 1001530,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So I wanna thank NordVPN\nfor sponsoring this video,"
    } ]
  }, {
    "tStartMs": 1004090,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  }, {
    "tStartMs": 1006520,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "I know you're thinking his\nchannel is named for an element,"
    } ]
  }, {
    "tStartMs": 1009910,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "but he's wearing a different\nelement on his shirt."
    } ]
  }, {
    "tStartMs": 1013230,
    "dDurationMs": 1373,
    "segs": [ {
      "utf8": "Oh the irony."
    } ]
  } ]
}
