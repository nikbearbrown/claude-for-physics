{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "This is Citicorp Center."
    } ]
  }, {
    "tStartMs": 2070,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "In the summer of 1978,"
    } ]
  }, {
    "tStartMs": 3750,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "it had been open for less than a year"
    } ]
  }, {
    "tStartMs": 5520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "when its structural\nengineer, Bill LeMessurier,"
    } ]
  }, {
    "tStartMs": 7680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "made a terrifying discovery."
    } ]
  }, {
    "tStartMs": 10020,
    "dDurationMs": 3075,
    "segs": [ {
      "utf8": "His cutting edge skyscraper,\nan engineering marvel"
    } ]
  }, {
    "tStartMs": 13095,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "had a fatal flaw."
    } ]
  }, {
    "tStartMs": 14850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Winds of just 110 kilometers per hour"
    } ]
  }, {
    "tStartMs": 17640,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "could cause it to collapse\nin the middle of Manhattan,"
    } ]
  }, {
    "tStartMs": 21120,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "potentially killing thousands."
    } ]
  }, {
    "tStartMs": 23190,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Over 200,000 people lived and worked"
    } ]
  }, {
    "tStartMs": 25680,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "in the surrounding area,"
    } ]
  }, {
    "tStartMs": 27330,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and hurricane season was only weeks away."
    } ]
  }, {
    "tStartMs": 30750,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "Here I am, the only man\nin the world who knew this."
    } ]
  }, {
    "tStartMs": 34803,
    "dDurationMs": 2697,
    "segs": [ {
      "utf8": "This thing is in real trouble."
    } ]
  }, {
    "tStartMs": 37500,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "LeMessurier\nfaced a stark choice."
    } ]
  }, {
    "tStartMs": 39720,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "He could stay silent\nand hope for the best,"
    } ]
  }, {
    "tStartMs": 42450,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "or he could try to fix it"
    } ]
  }, {
    "tStartMs": 44250,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and risk professional ruin and mass panic."
    } ]
  }, {
    "tStartMs": 47370,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "But Citicorp Center had a 100% probability"
    } ]
  }, {
    "tStartMs": 50550,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of total collapse by\nthe end of the century."
    } ]
  }, {
    "tStartMs": 53310,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "How could he save New York\nfrom a near certain disaster?"
    } ]
  }, {
    "tStartMs": 56910,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And how was this allowed\nin the first place?"
    } ]
  }, {
    "tStartMs": 60030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Veritasium producer and\nengineer, Henry van Dyck,"
    } ]
  }, {
    "tStartMs": 62400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "traveled to New York\nto investigate further."
    } ]
  }, {
    "tStartMs": 65640,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So in the 1960s, the\nfinancial giant, Citicorp,"
    } ]
  }, {
    "tStartMs": 68370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "was trying to build a new\nheadquarters in Manhattan."
    } ]
  }, {
    "tStartMs": 70710,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So just down the street from\ntheir original headquarters"
    } ]
  }, {
    "tStartMs": 73080,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "was this entire city block,\nwhich was up for sale."
    } ]
  }, {
    "tStartMs": 76170,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Well, everything except for\nthis church, Saint Peter's."
    } ]
  }, {
    "tStartMs": 79740,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So Citicorp came to the\npastor, Ralph Peterson,"
    } ]
  }, {
    "tStartMs": 81840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and asked, \"What's it gonna\ntake for you guys to leave?\""
    } ]
  }, {
    "tStartMs": 84180,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And he came back and\nsaid, \"We're not leaving."
    } ]
  }, {
    "tStartMs": 86970,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Anything that Citicorp builds"
    } ]
  }, {
    "tStartMs": 88890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "has to involve the church as part of it.\""
    } ]
  }, {
    "tStartMs": 90630,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "What the pastor wanted was for the church"
    } ]
  }, {
    "tStartMs": 92520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to have its own separate identity."
    } ]
  }, {
    "tStartMs": 94200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So eventually they agreed on two things."
    } ]
  }, {
    "tStartMs": 96600,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "One was to replace this\nold crumbling gothic church"
    } ]
  }, {
    "tStartMs": 99660,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "with a brand new one, which\nyou see in front of you."
    } ]
  }, {
    "tStartMs": 102060,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And the second thing was that the church"
    } ]
  }, {
    "tStartMs": 103770,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "had to be physically\ndistinct from the new tower."
    } ]
  }, {
    "tStartMs": 106890,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "In other words, it had to\nbe completely independent."
    } ]
  }, {
    "tStartMs": 109800,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And again, most importantly,\ntwo thirds of the space"
    } ]
  }, {
    "tStartMs": 114840,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "above the church had to be\nfree and clear, had to be open."
    } ]
  }, {
    "tStartMs": 120450,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Citicorp then\nhired architect Hugh Stubbins"
    } ]
  }, {
    "tStartMs": 122790,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "to design the tower and the church"
    } ]
  }, {
    "tStartMs": 124860,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and Bill LeMessurier as\nthe structural engineer,"
    } ]
  }, {
    "tStartMs": 128160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Stubbins explained the\nconstraints they faced."
    } ]
  }, {
    "tStartMs": 130560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "The church needed to be\nin the exact same spot"
    } ]
  }, {
    "tStartMs": 132990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and they needed to build\nthe tower around it."
    } ]
  }, {
    "tStartMs": 135270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "If they were to maximize the\nfloor area, they would have to"
    } ]
  }, {
    "tStartMs": 137550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "notch out one corner of\nthe tower for the church."
    } ]
  }, {
    "tStartMs": 140670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "LeMessurier agreed that could work,"
    } ]
  }, {
    "tStartMs": 142860,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "but why not notch two, three,\nor even all four corners,"
    } ]
  }, {
    "tStartMs": 147240,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "essentially constructing\nthe skyscraper on stilts."
    } ]
  }, {
    "tStartMs": 151140,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So it's probably the\nfirst time in history"
    } ]
  }, {
    "tStartMs": 153180,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "that an engineer has come\nto an architect and said,"
    } ]
  }, {
    "tStartMs": 155137,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "\"Let's make our job harder for us.\""
    } ]
  }, {
    "tStartMs": 158220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The stilts would\nserve two main purposes."
    } ]
  }, {
    "tStartMs": 160740,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "First, they would need\nto support at least half"
    } ]
  }, {
    "tStartMs": 163020,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of the building's gravity load."
    } ]
  }, {
    "tStartMs": 164700,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The rest would be held up\nby a larger central column."
    } ]
  }, {
    "tStartMs": 168210,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Second, they would need\nto withstand the load"
    } ]
  }, {
    "tStartMs": 170550,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "due to high winds."
    } ]
  }, {
    "tStartMs": 172140,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But unlike an ordinary structure,"
    } ]
  }, {
    "tStartMs": 174330,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the stilts wouldn't be at the corners."
    } ]
  }, {
    "tStartMs": 176790,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "They would be at the center of each face."
    } ]
  }, {
    "tStartMs": 179730,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Imagine a chair, and\ninstead of the columns"
    } ]
  }, {
    "tStartMs": 183450,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "or the supports on each\ncorner of the chair,"
    } ]
  }, {
    "tStartMs": 187380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "it's at the midpoint of each side."
    } ]
  }, {
    "tStartMs": 190440,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Obviously, it's not an ideal situation."
    } ]
  }, {
    "tStartMs": 193380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It doesn't seem very stable."
    } ]
  }, {
    "tStartMs": 194820,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "Exactly. So it created\nan engineering problem."
    } ]
  }, {
    "tStartMs": 199650,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "As LeMessurier\nconsidered the problem,"
    } ]
  }, {
    "tStartMs": 201450,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "he suddenly had a flash of inspiration."
    } ]
  }, {
    "tStartMs": 204270,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "He grabbed a napkin and\nsketched out an idea."
    } ]
  }, {
    "tStartMs": 206970,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "He drew six layers"
    } ]
  }, {
    "tStartMs": 208290,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "of diagonal braces up\neach face of the tower."
    } ]
  }, {
    "tStartMs": 211590,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "These chevrons would transfer\nthe forces to the middle"
    } ]
  }, {
    "tStartMs": 214680,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "of each face and down to the stilts."
    } ]
  }, {
    "tStartMs": 218550,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Now we have to see the\ngravity loads, right?"
    } ]
  }, {
    "tStartMs": 220770,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But now here's the trick."
    } ]
  }, {
    "tStartMs": 221940,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The gravity loads are\ncoming down the column."
    } ]
  }, {
    "tStartMs": 224520,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "When they get to the brace,"
    } ]
  }, {
    "tStartMs": 226050,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "they need to find their\nway into the brace."
    } ]
  }, {
    "tStartMs": 229620,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Okay.\nSo what you do"
    } ]
  }, {
    "tStartMs": 230910,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "is you take out that column right there."
    } ]
  }, {
    "tStartMs": 232860,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "There is no way that load can jump over"
    } ]
  }, {
    "tStartMs": 235890,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "and go to that column."
    } ]
  }, {
    "tStartMs": 237030,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And now they're coming\ndown into the braces."
    } ]
  }, {
    "tStartMs": 238770,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "They get down to the bottom here,"
    } ]
  }, {
    "tStartMs": 240480,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and now they continue to go down."
    } ]
  }, {
    "tStartMs": 242310,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "You take that column out,"
    } ]
  }, {
    "tStartMs": 243570,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "it has nowhere to go\nexcept into the brace."
    } ]
  }, {
    "tStartMs": 246660,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "By removing the columns at the top"
    } ]
  }, {
    "tStartMs": 248370,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and middle of each chevron,"
    } ]
  }, {
    "tStartMs": 250140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "every tier acted as a separate unit."
    } ]
  }, {
    "tStartMs": 252930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "They were only connected to the braces"
    } ]
  }, {
    "tStartMs": 254880,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and through the central core."
    } ]
  }, {
    "tStartMs": 256770,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So every eight stories,\nhalf of the gravity load"
    } ]
  }, {
    "tStartMs": 259740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "would be forced through the chevrons"
    } ]
  }, {
    "tStartMs": 261360,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to the midface columns,\nleading down to the stilts."
    } ]
  }, {
    "tStartMs": 264720,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Can you tell me how big\nof a new idea was this?"
    } ]
  }, {
    "tStartMs": 268920,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Yeah, well, this particular\nsystem was entirely unique,"
    } ]
  }, {
    "tStartMs": 272430,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "driven by the placement of the columns,"
    } ]
  }, {
    "tStartMs": 275370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "driven by the conditions of the building."
    } ]
  }, {
    "tStartMs": 277860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "As satisfied the chevrons\ncould transfer the gravity load,"
    } ]
  }, {
    "tStartMs": 280800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "LeMessurier turned his\nattention to the second problem,"
    } ]
  }, {
    "tStartMs": 283620,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "the wind."
    } ]
  }, {
    "tStartMs": 285420,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "When wind hits the left\nside of a normal building"
    } ]
  }, {
    "tStartMs": 287610,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "with corner columns, the\nentire frame deforms like this."
    } ]
  }, {
    "tStartMs": 291360,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So to reduce this deformation,"
    } ]
  }, {
    "tStartMs": 293130,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "we could strengthen these\njoints, but there's a better way"
    } ]
  }, {
    "tStartMs": 297300,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "because beams and columns are\nmuch stronger in compression"
    } ]
  }, {
    "tStartMs": 300270,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "or tension than they\nare with bending loads."
    } ]
  }, {
    "tStartMs": 302670,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So if we add diagonal bracing,"
    } ]
  }, {
    "tStartMs": 304620,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "they can carry this horizontal load."
    } ]
  }, {
    "tStartMs": 307290,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The beams sort of act like springs,"
    } ]
  }, {
    "tStartMs": 309510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and when they're compressed,\nthey push on the joints."
    } ]
  }, {
    "tStartMs": 312090,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "When they're stretched, they pull inwards."
    } ]
  }, {
    "tStartMs": 314820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "With braces like these,"
    } ]
  }, {
    "tStartMs": 316170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "the wind load compresses this diagonal"
    } ]
  }, {
    "tStartMs": 318120,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and stretches this one."
    } ]
  }, {
    "tStartMs": 319830,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "The left column pulls down in tension"
    } ]
  }, {
    "tStartMs": 321960,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and the right column\npushes up in compression."
    } ]
  }, {
    "tStartMs": 324720,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Where the braces meet,"
    } ]
  }, {
    "tStartMs": 325710,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "they both push the\nbottom beam to the right."
    } ]
  }, {
    "tStartMs": 328380,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "This stretches the left side\nand compresses the right one."
    } ]
  }, {
    "tStartMs": 332070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But this floor is the\ntop of the next chevron,"
    } ]
  }, {
    "tStartMs": 334830,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "so this lower section\nis carrying the force"
    } ]
  }, {
    "tStartMs": 337080,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "from the layer above it"
    } ]
  }, {
    "tStartMs": 338370,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and the normal wind load from the side."
    } ]
  }, {
    "tStartMs": 340470,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And this keeps happening at every chevron"
    } ]
  }, {
    "tStartMs": 343050,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "so the wind load builds up\nas you go down the building."
    } ]
  }, {
    "tStartMs": 346350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But Citicorp can't have\ncorner columns like this"
    } ]
  }, {
    "tStartMs": 348630,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "because of the gravity load."
    } ]
  }, {
    "tStartMs": 349950,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So in the wind, this entire triangle"
    } ]
  }, {
    "tStartMs": 352260,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "wants to rotate like this"
    } ]
  }, {
    "tStartMs": 354240,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and to prevent that from happening,"
    } ]
  }, {
    "tStartMs": 355740,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "this chevron pulls down going into tension"
    } ]
  }, {
    "tStartMs": 358350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and the far chevron\npushes up in compression."
    } ]
  }, {
    "tStartMs": 361200,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "The top and bottom beams"
    } ]
  }, {
    "tStartMs": 362250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "are again forced into\ncompression and tension."
    } ]
  }, {
    "tStartMs": 364980,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "The wind load ends up wrapping\naround the entire building."
    } ]
  }, {
    "tStartMs": 368070,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So every chevron works\nto transfer the wind load"
    } ]
  }, {
    "tStartMs": 370620,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "to the section below."
    } ]
  }, {
    "tStartMs": 373140,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "When we think about skyscrapers,"
    } ]
  }, {
    "tStartMs": 374220,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "like how big of a deal is wind?"
    } ]
  }, {
    "tStartMs": 375810,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If we made a skyscraper here, you know,"
    } ]
  }, {
    "tStartMs": 377910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "out of all these different\nthings, you push with your phone,"
    } ]
  }, {
    "tStartMs": 380490,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you get a certain amount of force,"
    } ]
  }, {
    "tStartMs": 381930,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "but then you push on my phone as well"
    } ]
  }, {
    "tStartMs": 383490,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "with a certain amount of force,"
    } ]
  }, {
    "tStartMs": 384323,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "but your phone is also\npushing on my phone."
    } ]
  }, {
    "tStartMs": 386520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "And so that's the shear in the building,"
    } ]
  }, {
    "tStartMs": 388500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "what we call the building shear."
    } ]
  }, {
    "tStartMs": 390000,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "It increases as you go down the building."
    } ]
  }, {
    "tStartMs": 392220,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "You know, at the 10th floor,"
    } ]
  }, {
    "tStartMs": 393810,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "you may have a smaller force\nthan at the 60th floor,"
    } ]
  }, {
    "tStartMs": 396360,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "but the total force of the 10th floor"
    } ]
  }, {
    "tStartMs": 398910,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "is like carrying everything above it."
    } ]
  }, {
    "tStartMs": 400950,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So it's much bigger than what's\ngoing on on the 60th floor."
    } ]
  }, {
    "tStartMs": 404550,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "So these chevrons were key to LeMessurier's design,"
    } ]
  }, {
    "tStartMs": 407804,
    "dDurationMs": 3558,
    "segs": [ {
      "utf8": "but the braces were massive, almost 40 meters long end to end. "
    } ]
  }, {
    "tStartMs": 411362,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "So even if you could fabricate\na steel brace that long,"
    } ]
  }, {
    "tStartMs": 415380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "there would be no way to\nget it through Manhattan."
    } ]
  }, {
    "tStartMs": 417960,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So instead it was sent in pieces"
    } ]
  }, {
    "tStartMs": 420300,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "to be welded together on site."
    } ]
  }, {
    "tStartMs": 423930,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The chevron bracing solved the\nwind and gravity load issues,"
    } ]
  }, {
    "tStartMs": 427530,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "but it also created a different problem."
    } ]
  }, {
    "tStartMs": 431520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Because of the chevron bracing system,"
    } ]
  }, {
    "tStartMs": 434760,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "they were able to save a\nlot of money and weight."
    } ]
  }, {
    "tStartMs": 438630,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "It was a lighter construct\nthan most other buildings"
    } ]
  }, {
    "tStartMs": 442830,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "in New York, I think it was\n22 pounds a square foot,"
    } ]
  }, {
    "tStartMs": 445140,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "which is very light."
    } ]
  }, {
    "tStartMs": 447270,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Unfortunately, that made\nthe building swayable,"
    } ]
  }, {
    "tStartMs": 451230,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it could move in the wind."
    } ]
  }, {
    "tStartMs": 452670,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "That wasn't necessarily a\nstructural problem, it was just,"
    } ]
  }, {
    "tStartMs": 456870,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "it could have been\nuncomfortable for the patrons."
    } ]
  }, {
    "tStartMs": 461490,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The way they could solve this was just"
    } ]
  }, {
    "tStartMs": 462750,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "let's add more structural steel\nand make it a lot stiffer."
    } ]
  }, {
    "tStartMs": 465300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "But the solution that\nLeMessurier came up with"
    } ]
  }, {
    "tStartMs": 467610,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "was far more elegant."
    } ]
  }, {
    "tStartMs": 470100,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "He adopted something that\nhad been regularly used"
    } ]
  }, {
    "tStartMs": 472470,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "in bridges, power lines and ships,"
    } ]
  }, {
    "tStartMs": 474870,
    "dDurationMs": 4987,
    "segs": [ {
      "utf8": "but never before in a building:\na tuned mass damper or TMD."
    } ]
  }, {
    "tStartMs": 480870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So we're here at Stark Laboratories,"
    } ]
  }, {
    "tStartMs": 482670,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and I'm not with Iron Man,"
    } ]
  }, {
    "tStartMs": 483870,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but instead the Columbia Space Initiative,"
    } ]
  }, {
    "tStartMs": 486030,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the student team here on\ncampus who has helped us build"
    } ]
  }, {
    "tStartMs": 488790,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "this incredible tuned mass\ndamper kind of system."
    } ]
  }, {
    "tStartMs": 492690,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "We'll use this cart to\nrepresent a building."
    } ]
  }, {
    "tStartMs": 495390,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "By pulling it back and releasing it,"
    } ]
  }, {
    "tStartMs": 497100,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "we can excite its resonant frequency,"
    } ]
  }, {
    "tStartMs": 499860,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And then we'll put on a\nlittle pendulum, aluminum rod,"
    } ]
  }, {
    "tStartMs": 503700,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "and a mass at the bottom."
    } ]
  }, {
    "tStartMs": 506280,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "As the building sways,"
    } ]
  }, {
    "tStartMs": 507450,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it transfers some of its\nkinetic energy to the pendulum,"
    } ]
  }, {
    "tStartMs": 510420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "which starts to swing."
    } ]
  }, {
    "tStartMs": 512220,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Then some of its energy is\ndissipated through friction"
    } ]
  }, {
    "tStartMs": 515160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "at the hinge."
    } ]
  }, {
    "tStartMs": 516480,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "The pendulum and the building oscillate"
    } ]
  }, {
    "tStartMs": 518430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "out of phase from each other."
    } ]
  }, {
    "tStartMs": 519840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So every time the building\npulls the pendulum"
    } ]
  }, {
    "tStartMs": 522180,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "in a different direction,\nmore energy is lost,"
    } ]
  }, {
    "tStartMs": 525150,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "significantly damping\nthe sway of the tower."
    } ]
  }, {
    "tStartMs": 528840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But this system needs\nto be carefully tuned"
    } ]
  }, {
    "tStartMs": 531030,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so it has the same frequency\nas the building itself"
    } ]
  }, {
    "tStartMs": 533550,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and the right amount of friction."
    } ]
  }, {
    "tStartMs": 537090,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "So first, the mass needs\nto be at least one to 5%"
    } ]
  }, {
    "tStartMs": 540377,
    "dDurationMs": 1903,
    "segs": [ {
      "utf8": "of the building's weight to be effective."
    } ]
  }, {
    "tStartMs": 542280,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And we tune the frequency of the TMD"
    } ]
  }, {
    "tStartMs": 544530,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "by adjusting the length of the pendulum."
    } ]
  }, {
    "tStartMs": 546870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "I assume engineers do\nmath around this thing,"
    } ]
  }, {
    "tStartMs": 549060,
    "dDurationMs": 1631,
    "segs": [ {
      "utf8": "but we're just doing it by feel."
    } ]
  }, {
    "tStartMs": 550691,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "(both laugh)"
    } ]
  }, {
    "tStartMs": 552000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Second, by loosening\nor tightening the bolt,"
    } ]
  }, {
    "tStartMs": 554640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "we can tune the amount of damping."
    } ]
  }, {
    "tStartMs": 556950,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "We need to dissipate more energy\nfrom friction at the hinge"
    } ]
  }, {
    "tStartMs": 559770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to stop the swaying faster."
    } ]
  }, {
    "tStartMs": 561870,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "We just tighten the top bolt,"
    } ]
  }, {
    "tStartMs": 563280,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "make the whole system a little bit,"
    } ]
  }, {
    "tStartMs": 565082,
    "dDurationMs": 1558,
    "segs": [ {
      "utf8": "you know, add a little\nbit more resistance,"
    } ]
  }, {
    "tStartMs": 566640,
    "dDurationMs": 3257,
    "segs": [ {
      "utf8": "and we'll see if we can\ndampen it now further."
    } ]
  }, {
    "tStartMs": 569897,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 572520,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Woohoo.\nMuch different. Yeah."
    } ]
  }, {
    "tStartMs": 573990,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Yeah, that looked\ngreat. That was so quick."
    } ]
  }, {
    "tStartMs": 576060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Yeah, that was."
    } ]
  }, {
    "tStartMs": 577440,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "It is cool when an experiment works."
    } ]
  }, {
    "tStartMs": 579465,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Does not always happen."
    } ]
  }, {
    "tStartMs": 582660,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "There are many\ndifferent types of TMDs,"
    } ]
  }, {
    "tStartMs": 584730,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "like pendulums, liquid columns,\nand a large mass on springs."
    } ]
  }, {
    "tStartMs": 589740,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "LeMessurier used this\nlast one in Citicorp."
    } ]
  }, {
    "tStartMs": 592680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "What you see\nis a mass of concrete,"
    } ]
  }, {
    "tStartMs": 594960,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "which is 29 feet square\nand about eight feet thick"
    } ]
  }, {
    "tStartMs": 598350,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and weighs 400 tons."
    } ]
  }, {
    "tStartMs": 601470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It was installed on the top floor"
    } ]
  }, {
    "tStartMs": 603540,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "and it's affectionately known\nas that great block of cheese."
    } ]
  }, {
    "tStartMs": 607950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "As Citicorp sways to one side,"
    } ]
  }, {
    "tStartMs": 610110,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the block starts to move\nin the same direction."
    } ]
  }, {
    "tStartMs": 613020,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Some energy is dissipated\nthrough separate viscous dampers."
    } ]
  }, {
    "tStartMs": 617010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Citicorp's oscillations are damped"
    } ]
  }, {
    "tStartMs": 618600,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "through those energy losses\nas the block oscillates"
    } ]
  }, {
    "tStartMs": 621420,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "out of phase to the building's motion."
    } ]
  }, {
    "tStartMs": 624090,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "LeMessurier expected the\ndamper to reduce the amplitude"
    } ]
  }, {
    "tStartMs": 626910,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "of swaying by roughly 50%,"
    } ]
  }, {
    "tStartMs": 629130,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and he saved around $4 million"
    } ]
  }, {
    "tStartMs": 631290,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "by not needing an additional\n2,800 tons of structural steel."
    } ]
  }, {
    "tStartMs": 636240,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "With both the chevron bracing"
    } ]
  }, {
    "tStartMs": 638040,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "to channel forces to the stilts"
    } ]
  }, {
    "tStartMs": 639600,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and the tuned mass damper to reduce sway,"
    } ]
  }, {
    "tStartMs": 642150,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "LeMessurier was convinced"
    } ]
  }, {
    "tStartMs": 643440,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "the building was structurally sound."
    } ]
  }, {
    "tStartMs": 646290,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "On Citicorp Center's opening day in 1977,"
    } ]
  }, {
    "tStartMs": 649080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it was the 11th tallest\nbuilding in the world."
    } ]
  }, {
    "tStartMs": 652200,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It was described by the press"
    } ]
  }, {
    "tStartMs": 653580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "as an acrobatic act of architecture."
    } ]
  }, {
    "tStartMs": 656760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Later, the American\nInstitute of Architects"
    } ]
  }, {
    "tStartMs": 659130,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "even gave it an honor award,\ncalling it a tour de force"
    } ]
  }, {
    "tStartMs": 662700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "as a stylish silhouette in the skyline,"
    } ]
  }, {
    "tStartMs": 665040,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and, for the pedestrian, a\nhovering cantilevered hulk."
    } ]
  }, {
    "tStartMs": 669000,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "So then, it's going\nswimmingly for years, right?"
    } ]
  }, {
    "tStartMs": 673230,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "Well, it's going\nswimmingly for about a year."
    } ]
  }, {
    "tStartMs": 678060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The first hint of\ntrouble came in May, 1978."
    } ]
  }, {
    "tStartMs": 680880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "LeMessurier was talking\nwith another client"
    } ]
  }, {
    "tStartMs": 683400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "about welding similar chevron braces."
    } ]
  }, {
    "tStartMs": 686100,
    "dDurationMs": 2797,
    "segs": [ {
      "utf8": "The architect and the\nsteel fabricator said,"
    } ]
  }, {
    "tStartMs": 688897,
    "dDurationMs": 3683,
    "segs": [ {
      "utf8": "\"Tell me, how did those\nwelded braces work out?\""
    } ]
  }, {
    "tStartMs": 692580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Seems like overkill, they thought."
    } ]
  }, {
    "tStartMs": 694500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And LeMessurier says,\n\"Yeah, they were fine."
    } ]
  }, {
    "tStartMs": 696630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Let me call my guys in\nNew York and I'll check.\""
    } ]
  }, {
    "tStartMs": 699150,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So he put the call into\nhis office in New York"
    } ]
  }, {
    "tStartMs": 702690,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and they say, \"Oh, Bill, didn't you know?"
    } ]
  }, {
    "tStartMs": 705450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "We bolted those connections.\""
    } ]
  }, {
    "tStartMs": 707970,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The contractor\nhad suggested saving"
    } ]
  }, {
    "tStartMs": 709980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "a quarter of a million\ndollars by using bolts"
    } ]
  }, {
    "tStartMs": 712230,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to attach the braces instead of welds."
    } ]
  }, {
    "tStartMs": 714480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And LeMessurier's firm had agreed."
    } ]
  }, {
    "tStartMs": 717240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "There is nothing that\nsays a bolt is inherently"
    } ]
  }, {
    "tStartMs": 719640,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "worse or better than a weld."
    } ]
  }, {
    "tStartMs": 721230,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "You use them in different circumstances"
    } ]
  }, {
    "tStartMs": 723060,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "for different reasons,"
    } ]
  }, {
    "tStartMs": 724080,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "but it's a little surprising to find out,"
    } ]
  }, {
    "tStartMs": 727020,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I thought the connections\nin this tour de force,"
    } ]
  }, {
    "tStartMs": 729570,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "one of a kind skyscraper, you know,"
    } ]
  }, {
    "tStartMs": 731520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that's on the cutting edge\nof structural engineering,"
    } ]
  }, {
    "tStartMs": 733920,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "was connected one way,"
    } ]
  }, {
    "tStartMs": 735450,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but apparently it's connected another way."
    } ]
  }, {
    "tStartMs": 737640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But if the braces are going like this,"
    } ]
  }, {
    "tStartMs": 740160,
    "dDurationMs": 1685,
    "segs": [ {
      "utf8": "where are they gonna go?"
    } ]
  }, {
    "tStartMs": 741845,
    "dDurationMs": 1345,
    "segs": [ {
      "utf8": "You know, you only need the weld"
    } ]
  }, {
    "tStartMs": 743190,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "when the braces are going like this."
    } ]
  }, {
    "tStartMs": 745320,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Since the gravity load"
    } ]
  }, {
    "tStartMs": 746370,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "was always compressing the\nbraces, some of the chevrons"
    } ]
  }, {
    "tStartMs": 749280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "only went into tension\nunder very high winds."
    } ]
  }, {
    "tStartMs": 752100,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And even then, it wasn't a lot of tension."
    } ]
  }, {
    "tStartMs": 755220,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "LeMessurier trusted that his team"
    } ]
  }, {
    "tStartMs": 756690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "did the right calculations,\nand the substitution was fine,"
    } ]
  }, {
    "tStartMs": 760050,
    "dDurationMs": 1153,
    "segs": [ {
      "utf8": "logical, even."
    } ]
  }, {
    "tStartMs": 761203,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "(phone ringing)"
    } ]
  }, {
    "tStartMs": 763260,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "But around a month later,"
    } ]
  }, {
    "tStartMs": 764310,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "LeMessurier got a phone\ncall from a student"
    } ]
  }, {
    "tStartMs": 765960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "who wanted to ask some questions\nabout the Citicorp Center."
    } ]
  }, {
    "tStartMs": 768840,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "And his teacher said to him,"
    } ]
  }, {
    "tStartMs": 770437,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "\"That engineer didn't know what he's doing"
    } ]
  }, {
    "tStartMs": 772050,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and nobody should put the\ncolumns in the middle."
    } ]
  }, {
    "tStartMs": 774480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "They should put 'em in the\ncorners. That's silly.\""
    } ]
  }, {
    "tStartMs": 777540,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "And I told the student, I said,"
    } ]
  }, {
    "tStartMs": 779137,
    "dDurationMs": 2573,
    "segs": [ {
      "utf8": "\"Well, you're a professor's full of it."
    } ]
  }, {
    "tStartMs": 781710,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "He doesn't understand the\nproblem we had to solve.\""
    } ]
  }, {
    "tStartMs": 784677,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "LeMessurier went\nthrough the calculations"
    } ]
  }, {
    "tStartMs": 786390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "with the student"
    } ]
  }, {
    "tStartMs": 787223,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "to reassure him the stilts\nwere in the right place."
    } ]
  }, {
    "tStartMs": 789990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But the interesting thing\nis, is in that moment,"
    } ]
  }, {
    "tStartMs": 792540,
    "dDurationMs": 4293,
    "segs": [ {
      "utf8": "he's thinking about wind\nloads from all directions."
    } ]
  }, {
    "tStartMs": 797700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You know, late spring,\nearly summer of 1978,"
    } ]
  }, {
    "tStartMs": 800250,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Bill LeMessurier is working\non the back of a Hilton Hotel"
    } ]
  }, {
    "tStartMs": 803100,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "that, in plan, forms a\ntriangle, not a rectangle."
    } ]
  }, {
    "tStartMs": 807330,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Now you got a triangle. What's\nyour orthogonal direction?"
    } ]
  }, {
    "tStartMs": 811140,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "You just have to give up and say,"
    } ]
  }, {
    "tStartMs": 813217,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "\"We're gonna analyze it\nfrom every direction.\""
    } ]
  }, {
    "tStartMs": 815640,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "That's going on the moment\nthat Bill LeMessurier"
    } ]
  }, {
    "tStartMs": 818490,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "gets this phone call."
    } ]
  }, {
    "tStartMs": 820410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Then I called him back\nand pointed it out to him"
    } ]
  }, {
    "tStartMs": 822510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that there's some peculiar\nthings about this building."
    } ]
  }, {
    "tStartMs": 824880,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The worst loading case\nwas not the diagonal,"
    } ]
  }, {
    "tStartMs": 827160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but it was the ordinary wind\nthat everybody thinks about."
    } ]
  }, {
    "tStartMs": 829800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The wind pushes straight on the building."
    } ]
  }, {
    "tStartMs": 831330,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "That was the critical case."
    } ]
  }, {
    "tStartMs": 832980,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "He said, you know what,"
    } ]
  }, {
    "tStartMs": 833820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I've been getting all these\ncalls from all these people."
    } ]
  }, {
    "tStartMs": 836160,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "I'm gonna sit down and explain this thing."
    } ]
  }, {
    "tStartMs": 839700,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "He decided to double check"
    } ]
  }, {
    "tStartMs": 840810,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "what happens to the\nbuilding if wind is hitting"
    } ]
  }, {
    "tStartMs": 842940,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "a corner of the building, not\nstraight on one of the faces."
    } ]
  }, {
    "tStartMs": 846510,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "These are also known as quartering winds."
    } ]
  }, {
    "tStartMs": 849150,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So he split the wind into\nits perpendicular components."
    } ]
  }, {
    "tStartMs": 852150,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So the west side and north\nside are hit by the force"
    } ]
  }, {
    "tStartMs": 855420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "divided by the square root of two."
    } ]
  }, {
    "tStartMs": 857280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "He computed the forces for\neach, as we did before,"
    } ]
  }, {
    "tStartMs": 860130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and summed up the result,"
    } ]
  }, {
    "tStartMs": 861960,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "but then he noticed something strange."
    } ]
  }, {
    "tStartMs": 864810,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Then now we\nlook at the diagonals,"
    } ]
  }, {
    "tStartMs": 867000,
    "dDurationMs": 3258,
    "segs": [ {
      "utf8": "the stresses in half of them vanish,"
    } ]
  }, {
    "tStartMs": 870258,
    "dDurationMs": 2592,
    "segs": [ {
      "utf8": "and in the other half, double."
    } ]
  }, {
    "tStartMs": 872850,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Since the force on each side"
    } ]
  }, {
    "tStartMs": 874500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "was F over the square root of two,"
    } ]
  }, {
    "tStartMs": 876600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "these beams get double that."
    } ]
  }, {
    "tStartMs": 878790,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Compared to LeMessurier calculations"
    } ]
  }, {
    "tStartMs": 880320,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "for the perpendicular wind load,"
    } ]
  }, {
    "tStartMs": 881850,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "the forces here were 40% higher."
    } ]
  }, {
    "tStartMs": 885360,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So 1.4 by itself is not\nenough to wreck havoc."
    } ]
  }, {
    "tStartMs": 890820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Okay? It may be, but it may not be."
    } ]
  }, {
    "tStartMs": 893160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Okay.\nSo then the question is,"
    } ]
  }, {
    "tStartMs": 894570,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "well, what happens?"
    } ]
  }, {
    "tStartMs": 897030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "This increase in\nforces wouldn't have mattered"
    } ]
  }, {
    "tStartMs": 899400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in the original design"
    } ]
  }, {
    "tStartMs": 900600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "since the chevrons were\nfully welded together."
    } ]
  }, {
    "tStartMs": 903540,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But that wasn't the case anymore."
    } ]
  }, {
    "tStartMs": 905730,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "LeMessurier remembered\nhis earlier phone call."
    } ]
  }, {
    "tStartMs": 908310,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The welds holding the chevrons together"
    } ]
  }, {
    "tStartMs": 910470,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "were swapped for bolts."
    } ]
  }, {
    "tStartMs": 912360,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "How did his team calculate\nthe number of bolts per joint?"
    } ]
  }, {
    "tStartMs": 916170,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Did they consider quartering winds?"
    } ]
  }, {
    "tStartMs": 918840,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It would be a miracle if\nthey ever thought that through,"
    } ]
  }, {
    "tStartMs": 922320,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "to think about the diagonal wind."
    } ]
  }, {
    "tStartMs": 923910,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "It just wasn't in the nature of anybody."
    } ]
  }, {
    "tStartMs": 926910,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So I had a bit of a worry."
    } ]
  }, {
    "tStartMs": 929940,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I didn't panic right away,"
    } ]
  }, {
    "tStartMs": 931620,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but I decided to go down\nto New York to my office."
    } ]
  }, {
    "tStartMs": 934290,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "LeMessurier\nrequested the building diagrams"
    } ]
  }, {
    "tStartMs": 936300,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and poured over all of the connections."
    } ]
  }, {
    "tStartMs": 938820,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "He looked at how his firm\ncalculated the number of bolts."
    } ]
  }, {
    "tStartMs": 942150,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "There was no question, they\nhad taken straight on wind,"
    } ]
  }, {
    "tStartMs": 944820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "not the diagonal wind."
    } ]
  }, {
    "tStartMs": 946380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Although wind speed is highest"
    } ]
  }, {
    "tStartMs": 947820,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "at the top of the tower,"
    } ]
  }, {
    "tStartMs": 948870,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "the wind shear builds up as you go lower."
    } ]
  }, {
    "tStartMs": 951780,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Looking at this brace around\nhalfway down the tower,"
    } ]
  }, {
    "tStartMs": 954600,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "the perpendicular wind load is 454 tons."
    } ]
  }, {
    "tStartMs": 958740,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Because of the skipped columns,"
    } ]
  }, {
    "tStartMs": 960510,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "all of these braces carry\nthe same gravity load,"
    } ]
  }, {
    "tStartMs": 963120,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "just 340 tons, from the\neight stories above."
    } ]
  }, {
    "tStartMs": 967140,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The gravity load builds\nup in the center column,"
    } ]
  }, {
    "tStartMs": 969780,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "not in the braces,"
    } ]
  }, {
    "tStartMs": 971430,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "which means there are 114\ntons of tension in this brace."
    } ]
  }, {
    "tStartMs": 976290,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "If each bolt can withstand around 28 tons,"
    } ]
  }, {
    "tStartMs": 979350,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "that would require four bolts."
    } ]
  }, {
    "tStartMs": 981900,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The original calculations said\njust four bolts were enough."
    } ]
  }, {
    "tStartMs": 985680,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So that was all they used."
    } ]
  }, {
    "tStartMs": 988140,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But when he added quartering winds,"
    } ]
  }, {
    "tStartMs": 990060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "LeMessurier's calculations\nshowed there were some braces"
    } ]
  }, {
    "tStartMs": 992640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that needed far more bolts."
    } ]
  }, {
    "tStartMs": 994920,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "At this particular part of the building,"
    } ]
  }, {
    "tStartMs": 997500,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "which I can show you on my\ncalculations is right about here,"
    } ]
  }, {
    "tStartMs": 1002060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and Bill LeMessurier talked\nabout the 30th floor,"
    } ]
  }, {
    "tStartMs": 1004160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and I always wondered why\nwas it the 30th floor?"
    } ]
  }, {
    "tStartMs": 1007040,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "The 40% increase\nfrom quartering winds"
    } ]
  }, {
    "tStartMs": 1009530,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "means that this brace has\na wind load of 635 tons."
    } ]
  }, {
    "tStartMs": 1013670,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "The tension in the brace is now 295 tons,"
    } ]
  }, {
    "tStartMs": 1017480,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "over double the original calculation."
    } ]
  }, {
    "tStartMs": 1020510,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "So these braces actually need\naround 10 bolts, not four."
    } ]
  }, {
    "tStartMs": 1024650,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But then it turned out\nthey had done something else."
    } ]
  }, {
    "tStartMs": 1027590,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "LeMessurier's\nfirm considered the braces"
    } ]
  }, {
    "tStartMs": 1029180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to be minor structural elements."
    } ]
  }, {
    "tStartMs": 1031160,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "They didn't use the right factor of safety"
    } ]
  }, {
    "tStartMs": 1032990,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "to calculate the number of bolts."
    } ]
  }, {
    "tStartMs": 1034820,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "They should have overestimated\nthe tension in the brace"
    } ]
  }, {
    "tStartMs": 1037130,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "by underestimating the gravity load."
    } ]
  }, {
    "tStartMs": 1039410,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "With only 75% of the gravity load,"
    } ]
  }, {
    "tStartMs": 1042170,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "the tension in the beam is now 380 tons."
    } ]
  }, {
    "tStartMs": 1045710,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "So they really needed 14\nbolts, but they used only four."
    } ]
  }, {
    "tStartMs": 1050750,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "I thought this\nthing is in real trouble."
    } ]
  }, {
    "tStartMs": 1054230,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Imagine, you know,"
    } ]
  }, {
    "tStartMs": 1055250,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "what Bill LeMessurier was\nthinking at that moment."
    } ]
  }, {
    "tStartMs": 1057380,
    "dDurationMs": 2887,
    "segs": [ {
      "utf8": "You see that number and you're like,"
    } ]
  }, {
    "tStartMs": 1060267,
    "dDurationMs": 3193,
    "segs": [ {
      "utf8": "\"Oh my God, this is serious.\nIt's really serious.\""
    } ]
  }, {
    "tStartMs": 1063460,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "LeMessurier\nwas starting to panic."
    } ]
  }, {
    "tStartMs": 1066290,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "He didn't wanna rush to conclusions,"
    } ]
  }, {
    "tStartMs": 1068210,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so he flew to Canada to\ncheck his calculations"
    } ]
  }, {
    "tStartMs": 1070490,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "with Alan Davenport at the\nBoundary Layer Wind Tunnel."
    } ]
  }, {
    "tStartMs": 1073790,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "After running more tests,"
    } ]
  }, {
    "tStartMs": 1074870,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "they found that it was even\nworse than LeMessurier thought."
    } ]
  }, {
    "tStartMs": 1079280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The estimated 40% increase in stress"
    } ]
  }, {
    "tStartMs": 1081680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "was technically correct,"
    } ]
  }, {
    "tStartMs": 1083120,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "but LeMessurier made his calculations"
    } ]
  }, {
    "tStartMs": 1084770,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "assuming the building wasn't moving."
    } ]
  }, {
    "tStartMs": 1086780,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "This is called static conditions."
    } ]
  }, {
    "tStartMs": 1089060,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But the wind tunnel gave\nLeMessurier a dynamic analysis,"
    } ]
  }, {
    "tStartMs": 1092360,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "how the forces change when\nthe building is moving around."
    } ]
  }, {
    "tStartMs": 1095780,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "To LeMessurier's horror,\nthe wind tunnel analysis"
    } ]
  }, {
    "tStartMs": 1098660,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "showed that the stresses could increase"
    } ]
  }, {
    "tStartMs": 1100490,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "up to 60% more than\noriginally anticipated."
    } ]
  }, {
    "tStartMs": 1105380,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "LeMessurier squirreled\nhimself away in Maine"
    } ]
  }, {
    "tStartMs": 1107390,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and worked through the data\nfrom the wind tunnel again,"
    } ]
  }, {
    "tStartMs": 1109760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "joint by joint on every floor."
    } ]
  }, {
    "tStartMs": 1112040,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "The weakest joints were at\nthe building's 30th floor."
    } ]
  }, {
    "tStartMs": 1114950,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "If those failed, the\nentire building would fall."
    } ]
  }, {
    "tStartMs": 1119360,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But what were the chances\nthat a storm strong enough"
    } ]
  }, {
    "tStartMs": 1121790,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "to topple the building would\npass through New York City?"
    } ]
  }, {
    "tStartMs": 1125780,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "LeMessurier dug through the\nhistorical weather reports."
    } ]
  }, {
    "tStartMs": 1129110,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "On average, a storm strong\nenough to tear the building apart"
    } ]
  }, {
    "tStartMs": 1132260,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "occurred every 67 years."
    } ]
  }, {
    "tStartMs": 1134810,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But only if the tuned\nmass damper was working."
    } ]
  }, {
    "tStartMs": 1137570,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "If a storm knocked out power,"
    } ]
  }, {
    "tStartMs": 1139370,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "then even 110 kilometer per hour winds"
    } ]
  }, {
    "tStartMs": 1142430,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "blowing for just five minutes\nwould collapse the building."
    } ]
  }, {
    "tStartMs": 1146300,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "In any given year,"
    } ]
  }, {
    "tStartMs": 1147590,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "the chance of a storm that\nsize happening was one in 16."
    } ]
  }, {
    "tStartMs": 1151970,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Just one year before\nCiticorp was completed,"
    } ]
  }, {
    "tStartMs": 1154430,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "wind gusts of 110 kilometers per hour"
    } ]
  }, {
    "tStartMs": 1157010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "roared through New York City"
    } ]
  }, {
    "tStartMs": 1158600,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "as Hurricane Belle passed through."
    } ]
  }, {
    "tStartMs": 1162140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "What do you think this moment\nwas like for LeMessurier,"
    } ]
  }, {
    "tStartMs": 1164480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "when he ran these calculations, like-"
    } ]
  }, {
    "tStartMs": 1166010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Oh, it must have been devastating."
    } ]
  }, {
    "tStartMs": 1168410,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "I mean, it just must have\nbeen, I can't imagine the fear."
    } ]
  }, {
    "tStartMs": 1172100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I can't imagine the feelings."
    } ]
  }, {
    "tStartMs": 1173720,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "I mean, like, it just must have been truly"
    } ]
  }, {
    "tStartMs": 1179420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "a moment he never thought\nhe would live through."
    } ]
  }, {
    "tStartMs": 1182030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That storm was gonna\nfall down in my lifetime."
    } ]
  }, {
    "tStartMs": 1185540,
    "dDurationMs": 1653,
    "segs": [ {
      "utf8": "And since this was July,"
    } ]
  }, {
    "tStartMs": 1188420,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "it could fall down the summer of 1978."
    } ]
  }, {
    "tStartMs": 1191960,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "LeMessurier needed to\ndecide and decide fast."
    } ]
  }, {
    "tStartMs": 1194750,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But revealing this mistake\ncould mean lawsuits,"
    } ]
  }, {
    "tStartMs": 1197180,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "bankruptcy and professional ruin."
    } ]
  }, {
    "tStartMs": 1199250,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "He could stay silent,"
    } ]
  }, {
    "tStartMs": 1200480,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "only Davenport knew and he\nwouldn't reveal anything,"
    } ]
  }, {
    "tStartMs": 1203510,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "or he could entirely disappear."
    } ]
  }, {
    "tStartMs": 1205910,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "In a later interview he\nadmitted, \"I did say to myself,"
    } ]
  }, {
    "tStartMs": 1208700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I could drive down the Maine Turnpike"
    } ]
  }, {
    "tStartMs": 1210620,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "at a hundred miles an hour"
    } ]
  }, {
    "tStartMs": 1211700,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and deliberately drive\ninto a bridge abutment."
    } ]
  }, {
    "tStartMs": 1214340,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "That would be the end and\nall of this would go away."
    } ]
  }, {
    "tStartMs": 1217520,
    "dDurationMs": 1257,
    "segs": [ {
      "utf8": "I thought about that.\""
    } ]
  }, {
    "tStartMs": 1220850,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "But there was a 1 in 16 chance\nof collapse that very fall."
    } ]
  }, {
    "tStartMs": 1225650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "With thousands of lives at risk,"
    } ]
  }, {
    "tStartMs": 1227930,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "there was never any\nother choice but to act."
    } ]
  }, {
    "tStartMs": 1231770,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "After speaking to a few lawyers"
    } ]
  }, {
    "tStartMs": 1233330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and other engineering experts,"
    } ]
  }, {
    "tStartMs": 1234830,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "LeMessurier told the architect,\nStubbins, and together"
    } ]
  }, {
    "tStartMs": 1237830,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "they informed Citicorp's\nchairman, Walter Wriston."
    } ]
  }, {
    "tStartMs": 1241070,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Within hours of that meeting,"
    } ]
  }, {
    "tStartMs": 1242450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "LeMessurier acquired emergency generators"
    } ]
  }, {
    "tStartMs": 1244520,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "for the tuned mass damper."
    } ]
  }, {
    "tStartMs": 1245990,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "The TMD was originally\ndesigned to stabilize"
    } ]
  }, {
    "tStartMs": 1248480,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "any swaying for comfort,\nbut now it became the crutch"
    } ]
  }, {
    "tStartMs": 1251690,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that the tower leaned on."
    } ]
  }, {
    "tStartMs": 1253430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "LeMessurier pinned all his hopes on it."
    } ]
  }, {
    "tStartMs": 1255860,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "He called the confidential\nrepair plan Project Pandora,"
    } ]
  }, {
    "tStartMs": 1259910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but that sounded ominous,"
    } ]
  }, {
    "tStartMs": 1261770,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "so he came up with the\nSpecial Engineering Review"
    } ]
  }, {
    "tStartMs": 1264890,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "of Events Nobody Envisioned,\nor Project Serene for short."
    } ]
  }, {
    "tStartMs": 1270170,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Each night, welders\nwould enter the building"
    } ]
  }, {
    "tStartMs": 1272210,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "after everyone left,\nrip off the sheet rock"
    } ]
  }, {
    "tStartMs": 1274610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "around the chevron beams,"
    } ]
  }, {
    "tStartMs": 1275870,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and then weld two five-centimeter thick,"
    } ]
  }, {
    "tStartMs": 1278450,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "two-meter long steel plates on each joint."
    } ]
  }, {
    "tStartMs": 1281060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Like Band-Aids, literally Band-Aids,"
    } ]
  }, {
    "tStartMs": 1283580,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "on both sides of these joints."
    } ]
  }, {
    "tStartMs": 1285350,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "After, they'd replaced the wall"
    } ]
  }, {
    "tStartMs": 1286940,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and clean everything up\nbefore the office workers"
    } ]
  }, {
    "tStartMs": 1289310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "came back the next morning,"
    } ]
  }, {
    "tStartMs": 1291320,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "They needed to weld over 200 joints"
    } ]
  }, {
    "tStartMs": 1294260,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and LeMessurier ranked them by importance,"
    } ]
  }, {
    "tStartMs": 1296180,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "starting with the ones on the 30th floor."
    } ]
  }, {
    "tStartMs": 1298790,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But the repairs wouldn't be completed"
    } ]
  }, {
    "tStartMs": 1300410,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "before hurricane season."
    } ]
  }, {
    "tStartMs": 1301970,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So Citicorp worked with the Red Cross"
    } ]
  }, {
    "tStartMs": 1303920,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "to develop a 10 block evacuation plan."
    } ]
  }, {
    "tStartMs": 1306980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Like, how many people\nwere at risk in the building"
    } ]
  }, {
    "tStartMs": 1309080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and if it fell, would it\naffect other buildings?"
    } ]
  }, {
    "tStartMs": 1311030,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Like, were there chances of it"
    } ]
  }, {
    "tStartMs": 1312500,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "leading to something more disastrous?"
    } ]
  }, {
    "tStartMs": 1314180,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Absolutely, this would have toppled"
    } ]
  }, {
    "tStartMs": 1317540,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and it would've toppled\ninto another building,"
    } ]
  }, {
    "tStartMs": 1320330,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which would've toppled\ninto another building,"
    } ]
  }, {
    "tStartMs": 1322910,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "which would've continued\na horrific process."
    } ]
  }, {
    "tStartMs": 1326450,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "So it was untold what the\nultimate effects could have been."
    } ]
  }, {
    "tStartMs": 1331160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "I mean, like,\njust the evacuation plans"
    } ]
  }, {
    "tStartMs": 1332900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "were how many people?"
    } ]
  }, {
    "tStartMs": 1334340,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Thousands, the building\nitself housed thousands"
    } ]
  }, {
    "tStartMs": 1337250,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and then the residents and the businesses"
    } ]
  }, {
    "tStartMs": 1340310,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "surrounding the building,\nit was into the thousands."
    } ]
  }, {
    "tStartMs": 1343940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Despite the risk,"
    } ]
  }, {
    "tStartMs": 1345140,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "they decided not to tell the public"
    } ]
  }, {
    "tStartMs": 1346910,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "or even the office\nworkers in the building."
    } ]
  }, {
    "tStartMs": 1349310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "No one wanted a mass panic."
    } ]
  }, {
    "tStartMs": 1351590,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Instead, they fitted strain gauges"
    } ]
  }, {
    "tStartMs": 1353540,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "on important structural members."
    } ]
  }, {
    "tStartMs": 1355670,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The gauges monitored the\nskyscrapers every bend and twist"
    } ]
  }, {
    "tStartMs": 1358880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "from a comm center eight blocks away."
    } ]
  }, {
    "tStartMs": 1361640,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "At least that would give\nthem a little bit of warning."
    } ]
  }, {
    "tStartMs": 1364820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But this plan required new telephone lines,"
    } ]
  }, {
    "tStartMs": 1366680,
    "dDurationMs": 2055,
    "segs": [ {
      "utf8": "and the phone company wouldn't get around to doing this"
    } ]
  }, {
    "tStartMs": 1368735,
    "dDurationMs": 1305,
    "segs": [ {
      "utf8": "for months."
    } ]
  }, {
    "tStartMs": 1370040,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So Citicorp's chairman immediately called AT\u0026T's president"
    } ]
  }, {
    "tStartMs": 1373040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and the lines were\ninstalled the next morning."
    } ]
  }, {
    "tStartMs": 1375200,
    "dDurationMs": 2512,
    "segs": [ {
      "utf8": "Now you might not be able to install"
    } ]
  }, {
    "tStartMs": 1377712,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "emergency telephone lines at a whim,"
    } ]
  }, {
    "tStartMs": 1379463,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "but you can still stay\nconnected no matter what."
    } ]
  }, {
    "tStartMs": 1381382,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "(phone ringing)"
    } ]
  }, {
    "tStartMs": 1385010,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It's probably not that important."
    } ]
  }, {
    "tStartMs": 1386630,
    "dDurationMs": 3468,
    "segs": [ {
      "utf8": "Henry, can you hear me? Hello!"
    } ]
  }, {
    "tStartMs": 1390098,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Team Veritasium travels all\nover the globe for our videos"
    } ]
  }, {
    "tStartMs": 1392850,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "We traveled here to New York\nto visit the Citicorp Center,"
    } ]
  }, {
    "tStartMs": 1395352,
    "dDurationMs": 1358,
    "segs": [ {
      "utf8": "and there's one really annoying problem."
    } ]
  }, {
    "tStartMs": 1397688,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "It's hard to stay connected\nwith the rest of the team"
    } ]
  }, {
    "tStartMs": 1399564,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "while we're on site."
    } ]
  }, {
    "tStartMs": 1400815,
    "dDurationMs": 905,
    "segs": [ {
      "utf8": "We either have to pay\nridiculous roaming charges,"
    } ]
  }, {
    "tStartMs": 1402692,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "find a local SIM card and\nhope it actually works,"
    } ]
  }, {
    "tStartMs": 1405027,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "or search around for public Wi-Fi"
    } ]
  }, {
    "tStartMs": 1406695,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "that might not be the most secure."
    } ]
  }, {
    "tStartMs": 1408447,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "That's not something we\nwanna be dealing with"
    } ]
  }, {
    "tStartMs": 1409948,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "while making a video."
    } ]
  }, {
    "tStartMs": 1411241,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "So Saily makes it incredibly\neasy and affordable"
    } ]
  }, {
    "tStartMs": 1413868,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "to stay connected while abroad."
    } ]
  }, {
    "tStartMs": 1415537,
    "dDurationMs": 1993,
    "segs": [ {
      "utf8": "Download it once and use\nit in over 180 countries."
    } ]
  }, {
    "tStartMs": 1417530,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You choose how much data\nyou want and for how long."
    } ]
  }, {
    "tStartMs": 1421041,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "It's much cheaper than roaming\nand super quick to set up."
    } ]
  }, {
    "tStartMs": 1423919,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "I just select the country and plan,"
    } ]
  }, {
    "tStartMs": 1425462,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "then activate the e-SIM before\nI take off and I'm done."
    } ]
  }, {
    "tStartMs": 1427910,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "Then when I land, I'll\nautomatically connect"
    } ]
  }, {
    "tStartMs": 1430883,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "to a local network with no hidden charges"
    } ]
  }, {
    "tStartMs": 1433010,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "and be able to do the important things,"
    } ]
  }, {
    "tStartMs": 1434261,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "like access maps, book\na car or call your boss."
    } ]
  }, {
    "tStartMs": 1437514,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "So if you've got travel plans coming up,"
    } ]
  }, {
    "tStartMs": 1439516,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "scan this QR code to download the app."
    } ]
  }, {
    "tStartMs": 1441685,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "Choose a plan in the\ncountry you're going to"
    } ]
  }, {
    "tStartMs": 1443269,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "and, here's the important thing,"
    } ]
  }, {
    "tStartMs": 1444896,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "use our code, Veritasium, at checkout"
    } ]
  }, {
    "tStartMs": 1446814,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "to get an exclusive 15%\noff your first purchase."
    } ]
  }, {
    "tStartMs": 1449692,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Again, check out with code, Veritasium,"
    } ]
  }, {
    "tStartMs": 1451735,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "and get connected no matter where you are."
    } ]
  }, {
    "tStartMs": 1453737,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "Thank you Saily for sponsoring this video."
    } ]
  }, {
    "tStartMs": 1455363,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "And now back to Project Serene."
    } ]
  }, {
    "tStartMs": 1456513,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "(phone ringing)"
    } ]
  }, {
    "tStartMs": 1459247,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "(sighs) I mean, should probably take this."
    } ]
  }, {
    "tStartMs": 1462125,
    "dDurationMs": 915,
    "segs": [ {
      "utf8": "(phone beeps)"
    } ]
  }, {
    "tStartMs": 1463040,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "But even though LeMessurier"
    } ]
  }, {
    "tStartMs": 1465205,
    "dDurationMs": 1195,
    "segs": [ {
      "utf8": "tried to keep Project Serene under wraps,"
    } ]
  }, {
    "tStartMs": 1466400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "people started asking questions."
    } ]
  }, {
    "tStartMs": 1469280,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "On August 8th, Citicorp\nreleased a statement"
    } ]
  }, {
    "tStartMs": 1471830,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "about the repairs."
    } ]
  }, {
    "tStartMs": 1473300,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Now, we had to cook up a\nline of bull, I'll tell you."
    } ]
  }, {
    "tStartMs": 1476120,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "And white lies at this\npoint are entirely moral."
    } ]
  }, {
    "tStartMs": 1479650,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "(class laughs)\nYou don't wanna spread terror"
    } ]
  }, {
    "tStartMs": 1482840,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "in the community to people that\ndon't need to be terrorized."
    } ]
  }, {
    "tStartMs": 1486260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We were terrorized, no\nquestion about that."
    } ]
  }, {
    "tStartMs": 1488660,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Several\nnewspapers reported on it,"
    } ]
  }, {
    "tStartMs": 1490730,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but they didn't have the details."
    } ]
  }, {
    "tStartMs": 1492830,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "Then LeMessurier got a message."
    } ]
  }, {
    "tStartMs": 1494937,
    "dDurationMs": 2273,
    "segs": [ {
      "utf8": "The New York Times\nwas trying to reach him."
    } ]
  }, {
    "tStartMs": 1497210,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "If he didn't respond, they\nwould know something was up."
    } ]
  }, {
    "tStartMs": 1502280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So I mixed a martini for myself"
    } ]
  }, {
    "tStartMs": 1504440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and it's one minute past six."
    } ]
  }, {
    "tStartMs": 1506810,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I dialed The New York Times."
    } ]
  }, {
    "tStartMs": 1508610,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I pick it up the phone,\nthey pick up the phone,"
    } ]
  }, {
    "tStartMs": 1511610,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "it's a tape recorder saying,"
    } ]
  }, {
    "tStartMs": 1513327,
    "dDurationMs": 4312,
    "segs": [ {
      "utf8": "The New York Times has gone\non strike as of six o'clock."
    } ]
  }, {
    "tStartMs": 1517639,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "(class laughs)"
    } ]
  }, {
    "tStartMs": 1518990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Not only did The New\nYork Times go on strike,"
    } ]
  }, {
    "tStartMs": 1521270,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "but all the newspapers in\nNew York went on strike"
    } ]
  }, {
    "tStartMs": 1524690,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "until October."
    } ]
  }, {
    "tStartMs": 1526190,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "So we had a press blackout"
    } ]
  }, {
    "tStartMs": 1528320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and that was the greatest\nthing that ever happened."
    } ]
  }, {
    "tStartMs": 1530240,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "(class laughs)"
    } ]
  }, {
    "tStartMs": 1532880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The press was off their back"
    } ]
  }, {
    "tStartMs": 1534560,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the weather was beautiful."
    } ]
  }, {
    "tStartMs": 1536060,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "The repair work continued smoothly."
    } ]
  }, {
    "tStartMs": 1539090,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "But late August brought the\nnews everyone had been dreading."
    } ]
  }, {
    "tStartMs": 1542960,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Hurricane Ella starts\nbrewing in the Caribbean."
    } ]
  }, {
    "tStartMs": 1547280,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "And this is the one storm\nthat they're nervous about."
    } ]
  }, {
    "tStartMs": 1552080,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "The repairs\nwere halfway done by now."
    } ]
  }, {
    "tStartMs": 1555410,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I think it was a one in 200 year storm"
    } ]
  }, {
    "tStartMs": 1558530,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that it could withstand,"
    } ]
  }, {
    "tStartMs": 1560060,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but LeMessurier wasn't taking chances"
    } ]
  }, {
    "tStartMs": 1562280,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "'cause he didn't know the\nintensity of the storm."
    } ]
  }, {
    "tStartMs": 1564350,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And this was a strong storm."
    } ]
  }, {
    "tStartMs": 1566480,
    "dDurationMs": 1644,
    "segs": [ {
      "utf8": "So there was, there was a chance."
    } ]
  }, {
    "tStartMs": 1568124,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "There was absolutely a chance"
    } ]
  }, {
    "tStartMs": 1569617,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "and they had to prepare for that chance."
    } ]
  }, {
    "tStartMs": 1571557,
    "dDurationMs": 2453,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 1574010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "By Friday, September 1st,"
    } ]
  }, {
    "tStartMs": 1575660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Ella was making her way toward New York,"
    } ]
  }, {
    "tStartMs": 1577580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "with winds reaching 200\nkilometers per hour."
    } ]
  }, {
    "tStartMs": 1580760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "City officials braced\nto start the evacuation."
    } ]
  }, {
    "tStartMs": 1583520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Police would go door to\ndoor to get everyone out"
    } ]
  }, {
    "tStartMs": 1585680,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "within a 10 block radius."
    } ]
  }, {
    "tStartMs": 1588470,
    "dDurationMs": 4353,
    "segs": [ {
      "utf8": "For 24 tense hours, Ella\nstalled around North Carolina."
    } ]
  }, {
    "tStartMs": 1593660,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "Like LeMessurier said,\nwe were sweating blood."
    } ]
  }, {
    "tStartMs": 1597080,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "But sometime in the night,"
    } ]
  }, {
    "tStartMs": 1598370,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Hurricane Ella veered off into\nthe sea at the last minute."
    } ]
  }, {
    "tStartMs": 1601910,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "It intensified and hit Canada"
    } ]
  }, {
    "tStartMs": 1603800,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "with peak winds of 225\nkilometers per hour."
    } ]
  }, {
    "tStartMs": 1608600,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "But Citicorp was safe."
    } ]
  }, {
    "tStartMs": 1612560,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "LeMessurier described that\nnext morning in New York"
    } ]
  }, {
    "tStartMs": 1615140,
    "dDurationMs": 2973,
    "segs": [ {
      "utf8": "as the most beautiful day\nthat the world's ever seen."
    } ]
  }, {
    "tStartMs": 1619340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "They completed the repairs in October,"
    } ]
  }, {
    "tStartMs": 1621500,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "just six weeks after\nLeMessurier told Citicorp."
    } ]
  }, {
    "tStartMs": 1624620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Now the building,\naccording to LeMessurier,"
    } ]
  }, {
    "tStartMs": 1627200,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "can withstand a one in 1000 storm."
    } ]
  }, {
    "tStartMs": 1630410,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "The repairs cost\nbetween $4 and $5 million,"
    } ]
  }, {
    "tStartMs": 1633750,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "but LeMessurier argued\nthat Citicorp approved"
    } ]
  }, {
    "tStartMs": 1635840,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "an earlier building design\nthat cost $5 to $6 million more,"
    } ]
  }, {
    "tStartMs": 1639110,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "so they were willing to spend that much"
    } ]
  }, {
    "tStartMs": 1640880,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "on the skyscraper anyway."
    } ]
  }, {
    "tStartMs": 1644720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "And for almost two decades,"
    } ]
  }, {
    "tStartMs": 1646220,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "the secret was confined\nto a small inner circle."
    } ]
  }, {
    "tStartMs": 1649790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But in 1995, \"The New Yorker\""
    } ]
  }, {
    "tStartMs": 1652220,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "finally brought Project\nSerene into the light."
    } ]
  }, {
    "tStartMs": 1655340,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Far from being vilified,"
    } ]
  }, {
    "tStartMs": 1656720,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "LeMessurier was praised"
    } ]
  }, {
    "tStartMs": 1658100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "for owning up to his mistake"
    } ]
  }, {
    "tStartMs": 1659120,
    "dDurationMs": 2925,
    "segs": [ {
      "utf8": "and fixing the issue as soon as possible."
    } ]
  }, {
    "tStartMs": 1662045,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "After the article, New\nYork updated the building code"
    } ]
  }, {
    "tStartMs": 1665840,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "to require quartering wind calculations."
    } ]
  }, {
    "tStartMs": 1667842,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "And since that\nfirst damper in Citicorp,"
    } ]
  }, {
    "tStartMs": 1669718,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "TMDs have spread across the globe."
    } ]
  }, {
    "tStartMs": 1672804,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "allowing architects to push\nskyscrapers taller and slimmer."
    } ]
  }, {
    "tStartMs": 1675432,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "It's in the first tall\nbuilding in the world"
    } ]
  }, {
    "tStartMs": 1678434,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "ever built with mechanical help\nto make the structure work."
    } ]
  }, {
    "tStartMs": 1682313,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "That's remarkable."
    } ]
  }, {
    "tStartMs": 1683522,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Incidentally, that has been now copied"
    } ]
  }, {
    "tStartMs": 1685190,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "a hundred times in Japan,\nthis is ubiquitous,"
    } ]
  }, {
    "tStartMs": 1688068,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "and when I go to Japan,\nI'm treated like a tin god"
    } ]
  }, {
    "tStartMs": 1690570,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "'cause I'm the father of\nthe tuned mass damper."
    } ]
  }, {
    "tStartMs": 1692530,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "I said, \"Really?\""
    } ]
  }, {
    "tStartMs": 1694010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Of the 20 tallest\nbuildings in the world,"
    } ]
  }, {
    "tStartMs": 1696590,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "six include the tuned mass damper,"
    } ]
  }, {
    "tStartMs": 1698060,
    "dDurationMs": 4562,
    "segs": [ {
      "utf8": " and they're especially critical in typhoon or earthquake-prone regions."
    } ]
  }, {
    "tStartMs": 1702622,
    "dDurationMs": 4618,
    "segs": [ {
      "utf8": "For example, Taipei 101 has\na massive 660 ton pendulum"
    } ]
  }, {
    "tStartMs": 1707240,
    "dDurationMs": 5099,
    "segs": [ {
      "utf8": "that stabilizes the building. It can withstand up to 200\nkilometer per hour winds"
    } ]
  }, {
    "tStartMs": 1712339,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and earthquakes with magnitudes over 6.8."
    } ]
  }, {
    "tStartMs": 1715926,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "But the legacy of this building"
    } ]
  }, {
    "tStartMs": 1717552,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "is still steeped in controversy."
    } ]
  }, {
    "tStartMs": 1719887,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "First, who was the mysterious\nstudent that started it all?"
    } ]
  }, {
    "tStartMs": 1723849,
    "dDurationMs": 7757,
    "segs": [ {
      "utf8": " I think it was spring of 1978. There's a student at Princeton,\nan undergraduate student"
    } ]
  }, {
    "tStartMs": 1731606,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "by the name of Diane Hartley, and she's studying structural engineering."
    } ]
  }, {
    "tStartMs": 1736402,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "It was time for her to\nconsider a senior thesis,"
    } ]
  }, {
    "tStartMs": 1739655,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "and then they decided that a study"
    } ]
  }, {
    "tStartMs": 1742407,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "of the new Citicorp\nTower would be wonderful."
    } ]
  }, {
    "tStartMs": 1745577,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "It's a remarkable thesis."
    } ]
  }, {
    "tStartMs": 1746744,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "It contains a lot of the\noriginal engineering calculations"
    } ]
  }, {
    "tStartMs": 1749455,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "by the engineers."
    } ]
  }, {
    "tStartMs": 1750831,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "She's looking through the documentation,"
    } ]
  }, {
    "tStartMs": 1754960,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "where did they consider quartering winds?"
    } ]
  }, {
    "tStartMs": 1757629,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "And she's not seeing it\n\"I must be wrong,\" she says."
    } ]
  }, {
    "tStartMs": 1759839,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "She's just an undergraduate student"
    } ]
  }, {
    "tStartMs": 1762759,
    "dDurationMs": 3836,
    "segs": [ {
      "utf8": "and you guys are award-winning\nstructural engineers."
    } ]
  }, {
    "tStartMs": 1766595,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "The engineer explains to Diane Hartley,"
    } ]
  }, {
    "tStartMs": 1769473,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "quartering winds are not\na factor in this building."
    } ]
  }, {
    "tStartMs": 1773560,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "So she's satisfied. She\ngraduates, that's it."
    } ]
  }, {
    "tStartMs": 1776896,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Doesn't think about it again."
    } ]
  }, {
    "tStartMs": 1779148,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "But a year after \"The\nNew Yorker\" article,"
    } ]
  }, {
    "tStartMs": 1781358,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "the BBC released a\ndocumentary on the crisis."
    } ]
  }, {
    "tStartMs": 1784152,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "And so she, she was holding her baby"
    } ]
  }, {
    "tStartMs": 1787030,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "and she turned on the\ntelevision, and lo and behold,"
    } ]
  }, {
    "tStartMs": 1791200,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "she heard them reference a\nconversation with a student,"
    } ]
  }, {
    "tStartMs": 1796455,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "an engineering student from New Jersey"
    } ]
  }, {
    "tStartMs": 1798582,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "reaching out to LeMessurier."
    } ]
  }, {
    "tStartMs": 1800250,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "And she said, \"I almost\ndropped my baby.\" "
    } ]
  }, {
    "tStartMs": 1803127,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "And then so she just assumed\nfor years afterwards,"
    } ]
  }, {
    "tStartMs": 1806047,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "she assumed that it wasn't me"
    } ]
  }, {
    "tStartMs": 1808507,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "because I didn't speak to LeMessurier."
    } ]
  }, {
    "tStartMs": 1810425,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "But then in 2003,\nher thesis advisor told Diane"
    } ]
  }, {
    "tStartMs": 1813970,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "that he checked all the\nother New Jersey engineering"
    } ]
  }, {
    "tStartMs": 1816306,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "and architecture programs, and no one else"
    } ]
  }, {
    "tStartMs": 1818683,
    "dDurationMs": 3544,
    "segs": [ {
      "utf8": "was working on a project\nabout Citicorp in 1978."
    } ]
  }, {
    "tStartMs": 1822227,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "She was the only one."
    } ]
  }, {
    "tStartMs": 1824354,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "She never spoke to\nLeMessurier personally."
    } ]
  }, {
    "tStartMs": 1826857,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "She never claimed to speak\nto LeMessurier personally."
    } ]
  }, {
    "tStartMs": 1829192,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "The assumption was that either\nLeMessurier was mistaken"
    } ]
  }, {
    "tStartMs": 1833404,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "and that it was Diane\nHartley who made the call,"
    } ]
  }, {
    "tStartMs": 1836323,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "it was a female, or more likely"
    } ]
  }, {
    "tStartMs": 1838825,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "that LeMessurier was basically tipped off"
    } ]
  }, {
    "tStartMs": 1842037,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "by his New York engineers."
    } ]
  }, {
    "tStartMs": 1844080,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Then, in 2011,"
    } ]
  }, {
    "tStartMs": 1845790,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "a man named Lee DeCarolis came forward."
    } ]
  }, {
    "tStartMs": 1848792,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "And the phone call, as we understand it,"
    } ]
  }, {
    "tStartMs": 1850586,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "came from a student"
    } ]
  }, {
    "tStartMs": 1851461,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "at the New Jersey Institute of Technology."
    } ]
  }, {
    "tStartMs": 1853463,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "His name is Lee DeCarolis."
    } ]
  }, {
    "tStartMs": 1855006,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "He's not asking for money,"
    } ]
  }, {
    "tStartMs": 1856508,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "he's not asking for fame or glory."
    } ]
  }, {
    "tStartMs": 1858801,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "He's just saying, \"This is interesting."
    } ]
  }, {
    "tStartMs": 1860761,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "And I'm the guy who made this call.\""
    } ]
  }, {
    "tStartMs": 1863222,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "And he said, \"Yeah,"
    } ]
  }, {
    "tStartMs": 1865057,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I had a conversation\nwith Bill LeMessurier.\""
    } ]
  }, {
    "tStartMs": 1866767,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "And he pretty much lined up"
    } ]
  }, {
    "tStartMs": 1867267,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "with what LeMessurier himself said."
    } ]
  }, {
    "tStartMs": 1869269,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "Sadly, LeMessurier\npassed away in 2007"
    } ]
  }, {
    "tStartMs": 1872647,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "before he could confirm\nthe student's identity."
    } ]
  }, {
    "tStartMs": 1876859,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Believe it or not, 40\nyears later, there's still,"
    } ]
  }, {
    "tStartMs": 1879486,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "I learned, a lot of raw\nfeeling still on this."
    } ]
  }, {
    "tStartMs": 1883239,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "People aren't anxious to talk about this,"
    } ]
  }, {
    "tStartMs": 1885908,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "especially people that\nwere involved in it,"
    } ]
  }, {
    "tStartMs": 1888244,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "even people that weren't involved in it"
    } ]
  }, {
    "tStartMs": 1889912,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "but were tangentially involved in it."
    } ]
  }, {
    "tStartMs": 1893290,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "We reached out to a\nLeMessurier Associates"
    } ]
  }, {
    "tStartMs": 1895750,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "and they refused to\nrespond to our request."
    } ]
  }, {
    "tStartMs": 1896960,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "You think that the namesake\nfor their company stood up"
    } ]
  }, {
    "tStartMs": 1901172,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "and did the right thing,"
    } ]
  }, {
    "tStartMs": 1902048,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "but I don't think they wanna\nbe associated with mistakes."
    } ]
  }, {
    "tStartMs": 1905676,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Their project\ndescription for Citicorp"
    } ]
  }, {
    "tStartMs": 1907594,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "doesn't even mention the repairs."
    } ]
  }, {
    "tStartMs": 1909304,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "The building was sold to\nBoston Properties in 2001,"
    } ]
  }, {
    "tStartMs": 1911931,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "who renamed it 601 Lexington."
    } ]
  }, {
    "tStartMs": 1915351,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "They also didn't respond\nto our request for comment"
    } ]
  }, {
    "tStartMs": 1917853,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "and refused to let us\nfilm inside the building."
    } ]
  }, {
    "tStartMs": 1920981,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Further questions arose\nin 2021, with a new study"
    } ]
  }, {
    "tStartMs": 1924693,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "from the National Institute\nof Standards and Technology."
    } ]
  }, {
    "tStartMs": 1927195,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "They wanted to see if quartering\nwinds were more demanding"
    } ]
  }, {
    "tStartMs": 1929405,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "for a building like Citicorp,"
    } ]
  }, {
    "tStartMs": 1931198,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Although they did conclude"
    } ]
  }, {
    "tStartMs": 1932408,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "that the pressure from\nperpendicular winds was greater,"
    } ]
  }, {
    "tStartMs": 1935118,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "their analysis didn't include\nany internal structure"
    } ]
  }, {
    "tStartMs": 1938121,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "specific to Citicorp."
    } ]
  }, {
    "tStartMs": 1939998,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "As for LeMessurier,\nthe engineering field"
    } ]
  }, {
    "tStartMs": 1941791,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "still regards his actions as upstanding."
    } ]
  }, {
    "tStartMs": 1943876,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "And the Citicorp case is\ntaught all over the world"
    } ]
  }, {
    "tStartMs": 1945920,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "as a case of good engineering ethics."
    } ]
  }, {
    "tStartMs": 1947880,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "In fact, in my own\nengineering ethics course,"
    } ]
  }, {
    "tStartMs": 1949589,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "I learned about the Citicorp building."
    } ]
  }, {
    "tStartMs": 1951341,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "And every structural\nengineer experiences this."
    } ]
  }, {
    "tStartMs": 1953885,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "When you actually feel the\nweight of the responsibility,"
    } ]
  }, {
    "tStartMs": 1957555,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "you're saying, \"Based on my engineering,"
    } ]
  }, {
    "tStartMs": 1959431,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "that building is gonna stand up.\""
    } ]
  }, {
    "tStartMs": 1960933,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Nobody else worries about it."
    } ]
  }, {
    "tStartMs": 1962267,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "And so if you think about\nthe emotional pressure"
    } ]
  }, {
    "tStartMs": 1964895,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "that Bill LeMessurier was under"
    } ]
  }, {
    "tStartMs": 1966396,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "and then needing to come back\nand do something about it"
    } ]
  }, {
    "tStartMs": 1968898,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "and to mobilize and to hold\nthat during this entire process,"
    } ]
  }, {
    "tStartMs": 1972735,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "it's truly a remarkable story."
    } ]
  }, {
    "tStartMs": 1975487,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "I mean, I can't imagine\nit. I can't imagine it."
    } ]
  }, {
    "tStartMs": 1979032,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "I said, look, if you got\na license from the state"
    } ]
  }, {
    "tStartMs": 1981868,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and a certification from university first,"
    } ]
  }, {
    "tStartMs": 1984537,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "then now you're gonna use that license"
    } ]
  }, {
    "tStartMs": 1986038,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "to hold yourself out as a professional,"
    } ]
  }, {
    "tStartMs": 1988082,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "you have a responsibility beyond yourself."
    } ]
  }, {
    "tStartMs": 1991293,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "If you see something\nthat is a social risk,"
    } ]
  }, {
    "tStartMs": 1994087,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "good heavens, this thing\nwould kill thousands,"
    } ]
  }, {
    "tStartMs": 1996756,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "you must do something,\nyou must do something."
    } ]
  } ]
}
