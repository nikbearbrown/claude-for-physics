{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- This is the largest\namount of spider silk"
    } ]
  }, {
    "tStartMs": 2760,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that's ever been put together\nfor a test like this."
    } ]
  }, {
    "tStartMs": 5070,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So I'm gonna put it to the ultimate test,"
    } ]
  }, {
    "tStartMs": 6720,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "and try to be the first\nperson ever to swing"
    } ]
  }, {
    "tStartMs": 9330,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "from spider silk."
    } ]
  }, {
    "tStartMs": 10290,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I don't know if it's going to\nhold my weight, so let's see."
    } ]
  }, {
    "tStartMs": 12420,
    "dDurationMs": 4313,
    "segs": [ {
      "utf8": "In three, two, one.\n(Derek yelling)"
    } ]
  }, {
    "tStartMs": 17760,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- In \"Spider-Man Two,\""
    } ]
  }, {
    "tStartMs": 18630,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Peter Parker is on a runaway\ntrain full of passengers."
    } ]
  }, {
    "tStartMs": 21180,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And to stop it from derailing,"
    } ]
  }, {
    "tStartMs": 22530,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "he stands in front of the train,"
    } ]
  }, {
    "tStartMs": 24060,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "fires webs at the buildings\naround him, and holds on."
    } ]
  }, {
    "tStartMs": 27270,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The webs stretch, some of them snap,"
    } ]
  }, {
    "tStartMs": 29490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "but they do just enough\nto slow down the train"
    } ]
  }, {
    "tStartMs": 31920,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and save everyone on board."
    } ]
  }, {
    "tStartMs": 33630,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It sounds like something\nstraight out of a comic book."
    } ]
  }, {
    "tStartMs": 36090,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "But real spider silk,"
    } ]
  }, {
    "tStartMs": 37500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "the fiber that makes up a spider's web,"
    } ]
  }, {
    "tStartMs": 39780,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "well, it truly might be this incredible."
    } ]
  }, {
    "tStartMs": 42330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "It's reportedly stronger than\nsteel. It's pretty strong."
    } ]
  }, {
    "tStartMs": 45060,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's crazy!"
    } ]
  }, {
    "tStartMs": 46560,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And 10 times tougher than Kevlar."
    } ]
  }, {
    "tStartMs": 49440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "To find out if that's really true,"
    } ]
  }, {
    "tStartMs": 50790,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I went to the Blackledge Spider Lab"
    } ]
  }, {
    "tStartMs": 52380,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "at the University of Akron,"
    } ]
  }, {
    "tStartMs": 53640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "one of the world's\nleading research centers"
    } ]
  }, {
    "tStartMs": 55440,
    "dDurationMs": 1437,
    "segs": [ {
      "utf8": "studying spider silk."
    } ]
  }, {
    "tStartMs": 56877,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "Before I went to the lab,"
    } ]
  }, {
    "tStartMs": 58260,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I'd always assume that\na spiderweb was made"
    } ]
  }, {
    "tStartMs": 60180,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "from just one kind of silk."
    } ]
  }, {
    "tStartMs": 61770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But that's actually not the case."
    } ]
  }, {
    "tStartMs": 63660,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "One type of silk anchors\nthe web to a surface."
    } ]
  }, {
    "tStartMs": 65880,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Another forms this stretchy spiral,"
    } ]
  }, {
    "tStartMs": 67860,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and a different sticky silk catches prey."
    } ]
  }, {
    "tStartMs": 70410,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Once something's trapped,"
    } ]
  }, {
    "tStartMs": 71340,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the spider switches to yet\nanother silk to wrap it up."
    } ]
  }, {
    "tStartMs": 74100,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- The threads are all\nthinner than your hair,"
    } ]
  }, {
    "tStartMs": 76560,
    "dDurationMs": 1907,
    "segs": [ {
      "utf8": "so they're going to look\npretty similar to each other"
    } ]
  }, {
    "tStartMs": 78467,
    "dDurationMs": 1813,
    "segs": [ {
      "utf8": "unless you use a microscope."
    } ]
  }, {
    "tStartMs": 80280,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Henry] All in all,"
    } ]
  }, {
    "tStartMs": 81113,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "there are seven different types of silk,"
    } ]
  }, {
    "tStartMs": 82650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "but the strongest is the dragline silk,"
    } ]
  }, {
    "tStartMs": 84840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which holds the web in its place."
    } ]
  }, {
    "tStartMs": 87120,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "- We've got the two main\nstructural threads in this web."
    } ]
  }, {
    "tStartMs": 90780,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So the spokes on the wagon wheel"
    } ]
  }, {
    "tStartMs": 93330,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and the outer framework here,\nthat's all the dragline silk."
    } ]
  }, {
    "tStartMs": 96270,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "It's called major ampullate\nsilk if you want the fancy word."
    } ]
  }, {
    "tStartMs": 99180,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- The major ampullate is that one"
    } ]
  }, {
    "tStartMs": 100650,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that commonly compared to steel?"
    } ]
  }, {
    "tStartMs": 104010,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Yes!\n- Okay."
    } ]
  }, {
    "tStartMs": 105180,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- Absolutely."
    } ]
  }, {
    "tStartMs": 106110,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And that's partly because it's\nfunction in a web like this."
    } ]
  }, {
    "tStartMs": 109200,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "A bug hits it, to stop that moving bug,"
    } ]
  }, {
    "tStartMs": 112920,
    "dDurationMs": 2723,
    "segs": [ {
      "utf8": "most of the work is done\nby the dragline silk."
    } ]
  }, {
    "tStartMs": 115643,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Henry] To do this,"
    } ]
  }, {
    "tStartMs": 116476,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "the dragline silk has\nto be incredibly strong."
    } ]
  }, {
    "tStartMs": 118860,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So to find out how it compares to steel,"
    } ]
  }, {
    "tStartMs": 120720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "we wanted to run a test,"
    } ]
  }, {
    "tStartMs": 122220,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "but it turns out that getting\nthe sample isn't so easy."
    } ]
  }, {
    "tStartMs": 125970,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "All right, we've taken\na garden variety spider"
    } ]
  }, {
    "tStartMs": 127860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and knocked it unconscious using CO2."
    } ]
  }, {
    "tStartMs": 130080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We brought it over here and\nwe put it down with tape."
    } ]
  }, {
    "tStartMs": 132810,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I then started pulling out\nthe dragline silk by hand."
    } ]
  }, {
    "tStartMs": 135840,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "It's so light that you can barely feel it."
    } ]
  }, {
    "tStartMs": 137706,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "We've attached it to this\nbig rotating mechanism"
    } ]
  }, {
    "tStartMs": 140250,
    "dDurationMs": 2154,
    "segs": [ {
      "utf8": "which they custom made to milk spiders."
    } ]
  }, {
    "tStartMs": 142404,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(bright music)"
    } ]
  }, {
    "tStartMs": 146820,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "No spiders were harmed in\nthe making of this video."
    } ]
  }, {
    "tStartMs": 149730,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Now that we've got our silk,"
    } ]
  }, {
    "tStartMs": 150690,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "we can put one strand into a machine"
    } ]
  }, {
    "tStartMs": 152430,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that slowly pulls on our sample."
    } ]
  }, {
    "tStartMs": 154470,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And as it pulls, we'll\nmonitor two key properties."
    } ]
  }, {
    "tStartMs": 157530,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "When you pull on the silk,"
    } ]
  }, {
    "tStartMs": 158610,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that force is spread over a\ntiny cross-sectional area."
    } ]
  }, {
    "tStartMs": 161550,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "If you divide the force by\nthat area, you get the stress."
    } ]
  }, {
    "tStartMs": 164790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now, as you pull, the\nsilk is also stretching."
    } ]
  }, {
    "tStartMs": 167340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "To see just how much, we\ndivide the change in length"
    } ]
  }, {
    "tStartMs": 169680,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "by the original length to get\na measure called the strain."
    } ]
  }, {
    "tStartMs": 173010,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "At first, as the stress increases,"
    } ]
  }, {
    "tStartMs": 174690,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "the strain increases\nroughly in proportion."
    } ]
  }, {
    "tStartMs": 177180,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And if we stop pulling here,"
    } ]
  }, {
    "tStartMs": 178500,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the silk would spring back\nto its original length."
    } ]
  }, {
    "tStartMs": 181170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "But keep pulling and\neventually it passes a point"
    } ]
  }, {
    "tStartMs": 183540,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "where some of that\nstretching becomes permanent."
    } ]
  }, {
    "tStartMs": 186690,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "And it's pulling."
    } ]
  }, {
    "tStartMs": 188940,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Videographer] All right."
    } ]
  }, {
    "tStartMs": 189773,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "You film that, I'm going\nto be filming this."
    } ]
  }, {
    "tStartMs": 191160,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- [Henry] And it broke.\n- [Videographer] Wow!"
    } ]
  }, {
    "tStartMs": 193920,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Henry] Eventually, if you\nkeep pulling on the silk,"
    } ]
  }, {
    "tStartMs": 195750,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "it will break."
    } ]
  }, {
    "tStartMs": 196830,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And at that point, the force applied,"
    } ]
  }, {
    "tStartMs": 198540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "divided by the cross-sectional area"
    } ]
  }, {
    "tStartMs": 200130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "is called its ultimate tensile strength."
    } ]
  }, {
    "tStartMs": 202380,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- We're at about 600 megapascals."
    } ]
  }, {
    "tStartMs": 205650,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Henry] To put that in perspective,"
    } ]
  }, {
    "tStartMs": 206700,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "if you had a rope of spider silk"
    } ]
  }, {
    "tStartMs": 208050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that had a cross-sectional\narea of one square centimeter,"
    } ]
  }, {
    "tStartMs": 210750,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "roughly the size of your little finger,"
    } ]
  }, {
    "tStartMs": 212550,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "it could support about\n60,000 newtons of force."
    } ]
  }, {
    "tStartMs": 215970,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "That's the weight of a fully\ngrown African elephant."
    } ]
  }, {
    "tStartMs": 218730,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And that's not even the\nstrongest spider silk out there."
    } ]
  }, {
    "tStartMs": 220980,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "- Breaking stress wasn't\nincredible for this piece of silk."
    } ]
  }, {
    "tStartMs": 225150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Henry] Deep in the\njungles of Madagascar"
    } ]
  }, {
    "tStartMs": 226710,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "lives the Darwin's bark spider."
    } ]
  }, {
    "tStartMs": 228390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Its diet consists of flying insects"
    } ]
  }, {
    "tStartMs": 230250,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that zip over wide rivers."
    } ]
  }, {
    "tStartMs": 231810,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So to catch its prey,\nthe Darwin's bark spider"
    } ]
  }, {
    "tStartMs": 234150,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "has to spin giant webs that\nstretch up to 25 meters"
    } ]
  }, {
    "tStartMs": 237450,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "over open water."
    } ]
  }, {
    "tStartMs": 239070,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And to survive that kind\nof distance and tension,"
    } ]
  }, {
    "tStartMs": 241110,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "its silk has to be incredibly strong."
    } ]
  }, {
    "tStartMs": 243060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "It has an ultimate tensile strength"
    } ]
  }, {
    "tStartMs": 244590,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "of around 1,600 megapascals."
    } ]
  }, {
    "tStartMs": 247020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "That's more than twice the\nstrength of our sample."
    } ]
  }, {
    "tStartMs": 249300,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But experimental ultra\nhigh strength steels"
    } ]
  }, {
    "tStartMs": 251730,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "can reach an ultimate tensile strength"
    } ]
  }, {
    "tStartMs": 253290,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "of nearly 3,000 megapascals."
    } ]
  }, {
    "tStartMs": 255720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That's about three times that\nof typical dragline silk,"
    } ]
  }, {
    "tStartMs": 258360,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "but steel is also about six times denser."
    } ]
  }, {
    "tStartMs": 261120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So for two ropes with\nthe same mass and length,"
    } ]
  }, {
    "tStartMs": 263820,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the silk rope has six times\nthe cross-sectional area."
    } ]
  }, {
    "tStartMs": 266430,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Six times the area at\none third the strength,"
    } ]
  }, {
    "tStartMs": 268710,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "well, that gives a rope that\ncan take twice the force"
    } ]
  }, {
    "tStartMs": 270870,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "before it snaps."
    } ]
  }, {
    "tStartMs": 271980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "This measure of strength relative to mass"
    } ]
  }, {
    "tStartMs": 273780,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "is called specific strength."
    } ]
  }, {
    "tStartMs": 275370,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And it means that for\nthe same mass and length,"
    } ]
  }, {
    "tStartMs": 277470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "spiderwebs can withstand\nroughly twice the force"
    } ]
  }, {
    "tStartMs": 279900,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "of ultra high strength\nsteel before breaking."
    } ]
  }, {
    "tStartMs": 282270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- So that's where ounce for ounce,"
    } ]
  }, {
    "tStartMs": 284790,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "spider silk is quite strong."
    } ]
  }, {
    "tStartMs": 286980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "You got to think about\nwhat is the application"
    } ]
  }, {
    "tStartMs": 289080,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "you're talking about\nusing this material in."
    } ]
  }, {
    "tStartMs": 291030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Is it somewhere where you\ndon't care about weight,"
    } ]
  }, {
    "tStartMs": 293070,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "and you need the strength?"
    } ]
  }, {
    "tStartMs": 294030,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Then steel's going to be perfectly fine."
    } ]
  }, {
    "tStartMs": 295950,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "But if weight matters,"
    } ]
  }, {
    "tStartMs": 297240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "spider silk is really the champion there"
    } ]
  }, {
    "tStartMs": 299400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for tensile strength."
    } ]
  }, {
    "tStartMs": 301560,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Henry] But strength alone isn't enough."
    } ]
  }, {
    "tStartMs": 303390,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "To see why, look at rock climbers."
    } ]
  }, {
    "tStartMs": 305580,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "If a rock climber was just\nhanging, all we would care about"
    } ]
  }, {
    "tStartMs": 308070,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "was if the rope could\nsupport their weight."
    } ]
  }, {
    "tStartMs": 309900,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "That's strength. But climbers\ndon't just hang, they fall."
    } ]
  }, {
    "tStartMs": 314160,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And now the rope has to\nbring them to a stop,"
    } ]
  }, {
    "tStartMs": 316230,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "which means absorbing that kinetic energy."
    } ]
  }, {
    "tStartMs": 318450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Stop the fall in a short distance,"
    } ]
  }, {
    "tStartMs": 319980,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and the energy has to be absorbed quickly."
    } ]
  }, {
    "tStartMs": 322050,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The forces are enormous."
    } ]
  }, {
    "tStartMs": 323910,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Stretch it out and that same\nenergy is absorbed gradually,"
    } ]
  }, {
    "tStartMs": 326760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "so the forces are lower."
    } ]
  }, {
    "tStartMs": 328200,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So to absorb more energy without snapping,"
    } ]
  }, {
    "tStartMs": 330510,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "it has to stretch further."
    } ]
  }, {
    "tStartMs": 332310,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And that's actually not so\ndifferent from spider silk."
    } ]
  }, {
    "tStartMs": 334800,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "- So a bug hits this web,\nyou've got to stop the flight"
    } ]
  }, {
    "tStartMs": 339030,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "of that bug pretty quickly."
    } ]
  }, {
    "tStartMs": 340560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And you could do it by just building"
    } ]
  }, {
    "tStartMs": 342120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "a really stiff structure."
    } ]
  }, {
    "tStartMs": 343890,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Think like a brick wall, you\nthrow a tennis ball against it."
    } ]
  }, {
    "tStartMs": 346560,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "You're gonna stop that ball instantly."
    } ]
  }, {
    "tStartMs": 348750,
    "dDurationMs": 2677,
    "segs": [ {
      "utf8": "But that doesn't work very well\nif you want to catch a meal."
    } ]
  }, {
    "tStartMs": 351427,
    "dDurationMs": 1643,
    "segs": [ {
      "utf8": "- It'll bounce off.\n- Because it'll just fall out."
    } ]
  }, {
    "tStartMs": 353070,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And so it helps to slowly\ndecelerate the insect"
    } ]
  }, {
    "tStartMs": 356640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so that the web has time to stick to it,"
    } ]
  }, {
    "tStartMs": 359160,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and keep the meal for\nthe spider to subdue."
    } ]
  }, {
    "tStartMs": 362430,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- [Henry] So the spider silk\nhas to be quite stretchy."
    } ]
  }, {
    "tStartMs": 364920,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "- This piece of silk\nstretched to 70% of its length"
    } ]
  }, {
    "tStartMs": 369510,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "before it broke,"
    } ]
  }, {
    "tStartMs": 370380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which is really exceptional\nfor dragline silk."
    } ]
  }, {
    "tStartMs": 372960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- [Henry] Now, every\ntiny bit of stretching"
    } ]
  }, {
    "tStartMs": 374550,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "absorbs a little bit of energy."
    } ]
  }, {
    "tStartMs": 376110,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "If you add all these\ntiny amounts together,"
    } ]
  }, {
    "tStartMs": 378000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the result is the total\nenergy the material absorbs"
    } ]
  }, {
    "tStartMs": 380580,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "before breaking."
    } ]
  }, {
    "tStartMs": 381540,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "On a stress/strain graph,"
    } ]
  }, {
    "tStartMs": 382770,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "it's proportional to the\narea under the curve."
    } ]
  }, {
    "tStartMs": 385140,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "This is the material's toughness."
    } ]
  }, {
    "tStartMs": 387360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Kevlar, the material used\nin bulletproof vests,"
    } ]
  }, {
    "tStartMs": 389730,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "whose whole job is to take\nthe energy of a bullet"
    } ]
  }, {
    "tStartMs": 391860,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and spread it out before\nit reaches the body, well,"
    } ]
  }, {
    "tStartMs": 394290,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "it has a toughness of up to\n50 megajoules per cubic meter."
    } ]
  }, {
    "tStartMs": 397560,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Experimental ultra-high strength steel"
    } ]
  }, {
    "tStartMs": 399420,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "has a toughness of around 170\nmegajoules per cubic meter."
    } ]
  }, {
    "tStartMs": 402960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But spider silk?"
    } ]
  }, {
    "tStartMs": 404760,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- This piece of silk had a toughness"
    } ]
  }, {
    "tStartMs": 407280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "of about 205 megajoules per cubic meter."
    } ]
  }, {
    "tStartMs": 410970,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- Oh, okay. So that might\nbe like four times Kevlar."
    } ]
  }, {
    "tStartMs": 413580,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "But the silk from the Darwin's bark spider"
    } ]
  }, {
    "tStartMs": 415530,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "can have a peak toughness of\n520 megajoules per cubic meter."
    } ]
  }, {
    "tStartMs": 419310,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "That's roughly three times\nthe strongest steel out there,"
    } ]
  }, {
    "tStartMs": 421680,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "and 10 times as tough as Kevlar."
    } ]
  }, {
    "tStartMs": 423630,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "See, Kevlar has a very\nhigh tensile strength,"
    } ]
  }, {
    "tStartMs": 425940,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but it's also quite stiff."
    } ]
  }, {
    "tStartMs": 427620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Compared with stretchy spider silk,"
    } ]
  }, {
    "tStartMs": 429450,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that means that the\nstress/strain graph rises sharply"
    } ]
  }, {
    "tStartMs": 431910,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and fails before it can stretch very far."
    } ]
  }, {
    "tStartMs": 434430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So it's not able to absorb as much energy."
    } ]
  }, {
    "tStartMs": 436740,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And that's why spider\nsilk wins on toughness."
    } ]
  }, {
    "tStartMs": 439140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- But it's the ultimate\nin green chemistry."
    } ]
  }, {
    "tStartMs": 441300,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "They're not using the high temperature,"
    } ]
  }, {
    "tStartMs": 443430,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "or the caustic solvents that\nmost of the polymer industry"
    } ]
  }, {
    "tStartMs": 447510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "uses to make high performance threads."
    } ]
  }, {
    "tStartMs": 450060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "They're doing it at room\ntemperature, inside a living body,"
    } ]
  }, {
    "tStartMs": 453540,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "with the same basic building blocks"
    } ]
  }, {
    "tStartMs": 455130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that you use to build\nyour hair and your skin."
    } ]
  }, {
    "tStartMs": 457890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- Now, the secret to spider silk's"
    } ]
  }, {
    "tStartMs": 459300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "unbelievable natural strength"
    } ]
  }, {
    "tStartMs": 460890,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "lies in how those building\nblocks are arranged."
    } ]
  }, {
    "tStartMs": 463620,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "If you look inside a silk fiber,"
    } ]
  }, {
    "tStartMs": 465090,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "you'll find spider silk\nproteins called spidroins."
    } ]
  }, {
    "tStartMs": 468240,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "In some regions,"
    } ]
  }, {
    "tStartMs": 469080,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "the spidroins are arranged\nin similar size and shape,"
    } ]
  }, {
    "tStartMs": 472170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and they're closely\naligned along its length."
    } ]
  }, {
    "tStartMs": 474150,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They're kind of like stacked egg trays."
    } ]
  }, {
    "tStartMs": 476190,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "These are nanocrystals."
    } ]
  }, {
    "tStartMs": 478020,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "In other areas, the\nspidroins aren't so uniform."
    } ]
  }, {
    "tStartMs": 480510,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Here they're less ordered,"
    } ]
  }, {
    "tStartMs": 481620,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and they can move and\nchange shape more freely."
    } ]
  }, {
    "tStartMs": 484110,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "These are called the amorphous regions."
    } ]
  }, {
    "tStartMs": 486240,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Together, they work like a\nnetwork of tiny rigid blocks"
    } ]
  }, {
    "tStartMs": 489180,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "connected by elastic cords,\nwhich I have in front of me."
    } ]
  }, {
    "tStartMs": 492090,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "When I pull on the network,"
    } ]
  }, {
    "tStartMs": 493170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the cords stretch, and they absorb energy."
    } ]
  }, {
    "tStartMs": 495540,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "The blocks don't stretch much,"
    } ]
  }, {
    "tStartMs": 496860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "but each one connects to several cords,"
    } ]
  }, {
    "tStartMs": 498990,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which spreads the pull across the network."
    } ]
  }, {
    "tStartMs": 501330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So the amorphous regions\nlet the silk stretch"
    } ]
  }, {
    "tStartMs": 503730,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "while the nanocrystals help it\nwithstand a much larger pull."
    } ]
  }, {
    "tStartMs": 506910,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Together, they allow the silk to absorb"
    } ]
  }, {
    "tStartMs": 508530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "a tremendous amount of\nenergy before breaking,"
    } ]
  }, {
    "tStartMs": 510600,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "which makes it so tough."
    } ]
  }, {
    "tStartMs": 512010,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The result is a material\nthat's stronger than steel"
    } ]
  }, {
    "tStartMs": 514230,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "by weight and also tougher than Kevlar."
    } ]
  }, {
    "tStartMs": 517020,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It sounds perfect for\nmaking climbing ropes,"
    } ]
  }, {
    "tStartMs": 519180,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "parachute cords, airbags,\neven bulletproof vests."
    } ]
  }, {
    "tStartMs": 522450,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "But we actually aren't using\nspider silk for any of that,"
    } ]
  }, {
    "tStartMs": 525030,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "even though we've been\ntrying to for centuries."
    } ]
  }, {
    "tStartMs": 527640,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "In 1709, a Frenchman\nnamed Francois Xavier Bon"
    } ]
  }, {
    "tStartMs": 530700,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "painstakingly collected\nhundreds of spider egg sacs,"
    } ]
  }, {
    "tStartMs": 533880,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "boiled them, combed them like\nwool, spun them into thread,"
    } ]
  }, {
    "tStartMs": 537210,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and then used them to make stockings"
    } ]
  }, {
    "tStartMs": 538770,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that attracted the attention\nat the royal court."
    } ]
  }, {
    "tStartMs": 541470,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But this was harder than it sounds."
    } ]
  }, {
    "tStartMs": 543300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "As he later said,"
    } ]
  }, {
    "tStartMs": 544133,
    "dDurationMs": 2317,
    "segs": [ {
      "utf8": "\"The only difficulty now lies in procuring"
    } ]
  }, {
    "tStartMs": 546450,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "a sufficient quantity of spider bags"
    } ]
  }, {
    "tStartMs": 548130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "to make any considerable work of it.\""
    } ]
  }, {
    "tStartMs": 550380,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Three centuries later, Simon\nPeers and Nicholas Godley"
    } ]
  }, {
    "tStartMs": 553440,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "led a years long project in Madagascar,"
    } ]
  }, {
    "tStartMs": 555660,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "in which teams of\nMalagasy workers gathered"
    } ]
  }, {
    "tStartMs": 557880,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "more than a million\ngolden orb weaver spiders"
    } ]
  }, {
    "tStartMs": 560190,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "in the jungle by hand."
    } ]
  }, {
    "tStartMs": 561780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "They extracted their silk\nand painstakingly wove"
    } ]
  }, {
    "tStartMs": 564360,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and embroidered it into\na single golden cape."
    } ]
  }, {
    "tStartMs": 567270,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Why hadn't they tried\nfarming the spiders instead?"
    } ]
  }, {
    "tStartMs": 569910,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Well, attempts to do that all\nrun into the same problem."
    } ]
  }, {
    "tStartMs": 572580,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Spiders are cannibals."
    } ]
  }, {
    "tStartMs": 574920,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "The big problem with spiders\nis that they eat each other?"
    } ]
  }, {
    "tStartMs": 578130,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- That's one of the big problems."
    } ]
  }, {
    "tStartMs": 579480,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And then you can't just keep them"
    } ]
  }, {
    "tStartMs": 580830,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "in a tiny little container."
    } ]
  }, {
    "tStartMs": 582180,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "You're going to have to\nhave a lot of real estate"
    } ]
  }, {
    "tStartMs": 583590,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "if you're going to have a farm\nwith 10,000 spiders on it."
    } ]
  }, {
    "tStartMs": 586950,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Henry] Even if you could get your hands"
    } ]
  }, {
    "tStartMs": 588120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "on that many spiders, as we've seen,"
    } ]
  }, {
    "tStartMs": 589890,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "milking them is difficult,"
    } ]
  }, {
    "tStartMs": 591150,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and the spiders don't always cooperate."
    } ]
  }, {
    "tStartMs": 593220,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "- Really cooperative spider\nwill give you 300 yards of silk."
    } ]
  }, {
    "tStartMs": 597680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "100's a lot more typical,"
    } ]
  }, {
    "tStartMs": 600000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but they kind of have their\nown individual personalities."
    } ]
  }, {
    "tStartMs": 602070,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Some of them will just\nbreak the thread right away,"
    } ]
  }, {
    "tStartMs": 604350,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and not even cooperate with you."
    } ]
  }, {
    "tStartMs": 606180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "- That's why natural\nspider silk is so scarce."
    } ]
  }, {
    "tStartMs": 608340,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "One supplier charges\n$700 for 100 milligrams,"
    } ]
  }, {
    "tStartMs": 611610,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "which works out to roughly\n$7 million per kilogram."
    } ]
  }, {
    "tStartMs": 614940,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "That's roughly 50 times the price of gold."
    } ]
  }, {
    "tStartMs": 617400,
    "dDurationMs": 2217,
    "segs": [ {
      "utf8": "Okay, so we can't farm\nspiders for their silk,"
    } ]
  }, {
    "tStartMs": 619617,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "but we know what the proteins are,"
    } ]
  }, {
    "tStartMs": 621330,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so surely we can just make them?"
    } ]
  }, {
    "tStartMs": 623130,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Well, scientists have tried."
    } ]
  }, {
    "tStartMs": 624720,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "By the late 1990s, researchers\nat DuPont took the genes"
    } ]
  }, {
    "tStartMs": 627750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that code for spider silk proteins"
    } ]
  }, {
    "tStartMs": 629340,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and put them into E. coli and yeast."
    } ]
  }, {
    "tStartMs": 631830,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "These living cells are\nlike protein factories."
    } ]
  }, {
    "tStartMs": 634290,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "One engineered cell\nquickly becomes millions."
    } ]
  }, {
    "tStartMs": 637140,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It worked,"
    } ]
  }, {
    "tStartMs": 637973,
    "dDurationMs": 2797,
    "segs": [ {
      "utf8": "but scientists wanted an\neven more efficient method."
    } ]
  }, {
    "tStartMs": 640770,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So in 2001,"
    } ]
  }, {
    "tStartMs": 641970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "a team in Germany tried\nimplanting spider silk genes"
    } ]
  }, {
    "tStartMs": 644610,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "into plants like tobacco and potatoes."
    } ]
  }, {
    "tStartMs": 646920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But if you really want to\nproduce a lot of protein"
    } ]
  }, {
    "tStartMs": 649110,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in a concentrated form, look at milk."
    } ]
  }, {
    "tStartMs": 651990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "To feed their young,"
    } ]
  }, {
    "tStartMs": 652823,
    "dDurationMs": 2947,
    "segs": [ {
      "utf8": "mothers produce milk with high\nconcentrations of proteins."
    } ]
  }, {
    "tStartMs": 655770,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "So around the same time,"
    } ]
  }, {
    "tStartMs": 657030,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "a Canadian company called Nexia"
    } ]
  }, {
    "tStartMs": 658680,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "tried something much stranger."
    } ]
  }, {
    "tStartMs": 660210,
    "dDurationMs": 2177,
    "segs": [ {
      "utf8": "They put spider silk genes into goats,"
    } ]
  }, {
    "tStartMs": 662387,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "creating genetically\nmodified spider goats."
    } ]
  }, {
    "tStartMs": 665730,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "No, no, really, they made spider goats."
    } ]
  }, {
    "tStartMs": 667530,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "These goats produce milk\nchock-full of spider silk proteins."
    } ]
  }, {
    "tStartMs": 671520,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "In one sense, it worked."
    } ]
  }, {
    "tStartMs": 672600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "All the experiments were able"
    } ]
  }, {
    "tStartMs": 673800,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to produce spider silk proteins,"
    } ]
  }, {
    "tStartMs": 675510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but they ran into the same problem."
    } ]
  }, {
    "tStartMs": 677730,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "From E. coli or yeast,"
    } ]
  }, {
    "tStartMs": 679140,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "these proteins were purified\nas a fine white powder."
    } ]
  }, {
    "tStartMs": 681720,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "From plants, the purified\nproteins formed a viscous,"
    } ]
  }, {
    "tStartMs": 684510,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "gelatin-like liquid."
    } ]
  }, {
    "tStartMs": 686070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And from goats, it was\ndissolved in the milk."
    } ]
  }, {
    "tStartMs": 688440,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "None of these even vaguely\nresemble spider silk."
    } ]
  }, {
    "tStartMs": 691200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "- And that's one of the\nsecrets that any company"
    } ]
  }, {
    "tStartMs": 694440,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "that really wants to mimic spider silk"
    } ]
  }, {
    "tStartMs": 696720,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at an industrial scale\nneeds to kind of figure out"
    } ]
  }, {
    "tStartMs": 699690,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "is how to process silk\nproteins the way spiders do."
    } ]
  }, {
    "tStartMs": 704370,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "- But that's easier said than done."
    } ]
  }, {
    "tStartMs": 706340,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "In a spider, it all\nstarts in the silk gland"
    } ]
  }, {
    "tStartMs": 709200,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "in a region called tail."
    } ]
  }, {
    "tStartMs": 710910,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Cells here make proteins called spidroins,"
    } ]
  }, {
    "tStartMs": 713280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and they secrete them into\nthe fluid inside the gland."
    } ]
  }, {
    "tStartMs": 716160,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Every spidroin has three main parts."
    } ]
  }, {
    "tStartMs": 718380,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "One end is called the N-terminal,"
    } ]
  }, {
    "tStartMs": 719940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and the other the C-terminal."
    } ]
  }, {
    "tStartMs": 721530,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "And between them is a\nlong repeating sequence"
    } ]
  }, {
    "tStartMs": 723660,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "of amino acids."
    } ]
  }, {
    "tStartMs": 725010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "This is called the repetitive region."
    } ]
  }, {
    "tStartMs": 726930,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Once inside the tail, the\nC-terminal ends pair up,"
    } ]
  }, {
    "tStartMs": 729420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "which links neighboring\nspidroins together."
    } ]
  }, {
    "tStartMs": 731820,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But the N-terminal ends\nstay mostly separate."
    } ]
  }, {
    "tStartMs": 734250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So the spidroins are still\nloose enough to bend,"
    } ]
  }, {
    "tStartMs": 736620,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "coil, and move around."
    } ]
  }, {
    "tStartMs": 738390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Next, they move into the storage sac,"
    } ]
  }, {
    "tStartMs": 740610,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "where they're packed together\nat high concentrations."
    } ]
  }, {
    "tStartMs": 743310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Normally, proteins this concentrated"
    } ]
  }, {
    "tStartMs": 744990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "would stick to each other,\nand clump into a solid,"
    } ]
  }, {
    "tStartMs": 747390,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "but this can be modified with\na careful balance of salts"
    } ]
  }, {
    "tStartMs": 750300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and by changing the pH."
    } ]
  }, {
    "tStartMs": 751920,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The pH is a measure of the concentration"
    } ]
  }, {
    "tStartMs": 753930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "of hydronium ions in a solution."
    } ]
  }, {
    "tStartMs": 755880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And because hydrogen ions\nare little positive charges,"
    } ]
  }, {
    "tStartMs": 758760,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "you can think of the pH like a dial"
    } ]
  }, {
    "tStartMs": 760500,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that controls the electrical charge"
    } ]
  }, {
    "tStartMs": 761970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "on different parts of the protein."
    } ]
  }, {
    "tStartMs": 763770,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "In the storage sac, the pH is tuned"
    } ]
  }, {
    "tStartMs": 765600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "so that the N-terminal ends\ncarry a net negative charge."
    } ]
  }, {
    "tStartMs": 768480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Every protein carries the same charge."
    } ]
  }, {
    "tStartMs": 770280,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And since like charges repel,\nwhen you crowd them together,"
    } ]
  }, {
    "tStartMs": 773010,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "they shove apart instead\nof sticking together."
    } ]
  }, {
    "tStartMs": 775320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Now, the spidroins are still crowded"
    } ]
  }, {
    "tStartMs": 776880,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "in this aqueous solution, and\nat such high concentrations,"
    } ]
  }, {
    "tStartMs": 779550,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "they begin to gradually rearrange."
    } ]
  }, {
    "tStartMs": 781500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The N-terminals are attracted to water."
    } ]
  }, {
    "tStartMs": 783360,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "These are hydrophilic."
    } ]
  }, {
    "tStartMs": 784680,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "While the repetitive\nregion is repelled by it,"
    } ]
  }, {
    "tStartMs": 786690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "this is hydrophobic."
    } ]
  }, {
    "tStartMs": 788340,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So the spidroins rearrange,"
    } ]
  }, {
    "tStartMs": 790080,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and you end up having\nthese hydrophilic parts"
    } ]
  }, {
    "tStartMs": 791850,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "facing outward towards the water."
    } ]
  }, {
    "tStartMs": 793590,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And hydrophobic parts tuck\nthemselves inside away from it."
    } ]
  }, {
    "tStartMs": 796860,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "They then form these tiny\nstructures called micelles."
    } ]
  }, {
    "tStartMs": 799830,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And the micelles cluster\ntogether into larger globules."
    } ]
  }, {
    "tStartMs": 803130,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "These globules next\nenter the spinning duct."
    } ]
  }, {
    "tStartMs": 806520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "- For the dragline silk, the\nduct is kind of S-shaped,"
    } ]
  }, {
    "tStartMs": 810600,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "but it gets skinnier and skinnier."
    } ]
  }, {
    "tStartMs": 813180,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- [Henry] As the globules\ngo through the narrow duct,"
    } ]
  }, {
    "tStartMs": 815010,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the liquid near the walls\nrubs against the surface,"
    } ]
  }, {
    "tStartMs": 817620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and it moves more slowly,"
    } ]
  }, {
    "tStartMs": 818820,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "while the liquid in the\nmiddle moves faster."
    } ]
  }, {
    "tStartMs": 821190,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So the layers slide past each other,"
    } ]
  }, {
    "tStartMs": 822930,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which is known as shear."
    } ]
  }, {
    "tStartMs": 824460,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "These shear forces stretch\nand deform the globule."
    } ]
  }, {
    "tStartMs": 827730,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "- You also remove some\nwater, so water goes out."
    } ]
  }, {
    "tStartMs": 831630,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "You get a drop in pH, so it\nbecomes a little bit more acidic"
    } ]
  }, {
    "tStartMs": 836981,
    "dDurationMs": 2079,
    "segs": [ {
      "utf8": "as you go down this duct."
    } ]
  }, {
    "tStartMs": 839060,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "- So the proteins are then being changed"
    } ]
  }, {
    "tStartMs": 840720,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "in two ways at once."
    } ]
  }, {
    "tStartMs": 841800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Mechanically, they're\nbeing pulled and aligned."
    } ]
  }, {
    "tStartMs": 844050,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "And chemically, that drop in pH"
    } ]
  }, {
    "tStartMs": 845700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "means that there are now\nmore positive hydronium ions"
    } ]
  }, {
    "tStartMs": 848160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in the solution."
    } ]
  }, {
    "tStartMs": 849660,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "These bind to the negative\nparts of the proteins,"
    } ]
  }, {
    "tStartMs": 851790,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "neutralizing them."
    } ]
  }, {
    "tStartMs": 853170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Now all the proteins don't\nrepel each other as strongly,"
    } ]
  }, {
    "tStartMs": 855900,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and so the N-terminal ends begin pairing,"
    } ]
  }, {
    "tStartMs": 858090,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "linking the proteins into long chains."
    } ]
  }, {
    "tStartMs": 860490,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "These chains are pulled\nthrough a tiny narrowing"
    } ]
  }, {
    "tStartMs": 862410,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "called the drawdown taper,\nwhich leads to the spigot."
    } ]
  }, {
    "tStartMs": 865200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Here, the spider pulls the\nliquid through a small opening."
    } ]
  }, {
    "tStartMs": 867900,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "This forces the liquid to speed up."
    } ]
  }, {
    "tStartMs": 869730,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And as it speeds up, it stretches."
    } ]
  }, {
    "tStartMs": 871800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "It's this final stretch that\npulls neighboring spidroins"
    } ]
  }, {
    "tStartMs": 874290,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "tightly alongside one another."
    } ]
  }, {
    "tStartMs": 876120,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, depending on the\nsequence of amino acids,"
    } ]
  }, {
    "tStartMs": 878250,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "some sections fold into zigzag strands."
    } ]
  }, {
    "tStartMs": 881010,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "These strands then interlock"
    } ]
  }, {
    "tStartMs": 882360,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and rows of hydrogen bonds\nstitch them into rigid,"
    } ]
  }, {
    "tStartMs": 884910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "sheet-like structures,"
    } ]
  }, {
    "tStartMs": 886230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "which stack together into the nanocrystals"
    } ]
  }, {
    "tStartMs": 888210,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that give the spider silk its strength."
    } ]
  }, {
    "tStartMs": 890400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "In other sections, the\nspidroins don't fold as neatly."
    } ]
  }, {
    "tStartMs": 893310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "That's how you get the amorphous regions"
    } ]
  }, {
    "tStartMs": 894870,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which give the silk its stretch."
    } ]
  }, {
    "tStartMs": 896880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Exactly how the proteins assemble"
    } ]
  }, {
    "tStartMs": 898500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "inside the spinning duct\nis still being studied."
    } ]
  }, {
    "tStartMs": 900630,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "No one fully understands it yet,"
    } ]
  }, {
    "tStartMs": 902340,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and that makes recreating the process"
    } ]
  }, {
    "tStartMs": 903960,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "in a lab quite difficult."
    } ]
  }, {
    "tStartMs": 905280,
    "dDurationMs": 1057,
    "segs": [ {
      "utf8": "So scientists wondered,"
    } ]
  }, {
    "tStartMs": 906337,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "\"What if instead of starting from scratch,"
    } ]
  }, {
    "tStartMs": 908310,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "you used an animal that\nalready has a spinner?\""
    } ]
  }, {
    "tStartMs": 911340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "This is exactly what researchers"
    } ]
  }, {
    "tStartMs": 912870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "at Kraig BioCraft Laboratories,"
    } ]
  }, {
    "tStartMs": 914460,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "a biotech company in Michigan,\nhave been working on."
    } ]
  }, {
    "tStartMs": 917190,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "What's more, they're\ndoing it with an insect"
    } ]
  }, {
    "tStartMs": 918930,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "that humans have been farming\nfor nearly 5,000 years."
    } ]
  }, {
    "tStartMs": 923220,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "According to legend,"
    } ]
  }, {
    "tStartMs": 924240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "a Chinese empress was\nrelaxing in her garden,"
    } ]
  }, {
    "tStartMs": 926760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "when something fell into her teacup."
    } ]
  }, {
    "tStartMs": 928920,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "She looked inside, and saw a cocoon."
    } ]
  }, {
    "tStartMs": 931500,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The hot water loosened it."
    } ]
  }, {
    "tStartMs": 932760,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "And when she lifted it out,"
    } ]
  }, {
    "tStartMs": 934020,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "it unraveled into a\nsingle shimmering thread."
    } ]
  }, {
    "tStartMs": 936810,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So long that it stretched\nacross her entire garden."
    } ]
  }, {
    "tStartMs": 939870,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "This was silk."
    } ]
  }, {
    "tStartMs": 941580,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Whether or not that story's true,"
    } ]
  }, {
    "tStartMs": 942870,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "people eventually learned\nto farm the insect"
    } ]
  }, {
    "tStartMs": 944910,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "that made the thread."
    } ]
  }, {
    "tStartMs": 946202,
    "dDurationMs": 1678,
    "segs": [ {
      "utf8": "(jaunty music)\nSilkworms."
    } ]
  }, {
    "tStartMs": 947880,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "They're the caterpillars of\nthe domesticated silk moth."
    } ]
  }, {
    "tStartMs": 950580,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Silk quickly became one of\nthe most valuable materials"
    } ]
  }, {
    "tStartMs": 953010,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in the land."
    } ]
  }, {
    "tStartMs": 953843,
    "dDurationMs": 1747,
    "segs": [ {
      "utf8": "It dressed emperors and spurred trade"
    } ]
  }, {
    "tStartMs": 955590,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "connecting East Asia and Europe."
    } ]
  }, {
    "tStartMs": 957300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So much so that it gave\nthe trade route its name,"
    } ]
  }, {
    "tStartMs": 959700,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the Silk Road."
    } ]
  }, {
    "tStartMs": 961380,
    "dDurationMs": 3015,
    "segs": [ {
      "utf8": "For nearly 2,000 years,\nChina guarded the secret."
    } ]
  }, {
    "tStartMs": 964395,
    "dDurationMs": 2838,
    "segs": [ {
      "utf8": "But of course, people were\nalways trying to steal it."
    } ]
  }, {
    "tStartMs": 968730,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "By the mid-sixth century,"
    } ]
  }, {
    "tStartMs": 969900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the Byzantine Empire was in trouble."
    } ]
  }, {
    "tStartMs": 972060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Plague had devastated the population."
    } ]
  }, {
    "tStartMs": 973860,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "And on top of that,"
    } ]
  }, {
    "tStartMs": 974700,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the purchase of silk\nwas draining its gold."
    } ]
  }, {
    "tStartMs": 977370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "The problem was that\nByzantines couldn't make silk."
    } ]
  }, {
    "tStartMs": 979860,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Most of it had to come through Persia,"
    } ]
  }, {
    "tStartMs": 981510,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "the very empire it was fighting."
    } ]
  }, {
    "tStartMs": 983820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So Emperor Justinian made a\nsecret deal with two monks."
    } ]
  }, {
    "tStartMs": 987180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "They would travel east,\nfind the source of silk,"
    } ]
  }, {
    "tStartMs": 989430,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and then smuggle it back."
    } ]
  }, {
    "tStartMs": 991290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "They returned with a secret"
    } ]
  }, {
    "tStartMs": 992640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "hidden inside their hollow canes."
    } ]
  }, {
    "tStartMs": 994920,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Silkworm eggs."
    } ]
  }, {
    "tStartMs": 996420,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "This may be the first recorded case"
    } ]
  }, {
    "tStartMs": 997950,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "of industrial espionage in history."
    } ]
  }, {
    "tStartMs": 999990,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "With that, Byzantium could\nfinally make its own silk."
    } ]
  }, {
    "tStartMs": 1003650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Nowadays, we farm them by the millions."
    } ]
  }, {
    "tStartMs": 1005810,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- One moth lays 500 eggs.\n- [Henry] Okay."
    } ]
  }, {
    "tStartMs": 1008030,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- So when you talk about\ngrowing productions, right?"
    } ]
  }, {
    "tStartMs": 1010520,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Like my wife and I had a baby."
    } ]
  }, {
    "tStartMs": 1013250,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "These guys, they have 500 babies."
    } ]
  }, {
    "tStartMs": 1015500,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And they do it every 30 days."
    } ]
  }, {
    "tStartMs": 1017090,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "- So the researchers at Kraig wondered,"
    } ]
  }, {
    "tStartMs": 1018897,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "\"What if we could make the silkworm"
    } ]
  }, {
    "tStartMs": 1020390,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "spin spider silk instead?\""
    } ]
  }, {
    "tStartMs": 1022340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- When we create a transgenic silkworm,"
    } ]
  }, {
    "tStartMs": 1024530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "we're taking the genetics of a silkworm,"
    } ]
  }, {
    "tStartMs": 1026720,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and the genetics of a spider,"
    } ]
  }, {
    "tStartMs": 1027950,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "and we're putting those together."
    } ]
  }, {
    "tStartMs": 1028940,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "We're taking the best aspects of both."
    } ]
  }, {
    "tStartMs": 1030710,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "And that's what we're\ndoing to create our fibers."
    } ]
  }, {
    "tStartMs": 1032660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- [Henry] They start by\ngluing eggs onto a slide,"
    } ]
  }, {
    "tStartMs": 1034640,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "which they line up under a microscope."
    } ]
  }, {
    "tStartMs": 1036500,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- So this is the microinjection station."
    } ]
  }, {
    "tStartMs": 1038150,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "We're talking about eggs"
    } ]
  }, {
    "tStartMs": 1039140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that are the size of the head of a pen."
    } ]
  }, {
    "tStartMs": 1041000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "We're talking about needles"
    } ]
  }, {
    "tStartMs": 1042080,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that are half a micron in diameter."
    } ]
  }, {
    "tStartMs": 1043820,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "- This part is the, I want to inject."
    } ]
  }, {
    "tStartMs": 1046940,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "So as you see, this is the tungsten needle"
    } ]
  }, {
    "tStartMs": 1049310,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and this is the glass capillary."
    } ]
  }, {
    "tStartMs": 1052370,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "And first we poke a hole\nwith the tungsten needle."
    } ]
  }, {
    "tStartMs": 1056300,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I will actually move the eggs\nto the capillary and poke."
    } ]
  }, {
    "tStartMs": 1061640,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- The fluid carrying the spider DNA"
    } ]
  }, {
    "tStartMs": 1063410,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "is then injected into the part of the egg"
    } ]
  }, {
    "tStartMs": 1065150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that will eventually become the silkworm."
    } ]
  }, {
    "tStartMs": 1067520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But at this point, the\ngenes are still separate."
    } ]
  }, {
    "tStartMs": 1069560,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "They have to become part\nof the silkworm's own DNA."
    } ]
  }, {
    "tStartMs": 1072020,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And luckily, nature already\nhas a way of doing that."
    } ]
  }, {
    "tStartMs": 1074570,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "If you take an insect like a moth"
    } ]
  }, {
    "tStartMs": 1076130,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "and look inside its genome,"
    } ]
  }, {
    "tStartMs": 1077430,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "you'll see some stretches\nof DNA that move around."
    } ]
  }, {
    "tStartMs": 1080840,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "They jump from one place\nin the genome to another."
    } ]
  }, {
    "tStartMs": 1083540,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "These are called jumping\ngenes, or transposons."
    } ]
  }, {
    "tStartMs": 1086780,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "One specific one is called piggyBac,"
    } ]
  }, {
    "tStartMs": 1088910,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and it was first identified\nin a cabbage looper moth."
    } ]
  }, {
    "tStartMs": 1092240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "PiggyBac is a piece of DNA"
    } ]
  }, {
    "tStartMs": 1093680,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "with two short sequences at its ends,"
    } ]
  }, {
    "tStartMs": 1095570,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and it works together with an enzyme"
    } ]
  }, {
    "tStartMs": 1097010,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "that recognizes these ends,\ncuts the whole piece out,"
    } ]
  }, {
    "tStartMs": 1099950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and inserts it somewhere\nelse in the genome,"
    } ]
  }, {
    "tStartMs": 1102200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "kind of like a natural\ncut and paste system."
    } ]
  }, {
    "tStartMs": 1104570,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "What scientists realized\nis that if the enzyme"
    } ]
  }, {
    "tStartMs": 1106460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "only looks at the two ends,"
    } ]
  }, {
    "tStartMs": 1108080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "then you can keep those ends the same,"
    } ]
  }, {
    "tStartMs": 1109760,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but change what sits in the middle,"
    } ]
  }, {
    "tStartMs": 1111620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and use that to implant\nthe DNA of your choosing."
    } ]
  }, {
    "tStartMs": 1114200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So in the lab, the DNA in the middle"
    } ]
  }, {
    "tStartMs": 1116180,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "is replaced with the spider silk gene."
    } ]
  }, {
    "tStartMs": 1118310,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "This, together with separate instructions"
    } ]
  }, {
    "tStartMs": 1119990,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "for making the enzyme,"
    } ]
  }, {
    "tStartMs": 1120950,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is what's then injected\ninto the silkworm egg."
    } ]
  }, {
    "tStartMs": 1123590,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "And inside the egg,"
    } ]
  }, {
    "tStartMs": 1124520,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the enzyme recognizes the\nfamiliar end sequences and cuts"
    } ]
  }, {
    "tStartMs": 1127340,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and inserts the spider silk\ngene into the silkworm's DNA."
    } ]
  }, {
    "tStartMs": 1130940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "If everything works, it\nbecomes a permanent part"
    } ]
  }, {
    "tStartMs": 1132920,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "of the silkworm's genome."
    } ]
  }, {
    "tStartMs": 1135260,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Now with silkworm where the edit worked"
    } ]
  }, {
    "tStartMs": 1136850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "looks almost exactly\nlike one where it didn't."
    } ]
  }, {
    "tStartMs": 1139280,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Jon] The first approach we used"
    } ]
  }, {
    "tStartMs": 1140420,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "was creating transgenics\nwith the glowing cocoon."
    } ]
  }, {
    "tStartMs": 1143690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "A green fluorescent protein is\nwhat's making these guys glow"
    } ]
  }, {
    "tStartMs": 1147140,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "that green color under\nthis particular wavelength"
    } ]
  }, {
    "tStartMs": 1149309,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "with that particular light\nfilter in front of it."
    } ]
  }, {
    "tStartMs": 1151970,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Henry] It feels magical."
    } ]
  }, {
    "tStartMs": 1153980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And there's a living thing inside of it."
    } ]
  }, {
    "tStartMs": 1155360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Jon] Mm hmm, yep."
    } ]
  }, {
    "tStartMs": 1156193,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "- [Henry] And it's creating\nthe glowing effect."
    } ]
  }, {
    "tStartMs": 1157880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Jon] Yeah."
    } ]
  }, {
    "tStartMs": 1158713,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "- [Henry] But even if the\nDNA insertion is successful,"
    } ]
  }, {
    "tStartMs": 1161180,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "it might not have ended\nup in the right place."
    } ]
  }, {
    "tStartMs": 1163640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- If I create the world's best recipe"
    } ]
  }, {
    "tStartMs": 1165440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "for chocolate chip cookies,"
    } ]
  }, {
    "tStartMs": 1166790,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and I stick it in the pasta section-"
    } ]
  }, {
    "tStartMs": 1168440,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Henry] Yeah."
    } ]
  }, {
    "tStartMs": 1169273,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- You're probably not going to make"
    } ]
  }, {
    "tStartMs": 1170106,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "a lot of chocolate chip cookies, right?"
    } ]
  }, {
    "tStartMs": 1170939,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "'Cause you're not going to see it."
    } ]
  }, {
    "tStartMs": 1171860,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- [Henry] Yeah.\n- Same thing for this, right?"
    } ]
  }, {
    "tStartMs": 1173570,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "We want the recipe in the right section"
    } ]
  }, {
    "tStartMs": 1175700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of the right cookbook."
    } ]
  }, {
    "tStartMs": 1176900,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- That's why getting the spider silk gene"
    } ]
  }, {
    "tStartMs": 1178550,
    "dDurationMs": 2111,
    "segs": [ {
      "utf8": "into the silkworm isn't enough."
    } ]
  }, {
    "tStartMs": 1180661,
    "dDurationMs": 2809,
    "segs": [ {
      "utf8": "- We really want the spider\nsilk get incorporated"
    } ]
  }, {
    "tStartMs": 1183470,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "into their silk gland,\nnot any other tissue."
    } ]
  }, {
    "tStartMs": 1187640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- [Henry] But piggyBac only looks"
    } ]
  }, {
    "tStartMs": 1189440,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "for a four-letter DNA sequence."
    } ]
  }, {
    "tStartMs": 1191330,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "TTAA."
    } ]
  }, {
    "tStartMs": 1192860,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "- There's so many TTAA in their genome."
    } ]
  }, {
    "tStartMs": 1196640,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You couldn't really\ncontrol where they were."
    } ]
  }, {
    "tStartMs": 1199190,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- [Henry] So it's like there\nare a lot of different places"
    } ]
  }, {
    "tStartMs": 1200720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "where they could park.\n- Yeah, yeah, that's true!"
    } ]
  }, {
    "tStartMs": 1203720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- And that means that it\nwon't spin pure spider silk."
    } ]
  }, {
    "tStartMs": 1206360,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If you had to estimate,\nof the transgenic silk,"
    } ]
  }, {
    "tStartMs": 1208910,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "like what percentage is spider DNA?"
    } ]
  }, {
    "tStartMs": 1210500,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Like 6%, 10%.\n- That's insane to me!"
    } ]
  }, {
    "tStartMs": 1213350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So even with this limited gene transfer,"
    } ]
  }, {
    "tStartMs": 1215240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "the fibers still achieve much\nof the mechanical performance"
    } ]
  }, {
    "tStartMs": 1217850,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of pure spider silk."
    } ]
  }, {
    "tStartMs": 1219050,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "- Our average samples are usually about"
    } ]
  }, {
    "tStartMs": 1221750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "60% of spider silk, right?"
    } ]
  }, {
    "tStartMs": 1224060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Which, show me any\nother place in the world"
    } ]
  }, {
    "tStartMs": 1226730,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "where you can get materials\nthat perform at 60% the strength"
    } ]
  }, {
    "tStartMs": 1229280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of spider silk that you can\nmake cost effectively, right?"
    } ]
  }, {
    "tStartMs": 1231620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "- [Henry] To push the\n60% average even higher,"
    } ]
  }, {
    "tStartMs": 1233660,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "the insertion needs to be more targeted."
    } ]
  }, {
    "tStartMs": 1235790,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- The next step is to create pure,"
    } ]
  }, {
    "tStartMs": 1238010,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "what are called\nknock-in/knockout transgenics"
    } ]
  }, {
    "tStartMs": 1239690,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "where we will completely\nremove all aspects"
    } ]
  }, {
    "tStartMs": 1242270,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "of the silkworm's native DNA for the silk,"
    } ]
  }, {
    "tStartMs": 1244340,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and replace that completely\nwith the spider silk protein."
    } ]
  }, {
    "tStartMs": 1246830,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- And to do that, most of\nthe leading labs in the field"
    } ]
  }, {
    "tStartMs": 1249050,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "are exploring CRISPR-Cas9."
    } ]
  }, {
    "tStartMs": 1251344,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "This tool has two parts."
    } ]
  }, {
    "tStartMs": 1253310,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "The first is a guide, a\nshort piece of genetic code"
    } ]
  }, {
    "tStartMs": 1255800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "designed to match one\nexact stretch of DNA."
    } ]
  }, {
    "tStartMs": 1258380,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Unlike piggyBac,"
    } ]
  }, {
    "tStartMs": 1259280,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "which recognizes a sequence\njust four DNA letters long,"
    } ]
  }, {
    "tStartMs": 1262370,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "this guide matches about 20 letters,"
    } ]
  }, {
    "tStartMs": 1264200,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "making it far more specific."
    } ]
  }, {
    "tStartMs": 1266270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The second is a cutting protein."
    } ]
  }, {
    "tStartMs": 1267950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "When the guide finds\nits matching sequence,"
    } ]
  }, {
    "tStartMs": 1269660,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the protein cuts the DNA."
    } ]
  }, {
    "tStartMs": 1271490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Here, that spot is inside\nthe silkworm's own gene"
    } ]
  }, {
    "tStartMs": 1273860,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "for making silk."
    } ]
  }, {
    "tStartMs": 1275120,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The cell immediately\ntries to repair the break,"
    } ]
  }, {
    "tStartMs": 1277280,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and scientists take advantage of this"
    } ]
  }, {
    "tStartMs": 1278750,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "by also injecting donor DNA,\ncarrying the spider silk gene."
    } ]
  }, {
    "tStartMs": 1282770,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "As the cell repairs the cut,\nit copies in that donor DNA,"
    } ]
  }, {
    "tStartMs": 1286100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "stitching the spider silk gene"
    } ]
  }, {
    "tStartMs": 1287480,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "into this one precise location."
    } ]
  }, {
    "tStartMs": 1289790,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But this process is still\nan active development."
    } ]
  }, {
    "tStartMs": 1291920,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And Kraig is not the only group"
    } ]
  }, {
    "tStartMs": 1293300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "chasing the dream of spider silk."
    } ]
  }, {
    "tStartMs": 1295340,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "In Germany, AMSilk is\nmaking proteins for fibers,"
    } ]
  }, {
    "tStartMs": 1298160,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "coatings, powders, and hydrogels."
    } ]
  }, {
    "tStartMs": 1300470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And in Japan, Spiber is\nbrewing protein fibers"
    } ]
  }, {
    "tStartMs": 1302900,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "through fermentation."
    } ]
  }, {
    "tStartMs": 1304250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Brands like Goldwin and The North Face"
    } ]
  }, {
    "tStartMs": 1306170,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "have already used a\nversion of these fibers"
    } ]
  }, {
    "tStartMs": 1308030,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "in their clothing."
    } ]
  }, {
    "tStartMs": 1309050,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And the military has been interested too."
    } ]
  }, {
    "tStartMs": 1311060,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "In 2016, the US Army funded Kraig"
    } ]
  }, {
    "tStartMs": 1313250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to produce ballistic shoe packs,"
    } ]
  }, {
    "tStartMs": 1314870,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "panels layered with transgenic silk"
    } ]
  }, {
    "tStartMs": 1316850,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that are designed as potential body armor."
    } ]
  }, {
    "tStartMs": 1319310,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And it's even being explored in medicine."
    } ]
  }, {
    "tStartMs": 1321740,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "For centuries,"
    } ]
  }, {
    "tStartMs": 1322573,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "surgeons have stitched\nwounds together with silk."
    } ]
  }, {
    "tStartMs": 1324980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But now a company called\nNewrotex is using spider silk"
    } ]
  }, {
    "tStartMs": 1327920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "to help repair damaged nerves."
    } ]
  }, {
    "tStartMs": 1330230,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So if it can be produced cheaply,"
    } ]
  }, {
    "tStartMs": 1331730,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "spider silk could find\nits way into clothing,"
    } ]
  }, {
    "tStartMs": 1333710,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "armor, implants, even nerve repair."
    } ]
  }, {
    "tStartMs": 1336950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But to do that, we're\ngoing to need a lot of it."
    } ]
  }, {
    "tStartMs": 1339020,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- And this is our specialized\nspider silk. There you go."
    } ]
  }, {
    "tStartMs": 1344660,
    "dDurationMs": 893,
    "segs": [ {
      "utf8": "- This is the transgenic spider silk."
    } ]
  }, {
    "tStartMs": 1345553,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "- [Jon] This is spider silk."
    } ]
  }, {
    "tStartMs": 1346880,
    "dDurationMs": 1156,
    "segs": [ {
      "utf8": "This is transgenic spider silk."
    } ]
  }, {
    "tStartMs": 1348036,
    "dDurationMs": 1064,
    "segs": [ {
      "utf8": "- What? This is like a bale."
    } ]
  }, {
    "tStartMs": 1349100,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "This is a hay bale of spider silk."
    } ]
  }, {
    "tStartMs": 1350660,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "- So last year we produced\nabout a half a ton"
    } ]
  }, {
    "tStartMs": 1355070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "of spider silk cocoon.\n- Half a ton."
    } ]
  }, {
    "tStartMs": 1357080,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- And this is silk from that."
    } ]
  }, {
    "tStartMs": 1358790,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- But what about our original question?"
    } ]
  }, {
    "tStartMs": 1360290,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Can you use transgenic spider\nsilk to swing like Spider-Man?"
    } ]
  }, {
    "tStartMs": 1364400,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So Derek, I've got you\nhere in a climbing gym"
    } ]
  }, {
    "tStartMs": 1367430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "for a very good reason."
    } ]
  }, {
    "tStartMs": 1369350,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And the reason is underneath\nthis dirty dish towel."
    } ]
  }, {
    "tStartMs": 1372080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Unveil it, unveil it. Yeah, go."
    } ]
  }, {
    "tStartMs": 1373880,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "All right, okay. This\nlooks very uninspiring."
    } ]
  }, {
    "tStartMs": 1378650,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Henry] So what's interesting is"
    } ]
  }, {
    "tStartMs": 1380090,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "this is one continuous filament."
    } ]
  }, {
    "tStartMs": 1382250,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- This is just one strand."
    } ]
  }, {
    "tStartMs": 1383780,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- But each one of these strands"
    } ]
  }, {
    "tStartMs": 1385070,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "is actually 10 individual silk filaments"
    } ]
  }, {
    "tStartMs": 1387770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "that are kind of connected.\n- All right."
    } ]
  }, {
    "tStartMs": 1389660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So you want me to hang from this?"
    } ]
  }, {
    "tStartMs": 1391520,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- I do want you to hang from it, yes."
    } ]
  }, {
    "tStartMs": 1393260,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "I actually want you to do\nmore than just hang from it."
    } ]
  }, {
    "tStartMs": 1394730,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I want you to swing."
    } ]
  }, {
    "tStartMs": 1396440,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "- This will be the first time ever"
    } ]
  }, {
    "tStartMs": 1398270,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "anyone has ever swung\nfrom actual spider silk."
    } ]
  }, {
    "tStartMs": 1402140,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "Granted this spider silk came\nfrom other organisms, but..."
    } ]
  }, {
    "tStartMs": 1405174,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "(mysterious music)"
    } ]
  }, {
    "tStartMs": 1409644,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "I don't know if it's going to\nhold my weight, so let's see."
    } ]
  }, {
    "tStartMs": 1412310,
    "dDurationMs": 2553,
    "segs": [ {
      "utf8": "In three, two, one."
    } ]
  }, {
    "tStartMs": 1420650,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "- You really came close!\n(Derek and Henry laughing)"
    } ]
  }, {
    "tStartMs": 1423900,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1433819,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "(dramatic music continues)"
    } ]
  }, {
    "tStartMs": 1438980,
    "dDurationMs": 3357,
    "segs": [ {
      "utf8": "- Don't tell anyone, but Spider-Man."
    } ]
  }, {
    "tStartMs": 1442337,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(dramatic music)"
    } ]
  }, {
    "tStartMs": 1447260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "- Okay, so we've seen\nit can hold your weight"
    } ]
  }, {
    "tStartMs": 1449510,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "pretty reasonably."
    } ]
  }, {
    "tStartMs": 1450410,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "We could swing, but I do want\nto put it to the ultimate test"
    } ]
  }, {
    "tStartMs": 1453140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and get you up there."
    } ]
  }, {
    "tStartMs": 1455000,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "How much do you trust spider silk?"
    } ]
  }, {
    "tStartMs": 1456350,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "- Tensile strength doesn't lie."
    } ]
  }, {
    "tStartMs": 1458060,
    "dDurationMs": 2311,
    "segs": [ {
      "utf8": "- All right, let's get you up there."
    } ]
  }, {
    "tStartMs": 1460371,
    "dDurationMs": 1379,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 1461750,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "- We used the title,"
    } ]
  }, {
    "tStartMs": 1462987,
    "dDurationMs": 3391,
    "segs": [ {
      "utf8": "\"Risking my life to settle\na physics debate\" too early."
    } ]
  }, {
    "tStartMs": 1466378,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 1471020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It feels like it's going\nto dig into my fingers."
    } ]
  }, {
    "tStartMs": 1474560,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "- [Speaker] This is crazy.\n(tense music)"
    } ]
  }, {
    "tStartMs": 1486678,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "(tense music continues)\n(Derek yelling)"
    } ]
  }, {
    "tStartMs": 1487970,
    "dDurationMs": 2508,
    "segs": [ {
      "utf8": "- I'm going to go. I'm going to go!"
    } ]
  }, {
    "tStartMs": 1490478,
    "dDurationMs": 1782,
    "segs": [ {
      "utf8": "(tense music)"
    } ]
  }, {
    "tStartMs": 1492260,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "- [Henry] Whoo!\n(Derek yelling)"
    } ]
  }, {
    "tStartMs": 1494270,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Let's go!"
    } ]
  }, {
    "tStartMs": 1497443,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "- You got to see my finger, man!"
    } ]
  }, {
    "tStartMs": 1500240,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "- [Henry] Ooh, damn!"
    } ]
  }, {
    "tStartMs": 1501140,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "- Yeah. This is the\nproblem with spider silk."
    } ]
  }, {
    "tStartMs": 1505310,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Just, it's thin, it's strong,"
    } ]
  }, {
    "tStartMs": 1509120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and it just rips you open."
    } ]
  }, {
    "tStartMs": 1511400,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Now, if it isn't clear,"
    } ]
  }, {
    "tStartMs": 1512450,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we're not exactly web-swinging experts."
    } ]
  }, {
    "tStartMs": 1514970,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But we'd love to get the\nsilk into of the hands"
    } ]
  }, {
    "tStartMs": 1516830,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "of someone who is."
    } ]
  }, {
    "tStartMs": 1518060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "- Tom Holland, this is a challenge."
    } ]
  }, {
    "tStartMs": 1519980,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Yeah, I'm calling out Tom Holland."
    } ]
  }, {
    "tStartMs": 1521270,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I'm calling out all them guys."
    } ]
  }, {
    "tStartMs": 1522620,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Andrew Garfield, Tobey McGuire."
    } ]
  }, {
    "tStartMs": 1527000,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "That's right. Come at me, bro."
    } ]
  }, {
    "tStartMs": 1530579,
    "dDurationMs": 3215,
    "segs": [ {
      "utf8": "(electronic music)"
    } ]
  }, {
    "tStartMs": 1533794,
    "dDurationMs": 1246,
    "segs": [ {
      "utf8": "- See, spider silk is so strong"
    } ]
  }, {
    "tStartMs": 1535040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and so thin that it\nactually cut Derek's skin."
    } ]
  }, {
    "tStartMs": 1537380,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "And that's actually a great way"
    } ]
  }, {
    "tStartMs": 1538520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to explain the design\nflaw with modern razors."
    } ]
  }, {
    "tStartMs": 1540920,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Thanks to Henson Shaving\nfor sponsoring this video."
    } ]
  }, {
    "tStartMs": 1543260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "See, facial hair resists\nmore than you think."
    } ]
  }, {
    "tStartMs": 1545300,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And many razor blades\nare engineered so thin"
    } ]
  }, {
    "tStartMs": 1547940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "that they bend under that resistance."
    } ]
  }, {
    "tStartMs": 1549800,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "This is called blade flex."
    } ]
  }, {
    "tStartMs": 1551390,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Now, most razors actually\nbuild this flex in."
    } ]
  }, {
    "tStartMs": 1553700,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "They use springs, pivots,"
    } ]
  }, {
    "tStartMs": 1555350,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and flexible mounts that\nallow the blade to move."
    } ]
  }, {
    "tStartMs": 1558110,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It's supposed to make\nthe shave feel gentler,"
    } ]
  }, {
    "tStartMs": 1560300,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "but it means that the cutting\nangle is constantly changing."
    } ]
  }, {
    "tStartMs": 1562790,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "When unsupported, the\nblade bends mid-stroke"
    } ]
  }, {
    "tStartMs": 1565070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and instead of slicing cleanly,"
    } ]
  }, {
    "tStartMs": 1566930,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "it tugs the hairs, micro-cutting the skin."
    } ]
  }, {
    "tStartMs": 1569450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "That's what causes irritation."
    } ]
  }, {
    "tStartMs": 1571340,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The usual fixes are lubrication\nstrips or extra blades,"
    } ]
  }, {
    "tStartMs": 1574820,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "but they don't solve the real problem."
    } ]
  }, {
    "tStartMs": 1576560,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The blade is still allowed to flex."
    } ]
  }, {
    "tStartMs": 1578570,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "We assume that razor bumps\nand irritation are inevitable,"
    } ]
  }, {
    "tStartMs": 1581150,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "but that's shaped by bad design."
    } ]
  }, {
    "tStartMs": 1583910,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But Henson is designed\nby aerospace machinists"
    } ]
  }, {
    "tStartMs": 1586310,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "who control cutting forces\nwith high precision."
    } ]
  }, {
    "tStartMs": 1588740,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And their razors use a single\nprecisely-machined blade."
    } ]
  }, {
    "tStartMs": 1591950,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Instead of letting it move,"
    } ]
  }, {
    "tStartMs": 1592880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Henson's design supports the cutting edge"
    } ]
  }, {
    "tStartMs": 1594800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with tight machining tolerances,"
    } ]
  }, {
    "tStartMs": 1596480,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "holding the blade securely\nso the angle is consistent."
    } ]
  }, {
    "tStartMs": 1599090,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Remove the flex, remove the irritation."
    } ]
  }, {
    "tStartMs": 1601370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Use code \"Veritasium\" for 100 free blades"
    } ]
  }, {
    "tStartMs": 1603410,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "with any razor purchase."
    } ]
  }, {
    "tStartMs": 1604520,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Just add both the razor\nand blades to your cart."
    } ]
  }, {
    "tStartMs": 1606590,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Thanks to Henson Shaving,"
    } ]
  }, {
    "tStartMs": 1607580,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "and as always, thanks for watching."
    } ]
  } ]
}
