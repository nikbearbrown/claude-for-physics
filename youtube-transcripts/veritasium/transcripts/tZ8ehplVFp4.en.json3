{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 113,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "- On October 23rd, 2018,"
    } ]
  }, {
    "tStartMs": 2400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "thousands of football\nfans were making their way"
    } ]
  }, {
    "tStartMs": 4400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to the game in Rome."
    } ]
  }, {
    "tStartMs": 5920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Excitement for the game was high,"
    } ]
  }, {
    "tStartMs": 7440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and the fans began to chant and sing."
    } ]
  }, {
    "tStartMs": 10160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "At 7:03 pm,"
    } ]
  }, {
    "tStartMs": 11600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "around 50 people were\nriding the long escalator"
    } ]
  }, {
    "tStartMs": 14240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "down to the platform,\nbut within 30 seconds,"
    } ]
  }, {
    "tStartMs": 16800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "the crowd had swelled\nto nearly double that."
    } ]
  }, {
    "tStartMs": 19520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Everything seemed fine,"
    } ]
  }, {
    "tStartMs": 20800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "but inside the escalator was a problem."
    } ]
  }, {
    "tStartMs": 25040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The weight of the passengers\nwas bearing down on the steps,"
    } ]
  }, {
    "tStartMs": 28240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and the load on the main\nmotor was increasing."
    } ]
  }, {
    "tStartMs": 31200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "To try to slow the descent,"
    } ]
  }, {
    "tStartMs": 32880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the motor applied a counter torque."
    } ]
  }, {
    "tStartMs": 35040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "But as the force continued to increase,"
    } ]
  }, {
    "tStartMs": 36800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the stairs began to move faster."
    } ]
  }, {
    "tStartMs": 39440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "By 7:04 pm, the crowd had tripled."
    } ]
  }, {
    "tStartMs": 42080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The motor finally reached its limit,"
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and under the massive strain,\nthe drum began to slip."
    } ]
  }, {
    "tStartMs": 47840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "With the motor losing control,"
    } ]
  }, {
    "tStartMs": 49360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the escalator triggered\nits second line of defense."
    } ]
  }, {
    "tStartMs": 52240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "A safety relay tripped,"
    } ]
  }, {
    "tStartMs": 54720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "immediately cutting power to the motor."
    } ]
  }, {
    "tStartMs": 56960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The main brake clamped\ndown on the metal drum"
    } ]
  }, {
    "tStartMs": 59360,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to stop the descent of the stairs,"
    } ]
  }, {
    "tStartMs": 63280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but, it failed."
    } ]
  }, {
    "tStartMs": 65920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The friction on the\nmain drum wasn't enough"
    } ]
  }, {
    "tStartMs": 68160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to stop the motor from spinning,"
    } ]
  }, {
    "tStartMs": 69840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and the stairs continued to accelerate."
    } ]
  }, {
    "tStartMs": 72960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Sensing the motor had\nlost control of the steps,"
    } ]
  }, {
    "tStartMs": 74880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the escalator engaged\nthe last line of defense."
    } ]
  }, {
    "tStartMs": 77680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "In the event of an emergency,\nan auxiliary break is designed"
    } ]
  }, {
    "tStartMs": 80560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "to bypass the motor entirely"
    } ]
  }, {
    "tStartMs": 82240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and directly lock the drive shaft."
    } ]
  }, {
    "tStartMs": 85520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Under normal circumstances,"
    } ]
  }, {
    "tStartMs": 87200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "the chance that all three\nsafety measures fail"
    } ]
  }, {
    "tStartMs": 89760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "at the same time is vanishingly small."
    } ]
  }, {
    "tStartMs": 93040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But these weren't normal circumstances."
    } ]
  }, {
    "tStartMs": 95840,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "At 7:05 pm, the third and\nfinal safety system failed,"
    } ]
  }, {
    "tStartMs": 99360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and the stairs began to plummet."
    } ]
  }, {
    "tStartMs": 102000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Fans were flung forward"
    } ]
  }, {
    "tStartMs": 103360,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "and started streaming down the escalator."
    } ]
  }, {
    "tStartMs": 106640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Some lept over the central\nbarrier in desperation,"
    } ]
  }, {
    "tStartMs": 109280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "while others were swept\ninto a crushing pileup."
    } ]
  }, {
    "tStartMs": 112240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "At the bottom, the landing\nbecame a dangerous choke point."
    } ]
  }, {
    "tStartMs": 115360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Under the pressure, the steps twisted"
    } ]
  }, {
    "tStartMs": 117120,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "and buckled into jagged metal,\nleaving 24 people injured."
    } ]
  }, {
    "tStartMs": 121840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Something like this\nshouldn't have been possible,"
    } ]
  }, {
    "tStartMs": 124480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and experts at the time knew\nthat something had gone wrong,"
    } ]
  }, {
    "tStartMs": 127840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and they started to suspect foul play."
    } ]
  }, {
    "tStartMs": 130080,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "In the aftermath, Rome's Transit Agency"
    } ]
  }, {
    "tStartMs": 132400,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "sealed off the accident site"
    } ]
  }, {
    "tStartMs": 133760,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and closed the Republica\nstation for several months."
    } ]
  }, {
    "tStartMs": 136880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The authorities ordered both a technical"
    } ]
  }, {
    "tStartMs": 139280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and a criminal investigation,"
    } ]
  }, {
    "tStartMs": 140960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the mayor even publicly vowed"
    } ]
  }, {
    "tStartMs": 142880,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to discover the cause of the accident."
    } ]
  }, {
    "tStartMs": 145200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So investigators began\ndismantling the wreck,"
    } ]
  }, {
    "tStartMs": 148000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "tearing it down piece by piece"
    } ]
  }, {
    "tStartMs": 149520,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "to reconstruct what had happened."
    } ]
  }, {
    "tStartMs": 154240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The ride people experienced\non that escalator"
    } ]
  }, {
    "tStartMs": 156720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "was one of the most terrifying\nrides of their lives."
    } ]
  }, {
    "tStartMs": 159520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But maybe it's more similar to the origin"
    } ]
  }, {
    "tStartMs": 162000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "of escalators than you might think."
    } ]
  }, {
    "tStartMs": 163920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Like what was the first\nescalator even used for?"
    } ]
  }, {
    "tStartMs": 167200,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Do you wanna have a guess?"
    } ]
  }, {
    "tStartMs": 171440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It was an attraction in a theme park"
    } ]
  }, {
    "tStartMs": 173440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "all the way back in 1896."
    } ]
  }, {
    "tStartMs": 175600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "It had no steps, a 25 degree incline,"
    } ]
  }, {
    "tStartMs": 178800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and it was essentially\njust a slow conveyor belt"
    } ]
  }, {
    "tStartMs": 181280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "made of metal and wooden parts."
    } ]
  }, {
    "tStartMs": 183360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It brought people up a full seven feet"
    } ]
  }, {
    "tStartMs": 185760,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "before they would have to walk\ndownstairs on the other side,"
    } ]
  }, {
    "tStartMs": 189440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and it was a huge success."
    } ]
  }, {
    "tStartMs": 191760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Over 75,000 people enjoyed the attraction"
    } ]
  }, {
    "tStartMs": 194480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "during its two week\nstay at the Old Iron Pier"
    } ]
  }, {
    "tStartMs": 196880,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "on Coney Island."
    } ]
  }, {
    "tStartMs": 198000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The ride was named the Continuous Elevator"
    } ]
  }, {
    "tStartMs": 200720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and its inventor, Jesse\nReno, had created it"
    } ]
  }, {
    "tStartMs": 203520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "not just as an attraction,\nbut as a proof of concept,"
    } ]
  }, {
    "tStartMs": 207120,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "because he saw it as the\nfuture of transportation."
    } ]
  }, {
    "tStartMs": 213200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But as Reno watched\npeople ride his invention,"
    } ]
  }, {
    "tStartMs": 216080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "he began to notice a pattern."
    } ]
  }, {
    "tStartMs": 218160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Nobody walked."
    } ]
  }, {
    "tStartMs": 219360,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Instead, they stood still,\nfeet planted firmly sideways"
    } ]
  }, {
    "tStartMs": 223520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "with people gripping the handrail tightly."
    } ]
  }, {
    "tStartMs": 227360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Two years later, the department\nstore Harrods in England"
    } ]
  }, {
    "tStartMs": 229840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "installed a similar device,"
    } ]
  }, {
    "tStartMs": 231440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but the ride was so\nunsettling that Harrods"
    } ]
  }, {
    "tStartMs": 233920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "had to put staff at the\ntop to offer brandy to men"
    } ]
  }, {
    "tStartMs": 236240,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and smelling salts to women\njust to calm their nerves."
    } ]
  }, {
    "tStartMs": 240480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "You see, for both devices,"
    } ]
  }, {
    "tStartMs": 241920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the 25 degree conveyor belt\nwas precarious to walk on"
    } ]
  }, {
    "tStartMs": 245280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and unnerving to stand on."
    } ]
  }, {
    "tStartMs": 247280,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "At around 12 degrees,"
    } ]
  }, {
    "tStartMs": 248800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "walking on an incline becomes difficult,"
    } ]
  }, {
    "tStartMs": 250880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and 25 degrees is roughly the limit"
    } ]
  }, {
    "tStartMs": 253520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "that our ankles can flex."
    } ]
  }, {
    "tStartMs": 256160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If only there was a way to\nreplace the conveyor belt"
    } ]
  }, {
    "tStartMs": 258560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "with a moving set of stairs."
    } ]
  }, {
    "tStartMs": 260560,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Well, then the riders would\nalways have a flat surface"
    } ]
  }, {
    "tStartMs": 263520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to stand on and a\nstaircase they could climb"
    } ]
  }, {
    "tStartMs": 266160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "if they wanted to."
    } ]
  }, {
    "tStartMs": 268160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "One attempt at a solution\nhad already been around"
    } ]
  }, {
    "tStartMs": 270400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "for four decades, and it was\ncalled the revolving stairs."
    } ]
  }, {
    "tStartMs": 274000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It consisted of a chain\nthat went around a loop,"
    } ]
  }, {
    "tStartMs": 276720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "then fixed stair shaped\nblocks were attached to it,"
    } ]
  }, {
    "tStartMs": 279600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "creating a flat surface to stand\non during the main incline."
    } ]
  }, {
    "tStartMs": 282960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "But as soon as you'd reached the top,"
    } ]
  }, {
    "tStartMs": 284400,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "the steps tilted forward, making\nit treacherous to get off,"
    } ]
  }, {
    "tStartMs": 287920,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and a similar problem\nplagued you at the bottom."
    } ]
  }, {
    "tStartMs": 291120,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Now, you might think if the top"
    } ]
  }, {
    "tStartMs": 292400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and bottom are causing problems,\njust extend each landing,"
    } ]
  }, {
    "tStartMs": 295840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but that also doesn't work."
    } ]
  }, {
    "tStartMs": 297600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "You just end up with a\njagged mess for longer."
    } ]
  }, {
    "tStartMs": 300720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So how do modern escalators\nsolve this problem?"
    } ]
  }, {
    "tStartMs": 304080,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I mean, have you ever\nstopped to think what happens"
    } ]
  }, {
    "tStartMs": 306320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to the stairs at the top"
    } ]
  }, {
    "tStartMs": 307840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "of the escalator when they disappear?"
    } ]
  }, {
    "tStartMs": 310000,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Clearly, we have steps going\naround in some sort of loop,"
    } ]
  }, {
    "tStartMs": 313360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "but how do they actually\nbehave on the return journey?"
    } ]
  }, {
    "tStartMs": 316560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "What if I give you two options?"
    } ]
  }, {
    "tStartMs": 318320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Do they stay right side up like the cabins"
    } ]
  }, {
    "tStartMs": 320880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in a Ferris wheel, or\ndo they flip upside down"
    } ]
  }, {
    "tStartMs": 323760,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and then flip back\nagain at the other side?"
    } ]
  }, {
    "tStartMs": 326560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "- I'm gonna go this one all day."
    } ]
  }, {
    "tStartMs": 328560,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- Ferris wheel.\n- This one makes more sense."
    } ]
  }, {
    "tStartMs": 330040,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "- Ferris Wheel."
    } ]
  }, {
    "tStartMs": 330840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Yeah, this one."
    } ]
  }, {
    "tStartMs": 332040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- I think they turn upside down."
    } ]
  }, {
    "tStartMs": 334280,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "- And they're actually right side up."
    } ]
  }, {
    "tStartMs": 335760,
    "dDurationMs": 1678,
    "segs": [ {
      "utf8": "- I think I'm gonna go with this."
    } ]
  }, {
    "tStartMs": 337438,
    "dDurationMs": 1816,
    "segs": [ {
      "utf8": "- Wow. You're both"
    } ]
  }, {
    "tStartMs": 339254,
    "dDurationMs": 24,
    "segs": [ {
      "utf8": "- They just keep-\n- Yeah."
    } ]
  }, {
    "tStartMs": 339278,
    "dDurationMs": 2482,
    "segs": [ {
      "utf8": "- The solution to this problem\ncame from another inventor"
    } ]
  }, {
    "tStartMs": 341760,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "named George Wheeler."
    } ]
  }, {
    "tStartMs": 343520,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "His idea forms the basis of\nevery escalator in use today."
    } ]
  }, {
    "tStartMs": 347520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "A modern version of it\nworks something like this."
    } ]
  }, {
    "tStartMs": 350720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "A typical subway escalator has\nan electric motor at the top"
    } ]
  }, {
    "tStartMs": 353760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "with a power output of\naround 50 kilowatts."
    } ]
  }, {
    "tStartMs": 356640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Smaller than most electric cars."
    } ]
  }, {
    "tStartMs": 359040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This motor spins extremely\nfast at over a 1,000 RPM,"
    } ]
  }, {
    "tStartMs": 362880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but it's pretty weak."
    } ]
  }, {
    "tStartMs": 364400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So to drive the steps, the escalator needs"
    } ]
  }, {
    "tStartMs": 366560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "to convert this into a slower\noutput with more force."
    } ]
  }, {
    "tStartMs": 370000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "To do this, it uses a reduction\ngearbox in a gear system,"
    } ]
  }, {
    "tStartMs": 373440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "lowering the output to just a few RPM"
    } ]
  }, {
    "tStartMs": 375760,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and increasing the torque\nby a factor of around 100."
    } ]
  }, {
    "tStartMs": 380240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The motor is connected\nwith a large sprocket"
    } ]
  }, {
    "tStartMs": 382560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to a reinforced steel chain,"
    } ]
  }, {
    "tStartMs": 384400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "which pulls the stairs around a loop."
    } ]
  }, {
    "tStartMs": 386480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The so-called step chain\nis fitted with wheels"
    } ]
  }, {
    "tStartMs": 388960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to allow it to roll\nsmoothly around curves."
    } ]
  }, {
    "tStartMs": 392080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But unlike the design\nfor the revolving stairs,"
    } ]
  }, {
    "tStartMs": 394640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Wheeler proposed attaching\neach step to this chain"
    } ]
  }, {
    "tStartMs": 397200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "through a single axle, giving\nit the freedom to rotate."
    } ]
  }, {
    "tStartMs": 401280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Next, he added a second\nset of wheels to each step"
    } ]
  }, {
    "tStartMs": 403920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that followed a different track,"
    } ]
  }, {
    "tStartMs": 405840,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "allowing him to control the\nangle of each step at any point."
    } ]
  }, {
    "tStartMs": 409680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "On the incline, the two tracks overlap"
    } ]
  }, {
    "tStartMs": 412000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "just like the revolving staircase,"
    } ]
  }, {
    "tStartMs": 413840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but then at the top,\nthe two tracks separate,"
    } ]
  }, {
    "tStartMs": 416480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and this is what allows us"
    } ]
  }, {
    "tStartMs": 417920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to keep the steps level\nthroughout the entire ride."
    } ]
  }, {
    "tStartMs": 421040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The tracks then remain\nseparated and curve around."
    } ]
  }, {
    "tStartMs": 424080,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The steps flip upside down,"
    } ]
  }, {
    "tStartMs": 425840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "tuck into the loop, and\nstart their return journey."
    } ]
  }, {
    "tStartMs": 428800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "At the start of the\nincline, the tracks rejoin"
    } ]
  }, {
    "tStartMs": 430960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and the whole process repeats."
    } ]
  }, {
    "tStartMs": 433280,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "- So the answer is, you are both wrong."
    } ]
  }, {
    "tStartMs": 436200,
    "dDurationMs": 4425,
    "segs": [ {
      "utf8": "- Oh my God."
    } ]
  }, {
    "tStartMs": 440625,
    "dDurationMs": 573,
    "segs": [ {
      "utf8": "- I don't want to be interviewed anymore."
    } ]
  }, {
    "tStartMs": 441198,
    "dDurationMs": 1882,
    "segs": [ {
      "utf8": "- Yeah.\n- Wow. I never really thought about that."
    } ]
  }, {
    "tStartMs": 443080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "- Yeah, like, I would say,"
    } ]
  }, {
    "tStartMs": 444880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "it's like a upside down elevator, bro."
    } ]
  }, {
    "tStartMs": 447400,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "- Guess what? You're right."
    } ]
  }, {
    "tStartMs": 450240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "- Yeah?\n- Yeah."
    } ]
  }, {
    "tStartMs": 452640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "- But despite all modern escalators"
    } ]
  }, {
    "tStartMs": 454720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "adopting Wheeler's design, at the time,"
    } ]
  }, {
    "tStartMs": 456960,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "it caught so little attention"
    } ]
  }, {
    "tStartMs": 458480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that he was forced to shelve the idea."
    } ]
  }, {
    "tStartMs": 460880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It wasn't until eight years\nlater that another inventor,"
    } ]
  }, {
    "tStartMs": 463520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Charles Seeberger, bought his patent"
    } ]
  }, {
    "tStartMs": 465520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and capitalized on the invention."
    } ]
  }, {
    "tStartMs": 467920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Seeberger partnered with\nthe Otis Elevator Company,"
    } ]
  }, {
    "tStartMs": 470480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and together they built a prototype."
    } ]
  }, {
    "tStartMs": 473920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "A year later, in 1900,"
    } ]
  }, {
    "tStartMs": 475440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "they showcased it at the\nParis Exposition Universelle."
    } ]
  }, {
    "tStartMs": 479280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "In total, 51 million people\nflocked to the exposition"
    } ]
  }, {
    "tStartMs": 482240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to see the marvels of modern technology."
    } ]
  }, {
    "tStartMs": 484400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But one of the most popular exhibitions"
    } ]
  }, {
    "tStartMs": 486080,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "was the world's first\ntrue commercial escalator."
    } ]
  }, {
    "tStartMs": 489040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The machine drew huge crowds."
    } ]
  }, {
    "tStartMs": 491200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "French historian Philippe\nJullian described it"
    } ]
  }, {
    "tStartMs": 493600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "as the jolliest attraction\nat the exhibition"
    } ]
  }, {
    "tStartMs": 495840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and wrote, \"The escalator\ncaused many an incident worthy"
    } ]
  }, {
    "tStartMs": 499200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"of the vaudeville, separating families,"
    } ]
  }, {
    "tStartMs": 501200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "\"sending old men sprawling,\ndelighting the children,"
    } ]
  }, {
    "tStartMs": 503760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "\"and reducing their nannies to despair.\""
    } ]
  }, {
    "tStartMs": 506160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The escalator was even awarded\none of the grand prizes"
    } ]
  }, {
    "tStartMs": 508960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of the fair."
    } ]
  }, {
    "tStartMs": 510160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Shortly after, escalators\nstarted being installed"
    } ]
  }, {
    "tStartMs": 512560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "in different places across the world."
    } ]
  }, {
    "tStartMs": 515760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But these escalators weren't perfect."
    } ]
  }, {
    "tStartMs": 518320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "They had smooth flat stairs,"
    } ]
  }, {
    "tStartMs": 520160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and when they reached the top,"
    } ]
  }, {
    "tStartMs": 521600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "these stairs would disappear\nunder a wooden board,"
    } ]
  }, {
    "tStartMs": 524560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "leaving a dangerous gap between them."
    } ]
  }, {
    "tStartMs": 527120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Shoe laces, coats, and\nespecially the long skirts"
    } ]
  }, {
    "tStartMs": 529680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "in fashion at the time easily\ngot caught in the machinery."
    } ]
  }, {
    "tStartMs": 533200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "One incident even saw a three year girl"
    } ]
  }, {
    "tStartMs": 535520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "getting her foot pinched in the gap."
    } ]
  }, {
    "tStartMs": 537760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And while the girl luckily\nescaped with injured toes"
    } ]
  }, {
    "tStartMs": 540400,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and a missing shoe, something\nin the design had to change."
    } ]
  }, {
    "tStartMs": 544720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "To solve this, Seeberger"
    } ]
  }, {
    "tStartMs": 546320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and Otis installed a\ntriangular shunt at the end"
    } ]
  }, {
    "tStartMs": 549040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of the escalator, forcing\nrider to go off to the left"
    } ]
  }, {
    "tStartMs": 552000,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "before they reached the dangerous gap."
    } ]
  }, {
    "tStartMs": 554480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This system worked, but it was awkward"
    } ]
  }, {
    "tStartMs": 556640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because it meant people\nhad to put one foot"
    } ]
  }, {
    "tStartMs": 558560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "onto solid ground while\nthe other was still moving,"
    } ]
  }, {
    "tStartMs": 561120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "which became especially tricky"
    } ]
  }, {
    "tStartMs": 562560,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "when some people stood\nstill and others walked."
    } ]
  }, {
    "tStartMs": 565680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So to reduce the risk of people\ngetting in each other's way,"
    } ]
  }, {
    "tStartMs": 568800,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "operators asked people\nto stand on the right"
    } ]
  }, {
    "tStartMs": 571360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and keep the left lane\nclear for faster walkers."
    } ]
  }, {
    "tStartMs": 574400,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It's a convention we still\noften follow to this day,"
    } ]
  }, {
    "tStartMs": 578400,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "but as it turns out,"
    } ]
  }, {
    "tStartMs": 579520,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "there's a much better\nsolution than the shunt."
    } ]
  }, {
    "tStartMs": 583200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Modern escalator steps aren't\nsmooth, they're grooved."
    } ]
  }, {
    "tStartMs": 586560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "These grooves then interlock perfectly"
    } ]
  }, {
    "tStartMs": 588480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "with a comb plate at the\ntop of the escalator."
    } ]
  }, {
    "tStartMs": 591360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So now, if a small item\napproaches the end,"
    } ]
  }, {
    "tStartMs": 594000,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "the comb plate lifts it\nup and out of harm's way."
    } ]
  }, {
    "tStartMs": 597280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "This makes it much harder\nfor things to get stuck,"
    } ]
  }, {
    "tStartMs": 599520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and perhaps more importantly,"
    } ]
  }, {
    "tStartMs": 600880,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "it allows people to\nsafely step off forwards."
    } ]
  }, {
    "tStartMs": 605600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But the comb plate doesn't\nentirely solve the problem."
    } ]
  }, {
    "tStartMs": 608320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "We still have these gaps on\nthe side of the escalator"
    } ]
  }, {
    "tStartMs": 610880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that can pinch and trap\nobjects as the steps move."
    } ]
  }, {
    "tStartMs": 613840,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "So to address this,"
    } ]
  }, {
    "tStartMs": 614960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "a new safety feature called\nthe skirt brush was added"
    } ]
  }, {
    "tStartMs": 617200,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "to the escalator in 1982."
    } ]
  }, {
    "tStartMs": 621360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Escalators are full of subtle\nsafety features like this,"
    } ]
  }, {
    "tStartMs": 624400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "some old and some new,"
    } ]
  }, {
    "tStartMs": 625920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but almost all of them are\ndesigned around people."
    } ]
  }, {
    "tStartMs": 628480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "All the way back in 1896,\nJesse Reno predicted"
    } ]
  }, {
    "tStartMs": 631280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "that riders on his attraction\nwould need something"
    } ]
  }, {
    "tStartMs": 633360,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to hold onto, so he\nintroduced a moving handrail."
    } ]
  }, {
    "tStartMs": 636720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "In a modern escalator, the\nmotor has a separate connection"
    } ]
  }, {
    "tStartMs": 639840,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "to turn a friction wheel\nthat drives the handrail."
    } ]
  }, {
    "tStartMs": 643440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The only problem is that\nfriction wears things down."
    } ]
  }, {
    "tStartMs": 646560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So over time, the wheel gets smaller,"
    } ]
  }, {
    "tStartMs": 648960,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and as its circumference decreases,"
    } ]
  }, {
    "tStartMs": 651280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "each rotation moves the\nrubber loop a slightly shorter"
    } ]
  }, {
    "tStartMs": 654320,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "distance, so the handrail\nbegins to move more slowly."
    } ]
  }, {
    "tStartMs": 658240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The effect is small, but\nit builds up over time."
    } ]
  }, {
    "tStartMs": 661040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So to compensate for this,\na new handrail is calibrated"
    } ]
  }, {
    "tStartMs": 664240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to move around 2% faster than the steps."
    } ]
  }, {
    "tStartMs": 667600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "You can actually try this yourself."
    } ]
  }, {
    "tStartMs": 669280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Next time you're standing on an escalator,"
    } ]
  }, {
    "tStartMs": 671200,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "just place your hand next\nto you as you stand still,"
    } ]
  }, {
    "tStartMs": 674480,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and you will watch as your\nhand slowly drifts forward."
    } ]
  }, {
    "tStartMs": 678560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This speed difference stops the handrail"
    } ]
  }, {
    "tStartMs": 680720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "from lagging too far\nbehind the steps over time."
    } ]
  }, {
    "tStartMs": 683760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "- Because I have definitely noticed that,"
    } ]
  }, {
    "tStartMs": 686480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that sometimes I'm on an escalator"
    } ]
  }, {
    "tStartMs": 688400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and then it's going faster than me."
    } ]
  }, {
    "tStartMs": 690880,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "My hand is going faster than my body,"
    } ]
  }, {
    "tStartMs": 694560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "but that means it's a new escalator."
    } ]
  }, {
    "tStartMs": 696120,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Well, it's a new frictional wheel."
    } ]
  }, {
    "tStartMs": 698880,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "That wheel that drives the\nhand, we don't replace,"
    } ]
  }, {
    "tStartMs": 703840,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "we don't replace the entire escalator."
    } ]
  }, {
    "tStartMs": 705760,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "- Oh, wow, so that's like\na party trick I can use"
    } ]
  }, {
    "tStartMs": 709520,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "to entertain my friends."
    } ]
  }, {
    "tStartMs": 710640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I mean, I don't know when I'd\nhave a party on an escalator,"
    } ]
  }, {
    "tStartMs": 712720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "but whatever, if I'm on an\nescalator with my friends"
    } ]
  }, {
    "tStartMs": 715360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and I can see it moving, I'd be like,"
    } ]
  }, {
    "tStartMs": 717200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "\"Hey, that's 'cause there's\na new frictional wheel.\""
    } ]
  }, {
    "tStartMs": 720080,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "I can tell them that and impress them."
    } ]
  }, {
    "tStartMs": 723440,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "- But it's not just the handrail."
    } ]
  }, {
    "tStartMs": 726720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The speed of the steps\nthemselves is also something"
    } ]
  }, {
    "tStartMs": 729040,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "that needs to be carefully controlled."
    } ]
  }, {
    "tStartMs": 730680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And modern escalators\nuse AC induction motors,"
    } ]
  }, {
    "tStartMs": 733680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "which are extremely good at regulating"
    } ]
  }, {
    "tStartMs": 735600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "their rotational speed."
    } ]
  }, {
    "tStartMs": 737360,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "And this has an unexpected\nbenefit on downward escalators."
    } ]
  }, {
    "tStartMs": 742080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "With enough people riding,\ntheir weight is enough"
    } ]
  }, {
    "tStartMs": 744800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "that the motor no longer\nhas to power the ride."
    } ]
  }, {
    "tStartMs": 747680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Instead, the weight of\nthe passengers themselves"
    } ]
  }, {
    "tStartMs": 750560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "drives the chain and\ncauses the motor to spin."
    } ]
  }, {
    "tStartMs": 753280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "As more people board, the\nforce on the motor increases,"
    } ]
  }, {
    "tStartMs": 756320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and it's pushed to turn faster."
    } ]
  }, {
    "tStartMs": 758720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But modern AC induction motors work"
    } ]
  }, {
    "tStartMs": 760640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "by creating a rotating magnetic field."
    } ]
  }, {
    "tStartMs": 762800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "When the motor tries to\nspin faster than the field,"
    } ]
  }, {
    "tStartMs": 765200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "electric currents are induced inside it,"
    } ]
  }, {
    "tStartMs": 767200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "which then create their\nown magnetic field."
    } ]
  }, {
    "tStartMs": 769680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "This new field pushes back\nin the opposite direction"
    } ]
  }, {
    "tStartMs": 772000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to the spin, creating a braking force,"
    } ]
  }, {
    "tStartMs": 774320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "which resists the increase in speed."
    } ]
  }, {
    "tStartMs": 778160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But something interesting\nhappens when the motor resists"
    } ]
  }, {
    "tStartMs": 780880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "like this, rather than consuming energy,"
    } ]
  }, {
    "tStartMs": 783840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "the physics of the motor flips"
    } ]
  }, {
    "tStartMs": 785440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and it uses the excess mechanical energy"
    } ]
  }, {
    "tStartMs": 787760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to produce an electric current."
    } ]
  }, {
    "tStartMs": 789840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "This is called regenerative braking,"
    } ]
  }, {
    "tStartMs": 791600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and it's the same trick\nthat electric vehicles use"
    } ]
  }, {
    "tStartMs": 793840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to recharge their batteries."
    } ]
  }, {
    "tStartMs": 795680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "In effect, the motor\nturns into a generator."
    } ]
  }, {
    "tStartMs": 798720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The result is that on a busy day,"
    } ]
  }, {
    "tStartMs": 800800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "many modern downward escalators\naren't just moving people,"
    } ]
  }, {
    "tStartMs": 803920,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "they're actually generating electricity."
    } ]
  }, {
    "tStartMs": 806400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Often this is channeled back\nto the building's internal grid"
    } ]
  }, {
    "tStartMs": 809360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and used to power other devices,"
    } ]
  }, {
    "tStartMs": 811200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "including the upward escalators."
    } ]
  }, {
    "tStartMs": 812880,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "- So even the escalator\nthat was invented"
    } ]
  }, {
    "tStartMs": 818080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "by George Wheeler"
    } ]
  }, {
    "tStartMs": 819360,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and was installed in 1920,\nthe Paris Exhibition,"
    } ]
  }, {
    "tStartMs": 824240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "et cetera, I mean, all these\nescalators were regenerators."
    } ]
  }, {
    "tStartMs": 827520,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "- What?"
    } ]
  }, {
    "tStartMs": 828080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- Yeah, when there were people standing"
    } ]
  }, {
    "tStartMs": 829920,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "on the escalator in down direction,"
    } ]
  }, {
    "tStartMs": 832400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "these escalators were feeding\nenergy back into the grid."
    } ]
  }, {
    "tStartMs": 835840,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "- No, it's like the down\nescalator's a generator?"
    } ]
  }, {
    "tStartMs": 839800,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "- This regenerative braking"
    } ]
  }, {
    "tStartMs": 842080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "makes escalators\nextremely power efficient,"
    } ]
  }, {
    "tStartMs": 844880,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "but more importantly,"
    } ]
  }, {
    "tStartMs": 845920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "it makes them inherently safe."
    } ]
  }, {
    "tStartMs": 848480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "But there is a point where\nif you keep adding weight,"
    } ]
  }, {
    "tStartMs": 851280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "then eventually the\nforce becomes so strong"
    } ]
  }, {
    "tStartMs": 853280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "that the motor can no longer resist it."
    } ]
  }, {
    "tStartMs": 855600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And if left unchecked,"
    } ]
  }, {
    "tStartMs": 856800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "it would start accelerating\nuncontrollably."
    } ]
  }, {
    "tStartMs": 859600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The stairs would go plummeting down,"
    } ]
  }, {
    "tStartMs": 862800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "which is exactly what happened in Rome."
    } ]
  }, {
    "tStartMs": 865920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "After a nearly two year\nlong investigation,"
    } ]
  }, {
    "tStartMs": 868160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the investigators published\nthis 86 page report."
    } ]
  }, {
    "tStartMs": 871520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Inside it lists the\nexact sequence of events"
    } ]
  }, {
    "tStartMs": 874000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that led to the disaster."
    } ]
  }, {
    "tStartMs": 876160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "As fans crowded onto the escalator,"
    } ]
  }, {
    "tStartMs": 878240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "their combined weight increased\nthe load on the main motor."
    } ]
  }, {
    "tStartMs": 881280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The motor tried to resist this change,"
    } ]
  }, {
    "tStartMs": 883040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but as more and more people funneled on,"
    } ]
  }, {
    "tStartMs": 885040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the force got too high,"
    } ]
  }, {
    "tStartMs": 886720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and eventually it hit a tipping point"
    } ]
  }, {
    "tStartMs": 888480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and the motor started\naccelerating uncontrollably."
    } ]
  }, {
    "tStartMs": 892080,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Safety sensors in the machine\nnoticed this sudden change"
    } ]
  }, {
    "tStartMs": 895040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and triggered two things\nin short succession."
    } ]
  }, {
    "tStartMs": 897440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "At first, the power to the motor was cut,"
    } ]
  }, {
    "tStartMs": 900160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and immediately after that,\nthe main brake engaged."
    } ]
  }, {
    "tStartMs": 903600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Two massive arms clamped down on the drum"
    } ]
  }, {
    "tStartMs": 906240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "to lock it in place and avert a runaway."
    } ]
  }, {
    "tStartMs": 910800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "This break should have\nhad enough stopping power"
    } ]
  }, {
    "tStartMs": 913040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to bring the fully loaded\nescalator to a halt,"
    } ]
  }, {
    "tStartMs": 915600,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "even under the massive\nstrain, but it didn't."
    } ]
  }, {
    "tStartMs": 919280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Tests after the incident showed"
    } ]
  }, {
    "tStartMs": 920880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "that its braking force was\nfar too low, around 37%"
    } ]
  }, {
    "tStartMs": 924720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "of the manufacturer's specification."
    } ]
  }, {
    "tStartMs": 927920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The weakened brake struggled\nto slow the spinning motor"
    } ]
  }, {
    "tStartMs": 930560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and the escalators downhill\nacceleration continued."
    } ]
  }, {
    "tStartMs": 934560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This is when the last\nline of defense kicked in."
    } ]
  }, {
    "tStartMs": 937360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "When the escalator speed\nrose by more than 20%,"
    } ]
  }, {
    "tStartMs": 940240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the auxiliary brake triggered\ndriving steel wedges"
    } ]
  }, {
    "tStartMs": 943280,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "into a disc on the drive shaft."
    } ]
  }, {
    "tStartMs": 946000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But when investigators\nopened up this brake,"
    } ]
  }, {
    "tStartMs": 948160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "they were shocked."
    } ]
  }, {
    "tStartMs": 949520,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "The final mechanical backstop\nhad been partially disabled."
    } ]
  }, {
    "tStartMs": 953440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Someone had physically tied plastic straps"
    } ]
  }, {
    "tStartMs": 956240,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "around one of the two brake\nwedges and rendered it useless."
    } ]
  }, {
    "tStartMs": 962800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "(dramatic music)\nWith half the system unable to engage,"
    } ]
  }, {
    "tStartMs": 964880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "its stopping power was cut by 50%,"
    } ]
  }, {
    "tStartMs": 967280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "just enough for the weight\nof all those passengers"
    } ]
  }, {
    "tStartMs": 970240,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "to overpower the brake"
    } ]
  }, {
    "tStartMs": 971520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and render the last\nline of defense useless."
    } ]
  }, {
    "tStartMs": 975600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Investigators knew that these failures"
    } ]
  }, {
    "tStartMs": 977920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "should have been automatically recorded"
    } ]
  }, {
    "tStartMs": 979680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "in the error logs,"
    } ]
  }, {
    "tStartMs": 981360,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "but when they went to\ncheck, they found nothing."
    } ]
  }, {
    "tStartMs": 985040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The error codes had been turned off."
    } ]
  }, {
    "tStartMs": 987120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Meaning critical malfunctions could occur"
    } ]
  }, {
    "tStartMs": 989040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "without leaving a trace."
    } ]
  }, {
    "tStartMs": 990880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The only way this could happen\nwas if they had been disabled"
    } ]
  }, {
    "tStartMs": 993440,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "on purpose, meaning someone\nmust have reprogrammed"
    } ]
  }, {
    "tStartMs": 996400,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "the system to stop recording fault codes."
    } ]
  }, {
    "tStartMs": 1000480,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Next investigators turn to\nthe maintenance records,"
    } ]
  }, {
    "tStartMs": 1004240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but they found these similarly incomplete"
    } ]
  }, {
    "tStartMs": 1006800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and evidence of major\nwork on the escalator"
    } ]
  }, {
    "tStartMs": 1008800,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "was nowhere to be found at all."
    } ]
  }, {
    "tStartMs": 1012320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "With all the main safety\nsystems compromised"
    } ]
  }, {
    "tStartMs": 1014640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and critical alerts turned off,"
    } ]
  }, {
    "tStartMs": 1016720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the escalator had been\na ticking time bomb."
    } ]
  }, {
    "tStartMs": 1019760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "All findings from the\ntechnical investigation"
    } ]
  }, {
    "tStartMs": 1021680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "pointed not to a manufacturing defect,"
    } ]
  }, {
    "tStartMs": 1024240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "but to a pattern of neglect"
    } ]
  }, {
    "tStartMs": 1025760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and falsification by those in charge"
    } ]
  }, {
    "tStartMs": 1027680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "of keeping the machine safe."
    } ]
  }, {
    "tStartMs": 1029760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "This left the prosecution\nwith one clear question,"
    } ]
  }, {
    "tStartMs": 1033200,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "who was responsible?"
    } ]
  }, {
    "tStartMs": 1036960,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "The trail of evidence led back"
    } ]
  }, {
    "tStartMs": 1038320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "to June, 2017 when\nmaintenance responsibilities"
    } ]
  }, {
    "tStartMs": 1041360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "for Rome's escalators shifted"
    } ]
  }, {
    "tStartMs": 1043120,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to a new contractor, Metro Roma."
    } ]
  }, {
    "tStartMs": 1046080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The Transit Authority\nATAC severed its contract"
    } ]
  }, {
    "tStartMs": 1048640,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "with Metro Roma in an attempt"
    } ]
  }, {
    "tStartMs": 1050080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to wash its hands of the situation."
    } ]
  }, {
    "tStartMs": 1052240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But as the criminal inquest\ncontinued, it became clear"
    } ]
  }, {
    "tStartMs": 1054960,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that the problem went far deeper."
    } ]
  }, {
    "tStartMs": 1057440,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "The investigators discovered"
    } ]
  }, {
    "tStartMs": 1058800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that Metro Roma had been\nworking hand in hand"
    } ]
  }, {
    "tStartMs": 1061200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with the Transit Authority ATAC,"
    } ]
  }, {
    "tStartMs": 1063360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and together they presided\nover negligent maintenance"
    } ]
  }, {
    "tStartMs": 1066080,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and falsified records\nall across the network."
    } ]
  }, {
    "tStartMs": 1069280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "By September 2019, 11 suspects were named"
    } ]
  }, {
    "tStartMs": 1072400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and the courts had suspended\nthree ATAC managers"
    } ]
  }, {
    "tStartMs": 1075200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "along with the chief of Metro Roma."
    } ]
  }, {
    "tStartMs": 1078400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The prosecution's findings were grave."
    } ]
  }, {
    "tStartMs": 1081120,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "In many cases,"
    } ]
  }, {
    "tStartMs": 1082160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "safety devices had been\ndeliberately sabotaged"
    } ]
  }, {
    "tStartMs": 1084640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to avoid escalator shutdowns,"
    } ]
  }, {
    "tStartMs": 1086880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and those in charge had\ncovered their tracks"
    } ]
  }, {
    "tStartMs": 1089040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "through a pattern of\nfraud and obstruction."
    } ]
  }, {
    "tStartMs": 1091760,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "In the midst of the public outrage,"
    } ]
  }, {
    "tStartMs": 1093600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "prosecutors recorded a chilling wiretap"
    } ]
  }, {
    "tStartMs": 1095920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "of ATAC Manager Renato Domico."
    } ]
  }, {
    "tStartMs": 1098720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The translation, \"If you run the numbers,"
    } ]
  }, {
    "tStartMs": 1100880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "\"out of 700 escalators,\nthere'd be like three"
    } ]
  }, {
    "tStartMs": 1103360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "\"or four more dropping. Come on.\""
    } ]
  }, {
    "tStartMs": 1105920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The prosecutors note in their report"
    } ]
  }, {
    "tStartMs": 1107360,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that Domico appeared\nuninterested in the possibility"
    } ]
  }, {
    "tStartMs": 1110080,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "there might have been people"
    } ]
  }, {
    "tStartMs": 1111040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "on those three or four escalators."
    } ]
  }, {
    "tStartMs": 1113440,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "It was simply a matter of\nnumbers and percentages to him."
    } ]
  }, {
    "tStartMs": 1117120,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "It was a callous remark"
    } ]
  }, {
    "tStartMs": 1118160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and it painted a clear\npicture of the incident."
    } ]
  }, {
    "tStartMs": 1121200,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "This wasn't an engineering\nfailure, it was a human one."
    } ]
  }, {
    "tStartMs": 1127120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "But that brings us to a\nmore fundamental question."
    } ]
  }, {
    "tStartMs": 1129600,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I mean, how safe are escalators really?"
    } ]
  }, {
    "tStartMs": 1132480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The truth is when they're\nproperly maintained,"
    } ]
  }, {
    "tStartMs": 1134640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the safety margins on\nescalators are enormous."
    } ]
  }, {
    "tStartMs": 1137280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Each system is engineered\nto handle forces far beyond"
    } ]
  }, {
    "tStartMs": 1140320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "what they'll ever see in service."
    } ]
  }, {
    "tStartMs": 1142080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "- So the breaking load"
    } ]
  }, {
    "tStartMs": 1143920,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "of our step is like greater\n15 kilonewtons to 1.5 tons."
    } ]
  }, {
    "tStartMs": 1148960,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "So you can put an elephant on\nthe step and it won't break."
    } ]
  }, {
    "tStartMs": 1152427,
    "dDurationMs": 4293,
    "segs": [ {
      "utf8": "Well, I've never seen a step\nbreak in my work career."
    } ]
  }, {
    "tStartMs": 1156720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Never seen a step chain break either."
    } ]
  }, {
    "tStartMs": 1158720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "I mean, it's does not happen."
    } ]
  }, {
    "tStartMs": 1161200,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I mean, I'm not here to say\nthat there are no accidents"
    } ]
  }, {
    "tStartMs": 1164480,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "on an escalator, but the accidents I know,"
    } ]
  }, {
    "tStartMs": 1169200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "I mean, it's critical like that you,"
    } ]
  }, {
    "tStartMs": 1172720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that you ensure the right maintenance."
    } ]
  }, {
    "tStartMs": 1175520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That's the most important thing,"
    } ]
  }, {
    "tStartMs": 1177440,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "because in the end, it's\nall about maintenance."
    } ]
  }, {
    "tStartMs": 1181240,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "- When this is done right,"
    } ]
  }, {
    "tStartMs": 1183440,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "the chances of a catastrophic\nfailure are vanishingly small"
    } ]
  }, {
    "tStartMs": 1187520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and with around 1.5 million\nescalators worldwide,"
    } ]
  }, {
    "tStartMs": 1190640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "that really is how it should be."
    } ]
  }, {
    "tStartMs": 1192880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "In the US and Canada alone,"
    } ]
  }, {
    "tStartMs": 1194640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "over a hundred billion escalator trips"
    } ]
  }, {
    "tStartMs": 1197200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "are happening every year,"
    } ]
  }, {
    "tStartMs": 1198720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "making the escalator one of\nthe most widely used forms"
    } ]
  }, {
    "tStartMs": 1201440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "of transport on the planet."
    } ]
  }, {
    "tStartMs": 1203280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "On a scale that large, it's sometimes easy"
    } ]
  }, {
    "tStartMs": 1205680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to point the finger at our\ntechnology when things go wrong."
    } ]
  }, {
    "tStartMs": 1208560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "But the truth is,"
    } ]
  }, {
    "tStartMs": 1209760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "no matter how well\ndesigned our systems are,"
    } ]
  }, {
    "tStartMs": 1212000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "they all rely on people to maintain them."
    } ]
  }, {
    "tStartMs": 1214800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And perhaps that's the lesson here."
    } ]
  }, {
    "tStartMs": 1217200,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "As humans, we have a duty of\ncare, not just to ourselves,"
    } ]
  }, {
    "tStartMs": 1220880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "but to everyone around us."
    } ]
  }, {
    "tStartMs": 1223040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And sometimes that means\ntaking responsibility"
    } ]
  }, {
    "tStartMs": 1225040,
    "dDurationMs": 8640,
    "segs": [ {
      "utf8": "for keeping each other safe."
    } ]
  }, {
    "tStartMs": 1233680,
    "dDurationMs": 80,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 1233760,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "In a way, that's how the\nescalators story began"
    } ]
  }, {
    "tStartMs": 1236640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with one person deciding\nto take responsibility"
    } ]
  }, {
    "tStartMs": 1238960,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "for a problem that everyone else ignored."
    } ]
  }, {
    "tStartMs": 1241520,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Back when Jesse Reno was\nat university, every day,"
    } ]
  }, {
    "tStartMs": 1244320,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "he had to climb more than\n300 steps to get to his frat house."
    } ]
  }, {
    "tStartMs": 1248720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But while everyone else\ncomplained about this,"
    } ]
  }, {
    "tStartMs": 1250640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Reno did something about it."
    } ]
  }, {
    "tStartMs": 1252480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "He had the math, the science,"
    } ]
  }, {
    "tStartMs": 1253840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and most importantly, the\nproblem solving skills"
    } ]
  }, {
    "tStartMs": 1256000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to create the world's\nvery first escalator,"
    } ]
  }, {
    "tStartMs": 1258640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "which he took to Coney Island."
    } ]
  }, {
    "tStartMs": 1260720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So how do you go from a\nfrustrating, everyday problem"
    } ]
  }, {
    "tStartMs": 1263680,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "to an innovation that changes the world?"
    } ]
  }, {
    "tStartMs": 1266000,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Well, that's where today's\nsponsor, Brilliant, comes in."
    } ]
  }, {
    "tStartMs": 1268880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Brilliant is a learning app built"
    } ]
  }, {
    "tStartMs": 1270720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "around interactive problem solving."
    } ]
  }, {
    "tStartMs": 1272640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Whether it's electric\ncircuits, probability,"
    } ]
  }, {
    "tStartMs": 1274800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "or even AI, Brilliant's\ncourses are designed"
    } ]
  }, {
    "tStartMs": 1277520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "to help you build intuition,"
    } ]
  }, {
    "tStartMs": 1279120,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the kind that helps you\nsee the world in new ways."
    } ]
  }, {
    "tStartMs": 1282080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Their unique approach lets\nyou play with concepts"
    } ]
  }, {
    "tStartMs": 1284640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and build your understanding\nfrom the ground up."
    } ]
  }, {
    "tStartMs": 1287200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This is actually my favorite\nway to learn anything,"
    } ]
  }, {
    "tStartMs": 1289840,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "getting hands-on with ideas"
    } ]
  }, {
    "tStartMs": 1291600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "so that you actually understand them."
    } ]
  }, {
    "tStartMs": 1293680,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Plus, it's been proven to be\nup to six times more effective"
    } ]
  }, {
    "tStartMs": 1296720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "than watching lecture videos."
    } ]
  }, {
    "tStartMs": 1298800,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "They're also releasing new"
    } ]
  }, {
    "tStartMs": 1300080,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and updated courses across\nmath, science, coding, data,"
    } ]
  }, {
    "tStartMs": 1303120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "technology, you name it."
    } ]
  }, {
    "tStartMs": 1304800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So there is always\nsomething new to dive into."
    } ]
  }, {
    "tStartMs": 1307520,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The best part is you can\nstart learning on Brilliant"
    } ]
  }, {
    "tStartMs": 1310080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "for free right now."
    } ]
  }, {
    "tStartMs": 1311440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Just go to brilliant.org/veritasium."
    } ]
  }, {
    "tStartMs": 1314240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "You can scan this QR code"
    } ]
  }, {
    "tStartMs": 1315920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "or click the link that I'll\nput down in the description."
    } ]
  }, {
    "tStartMs": 1319040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Brilliant has also given\nour viewers 20% off"
    } ]
  }, {
    "tStartMs": 1321600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "an annual premium subscription,"
    } ]
  }, {
    "tStartMs": 1323360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "which gives you unlimited daily access"
    } ]
  }, {
    "tStartMs": 1325200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to everything they have to offer."
    } ]
  }, {
    "tStartMs": 1326960,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So I wanna thank Brilliant\nfor sponsoring this video,"
    } ]
  }, {
    "tStartMs": 1329120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and I wanna thank you for watching."
    } ]
  } ]
}
