{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 30,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "On July 20th, fifty years ago"
    } ]
  }, {
    "tStartMs": 2900,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Neil Armstrong and Buzz Lightyear first set foot on the moon."
    } ]
  }, {
    "tStartMs": 6680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But before they went there, they came here."
    } ]
  }, {
    "tStartMs": 9680,
    "dDurationMs": 6260,
    "segs": [ {
      "utf8": "This is Sedan Crater and it was excavated by a nuclear bomb in 1962."
    } ]
  }, {
    "tStartMs": 15940,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "[bomb explodes]"
    } ]
  }, {
    "tStartMs": 18400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's part of the Nevada Test Site,"
    } ]
  }, {
    "tStartMs": 20800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "an area of desert bigger than Rhode Island."
    } ]
  }, {
    "tStartMs": 23840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "-- [broadcast] located 70 miles [110 km] northwest of Las Vegas --"
    } ]
  }, {
    "tStartMs": 27120,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "Here, the U.S. performed 928 nuclear explosions."
    } ]
  }, {
    "tStartMs": 33240,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "And from 1965, they trained Apollo astronauts"
    } ]
  }, {
    "tStartMs": 37040,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "like Neil Armstrong and Buzz Aldrin before their trips to the moon."
    } ]
  }, {
    "tStartMs": 41600,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "In the following years, astronauts returned with spacesuit mock-ups and TV cameras."
    } ]
  }, {
    "tStartMs": 47120,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "They even tested out a mock-up of the lunar roving vehicle."
    } ]
  }, {
    "tStartMs": 50920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Over a period of seven years,"
    } ]
  }, {
    "tStartMs": 53200,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "11 of the 12 men who would eventually walk on the moon visited this site."
    } ]
  }, {
    "tStartMs": 58320,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "So why would you bring Apollo astronauts to a nuclear bomb test site?"
    } ]
  }, {
    "tStartMs": 64040,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "That's what we're gonna find out."
    } ]
  }, {
    "tStartMs": 66500,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "[♫]"
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The obvious reason is because the moon is covered in craters,"
    } ]
  }, {
    "tStartMs": 70680,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "so the astronauts needed experience in cratered terrain,"
    } ]
  }, {
    "tStartMs": 74400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "but there were other locations available,"
    } ]
  }, {
    "tStartMs": 77360,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "like Barringer Crater in Arizona,"
    } ]
  }, {
    "tStartMs": 79720,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "claimed to be the site of a meteorite impact, though its origins were disputed until the 1960s."
    } ]
  }, {
    "tStartMs": 86280,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "In another part of Arizona, scientists used conventional explosives"
    } ]
  }, {
    "tStartMs": 90800,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "to recreate the exact pattern of craters on the moon around the Apollo 11 landing site."
    } ]
  }, {
    "tStartMs": 96560,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Now the astronauts did train at both of these sites,"
    } ]
  }, {
    "tStartMs": 100040,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "but the Nevada Test Site provided something extra."
    } ]
  }, {
    "tStartMs": 104080,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "[♫ brassy fanfare ♫]"
    } ]
  }, {
    "tStartMs": 110800,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "-- Put on your goggles --"
    } ]
  }, {
    "tStartMs": 111980,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "The Nevada Test Site was commissioned in 1951 as a place to test nuclear explosions."
    } ]
  }, {
    "tStartMs": 117880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The goal was not only to develop better bombs,"
    } ]
  }, {
    "tStartMs": 120760,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "but also to understand how homes and household items could be made to withstand a nuclear blast."
    } ]
  }, {
    "tStartMs": 126280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "-- Five... --"
    } ]
  }, {
    "tStartMs": 127280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "-- Four... --"
    } ]
  }, {
    "tStartMs": 128480,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "-- Three... --"
    } ]
  }, {
    "tStartMs": 129760,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "--Two... --"
    } ]
  }, {
    "tStartMs": 131210,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "-- One... --"
    } ]
  }, {
    "tStartMs": 132000,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "-- Zero. --"
    } ]
  }, {
    "tStartMs": 132540,
    "dDurationMs": 14260,
    "segs": [ {
      "utf8": "[bomb explodes]"
    } ]
  }, {
    "tStartMs": 147120,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "A hundred tests were conducted above ground before the Nuclear Test Ban Treaty was signed in 1963."
    } ]
  }, {
    "tStartMs": 153920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It banned testing in the atmosphere,"
    } ]
  }, {
    "tStartMs": 156720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "outer space, and under water,"
    } ]
  }, {
    "tStartMs": 159240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "leaving only underground testing."
    } ]
  }, {
    "tStartMs": 161760,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Like the blast that formed Sedan Crater:"
    } ]
  }, {
    "tStartMs": 164680,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "a 1 meter wide hole was drilled down into the ground right here, 635 feet [194 m] deep,"
    } ]
  }, {
    "tStartMs": 172040,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and that is where they located a nuclear bomb."
    } ]
  }, {
    "tStartMs": 176280,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "It was a 104-kiloton [440 TJ] device."
    } ]
  }, {
    "tStartMs": 179600,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "That means the energy released was equivalent to 104,000 tons of TNT,"
    } ]
  }, {
    "tStartMs": 185680,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "roughly eight times as big as the bomb dropped on Hiroshima."
    } ]
  }, {
    "tStartMs": 189360,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "--  [broadcast] This close-up view was taken from a ground station three miles [5 km] from ground zero."
    } ]
  }, {
    "tStartMs": 195320,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "The dome rose to a height of 290 feet [88.4 m] before it vented at three seconds. --"
    } ]
  }, {
    "tStartMs": 203160,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "It excavated 12 million tons [11 Mt] of dirt and rock,"
    } ]
  }, {
    "tStartMs": 207800,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "forming what is the largest man-made crater in North America."
    } ]
  }, {
    "tStartMs": 212200,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "In fact it's the second biggest in the world after Chagan Crater in Russia."
    } ]
  }, {
    "tStartMs": 216440,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "It's about 400 meters in diameter and nearly 100 meters deep."
    } ]
  }, {
    "tStartMs": 221920,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This was part of an operation called \"Plowshare.\""
    } ]
  }, {
    "tStartMs": 224680,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "--  [broadcast] The United States is conducting, for the benefit of all nations, a program it calls \"Plowshare.\" --"
    } ]
  }, {
    "tStartMs": 231120,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "[♫ momentous fanfare ♫]"
    } ]
  }, {
    "tStartMs": 234680,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "With the idea being, if you need to form a big hole somewhere,"
    } ]
  }, {
    "tStartMs": 238360,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "let's say you're making a huge construction project, maybe a canal,"
    } ]
  }, {
    "tStartMs": 242120,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "could you use nuclear weapons to excavate that dirt?"
    } ]
  }, {
    "tStartMs": 247480,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "[♫]\n-- [broadcast] Enormous energy, relatively inexpensive, compact, and easily transportable."
    } ]
  }, {
    "tStartMs": 249660,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "-- [broadcast] Enormous energy, relatively inexpensive, compact, and easily transportable."
    } ]
  }, {
    "tStartMs": 254120,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "This is the new power tool that \"Plowshare\" would add to Man's resources of useful energy,"
    } ]
  }, {
    "tStartMs": 259960,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "to do jobs never before practical or even possible. --"
    } ]
  }, {
    "tStartMs": 263560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "As you can see, it's a pretty good excavator."
    } ]
  }, {
    "tStartMs": 266040,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "But later, they found out that it's very hard to reduce the contamination,"
    } ]
  }, {
    "tStartMs": 270400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the radioactive contamination that results"
    } ]
  }, {
    "tStartMs": 272480,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "from a nuclear explosion and so the operation was effectively canceled."
    } ]
  }, {
    "tStartMs": 277160,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "But what they had created was the closest thing you can get to a meteorite impact crater."
    } ]
  }, {
    "tStartMs": 282800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And that seems a bit weird,"
    } ]
  }, {
    "tStartMs": 284240,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "because I mean when I think about meteor impacts,"
    } ]
  }, {
    "tStartMs": 287080,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "I imagine these sort of compressions of a big rock coming in and pushing the dirt out of the way."
    } ]
  }, {
    "tStartMs": 293720,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "But that's not actually how it works."
    } ]
  }, {
    "tStartMs": 295760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Meteors are typically going incredibly fast,"
    } ]
  }, {
    "tStartMs": 299040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "like 10 or 20 kilometers per second,\n[♫]"
    } ]
  }, {
    "tStartMs": 302240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "so when one strikes the ground,"
    } ]
  }, {
    "tStartMs": 304600,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "it creates an incredibly hot, dense, high-pressure region at the site of the impact."
    } ]
  }, {
    "tStartMs": 310760,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "This melts and vaporizes rock."
    } ]
  }, {
    "tStartMs": 313840,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "A shockwave traveling out from the point of contact"
    } ]
  }, {
    "tStartMs": 316680,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "transforms minerals due to the extreme pressure."
    } ]
  }, {
    "tStartMs": 320400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "As the high-pressure region decompresses,"
    } ]
  }, {
    "tStartMs": 323280,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "it creates what is essentially a huge explosion,"
    } ]
  }, {
    "tStartMs": 327160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and it is this explosion that creates the crater."
    } ]
  }, {
    "tStartMs": 330520,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Something you might notice if you look at craters is they're almost always circular."
    } ]
  }, {
    "tStartMs": 335720,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "But if you think about it, meteors impact from all sorts of different angles."
    } ]
  }, {
    "tStartMs": 339880,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "The reason you're seeing a circle is because"
    } ]
  }, {
    "tStartMs": 342540,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "really, a meteor impact is an explosion."
    } ]
  }, {
    "tStartMs": 346400,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "That is what forms the crater."
    } ]
  }, {
    "tStartMs": 347680,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "It's not the impact, otherwise you would see all sorts of weird, oblong-shaped craters."
    } ]
  }, {
    "tStartMs": 352520,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Nuclear explosions are so much like meteorite impacts,"
    } ]
  }, {
    "tStartMs": 356280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "that craters on this test site provided the definitive evidence"
    } ]
  }, {
    "tStartMs": 360280,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "confirming that Barringer Crater was in fact the result of an impact."
    } ]
  }, {
    "tStartMs": 364840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Scientists compared samples from both sites"
    } ]
  }, {
    "tStartMs": 367840,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "and found the same shocked minerals, like coesite, a shocked form of quartz."
    } ]
  }, {
    "tStartMs": 373640,
    "dDurationMs": 7840,
    "segs": [ {
      "utf8": "This mineral can only be formed under the intense pressure of a meteorite impact, or a nuclear explosion."
    } ]
  }, {
    "tStartMs": 381480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Further similarities with nuclear test craters"
    } ]
  }, {
    "tStartMs": 384200,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "allowed scientists to estimate that the energy of impact was around 10 megatons."
    } ]
  }, {
    "tStartMs": 389440,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "That's the size of a fairly big thermonuclear detonation."
    } ]
  }, {
    "tStartMs": 393160,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Another similarity is in how these cratering events excavate rock."
    } ]
  }, {
    "tStartMs": 397440,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "All of this dirt got excavated out of here—\n12 million tons [11 Mt]—"
    } ]
  }, {
    "tStartMs": 401960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and it was ejected out and over the rim,"
    } ]
  }, {
    "tStartMs": 405080,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "and what actually happens in that process is the layers of rock actually get turned over at the rim"
    } ]
  }, {
    "tStartMs": 411400,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It's called inverted stratigraphy"
    } ]
  }, {
    "tStartMs": 413720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "This is a telltale sign of meteorite impacts and nuclear explosions"
    } ]
  }, {
    "tStartMs": 418640,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and it helped the astronauts know, when they collected samples on the moon,"
    } ]
  }, {
    "tStartMs": 422320,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "what to look for and where."
    } ]
  }, {
    "tStartMs": 424280,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Something I was surprised to learn was that Apollo astronauts actually spent"
    } ]
  }, {
    "tStartMs": 428360,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "25%, or a full quarter, of their final year before blasting off to the moon studying science,"
    } ]
  }, {
    "tStartMs": 435800,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "visiting sites like this one where they could learn about geology,"
    } ]
  }, {
    "tStartMs": 439360,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "about their rocks and minerals, and the formations that they should look for when they're on the moon."
    } ]
  }, {
    "tStartMs": 445480,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And I guess it makes sense,"
    } ]
  }, {
    "tStartMs": 447600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "because these were scientific missions."
    } ]
  }, {
    "tStartMs": 450720,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But they weren't conducted by professional scientists."
    } ]
  }, {
    "tStartMs": 453480,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "By and large, the Apollo astronauts were expert pilots."
    } ]
  }, {
    "tStartMs": 457560,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "As Apollo 11 blasted off, the astronauts were journeying into the unknown—literally."
    } ]
  }, {
    "tStartMs": 464640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "We knew so little about the moon,"
    } ]
  }, {
    "tStartMs": 467680,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "like how it formed, what it was made of, and whether or not it was volcanically active."
    } ]
  }, {
    "tStartMs": 473620,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "(-- All engines run.)"
    } ]
  }, {
    "tStartMs": 475400,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "(We have a liftoff! --)"
    } ]
  }, {
    "tStartMs": 477320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "When the Apollo astronauts were on the moon,"
    } ]
  }, {
    "tStartMs": 479320,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "they actually used some of their training from here."
    } ]
  }, {
    "tStartMs": 489400,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "The astronauts were really excited when they found the rocks that they recognized."
    } ]
  }, {
    "tStartMs": 504240,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "In fact, it was probably due to their training here that they were able"
    } ]
  }, {
    "tStartMs": 507820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to recognize those minerals and those rocks,"
    } ]
  }, {
    "tStartMs": 511000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "which were so important to bring back."
    } ]
  }, {
    "tStartMs": 513280,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And to learn not only about the moon's formation, but also about our entire solar system,"
    } ]
  }, {
    "tStartMs": 517600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the formation of all the planets."
    } ]
  }, {
    "tStartMs": 520000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "This is the actual moon dust,"
    } ]
  }, {
    "tStartMs": 523440,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "or lunar regolith, collected by the Apollo 11 astronauts."
    } ]
  }, {
    "tStartMs": 528280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I'm gonna take a look at it under the microscope."
    } ]
  }, {
    "tStartMs": 531080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now since the moon has basically no atmosphere,"
    } ]
  }, {
    "tStartMs": 534200,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "all of this material had never been exposed to oxygen."
    } ]
  }, {
    "tStartMs": 537280,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "So there was some concern that once the astronauts brought it back into their spacecraft"
    } ]
  }, {
    "tStartMs": 543600,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "and introduced some oxygen, that it would spontaneously catch fire."
    } ]
  }, {
    "tStartMs": 548440,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "So Buzz recounts the story of how they were ready to throw all the samples out if that were to happen."
    } ]
  }, {
    "tStartMs": 554880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But, of course, thankfully nothing did happen"
    } ]
  }, {
    "tStartMs": 557640,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "when they brought those samples in and re-pressurized the lunar module."
    } ]
  }, {
    "tStartMs": 561720,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Amongst the dark lunar dust that Apollo 11 brought back,"
    } ]
  }, {
    "tStartMs": 565280,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "scientists identified tiny flecks of a light-colored rock,"
    } ]
  }, {
    "tStartMs": 569560,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "which they immediately identified as anorthosite."
    } ]
  }, {
    "tStartMs": 572960,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "And that was an important discovery,"
    } ]
  }, {
    "tStartMs": 574840,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "because it supported the theory that in the past the moon was entirely melted,"
    } ]
  }, {
    "tStartMs": 580040,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "covered in a magma ocean at least a hundred kilometers thick."
    } ]
  }, {
    "tStartMs": 584800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So the idea goes that when anorthosite forms,"
    } ]
  }, {
    "tStartMs": 588000,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "when the minerals that make it up crystallize out"
    } ]
  }, {
    "tStartMs": 591160,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "they are less dense than the magma around them, so they float to the surface."
    } ]
  }, {
    "tStartMs": 595240,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "So, the initial surface of the Moon, the primordial surface of the Moon. would have been made of anorthosite,"
    } ]
  }, {
    "tStartMs": 601840,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "and then about a billion years later, there was more volcanic activity on the Moon,"
    } ]
  }, {
    "tStartMs": 606680,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "leading to lava flows over these regions that are darker called the mare."
    } ]
  }, {
    "tStartMs": 611320,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And you can see they have fewer craters on them because, well, they're younger."
    } ]
  }, {
    "tStartMs": 616680,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "So how do you get anorthosite over here in the Sea of Tranquility?"
    } ]
  }, {
    "tStartMs": 621560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Well, that must have happened through giant impacts in the highlands,"
    } ]
  }, {
    "tStartMs": 625880,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "which would have sprayed ejecta all over the Moon."
    } ]
  }, {
    "tStartMs": 629200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And so it got mixed in with the dark soil over here,"
    } ]
  }, {
    "tStartMs": 632720,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "and brought back by the astronauts to my Petri dish where I can look at it today."
    } ]
  }, {
    "tStartMs": 637800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "But anorthosite was just the tip of the iceberg."
    } ]
  }, {
    "tStartMs": 641160,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Inside all of these samples was a subtle clue to how the Moon formed."
    } ]
  }, {
    "tStartMs": 646120,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "Looking at the amounts of different isotopes in a rock can tell you where that rock came from."
    } ]
  }, {
    "tStartMs": 651440,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "And when scientists analyzed the Moon rocks, they found the same isotopic abundances as in Earth rocks."
    } ]
  }, {
    "tStartMs": 658680,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "This is why we believe today that the Earth and Moon formed together,"
    } ]
  }, {
    "tStartMs": 663600,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "from the same event: a giant impact between planets"
    } ]
  }, {
    "tStartMs": 667800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "four-and-a-half billion years ago."
    } ]
  }, {
    "tStartMs": 670800,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Going to the Moon and knowing what to look for taught us not only how the Moon formed,"
    } ]
  }, {
    "tStartMs": 676320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "but also how our Earth formed."
    } ]
  }, {
    "tStartMs": 679040,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "And all this from less than 400 kilograms of Moon rock from the near side of the Moon."
    } ]
  }, {
    "tStartMs": 685280,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "Clearly there is still a lot to learn up there and personally I can't wait until we go back."
    } ]
  }, {
    "tStartMs": 691400,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Who knows what unexpected discoveries are waiting for us when we return."
    } ]
  }, {
    "tStartMs": 699600,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "Hey! This episode of Veritasium was supported by viewers like you on Patreon and by Audible."
    } ]
  }, {
    "tStartMs": 705760,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "You know for the last few weeks I have been re-listening to \"A Man on the Moon\" by Andrew Chaikin."
    } ]
  }, {
    "tStartMs": 711600,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "This book tells the extraordinary story of all of the Apollo missions,"
    } ]
  }, {
    "tStartMs": 716240,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and in such gripping detail that it's really hard to stop listening to it."
    } ]
  }, {
    "tStartMs": 720480,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "I was listening in traffic, on flights, even signing shade balls"
    } ]
  }, {
    "tStartMs": 724680,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Yes, listening to this book is what got me through it."
    } ]
  }, {
    "tStartMs": 727120,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "And there is no better place to listen than Audible."
    } ]
  }, {
    "tStartMs": 730200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Just go to Audible.com/Veritasium"
    } ]
  }, {
    "tStartMs": 734280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "or text \"Veritasium\" to 500-500,"
    } ]
  }, {
    "tStartMs": 736520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and browse their unmatched selection of audio content."
    } ]
  }, {
    "tStartMs": 739880,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Audible members get to choose three titles every month:"
    } ]
  }, {
    "tStartMs": 743280,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "one audiobook plus two Audible originals that you can't hear anywhere else."
    } ]
  }, {
    "tStartMs": 747600,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "On top of that, members get access to audio-guided fitness programs and meditation programs."
    } ]
  }, {
    "tStartMs": 752680,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And for a limited time, Amazon Prime members can start an Audible membership"
    } ]
  }, {
    "tStartMs": 756760,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and save $30 total for the first three months."
    } ]
  }, {
    "tStartMs": 759800,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "That's like getting three months for the price of one."
    } ]
  }, {
    "tStartMs": 762720,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Each month is just $4.95 per month for the first three months,"
    } ]
  }, {
    "tStartMs": 766120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and after that, it's only $14.95 per month."
    } ]
  }, {
    "tStartMs": 769240,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "The offer is valid from July 1st to the 31st of 2019"
    } ]
  }, {
    "tStartMs": 773320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "so I really want to thank Audible for supporting me,"
    } ]
  }, {
    "tStartMs": 775560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and I want to thank you for watching."
    } ]
  } ]
}
