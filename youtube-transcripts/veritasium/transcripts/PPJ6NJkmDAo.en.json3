  }, {
    "tStartMs": 22560,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- Seen these."
    } ]
  }, {
    "tStartMs": 23610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- And we'll start with a\nlittle, like, maybe 100."
