  }, {
    "tStartMs": 84600,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "Ah, oh, I have a new $5 charge."
    } ]
  }, {
    "tStartMs": 90690,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "And it's time stamped right now."
    } ]
  }, {
    "tStartMs": 94950,
    "dDurationMs": 1072,
    "segs": [ {
      "utf8": "I don't like that at all."
    } ]
  }, {
    "tStartMs": 97500,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So, that's concerning."
    } ]
  }, {
    "tStartMs": 99810,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "Oh, so my phone had to be on this thing?"
    } ]
  }, {
    "tStartMs": 101786,
    "dDurationMs": 994,
    "segs": [ {
      "utf8": "- [Henry] Yes."
    } ]
  }, {
    "tStartMs": 102780,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- Did it have to be on this thing?"
    } ]
  }, {
    "tStartMs": 104400,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Or like, near it, I guess?"
    } ]
  }, {
    "tStartMs": 105780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- So the way, well, I\ncould explain how it works-"
    } ]
  }, {
    "tStartMs": 108750,
    "dDurationMs": 1745,
    "segs": [ {
      "utf8": "- Yeah.\n- But maybe before that,"
    } ]
  }, {
    "tStartMs": 110495,
    "dDurationMs": 3235,
    "segs": [ {
      "utf8": "$5, it's not very much.\n- Yeah."
    } ]
  }, {
    "tStartMs": 113730,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Do we want to try upping it a bit?"
    } ]
  }, {
    "tStartMs": 116580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- I..."
    } ]
  }, {
    "tStartMs": 117930,
    "dDurationMs": 2479,
    "segs": [ {
      "utf8": "- I'm gonna enter a\nslightly larger amount."
    } ]
  }, {
    "tStartMs": 120409,
    "dDurationMs": 2291,
    "segs": [ {
      "utf8": "- Careful. Careful with that."
    } ]
  }, {
    "tStartMs": 122700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Careful, careful."
    } ]
  }, {
    "tStartMs": 124200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That's a lot of zeros. Careful with that."
    } ]
  }, {
    "tStartMs": 126360,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Oh my God. Okay."
    } ]
  }, {
    "tStartMs": 128400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "- Do you even think it's\npossible? Firstly, $10,000."
    } ]
  }, {
    "tStartMs": 131280,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "- I mean, the credit, the limit\non the card is above that."
    } ]
  }, {
    "tStartMs": 135150,
    "dDurationMs": 4446,
    "segs": [ {
      "utf8": "I don't know if Apple\nPay will let you do that."
    } ]
  }, {
    "tStartMs": 139596,
    "dDurationMs": 1884,
    "segs": [ {
      "utf8": "- The question is also\nare you used to spending"
    } ]
  }, {
    "tStartMs": 141480,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "this amount of money\non this card, you know?"
    } ]
  }, {
    "tStartMs": 143430,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "- Not from my phone."
    } ]
  }, {
    "tStartMs": 145540,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "It's like a big screen activity."
    } ]
  }, {
    "tStartMs": 147570,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- Yeah.\n- Like, $10,000 purchase,"
    } ]
  }, {
    "tStartMs": 150090,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I gotta be checking everything."
    } ]
  }, {
    "tStartMs": 152010,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So, yeah, no. This would be unusual."
    } ]
  }, {
    "tStartMs": 154260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- Let's see it. Let's see if it works."
    } ]
  }, {
    "tStartMs": 155340,
    "dDurationMs": 1185,
    "segs": [ {
      "utf8": "Okay, I'm gonna do it again."
    } ]
  }, {
    "tStartMs": 156525,
    "dDurationMs": 1065,
    "segs": [ {
      "utf8": "- Okay.\n- We're just,"
    } ]
  }, {
    "tStartMs": 157590,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "all we gotta do again."
    } ]
  }, {
    "tStartMs": 158760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Put your phone locked."
    } ]
  }, {
    "tStartMs": 160050,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Phone-\n- On this device."
    } ]
  }, {
    "tStartMs": 161340,
    "dDurationMs": 3275,
    "segs": [ {
      "utf8": "- Locked on that device."
    } ]
  }, {
    "tStartMs": 164615,
    "dDurationMs": 1618,
    "segs": [ {
      "utf8": "- [Henry] Yes, exactly."
    } ]
  }, {
    "tStartMs": 167100,
    "dDurationMs": 4673,
    "segs": [ {
      "utf8": "And okay, we're gonna\nstart the script again."
    } ]
  }, {
    "tStartMs": 173693,
    "dDurationMs": 991,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 174684,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 184176,
    "dDurationMs": 891,
    "segs": [ {
      "utf8": "(phone chimes)"
    } ]
  }, {
    "tStartMs": 185067,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Marques] Uh-uh."
    } ]
  }, {
    "tStartMs": 185900,
    "dDurationMs": 1363,
    "segs": [ {
      "utf8": "(coins clinking)"
    } ]
  }, {
    "tStartMs": 187263,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Uh-uh. No."
    } ]
  }, {
    "tStartMs": 189240,
    "dDurationMs": 3856,
    "segs": [ {
      "utf8": "- No? (laughs)\n- It's just green. Approved."
    } ]
  }, {
    "tStartMs": 193096,
    "dDurationMs": 2674,
    "segs": [ {
      "utf8": "- Print that out. Print that."
    } ]
  }, {
    "tStartMs": 195770,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "(receipt sprinting)"
    } ]
  }, {
    "tStartMs": 197460,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "That is crazy."
    } ]
  }, {
    "tStartMs": 199760,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "- Oh my God. So, so, yeah,\nI'm gonna need that back."
    } ]
  }, {
    "tStartMs": 204600,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "- Yeah. (laughs)\n- For sure,"
    } ]
  }, {
    "tStartMs": 206030,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "I'm gonna need that back."
    } ]
  }, {
    "tStartMs": 208140,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But also, did that just?"
    } ]
  }, {
    "tStartMs": 209910,
    "dDurationMs": 2857,
    "segs": [ {
      "utf8": "Yeah, wow. It worked."
    } ]
  }, {
    "tStartMs": 212767,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- $10,000."
    } ]
  }, {
    "tStartMs": 213600,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "- All right. I believe you."
    } ]
  }, {
    "tStartMs": 215144,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "I definitely believe you."
    } ]
  }, {
    "tStartMs": 218182,
    "dDurationMs": 1718,
    "segs": [ {
      "utf8": "How do we get this back?"
    } ]
  }, {
    "tStartMs": 219900,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "We do like a little Venmo or like PayPal?"
    } ]
  }, {
    "tStartMs": 222253,
    "dDurationMs": 1037,
    "segs": [ {
      "utf8": "How do we even?\n- You know,"
    } ]
  }, {
    "tStartMs": 223290,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "do we give it back though?\n- Reverse the transaction."
    } ]
  }, {
    "tStartMs": 225690,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I don't even know. Do I call my company?"
    } ]
  }, {
    "tStartMs": 227370,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Yeah, that's crazy.\n- Yeah, exactly."
    } ]
  }, {
    "tStartMs": 229170,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "You can keep this if you wanna-"
    } ]
  }, {
    "tStartMs": 230237,
    "dDurationMs": 974,
    "segs": [ {
      "utf8": "- Yeah.\n- Get it framed."
    } ]
  }, {
    "tStartMs": 231211,
    "dDurationMs": 2706,
    "segs": [ {
      "utf8": "- Yeah. A receipt of the damage."
    } ]
  }, {
    "tStartMs": 233917,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "I never unlock my phone.\nI never put in a password."
    } ]
  }, {
    "tStartMs": 236059,
    "dDurationMs": 1704,
    "segs": [ {
      "utf8": "I never did what I would normally do"
    } ]
  }, {
    "tStartMs": 237763,
    "dDurationMs": 2807,
    "segs": [ {
      "utf8": "to verify a transaction on my phone."
    } ]
  }, {
    "tStartMs": 240570,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Yes.\n- It just happened"
    } ]
  }, {
    "tStartMs": 241680,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "to be on top of that."
    } ]
  }, {
    "tStartMs": 244590,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- So, how did we do it?"
    } ]
  }, {
    "tStartMs": 245910,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Well, we teamed up with\ntwo cybersecurity experts,"
    } ]
  }, {
    "tStartMs": 248460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Professors Ioana Boureanu and Tom Chothia."
    } ]
  }, {
    "tStartMs": 250980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And we went to visit them\nat the University of Surrey,"
    } ]
  }, {
    "tStartMs": 253230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "where they ran us through a\nunique hack that they developed"
    } ]
  }, {
    "tStartMs": 255780,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "to bypass the phone's lock\nscreen and then to drain funds"
    } ]
  }, {
    "tStartMs": 258381,
    "dDurationMs": 2289,
    "segs": [ {
      "utf8": "from inside its mobile wallet."
    } ]
  }, {
    "tStartMs": 260670,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- Without unlocking my phone\nis the real magic part."
    } ]
  }, {
    "tStartMs": 263040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That's crazy."
    } ]
  }, {
    "tStartMs": 263873,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "- And the craziest thing\nof all is that this hack"
    } ]
  }, {
    "tStartMs": 265816,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "was made public back in 2021."
    } ]
  }, {
    "tStartMs": 268650,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So, people have known that it's possible"
    } ]
  }, {
    "tStartMs": 269850,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "to take money from locked phones\nin this way for five years."
    } ]
  }, {
    "tStartMs": 273780,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So, what kind of amounts does this?"
    } ]
  }, {
    "tStartMs": 276240,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- The only limit is how much someone has"
    } ]
  }, {
    "tStartMs": 278220,
    "dDurationMs": 1123,
    "segs": [ {
      "utf8": "in their bank account."
    } ]
  }, {
    "tStartMs": 279343,
    "dDurationMs": 1847,
    "segs": [ {
      "utf8": "(suspenseful music)"
    } ]
  }, {
    "tStartMs": 281190,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "- Yet the loophole\nstill hasn't been fixed."
    } ]
  }, {
    "tStartMs": 284730,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So, how does it work?"
    } ]
  }, {
    "tStartMs": 286570,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Well, whenever you use Tap to\nPay, your phone and the reader"
    } ]
  }, {
    "tStartMs": 289950,
    "dDurationMs": 2262,
    "segs": [ {
      "utf8": "exchange information\nabout the transaction."
    } ]
  }, {
    "tStartMs": 292212,
    "dDurationMs": 2418,
    "segs": [ {
      "utf8": "But they send this\ninformation through the air"
    } ]
  }, {
    "tStartMs": 294630,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "by a shared magnetic field,"
    } ]
  }, {
    "tStartMs": 296096,
    "dDurationMs": 3364,
    "segs": [ {
      "utf8": "so we can intercept the\ncommunication and alter it."
    } ]
  }, {
    "tStartMs": 299460,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "All we need to do is to\ninsert our own devices"
    } ]
  }, {
    "tStartMs": 302010,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "in between the phone and the reader."
    } ]
  }, {
    "tStartMs": 304620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "First, we tap Marques's\nphone against this."
    } ]
  }, {
    "tStartMs": 307080,
    "dDurationMs": 1857,
    "segs": [ {
      "utf8": "It's an NFC device called the Proxmark."
    } ]
  }, {
    "tStartMs": 308937,
    "dDurationMs": 1413,
    "segs": [ {
      "utf8": "To Marques's phone,"
    } ]
  }, {
    "tStartMs": 310350,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "the proxmark looks like\na typical card reader."
    } ]
  }, {
    "tStartMs": 312780,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "So, it happily sends over\nits transaction data."
    } ]
  }, {
    "tStartMs": 315170,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "That proxmark then sends that\ndata straight to our laptop,"
    } ]
  }, {
    "tStartMs": 318660,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "where we run a Python\nscript to modify it."
    } ]
  }, {
    "tStartMs": 321390,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Next, the laptop sends the\ndata to our burner phone,"
    } ]
  }, {
    "tStartMs": 324030,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "which I tap on the actual card reader."
    } ]
  }, {
    "tStartMs": 326120,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "To the reader, my phone\nlooks just like Marques's."
    } ]
  }, {
    "tStartMs": 329550,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, both Marques's phone\nand the card reader"
    } ]
  }, {
    "tStartMs": 331980,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "think they're talking\ndirectly to each other,"
    } ]
  }, {
    "tStartMs": 334470,
    "dDurationMs": 1582,
    "segs": [ {
      "utf8": "when in fact all their communication"
    } ]
  }, {
    "tStartMs": 336052,
    "dDurationMs": 2738,
    "segs": [ {
      "utf8": "goes through our series of devices."
    } ]
  }, {
    "tStartMs": 338790,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "This is a classic\nman-in-the-middle attack."
    } ]
  }, {
    "tStartMs": 344190,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Now, getting in the middle\nto intercept the data"
    } ]
  }, {
    "tStartMs": 346170,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "is actually the easy part."
    } ]
  }, {
    "tStartMs": 347580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The hard part is what you\nneed to do to that data"
    } ]
  }, {
    "tStartMs": 349560,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "to trick the phone and the reader"
    } ]
  }, {
    "tStartMs": 351210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "into authorizing the transaction."
    } ]
  }, {
    "tStartMs": 353010,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "See, to actually steal\nmoney using this attack,"
    } ]
  }, {
    "tStartMs": 355500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you have to get past three layers"
    } ]
  }, {
    "tStartMs": 356940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "of defense on both systems."
    } ]
  }, {
    "tStartMs": 358770,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "And to do that, we have\nto tell three lies."
    } ]
  }, {
    "tStartMs": 361260,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "Two to the phone, and one to the reader."
    } ]
  }, {
    "tStartMs": 365940,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, the first layer of\ndefense is the simplest."
    } ]
  }, {
    "tStartMs": 368370,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The phone is locked."
    } ]
  }, {
    "tStartMs": 370050,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "And in an ordinary transaction,"
    } ]
  }, {
    "tStartMs": 371520,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "you have to unlock your phone to pay."
    } ]
  }, {
    "tStartMs": 373560,
    "dDurationMs": 1546,
    "segs": [ {
      "utf8": "But this is no ordinary transaction."
    } ]
  }, {
    "tStartMs": 375106,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "So, you know, if you\never go to the subway,"
    } ]
  }, {
    "tStartMs": 377633,
    "dDurationMs": 1797,
    "segs": [ {
      "utf8": "there's a feature that Apple's\ncreated where you know,"
    } ]
  }, {
    "tStartMs": 379430,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "when you walk through,"
    } ]
  }, {
    "tStartMs": 380580,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "they don't want a bunch\nof people lining up"
    } ]
  }, {
    "tStartMs": 381647,
    "dDurationMs": 1398,
    "segs": [ {
      "utf8": "and having to unlock their face."
    } ]
  }, {
    "tStartMs": 383045,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "And you know, maybe they're wearing a coat"
    } ]
  }, {
    "tStartMs": 384630,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and glasses and stuff.\n- Oh. Express Transit Mode."
    } ]
  }, {
    "tStartMs": 387300,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "- Apple introduced express\ntransit mode in 2019"
    } ]
  }, {
    "tStartMs": 390110,
    "dDurationMs": 1588,
    "segs": [ {
      "utf8": "to let you make transit transactions"
    } ]
  }, {
    "tStartMs": 391698,
    "dDurationMs": 2175,
    "segs": [ {
      "utf8": "without having to unlock your phone."
    } ]
  }, {
    "tStartMs": 395700,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "The way this works is\nthat the payment terminals"
    } ]
  }, {
    "tStartMs": 397285,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "on the subway or on the\nbus broadcast a message"
    } ]
  }, {
    "tStartMs": 400022,
    "dDurationMs": 2458,
    "segs": [ {
      "utf8": "that identifies them\nas a transit terminal."
    } ]
  }, {
    "tStartMs": 402480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Then, when you tap your phone to pay,"
    } ]
  }, {
    "tStartMs": 404010,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "it looks for whatever card\nis in the transit slot"
    } ]
  }, {
    "tStartMs": 406320,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "of its mobile wallet and it\npays without needing to unlock."
    } ]
  }, {
    "tStartMs": 410010,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "This is super convenient,\nbut we can also abuse it."
    } ]
  }, {
    "tStartMs": 413430,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- We found out how this worked"
    } ]
  }, {
    "tStartMs": 414840,
    "dDurationMs": 2179,
    "segs": [ {
      "utf8": "by going to the London Underground"
    } ]
  }, {
    "tStartMs": 417019,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "with our laptops and our equipment,"
    } ]
  }, {
    "tStartMs": 419700,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and actually scanning the signals"
    } ]
  }, {
    "tStartMs": 421770,
    "dDurationMs": 3395,
    "segs": [ {
      "utf8": "and seeing what the gate\nwas saying to the phone."
    } ]
  }, {
    "tStartMs": 425165,
    "dDurationMs": 3156,
    "segs": [ {
      "utf8": "And that's how we discovered\nthis code the gate send"
    } ]
  }, {
    "tStartMs": 428321,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "which unlocked the phone."
    } ]
  }, {
    "tStartMs": 430290,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- We used the proxmark to\nbroadcast that same code,"
    } ]
  }, {
    "tStartMs": 433020,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "which fools Marques's phone into thinking"
    } ]
  }, {
    "tStartMs": 435090,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "that it's a transit reader."
    } ]
  }, {
    "tStartMs": 436560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, when we tap Marques's\nphone against the proxmark,"
    } ]
  }, {
    "tStartMs": 438990,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "it's now expecting to\nreceive another message"
    } ]
  }, {
    "tStartMs": 441570,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "with the details about\nthe transit transaction."
    } ]
  }, {
    "tStartMs": 444180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Here's what that message\nwould typically look like"
    } ]
  }, {
    "tStartMs": 446100,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "in binary code."
    } ]
  }, {
    "tStartMs": 447870,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "Each of these bits carries\nimportant information"
    } ]
  }, {
    "tStartMs": 449631,
    "dDurationMs": 1509,
    "segs": [ {
      "utf8": "about the transaction."
    } ]
  }, {
    "tStartMs": 451140,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "Now, the important part of this\nmessage for us is this bit."
    } ]
  }, {
    "tStartMs": 454074,
    "dDurationMs": 3936,
    "segs": [ {
      "utf8": "An authentic transit transaction\nwould have a 1 right here."
    } ]
  }, {
    "tStartMs": 458010,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "This tells the phone that\nthe reader may be offline."
    } ]
  }, {
    "tStartMs": 460074,
    "dDurationMs": 2346,
    "segs": [ {
      "utf8": "Like if it's underground on the subway."
    } ]
  }, {
    "tStartMs": 462420,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "In which case the phone would need to send"
    } ]
  }, {
    "tStartMs": 463830,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "an extra layer of authentication."
    } ]
  }, {
    "tStartMs": 466620,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So, when Marques's phone\nreceives the transaction request"
    } ]
  }, {
    "tStartMs": 469650,
    "dDurationMs": 1707,
    "segs": [ {
      "utf8": "from what it thinks is a transit reader,"
    } ]
  }, {
    "tStartMs": 471357,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "it's gonna be expecting\nthat value to be set to 1."
    } ]
  }, {
    "tStartMs": 474570,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "But in reality, the\ndevice sending the request"
    } ]
  }, {
    "tStartMs": 477060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is our retail reader, and\nthis reader is online,"
    } ]
  }, {
    "tStartMs": 479700,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "which means that that bit\nis currently set to zero."
    } ]
  }, {
    "tStartMs": 482430,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Therefore, to trick the phone"
    } ]
  }, {
    "tStartMs": 483720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "into accepting the transaction,"
    } ]
  }, {
    "tStartMs": 485400,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "we intercept the message from the reader,"
    } ]
  }, {
    "tStartMs": 487120,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "pass it through our computer,"
    } ]
  }, {
    "tStartMs": 488640,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and we change that 0 to a 1."
    } ]
  }, {
    "tStartMs": 490980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So by the time the message\ngets to Marques's phone,"
    } ]
  }, {
    "tStartMs": 493560,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "it looks like a transit transaction."
    } ]
  }, {
    "tStartMs": 497010,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "As this communicates through our computer,"
    } ]
  }, {
    "tStartMs": 500070,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "we're convincing the phone"
    } ]
  }, {
    "tStartMs": 501543,
    "dDurationMs": 3387,
    "segs": [ {
      "utf8": "that it is in fact talking\nto a transit terminal."
    } ]
  }, {
    "tStartMs": 504930,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "But now there's a second line\nof defense we need to break."
    } ]
  }, {
    "tStartMs": 508036,
    "dDurationMs": 1274,
    "segs": [ {
      "utf8": "With this first lie,"
    } ]
  }, {
    "tStartMs": 509310,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "we bypassed the need to unlock the phone."
    } ]
  }, {
    "tStartMs": 511500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "And we can now trick it"
    } ]
  }, {
    "tStartMs": 512400,
    "dDurationMs": 2394,
    "segs": [ {
      "utf8": "into making small\npayments of a few dollars."
    } ]
  }, {
    "tStartMs": 514794,
    "dDurationMs": 1808,
    "segs": [ {
      "utf8": "Kind you'd expect on the subway."
    } ]
  }, {
    "tStartMs": 516602,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "But if we suddenly went and\nasked the phone for $10,000,"
    } ]
  }, {
    "tStartMs": 520230,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "well, its guard would go way back up."
    } ]
  }, {
    "tStartMs": 522900,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "After all, it's pretty\nunusual for a transit reader"
    } ]
  }, {
    "tStartMs": 525420,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to ask for such a large amount of money."
    } ]
  }, {
    "tStartMs": 528420,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "So, this activates a\nsecond layer of defense."
    } ]
  }, {
    "tStartMs": 530850,
    "dDurationMs": 1296,
    "segs": [ {
      "utf8": "Customer verification."
    } ]
  }, {
    "tStartMs": 532146,
    "dDurationMs": 2094,
    "segs": [ {
      "utf8": "On contactless payments like this,"
    } ]
  }, {
    "tStartMs": 534240,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "there are two categories of transaction."
    } ]
  }, {
    "tStartMs": 536130,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "We got high value and low value."
    } ]
  }, {
    "tStartMs": 538800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Any transaction that's\nclassified as high value"
    } ]
  }, {
    "tStartMs": 541140,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "requires additional\nverification from the customer."
    } ]
  }, {
    "tStartMs": 543833,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "For example, in the UK,\nmost banks require a pin"
    } ]
  }, {
    "tStartMs": 546446,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "or a fingerprint or facial recognition"
    } ]
  }, {
    "tStartMs": 548786,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "for any transaction over 100 pounds."
    } ]
  }, {
    "tStartMs": 551622,
    "dDurationMs": 2774,
    "segs": [ {
      "utf8": "So, for us to get this\n$10,000 payment through"
    } ]
  }, {
    "tStartMs": 554396,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "without customer verification,"
    } ]
  }, {
    "tStartMs": 556265,
    "dDurationMs": 2005,
    "segs": [ {
      "utf8": "we need to trick the phone into thinking"
    } ]
  }, {
    "tStartMs": 558270,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "that $10,000 is in fact\na low value transaction."
    } ]
  }, {
    "tStartMs": 563079,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "And that's actually surprisingly simple."
    } ]
  }, {
    "tStartMs": 566040,
    "dDurationMs": 836,
    "segs": [ {
      "utf8": "That's because to determine"
    } ]
  }, {
    "tStartMs": 566876,
    "dDurationMs": 2038,
    "segs": [ {
      "utf8": "whether the transaction is high value,"
    } ]
  }, {
    "tStartMs": 568914,
    "dDurationMs": 2046,
    "segs": [ {
      "utf8": "Marques's phone doesn't actually look"
    } ]
  }, {
    "tStartMs": 570960,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "at the numerical value of $10,000."
    } ]
  }, {
    "tStartMs": 573026,
    "dDurationMs": 3094,
    "segs": [ {
      "utf8": "It just looks at another\nsingle bit of information"
    } ]
  }, {
    "tStartMs": 576120,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "in the transaction data."
    } ]
  }, {
    "tStartMs": 577329,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "A 1 here means high\nvalue and 0 means low."
    } ]
  }, {
    "tStartMs": 580571,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "The reason for this is that the boundary"
    } ]
  }, {
    "tStartMs": 582279,
    "dDurationMs": 3208,
    "segs": [ {
      "utf8": "between high and low value\nvaries from country to country."
    } ]
  }, {
    "tStartMs": 585487,
    "dDurationMs": 893,
    "segs": [ {
      "utf8": "And of course,"
    } ]
  }, {
    "tStartMs": 586380,
    "dDurationMs": 1945,
    "segs": [ {
      "utf8": "different countries operate\nin different currencies."
    } ]
  }, {
    "tStartMs": 588325,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So, a simple label allows the flexibility"
    } ]
  }, {
    "tStartMs": 590335,
    "dDurationMs": 2315,
    "segs": [ {
      "utf8": "to deal with these variations."
    } ]
  }, {
    "tStartMs": 592650,
    "dDurationMs": 1276,
    "segs": [ {
      "utf8": "And it allows the limits to be changed"
    } ]
  }, {
    "tStartMs": 593926,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "without the banks needing\nto issue new cards."
    } ]
  }, {
    "tStartMs": 597240,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "So, all we need to do"
    } ]
  }, {
    "tStartMs": 598110,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "is intercept the message from the reader,"
    } ]
  }, {
    "tStartMs": 600120,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "flip that bit to a zero,"
    } ]
  }, {
    "tStartMs": 601389,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "and then the phone will believe"
    } ]
  }, {
    "tStartMs": 602710,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "that this transaction is low value"
    } ]
  }, {
    "tStartMs": 605370,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "even though it's for $10,000."
    } ]
  }, {
    "tStartMs": 607830,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Then, when the phone receives our request"
    } ]
  }, {
    "tStartMs": 609870,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "for a $10,000 transaction,"
    } ]
  }, {
    "tStartMs": 611517,
    "dDurationMs": 1798,
    "segs": [ {
      "utf8": "it doesn't ask for customer verification."
    } ]
  }, {
    "tStartMs": 613315,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "It just goes ahead and\nauthorizes the transaction."
    } ]
  }, {
    "tStartMs": 619290,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Now, you might be asking,"
    } ]
  }, {
    "tStartMs": 620370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "why is this data so easy to tamper with?"
    } ]
  }, {
    "tStartMs": 622860,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And we'll get to that in just a minute."
    } ]
  }, {
    "tStartMs": 624300,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But we have one final\nsecurity check to overcome."
    } ]
  }, {
    "tStartMs": 627090,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "See, with these first two lies,"
    } ]
  }, {
    "tStartMs": 628470,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "we bypassed unlocking the phone"
    } ]
  }, {
    "tStartMs": 630540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and then tricked it into\nmaking a high value transaction"
    } ]
  }, {
    "tStartMs": 633120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "without asking for verification."
    } ]
  }, {
    "tStartMs": 635040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So, the phone is fully convinced"
    } ]
  }, {
    "tStartMs": 636720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and it's ready to make the payment."
    } ]
  }, {
    "tStartMs": 638490,
    "dDurationMs": 1432,
    "segs": [ {
      "utf8": "But we still need to convince the reader"
    } ]
  }, {
    "tStartMs": 639922,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "that the transaction's valid."
    } ]
  }, {
    "tStartMs": 642660,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And this is where our third lie comes in."
    } ]
  }, {
    "tStartMs": 645420,
    "dDurationMs": 1058,
    "segs": [ {
      "utf8": "When Marques's phone replies,"
    } ]
  }, {
    "tStartMs": 646478,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "it says it's approved\nthe $10,000 transaction."
    } ]
  }, {
    "tStartMs": 649680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But it also says that it hasn't asked"
    } ]
  }, {
    "tStartMs": 651480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "for customer verification."
    } ]
  }, {
    "tStartMs": 653100,
    "dDurationMs": 2725,
    "segs": [ {
      "utf8": "No pin, no fingerprint,\nno facial recognition."
    } ]
  }, {
    "tStartMs": 655825,
    "dDurationMs": 3225,
    "segs": [ {
      "utf8": "But if the reader sees this,\nit'll reject the transaction"
    } ]
  }, {
    "tStartMs": 659050,
    "dDurationMs": 2212,
    "segs": [ {
      "utf8": "because it knows that the $10,000 payment"
    } ]
  }, {
    "tStartMs": 661262,
    "dDurationMs": 2668,
    "segs": [ {
      "utf8": "it originally asked for is high value."
    } ]
  }, {
    "tStartMs": 663930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It should therefore require\ncustomer verification."
    } ]
  }, {
    "tStartMs": 666570,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "So, now we need to trick the reader"
    } ]
  }, {
    "tStartMs": 667879,
    "dDurationMs": 4121,
    "segs": [ {
      "utf8": "into thinking that the customer\nhas verified the payment."
    } ]
  }, {
    "tStartMs": 672000,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So, we intercept the\nresponse from Marques's phone"
    } ]
  }, {
    "tStartMs": 674730,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and look for the bit of information"
    } ]
  }, {
    "tStartMs": 676080,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "that says customer\nverification hasn't been done."
    } ]
  }, {
    "tStartMs": 679230,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Then we change it to say that\nthe payment has been verified"
    } ]
  }, {
    "tStartMs": 682740,
    "dDurationMs": 2406,
    "segs": [ {
      "utf8": "by flipping this 0 to a 1."
    } ]
  }, {
    "tStartMs": 685146,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "Now, the reader's happy."
    } ]
  }, {
    "tStartMs": 686940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It forwards the information onto the bank,"
    } ]
  }, {
    "tStartMs": 688800,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and the bank authorizes the payment."
    } ]
  }, {
    "tStartMs": 691170,
    "dDurationMs": 2124,
    "segs": [ {
      "utf8": "After all, it sees a\ntransaction that's been verified"
    } ]
  }, {
    "tStartMs": 693294,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "by the customer on their device."
    } ]
  }, {
    "tStartMs": 695904,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "(upbeat lively music)"
    } ]
  }, {
    "tStartMs": 700376,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "(notification beeps)"
    } ]
  }, {
    "tStartMs": 701610,
    "dDurationMs": 1113,
    "segs": [ {
      "utf8": "Green approved."
    } ]
  }, {
    "tStartMs": 704025,
    "dDurationMs": 1185,
    "segs": [ {
      "utf8": "(coins clinking)"
    } ]
  }, {
    "tStartMs": 705210,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- That is crazy."
    } ]
  }, {
    "tStartMs": 706530,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "- Verified on device?\n- Yeah, verified."
    } ]
  }, {
    "tStartMs": 707690,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "- You didn't, you didn't verify it."
    } ]
  }, {
    "tStartMs": 710070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 711360,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- So, why isn't all this\ninformation encrypted?"
    } ]
  }, {
    "tStartMs": 714330,
    "dDurationMs": 2546,
    "segs": [ {
      "utf8": "That would make it impossible\nto secretly tamper with."
    } ]
  }, {
    "tStartMs": 716876,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "Well, the way the phone\nand reader communicate"
    } ]
  }, {
    "tStartMs": 718918,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "has to be compatible with\nthousands of different devices,"
    } ]
  }, {
    "tStartMs": 721605,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "which would be impossible\nto update all in one go."
    } ]
  }, {
    "tStartMs": 724548,
    "dDurationMs": 2549,
    "segs": [ {
      "utf8": "So for that reason, the\ninformation we've looked at so far"
    } ]
  }, {
    "tStartMs": 727097,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "is just sent across unencrypted."
    } ]
  }, {
    "tStartMs": 730080,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Even still, phones, readers and banks"
    } ]
  }, {
    "tStartMs": 731800,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "all have checks in place to make sure"
    } ]
  }, {
    "tStartMs": 733890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "an attack like this can't happen."
    } ]
  }, {
    "tStartMs": 735810,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "And normally, it can't."
    } ]
  }, {
    "tStartMs": 737187,
    "dDurationMs": 3505,
    "segs": [ {
      "utf8": "Except if you happen to use\na specific type of phone"
    } ]
  }, {
    "tStartMs": 740692,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "and a specific type of card."
    } ]
  }, {
    "tStartMs": 742797,
    "dDurationMs": 3362,
    "segs": [ {
      "utf8": "Because when you combine them\nin this particular scenario,"
    } ]
  }, {
    "tStartMs": 746159,
    "dDurationMs": 1594,
    "segs": [ {
      "utf8": "they create a loophole."
    } ]
  }, {
    "tStartMs": 748980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So, our hack relied on a specific phone"
    } ]
  }, {
    "tStartMs": 751200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and credit card combination."
    } ]
  }, {
    "tStartMs": 752880,
    "dDurationMs": 1248,
    "segs": [ {
      "utf8": "And we also use a sophisticated method"
    } ]
  }, {
    "tStartMs": 754128,
    "dDurationMs": 2712,
    "segs": [ {
      "utf8": "developed by cybersecurity experts."
    } ]
  }, {
    "tStartMs": 756840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "But hackers or scammers online,"
    } ]
  }, {
    "tStartMs": 758670,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "well, they don't need to be that smart."
    } ]
  }, {
    "tStartMs": 760560,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Often they can just buy\ninformation to target you."
    } ]
  }, {
    "tStartMs": 763290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "When I started working at Veritasium,"
    } ]
  }, {
    "tStartMs": 764640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I was on a work trip to go\nmeet Derek for the first time."
    } ]
  }, {
    "tStartMs": 767040,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "And I got an email from\nsomebody was saying he was Derek"
    } ]
  }, {
    "tStartMs": 770577,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "asking for my phone number."
    } ]
  }, {
    "tStartMs": 772037,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "That made a ton of sense."
    } ]
  }, {
    "tStartMs": 773220,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "I was leaving the airport."
    } ]
  }, {
    "tStartMs": 774120,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So, I just responded by\nsending my phone number."
    } ]
  }, {
    "tStartMs": 776340,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I immediately was like,\n\"Wait, let me look at that.\""
    } ]
  }, {
    "tStartMs": 778320,
    "dDurationMs": 1679,
    "segs": [ {
      "utf8": "I checked the email. Not Derek."
    } ]
  }, {
    "tStartMs": 779999,
    "dDurationMs": 1531,
    "segs": [ {
      "utf8": "Of course, for the next few months"
    } ]
  }, {
    "tStartMs": 781530,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "I was just getting scam\ncall after scam call."
    } ]
  }, {
    "tStartMs": 783311,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "That's one way they can get\nyou. I felt like an idiot."
    } ]
  }, {
    "tStartMs": 785610,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But it's not just scam calls like that."
    } ]
  }, {
    "tStartMs": 788010,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I've also had that feeling"
    } ]
  }, {
    "tStartMs": 789150,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "after news of a major data breach."
    } ]
  }, {
    "tStartMs": 790890,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I've wondered whether\nme using some website"
    } ]
  }, {
    "tStartMs": 793140,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "has led to my personal information\nbeing exposed somewhere"
    } ]
  }, {
    "tStartMs": 796050,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "without me even knowing about it."
    } ]
  }, {
    "tStartMs": 797490,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "But you can protect your personal info"
    } ]
  }, {
    "tStartMs": 799260,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with today's sponsor, Incogni."
    } ]
  }, {
    "tStartMs": 801180,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "See, whenever scammers purchase\nyour email, phone number,"
    } ]
  }, {
    "tStartMs": 804090,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and even your home\naddress from data brokers,"
    } ]
  }, {
    "tStartMs": 806400,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Incogni automates the\ngrueling process of requesting"
    } ]
  }, {
    "tStartMs": 808767,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "that these data brokers\ndelete your information."
    } ]
  }, {
    "tStartMs": 811290,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Okay, so I've had this since June 2025."
    } ]
  }, {
    "tStartMs": 813990,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "And since then, we've had 94\ndifferent removal requests."
    } ]
  }, {
    "tStartMs": 818490,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "And I really like how you\ncan track the progress"
    } ]
  }, {
    "tStartMs": 819947,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "in this dashboard here."
    } ]
  }, {
    "tStartMs": 821400,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "They've estimated that that saved me"
    } ]
  }, {
    "tStartMs": 822930,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "70 hours and 30 minutes of my own time"
    } ]
  }, {
    "tStartMs": 825160,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "if I were to reach out\nto these people myself."
    } ]
  }, {
    "tStartMs": 827340,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "And with Incogni's new\ncustom removal feature"
    } ]
  }, {
    "tStartMs": 829152,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": "in their unlimited plans,"
    } ]
  }, {
    "tStartMs": 830760,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "you can point to any specific site"
    } ]
  }, {
    "tStartMs": 832181,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "where your information is visible."
    } ]
  }, {
    "tStartMs": 833820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And then, one of their privacy agents"
    } ]
  }, {
    "tStartMs": 835260,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "will take care of the rest."
    } ]
  }, {
    "tStartMs": 836250,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "So, to take your data\noff the market today,"
    } ]
  }, {
    "tStartMs": 838094,
    "dDurationMs": 3283,
    "segs": [ {
      "utf8": "go to incogni.com/veritasium"
    } ]
  }, {
    "tStartMs": 841377,
    "dDurationMs": 3123,
    "segs": [ {
      "utf8": "and then use code Veritasium for 60% off."
    } ]
  }, {
    "tStartMs": 844500,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "You can click the link below"
    } ]
  }, {
    "tStartMs": 845670,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "or you can scan this QR\ncode to claim that 60% off"
    } ]
  }, {
    "tStartMs": 848940,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and get your personal data off the market."
    } ]
  }, {
    "tStartMs": 851310,
    "dDurationMs": 1808,
    "segs": [ {
      "utf8": "I wanna thank Incogni\nfor sponsoring this video"
    } ]
  }, {
    "tStartMs": 853118,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "about taking money from Marques Brownlee."
    } ]
  }, {
    "tStartMs": 856140,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "And now, let's get back\nto that thing."
    } ]
  }, {
    "tStartMs": 860160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So, which combination of card and phone"
    } ]
  }, {
    "tStartMs": 862320,
    "dDurationMs": 1332,
    "segs": [ {
      "utf8": "make this hack possible?"
    } ]
  }, {
    "tStartMs": 863652,
    "dDurationMs": 3168,
    "segs": [ {
      "utf8": "Firstly, the phone has to be an iPhone."
    } ]
  }, {
    "tStartMs": 866820,
    "dDurationMs": 1706,
    "segs": [ {
      "utf8": "As we saw earlier, when\nan iPhone is deciding"
    } ]
  }, {
    "tStartMs": 868526,
    "dDurationMs": 2824,
    "segs": [ {
      "utf8": "whether to ask for customer verification,"
    } ]
  }, {
    "tStartMs": 871350,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it doesn't look at the numerical\nvalue of the transaction."
    } ]
  }, {
    "tStartMs": 874230,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "It only looks at the high\nvalue or low value label"
    } ]
  }, {
    "tStartMs": 876780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "provided by the reader."
    } ]
  }, {
    "tStartMs": 878550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But other phones don't work that way."
    } ]
  }, {
    "tStartMs": 880740,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "For example, when a Samsung\nphone goes into transit mode,"
    } ]
  }, {
    "tStartMs": 883860,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "it doesn't rely on this low\nvalue label from the reader."
    } ]
  }, {
    "tStartMs": 886394,
    "dDurationMs": 3256,
    "segs": [ {
      "utf8": "It looks at the actual numerical\nvalue of the transaction"
    } ]
  }, {
    "tStartMs": 889650,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "and it only accepts a payment of $0."
    } ]
  }, {
    "tStartMs": 892680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Then it relies on the transport provider"
    } ]
  }, {
    "tStartMs": 894600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to count up all the times\nyou've used the subway,"
    } ]
  }, {
    "tStartMs": 896940,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and then to send you a\nbill at the end of the day."
    } ]
  }, {
    "tStartMs": 899430,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, if a Samsung phone\nsaw a transit terminal"
    } ]
  }, {
    "tStartMs": 902280,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "trying to charge you\n$10,000 for a single tap,"
    } ]
  }, {
    "tStartMs": 905460,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "it would immediately reject it."
    } ]
  }, {
    "tStartMs": 907560,
    "dDurationMs": 1338,
    "segs": [ {
      "utf8": "But it's not just Apple's transit mode"
    } ]
  }, {
    "tStartMs": 908898,
    "dDurationMs": 2382,
    "segs": [ {
      "utf8": "that makes this hack possible."
    } ]
  }, {
    "tStartMs": 911280,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "You've gotta have one\nspecific type of card"
    } ]
  }, {
    "tStartMs": 913042,
    "dDurationMs": 2408,
    "segs": [ {
      "utf8": "in the transit slot."
    } ]
  }, {
    "tStartMs": 915450,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "- It was truly a design\nfeature that was introduced"
    } ]
  }, {
    "tStartMs": 918190,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "by the way you mixed Apple and Visa."
    } ]
  }, {
    "tStartMs": 921420,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "- And the reason that this\nworks with a Visa card,"
    } ]
  }, {
    "tStartMs": 923033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "but wouldn't, with say, a MasterCard"
    } ]
  }, {
    "tStartMs": 925500,
    "dDurationMs": 1562,
    "segs": [ {
      "utf8": "comes down to the different\nprocesses they use"
    } ]
  }, {
    "tStartMs": 927062,
    "dDurationMs": 2248,
    "segs": [ {
      "utf8": "to verify transactions."
    } ]
  }, {
    "tStartMs": 929310,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So, what is it about\nVisa's verification process"
    } ]
  }, {
    "tStartMs": 932760,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that makes this hack possible?"
    } ]
  }, {
    "tStartMs": 934710,
    "dDurationMs": 2196,
    "segs": [ {
      "utf8": "In a previous video, we saw\nthat any card transaction"
    } ]
  }, {
    "tStartMs": 936906,
    "dDurationMs": 2424,
    "segs": [ {
      "utf8": "relies on a secret cryptographic key"
    } ]
  }, {
    "tStartMs": 939330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "shared by the card and the bank."
    } ]
  }, {
    "tStartMs": 941730,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "When you tap the card\nor phone onto a reader,"
    } ]
  }, {
    "tStartMs": 944460,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "the reader sends across"
    } ]
  }, {
    "tStartMs": 945510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "a long string of transaction details."
    } ]
  }, {
    "tStartMs": 947880,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "The card then applies its secret\nkey to garble that message"
    } ]
  }, {
    "tStartMs": 950119,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "into a unique code for the transaction."
    } ]
  }, {
    "tStartMs": 952890,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The card sends this to the reader,"
    } ]
  }, {
    "tStartMs": 954510,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "which the reader forwards onto the bank,"
    } ]
  }, {
    "tStartMs": 956340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "along with the raw transaction details."
    } ]
  }, {
    "tStartMs": 959310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The bank then applies its own secret key"
    } ]
  }, {
    "tStartMs": 961320,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to the raw data as well."
    } ]
  }, {
    "tStartMs": 962820,
    "dDurationMs": 1691,
    "segs": [ {
      "utf8": "And if the output matches\nthe one from the card,"
    } ]
  }, {
    "tStartMs": 964511,
    "dDurationMs": 2422,
    "segs": [ {
      "utf8": "the bank authorizes the transaction."
    } ]
  }, {
    "tStartMs": 967800,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is called symmetric cryptography"
    } ]
  }, {
    "tStartMs": 969780,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "since the card and the bank\nuse the same secret key."
    } ]
  }, {
    "tStartMs": 973080,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And this step is required\nin all transactions."
    } ]
  }, {
    "tStartMs": 975360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "No matter whether you\nhave a Visa, a MasterCard,"
    } ]
  }, {
    "tStartMs": 977460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "or something else."
    } ]
  }, {
    "tStartMs": 979080,
    "dDurationMs": 1948,
    "segs": [ {
      "utf8": "But there's actually\nanother layer of security"
    } ]
  }, {
    "tStartMs": 981028,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "which MasterCard uses in\nall of its transactions."
    } ]
  }, {
    "tStartMs": 984090,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "But in this particular case, Visa doesn't."
    } ]
  }, {
    "tStartMs": 986633,
    "dDurationMs": 3279,
    "segs": [ {
      "utf8": "This layer of security is not\nbetween the card and the bank,"
    } ]
  }, {
    "tStartMs": 989912,
    "dDurationMs": 2368,
    "segs": [ {
      "utf8": "but between the card and the reader."
    } ]
  }, {
    "tStartMs": 992280,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "And it's at this step where\nMasterCard thwarts our attack."
    } ]
  }, {
    "tStartMs": 996900,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The second step relies on\nasymmetric cryptography."
    } ]
  }, {
    "tStartMs": 1000260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So-called because it\nuses two different keys."
    } ]
  }, {
    "tStartMs": 1003050,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "A private key for the card and\na public key for the reader."
    } ]
  }, {
    "tStartMs": 1006830,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "It starts with the reader sending across"
    } ]
  }, {
    "tStartMs": 1008191,
    "dDurationMs": 3739,
    "segs": [ {
      "utf8": "the transaction details to\nthe card just like before."
    } ]
  }, {
    "tStartMs": 1011930,
    "dDurationMs": 2276,
    "segs": [ {
      "utf8": "The card then uses its private\nkey to garble that message"
    } ]
  }, {
    "tStartMs": 1014206,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "into another long string of digits."
    } ]
  }, {
    "tStartMs": 1017090,
    "dDurationMs": 2938,
    "segs": [ {
      "utf8": "This is the card's digital\nsignature for the transaction."
    } ]
  }, {
    "tStartMs": 1020028,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "The card sends this\nsignature back to the reader"
    } ]
  }, {
    "tStartMs": 1022084,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "along with the public key,\nwhich the reader then uses"
    } ]
  }, {
    "tStartMs": 1024771,
    "dDurationMs": 2916,
    "segs": [ {
      "utf8": "to verify that the signature\ncame from that specific card"
    } ]
  }, {
    "tStartMs": 1027687,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "for this specific transaction."
    } ]
  }, {
    "tStartMs": 1030380,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "To illustrate how this works,"
    } ]
  }, {
    "tStartMs": 1031760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "let's consider a simple example."
    } ]
  }, {
    "tStartMs": 1034340,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "The private key and public\nkey both have two components."
    } ]
  }, {
    "tStartMs": 1037730,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "N is a shared number."
    } ]
  }, {
    "tStartMs": 1039020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "In this case, let's say 55."
    } ]
  }, {
    "tStartMs": 1041600,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "D is the card's private\nnumber. Let's say 7."
    } ]
  }, {
    "tStartMs": 1044450,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And E is the public number. Let's say 3."
    } ]
  }, {
    "tStartMs": 1047240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Now, when the reader sends\nacross the raw transaction data,"
    } ]
  }, {
    "tStartMs": 1050150,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "it represents it as one long number."
    } ]
  }, {
    "tStartMs": 1052130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But for simplicity, we'll\nuse a much smaller one."
    } ]
  }, {
    "tStartMs": 1054350,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Let's say 2."
    } ]
  }, {
    "tStartMs": 1056090,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "To sign for the transaction,\nthe card or the phone"
    } ]
  }, {
    "tStartMs": 1058210,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "raises the transaction\nnumber, in this case 2,"
    } ]
  }, {
    "tStartMs": 1061430,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "to the power of its private\nnumber, so we get 128."
    } ]
  }, {
    "tStartMs": 1065120,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And then divides this by the\nshared number, 128 over 55,"
    } ]
  }, {
    "tStartMs": 1069440,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "which leaves a remainder of 18."
    } ]
  }, {
    "tStartMs": 1072560,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And this is the card signature, 18,"
    } ]
  }, {
    "tStartMs": 1075020,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "which it sends on to the reader."
    } ]
  }, {
    "tStartMs": 1077540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Now, the reader needs to know"
    } ]
  }, {
    "tStartMs": 1078650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "whether the transaction is valid."
    } ]
  }, {
    "tStartMs": 1080990,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "So, it takes the card signature"
    } ]
  }, {
    "tStartMs": 1082730,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and raises it to the power\nof the public number."
    } ]
  }, {
    "tStartMs": 1085250,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Then, it takes the remainder"
    } ]
  }, {
    "tStartMs": 1086480,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "when you divide by the shared number 55."
    } ]
  }, {
    "tStartMs": 1089630,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And you get 2."
    } ]
  }, {
    "tStartMs": 1090920,
    "dDurationMs": 1388,
    "segs": [ {
      "utf8": "This matches the original transaction data"
    } ]
  }, {
    "tStartMs": 1092308,
    "dDurationMs": 2212,
    "segs": [ {
      "utf8": "the reader sent to the card."
    } ]
  }, {
    "tStartMs": 1094520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The reason this works is that\nthe private and public numbers"
    } ]
  }, {
    "tStartMs": 1097220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "are specifically chosen"
    } ]
  }, {
    "tStartMs": 1098750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "so that when combined\nwith the shared number,"
    } ]
  }, {
    "tStartMs": 1100640,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the public key effectively\nreverses the operation"
    } ]
  }, {
    "tStartMs": 1103310,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "of the private key."
    } ]
  }, {
    "tStartMs": 1104480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And this allows the reader to verify"
    } ]
  }, {
    "tStartMs": 1106010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that the card signature is valid"
    } ]
  }, {
    "tStartMs": 1107930,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "without ever having\nseen its private number."
    } ]
  }, {
    "tStartMs": 1111350,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "This is based on a type of\ncryptography called RSA."
    } ]
  }, {
    "tStartMs": 1114260,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "In reality, the numbers\ninvolved are much larger."
    } ]
  }, {
    "tStartMs": 1116420,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But that makes it incredibly secure"
    } ]
  }, {
    "tStartMs": 1119270,
    "dDurationMs": 1406,
    "segs": [ {
      "utf8": "because that makes it virtually impossible"
    } ]
  }, {
    "tStartMs": 1120676,
    "dDurationMs": 2956,
    "segs": [ {
      "utf8": "to reverse engineer\nthe card's private key."
    } ]
  }, {
    "tStartMs": 1123632,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And it also means that\neven a one digit change"
    } ]
  }, {
    "tStartMs": 1125912,
    "dDurationMs": 2473,
    "segs": [ {
      "utf8": "in the transaction data will\nproduce a different result"
    } ]
  }, {
    "tStartMs": 1128385,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "when the reader checks\nthe phone's signature,"
    } ]
  }, {
    "tStartMs": 1130641,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "in which case the reader\nwon't approve the transaction."
    } ]
  }, {
    "tStartMs": 1133198,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "This is a problem because\nwe've modified the data."
    } ]
  }, {
    "tStartMs": 1135694,
    "dDurationMs": 1532,
    "segs": [ {
      "utf8": "The reader's expecting a signature"
    } ]
  }, {
    "tStartMs": 1137226,
    "dDurationMs": 2851,
    "segs": [ {
      "utf8": "for a high value retail transaction."
    } ]
  }, {
    "tStartMs": 1140077,
    "dDurationMs": 1772,
    "segs": [ {
      "utf8": "But we intercepted the communication."
    } ]
  }, {
    "tStartMs": 1141849,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "So the phone signature"
    } ]
  }, {
    "tStartMs": 1142882,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "is actually for low value\ntransit transaction."
    } ]
  }, {
    "tStartMs": 1146184,
    "dDurationMs": 3105,
    "segs": [ {
      "utf8": "This wouldn't pass the\nasymmetric signature check."
    } ]
  }, {
    "tStartMs": 1149289,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "But while MasterCard always requires"
    } ]
  }, {
    "tStartMs": 1151401,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "this asymmetric verification,"
    } ]
  }, {
    "tStartMs": 1153620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "which would spot our hack, Visa doesn't."
    } ]
  }, {
    "tStartMs": 1156980,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "They only require this\nsignature in certain situations."
    } ]
  }, {
    "tStartMs": 1159890,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Like, when the reader's offline."
    } ]
  }, {
    "tStartMs": 1161600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "For example, when you're\nunderground with no signal,"
    } ]
  }, {
    "tStartMs": 1163760,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "there's no way for the reader\nto communicate with the bank"
    } ]
  }, {
    "tStartMs": 1165601,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "for that first layer of\nsymmetric cryptography."
    } ]
  }, {
    "tStartMs": 1168560,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "At least not until it comes back online."
    } ]
  }, {
    "tStartMs": 1171350,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "So, during our attack,"
    } ]
  }, {
    "tStartMs": 1172460,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "we make sure the reader\nis online the whole time."
    } ]
  }, {
    "tStartMs": 1174800,
    "dDurationMs": 1298,
    "segs": [ {
      "utf8": "That way, it doesn't bother using"
    } ]
  }, {
    "tStartMs": 1176098,
    "dDurationMs": 2392,
    "segs": [ {
      "utf8": "the asymmetric layer of security,"
    } ]
  }, {
    "tStartMs": 1178490,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "which contains the signature\nthat would unravel our lies."
    } ]
  }, {
    "tStartMs": 1181580,
    "dDurationMs": 1483,
    "segs": [ {
      "utf8": "But the funny thing is\nwe've tricked the phone"
    } ]
  }, {
    "tStartMs": 1183063,
    "dDurationMs": 2747,
    "segs": [ {
      "utf8": "into thinking it's interacting\nwith the transit reader."
    } ]
  }, {
    "tStartMs": 1185810,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "And transit transactions\nare one of those times"
    } ]
  }, {
    "tStartMs": 1187551,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "where Visa does require\nthe asymmetric signature,"
    } ]
  }, {
    "tStartMs": 1190407,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "since the reader could be\nunderground on the subway,"
    } ]
  }, {
    "tStartMs": 1192817,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "and therefore offline."
    } ]
  }, {
    "tStartMs": 1194870,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "So, the phone actually does send across"
    } ]
  }, {
    "tStartMs": 1196578,
    "dDurationMs": 1982,
    "segs": [ {
      "utf8": "its signature to the reader,"
    } ]
  }, {
    "tStartMs": 1198560,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "but the reader doesn't check it."
    } ]
  }, {
    "tStartMs": 1199940,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Because in reality, the reader's online."
    } ]
  }, {
    "tStartMs": 1202790,
    "dDurationMs": 1097,
    "segs": [ {
      "utf8": "So, instead it just relies"
    } ]
  }, {
    "tStartMs": 1203887,
    "dDurationMs": 2757,
    "segs": [ {
      "utf8": "on that first layer of\nsecurity with the bank,"
    } ]
  }, {
    "tStartMs": 1206644,
    "dDurationMs": 2362,
    "segs": [ {
      "utf8": "even though if it did\ncheck the phone signature,"
    } ]
  }, {
    "tStartMs": 1209006,
    "dDurationMs": 2977,
    "segs": [ {
      "utf8": "it would've all the evidence\nit needed to stop the hack."
    } ]
  }, {
    "tStartMs": 1211983,
    "dDurationMs": 1697,
    "segs": [ {
      "utf8": "(screen whooshing)"
    } ]
  }, {
    "tStartMs": 1213680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So yeah, you go.\n- Makes sense"
    } ]
  }, {
    "tStartMs": 1214880,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that it's that sophisticated"
    } ]
  }, {
    "tStartMs": 1215900,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "'cause it shouldn't be that easy,"
    } ]
  }, {
    "tStartMs": 1216890,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but that still seemed way too easy."
    } ]
  }, {
    "tStartMs": 1219710,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- And Marques was not the only victim."
    } ]
  }, {
    "tStartMs": 1221570,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "I thought it was only fair"
    } ]
  }, {
    "tStartMs": 1222590,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "that I first try it out on myself."
    } ]
  }, {
    "tStartMs": 1224049,
    "dDurationMs": 2075,
    "segs": [ {
      "utf8": "(phone beeping)"
    } ]
  }, {
    "tStartMs": 1226124,
    "dDurationMs": 2016,
    "segs": [ {
      "utf8": "- Approved it.\n- Woohoohoo!"
    } ]
  }, {
    "tStartMs": 1228140,
    "dDurationMs": 3555,
    "segs": [ {
      "utf8": "- Yeah, here. You souvenir\nfrom the UK from Tom and me."
    } ]
  }, {
    "tStartMs": 1231695,
    "dDurationMs": 4545,
    "segs": [ {
      "utf8": "- Oh, what a lovely receipt\nfor this theft. (chuckles)"
    } ]
  }, {
    "tStartMs": 1236240,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And then I got another victim\nwith a bit of a bigger budget."
    } ]
  }, {
    "tStartMs": 1239300,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Our channel has a CFO basically,\nwho lives very nearby."
    } ]
  }, {
    "tStartMs": 1243290,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "What we're doing is we're setting it"
    } ]
  }, {
    "tStartMs": 1244250,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to be your transit card."
    } ]
  }, {
    "tStartMs": 1245570,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Okay.\n- So that means"
    } ]
  }, {
    "tStartMs": 1246403,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "that if you're in, London \nyou have to use the tube-"
    } ]
  }, {
    "tStartMs": 1248300,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Yeah.\n- It'll take money"
    } ]
  }, {
    "tStartMs": 1249560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "from this card."
    } ]
  }, {
    "tStartMs": 1250640,
    "dDurationMs": 1508,
    "segs": [ {
      "utf8": "Something just happened.\n- Yeah."
    } ]
  }, {
    "tStartMs": 1252148,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "(everyone laughs)"
    } ]
  }, {
    "tStartMs": 1255110,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "How you feel about that?\n- Oh my goodness me."
    } ]
  }, {
    "tStartMs": 1257120,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Oh my-"
    } ]
  }, {
    "tStartMs": 1258680,
    "dDurationMs": 893,
    "segs": [ {
      "utf8": "- [Henry] There you go."
    } ]
  }, {
    "tStartMs": 1259573,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "- We were just gonna meet for a drink."
    } ]
  }, {
    "tStartMs": 1262313,
    "dDurationMs": 2277,
    "segs": [ {
      "utf8": "That's what, you know,\nthat was the agreement."
    } ]
  }, {
    "tStartMs": 1264590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- In the real world, say you\nhad your phone in your pocket."
    } ]
  }, {
    "tStartMs": 1267920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1268753,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "- I would walk by you-"
    } ]
  }, {
    "tStartMs": 1270530,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- Yeah.\n- Doing this."
    } ]
  }, {
    "tStartMs": 1271820,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And Tom would have this\nin the shop and pay."
    } ]
  }, {
    "tStartMs": 1274640,
    "dDurationMs": 2206,
    "segs": [ {
      "utf8": "- The easiest way for this\nto actually be a crime"
    } ]
  }, {
    "tStartMs": 1276846,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "would be a stolen iPhone."
    } ]
  }, {
    "tStartMs": 1278320,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "- [Henry] Sure."
    } ]
  }, {
    "tStartMs": 1279350,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- And then someone goes and\nspends thousands of pounds."
    } ]
  }, {
    "tStartMs": 1283040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- So you know, you\ncould buy a car with us."
    } ]
  }, {
    "tStartMs": 1284780,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "- Jesus. Yeah, yeah."
    } ]
  }, {
    "tStartMs": 1286370,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Theoretically. Geez."
    } ]
  }, {
    "tStartMs": 1287450,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah.\n- Wow."
    } ]
  }, {
    "tStartMs": 1288283,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I guess from your perspective,"
    } ]
  }, {
    "tStartMs": 1289116,
    "dDurationMs": 1994,
    "segs": [ {
      "utf8": "you've revealed all this\ninformation publicly"
    } ]
  }, {
    "tStartMs": 1291110,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and you're telling us."
    } ]
  }, {
    "tStartMs": 1291943,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "We're walking through it in great detail."
    } ]
  }, {
    "tStartMs": 1294439,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "How do we stop people from using this for-"
    } ]
  }, {
    "tStartMs": 1298040,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Or can we stop people?"
    } ]
  }, {
    "tStartMs": 1299030,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Like, whose responsibility\nis it to stop this?"
    } ]
  }, {
    "tStartMs": 1302090,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Oh, whose responsibility is\nit is an interesting question."
    } ]
  }, {
    "tStartMs": 1304760,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Yeah.\n- But you can stop it"
    } ]
  }, {
    "tStartMs": 1305750,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "by turning transit mode off."
    } ]
  }, {
    "tStartMs": 1307670,
    "dDurationMs": 1625,
    "segs": [ {
      "utf8": "- Or not turn it off,\nbut not have a Visa card"
    } ]
  }, {
    "tStartMs": 1309295,
    "dDurationMs": 1855,
    "segs": [ {
      "utf8": "in transit mode on an Apple."
    } ]
  }, {
    "tStartMs": 1311150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 1311983,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "And you do need to be careful"
    } ]
  }, {
    "tStartMs": 1313100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "because as soon as you\nhave a suitable card"
    } ]
  }, {
    "tStartMs": 1314720,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in your Apple wallet,"
    } ]
  }, {
    "tStartMs": 1315553,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Express Transit Mode is\nturned on by default."
    } ]
  }, {
    "tStartMs": 1319490,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "This hack was first made\npublic way back in 2021"
    } ]
  }, {
    "tStartMs": 1323690,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "after the professors had informed\nApple and Visa privately."
    } ]
  }, {
    "tStartMs": 1327031,
    "dDurationMs": 2225,
    "segs": [ {
      "utf8": "And to get to the bottom\nof why it's still possible,"
    } ]
  }, {
    "tStartMs": 1329256,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "we reached out to Apple,"
    } ]
  }, {
    "tStartMs": 1331070,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and they didn't agree to an interview."
    } ]
  }, {
    "tStartMs": 1333140,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "But here's what they said."
    } ]
  }, {
    "tStartMs": 1334827,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "\"This is a concern with the Visa system,"
    } ]
  }, {
    "tStartMs": 1336800,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "but Visa does not believe\nthis kind of fraud"
    } ]
  }, {
    "tStartMs": 1338199,
    "dDurationMs": 2351,
    "segs": [ {
      "utf8": "is likely to take place in the real world."
    } ]
  }, {
    "tStartMs": 1340550,
    "dDurationMs": 1328,
    "segs": [ {
      "utf8": "Visa has made it clear\nthat their cardholders"
    } ]
  }, {
    "tStartMs": 1341878,
    "dDurationMs": 4192,
    "segs": [ {
      "utf8": "are protected by Visa's\nzero liability policy.\""
    } ]
  }, {
    "tStartMs": 1346070,
    "dDurationMs": 1382,
    "segs": [ {
      "utf8": "This is exactly the same as their position"
    } ]
  }, {
    "tStartMs": 1347452,
    "dDurationMs": 3698,
    "segs": [ {
      "utf8": "when the hack was first\nmade public back in 2021."
    } ]
  }, {
    "tStartMs": 1351150,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "So, it seems like Apple\nare basically saying,"
    } ]
  }, {
    "tStartMs": 1352873,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "\"Well, this is a Visa problem.\""
    } ]
  }, {
    "tStartMs": 1355400,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "So, we went and asked\nVisa what they thought."
    } ]
  }, {
    "tStartMs": 1357636,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "- I think this specific vulnerability"
    } ]
  }, {
    "tStartMs": 1359855,
    "dDurationMs": 3135,
    "segs": [ {
      "utf8": "is likely within a controlled setting."
    } ]
  }, {
    "tStartMs": 1362990,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Very unlikely from a\nscaled real world setting."
    } ]
  }, {
    "tStartMs": 1365930,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "And then, kind of the last point"
    } ]
  }, {
    "tStartMs": 1367280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is from a consumer perspective,"
    } ]
  }, {
    "tStartMs": 1368720,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "is that in the cases\nwhere this is successful,"
    } ]
  }, {
    "tStartMs": 1371713,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "they have the ability to\ndispute this transaction"
    } ]
  }, {
    "tStartMs": 1374162,
    "dDurationMs": 2748,
    "segs": [ {
      "utf8": "and get their refunds returned to them."
    } ]
  }, {
    "tStartMs": 1376910,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- I think that's fair."
    } ]
  }, {
    "tStartMs": 1377743,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "You're saying it's not entirely scalable,"
    } ]
  }, {
    "tStartMs": 1379333,
    "dDurationMs": 1272,
    "segs": [ {
      "utf8": "and then even if it does happen,"
    } ]
  }, {
    "tStartMs": 1380605,
    "dDurationMs": 1915,
    "segs": [ {
      "utf8": "we'll give you your money back."
    } ]
  }, {
    "tStartMs": 1382520,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "Like, that's a great,\nthat's a great stance."
    } ]
  }, {
    "tStartMs": 1384616,
    "dDurationMs": 2251,
    "segs": [ {
      "utf8": "I still think though, a lot of people,"
    } ]
  }, {
    "tStartMs": 1386867,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "and I think our audience\nwould really wanna hear"
    } ]
  }, {
    "tStartMs": 1388957,
    "dDurationMs": 2074,
    "segs": [ {
      "utf8": "that you're actually making\nthe technical changes"
    } ]
  }, {
    "tStartMs": 1391031,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "to stop this from ever happening again."
    } ]
  }, {
    "tStartMs": 1393067,
    "dDurationMs": 3703,
    "segs": [ {
      "utf8": "- 'Cause when you think about\nit from a scale perspective"
    } ]
  }, {
    "tStartMs": 1396770,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "and whether the network level defenses"
    } ]
  }, {
    "tStartMs": 1398739,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "that we have are effective in making sure"
    } ]
  }, {
    "tStartMs": 1401510,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "that this type of\nvulnerability is isolated,"
    } ]
  }, {
    "tStartMs": 1405020,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "we believe it is effective."
    } ]
  }, {
    "tStartMs": 1406640,
    "dDurationMs": 2424,
    "segs": [ {
      "utf8": "Because if it wasn't, you\nwould hear a lot more data"
    } ]
  }, {
    "tStartMs": 1409064,
    "dDurationMs": 3297,
    "segs": [ {
      "utf8": "about how this is an\nissue, and it simply isn't."
    } ]
  }, {
    "tStartMs": 1412361,
    "dDurationMs": 3224,
    "segs": [ {
      "utf8": "The point that I'm making is\nthat you're never gonna be able"
    } ]
  }, {
    "tStartMs": 1415585,
    "dDurationMs": 4747,
    "segs": [ {
      "utf8": "to completely eradicate\nany specific type of fraud"
    } ]
  }, {
    "tStartMs": 1420332,
    "dDurationMs": 1942,
    "segs": [ {
      "utf8": "'cause it's going to exist, right?"
    } ]
  }, {
    "tStartMs": 1422274,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "- Yes.\n- What I'm saying"
    } ]
  }, {
    "tStartMs": 1423604,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "is that we have the right\ndetections in place to ensure"
    } ]
  }, {
    "tStartMs": 1427224,
    "dDurationMs": 3839,
    "segs": [ {
      "utf8": "that this type of fraud is not endemic."
    } ]
  }, {
    "tStartMs": 1431063,
    "dDurationMs": 1726,
    "segs": [ {
      "utf8": "- Would it not be even better"
    } ]
  }, {
    "tStartMs": 1432789,
    "dDurationMs": 2531,
    "segs": [ {
      "utf8": "to just say this type of\nfraud is not possible."
    } ]
  }, {
    "tStartMs": 1435320,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "Why not just say it's not probable?"
    } ]
  }, {
    "tStartMs": 1436741,
    "dDurationMs": 1279,
    "segs": [ {
      "utf8": "Why not just totally get rid of it"
    } ]
  }, {
    "tStartMs": 1438020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "by implementing an\nactual technical change?"
    } ]
  }, {
    "tStartMs": 1440630,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "- If you think about for every $100"
    } ]
  }, {
    "tStartMs": 1443810,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "of spend that occurs on card payments."
    } ]
  }, {
    "tStartMs": 1447530,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "10 cents of that is lost to fraud."
    } ]
  }, {
    "tStartMs": 1450650,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So, every $100 it's 10 cents."
    } ]
  }, {
    "tStartMs": 1453410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If you look at in-person transactions,"
    } ]
  }, {
    "tStartMs": 1455810,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "which is what kind of this topic"
    } ]
  }, {
    "tStartMs": 1458330,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "is really much more related to."
    } ]
  }, {
    "tStartMs": 1459953,
    "dDurationMs": 2697,
    "segs": [ {
      "utf8": "That number goes down to 2 cents"
    } ]
  }, {
    "tStartMs": 1462650,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "for every $100 of fraud that's being made."
    } ]
  }, {
    "tStartMs": 1466910,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- So, I've been thinking about this hack"
    } ]
  }, {
    "tStartMs": 1468320,
    "dDurationMs": 1726,
    "segs": [ {
      "utf8": "and it reminds me a lot about people"
    } ]
  }, {
    "tStartMs": 1470046,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "who are afraid of flying."
    } ]
  }, {
    "tStartMs": 1472010,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Statistically, you're a lot more likely"
    } ]
  }, {
    "tStartMs": 1473660,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to crash on the drive to the airport"
    } ]
  }, {
    "tStartMs": 1475760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "than you are in the air."
    } ]
  }, {
    "tStartMs": 1477440,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "So, I do understand\nVisa's argument generally."
    } ]
  }, {
    "tStartMs": 1480410,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Compared to other kinds of fraud,"
    } ]
  }, {
    "tStartMs": 1481850,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "this is just a drop in the ocean."
    } ]
  }, {
    "tStartMs": 1484100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But airlines don't accept"
    } ]
  }, {
    "tStartMs": 1485780,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "a small number of crashes each year"
    } ]
  }, {
    "tStartMs": 1487523,
    "dDurationMs": 2817,
    "segs": [ {
      "utf8": "as an inevitable cost of doing business."
    } ]
  }, {
    "tStartMs": 1490340,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "No. Anytime there's a crash,\nthey analyze it meticulously."
    } ]
  }, {
    "tStartMs": 1493910,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And then they do everything in their power"
    } ]
  }, {
    "tStartMs": 1495470,
    "dDurationMs": 2394,
    "segs": [ {
      "utf8": "to make sure that it's\nnever gonna happen again."
    } ]
  }, {
    "tStartMs": 1497864,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "Visa says that they'll\nget you your money back"
    } ]
  }, {
    "tStartMs": 1500330,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and that's great."
    } ]
  }, {
    "tStartMs": 1502040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But you've still gotta notice the charge,"
    } ]
  }, {
    "tStartMs": 1503780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "dispute it, and then wait."
    } ]
  }, {
    "tStartMs": 1506120,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Imagine waking up to see\n$10,000 gone from your account."
    } ]
  }, {
    "tStartMs": 1509660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "That's money for rent, insurance,"
    } ]
  }, {
    "tStartMs": 1512120,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "car payment, or a medical bill."
    } ]
  }, {
    "tStartMs": 1514460,
    "dDurationMs": 1295,
    "segs": [ {
      "utf8": "Even if the refund does come,"
    } ]
  }, {
    "tStartMs": 1515755,
    "dDurationMs": 3055,
    "segs": [ {
      "utf8": "the stress before is gonna be very real."
    } ]
  }, {
    "tStartMs": 1518810,
    "dDurationMs": 1988,
    "segs": [ {
      "utf8": "So for me, the question\nis whether just saying"
    } ]
  }, {
    "tStartMs": 1520798,
    "dDurationMs": 3052,
    "segs": [ {
      "utf8": "they're gonna refund it after\nthe fact is good enough."
    } ]
  }, {
    "tStartMs": 1523850,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Or when a system touches\nthe lives of so many people,"
    } ]
  }, {
    "tStartMs": 1527270,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "should we expect better?"
    } ]
  }, {
    "tStartMs": 1533471,
    "dDurationMs": 1486,
    "segs": [ {
      "utf8": "Okay, yeah. That's the whole demo."
    } ]
  }, {
    "tStartMs": 1534957,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I will now give you your money back."
    } ]
  }, {
    "tStartMs": 1536457,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 1539021,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "- [Henry] Okay, we gotta."
    } ]
  } ]
}
