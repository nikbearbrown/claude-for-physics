  }, {
    "tStartMs": 25380,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "No, maybe $5?"
    } ]
  }, {
    "tStartMs": 26213,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "Let's start with something like-"
    } ]
  }, {
    "tStartMs": 27360,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- Yeah, five. Five.\n- Start with five."
    } ]
  }, {
    "tStartMs": 28500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- That sounds great.\n- Yeah. Five bucks."
    } ]
  }, {
    "tStartMs": 30360,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Do you think that we can take,"
    } ]
  }, {
    "tStartMs": 31650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "like, will we be able to\nget this out of your phone?"
    } ]
  }, {
    "tStartMs": 34260,
    "dDurationMs": 4947,
    "segs": [ {
      "utf8": "- I hope not, but I\nkinda feel like you will."
    } ]
  }, {
    "tStartMs": 40433,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Let's see."
    } ]
  }, {
    "tStartMs": 41723,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "- So, now I'm gonna\ncharge $5 on this device."
    } ]
  }, {
    "tStartMs": 44820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Your phone's still locked, right?"
    } ]
  }, {
    "tStartMs": 46320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yep."
    } ]
  }, {
    "tStartMs": 47153,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "- I haven't done anything.\n- It's like a David Blaine."
    } ]
  }, {
    "tStartMs": 49200,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "- [Henry] It's like the\nnerdiest David Blaine."
    } ]
  }, {
    "tStartMs": 50630,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "- Yeah. (chuckles)"
    } ]
  }, {
    "tStartMs": 52230,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- Sweet, so."
    } ]
  }, {
    "tStartMs": 53700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Just try to tap. We'll go."
    } ]
  }, {
    "tStartMs": 56040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "(phone chimes)"
    } ]
  }, {
    "tStartMs": 58920,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "- What just happened on my phone?"
    } ]
  }, {
    "tStartMs": 62400,
    "dDurationMs": 1846,
    "segs": [ {
      "utf8": "Approved? Whoa, whoa, approved."
    } ]
  }, {
    "tStartMs": 64246,
    "dDurationMs": 1244,
    "segs": [ {
      "utf8": "(coins clinking)\nSo, okay."
    } ]
  }, {
    "tStartMs": 65490,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "I heard something happen on my phone"
    } ]
  }, {
    "tStartMs": 66449,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "while you tapped this on this."
    } ]
  }, {
    "tStartMs": 68130,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 72270,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "We got a little receipt for you."
    } ]
  }, {
    "tStartMs": 76449,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "- Credit verified on device, $5."
