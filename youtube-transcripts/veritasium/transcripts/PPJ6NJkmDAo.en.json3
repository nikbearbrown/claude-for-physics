  "events": [ {
    "tStartMs": 120,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- I'm here with MKBHD,"
    } ]
  }, {
    "tStartMs": 1260,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "and we're gonna try to steal\n$10,000 from his locked iPhone."
    } ]
  }, {
    "tStartMs": 4800,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- Really hope it doesn't work."
    } ]
  }, {
    "tStartMs": 5910,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Really hope it doesn't work."
    } ]
  }, {
    "tStartMs": 7260,
    "dDurationMs": 1095,
    "segs": [ {
      "utf8": "- I'm gonna get you to put that phone down"
    } ]
  }, {
    "tStartMs": 8355,
    "dDurationMs": 1515,
    "segs": [ {
      "utf8": "on top of this device."
    } ]
  }, {
    "tStartMs": 9870,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "- [Marques] Okay.\n- Just put it down there."
    } ]
  }, {
    "tStartMs": 11536,
    "dDurationMs": 2144,
    "segs": [ {
      "utf8": "- Just put it on like a, all right."
    } ]
  }, {
    "tStartMs": 13680,
    "dDurationMs": 1032,
    "segs": [ {
      "utf8": "- I feel like I'm a bit of a magician,"
    } ]
  }, {
    "tStartMs": 14712,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but I'm like-\n- Yeah."
