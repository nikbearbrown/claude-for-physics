  }, {
    "tStartMs": 15545,
    "dDurationMs": 1015,
    "segs": [ {
      "utf8": "- I haven't changed anything, right?"
    } ]
  }, {
    "tStartMs": 16560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- Okay. Yeah."
    } ]
  }, {
    "tStartMs": 17760,
    "dDurationMs": 1047,
    "segs": [ {
      "utf8": "- It's still locked.\n- It's locked."
    } ]
  }, {
    "tStartMs": 18807,
    "dDurationMs": 1076,
    "segs": [ {
      "utf8": "- Nothing else.\n- Yeah."
    } ]
  }, {
    "tStartMs": 19883,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "- This is just a regular payment terminal."
    } ]
  }, {
    "tStartMs": 21531,
    "dDurationMs": 1029,
    "segs": [ {
      "utf8": "- Yeah.\n- Nothing weird about that."
