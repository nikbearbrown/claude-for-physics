{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "- Glass is inherently brittle."
    } ]
  }, {
    "tStartMs": 2456,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(glass smashing)"
    } ]
  }, {
    "tStartMs": 3289,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "It is the very symbol\nwe use for fragility."
    } ]
  }, {
    "tStartMs": 5970,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But these days, we expect\nso much from this material."
    } ]
  }, {
    "tStartMs": 9270,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We want it to be perfectly transparent,"
    } ]
  }, {
    "tStartMs": 11670,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "scratch resistant,\nthin, and even flexible."
    } ]
  }, {
    "tStartMs": 15480,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "But most of all, we want it not to break."
    } ]
  }, {
    "tStartMs": 18420,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "So is it possible to\nmake unbreakable glass?"
    } ]
  }, {
    "tStartMs": 22110,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Well, in this video, I will make the case"
    } ]
  }, {
    "tStartMs": 23670,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "that glass is one of the\nmost important materials"
    } ]
  }, {
    "tStartMs": 26160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "humans have ever made."
    } ]
  }, {
    "tStartMs": 27900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It has transformed how we live,"
    } ]
  }, {
    "tStartMs": 30060,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "launched numerous scientific revolutions,"
    } ]
  }, {
    "tStartMs": 32190,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and forever altered how we think"
    } ]
  }, {
    "tStartMs": 34230,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "about our place in the universe."
    } ]
  }, {
    "tStartMs": 38160,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "Part of this video was sponsored by Saily."
    } ]
  }, {
    "tStartMs": 42540,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "In mid 2006, Steve Jobs had a problem."
    } ]
  }, {
    "tStartMs": 45840,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Apple was working on the first iPhone,"
    } ]
  }, {
    "tStartMs": 47850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "set to be released in January 2007."
    } ]
  }, {
    "tStartMs": 50640,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "But Jobs wasn't satisfied with the screen."
    } ]
  }, {
    "tStartMs": 53430,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The prototypes he was\ntesting had plastic screens,"
    } ]
  }, {
    "tStartMs": 56190,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "which scratched easily."
    } ]
  }, {
    "tStartMs": 57840,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "So Jobs wanted glass, but\nregular glass wouldn't work."
    } ]
  }, {
    "tStartMs": 62220,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "It too would get scratched\nup and it would also shatter."
    } ]
  }, {
    "tStartMs": 66300,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Plus, he wanted the phone to be slick,"
    } ]
  }, {
    "tStartMs": 68730,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so the glass had to be really thin."
    } ]
  }, {
    "tStartMs": 71010,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "So he called up the CEO\nof Corning, Wendell Weeks,"
    } ]
  }, {
    "tStartMs": 74760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "to ask him to make the glass for Apple."
    } ]
  }, {
    "tStartMs": 77040,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And six months later, it\nwas on the first iPhone."
    } ]
  }, {
    "tStartMs": 80700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "This was Gorilla Glass."
    } ]
  }, {
    "tStartMs": 83550,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Gorilla Glass has been\nused in phones, computers,"
    } ]
  }, {
    "tStartMs": 86070,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and wearable devices\nfor the last 17 years."
    } ]
  }, {
    "tStartMs": 88950,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Now it's used on billions of devices,"
    } ]
  }, {
    "tStartMs": 91530,
    "dDurationMs": 3213,
    "segs": [ {
      "utf8": "and over the years it's\nbecome a lot more durable."
    } ]
  }, {
    "tStartMs": 96180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So we sent Veritasium producer, Petr,"
    } ]
  }, {
    "tStartMs": 98130,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "to Corning's headquarters,"
    } ]
  }, {
    "tStartMs": 99210,
    "dDurationMs": 2672,
    "segs": [ {
      "utf8": "to see for ourselves how\nGorilla Glass is made"
    } ]
  }, {
    "tStartMs": 101882,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "and how it works."
    } ]
  }, {
    "tStartMs": 103950,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- We'll need a volunteer."
    } ]
  }, {
    "tStartMs": 105690,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "- [Petr] Yeah, guess that's me."
    } ]
  }, {
    "tStartMs": 108210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Demonstrator] All right,\nso this is what we call"
    } ]
  }, {
    "tStartMs": 109440,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "our key scratch demo."
    } ]
  }, {
    "tStartMs": 110700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "In here we have a polycarbonate,"
    } ]
  }, {
    "tStartMs": 113460,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "which is basically a plastic,"
    } ]
  }, {
    "tStartMs": 115410,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and then we have the Gorilla Glass."
    } ]
  }, {
    "tStartMs": 116880,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And what you can do is\nscratch this side first,"
    } ]
  }, {
    "tStartMs": 119820,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the polycarbonate, see how it goes."
    } ]
  }, {
    "tStartMs": 123240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- [Petr] Yep, definitely scratches."
    } ]
  }, {
    "tStartMs": 124800,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Yep.\n- Try to scratch in our logo."
    } ]
  }, {
    "tStartMs": 127290,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Not quite.\n- There you go."
    } ]
  }, {
    "tStartMs": 129657,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Petr] Are we getting it?"
    } ]
  }, {
    "tStartMs": 130490,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "Veritasium."
    } ]
  }, {
    "tStartMs": 131964,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Camera Operator] Yes."
    } ]
  }, {
    "tStartMs": 132797,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Petr] All right."
    } ]
  }, {
    "tStartMs": 133630,
    "dDurationMs": 1017,
    "segs": [ {
      "utf8": "- [Demonstrator] So now try the same thing"
    } ]
  }, {
    "tStartMs": 134647,
    "dDurationMs": 1073,
    "segs": [ {
      "utf8": "on the other side."
    } ]
  }, {
    "tStartMs": 135720,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "So this is Gorilla Glass."
    } ]
  }, {
    "tStartMs": 137310,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "- [Petr] Yeah, definitely\ndoes not scratch."
    } ]
  }, {
    "tStartMs": 141030,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "- [Narrator] To break\nglass requires two things,"
    } ]
  }, {
    "tStartMs": 143250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a flaw and stress."
    } ]
  }, {
    "tStartMs": 145170,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "To introduce the flaw,\nthey sandblasted a spot"
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "in the middle of the glass\nto roughen up its surface."
    } ]
  }, {
    "tStartMs": 150810,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "And Petr will apply the stress."
    } ]
  }, {
    "tStartMs": 153720,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- [Demonstrator] Take that tip\nand put it inside that circle"
    } ]
  }, {
    "tStartMs": 156240,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and push down."
    } ]
  }, {
    "tStartMs": 157740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "See if you can break it apart."
    } ]
  }, {
    "tStartMs": 160200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Not too hard, right?"
    } ]
  }, {
    "tStartMs": 161033,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "- [Petr] No."
    } ]
  }, {
    "tStartMs": 162300,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Demonstrator] All\nright, so next we have"
    } ]
  }, {
    "tStartMs": 163470,
    "dDurationMs": 969,
    "segs": [ {
      "utf8": "strengthened soda lime."
    } ]
  }, {
    "tStartMs": 164439,
    "dDurationMs": 2511,
    "segs": [ {
      "utf8": "Strengthened as much as\nyou can for soda lime."
    } ]
  }, {
    "tStartMs": 166950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So, all right."
    } ]
  }, {
    "tStartMs": 168744,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "(glass cracking)"
    } ]
  }, {
    "tStartMs": 169711,
    "dDurationMs": 894,
    "segs": [ {
      "utf8": "- [Petr] Harder, for sure."
    } ]
  }, {
    "tStartMs": 170605,
    "dDurationMs": 1025,
    "segs": [ {
      "utf8": "- Harder, a little bit?"
    } ]
  }, {
    "tStartMs": 171630,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Next we have Gorilla Glass."
    } ]
  }, {
    "tStartMs": 173040,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "- [Petr] I'm kind of terrified."
    } ]
  }, {
    "tStartMs": 177060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Oh, Man."
    } ]
  }, {
    "tStartMs": 179462,
    "dDurationMs": 3808,
    "segs": [ {
      "utf8": "(laughing) I know like we\ndon't actually want to do this,"
    } ]
  }, {
    "tStartMs": 183270,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "but I want to do this."
    } ]
  }, {
    "tStartMs": 184260,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So."
    } ]
  }, {
    "tStartMs": 186481,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "(Petr grunting)"
    } ]
  }, {
    "tStartMs": 189747,
    "dDurationMs": 1236,
    "segs": [ {
      "utf8": "Are you kidding me?"
    } ]
  }, {
    "tStartMs": 191995,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "- There's two responses."
    } ]
  }, {
    "tStartMs": 195120,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "The first response is either,"
    } ]
  }, {
    "tStartMs": 196687,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "\"This is a really great demo,"
    } ]
  }, {
    "tStartMs": 198120,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I completely understand\nwhat you're showing me.\""
    } ]
  }, {
    "tStartMs": 200430,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The second response is,"
    } ]
  }, {
    "tStartMs": 202050,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "'I'm taking this personally,"
    } ]
  }, {
    "tStartMs": 204592,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": "and I need to try to break this glass.\""
    } ]
  }, {
    "tStartMs": 206156,
    "dDurationMs": 977,
    "segs": [ {
      "utf8": "- Okay."
    } ]
  }, {
    "tStartMs": 207133,
    "dDurationMs": 1194,
    "segs": [ {
      "utf8": "It is a very good demo."
    } ]
  }, {
    "tStartMs": 208327,
    "dDurationMs": 3113,
    "segs": [ {
      "utf8": "I'm like genuinely really\nimpressed at this point."
    } ]
  }, {
    "tStartMs": 211440,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I still want to break the glass."
    } ]
  }, {
    "tStartMs": 213990,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "Right, last one."
    } ]
  }, {
    "tStartMs": 217500,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 218610,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "Like, I'm bending the stylus."
    } ]
  }, {
    "tStartMs": 222510,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "Okay, amazing"
    } ]
  }, {
    "tStartMs": 227280,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "- Glass has existed in\nnature for billions of years."
    } ]
  }, {
    "tStartMs": 230970,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It's formed by meteorite impacts,"
    } ]
  }, {
    "tStartMs": 233040,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "lightning strikes and volcanic eruptions."
    } ]
  }, {
    "tStartMs": 235950,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But when humans came along,\nthey found ways to use glass."
    } ]
  }, {
    "tStartMs": 239370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Obsidian is volcanic glass."
    } ]
  }, {
    "tStartMs": 241710,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It forms when lava cools quickly."
    } ]
  }, {
    "tStartMs": 244110,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "It's extremely brittle,"
    } ]
  }, {
    "tStartMs": 245700,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "so when you hit it with another rock,"
    } ]
  }, {
    "tStartMs": 247470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you can chip off sections of it"
    } ]
  }, {
    "tStartMs": 249060,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to make a sharper and sharper edge."
    } ]
  }, {
    "tStartMs": 251700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "There's evidence of obsidian being used"
    } ]
  }, {
    "tStartMs": 254040,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "for cutting implements,\narrowheads and tips of spears,"
    } ]
  }, {
    "tStartMs": 257310,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "as early as 1.2 million years ago."
    } ]
  }, {
    "tStartMs": 261390,
    "dDurationMs": 1455,
    "segs": [ {
      "utf8": "And it hasn't gone out of fashion."
    } ]
  }, {
    "tStartMs": 262845,
    "dDurationMs": 3195,
    "segs": [ {
      "utf8": "Today, some surgical\nscalpels have their tips"
    } ]
  }, {
    "tStartMs": 266040,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "sharpened to just three nanometers across,"
    } ]
  }, {
    "tStartMs": 269182,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "and the best material for\nthis purpose is obsidian."
    } ]
  }, {
    "tStartMs": 274707,
    "dDurationMs": 3873,
    "segs": [ {
      "utf8": "Compared to the million plus\nyears we've been using glass,"
    } ]
  }, {
    "tStartMs": 278580,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "we only started making it very recently,"
    } ]
  }, {
    "tStartMs": 281190,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "around 5,600 years ago."
    } ]
  }, {
    "tStartMs": 283770,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Most common glass is composed\nmainly of oxygen and silicon."
    } ]
  }, {
    "tStartMs": 287610,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "The two most abundant\nelements in Earth's crust."
    } ]
  }, {
    "tStartMs": 290352,
    "dDurationMs": 3078,
    "segs": [ {
      "utf8": "In nature, you find them\nin the form of quartz,"
    } ]
  }, {
    "tStartMs": 293430,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "crystalline silicon dioxide."
    } ]
  }, {
    "tStartMs": 295830,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Crystalline means that\nthe atoms are arranged"
    } ]
  }, {
    "tStartMs": 297900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in a regular repeating structure,"
    } ]
  }, {
    "tStartMs": 300000,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and quartz is the primary\nconstituent of sand."
    } ]
  }, {
    "tStartMs": 303570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So if you take some sand,"
    } ]
  }, {
    "tStartMs": 305400,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "heat it up to about 1700\ndegrees Celsius until it melts,"
    } ]
  }, {
    "tStartMs": 308610,
    "dDurationMs": 3453,
    "segs": [ {
      "utf8": "and then rapidly cool it, it forms glass."
    } ]
  }, {
    "tStartMs": 314039,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "During the rapid cooling process,"
    } ]
  }, {
    "tStartMs": 316380,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "the atoms don't have enough time"
    } ]
  }, {
    "tStartMs": 317790,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to return to their periodically\narranged crystal structure."
    } ]
  }, {
    "tStartMs": 321150,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So instead they are stuck where they are,"
    } ]
  }, {
    "tStartMs": 323850,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "like a liquid that's been\nflash frozen in place."
    } ]
  }, {
    "tStartMs": 327480,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "That is why glass is\nconsidered an amorphous solid."
    } ]
  }, {
    "tStartMs": 330630,
    "dDurationMs": 2062,
    "segs": [ {
      "utf8": "Amorphous just means disorganized,"
    } ]
  }, {
    "tStartMs": 332692,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "not in any regular arrangement."
    } ]
  }, {
    "tStartMs": 335258,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "But perhaps this is where\nthe misconception about glass"
    } ]
  }, {
    "tStartMs": 338520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "being a liquid comes from."
    } ]
  }, {
    "tStartMs": 340620,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "It isn't a liquid at room temperature."
    } ]
  }, {
    "tStartMs": 342990,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Glass is solid because the\natoms are fixed in place."
    } ]
  }, {
    "tStartMs": 345660,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "They can't flow past each\nother like in a liquid."
    } ]
  }, {
    "tStartMs": 348810,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I even made a video about\nthis nine years ago."
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "They are disordered, but they are solid."
    } ]
  }, {
    "tStartMs": 356280,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "This amorphous structure is\nalso what makes glass so brittle"
    } ]
  }, {
    "tStartMs": 359580,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "because there's no way for the\nstructure to relieve stress."
    } ]
  }, {
    "tStartMs": 363240,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "When stress is applied to the glass"
    } ]
  }, {
    "tStartMs": 364950,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "a small crack will form\nat a flaw on the surface."
    } ]
  }, {
    "tStartMs": 368010,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And as the glass cracks,"
    } ]
  }, {
    "tStartMs": 369390,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "the stress is applied to\natoms with fewer neighbors."
    } ]
  }, {
    "tStartMs": 372120,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So the crack grows bigger,"
    } ]
  }, {
    "tStartMs": 373500,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "which eventually leads\nto the glass fracturing."
    } ]
  }, {
    "tStartMs": 377310,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- [Demonstrator] So next\nwe'll move to what we call"
    } ]
  }, {
    "tStartMs": 378630,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "the slapper demos."
    } ]
  }, {
    "tStartMs": 379890,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "What we're using is sandpaper."
    } ]
  }, {
    "tStartMs": 382392,
    "dDurationMs": 2868,
    "segs": [ {
      "utf8": "This represents like an\nasphalt type surface."
    } ]
  }, {
    "tStartMs": 385260,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Sure."
    } ]
  }, {
    "tStartMs": 386093,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "- So if you were to get outta your car"
    } ]
  }, {
    "tStartMs": 387930,
    "dDurationMs": 2207,
    "segs": [ {
      "utf8": "and you accidentally drop\nyour phone in the parking lot."
    } ]
  }, {
    "tStartMs": 390137,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "And what we're using is this fixture."
    } ]
  }, {
    "tStartMs": 393870,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It's bending it."
    } ]
  }, {
    "tStartMs": 394703,
    "dDurationMs": 1597,
    "segs": [ {
      "utf8": "- Mm hm.\n- So it's pre-stressing it."
    } ]
  }, {
    "tStartMs": 396300,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You have our rough surface\nto introduce the flaw."
    } ]
  }, {
    "tStartMs": 398850,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And on here we have an alternative glass."
    } ]
  }, {
    "tStartMs": 401070,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Similar to some of the competitive stuff,"
    } ]
  }, {
    "tStartMs": 403170,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "different things on the market."
    } ]
  }, {
    "tStartMs": 404400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And when you're ready, you can drop."
    } ]
  }, {
    "tStartMs": 406920,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "- On three, two, one."
    } ]
  }, {
    "tStartMs": 409089,
    "dDurationMs": 1671,
    "segs": [ {
      "utf8": "(glass clanging)"
    } ]
  }, {
    "tStartMs": 410760,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Some sounds."
    } ]
  }, {
    "tStartMs": 412560,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Okay.\n- Right."
    } ]
  }, {
    "tStartMs": 413640,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- So it broke.\n- Not what you wanna see"
    } ]
  }, {
    "tStartMs": 415110,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "when you pick up your\nphone off the parking lot."
    } ]
  }, {
    "tStartMs": 417660,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "- [Petr] No."
    } ]
  }, {
    "tStartMs": 418500,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Heartbreak."
    } ]
  }, {
    "tStartMs": 419850,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- And then we have the Gorilla Glass"
    } ]
  }, {
    "tStartMs": 421260,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and what we call the mega slap."
    } ]
  }, {
    "tStartMs": 422940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "All right, very exciting name, right?"
    } ]
  }, {
    "tStartMs": 425670,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Now you can see me dramatically\nincrease the height."
    } ]
  }, {
    "tStartMs": 428220,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- Shall I do it from here?"
    } ]
  }, {
    "tStartMs": 429240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "- Nope, from...\n- The very top?"
    } ]
  }, {
    "tStartMs": 430770,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- From the very top.\n- Okay."
    } ]
  }, {
    "tStartMs": 432030,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So, we're not just increasing the height,"
    } ]
  }, {
    "tStartMs": 435390,
    "dDurationMs": 1243,
    "segs": [ {
      "utf8": "we're also starting from way up here."
    } ]
  }, {
    "tStartMs": 436633,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "- Right.\n- All right."
    } ]
  }, {
    "tStartMs": 438090,
    "dDurationMs": 2246,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 440336,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "(metal clanging)"
    } ]
  }, {
    "tStartMs": 444900,
    "dDurationMs": 1173,
    "segs": [ {
      "utf8": "No, we're good."
    } ]
  }, {
    "tStartMs": 447030,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "That's pretty cool."
    } ]
  }, {
    "tStartMs": 448838,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 450630,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- While, the basic recipe for glass"
    } ]
  }, {
    "tStartMs": 451950,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "involves silicon dioxide,"
    } ]
  }, {
    "tStartMs": 453570,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "glass makers have been\nadding other ingredients"
    } ]
  }, {
    "tStartMs": 455550,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "to change its properties\nfor thousands of years."
    } ]
  }, {
    "tStartMs": 458400,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Adding sodium carbonate,\nalso known as soda,"
    } ]
  }, {
    "tStartMs": 460890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and calcium oxide, also known as lime,"
    } ]
  }, {
    "tStartMs": 463590,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "lowers the temperature at\nwhich it becomes liquid"
    } ]
  }, {
    "tStartMs": 465750,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "from 1700 degrees Celsius"
    } ]
  }, {
    "tStartMs": 467850,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "to around a thousand degrees Celsius."
    } ]
  }, {
    "tStartMs": 470310,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And that's why soda lime\nglass accounts for around 90%"
    } ]
  }, {
    "tStartMs": 473730,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "of all glass manufactured today."
    } ]
  }, {
    "tStartMs": 476220,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Another recipe includes adding"
    } ]
  }, {
    "tStartMs": 477960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "boron trioxide to the mixture,"
    } ]
  }, {
    "tStartMs": 480000,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "forming a borosilicate glass."
    } ]
  }, {
    "tStartMs": 482370,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Glass is usually quite sensitive\nto changes in temperature."
    } ]
  }, {
    "tStartMs": 485310,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "If you throw boiling water\non your car's windshield,"
    } ]
  }, {
    "tStartMs": 487420,
    "dDurationMs": 3939,
    "segs": [ {
      "utf8": "it'll likely shatter due to\nthe glass rapidly expanding."
    } ]
  }, {
    "tStartMs": 491359,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "But borosilicate glass"
    } ]
  }, {
    "tStartMs": 493020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "has a really low coefficient\nof thermal expansion."
    } ]
  }, {
    "tStartMs": 495630,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "It doesn't grow or shrink very much,"
    } ]
  }, {
    "tStartMs": 497640,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "even with drastic temperature changes."
    } ]
  }, {
    "tStartMs": 499650,
    "dDurationMs": 3465,
    "segs": [ {
      "utf8": "So it's often used for\nlaboratory glass, like beakers."
    } ]
  }, {
    "tStartMs": 503115,
    "dDurationMs": 1729,
    "segs": [ {
      "utf8": "- [Group Member] Let's go."
    } ]
  }, {
    "tStartMs": 504844,
    "dDurationMs": 1526,
    "segs": [ {
      "utf8": "(bystander laughing)"
    } ]
  }, {
    "tStartMs": 506370,
    "dDurationMs": 2537,
    "segs": [ {
      "utf8": "- If you want to grab a pair\nof these screen glasses too?"
    } ]
  }, {
    "tStartMs": 508907,
    "dDurationMs": 1287,
    "segs": [ {
      "utf8": "- [Petr] Yeah."
    } ]
  }, {
    "tStartMs": 510194,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "- [Camera Operator] Oh yeah."
    } ]
  }, {
    "tStartMs": 512262,
    "dDurationMs": 1917,
    "segs": [ {
      "utf8": "- I can't see anything."
    } ]
  }, {
    "tStartMs": 516060,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Narrator] And while\nthis specific recipe"
    } ]
  }, {
    "tStartMs": 517530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for Gorilla Glass is secret,"
    } ]
  }, {
    "tStartMs": 519180,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "it is based on a combination of silicon,"
    } ]
  }, {
    "tStartMs": 521490,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "aluminum, magnesium, and sodium."
    } ]
  }, {
    "tStartMs": 526710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "And the recipe keeps changing."
    } ]
  }, {
    "tStartMs": 528240,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The scientists are constantly\ntrying different formulations"
    } ]
  }, {
    "tStartMs": 531030,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "to find more durable and\nscratch resistant glasses here."
    } ]
  }, {
    "tStartMs": 535987,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- This is so cool."
    } ]
  }, {
    "tStartMs": 537227,
    "dDurationMs": 2065,
    "segs": [ {
      "utf8": "Do you ever feel like a pizza chef?"
    } ]
  }, {
    "tStartMs": 539292,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "(group indistinct chattering)"
    } ]
  }, {
    "tStartMs": 540785,
    "dDurationMs": 878,
    "segs": [ {
      "utf8": "(Petr laughing)"
    } ]
  }, {
    "tStartMs": 541663,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "(group indistinct chattering)"
    } ]
  }, {
    "tStartMs": 543263,
    "dDurationMs": 3907,
    "segs": [ {
      "utf8": "(light upbeat music)"
    } ]
  }, {
    "tStartMs": 547170,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Narrator] This facility"
    } ]
  }, {
    "tStartMs": 548003,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "is actually where that\nexperimentation takes place."
    } ]
  }, {
    "tStartMs": 554048,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "(light music)"
    } ]
  }, {
    "tStartMs": 556350,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "The earliest human made\nglass was likely an accident."
    } ]
  }, {
    "tStartMs": 559920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "People have been working\nmetal for thousands of years"
    } ]
  }, {
    "tStartMs": 562470,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "before they made glass."
    } ]
  }, {
    "tStartMs": 563970,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "So it's thought that\nsome sand made its way"
    } ]
  }, {
    "tStartMs": 566520,
    "dDurationMs": 3889,
    "segs": [ {
      "utf8": "into metal working furnaces,\nforming small glass beads."
    } ]
  }, {
    "tStartMs": 570409,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "But soon glass making\nbecame its own art form,"
    } ]
  }, {
    "tStartMs": 573930,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to make decorations, ornaments, statues,"
    } ]
  }, {
    "tStartMs": 576630,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "tableware and containers."
    } ]
  }, {
    "tStartMs": 578422,
    "dDurationMs": 3518,
    "segs": [ {
      "utf8": "Unlike clay, glass is\nimpermeable to water,"
    } ]
  }, {
    "tStartMs": 581940,
    "dDurationMs": 3738,
    "segs": [ {
      "utf8": "making it an ideal material\nfor bowls and bottles."
    } ]
  }, {
    "tStartMs": 585678,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "But then glass makers noticed"
    } ]
  }, {
    "tStartMs": 587760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "that by adding other\nelements into the mix,"
    } ]
  }, {
    "tStartMs": 589800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "they could change the color of the glass."
    } ]
  }, {
    "tStartMs": 592050,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "By adding cobalt oxide,"
    } ]
  }, {
    "tStartMs": 593790,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "you would get a vivid blue."
    } ]
  }, {
    "tStartMs": 595770,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "Adding cuprite makes red."
    } ]
  }, {
    "tStartMs": 599550,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But all of the historical\nglasses we've been talking about"
    } ]
  }, {
    "tStartMs": 602250,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "have been opaque."
    } ]
  }, {
    "tStartMs": 603720,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Which is not really what\nwe think of as glass today."
    } ]
  }, {
    "tStartMs": 607230,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "After glass making was invented,"
    } ]
  }, {
    "tStartMs": 608970,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "thousands of years passed before"
    } ]
  }, {
    "tStartMs": 611070,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "we invented transparent glass."
    } ]
  }, {
    "tStartMs": 613320,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "That's because making it is\nactually pretty difficult."
    } ]
  }, {
    "tStartMs": 616481,
    "dDurationMs": 1129,
    "segs": [ {
      "utf8": "(light bright music)"
    } ]
  }, {
    "tStartMs": 617610,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The first step came around a hundred AD,"
    } ]
  }, {
    "tStartMs": 619860,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "when glass makers in Alexandria"
    } ]
  }, {
    "tStartMs": 621630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "added manganese dioxide into the mixture,"
    } ]
  }, {
    "tStartMs": 624240,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which led to a semi opaque glass."
    } ]
  }, {
    "tStartMs": 626730,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "It definitely wasn't transparent,"
    } ]
  }, {
    "tStartMs": 628560,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "but it did let some light through."
    } ]
  }, {
    "tStartMs": 631770,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "This is when glass began\nbeing used for windows."
    } ]
  }, {
    "tStartMs": 635160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And glass windows were a huge deal."
    } ]
  }, {
    "tStartMs": 637950,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I mean, they provide a physical barrier"
    } ]
  }, {
    "tStartMs": 640200,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that keeps the warm air in"
    } ]
  }, {
    "tStartMs": 641790,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and the wind and critters out,"
    } ]
  }, {
    "tStartMs": 643770,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "while still allowing light\nto shine into your home."
    } ]
  }, {
    "tStartMs": 648216,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "But the first truly transparent glass"
    } ]
  }, {
    "tStartMs": 650550,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "was made many centuries later,"
    } ]
  }, {
    "tStartMs": 652530,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "around the Italian city of Venice."
    } ]
  }, {
    "tStartMs": 654960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "The art of glass making was thriving"
    } ]
  }, {
    "tStartMs": 657210,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "and bringing a lot of money into the city."
    } ]
  }, {
    "tStartMs": 659830,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "(cash register dinging)"
    } ]
  }, {
    "tStartMs": 661470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "There was just one problem."
    } ]
  }, {
    "tStartMs": 663060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "To make and manipulate glass\nyou need very hot furnaces."
    } ]
  }, {
    "tStartMs": 666540,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And at the time, Venice was a city"
    } ]
  }, {
    "tStartMs": 668580,
    "dDurationMs": 2676,
    "segs": [ {
      "utf8": "built almost entirely out of wood."
    } ]
  }, {
    "tStartMs": 671256,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "So yeah, glass makers were bringing"
    } ]
  }, {
    "tStartMs": 673860,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "a lot of money into the city,"
    } ]
  }, {
    "tStartMs": 675390,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "but they also kept\naccidentally burning it down."
    } ]
  }, {
    "tStartMs": 678930,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So in 1291, the government\nof Venice had had enough,"
    } ]
  }, {
    "tStartMs": 682350,
    "dDurationMs": 4471,
    "segs": [ {
      "utf8": "so they moved all the glass\nmakers to the island of Murano."
    } ]
  }, {
    "tStartMs": 686821,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "The island became known\nas the Isle of Glass,"
    } ]
  }, {
    "tStartMs": 690450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "celebrated for making the most beautiful"
    } ]
  }, {
    "tStartMs": 692520,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "and intricate glassware anywhere on earth."
    } ]
  }, {
    "tStartMs": 695610,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "This is also where the glass\nmaker, Angelo Barovier,"
    } ]
  }, {
    "tStartMs": 698820,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "invented clear glass."
    } ]
  }, {
    "tStartMs": 701010,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "He took some seaweed rich in\npotassium oxide and manganese"
    } ]
  }, {
    "tStartMs": 704940,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and burned it to create ash."
    } ]
  }, {
    "tStartMs": 707010,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Then he added this ash into his glass."
    } ]
  }, {
    "tStartMs": 709890,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "And when it cooled, he found\nthat the glass was transparent."
    } ]
  }, {
    "tStartMs": 716213,
    "dDurationMs": 3787,
    "segs": [ {
      "utf8": "Most materials are opaque\nbecause when photons hit them,"
    } ]
  }, {
    "tStartMs": 720000,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "the photons are absorbed."
    } ]
  }, {
    "tStartMs": 721470,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "The photon excites an electron,"
    } ]
  }, {
    "tStartMs": 723000,
    "dDurationMs": 2149,
    "segs": [ {
      "utf8": "pushing it up to a higher energy level."
    } ]
  }, {
    "tStartMs": 725149,
    "dDurationMs": 2651,
    "segs": [ {
      "utf8": "But this only happens\nwhen the photons energy"
    } ]
  }, {
    "tStartMs": 727800,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "matches the energy of an\nallowed electron transition."
    } ]
  }, {
    "tStartMs": 731050,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "And different materials have\ndifferent energy levels."
    } ]
  }, {
    "tStartMs": 733890,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In transparent glass,"
    } ]
  }, {
    "tStartMs": 736530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "the energy required to move an electron"
    } ]
  }, {
    "tStartMs": 738360,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "from a lower state to a higher state"
    } ]
  }, {
    "tStartMs": 740490,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "is higher than the amount of energy"
    } ]
  }, {
    "tStartMs": 742140,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "that a photon of visible light has."
    } ]
  }, {
    "tStartMs": 744750,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "So the photon just passes right through."
    } ]
  }, {
    "tStartMs": 748470,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Now, while glass is\ntransparent to visible light,"
    } ]
  }, {
    "tStartMs": 750690,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "it does interact with other parts"
    } ]
  }, {
    "tStartMs": 752340,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "of the electromagnetic spectrum."
    } ]
  }, {
    "tStartMs": 754470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "It absorbs much of the\nultraviolet spectrum,"
    } ]
  }, {
    "tStartMs": 756990,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "because UV photons have more energy."
    } ]
  }, {
    "tStartMs": 759690,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Hence, they can push the electron\nto the higher energy level"
    } ]
  }, {
    "tStartMs": 762570,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and be absorbed."
    } ]
  }, {
    "tStartMs": 764040,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "That makes it opaque to UV."
    } ]
  }, {
    "tStartMs": 768100,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "This is also how colored glass is made."
    } ]
  }, {
    "tStartMs": 771060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You add impurities into the glass,"
    } ]
  }, {
    "tStartMs": 773040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "which affects the electron energy levels,"
    } ]
  }, {
    "tStartMs": 775050,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "which then changes the color of the glass."
    } ]
  }, {
    "tStartMs": 777900,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "If you look at a pane of glass side on,"
    } ]
  }, {
    "tStartMs": 780090,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "you might notice that\nit looks slightly green,"
    } ]
  }, {
    "tStartMs": 782850,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "which is because the most\ncommon glass used for windows,"
    } ]
  }, {
    "tStartMs": 785640,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "soda lime, has impurities of iron oxides,"
    } ]
  }, {
    "tStartMs": 788580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which give the glass a green tinge."
    } ]
  }, {
    "tStartMs": 791040,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The glass absorbs more of the other colors"
    } ]
  }, {
    "tStartMs": 793050,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "than it does green."
    } ]
  }, {
    "tStartMs": 794940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So that's why we see it."
    } ]
  }, {
    "tStartMs": 799800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I think the only way we truly appreciate"
    } ]
  }, {
    "tStartMs": 802440,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "how important transparent glass is"
    } ]
  }, {
    "tStartMs": 804330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "would be if all of a\nsudden it disappeared."
    } ]
  }, {
    "tStartMs": 806880,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So your windows, glasses,\nscreens all gone."
    } ]
  }, {
    "tStartMs": 810420,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "But there is another\nelement in our daily lives"
    } ]
  }, {
    "tStartMs": 812760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that we take for granted,\nwhich is connectivity."
    } ]
  }, {
    "tStartMs": 815130,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I mean, we are always\nconnected to the internet,"
    } ]
  }, {
    "tStartMs": 818220,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and losing that connection,"
    } ]
  }, {
    "tStartMs": 819480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "even for a few minutes, can\nbe pretty uncomfortable,"
    } ]
  }, {
    "tStartMs": 822180,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "especially when you are traveling."
    } ]
  }, {
    "tStartMs": 824490,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Staying connected abroad requires"
    } ]
  }, {
    "tStartMs": 826590,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "either paying exorbitant roaming fees,"
    } ]
  }, {
    "tStartMs": 828611,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "or a continuous hunt for public wifi."
    } ]
  }, {
    "tStartMs": 831990,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But luckily, you can avoid all\nof this with today's sponsor,"
    } ]
  }, {
    "tStartMs": 835020,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Saily."
    } ]
  }, {
    "tStartMs": 835853,
    "dDurationMs": 3427,
    "segs": [ {
      "utf8": "Saily makes it incredibly\neasy to set up a cell plan"
    } ]
  }, {
    "tStartMs": 839280,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "with data in more than 150 countries."
    } ]
  }, {
    "tStartMs": 841890,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And it's way cheaper than roaming."
    } ]
  }, {
    "tStartMs": 844440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I went to Germany for our\nrecent thermite video,"
    } ]
  }, {
    "tStartMs": 846810,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and here's how easy it was\nto set up an eSIM with Saily."
    } ]
  }, {
    "tStartMs": 850410,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "After downloading the app to my phone,"
    } ]
  }, {
    "tStartMs": 852630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "all I had to do was click on the country,"
    } ]
  }, {
    "tStartMs": 854580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "select a plan, and activate the eSIM."
    } ]
  }, {
    "tStartMs": 857220,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Then when I landed, I instantly\nconnected to a local network"
    } ]
  }, {
    "tStartMs": 860550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with no hidden charges."
    } ]
  }, {
    "tStartMs": 862620,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "That was it."
    } ]
  }, {
    "tStartMs": 863580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "You don't have to use\nany shady public wifi"
    } ]
  }, {
    "tStartMs": 865620,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "or worry about scammers\nselling fake SIM cards"
    } ]
  }, {
    "tStartMs": 867810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "in front of the airport."
    } ]
  }, {
    "tStartMs": 869220,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Download Saily once and\nyou'll always be connected."
    } ]
  }, {
    "tStartMs": 872430,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And if you find out that your\nphone isn't eSIM compatible,"
    } ]
  }, {
    "tStartMs": 875580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you'll get a full refund."
    } ]
  }, {
    "tStartMs": 877680,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "To try Saily, you can scan this QR code,"
    } ]
  }, {
    "tStartMs": 880350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "or click the link in the description."
    } ]
  }, {
    "tStartMs": 882600,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Make sure to use code\nveritasium at checkout"
    } ]
  }, {
    "tStartMs": 884790,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "to get a special 15%\noff your first purchase."
    } ]
  }, {
    "tStartMs": 888120,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "So I wanna thank Saily for sponsoring"
    } ]
  }, {
    "tStartMs": 890070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "this part of the video."
    } ]
  }, {
    "tStartMs": 890903,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And now back to transparent glass."
    } ]
  }, {
    "tStartMs": 894746,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(light upbeat music)"
    } ]
  }, {
    "tStartMs": 895579,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "Truly transparent glass was a massive deal"
    } ]
  }, {
    "tStartMs": 898530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "for three reasons."
    } ]
  }, {
    "tStartMs": 900180,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Sometime in the early\n1300s, in northern Italy,"
    } ]
  }, {
    "tStartMs": 903240,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "this clear glass was\nground, shaped and polished"
    } ]
  }, {
    "tStartMs": 906720,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "into small discs"
    } ]
  }, {
    "tStartMs": 908250,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that were thicker in the\ncenter than at the edges."
    } ]
  }, {
    "tStartMs": 911040,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Due to their resemblance to lentil beans,"
    } ]
  }, {
    "tStartMs": 913470,
    "dDurationMs": 2283,
    "segs": [ {
      "utf8": "they became known as lenses."
    } ]
  }, {
    "tStartMs": 917820,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Glasses to correct farsightedness"
    } ]
  }, {
    "tStartMs": 919950,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "didn't seem all that\nimportant at the time,"
    } ]
  }, {
    "tStartMs": 922140,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "because literacy rates were so low,"
    } ]
  }, {
    "tStartMs": 924450,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "they were almost\nexclusively used by monks."
    } ]
  }, {
    "tStartMs": 928830,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But after the invention of the\nprinting press, circa 1440,"
    } ]
  }, {
    "tStartMs": 932430,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "glasses became a vital tool."
    } ]
  }, {
    "tStartMs": 934680,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "The printing press led\nto a precipitous drop"
    } ]
  }, {
    "tStartMs": 936710,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "in the cost of producing books,"
    } ]
  }, {
    "tStartMs": 938670,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "which led to a rapid\nincrease in literacy rates."
    } ]
  }, {
    "tStartMs": 942210,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Now a large number of people became aware"
    } ]
  }, {
    "tStartMs": 944430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that they were farsighted."
    } ]
  }, {
    "tStartMs": 945990,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Thankfully, there was\na technology available"
    } ]
  }, {
    "tStartMs": 948120,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "to solve the problem."
    } ]
  }, {
    "tStartMs": 951351,
    "dDurationMs": 3279,
    "segs": [ {
      "utf8": "150 years later, a father and son,"
    } ]
  }, {
    "tStartMs": 954630,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Hans and Zacharias Janssen,"
    } ]
  }, {
    "tStartMs": 956910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "put two lenses in line with each other,"
    } ]
  }, {
    "tStartMs": 959070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "rather than side by side."
    } ]
  }, {
    "tStartMs": 960960,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And this was likely the\nworld's first microscope."
    } ]
  }, {
    "tStartMs": 964170,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It made objects appear about\n20 times their original size."
    } ]
  }, {
    "tStartMs": 968610,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "In the 1660s,"
    } ]
  }, {
    "tStartMs": 969990,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Antony Van Leeuwenhoek made\nsignificant improvements"
    } ]
  }, {
    "tStartMs": 972930,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "on the microscope, by\ngrinding the lenses himself."
    } ]
  }, {
    "tStartMs": 976050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "He could magnify things 200 times,"
    } ]
  }, {
    "tStartMs": 978270,
    "dDurationMs": 2814,
    "segs": [ {
      "utf8": "allowing him to see human cells."
    } ]
  }, {
    "tStartMs": 981084,
    "dDurationMs": 3756,
    "segs": [ {
      "utf8": "A few years later, Robert\nHook published \"Micrographia,\""
    } ]
  }, {
    "tStartMs": 984840,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "a book full of beautiful sketches\nof the microscopic world."
    } ]
  }, {
    "tStartMs": 988560,
    "dDurationMs": 4053,
    "segs": [ {
      "utf8": "And all of this was possible\nbecause of transparent glass."
    } ]
  }, {
    "tStartMs": 993503,
    "dDurationMs": 4327,
    "segs": [ {
      "utf8": "And in 1608, Hans Lippershey,\nan eyeglass maker,"
    } ]
  }, {
    "tStartMs": 997830,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "applied for a patent for a spy glass."
    } ]
  }, {
    "tStartMs": 1000410,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "His idea was for it to be used in warfare"
    } ]
  }, {
    "tStartMs": 1002810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "to spy on your enemy on the battlefield."
    } ]
  }, {
    "tStartMs": 1005420,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "The next year, Galileo\nGalilei heard about his idea"
    } ]
  }, {
    "tStartMs": 1009410,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and realized that he could\npoint this device toward the sky"
    } ]
  }, {
    "tStartMs": 1012710,
    "dDurationMs": 3028,
    "segs": [ {
      "utf8": "to study the stars and planets."
    } ]
  }, {
    "tStartMs": 1015738,
    "dDurationMs": 3782,
    "segs": [ {
      "utf8": "Galileo's telescope magnified\nobjects in the night sky"
    } ]
  }, {
    "tStartMs": 1019520,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "by about 30 times."
    } ]
  }, {
    "tStartMs": 1021530,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "In 1610, he was able to see"
    } ]
  }, {
    "tStartMs": 1023240,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "he craters of the moon in\ndetail, the phases of Venus,"
    } ]
  }, {
    "tStartMs": 1027280,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and four of Jupiter's largest moons."
    } ]
  }, {
    "tStartMs": 1030440,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "These observations were the\nfinal nail in the coffin"
    } ]
  }, {
    "tStartMs": 1033740,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "for the geocentric model of the universe."
    } ]
  }, {
    "tStartMs": 1036260,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "He saw moons that were clearly\nrevolving around Jupiter"
    } ]
  }, {
    "tStartMs": 1039620,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and not the earth."
    } ]
  }, {
    "tStartMs": 1040940,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "And how else could you\nexplain the phases of Venus,"
    } ]
  }, {
    "tStartMs": 1043760,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "other than to say that the\nplanet must go around the sun?"
    } ]
  }, {
    "tStartMs": 1047900,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "None of this would've been discovered"
    } ]
  }, {
    "tStartMs": 1050330,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "without the invention\nof transparent glass."
    } ]
  }, {
    "tStartMs": 1055166,
    "dDurationMs": 3114,
    "segs": [ {
      "utf8": "Four centuries later,\nwe can now make glass"
    } ]
  }, {
    "tStartMs": 1058280,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "that is orders of magnitude\nmore transparent than water."
    } ]
  }, {
    "tStartMs": 1061581,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "Glass that is so transparent,"
    } ]
  }, {
    "tStartMs": 1063860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that if you were able to make a column"
    } ]
  }, {
    "tStartMs": 1065780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "as deep as the Mariana trench,"
    } ]
  }, {
    "tStartMs": 1067700,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "you'll be able to see all\nthe way to the bottom."
    } ]
  }, {
    "tStartMs": 1071570,
    "dDurationMs": 2793,
    "segs": [ {
      "utf8": "This is the glass inside optical fibers."
    } ]
  }, {
    "tStartMs": 1077942,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "- Oh, this is getting real."
    } ]
  }, {
    "tStartMs": 1079820,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "I'm stoked."
    } ]
  }, {
    "tStartMs": 1080720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "(camera operator laughing)"
    } ]
  }, {
    "tStartMs": 1083210,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "- [Narrator] But the\nmain thing we all need"
    } ]
  }, {
    "tStartMs": 1084890,
    "dDurationMs": 1971,
    "segs": [ {
      "utf8": "is durable glass."
    } ]
  }, {
    "tStartMs": 1086861,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "So how do you take a substance"
    } ]
  }, {
    "tStartMs": 1088460,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that is typically delicate and brittle"
    } ]
  }, {
    "tStartMs": 1090620,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "and improve its scratch\nresistance and drop resistance?"
    } ]
  }, {
    "tStartMs": 1094875,
    "dDurationMs": 2975,
    "segs": [ {
      "utf8": "First you start with an\naluminosilicate base,"
    } ]
  }, {
    "tStartMs": 1097850,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and then after the glass is made,"
    } ]
  }, {
    "tStartMs": 1099680,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "you submerge it in a\npotassium salt solution"
    } ]
  }, {
    "tStartMs": 1102050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "at 420 degrees Celsius."
    } ]
  }, {
    "tStartMs": 1105020,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- [Petr] It really does look like water."
    } ]
  }, {
    "tStartMs": 1106400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- [Camera Operator] Doesn't it?"
    } ]
  }, {
    "tStartMs": 1107660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 1108493,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "I don't know if I want to drink it."
    } ]
  }, {
    "tStartMs": 1110930,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Narrator] Potassium and sodium"
    } ]
  }, {
    "tStartMs": 1112010,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "are chemically very similar."
    } ]
  }, {
    "tStartMs": 1113330,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "I mean, they both have one\nelectron in their outer shell."
    } ]
  }, {
    "tStartMs": 1116350,
    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "So during this process,"
    } ]
  }, {
    "tStartMs": 1117553,
    "dDurationMs": 3787,
    "segs": [ {
      "utf8": "some of the sodium atoms are\nreplaced by potassium atoms"
    } ]
  }, {
    "tStartMs": 1121340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in the glass."
    } ]
  }, {
    "tStartMs": 1122540,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now, potassium atoms are physically larger"
    } ]
  }, {
    "tStartMs": 1125180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "than sodium atoms,"
    } ]
  }, {
    "tStartMs": 1126380,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but the glass is already set."
    } ]
  }, {
    "tStartMs": 1127790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "It's rigid, so it\ndoesn't increase in size."
    } ]
  }, {
    "tStartMs": 1131000,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So now there's the larger potassium atoms"
    } ]
  }, {
    "tStartMs": 1133340,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "all squeezed together,"
    } ]
  }, {
    "tStartMs": 1134810,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "taking up the same amount\nof space as before."
    } ]
  }, {
    "tStartMs": 1137960,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "This increases the compressive strength"
    } ]
  }, {
    "tStartMs": 1140570,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "in the surface of the glass,\nwhich makes it more durable."
    } ]
  }, {
    "tStartMs": 1145070,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "- [Camera Operator] Can you\nsee any visual difference"
    } ]
  }, {
    "tStartMs": 1146300,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "of size between them?"
    } ]
  }, {
    "tStartMs": 1149600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Honestly, no."
    } ]
  }, {
    "tStartMs": 1151683,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "I have two pieces of glass."
    } ]
  }, {
    "tStartMs": 1153350,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "One of them has gone through\nthe ion exchange process."
    } ]
  }, {
    "tStartMs": 1156283,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "The other one hasn't."
    } ]
  }, {
    "tStartMs": 1158090,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "I don't know which one is which."
    } ]
  }, {
    "tStartMs": 1159959,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "And we're gonna figure\nthat out really soon."
    } ]
  }, {
    "tStartMs": 1163361,
    "dDurationMs": 1875,
    "segs": [ {
      "utf8": "You guys ready?"
    } ]
  }, {
    "tStartMs": 1165236,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 1166875,
    "dDurationMs": 2208,
    "segs": [ {
      "utf8": "(glass shattering)"
    } ]
  }, {
    "tStartMs": 1169083,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 1170518,
    "dDurationMs": 1791,
    "segs": [ {
      "utf8": "(camera operator laughing)"
    } ]
  }, {
    "tStartMs": 1172309,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "That was really cool."
    } ]
  }, {
    "tStartMs": 1174483,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "(glass clanging)"
    } ]
  }, {
    "tStartMs": 1177110,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "Shall I hit it harder?\n- Yeah."
    } ]
  }, {
    "tStartMs": 1179522,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(glass clanging)"
    } ]
  }, {
    "tStartMs": 1180355,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "- Yeah, that was a thunk."
    } ]
  }, {
    "tStartMs": 1182261,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "My mind is genuinely blown."
    } ]
  }, {
    "tStartMs": 1183140,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "That's really cool."
    } ]
  }, {
    "tStartMs": 1184100,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "That's all just like ion exchange, right?"
    } ]
  }, {
    "tStartMs": 1186734,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "That's all just..."
    } ]
  }, {
    "tStartMs": 1188601,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "There's no other difference, right?"
    } ]
  }, {
    "tStartMs": 1190370,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- Yeah.\n- You put it in"
    } ]
  }, {
    "tStartMs": 1191690,
    "dDurationMs": 1765,
    "segs": [ {
      "utf8": "a bunch of salt.\n- Yep, for a few hours,"
    } ]
  }, {
    "tStartMs": 1193455,
    "dDurationMs": 1985,
    "segs": [ {
      "utf8": "and voila.\n- For a few hours."
    } ]
  }, {
    "tStartMs": 1195440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- Yep.\n- Ah."
    } ]
  }, {
    "tStartMs": 1196940,
    "dDurationMs": 2271,
    "segs": [ {
      "utf8": "- I'm trying to think of\na good analogy for this."
    } ]
  }, {
    "tStartMs": 1199211,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "You know, I can imagine"
    } ]
  }, {
    "tStartMs": 1200420,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "if there were just a whole bunch of people"
    } ]
  }, {
    "tStartMs": 1202100,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "sort of standing around casually"
    } ]
  }, {
    "tStartMs": 1203881,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "and you try to run through them,"
    } ]
  }, {
    "tStartMs": 1206120,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "you'd probably be able to\nbounce through a few of them,"
    } ]
  }, {
    "tStartMs": 1208160,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "break through the crowd."
    } ]
  }, {
    "tStartMs": 1209510,
    "dDurationMs": 1094,
    "segs": [ {
      "utf8": "But what if instead,"
    } ]
  }, {
    "tStartMs": 1210604,
    "dDurationMs": 2716,
    "segs": [ {
      "utf8": "all of those people\nwere squeezed together,"
    } ]
  }, {
    "tStartMs": 1213320,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "shoulder to shoulder, you know,"
    } ]
  }, {
    "tStartMs": 1214850,
    "dDurationMs": 2031,
    "segs": [ {
      "utf8": "like people trying to get\ninto a subway or something."
    } ]
  }, {
    "tStartMs": 1216881,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "If you try to run through them,"
    } ]
  }, {
    "tStartMs": 1218541,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "all of those forces are just\ngonna add up and prevent you"
    } ]
  }, {
    "tStartMs": 1222170,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "from getting in or from\nmaking a dent, making a crack,"
    } ]
  }, {
    "tStartMs": 1224900,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "anything like that."
    } ]
  }, {
    "tStartMs": 1226280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "(light groovy music)"
    } ]
  }, {
    "tStartMs": 1228080,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "But the scientists at Corning"
    } ]
  }, {
    "tStartMs": 1229190,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "are constantly trying\nto refine the process,"
    } ]
  }, {
    "tStartMs": 1231500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "to make the glass even more durable."
    } ]
  }, {
    "tStartMs": 1233900,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "There is a whole team at the facility"
    } ]
  }, {
    "tStartMs": 1235460,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "that is dedicated to testing and measuring"
    } ]
  }, {
    "tStartMs": 1237590,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "different glass prototypes."
    } ]
  }, {
    "tStartMs": 1239570,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "- [Petr] Alright, we're displacing it"
    } ]
  }, {
    "tStartMs": 1241070,
    "dDurationMs": 2004,
    "segs": [ {
      "utf8": "by one and a half millimeters.\n- Yep."
    } ]
  }, {
    "tStartMs": 1243074,
    "dDurationMs": 1555,
    "segs": [ {
      "utf8": "- [Petr] Two millimeters."
    } ]
  }, {
    "tStartMs": 1244629,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(glass cracking)"
    } ]
  }, {
    "tStartMs": 1245462,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Well."
    } ]
  }, {
    "tStartMs": 1246295,
    "dDurationMs": 2185,
    "segs": [ {
      "utf8": "- [Narrator] And they really\nput glass through its paces."
    } ]
  }, {
    "tStartMs": 1248480,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Conducting bending\ntests, scratching tests,"
    } ]
  }, {
    "tStartMs": 1251450,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "and dropping heavy steel\nballs onto the glass."
    } ]
  }, {
    "tStartMs": 1254392,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "- [Demonstrator] Three, two, one."
    } ]
  }, {
    "tStartMs": 1256504,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(metal clanging)"
    } ]
  }, {
    "tStartMs": 1257337,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "- [Narrator] They also have replica phones"
    } ]
  }, {
    "tStartMs": 1258680,
    "dDurationMs": 1887,
    "segs": [ {
      "utf8": "with different glasses for the screen."
    } ]
  }, {
    "tStartMs": 1260567,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And they drop them from\never increasing heights."
    } ]
  }, {
    "tStartMs": 1263570,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- But we can go up a little bit"
    } ]
  }, {
    "tStartMs": 1264950,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and maybe-\n- Right."
    } ]
  }, {
    "tStartMs": 1266450,
    "dDurationMs": 1324,
    "segs": [ {
      "utf8": "- We can imagine that I'm taking a selfie."
    } ]
  }, {
    "tStartMs": 1267774,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "- [Narrator] All of this is to make"
    } ]
  }, {
    "tStartMs": 1270027,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "the next version of Gorilla\nGlass even more durable"
    } ]
  }, {
    "tStartMs": 1271970,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "than it already is."
    } ]
  }, {
    "tStartMs": 1273030,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "- Like, are we doing this?"
    } ]
  }, {
    "tStartMs": 1274340,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "- If you want to.\n- Hell yeah."
    } ]
  }, {
    "tStartMs": 1275959,
    "dDurationMs": 1184,
    "segs": [ {
      "utf8": "(machine whirring)"
    } ]
  }, {
    "tStartMs": 1277143,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "1.7 meters."
    } ]
  }, {
    "tStartMs": 1277976,
    "dDurationMs": 1527,
    "segs": [ {
      "utf8": "- That's roughly selfie height."
    } ]
  }, {
    "tStartMs": 1281270,
    "dDurationMs": 1474,
    "segs": [ {
      "utf8": "Three, two, one."
    } ]
  }, {
    "tStartMs": 1282744,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "(glass clanging)"
    } ]
  }, {
    "tStartMs": 1284210,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- Amazing.\n- Go down and pick that up."
    } ]
  }, {
    "tStartMs": 1286280,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "- Still good.\n- Still survived."
    } ]
  }, {
    "tStartMs": 1288524,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "- [Petr] Dude, that's pretty wild."
    } ]
  }, {
    "tStartMs": 1290270,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- You know, I think it's rather ironic,"
    } ]
  }, {
    "tStartMs": 1292040,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "that we are making this video right now,"
    } ]
  }, {
    "tStartMs": 1293975,
    "dDurationMs": 3195,
    "segs": [ {
      "utf8": "while my phone looks like this."
    } ]
  }, {
    "tStartMs": 1297170,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Can you see those?"
    } ]
  }, {
    "tStartMs": 1298040,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1299480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So, it's still glass, it's still cracks."
    } ]
  }, {
    "tStartMs": 1302600,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "It is not perfect yet."
    } ]
  }, {
    "tStartMs": 1304558,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "But it is constantly improving,"
    } ]
  }, {
    "tStartMs": 1307400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "because scientists are working on ways"
    } ]
  }, {
    "tStartMs": 1309560,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to make this material\nmore and more durable."
    } ]
  }, {
    "tStartMs": 1312230,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "And we have come such a long way."
    } ]
  }, {
    "tStartMs": 1314358,
    "dDurationMs": 3639,
    "segs": [ {
      "utf8": "I am just appreciative that\nI can have this material."
    } ]
  }, {
    "tStartMs": 1317997,
    "dDurationMs": 2947,
    "segs": [ {
      "utf8": "And it is amazing,"
    } ]
  }, {
    "tStartMs": 1320944,
    "dDurationMs": 3735,
    "segs": [ {
      "utf8": "even if it does still crack sometimes,"
    } ]
  }, {
    "tStartMs": 1324679,
    "dDurationMs": 3244,
    "segs": [ {
      "utf8": "with people who just refuse\nto get a case for their phone."
    } ]
  }, {
    "tStartMs": 1329119,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "(electronic device whirring)"
    } ]
  } ]
}
