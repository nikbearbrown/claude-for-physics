  "events": [ {
    "tStartMs": 219,
    "dDurationMs": 6980,
    "segs": [ {
      "utf8": "It's august 21st 2017 the day of the total solar eclipse. I'm in Madras, Oregon"
    } ]
  }, {
    "tStartMs": 7750,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the skies are clear"
    } ]
  }, {
    "tStartMs": 9790,
    "dDurationMs": 4939,
    "segs": [ {
      "utf8": "My sky tracker. It's meant to move the camera with the sky so it"
    } ]
  }, {
    "tStartMs": 15580,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "Compensates for the Earth's rotation that should help me keep the sun in shot as the eclipse is taking place"
    } ]
  }, {
    "tStartMs": 32649,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "We have first contact this is C1. You just see the moon entering on the top right side"
    } ]
  }, {
    "tStartMs": 61420,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "We are 17 minutes out from totality and I think the light is starting to change. I think it's getting noticeably dimmer"
    } ]
  }, {
    "tStartMs": 67630,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "There's a bit of like a cold wind coming in from this side. Can you guys feel it?"
    } ]
  }, {
    "tStartMs": 72460,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "It's getting kind of cool, and it's getting darker. I'm really excited"
    } ]
  }, {
    "tStartMs": 85890,
    "dDurationMs": 4339,
    "segs": [ {
      "utf8": "Now that the sun is about 90 percent covered. I'm seeing much sharper shadows."
    } ]
  }, {
    "tStartMs": 90780,
    "dDurationMs": 6319,
    "segs": [ {
      "utf8": "Normally shadows, They're a little bit fuzzy because the light from the sun is coming from a whole bunch of locations."
    } ]
  }, {
    "tStartMs": 97100,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "But now because it's coming from basically one little sliver of the sun the shadows are all getting very."
    } ]
  }, {
    "tStartMs": 103229,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "very sharp, oh."
    } ]
  }, {
    "tStartMs": 111390,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "my God, oh."
    } ]
  }, {
    "tStartMs": 114840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "my God, ah."
    } ]
  }, {
    "tStartMs": 118049,
    "dDurationMs": 4879,
    "segs": [ {
      "utf8": "Look around the treasure. This is insane right now. Oh."
    } ]
  }, {
    "tStartMs": 126320,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "This is just unbelievable,"
    } ]
  }, {
    "tStartMs": 138060,
    "dDurationMs": 7560,
    "segs": [ {
      "utf8": "What is happening? This is absolutely insane like it's like- the breeze."
    } ]
  }, {
    "tStartMs": 153280,
    "dDurationMs": 7960,
    "segs": [ {
      "utf8": "Oh my God, this is totally creepy. Oh!"
    } ]
  }, {
    "tStartMs": 167050,
    "dDurationMs": 3919,
    "segs": [ {
      "utf8": "My goodness, this is weird. Oh!"
    } ]
  }, {
    "tStartMs": 176110,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "my goodness!"
    } ]
  }, {
    "tStartMs": 178660,
    "dDurationMs": 4849,
    "segs": [ {
      "utf8": "There's like sunset - sunrise every direction people are going nuts!"
    } ]
  }, {
    "tStartMs": 185319,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "This I did not expect. I don't know what I expected, but... Oh my God!"
    } ]
  }, {
    "tStartMs": 196269,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This, just looks so wrong."
    } ]
  }, {
    "tStartMs": 198630,
    "dDurationMs": 6149,
    "segs": [ {
      "utf8": "You can see these prominences the solar Corona coming out at the top left and right at the bottom I"
    } ]
  }, {
    "tStartMs": 206170,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "I can see Venus directly above me."
    } ]
  }, {
    "tStartMs": 211560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "oh... what!"
    } ]
  }, {
    "tStartMs": 216120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What is this?"
    } ]
  }, {
    "tStartMs": 219220,
    "dDurationMs": 2779,
    "segs": [ {
      "utf8": "What? I just don't even know?!"
    } ]
  }, {
    "tStartMs": 224380,
    "dDurationMs": 2149,
    "segs": [ {
      "utf8": "We are inside Totality."
    } ]
  }, {
    "tStartMs": 228069,
    "dDurationMs": 3031,
    "segs": [ {
      "utf8": "I just, I am kinda speechless."
    } ]
  }, {
    "tStartMs": 231820,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Hey, it is. Just unreal right now"
    } ]
  }, {
    "tStartMs": 240640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It's totally nuts"
    } ]
  }, {
    "tStartMs": 250060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "*Background* It's like a hole in the sky!"
    } ]
  }, {
    "tStartMs": 258300,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "*Loud cheering*  (as diamond ring effect appears)"
    } ]
  }, {
    "tStartMs": 267700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Our excitement is that the sun is back."
    } ]
  }, {
    "tStartMs": 273980,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Gonna pop the solar filter back on."
    } ]
  }, {
    "tStartMs": 295240,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Just want to say a huge. Thank you to my patreon supporters"
    } ]
  }, {
    "tStartMs": 298630,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "you made it possible for me to buy a flight here and"
    } ]
  }, {
    "tStartMs": 301780,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "for the equipment that kept my camera tracking with the sun and the solar filters on the front and yeah"
    } ]
  }, {
    "tStartMs": 308320,
    "dDurationMs": 6470,
    "segs": [ {
      "utf8": "Basically everything I needed to get here and see this total solar eclipse, so thank you so much for supporting me"
    } ]
  }, {
    "tStartMs": 315040,
    "dDurationMs": 4819,
    "segs": [ {
      "utf8": "You make possible to keep doing the things I love doing and making these videos"
    } ]
  } ]
